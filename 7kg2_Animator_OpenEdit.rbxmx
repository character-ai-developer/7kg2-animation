}

local function handleMicroHiddenPlaybackEscape(options, statusLabel, refreshCallback, key)
	if key ~= "escape"
		or type(options) ~= "table"
		or type(options.getIsPlaying) ~= "function"
		or options.getIsPlaying() ~= true then
		return false
	end
	local state = type(options.getEditorState) == "function" and (options.getEditorState() or {}) or {}
	if state.hideDuringPlayback ~= true then
		return false
	end
	local _, message = runOption(options, "onPlayPause", "playPause")
	if statusLabel then
		statusLabel.Text = tostring(message or "Paused playback and restored Micro.")
	end
	if type(refreshCallback) == "function" then
		task.defer(refreshCallback)
	end
	return true
end

local focusMicroShortcutCapture
local bindMicroShortcutSink

local function runMicroTrackballAxisShortcut(options, key)
	if key ~= "x" and key ~= "y" and key ~= "z" then
		return false, nil
	end
	local ok, message = runOption(options, "onSetTrackballAxis", "setTrackballAxis", string.upper(key))
	if not ok then
		return false, nil
	end
	local _, currentAxis = runOption(options, "onGetTrackballAxis", "getTrackballAxis")
	if currentAxis then
		return true, "Trackball axis lock: " .. tostring(currentAxis) .. " (press again to unlock)."
	end
	return true, "Trackball axis lock off: free Trackball rotation."
end

local function runMicroShortcutAction(options, statusLabel, refreshCallback, openOptionsCallback, key, shiftDown, controlDown)
	local hint = nil
	local handled = true
	local ok, message = nil, nil

	if key == "seven" then
		if type(openOptionsCallback) == "function" then
			openOptionsCallback()
		end
		return true
	elseif key == "c" and controlDown then
		clearMicroStudioSelectionForTimelineShortcut()
		microShortcutDebug("action", "copy", "ctrl=" .. tostring(controlDown), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)), "callback=" .. tostring(type(options.onCopyKeys) == "function"), "fallback=" .. tostring(type(options.onEditorAction) == "function"))
		ok, message = runOption(options, "onCopyKeys", "copySelectedKeys")
		microShortcutDebug("result", "copy", "ok=" .. tostring(ok), "message=" .. tostring(message))
		hint = "Last shortcut: Ctrl+C -&gt; Copy"
	elseif key == "v" and controlDown then
		clearMicroStudioSelectionForTimelineShortcut()
		microShortcutDebug("action", "paste", "ctrl=" .. tostring(controlDown), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)), "callback=" .. tostring(type(options.onPasteKeys) == "function"), "fallback=" .. tostring(type(options.onEditorAction) == "function"))
		ok, message = runOption(options, "onPasteKeys", "pasteKeysAtPlayhead")
		microShortcutDebug("result", "paste", "ok=" .. tostring(ok), "message=" .. tostring(message))
		hint = "Last shortcut: Ctrl+V -&gt; Paste"
	elseif key == "z" and controlDown then
		clearMicroStudioSelectionForTimelineShortcut()
		_, message = runOption(options, "onUndo", "undoLastEdit")
		hint = "Last shortcut: Ctrl+Z -&gt; Undo"
	elseif key == "y" and controlDown then
		clearMicroStudioSelectionForTimelineShortcut()
		_, message = runOption(options, "onRedo", "redoLastEdit")
		hint = "Last shortcut: Ctrl+Y -&gt; Redo"
	elseif key == "space" and controlDown then
		clearMicroStudioSelectionForTimelineShortcut()
		_, message = runOption(options, "onToggleCameraTrackEnabled", "toggleCameraTrackEnabled")
		hint = "Last shortcut: Ctrl+Space -&gt; Toggle Camera"
	elseif key == "c" and not shiftDown then
		local _, label = CameraGuideService.cycle()
		message = "Camera guide: " .. tostring(label)
		hint = "Last shortcut: C -&gt; Camera Guide " .. tostring(label)
	elseif not shiftDown and (key == "x" or key == "y" or key == "z") then
		ok, hint = runMicroTrackballAxisShortcut(options, key)
		if not ok and key ~= "y" then
			return false
		end
		if ok then
			message = hint
		else
			_, message = runOption(options, "onToggleRotateSpace", "toggleRotateSpace")
			hint = "Last shortcut: Y -&gt; Toggle Local/World Move-Rotate"
		end
	elseif key == "c" and shiftDown then
		microShortcutDebug("action", "copy", "shift=" .. tostring(shiftDown), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)), "callback=" .. tostring(type(options.onCopyKeys) == "function"), "fallback=" .. tostring(type(options.onEditorAction) == "function"))
		ok, message = runOption(options, "onCopyKeys", "copySelectedKeys")
		microShortcutDebug("result", "copy", "ok=" .. tostring(ok), "message=" .. tostring(message))
		hint = "Last shortcut: Shift+C -&gt; Copy"
	elseif key == "a" and controlDown then
		microShortcutDebug("action", "selectAll", "ctrl=" .. tostring(controlDown), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)), "callback=" .. tostring(type(options.onSelectAllKeys) == "function"), "fallback=" .. tostring(type(options.onEditorAction) == "function"))
		clearMicroStudioSelectionForTimelineShortcut()
		local selectedTrackCount = 0
		if type(options.getSelectedTrackPaths) == "function" then
			local okTracks, paths = pcall(options.getSelectedTrackPaths)
			selectedTrackCount = (okTracks and type(paths) == "table") and #paths or 0
		end
		local selectedKeyCount = getMicroShortcutSelectedKeyCount(options)
		local trackScopeSelected = selectedTrackCount &gt; 0 and options._microLastSelectionScope == "track"
		local forceTimelineScope = not trackScopeSelected
			and (options._microLastSelectionScope == "timeline" or selectedKeyCount &gt; 0 or selectedTrackCount == 0)
		if not forceTimelineScope and options._microLastSelectionScope ~= "track" and type(options._microSelectAllFromBlankTimeline) == "function" then
			local okScope, shouldUseTimelineScope = pcall(options._microSelectAllFromBlankTimeline)
			forceTimelineScope = forceTimelineScope or (okScope and shouldUseTimelineScope == true)
		end
		if forceTimelineScope then
			runOption(options, "onClearKeySelection", "clearTimelineKeySelection")
		end
		_, message = runOption(options, "onSelectAllKeys", "selectAllKeys", forceTimelineScope and "timeline" or "track")
		task.defer(clearMicroStudioSelectionForTimelineShortcut)
		task.delay(0.05, clearMicroStudioSelectionForTimelineShortcut)
		microShortcutDebug("result", "selectAll", "message=" .. tostring(message))
		hint = forceTimelineScope and "Last shortcut: Ctrl+A -&gt; Select All Timeline Keys" or "Last shortcut: Ctrl+A -&gt; Select All Track Keys"
	elseif key == "x" and shiftDown then
		_, message = runOption(options, "onCutKeys", "cutSelectedKeys")
		hint = "Last shortcut: Shift+X -&gt; Cut"
	elseif key == "v" and shiftDown then
		microShortcutDebug("action", "paste", "shift=" .. tostring(shiftDown), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)), "callback=" .. tostring(type(options.onPasteKeys) == "function"), "fallback=" .. tostring(type(options.onEditorAction) == "function"))
		ok, message = runOption(options, "onPasteKeys", "pasteKeysAtPlayhead")
		microShortcutDebug("result", "paste", "ok=" .. tostring(ok), "message=" .. tostring(message))
		hint = "Last shortcut: Shift+V -&gt; Paste"
	elseif key == "z" and shiftDown then
		_, message = runOption(options, "onUndo", "undoLastEdit")
		hint = "Last shortcut: Shift+Z -&gt; Undo"
	elseif key == "y" and shiftDown then
		_, message = runOption(options, "onRedo", "redoLastEdit")
		hint = "Last shortcut: Shift+Y -&gt; Redo"
	elseif key == "m" and shiftDown then
		_, message = runOption(options, "onMirrorKeys", "mirrorSelectedKeyframes")
		hint = "Last shortcut: Shift+M -&gt; Mirror"
	elseif key == "m" then
		_, message = runOption(options, "onSmoothMotion", "smoothSelectedMotion", "Light")
		hint = "Last shortcut: M -&gt; Smooth Motion"
	elseif key == "n" then
		if type(options.onToggleMicroMultiSelect) == "function" then
			message = options.onToggleMicroMultiSelect()
		else
			handled = false
		end
		hint = "Last shortcut: N -&gt; Toggle Multi Select"
	elseif key == "i" and shiftDown then
		_, message = runOption(options, "onInvertKeys", "invertSelectedKeyframes")
		hint = "Last shortcut: Shift+I -&gt; Invert"
	elseif key == "d" and controlDown then
		clearMicroStudioSelectionForTimelineShortcut()
		_, message = runOption(options, "onDeleteKeys", "deleteCurrentFrame")
		hint = "Last shortcut: Ctrl+D -&gt; Delete"
	elseif key == "delete" or key == "backspace" then
		_, message = runOption(options, "onDeleteKeys", "deleteCurrentFrame")
		hint = "Last shortcut: Delete -&gt; Delete"
	elseif key == "r" and shiftDown then
		_, message = runOption(options, "onRecordMotion", "recordMotion")
		hint = "Last shortcut: Shift+R -&gt; Record Motion"
	elseif key == "r" then
		_, message = runOption(options, "onToggleGizmoMode", "toggleGizmoMode")
		hint = "Last shortcut: R -&gt; Toggle Move/Rotate"
	elseif key == "t" then
		_, message = runOption(options, "onBeginTrackballMode", "beginTrackballMode", shiftDown and "Move" or "Rotate")
		hint = shiftDown and "Last shortcut: Shift+T -&gt; Trackball Move" or "Last shortcut: T -&gt; Trackball Rotate"
	elseif key == "g" then
		_, message = runOption(options, "onDefaultPoseKeyframes", "defaultPoseKeyframes", true)
		hint = "Last shortcut: G -&gt; Reset selected limb"
	elseif key == "b" and shiftDown then
		_, message = runOption(options, "onToggleRigHandles", "toggleRigHandles")
		hint = "Last shortcut: Shift+B -&gt; Toggle Rig/Bone Handles"
	elseif key == "b" then
		_, message = runOption(options, "onToggleOnionSkin", "toggleOnionSkin")
		hint = "Last shortcut: B -&gt; Toggle Onion Skin"
	elseif key == "h" then
		_, message = runOption(options, "onToggleRigPartHighlight", "toggleRigPartHighlight")
		hint = "Last shortcut: H -&gt; Toggle Viewport Part Picker"
	elseif key == "k" then
		if type(options.onOpenPopup) == "function" then
			options.onOpenPopup("Effects")
			message = "Wiggle / Fill Frames is in Effects."
		else
			_, message = runOption(options, "onOpenFull", nil, "Effects")
		end
		hint = "Last shortcut: K -&gt; Wiggle / Fill Frames"
	elseif key == "p" then
		_, message = runOption(options, "onToggleHideDuringPlayback", "toggleHideDuringPlayback")
		hint = "Last shortcut: P -&gt; Toggle Hide During Playback"
	elseif key == "plus" then
		_, message = runOption(options, "onCaptureFrame", "captureFrame")
		hint = "Last shortcut: + -&gt; Add Keyframe"
	elseif key == "previousframe" then
		_, message = runOption(options, "onStepTimelineFrame", "stepTimelineFrame", -1)
		if message == nil then
			_, message = runOption(options, "onPreviousKeyframe", "previousKeyframe")
			hint = "Last shortcut: [ -&gt; Previous keyframe"
		else
			hint = "Last shortcut: [ -&gt; Previous frame"
		end
	elseif key == "nextframe" then
		_, message = runOption(options, "onStepTimelineFrame", "stepTimelineFrame", 1)
		if message == nil then
			_, message = runOption(options, "onNextKeyframe", "nextKeyframe")
			hint = "Last shortcut: ] -&gt; Next keyframe"
		else
			hint = "Last shortcut: ] -&gt; Next frame"
		end
	elseif key == "space" then
		_, message = runOption(options, "onPlayPause", "playPause")
		hint = "Last shortcut: Space -&gt; Play/Pause"
	else
		handled = false
	end

	if not handled then
		if key == "c" or key == "v" then
			microShortcutDebug("unhandled", "key=" .. tostring(key), "shift=" .. tostring(shiftDown))
		end
		return false
	end
	if statusLabel then
		statusLabel.Text = tostring(message or hint or "Shortcut handled.")
	end
	if type(refreshCallback) == "function" then
		task.defer(refreshCallback)
	end
	if focusMicroShortcutCapture
		and controlDown == true
		and (key == "a" or key == "c" or key == "d" or key == "v" or key == "z" or key == "y") then
		task.defer(function()
			focusMicroShortcutCapture(options, statusLabel, nil)
		end)
	end
	return true
end

local function handleMicroToolShortcut(options, plugin, gui, microActive, statusLabel, refreshCallback, openOptionsCallback, input, gameProcessed)
	if not input or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return false
	end
	local key = normalizeMicroShortcutName(input.KeyCode.Name)
	local debugKey = isMicroShortcutDebugKey(key)
	if debugKey then
		microShortcutDebug("inputBegan", "source=UserInput/CAS", "key=" .. tostring(input.KeyCode.Name), "normalized=" .. tostring(key), "active=" .. tostring(microActive), "gui=" .. tostring(gui ~= nil), "enabled=" .. tostring(gui and gui.Enabled), "processed=" .. tostring(gameProcessed))
	end
	if handleMicroHiddenPlaybackEscape(options, statusLabel, refreshCallback, key) then
		return true
	end
	if not gui or not gui.Enabled or not microActive then
		if debugKey then
			microShortcutDebug("blocked", "inactive", "key=" .. tostring(key))
		end
		return false
	end
	observeMicroShortcutInput(input, true)
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local shortcutCaptureInput = type(options) == "table" and options._microShortcutCaptureInput or nil
	if focusedTextBox and focusedTextBox ~= shortcutCaptureInput then
		if debugKey then
			microShortcutDebug("blocked", "focus", "key=" .. tostring(key), "focused=" .. tostring(focusedTextBox.Name), "capture=" .. tostring(shortcutCaptureInput and shortcutCaptureInput.Name))
		end
		return false
	end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		if MicroWidgetController._ownsMicroTimelineShortcuts(options, gui, microActive) then
			clearMicroStudioSelectionForTimelineShortcut()
			options._microCtrlShortcutCaptureActive = true
			if shortcutCaptureInput then
				shortcutCaptureInput.Text = ""
				if UserInputService:GetFocusedTextBox() ~= shortcutCaptureInput and focusMicroShortcutCapture then
					focusMicroShortcutCapture(options, statusLabel, nil, true)
				end
			end
			if statusLabel then
				statusLabel.Text = "Timeline shortcuts ready: Ctrl+C/V/A/D/Z/Y."
			end
			return true
		end
		return false
	end
	if isMicroShortcutShiftKey(input.KeyCode) then
		return false
	end
	if gameProcessed and not MICRO_SHORTCUT_KEYS[key] then
		if debugKey then
			microShortcutDebug("blocked", "gameProcessed", "key=" .. tostring(key))
		end
		return false
	end
	if not MICRO_SHORTCUT_KEYS[key] then
		if debugKey then
			microShortcutDebug("blocked", "notMapped", "key=" .. tostring(key))
		end
		return false
	end
	if key == "previousframe" or key == "nextframe" then
		options._microFrameStepShortcutDown = type(options._microFrameStepShortcutDown) == "table" and options._microFrameStepShortcutDown or {}
		local lastStepClock = tonumber(options._microFrameStepShortcutDown[key])
		if lastStepClock and os.clock() - lastStepClock &lt; 0.75 then
			return true
		end
		options._microFrameStepShortcutDown[key] = os.clock()
	end
	local shiftDown = isMicroShortcutShiftDown(options, false)
	local controlDown = isMicroShortcutControlDown()
	if debugKey then
		microShortcutDebug("ready", "key=" .. tostring(key), "shift=" .. tostring(shiftDown), "ctrl=" .. tostring(controlDown), "internalShift=" .. tostring(microShortcutShiftHeld), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)))
	end
	if (key == "a" or key == "d") and not controlDown then
		return false
	end
	if MicroWidgetController._consumeMicroOneShotShortcut(options, key, controlDown) then
		return true
	end
	if shouldSkipDuplicateMicroToolShortcut(key, shiftDown, controlDown) then
		if debugKey then
			microShortcutDebug("blocked", "duplicate", "key=" .. tostring(key), "shift=" .. tostring(shiftDown))
		end
		return true
	end
	pcall(function()
		plugin:Activate(false)
	end)
	return runMicroShortcutAction(
		options,
		statusLabel,
		refreshCallback,
		openOptionsCallback,
		key,
		shiftDown,
		controlDown
	)
end

local function handleMicroToolShortcutKeyName(options, plugin, gui, microActive, statusLabel, refreshCallback, openOptionsCallback, keyName)
	local rawKeyName = tostring(keyName or "")
	local normalizedDebugKey = MicroWidgetController._decodeMicroShortcutKeyName(rawKeyName)
	local debugKey = isMicroShortcutDebugKey(normalizedDebugKey)
	if debugKey then
		microShortcutDebug("pluginKeyDown", "key=" .. rawKeyName, "normalized=" .. tostring(normalizedDebugKey), "active=" .. tostring(microActive), "gui=" .. tostring(gui ~= nil), "enabled=" .. tostring(gui and gui.Enabled))
	end
	if observeMicroShortcutKeyName(keyName, true) then
		return false
	end
	if handleMicroHiddenPlaybackEscape(options, statusLabel, refreshCallback, normalizedDebugKey) then
		return true
	end
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local shortcutCaptureInput = type(options) == "table" and options._microShortcutCaptureInput or nil
	if not gui or not gui.Enabled or not microActive or (focusedTextBox and focusedTextBox ~= shortcutCaptureInput) then
		if debugKey then
			microShortcutDebug("blocked", "pluginKeyInactiveOrFocus", "key=" .. tostring(normalizedDebugKey), "focused=" .. tostring(focusedTextBox and focusedTextBox.Name), "capture=" .. tostring(shortcutCaptureInput and shortcutCaptureInput.Name))
		end
		return false
	end
	local key, controlImplied, shiftImplied = MicroWidgetController._decodeMicroShortcutKeyName(keyName)
	if not MICRO_SHORTCUT_KEYS[key] then
		if debugKey then
			microShortcutDebug("blocked", "pluginKeyNotMapped", "key=" .. tostring(key))
		end
		return false
	end
	if key == "previousframe" or key == "nextframe" then
		options._microFrameStepShortcutDown = type(options._microFrameStepShortcutDown) == "table" and options._microFrameStepShortcutDown or {}
		local lastStepClock = tonumber(options._microFrameStepShortcutDown[key])
		if lastStepClock and os.clock() - lastStepClock &lt; 0.75 then
			return true
		end
		options._microFrameStepShortcutDown[key] = os.clock()
	end
	local shiftDown = isMicroShortcutShiftDown(options, false) or shiftImplied == true
	local controlDown = isMicroShortcutControlDown() or controlImplied == true
	if debugKey then
		microShortcutDebug("pluginReady", "key=" .. tostring(key), "shift=" .. tostring(shiftDown), "ctrl=" .. tostring(controlDown), "controlImplied=" .. tostring(controlImplied), "internalShift=" .. tostring(microShortcutShiftHeld), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)))
	end
	if (key == "a" or key == "d") and not controlDown then
		return false
	end
	if MicroWidgetController._consumeMicroOneShotShortcut(options, key, controlDown) then
		return true
	end
	if shouldSkipDuplicateMicroToolShortcut(key, shiftDown, controlDown) then
		if debugKey then
			microShortcutDebug("blocked", "pluginDuplicate", "key=" .. tostring(key), "shift=" .. tostring(shiftDown))
		end
		return true
	end
	pcall(function()
		plugin:Activate(false)
	end)
	return runMicroShortcutAction(
		options,
		statusLabel,
		refreshCallback,
		openOptionsCallback,
		key,
		shiftDown,
		controlDown
	)
end

function focusMicroShortcutCapture(options, statusLabel, message, forceFocus)
	local input = type(options) == "table" and options._microShortcutCaptureInput or nil
	if not input or not input.Parent then
		return false
	end
	options._microShortcutArmed = true
	options._microShortcutOwner = "timeline"
	options._microTimelineShortcutOwned = true
	options._microTimelineShortcutScope = "timeline"
	options._microTimelineOwnershipArmedAt = os.clock()
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	if focusedTextBox and focusedTextBox ~= input then
		if forceFocus == true then
			pcall(function()
				focusedTextBox:ReleaseFocus()
			end)
		else
			return false
		end
	end
	if statusLabel and message then
		statusLabel.Text = tostring(message)
	end
	input.Text = ""
	pcall(function()
		input:CaptureFocus()
	end)
	return true
end

local function releaseMicroShortcutCapture(options)
	local input = type(options) == "table" and options._microShortcutCaptureInput or nil
	if input and UserInputService:GetFocusedTextBox() == input then
		pcall(function()
			input:ReleaseFocus()
		end)
		return true
	end
	return false
end

function MicroWidgetController._getMicroPressedKeyNames()
	local pressedKeys = {}
	pcall(function()
		for _, inputObject in ipairs(UserInputService:GetKeysPressed()) do
			if inputObject and inputObject.KeyCode and inputObject.KeyCode ~= Enum.KeyCode.Unknown then
				pressedKeys[inputObject.KeyCode.Name] = true
			end
		end
	end)
	return pressedKeys
end

function MicroWidgetController._isMicroPointInsideGuiObject(guiObject, point)
	if not guiObject or not guiObject.Parent or not point then
		return false
	end
	local pos = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize
	return point.X &gt;= pos.X
		and point.X &lt;= pos.X + size.X
		and point.Y &gt;= pos.Y
		and point.Y &lt;= pos.Y + size.Y
end

function MicroWidgetController._isMouseOverMicroPanel(options)
	local panel = type(options) == "table" and options._microShortcutPanel or nil
	if not panel or not panel.Parent then
		return false
	end
	local ok, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if not ok or not mouseLocation then
		return false
	end
	return MicroWidgetController._isMicroPointInsideGuiObject(panel, Vector2.new(mouseLocation.X, mouseLocation.Y))
end

function MicroWidgetController._isMicroRealTextBoxFocused(options)
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	if not focusedTextBox then
		return false
	end
	return focusedTextBox ~= (type(options) == "table" and options._microShortcutCaptureInput or nil)
end

function MicroWidgetController._ownsMicroTimelineShortcuts(options, gui, microActive)
	return type(options) == "table"
		and options._microShortcutOwner == "timeline"
		and options._microTimelineShortcutOwned == true
		and options._microShortcutArmed == true
		and gui ~= nil
		and gui.Enabled == true
		and microActive == true
		and not MicroWidgetController._isMicroRealTextBoxFocused(options)
end

function MicroWidgetController._tryMicroTimelineControlShortcut(options, plugin, gui, microActive, statusLabel, refreshCallback, openOptionsCallback, input)
	if not input or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return false
	end
	if not gui or not gui.Enabled or not microActive or type(options) ~= "table" then
		return false
	end
	local key = normalizeMicroShortcutName(input.KeyCode.Name)
	if key ~= "z" and key ~= "y" and key ~= "c" and key ~= "v" then
		return false
	end
	local pressedKeys = MicroWidgetController._getMicroPressedKeyNames()
	local controlDown = isMicroShortcutControlDown()
		or pressedKeys.LeftControl == true
		or pressedKeys.RightControl == true
	if not controlDown then
		return false
	end
	if not MicroWidgetController._ownsMicroTimelineShortcuts(options, gui, microActive) then
		return false
	end
	if shouldSkipDuplicateMicroToolShortcut(key, false, true) then
		return true
	end
	pcall(function()
		if plugin then
			plugin:Activate(false)
		end
	end)
	return runMicroShortcutAction(
		options,
		statusLabel,
		refreshCallback,
		openOptionsCallback,
		key,
		false,
		true
	)
end

function MicroWidgetController._pollMicroControlShortcuts(options, plugin, gui, microActive, statusLabel, refreshCallback, openOptionsCallback)
	if not gui or not gui.Enabled or not microActive or type(options) ~= "table" then
		if type(options) == "table" then
			options._microControlShortcutPollState = nil
		end
		return
	end
	if not MicroWidgetController._ownsMicroTimelineShortcuts(options, gui, microActive) then
		options._microControlShortcutPollState = nil
		return
	end

	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local shortcutCaptureInput = options._microShortcutCaptureInput
	if focusedTextBox and focusedTextBox ~= shortcutCaptureInput then
		options._microControlShortcutPollState = nil
		return
	end

	local pressedKeys = MicroWidgetController._getMicroPressedKeyNames()
	local controlDown = isMicroShortcutControlDown()
		or pressedKeys.LeftControl == true
		or pressedKeys.RightControl == true
	if not controlDown then
		options._microControlShortcutPollState = nil
		return
	end

	local pollState = options._microControlShortcutPollState
	if type(pollState) ~= "table" then
		pollState = {}
		options._microControlShortcutPollState = pollState
	end

	local shortcutKeys = {
		{ key = "z", keyCode = Enum.KeyCode.Z },
		{ key = "y", keyCode = Enum.KeyCode.Y },
		{ key = "c", keyCode = Enum.KeyCode.C },
		{ key = "v", keyCode = Enum.KeyCode.V },
	}

	for _, shortcut in ipairs(shortcutKeys) do
		local keyName = shortcut.keyCode.Name
		local isDown = UserInputService:IsKeyDown(shortcut.keyCode) or pressedKeys[keyName] == true
		if isDown and not pollState[keyName] then
			pollState[keyName] = true
			if not shouldSkipDuplicateMicroToolShortcut(shortcut.key, false, true) then
				pcall(function()
					plugin:Activate(false)
				end)
				runMicroShortcutAction(
					options,
					statusLabel,
					refreshCallback,
					openOptionsCallback,
					shortcut.key,
					false,
					true
				)
			end
		elseif not isDown and pollState[keyName] then
			pollState[keyName] = nil
		end
	end
end

-- Shortcut ownership is intentionally separate from viewport mouse ownership.
-- Before changing this area, run docs/micro-viewport-ownership-regression-checklist.md.
function MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, message)
	if type(options) ~= "table" then
		return false
	end
	options._microShortcutArmed = true
	options._microShortcutOwner = "timeline"
	options._microTimelineShortcutOwned = true
	options._microTimelineShortcutScope = "timeline"
	options._microTimelineOwnershipArmedAt = os.clock()
	options._microTimelineArmGraceUntil = os.clock() + 0.2
	options._microViewportOutsideReleaseToken = nil
	if type(options._bindMicroShortcutSink) == "function" then
		options._bindMicroShortcutSink("arm")
	end
	runOption(options, "onResumeViewportRigPartPicker", "resumeViewportRigPartPicker")
	pcall(function()
		if plugin then
			plugin:Activate(false)
		end
	end)
	if runOption(options, "onHasViewportGizmoTarget", "hasViewportGizmoTarget") == true then
		runOption(options, "onKeepViewportGizmoOwnership", "keepViewportGizmoOwnership")
	end
	if focusMicroShortcutCapture then
		focusMicroShortcutCapture(options, statusLabel, message)
	end
	return true
end

function MicroWidgetController._armMicroTimelineOwnershipDeferred(options, plugin, statusLabel, message, forceFocus)
	MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, message)
	if forceFocus == true and plugin then
		pcall(function()
			plugin:Activate(true)
		end)
	end
	task.defer(function()
		if type(options) == "table" and options._microShortcutArmed == true then
			MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, message)
			if forceFocus == true and plugin then
				pcall(function()
					plugin:Activate(true)
				end)
			end
			if forceFocus == true and focusMicroShortcutCapture then
				focusMicroShortcutCapture(options, statusLabel, message, true)
			end
		end
	end)
	if forceFocus == true then
		task.delay(0.05, function()
			if type(options) == "table" and options._microShortcutArmed == true and focusMicroShortcutCapture then
				if plugin then
					pcall(function()
						plugin:Activate(true)
					end)
				end
				focusMicroShortcutCapture(options, statusLabel, message, true)
			end
		end)
	end
end

function MicroWidgetController._releaseMicroTimelineOwnership(options, statusLabel, message, suspendViewportPicker)
	if type(options) ~= "table" then
		return
	end
	options._microViewportOutsideReleaseToken = nil
	options._microShortcutArmed = false
	options._microShortcutOwner = nil
	options._microTimelineShortcutOwned = false
	options._microTimelineShortcutScope = nil
	options._microCtrlShortcutCaptureActive = false
	options._microOneShotShortcutDown = nil
	options._microControlShortcutPollState = nil
	options._microTimelineOwnershipArmedAt = nil
	options._microTimelineArmGraceUntil = nil
	releaseMicroShortcutCapture(options)
	if suspendViewportPicker ~= false then
		runOption(
			options,
			"onSuspendViewportRigPartPicker",
			"suspendViewportRigPartPicker",
			message or "Studio viewport controls active."
		)
	end
	if statusLabel and message then
		statusLabel.Text = tostring(message)
	end
end

function MicroWidgetController._getSelectedStudioRibbonTool(plugin)
	if not plugin then
		return nil
	end
	local ok, tool = pcall(function()
		return plugin:GetSelectedRibbonTool()
	end)
	if ok then
		return tool
	end
	return nil
end

function MicroWidgetController._isStudioTransformRibbonTool(plugin)
	local tool = MicroWidgetController._getSelectedStudioRibbonTool(plugin)
	return tool == Enum.RibbonTool.Move
		or tool == Enum.RibbonTool.Rotate
		or tool == Enum.RibbonTool.Scale
		or tool == Enum.RibbonTool.Transform
		or tool == Enum.RibbonTool.PivotEditor
end

function MicroWidgetController._shouldAttemptViewportRigPartPick(options, plugin, gui, microActive)
	if require(script.Parent.Parent:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
		return false
	end
	if MicroWidgetController._ownsMicroTimelineShortcuts(options, gui, microActive) then
		return true
	end
	local tool = MicroWidgetController._getSelectedStudioRibbonTool(plugin)
	return tool == Enum.RibbonTool.Select or tool == Enum.RibbonTool.None
end

function MicroWidgetController._tryViewportRigPartPick(options, plugin, point, allowPluginMouse, onlyDifferent)
	if type(options) ~= "table" or type(options.onViewportRigPartPick) ~= "function" then
		return false
	end
	if type(options.onIsViewportGizmoPointerOverHandle) == "function" and options.onIsViewportGizmoPointerOverHandle(point) == true then
		if type(options.onKeepViewportGizmoOwnership) == "function" then
			pcall(options.onKeepViewportGizmoOwnership)
		end
		return false
	end
	local picked = false
	if typeof(point) == "Vector2" then
		local screenMouse = {
			X = point.X,
			Y = point.Y,
		}
		pcall(function()
			picked = options.onViewportRigPartPick(screenMouse, point, onlyDifferent == true) == true
		end)
		if picked then
			return true
		end
	end
	if allowPluginMouse ~= true or not plugin then
		return false
	end
	pcall(function()
		plugin:Activate(true)
	end)
	pcall(function()
		local mouse = plugin:GetMouse()
		picked = options.onViewportRigPartPick(mouse, point, onlyDifferent == true) == true
	end)
	return picked == true
end

function MicroWidgetController._releaseMicroTimelineOwnershipAfterViewportSettle(options, plugin, statusLabel, message, gui, microActive, point)
	if type(options) ~= "table" then
		return
	end
	local token = {}
	options._microViewportOutsideReleaseToken = token
	task.delay(0.12, function()
		if type(options) ~= "table" or options._microViewportOutsideReleaseToken ~= token then
			return
		end
		options._microViewportOutsideReleaseToken = nil
		if options._microShortcutArmed ~= true then
			return
		end
		if type(options.onIsViewportGizmoPointerOverHandle) == "function" and options.onIsViewportGizmoPointerOverHandle(point) == true then
			if type(options.onKeepViewportGizmoOwnership) == "function" then
				pcall(options.onKeepViewportGizmoOwnership)
			end
			MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
			return
		end
		if MicroWidgetController._shouldAttemptViewportRigPartPick(options, plugin, gui, microActive)
			and MicroWidgetController._tryViewportRigPartPick(options, plugin, point, true) then
			MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
			return
		end
		MicroWidgetController._releaseMicroTimelineOwnership(
			options,
			statusLabel,
			message or "Studio shortcuts active: click Micro to resume timeline shortcuts.",
			true
		)
	end)
end

bindMicroShortcutSink = function(options, plugin, getGui, isMicroActive, getStatusLabel, refreshCallback, openOptionsCallback, reason)
	pcall(function()
		ContextActionService:UnbindAction(MICRO_SHORTCUT_ACTION_NAME)
		ContextActionService:BindActionAtPriority(
			MICRO_SHORTCUT_ACTION_NAME,
			function(_, inputState, inputObject)
				if inputState ~= Enum.UserInputState.Begin then
					return Enum.ContextActionResult.Pass
				end
				local currentGui = type(getGui) == "function" and getGui() or nil
				local active = type(isMicroActive) == "function" and isMicroActive() or false
				local currentStatus = type(getStatusLabel) == "function" and getStatusLabel() or nil
				if MicroWidgetController._tryMicroTimelineControlShortcut(options, plugin, currentGui, active, currentStatus, refreshCallback, openOptionsCallback, inputObject) then
					return Enum.ContextActionResult.Sink
				end
				if handleMicroToolShortcut(options, plugin, currentGui, active, currentStatus, refreshCallback, openOptionsCallback, inputObject, false) then
					return Enum.ContextActionResult.Sink
				end
				return Enum.ContextActionResult.Pass
			end,
			false,
			MICRO_SHORTCUT_PRIORITY,
			table.unpack(MICRO_SHORTCUT_KEYCODES)
		)
	end)
end

local function mountMicroShortcutCapture(parent, options, plugin, getGui, isMicroActive, getStatusLabel, refreshCallback, openOptionsCallback)
	local input = make("TextBox", {
		Name = "MicroShortcutCaptureInput",
		Active = true,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		Position = UDim2.fromOffset(-32, -32),
		Size = UDim2.fromOffset(1, 1),
		Text = "",
		TextColor3 = theme().Text,
		TextSize = 1,
		TextTransparency = 1,
		ZIndex = 1,
	}, parent)
	input:SetAttribute("MegMoShortcutCapture", true)
	options._microShortcutCaptureInput = input

	local function currentGui()
		return type(getGui) == "function" and getGui() or nil
	end
	local function active()
		return type(isMicroActive) == "function" and isMicroActive() or false
	end
	local function status()
		return type(getStatusLabel) == "function" and getStatusLabel() or nil
	end
	input.Focused:Connect(function()
		local label = status()
		if label then
			label.Text = "Micro shortcuts active: [/] step frames, Space play/pause."
		end
	end)
	input.FocusLost:Connect(function()
		input.Text = ""
	end)
	input.InputBegan:Connect(function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		handleMicroToolShortcut(options, plugin, currentGui(), active(), status(), refreshCallback, openOptionsCallback, inputObject, false)
		input.Text = ""
	end)
	input:GetPropertyChangedSignal("Text"):Connect(function()
		local value = tostring(input.Text or "")
		if value == "" then
			return
		end
		input.Text = ""
		if isMicroShortcutDebugKey(value) then
			microShortcutDebug("captureText", "value=" .. value, "shift=" .. tostring(isMicroShortcutShiftDown(options)), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)))
		end
		handleMicroToolShortcutKeyName(options, plugin, currentGui(), active(), status(), refreshCallback, openOptionsCallback, value)
	end)
	return input
end

local function trimText(value)
	return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function getMicroCutsceneOptions(options)
	options = options or {}
	if type(options._microCutsceneOptions) ~= "table" then
		options._microCutsceneOptions = {
			playback = "LocalPlayer",
			trigger = "Manual",
			replay = "Once",
			triggerPartPath = "Workspace.CutsceneTrigger",
			delaySeconds = 0,
			rigTargetMode = "WorkspaceRig",
			playerEndMode = "ReturnToStart",
			restoreCamera = true,
			hidePlayerDuringCutscene = true,
		}
	end
	return options._microCutsceneOptions
end

local function copyMicroCutsceneOptions(options)
	local source = getMicroCutsceneOptions(options)
	return {
		playback = source.playback,
		trigger = source.trigger,
		replay = source.replay,
		triggerPartPath = source.triggerPartPath,
		delaySeconds = tonumber(source.delaySeconds) or 0,
		rigTargetMode = source.rigTargetMode,
		playerEndMode = source.playerEndMode,
		restoreCamera = source.restoreCamera ~= false,
		hidePlayerDuringCutscene = source.hidePlayerDuringCutscene ~= false,
	}
end

local function describeMicroCutsceneOptions(options)
	local cutsceneOptions = getMicroCutsceneOptions(options)
	local playback = cutsceneOptions.playback == "Everyone" and "Everyone" or "Local Player"
	local trigger = tostring(cutsceneOptions.trigger or "Manual")
	local character = cutsceneOptions.rigTargetMode == "TriggeringPlayerClone" and "Player Avatar" or "Dummy Rig"
	local ending = cutsceneOptions.playerEndMode == "MoveToCutsceneEnd" and "End Position" or "Return Start"
	return string.format("%s | %s | %s | %s", playback, trigger, character, ending)
end

local function runCutscenePackageAction(options, shouldGenerate)
	options = options or {}
	local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
	if not timeline then
		return false, "No timeline is available for cutscene export."
	end
	local modules = script.Parent.Parent
	local ok, successOrValid, message = pcall(function()
		local buildInfo = require(modules:WaitForChild("BuildInfo"))
		local cutsceneExportService = require(modules:WaitForChild("Cutscene"):WaitForChild("CutsceneExportService"))
		local exportOptions = copyMicroCutsceneOptions(options)
		if shouldGenerate then
			ChangeHistoryService:SetWaypoint("Before Generate Micro Cutscene")
			local generated, generateMessage = cutsceneExportService.generate(timeline, buildInfo, exportOptions)
			if generated then
				ChangeHistoryService:SetWaypoint("After Generate Micro Cutscene")
			end
			return generated, generateMessage
		end
		return cutsceneExportService.validate(timeline, buildInfo, exportOptions)
	end)
	if not ok then
		return false, "Cutscene action failed: " .. tostring(successOrValid)
	end
	return successOrValid == true, tostring(message or (successOrValid and "Cutscene action finished." or "Cutscene action could not finish."))
end

local function getMicroFacePresets(options)
	options = options or {}
	local plugin = options.plugin
	if not plugin then
		return {}
	end
	local ok, presets = pcall(function()
		local storeModule = require(script.Parent.Parent.Parent:WaitForChild("Features"):WaitForChild("Faces"):WaitForChild("FacePresetStore"))
		local store = storeModule.new(plugin)
		store:load()
		return store:list()
	end)
	return ok and presets or {}
end

local function runMicroFacePreset(options, presetId)
	options = options or {}
	local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
	if not timeline then
		return false, "No timeline is available for faces."
	end
	if type(presetId) ~= "string" or presetId == "" then
		return false, "Choose a saved face preset first."
	end
	local ok, success, message = pcall(function()
		local features = script.Parent.Parent.Parent:WaitForChild("Features"):WaitForChild("Faces")
		local facesControllerModule = require(features:WaitForChild("FacesController"))
		local controller = facesControllerModule.new({
			plugin = options.plugin,
			timeline = timeline,
			selectionService = require(script.Parent.Parent:WaitForChild("SelectionService")),
			changeHistoryService = ChangeHistoryService,
			markDirty = options.onMarkDirty or function() end,
		})
		if type(controller.setSelectedTrackPathProvider) == "function" and type(options.getSelectedTrackPaths) == "function" then
			controller:setSelectedTrackPathProvider(options.getSelectedTrackPaths)
		end
		return controller:applyPreset(presetId)
	end)
	if not ok then
		return false, "Face preset failed: " .. tostring(success)
	end
	return success == true, tostring(message or (success and "Face preset applied." or "Face preset could not be applied."))
end

local function runMicroSoundPreview(options)
	options = options or {}
	local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
	if not timeline then
		return false, "No timeline is available for sound preview."
	end

	local selectedPaths = type(options.getSelectedTrackPaths) == "function" and options.getSelectedTrackPaths() or {}
	local soundTrack = nil
	for _, path in ipairs(selectedPaths) do
		local track = type(timeline.getTrackByPath) == "function" and timeline:getTrackByPath(path) or nil
		if track and track.trackType == "Sound" and track.instance and track.instance:IsA("Sound") then
			soundTrack = track
			break
		end
	end
	if not soundTrack and type(timeline.getTracks) == "function" then
		for _, track in ipairs(timeline:getTracks()) do
			if track and track.trackType == "Sound" and track.instance and track.instance:IsA("Sound") then
				soundTrack = track
				break
			end
		end
	end
	if not soundTrack then
		return false, "Select a Sound track before using Test Play."
	end

	local ok, played = pcall(function()
		local soundService = require(script.Parent.Parent:WaitForChild("SoundTimelineService"))
		local frame = type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or 0
		local value = soundService.capture(soundTrack.instance)
		if type(timeline.hasTrackKeyframe) == "function" and timeline:hasTrackKeyframe(soundTrack.path, frame) then
			local keys = type(timeline.getTrackKeyValues) == "function" and timeline:getTrackKeyValues({
				{
					jointPath = soundTrack.path,
					frame = frame,
				},
			}) or {}
			if keys[1] and type(keys[1].value) == "table" then
				value = keys[1].value
			end
		end
		return soundService.play(soundTrack.instance, value)
	end)
	if not ok then
		return false, "Sound preview failed: " .. tostring(played)
	end
	return played == true, played == true and ("Playing " .. tostring(soundTrack.name or "Sound") .. ".") or "Sound preview failed: check SoundId."
end

local function getMicroImportEntries(options)
	options = options or {}
	local callback = options.onGetImportEntries
	if type(callback) ~= "function" then
		return {}
	end
	local ok, entries = pcall(callback)
	return ok and type(entries) == "table" and entries or {}
end

local function getMicroImportBrowserStatus(options)
	options = options or {}
	if type(options.onGetImportBrowserStatus) ~= "function" then
		return nil
	end
	local ok, status = pcall(options.onGetImportBrowserStatus)
	return ok and tostring(status or "") or nil
end

local function runMicroImportEntry(options, entry)
	if type(entry) ~= "table" then
		return false, "Choose an import entry first."
	end
	if entry.entryType == "SavedProject" then
		return runOption(options, "onOpenSavedProject", nil, entry.id)
	elseif entry.entryType == "BulkKeyframeSequence" then
		return runOption(options, "onImportBulkKeyframeSequence", nil, entry.id)
	elseif entry.entryType == "LoadMoreMyAnimations" then
		return runOption(options, "onLoadMoreMyAnimations", nil)
	end
	return runOption(options, "onImportAnimationId", nil, entry.id, entry.name, entry)
end

local getMicroProjectSummary

local function runMicroAction(tabName, actionName, options, payload)
	local function resumeMicroViewportOwnership()
		runOption(options, "onResumeViewportRigPartPicker", "resumeViewportRigPartPicker")
	end

	local selectedStyle = tostring(actionName or ""):match("^Set Ease Style:%s*(.+)$")
	if selectedStyle then
		return runOption(options, "onSetEasingStyle", "setSelectedEasingStyle", selectedStyle)
	end
	local selectedDirection = tostring(actionName or ""):match("^Set Ease Dir:%s*(.+)$")
	if selectedDirection then
		return runOption(options, "onSetEasingDirection", "setSelectedEasingDirection", selectedDirection)
	end
	local selectedPriority = tostring(actionName or ""):match("^Set Priority:%s*(.+)$")
	if selectedPriority then
		local didRun, message = runOption(options, "onPriorityChanged", "priorityChanged", selectedPriority)
		if didRun then
			return didRun, message
		end
		local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
		if timeline and type(timeline.setPriority) == "function" then
			timeline:setPriority(selectedPriority)
			return true, "Animation priority set to " .. selectedPriority .. "."
		end
		return false, "No timeline is available."
	end

	if tabName == "Motion" then
		if actionName == "Select Rig" then
			return runOption(options, "onSelectRigInStudio", "selectRigInStudio")
		elseif actionName == "Add Marker" then
			return runOption(options, "onAddMotionMarker")
		elseif actionName == "Clear" then
			return runOption(options, "onClearMotionMarkers")
		elseif actionName == "Preview" then
			return runOption(options, "onPreviewMotionPath")
		elseif actionName == "Stop" then
			return runOption(options, "onStopMotionPreview")
		elseif actionName == "Build Timeline" then
			return runOption(options, "onCreateMotionAnimation")
		elseif actionName == "Open Motion" then
			return requestOpenFullDestination(options, "Motion")
		end
	elseif tabName == "Faces" then
		if actionName == "Apply Face" then
			local preset = getMicroFacePresets(options)[1]
			return runMicroFacePreset(options, preset and preset.Id)
		elseif actionName == "Open Faces" then
			return requestOpenFullDestination(options, "Faces")
		end
		return requestOpenFull(options)
	elseif tabName == "Camera" then
		if actionName == "Add Camera" then
			return runOption(options, "onAddTrack", "addTrack", "Camera")
		elseif actionName == "Capture" then
			return runOption(options, "onCaptureCameraTrack", "captureCameraTrackAtPlayhead")
		elseif actionName == "FOV" then
			return runOption(options, "onEnsureCameraFovTrack", "ensureCameraFovTrack")
		elseif actionName == "Orbit" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "Orbit", {
				durationSeconds = 3,
				durationToEnd = true,
				followAngle = "Auto",
				orbitDirection = "Clockwise",
				orbitCycles = 1,
				useBoundRig = true,
			})
		elseif actionName == "Follow" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "FollowRig", {
				followStyle = "Regular",
				followAngle = "Auto",
				useBoundRig = true,
			})
		elseif actionName == "Cine Follow" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "FollowRig", {
				followStyle = "Cinematic",
				followAngle = "Auto",
				useBoundRig = true,
			})
		elseif actionName == "Face Focus" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "FaceFocus", {
				durationSeconds = 3,
				radius = 4.5,
				smoothness = 5,
				useBoundRig = true,
			})
		elseif actionName == "Handheld" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "SoftHandheld", {
				durationSeconds = 5.8,
				handheldSmoothness = 3,
			})
		elseif actionName == "First Person" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "FirstPersonAttach", {
				durationToEnd = true,
				useBoundRig = true,
			})
		elseif actionName == "Detach FP" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "FirstPersonDetach", {
				durationToEnd = true,
			})
		elseif actionName == "Orbit Shot" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "OrbitShot", {
				useBoundRig = true,
			})
		elseif actionName == "Dolly In" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "DollyIn", {
				useBoundRig = true,
			})
		elseif actionName == "Dolly Out" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "DollyOut", {
				useBoundRig = true,
			})
		elseif actionName == "Hero" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "HeroReveal", {
				useBoundRig = true,
			})
		elseif actionName == "Shoulder" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "OverShoulder", {
				useBoundRig = true,
			})
		elseif actionName == "Crash" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "CrashZoom", {
				useBoundRig = true,
			})
		elseif actionName == "Follow Cam" then
			return runOption(options, "onApplyCameraPreset", "applyCameraPreset", "FollowCam", {
				useBoundRig = true,
			})
		elseif actionName == "Open Camera" then
			return requestOpenFullDestination(options, "Camera")
		end
	elseif tabName == "Audio" then
		if actionName == "Add Sound" then
			return runOption(options, "onAddTrack", "addTrack", "Sound")
		elseif actionName == "Test Play" then
			return runMicroSoundPreview(options)
		elseif actionName == "Open Audio" then
			return requestOpenFullDestination(options, "Audio")
		end
	elseif tabName == "Presets" then
		if actionName == "Import ID" then
			local input = trimText(payload)
			if input == "" then
				return false, "Paste an Animation ID or URL first."
			end
			return runOption(options, "onImportAnimationId", nil, input)
