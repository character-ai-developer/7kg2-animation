	onReverseSelectedGroups = editorActions.reverseSelectedGroups,
	onStretchGroupToFrame = stretchGroupToFrame,
	onRepeatGroupToFrame = repeatGroupToFrame,
	onGetRepeatFrameDefaults = function()
		return require(Modules:WaitForChild("RepeatFramesService")).buildDefaults(timeline, getSelectedKeyRefs())
	end,
	onRepeatFrames = function(options)
		local selectedKeyRefs = getSelectedKeyRefs()
		if #selectedKeyRefs == 0 then
			refreshUi("Select keyframes before repeating.")
			return
		end

		pushUndo("Repeat Frames")
		ChangeHistoryService:SetWaypoint("Before Repeat Frames")
		local success, message, repeatedKeys = require(Modules:WaitForChild("RepeatFramesService")).repeatSelectedKeys(timeline, selectedKeyRefs, options or {})
		if success then
			local groupRefs = {}
			for _, key in ipairs(selectedKeyRefs) do
				table.insert(groupRefs, {
					jointPath = key.jointPath,
					frame = key.frame,
				})
			end
			for _, key in ipairs(repeatedKeys or {}) do
				table.insert(groupRefs, {
					jointPath = key.jointPath,
					frame = key.frame,
				})
			end
			if #groupRefs &gt;= 2 then
				keyframeEditService:groupSelectedKeys(groupRefs)
				rebuildGroupMembership()
				message = tostring(message or "Repeated keyframes.") .. " Auto-grouped for performance."
			end
			clearSelectedKeyframes()
			for _, key in ipairs(repeatedKeys or {}) do
				selectedKeys[SelectionState.makeTrackKeyId(key.jointPath, key.frame)] = {
					jointPath = key.jointPath,
					frame = key.frame,
				}
			end
			local selectedFrames = getSelectedKeyframeFrames()
			selectedKeyframeFrame = selectedFrames[#selectedFrames]
			widgetController:invalidateTimelineRenderCache()
			timeline:applyCurrentFrame()
			ChangeHistoryService:SetWaypoint("After Repeat Frames")
		else
			historyService:discardPendingUndo()
		end
		refreshUi(message)
	end,
	onUndo = editorActions.undoLastEdit,
	onRedo = editorActions.redoLastEdit,
	onRenameAnimation = editorActions.renameAnimation,
	onNewAnimation = newAnimationFile,
	onSaveAndNewAnimation = saveAndNewAnimationFile,
	onSelectTheme = selectTheme,
	onFacesAction = handleFacesAction,
		onSaveAnimation = saveAnimation,
		onSaveAndClosePlugin = function()
			local saved = saveAnimation()
			if saved then
				if playbackService and playbackService:getIsPlaying() then
					stopPlayback()
				end
				restoreOriginalWorkspaceState("Save And Close")
				setWidgetEnabled(false)
			end
		end,
		onClosePluginWithoutSaving = function()
			setWidgetEnabled(false)
		end,
		onExportAnimation = exportAnimation,
		onValidateCutscene = function(options)
			local ok, isValid, message = pcall(function()
				return require(Modules:WaitForChild("Cutscene"):WaitForChild("CutsceneExportService")).validate(timeline, BuildInfo, options)
			end)
			local status = ok and message or ("Cutscene validation failed: " .. tostring(isValid))
			if ok and not isValid then
				status = message
			end
			refreshUi(status)
			return status
		end,
		onGenerateCutscene = function(options)
