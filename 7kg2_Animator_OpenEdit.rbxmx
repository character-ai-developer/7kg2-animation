          <string name="Name">WidgetController</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local BuildInfo = require(script.Parent:WaitForChild("BuildInfo"))
local ContextActionService = game:GetService("ContextActionService")
local CoreGui = game:GetService("CoreGui")
local ParticleKeyframeEditorController = require(script.Parent:WaitForChild("ParticleKeyframeEditorController"))
