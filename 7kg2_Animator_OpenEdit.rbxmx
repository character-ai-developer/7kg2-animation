            <ProtectedString name="Source">local BuildInfo = require(script.Parent.Parent:WaitForChild("BuildInfo"))
local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local FontPreviewService = require(script.Parent.Parent:WaitForChild("FontPreviewService"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))

local MicroParityPopupSupport = {}

