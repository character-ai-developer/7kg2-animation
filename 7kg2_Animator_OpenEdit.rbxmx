end

return WiggleFramesUI
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX111">
        <Properties>
          <string name="Name">AdornedGizmoLayer</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))

local FOLDER_NAME = "MegMoAnimatorAdornedGizmos"
local DEFAULT_SCALE_DISTANCE = 18
local MIN_SCALE = 0.75
local MAX_SCALE = 2.25
local MOVE_STEM_LENGTH = 2.1
local MOVE_CENTER_GAP = 0.34
local MOVE_ARROW_RADIUS = 0.34
local MOVE_ARROW_HEIGHT = 0.72
local MOVE_ARROW_HIT_RADIUS = 0.44
local MOVE_ARROW_HIT_HEIGHT = 0.84
local MOVE_ARROW_HIT_SPHERE_RADIUS = 0.46
local MOVE_LINE_RADIUS = 0.055
local MOVE_HIT_RADIUS = 0.14
local MOVE_HIT_TRANSPARENCY = 0.99
local ROTATE_RADIUS = 2.35
local ROTATE_LINE_THICKNESS = 0.08
local ROTATE_SPHERE_RADIUS = 0.33
local ROTATE_HIT_SPHERE_RADIUS = 0.44
local MOVE_LINE_HIT_PIXELS = 8
local ROTATE_SPHERE_HIT_PIXELS = 14
local HOVER_TRANSPARENCY = 0.08
local NORMAL_TRANSPARENCY = 0.34
local RING_TRANSPARENCY = 0.48
local HANDLE_HOVER_SCALE = 1.18
local FOCUS_ACTIVE_GIZMO_AXIS = true
local DEFAULT_USER_SCALE = 1
local MIN_USER_SCALE = 0.6
local MAX_USER_SCALE = 1.4

local AXIS_COLORS = {
	X = Color3.fromRGB(255, 76, 76),
	Y = Color3.fromRGB(80, 220, 110),
	Z = Color3.fromRGB(80, 140, 255),
}

local FACE_TO_LOCAL = {
	[Enum.NormalId.Right] = Vector3.xAxis,
	[Enum.NormalId.Left] = -Vector3.xAxis,
	[Enum.NormalId.Top] = Vector3.yAxis,
	[Enum.NormalId.Bottom] = -Vector3.yAxis,
	[Enum.NormalId.Back] = Vector3.zAxis,
	[Enum.NormalId.Front] = -Vector3.zAxis,
}

local FACE_AXIS_NAME = {
	[Enum.NormalId.Right] = "X",
	[Enum.NormalId.Left] = "X",
	[Enum.NormalId.Top] = "Y",
	[Enum.NormalId.Bottom] = "Y",
	[Enum.NormalId.Back] = "Z",
	[Enum.NormalId.Front] = "Z",
}

local AXIS_TO_LOCAL = {
	[Enum.Axis.X] = Vector3.xAxis,
	[Enum.Axis.Y] = Vector3.yAxis,
	[Enum.Axis.Z] = Vector3.zAxis,
}

-- Sphere handles must sit on each rotation ring, not along the ring's normal.
local ROTATE_HANDLE_TANGENT = {
	[Enum.Axis.X] = Vector3.zAxis,
	[Enum.Axis.Y] = Vector3.xAxis,
	[Enum.Axis.Z] = Vector3.yAxis,
}

local AXIS_NAMES = {
	Enum.Axis.X,
	Enum.Axis.Y,
	Enum.Axis.Z,
}

local MOVE_FACES = {
	Enum.NormalId.Right,
	Enum.NormalId.Left,
	Enum.NormalId.Top,
	Enum.NormalId.Bottom,
	Enum.NormalId.Back,
	Enum.NormalId.Front,
}

local AdornedGizmoLayer = {}
AdornedGizmoLayer.__index = AdornedGizmoLayer

local function safeConnect(signal, callback)
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	return ok and connection or nil
end

local function ensureFolder()
	local folder = CoreGui:FindFirstChild(FOLDER_NAME)
	if folder then
		folder:Destroy()
		folder = nil
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = CoreGui
	end
	return folder
end

local function localCFrameForDirection(localDirection, distance)
	local dir = localDirection.Magnitude &gt; 0 and localDirection.Unit or Vector3.zAxis
	local up = math.abs(dir:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	local right = up:Cross(dir).Unit
	local correctedUp = dir:Cross(right).Unit
	return CFrame.fromMatrix(dir * distance, right, correctedUp, dir)
end

local function localCFrameAtPositionFacing(localPositionDirection, distance, localFacingDirection)
	local positionDir = localPositionDirection.Magnitude &gt; 0 and localPositionDirection.Unit or Vector3.zAxis
	local facingDir = localFacingDirection.Magnitude &gt; 0 and localFacingDirection.Unit or positionDir
	local up = math.abs(facingDir:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	local right = up:Cross(facingDir).Unit
	local correctedUp = facingDir:Cross(right).Unit
	return CFrame.fromMatrix(positionDir * distance, right, correctedUp, facingDir)
end

local function cameraScale(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local distance = (camera.CFrame.Position - position).Magnitude
	return math.clamp(distance / DEFAULT_SCALE_DISTANCE, MIN_SCALE, MAX_SCALE)
end

local function viewportRay()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, nil
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y, 0)
	return ray.Origin, ray.Direction
end

local function getViewportMouseCandidates()
	local candidates = {}
	local ok, mouse = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if ok and typeof(mouse) == "Vector2" then
		table.insert(candidates, mouse)
		local insetOk, inset = pcall(function()
			return GuiService:GetGuiInset()
		end)
		if insetOk and typeof(inset) == "Vector2" then
			table.insert(candidates, mouse - inset)
		end
	end
	return candidates
end

local function intersectPlane(rayOrigin, rayDirection, planeOrigin, planeNormal)
	local denom = planeNormal:Dot(rayDirection)
	if math.abs(denom) &lt; 0.0001 then
		return nil
	end
	local t = planeNormal:Dot(planeOrigin - rayOrigin) / denom
	if t &lt; 0 then
		return nil
	end
	return rayOrigin + rayDirection * t
end

local function intersectViewportPlane(planeOrigin, planeNormal)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	for _, mouse in ipairs(getViewportMouseCandidates()) do
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y, 0)
		local point = intersectPlane(ray.Origin, ray.Direction, planeOrigin, planeNormal)
		if point then
			return point
		end
	end
	local rayOrigin, rayDirection = viewportRay()
	if rayOrigin then
		return intersectPlane(rayOrigin, rayDirection, planeOrigin, planeNormal)
	end
	return nil
end

local function chooseMovePlaneNormal(axisDirection, origin)
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.yAxis
	end

	local cameraLook = -camera.CFrame.LookVector
	local candidates = {
		camera.CFrame.RightVector,
		camera.CFrame.UpVector,
		cameraLook,
	}
	local bestNormal = nil
	local bestScore = -math.huge
	for _, candidate in ipairs(candidates) do
		local rejected = candidate - axisDirection * candidate:Dot(axisDirection)
		if rejected.Magnitude &gt; 0.001 then
			local normal = rejected.Unit
			local score = math.abs(normal:Dot(cameraLook))
			if score &gt; bestScore then
				bestScore = score
				bestNormal = normal
			end
		end
	end

	if bestNormal then
		local toCamera = camera.CFrame.Position - origin
		return bestNormal:Dot(toCamera) &lt; 0 and -bestNormal or bestNormal
	end
	return cameraLook
end

local function signedAngleOnPlane(origin, normal, initialPoint, currentPoint)
	local a = initialPoint - origin
	local b = currentPoint - origin
	if a.Magnitude &lt; 0.001 or b.Magnitude &lt; 0.001 then
		return 0
	end

	a = a.Unit
	b = b.Unit
	local dot = math.clamp(a:Dot(b), -1, 1)
	local angle = math.acos(dot)
	return normal:Dot(a:Cross(b)) &gt;= 0 and angle or -angle
end

local function setAdornmentColor(adornment, color, transparency)
	adornment.Color3 = color
	adornment.Transparency = transparency
end

local function appendScreenPoint(points, point)
	if typeof(point) == "Vector2" then
		table.insert(points, point)
	elseif type(point) == "table" then
		local x = tonumber(point.X)
		local y = tonumber(point.Y)
		if x and y then
			table.insert(points, Vector2.new(x, y))
		end
	end
end

local function collectScreenPoints(overridePoint)
	local points = {}
	appendScreenPoint(points, overridePoint)
	for _, point in ipairs(getViewportMouseCandidates()) do
		appendScreenPoint(points, point)
	end
	return points
end

local function projectWorldPoint(camera, worldPoint)
	if not (camera and typeof(worldPoint) == "Vector3") then
		return nil
	end
	local projected = camera:WorldToViewportPoint(worldPoint)
	if projected.Z &lt;= 0 then
		return nil
	end
	return Vector2.new(projected.X, projected.Y)
end

local function isNearProjectedWorldPoint(camera, screenPoint, worldPoint, maxDistance)
	local projected = projectWorldPoint(camera, worldPoint)
	return projected ~= nil and (screenPoint - projected).Magnitude &lt;= maxDistance
end

local function isNearProjectedWorldSegment(camera, screenPoint, startWorld, endWorld, maxDistance)
	local startPoint = projectWorldPoint(camera, startWorld)
	local endPoint = projectWorldPoint(camera, endWorld)
	if not (startPoint and endPoint and typeof(screenPoint) == "Vector2") then
		return false
	end
	local segment = endPoint - startPoint
	local lengthSquared = segment:Dot(segment)
	if lengthSquared &lt;= 0.001 then
		return (screenPoint - startPoint).Magnitude &lt;= maxDistance
	end
	local alpha = math.clamp((screenPoint - startPoint):Dot(segment) / lengthSquared, 0, 1)
	local closest = startPoint + segment * alpha
	return (screenPoint - closest).Magnitude &lt;= maxDistance
end

local function shouldShowMoveHandleDuringDrag(dragging, handle)
	if not FOCUS_ACTIVE_GIZMO_AXIS or not dragging or dragging.kind ~= "Move" then
		return true
	end
	local dragHandle = dragging.handle
	return dragHandle and dragHandle.axisName == handle.axisName
end

local function shouldShowRotateHandleDuringDrag(dragging, handle)
	if not FOCUS_ACTIVE_GIZMO_AXIS or not dragging or dragging.kind ~= "Rotate" then
		return true
	end
	local dragHandle = dragging.handle
	return dragHandle and dragHandle.axisName == handle.axisName
end

function AdornedGizmoLayer.new(proxyPart, callbacks)
	local self = setmetatable({}, AdornedGizmoLayer)
	self._proxyPart = proxyPart
	self._callbacks = callbacks or {}
	self._folder = ensureFolder()
	self._mode = "Move"
	self._space = "Local"
	self._visible = false
	self._userScale = DEFAULT_USER_SCALE
	self._hovered = nil
	self._dragging = nil
	self._rotateDragAngle = 0
	self._moveHandles = {}
	self._rotateHandles = {}
	self._connections = {}
	self:_createMoveHandles()
	self:_createRotateHandles()
	self:_bindInput()
	self:Refresh()
	return self
end

function AdornedGizmoLayer:_track(connection)
	if connection then
		table.insert(self._connections, connection)
	end
end

function AdornedGizmoLayer:_createMoveHandles()
	for _, face in ipairs(MOVE_FACES) do
		local axisName = FACE_AXIS_NAME[face]
		local color = AXIS_COLORS[axisName]
		local localDirection = FACE_TO_LOCAL[face]

		local line = Instance.new("CylinderHandleAdornment")
		line.Name = "MoveLine_" .. face.Name
		line.Adornee = self._proxyPart
		line.AlwaysOnTop = true
		line.ZIndex = 2
		line.Radius = MOVE_LINE_RADIUS
		line.Height = MOVE_STEM_LENGTH
		line.Color3 = color
		line.Transparency = NORMAL_TRANSPARENCY + 0.18
		line.Visible = false
		line.Parent = self._folder

		local hitLine = Instance.new("CylinderHandleAdornment")
		hitLine.Name = "MoveHitLine_" .. face.Name
		hitLine.Adornee = self._proxyPart
		hitLine.AlwaysOnTop = true
		hitLine.ZIndex = 6
		hitLine.Radius = MOVE_HIT_RADIUS
		hitLine.Height = MOVE_STEM_LENGTH
		hitLine.Color3 = color
		hitLine.Transparency = MOVE_HIT_TRANSPARENCY
		hitLine.Visible = false
		hitLine.Parent = self._folder

		local arrow = Instance.new("ConeHandleAdornment")
		arrow.Name = "MoveArrow_" .. face.Name
		arrow.Adornee = self._proxyPart
		arrow.AlwaysOnTop = true
		arrow.ZIndex = 5
		arrow.Radius = MOVE_ARROW_RADIUS
		arrow.Height = MOVE_ARROW_HEIGHT
		arrow.Color3 = color
		arrow.Transparency = NORMAL_TRANSPARENCY
		arrow.Visible = false
		arrow.Parent = self._folder

		local hitArrow = Instance.new("ConeHandleAdornment")
		hitArrow.Name = "MoveHitArrow_" .. face.Name
		hitArrow.Adornee = self._proxyPart
		hitArrow.AlwaysOnTop = true
		hitArrow.ZIndex = 7
		hitArrow.Radius = MOVE_ARROW_HIT_RADIUS
		hitArrow.Height = MOVE_ARROW_HIT_HEIGHT
		hitArrow.Color3 = color
		hitArrow.Transparency = MOVE_HIT_TRANSPARENCY
		hitArrow.Visible = false
		hitArrow.Parent = self._folder

		local hitArrowSphere = Instance.new("SphereHandleAdornment")
		hitArrowSphere.Name = "MoveHitArrowSphere_" .. face.Name
		hitArrowSphere.Adornee = self._proxyPart
		hitArrowSphere.AlwaysOnTop = true
		hitArrowSphere.ZIndex = 8
		hitArrowSphere.Radius = MOVE_ARROW_HIT_SPHERE_RADIUS
		hitArrowSphere.Color3 = color
		hitArrowSphere.Transparency = MOVE_HIT_TRANSPARENCY
		hitArrowSphere.Visible = false
		hitArrowSphere.Parent = self._folder

		local handle = {
			kind = "Move",
			face = face,
			axisName = axisName,
			localDirection = localDirection,
			color = color,
			line = line,
			hitLine = hitLine,
			arrow = arrow,
			hitArrow = hitArrow,
			hitArrowSphere = hitArrowSphere,
			adornment = arrow,
		}
		table.insert(self._moveHandles, handle)
		self:_bindHandleHover(handle, arrow)
		self:_bindHandleHover(handle, hitLine)
		self:_bindHandleHover(handle, hitArrow)
		self:_bindHandleHover(handle, hitArrowSphere)
		self:_track(safeConnect(arrow.MouseButton1Down, function()
			self:_beginMoveDrag(handle)
		end))
		self:_track(safeConnect(hitLine.MouseButton1Down, function()
			self:_beginMoveDrag(handle)
		end))
		self:_track(safeConnect(hitArrow.MouseButton1Down, function()
			self:_beginMoveDrag(handle)
		end))
		self:_track(safeConnect(hitArrowSphere.MouseButton1Down, function()
			self:_beginMoveDrag(handle)
		end))
	end
end

function AdornedGizmoLayer:_createRotateHandles()
	for _, axis in ipairs(AXIS_NAMES) do
		local axisName = axis.Name
		local localAxis = AXIS_TO_LOCAL[axis]
		local color = AXIS_COLORS[axisName]

		local ring = Instance.new("CylinderHandleAdornment")
		ring.Name = "RotateRing_" .. axisName
		ring.Adornee = self._proxyPart
		ring.AlwaysOnTop = true
		ring.ZIndex = 2
		ring.Radius = ROTATE_RADIUS
		ring.Height = ROTATE_LINE_THICKNESS
		ring.Color3 = color
		ring.Transparency = RING_TRANSPARENCY
		pcall(function()
			ring.InnerRadius = ROTATE_RADIUS - ROTATE_LINE_THICKNESS
		end)
		ring.Visible = false
		ring.Parent = self._folder

		for sign = -1, 1, 2 do
			local sphere = Instance.new("SphereHandleAdornment")
			sphere.Name = "RotateSphere_" .. axisName .. (sign &gt; 0 and "Positive" or "Negative")
			sphere.Adornee = self._proxyPart
			sphere.AlwaysOnTop = true
			sphere.ZIndex = 6
			sphere.Radius = ROTATE_SPHERE_RADIUS
			sphere.Color3 = color
			sphere.Transparency = NORMAL_TRANSPARENCY
			sphere.Visible = false
			sphere.Parent = self._folder

			local hitSphere = Instance.new("SphereHandleAdornment")
			hitSphere.Name = "RotateHitSphere_" .. axisName .. (sign &gt; 0 and "Positive" or "Negative")
			hitSphere.Adornee = self._proxyPart
			hitSphere.AlwaysOnTop = true
			hitSphere.ZIndex = 8
			hitSphere.Radius = ROTATE_HIT_SPHERE_RADIUS
			hitSphere.Color3 = color
			hitSphere.Transparency = MOVE_HIT_TRANSPARENCY
			hitSphere.Visible = false
			hitSphere.Parent = self._folder

			local handle = {
				kind = "Rotate",
				axis = axis,
				axisName = axisName,
				localAxis = localAxis,
				sign = sign,
				color = color,
				ring = ring,
				sphere = sphere,
				hitSphere = hitSphere,
				adornment = sphere,
			}
			table.insert(self._rotateHandles, handle)
			self:_bindHandleHover(handle, sphere)
			self:_bindHandleHover(handle, hitSphere)
			self:_track(safeConnect(sphere.MouseButton1Down, function()
				self:_beginRotateDrag(handle)
			end))
			self:_track(safeConnect(hitSphere.MouseButton1Down, function()
				self:_beginRotateDrag(handle)
			end))
		end
	end
end

function AdornedGizmoLayer:_bindHandleHover(handle, adornment)
	self:_track(safeConnect(adornment.MouseEnter, function()
		self._hovered = handle
		self:_updateHoverVisuals()
	end))
	self:_track(safeConnect(adornment.MouseLeave, function()
		if self._hovered == handle then
			self._hovered = nil
		end
		self:_updateHoverVisuals()
	end))
end

function AdornedGizmoLayer:_bindInput()
	self:_track(UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		self:_updateDrag()
	end))
	self:_track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		self:_endDrag()
	end))
	self:_track(RunService.Heartbeat:Connect(function()
		if self._visible then
			self:Refresh()
		end
	end))
end

function AdornedGizmoLayer:_beginMoveDrag(handle)
	if not self._visible or self._mode ~= "Move" then
		return
	end

	local proxyCFrame = self._proxyPart.CFrame
	local origin = proxyCFrame.Position
	local axisDirection = proxyCFrame:VectorToWorldSpace(handle.localDirection).Unit
	local planeNormal = chooseMovePlaneNormal(axisDirection, origin)
	local point = intersectViewportPlane(origin, planeNormal)
	if not point then
		return
	end

	self._dragging = {
		kind = "Move",
		handle = handle,
		origin = origin,
		axisDirection = axisDirection,
		planeNormal = planeNormal,
		initialScalar = axisDirection:Dot(point - origin),
	}
	self:Refresh()
	if self._callbacks.onMoveDown then
		self._callbacks.onMoveDown(handle.face)
	end
end

function AdornedGizmoLayer:_beginRotateDrag(handle)
	if not self._visible or self._mode ~= "Rotate" then
		return
	end

	local proxyCFrame = self._proxyPart.CFrame
	local origin = proxyCFrame.Position
	local normal = proxyCFrame:VectorToWorldSpace(handle.localAxis).Unit
	local point = intersectViewportPlane(origin, normal)
	if not point then
		point = origin + proxyCFrame.RightVector
	end

	self._dragging = {
		kind = "Rotate",
		handle = handle,
		origin = origin,
		normal = normal,
		initialPoint = point,
	}
	self:Refresh()
	if self._callbacks.onRotateDown then
		self._callbacks.onRotateDown(handle.axis)
	end
end

function AdornedGizmoLayer:_updateDrag()
	local drag = self._dragging
	if not drag then
		return
	end

	local rayOrigin, rayDirection = viewportRay()
	if not rayOrigin then
		return
	end

	if drag.kind == "Move" then
		local point = intersectPlane(rayOrigin, rayDirection, drag.origin, drag.planeNormal)
		if point and self._callbacks.onMoveDrag then
			local distance = drag.axisDirection:Dot(point - drag.origin) - drag.initialScalar
			self._callbacks.onMoveDrag(drag.handle.face, distance)
		end
	elseif drag.kind == "Rotate" then
		local point = intersectPlane(rayOrigin, rayDirection, drag.origin, drag.normal)
		if point and self._callbacks.onRotateDrag then
			local angle = signedAngleOnPlane(drag.origin, drag.normal, drag.initialPoint, point)
			self._rotateDragAngle = angle
			self._callbacks.onRotateDrag(drag.handle.axis, angle)
		end
	end
end

function AdornedGizmoLayer:_endDrag()
	local drag = self._dragging
	if not drag then
		return
	end
	self._dragging = nil
	self._rotateDragAngle = 0
	self:Refresh()

	if drag.kind == "Move" then
		if self._callbacks.onMoveUp then
			self._callbacks.onMoveUp(drag.handle.face)
		end
	elseif drag.kind == "Rotate" then
		if self._callbacks.onRotateUp then
			self._callbacks.onRotateUp(drag.handle.axis)
		end
	end
end

function AdornedGizmoLayer:_updateHoverVisuals()
	for _, handle in ipairs(self._moveHandles) do
		local active = self._hovered == handle or (self._dragging and self._dragging.handle == handle)
		local scale = active and HANDLE_HOVER_SCALE or 1
		if handle._arrowHeight and handle._arrowRadius then
			handle.arrow.Height = handle._arrowHeight * scale
			handle.arrow.Radius = handle._arrowRadius * scale
		end
		setAdornmentColor(handle.arrow, handle.color, active and HOVER_TRANSPARENCY or NORMAL_TRANSPARENCY)
		setAdornmentColor(handle.line, handle.color, active and HOVER_TRANSPARENCY + 0.12 or NORMAL_TRANSPARENCY + 0.18)
		if handle.hitLine then
			setAdornmentColor(handle.hitLine, handle.color, MOVE_HIT_TRANSPARENCY)
		end
		if handle.hitArrow then
			setAdornmentColor(handle.hitArrow, handle.color, MOVE_HIT_TRANSPARENCY)
		end
		if handle.hitArrowSphere then
			setAdornmentColor(handle.hitArrowSphere, handle.color, MOVE_HIT_TRANSPARENCY)
		end
	end

	for _, handle in ipairs(self._rotateHandles) do
		local active = self._hovered == handle or (self._dragging and self._dragging.handle == handle)
		local color = handle.color
		if handle._sphereRadius then
			handle.sphere.Radius = handle._sphereRadius * (active and HANDLE_HOVER_SCALE or 1)
		end
		setAdornmentColor(handle.sphere, color, active and HOVER_TRANSPARENCY or NORMAL_TRANSPARENCY)
		if handle.hitSphere then
			setAdornmentColor(handle.hitSphere, color, MOVE_HIT_TRANSPARENCY)
		end
		setAdornmentColor(handle.ring, color, active and HOVER_TRANSPARENCY + 0.2 or RING_TRANSPARENCY)
	end
end

function AdornedGizmoLayer:_setMoveCFrames(scale)
	local stemLength = MOVE_STEM_LENGTH * scale
	local centerGap = MOVE_CENTER_GAP * scale
	local visualStemLength = math.max(0.05, stemLength - centerGap)
	local arrowHeight = MOVE_ARROW_HEIGHT * scale
	local arrowHitHeight = MOVE_ARROW_HIT_HEIGHT * scale
	local arrowDistance = stemLength
	for _, handle in ipairs(self._moveHandles) do
		handle.line.Height = visualStemLength
		handle.line.Radius = MOVE_LINE_RADIUS * scale
		handle.line.CFrame = localCFrameForDirection(handle.localDirection, centerGap + (visualStemLength * 0.5))

		if handle.hitLine then
			handle.hitLine.Height = visualStemLength
			handle.hitLine.Radius = MOVE_HIT_RADIUS * scale
			handle.hitLine.CFrame = localCFrameForDirection(handle.localDirection, centerGap + (visualStemLength * 0.5))
		end

		handle._arrowHeight = arrowHeight
		handle._arrowRadius = MOVE_ARROW_RADIUS * scale
		handle.arrow.Height = arrowHeight
		handle.arrow.Radius = handle._arrowRadius
		handle.arrow.CFrame = localCFrameAtPositionFacing(handle.localDirection, arrowDistance, -handle.localDirection)

		if handle.hitArrow then
			handle.hitArrow.Height = arrowHitHeight
			handle.hitArrow.Radius = MOVE_ARROW_HIT_RADIUS * scale
			handle.hitArrow.CFrame = localCFrameAtPositionFacing(handle.localDirection, arrowDistance, -handle.localDirection)
		end
		if handle.hitArrowSphere then
			handle.hitArrowSphere.Radius = MOVE_ARROW_HIT_SPHERE_RADIUS * scale
			handle.hitArrowSphere.CFrame = CFrame.new(handle.localDirection * arrowDistance)
		end
	end
end

function AdornedGizmoLayer:_setRotateCFrames(scale)
	local radius = ROTATE_RADIUS * scale
	local sphereRadius = ROTATE_SPHERE_RADIUS * scale
	local hitSphereRadius = ROTATE_HIT_SPHERE_RADIUS * scale
	local thickness = ROTATE_LINE_THICKNESS * scale

	for _, axis in ipairs(AXIS_NAMES) do
		local localAxis = AXIS_TO_LOCAL[axis]
		local ringCFrame = localCFrameForDirection(localAxis, 0)
		for _, handle in ipairs(self._rotateHandles) do
			if handle.axis == axis then
				handle.ring.Radius = radius
				handle.ring.Height = thickness
				pcall(function()
					handle.ring.InnerRadius = math.max(0.01, radius - thickness)
				end)
				handle.ring.CFrame = ringCFrame

				handle._sphereRadius = sphereRadius
				handle.sphere.Radius = sphereRadius
				if handle.hitSphere then
					handle.hitSphere.Radius = hitSphereRadius
				end
				local tangent = ROTATE_HANDLE_TANGENT[axis] or Vector3.xAxis
				-- In Local space the proxy already rotates with the edited target. Applying
				-- the cumulative drag angle again makes the visible sphere run ahead of
				-- the cursor. World space strips the proxy rotation, so it still needs the
				-- explicit visual angle.
				local visualAngle = 0
				if self._space == "World"
					and self._dragging
					and self._dragging.kind == "Rotate"
					and self._dragging.handle
					and self._dragging.handle.axis == axis then
					visualAngle = self._rotateDragAngle or 0
				end
				local offset = CFrame.fromAxisAngle(localAxis, visualAngle):VectorToWorldSpace(tangent * radius * handle.sign)
				handle.sphere.CFrame = CFrame.new(offset)
				if handle.hitSphere then
					handle.hitSphere.CFrame = CFrame.new(offset)
				end
			end
		end
	end
end

function AdornedGizmoLayer:Refresh(options)
	local perfToken = PerformanceDebugService.begin("Gizmo Adornment Refresh")
	options = options or {}
	if options.mode then
		self._mode = options.mode
	end
	if options.space then
		self._space = options.space
	end
	if options.visible ~= nil then
		self._visible = options.visible == true
	end
	if options.sizeScale ~= nil then
		self._userScale = math.clamp(tonumber(options.sizeScale) or DEFAULT_USER_SCALE, MIN_USER_SCALE, MAX_USER_SCALE)
	end

	local scale = cameraScale(self._proxyPart.Position) * self._userScale
	self:_setMoveCFrames(scale)
	self:_setRotateCFrames(scale)

	local showMove = self._visible and self._mode == "Move"
	for _, handle in ipairs(self._moveHandles) do
		local showMoveHandle = showMove and shouldShowMoveHandleDuringDrag(self._dragging, handle)
		handle.line.Visible = showMoveHandle
		if handle.hitLine then
			handle.hitLine.Visible = showMoveHandle
		end
		handle.arrow.Visible = showMoveHandle
		if handle.hitArrow then
			handle.hitArrow.Visible = showMoveHandle
		end
		if handle.hitArrowSphere then
			handle.hitArrowSphere.Visible = showMoveHandle
		end
	end

	local showRotate = self._visible and self._mode == "Rotate"
	for _, handle in ipairs(self._rotateHandles) do
		local showRotateHandle = showRotate and shouldShowRotateHandleDuringDrag(self._dragging, handle)
		handle.ring.Visible = showRotateHandle
		handle.sphere.Visible = showRotateHandle
		if handle.hitSphere then
			handle.hitSphere.Visible = showRotateHandle
		end
	end
	self:_updateHoverVisuals()
	PerformanceDebugService.finish(perfToken, tostring(self._mode or "Unknown"))
end

function AdornedGizmoLayer:IsPointerOverHandle(screenPoint)
	if not self._visible then
		return false
	end
	if self._hovered ~= nil or self._dragging ~= nil then
		return true
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	local points = collectScreenPoints(screenPoint)
	if #points == 0 then
		return false
	end

	local proxyCFrame = self._proxyPart.CFrame
	if self._mode == "Rotate" then
		for _, point in ipairs(points) do
			for _, handle in ipairs(self._rotateHandles) do
				if handle.hitSphere and handle.hitSphere.Visible then
					local hitWorld = proxyCFrame:PointToWorldSpace(handle.hitSphere.CFrame.Position)
					local threshold = math.max(ROTATE_SPHERE_HIT_PIXELS, (handle.hitSphere.Radius or ROTATE_HIT_SPHERE_RADIUS) * 16)
					if isNearProjectedWorldPoint(camera, point, hitWorld, threshold) then
						return true
					end
				end
			end
		end
	elseif self._mode == "Move" then
		local scale = cameraScale(proxyCFrame.Position) * self._userScale
		local centerGap = MOVE_CENTER_GAP * scale
		local stemLength = MOVE_STEM_LENGTH * scale
		for _, point in ipairs(points) do
			for _, handle in ipairs(self._moveHandles) do
				if handle.hitLine and handle.hitLine.Visible and handle.localDirection then
					local startWorld = proxyCFrame:PointToWorldSpace(handle.localDirection.Unit * centerGap)
					local endWorld = proxyCFrame:PointToWorldSpace(handle.localDirection.Unit * stemLength)
					if isNearProjectedWorldSegment(camera, point, startWorld, endWorld, MOVE_LINE_HIT_PIXELS) then
						return true
					end
				end
				if handle.hitArrowSphere and handle.hitArrowSphere.Visible then
					local hitWorld = proxyCFrame:PointToWorldSpace(handle.hitArrowSphere.CFrame.Position)
					local threshold = math.max(14, (handle.hitArrowSphere.Radius or MOVE_ARROW_HIT_SPHERE_RADIUS) * 16)
					if isNearProjectedWorldPoint(camera, point, hitWorld, threshold) then
						return true
					end
				end
			end
		end
	end
	return false
end

function AdornedGizmoLayer:Destroy()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self._connections = {}
	for _, handle in ipairs(self._moveHandles) do
		handle.line:Destroy()
		if handle.hitLine then
			handle.hitLine:Destroy()
		end
		handle.arrow:Destroy()
		if handle.hitArrow then
			handle.hitArrow:Destroy()
		end
		if handle.hitArrowSphere then
			handle.hitArrowSphere:Destroy()
		end
	end
	for _, handle in ipairs(self._rotateHandles) do
		handle.sphere:Destroy()
		if handle.hitSphere then
			handle.hitSphere:Destroy()
		end
	end
	local seenRings = {}
	for _, handle in ipairs(self._rotateHandles) do
		if not seenRings[handle.ring] then
			seenRings[handle.ring] = true
			handle.ring:Destroy()
		end
	end
	if self._folder and self._folder.Parent and #self._folder:GetChildren() == 0 then
		self._folder:Destroy()
	end
end

return AdornedGizmoLayer
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX112">
        <Properties>
          <string name="Name">AnimationEffectsService</string>
          <ProtectedString name="Source">local AnimationEffectsService = {}

local DEFAULT_DIRECTION = "InOut"
local RAMP_EASING_STYLE = "Linear"
local DEFAULT_WIGGLE_MAX_KEYS = 25000

local function cloneValue(value)
	if typeof(value) == "table" then
		local clone = {}
		for key, child in pairs(value) do
			clone[key] = cloneValue(child)
		end
		return clone
	end
	return value
end

local function interpolateValue(leftValue, rightValue, alpha)
	alpha = math.clamp(alpha or 0, 0, 1)

	if typeof(leftValue) == "CFrame" and typeof(rightValue) == "CFrame" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if typeof(leftValue) == "Vector3" and typeof(rightValue) == "Vector3" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if typeof(leftValue) == "Vector2" and typeof(rightValue) == "Vector2" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if typeof(leftValue) == "Color3" and typeof(rightValue) == "Color3" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if type(leftValue) == "number" and type(rightValue) == "number" then
		return leftValue + ((rightValue - leftValue) * alpha)
	end

	if typeof(leftValue) == "NumberRange" and typeof(rightValue) == "NumberRange" then
		return NumberRange.new(
			leftValue.Min + ((rightValue.Min - leftValue.Min) * alpha),
			leftValue.Max + ((rightValue.Max - leftValue.Max) * alpha)
		)
	end

	if typeof(leftValue) == "NumberSequence" and typeof(rightValue) == "NumberSequence" then
		local left = leftValue.Keypoints[1] and leftValue.Keypoints[1].Value or 0
		local right = rightValue.Keypoints[1] and rightValue.Keypoints[1].Value or left
		return NumberSequence.new(left + ((right - left) * alpha))
	end

	if typeof(leftValue) == "ColorSequence" and typeof(rightValue) == "ColorSequence" then
		local left = leftValue.Keypoints[1] and leftValue.Keypoints[1].Value or Color3.new(1, 1, 1)
		local right = rightValue.Keypoints[1] and rightValue.Keypoints[1].Value or left
		return ColorSequence.new(left:Lerp(right, alpha))
	end

	if type(leftValue) == "table" and type(rightValue) == "table" then
		local value = {}
		local seen = {}
		for key, child in pairs(leftValue) do
			seen[key] = true
			if rightValue[key] ~= nil then
				value[key] = interpolateValue(child, rightValue[key], alpha)
			else
				value[key] = cloneValue(child)
			end
		end
		for key, child in pairs(rightValue) do
			if not seen[key] then
				value[key] = cloneValue(child)
			end
		end
		return value
	end

	return alpha &lt; 0.5 and cloneValue(leftValue) or cloneValue(rightValue)
end

local function keyId(path, frame)
	return tostring(path or "") .. "::" .. tostring(math.max(0, math.floor(frame or 0)))
end

local function normalizeKeys(timeline, keyList)
	local normalized = {}
	local seen = {}
	for _, key in ipairs(keyList or {}) do
		local path = key.jointPath or key.path
		local frame = math.max(0, math.floor(key.frame or 0))
		local id = keyId(path, frame)
		if path and not seen[id] and timeline:hasTrackKeyframe(path, frame) then
			seen[id] = true
			table.insert(normalized, {
				jointPath = path,
				frame = frame,
			})
		end
	end
	table.sort(normalized, function(a, b)
		if a.jointPath == b.jointPath then
			return a.frame &lt; b.frame
		end
		return tostring(a.jointPath) &lt; tostring(b.jointPath)
	end)
	return normalized
end

local function groupKeysByPath(keys)
	local groups = {}
	local order = {}
	for _, key in ipairs(keys) do
		local path = key.jointPath
		if not groups[path] then
			groups[path] = {}
			table.insert(order, path)
		end
		table.insert(groups[path], key)
	end
	for _, path in ipairs(order) do
		table.sort(groups[path], function(a, b)
			return a.frame &lt; b.frame
		end)
	end
	table.sort(order, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)
	return groups, order
end

local function setEasing(timeline, keys, easingStyle, easingDirection, label)
	local success, message = timeline:setTrackKeyOptions(keys, easingStyle, easingDirection or DEFAULT_DIRECTION)
	if not success then
		return false, message, keys
	end
	return true, string.format("%s on %d selected keyframe%s.", label, #keys, #keys == 1 and "" or "s"), keys
end

local function applyStopChunk(timeline, keys, keepEvery)
	local values = timeline:getTrackKeyValues(keys)
	local groups, order = groupKeysByPath(values)
	local keep = {}
	local remove = {}

	for _, path in ipairs(order) do
		local list = groups[path]
		for index, key in ipairs(list) do
			local shouldKeep = index == 1 or index == #list or ((index - 1) % keepEvery == 0)
			if shouldKeep then
				table.insert(keep, {
					jointPath = key.jointPath,
					frame = key.frame,
				})
			else
				table.insert(remove, {
					jointPath = key.jointPath,
					frame = key.frame,
				})
			end
		end
	end

	if #keep == 0 then
		return false, "Select two or more keyframes before applying Stop Motion.", keys
	end

	if #remove &gt; 0 then
		local deleted = nil
		local success, message, deletedCount = timeline:deleteTrackKeyframes(remove)
		deleted = deletedCount
		if not success then
			return false, message, keys
		end
		if (deleted or 0) == 0 then
			return false, "No in-between keyframes were available to remove.", keys
		end
	end

	local easingSuccess, easingMessage = timeline:setTrackKeyOptions(keep, "None", DEFAULT_DIRECTION)
	if not easingSuccess then
		return false, easingMessage, keep
	end

	return true, string.format(
		"Applied Stop Motion x%d: kept %d key%s and removed %d in-between key%s.",
		keepEvery,
		#keep,
		#keep == 1 and "" or "s",
		#remove,
		#remove == 1 and "" or "s"
	), keep
end

local function applyStagger(timeline, keys)
	local groups, order = groupKeysByPath(keys)
	local moved = {}
	local duration = timeline:getDurationFrames()

	for index, path in ipairs(order) do
		local offset = index - 1
		for _, key in ipairs(groups[path]) do
			if key.frame + offset &gt; duration then
				return false, "Stagger would move a selected key past the animation length.", keys
			end
		end
	end

	for index, path in ipairs(order) do
		local offset = index - 1
		if offset &gt; 0 then
			local success, message = timeline:moveTrackKeyframes(groups[path], offset)
			if not success then
				return false, message, keys
			end
		end
		for _, key in ipairs(groups[path]) do
			table.insert(moved, {
				jointPath = key.jointPath,
				frame = key.frame + offset,
			})
		end
	end

	return true, string.format("Applied Cartoony timing to %d selected keyframe%s across %d track%s.", #moved, #moved == 1 and "" or "s", #order, #order == 1 and "" or "s"), moved
end

local function applyPoseHold(timeline, keys)
	local values = timeline:getTrackKeyValues(keys)
	local groups, order = groupKeysByPath(values)
	local added = {}

	for _, path in ipairs(order) do
		local list = groups[path]
		for index = 1, #list - 1 do
			local key = list[index]
			local nextKey = list[index + 1]
			local targetFrame = nextKey.frame - 1
			if targetFrame &gt; key.frame and not timeline:hasTrackKeyframe(path, targetFrame) then
				local success = timeline:setTrackValueAtFrame(path, targetFrame, key.value, "None", DEFAULT_DIRECTION)
				if success then
					table.insert(added, {
						jointPath = path,
						frame = targetFrame,
					})
				end
			end
		end
	end

	if #added == 0 then
		return false, "Pose Hold needs gaps between selected keyframes on the same track.", keys
	end

	timeline:setTrackKeyOptions(keys, "None", DEFAULT_DIRECTION)
	for _, key in ipairs(keys) do
		table.insert(added, key)
	end
	return true, string.format("Added %d pose-hold keyframe%s.", #added, #added == 1 and "" or "s"), added
end

local function applyLoopPolish(timeline, keys)
	local values = timeline:getTrackKeyValues(keys)
	local groups, order = groupKeysByPath(values)
	local polished = {}

	for _, path in ipairs(order) do
		local list = groups[path]
		if #list &gt;= 2 then
			local first = list[1]
			local last = list[#list]
			if last.frame &gt; first.frame then
				local success = timeline:setTrackValueAtFrame(path, last.frame, first.value, "Sine", DEFAULT_DIRECTION)
				if success then
					table.insert(polished, {
						jointPath = path,
						frame = last.frame,
					})
				end
			end
		end
	end

	if #polished == 0 then
		return false, "Loop Polish needs at least two selected keyframes on a track.", keys
	end
	return true, string.format("Polished %d loop endpoint%s to match the first selected pose.", #polished, #polished == 1 and "" or "s"), polished
end

local function applyBoilFrames(timeline, keys)
	local values = timeline:getTrackKeyValues(keys)
	local changed = {}
	for index, key in ipairs(values) do
		table.insert(changed, {
			jointPath = key.jointPath,
			frame = key.frame,
		})
		local style = (index % 2 == 0) and "Linear" or "None"
		timeline:setTrackKeyOptions({ changed[#changed] }, style, DEFAULT_DIRECTION)
	end

	if #changed == 0 then
		return false, "Select keyframes before applying Boil Frames.", keys
	end
	return true, string.format("Applied alternating hold/linear timing to %d keyframe%s.", #changed, #changed == 1 and "" or "s"), changed
end

local function reverseDirection(direction)
	if direction == "In" then
		return "Out"
	elseif direction == "Out" then
		return "In"
	end
	return direction or DEFAULT_DIRECTION
end

local function applyReverse(timeline, keys)
	local values = timeline:getTrackKeyValues(keys)
	if #values &lt; 2 then
		return false, "Select two or more keyframes before reversing an animation section.", keys
	end

	local minFrame = math.huge
	local maxFrame = -math.huge
	local selectedLookup = {}
	for _, key in ipairs(values) do
		minFrame = math.min(minFrame, key.frame)
		maxFrame = math.max(maxFrame, key.frame)
		selectedLookup[key.jointPath] = selectedLookup[key.jointPath] or {}
		selectedLookup[key.jointPath][key.frame] = true
	end

	if minFrame == maxFrame then
		return false, "Reverse needs selected keyframes across at least two different frames.", keys
	end

	local writes = {}
	for _, key in ipairs(values) do
		local targetFrame = minFrame + maxFrame - key.frame
		if type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(key.jointPath) then
			return false, "Reverse cannot update disabled tracks. Enable the selected tracks first.", keys
		end
		if timeline:hasTrackKeyframe(key.jointPath, targetFrame)
			and not (selectedLookup[key.jointPath] and selectedLookup[key.jointPath][targetFrame]) then
			return false, string.format("Reverse would overwrite an unselected keyframe at frame %d.", targetFrame), keys
		end
		table.insert(writes, {
			jointPath = key.jointPath,
			frame = targetFrame,
			value = key.value,
			easingStyle = key.easingStyle,
			easingDirection = reverseDirection(key.easingDirection),
		})
	end

	local deleteSuccess, deleteMessage = timeline:deleteTrackKeyframes(keys)
	if not deleteSuccess then
		return false, deleteMessage, keys
	end

	local changed = {}
	for _, key in ipairs(writes) do
		local success, message = timeline:setTrackValueAtFrame(key.jointPath, key.frame, key.value, key.easingStyle, key.easingDirection)
		if not success then
			return false, message, changed
		end
		table.insert(changed, {
			jointPath = key.jointPath,
			frame = key.frame,
		})
	end

	return true, string.format("Reversed %d selected keyframe%s between frames %d and %d.", #changed, #changed == 1 and "" or "s", minFrame, maxFrame), changed
end

local function buildPathLookup(keys)
	local lookup = {}
	for _, key in ipairs(keys or {}) do
		local path = key.jointPath or key.path
		if path then
			lookup[path] = true
		end
	end
	return lookup
end

local function collectKeysAfterFrame(timeline, frame, pathLookup)
	local refs = {}
	local keyframesByPath = type(timeline.getTrackKeyframesByPath) == "function" and timeline:getTrackKeyframesByPath() or {}
	for path, frames in pairs(keyframesByPath) do
		if not pathLookup or pathLookup[path] then
			for _, keyFrame in ipairs(frames) do
				if keyFrame &gt; frame then
					table.insert(refs, {
						jointPath = path,
						frame = keyFrame,
					})
				end
			end
		end
	end
	return timeline:getTrackKeyValues(refs)
end

local function writeTrackKey(timeline, key, frame)
	return timeline:setTrackValueAtFrame(
		key.jointPath,
		frame,
		cloneValue(key.value),
		key.easingStyle,
		key.easingDirection
	)
end

local function trim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function parseFrameInput(input, fps)
	fps = math.max(1, math.floor(tonumber(fps) or 30))
	local text = trim(input)
	if text == "" then
		return nil
	end

	local secondsText = string.match(string.lower(text), "^([%d%.]+)%s*s$")
	if secondsText then
		return math.max(0, math.floor((tonumber(secondsText) or 0) * fps + 0.5))
	end

	local whole, subFrame = string.match(text, "^(%-?%d+)%s*:%s*(%-?%d+)$")
	if whole and subFrame then
		return math.max(0, (tonumber(whole) or 0) * fps + (tonumber(subFrame) or 0))
	end

	local value = tonumber(text)
	if value then
		return math.max(0, math.floor(value + 0.5))
	end

	return nil
end

local function parseWiggleIntervalInput(input, fps)
	fps = math.max(1, math.floor(tonumber(fps) or 30))
	local text = trim(input)
	if text == "" then
		return nil, false
	end

	local normalized = string.lower(text)
	local frameText = string.match(normalized, "^(%-?%d+)%s*f%s*$")
		or string.match(normalized, "^(%-?%d+)%s*frame%s*$")
		or string.match(normalized, "^(%-?%d+)%s*frames%s*$")
	if frameText then
		return math.max(0, math.floor((tonumber(frameText) or 0) + 0.5)), true
	end

	local secondsText = string.match(normalized, "^([%d%.]+)%s*s$")
		or string.match(normalized, "^([%d%.]+)%s*sec%s*$")
		or string.match(normalized, "^([%d%.]+)%s*secs%s*$")
		or string.match(normalized, "^([%d%.]+)%s*second%s*$")
		or string.match(normalized, "^([%d%.]+)%s*seconds%s*$")
	if secondsText then
		return math.max(0, math.floor((tonumber(secondsText) or 0) * fps + 0.5)), true
	end

	local whole, subFrame = string.match(text, "^(%-?%d+)%s*:%s*(%-?%d+)$")
	if whole and subFrame then
		return math.max(0, (tonumber(whole) or 0) * fps + (tonumber(subFrame) or 0)), true
	end

	local value = tonumber(text)
	if value then
		if string.find(text, "%.") then
			return math.max(0, math.floor(value * fps + 0.5)), true
		end
		return math.max(0, math.floor(value + 0.5)), true
	end

	return nil, true
end

local function optionNumber(options, key, defaultValue)
	local value = options and options[key]
	value = tonumber(value)
	if value == nil then
		return defaultValue or 0
	end
	return value
end

local function applyWiggleOffset(value, angleDegrees, positionOffset, sign)
	sign = sign or 1
	local rotation = CFrame.Angles(
		math.rad(angleDegrees.X * sign),
		math.rad(angleDegrees.Y * sign),
		math.rad(angleDegrees.Z * sign)
	)
	local offset = positionOffset * sign

	if typeof(value) == "CFrame" then
		return value * CFrame.new(offset) * rotation
	end

	if typeof(value) == "Vector3" then
		return value + offset
	end

	if type(value) == "table" then
		local result = cloneValue(value)
		local cframe = value.cframe or value.CFrame
		if typeof(cframe) == "CFrame" then
			local wiggledCFrame = cframe * CFrame.new(offset) * rotation
			if value.cframe ~= nil then
				result.cframe = wiggledCFrame
			end
			if value.CFrame ~= nil then
				result.CFrame = wiggledCFrame
			end
			local focus = value.focus or value.Focus
			if typeof(focus) == "CFrame" then
				local oldDistance = (focus.Position - cframe.Position).Magnitude
				local shiftedFocus = CFrame.new(wiggledCFrame.Position + (wiggledCFrame.LookVector * math.max(oldDistance, 1)))
				if value.focus ~= nil then
					result.focus = shiftedFocus
				end
				if value.Focus ~= nil then
					result.Focus = shiftedFocus
				end
			end
			return result
		end
	end

	return nil
end

local function applyWiggle(timeline, keys, options)
	options = options or {}
	local values = timeline:getTrackKeyValues(keys)
	if #values &lt; 2 then
		return false, "Wiggle needs at least two selected keyframes on the same track.", keys
	end

	local fps = type(timeline.getFps) == "function" and timeline:getFps() or 30
	local intervalFrames = tonumber(options.intervalFrames)
	if not intervalFrames then
		local parsedIntervalFrames, hadIntervalInput = parseWiggleIntervalInput(options.interval, fps)
		if hadIntervalInput and not parsedIntervalFrames then
			return false, "Enter a Wiggle interval like 2, 10f, 0:10, or 0.5s.", keys
		end
		intervalFrames = parsedIntervalFrames or parseFrameInput(options.interval, fps) or 2
	end
	intervalFrames = math.max(1, math.floor(intervalFrames + 0.5))

	local angleDegrees = Vector3.new(
		optionNumber(options, "angleX", 2),
		optionNumber(options, "angleY", 2),
		optionNumber(options, "angleZ", 2)
	)
	local positionOffset = Vector3.new(
		optionNumber(options, "posX", 0),
		optionNumber(options, "posY", 0),
		optionNumber(options, "posZ", 0)
	)
	if angleDegrees.Magnitude &lt;= 0 and positionOffset.Magnitude &lt;= 0 then
		return false, "Enter a rotation or position amount before applying Wiggle.", keys
	end

	local easingStyle = tostring(options.easingStyle or "Linear")
	local easingDirection = tostring(options.easingDirection or DEFAULT_DIRECTION)
	local groups, order = groupKeysByPath(values)
	local inserted = {}
	local skippedExisting = 0
	local skippedUnsupported = 0

	for _, path in ipairs(order) do
		if type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(path) then
			return false, "Wiggle cannot update disabled tracks. Enable the selected tracks first.", keys
		end

		local list = groups[path]
		if #list &lt; 2 then
			continue
		end

		for index = 1, #list - 1 do
			local leftKey = list[index]
			local rightKey = list[index + 1]
			local span = rightKey.frame - leftKey.frame
			if span &lt;= intervalFrames then
				continue
			end

			local stepIndex = 0
			local frame = leftKey.frame + intervalFrames
			while frame &lt; rightKey.frame do
				if #inserted &gt;= DEFAULT_WIGGLE_MAX_KEYS then
					return false, "Wiggle would create too many keyframes. Use a larger interval or a smaller selection.", inserted
				end

				if timeline:hasTrackKeyframe(path, frame) then
					skippedExisting += 1
				else
					stepIndex += 1
					local alpha = (frame - leftKey.frame) / span
					local baseValue = interpolateValue(leftKey.value, rightKey.value, alpha)
					local sign = (stepIndex % 2 == 1) and 1 or -1
					local wiggledValue = applyWiggleOffset(baseValue, angleDegrees, positionOffset, sign)
					if wiggledValue ~= nil then
						local success, message = timeline:setTrackValueAtFrame(path, frame, wiggledValue, easingStyle, easingDirection)
						if not success then
							return false, message, inserted
						end
						table.insert(inserted, {
							jointPath = path,
							frame = frame,
						})
					else
						skippedUnsupported += 1
					end
				end
				frame += intervalFrames
			end
		end
	end

	if #inserted == 0 then
		if skippedExisting &gt; 0 then
			return false, "Wiggle found existing in-between keyframes and did not overwrite them.", keys
		end
		if skippedUnsupported &gt; 0 then
			return false, "Wiggle supports CFrame, camera CFrame, and Vector3-style values for now.", keys
		end
		return false, "Wiggle needs selected keyframes with open gaps between them.", keys
	end

	local skippedText = skippedExisting &gt; 0 and string.format(" Skipped %d existing key%s.", skippedExisting, skippedExisting == 1 and "" or "s") or ""
	return true, string.format("Added %d wiggle keyframe%s every %d frame%s.%s", #inserted, #inserted == 1 and "" or "s", intervalFrames, intervalFrames == 1 and "" or "s", skippedText), inserted
end

local function applySlowMotion(timeline, keys, factor)
	factor = math.max(2, math.floor(factor or 2))
	local values = timeline:getTrackKeyValues(keys)
	if #values &lt; 2 then
		return false, "Select two or more keyframes before applying slow motion.", keys
	end

	local minFrame = math.huge
	local maxFrame = -math.huge
	local selectedLookup = {}
	for _, key in ipairs(values) do
		minFrame = math.min(minFrame, key.frame)
		maxFrame = math.max(maxFrame, key.frame)
		selectedLookup[key.jointPath] = selectedLookup[key.jointPath] or {}
		selectedLookup[key.jointPath][key.frame] = true
	end

	if minFrame == maxFrame then
		return false, "Slow motion needs selected keyframes across at least two different frames.", keys
	end

	local writes = {}
	local maxTargetFrame = timeline:getDurationFrames()
	local addedSpan = (maxFrame - minFrame) * (factor - 1)
	local affectedPaths = buildPathLookup(values)
	local downstreamKeys = addedSpan &gt; 0 and collectKeysAfterFrame(timeline, maxFrame, affectedPaths) or {}
	for _, key in ipairs(values) do
		if type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(key.jointPath) then
			return false, "Slow motion cannot update disabled tracks. Enable the selected tracks first.", keys
		end
		if type(timeline.getTrackByPath) == "function" and not timeline:getTrackByPath(key.jointPath) then
			return false, "Slow motion found a selected keyframe on a missing track.", keys
		end

		local targetFrame = minFrame + ((key.frame - minFrame) * factor)
		if timeline:hasTrackKeyframe(key.jointPath, targetFrame)
			and targetFrame &lt;= maxFrame
			and not (selectedLookup[key.jointPath] and selectedLookup[key.jointPath][targetFrame]) then
			return false, string.format("Slow motion would overwrite an unselected keyframe at frame %d.", targetFrame), keys
		end

		maxTargetFrame = math.max(maxTargetFrame, targetFrame)
		table.insert(writes, {
			jointPath = key.jointPath,
			frame = targetFrame,
			value = key.value,
			easingStyle = key.easingStyle,
			easingDirection = key.easingDirection,
		})
	end
	for _, key in ipairs(downstreamKeys) do
		maxTargetFrame = math.max(maxTargetFrame, key.frame + addedSpan)
	end

	if maxTargetFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(maxTargetFrame)
	end

	if #downstreamKeys &gt; 0 then
		local downstreamRefs = {}
		for _, key in ipairs(downstreamKeys) do
			table.insert(downstreamRefs, {
				jointPath = key.jointPath,
				frame = key.frame,
			})
		end
		local downstreamDeleteSuccess, downstreamDeleteMessage = timeline:deleteTrackKeyframes(downstreamRefs)
		if not downstreamDeleteSuccess then
			return false, downstreamDeleteMessage, keys
		end
	end

	local deleteSuccess, deleteMessage = timeline:deleteTrackKeyframes(keys)
	if not deleteSuccess then
		return false, deleteMessage, keys
	end

	local changed = {}
	for _, key in ipairs(writes) do
		local success, message = writeTrackKey(timeline, key, key.frame)
		if not success then
			return false, message, changed
		end
		table.insert(changed, {
			jointPath = key.jointPath,
			frame = key.frame,
		})
	end
	for _, key in ipairs(downstreamKeys) do
		local success, message = writeTrackKey(timeline, key, key.frame + addedSpan)
		if not success then
			return false, message, changed
		end
	end

	local shiftedText = #downstreamKeys &gt; 0 and string.format(" Shifted %d later keyframe%s forward by %d frame%s.", #downstreamKeys, #downstreamKeys == 1 and "" or "s", addedSpan, addedSpan == 1 and "" or "s") or ""
	return true, string.format("Applied Slow Motion to %d selected keyframe%s.%s", #changed, #changed == 1 and "" or "s", shiftedText), changed
end

local function speedRampTargetAlpha(alpha, rampId)
	alpha = math.clamp(alpha or 0, 0, 1)
	if rampId == "SpeedRampUp" then
		return math.sqrt(alpha)
	elseif rampId == "SpeedRampDown" then
		return 1 - math.sqrt(1 - alpha)
	elseif rampId == "SpeedRampInOut" then
		if alpha &lt; 0.5 then
			return math.sqrt(alpha / 2)
		end
		return 1 - math.sqrt((1 - alpha) / 2)
	elseif rampId == "SpeedRampOutIn" then
		if alpha &lt; 0.5 then
			return 0.5 * (1 - math.sqrt(1 - (2 * alpha)))
		end
		return 0.5 + (0.5 * math.sqrt((alpha - 0.5) * 2))
	end
	return alpha
end

local function roundFrame(frame)
	return math.max(0, math.floor((frame or 0) + 0.5))
end

local function rampDisplayName(rampId)
	if rampId == "SpeedRampUp" then
		return "Ramp Up"
	elseif rampId == "SpeedRampDown" then
		return "Ramp Down"
	elseif rampId == "SpeedRampInOut" then
		return "Ramp In-Out"
	elseif rampId == "SpeedRampOutIn" then
		return "Ramp Out-In"
	end
	return "Speed Ramp"
end

local function rampEasingStyle(_rampId)
	return RAMP_EASING_STYLE
end

local function rampInsertedPointCount(rampId)
	if rampId == "SpeedRampUp" or rampId == "SpeedRampDown" then
		return 1
	end
	return 2
end

local function getMinimumRampSpan(timeline, rampId)
	local fps = type(timeline.getFps) == "function" and timeline:getFps() or 30
	return math.max(rampInsertedPointCount(rampId) + 1, math.floor((math.max(1, fps) * 0.2) + 0.5))
end

local function expandRampSelectionIfNeeded(timeline, values, keys, rampId)
	local minFrame = math.huge
	local maxFrame = -math.huge
	local selectedLookup = {}
	for _, key in ipairs(values) do
		minFrame = math.min(minFrame, key.frame)
		maxFrame = math.max(maxFrame, key.frame)
		selectedLookup[key.jointPath] = selectedLookup[key.jointPath] or {}
		selectedLookup[key.jointPath][key.frame] = true
	end

	if maxFrame &lt;= minFrame then
		return false, keys, "Speed Ramp needs selected keyframes across a frame range."
	end

	local span = maxFrame - minFrame
	local minimumSpan = getMinimumRampSpan(timeline, rampId)
	if span &gt;= minimumSpan then
		return true, keys, nil
	end

	local addedSpan = minimumSpan - span
	local targetLookup = {}
	local selectedWrites = {}
	local maxTargetFrame = timeline:getDurationFrames()
	table.sort(values, function(a, b)
		if a.jointPath == b.jointPath then
			return a.frame &lt; b.frame
		end
		return tostring(a.jointPath) &lt; tostring(b.jointPath)
	end)

	for _, key in ipairs(values) do
		local alpha = (key.frame - minFrame) / span
		local targetFrame = roundFrame(minFrame + (minimumSpan * alpha))
		local targetId = keyId(key.jointPath, targetFrame)
		if targetLookup[targetId] then
			return false, keys, string.format("%s could not spread selected keyframes without overlapping frame %d.", rampDisplayName(rampId), targetFrame)
		end
		if timeline:hasTrackKeyframe(key.jointPath, targetFrame)
			and targetFrame &lt;= maxFrame
			and not (selectedLookup[key.jointPath] and selectedLookup[key.jointPath][targetFrame]) then
			return false, keys, string.format("%s would overwrite an unselected keyframe at frame %d.", rampDisplayName(rampId), targetFrame)
		end

		targetLookup[targetId] = true
		maxTargetFrame = math.max(maxTargetFrame, targetFrame)
		table.insert(selectedWrites, {
			jointPath = key.jointPath,
			frame = targetFrame,
			value = key.value,
			easingStyle = key.easingStyle,
			easingDirection = key.easingDirection,
		})
	end

	local affectedPaths = buildPathLookup(values)
	local downstreamKeys = collectKeysAfterFrame(timeline, maxFrame, affectedPaths)
	for _, key in ipairs(downstreamKeys) do
		maxTargetFrame = math.max(maxTargetFrame, key.frame + addedSpan)
	end
	if maxTargetFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(maxTargetFrame)
	end

	if #downstreamKeys &gt; 0 then
		local downstreamRefs = {}
		for _, key in ipairs(downstreamKeys) do
			table.insert(downstreamRefs, {
				jointPath = key.jointPath,
				frame = key.frame,
			})
		end
		local downstreamDeleteSuccess, downstreamDeleteMessage = timeline:deleteTrackKeyframes(downstreamRefs)
		if not downstreamDeleteSuccess then
			return false, keys, downstreamDeleteMessage
		end
	end

	local deleteSuccess, deleteMessage = timeline:deleteTrackKeyframes(keys)
	if not deleteSuccess then
		return false, keys, deleteMessage
	end

	local expandedKeys = {}
	for _, key in ipairs(selectedWrites) do
		local success, message = writeTrackKey(timeline, key, key.frame)
		if not success then
			return false, expandedKeys, message
		end
		table.insert(expandedKeys, {
			jointPath = key.jointPath,
			frame = key.frame,
		})
	end
	for _, key in ipairs(downstreamKeys) do
		local success, message = writeTrackKey(timeline, key, key.frame + addedSpan)
		if not success then
			return false, expandedKeys, message
		end
	end

	local shiftedText = #downstreamKeys &gt; 0 and string.format(" Shifted %d later keyframe%s forward by %d frame%s.", #downstreamKeys, #downstreamKeys == 1 and "" or "s", addedSpan, addedSpan == 1 and "" or "s") or ""
	return true, expandedKeys, string.format("Spread close selected keyframes from %d to %d frames so the ramp has room.%s", span, minimumSpan, shiftedText)
end

local function findFreeInteriorFrame(timeline, path, desiredFrame, minFrame, maxFrame, reservedFrames)
	if maxFrame - minFrame &lt;= 1 then
		return nil
	end

	desiredFrame = math.clamp(roundFrame(desiredFrame), minFrame + 1, maxFrame - 1)
	for radius = 0, maxFrame - minFrame do
		local candidates = {
			desiredFrame - radius,
			desiredFrame + radius,
		}
		for _, candidate in ipairs(candidates) do
			if candidate &gt; minFrame
				and candidate &lt; maxFrame
				and not reservedFrames[candidate]
				and not timeline:hasTrackKeyframe(path, candidate) then
				reservedFrames[candidate] = true
				return candidate
			end
		end
	end

	return nil
end

local function appendInsertedRampKeys(timeline, path, list, rampId, inserted)
	local first = list[1]
	local last = list[#list]
	local minFrame = first.frame
	local maxFrame = last.frame
	local span = maxFrame - minFrame
	if span &lt; 2 then
		return false, "Speed Ramp needs at least two frames of space between the selected keys."
	end

	local reservedFrames = {}
	local points = {}
	if rampId == "SpeedRampUp" then
		table.insert(points, {
			frameAlpha = 0.68,
			valueAlpha = 0.5,
		})
	elseif rampId == "SpeedRampDown" then
		table.insert(points, {
			frameAlpha = 0.32,
			valueAlpha = 0.5,
		})
	elseif rampId == "SpeedRampInOut" then
		table.insert(points, {
			frameAlpha = 0.35,
			valueAlpha = 0.2,
		})
		table.insert(points, {
			frameAlpha = 0.65,
			valueAlpha = 0.8,
		})
	else
		table.insert(points, {
			frameAlpha = 0.25,
			valueAlpha = 0.35,
		})
		table.insert(points, {
			frameAlpha = 0.75,
			valueAlpha = 0.65,
		})
	end

	for _, point in ipairs(points) do
		local frame = findFreeInteriorFrame(timeline, path, minFrame + (span * point.frameAlpha), minFrame, maxFrame, reservedFrames)
		if not frame then
			return false, string.format("%s could not find free space between frames %d and %d.", rampDisplayName(rampId), minFrame, maxFrame)
		end
		table.insert(inserted, {
			jointPath = path,
			frame = frame,
			value = interpolateValue(first.value, last.value, point.valueAlpha),
			easingStyle = rampEasingStyle(rampId),
			easingDirection = DEFAULT_DIRECTION,
		})
	end

	return true
end

local function buildRetimedRampKeys(timeline, path, list, selectedLookup, rampId, writes)
	local minFrame = list[1].frame
	local maxFrame = list[#list].frame
	local span = maxFrame - minFrame
	if span &lt;= 0 then
		return false, "Speed Ramp needs selected keyframes across a frame range."
	end

	local previousTarget = minFrame - 1
	for index, key in ipairs(list) do
		local sourceAlpha = (index - 1) / (#list - 1)
		local targetAlpha = speedRampTargetAlpha(sourceAlpha, rampId)
		local remaining = #list - index
		local rawFrame = roundFrame(minFrame + (span * targetAlpha))
		local minAllowed = previousTarget + 1
		local maxAllowed = maxFrame - remaining
		local targetFrame = math.clamp(rawFrame, minAllowed, maxAllowed)

		if timeline:hasTrackKeyframe(path, targetFrame)
			and not (selectedLookup[path] and selectedLookup[path][targetFrame]) then
			return false, string.format("%s would overwrite an unselected keyframe at frame %d.", rampDisplayName(rampId), targetFrame)
		end

		previousTarget = targetFrame
		table.insert(writes, {
			jointPath = path,
			sourceFrame = key.frame,
			frame = targetFrame,
			value = cloneValue(key.value),
			easingStyle = rampEasingStyle(rampId),
			easingDirection = DEFAULT_DIRECTION,
		})
	end

	return true
end

local function applySpeedRamp(timeline, keys, rampId)
	local values = timeline:getTrackKeyValues(keys)
	if #values &lt; 2 then
		return false, "Select at least two keyframes before applying a speed ramp.", keys
	end

	local spacingMessage = nil
	local spacingSuccess, expandedKeys, expandMessage = expandRampSelectionIfNeeded(timeline, values, keys, rampId)
	if not spacingSuccess then
		return false, expandMessage, keys
	end
	if expandMessage then
		keys = expandedKeys
		values = timeline:getTrackKeyValues(keys)
		spacingMessage = expandMessage
	end

	local selectedLookup = {}
	local groups = {}
	local order = {}
	for _, key in ipairs(values) do
		selectedLookup[key.jointPath] = selectedLookup[key.jointPath] or {}
		selectedLookup[key.jointPath][key.frame] = true
		if not groups[key.jointPath] then
			groups[key.jointPath] = {}
			table.insert(order, key.jointPath)
		end
		table.insert(groups[key.jointPath], key)
	end

	table.sort(order, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)

	local writes = {}
	for _, path in ipairs(order) do
		if type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(path) then
			return false, "Speed Ramp cannot update disabled tracks. Enable the selected tracks first.", keys
		end
		if type(timeline.getTrackByPath) == "function" and not timeline:getTrackByPath(path) then
			return false, "Speed Ramp found a selected keyframe on a missing track.", keys
		end

		local list = groups[path]
		table.sort(list, function(a, b)
			return a.frame &lt; b.frame
		end)

		if #list &lt; 2 then
			continue
		end

		local minFrame = list[1].frame
		local maxFrame = list[#list].frame
		if maxFrame &lt;= minFrame then
			continue
		end

		if #list == 2 then
			local success, message = appendInsertedRampKeys(timeline, path, list, rampId, writes)
			if not success then
				return false, message, keys
			end
		else
			local success, message = buildRetimedRampKeys(timeline, path, list, selectedLookup, rampId, writes)
			if not success then
				return false, message, keys
			end
		end
	end

	if #writes == 0 then
		return false, "Speed Ramp needs selected keyframes across a frame range.", keys
	end

	local shouldDeleteSelectedKeys = false
	for _, key in ipairs(writes) do
		if key.sourceFrame and key.sourceFrame ~= key.frame then
			shouldDeleteSelectedKeys = true
			break
		end
	end

	if shouldDeleteSelectedKeys then
		local deleteSuccess, deleteMessage = timeline:deleteTrackKeyframes(keys)
		if not deleteSuccess then
			return false, deleteMessage, keys
		end
	end

	local changed = {}
	for _, key in ipairs(writes) do
		local success, message = timeline:setTrackValueAtFrame(key.jointPath, key.frame, key.value, key.easingStyle, key.easingDirection)
		if not success then
			return false, message, changed
		end
		table.insert(changed, {
			jointPath = key.jointPath,
			frame = key.frame,
		})
	end

	if not shouldDeleteSelectedKeys then
		for _, key in ipairs(keys) do
			table.insert(changed, key)
		end
	end

	local prefix = spacingMessage and (spacingMessage .. " ") or ""
	return true, string.format("%sApplied %s timing to %d keyframe%s.", prefix, rampDisplayName(rampId), #changed, #changed == 1 and "" or "s"), changed
end

function AnimationEffectsService.apply(timeline, keyList, effectId, options)
	local keys = normalizeKeys(timeline, keyList)
	if #keys == 0 then
		return false, "Select one or more keyframes before applying an animation effect.", {}
	end

	if effectId == "StopMotion" or effectId == "StopMotionHold" then
		return setEasing(timeline, keys, "None", DEFAULT_DIRECTION, "Applied Stop Motion")
	elseif effectId == "StopMotion2" then
		return applyStopChunk(timeline, keys, 2)
	elseif effectId == "StopMotion4" then
		return applyStopChunk(timeline, keys, 4)
	elseif effectId == "StopMotion6" then
		return applyStopChunk(timeline, keys, 6)
	elseif effectId == "Linearize" then
		return setEasing(timeline, keys, "Linear", DEFAULT_DIRECTION, "Applied linear easing")
	elseif effectId == "KeyframeStagger" then
		return applyStagger(timeline, keys)
	elseif effectId == "OvershootSettle" then
		return setEasing(timeline, keys, "Back", DEFAULT_DIRECTION, "Applied overshoot/settle easing")
	elseif effectId == "LoopPolish" then
		return applyLoopPolish(timeline, keys)
	elseif effectId == "BoilFrames" then
		return applyBoilFrames(timeline, keys)
	elseif effectId == "PoseHold" then
		return applyPoseHold(timeline, keys)
	elseif effectId == "Wiggle" then
		return applyWiggle(timeline, keys, options)
	elseif effectId == "Reverse" then
		return applyReverse(timeline, keys)
	elseif effectId == "SlowMotion2" then
		return applySlowMotion(timeline, keys, 2)
	elseif effectId == "SpeedRampUp" or effectId == "SpeedRampDown" or effectId == "SpeedRampInOut" or effectId == "SpeedRampOutIn" then
		return applySpeedRamp(timeline, keys, effectId)
	end

	return false, "Unknown animation effect: " .. tostring(effectId), keys
end

return AnimationEffectsService
</ProtectedString>
        </Properties>
