          <Properties>
            <string name="Name">MicroMain</string>
            <ProtectedString name="Source">local MicroWidgetController = require(script.Parent:WaitForChild("MicroWidgetController"))
local TrackballDebugService = require(script.Parent.Parent:WaitForChild("TrackballDebugService"))

local MicroMain = {}

local function buildMicroTrackballSelectionFromKeys(deps)
	if type(deps) ~= "table" or type(deps.getTimeline) ~= "function" or type(deps.getSelectedKeyRefs) ~= "function" then
		return nil, 0
	end

	local timeline = deps.getTimeline()
	local selectedKeys = deps.getSelectedKeyRefs() or {}
	if not timeline or type(selectedKeys) ~= "table" or #selectedKeys &lt; 2 then
		return nil, type(selectedKeys) == "table" and #selectedKeys or 0
	end

	local sharedFrame = math.max(0, math.floor(tonumber(selectedKeys[1].frame) or 0))
	local selectedPaths = {}
	local seenPaths = {}
	for _, keyRef in ipairs(selectedKeys) do
		local jointPath = keyRef and keyRef.jointPath
		local frame = math.max(0, math.floor(tonumber(keyRef and keyRef.frame) or 0))
		if frame ~= sharedFrame then
			return nil, #selectedKeys
		end
		if type(jointPath) ~= "string" or type(timeline.getMotorByPath) ~= "function" or not timeline:getMotorByPath(jointPath) then
			return nil, #selectedKeys
		end
		if not seenPaths[jointPath] then
			seenPaths[jointPath] = true
			table.insert(selectedPaths, jointPath)
		end
	end

	if #selectedPaths &lt; 2 then
		return nil, #selectedKeys
	end

	return {
		paths = selectedPaths,
		frame = sharedFrame,
	}, #selectedKeys
end

local function buildMicroTrackballSelectionFromTracks(deps)
	if type(deps) ~= "table" or type(deps.getTimeline) ~= "function" or type(deps.getSelectedTrackPaths) ~= "function" then
		return nil, 0
	end

	local timeline = deps.getTimeline()
	local selectedTracks = deps.getSelectedTrackPaths() or {}
	if not timeline or type(selectedTracks) ~= "table" or #selectedTracks == 0 then
		return nil, type(selectedTracks) == "table" and #selectedTracks or 0
	end

	local selectedPaths = {}
	local seenPaths = {}
	local function addRigPath(path)
		if type(path) ~= "string" or seenPaths[path] then
			return
		end
		if type(timeline.getMotorByPath) == "function" and timeline:getMotorByPath(path) then
			seenPaths[path] = true
			table.insert(selectedPaths, path)
		end
	end

	for _, trackPath in ipairs(selectedTracks) do
		local track = type(timeline.getTrackByPath) == "function" and timeline:getTrackByPath(trackPath) or nil
		if track and track.trackType == "Rig Group" and track.rigName and type(timeline.getRigTrackPaths) == "function" then
			for _, rigPath in ipairs(timeline:getRigTrackPaths(track.rigName) or {}) do
				addRigPath(rigPath)
			end
		else
			addRigPath(trackPath)
		end
	end

	if #selectedPaths &gt; 1 then
		return {
			paths = selectedPaths,
			frame = type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or 0,
		}, #selectedTracks
	elseif #selectedPaths == 1 then
		return {
			path = selectedPaths[1],
			frame = type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or 0,
		}, #selectedTracks
	end

	return nil, #selectedTracks
end

function MicroMain.attach(deps)
	deps = deps or {}
	local editorActions = deps.editorActions
	if type(editorActions) ~= "table" then
		return nil
	end
	TrackballDebugService.setEnabled(false, "Micro")
	TrackballDebugService.log("MicroMain", "attach", "Micro Trackball diagnostics enabled")

	local function runEditorAction(actionName, ...)
		local action = editorActions[actionName]
		if type(action) == "function" then
			return action(...)
		end
		return nil, tostring(actionName or "Action") .. " is not available yet."
	end

	local options = {
		plugin = deps.plugin,
		toolbar = deps.toolbar,
		constants = deps.constants,
		getTimeline = deps.getTimeline,
		getIsPlaying = deps.getIsPlaying,
		getPlaybackFrame = deps.getPlaybackFrame,
		getEditorState = deps.getEditorState,
		getSelectedTrackPaths = deps.getSelectedTrackPaths,
		getSelectedKeyRefs = deps.getSelectedKeyRefs,
		onPreviewScrubToFrame = deps.onPreviewScrubToFrame,
		onScrubToFrame = deps.onScrubToFrame,
		onAddKeyframe = deps.onAddKeyframe,
		onCaptureFrame = deps.onCaptureFrame or function(...)
			return runEditorAction("captureFrame", ...)
		end,
		onCaptureTrackFrame = deps.onCaptureTrackFrame or function(...)
			return runEditorAction("captureTrackFrame", ...)
		end,
		onSelectKeySet = deps.onSelectKeySet or function(...)
			return runEditorAction("selectKeySet", ...)
		end,
		onToggleKeySet = deps.onToggleKeySet or function(...)
			return runEditorAction("toggleKeySet", ...)
		end,
		onToggleKeySelection = function(...)
			return runEditorAction("toggleKeySelection", ...)
		end,
		onSelectKey = deps.onSelectKey or function(...)
			return runEditorAction("selectKey", ...)
		end,
		onSelectKeysInBox = function(...)
			return runEditorAction("selectKeysInBox", ...)
		end,
		onMoveKeyToFrame = deps.onMoveKeyToFrame or function(...)
			return runEditorAction("moveKeyToFrame", ...)
		end,
		onMoveSelectedKeysByOffset = deps.onMoveSelectedKeysByOffset or function(...)
			return runEditorAction("moveSelectedKeysByOffset", ...)
		end,
		onMoveKeyRefsByOffset = deps.onMoveKeyRefsByOffset or function(...)
			return runEditorAction("moveKeyRefsByOffset", ...)
		end,
		onToggleTrackEnabled = deps.onToggleTrackEnabled or function(...)
			return runEditorAction("toggleTrackEnabled", ...)
		end,
		onRemoveSelectedTrack = deps.onRemoveSelectedTrack or function(...)
			return runEditorAction("removeSelectedTrack", ...)
		end,
		onBindRig = deps.onBindRig,
		onBindMotionRig = deps.onBindMotionRig,
		onInsertDefaultRig = deps.onInsertDefaultRig,
		onInsertAvatarRig = deps.onInsertAvatarRig,
		getMotionBuilderViewModel = deps.getMotionBuilderViewModel,
		onAddMotionMarker = deps.onAddMotionMarker,
		onDeleteMotionMarker = deps.onDeleteMotionMarker,
		onSelectMotionMarker = deps.onSelectMotionMarker,
		onClearMotionMarkers = deps.onClearMotionMarkers,
		onPreviewMotionPath = deps.onPreviewMotionPath,
		onPreviewMotionSegment = deps.onPreviewMotionSegment,
		onStopMotionPreview = deps.onStopMotionPreview,
		onCreateMotionAnimation = deps.onCreateMotionAnimation,
		onSetMotionSegmentMotion = deps.onSetMotionSegmentMotion,
		onSetMotionSegmentClip = deps.onSetMotionSegmentClip,
		onSetMotionDefaultClip = deps.onSetMotionDefaultClip,
		onSetMotionSegmentPauseIdle = deps.onSetMotionSegmentPauseIdle,
		onSetMotionSegmentDuration = deps.onSetMotionSegmentDuration,
		onSetMotionSegmentPause = deps.onSetMotionSegmentPause,
		onSetMotionSegmentBlend = deps.onSetMotionSegmentBlend,
		onResetMotionSegments = deps.onResetMotionSegments,
		onPlay = deps.onPlay,
		onStop = deps.onStop,
		onPlayPause = deps.onPlayPause or function(...)
			return runEditorAction("playPause", ...)
		end,
		onPausePlaybackAtCurrent = deps.onPausePlaybackAtCurrent,
		onToggleCameraTrackEnabled = deps.onToggleCameraTrackEnabled or function(...)
			return runEditorAction("toggleCameraTrackEnabled", ...)
		end,
		onStepTimelineFrame = deps.onStepTimelineFrame or function(...)
			return runEditorAction("stepTimelineFrame", ...)
		end,
		onPreviousKeyframe = deps.onPreviousKeyframe or function(...)
			return runEditorAction("previousKeyframe", ...)
		end,
		onNextKeyframe = deps.onNextKeyframe or function(...)
			return runEditorAction("nextKeyframe", ...)
		end,
		onOpenFull = deps.onOpenFull,
		onOpenMicro = deps.onOpenMicro,
		onCloseMicro = deps.onCloseMicro,
		getFacesViewModel = deps.getFacesViewModel,
		getEffectsViewModel = deps.getEffectsViewModel,
		onFacesAction = deps.onFacesAction,
		onSelectTrack = deps.onSelectTrack or function(...)
			return runEditorAction("selectTrack", ...)
		end,
		onSetMicroMultiSelectLocked = function(isLocked)
			editorActions._microMultiSelectLocked = isLocked == true
			return true, editorActions._microMultiSelectLocked and "Micro Multi Select On" or "Micro Multi Select Off"
		end,
		onSelectRigInStudio = function(...)
			return runEditorAction("selectRigInStudio", ...)
		end,
		onAddTrack = function(...)
			return runEditorAction("addTrack", ...)
		end,
		onBakePreview = deps.onBakePreview or function(...)
			return runEditorAction("bakePreview", ...)
		end,
		onCaptureCameraTrack = function(...)
			return runEditorAction("captureCameraTrackAtPlayhead", ...)
		end,
		onApplyCameraPreset = function(...)
			return runEditorAction("applyCameraPreset", ...)
		end,
		onEnsureCameraFovTrack = function(...)
