	local function followOptionControl(labelText, control)
		local cell = create("Frame", {
			Parent = cameraFollowOptionsFrame,
			BackgroundTransparency = 1,
			ZIndex = 121,
		})
		create("TextLabel", {
			Parent = cell,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.new(0, 72, 1, 0),
			Font = Enum.Font.Gotham,
			Text = labelText,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 122,
		})
		control.Parent = cell
		control.Position = UDim2.new(0, 74, 0, 0)
		control.Size = UDim2.new(1, -74, 1, 0)
		return control
	end
