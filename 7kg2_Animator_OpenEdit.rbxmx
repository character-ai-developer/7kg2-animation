        <Item class="ModuleScript" referent="RBX89">
          <Properties>
            <string name="Name">MicroShiftSelectionSupport</string>
            <ProtectedString name="Source">local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")

local WidgetMathSupport = require(script.Parent.Parent:WaitForChild("WidgetMathSupport"))

local MicroShiftSelectionSupport = {}
MicroShiftSelectionSupport.__index = MicroShiftSelectionSupport

local ACTION_NAME = "MegMoAnimatorMicroShiftSelection"
local PRIORITY = Enum.ContextActionPriority.High.Value + 1200
local SHIFT_GRACE_SECONDS = 0.35

local function isShiftKey(keyCode)
	return WidgetMathSupport.isShiftKey(keyCode)
end

local function isShiftKeyString(key)
	return WidgetMathSupport.isShiftKeyString(key)
end

local function readShiftDown()
	return WidgetMathSupport.isShiftDown(UserInputService)
end

function MicroShiftSelectionSupport.new(options)
	options = options or {}
	return setmetatable({
		_connections = {},
		_graceUntil = 0,
		_held = false,
		_isActive = options.isActive or function()
			return true
		end,
		_plugin = options.plugin,
	}, MicroShiftSelectionSupport)
end

function MicroShiftSelectionSupport:_connect(signal, callback)
	if not signal then
		return
	end
	self._connections[#self._connections + 1] = signal:Connect(callback)
end

function MicroShiftSelectionSupport:_observe(isHeld)
	if isHeld then
		self._held = true
		self._graceUntil = os.clock() + SHIFT_GRACE_SECONDS
	else
		self._held = false
		self._graceUntil = os.clock() + SHIFT_GRACE_SECONDS
	end
end

function MicroShiftSelectionSupport:observeKeyCode(keyCode, isHeld)
	if not isShiftKey(keyCode) then
		return false
	end
	self:_observe(isHeld == true)
	return true
end

function MicroShiftSelectionSupport:observePluginKey(key, isHeld)
	if not isShiftKeyString(key) then
		return false
	end
	self:_observe(isHeld == true)
	return true
end

function MicroShiftSelectionSupport:isHeld()
	return self._held or readShiftDown() or os.clock() &lt;= (self._graceUntil or 0)
end

function MicroShiftSelectionSupport:clear()
	self._held = false
	self._graceUntil = 0
end

function MicroShiftSelectionSupport:start()
	if self._started then
		return
	end
	self._started = true

	self:_connect(UserInputService.InputBegan, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.Keyboard then
			self:observeKeyCode(inputObject.KeyCode, true)
		end
	end)
	self:_connect(UserInputService.InputEnded, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.Keyboard then
			self:observeKeyCode(inputObject.KeyCode, false)
		end
	end)
	self:_connect(UserInputService.WindowFocusReleased, function()
		self:clear()
	end)

	pcall(function()
		ContextActionService:UnbindAction(ACTION_NAME)
		ContextActionService:BindActionAtPriority(
			ACTION_NAME,
			function(_, inputState, inputObject)
				if inputObject.UserInputType ~= Enum.UserInputType.Keyboard or not isShiftKey(inputObject.KeyCode) then
					return Enum.ContextActionResult.Pass
				end
				if not self._isActive() then
					if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
						self:clear()
					end
					return Enum.ContextActionResult.Pass
				end
				if inputState == Enum.UserInputState.Begin then
					self:observeKeyCode(inputObject.KeyCode, true)
				elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
					self:observeKeyCode(inputObject.KeyCode, false)
				end
				return Enum.ContextActionResult.Pass
			end,
			false,
			PRIORITY,
			Enum.KeyCode.LeftShift,
			Enum.KeyCode.RightShift
		)
	end)

	local pluginMouse
	if pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end) and pluginMouse then
		self:_connect(pluginMouse.KeyDown, function(key)
			self:observePluginKey(key, true)
		end)
		self:_connect(pluginMouse.KeyUp, function(key)
			self:observePluginKey(key, false)
		end)
	end
end

function MicroShiftSelectionSupport:destroy()
	pcall(function()
		ContextActionService:UnbindAction(ACTION_NAME)
	end)
	for _, connection in ipairs(self._connections) do
		if connection then
			connection:Disconnect()
		end
	end
	self._connections = {}
	self._started = false
	self:clear()
end

return MicroShiftSelectionSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX90">
          <Properties>
            <string name="Name">MicroViewportButtonStyleSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiMotion = require(script.Parent.Parent:WaitForChild("UiMotion"))

local MicroViewportButtonStyleSupport = {}

local function currentTheme()
	local theme = ThemeService.getCurrentTheme()
	return (theme and theme.colors) or Constants.THEME
end

local function findOrCreateStroke(button)
	local stroke = button:FindFirstChild("MegMoButtonStroke")
	if stroke and stroke:IsA("UIStroke") then
		return stroke
	end
	for _, child in ipairs(button:GetChildren()) do
		if child:IsA("UIStroke") then
			return child
		end
	end
	stroke = Instance.new("UIStroke")
	stroke.Name = "MegMoButtonStroke"
	stroke.Parent = button
	return stroke
end

function MicroViewportButtonStyleSupport.apply(button, options)
	if not (button and button:IsA("GuiButton")) then
		return nil
	end
	options = options or {}
	button.AutoButtonColor = false
	UiMotion.attachButtonEffect(button, {
		hoverScale = options.hoverScale or 1.035,
		clickScale = options.clickScale or 0.94,
	})

	local stroke = findOrCreateStroke(button)
	local baseTransparency = options.baseTransparency or 0.28
	local hoverTransparency = options.hoverTransparency or 0.06
	local baseThickness = options.baseThickness or 1.25
	local hoverThickness = options.hoverThickness or 1.65
	stroke.Color = options.strokeColor or currentTheme().Accent
	stroke.Transparency = baseTransparency
	stroke.Thickness = baseThickness
	stroke:SetAttribute("MegMoThemeStrokeRole", options.strokeRole or "Accent")
	pcall(function()
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end)

	button.MouseEnter:Connect(function()
		stroke.Transparency = hoverTransparency
		stroke.Thickness = hoverThickness
	end)
	button.MouseLeave:Connect(function()
		stroke.Transparency = baseTransparency
		stroke.Thickness = baseThickness
	end)
	return stroke
end

return MicroViewportButtonStyleSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX91">
          <Properties>
            <string name="Name">MicroViewportEditButtonsSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local MicroViewportButtonStyleSupport = require(script.Parent:WaitForChild("MicroViewportButtonStyleSupport"))

local MicroViewportEditButtonsSupport = {}

local EDIT_BUTTONS = {
	{
		name = "Copy",
		image = "rbxassetid://72638816901788",
		callbackName = "onCopyKeys",
		fallbackActionName = "copySelectedKeys",
		status = "Copied selected keyframes.",
		tooltip = "Copy selected keyframes",
	},
	{
		name = "Paste",
		image = "rbxassetid://107691948133987",
		callbackName = "onPasteKeys",
		fallbackActionName = "pasteKeysAtPlayhead",
