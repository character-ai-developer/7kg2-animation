local addSelectedRigs

local function ensureMotionBuilderRigBound()
	local targetRigName = editorActions.getImportTargetRigName()
	local selectedRig = SelectionService.getSelectedRig and SelectionService.getSelectedRig() or nil
	if selectedRig and selectedRig.Parent and timeline:getRigByName(selectedRig.Name) then
		timeline:setActiveRig(selectedRig.Name)
	elseif selectedRig and selectedRig.Parent and not timeline:getRigByName(selectedRig.Name) then
		local bindSuccess, bindMessage = addSelectedRigs(true)
		if not bindSuccess then
			refreshUi(bindMessage)
			return false, bindMessage
		end
	elseif targetRigName and timeline:getRigByName(targetRigName) then
		timeline:setActiveRig(targetRigName)
	end

	local activeRig = timeline:getRig()
	if not activeRig or not activeRig.Parent then
		local message = "Select or add the rig you want Motion Builder to animate."
		refreshUi(message)
		return false, message
	end

	return true, nil
end

local function motionServiceDeps()
	return require(Modules:WaitForChild("MotionServiceDependencySupport")).buildDeps({
		timeline = timeline,
		selectionService = SelectionService,
		getRigInsertCFrame = getRigInsertCFrame,
		pushUndo = pushUndo,
		popUndo = function()
			historyService:discardPendingUndo()
		end,
		setSingleSelectedTrack = setSingleSelectedTrack,
		refreshUi = refreshUi,
		gizmoController = gizmoController,
		stopPlayback = function()
			if playbackService and playbackService:getIsPlaying() then
				playbackService:stop("Stopped timeline playback before Motion Builder preview.", playbackService:getPlaybackFrame())
			end
		end,
		ensureMotionBuilderRig = ensureMotionBuilderRigBound,
	})
end

local function yieldStudioViewportControlForMotionBuilder()
	widgetController._motionBuilderSuspendedViewportPicker = true
	editorActions.suspendViewportRigPartPicker("Motion Builder workspace.")
	task.defer(function()
		if widgetController._motionBuilderSuspendedViewportPicker == true then
			widgetController._viewportPartPickerArmed = false
			widgetController._viewportPartPickerSuspended = true
			widgetController._rigPartHighlightEnabled = false
			pcall(function()
				toggleButton:SetActive(false)
			end)
			pcall(function()
				plugin:Deactivate()
			end)
		end
	end)
end

local function runMotionMarkerAction(action)
	local results = table.pack(action())
	yieldStudioViewportControlForMotionBuilder()
	return table.unpack(results, 1, results.n)
end

