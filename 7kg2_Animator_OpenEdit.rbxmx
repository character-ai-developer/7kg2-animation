local function createCategoryStroke(parent, accent, transparency)
	local stroke = createStroke(parent, accent, 1)
	stroke.Transparency = transparency or 0.5
	return stroke
end

local function flattenButtonSurface(button)
	if not button then
		return
	end
	local gradientOverlay = button:FindFirstChild("MegMoButtonGradientOverlay")
	if gradientOverlay and gradientOverlay:IsA("GuiObject") then
		gradientOverlay.Visible = false
	end
end

local function createHeaderLabel(parent, text, y, size, x, widthOffset, textColor)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, x or 22, 0, y),
		Size = UDim2.new(1, -(widthOffset or 44), 0, size or 24),
		Font = Enum.Font.GothamSemibold,
		Text = text,
		TextColor3 = textColor or Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 132,
	})
end

local function createDescriptionLabel(parent, text, y, x, widthOffset)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, x or 22, 0, y),
		Size = UDim2.new(1, -(widthOffset or 44), 0, 36),
		Font = Enum.Font.GothamSemibold,
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 132,
	})
end

local function createBackButton(parent, y, width, accent)
	local button = create("TextButton", {
		Parent = parent,
		Position = UDim2.new(0, 22, 0, y or 18),
		Size = UDim2.new(0, width or 96, 0, 32),
		Text = "&lt; Back",
		ZIndex = 133,
	})
	styleGhostButton(button)
	if accent then
		button.BackgroundColor3 = accent:Lerp(Constants.THEME.PanelSoft, 0.78)
		button.TextColor3 = accent
		local stroke = button:FindFirstChild("MegMoButtonStroke")
		if stroke and stroke:IsA("UIStroke") then
			stroke.Color = accent
			stroke.Transparency = 0.38
			stroke:SetAttribute("MegMoThemeStrokeRole", nil)
		end
	end
	createCorner(button, 9)
	return button
end

local function createEffectRow(parent, effect, order, buttonText, accent, flatStyle, compact)
	accent = accent or Constants.THEME.Accent
	local row = create("Frame", {
		Parent = parent,
		BackgroundColor3 = flatStyle and Constants.THEME.PanelAlt or accent:Lerp(Constants.THEME.PanelAlt, 0.9),
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, compact and 62 or flatStyle and 66 or 74),
		ZIndex = 133,
	})
	if not flatStyle then
		applySectionSurface(row)
	end
	createCorner(row, flatStyle and 5 or 12)
	local rowStroke = createCategoryStroke(row, flatStyle and Constants.THEME.Border or accent, flatStyle and 0.58 or 0.5)
	if flatStyle then
		rowStroke.Thickness = 1
	end

	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, compact and 12 or 16, 0, flatStyle and 8 or 12),
		Size = UDim2.new(1, compact and -142 or -196, 0, 20),
		Font = flatStyle and Enum.Font.GothamBold or Enum.Font.GothamSemibold,
		Text = effect.name,
		TextColor3 = Constants.THEME.Text,
		TextSize = compact and 13 or flatStyle and 14 or 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 134,
	})

	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, compact and 12 or 16, 0, flatStyle and 29 or 34),
		Size = UDim2.new(1, compact and -142 or -196, 0, flatStyle and 25 or 28),
		Font = Enum.Font.GothamSemibold,
		Text = effect.description,
		TextColor3 = Constants.THEME.Text,
		TextSize = flatStyle and 11 or 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 134,
	})

	local button = create("TextButton", {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, compact and -10 or -14, 0.5, 0),
		Size = UDim2.new(0, compact and 108 or flatStyle and 136 or 150, 0, flatStyle and 32 or 34),
		Text = buttonText or effect.name,
		ZIndex = 134,
	})
	if effect.primary then
		styleTextButton(button, accent)
	else
		styleGhostButton(button)
		button.BackgroundColor3 = accent:Lerp(Constants.THEME.PanelSoft, 0.82)
		button.TextColor3 = Constants.THEME.Text
		local buttonStroke = button:FindFirstChild("MegMoButtonStroke")
		if buttonStroke and buttonStroke:IsA("UIStroke") then
			buttonStroke.Color = accent
			buttonStroke.Transparency = 0.4
			buttonStroke:SetAttribute("MegMoThemeStrokeRole", nil)
		end
	end
	createCorner(button, flatStyle and 5 or 9)
	if flatStyle then
		flattenButtonSurface(button)
		local buttonStroke = button:FindFirstChild("MegMoButtonStroke")
		if buttonStroke and buttonStroke:IsA("UIStroke") then
			buttonStroke.Color = effect.primary and accent or Constants.THEME.Border
			buttonStroke.Transparency = effect.primary and 0.2 or 0.5
			buttonStroke.Thickness = 1
		end
	end

	return button
end

local function createPlaceholderRow(parent, effect, order)
	local row = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 72),
		ZIndex = 133,
	})
	applySectionSurface(row)
	createCorner(row, 12)
	createStroke(row, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(1, -140, 0, 20),
		Font = Enum.Font.GothamSemibold,
		Text = effect.name,
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 134,
	})

	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 34),
		Size = UDim2.new(1, -140, 0, 28),
		Font = Enum.Font.GothamSemibold,
		Text = effect.description,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 134,
	})

	local badge = create("TextLabel", {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 104, 0, 30),
		Font = Enum.Font.GothamSemibold,
		Text = "Coming Soon",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		ZIndex = 134,
	})
	createCorner(badge, 9)
end

local function createDetailScroll(parent, topOffset)
	local scroll = create("ScrollingFrame", {
		Parent = parent,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 22, 0, topOffset or 106),
		Size = UDim2.new(1, -44, 1, -(topOffset or 106) - 18),
		ScrollBarThickness = 6,
		ZIndex = 132,
	})
	create("UIListLayout", {
		Parent = scroll,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = scroll,
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 8),
	})
	return scroll
end

local function createCompactCameraInput(parent, labelText, defaultText, order)
	local field = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		ZIndex = 133,
	})

	create("TextLabel", {
		Parent = field,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		Text = labelText,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 134,
	})
	create("TextLabel", {
		Parent = field,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 14, 0, 14),
		Font = Enum.Font.GothamBold,
		Text = "?",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		ZIndex = 134,
	})

	local input = create("TextBox", {
		Parent = field,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		Font = Enum.Font.Gotham,
		PlaceholderText = defaultText or "",
		Text = defaultText or "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 134,
	})
	createCorner(input, 8)
	createStroke(input)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	return input, field
end

local function createCompactCameraButton(parent, labelText, text, order)
	local field = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		ZIndex = 133,
	})

	create("TextLabel", {
		Parent = field,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		Text = labelText,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 134,
	})
	create("TextLabel", {
		Parent = field,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 14, 0, 14),
		Font = Enum.Font.GothamBold,
		Text = "?",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		ZIndex = 134,
	})

	local button = create("TextButton", {
		Parent = field,
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		Text = text,
		ZIndex = 134,
	})
	styleGhostButton(button)
	createCorner(button, 8)
	return button, field
end

function EffectsUI.mount(parent, context)
	if not parent then
		error("EffectsUI.mount requires parent")
	end
	context = context or {}
	local embeddedPopup = context.embeddedPopup == true
	local flatMain = not embeddedPopup
	local flatStyle = flatMain or embeddedPopup
	local categoryRailWidth = embeddedPopup and 172 or 226
	local hideHeader = context.hideHeader == true
	local hideCloseButton = context.hideCloseButton == true
	local topOffset = hideHeader and -56 or 0
	local compactPageOffset = embeddedPopup and -40 or 0
	local embeddedBackButtonY = embeddedPopup and 10 or 18
	local embeddedBackButtonWidth = embeddedPopup and 84 or 96
	local embeddedHeaderY = embeddedPopup and 46 or 60
	local embeddedDescriptionY = embeddedPopup and 72 or 88
	local embeddedHeaderX = embeddedPopup and 118 or 22
	local embeddedHeaderWidthOffset = embeddedPopup and 140 or 44

	local refs = {}
	local pages = {}
	local categoryButtons = {}

	local overlay = create("Frame", {
		Name = "EffectsOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = embeddedPopup and 1 or 0.24,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 128,
	})

	local card = create("Frame", {
		Name = "EffectsCard",
		Parent = overlay,
		AnchorPoint = embeddedPopup and Vector2.new(0, 0) or Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = embeddedPopup and UDim2.fromOffset(0, 0) or UDim2.fromScale(0.5, 0.52),
		Size = embeddedPopup and UDim2.fromScale(1, 1) or UDim2.new(0.72, 0, 0.66, 0),
		ZIndex = 129,
	})
	if embeddedPopup then
		card.BackgroundColor3 = Constants.THEME.Panel
	else
		create("UISizeConstraint", {
			Parent = card,
			MinSize = Vector2.new(720, 500),
			MaxSize = Vector2.new(1040, 620),
		})
		createCorner(card, 8)
		local cardStroke = createStroke(card, Constants.THEME.Border, 1)
		cardStroke.Transparency = 0.38
	end

	local titleLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 18 + topOffset),
		Size = UDim2.new(1, -80, 0, 26),
		Font = Enum.Font.GothamBold,
		Text = "Effects",
		TextColor3 = Constants.THEME.Text,
		TextSize = flatMain and 21 or 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 130,
	})
	titleLabel.Visible = not hideHeader

	local descriptionLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 48 + topOffset),
		Size = UDim2.new(1, -80, 0, 34),
		Font = Enum.Font.GothamSemibold,
		Text = "Choose an effect category, then pick the effect you want to add or apply.",
		TextColor3 = Constants.THEME.Text,
		TextSize = flatMain and 13 or 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 130,
	})
	descriptionLabel.Visible = not hideHeader

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 18 + topOffset),
		Size = UDim2.new(0, 34, 0, 34),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "X",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		ZIndex = 131,
	})
	createCorner(closeButton, flatMain and 5 or 10)
	if flatMain then
		local closeStroke = createStroke(closeButton, Constants.THEME.Border, 1)
		closeStroke.Transparency = 0.46
	end
	closeButton.Visible = not hideCloseButton

	local pageHost = create("Frame", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 86 + topOffset),
		Size = UDim2.new(1, 0, 1, -(86 + topOffset)),
		ZIndex = 131,
	})

	local function showPage(pageId)
		if flatStyle then
			local selectedPageId = pageId == "Categories" and "Animation" or pageId
			for id, page in pairs(pages) do
				page.Visible = id == "Categories" or id == selectedPageId
			end
			for id, entry in pairs(categoryButtons) do
				local selected = id == selectedPageId
				entry.button.BackgroundColor3 = selected
					and entry.accent:Lerp(Constants.THEME.PanelAlt, 0.82)
					or Constants.THEME.PanelSoft
				entry.stroke.Color = selected and entry.accent or Constants.THEME.Border
				entry.stroke.Transparency = selected and 0.08 or 0.58
				entry.stroke.Thickness = selected and 1.5 or 1
			end
		else
			for id, page in pairs(pages) do
				page.Visible = id == pageId
			end
		end
	end

	local categoryPage = create("Frame", {
		Parent = pageHost,
		BackgroundColor3 = flatStyle and Constants.THEME.PanelAlt or Constants.THEME.Panel,
		BackgroundTransparency = flatStyle and 0 or 1,
		Size = flatStyle and UDim2.new(0, categoryRailWidth, 1, 0) or UDim2.fromScale(1, 1),
		Visible = true,
		ZIndex = 131,
	})
	pages.Categories = categoryPage

	local categoryLabel =
		createDescriptionLabel(categoryPage, flatStyle and "CATEGORIES" or "Choose a category", 2 + compactPageOffset, 22, 44)
	if flatStyle then
		categoryLabel.Position = UDim2.new(0, embeddedPopup and 12 or 16, 0, embeddedPopup and 8 or 16)
		categoryLabel.Size = UDim2.new(1, embeddedPopup and -24 or -32, 0, 18)
		categoryLabel.Font = Enum.Font.GothamBold
		categoryLabel.TextColor3 = Constants.THEME.MutedText
		categoryLabel.TextSize = 11
		categoryLabel.TextYAlignment = Enum.TextYAlignment.Center
	end

	local categoryGrid = create("Frame", {
		Parent = categoryPage,
		BackgroundTransparency = 1,
		Position = flatStyle and UDim2.new(0, embeddedPopup and 8 or 12, 0, embeddedPopup and 34 or 46)
			or UDim2.new(0, 22, 0, 52 + compactPageOffset),
		Size = flatStyle and UDim2.new(1, embeddedPopup and -16 or -24, 1, embeddedPopup and -42 or -58)
			or UDim2.new(1, -44, 1, -(70 + compactPageOffset)),
		ZIndex = 132,
	})
	local categoryLayout = create("UIGridLayout", {
		Parent = categoryGrid,
		CellPadding = flatStyle and UDim2.new(0, 0, 0, embeddedPopup and 6 or 8) or UDim2.new(0, 10, 0, 10),
		CellSize = flatStyle and UDim2.new(1, 0, 0, embeddedPopup and 46 or 64)
			or UDim2.new(0.5, -5, 0, embeddedPopup and 92 or 104),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	if flatStyle then
		categoryLayout.FillDirectionMaxCells = 1
	end

	for index, category in ipairs(CATEGORY_DEFINITIONS) do
		local button = create("TextButton", {
			Parent = categoryGrid,
			AutoButtonColor = true,
			BackgroundColor3 = flatStyle and Constants.THEME.PanelSoft or category.accent:Lerp(Constants.THEME.PanelAlt, 0.92),
			BorderSizePixel = 0,
			LayoutOrder = index,
			Text = "",
			ZIndex = 132,
		})
		createCorner(button, flatStyle and 5 or 8)
		local categoryStroke = create("UIStroke", {
			Parent = button,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = flatStyle and Constants.THEME.Border or category.accent,
			Thickness = 1,
			Transparency = flatStyle and 0.58 or 0.48,
		})
		categoryButtons[category.id] = {
			button = button,
			stroke = categoryStroke,
			accent = category.accent,
		}

		local iconBackground = create("Frame", {
			Parent = button,
			BackgroundColor3 = category.accent:Lerp(Constants.THEME.PanelAlt, 0.72),
			BorderSizePixel = 0,
			Position = UDim2.new(0, embeddedPopup and 8 or flatMain and 10 or 14, 0.5, embeddedPopup and -15 or flatMain and -17 or -20),
			Size = UDim2.fromOffset(embeddedPopup and 30 or flatMain and 34 or 40, embeddedPopup and 30 or flatMain and 34 or 40),
			ZIndex = 133,
		})
		createCorner(iconBackground, flatStyle and 5 or 8)

		create("ImageLabel", {
			Parent = iconBackground,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(embeddedPopup and 6 or flatMain and 7 or 8, embeddedPopup and 6 or flatMain and 7 or 8),
			Size = UDim2.fromOffset(embeddedPopup and 18 or flatMain and 20 or 24, embeddedPopup and 18 or flatMain and 20 or 24),
			Image = category.icon,
			ImageColor3 = category.accent,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 134,
		})

		create("TextLabel", {
			Parent = button,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, embeddedPopup and 46 or flatMain and 54 or 64, 0.5, embeddedPopup and -10 or flatMain and -17 or -22),
			Size = UDim2.new(1, embeddedPopup and -54 or flatMain and -64 or -92, 0, 20),
			Font = flatStyle and Enum.Font.GothamBold or Enum.Font.GothamSemibold,
			Text = category.name,
			TextColor3 = Constants.THEME.Text,
			TextSize = embeddedPopup and 12 or flatMain and 13 or 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 133,
		})

		local categorySummary = create("TextLabel", {
			Parent = button,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, flatMain and 54 or 64, 0.5, flatMain and 3 or 2),
			Size = UDim2.new(1, flatMain and -64 or -92, 0, flatMain and 24 or 34),
			Font = Enum.Font.GothamSemibold,
			Text = category.shortDescription,
			TextColor3 = Constants.THEME.Text,
			TextSize = flatMain and 11 or 12,
			TextTruncate = Enum.TextTruncate.None,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 133,
		})
		categorySummary.Visible = not embeddedPopup

		create("TextLabel", {
			Parent = button,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(16, 24),
			Font = Enum.Font.GothamBold,
			Text = flatStyle and "" or "&gt;",
			TextColor3 = category.accent,
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 133,
		})

		button.Activated:Connect(function()
			showPage(category.id)
		end)
	end

	for _, category in ipairs(CATEGORY_DEFINITIONS) do
		local page = create("Frame", {
			Parent = pageHost,
			BackgroundColor3 = flatStyle and Constants.THEME.Panel or category.accent:Lerp(Constants.THEME.Panel, 0.88),
			BackgroundTransparency = 0,
			Position = flatStyle and UDim2.new(0, categoryRailWidth, 0, 0) or UDim2.fromOffset(0, 0),
			Size = flatStyle and UDim2.new(1, -categoryRailWidth, 1, 0) or UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 131,
		})
		pages[category.id] = page

		local backButton = createBackButton(page, embeddedBackButtonY, embeddedBackButtonWidth, category.accent)
		backButton.Visible = not flatStyle
		backButton.Activated:Connect(function()
			showPage("Categories")
		end)

		local headerLabel = createHeaderLabel(
			page,
			category.name,
			flatStyle and (embeddedPopup and 8 or 14) or embeddedHeaderY + compactPageOffset,
			24,
			flatStyle and (embeddedPopup and 14 or 20) or embeddedHeaderX,
			flatStyle and (embeddedPopup and 78 or 108) or embeddedHeaderWidthOffset,
			flatStyle and Constants.THEME.Text or category.accent
		)
		if flatStyle then
			headerLabel.Font = Enum.Font.GothamBold
			headerLabel.TextSize = embeddedPopup and 17 or 20
		end
		local pageDescription = createDescriptionLabel(
			page,
			category.description,
			flatStyle and (embeddedPopup and 34 or 43) or embeddedDescriptionY + compactPageOffset,
			flatStyle and (embeddedPopup and 14 or 20) or embeddedHeaderX,
			flatStyle and (embeddedPopup and 78 or 108) or embeddedHeaderWidthOffset
		)
		if flatStyle then
			pageDescription.TextSize = embeddedPopup and 11 or 12
		end

		if flatStyle then
			create("ImageLabel", {
				Name = "CategoryIllustration",
				Parent = page,
				AnchorPoint = Vector2.new(1, 0),
				BackgroundTransparency = 1,
				Image = category.icon,
				ImageColor3 = category.accent,
				ImageTransparency = embeddedPopup and 0.87 or 0.83,
				Position = UDim2.new(1, embeddedPopup and -12 or -18, 0, embeddedPopup and 6 or 10),
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromOffset(embeddedPopup and 48 or 66, embeddedPopup and 48 or 66),
				ZIndex = 132,
			})
			create("Frame", {
				Name = "HeaderDivider",
				Parent = page,
				BackgroundColor3 = Constants.THEME.Border,
				BackgroundTransparency = 0.42,
				BorderSizePixel = 0,
				Position = UDim2.new(0, embeddedPopup and 14 or 20, 0, embeddedPopup and 72 or 82),
				Size = UDim2.new(1, embeddedPopup and -28 or -40, 0, 1),
				ZIndex = 132,
			})
		end
	end

	local animationList = createDetailScroll(pages.Animation, flatStyle and (embeddedPopup and 82 or 94) or 134 + compactPageOffset)
	for index, effect in ipairs(ANIMATION_EFFECTS) do
		refs[effect.ref] =
			createEffectRow(
				animationList,
				effect,
				index,
				effect.buttonText or "Apply",
				CATEGORY_BY_ID.Animation.accent,
				flatStyle,
				embeddedPopup
			)
	end

	local cameraSettingsPanel = create("Frame", {
		Parent = pages.Camera,
		BackgroundColor3 = flatStyle and Constants.THEME.PanelAlt
			or CATEGORY_BY_ID.Camera.accent:Lerp(Constants.THEME.PanelAlt, 0.9),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 22, 0, flatStyle and (embeddedPopup and 82 or 94) or 126 + compactPageOffset),
		Size = UDim2.new(1, -44, 0, 222),
		Visible = false,
		ZIndex = 132,
	})
	if not flatStyle then
		applySectionSurface(cameraSettingsPanel)
	end
	createCorner(cameraSettingsPanel, flatStyle and 5 or 14)
	createCategoryStroke(
		cameraSettingsPanel,
		flatStyle and Constants.THEME.Border or CATEGORY_BY_ID.Camera.accent,
		0.5
	)

	create("TextLabel", {
		Parent = cameraSettingsPanel,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -32, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Cinematic Preset Settings",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 133,
	})

	create("TextLabel", {
		Parent = cameraSettingsPanel,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 30),
		Size = UDim2.new(1, -32, 0, 28),
		Font = Enum.Font.GothamSemibold,
		Text = "These values apply to Orbit Shot, Dolly, Hero Reveal, Crash Zoom, and Follow Cam before you preview or bake keys.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 133,
	})

	local cameraSettingsGrid = create("Frame", {
		Parent = cameraSettingsPanel,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 62),
		Size = UDim2.new(1, -32, 1, -74),
		ZIndex = 133,
	})
	create("UIGridLayout", {
		Parent = cameraSettingsGrid,
		CellPadding = UDim2.new(0, 10, 0, 8),
		CellSize = UDim2.new(0.2, -8, 0, 40),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local cameraTooltip = create("Frame", {
		Parent = cameraSettingsPanel,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 16, 0, 62),
		Size = UDim2.new(0, 342, 0, 78),
		Visible = false,
		ZIndex = 180,
	})
	createCorner(cameraTooltip, 10)
	createStroke(cameraTooltip, Constants.THEME.Border, 1)
	local cameraTooltipTitle = create("TextLabel", {
		Parent = cameraTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Font = Enum.Font.GothamSemibold,
		Text = "Setting",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 181,
	})
	local cameraTooltipDetail = create("TextLabel", {
		Parent = cameraTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 42),
		Font = Enum.Font.GothamSemibold,
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 181,
	})

	local function showCameraTooltip(anchor, tooltipInfo)
		if not anchor or not anchor.Parent or not tooltipInfo then
			return
		end
		cameraTooltipTitle.Text = tooltipInfo.title or "Setting"
		cameraTooltipDetail.Text = tooltipInfo.detail or ""

		local panelAbs = cameraSettingsPanel.AbsolutePosition
		local panelSize = cameraSettingsPanel.AbsoluteSize
		local anchorAbs = anchor.AbsolutePosition
		local anchorSize = anchor.AbsoluteSize
		local tooltipWidth = cameraTooltip.AbsoluteSize.X &gt; 0 and cameraTooltip.AbsoluteSize.X or 342
		local tooltipHeight = cameraTooltip.AbsoluteSize.Y &gt; 0 and cameraTooltip.AbsoluteSize.Y or 78
		local x = anchorAbs.X - panelAbs.X
		local y = anchorAbs.Y - panelAbs.Y + anchorSize.Y + 8
		if y + tooltipHeight &gt; panelSize.Y - 8 then
			y = math.max(8, anchorAbs.Y - panelAbs.Y - tooltipHeight - 8)
		end
		x = math.clamp(x, 8, math.max(8, panelSize.X - tooltipWidth - 8))
		cameraTooltip.Position = UDim2.fromOffset(x, y)
		cameraTooltip.Visible = true
	end

	local function bindCameraTooltip(input, field, tooltipInfo)
		local function show()
			showCameraTooltip(field or input, tooltipInfo)
		end
		input.MouseEnter:Connect(show)
		input.MouseMoved:Connect(show)
		input.MouseLeave:Connect(function()
			cameraTooltip.Visible = false
		end)
		if field then
			field.MouseEnter:Connect(show)
			field.MouseMoved:Connect(show)
			field.MouseLeave:Connect(function()
				cameraTooltip.Visible = false
			end)
		end
	end

	local durationField
	refs._effectsCameraDurationInput, durationField = createCompactCameraInput(cameraSettingsGrid, "Duration", "3.50", 1)
	local radiusField
	refs._effectsCameraRadiusInput, radiusField = createCompactCameraInput(cameraSettingsGrid, "Radius", "10", 2)
	local heightField
	refs._effectsCameraHeightInput, heightField = createCompactCameraInput(cameraSettingsGrid, "Height Offset", "2", 3)
	local fovField
	refs._effectsCameraFovInput, fovField = createCompactCameraInput(cameraSettingsGrid, "FOV", "50", 4)
	local lookSmoothField
	refs._effectsCameraLookSmoothingInput, lookSmoothField = createCompactCameraInput(cameraSettingsGrid, "Look Smooth", "0.15", 5)
	local intensityField
	refs._effectsCameraIntensityInput, intensityField = createCompactCameraInput(cameraSettingsGrid, "Intensity", "1.00", 6)
	local smoothnessField
	refs._effectsCameraSmoothnessInput, smoothnessField = createCompactCameraInput(cameraSettingsGrid, "Smoothness", "5.00", 7)
	local startOffsetField
	refs._effectsCameraStartOffsetInput, startOffsetField = createCompactCameraInput(cameraSettingsGrid, "Start Offset", "0,0,0", 8)
	local endOffsetField
	refs._effectsCameraEndOffsetInput, endOffsetField = createCompactCameraInput(cameraSettingsGrid, "End Offset", "0,0,0", 9)
	local orbitAngleField
	refs._effectsCameraOrbitAngleButton, orbitAngleField = createCompactCameraButton(cameraSettingsGrid, "Orbit Angle", "Half 180", 10)
	local directionField
	refs._effectsCameraDirectionButton, directionField = createCompactCameraButton(cameraSettingsGrid, "Direction", "Clockwise", 11)
	local trackingField
	refs._effectsCameraTrackingButton, trackingField = createCompactCameraButton(cameraSettingsGrid, "Tracking", "On", 12)
	local easingField
	refs._effectsCameraEasingButton, easingField = createCompactCameraButton(cameraSettingsGrid, "Easing", "Linear InOut", 13)
	local previewField
	refs._effectsCameraPreviewButton, previewField = createCompactCameraButton(cameraSettingsGrid, "Preview", "Orbit Shot", 14)

	bindCameraTooltip(refs._effectsCameraDurationInput, durationField, CAMERA_SETTING_TOOLTIPS.Duration)
	bindCameraTooltip(refs._effectsCameraRadiusInput, radiusField, CAMERA_SETTING_TOOLTIPS.Radius)
	bindCameraTooltip(refs._effectsCameraHeightInput, heightField, CAMERA_SETTING_TOOLTIPS.Height)
	bindCameraTooltip(refs._effectsCameraFovInput, fovField, CAMERA_SETTING_TOOLTIPS.FOV)
	bindCameraTooltip(refs._effectsCameraLookSmoothingInput, lookSmoothField, CAMERA_SETTING_TOOLTIPS.LookSmooth)
	bindCameraTooltip(refs._effectsCameraIntensityInput, intensityField, CAMERA_SETTING_TOOLTIPS.Intensity)
	bindCameraTooltip(refs._effectsCameraSmoothnessInput, smoothnessField, CAMERA_SETTING_TOOLTIPS.Smoothness)
	bindCameraTooltip(refs._effectsCameraStartOffsetInput, startOffsetField, CAMERA_SETTING_TOOLTIPS.StartOffset)
	bindCameraTooltip(refs._effectsCameraEndOffsetInput, endOffsetField, CAMERA_SETTING_TOOLTIPS.EndOffset)
	bindCameraTooltip(refs._effectsCameraOrbitAngleButton, orbitAngleField, CAMERA_SETTING_TOOLTIPS.OrbitAngle)
	bindCameraTooltip(refs._effectsCameraDirectionButton, directionField, CAMERA_SETTING_TOOLTIPS.Direction)
	bindCameraTooltip(refs._effectsCameraTrackingButton, trackingField, CAMERA_SETTING_TOOLTIPS.Tracking)
	bindCameraTooltip(refs._effectsCameraEasingButton, easingField, CAMERA_SETTING_TOOLTIPS.Easing)
	bindCameraTooltip(refs._effectsCameraPreviewButton, previewField, {
		title = "Preview",
		detail = "Previews the selected cinematic preset without writing keyframes. Defaults to Orbit Shot until you choose another preset below.",
	})

	local cameraList = createDetailScroll(pages.Camera, flatStyle and (embeddedPopup and 82 or 94) or 134 + compactPageOffset)
	for index, effect in ipairs(CAMERA_EFFECTS) do
		refs[effect.ref] = createEffectRow(
			cameraList,
			effect,
			index,
			effect.buttonText or "Use",
			CATEGORY_BY_ID.Camera.accent,
			flatStyle,
			embeddedPopup
		)
	end

	local rigList = createDetailScroll(pages.Rig, flatStyle and (embeddedPopup and 82 or 94) or 134 + compactPageOffset)
	for index, effect in ipairs(RIG_EFFECTS) do
		refs[effect.ref] = createEffectRow(
			rigList,
			effect,
			index,
			effect.buttonText or "Use",
			CATEGORY_BY_ID.Rig.accent,
			flatStyle,
			embeddedPopup
		)
	end

	local particleList = createDetailScroll(pages.Particles, flatStyle and (embeddedPopup and 82 or 94) or 134 + compactPageOffset)
	for index, effect in ipairs(PARTICLE_EFFECTS) do
		refs[effect.ref] = createEffectRow(
			particleList,
			effect,
			index,
			effect.buttonText or "Use",
			CATEGORY_BY_ID.Particles.accent,
			flatStyle,
			embeddedPopup
		)
	end

	local screenPage = pages.Screen
	local screenStatus = create("TextLabel", {
		Parent = screenPage,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, flatStyle and (embeddedPopup and 82 or 94) or 124 + compactPageOffset),
		Size = UDim2.new(1, -44, 0, 30),
		Font = Enum.Font.GothamSemibold,
		Text = "Add screen effects as timeline tracks, then keyframe their settings with ... or Keypad 7.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 132,
	})

	local screenList =
		createDetailScroll(screenPage, flatStyle and (embeddedPopup and 120 or 132) or 164 + compactPageOffset)
	local screenEffectButtons = {}
	for index, effect in ipairs(EffectsService.getScreenEffectDefinitions()) do
		screenEffectButtons[effect.id] =
			createEffectRow(screenList, effect, index, "Add Track", CATEGORY_BY_ID.Screen.accent, flatStyle, embeddedPopup)
	end

	local lightingPage = pages.Lighting
	local lightingStatus = create("TextLabel", {
		Parent = lightingPage,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, flatStyle and (embeddedPopup and 82 or 94) or 124 + compactPageOffset),
		Size = UDim2.new(1, -44, 0, 30),
		Font = Enum.Font.GothamSemibold,
		Text = "Add lighting effects as timeline tracks, then keyframe their settings with ... or Keypad 7.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 132,
	})

	local lightingList =
		createDetailScroll(lightingPage, flatStyle and (embeddedPopup and 120 or 132) or 164 + compactPageOffset)
	local lightingEffectButtons = {}
	for index, effect in ipairs(EffectsService.getLightingEffectDefinitions()) do
		lightingEffectButtons[effect.id] =
			createEffectRow(lightingList, effect, index, "Add Track", CATEGORY_BY_ID.Lighting.accent, flatStyle, embeddedPopup)
	end

	if flatStyle then
		showPage("Animation")
	end

	refs._effectsOverlay = overlay
	refs._effectsCloseButton = closeButton
	refs._effectsShowPage = showPage
	refs._screenEffectsStatus = screenStatus
	refs._screenEffectButtons = screenEffectButtons
	refs._lightingEffectsStatus = lightingStatus
	refs._lightingEffectButtons = lightingEffectButtons

	return refs
end

function EffectsUI.update(_context)
end

function EffectsUI.destroy()
end

return EffectsUI
