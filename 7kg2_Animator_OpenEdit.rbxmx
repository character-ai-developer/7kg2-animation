local THEME_ACTIONS = {
	Neon = "NeonPurple",
	Black = "PureBlack",
	Light = "LightMode",
	Cyber = "Cyberpunk",
	Pastel = "SoftPastel",
	Grey = "MinimalGrey",
	Solar = "SolarFlare",
	Arctic = "ArcticBlue",
	Emerald = "EmeraldNight",
	Crimson = "CrimsonStudio",
	Gold = "RoyalGold",
	Custom = "Custom",
}

local ACTION_COLORS = {
	Keyframes = {
		All = Color3.fromRGB(95, 82, 178),
		Default = Color3.fromRGB(92, 206, 129),
		Delete = Color3.fromRGB(218, 75, 115),
		Ease = Color3.fromRGB(99, 72, 164),
		["Ease Dir"] = Color3.fromRGB(82, 68, 145),
		Group = Color3.fromRGB(63, 72, 102),
		Ungroup = Color3.fromRGB(63, 72, 102),
		Invert = Color3.fromRGB(78, 62, 136),
		Mirror = Color3.fromRGB(78, 62, 136),
		Repeat = Color3.fromRGB(88, 68, 154),
	},
	Enhance = {
		Bake = Color3.fromRGB(74, 173, 231),
		Copy = Color3.fromRGB(118, 78, 214),
		Default = Color3.fromRGB(92, 206, 129),
		Detach = Color3.fromRGB(218, 75, 115),
		Delete = Color3.fromRGB(218, 75, 115),
		["Ease Dir"] = Color3.fromRGB(82, 68, 145),
		["Ease Style"] = Color3.fromRGB(99, 72, 164),
		Group = Color3.fromRGB(63, 72, 102),
		Handles = Color3.fromRGB(55, 107, 159),
		Invert = Color3.fromRGB(78, 62, 136),
		Mirror = Color3.fromRGB(78, 62, 136),
		Onion = Color3.fromRGB(58, 128, 143),
		Paste = Color3.fromRGB(82, 68, 145),
		Pick = Color3.fromRGB(55, 107, 159),
		Priority = Color3.fromRGB(82, 68, 145),
		Record = Color3.fromRGB(218, 75, 115),
		Redo = Color3.fromRGB(82, 68, 145),
		Repeat = Color3.fromRGB(88, 68, 154),
		Smooth = Color3.fromRGB(89, 87, 158),
		Undo = Color3.fromRGB(82, 68, 145),
		Wiggle = Color3.fromRGB(153, 91, 192),
	},
}

function MicroParityPopupSupport.getActionButtonColor(tabName, actionName)
	local actionColors = ACTION_COLORS[tabName]
	if actionColors and actionColors[actionName] then
		return actionColors[actionName]
	end

	if tabName ~= "Theme" then
		return nil
	end

	local themeId = THEME_ACTIONS[actionName]
	if not themeId or themeId == "Custom" then
		return nil
	end

	local themeInfo = ThemeService.getTheme(themeId)
	local colors = themeInfo and themeInfo.colors
	if not colors then
		return nil
	end

	return colors.Accent or colors.PanelSoft or colors.PanelAlt
end

local HELP_TEXT = {
	Quick = "Quick: add or bind a rig, choose a track, pose in the viewport, then add keyframes. Use Motion Builder for marker paths, Presets for imports, Effects for camera/screen/audio polish, and Cutscene Exporter for packages.",
	["Getting Started"] = "Getting Started: click Add Rig or +Rig, select a body-part/track, use Move/Rotate/Trackball, press + Key, scrub forward, and repeat. Save often from Summary or Presets &amp; Import.",
	Motion = "Motion Builder: bind a rig, add markers, choose motion styles between markers, preview the path, then Build Timeline to create normal editable keyframes.",
	Timeline = "Timeline: click empty ruler space to scrub, drag keys to move them, box-select multiple keys, use the bottom scrollbar to pan, and use zoom controls to change frame density.",
	Pose = "Pose Tools: R toggles Move/Rotate, Y toggles Local/World, T starts Trackball Rotate, Shift+T starts Trackball Move, Shift+R starts Record Motion, H enables part picking, and Shift+B toggles rig/bone handles. During Record Motion, right-click rotates the Studio camera and Escape cancels.",
	Cutscene = "Cutscene: choose playback, trigger, character, and sound options, validate first, then generate the package. Micro and Main use the same cutscene export service.",
	Faces = "Faces: create or select reusable face presets, then apply one at the playhead to create editable face keyframes under the selected rig.",
	Audio = "Audio: add a sound track, key a SoundId at the playhead, then playback continues from the current playhead until the clip or project length ends.",
	Import = "Import: paste an animation ID/URL, import a selected KeyframeSequence, load saved 7kg2 projects, or browse Roblox Starter/My Animations in Presets.",
	Effects = "Effects: use screen, lighting, camera, particle, sound, and animation effects. Select an effect keyframe or track and press Keypad 7 for its editor.",
	Physics = "Physics: choose an effect, follow the highlighted Setup and Capture steps, preview manually, then Bake to Timeline. Guided Mode, Starting Push tests, multi-rig Ragdoll/Knockback, and explosion tests help you check the result before capture.",
	Trouble = "Troubleshooting: if an editor says to select something first, select the relevant track or keyframe, then press Keypad 7 or use the track ... menu. Use Bake for heavy preview playback.",
	Shortcuts = "+ Add Key | Space Play/Pause | Stop returns to frame 0 | [/] previous/next frame | Ctrl+A select all | Ctrl+D delete | Shift+R Record Motion | N multi-select | P hide during playback | Shift+Z/Y undo/redo | Shift+M mirror | Shift+I invert | 7 options.",
	Support = "Support: save the project, note the build number, then share the exact action and Studio output message. Micro build: " .. tostring(BuildInfo.BUILD_ID or "unknown") .. ".",
}

local function callRunOption(context, options, callbackName, fallbackActionName, ...)
	if context and type(context.runOption) == "function" then
		return context.runOption(options, callbackName, fallbackActionName, ...)
	end
	return false, nil
end

local function openPopup(options, popupName)
	if type(options) == "table" and type(options.onOpenPopup) == "function" then
		options.onOpenPopup(popupName)
		return true, tostring(POPUPS[popupName] and POPUPS[popupName].title or popupName) .. " opened."
	end
	return false, "That Micro popup is not available yet."
end

local function refreshMicroTheme(options)
	if type(options) == "table" and options._microGui then
		ThemeService.applyToGui(options._microGui)
	end
end

local function runThemeAction(actionName, options)
	if actionName == "Custom Colors" then
		if type(options) == "table" and type(options.onOpenCustomThemeEditor) == "function" then
			options.onOpenCustomThemeEditor()
			return true, "Custom theme editor opened."
		end
		return false, "Custom theme editor is not available yet."
	elseif actionName == "Font Picker" then
		if type(options) == "table" and type(options.onOpenFontPicker) == "function" then
			options.onOpenFontPicker()
			return true, "Font picker opened."
		end
		return false, "Font picker is not available yet."
	end

	local themeId = THEME_ACTIONS[actionName]
	if themeId then
		local ok, message
		if type(options) == "table" and type(options.onSelectTheme) == "function" then
			ok, message = options.onSelectTheme(themeId)
		end
		if not ok then
			ok, message = ThemeService.saveTheme(options and options.plugin, themeId)
		end
		refreshMicroTheme(options)
		return ok, message
	end

	if actionName == "Font Default" or actionName == "Font Arcade" or actionName == "Font SciFi" then
		local fontName = actionName == "Font Default" and "Default" or (actionName == "Font Arcade" and "Arcade" or "SciFi")
		FontPreviewService.saveFont(options and options.plugin, fontName)
		return FontPreviewService.apply(options and options._microGui, fontName)
	end

	return false, nil
end

local function runSummaryAction(actionName, options, context)
	if actionName == "Refresh" then
		if context and type(context.getProjectSummary) == "function" then
			return true, context.getProjectSummary(options)
		end
		return true, "Micro summary refreshed."
	elseif actionName == "New" then
		return callRunOption(context, options, "onNewAnimation", "newAnimation")
	elseif actionName == "Save+New" then
		return callRunOption(context, options, "onSaveAndNewAnimation", "saveAndNewAnimation")
	elseif actionName == "Save" then
		return callRunOption(context, options, "onSaveAnimation", "saveAnimation")
	elseif actionName == "Import" then
		return openPopup(options, "Presets")
	elseif actionName == "Export" then
		return callRunOption(context, options, "onExportAnimation", "exportAnimation")
	elseif actionName == "Add Rig" then
		return callRunOption(context, options, "onBindRig", nil, true)
	elseif actionName == "R6" then
		return callRunOption(context, options, "onInsertDefaultRig", nil, "R6")
	elseif actionName == "R15 Classic" then
		return callRunOption(context, options, "onInsertDefaultRig", nil, "R15", "Classic")
	elseif actionName == "R15 Modern" then
		return callRunOption(context, options, "onInsertDefaultRig", nil, "R15", "Modern")
	elseif actionName == "Avatar" then
		return callRunOption(context, options, "onOpenAvatarImporter", nil)
	elseif actionName == "Camera" then
		return callRunOption(context, options, "onAddTrack", "addTrack", "Camera")
	elseif actionName == "Object" then
		return callRunOption(context, options, "onAddTrack", "addTrack", "Object")
	elseif actionName == "Model" then
		return callRunOption(context, options, "onAddTrack", "addTrack", "Model")
	elseif actionName == "Event" then
		return callRunOption(context, options, "onAddTrack", "addTrack", "Event")
	elseif actionName == "Close" then
		return callRunOption(context, options, "onRequestCloseMicroWorkspace", nil)
	elseif actionName == "Help" then
		return openPopup(options, "Help")
	end
	return false, nil
end

local EASING_STYLE_ACTIONS = {}
for _, easingStyle in ipairs(Constants.EASING_STYLES or {}) do
	EASING_STYLE_ACTIONS[easingStyle] = true
end

local EASING_DIRECTION_ACTIONS = {}
for _, easingDirection in ipairs(Constants.EASING_DIRECTIONS or {}) do
	EASING_DIRECTION_ACTIONS["Dir " .. easingDirection] = easingDirection
end

local function cyclePriority(options, context)
	local timeline = options and type(options.getTimeline) == "function" and options.getTimeline() or nil
	local currentPriority = timeline and type(timeline.getPriority) == "function" and timeline:getPriority() or nil
	local priorities = Constants.ANIMATION_PRIORITIES or {}
	local nextPriority = priorities[1] or "Action"

	for index, priority in ipairs(priorities) do
		if priority == currentPriority then
			nextPriority = priorities[(index % #priorities) + 1] or nextPriority
			break
		end
	end

	return callRunOption(context, options, "onPriorityChanged", "priorityChanged", nextPriority)
end

local function runEnhanceAction(actionName, options, context)
	local selectedStyle = tostring(actionName or ""):match("^Set Ease Style:%s*(.+)$")
	if selectedStyle then
		return callRunOption(context, options, "onSetEasingStyle", "setSelectedEasingStyle", selectedStyle)
	end
	local selectedDirection = tostring(actionName or ""):match("^Set Ease Dir:%s*(.+)$")
	if selectedDirection then
		return callRunOption(context, options, "onSetEasingDirection", "setSelectedEasingDirection", selectedDirection)
	end
	local selectedPriority = tostring(actionName or ""):match("^Set Priority:%s*(.+)$")
	if selectedPriority then
		return callRunOption(context, options, "onPriorityChanged", "priorityChanged", selectedPriority)
	end

	if actionName == "Copy" then
		return callRunOption(context, options, "onCopyKeys", "copySelectedKeys")
	elseif actionName == "Paste" then
		return callRunOption(context, options, "onPasteKeys", "pasteKeysAtPlayhead")
	elseif actionName == "Undo" then
		return callRunOption(context, options, "onUndo", "undoLastEdit")
	elseif actionName == "Redo" then
		return callRunOption(context, options, "onRedo", "redoLastEdit")
	elseif actionName == "Delete" then
		return callRunOption(context, options, "onDeleteKeys", "deleteCurrentFrame")
	elseif actionName == "Smooth" then
		return callRunOption(context, options, "onSmoothMotion", "smoothSelectedMotion", "Light")
	elseif actionName == "Repeat" then
		if options and type(options.onOpenRepeatFramesPopup) == "function" then
			return options.onOpenRepeatFramesPopup()
		end
		return callRunOption(context, options, "onRepeatFrames", "repeatFrames", {
			loopCount = "2",
		})
	elseif actionName == "Wiggle" then
		return callRunOption(context, options, "onApplyAnimationEffect", nil, "Wiggle", {
			angleX = "2",
			angleY = "2",
			angleZ = "2",
			positionX = "0",
			positionY = "0",
			positionZ = "0",
			interval = "0:02",
			easingStyle = "Linear",
			easingDirection = "InOut",
		})
	elseif actionName == "Mirror" then
		return callRunOption(context, options, "onMirrorKeys", "mirrorSelectedKeyframes")
	elseif actionName == "Invert" then
		return callRunOption(context, options, "onInvertKeys", "invertSelectedKeyframes")
	elseif actionName == "Priority" then
		return cyclePriority(options, context)
	elseif actionName == "Ease Style" then
		return callRunOption(context, options, "onCycleEasingStyle", "cycleSelectedEasingStyle")
	elseif actionName == "Ease Dir" then
		return callRunOption(context, options, "onCycleEasingDirection", "cycleSelectedEasingDirection")
	elseif EASING_STYLE_ACTIONS[actionName] then
		return callRunOption(context, options, "onSetEasingStyle", "setSelectedEasingStyle", actionName)
	elseif EASING_DIRECTION_ACTIONS[actionName] then
		return callRunOption(context, options, "onSetEasingDirection", "setSelectedEasingDirection", EASING_DIRECTION_ACTIONS[actionName])
	elseif actionName == "Default" then
		return callRunOption(context, options, "onDefaultPoseKeyframes", "defaultPoseKeyframes", true)
	elseif actionName == "Group" then
		return callRunOption(context, options, "onGroupKeys", "groupSelectedKeys")
	elseif actionName == "Ungroup" then
		return callRunOption(context, options, "onUngroupKeys", "ungroupSelectedKeys")
	elseif actionName == "Attach" then
		return callRunOption(context, options, "onAttachSelection", "attachHandToSelection")
	elseif actionName == "Detach" then
		return callRunOption(context, options, "onDetachSelection", "detachAttachedObject")
	elseif actionName == "Onion" then
		return callRunOption(context, options, "onToggleOnionSkin", "toggleOnionSkin")
	elseif actionName == "Handles" then
		return callRunOption(context, options, "onToggleRigHandles", "toggleRigHandles")
	elseif actionName == "Pick" then
		return callRunOption(context, options, "onToggleRigPartHighlight", "toggleRigPartHighlight")
	elseif actionName == "Record" then
		return callRunOption(context, options, "onRecordMotion", "recordMotion")
	elseif actionName == "Bake" then
		return callRunOption(context, options, "onBakePreview", "bakePreview")
	elseif actionName == "Performance" then
		return callRunOption(context, options, "onTogglePerformanceDebug", "togglePerformanceDebug")
	end
	return false, nil
end

function MicroParityPopupSupport.getPopups()
	return POPUPS
end

function MicroParityPopupSupport.runAction(tabName, actionName, options, _payload, context)
	if tabName == "Summary" then
		return true, runSummaryAction(actionName, options, context)
	elseif tabName == "Help" then
		return true, true, HELP_TEXT[actionName] or "Help guide selected."
	elseif tabName == "Theme" then
		return true, runThemeAction(actionName, options)
	elseif tabName == "Enhance" then
		return true, runEnhanceAction(actionName, options, context)
	end
	return false, nil, nil
end

return MicroParityPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX84">
          <Properties>
            <string name="Name">MicroPreferencesPopupSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local CustomThemeUI = require(script.Parent:WaitForChild("CustomThemeUI"))
local FontPreviewService = require(script.Parent.Parent:WaitForChild("FontPreviewService"))
local FontPreviewUI = require(script.Parent:WaitForChild("FontPreviewUI"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local MicroPreferencesPopupSupport = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local function disconnectAll(connections)
	for index = #connections, 1, -1 do
		local connection = connections[index]
		if connection then
			pcall(function()
				connection:Disconnect()
			end)
		end
		connections[index] = nil
	end
end

local function connect(connections, signal, callback)
	if signal and type(callback) == "function" then
		table.insert(connections, signal:Connect(callback))
	end
end

local function setStatus(options, message)
	if options and type(options.onStatus) == "function" then
		options.onStatus(message)
	end
end

local function refreshRoot(parent, options)
	ThemeService.applyToGui(parent)
	FontPreviewService.apply(parent, FontPreviewService.getCurrentFontName())
	if options and type(options.onRefresh) == "function" then
		options.onRefresh()
	end
end

local function updateFontSelection(refs)
	local currentFontName = FontPreviewService.getCurrentFontName()
	if refs._fontPreviewSelectedButton then
		refs._fontPreviewSelectedButton.Text = tostring(currentFontName)
	end
	for fontName, button in pairs(refs._fontPreviewOptionButtons or {}) do
		if button then
			button.BackgroundColor3 = fontName == currentFontName and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
			button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
		end
	end
end

local function updateCustomThemePreview(refs, role, color)
	if typeof(color) ~= "Color3" then
		return
	end
	if role == "Background" and refs._customThemePreview then
		refs._customThemePreview.BackgroundColor3 = color
	elseif role == "Panel" and refs._customThemePreviewPanel then
		refs._customThemePreviewPanel.BackgroundColor3 = color
	elseif role == "Accent" and refs._customThemePreviewAccent then
		refs._customThemePreviewAccent.BackgroundColor3 = color
	end
	if refs._customThemePreviewText and refs._customThemePreviewPanel then
		refs._customThemePreviewText.TextColor3 = ThemeService.getReadableTextColor(refs._customThemePreviewPanel.BackgroundColor3)
	end
end

local function resetCustomThemePreview(refs)
	local theme = ThemeService.getCurrentTheme()
	local colors = theme and theme.colors or Constants.THEME
	updateCustomThemePreview(refs, "Background", colors.Background)
	updateCustomThemePreview(refs, "Panel", colors.Panel)
	updateCustomThemePreview(refs, "Accent", colors.Accent)
end

local function makeClosePrompt(parent, options, connections)
	local overlay = create("Frame", {
		Name = "MicroSaveCloseOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 240,
	})

	local card = create("Frame", {
		Name = "MicroSaveCloseCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 440, 0, 220),
		ZIndex = 241,
	})
	applySectionSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)

	local title = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 18, 0, 16),
		Size = UDim2.new(1, -36, 0, 22),
		Text = "Close 7kg2 Micro?",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 242,
	})
	title:SetAttribute("MegMoThemeTextRole", "Text")

	local message = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 18, 0, 48),
		Size = UDim2.new(1, -36, 0, 60),
		Text = "Save your progress before closing? 7kg2 also keeps an autosave in ServerStorage so you can recover recent work.",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 242,
	})
	message:SetAttribute("MegMoThemeTextRole", "MutedText")

	local saveButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 18, 0, 122),
		Size = UDim2.new(1, -36, 0, 34),
		Text = "Save And Close",
		ZIndex = 242,
	})
	styleTextButton(saveButton)
	createCorner(saveButton, 9)

	local discardButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 18, 0, 162),
		Size = UDim2.new(0.5, -24, 0, 34),
		Text = "Close Without Saving",
		ZIndex = 242,
	})
	styleGhostButton(discardButton)
	createCorner(discardButton, 9)

	local cancelButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.5, 6, 0, 162),
		Size = UDim2.new(0.5, -24, 0, 34),
		Text = "Cancel",
		ZIndex = 242,
	})
	styleGhostButton(cancelButton)
	createCorner(cancelButton, 9)

	local function hide()
		overlay.Visible = false
	end

	connect(connections, cancelButton.Activated, hide)
	connect(connections, discardButton.Activated, function()
		hide()
		if type(options.onCloseWithoutSaving) == "function" then
			options.onCloseWithoutSaving()
		end
	end)
	connect(connections, saveButton.Activated, function()
		if type(options.onSaveAndClose) == "function" then
			options.onSaveAndClose()
		end
	end)

	return {
		overlay = overlay,
		show = function()
			overlay.Visible = true
			setStatus(options, "Close prompt open: save and close, close without saving, or cancel.")
		end,
		hide = hide,
	}
end

function MicroPreferencesPopupSupport.mount(parent, options)
	if not parent then
		error("MicroPreferencesPopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local customRefs = CustomThemeUI.mount(parent, {})
	local fontRefs = FontPreviewUI.mount(parent, {})
	local closePrompt = makeClosePrompt(parent, options, connections)
	local pendingCustomThemeColors = nil

	local function setCustomThemeVisible(isVisible)
		if customRefs._customThemeOverlay then
			customRefs._customThemeOverlay.Visible = isVisible == true
		end
		if isVisible == true then
			pendingCustomThemeColors = {}
			resetCustomThemePreview(customRefs)
			if customRefs._customThemeStatusLabel then
				customRefs._customThemeStatusLabel.Text = "Choose one or more colors, then click Save Custom Theme."
			end
			refreshRoot(parent, options)
		else
			pendingCustomThemeColors = nil
		end
	end

	local function setFontPickerVisible(isVisible)
		if fontRefs._fontPreviewOverlay then
			fontRefs._fontPreviewOverlay.Visible = isVisible == true
		end
		if isVisible == true then
			updateFontSelection(fontRefs)
			refreshRoot(parent, options)
		end
	end

	for _, swatch in ipairs(customRefs._customThemeSwatches or {}) do
		connect(connections, swatch.button and swatch.button.Activated, function()
			pendingCustomThemeColors = pendingCustomThemeColors or {}
			pendingCustomThemeColors[swatch.role] = swatch.color
			updateCustomThemePreview(customRefs, swatch.role, swatch.color)
			if customRefs._customThemeStatusLabel then
				customRefs._customThemeStatusLabel.Text = tostring(swatch.role) .. " color selected. Click Save Custom Theme to keep it."
			end
		end)
	end
	connect(connections, customRefs._customThemeCloseButton and customRefs._customThemeCloseButton.Activated, function()
		setCustomThemeVisible(false)
	end)
	connect(connections, customRefs._customThemeCancelButton and customRefs._customThemeCancelButton.Activated, function()
		setCustomThemeVisible(false)
	end)
	connect(connections, customRefs._customThemeSaveButton and customRefs._customThemeSaveButton.Activated, function()
		if not pendingCustomThemeColors or next(pendingCustomThemeColors) == nil then
			if customRefs._customThemeStatusLabel then
				customRefs._customThemeStatusLabel.Text = "Choose at least one custom color before saving."
			end
			return
		end
		local success, message = ThemeService.saveCustomTheme(options.plugin, pendingCustomThemeColors)
		refreshRoot(parent, options)
		if success then
			setCustomThemeVisible(false)
		elseif customRefs._customThemeStatusLabel then
			customRefs._customThemeStatusLabel.Text = message or "Custom theme could not be saved."
		end
		setStatus(options, message or "Custom theme saved.")
	end)

	connect(connections, fontRefs._fontPreviewCloseButton and fontRefs._fontPreviewCloseButton.Activated, function()
		setFontPickerVisible(false)
	end)
	connect(connections, fontRefs._fontPreviewSelectedButton and fontRefs._fontPreviewSelectedButton.Activated, function()
		if fontRefs._fontPreviewList then
			fontRefs._fontPreviewList.Visible = not fontRefs._fontPreviewList.Visible
		end
	end)
	for fontName, button in pairs(fontRefs._fontPreviewOptionButtons or {}) do
		connect(connections, button.Activated, function()
			FontPreviewService.saveFont(options.plugin, fontName)
			local _success, message = FontPreviewService.apply(parent, fontName)
			updateFontSelection(fontRefs)
			refreshRoot(parent, options)
			if fontRefs._fontPreviewStatusLabel then
				fontRefs._fontPreviewStatusLabel.Text = message or "Font saved."
			end
			setStatus(options, message or "Font saved.")
		end)
	end

	refreshRoot(parent, options)

	return {
		openCustomThemeEditor = function()
			setFontPickerVisible(false)
			setCustomThemeVisible(true)
			setStatus(options, "Custom theme editor opened.")
		end,
		openFontPicker = function()
			setCustomThemeVisible(false)
			setFontPickerVisible(true)
			setStatus(options, "Font picker opened.")
		end,
		openClosePrompt = function()
			closePrompt.show()
		end,
		closeAll = function()
			setCustomThemeVisible(false)
			setFontPickerVisible(false)
			closePrompt.hide()
		end,
		destroy = function()
			disconnectAll(connections)
		end,
	}
end

return MicroPreferencesPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX85">
          <Properties>
            <string name="Name">MicroPresetsPopupSupport</string>
            <ProtectedString name="Source">local RunService = game:GetService("RunService")

local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local PresetsUI = require(script.Parent:WaitForChild("PresetsUI"))
local PresetPreviewSupport = require(script.Parent.Parent:WaitForChild("PresetPreviewSupport"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))
local WidgetImportBrowserSupport = require(script.Parent.Parent:WaitForChild("WidgetImportBrowserSupport"))
local WidgetPresetPreviewSupport = require(script.Parent.Parent:WaitForChild("WidgetPresetPreviewSupport"))

local MicroPresetsPopupSupport = {}

local PRESET_PREVIEW_SAMPLE_TIME = PresetPreviewSupport.SAMPLE_TIME

local function disconnectAll(connections)
	for _, connection in ipairs(connections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	table.clear(connections)
end

local function connect(connections, signal, handler)
	if not signal or type(handler) ~= "function" then
		return nil
	end
	local connection = signal:Connect(handler)
	table.insert(connections, connection)
	return connection
end

local function setStatus(options, message)
	if type(options.setStatus) == "function" then
		options.setStatus(message)
	end
end

local function closeAfterTimelineImport(options)
	if type(options.onCloseAfterImport) == "function" then
		task.defer(function()
			options.onCloseAfterImport()
		end)
	end
end

local function getImportEntries(options)
	local getter = options.getImportEntries or options.onGetImportEntries
	if type(getter) ~= "function" then
		return {}
	end
	local ok, result = pcall(getter)
	return ok and (result or {}) or {}
end

local function getImportBrowserStatus(options)
	local getter = options.getImportBrowserStatus or options.onGetImportBrowserStatus
	if type(getter) ~= "function" then
		return ""
	end
	local ok, result = pcall(getter)
	return ok and tostring(result or "") or ""
end

local function hasEntriesForPresetSource(entries, presetSource)
	local expectedSource = presetSource == "MyAnimations" and "My Animations" or "Roblox Starter"
	for _, entry in ipairs(entries or {}) do
		if entry and tostring(entry.source or "") == expectedSource then
			return true
		end
	end
	return false
end

function MicroPresetsPopupSupport.mount(parent, options)
	if not parent then
		error("MicroPresetsPopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local refs = PresetsUI.mount(parent, {
		root = parent,
		embeddedPopup = true,
		hideHeader = true,
	})
	local controller = {
		_callbacks = {},
		_root = parent,
		_uiSections = {
			PresetsUI = PresetsUI,
		},
		_presetRigFilter = "All",
		_presetSource = "RobloxStarter",
		_presetPreviewStates = {},
		_motionDefaultPickerMotion = nil,
		_motionSegmentPickerKey = nil,
		_motionSegmentPickerLabel = nil,
		_workspaceMode = "Presets",
	}

	for key, value in pairs(refs or {}) do
		controller[key] = value
	end

	if controller._presetImportIdInput and controller._presetImportIdButton and controller._presetImportIdButton.Parent then
		local importRow = controller._presetImportIdButton.Parent
		controller._presetImportIdInput.Size = UDim2.new(1, -294, 1, 0)
		controller._presetImportIdButton.Size = UDim2.new(0, 76, 1, 0)
		controller._presetImportIdButton.Position = UDim2.new(1, 0, 0, 0)
		controller._presetImportIdButton.Text = "Import"
		controller._presetImportIdButton.TextSize = 12
		if controller._presetR15ToR6Button then
			controller._presetR15ToR6Button.Position = UDim2.new(1, -190, 0, 0)
			controller._presetR15ToR6Button.Size = UDim2.new(0, 96, 1, 0)
			controller._presetR15ToR6Button.Text = "R15 -&gt; R6"
		end
		controller._presetSelectedImportButton = UiHelpers.create("TextButton", {
			Name = "PresetSelectedImportButton",
			Parent = importRow,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -86, 0, 0),
			Size = UDim2.new(0, 96, 1, 0),
			Text = "Selected",
		})
		UiHelpers.styleTextButton(controller._presetSelectedImportButton, Constants.THEME.PanelSoft)
		UiHelpers.createCorner(controller._presetSelectedImportButton, 9)
	end

	function controller:_connect(signal, handler)
		return connect(connections, signal, handler)
	end

	function controller:_setShortcutHint(message)
		setStatus(options, message)
	end

	controller._focusShortcutCapture = controller._setShortcutHint

	function controller:_setWorkspaceMode(mode)
		self._workspaceMode = mode or "Presets"
	end

	function controller:_hideImportDialog()
		if self._importOverlay then
			self._importOverlay.Visible = false
		end
	end

	function controller:_showImportDialog()
		if not self._importOverlay then
			return
		end
		self._importOverlay.Visible = true
		self._lastImportEntriesSignature = nil
		if self._importStatusLabel then
			self._importStatusLabel.Text = "Loading 7kg2 Animator saves..."
		end
		self:_renderImportAnimationEntries({}, "Loading 7kg2 Animator saves...")
		self:_setShortcutHint("Import dialog open: saved 7kg2 files are shown first, or choose another import method")
		task.defer(function()
			if self._importOverlay and self._importOverlay.Visible and self._callbacks.onLoadSavedProjects then
				self._callbacks.onLoadSavedProjects()
			end
		end)
	end

	function controller:_setPresetSource(source)
		self._presetSource = tostring(source or "")
		local active = Constants.THEME.Accent
		local inactive = Constants.THEME.PanelSoft
		if self._presetFreeButton then
			local isActive = self._presetSource == "RobloxStarter"
			self._presetFreeButton.BackgroundColor3 = isActive and active or inactive
			self._presetFreeButton.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Constants.THEME.Text
		end
		if self._presetOwnedButton then
			local isActive = self._presetSource == "MyAnimations"
			self._presetOwnedButton.BackgroundColor3 = isActive and active or inactive
			self._presetOwnedButton.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Constants.THEME.Text
		end
	end

	local refresh

	local function requestAsyncRefresh(delays)
		task.defer(function()
			if refresh and controller._presetsCard and controller._presetsCard.Parent then
				refresh()
			end
		end)
		for _, delaySeconds in ipairs(delays or { 0.35, 0.85, 1.5 }) do
			task.delay(delaySeconds, function()
				if refresh and controller._presetsCard and controller._presetsCard.Parent then
					refresh()
				end
			end)
		end
	end

	local function requestAsyncMyAnimationsRefresh()
		-- My Animations loads through Roblox web requests, so it can finish after the
		-- short local refresh window used by the Starter preset list.
		requestAsyncRefresh({ 0.2, 0.5, 0.9, 1.5, 2.5, 4, 6, 8, 10, 12 })
	end

	local function requestInitialSourceLoad()
		local entries = getImportEntries(options)
		if hasEntriesForPresetSource(entries, controller._presetSource) then
			return
		end
		if controller._presetSource == "MyAnimations" then
			if controller._presetStatusLabel then
				controller._presetStatusLabel.Text = "Loading your Roblox animations..."
			end
			if controller._callbacks.onLoadMyAnimations then
				controller._callbacks.onLoadMyAnimations()
			end
		else
			if controller._presetStatusLabel then
				controller._presetStatusLabel.Text = "Loading Roblox Starter packs..."
			end
			if controller._callbacks.onLoadPresetAnimations then
				controller._callbacks.onLoadPresetAnimations()
			end
		end
		requestAsyncRefresh()
	end

	function controller:_cyclePresetRigFilter()
		local current = self._presetRigFilter or "All"
		local nextFilter = current == "All" and "R15" or (current == "R15" and "R6" or "All")
		self._presetRigFilter = nextFilter
		if self._presetRigFilterButton then
			self._presetRigFilterButton.Text = "Rig: " .. nextFilter
		end
		if refresh then
			refresh()
		end
	end

	function controller:_importPresetIdInput()
		local importText = self._presetImportIdInput and self._presetImportIdInput.Text or ""
		importText = tostring(importText or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if importText == "" then
			if self._presetStatusLabel then
				self._presetStatusLabel.Text = "Paste an Animation ID or URL first, then click Import ID."
			end
			return false
		end
		if self._presetStatusLabel then
			self._presetStatusLabel.Text = "Importing animation from ID..."
		end
		local result = nil
		if self._callbacks.onImportAnimationId then
			result = self._callbacks.onImportAnimationId(importText)
		end
		requestAsyncRefresh()
		if result ~= false then
			closeAfterTimelineImport(options)
		end
		return true
	end

	function controller:_renderImportAnimationEntries(entries, statusText)
		return WidgetImportBrowserSupport.renderImportAnimationEntries(self, entries, statusText, {
			create = UiHelpers.create,
			createCorner = UiHelpers.createCorner,
		})
	end

	function controller:_renderPresetBrowserEntries(entries, statusText)
		local signature, filteredEntries = WidgetImportBrowserSupport.buildPresetEntriesSignature(self, entries, statusText)
		if signature == self._lastPresetEntriesSignature then
			return
		end
		self._lastPresetEntriesSignature = signature
		return WidgetImportBrowserSupport.renderPresetBrowserEntries(self, filteredEntries, statusText, false, "", {
			create = UiHelpers.create,
			createCorner = UiHelpers.createCorner,
			createStroke = UiHelpers.createStroke,
		})
	end

	function controller:_setPresetPreviewPlaying(viewport, shouldPlay)
		if not viewport then
			return
		end
		local previewState = self._presetPreviewStates and self._presetPreviewStates[viewport]
		if not previewState or not previewState.ready or not previewState.previewData then
			return
		end
		if shouldPlay then
			if previewState.connection then
				return
			end
			previewState.connection = RunService.Heartbeat:Connect(function(deltaTime)
				if not viewport.Parent then
					if previewState.connection then
						previewState.connection:Disconnect()
						previewState.connection = nil
					end
					return
				end
				local duration = math.max(previewState.duration or 0, PRESET_PREVIEW_SAMPLE_TIME + 0.01)
				previewState.resumeTime = (previewState.resumeTime or PRESET_PREVIEW_SAMPLE_TIME) + deltaTime
				if previewState.resumeTime &gt; duration then
				previewState.resumeTime = 0
			end
			local pose = PresetPreviewSupport.samplePreviewPose(previewState.previewData, previewState.resumeTime)
			PresetPreviewSupport.applyPreviewPoseAboveFloor(previewState.rigData, pose, 0.1)
		end)
	elseif previewState.connection then
		previewState.connection:Disconnect()
			previewState.connection = nil
		end
	end

	function controller:_populatePresetPreview(viewport, fallbackThumb, entry, previewOptions)
		if not viewport or not entry then
			return
		end
		previewOptions = previewOptions or {}
		PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, previewOptions.loadingOverlay, "loading")
		local previewToken = tostring(os.clock()) .. ":" .. tostring(entry.id or "")
		viewport:SetAttribute("PreviewToken", previewToken)
		for _, child in ipairs(viewport:GetChildren()) do
			child:Destroy()
		end
		local worldModel = Instance.new("WorldModel")
		worldModel.Parent = viewport
		PresetPreviewSupport.setPreviewViewportCamera(viewport)
		local floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Anchored = true
		floor.CanCollide = false
		floor.CastShadow = false
		floor.Material = Enum.Material.SmoothPlastic
		floor.Color = Color3.fromRGB(57, 61, 72)
		floor.Size = Vector3.new(9, 0.2, 9)
		floor.CFrame = CFrame.new(0, 0, 0)
		floor.Parent = worldModel
		task.spawn(function()
			if not entry.id or not viewport.Parent then
				PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, previewOptions.loadingOverlay, "fallback")
				return
			end
			local clip = PresetPreviewSupport.loadEntryPreviewAnimationClip(entry)
			if not clip or not clip:IsA("KeyframeSequence") then
				PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, previewOptions.loadingOverlay, "fallback")
				return
			end
			local rigTypeName = PresetPreviewSupport.getRigTypeNameForPreview(entry, clip)
			local rigSuccess, previewRig, animator = pcall(function()
				return PresetPreviewSupport.createPresetPreviewRig(rigTypeName)
			end)
			if not rigSuccess or not previewRig then
				PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, previewOptions.loadingOverlay, "fallback")
				return
			end
			previewRig.Parent = worldModel
			local rigData = PresetPreviewSupport.describePreviewRigMotors(previewRig)
			local previewData = PresetPreviewSupport.buildPreviewPoseDataFromKeyframeSequence(clip, rigData)
			if not previewData then
				PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, previewOptions.loadingOverlay, "fallback")
				return
			end
			local samplePose = PresetPreviewSupport.samplePreviewPose(previewData, PRESET_PREVIEW_SAMPLE_TIME)
			PresetPreviewSupport.applyPreviewPose(rigData, samplePose)
			PresetPreviewSupport.alignPreviewRigToFloor(previewRig, 0.1)
			PresetPreviewSupport.rebasePreviewRootFromPose(rigData, samplePose)
			if viewport:GetAttribute("PreviewToken") ~= previewToken then
				return
			end
			PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, previewOptions.loadingOverlay, "ready")
			self._presetPreviewStates[viewport] = {
				ready = true,
				previewData = previewData,
				rigData = rigData,
				duration = previewData.duration,
				resumeTime = PRESET_PREVIEW_SAMPLE_TIME,
				animator = animator,
			}
			if previewOptions.autoPlay then
				self:_setPresetPreviewPlaying(viewport, true)
			end
		end)
	end

	function controller:_showPresetPreview(entry)
		return WidgetPresetPreviewSupport.showPresetPreview(self, entry)
	end

	function controller:_hidePresetPreview()
		return WidgetPresetPreviewSupport.hidePresetPreview(self)
	end

	function controller:_usePresetEntryForCurrentPurpose(entry)
		if not entry then
			return false
		end
		if entry.entryType == "SavedProject" and self._callbacks.onOpenSavedProject then
			if self._presetStatusLabel then
				self._presetStatusLabel.Text = "Opening " .. tostring(entry.name or entry.id or "saved project") .. "..."
			end
			local handled = self._callbacks.onOpenSavedProject(entry.id)
			if handled == true then
				self:_hidePresetPreview()
				self:_focusShortcutCapture("Opened saved project")
			end
			requestAsyncRefresh()
			return handled ~= false
		end
		if entry.entryType == "BulkKeyframeSequence" and self._callbacks.onImportBulkKeyframeSequence then
			if self._presetStatusLabel then
				self._presetStatusLabel.Text = "Importing " .. tostring(entry.name or "selected KeyframeSequence") .. "..."
			end
			local result = self._callbacks.onImportBulkKeyframeSequence(entry.id)
			requestAsyncRefresh()
			if result ~= false then
				closeAfterTimelineImport(options)
			end
			return true
		end
		if self._presetStatusLabel then
			self._presetStatusLabel.Text = "Importing " .. tostring(entry.name or entry.id or "animation") .. "..."
		end
		local result = nil
		if self._callbacks.onImportAnimationId then
			result = self._callbacks.onImportAnimationId(entry.id, entry.name, entry)
		end
		requestAsyncRefresh()
		if result ~= false then
			closeAfterTimelineImport(options)
		end
		return true
	end

	refresh = function()
		if controller._presetsCard then
			controller._presetsCard.Visible = true
		end
		controller:_setPresetSource(controller._presetSource)
		if controller._presetRigFilterButton then
			controller._presetRigFilterButton.Text = "Rig: " .. tostring(controller._presetRigFilter or "All")
		end
		local entries = getImportEntries(options)
		local statusText = getImportBrowserStatus(options)
		controller:_renderPresetBrowserEntries(entries, statusText)
		controller:_renderImportAnimationEntries(entries, statusText)
		if controller._presetStatusLabel then
			if statusText ~= "" then
				controller._presetStatusLabel.Text = statusText
			elseif controller._presetSource == "MyAnimations" then
				controller._presetStatusLabel.Text = "Click My Animations to load your uploaded Roblox animations."
			else
				controller._presetStatusLabel.Text = "Click Roblox Starter to load official Roblox starter animations."
			end
		end
	end

	local liveRefreshAccumulator = 0
	connect(connections, RunService.Heartbeat, function(deltaTime)
		if not controller._presetsCard or not controller._presetsCard.Parent then
			return
		end
		liveRefreshAccumulator += tonumber(deltaTime) or 0
		if liveRefreshAccumulator &lt; 0.35 then
			return
		end
		liveRefreshAccumulator = 0
		if refresh then
			refresh()
		end
	end)

	controller._callbacks = {
		onImportAnimationId = options.onImportAnimationId,
		onLoadMyAnimations = options.onLoadMyAnimations,
		onLoadMoreMyAnimations = options.onLoadMoreMyAnimations,
		onLoadSavedProjects = options.onLoadSavedProjects,
		onLoadPresetAnimations = options.onLoadPresetAnimations,
		onLoadBulkKeyframeSequences = options.onLoadBulkKeyframeSequences,
		onSearchMarketplaceAnimations = options.onSearchMarketplaceAnimations,
		onSearchMyAnimations = options.onSearchMyAnimations,
		onImportSelectedAnimation = options.onImportSelectedAnimation,
		onOpenR15ToR6Converter = options.onOpenR15ToR6Converter,
		onOpenSavedProject = options.onOpenSavedProject,
		onImportSavedProjectToSelectedRig = options.onImportSavedProjectToSelectedRig,
		onImportBulkKeyframeSequence = options.onImportBulkKeyframeSequence,
	}

	connect(connections, controller._presetFreeButton and controller._presetFreeButton.Activated, function()
		controller:_setPresetSource("RobloxStarter")
		if controller._presetStatusLabel then
			controller._presetStatusLabel.Text = "Loading Roblox Starter packs..."
		end
		if controller._callbacks.onLoadPresetAnimations then
			controller._callbacks.onLoadPresetAnimations()
		end
		requestAsyncRefresh()
	end)
	connect(connections, controller._presetOwnedButton and controller._presetOwnedButton.Activated, function()
		controller:_setPresetSource("MyAnimations")
		if controller._presetStatusLabel then
			controller._presetStatusLabel.Text = "Loading your Roblox animations..."
		end
		if controller._callbacks.onLoadMyAnimations then
			controller._callbacks.onLoadMyAnimations()
		end
		requestAsyncMyAnimationsRefresh()
	end)
	connect(connections, controller._presetRigFilterButton and controller._presetRigFilterButton.Activated, function()
		controller:_cyclePresetRigFilter()
	end)
	connect(connections, controller._presetImportIdButton and controller._presetImportIdButton.Activated, function()
		local importText = controller._presetImportIdInput and controller._presetImportIdInput.Text or ""
		importText = tostring(importText or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if importText ~= "" then
			controller:_importPresetIdInput()
		elseif controller._presetStatusLabel then
			controller._presetStatusLabel.Text = "Paste an Animation ID or URL, then click Import."
			if controller._presetImportIdInput then
				controller._presetImportIdInput:CaptureFocus()
			end
		end
	end)
	connect(connections, controller._presetR15ToR6Button and controller._presetR15ToR6Button.Activated, function()
		if controller._callbacks.onOpenR15ToR6Converter then
			controller._callbacks.onOpenR15ToR6Converter()
		elseif controller._presetStatusLabel then
			controller._presetStatusLabel.Text = "R15 -&gt; R6 Converter is not connected yet."
		end
	end)
	connect(connections, controller._presetSelectedImportButton and controller._presetSelectedImportButton.Activated, function()
		if controller._presetStatusLabel then
			controller._presetStatusLabel.Text = "Importing selected Animation or KeyframeSequence..."
		end
		local result, message = nil, nil
		if controller._callbacks.onImportSelectedAnimation then
			result, message = controller._callbacks.onImportSelectedAnimation()
		end
		requestAsyncRefresh()
		if controller._presetStatusLabel and tostring(message or "") ~= "" then
			controller._presetStatusLabel.Text = tostring(message)
		elseif controller._presetStatusLabel and result == false then
			controller._presetStatusLabel.Text = "Select an Animation or KeyframeSequence in Explorer, then click Selected."
		end
		if result == true then
			closeAfterTimelineImport(options)
		end
	end)
	connect(connections, controller._presetImportIdInput and controller._presetImportIdInput.FocusLost, function(enterPressed)
		if enterPressed then
			controller:_importPresetIdInput()
		end
	end)
	connect(connections, controller._presetSearchInput and controller._presetSearchInput.FocusLost, function(enterPressed)
		if not enterPressed then
			return
		end
		if controller._presetSource == "MyAnimations" and controller._callbacks.onSearchMyAnimations then
			controller._callbacks.onSearchMyAnimations(controller._presetSearchInput.Text)
		elseif controller._callbacks.onSearchMarketplaceAnimations then
			controller._callbacks.onSearchMarketplaceAnimations(controller._presetSearchInput.Text)
		end
		requestAsyncRefresh()
	end)
	connect(connections, controller._presetPreviewCloseButton and controller._presetPreviewCloseButton.Activated, function()
		controller:_hidePresetPreview()
	end)
	connect(connections, controller._presetPreviewImportButton and controller._presetPreviewImportButton.Activated, function()
		local entry = controller._presetPreviewEntry
		if not entry then
			return
		end
		controller:_hidePresetPreview()
		controller:_usePresetEntryForCurrentPurpose(entry)
	end)
	connect(connections, controller._importFromIdButton and controller._importFromIdButton.Activated, function()
		local importText = controller._importIdInput and controller._importIdInput.Text or ""
		local result = nil
		if controller._callbacks.onImportAnimationId then
			result = controller._callbacks.onImportAnimationId(importText)
		end
		requestAsyncRefresh()
		if result ~= false then
			closeAfterTimelineImport(options)
		end
	end)
	connect(connections, controller._browseMyAnimationsButton and controller._browseMyAnimationsButton.Activated, function()
		if controller._callbacks.onLoadMyAnimations then
			controller._callbacks.onLoadMyAnimations()
		end
		requestAsyncMyAnimationsRefresh()
	end)
	connect(connections, controller._browseSavesButton and controller._browseSavesButton.Activated, function()
		if controller._callbacks.onLoadSavedProjects then
			controller._callbacks.onLoadSavedProjects()
		end
		requestAsyncRefresh()
	end)
	connect(connections, controller._loadPresetsButton and controller._loadPresetsButton.Activated, function()
		if controller._callbacks.onLoadPresetAnimations then
			controller._callbacks.onLoadPresetAnimations()
		end
		requestAsyncRefresh()
	end)
	connect(connections, controller._importSelectedButton and controller._importSelectedButton.Activated, function()
		local result, message = nil, nil
		if controller._callbacks.onImportSelectedAnimation then
			result, message = controller._callbacks.onImportSelectedAnimation()
		end
		requestAsyncRefresh()
		if controller._importStatusLabel and tostring(message or "") ~= "" then
			controller._importStatusLabel.Text = tostring(message)
		end
		if result == true then
			closeAfterTimelineImport(options)
		end
	end)
	connect(connections, controller._bulkSelectedButton and controller._bulkSelectedButton.Activated, function()
		if controller._callbacks.onLoadBulkKeyframeSequences then
			controller._callbacks.onLoadBulkKeyframeSequences()
		end
		requestAsyncRefresh()
	end)
	connect(connections, controller._importCloseButton and controller._importCloseButton.Activated, function()
		controller:_hideImportDialog()
	end)

	refresh()
	requestInitialSourceLoad()

	return {
		refresh = refresh,
		destroy = function()
			for _, previewState in pairs(controller._presetPreviewStates or {}) do
				if previewState.connection then
					previewState.connection:Disconnect()
				end
			end
			disconnectAll(connections)
			if controller._presetPreviewOverlay and controller._presetPreviewOverlay.Parent then
				controller._presetPreviewOverlay:Destroy()
			end
			if controller._importOverlay and controller._importOverlay.Parent then
				controller._importOverlay:Destroy()
			end
			if controller._presetsCard and controller._presetsCard.Parent then
				controller._presetsCard:Destroy()
			end
		end,
	}
end

return MicroPresetsPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX86">
          <Properties>
            <string name="Name">MicroProjectPopupSupport</string>
            <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))
local UiMotion = require(script.Parent.Parent:WaitForChild("UiMotion"))
local MicroSavedProjectsSupport = require(script.Parent:WaitForChild("MicroSavedProjectsSupport"))
local SessionSummaryUI = require(script.Parent:WaitForChild("SessionSummaryUI"))

local MicroProjectPopupSupport = {}

local LOGO_IMAGE = Constants.BRAND_ICON

local function create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then
		return false, nil
	end
	local ok, first, second = pcall(callback, ...)
	if not ok then
		warn("[7kg2 Micro] " .. tostring(first))
		return false, tostring(first)
	end
	local message = type(second) == "string" and second or (type(first) == "string" and first or nil)
	if first == false then
		return false, message
	end
	return true, message
end

local function runOption(options, callbackName, fallbackActionName, ...)
	options = options or {}
	if type(options[callbackName]) == "function" then
		return safeCall(options[callbackName], ...)
	end
	if fallbackActionName and type(options.onEditorAction) == "function" then
		return safeCall(options.onEditorAction, fallbackActionName, ...)
	end
	return false, nil
end

local function getTimeline(options)
	return type(options) == "table" and type(options.getTimeline) == "function" and options.getTimeline() or nil
end

local function getProjectName(options)
	local timeline = getTimeline(options)
	if timeline and type(timeline.getAnimationName) == "function" then
		local name = tostring(timeline:getAnimationName() or "")
		if name ~= "" then
			return name
		end
	end
	return "Untitled Animation"
end

local function commitProjectName(options, input)
	if not input then
		return false, "Project name input is not available."
	end
	local name = tostring(input.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then
		input.Text = getProjectName(options)
		return false, "Enter a project name before renaming."
	end
	local ok, message = runOption(options, "onRenameAnimation", "renameAnimation", name)
	if not ok then
		local timeline = getTimeline(options)
		if timeline and type(timeline.renameAnimation) == "function" then
			ok = timeline:renameAnimation(name)
			message = ok and ("Renamed animation to '" .. getProjectName(options) .. "'.") or "Enter a valid animation name before renaming."
		end
	end
	input.Text = getProjectName(options)
	return ok, message
end

local function formatDuration(timeline)
	if not timeline then
		return "Timeline: 0 frames"
	end
	local fps = type(timeline.getFps) == "function" and math.max(1, tonumber(timeline:getFps()) or 60) or 60
	local durationFrames = type(timeline.getDurationFrames) == "function" and math.max(0, tonumber(timeline:getDurationFrames()) or 0) or 0
	return string.format("Timeline: %d frames (%.2fs @ %d FPS)", durationFrames, durationFrames / fps, fps)
end

local function formatCount(value)
	local text = tostring(math.max(0, math.floor(tonumber(value) or 0)))
	while true do
		local formatted, replacements = string.gsub(text, "^(%d+)(%d%d%d)", "%1,%2")
		text = formatted
		if replacements == 0 then
			return text
		end
	end
end

local function findRigAncestor(instance)
	local current = typeof(instance) == "Instance" and instance or nil
	while current and current ~= workspace do
		if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function getProjectRigCount(timeline)
	if not timeline then
		return 0
	end

	local rigs = {}
	local rigNames = {}
	local missingRigNames = {}
	local function addRig(rig)
		if typeof(rig) == "Instance" and rig:IsA("Model") then
			rigs[rig] = true
			rigNames[rig.Name] = true
		end
	end

	if type(timeline.getRigs) == "function" then
		for _, rig in ipairs(timeline:getRigs() or {}) do
			addRig(rig)
		end
	elseif type(timeline.getRig) == "function" then
		addRig(timeline:getRig())
	end

	if type(timeline.getTracks) == "function" then
		for _, track in ipairs(timeline:getTracks() or {}) do
			local rig = findRigAncestor(track and (track.rig or track.instance))
			if rig then
				addRig(rig)
			elseif type(track and track.rigName) == "string" and track.rigName ~= "" then
				missingRigNames[track.rigName] = true
			end
		end
	end

	local count = 0
	for _ in pairs(rigs) do
		count += 1
	end
	for rigName in pairs(missingRigNames) do
		if not rigNames[rigName] then
			count += 1
		end
	end
	return count
end

local function getProjectStatsSummary(timeline)
	local keyCount = timeline and type(timeline.getKeyframeCount) == "function"
		and timeline:getKeyframeCount()
		or 0
	return string.format(
		"Rigs: %s | Keyframes: %s",
		formatCount(getProjectRigCount(timeline)),
		formatCount(keyCount)
	)
end

local function getSelectedTrackSummary(options)
	if type(options) ~= "table" or type(options.getSelectedTrackPaths) ~= "function" then
		return "Selected Track: none"
	end
	local ok, paths = pcall(options.getSelectedTrackPaths)
	if not ok or type(paths) ~= "table" or #paths == 0 then
		return "Selected Track: none"
	end
	if #paths &gt; 1 then
		return string.format("Selected Tracks: %d", #paths)
	end
	return "Selected Track: " .. tostring(paths[1])
end

local function refreshSummary(options, refs)
	local timeline = getTimeline(options)
	if refs._animationNameInput and not refs._animationNameInput:IsFocused() then
		refs._animationNameInput.Text = getProjectName(options)
	end
	if refs._rigLabel then
		refs._rigLabel.Text = getProjectStatsSummary(timeline)
	end
	if refs._keyframeSummary then
		local keyCount = timeline and type(timeline.getKeyframeCount) == "function" and timeline:getKeyframeCount() or 0
		refs._keyframeSummary.Text = string.format("Keyframes: %d", keyCount)
	end
	if refs._durationSummary then
		refs._durationSummary.Text = formatDuration(timeline)
	end
	if refs._selectedJointSummary then
		refs._selectedJointSummary.Text = getSelectedTrackSummary(options)
	end
end

local function placePopup(popup, anchorPanel)
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
	local size = popup.AbsoluteSize
	local width = size.X &gt; 0 and size.X or 430
	local height = size.Y &gt; 0 and size.Y or 600
	local margin = 8
	local anchorPos = anchorPanel and anchorPanel.AbsolutePosition or Vector2.new(80, 80)
	local anchorSize = anchorPanel and anchorPanel.AbsoluteSize or Vector2.new(620, 360)
	local rightX = anchorPos.X + anchorSize.X + 14
	local leftX = anchorPos.X - width - 14
	local x = rightX + width &lt;= viewport.X - margin and rightX or leftX
	if x &lt; margin then
		x = math.clamp(anchorPos.X + math.floor((anchorSize.X - width) * 0.5), margin, math.max(margin, viewport.X - width - margin))
	end
	local y = math.clamp(anchorPos.Y + 8, margin, math.max(margin, viewport.Y - height - margin))
	popup.Position = UDim2.fromOffset(x, y)
end

local function makeDraggable(handle, target)
	local dragging = false
	local dragStart
	local startPosition
	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		dragging = true
		dragStart = input.Position
		startPosition = target.Position
	end)
	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = input.Position - dragStart
		target.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)
end

local function makeResizable(handle, target, minSize, maxSize)
	local resizing = false
	local resizeStart
	local startSize
	minSize = minSize or Vector2.new(360, 330)
	maxSize = maxSize or Vector2.new(760, 680)

	local function stopResize()
		resizing = false
	end

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		resizing = true
		resizeStart = input.Position
		startSize = target.AbsoluteSize
	end)
	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopResize()
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not resizing or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = input.Position - resizeStart
		target.Size = UDim2.fromOffset(
			math.clamp(startSize.X + delta.X, minSize.X, maxSize.X),
			math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
		)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopResize()
		end
	end)
end

local function connectButton(button, callback)
	if not button or type(callback) ~= "function" then
		return
	end
	local lastFireClock = 0
	local function fire()
		local now = os.clock()
		if now - lastFireClock &lt; 0.1 then
			return
		end
		lastFireClock = now
		callback()
	end
	button.Activated:Connect(fire)
	button.MouseButton1Click:Connect(fire)
end

function MicroProjectPopupSupport.open(parent, anchorPanel, options, onClose)
	if not parent then
		return nil
	end

	local modalShield = nil

	local popup = create("Frame", {
		Name = "MicroProjectSummaryPopup",
		BackgroundColor3 = Constants.THEME.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Active = true,
		Position = UDim2.fromOffset(80, 80),
		Size = UDim2.fromOffset(430, 600),
		ZIndex = 90,
		Parent = parent,
	})
	popup.Destroying:Connect(function()
		if modalShield and modalShield.Parent then
			modalShield:Destroy()
		end
	end)
	UiHelpers.applyPanelSurface(popup)
	UiHelpers.createCorner(popup, 12)
	UiHelpers.createStroke(popup, Constants.THEME.Accent, 1)

	local inputSink = create("TextButton", {
		Name = "InputSink",
		Active = true,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 90,
		Parent = popup,
	})

	local titleBar = create("Frame", {
		Name = "TitleBar",
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 42),
		ZIndex = 91,
		Parent = popup,
	})
	UiHelpers.createCorner(titleBar, 12)
	create("Frame", {
		Name = "TitleBarMask",
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -10),
		Size = UDim2.new(1, 0, 0, 10),
		ZIndex = 91,
		Parent = titleBar,
	})

	create("ImageLabel", {
		Name = "Logo",
		BackgroundTransparency = 1,
		Image = LOGO_IMAGE,
		Position = UDim2.fromOffset(12, 8),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(26, 26),
		ZIndex = 92,
		Parent = titleBar,
	})
	create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(46, 0),
		Size = UDim2.fromOffset(166, 42),
		Text = "Project &amp; Session Summary",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 92,
		Parent = titleBar,
	})
	local close = create("TextButton", {
		Name = "CloseButton",
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -34, 0, 8),
		Size = UDim2.fromOffset(24, 24),
		Text = "X",
		TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelSoft),
		TextSize = 12,
		ZIndex = 93,
		Parent = titleBar,
	})
	UiHelpers.createCorner(close, 7)

	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(1, -28, 1, -68),
		ZIndex = 91,
		Parent = popup,
	})
	local refs = SessionSummaryUI.mount(content, {})
	if refs._sessionSummaryCard then
		refs._sessionSummaryCard.Position = UDim2.fromOffset(0, 0)
		refs._sessionSummaryCard.Size = UDim2.fromScale(1, 1)
		refs._sessionSummaryCard.ZIndex = 92
	end
	local summaryStatus = create("TextLabel", {
		Name = "MicroSummaryStatus",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.new(0, 220, 0, 0),
		Size = UDim2.new(1, -268, 1, 0),
		Text = "",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 92,
		Parent = titleBar,
	})
	local function setSummaryStatus(message)
		summaryStatus.Text = tostring(message or "")
	end
	local function runSummaryAction(callbackName, fallbackActionName, ...)
		local ok, message = runOption(options, callbackName, fallbackActionName, ...)
		if not ok and (message == nil or message == "") then
			message = tostring(fallbackActionName or callbackName or "Action") .. " is not connected in Micro yet."
		end
		setSummaryStatus(message)
		refreshSummary(options, refs)
		return ok, message
	end
	if refs._sessionSummaryCollapseButton then
		refs._sessionSummaryCollapseButton.Visible = false
	end
	if refs._performanceDebugLabel then
		refs._performanceDebugLabel.Visible = false
	end
	if refs._summaryStack then
		refs._summaryStack.Visible = false
	end

	local function closePopup()
		if type(onClose) == "function" then
			onClose()
		elseif popup and popup.Parent then
			popup:Destroy()
		end
	end
	connectButton(close, closePopup)
	makeDraggable(titleBar, popup)

	local savedProjectsSummaryController = nil
	if refs._sessionSummaryCard then
		savedProjectsSummaryController = MicroSavedProjectsSupport.mountSummaryList(refs._sessionSummaryCard, {
			onLoadSavedProjects = options.onLoadSavedProjects,
			onOpenSavedProject = options.onOpenSavedProject,
			getImportEntries = options.getImportEntries or options.onGetImportEntries,
			setStatus = setSummaryStatus,
			onProjectOpened = closePopup,
		})
	end

	local savedProjectsController = nil
	if content then
		savedProjectsController = MicroSavedProjectsSupport.mount(content, {
			onLoadSavedProjects = options.onLoadSavedProjects,
			onOpenSavedProject = options.onOpenSavedProject,
			onImportSavedProjectToSelectedRig = options.onImportSavedProjectToSelectedRig,
			promptParent = popup,
			getImportEntries = options.getImportEntries or options.onGetImportEntries,
			setStatus = setSummaryStatus,
			onProjectOpened = closePopup,
			onClose = function()
				if refs._sessionSummaryCard then
					refs._sessionSummaryCard.Visible = true
				end
			end,
		})
	end

	local newPromptOverlay = nil
	local function showNewAnimationPrompt()
		if not newPromptOverlay then
			newPromptOverlay = create("Frame", {
				Name = "NewAnimationPromptOverlay",
				Active = true,
				BackgroundColor3 = Color3.fromRGB(3, 5, 9),
				BackgroundTransparency = 0.16,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 120,
				Parent = popup,
			})
			create("TextButton", {
				Name = "PromptInputSink",
				Active = true,
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				Text = "",
				ZIndex = 121,
				Parent = newPromptOverlay,
			})
			local card = create("Frame", {
				Name = "PromptCard",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Constants.THEME.Panel,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(360, 190),
				ZIndex = 122,
				Parent = newPromptOverlay,
			})
			UiHelpers.applyPanelSurface(card)
			UiHelpers.createCorner(card, 14)
			UiHelpers.createStroke(card, Constants.THEME.Accent, 1)
			create("TextLabel", {
				Name = "PromptTitle",
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Position = UDim2.fromOffset(18, 16),
				Size = UDim2.new(1, -36, 0, 22),
				Text = "Start a new animation?",
				TextColor3 = Constants.THEME.Text,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 123,
				Parent = card,
			})
			create("TextLabel", {
				Name = "PromptMessage",
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				Position = UDim2.fromOffset(18, 48),
				Size = UDim2.new(1, -36, 0, 52),
				Text = "This clears the current Micro timeline, tracks, keyframes, markers, effects, and temporary attachments. Save first if you want to keep this work.",
				TextColor3 = Constants.THEME.MutedText,
				TextSize = 11,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 123,
				Parent = card,
			})
			local save = create("TextButton", {
				Name = "SaveAndContinueButton",
				BackgroundColor3 = Constants.THEME.Accent,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Position = UDim2.fromOffset(18, 112),
				Size = UDim2.fromOffset(154, 34),
				Text = "Save And Continue",
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.Accent),
				TextSize = 11,
				ZIndex = 123,
				Parent = card,
			})
			UiHelpers.createCorner(save, 9)
			local discard = create("TextButton", {
				Name = "ContinueWithoutSavingButton",
				BackgroundColor3 = Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Position = UDim2.fromOffset(182, 112),
				Size = UDim2.fromOffset(160, 34),
				Text = "Continue Without Saving",
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelSoft),
				TextSize = 10,
				ZIndex = 123,
				Parent = card,
			})
			UiHelpers.createCorner(discard, 9)
			local cancel = create("TextButton", {
				Name = "CancelButton",
				BackgroundColor3 = Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Position = UDim2.new(1, -118, 1, -34),
				Size = UDim2.fromOffset(100, 24),
				Text = "Cancel",
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelSoft),
				TextSize = 11,
				ZIndex = 123,
				Parent = card,
			})
			UiHelpers.createCorner(cancel, 8)
			connectButton(save, function()
				local ok, message = runSummaryAction("onSaveAndNewAnimation", "saveAndNewAnimation")
				newPromptOverlay.Visible = false
				setSummaryStatus(message or (ok and "Saved and started a new animation." or "Save failed. New animation was not started."))
				if ok then
					closePopup()
				end
			end)
			connectButton(discard, function()
				local ok, message = runSummaryAction("onNewAnimation", "newAnimation")
				newPromptOverlay.Visible = false
				setSummaryStatus(message or (ok and "Started a new blank animation." or "New animation is not connected in Micro yet."))
				if ok then
					closePopup()
				end
			end)
			connectButton(cancel, function()
				newPromptOverlay.Visible = false
				setSummaryStatus("New animation cancelled.")
			end)
		end
		newPromptOverlay.Visible = true
		setSummaryStatus("Choose whether to save before starting a new animation.")
	end

	local resizeGrip = create("ImageButton", {
		Name = "ResizeGrip",
		Active = true,
		AnchorPoint = Vector2.new(1, 1),
		AutoButtonColor = false,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = "rbxassetid://104703373565023",
		ImageColor3 = Constants.THEME.Text,
		ImageTransparency = 1,
		Position = UDim2.new(1, -5, 1, -5),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(16, 16),
		ZIndex = 98,
		Parent = popup,
	})
	resizeGrip:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	resizeGrip:SetAttribute("MegMoThemeImageRole", "Text")
	UiHelpers.createCorner(resizeGrip, 4)
	local gripResizing = false
	local function setResizeGripVisible(visible)
		resizeGrip.BackgroundTransparency = visible and 0.42 or 1
		resizeGrip.ImageTransparency = visible and 0.08 or 1
	end
	resizeGrip.MouseEnter:Connect(function()
		setResizeGripVisible(true)
	end)
	resizeGrip.MouseLeave:Connect(function()
		if gripResizing then
			return
		end
		setResizeGripVisible(false)
	end)
	resizeGrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			gripResizing = true
			setResizeGripVisible(true)
		end
	end)
	resizeGrip.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			gripResizing = false
			setResizeGripVisible(false)
		end
	end)
	makeResizable(resizeGrip, popup, Vector2.new(430, 520), Vector2.new(760, 760))

	if refs._animationNameInput then
		refs._animationNameInput.FocusLost:Connect(function()
			local _, message = commitProjectName(options, refs._animationNameInput)
			setSummaryStatus(message)
			refreshSummary(options, refs)
		end)
	end
	if refs._newAnimationButton then
		connectButton(refs._newAnimationButton, function()
			showNewAnimationPrompt()
		end)
	end
	if refs._saveButton then
		connectButton(refs._saveButton, function()
			local renameOk, renameMessage = commitProjectName(options, refs._animationNameInput)
			local saveOk, saveMessage = runSummaryAction("onSaveAnimation", "saveAnimation")
			setSummaryStatus(saveMessage or renameMessage or (saveOk and "Saved project." or (renameOk and "Project name updated." or "Save is not connected in Micro yet.")))
			if saveOk and savedProjectsController then
				savedProjectsController.refresh(true)
			end
			if saveOk and savedProjectsSummaryController then
				savedProjectsSummaryController.refresh(false)
			end
		end)
	end
	if refs._importButton then
		connectButton(refs._importButton, function()
			if savedProjectsController then
				if refs._sessionSummaryCard then
					refs._sessionSummaryCard.Visible = false
				end
				savedProjectsController.refresh(true)
				savedProjectsController.show()
			else
				runSummaryAction("onLoadSavedProjects", "loadSavedProjects")
			end
		end)
	end
	if refs._exportButton then
		connectButton(refs._exportButton, function()
			runSummaryAction("onExportAnimation", "exportAnimation")
		end)
	end

	local rigButtons = {
		{ refs._insertR6Button, "R6" },
		{ refs._insertR15Button, "R15", "Classic" },
		{ refs._insertR15ModernButton, "R15", "Modern" },
	}
	for _, spec in ipairs(rigButtons) do
		local button = spec[1]
		if button then
			connectButton(button, function()
				runSummaryAction("onInsertDefaultRig", nil, spec[2], spec[3])
			end)
		end
	end
	if refs._insertAvatarButton then
		local avatarRigType = "R15Classic"
		local function setAvatarRigType(nextType)
			avatarRigType = tostring(nextType or "R15Classic")
			if avatarRigType ~= "R6" and avatarRigType ~= "R15Modern" then
				avatarRigType = "R15Classic"
			end
			if refs._avatarRigTypeButton then
				refs._avatarRigTypeButton.Text = avatarRigType == "R6" and "Avatar Type: R6"
					or (avatarRigType == "R15Modern" and "Avatar Type: R15 Modern" or "Avatar Type: R15 Classic")
			end
		end
		if refs._avatarRigTypeButton then
			connectButton(refs._avatarRigTypeButton, function()
				if avatarRigType == "R6" then
					setAvatarRigType("R15Classic")
				elseif avatarRigType == "R15Classic" then
					setAvatarRigType("R15Modern")
				else
					setAvatarRigType("R6")
				end
				setSummaryStatus(refs._avatarRigTypeButton.Text)
			end)
		end
		setAvatarRigType("R15Classic")
		connectButton(refs._insertAvatarButton, function()
			local text = refs._avatarInput and refs._avatarInput.Text or ""
			runSummaryAction("onInsertAvatarRig", nil, text, avatarRigType)
		end)
	end

	refreshSummary(options, refs)
	if savedProjectsController then
		savedProjectsController.refresh(true)
	end
	if savedProjectsSummaryController then
		savedProjectsSummaryController.refresh(false)
	end
	task.defer(function()
		placePopup(popup, anchorPanel)
		ThemeService.applyToGui(popup)
		UiMotion.popupIn(popup)
	end)
	return popup
end

return MicroProjectPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX87">
          <Properties>
            <string name="Name">MicroRepeatFramesPopupSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local RepeatFramesUI = require(script.Parent:WaitForChild("RepeatFramesUI"))
local WidgetOverlayStateSupport = require(script.Parent.Parent:WaitForChild("WidgetOverlayStateSupport"))

local MicroRepeatFramesPopupSupport = {}

local function connect(connections, signal, handler)
	if not signal or type(handler) ~= "function" then
		return nil
	end
	local connection = signal:Connect(handler)
	table.insert(connections, connection)
	return connection
end

local function disconnectAll(connections)
	for _, connection in ipairs(connections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	table.clear(connections)
end

local function setStatus(options, message)
	if type(options.onStatus) == "function" then
		options.onStatus(message)
	end
end

function MicroRepeatFramesPopupSupport.mount(parent, options)
	if not parent then
		error("MicroRepeatFramesPopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local controller = {}
	local refs = RepeatFramesUI.mount(parent, {})
	for key, value in pairs(refs or {}) do
		controller[key] = value
	end

	local function close()
		WidgetOverlayStateSupport.hideRepeatFramesOverlay(controller)
	end

	local function open()
		local defaults = {}
		if type(options.getDefaults) == "function" then
			local ok, result = pcall(options.getDefaults)
			if ok and type(result) == "table" then
				defaults = result
			end
		end
		WidgetOverlayStateSupport.showRepeatFramesOverlay(controller, defaults)
		setStatus(options, "Repeat Frames open: choose loop count, length, end time, or To End.")
	end

	connect(connections, controller._repeatFramesCloseButton and controller._repeatFramesCloseButton.Activated, close)
	connect(connections, controller._repeatFramesCancelButton and controller._repeatFramesCancelButton.Activated, close)
	connect(connections, controller._repeatFramesToEndButton and controller._repeatFramesToEndButton.Activated, function()
		controller._repeatFramesToEnd = not controller._repeatFramesToEnd
		if controller._repeatFramesToEndButton then
			controller._repeatFramesToEndButton.Text = controller._repeatFramesToEnd and "To End: On" or "To End"
			controller._repeatFramesToEndButton.BackgroundColor3 = controller._repeatFramesToEnd and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		end
	end)
	connect(connections, controller._repeatFramesOkButton and controller._repeatFramesOkButton.Activated, function()
		local repeatOptions = WidgetOverlayStateSupport.getRepeatFramesOptions(controller)
		local success, message = true, nil
		if type(options.onRepeatFrames) == "function" then
			success, message = options.onRepeatFrames(repeatOptions)
		else
			success, message = false, "Repeat Frames is not connected yet."
		end
		setStatus(options, message or (success == false and "Repeat Frames failed." or "Repeated selected keyframes."))
		if success ~= false then
			close()
		elseif controller._repeatFramesStatusLabel then
			controller._repeatFramesStatusLabel.Text = tostring(message or "Repeat Frames failed.")
		end
	end)

	return {
		open = open,
		close = close,
		destroy = function()
			disconnectAll(connections)
			if controller._repeatFramesOverlay and controller._repeatFramesOverlay.Parent then
				controller._repeatFramesOverlay:Destroy()
			end
		end,
	}
end

return MicroRepeatFramesPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX88">
          <Properties>
            <string name="Name">MicroSavedProjectsSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local MicroSavedProjectsSupport = {}

local function create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

local function call(callback, ...)
	if type(callback) ~= "function" then
		return false, nil
	end
	local ok, first, second = pcall(callback, ...)
	if not ok then
		warn("[7kg2 Micro] " .. tostring(first))
		return false, tostring(first)
	end
	local message = type(second) == "string" and second or (type(first) == "string" and first or nil)
	if first == false then
		return false, message
	end
	return true, message
end

local function formatSavedAt(value)
	local text = tostring(value or "")
	local year, month, day, hour, minute = string.match(text, "^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+)")
	if year then
		return string.format("%s/%s/%s  %s:%s", day, month, year, hour, minute)
	end
	return text
end

local function getSavedEntries(options)
	local callback = options and (options.getImportEntries or options.onGetImportEntries)
	if type(callback) ~= "function" then
		return {}
	end
	local ok, entries = pcall(callback)
	if not ok or type(entries) ~= "table" then
		return {}
	end
	local savedEntries = {}
	for _, entry in ipairs(entries) do
		if type(entry) == "table" and entry.entryType == "SavedProject" then
			table.insert(savedEntries, entry)
		end
	end
	table.sort(savedEntries, function(a, b)
		if (tonumber(a.sortTime) or 0) ~= (tonumber(b.sortTime) or 0) then
			return (tonumber(a.sortTime) or 0) &gt; (tonumber(b.sortTime) or 0)
		end
		return tostring(a.name or a.id) &lt; tostring(b.name or b.id)
	end)
	return savedEntries
end

function MicroSavedProjectsSupport.mountSummaryList(parent, options)
	options = options or {}
	local controller = {}
	local rows = {}

	local summary = create("Frame", {
		Name = "MicroSavedProjectsSummary",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 322),
		Size = UDim2.new(1, -28, 1, -332),
		Parent = parent,
	})
	local title = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(0.7, 0, 0, 22),
		Text = "Saved Projects",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = summary,
	})
	title:SetAttribute("MegMoThemeTextRole", "Text")
	local countLabel = create("TextLabel", {
		Name = "ProjectCount",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0.7, 0, 0, 0),
		Size = UDim2.new(0.3, 0, 0, 22),
		Text = "0 projects",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = summary,
	})
	countLabel:SetAttribute("MegMoThemeTextRole", "MutedText")

	local list = create("ScrollingFrame", {
		Name = "SavedProjectsList",
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BackgroundTransparency = 0.24,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 0),
		Position = UDim2.fromOffset(0, 26),
		ScrollBarImageColor3 = Constants.THEME.Accent,
		ScrollBarThickness = 4,
		Size = UDim2.new(1, 0, 1, -26),
		Parent = summary,
	})
	list:SetAttribute("MegMoThemeBackgroundRole", "PanelAlt")
	list:SetAttribute("MegMoThemeScrollBarRole", "Accent")
	UiHelpers.createCorner(list, 8)
	local listStroke = UiHelpers.createStroke(list, Constants.THEME.Border, 1)
	listStroke.Transparency = 0.45
	listStroke:SetAttribute("MegMoThemeStrokeRole", "Border")
	create("UIPadding", {
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 6),
		Parent = list,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	local emptyLabel = create("TextLabel", {
		Name = "EmptyLabel",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = 1,
		Size = UDim2.new(1, -4, 0, 44),
		Text = "No saved projects yet.\nUse Save to add this project.",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextWrapped = true,
		Parent = list,
	})
	emptyLabel:SetAttribute("MegMoThemeTextRole", "MutedText")

	local function clearRows()
		for _, row in ipairs(rows) do
			if row and row.Parent then
				row:Destroy()
			end
		end
		table.clear(rows)
	end

	local function openEntry(entry)
		local ok, message = call(options.onOpenSavedProject, entry.id)
		if type(options.setStatus) == "function" then
			options.setStatus(message or (ok and ("Opened '" .. tostring(entry.name or "project") .. "'.") or "That saved project could not be opened."))
		end
		if ok and type(options.onProjectOpened) == "function" then
			options.onProjectOpened()
		end
	end

	local function createEntryRow(entry, order)
		local row = create("Frame", {
			Name = "SavedProjectSummaryRow",
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Size = UDim2.new(1, -4, 0, 42),
			Parent = list,
		})
		row:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		UiHelpers.createCorner(row, 7)
		local rowStroke = UiHelpers.createStroke(row, Constants.THEME.Border, 1)
		rowStroke.Transparency = 0.46
		rowStroke:SetAttribute("MegMoThemeStrokeRole", "Border")
		local nameLabel = create("TextLabel", {
			Name = "ProjectName",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(9, 4),
			Size = UDim2.new(1, -90, 0, 17),
			Text = tostring(entry.name or "Untitled Project"),
			TextColor3 = Constants.THEME.Text,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		nameLabel:SetAttribute("MegMoThemeTextRole", "Text")
		local savedAt = formatSavedAt(entry.priceLabel)
		local category = tostring(entry.category or "Project")
		local metaLabel = create("TextLabel", {
			Name = "ProjectMeta",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.fromOffset(9, 22),
			Size = UDim2.new(1, -90, 0, 14),
			Text = savedAt ~= "" and (category .. "  |  " .. savedAt) or category,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 9,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		metaLabel:SetAttribute("MegMoThemeTextRole", "MutedText")
		local openButton = create("TextButton", {
			Name = "OpenButton",
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(66, 28),
			Text = "Open",
			TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelAlt),
			TextSize = 10,
			Parent = row,
		})
		openButton:SetAttribute("MegMoThemeBackgroundRole", "PanelAlt")
		openButton:SetAttribute("MegMoThemeTextRole", "__auto")
		UiHelpers.createCorner(openButton, 6)
		local openStroke = UiHelpers.createStroke(openButton, Constants.THEME.Border, 1)
		openStroke.Transparency = 0.32
		openStroke:SetAttribute("MegMoThemeStrokeRole", "Border")
		openButton.Activated:Connect(function()
			openEntry(entry)
		end)
		table.insert(rows, row)
	end

	function controller.refresh(reload)
		if reload then
			call(options.onLoadSavedProjects)
		end
		local entries = getSavedEntries(options)
		clearRows()
		emptyLabel.Visible = #entries == 0
		countLabel.Text = string.format("%d project%s", #entries, #entries == 1 and "" or "s")
		for index, entry in ipairs(entries) do
			createEntryRow(entry, index + 1)
		end
	end

	function controller.destroy()
		clearRows()
		if summary.Parent then
			summary:Destroy()
		end
	end

	return controller
end

function MicroSavedProjectsSupport.mount(parent, options)
	options = options or {}
	local controller = {}
	local rows = {}
	local allEntries = {}
	local filteredEntries = {}
	local currentPage = 1
	local pageSize = 6

	local browser = create("Frame", {
		Name = "MicroSavedProjectsBrowser",
		Active = true,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
