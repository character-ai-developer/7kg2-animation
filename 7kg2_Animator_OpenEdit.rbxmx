	})
	applySectionSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 16),
		Size = UDim2.new(1, -54, 0, 22),
		Font = Enum.Font.GothamSemibold,
