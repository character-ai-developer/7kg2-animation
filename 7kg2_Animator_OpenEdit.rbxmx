function editorActions.setScreenEffectKeyPreset(trackPath, presetName)
	local track = timeline:getTrackByPath(trackPath)
	if not ScreenEffectTrackService.isScreenEffectTrack(track) then
		refreshUi("Select a screen effect track before editing effect settings.")
		return
	end

	pushUndo("Set Screen Effect Keyframe")
	ChangeHistoryService:SetWaypoint("Before Set Screen Effect Keyframe")
	local value = ScreenEffectTrackService.fadePreset(presetName)
	local success, message = timeline:setTrackValueAtFrame(track.path, timeline:getCurrentFrame(), value)
	if success then
		setSingleSelectedTrack(track.path)
		selectKeys({
			{
				jointPath = track.path,
				frame = timeline:getCurrentFrame(),
			},
		})
		ChangeHistoryService:SetWaypoint("After Set Screen Effect Keyframe")
		refreshUi(string.format("Set %s fade keyframe at frame %d.", tostring(presetName or "Fade"), timeline:getCurrentFrame()))
	else
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set effect keyframe.")
	end
end

