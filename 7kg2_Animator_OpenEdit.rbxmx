	timelineToolbar:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyToolbarResponsiveLayout)
	timelineCard:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyToolbarResponsiveLayout)
	task.defer(applyToolbarResponsiveLayout)

	local leftTrackColumn = create("Frame", {
