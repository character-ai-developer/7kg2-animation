local function currentTheme()
	local ok, themeService = pcall(function()
		return require(script.Parent.Parent:WaitForChild("ThemeService"))
	end)
	if ok and themeService and type(themeService.getCurrentTheme) == "function" then
		local theme = themeService.getCurrentTheme()
		if theme and theme.colors then
			return theme.colors
		end
	end
	return Constants.THEME
end

local function showHint(config, text, anchor)
	local toolHint = config.toolHint
	if not (toolHint and anchor) then
		return
	end
	toolHint.Text = tostring(text or "")
	local height = math.max(20, toolHint.AbsoluteSize.Y)
	local width = math.clamp(math.floor((toolHint.TextBounds.X or 0) + 18), 80, 260)
	toolHint.Size = UDim2.fromOffset(width, height)
	local parent = toolHint.Parent
	local parentOffset = Vector2.new(0, 0)
	local parentSize = nil
	if parent and parent:IsA("GuiObject") then
		parentOffset = parent.AbsolutePosition
		parentSize = parent.AbsoluteSize
	end
	local anchorPosition = anchor.AbsolutePosition
	local anchorSize = anchor.AbsoluteSize
	local x = math.floor(anchorPosition.X - parentOffset.X + (anchorSize.X * 0.5) - (width * 0.5))
	local y = math.floor(anchorPosition.Y - parentOffset.Y + anchorSize.Y + 8)
	if parentSize then
		x = math.clamp(x, 6, math.max(6, parentSize.X - width - 6))
		y = math.clamp(y, 6, math.max(6, parentSize.Y - height - 6))
	end
	toolHint.Position = UDim2.fromOffset(x, y)
	toolHint.Visible = true
end

local function createEditButton(config, action, layoutOrder)
	local theme = currentTheme()
	local button = Instance.new("ImageButton")
	button.Name = "Viewport" .. action.name .. "Button"
	button.AutoButtonColor = true
	button.BackgroundColor3 = theme.PanelSoft
	button.BorderSizePixel = 0
	button.Image = action.image
	button.ImageColor3 = theme.Text
	button.LayoutOrder = layoutOrder
	button.ScaleType = Enum.ScaleType.Fit
	button.Size = UDim2.fromOffset(42, 36)
	button.ZIndex = 52
	button:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	button:SetAttribute("MegMoThemeImageRole", "Text")
	button.Parent = config.parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = theme.Border
	stroke.Thickness = 1
	stroke.Transparency = 0.28
	stroke:SetAttribute("MegMoThemeStrokeRole", "Border")
	stroke.Parent = button
	MicroViewportButtonStyleSupport.apply(button)

	button.MouseEnter:Connect(function()
		showHint(config, action.tooltip, button)
	end)
	button.MouseLeave:Connect(function()
		if config.toolHint then
			config.toolHint.Visible = false
		end
	end)
	button.Activated:Connect(function()
		if config.plugin then
			pcall(function()
				config.plugin:Activate(true)
			end)
		end
		local ok, message
		if type(config.runAction) == "function" then
			ok, message = config.runAction(action)
		end
		if config.statusLabel then
			config.statusLabel.Text = tostring(message or action.status or (ok and action.name .. " finished." or action.name .. " unavailable."))
		end
		if type(config.refresh) == "function" then
			task.defer(config.refresh)
		end
	end)

	return button
end

function MicroViewportEditButtonsSupport.mount(config)
	if type(config) ~= "table" or not config.parent then
		return {}
	end
	local buttons = {}
	local startOrder = tonumber(config.layoutOrderStart) or 910
	for index, action in ipairs(EDIT_BUTTONS) do
		buttons[action.name] = createEditButton(config, action, startOrder + index)
	end
	return buttons
end

return MicroViewportEditButtonsSupport
