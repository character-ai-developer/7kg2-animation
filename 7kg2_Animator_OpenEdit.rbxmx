      <Item class="ModuleScript" referent="RBX126">
        <Properties>
          <string name="Name">EasingSelectionSupport</string>
          <ProtectedString name="Source">local EasingSelectionSupport = {}

function EasingSelectionSupport.getNextOption(options, current)
	for index, option in ipairs(options) do
		if option == current then
			return options[(index % #options) + 1]
		end
	end
	return options[1]
end

function EasingSelectionSupport.getCycledStyle(options, currentStyle)
	return EasingSelectionSupport.getNextOption(options, currentStyle)
end

function EasingSelectionSupport.getCycledDirection(options, currentDirection)
	return EasingSelectionSupport.getNextOption(options, currentDirection)
end

return EasingSelectionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX127">
        <Properties>
          <string name="Name">EasingVisualSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local EasingVisualSupport = {}

local function normalizeName(value, fallback)
	if typeof(value) == "EnumItem" then
		return value.Name
	end
	if value == nil or value == "" then
		return fallback
	end
	return tostring(value)
end

function EasingVisualSupport.styleName(easingStyle)
	return normalizeName(easingStyle, Constants.DEFAULT_EASING_STYLE or "Linear")
end

function EasingVisualSupport.directionName(easingDirection)
	return normalizeName(easingDirection, Constants.DEFAULT_EASING_DIRECTION or "InOut")
end

function EasingVisualSupport.getColor(easingStyle)
	local styleName = EasingVisualSupport.styleName(easingStyle)
	local colors = Constants.EASING_STYLE_COLORS or {}
	return colors[styleName]
		or colors[Constants.DEFAULT_EASING_STYLE]
		or Color3.fromRGB(180, 190, 205)
end

function EasingVisualSupport.getHighlightColor(easingStyle)
	local styleName = EasingVisualSupport.styleName(easingStyle)
	if styleName == "" or styleName == (Constants.DEFAULT_EASING_STYLE or "Linear") then
		return nil
	end
	return EasingVisualSupport.getColor(styleName)
end

function EasingVisualSupport.getTooltip(easingStyle, easingDirection)
	return string.format(
		"Style: %s | Direction: %s",
		EasingVisualSupport.styleName(easingStyle),
		EasingVisualSupport.directionName(easingDirection)
	)
end

return EasingVisualSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX128">
        <Properties>
          <string name="Name">EditorHistoryMutationSupport</string>
          <ProtectedString name="Source">local EditorHistoryMutationSupport = {}

function EditorHistoryMutationSupport.push(historyService, label, snapshot)
	historyService:push(label, snapshot)
	return 1
end

function EditorHistoryMutationSupport.reset(historyService)
	historyService:reset()
end

return EditorHistoryMutationSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX129">
        <Properties>
          <string name="Name">EditorHistoryService</string>
          <ProtectedString name="Source">local EditorHistoryService = {}
EditorHistoryService.__index = EditorHistoryService

function EditorHistoryService.new(maxHistory)
	return setmetatable({
		_maxHistory = math.max(1, tonumber(maxHistory) or 50),
		_undoStack = {},
		_redoStack = {},
	}, EditorHistoryService)
end

function EditorHistoryService:push(label, snapshot)
	table.insert(self._undoStack, snapshot)
	if #self._undoStack &gt; self._maxHistory then
		table.remove(self._undoStack, 1)
	end
	self._redoStack = {}
end

function EditorHistoryService:discardPendingUndo()
	return table.remove(self._undoStack)
end

function EditorHistoryService:reset()
	self._undoStack = {}
	self._redoStack = {}
end

function EditorHistoryService:performUndo(createSnapshot, restoreSnapshot)
	local snapshot = table.remove(self._undoStack)
	if not snapshot then
		return false, "There is nothing to undo."
	end

	table.insert(self._redoStack, createSnapshot("Redo"))
	restoreSnapshot(snapshot)
	return true, string.format("Undid %s.", snapshot.label or "edit")
end

function EditorHistoryService:performRedo(createSnapshot, restoreSnapshot)
	local snapshot = table.remove(self._redoStack)
	if not snapshot then
		return false, "There is nothing to redo."
	end

	table.insert(self._undoStack, createSnapshot("Undo"))
	restoreSnapshot(snapshot)
	return true, "Redid edit."
end

return EditorHistoryService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX130">
        <Properties>
          <string name="Name">EditorSnapshotSupport</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local EditorSnapshotSupport = {}

function EditorSnapshotSupport.create(label, timeline, selectedJointPath, selectedKeyframeFrame, selectedKeys, selectedTrackPaths, keyframeEditService, facesController)
	return {
		label = label,
		timeline = timeline:createSnapshot(),
		selectedJointPath = selectedJointPath,
		selectedKeyframeFrame = selectedKeyframeFrame,
		selectedKeys = SelectionState.cloneSelectedKeys(selectedKeys),
		selectedTrackPaths = SelectionState.cloneSelectedTracks(selectedTrackPaths),
		keyframeEdit = keyframeEditService:createSnapshotData(),
		faces = facesController:getSaveData(),
	}
end

function EditorSnapshotSupport.restore(snapshot, options)
	if not snapshot then
		return false
	end

	local timeline = options.timeline
	local keyframeEditService = options.keyframeEditService
	local facesController = options.facesController
	local modules = options.modules
	local editorActions = options.editorActions

	timeline:restoreSnapshot(snapshot.timeline)
	keyframeEditService:restoreSnapshotData(snapshot.keyframeEdit)
	if snapshot.faces then
		facesController:restoreSaveData(snapshot.faces)
	end
	pcall(function()
		require(modules:WaitForChild("AttachService")).prepareTimelineState(timeline, timeline:getCurrentFrame())
	end)
	timeline:resetRigPose()
	timeline:applyCurrentFrame()
	pcall(function()
		require(modules:WaitForChild("AttachService")).applyTimelineState(timeline, timeline:getCurrentFrame())
	end)
	if editorActions._trackballTool and type(editorActions._trackballTool.SyncToCurrentPose) == "function" then
		editorActions._trackballTool:SyncToCurrentPose()
	end

	return true, {
		selectedJointPath = snapshot.selectedJointPath,
		selectedKeyframeFrame = snapshot.selectedKeyframeFrame,
		selectedKeys = SelectionState.cloneSelectedKeys(snapshot.selectedKeys),
		selectedTrackPaths = SelectionState.cloneSelectedTracks(snapshot.selectedTrackPaths),
	}
end

return EditorSnapshotSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX131">
        <Properties>
          <string name="Name">EffectsActionBinder</string>
          <ProtectedString name="Source">local EffectsActionBinder = {}

local function connect(controller, button, callback)
	if controller and button and type(callback) == "function" then
		controller:_connect(button.Activated, callback)
	end
end

local function focus(controller, message)
	if controller and type(controller._focusShortcutCapture) == "function" then
		controller:_focusShortcutCapture(message)
	elseif controller and type(controller._setShortcutHint) == "function" then
		controller:_setShortcutHint(message)
	end
end

local CINEMATIC_PRESET_NAMES = {
	OrbitShot = "Orbit Shot",
	DollyIn = "Dolly Zoom",
	DollyOut = "Reverse Dolly Zoom",
	HeroReveal = "Hero Reveal",
	OverShoulder = "Over Shoulder",
	CrashZoom = "Crash Zoom",
	FollowCam = "Follow Cam",
	FaceFocus = "Face Focus",
}

local function setCinematicPreset(controller, presetId)
	if not controller or not CINEMATIC_PRESET_NAMES[presetId] then
		return
	end
	controller._effectsCameraPreviewPresetId = presetId
	if controller._effectsCameraPreviewButton then
		controller._effectsCameraPreviewButton.Text = CINEMATIC_PRESET_NAMES[presetId]
	end
end

local function selectedTrack(controller)
	if controller and type(controller._getOptionsTrackFromSelection) == "function" then
		return controller:_getOptionsTrackFromSelection()
	end
	return nil
end

local function selectedBaseTrackPath(controller)
	local track = selectedTrack(controller)
	if not track then
		return nil
	end
	if track.parentTrackPath then
		return track.parentTrackPath
	end
	return track.path
end

local function addRigOrObjectProperty(controller, callbacks, propertyName)
	local track = selectedTrack(controller)
	if not track then
		focus(controller, "Select a rig, model, object, or property track first.")
		return
	end

	if track.rigName and callbacks.onToggleRigPropertyTrack then
		callbacks.onToggleRigPropertyTrack(track.rigName, propertyName, true)
		focus(controller, "Added " .. propertyName .. " property track.")
		return
	end

	local basePath = selectedBaseTrackPath(controller)
	if basePath and callbacks.onTogglePropertyTrack then
		callbacks.onTogglePropertyTrack(basePath, propertyName, true)
		focus(controller, "Added " .. propertyName .. " property track.")
		return
	end

	focus(controller, "That selected track cannot add " .. propertyName .. " yet.")
end

local function addParticleProperty(controller, callbacks, propertyName)
	local basePath = selectedBaseTrackPath(controller)
	if not basePath then
		focus(controller, "Select an emitter group or ParticleEmitter track first.")
		return
	end
	if callbacks.onTogglePropertyTrack then
		callbacks.onTogglePropertyTrack(basePath, propertyName, true)
		focus(controller, "Added particle " .. propertyName .. " track.")
	end
end

local function findChildPropertyTrack(controller, parentTrackPath, propertyName)
	local viewModel = controller and controller._lastViewModel or {}
	for _, track in ipairs(viewModel.tracks or {}) do
		if track
			and track.parentTrackPath == parentTrackPath
			and track.propertyName == propertyName
			and (track.targetScope == "ObjectProperty" or track.targetScope == "EmitterGroupProperty")
		then
			return track
		end
	end
	return nil
end

local function applyParticleSlowMotion(controller, callbacks)
	local track = selectedTrack(controller)
	if not track then
		focus(controller, "Select an emitter group or ParticleEmitter track first.")
		return
	end

	local targetTrack = nil
	if track.propertyName == "TimeScale"
		and (track.targetScope == "ObjectProperty" or track.targetScope == "EmitterGroupProperty")
	then
		targetTrack = track
	else
		local basePath = selectedBaseTrackPath(controller)
		if not basePath then
			focus(controller, "Select an emitter group or ParticleEmitter track first.")
			return
		end

		targetTrack = findChildPropertyTrack(controller, basePath, "TimeScale")
		if not targetTrack and callbacks.onTogglePropertyTrack then
			callbacks.onTogglePropertyTrack(basePath, "TimeScale", true)
			targetTrack = findChildPropertyTrack(controller, basePath, "TimeScale") or selectedTrack(controller)
		end
	end

	if not targetTrack or not targetTrack.path then
		focus(controller, "Could not create or select the particle TimeScale track.")
		return
	end

	if callbacks.onSetParticleEmitterPropertyKey then
		callbacks.onSetParticleEmitterPropertyKey(targetTrack.path, "0.1", nil)
		if controller and type(controller._setEffectsOverlayVisible) == "function" then
			controller:_setEffectsOverlayVisible(false)
		elseif controller and controller._effectsOverlay then
			controller._effectsOverlay.Visible = false
		end
		focus(controller, "Particle Slow Motion applied: TimeScale set to 0.1 at the playhead.")
	else
		focus(controller, "Particle Slow Motion needs the particle keyframe editor callback.")
	end
end

local function applyCameraPreset(controller, callbacks, presetId)
	if not callbacks.onApplyCameraPreset then
		return false
	end

	local options = {}
	if controller and type(controller._getCameraPresetOptions) == "function" then
		options = controller:_getCameraPresetOptions()
	end
	local success = callbacks.onApplyCameraPreset(presetId, options)
	focus(controller, "Camera effect applied: " .. tostring(presetId))
	return success ~= false
end

local function applyCinematicCameraPreset(controller, callbacks, presetId)
	setCinematicPreset(controller, presetId)
	local applied = applyCameraPreset(controller, callbacks, presetId)
	if applied and controller and type(controller._setEffectsOverlayVisible) == "function" then
		controller:_setEffectsOverlayVisible(false)
	end
	return applied
end

local function previewCameraPreset(controller, callbacks)
	if not callbacks.onApplyCameraPreset then
		return
	end

	local presetId = controller and controller._effectsCameraPreviewPresetId or "OrbitShot"
	if not CINEMATIC_PRESET_NAMES[presetId] then
		presetId = "OrbitShot"
	end
	setCinematicPreset(controller, presetId)
	local options = {}
	if controller and type(controller._getCameraPresetOptions) == "function" then
		options = controller:_getCameraPresetOptions()
	end
	options.previewOnly = true
	callbacks.onApplyCameraPreset(presetId, options)
	focus(controller, "Previewing camera effect: " .. (CINEMATIC_PRESET_NAMES[presetId] or tostring(presetId)))
end

local function setupCameraFollow(controller, presetId)
	if controller and type(controller._showCameraFollowOverlay) == "function" then
		setCinematicPreset(controller, presetId)
		if type(controller._setEffectsOverlayVisible) == "function" then
			controller:_setEffectsOverlayVisible(false)
		elseif controller._effectsOverlay then
			controller._effectsOverlay.Visible = false
		end
		controller:_showCameraFollowOverlay(presetId)
		focus(controller, "Camera follow setup open.")
	end
end

local function bindCameraSettings(controller, callbacks)
	if not controller then
		return
	end

	connect(controller, controller._effectsCameraOrbitAngleButton, function()
		controller._cameraOrbitAngleMode = controller._cameraOrbitAngleMode == "Full" and "Half" or "Full"
		controller._effectsCameraOrbitAngleButton.Text = controller._cameraOrbitAngleMode == "Full" and "Full 360" or "Half 180"
		focus(controller, "Camera orbit angle set to " .. controller._effectsCameraOrbitAngleButton.Text)
	end)

	connect(controller, controller._effectsCameraDirectionButton, function()
		controller._cameraOrbitDirection = controller._cameraOrbitDirection == "Counterclockwise" and "Clockwise" or "Counterclockwise"
		controller._effectsCameraDirectionButton.Text = controller._cameraOrbitDirection
		focus(controller, "Camera orbit direction set to " .. controller._cameraOrbitDirection)
	end)

	connect(controller, controller._effectsCameraTrackingButton, function()
		controller._cameraPresetSubjectTracking = not (controller._cameraPresetSubjectTracking ~= false)
		controller._effectsCameraTrackingButton.Text = controller._cameraPresetSubjectTracking ~= false and "On" or "Off"
		focus(controller, controller._cameraPresetSubjectTracking ~= false and "Subject tracking on." or "Subject tracking off.")
	end)

	connect(controller, controller._effectsCameraEasingButton, function()
		local styles = { "Sine", "Quad", "Cubic", "Exponential", "Linear" }
		local current = controller._cameraPresetEasingStyle or "Linear"
		local nextIndex = 1
		for index, styleName in ipairs(styles) do
			if styleName == current then
				nextIndex = (index % #styles) + 1
				break
			end
		end
		controller._cameraPresetEasingStyle = styles[nextIndex]
		controller._cameraPresetEasingDirection = "InOut"
		controller._effectsCameraEasingButton.Text = controller._cameraPresetEasingStyle .. " InOut"
		focus(controller, "Camera easing set to " .. controller._effectsCameraEasingButton.Text)
	end)

	connect(controller, controller._effectsCameraPreviewButton, function()
		controller._effectsCameraPreviewPresetId = controller._effectsCameraPreviewPresetId or "OrbitShot"
		previewCameraPreset(controller, callbacks or {})
	end)
end

function EffectsActionBinder.bind(controller, callbacks)
	callbacks = callbacks or {}
	bindCameraSettings(controller, callbacks)

	connect(controller, controller._effectsAddCameraTrackButton, function()
		if callbacks.onAddTrack then
			callbacks.onAddTrack("Camera")
			focus(controller, "Added camera track.")
		end
	end)

	connect(controller, controller._effectsCaptureCameraButton, function()
		if callbacks.onCaptureCameraTrack then
			callbacks.onCaptureCameraTrack()
			focus(controller, "Captured current Studio camera.")
		end
	end)

	connect(controller, controller._effectsFovTrackButton, function()
		setupCameraFollow(controller, "DollyIn")
	end)

	connect(controller, controller._effectsExplosionShakeButton, function()
		applyCameraPreset(controller, callbacks, "ExplosionShake")
	end)

	connect(controller, controller._effectsSoftHandheldButton, function()
		applyCameraPreset(controller, callbacks, "SoftHandheld")
	end)

	connect(controller, controller._effectsOrbitButton, function()
		setupCameraFollow(controller, "Orbit")
	end)

	connect(controller, controller._effectsOrbitShotButton, function()
		applyCinematicCameraPreset(controller, callbacks, "OrbitShot")
	end)

	connect(controller, controller._effectsDollyInButton, function()
		applyCinematicCameraPreset(controller, callbacks, "DollyIn")
	end)

	connect(controller, controller._effectsDollyOutButton, function()
		applyCinematicCameraPreset(controller, callbacks, "DollyOut")
	end)

	connect(controller, controller._effectsHeroRevealButton, function()
		applyCinematicCameraPreset(controller, callbacks, "HeroReveal")
	end)

	connect(controller, controller._effectsOverShoulderButton, function()
		applyCinematicCameraPreset(controller, callbacks, "OverShoulder")
	end)

	connect(controller, controller._effectsCrashZoomButton, function()
		applyCinematicCameraPreset(controller, callbacks, "CrashZoom")
	end)

	connect(controller, controller._effectsFollowCamButton, function()
		applyCinematicCameraPreset(controller, callbacks, "FollowCam")
	end)

	connect(controller, controller._effectsFollowRegularButton, function()
		setupCameraFollow(controller, "FollowRig")
	end)

	connect(controller, controller._effectsFollowCinematicButton, function()
		setupCameraFollow(controller, "FollowRigCinematic")
	end)

	connect(controller, controller._effectsFaceFocusButton, function()
		setupCameraFollow(controller, "FaceFocus")
	end)

	connect(controller, controller._effectsFirstPersonButton, function()
		setupCameraFollow(controller, "FirstPerson")
	end)

	connect(controller, controller._effectsFirstPersonDetachButton, function()
		applyCameraPreset(controller, callbacks, "FirstPersonDetach")
	end)

	connect(controller, controller._effectsRigOptionsButton, function()
		if controller and type(controller._openSelectedOptionsPopup) == "function" then
			local _, message = controller:_openSelectedOptionsPopup()
			focus(controller, message or "Opened selected track options.")
		end
	end)

	connect(controller, controller._effectsRigCFrameButton, function()
		if callbacks.onAddTrack then
			callbacks.onAddTrack("RigCFrame")
			focus(controller, "Added rig CFrame track.")
		end
	end)

	connect(controller, controller._effectsRigScaleButton, function()
		addRigOrObjectProperty(controller, callbacks, "Scale")
	end)

	connect(controller, controller._effectsRigTransparencyButton, function()
		addRigOrObjectProperty(controller, callbacks, "Transparency")
	end)

	connect(controller, controller._effectsRigColorButton, function()
		addRigOrObjectProperty(controller, callbacks, "Color")
	end)

	connect(controller, controller._effectsEmitterGroupButton, function()
		if callbacks.onAddTrack then
			callbacks.onAddTrack("EmitterGroup")
			focus(controller, "Added emitter group from Studio selection.")
		end
	end)

	connect(controller, controller._effectsParticleOptionsButton, function()
		if controller and type(controller._openSelectedOptionsPopup) == "function" then
			local _, message = controller:_openSelectedOptionsPopup()
			focus(controller, message or "Opened particle options.")
		end
	end)

	connect(controller, controller._effectsParticleEmitButton, function()
		addParticleProperty(controller, callbacks, "Emit")
	end)

	connect(controller, controller._effectsParticleEnabledButton, function()
		addParticleProperty(controller, callbacks, "Enabled")
	end)

	connect(controller, controller._effectsParticleRateButton, function()
		addParticleProperty(controller, callbacks, "Rate")
	end)

	connect(controller, controller._effectsParticleSlowMotionButton, function()
		applyParticleSlowMotion(controller, callbacks)
	end)

	connect(controller, controller._effectsParticleColorButton, function()
		addParticleProperty(controller, callbacks, "Color")
	end)
end

return EffectsActionBinder
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX132">
        <Properties>
          <string name="Name">EffectsService</string>
          <ProtectedString name="Source">local EffectsService = {}
EffectsService.__index = EffectsService

local ScreenEffectTrackService = require(script.Parent:WaitForChild("ScreenEffectTrackService"))
local LightingEffectTrackService = require(script.Parent:WaitForChild("LightingEffectTrackService"))
local SCREEN_EFFECTS = ScreenEffectTrackService.getEffectDefinitions()
local LIGHTING_EFFECTS = LightingEffectTrackService.getEffectDefinitions()

local EFFECT_CATEGORIES = {
	{
		id = "Camera",
		name = "Camera Effects",
		description = "Dolly zooms, camera shake, depth of field, focus, and cinematic camera properties.",
		accent = Color3.fromRGB(91, 189, 246),
		items = {
			"Dolly Zoom",
			"Camera Shake",
			"Depth of Field",
			"Focus Distance",
		},
	},
	{
		id = "Rig",
		name = "Rig Effects",
		description = "Character visibility, color, scale, silhouette, and stylized rig properties.",
		accent = Color3.fromRGB(109, 214, 146),
		items = {
			"Transparency",
			"Color Tint",
			"Scale",
			"Ghost Trail",
		},
	},
	{
		id = "Particles",
		name = "Particle Effects",
		description = "Emit bursts, toggle particle emitters, and time VFX with animation beats.",
		accent = Color3.fromRGB(255, 153, 85),
		items = {
			"Emit Burst",
			"Enable Emitter",
			"Rate",
			"Trail",
		},
	},
	{
		id = "Screen",
		name = "Screen Effects",
		description = "Letterbox, vignette, subtitles, captions, fades, and other viewer overlays.",
		accent = Color3.fromRGB(194, 108, 255),
		items = {
			"Letterbox",
			"Vignette",
			"Subtitle",
			"Fade",
			"Film Grain",
			"Camera Flash",
			"Color Wash",
			"Depth Of Field",
		},
	},
	{
		id = "Lighting",
		name = "Lighting Effects",
		description = "Keyframe Lighting, Atmosphere, Sky, Bloom, Depth Of Field, Sunrays, Color Correction, Blur, and Highlights.",
		accent = Color3.fromRGB(255, 218, 90),
		items = {
			"Lighting",
			"Atmosphere",
			"Sky",
			"Bloom",
			"Depth Of Field",
			"Sunrays",
			"Color Correction",
			"Blur",
			"Highlight",
		},
	},
}

local function cloneList(list)
	local clone = {}
	for _, item in ipairs(list or {}) do
		local entry = {}
		for key, value in pairs(item) do
			entry[key] = value
		end
		table.insert(clone, entry)
	end
	return clone
end

local function buildScreenLookup()
	local lookup = {}
	for _, effect in ipairs(SCREEN_EFFECTS) do
		lookup[effect.id] = effect
	end
	return lookup
end

local SCREEN_LOOKUP = buildScreenLookup()

function EffectsService.new()
	return setmetatable({
		screenEffects = {},
		subtitleText = "Your subtitle goes here",
		vignetteTone = "Dark",
		viewerEnabled = false,
	}, EffectsService)
end

function EffectsService.getCategories()
	local categories = {}
	for _, category in ipairs(EFFECT_CATEGORIES) do
		local items = {}
		for _, item in ipairs(category.items or {}) do
			table.insert(items, item)
		end
		table.insert(categories, {
			id = category.id,
			name = category.name,
			description = category.description,
			accent = category.accent,
			items = items,
		})
	end
	return categories
end

function EffectsService.getScreenEffectDefinitions()
	return cloneList(SCREEN_EFFECTS)
end

function EffectsService.getLightingEffectDefinitions()
	return cloneList(LIGHTING_EFFECTS)
end

function EffectsService:getScreenEffects()
	local effects = {}
	for _, definition in ipairs(SCREEN_EFFECTS) do
		table.insert(effects, {
			id = definition.id,
			name = definition.name,
			description = definition.description,
			enabled = self.screenEffects[definition.id] == true,
		})
	end
	return effects
end

function EffectsService:getActiveScreenEffectCount()
	local count = 0
	for effectId, isEnabled in pairs(self.screenEffects) do
		if isEnabled and SCREEN_LOOKUP[effectId] then
			count += 1
		end
	end
	return count
end

function EffectsService:toggleScreenEffect(effectId)
	effectId = tostring(effectId or "")
	local definition = SCREEN_LOOKUP[effectId]
	if not definition then
		return false, "That screen effect is not available yet."
	end

	self.screenEffects[effectId] = not self.screenEffects[effectId]
	return true, string.format(
		"%s %s.",
		definition.name,
		self.screenEffects[effectId] and "enabled" or "disabled"
	)
end

function EffectsService:clearScreenEffects()
	local hadEffects = self:getActiveScreenEffectCount() &gt; 0
	self.screenEffects = {}
	return hadEffects, hadEffects and "Cleared all screen effects." or "No screen effects were enabled."
end

function EffectsService:setSubtitleText(text)
	text = tostring(text or "")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	if text == "" then
		text = "Your subtitle goes here"
	end
	self.subtitleText = string.sub(text, 1, 120)
	return true, "Updated subtitle text."
end

function EffectsService:cycleVignetteTone()
	self.vignetteTone = self.vignetteTone == "Dark" and "Light" or "Dark"
	return true, "Vignette tone set to " .. self.vignetteTone .. "."
end

function EffectsService:toggleViewerEnabled()
	self.viewerEnabled = not self.viewerEnabled
	return true, self.viewerEnabled
		and "Viewer screen effects enabled."
		or "Viewer screen effects disabled."
end

function EffectsService:getViewModel()
	return {
		categories = EffectsService.getCategories(),
		screenEffects = self:getScreenEffects(),
		subtitleText = self.subtitleText,
		activeScreenEffectCount = self:getActiveScreenEffectCount(),
		vignetteTone = self.vignetteTone,
		viewerEnabled = self.viewerEnabled,
	}
end

function EffectsService:getSaveData()
	local enabled = {}
	for effectId, isEnabled in pairs(self.screenEffects) do
		if isEnabled and SCREEN_LOOKUP[effectId] then
			enabled[effectId] = true
		end
	end
	return {
		screen = {
			enabled = enabled,
			subtitleText = self.subtitleText,
			vignetteTone = self.vignetteTone,
			viewerEnabled = self.viewerEnabled,
		},
	}
end

function EffectsService:restoreSaveData(data)
	local screen = type(data) == "table" and data.screen or nil
	local enabled = type(screen) == "table" and screen.enabled or nil
	local restored = {}
	if type(enabled) == "table" then
		for effectId, isEnabled in pairs(enabled) do
			if isEnabled and SCREEN_LOOKUP[effectId] then
				restored[effectId] = true
			end
		end
	end
	self.screenEffects = restored
	if type(screen) == "table" and type(screen.subtitleText) == "string" then
		self:setSubtitleText(screen.subtitleText)
	end
	if type(screen) == "table" and screen.vignetteTone == "Light" then
		self.vignetteTone = "Light"
	else
		self.vignetteTone = "Dark"
	end
	self.viewerEnabled = type(screen) == "table" and screen.viewerEnabled == true
	return true
end

return EffectsService
