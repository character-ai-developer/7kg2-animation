	local function fillInputFromSelected(input)
		local imageId = getSelectedFaceImage()
		if not imageId then
			if refs._facesStatusLabel then
				refs._facesStatusLabel.Text = "Select a Decal, Texture, ImageLabel, or ImageButton first."
			end
			return
		end
		input.Text = imageId
		if refs._facesStatusLabel then
			refs._facesStatusLabel.Text = "Added selected image to the face preset."
		end
		FacesView.renderModalPreview(refs)
	end

	for _, fillTarget in ipairs(selectedFillButtons) do
		local target = fillTarget
		target.button.Activated:Connect(function()
			fillInputFromSelected(target.input)
		end)
	end

	if singleImageInput then
		singleImageInput.FocusLost:Connect(function()
			FacesView.renderModalPreview(refs)
		end)
	end
	for _, input in pairs(layerInputs) do
		input.FocusLost:Connect(function()
			FacesView.renderModalPreview(refs)
		end)
	end
	for layerName, button in pairs(layerTransformButtons) do
		button.Activated:Connect(function()
			selectLayerTransform(refs, layerName)
		end)
	end
	nudgeLeftButton.Activated:Connect(function()
		adjustLayerTransform(refs, LAYER_NUDGE_STEP, 0, 0)
	end)
	nudgeRightButton.Activated:Connect(function()
		adjustLayerTransform(refs, -LAYER_NUDGE_STEP, 0, 0)
	end)
	nudgeUpButton.Activated:Connect(function()
