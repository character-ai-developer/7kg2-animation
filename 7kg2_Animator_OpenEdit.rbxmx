	})
	styleGhostButton(autoFillMotionsButton)
	autoFillMotionsButton.TextSize = 12
	createCorner(autoFillMotionsButton, 8)
	local saveRecipeButton = create("TextButton", {
		Parent = motionsPreviewFrame,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -158, 0, 32),
		Size = UDim2.new(0, 92, 0, 22),
		Text = "Save Recipe",
