	HelpPhysics = {
		title = "Physics",
		subtitle = "Capture real Studio physics, review it, then turn it into editable 7kg2 timeline keys.",
		sections = {
			{
				heading = "1. Choose the effect",
				body = "Select the rig, Part, Model, or loose objects involved when appropriate, then open Physics from Main or the Micro viewport strip. Choose Release to Physics, Drop or bounce, Ragdoll, Drive &amp; Impact, Launch projectile, Create explosion, Simulate selected objects, or Adapt movement to ground.",
			},
			{
				heading = "2. Follow Guided Mode",
				body = "Click ? when you want the simple guided walkthrough. Follow the moving NEXT label and animated rainbow outline; the guide advances as each required choice is completed. Existing valid Studio selections are carried into supported setups automatically.",
			},
			{
				heading = "Release to Physics",
				body = "Add a Detach event to the held object in 7kg2 and place the playhead on it. Physics can detect the held object and inherit its movement from that event. Use the manual object choice only as a fallback. Collisions can be toggled in the Review card.",
			},
			{
				heading = "Drop, bounce, and scene reactions",
				body = "Drop or bounce makes only the prepared loose objects physical during capture. Simulate selected objects handles several loose objects together and can add one optional Starting Push. Set CONTACT at the hit point, PUSH FROM for direction, adjust speed, then use Test Push to compare the reaction before capture.",
			},
			{
				heading = "Ragdoll and Knockback",
				body = "Select one or more compatible R6 or R15 characters. Natural Fall captures an unforced fall; Knockback adds a shared direction and adjustable speed. Use Test Knockback to compare the force before capture. 7kg2 restores the original rigs after tests, previews, retakes, resets, and closing Physics.",
			},
			{
				heading = "Drive, projectile, and explosion tests",
				body = "Drive &amp; Impact follows the moving object's 7kg2 CFrame path before physics takes over, with Physics Drive as the normal movement choice and Keep Upright available for vehicles. Projectile and explosion setups need their source point and affected objects. For explosions, choose Push to keep assemblies intact, Ragdoll to keep a character connected with physics joints, or Break Apart to separate its body parts while preserving accessory welds. Set the power and playback Speed from 10% to 200%, then choose Outward, Upward, or Forward. In Forward mode, the cyan arrow shows the heading and its cyan rotation rings let you aim the blast. Optionally select a ParticleEmitter, Attachment, Part, Folder, or Model containing emitters and press Explosion VFX; slow presets also slow the particle TimeScale, while Roblox caps particles at their authored 100% speed for faster presets. Test Explosion previews the VFX at the Blast Origin, and Bake to Timeline adds a normal editable Emit event.",
			},
			{
				heading = "3. Capture",
				body = "Continue to Capture and click Simulate &amp; Capture. Physics records until the effect finishes, the motion settles, you stop it, or the editable maximum duration is reached. Only prepared targets are captured; the original edit-mode setup and object properties are preserved for Retake, Reset, and closing the Physics window.",
			},
			{
				heading = "Team Create",
				body = "Physics capture is not available while Team Create is active. Its separate Run session cannot return the captured take when Studio returns to Edit mode. Disable Team Create from Live Collaborators, or open a local copy of the place, before clicking Simulate &amp; Capture. Published places still work when Team Create is off.",
			},
			{
				heading = "4. Preview manually",
				body = "After capture, click Preview Take when you want to review the result. Preview never starts automatically. You can change preview speed, stop the preview, Retake the simulation, or Reset the scene.",
			},
			{
				heading = "5. Bake to Timeline",
				body = "When the take looks right, continue to Bake and click Bake to Timeline. 7kg2 extends the project length when needed and creates editable, track-coloured Physics Clips. Select a clip to split, stretch, repeat, or move it; Ungroup exposes the captured keyframes for fine adjustment. The result saves and exports with the project normally.",
			},
			{
				heading = "Capture quality and effect tips",
				body = "Maximum duration and Capture quality are available on the Capture page. Use 30 FPS for a lighter timeline or 60 FPS for smoother, faster motion. Effect-specific choices stay in Setup, beside the objects or characters they affect. Keep anchored ramps and scenery out of loose-object selections. Adapt movement to ground needs a compatible rig, a 7kg2 path, and the intended walk style.",
			},
		},
	},
