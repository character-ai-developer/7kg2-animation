		steps = {
			step("selectButton", "Choose the loose objects", "Select the Parts or Models that should fall. Then press Use Selected Objects."),
			step(nil, "Choose the bounce", "Turn Extra Bounce on only if you want a springier result. This step is optional.", nil, "bounce"),
			step("setupContinue", "Continue to Capture", "When the object count looks correct, continue to the Capture page."),
			step("run", "Drop and record", "Press Simulate &amp; Capture. Wait while the objects fall and come to rest.", "Capture"),
			step("continueBake", "Preview it", "Press Preview Take to check the motion. Retake it if you want a different result.", "Capture", { "preview", "continueBake" }),
			step("import", "Bake to the timeline", "Press Bake to Timeline to turn the captured motion into editable keyframes.", "Bake", { "preview", "import" }),
		},
	},
	Character = {
		name = "Ragdoll",
		accent = Color3.fromRGB(126, 86, 255),
		steps = {
			step("selectButton", "Choose the characters", "Select one or more R6 or R15 rigs. Then press Use Selected Characters."),
			step(nil, "Choose how they fall", "Leave Natural Fall selected and press Simulate &amp; Capture, or choose Knockback to set a direction and speed.", nil, { "ragdollMode", "setupContinue" }),
			step("startingPush", "Set the Knockback direction", "For Knockback, place the red Push From guide and blue Contact guide to show where the hit travels."),
			step("eventTest", "Test the Ragdoll", "Press Test Ragdoll. In Knockback mode, adjust the direction or speed and test again until the reaction feels right."),
			step("setupContinue", "Simulate and capture", "Press Simulate &amp; Capture. 7kg2 will ragdoll every selected character and record the result.", "Capture"),
			step("import", "Preview, then bake", "Preview the captured fall. When you are happy with it, press Bake to Timeline.", "Bake", { "preview", "import" }),
		},
	},
	Impact = {
		name = "Drive &amp; Impact",
		accent = Color3.fromRGB(255, 201, 92),
		steps = {
			step("driverButton", "Choose what will move", "Select the vehicle or moving Model. Then press the moving-object button."),
			step(nil, "Choose the movement", "Physics Drive is the normal choice. Keep Upright helps vehicles stay level during jumps.", nil, { "movement", "keepUpright" }),
			step(nil, "Add anything that should react", "Add riders or loose collision objects only when the shot needs them. Both are optional.", nil, { "riderButton", "selectButton" }),
			step("loadPath", "Load the 7kg2 path", "Animate the vehicle from start to end in 7kg2, then press Load Start / End Path from 7kg2."),
			step("setupContinue", "Continue to Capture", "Check the moving object, path and optional targets. Then continue to Capture."),
			step("run", "Drive and record", "Press Simulate &amp; Capture. 7kg2 drives the path and records the impact.", "Capture"),
			step("import", "Preview, then bake", "Preview the result first. When it looks right, press Bake to Timeline.", "Bake", { "preview", "import" }),
		},
	},
	Projectile = {
		name = "Launch projectile",
		accent = Color3.fromRGB(255, 116, 62),
		steps = {
			step("selectButton", "Choose what should react", "Select the objects that the projectile can hit or move. Then confirm the selection."),
			step("eventSource", "Choose the projectile", "Select the projectile Part or Model and set it as the projectile object."),
			step("projectileStart", "Place the start point", "Set the point where the projectile begins its flight."),
			step("projectileEnd", "Place the impact point", "Set the point where the projectile should arrive and hit the scene."),
			step("eventAdd", "Set the hit and add it", "Choose the time, strength and reaction. Then press Add Projectile Event."),
			step("setupContinue", "Capture the shot", "Continue to Capture, run the simulation, and preview the result."),
			step("import", "Bake to the timeline", "Press Bake to Timeline when the projectile and impact look right.", "Bake", { "preview", "import" }),
		},
	},
	Explosion = {
		name = "Create explosion",
		accent = Color3.fromRGB(255, 159, 67),
		steps = {
			step("selectButton", "Choose what should be blasted", "Select the Parts or Models that the explosion should move. Then confirm the selection."),
			step("eventSource", "Place the blast origin", "Press Blast Origin to place it automatically in front of the affected objects. Drag the coloured axis arrows to fine-tune it, or press the button again to choose a point in the viewport."),
			step("eventTest", "Shape and test the explosion", "Choose Push, Ragdoll, or Break Apart. Set the power, playback speed, and direction, then press Test Explosion. Slow presets also slow optional particle VFX; Roblox caps particle TimeScale at 100% for faster presets. For Forward, use the cyan rotation rings to aim. 7kg2 restores the scene one second after the objects settle."),
			step("setupContinue", "Simulate and capture", "When the test looks right, continue to Capture and record the final blast."),
			step("import", "Preview, then bake", "Preview the explosion. When it looks right, press Bake to Timeline.", "Bake", { "preview", "import" }),
		},
	},
	Scene = {
		name = "Simulate selected objects",
		accent = Color3.fromRGB(91, 224, 165),
		steps = {
			step("selectButton", "Choose every physics object", "Select all loose Parts or Models that should collide, topple or roll. Then confirm them."),
			step("startingPush", "Place the first impact", "Press Add Starting Push, then click the exact target surface in the Studio viewport where the push should HIT. 7kg2 places PUSH FROM outside that surface; drag it afterward if needed."),
			step("startingPushTest", "Test the push", "Test different speeds. Stop the test and adjust it until the first impact feels right."),
			step("setupContinue", "Continue to Capture", "Check the object count and push settings, then continue."),
			step("run", "Capture the chain reaction", "Press Simulate &amp; Capture. Wait until the objects have finished moving.", "Capture"),
			step("import", "Preview, then bake", "Preview the whole reaction. When it looks right, press Bake to Timeline.", "Bake", { "preview", "import" }),
		},
	},
	AdaptiveWalk = {
		name = "Adapt movement to ground",
		accent = Color3.fromRGB(177, 223, 83),
		steps = {
			step("selectButton", "Choose the character", "Select the animated R6 or R15 rig and confirm it."),
			step(nil, "Choose the walk style", "Pick the walk animation that should be preserved while the feet adapt to the ground.", nil, { "walkStyle", "walkNext" }),
			step("loadPath", "Load the route", "Animate the rig's CFrame route in 7kg2, then press Load CFrame Route + Walk Style."),
			step("setupContinue", "Continue to Capture", "Check the rig, route and walk style, then continue."),
			step("run", "Capture the adapted walk", "Press Preview &amp; Capture Walk. 7kg2 fits the steps to the ground and records them.", "Capture"),
			step("import", "Preview, then bake", "Preview the walk slowly if needed. When it looks right, press Bake to Timeline.", "Bake", { "preview", "import" }),
		},
	},
}

local function make(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function corner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function border(parent, color, transparency, thickness)
	return make("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	}, parent)
end

local function connect(self, signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

local function readCompleted(pluginObject, effectMode)
	if not pluginObject then
		return false
	end
	local success, value = pcall(function()
		return pluginObject:GetSetting(SETTING_PREFIX .. effectMode)
	end)
	return success and value == true
end

local function writeCompleted(pluginObject, effectMode)
	if pluginObject then
		pcall(function()
			pluginObject:SetSetting(SETTING_PREFIX .. effectMode, true)
		end)
	end
end

local function findStep(effect, targetName, stage)
	if targetName then
		for index, data in ipairs(effect.steps) do
			if data.target == targetName then
				return index
			end
		end
	end
	if stage then
		for index, data in ipairs(effect.steps) do
			if data.stage == stage then
				return index
			end
		end
	end
	return 1
end

local function syncedStep(effectMode, context)
	local effect = EFFECTS[effectMode]
	if not effect then
		return 1
	end
	local objectCount = tonumber(context.objectCount) or 0
	local rigCount = tonumber(context.rigCount) or 0
	local eventCount = tonumber(context.eventCount) or 0
	if context.uiStage == "Bake" then
		return #effect.steps
	end
	if context.uiStage == "Capture" then
		if context.hasTake then
			local reviewStep = findStep(effect, "continueBake")
			if reviewStep &gt; 1 then
				return reviewStep
			end
		end
		return findStep(effect, nil, "Capture")
	end
	if effectMode == "Release" then
		if not context.hasReleaseData then return 1 end
		if not context.hasReleaseObject then return 2 end
		return 3
	elseif effectMode == "Drop" then
		return objectCount &gt; 0 and 2 or 1
	elseif effectMode == "Character" then
		if rigCount &lt;= 0 then return 1 end
		if context.ragdollMode ~= "Knockback" then return 2 end
		if not context.hasStartingPush then return 3 end
		if not context.startingPushTested then return 4 end
		return 5
	elseif effectMode == "Impact" then
		if not context.hasDriver then return 1 end
		if context.hasPath then return 5 end
		return 2
	elseif effectMode == "Projectile" then
		if objectCount &lt;= 0 then return 1 end
		if not context.hasEventSource then return 2 end
		if not context.hasProjectileStart then return 3 end
		if not context.hasProjectileEnd then return 4 end
		return eventCount &gt; 0 and 6 or 5
	elseif effectMode == "Explosion" then
		if objectCount &lt;= 0 then return 1 end
		if not context.hasEventSource then return 2 end
		return context.eventTested and 4 or 3
	elseif effectMode == "Scene" then
		if objectCount &lt;= 0 then return 1 end
		if not context.hasStartingPush then return 2 end
		return context.startingPushTested and 4 or 3
	elseif effectMode == "AdaptiveWalk" then
		if rigCount &lt;= 0 then return 1 end
		return context.hasPath and 4 or 2
	end
	return 1
end

function PhysicsGuidedMode.new(options)
	options = options or {}
	local self = setmetatable({
		active = false,
		connections = {},
		currentEffect = "Drop",
		currentIndex = 1,
		focusFrames = {},
		focusTweens = {},
		lastContext = nil,
		lastTargetName = nil,
		plugin = options.plugin,
		refs = options.refs or {},
		root = options.root,
		theme = options.theme or {},
	}, PhysicsGuidedMode)
	local parent = self.root and self.root.Parent
	if not parent then
		return self
	end

	self.highlight = make("Frame", {
		Name = "PhysicsGuideTargetHighlight", Active = false, BackgroundTransparency = 1,
		BorderSizePixel = 0, Visible = false, ZIndex = 410,
	}, parent)
	corner(self.highlight, 7)
	self.highlightStroke = border(self.highlight, Color3.fromRGB(235, 67, 84), 0, 3)
	self.card = make("Frame", {
		Name = "PhysicsGuidedMode", Active = true, BackgroundColor3 = self.theme.panel,
		BackgroundTransparency = 0, BorderSizePixel = 0, Size = UDim2.fromOffset(352, 228),
		Visible = false, ZIndex = 420,
	}, parent)
	corner(self.card, 9)
	self.cardStroke = border(self.card, self.theme.text, 0.25, 1)

	self.progress = make("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -58, 0, 16), Text = "GUIDED MODE", TextColor3 = self.theme.text,
		TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 421,
	}, self.card)
	self.close = make("TextButton", {
		Active = true, AutoButtonColor = false, BackgroundColor3 = self.theme.button, BorderSizePixel = 0,
		Font = Enum.Font.GothamBold, Position = UDim2.new(1, -38, 0, 8), Size = UDim2.fromOffset(28, 28),
		Text = "X", TextColor3 = self.theme.text, TextSize = 12, ZIndex = 422,
	}, self.card)
	corner(self.close, 6)
	self.effectName = make("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Position = UDim2.fromOffset(16, 32),
		Size = UDim2.new(1, -32, 0, 18), Text = "", TextColor3 = self.theme.text, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 421,
	}, self.card)
	self.title = make("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(16, 58),
		Size = UDim2.new(1, -32, 0, 24), Text = "", TextColor3 = self.theme.text, TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 421,
	}, self.card)
	self.body = make("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Position = UDim2.fromOffset(16, 86),
		Size = UDim2.new(1, -32, 0, 54), Text = "", TextColor3 = self.theme.text, TextSize = 12,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 421,
	}, self.card)
	self.hint = make("TextLabel", {
		BackgroundColor3 = self.theme.button, BorderSizePixel = 0, Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(16, 146), Size = UDim2.new(1, -32, 0, 30),
		Text = "Look for the red NEXT label in the Physics panel.", TextColor3 = self.theme.text,
		TextSize = 10, TextWrapped = true, ZIndex = 421,
	}, self.card)
	corner(self.hint, 5)
	self.back = make("TextButton", {
		Active = true, AutoButtonColor = false, BackgroundColor3 = self.theme.button, BorderSizePixel = 0,
		Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(16, 184), Size = UDim2.new(0.32, -8, 0, 32),
		Text = "Back", TextColor3 = self.theme.text, TextSize = 11, ZIndex = 421,
	}, self.card)
	corner(self.back, 6)
	self.next = make("TextButton", {
		Active = true, AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(82, 139, 255),
		BorderSizePixel = 0, Font = Enum.Font.GothamBold, Position = UDim2.new(0.32, 8, 0, 184),
		Size = UDim2.new(0.36, -8, 0, 32), Text = "Next", TextColor3 = Color3.fromRGB(12, 18, 24),
		TextSize = 11, ZIndex = 421,
	}, self.card)
	corner(self.next, 6)
	self.skip = make("TextButton", {
		Active = true, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold, Position = UDim2.new(0.68, 4, 0, 181),
		Size = UDim2.new(0.32, -20, 0, 18), Text = "Skip for now", TextColor3 = self.theme.text,
		TextSize = 9, ZIndex = 421,
	}, self.card)
	self.neverShow = make("TextButton", {
		Active = true, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold, Position = UDim2.new(0.68, 4, 0, 199),
		Size = UDim2.new(0.32, -20, 0, 18), Text = "Don't show again", TextColor3 = self.theme.muted,
		TextSize = 9, ZIndex = 421,
	}, self.card)

	connect(self, self.close.Activated, function() self:Hide() end)
	connect(self, self.skip.Activated, function() self:Hide() end)
	connect(self, self.neverShow.Activated, function()
		writeCompleted(self.plugin, self.currentEffect)
		self:Hide()
	end)
	connect(self, self.back.Activated, function()
		self.currentIndex = math.max(1, self.currentIndex - 1)
		self:_render()
	end)
	connect(self, self.next.Activated, function()
		local effect = EFFECTS[self.currentEffect] or EFFECTS.Drop
		if self.currentIndex &gt;= #effect.steps then
			writeCompleted(self.plugin, self.currentEffect)
			self:Hide()
		else
			self.currentIndex += 1
			self:_render()
		end
	end)
	connect(self, self.root:GetPropertyChangedSignal("AbsolutePosition"), function() self:_position() end)
	connect(self, self.root:GetPropertyChangedSignal("AbsoluteSize"), function() self:_position() end)
	return self
end

function PhysicsGuidedMode:_target()
	local effect = EFFECTS[self.currentEffect] or EFFECTS.Drop
	local data = effect.steps[self.currentIndex]
	return data and data.target and self.refs[data.target] or nil
end

function PhysicsGuidedMode:_clearFocus()
	for _, focusTween in ipairs(self.focusTweens) do
		focusTween:Cancel()
	end
	self.focusTweens = {}
	for _, focusFrame in ipairs(self.focusFrames) do
		if focusFrame.Parent then
			focusFrame:Destroy()
		end
	end
	self.focusFrames = {}
end

function PhysicsGuidedMode:_showFocus(effect, data)
	self:_clearFocus()
	local focus = data and data.focus
	if type(focus) == "string" then
		focus = { focus }
	end
	if type(focus) ~= "table" then
		return
	end
	for _, refName in ipairs(focus) do
		local button = self.refs[refName]
		if button and button:IsA("GuiButton") and button.Visible then
			local focusFrame = make("Frame", {
				Name = "PhysicsGuideFocus",
				Active = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromScale(1, 1),
				ZIndex = button.ZIndex + 8,
			}, button)
			corner(focusFrame, 7)
			local focusStroke = border(focusFrame, Color3.new(1, 1, 1), 0, 4)
			local focusGradient = make("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 55, 70)),
					ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 225, 55)),
					ColorSequenceKeypoint.new(0.34, Color3.fromRGB(65, 255, 125)),
					ColorSequenceKeypoint.new(0.51, Color3.fromRGB(55, 225, 255)),
					ColorSequenceKeypoint.new(0.68, Color3.fromRGB(70, 105, 255)),
					ColorSequenceKeypoint.new(0.85, Color3.fromRGB(235, 70, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 55, 70)),
				}),
				Rotation = 0,
			}, focusStroke)
			local focusTween = TweenService:Create(
				focusGradient,
				TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
				{ Rotation = 360 }
			)
			focusTween:Play()
			table.insert(self.focusFrames, focusFrame)
			table.insert(self.focusTweens, focusTween)
		end
	end
end

function PhysicsGuidedMode:_position()
	if not (self.card and self.root) then
		return
	end
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local rootPosition, rootSize, cardSize = self.root.AbsolutePosition, self.root.AbsoluteSize, self.card.AbsoluteSize
	local x = rootPosition.X + rootSize.X + 12
	if x + cardSize.X &gt; viewport.X - 12 then
		x = rootPosition.X - cardSize.X - 12
	end
	x = math.clamp(x, 12, math.max(12, viewport.X - cardSize.X - 12))
	local y = math.clamp(rootPosition.Y + 108, 12, math.max(12, viewport.Y - cardSize.Y - 12))
	self.card.Position = UDim2.fromOffset(x, y)
	self.highlight.Visible = false
end

function PhysicsGuidedMode:_render()
	if not self.card then
		return
	end
	local effect = EFFECTS[self.currentEffect] or EFFECTS.Drop
	self.currentIndex = math.clamp(self.currentIndex, 1, #effect.steps)
	local data, theme = effect.steps[self.currentIndex], self.theme
	self.card.BackgroundColor3 = theme.panel
	self.cardStroke.Color = theme.text
	self.progress.Text = string.format("GUIDED MODE  -  STEP %d OF %d", self.currentIndex, #effect.steps)
	self.progress.TextColor3 = effect.accent
	self.effectName.Text, self.title.Text, self.body.Text = effect.name, data.title, data.body
	self.effectName.TextColor3, self.title.TextColor3, self.body.TextColor3 = theme.text, theme.text, theme.text
	self.hint.BackgroundColor3, self.hint.TextColor3 = theme.button, theme.text
	self.back.BackgroundColor3 = theme.button
	self.back.TextColor3 = self.currentIndex &gt; 1 and theme.text or theme.muted
	self.back.Active = self.currentIndex &gt; 1
	self.next.BackgroundColor3 = effect.accent
	self.next.Text = self.currentIndex == #effect.steps and "Finish" or "Next"
	self.skip.TextColor3, self.neverShow.TextColor3 = theme.text, theme.muted
	self.close.BackgroundColor3, self.close.TextColor3 = theme.button, theme.text
	self.highlightStroke.Color = effect.accent
	self:_showFocus(effect, data)
	self:_position()
end

function PhysicsGuidedMode:OpenForEffect(effectMode, force)
	if not EFFECTS[effectMode] or (not force and readCompleted(self.plugin, effectMode)) then
		return false
	end
	self.currentEffect = effectMode
	self.currentIndex = math.max(1, syncedStep(effectMode, self.lastContext or {}))
	self.active, self.card.Visible = true, true
	self:_render()
	return true
end

function PhysicsGuidedMode:Hide()
	self.active = false
	self:_clearFocus()
	if self.card then self.card.Visible = false end
	if self.highlight then self.highlight.Visible = false end
end

function PhysicsGuidedMode:Update(context)
	context = context or {}
	self.lastContext = context
	if context.setupPage == "Choose" or context.quickVisible == true then
		self:Hide()
		return
	end
	if EFFECTS[context.effectMode] then
		if self.currentEffect ~= context.effectMode then
			self.currentEffect, self.currentIndex, self.lastTargetName = context.effectMode, 1, nil
		end
		self.currentIndex = math.max(self.currentIndex, syncedStep(self.currentEffect, context))
	end
	if self.active then self:_render() end
end

function PhysicsGuidedMode:Destroy()
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	self.connections = {}
	self:_clearFocus()
	if self.card then self.card:Destroy() end
	if self.highlight then self.highlight:Destroy() end
	self.card, self.highlight = nil, nil
end

return PhysicsGuidedMode
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX27">
            <Properties>
              <string name="Name">PhysicsLargeSelectionWarning</string>
              <ProtectedString name="Source">local PhysicsLargeSelectionWarning = {}
PhysicsLargeSelectionWarning.__index = PhysicsLargeSelectionWarning

local TRACK_WARNING_THRESHOLD = 100
local SAMPLE_WARNING_THRESHOLD = 60000

local function make(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function formatNumber(value)
	local formatted = tostring(math.max(0, math.floor((tonumber(value) or 0) + 0.5)))
	while true do
		local replaced
		formatted, replaced = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return formatted
end

function PhysicsLargeSelectionWarning.new(parent, theme)
	local self = setmetatable({}, PhysicsLargeSelectionWarning)
	self.theme = theme
	self.pendingConfirm = nil
	self.pendingCancel = nil

	self.overlay = make("Frame", {
		Name = "LargeSelectionWarning",
		Active = true,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 500,
	}, parent)

	local dialog = make("Frame", {
		Name = "Dialog",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -36, 0, 236),
		ZIndex = 501,
	}, self.overlay)
	make("UICorner", { CornerRadius = UDim.new(0, 9) }, dialog)
	make("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = theme.yellow,
		Thickness = 1,
		Transparency = 0.18,
	}, dialog)

	make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 26),
		Text = "Large Physics selection",
		TextColor3 = theme.text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 502,
	}, dialog)

	self.body = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(18, 52),
		Size = UDim2.new(1, -36, 0, 106),
		Text = "",
		TextColor3 = theme.muted,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 502,
	}, dialog)

	local cancel = make("TextButton", {
		AutoButtonColor = true,
		BackgroundColor3 = theme.button,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 178),
		Size = UDim2.new(0.42, -24, 0, 42),
		Text = "Cancel",
		TextColor3 = theme.text,
		TextSize = 13,
		ZIndex = 502,
	}, dialog)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, cancel)

	local continue = make("TextButton", {
		AutoButtonColor = true,
		BackgroundColor3 = theme.yellow,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0.42, 6, 0, 178),
		Size = UDim2.new(0.58, -24, 0, 42),
		Text = "Continue anyway",
		TextColor3 = Color3.fromRGB(18, 22, 30),
		TextSize = 13,
		ZIndex = 502,
	}, dialog)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, continue)

	cancel.Activated:Connect(function()
		self.overlay.Visible = false
		local callback = self.pendingCancel
		self.pendingConfirm = nil
		self.pendingCancel = nil
		if callback then
			callback()
		end
	end)
	continue.Activated:Connect(function()
		self.overlay.Visible = false
		local callback = self.pendingConfirm
		self.pendingConfirm = nil
		self.pendingCancel = nil
		if callback then
			callback()
		end
	end)

	return self
end

function PhysicsLargeSelectionWarning:ConfirmIfNeeded(details, onConfirm, onCancel)
	details = details or {}
	local trackCount = math.max(0, tonumber(details.trackCount) or 0)
	local fps = math.max(1, tonumber(details.fps) or 30)
	local duration = math.max(0, tonumber(details.duration) or 0)
	local sampleCount = trackCount * fps * duration
	if details.truncated ~= true
		and trackCount &lt; TRACK_WARNING_THRESHOLD
		and sampleCount &lt; SAMPLE_WARNING_THRESHOLD then
		return false
	end

	local action = details.action == "test" and "test" or "capture"
	local message = string.format(
		"This %s may record about %d animated track%s at %d FPS for up to %.0f seconds (roughly %s sample points). It may take longer and use more memory; a final capture can also create a heavy timeline.",
		action,
		trackCount,
		trackCount == 1 and "" or "s",
		fps,
		duration,
		formatNumber(sampleCount)
	)
	if details.truncated == true then
		message ..= " The selection also exceeds the 500-part safety limit, so only the first 500 eligible parts will be captured."
	end
	self.body.Text = message
	self.pendingConfirm = onConfirm
	self.pendingCancel = onCancel
	self.overlay.Visible = true
	return true
end

function PhysicsLargeSelectionWarning:Hide()
	self.overlay.Visible = false
	self.pendingConfirm = nil
	self.pendingCancel = nil
end

return PhysicsLargeSelectionWarning
