		microUiHost._shortcutCaptureInput = mountMicroShortcutCapture(gui, options, plugin, function()
			return gui
		end, function()
			return microActive
		end, function()
			return statusLabel
		end, refresh, function()
			if type(options._triggerMicroSelectedOptions) == "function" then
				return options._triggerMicroSelectedOptions()
			end
			return nil
		end)
		options._bindMicroShortcutSink = function(reason)
			return bindMicroShortcutSink(options, plugin, function()
				return gui
			end, function()
				return microActive
			end, function()
				return statusLabel
			end, refresh, function()
				if type(options._triggerMicroSelectedOptions) == "function" then
