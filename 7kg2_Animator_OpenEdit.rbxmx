local function isKnownWorkspaceTab(tabName)
	return tabName == "Timeline" or WORKSPACE_POPUPS[tabName] ~= nil
end

local function make(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function theme()
	return Constants.THEME
end

local function setBackgroundRole(instance, roleName)
	local palette = theme()
	if instance and roleName and palette[roleName] then
		instance.BackgroundColor3 = palette[roleName]
		instance:SetAttribute("MegMoThemeBackgroundRole", roleName)
	end
	return instance
end

local function setTextRole(instance, roleName)
	local palette = theme()
	if instance and roleName and palette[roleName] then
		instance.TextColor3 = palette[roleName]
		instance:SetAttribute("MegMoThemeTextRole", roleName)
	end
	return instance
end

local function setImageRole(instance, roleName)
	local palette = theme()
	if instance and roleName and palette[roleName] then
		instance.ImageColor3 = palette[roleName]
		instance:SetAttribute("MegMoThemeImageRole", roleName)
	end
	return instance
end

local function normalizeImageAssetId(value)
	if type(value) == "number" then
		value = tostring(value)
	end
	if type(value) ~= "string" then
		return nil
	end
	local trimmed = value:match("^%s*(.-)%s*$") or value
	if trimmed == "" then
		return nil
	end
	if trimmed:match("^rbxassetid://") or trimmed:match("^rbxthumb://") then
		return trimmed
	end
	if tonumber(trimmed) then
		return "rbxassetid://" .. trimmed
	end
	return trimmed
end

local function readImageAssetFromInstance(instance)
	if not instance then
		return nil
	end
	local ok, value = pcall(function()
		if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
			return instance.Image
		end
		if instance:IsA("Decal") or instance:IsA("Texture") then
			return instance.Texture
		end
		if instance:IsA("StringValue") then
			return instance.Value
		end
		return instance:GetAttribute("Image") or instance:GetAttribute("ImageId") or instance:GetAttribute("AssetId")
	end)
	if not ok then
		return nil
	end
	return normalizeImageAssetId(value)
end

local function getMicroRailIconImage(itemName)
	local itemNameText = tostring(itemName or "")
	local fallbackImage = nil
	if itemNameText == "File" then
		fallbackImage = MICRO_MENU_IMAGE_ASSETS.File
	elseif itemNameText == "Edit" then
		fallbackImage = MICRO_MENU_IMAGE_ASSETS.Edit
	elseif itemNameText == "Rig" then
		fallbackImage = "rbxassetid://84424290988173"
	elseif itemNameText == "Time" then
		fallbackImage = "rbxassetid://75935339918235"
	elseif itemNameText == "Theme" then
		fallbackImage = MICRO_MENU_IMAGE_ASSETS.Theme
	elseif itemNameText == "Help" then
		fallbackImage = "rbxassetid://109802318933022"
	end
	local imagesFolder = ServerStorage:FindFirstChild("Images")
	if not imagesFolder then
		return fallbackImage
	end
	local candidates = {
		itemNameText,
		itemNameText .. "Icon",
		itemNameText .. "Button",
		"Micro" .. itemNameText,
		"Micro" .. itemNameText .. "Icon",
	}
	for _, candidateName in ipairs(candidates) do
		local image = readImageAssetFromInstance(imagesFolder:FindFirstChild(candidateName))
		if image then
			return image
		end
	end
	local target = string.lower(itemNameText)
	for _, child in ipairs(imagesFolder:GetChildren()) do
		if string.lower(child.Name) == target then
			return readImageAssetFromInstance(child)
		end
	end
	return fallbackImage
end

local function getMicroActionIconImage(tabName, actionName)
	local actionText = tostring(actionName or "")
	local compactText = actionText:gsub("%s+", "")
	local fallbackImage = MICRO_MENU_IMAGE_ASSETS[actionText] or MICRO_MENU_IMAGE_ASSETS[compactText]
	local candidates = {
		actionText,
		compactText,
		actionText .. "Icon",
		compactText .. "Icon",
		tostring(tabName or "") .. actionText,
		tostring(tabName or "") .. compactText,
	}
	if actionText == "Select All" then
		table.insert(candidates, "All")
		fallbackImage = fallbackImage or MICRO_MENU_IMAGE_ASSETS.SelectAll
	elseif actionText == "Default Pose" then
		table.insert(candidates, "DefaultPose")
		table.insert(candidates, "Default")
		fallbackImage = fallbackImage or MICRO_MENU_IMAGE_ASSETS.DefaultPose
	elseif actionText == "Onion Skin" then
		table.insert(candidates, "Onion")
		fallbackImage = fallbackImage or MICRO_MENU_IMAGE_ASSETS.OnionSkin
	elseif actionText == "Add Rig" then
		table.insert(candidates, "Rig")
		fallbackImage = fallbackImage or MICRO_MENU_IMAGE_ASSETS.AddRig
	elseif actionText == "R15 Classic" then
		table.insert(candidates, "R15Classic")
		fallbackImage = fallbackImage or MICRO_MENU_IMAGE_ASSETS.R15Classic
	elseif actionText == "R15 Modern" then
		table.insert(candidates, "R15Modern")
		fallbackImage = fallbackImage or MICRO_MENU_IMAGE_ASSETS.R15Modern
	end
	local imagesFolder = ServerStorage:FindFirstChild("Images")
	if not imagesFolder then
		return fallbackImage
	end
	for _, candidateName in ipairs(candidates) do
		local image = readImageAssetFromInstance(imagesFolder:FindFirstChild(candidateName))
		if image then
			return image
		end
	end
	local target = string.lower(compactText)
	for _, child in ipairs(imagesFolder:GetChildren()) do
		if string.lower(child.Name:gsub("%s+", "")) == target then
			return readImageAssetFromInstance(child)
		end
	end
	return fallbackImage
end

local function createMicroRailIcon(parent, itemName)
	local icon = Instance.new("ImageLabel")
	icon.Name = "RailIcon"
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.BackgroundTransparency = 1
	icon.BorderSizePixel = 0
	icon.Image = getMicroRailIconImage(itemName) or ""
	icon.ImageColor3 = ThemeService.getReadableTextColor(theme().PanelSoft)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.ScaleType = Enum.ScaleType.Fit
	icon.Size = UDim2.new(1, -8, 1, -8)
	icon.Visible = false
	icon.ZIndex = 25
	icon.Parent = parent
	return icon
end

local function syncMicroRailButtonMode(railButton, railExpanded, railWidth)
	if not railButton then
		return
	end
	local itemName = tostring(railButton:GetAttribute("MegMoRailName") or "")
	local itemLabel = tostring(railButton:GetAttribute("MegMoRailLabel") or "")
	local itemIndex = tonumber(railButton:GetAttribute("MegMoRailIndex")) or 1
	local rowHeight = railExpanded and 19 or 34
	local rowStep = railExpanded and 21 or 38
	local icon = railButton:FindFirstChild("RailIcon")
	local iconImage = icon and getMicroRailIconImage(itemName) or nil
	railButton.Position = UDim2.fromOffset(5, 29 + ((itemIndex - 1) * rowStep))
	railButton.Size = UDim2.fromOffset(railWidth - 10, rowHeight)
	railButton.Text = railExpanded and ("  " .. itemName) or (iconImage and "" or itemLabel)
	railButton.TextXAlignment = railExpanded and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
	railButton.TextSize = railExpanded and 10 or 9
	if icon then
		icon.Image = iconImage or ""
		icon.ImageColor3 = railButton.TextColor3
		icon.Size = UDim2.new(1, -8, 1, -8)
		icon.Visible = (not railExpanded) and iconImage ~= nil
	end
end

local function getFolderColor(folderTrack)
	return WidgetControllerUtilitySupport.getFolderColor(FOLDER_COLOR_BY_ID, folderTrack)
end

local function getTrackReorderScope(track)
	return WidgetControllerUtilitySupport.getTrackReorderScope(track)
end

local function makeRigGroupTrackPath(rigName)
	return WidgetControllerUtilitySupport.makeRigGroupTrackPath(rigName)
end

local function corner(parent, radius)
	return make("UICorner", {
		CornerRadius = UDim.new(0, radius or 8),
	}, parent)
end

local function stroke(parent, color, transparency, thickness, roleName)
	local isTextStroke = parent
		and (parent:IsA("TextLabel") or parent:IsA("TextButton") or parent:IsA("TextBox"))
	local function usesWhiteText()
		return isTextStroke
			and parent.TextColor3.R &gt;= 0.88
			and parent.TextColor3.G &gt;= 0.88
			and parent.TextColor3.B &gt;= 0.88
	end
	local baseColor = color or theme().Border
	local isWhiteTextStroke = usesWhiteText()
	local item = make("UIStroke", {
		Color = isWhiteTextStroke and Color3.new(0, 0, 0) or baseColor,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
	}, parent)
	if isWhiteTextStroke then
		if roleName then
			item:SetAttribute("MegMoTextStrokeFallbackRole", roleName)
		end
		item:SetAttribute("MegMoThemeStrokeRole", "__white_text_stroke")
	elseif roleName then
		item:SetAttribute("MegMoThemeStrokeRole", roleName)
	end
	if isTextStroke then
		parent:GetPropertyChangedSignal("TextColor3"):Connect(function()
			if usesWhiteText() then
				item.Color = Color3.new(0, 0, 0)
				if roleName then
					item:SetAttribute("MegMoTextStrokeFallbackRole", roleName)
				end
				item:SetAttribute("MegMoThemeStrokeRole", "__white_text_stroke")
			else
				item.Color = roleName and (theme()[roleName] or baseColor) or baseColor
				if roleName then
					item:SetAttribute("MegMoThemeStrokeRole", roleName)
				else
					item:SetAttribute("MegMoThemeStrokeRole", nil)
				end
			end
		end)
	end
	return item
end

local function padding(parent, all)
	return make("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
	}, parent)
end

local function button(parent, text, color, textColor)
	local btn = make("TextButton", {
		Name = text:gsub("%s+", "") .. "Button",
		AutoButtonColor = true,
		BackgroundColor3 = color or theme().PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Text = text,
		TextColor3 = textColor or ThemeService.getReadableTextColor(color or theme().PanelSoft),
		TextSize = 12,
		TextWrapped = true,
	}, parent)
	if not color then
		btn:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	end
	btn:SetAttribute("MegMoThemeTextRole", "__auto")
	corner(btn, 5)
	UiHelpers.styleGhostButton(btn)
	if color == theme().Accent or color == theme().AccentSoft then
		UiHelpers.styleTextButton(btn, color)
	end
	UiHelpers.applyButtonIcon(btn, text, {
		size = 13,
	})
	return btn
end

local function text(parent, props)
	props = props or {}
	props.BackgroundTransparency = props.BackgroundTransparency == nil and 1 or props.BackgroundTransparency
	props.Font = props.Font or Enum.Font.Gotham
	props.TextColor3 = props.TextColor3 or theme().Text
	props.TextSize = props.TextSize or 12
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	local label = make("TextLabel", props, parent)
	if props.TextColor3 == theme().MutedText then
		label:SetAttribute("MegMoThemeTextRole", "MutedText")
	elseif props.TextColor3 == theme().Text then
		label:SetAttribute("MegMoThemeTextRole", "Text")
	end
	return label
end

local function mountMicroRadialButton(radialMenu, toolHint, item, index, totalCount, onActivate)
	local angle = math.rad(-90 + ((index - 1) * (360 / totalCount)))
	local radius = MICRO_RADIAL_RADIUS
	local buttonSize = MICRO_RADIAL_BUTTON_SIZE
	local halfButton = math.floor(buttonSize * 0.5)
	local buttonX = math.floor(MICRO_RADIAL_CENTER + (math.cos(angle) * radius) - halfButton)
	local buttonY = math.floor(MICRO_RADIAL_CENTER + (math.sin(angle) * radius) - halfButton)
	local radialButton = make("ImageButton", {
		Name = item.name .. "RadialButton",
		AutoButtonColor = true,
		BackgroundColor3 = theme().PanelSoft,
		BorderSizePixel = 0,
		Image = "",
		ImageColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(buttonX, buttonY),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(buttonSize, buttonSize),
		ZIndex = 42,
	}, radialMenu)
	radialButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	corner(radialButton, 999)
	make("ImageLabel", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Image = item.image or "",
		ImageColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.new(1, -MICRO_RADIAL_ICON_INSET, 1, -MICRO_RADIAL_ICON_INSET),
		ZIndex = 43,
	}, radialButton)
	local radialButtonStroke = stroke(radialButton, theme().Accent, 1, 1, "Accent")
	pcall(function()
		radialButtonStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end)
	radialButton.MouseEnter:Connect(function()
		radialButtonStroke.Transparency = 0
		radialButtonStroke.Thickness = 2
		if toolHint then
			MicroWidgetController._positionMicroTooltipNear(radialButton, toolHint, item.label, 8)
		end
	end)
	radialButton.MouseLeave:Connect(function()
		radialButtonStroke.Transparency = 0.24
		radialButtonStroke.Thickness = 1
		if toolHint then
			toolHint.Visible = false
		end
	end)
	radialButton.MouseButton1Click:Connect(function()
		onActivate(item)
	end)
	return radialButton
end

local function mountMicroRadialHub(config)
	config = config or {}
	local gui = config.gui
	local panel = config.panel
	local toolStrip = config.toolStrip
	local toolHint = config.toolHint
	local railHint = config.railHint
	if not gui or not panel or not toolStrip then
		return nil
	end

	local radialOpen = false
	local radialButtons = {}
	local radialLauncher = make("ImageButton", {
		Name = "RadialLauncher",
		AutoButtonColor = true,
		BackgroundColor3 = theme().PanelSoft,
		BorderSizePixel = 0,
		Image = "",
		ImageColor3 = theme().Text,
		AnchorPoint = Vector2.new(1, 0.5),
		LayoutOrder = -10,
		Position = UDim2.new(0, -8, 0.5, 0),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(52, 52),
		ZIndex = 58,
	}, toolStrip)
	radialLauncher:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	do
		local logoOk, logoModule = pcall(require, script.Parent.Parent:WaitForChild("BrandLogo"))
		if logoOk and type(logoModule) == "table" and type(logoModule.create) == "function" then
			local launcherLogo = logoModule.create(radialLauncher, {
				name = "RadialLauncherLogo",
				size = UDim2.fromScale(0.74, 0.74),
				position = UDim2.fromScale(0.5, 0.5),
				anchorPoint = Vector2.new(0.5, 0.5),
				showTile = false,
				zIndex = 60,
			})
			if launcherLogo then
				launcherLogo.Active = false
				launcherLogo.BackgroundTransparency = 1
			end
		end
	end
	corner(radialLauncher, 999)
	stroke(radialLauncher, theme().Accent, 0.22, 1, "Accent")
	MicroViewportButtonStyleSupport.apply(radialLauncher, {
		baseTransparency = 0.22,
		hoverTransparency = 0.04,
		baseThickness = 1.1,
		hoverThickness = 1.7,
	})

	local radialMenu = make("Frame", {
		Name = "RadialMenu",
		AnchorPoint = Vector2.new(0, 0),
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(MICRO_RADIAL_MENU_SIZE, MICRO_RADIAL_MENU_SIZE),
		Visible = false,
		ZIndex = 80,
	}, gui)
	radialMenu.Active = true
	radialMenu.InputBegan:Connect(function() end)
	radialMenu.InputChanged:Connect(function() end)
	radialMenu.InputEnded:Connect(function() end)

	local radialRingMask = make("Frame", {
		Name = "RadialRingMask",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(MICRO_RADIAL_RING_SIZE, MICRO_RADIAL_RING_SIZE),
		ZIndex = 41,
	}, radialMenu)
	radialRingMask.ClipsDescendants = true
	corner(radialRingMask, 999)

	local radialRing = make("Frame", {
		Name = "RadialRing",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme().Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(MICRO_RADIAL_RING_SIZE, MICRO_RADIAL_RING_SIZE),
		ZIndex = 41,
	}, radialRingMask)
	radialRing.ClipsDescendants = true
	setBackgroundRole(radialRing, "Panel")
	corner(radialRing, 999)
	UiHelpers.applyPanelSurface(radialRing)
	local radialRingTexture = radialRing:FindFirstChild("MegMoPanelTexture")
	if radialRingTexture and radialRingTexture:IsA("ImageLabel") then
		corner(radialRingTexture, 999)
	end
	stroke(radialRing, theme().Border, 0.16, 1, "Border")

	local radialCore = make("TextButton", {
		Name = "RadialCore",
		AnchorPoint = Vector2.new(0.5, 0.5),
		AutoButtonColor = true,
		BackgroundColor3 = theme().Accent,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(MICRO_RADIAL_CORE_SIZE, MICRO_RADIAL_CORE_SIZE),
		Text = "",
		Font = Enum.Font.GothamBold,
		ZIndex = 43,
	}, radialMenu)
	radialCore.ClipsDescendants = true
	radialCore:SetAttribute("MegMoThemeBackgroundRole", "Accent")
	corner(radialCore, 999)
	stroke(radialCore, theme().Accent, 0, 1.2, "Accent")
	do
		local coreLogoOk, coreLogoModule = pcall(require, script.Parent.Parent:WaitForChild("BrandLogo"))
		if coreLogoOk and type(coreLogoModule) == "table" and type(coreLogoModule.create) == "function" then
			local coreLogo = coreLogoModule.create(radialCore, {
				name = "RadialCoreIcon",
				size = UDim2.fromScale(0.72, 0.72),
				position = UDim2.fromScale(0.5, 0.5),
				anchorPoint = Vector2.new(0.5, 0.5),
				showTile = false,
				zIndex = 44,
			})
			if coreLogo then
				coreLogo.BackgroundTransparency = 1
			end
		else
			make("ImageLabel", {
				Name = "RadialCoreIcon",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = "",
				ImageColor3 = ThemeService.getReadableTextColor(theme().Accent),
				Position = UDim2.fromScale(0.5, 0.5),
				ScaleType = Enum.ScaleType.Stretch,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 44,
			}, radialCore)
		end
	end

	local function updatePlacement()
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
		local panelPos = panel.AbsolutePosition
		local panelSize = panel.AbsoluteSize
		local menuSize = radialMenu.AbsoluteSize
		local menuW = menuSize.X &gt; 0 and menuSize.X or MICRO_RADIAL_MENU_SIZE
		local menuH = menuSize.Y &gt; 0 and menuSize.Y or MICRO_RADIAL_MENU_SIZE
		local centerX = panelPos.X + math.floor((panelSize.X - menuW) * 0.5)
		local centerY = panelPos.Y + math.floor((panelSize.Y - menuH) * 0.5)
		local margin = 6
		local leftX = panelPos.X - menuW - 18
		local rightX = panelPos.X + panelSize.X + 18
		local topY = panelPos.Y - menuH - 18
		local bottomY = panelPos.Y + panelSize.Y + 18
		local candidates = {
			{
				fits = leftX &gt;= margin,
				space = panelPos.X - margin,
				x = leftX,
				y = math.clamp(centerY, margin, math.max(margin, viewport.Y - menuH - margin)),
			},
			{
				fits = rightX + menuW &lt;= viewport.X - margin,
				space = viewport.X - (panelPos.X + panelSize.X) - margin,
				x = rightX,
				y = math.clamp(centerY, margin, math.max(margin, viewport.Y - menuH - margin)),
			},
			{
				fits = topY &gt;= margin,
				space = panelPos.Y - margin,
				x = math.clamp(centerX, margin, math.max(margin, viewport.X - menuW - margin)),
				y = topY,
			},
			{
				fits = bottomY + menuH &lt;= viewport.Y - margin,
				space = viewport.Y - (panelPos.Y + panelSize.Y) - margin,
				x = math.clamp(centerX, margin, math.max(margin, viewport.X - menuW - margin)),
				y = bottomY,
			},
		}
		table.sort(candidates, function(a, b)
			if a.fits ~= b.fits then
				return a.fits
			end
			return a.space &gt; b.space
		end)
		local best = candidates[1]
		radialMenu.Position = UDim2.fromOffset(
			best and best.x or math.clamp(centerX, margin, math.max(margin, viewport.X - menuW - margin)),
			best and best.y or math.clamp(centerY, margin, math.max(margin, viewport.Y - menuH - margin))
		)
	end

	local function setOpen(open)
		local nextOpen = open == true
		if radialOpen == nextOpen and radialMenu.Visible == nextOpen then
			return
		end
		radialOpen = nextOpen
		if radialOpen then
			radialMenu.Visible = true
		else
			UiMotion.staggerRadialOut(radialMenu, radialButtons, {
				center = UDim2.fromOffset(
					MICRO_RADIAL_CENTER - (MICRO_RADIAL_BUTTON_SIZE * 0.5),
					MICRO_RADIAL_CENTER - (MICRO_RADIAL_BUTTON_SIZE * 0.5)
				),
				interval = 0.07,
				itemTime = 0.18,
			}, function()
				if not radialOpen then
					UiMotion.resetRadialItems(radialMenu, radialButtons)
					radialMenu.Visible = false
				end
			end)
		end
		radialLauncher.BackgroundColor3 = radialOpen and theme().Accent or theme().PanelSoft
		radialLauncher.ImageColor3 = radialOpen and ThemeService.getReadableTextColor(theme().Accent) or theme().Text
		radialLauncher:SetAttribute("MegMoThemeBackgroundRole", radialOpen and "Accent" or "PanelSoft")
		radialLauncher:SetAttribute("MegMoThemeImageRole", radialOpen and "__auto" or "Text")
		if radialOpen then
			updatePlacement()
			UiMotion.staggerRadialIn(radialMenu, radialButtons, {
				center = UDim2.fromOffset(
					MICRO_RADIAL_CENTER - (MICRO_RADIAL_BUTTON_SIZE * 0.5),
					MICRO_RADIAL_CENTER - (MICRO_RADIAL_BUTTON_SIZE * 0.5)
				),
				interval = 0.1,
				itemTime = 0.24,
			})
		end
	end

	radialCore.MouseButton1Click:Connect(function()
		setOpen(false)
	end)
	local function activateRadialItem(item)
		setOpen(false)
		if item.name == "Summary" and type(config.onOpenSummary) == "function" then
			config.onOpenSummary()
		elseif type(config.onSelectTab) == "function" then
			config.onSelectTab(item.name)
		end
	end
	for index, item in ipairs(MICRO_RADIAL_ITEMS) do
		radialButtons[#radialButtons + 1] = mountMicroRadialButton(radialMenu, toolHint, item, index, #MICRO_RADIAL_ITEMS, activateRadialItem)
	end
	radialLauncher.MouseEnter:Connect(function()
		if type(config.isRailExpanded) == "function" and config.isRailExpanded() then
			return
		end
		if railHint then
			railHint.Text = "Radial Hub"
			railHint.Position = UDim2.fromOffset(
				math.max(4, panel.AbsolutePosition.X - railHint.AbsoluteSize.X - 6),
				math.max(4, radialLauncher.AbsolutePosition.Y - 1)
			)
			railHint.Visible = true
		end
	end)
	radialLauncher.MouseLeave:Connect(function()
		if railHint then
			railHint.Visible = false
		end
	end)
	radialLauncher.MouseButton1Click:Connect(function()
		if railHint then
			railHint.Visible = false
		end
		setOpen(not radialOpen)
	end)

	return {
		launcher = radialLauncher,
		menu = radialMenu,
		setOpen = setOpen,
		updatePlacement = updatePlacement,
		isOpen = function()
			return radialOpen
		end,
	}
end

local function safeCall(callback, ...)
	if type(callback) == "function" then
		local ok, first, second, third = pcall(callback, ...)
		if not ok then
			warn("[7kg2 Micro] " .. tostring(first))
			return false, tostring(first)
		end
		local message = type(second) == "string" and second or (type(first) == "string" and first or nil)
		if first == false then
			return false, message, third
		end
		return true, message, third
	end
	return false, nil
end

local function requestOpenFull(options)
	options = options or {}
	safeCall(options.onBeforeOpenFull)
	return safeCall(options.onOpenFull)
end

local function requestOpenFullDestination(options, destination)
	options = options or {}
	safeCall(options.onBeforeOpenFull)
	return safeCall(options.onOpenFull, destination)
end

local function runOption(options, callbackName, fallbackActionName, ...)
	options = options or {}
	local callback = options[callbackName]
	if type(callback) == "function" then
		return safeCall(callback, ...)
	end
	if fallbackActionName and type(options.onEditorAction) == "function" then
		return safeCall(options.onEditorAction, fallbackActionName, ...)
	end
	return false, nil
end

function MicroWidgetController._runBindRig(options)
	local success, message = runOption(options, "onBindRig", nil, true)
	if success == false and type(message) == "string"
		and (message:find("shares its name", 1, true) or message:find("unique name", 1, true)) then
		require(script.Parent:WaitForChild("MicroMessagePopupSupport")).show(
			options and options._microGui,
			"Rig Names Must Be Unique",
			message
		)
	end
	return success, message
end

function MicroWidgetController._findMicroRigEventTrack(timeline, rigName)
	if not (timeline and type(timeline.getTracks) == "function") then
		return nil
	end
	local wantedRigName = tostring(rigName or "")
	if wantedRigName == "" then
		return nil
	end
	for _, track in ipairs(timeline:getTracks() or {}) do
		if track
			and (track.trackType == "Event" or track.valueType == "Event")
			and tostring(track.rigName or "") == wantedRigName
			and track.targetScope == "RigEvent"
		then
			return track
		end
	end
	return nil
end

function MicroWidgetController._ensureMicroRigEventTrack(options, rigName)
	local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
	if not (timeline and type(timeline.addGenericTrack) == "function") then
		return nil, "Timeline is not ready."
	end
	local existing = MicroWidgetController._findMicroRigEventTrack(timeline, rigName)
	if existing then
		return existing, "Events track ready."
	end
	local rig = type(timeline.getRigByName) == "function" and timeline:getRigByName(rigName) or nil
	local track = timeline:addGenericTrack("Event", nil, "Events", {
		rig = rig,
		rigName = rigName,
		targetScope = "RigEvent",
		eventName = "Event",
		sortOrder = 1,
	})
	return track, "Added Events track. Add an event keyframe, then name it in Track Options."
end

local lastMicroToolShortcutKey = nil
local lastMicroToolShortcutTime = 0
local lastMicroToolShortcutBaseKey = nil
local lastMicroToolShortcutBaseTime = 0
local microShortcutShiftHeld = false
local microShortcutShiftGraceUntil = 0

local function isMicroShortcutShiftKey(keyCode)
	return keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift
end

local function isMicroShortcutShiftKeyName(keyName)
	local key = string.lower(tostring(keyName or ""))
	return key == "leftshift" or key == "rightshift" or key == "shift"
end

local function shouldSkipDuplicateMicroToolShortcut(keyName, shiftDown, controlDown)
	local now = os.clock()
	local baseKey = tostring(keyName)
	if lastMicroToolShortcutBaseKey == baseKey and now - lastMicroToolShortcutBaseTime &lt; 0.08 then
		return true
	end
	local signature = tostring(keyName) .. ":" .. tostring(shiftDown == true) .. ":" .. tostring(controlDown == true)
	if lastMicroToolShortcutKey == signature and now - lastMicroToolShortcutTime &lt; 0.08 then
		return true
	end
	lastMicroToolShortcutBaseKey = baseKey
	lastMicroToolShortcutBaseTime = now
	lastMicroToolShortcutKey = signature
	lastMicroToolShortcutTime = now
	return false
end

function MicroWidgetController._consumeMicroOneShotShortcut(options, keyName, controlDown)
	if not controlDown or (keyName ~= "z" and keyName ~= "y") then
		return false
	end
	return false
end

local function normalizeMicroShortcutName(keyName)
	local key = string.lower(tostring(keyName or ""))
	if key == "keypadseven" or key == "7" then
		return "seven"
	elseif key == "keypadplus" or key == "plus" or key == "equals" or key == "=" or key == "+" then
		return "plus"
	elseif key == "leftbracket" or key == "[" then
		return "previousframe"
	elseif key == "rightbracket" or key == "]" then
		return "nextframe"
	elseif key == " " then
		return "space"
	end
	return key
end

function MicroWidgetController._decodeMicroShortcutKeyName(keyName)
	local rawKeyName = tostring(keyName or "")
	local firstByte = string.byte(rawKeyName, 1)
	local key = normalizeMicroShortcutName(rawKeyName)
	local controlImplied = false
	local shiftImplied = string.len(rawKeyName) == 1
		and string.match(rawKeyName, "%a") ~= nil
		and rawKeyName == string.upper(rawKeyName)
		and rawKeyName ~= string.lower(rawKeyName)

	if firstByte == 1 then
		key = "a"
		controlImplied = true
	elseif firstByte == 3 then
		key = "c"
		controlImplied = true
	elseif firstByte == 4 then
		key = "d"
		controlImplied = true
	elseif firstByte == 22 then
		key = "v"
		controlImplied = true
	elseif firstByte == 25 then
		key = "y"
		controlImplied = true
	elseif firstByte == 26 then
		key = "z"
		controlImplied = true
	end

	return key, controlImplied, shiftImplied
end

local MICRO_SHORTCUT_DEBUG_ENABLED = false

local function microShortcutDebug(...)
	if not MICRO_SHORTCUT_DEBUG_ENABLED then
		return
	end
	local parts = { "[7kg2 Micro Shortcut Debug]" }
	for index = 1, select("#", ...) do
		parts[#parts + 1] = tostring(select(index, ...))
	end
	print(table.concat(parts, " | "))
end

local function isMicroShortcutDebugKey(key)
	return false
end

local function getMicroShortcutSelectedKeyCount(options)
	if type(options) ~= "table" or type(options.getSelectedKeyRefs) ~= "function" then
		return -1
	end
	local ok, keys = pcall(options.getSelectedKeyRefs)
	if not ok or type(keys) ~= "table" then
		return -1
	end
	return #keys
end

local function isMicroShortcutShiftDown(options, includeGrace)
	local shiftSelection = type(options) == "table" and options._microShiftSelection or nil
	local shiftSelectionHeld = false
	if shiftSelection and type(shiftSelection.isHeld) == "function" then
		shiftSelectionHeld = shiftSelection:isHeld() == true
	end
	return shiftSelectionHeld
		or microShortcutShiftHeld
		or (includeGrace == true and os.clock() &lt;= microShortcutShiftGraceUntil)
		or (function()
			local ok, state = pcall(function()
				return require(script.Parent.Parent:WaitForChild("ShortcutInputState"))
			end)
			if ok and state and type(state.isShiftDown) == "function" then
				return state.isShiftDown()
			end
			return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		end)()
end

local function isMicroShortcutControlDown()
	local ok, state = pcall(function()
		return require(script.Parent.Parent:WaitForChild("ShortcutInputState"))
	end)
	if ok and state and type(state.isControlDown) == "function" then
		if state.isControlDown() then
			return true
		end
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
		return true
	end
	local controlPressed = false
	pcall(function()
		for _, inputObject in ipairs(UserInputService:GetKeysPressed()) do
			if inputObject
				and (inputObject.KeyCode == Enum.KeyCode.LeftControl
					or inputObject.KeyCode == Enum.KeyCode.RightControl) then
				controlPressed = true
				break
			end
		end
	end)
	return controlPressed
end

local function clearMicroStudioSelectionForTimelineShortcut()
	pcall(function()
		local Selection = game:GetService("Selection")
		if #Selection:Get() &gt; 0 then
			Selection:Set({})
		end
	end)
end

local function observeMicroShortcutInput(input, isDown)
	if not input or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	pcall(function()
		local state = require(script.Parent.Parent:WaitForChild("ShortcutInputState"))
		if state and type(state.observeKeyCode) == "function" then
			state.observeKeyCode(input.KeyCode, isDown)
		end
	end)
	if not isMicroShortcutShiftKey(input.KeyCode) then
		return
	end
	if isDown then
		microShortcutShiftHeld = true
		microShortcutShiftGraceUntil = 0
	else
		microShortcutShiftHeld = false
		microShortcutShiftGraceUntil = os.clock() + 0.35
	end
	microShortcutDebug("observeInput", input.KeyCode.Name, isDown and "down" or "up", "held=" .. tostring(microShortcutShiftHeld))
end

local function observeMicroShortcutKeyName(keyName, isDown)
	if not isMicroShortcutShiftKeyName(keyName) then
		return false
	end
	if isDown then
		microShortcutShiftHeld = true
		microShortcutShiftGraceUntil = 0
	else
		microShortcutShiftHeld = false
		microShortcutShiftGraceUntil = os.clock() + 0.35
	end
	microShortcutDebug("observePluginKey", tostring(keyName), isDown and "down" or "up", "held=" .. tostring(microShortcutShiftHeld))
	return true
end

