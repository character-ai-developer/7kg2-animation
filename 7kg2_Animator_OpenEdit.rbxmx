local function buildWorkflowUI(parent)
	local function panel(name, position, size, color)
		local frame = make("Frame", {
			Name = name,
			BackgroundColor3 = Color3.fromRGB(16, 23, 36),
			BorderSizePixel = 0,
			Position = position,
			Size = size,
		}, parent)
		addCorner(frame, 8)
		addStroke(frame, color or Color3.fromRGB(53, 64, 84))
		return frame
	end
	local function heading(text, target)
		return make("TextLabel", {
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = text,
			TextColor3 = THEME.text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(14, 10),
			Size = UDim2.new(1, -28, 0, 22),
		}, target)
	end
	local function iconButton(target, title, image, color, position, size)
		local button = make("TextButton", {
			Text = title,
			Font = Enum.Font.GothamMedium,
			TextColor3 = THEME.text,
			TextSize = 11,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			BackgroundColor3 = THEME.button,
			BorderSizePixel = 0,
			Position = position,
			Size = size,
		}, target)
		addCorner(button, 6)
		addStroke(button, color)
		make("ImageLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Image = image,
			ImageColor3 = color,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 9),
			Size = UDim2.fromOffset(34, 34),
		}, button)
		make("UIPadding", { PaddingBottom = UDim.new(0, 10) }, button)
		return button
	end
	local function scenarioButton(target, title, description, image, color, position, size)
		local button = make("TextButton", {
			Text = "",
			BackgroundColor3 = THEME.button,
			BorderSizePixel = 0,
			Position = position,
			Size = size,
		}, target)
		addCorner(button, 7)
		addStroke(button, color)
		make("ImageLabel", {
			Name = "Icon",
			BackgroundColor3 = color:Lerp(THEME.background, 0.68),
			BorderSizePixel = 0,
			Image = image,
			ImageColor3 = color,
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(52, 52),
		}, button)
		addCorner(button.Icon, 6)
		make("TextLabel", {
			Name = "Title",
			Active = false,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = title,
			TextColor3 = THEME.text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(76, 11),
			Size = UDim2.new(1, -88, 0, 22),
		}, button)
		make("TextLabel", {
			Name = "Description",
			Active = false,
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = description,
			TextColor3 = THEME.muted,
			TextSize = 10,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(76, 34),
			Size = UDim2.new(1, -88, 0, 34),
		}, button)
		return button
	end

