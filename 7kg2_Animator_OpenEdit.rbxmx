      <Item class="ModuleScript" referent="RBX161">
        <Properties>
          <string name="Name">MicroGroupOptionsSupport</string>
          <ProtectedString name="Source">local MicroGroupOptionsSupport = {}

local function makeKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

local function groupExists(groups, groupId)
	if type(groups) ~= "table" then
		return false
	end
	return groups[groupId] ~= nil or groups[tostring(groupId)] ~= nil
end

function MicroGroupOptionsSupport.getSelectedGroupIds(explicitGroupIds, selectedKeyRefs, groups, fallbackGroupIds)
	local selectedGroupIds = {}
	local seen = {}
	local function addGroupId(groupId)
		if groupId ~= nil and not seen[groupId] then
			seen[groupId] = true
			selectedGroupIds[#selectedGroupIds + 1] = groupId
		end
	end

	for _, groupId in ipairs(type(explicitGroupIds) == "table" and explicitGroupIds or {}) do
		if groupExists(groups, groupId) then
			addGroupId(groupId)
		end
	end

	if #selectedGroupIds == 0 then
		local selectedKeyIds = {}
		for _, key in ipairs(type(selectedKeyRefs) == "table" and selectedKeyRefs or {}) do
			local jointPath = key and (key.jointPath or key.path)
			if jointPath ~= nil and key.frame ~= nil then
				selectedKeyIds[makeKeyId(jointPath, key.frame)] = true
			end
		end
		if next(selectedKeyIds) ~= nil then
			for groupId, group in pairs(type(groups) == "table" and groups or {}) do
				for keyId in pairs((group and group.keys) or {}) do
					if selectedKeyIds[keyId] then
						addGroupId(groupId)
						break
					end
				end
			end
		end
	end

	if #selectedGroupIds == 0 then
		for _, groupId in ipairs(type(fallbackGroupIds) == "table" and fallbackGroupIds or {}) do
			if groupExists(groups, groupId) then
				addGroupId(groupId)
			end
		end
	end

	table.sort(selectedGroupIds, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)
	return selectedGroupIds
end

function MicroGroupOptionsSupport.getSelectedGroupIdsFromViewModel(viewModel, fallbackGroupIds)
	viewModel = type(viewModel) == "table" and viewModel or {}
	return MicroGroupOptionsSupport.getSelectedGroupIds(
		viewModel.selectedGroupIds,
		viewModel.selectedKeys,
		viewModel.groups,
		fallbackGroupIds
	)
end

function MicroGroupOptionsSupport.hasSelectedGroup(viewModel, fallbackGroupIds)
	return #MicroGroupOptionsSupport.getSelectedGroupIdsFromViewModel(viewModel, fallbackGroupIds) &gt; 0
end

function MicroGroupOptionsSupport.hasSelectedGroupKind(groups, groupIds, kind)
	groups = type(groups) == "table" and groups or {}
	for _, groupId in ipairs(type(groupIds) == "table" and groupIds or {}) do
		local group = groups[groupId] or groups[tostring(groupId)]
		if group and group.kind == kind then
			return true
		end
	end
	return false
end

return MicroGroupOptionsSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX162">
        <Properties>
          <string name="Name">ModalOverlaySupport</string>
          <ProtectedString name="Source">local ModalOverlaySupport = {}

local MAIN_MODAL_OVERLAY_NAMES = {
	AlertOverlay = true,
	AvatarImportOverlay = true,
	BakeProgressOverlay = true,
	CameraFollowOverlay = true,
	CameraRotationOverlay = true,
	CameraTrackEditorOverlay = true,
	ClosePluginOverlay = true,
	ColorPickerOverlay = true,
	ConfirmOverlay = true,
	CustomThemeOverlay = true,
	EffectTrackEditorOverlay = true,
	EffectsOverlay = true,
	EnhanceAnimationOverlay = true,
	FacePresetModalBlocker = true,
	FacesConfirmOverlay = true,
	FacesOverlay = true,
	FontPreviewOverlay = true,
	HelpOverlay = true,
	ImportOverlay = true,
	MotionRecipeOverlay = true,
	ParticleKeyframeEditorOverlay = true,
	PresetPreviewOverlay = true,
	PropertyKeyframeEditorOverlay = true,
	R15ToR6ConverterOverlay = true,
	RepeatFramesOverlay = true,
	RigPropertyEditorOverlay = true,
	SoundKeyframeEditorOverlay = true,
	TrackActionsOverlay = true,
	WiggleFramesOverlay = true,
}

local function setButtonModal(button)
	button.Active = true
	pcall(function()
		button.Modal = true
	end)
end

function ModalOverlaySupport.applyToOverlay(overlay)
	if not overlay or not overlay:IsA("GuiObject") then
		return nil
	end

	overlay.Active = true
	if overlay:IsA("GuiButton") then
		setButtonModal(overlay)
		return overlay
	end

	local existing = overlay:FindFirstChild("MegMoModalInputSink")
	if existing and existing:IsA("TextButton") then
		setButtonModal(existing)
		return existing
	end

	local sink = Instance.new("TextButton")
	sink.Name = "MegMoModalInputSink"
	sink.Active = true
	sink.AutoButtonColor = false
	sink.BackgroundTransparency = 1
	sink.BorderSizePixel = 0
	sink.Size = UDim2.fromScale(1, 1)
	sink.Text = ""
	sink.TextTransparency = 1
	sink.ZIndex = overlay.ZIndex
	sink:SetAttribute("MegMoModalInputSink", true)
	sink.Parent = overlay
	setButtonModal(sink)
	return sink
end

function ModalOverlaySupport.apply(root)
	if not root then
		return 0
	end

	local applied = 0
	for _, descendant in ipairs(root:GetDescendants()) do
		if MAIN_MODAL_OVERLAY_NAMES[descendant.Name] and descendant:IsA("GuiObject") then
			if ModalOverlaySupport.applyToOverlay(descendant) then
				applied += 1
			end
		end
	end
	return applied
end

return ModalOverlaySupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX163">
        <Properties>
          <string name="Name">MotionBuilderState</string>
          <ProtectedString name="Source">local MotionBuilderState = {}
MotionBuilderState.__index = MotionBuilderState

local MOTION_NAMES = {
	Walk = true,
	Run = true,
	Jump = true,
	Climb = true,
	Idle = true,
	Action = true,
}

local DEFAULT_RTHRO_CLIPS = {
	Walk = "2510202577",
	Run = "2510198475",
	Jump = "2510197830",
	Climb = "2510192778",
	Idle = "2510197257",
}

local DEFAULT_R6_CLIPS = {
	Walk = "180426354",
	Run = "180426354",
	Jump = "125750702",
	Climb = "180436334",
	Idle = "180435571",
}

local function trim(value)
	return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function copyMap(source)
	local copy = {}
	for key, value in pairs(source or {}) do
		copy[key] = value
	end
	return copy
end

local function normalizeRigType(rigType)
	return tostring(rigType or "") == "R6" and "R6" or "R15"
end

local function getBuiltinDefaultClips(rigType)
	if normalizeRigType(rigType) == "R6" then
		return DEFAULT_R6_CLIPS
	end
	return DEFAULT_RTHRO_CLIPS
end

local function copyDefaultClipsByRigType(source)
	local copy = {
		R15 = copyMap(DEFAULT_RTHRO_CLIPS),
		R6 = copyMap(DEFAULT_R6_CLIPS),
	}
	if type(source) ~= "table" then
		return copy
	end
	for rigType, defaults in pairs(source) do
		local normalizedRigType = normalizeRigType(rigType)
		if type(defaults) == "table" then
			copy[normalizedRigType] = copyMap(defaults)
		end
	end
	return copy
end

local function parseSegmentSecondsInput(input, allowZero)
	local text = trim(input):gsub("[sS]$", "")
	if text == "" then
		return nil, true
	end

	local numeric = tonumber(text)
	if not numeric then
		return nil, false
	end

	if allowZero then
		numeric = math.clamp(numeric, 0, 60)
	else
		numeric = math.clamp(numeric, 0.05, 60)
	end
	return math.floor(numeric * 100 + 0.5) / 100, true
end

function MotionBuilderState.new(motionService)
	local self = setmetatable({}, MotionBuilderState)
	self._motionService = motionService
	self._segmentMotions = {}
	self._segmentDurations = {}
	self._segmentPauses = {}
	self._segmentBlends = {}
	self._segmentClips = {}
	self._segmentPauseIdles = {}
	self._defaultClipsByRigType = copyDefaultClipsByRigType()
	self._defaultClips = self._defaultClipsByRigType.R15
	return self
end

function MotionBuilderState:getOptions(extra)
	extra = extra or {}
	local rigType = normalizeRigType(extra.rigType or extra.motionRigType)
	local options = {
		segmentMotions = copyMap(self._segmentMotions),
		segmentDurations = copyMap(self._segmentDurations),
		segmentPauses = copyMap(self._segmentPauses),
		segmentBlends = copyMap(self._segmentBlends),
		segmentClips = copyMap(self._segmentClips),
		segmentPauseIdles = copyMap(self._segmentPauseIdles),
		defaultClips = self:getDefaultClips(rigType),
		defaultClipsByRigType = copyDefaultClipsByRigType(self._defaultClipsByRigType),
	}

	for key, value in pairs(extra) do
		options[key] = value
	end
	return options
end

function MotionBuilderState:getDefaultClips(rigType)
	rigType = normalizeRigType(rigType)
	local defaultsByRigType = self._defaultClipsByRigType or {}
	local defaults = defaultsByRigType[rigType]
	if type(defaults) ~= "table" then
		defaults = getBuiltinDefaultClips(rigType)
	end
	return copyMap(defaults)
end

function MotionBuilderState:listSegments(extra)
	return self._motionService.listMotionSegments(self:getOptions(extra))
end

function MotionBuilderState:captureRecipe(extra)
	return self._motionService.captureMotionRecipe(self:getOptions(extra))
end

function MotionBuilderState:clearSegments()
	self._segmentMotions = {}
	self._segmentDurations = {}
	self._segmentPauses = {}
	self._segmentBlends = {}
	self._segmentClips = {}
	self._segmentPauseIdles = {}
end

function MotionBuilderState:resetSegments()
	local hadEdits = next(self._segmentMotions) ~= nil
		or next(self._segmentDurations) ~= nil
		or next(self._segmentPauses) ~= nil
		or next(self._segmentBlends) ~= nil
		or next(self._segmentClips) ~= nil
		or next(self._segmentPauseIdles) ~= nil
	self:clearSegments()
	local clearedMarkerCount = self._motionService.clearMotionSegmentSettings()
	return hadEdits, clearedMarkerCount
end

function MotionBuilderState:setSegmentMotion(segmentKey, motionName)
	segmentKey = trim(segmentKey)
	motionName = tostring(motionName or "Path Only")
	if motionName == "Auto" then
		motionName = "Path Only"
	end
	if segmentKey == "" then
		return false, "That marker segment is no longer available."
	end

	if motionName == "Path Only" then
		self._segmentMotions[segmentKey] = nil
	else
		self._segmentMotions[segmentKey] = motionName
	end
	self._segmentClips[segmentKey] = nil
	self._motionService.setMotionSegmentSetting(segmentKey, "motion", motionName)
	self._motionService.setMotionSegmentSetting(segmentKey, "clip", nil)
	return true, string.format("Set segment motion to %s.", motionName)
end

function MotionBuilderState:setSegmentClip(segmentKey, clipId)
	segmentKey = trim(segmentKey)
	clipId = trim(clipId)
	if segmentKey == "" then
		return false, "That marker segment is no longer available."
	end

	if clipId == "" then
		self._segmentClips[segmentKey] = nil
		self._motionService.setMotionSegmentSetting(segmentKey, "clip", nil)
		return true, "Set segment animation to the default clip."
	end

	self._segmentClips[segmentKey] = clipId
	self._motionService.setMotionSegmentSetting(segmentKey, "clip", clipId)
	return true, "Set segment animation clip."
end

function MotionBuilderState:setDefaultClip(motionName, clipId, rigType)
	motionName = tostring(motionName or "")
	clipId = trim(clipId)
	if not MOTION_NAMES[motionName] then
		return false, "Choose Walk, Run, Jump, Climb, Idle, or Action before setting a default style."
	end

	rigType = normalizeRigType(rigType)
	self._defaultClipsByRigType = copyDefaultClipsByRigType(self._defaultClipsByRigType)
	local defaults = self._defaultClipsByRigType[rigType]
	if clipId == "" then
		defaults[motionName] = nil
		self._defaultClips = self._defaultClipsByRigType.R15
		return true, string.format("%s will use the first matching %s preset by default.", motionName, rigType)
	end

	defaults[motionName] = clipId
	self._defaultClips = self._defaultClipsByRigType.R15
	return true, string.format("Set the default %s %s style.", rigType, motionName)
end

function MotionBuilderState:setSegmentPauseIdle(segmentKey, clipId)
	segmentKey = trim(segmentKey)
	clipId = trim(clipId)
	if segmentKey == "" then
		return false, "That marker segment is no longer available."
	end

	if clipId == "" then
		self._segmentPauseIdles[segmentKey] = nil
		self._motionService.setMotionSegmentSetting(segmentKey, "pauseIdle", nil)
		return true, "Pause will hold the current pose."
	end

	self._segmentPauseIdles[segmentKey] = clipId
	self._motionService.setMotionSegmentSetting(segmentKey, "pauseIdle", clipId)
	return true, "Pause will play the selected idle clip."
end

function MotionBuilderState:setSegmentDuration(segmentKey, input)
	segmentKey = trim(segmentKey)
	if segmentKey == "" then
		return false, "That marker segment is no longer available."
	end

	local seconds, ok = parseSegmentSecondsInput(input, false)
	if not ok then
		return false, "Enter a duration in seconds, for example 1.50."
	end

	if seconds == nil then
		self._segmentDurations[segmentKey] = nil
		self._motionService.setMotionSegmentSetting(segmentKey, "duration", nil)
		return true, "Cleared the custom segment duration."
	end

	self._segmentDurations[segmentKey] = seconds
	self._motionService.setMotionSegmentSetting(segmentKey, "duration", seconds)
	return true, string.format("Set segment duration to %.2fs.", seconds)
end

function MotionBuilderState:setSegmentPause(segmentKey, input)
	segmentKey = trim(segmentKey)
	if segmentKey == "" then
		return false, "That marker segment is no longer available."
	end

	local seconds, ok = parseSegmentSecondsInput(input, true)
	if not ok then
		return false, "Enter a pause in seconds, for example 0.75. Use 0 for no hold."
	end

	if seconds == nil then
		self._segmentPauses[segmentKey] = nil
		self._motionService.setMotionSegmentSetting(segmentKey, "pause", nil)
		return true, "Cleared the custom segment pause."
	end

	self._segmentPauses[segmentKey] = seconds
	self._motionService.setMotionSegmentSetting(segmentKey, "pause", seconds)
	return true, seconds &gt; 0 and string.format("Set segment pause to %.2fs.", seconds) or "Set segment pause to no hold."
end

function MotionBuilderState:setSegmentBlend(segmentKey, input)
	segmentKey = trim(segmentKey)
	if segmentKey == "" then
		return false, "That marker segment is no longer available."
	end

	local seconds, ok = parseSegmentSecondsInput(input, true)
	if not ok then
		return false, "Enter a blend in seconds, for example 0.20. Use 0 for a hard cut."
	end

	if seconds == nil then
		self._segmentBlends[segmentKey] = nil
		self._motionService.setMotionSegmentSetting(segmentKey, "blend", nil)
		return true, "Cleared the custom segment blend."
	end

	self._segmentBlends[segmentKey] = seconds
	self._motionService.setMotionSegmentSetting(segmentKey, "blend", seconds)
	return true, seconds &gt; 0 and string.format("Set segment blend to %.2fs.", seconds) or "Set segment blend to a hard cut."
end

function MotionBuilderState:restoreRecipe(deps, recipe)
	local restored, message, state = self._motionService.restoreMotionRecipe(deps, recipe)
	if not restored or type(state) ~= "table" then
		return restored, message
	end

	self._segmentMotions = state.segmentMotions or {}
	self._segmentDurations = state.segmentDurations or {}
	self._segmentPauses = state.segmentPauses or {}
	self._segmentBlends = state.segmentBlends or {}
	self._segmentClips = state.segmentClips or {}
	self._segmentPauseIdles = state.segmentPauseIdles or {}
	local hasRigDefaultClips = type(state.defaultClipsByRigType) == "table" and next(state.defaultClipsByRigType) ~= nil
	self._defaultClipsByRigType = copyDefaultClipsByRigType(state.defaultClipsByRigType)
	if not hasRigDefaultClips and type(state.defaultClips) == "table" then
		self._defaultClipsByRigType.R15 = copyMap(state.defaultClips)
	end
	self._defaultClips = self._defaultClipsByRigType.R15
	return true, message
end

return MotionBuilderState
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX164">
        <Properties>
          <string name="Name">MotionBuilderViewModelSupport</string>
          <ProtectedString name="Source">local MotionBuilderViewModelSupport = {}

function MotionBuilderViewModelSupport.build(deps)
	deps = deps or {}
	local timeline = deps.timeline
	local motionService = deps.motionService
	local motionBuilderState = deps.motionBuilderState
	local motionClipService = deps.motionClipService
	local importService = deps.importService
	local rig = timeline and timeline:getRig() or nil
	local rigs = timeline and timeline:getRigs() or {}
	local rigLabel = "No rig bound"
	if #rigs == 1 and rigs[1] then
		rigLabel = rigs[1].Name
	elseif #rigs &gt; 1 then
		rigLabel = rig and string.format("Using %s (%d rigs)", rig.Name, #rigs) or string.format("%d rigs bound", #rigs)
	end

	local motionRigType = motionClipService and (motionClipService.getRigTypeName(rig) or "R15") or "R15"
	return {
		rigName = rigLabel,
		boundRigPath = rig and rig.Parent and rig:GetFullName() or nil,
		motionMarkers = motionService and motionService.listMotionMarkers() or {},
		motionPreview = motionService and motionService.getMotionPreviewState() or {},
		motionRigType = motionRigType,
		motionSegments = motionBuilderState and motionBuilderState:listSegments({ rigType = motionRigType }) or {},
		motionDefaultClips = motionBuilderState and motionBuilderState:getDefaultClips(motionRigType) or {},
		motionClipOptionsByMotion = motionClipService and motionClipService.buildClipOptionsByMotion(
			importService,
			motionRigType,
			deps.importAnimationEntries or {}
		) or {},
		motionRecipeEntries = deps.motionRecipeEntries or {},
		motionRecipeStatus = deps.motionRecipeStatus or "",
		selectedMotionRecipeName = deps.selectedMotionRecipeName,
	}
end

return MotionBuilderViewModelSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX165">
        <Properties>
          <string name="Name">MotionClipService</string>
          <ProtectedString name="Source">local MotionClipService = {}

local MOTION_NAMES = { "Walk", "Run", "Jump", "Climb", "Idle", "Action" }

local function trim(value)
	return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

function MotionClipService.getRigTypeName(rig)
	if not rig then
		return nil
	end

	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
		return "R6"
	end
	if rig:FindFirstChild("UpperTorso", true) then
		return "R15"
	end
	if rig:FindFirstChild("Torso", true) then
		return "R6"
	end
	return humanoid and humanoid.RigType.Name or nil
end

local function addClipOption(options, seen, entry, motionName)
	local optionId = tostring(entry and (entry.id or entry.numericId) or "")
	if optionId == "" or seen[optionId] then
		return
	end

	seen[optionId] = true
	table.insert(options, {
		id = optionId,
		name = tostring(entry.name or entry.id or motionName),
		pack = entry.pack,
		source = entry.source,
		rigType = entry.rigType,
		sourceRigType = entry.sourceRigType,
		convertToR6 = entry.convertToR6 == true,
		category = entry.category,
		priceLabel = entry.priceLabel,
	})
end

local function makeDirectClipEntry(importService, clipId, motionName, rigType)
	local _, numericId = importService.normalizeAnimationContentId(clipId)
	if not numericId then
		return nil
	end

	return {
		id = numericId,
		numericId = numericId,
		name = tostring(motionName or "Custom") .. " custom clip",
		source = "Custom Animation",
		category = motionName,
		rigType = rigType,
	}
end

function MotionClipService.buildClipOptionsByMotion(importService, rigType, customEntries)
	local optionsByMotion = {}
	for _, motionName in ipairs(MOTION_NAMES) do
		local options = {}
		local seen = {}
		for _, entry in ipairs(importService.getPresetEntriesForCategory(motionName, rigType or "")) do
			addClipOption(options, seen, entry, motionName)
		end
		if importService.getCustomEntriesForCategory then
			for _, entry in ipairs(importService.getCustomEntriesForCategory(customEntries, motionName, rigType or "")) do
				addClipOption(options, seen, entry, motionName)
			end
		end
		optionsByMotion[motionName] = options
	end
	return optionsByMotion
end

function MotionClipService.getSegmentMotionPresetEntry(importService, segment, rigType, customEntries)
	local motionName = tostring(segment and segment.motionName or "Path Only")
	if motionName == "Path Only" then
		return nil, nil
	end

	local clipId = trim(segment and segment.clipId)
	if clipId ~= "" then
		local entry = importService.findPresetEntryById(clipId, motionName, rigType)
		if entry then
			return entry, nil
		end
		if importService.findCustomEntryById then
			entry = importService.findCustomEntryById(customEntries, clipId, motionName, rigType)
			if entry then
				return entry, nil
			end
		end
		entry = makeDirectClipEntry(importService, clipId, motionName, rigType)
		if entry then
			return entry, nil
		end
		return nil, string.format("The selected %s clip id could not be read.", motionName)
	end

	local entry = importService.findDefaultPresetEntry(motionName, rigType)
	if entry then
		return entry, nil
	end
	return nil, string.format("No free %s preset was found for %s rigs.", motionName, rigType)
end

function MotionClipService.getSegmentPauseIdlePresetEntry(importService, segment, rigType, customEntries)
	local clipId = trim(segment and segment.pauseIdleClipId)
	if clipId == "" then
		return nil, nil
	end

	local entry = importService.findPresetEntryById(clipId, "Idle", rigType)
	if entry then
		return entry, nil
	end
	if importService.findCustomEntryById then
		entry = importService.findCustomEntryById(customEntries, clipId, "Idle", rigType)
		if entry then
			return entry, nil
		end
	end
	entry = makeDirectClipEntry(importService, clipId, "Idle", rigType)
	if entry then
		entry.name = "Pause idle custom clip"
		return entry, nil
	end
	return nil, "The selected pause idle clip id could not be read."
end

function MotionClipService.loadPresetClip(importService, entry, rigType, label)
	local contentId = importService.normalizeAnimationContentId(entry and (entry.id or entry.numericId))
	if not contentId then
		return false, string.format("Could not read the %s animation id.", label)
	end

	local success, clipOrMessage = importService.loadAnimationClipFromContentId(contentId)
	if not success then
		return false, string.format("Could not load %s: %s", label, tostring(clipOrMessage))
	end

	local clip = clipOrMessage
	if entry and entry.convertToR6 == true and tostring(rigType or "") == "R6" then
		local convertOk, convertedOrMessage = pcall(function()
			local converter = require(script.Parent:WaitForChild("AnimationConversion"):WaitForChild("R15ToR6Converter"))
			local sourceSequence = clip
			if not sourceSequence:IsA("KeyframeSequence") then
				sourceSequence = converter.LoadFromAnimationId(contentId)
			end
			return converter.Convert(sourceSequence)
		end)
		if not convertOk or not convertedOrMessage then
			return false, string.format("Could not convert %s to R6: %s", label, tostring(convertedOrMessage))
		end
		clip = convertedOrMessage
	end
	local clipRigType = importService.detectRigTypeFromAnimationClip(clip)
	if clipRigType and rigType and clipRigType ~= rigType then
		return false, string.format("%s is %s, but the bound rig is %s.", label, clipRigType, rigType)
	end

	return true, {
		clip = clip,
		name = entry.name or label,
		entry = entry,
	}
end

return MotionClipService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX166">
        <Properties>
          <string name="Name">MotionFreezePoseSupport</string>
          <ProtectedString name="Source">local MotionFreezePoseSupport = {}

function MotionFreezePoseSupport.freezeRigPoseAcrossHold(timeline, holdRange, rigName)
	if not holdRange then
		return false, "No hold range was provided."
	end

	local freezeFrame = math.max(holdRange.startFrame, holdRange.endFrame - 1)
	if freezeFrame &lt;= holdRange.startFrame then
		return true, nil
	end

	local pose = timeline:samplePose(holdRange.startFrame)
	if type(pose) ~= "table" then
		return false, "Could not sample the rig pose for the hold."
	end

	for _, motorData in ipairs(timeline:getMotors()) do
		if rigName and motorData.rigName ~= rigName then
			continue
		end
		local value = pose[motorData.path]
		if value ~= nil then
			local success, message = timeline:setTrackValueAtFrame(
				motorData.path,
				freezeFrame,
				value,
				"Linear",
				"InOut"
			)
			if not success then
				return false, message
			end
		end
	end

	return true, nil
end

return MotionFreezePoseSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX167">
        <Properties>
          <string name="Name">MotionImportClipSupport</string>
          <ProtectedString name="Source">local MotionImportClipSupport = {}

function MotionImportClipSupport.importClipInFrameRange(timeline, clip, startFrame, endFrame, rigName)
	if not clip then
		return false, "No clip was available to import."
	end

	local importOptions = {
		frameOffset = startFrame,
		repeatUntilFrame = endFrame,
		preserveMetadata = true,
		rigName = rigName,
	}

	if clip:IsA("KeyframeSequence") then
		return timeline:importKeyframeSequence(clip, importOptions)
	end
	if clip:IsA("CurveAnimation") then
		return timeline:importCurveAnimation(clip, importOptions)
	end

	return false, string.format("%s is not supported for range import.", clip.ClassName)
end

return MotionImportClipSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX168">
        <Properties>
          <string name="Name">MotionMarkerActionSupport</string>
          <ProtectedString name="Source">local MotionMarkerActionSupport = {}

function MotionMarkerActionSupport.clearWithSegments(motionBuilderState, motionService, deps)
	motionBuilderState:clearSegments()
	return motionService.clearMotionMarkers(deps)
end

function MotionMarkerActionSupport.clearSilently(motionBuilderState, motionService)
	motionBuilderState:clearSegments()
	pcall(function()
		if type(motionService.clearGeneratedMotionMarkers) == "function" then
			motionService.clearGeneratedMotionMarkers()
		else
			motionService.clearMotionMarkers({
				refreshUi = function() end,
			})
		end
	end)
end

function MotionMarkerActionSupport.deleteSelected(motionBuilderState, motionService, deps)
	motionBuilderState:clearSegments()
	return motionService.deleteSelectedMotionMarker(deps)
end

return MotionMarkerActionSupport
</ProtectedString>
