		Size = UDim2.new(0, 12, 0, 18),
		BackgroundColor3 = Constants.THEME.Accent,
		BorderSizePixel = 0,
		ZIndex = 4,
	})
	createCorner(timelinePlayheadHandle, 6)

	local timelineHintLabel = create("TextLabel", {
		Parent = trackLaneArea,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 360, 0, 20),
		Font = Enum.Font.Gotham,
		Text = "Scrub on ruler. Drag empty lane space to range-select.",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
	})

	local laneContainer = create("ScrollingFrame", {
		Parent = trackLaneArea,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 36),
		Size = UDim2.new(1, 0, 1, -48),
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.XY,
		ScrollBarThickness = 8,
	})
	create("UIPadding", {
		Parent = laneContainer,
		PaddingBottom = UDim.new(0, 20),
	})
	local laneLayout = nil

	local timelineMarqueeOverlay = create("TextButton", {
		Parent = trackLaneArea,
		Active = true,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 36),
		Size = UDim2.new(1, -12, 1, -78),
		Text = "",
		TextTransparency = 1,
		ZIndex = 100,
	})

	local marqueeBox = create("Frame", {
		Parent = timelineMarqueeOverlay,
