        <Item class="ModuleScript" referent="RBX72">
          <Properties>
            <string name="Name">MainTimingPopupSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))
local ModalOverlaySupport = require(script.Parent.Parent:WaitForChild("ModalOverlaySupport"))

local MainTimingPopupSupport = {}

local create = UiHelpers.create

local function setBackgroundRole(instance, role)
	instance:SetAttribute("MegMoThemeBackgroundRole", role)
	return instance
end

local function setTextRole(instance, role)
	instance:SetAttribute("MegMoThemeTextRole", role)
	return instance
end

local function getTimingState(controller)
	local viewModel = controller and controller._lastViewModel or nil
	local fps = math.max(1, tonumber(viewModel and viewModel.fps) or Constants.DEFAULT_FPS)
	local durationFrames = math.max(1, tonumber(viewModel and viewModel.durationFrames) or fps * 5)
	return fps, durationFrames
end

local function trimNumber(value)
	return string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", "")
end

local function parseDurationFrames(inputText, fps)
	local textValue = string.lower(tostring(inputText or "")):gsub("^%s+", ""):gsub("%s+$", "")
	if textValue == "" then
		return nil, "Enter an animation length."
	end
	local frameText = textValue:match("^([%d%.]+)%s*f$")
		or textValue:match("^([%d%.]+)%s*frames?$")
	if frameText then
		local frames = tonumber(frameText)
		if frames and frames &gt; 0 then
			return math.max(1, math.floor(frames + 0.5))
		end
	end
	local secondsText = textValue:match("^([%d%.]+)%s*s?$")
		or textValue:match("^([%d%.]+)%s*seconds?$")
	if secondsText then
		local seconds = tonumber(secondsText)
		if seconds and seconds &gt; 0 then
			return math.max(1, math.floor(seconds * fps + 0.5))
		end
	end
	local minutes, seconds = textValue:match("^(%d+):([%d%.]+)$")
	if minutes and seconds then
		local totalSeconds = (tonumber(minutes) or 0) * 60 + (tonumber(seconds) or 0)
		if totalSeconds &gt; 0 then
			return math.max(1, math.floor(totalSeconds * fps + 0.5))
		end
	end
	return nil, "Use seconds, frames, or mm:ss â€” for example 7.5, 180f, or 1:30."
end

function MainTimingPopupSupport.mount(parent, context)
	if not parent then
		return nil
	end

	local controller = context and context.controller
	local mode = "Duration"
	local presetConnections = {}

	local overlay = create("TextButton", {
		Name = "SessionTimingOverlay",
		Parent = parent,
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextTransparency = 1,
		Visible = false,
		ZIndex = 188,
	})
	ModalOverlaySupport.applyToOverlay(overlay)

	local card = setBackgroundRole(create("Frame", {
		Name = "SessionTimingCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -40, 0, 315),
		ZIndex = 189,
	}), "Panel")
	create("UISizeConstraint", {
		Parent = card,
		MinSize = Vector2.new(340, 315),
		MaxSize = Vector2.new(460, 315),
	})
	UiHelpers.applySectionSurface(card)
	UiHelpers.createCorner(card, 12)
	UiHelpers.createStroke(card, Constants.THEME.Border, 1)

	local title = setTextRole(create("TextLabel", {
		Name = "Title",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 15),
		Size = UDim2.new(1, -64, 0, 24),
		Text = "Animation Length",
		TextColor3 = Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 190,
	}), "Text")

	local closeButton = create("TextButton", {
		Name = "CloseButton",
		Parent = card,
		Position = UDim2.new(1, -44, 0, 12),
		Size = UDim2.fromOffset(30, 30),
		Text = "X",
		ZIndex = 190,
	})
	UiHelpers.styleGhostButton(closeButton)
	closeButton.Font = Enum.Font.GothamBold
	closeButton.TextSize = 12
	UiHelpers.createCorner(closeButton, 8)

	local description = setTextRole(create("TextLabel", {
		Name = "Description",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(18, 48),
		Size = UDim2.new(1, -36, 0, 36),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 190,
	}), "Text")

	setTextRole(create("TextLabel", {
		Name = "PresetLabel",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 91),
		Size = UDim2.new(1, -36, 0, 18),
		Text = "Quick presets",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 190,
	}), "Text")

	local presetRow = create("Frame", {
		Name = "PresetRow",
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 113),
		Size = UDim2.new(1, -36, 0, 38),
		ZIndex = 190,
	})

	setTextRole(create("TextLabel", {
		Name = "ManualLabel",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 165),
		Size = UDim2.new(1, -36, 0, 18),
		Text = "Custom value",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 190,
	}), "Text")

	local manualInput = setTextRole(setBackgroundRole(create("TextBox", {
		Name = "ManualInput",
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		PlaceholderColor3 = Constants.THEME.MutedText,
		PlaceholderText = "Seconds, frames, or mm:ss",
		Position = UDim2.fromOffset(18, 187),
		Size = UDim2.new(1, -36, 0, 38),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 190,
	}), "PanelAlt"), "Text")
	UiHelpers.styleInput(manualInput)
	UiHelpers.createCorner(manualInput, 8)
	UiHelpers.createStroke(manualInput, Constants.THEME.Border, 1)
	create("UIPadding", {
		Parent = manualInput,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local status = setTextRole(create("TextLabel", {
		Name = "Status",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(18, 231),
		Size = UDim2.new(1, -36, 0, 18),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 190,
	}), "Text")

	local cancelButton = create("TextButton", {
		Name = "CancelButton",
		Parent = card,
		Position = UDim2.new(0, 18, 1, -50),
		Size = UDim2.new(0.4, -24, 0, 36),
		Text = "Cancel",
		ZIndex = 190,
	})
	UiHelpers.styleGhostButton(cancelButton)
	cancelButton.Font = Enum.Font.GothamBold
	UiHelpers.createCorner(cancelButton, 8)

	local applyButton = create("TextButton", {
		Name = "ApplyButton",
		Parent = card,
		Position = UDim2.new(0.4, 4, 1, -50),
		Size = UDim2.new(0.6, -22, 0, 36),
		Text = "Apply",
		ZIndex = 190,
	})
	UiHelpers.styleTextButton(applyButton)
	applyButton.Font = Enum.Font.GothamBold
	UiHelpers.createCorner(applyButton, 8)

	local function close()
		overlay.Visible = false
		status.Text = ""
	end

	local function invokeCallback(callbackName, value)
		local callbacks = controller and controller._callbacks or nil
		local callback = callbacks and callbacks[callbackName] or nil
		if type(callback) ~= "function" then
			status.Text = "Project timing is not available yet."
			return false
		end
		local ok, err = pcall(callback, value)
		if not ok then
			status.Text = "Could not update project timing: " .. tostring(err)
			return false
		end
		close()
		return true
	end

	local function applyValue(rawValue)
		local fps = getTimingState(controller)
		if mode == "FPS" then
			local value = tonumber(rawValue)
			if not value or value &lt;= 0 then
				status.Text = "Enter a valid frame rate."
				return
			end
			invokeCallback("onFpsChanged", math.clamp(math.floor(value + 0.5), 1, 240))
			return
		end
		local frameCount, parseMessage = parseDurationFrames(rawValue, fps)
		if not frameCount then
			status.Text = parseMessage
			return
		end
		invokeCallback("onDurationChanged", frameCount)
	end

	local function clearPresetButtons()
		for _, connection in ipairs(presetConnections) do
			connection:Disconnect()
		end
		table.clear(presetConnections)
		for _, child in ipairs(presetRow:GetChildren()) do
			child:Destroy()
		end
	end

	local function buildPresetButtons(values)
		clearPresetButtons()
		local count = #values
		create("UIGridLayout", {
			Parent = presetRow,
			CellPadding = UDim2.fromOffset(7, 0),
			CellSize = UDim2.new(1 / count, -math.ceil(7 * (count - 1) / count), 1, 0),
			FillDirection = Enum.FillDirection.Horizontal,
			FillDirectionMaxCells = count,
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		for index, preset in ipairs(values) do
			local button = create("TextButton", {
				Name = "Preset" .. tostring(index),
				Parent = presetRow,
				LayoutOrder = index,
				Text = preset.label,
				ZIndex = 190,
			})
			UiHelpers.styleGhostButton(button)
			button.Font = Enum.Font.GothamBold
			button.TextSize = 11
			UiHelpers.createCorner(button, 7)
			table.insert(presetConnections, button.Activated:Connect(function()
				applyValue(preset.value)
			end))
		end
	end

	local popup = {}
	function popup:open(target)
		mode = target == "FPS" and "FPS" or "Duration"
		local fps, durationFrames = getTimingState(controller)
		status.Text = ""
		if mode == "FPS" then
			title.Text = "Frame Rate"
			description.Text = "Choose a common FPS or enter a custom frame rate for this project."
			manualInput.PlaceholderText = "Frames per second"
			manualInput.Text = tostring(math.floor(fps + 0.5))
			buildPresetButtons({
				{ label = "12 FPS", value = 12 },
				{ label = "24 FPS", value = 24 },
				{ label = "30 FPS", value = 30 },
				{ label = "60 FPS", value = 60 },
			})
		else
			title.Text = "Animation Length"
			description.Text = "Choose a common length or enter seconds, frames, or mm:ss."
			manualInput.PlaceholderText = "For example 7.5, 180f, or 1:30"
			manualInput.Text = trimNumber(durationFrames / fps)
			buildPresetButtons({
				{ label = "5 sec", value = "5" },
				{ label = "10 sec", value = "10" },
				{ label = "15 sec", value = "15" },
				{ label = "30 sec", value = "30" },
				{ label = "60 sec", value = "60" },
			})
		end
		overlay.Visible = true
		task.defer(function()
			if overlay.Visible and manualInput.Parent then
				manualInput:CaptureFocus()
			end
		end)
	end

	overlay.Activated:Connect(close)
	closeButton.Activated:Connect(close)
	cancelButton.Activated:Connect(close)
	applyButton.Activated:Connect(function()
		applyValue(manualInput.Text)
	end)
	manualInput.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			applyValue(manualInput.Text)
		end
	end)

	return popup
end

return MainTimingPopupSupport
</ProtectedString>
