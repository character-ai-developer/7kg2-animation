	refs.stageContent.Position = UDim2.fromOffset(8, 112)
	refs.stageContent.Size = UDim2.new(1, -16, 1, -168)
	refs.stageContent.BackgroundTransparency = 1
	refs.stageContent.ScrollBarThickness = 4

	return self
end

function EffectSetupPresentation:StyleAll(root)
	stripGloss(root)
	for _, panel in ipairs({
		self.refs.setupPanel,
		self.refs.setupNavigationPanel,
		self.refs.checklistPanel,
		self.refs.simulatePanel,
		self.refs.takePanel,
		self.refs.advancedPanel,
	}) do
		if panel then
			panel.BackgroundColor3 = self.theme.panel
			setPanelStroke(panel, self.theme.border, 0.5)
		end
	end
	if self.refs.status then
		self.refs.status.Visible = true
		self.refs.status.BackgroundColor3 = self.theme.panelAlt
		self.refs.status.Font = Enum.Font.GothamBold
		self.refs.status.Position = UDim2.new(0, 8, 1, -50)
		self.refs.status.Size = UDim2.new(1, -16, 0, 42)
		self.refs.status.TextSize = 13
		self.refs.status.TextXAlignment = Enum.TextXAlignment.Left
		self.refs.status.TextYAlignment = Enum.TextYAlignment.Center
		local statusPadding = self.refs.status:FindFirstChildOfClass("UIPadding")
		if statusPadding then
			statusPadding.PaddingLeft = UDim.new(0, 12)
			statusPadding.PaddingRight = UDim.new(0, 12)
		end
		border(self.refs.status, self.theme.border, 0.46)
	end
end

function EffectSetupPresentation:_updateHeader(effect, uiStage, setupPage)
	local isSetup = uiStage == "Setup"
	local isChooser = isSetup and setupPage == "Choose"
	local title = isChooser and "7kg2 KINETIC"
		or isSetup and effect.name
		or uiStage == "Capture" and "Capture Physics"
		or "Bake to Timeline"
	if self.headerTitle then
		self.headerTitle.Text = title
		self.headerTitle.TextColor3 = self.theme.text
		self.headerTitle.Font = Enum.Font.GothamBold
		self.headerTitle.TextSize = 17
		self.headerTitle.Position = UDim2.fromOffset(isSetup and not isChooser and 104 or 62, 11)
		self.headerTitle.Size = UDim2.new(1, isSetup and not isChooser and -160 or -116, 0, 28)
		self.headerTitle.TextTruncate = Enum.TextTruncate.AtEnd
	end
	if self.headerSubtitle then
		self.headerSubtitle.Visible = false
	end
	if self.headerIcon then
		self.headerIcon.Image = isChooser and "rbxassetid://110022673488157" or effect.image
		self.headerIcon.ImageColor3 = isChooser and self.theme.text or effect.accent
		self.headerIcon.BackgroundTransparency = 1
		self.headerIcon.Position = UDim2.fromOffset(isSetup and not isChooser and 62 or 18, 9)
		self.headerIcon.Size = UDim2.fromOffset(32, 32)
		self.headerIcon.Visible = true
	end
	self.bakeHeaderGlyph.Visible = false
	self.bakeHeaderGlyph.TextColor3 = self.theme.text
	if self.refs.help then
		self.refs.help.Visible = not isChooser
		self.refs.help.Position = UDim2.new(1, -74, 0, 10)
		self.refs.help.Size = UDim2.fromOffset(30, 30)
		setButtonSurface(self.refs.help, self.theme.button, self.theme.text)
	end
	if self.refs.close then
		self.refs.close.Position = UDim2.new(1, -40, 0, 10)
		self.refs.close.Size = UDim2.fromOffset(30, 30)
		setButtonSurface(self.refs.close, self.theme.button, self.theme.text)
	end
	self.headerTopDivider.BackgroundColor3 = self.theme.border
	self.headerBottomDivider.BackgroundColor3 = self.theme.border
end

function EffectSetupPresentation:_updateStageNavigation(effect, uiStage)
	local navigationAccent = readableAccentColor(effect.accent, self.theme.background, self.theme.text)
	for index, entry in ipairs(self.stageUnderlines) do
		local stageName = index == 1 and "Setup" or index == 2 and "Capture" or "Bake"
		local active = uiStage == stageName
		entry.button.BackgroundTransparency = 1
		entry.button.TextColor3 = active and navigationAccent or self.theme.text
		entry.underline.BackgroundColor3 = effect.accent
		entry.underline.Visible = active
	end
	self.refs.stageContent.ScrollBarImageColor3 = effect.accent
end

function EffectSetupPresentation:_updateReleaseSetup(
	effect,
	releaseObject,
	releaseData,
	releaseCollisionsEnabled
)
	local refs = self.refs
	local selectedName = releaseObject and releaseObject.Parent and releaseObject.Name or "Not detected yet"
	local releaseFrame = releaseData and tonumber(releaseData.releaseFrame) or nil
	self.releaseCollisionsEnabled = releaseCollisionsEnabled ~= false

	-- Release uses the same card, steps, status and button rhythm as every
	-- other effect. Only the compact collision row is Release-specific.
	refs.rig.Size = UDim2.new(1, -28, 0, 82)
	refs.rig.ClipsDescendants = true
	self.setupStatusValue.Text = string.format(
		"Object: %s\nDetach: %s",
		selectedName,
		releaseFrame and ("Frame " .. tostring(releaseFrame)) or "Not loaded"
	)
	self.setupStatusValue.Size = UDim2.new(1, -24, 0, 29)
	self.reviewRowOneLabel.Visible = false
	self.reviewRowOneValue.Visible = false
	self.reviewRowTwoLabel.Visible = true
	self.reviewRowTwoValue.Visible = true
	self.reviewDivider.Visible = true
	self.reviewRowTwoLabel.TextColor3 = self.theme.text
	self.reviewRowTwoLabel.Font = Enum.Font.GothamSemibold
	self.reviewRowTwoLabel.Position = UDim2.fromOffset(12, 52)
	self.reviewRowTwoLabel.Size = UDim2.new(1, -104, 0, 24)
	self.reviewRowTwoValue.Position = UDim2.new(1, -78, 0, 52)
	self.reviewRowTwoValue.Size = UDim2.fromOffset(66, 24)
	self.reviewRowTwoValue.Text = self.releaseCollisionsEnabled and "ON" or "OFF"
	self.reviewRowTwoValue.BackgroundColor3 = self.releaseCollisionsEnabled and effect.accent or self.theme.button
	self.reviewRowTwoValue.TextColor3 = self.releaseCollisionsEnabled
		and readableTextColor(effect.accent)
		or self.theme.text
	local collisionStroke = self.reviewRowTwoValue:FindFirstChildOfClass("UIStroke")
	if collisionStroke then
		collisionStroke.Color = self.releaseCollisionsEnabled and effect.accent or self.theme.border
		collisionStroke.Transparency = self.releaseCollisionsEnabled and 0.08 or 0.32
	end
	self.reviewDivider.Position = UDim2.fromOffset(12, 49)
	self.reviewDivider.BackgroundColor3 = self.theme.border
	refs.loadPath.Position = UDim2.fromOffset(14, 284)
	refs.loadPath.Size = UDim2.new(1, -28, 0, 38)
	refs.selectButton.Position = UDim2.fromOffset(14, 330)
	refs.selectButton.Size = UDim2.new(1, -28, 0, 38)
	refs.selectButton.Text = releaseObject and releaseObject.Parent
		and ("Release Object: " .. selectedName .. " - Change")
		or "Use Selected Release Object (Optional)"

	return 382
end

function EffectSetupPresentation:_updateSetup(
	effect,
	effectMode,
	movingObjectMode,
	advancedVisible,
	ready,
	releaseObject,
	releaseData,
	releaseCollisionsEnabled,
	startingPushTested,
	eventTested
)
	local refs = self.refs
	self.effectIcon.Visible = true
	refs.setupHeading.Visible = true
	self.howLabel.Visible = true
	self.optionalControlsLabel.Visible = false
	self.releaseSelectionIcon.Visible = false
	self.releaseSelectionValue.Visible = false
	self.releaseSelectionAction.Visible = false
	self.releaseLoadIcon.Visible = false
	self.releaseLoadValue.Visible = false
	self.releaseLoadAction.Visible = false
	self.setupStatusEyebrow.Visible = true
	self.setupStatusValue.Visible = true
	self.setupStatusValue.Position = UDim2.fromOffset(12, 20)
	self.setupStatusValue.Size = UDim2.new(1, -24, 0, 32)
	self.reviewRowOneLabel.Visible = false
	self.reviewRowOneValue.Visible = false
	self.reviewRowTwoLabel.Visible = false
	self.reviewRowTwoValue.Visible = false
	self.reviewDivider.Visible = false
	for _, divider in ipairs(self.releaseDividers) do
		divider.Visible = false
	end
	refs.setupPanel.BackgroundTransparency = 0
	refs.setupPrompt.Visible = true
	refs.setupPrompt.Position = UDim2.fromOffset(14, 38)
	refs.setupPrompt.Size = UDim2.new(1, -28, 0, 32)
	refs.setupPrompt.TextSize = 12
	self.instructions.Position = UDim2.fromOffset(14, 102)
	self.instructions.Size = UDim2.new(1, -28, 0, 84)
	for index, row in ipairs(self.stepRows) do
		local y = (index - 1) * 28
		row.number.Visible = true
		row.text.Visible = true
		row.number.Position = UDim2.fromOffset(0, y)
		row.number.Size = UDim2.fromOffset(24, 24)
		row.number.Font = Enum.Font.GothamBold
		row.number.TextSize = 20
		row.text.Position = UDim2.fromOffset(30, y + 1)
		row.text.Size = UDim2.new(1, -30, 0, 23)
		row.text.Font = Enum.Font.GothamSemibold
		row.text.TextSize = 11
		local divider = self.instructions:FindFirstChild("Divider" .. index)
		if divider then
			divider.Visible = true
		end
	end
	refs.checklistPanel.Visible = true
	refs.setupBack.Visible = true
	refs.setupHeading.Text = effect.name
	refs.setupPrompt.Text = effect.purpose
	self.effectIcon.Image = effect.image
	self.effectIcon.ImageColor3 = effect.accent
	self.effectIcon.BackgroundColor3 = effect.accent:Lerp(self.theme.panel, 0.78)
	for index, row in ipairs(self.stepRows) do
		row.number.TextColor3 = readableAccentColor(effect.accent, self.theme.panel, self.theme.text)
		row.text.Text = effect.steps[index] or ""
		row.text.TextColor3 = self.theme.text
	end
	self.howLabel.TextColor3 = readableAccentColor(effect.accent, self.theme.panel, self.theme.text)
	refs.setupPanel.BackgroundColor3 = self.theme.panel
	setPanelStroke(refs.setupPanel, self.theme.border, 0.5)
	refs.rig.BackgroundColor3 = self.theme.panelAlt
	refs.rig.TextColor3 = self.theme.text
	self.setupStatusEyebrow.TextColor3 = readableAccentColor(effect.accent, self.theme.panelAlt, self.theme.text)
	self.setupStatusValue.Text = refs.rig.Text
	self.setupStatusValue.TextColor3 = self.theme.text
	refs.rig.Text = ""

	-- Release uses an indented, taller layout for these shared controls.
	-- Reset both axes and dimensions before presenting another effect so that
	-- its layout cannot leak into Drop, Ragdoll, Scene, or the event effects.
	refs.rig.Position = UDim2.fromOffset(14, 194)
	refs.rig.Size = UDim2.new(1, -28, 0, 58)
	refs.selectButton.Position = UDim2.fromOffset(14, 260)
	refs.selectButton.Size = UDim2.new(1, -28, 0, 38)
	refs.loadPath.Position = UDim2.fromOffset(14, 302)
	refs.loadPath.Size = UDim2.new(1, -28, 0, 38)
	refs.driverButton.Position = UDim2.fromOffset(14, 260)
	refs.driverButton.Size = UDim2.new(1, -28, 0, 38)
	refs.riderButton.Position = UDim2.fromOffset(14, 302)
	refs.riderButton.Size = UDim2.new(1, -28, 0, 38)
	setOffsetY(refs.walkPrevious, 302)
	setOffsetY(refs.walkStyle, 302)
	setOffsetY(refs.walkNext, 302)
	setOffsetY(refs.bounce, 302)
	setOffsetY(refs.eventSource, 302)
	setOffsetY(refs.eventVFX, 344)
	setOffsetY(refs.ragdollMode, 302)
	setOffsetY(refs.startingPush, 302)
	setOffsetY(refs.startingPushClear, 302)
	setOffsetY(refs.startingPushSpeedDown, 344)
	setOffsetY(refs.startingPushSpeed, 344)
	setOffsetY(refs.startingPushSpeedUp, 344)
	setOffsetY(refs.startingPushTest, 386)

	local setupHeight
	if effectMode == "Character" then
		setOffsetY(refs.selectButton, 260)
		setOffsetY(refs.ragdollMode, 302)
		setOffsetY(refs.startingPush, 344)
		setOffsetY(refs.startingPushClear, 344)
		setOffsetY(refs.startingPushSpeedDown, 386)
		setOffsetY(refs.startingPushSpeed, 386)
		setOffsetY(refs.startingPushSpeedUp, 386)
		setOffsetY(refs.startingPushTest, 428)
		setupHeight = refs.startingPushTest.Visible and 482
			or refs.startingPushSpeed.Visible and 440
			or refs.startingPush.Visible and 398
			or 356
	elseif effectMode == "Scene" then
		setOffsetY(refs.selectButton, 260)
		setOffsetY(refs.startingPush, 302)
		setOffsetY(refs.startingPushClear, 302)
		setOffsetY(refs.startingPushSpeedDown, 344)
		setOffsetY(refs.startingPushSpeed, 344)
		setOffsetY(refs.startingPushSpeedUp, 344)
		setOffsetY(refs.startingPushTest, 386)
		setupHeight = refs.startingPushSpeed.Visible and 440 or 356
	elseif effectMode == "Drop" then
		setOffsetY(refs.selectButton, 260)
		setupHeight = 356
	elseif effectMode == "Release" then
		setupHeight = self:_updateReleaseSetup(
			effect,
			releaseObject,
			releaseData,
			releaseCollisionsEnabled
		)
	elseif effectMode == "AdaptiveWalk" then
		setOffsetY(refs.selectButton, 260)
		setOffsetY(refs.loadPath, 344)
		setupHeight = 398
	elseif effectMode == "Impact" then
		if movingObjectMode == "PhysicsDrive" then
			setOffsetY(refs.driverButton, 260)
			setOffsetY(refs.loadPath, 302)
			self.optionalControlsLabel.Visible = true
			self.optionalControlsLabel.Position = UDim2.fromOffset(14, 346)
			self.optionalControlsLabel.TextColor3 = self.theme.text
			refs.riderButton.Position = UDim2.fromOffset(14, 364)
			refs.riderButton.Size = UDim2.new(0.5, -21, 0, 38)
			refs.selectButton.Position = UDim2.new(0.5, 7, 0, 364)
			refs.selectButton.Size = UDim2.new(0.5, -21, 0, 38)
			if refs.riderButton.Text == "Use Selected Riders (Optional)" then
				refs.riderButton.Text = "Add Riders"
			end
			if refs.selectButton.Text == "Use Selected Loose Objects (Optional)" then
				refs.selectButton.Text = "Add Loose Objects"
			end
			refs.movement.Position = UDim2.fromOffset(14, 410)
			refs.movement.Size = UDim2.new(0.5, -21, 0, 38)
			refs.keepUpright.Position = UDim2.new(0.5, 7, 0, 410)
			refs.keepUpright.Size = UDim2.new(0.5, -21, 0, 38)
			setupHeight = 464
		else
			setOffsetY(refs.driverButton, 260)
			setOffsetY(refs.selectButton, 302)
			setOffsetY(refs.loadPath, 344)
			refs.movement.Position = UDim2.fromOffset(14, 386)
			refs.movement.Size = UDim2.new(1, -28, 0, 38)
			setupHeight = 440
		end
	elseif effectMode == "Projectile" then
		setOffsetY(refs.selectButton, 260)
		setOffsetY(refs.projectileStart, 344)
		setOffsetY(refs.projectileEnd, 344)
		setOffsetY(refs.eventTimeDown, 386)
		setOffsetY(refs.eventTime, 386)
		setOffsetY(refs.eventTimeUp, 386)
		setOffsetY(refs.eventTimeHelp, 427)
		refs.eventTimeHelp.Size = UDim2.new(1, -28, 0, 30)
		refs.eventTimeHelp.TextWrapped = true
		setOffsetY(refs.eventStrength, 463)
		setOffsetY(refs.eventSlowMotion, 463)
		setOffsetY(refs.eventReaction, 505)
		setOffsetY(refs.eventPowerPanel, 555)
		setOffsetY(refs.eventAdd, 597)
		setOffsetY(refs.eventRemove, 597)
		setupHeight = 651
	else
		setOffsetY(refs.selectButton, 260)
		-- Explosion fires immediately, so the reaction controls can follow the
		-- blast-point and optional VFX controls without exposing a delay row.
		setOffsetY(refs.eventVFX, 344)
		setOffsetY(refs.eventStrength, 386)
		setOffsetY(refs.eventReaction, 428)
		setOffsetY(refs.eventDirection, 478)
		setOffsetY(refs.eventPowerPanel, 520)
		setupHeight = 562
	end
	setOffsetY(refs.eventTest, setupHeight)
	setupHeight += 52

	local characterNeedsTest = effectMode == "Character"
		and refs.startingPushTest.Visible
		and not startingPushTested
	local explosionNeedsTest = effectMode == "Explosion"
		and refs.eventTest.Visible
		and not eventTested
	refs.setupPanel.Size = UDim2.new(1, 0, 0, setupHeight)
	refs.checklistPanel.Position = UDim2.fromOffset(0, setupHeight + (ready and 70 or 10))
	refs.checklistPanel.Size = UDim2.new(1, 0, 0, 40)
	refs.checklistPanel.BackgroundColor3 = self.theme.panelAlt
	setPanelStroke(refs.checklistPanel, ready and effect.accent or self.theme.border, 0.52)
	self.readyIndicator.frame.Visible = false
	refs.checklist.Text = ready
		and (characterNeedsTest and "Test the Knockback before capturing"
			or explosionNeedsTest and "Test the Explosion before capturing"
			or "Ready to continue")
		or refs.checklist.Text
	refs.checklist.TextColor3 = ready
		and readableAccentColor(effect.accent, self.theme.panelAlt, self.theme.text)
		or self.theme.text
	refs.checklist.TextXAlignment = Enum.TextXAlignment.Center
	refs.checklist.Font = Enum.Font.GothamSemibold
	refs.checklist.TextSize = 11
	local checklistPadding = refs.checklist:FindFirstChild("HandcraftedReadyPadding")
	if checklistPadding then
		checklistPadding.PaddingLeft = UDim.new(0, 0)
		checklistPadding.PaddingRight = UDim.new(0, 0)
	end

	refs.setupNavigationPanel.Position = UDim2.fromOffset(0, setupHeight + (ready and 10 or 60))
	refs.setupNavigationPanel.Size = UDim2.new(1, 0, 0, 52)
	refs.setupNavigationPanel.BackgroundTransparency = 1
	setPanelStroke(refs.setupNavigationPanel, self.theme.border, 1)
	refs.setupBack.Position = UDim2.fromOffset(0, 6)
	refs.setupBack.Size = UDim2.new(0.32, -5, 0, 40)
	refs.setupContinue.Position = UDim2.new(0.32, 5, 0, 6)
	refs.setupContinue.Size = UDim2.new(0.68, -5, 0, 40)
	refs.setupContinue.Text = effectMode == "Character" and "Simulate &amp; Capture" or "Continue to Capture"
	setButtonSurface(refs.setupBack, self.theme.button, self.theme.text)
	if ready then
		setPrimaryButton(refs.setupContinue, effect.buttonAccent or effect.accent)
	else
		setOutlinedButton(refs.setupContinue, self.theme, self.theme.border)
		refs.setupContinue.TextColor3 = self.theme.muted
	end

	refs.advancedToggle.Visible = false
	refs.advancedPanel.Visible = false

	for _, button in ipairs({
		refs.selectButton,
		refs.driverButton,
		refs.riderButton,
		refs.loadPath,
		refs.eventSource,
		refs.eventVFX,
		refs.projectileStart,
		refs.projectileEnd,
		refs.ragdollMode,
		refs.startingPush,
		refs.startingPushClear,
		refs.startingPushSpeedDown,
		refs.startingPushSpeedUp,
		refs.startingPushTest,
		refs.eventTest,
		refs.capture,
	}) do
		if button and button.Visible then
			setOutlinedButton(button, self.theme, effect.accent)
		end
	end
	if effectMode == "Impact" and movingObjectMode == "PhysicsDrive" then
		setOutlinedButton(refs.riderButton, self.theme, self.theme.border)
		setOutlinedButton(refs.selectButton, self.theme, self.theme.border)
	end
	if refs.startingPushClear.Visible then
		setOutlinedButton(refs.startingPushClear, self.theme, self.theme.border)
		setOutlinedButton(refs.startingPushSpeed, self.theme, self.theme.border)
		setOutlinedButton(refs.startingPushTest, self.theme, effect.accent)
	end

	local statusText = self.setupStatusValue.Text or ""
	local primaryButton
	if effectMode == "AdaptiveWalk" then
		primaryButton = string.find(statusText, "No rig selected", 1, true)
			and refs.selectButton
			or refs.loadPath
	elseif effectMode == "Release" then
		primaryButton = not releaseData and refs.loadPath
			or not (releaseObject and releaseObject.Parent) and refs.selectButton
			or refs.setupContinue
	elseif effectMode == "Impact" then
		if string.find(statusText, "Moving Object: Not selected", 1, true) then
			primaryButton = refs.driverButton
		elseif movingObjectMode ~= "PhysicsDrive"
			and string.find(statusText, "Physics objects: 0 selected", 1, true) then
			primaryButton = refs.selectButton
		else
			primaryButton = refs.loadPath
		end
	elseif effectMode == "Projectile" then
		primaryButton = string.find(statusText, "Affected objects: 0", 1, true)
			and refs.selectButton
			or refs.eventAdd
	elseif effectMode == "Explosion" then
		if string.find(statusText, "Affected objects: 0", 1, true) then
			primaryButton = refs.selectButton
			elseif string.find(statusText, "Blast Origin: Not selected", 1, true) then
			primaryButton = refs.eventSource
		elseif explosionNeedsTest then
			primaryButton = refs.eventTest
		else
			primaryButton = refs.setupContinue
		end
	elseif effectMode == "Character" then
		if string.find(statusText, "No rig selected", 1, true) then
			primaryButton = refs.selectButton
		elseif refs.startingPush.Visible and not refs.startingPushClear.Visible then
			primaryButton = refs.startingPush
		elseif characterNeedsTest then
			primaryButton = refs.startingPushTest
		else
			primaryButton = refs.selectButton
		end
	else
		primaryButton = refs.selectButton
	end
	if (not ready or characterNeedsTest or explosionNeedsTest) and primaryButton and primaryButton.Visible then
		setPrimaryButton(primaryButton, effect.buttonAccent or effect.accent)
	end
	setNextAction(primaryButton, effect.buttonAccent or effect.accent, not ready or characterNeedsTest or explosionNeedsTest)
	setNextAction(refs.setupContinue, effect.buttonAccent or effect.accent, ready and not characterNeedsTest and not explosionNeedsTest)

	refs.stageContent.CanvasSize = UDim2.fromOffset(0, setupHeight + 172)
end

function EffectSetupPresentation:_updateAdvanced(effect)
	local refs = self.refs
	refs.advancedPanel.Size = UDim2.new(1, 0, 0, 460)
	refs.advancedPanel.BackgroundColor3 = self.theme.panel
	setPanelStroke(refs.advancedPanel, self.theme.border, 0.42)
	self.advancedTitle.TextColor3 = self.theme.text
	self.advancedSubtitle.TextColor3 = self.theme.text
	self.advancedSubtitle.Font = Enum.Font.GothamSemibold
	self.advancedSubtitle.TextSize = 11
	for _, label in ipairs(self.advancedSectionLabels) do
		label.TextColor3 = readableAccentColor(effect.accent, self.theme.panel, self.theme.text)
	end

	refs.ragdoll.Position = UDim2.fromOffset(14, 76)
	refs.ragdoll.Size = UDim2.new(1, -28, 0, 34)
	refs.pathMode.Position = UDim2.fromOffset(14, 116)
	refs.pathMode.Size = UDim2.new(0.5, -20, 0, 34)
	refs.impact.Position = UDim2.new(0.5, 6, 0, 116)
	refs.impact.Size = UDim2.new(0.5, -20, 0, 34)

	refs.scopeRig.Position = UDim2.fromOffset(14, 162)
	refs.scopeRig.Size = UDim2.new(1 / 3, -16, 0, 32)
	refs.scopeSelected.Position = UDim2.new(1 / 3, 2, 0, 162)
	refs.scopeSelected.Size = UDim2.new(1 / 3, -10, 0, 32)
	refs.scopeScene.Position = UDim2.new(2 / 3, 4, 0, 162)
	refs.scopeScene.Size = UDim2.new(1 / 3, -18, 0, 32)

	for index, button in ipairs({
		refs.fps30,
		refs.fps60,
		refs.duration10,
		refs.duration20,
		refs.duration30,
	}) do
		button.Position = UDim2.new((index - 1) / 5, index == 1 and 14 or 4, 0, 224)
		button.Size = UDim2.new(1 / 5, index == 1 and -18 or index == 5 and -18 or -8, 0, 32)
	end

	refs.capture.Position = UDim2.fromOffset(14, 286)
	refs.capture.Size = UDim2.new(1, -28, 0, 34)
	refs.bake.Position = UDim2.fromOffset(14, 326)
	refs.bake.Size = UDim2.new(1, -28, 0, 34)
	refs.targets.Visible = false
	refs.path.Visible = false

	for _, button in ipairs({
		refs.ragdoll,
		refs.pathMode,
		refs.impact,
		refs.scopeRig,
		refs.scopeSelected,
		refs.scopeScene,
		refs.fps30,
		refs.fps60,
		refs.duration10,
		refs.duration20,
		refs.duration30,
		refs.capture,
		refs.bake,
	}) do
		button.Font = Enum.Font.GothamSemibold
		button.TextSize = 11
		local stroke = button:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = button.BackgroundColor3
			stroke.Transparency = 0.38
			stroke.Thickness = 1
		end
	end
	self.advancedHelp.BackgroundColor3 = self.theme.panelAlt
	setPanelStroke(self.advancedHelp, self.theme.border, 0.42)
	self.advancedHelpTitle.TextColor3 = self.theme.text
	self.advancedHelpBody.TextColor3 = self.theme.text
	self.advancedHelpBody.Font = Enum.Font.GothamSemibold
	self.advancedHelpBody.TextSize = 11
end

function EffectSetupPresentation:_updateCapture(
	effectMode,
	effect,
	ready,
	maxDuration,
	take,
	releaseObject,
	releaseData
)
	local refs = self.refs
	self.currentMaxDuration = tonumber(maxDuration) or 0
	self.captureGuide.frame.Visible = true
	self.captureGuide.frame.Position = UDim2.fromOffset(0, 0)
	self.captureGuide.frame.Size = UDim2.new(1, 0, 0, 34)
	self.captureGuide.icon.Visible = false
	self.captureGuide.heading.Visible = false
	self.captureGuide.purpose.Position = UDim2.fromOffset(8, 4)
	self.captureGuide.purpose.Size = UDim2.new(1, -16, 0, 24)
	self.captureGuide.purpose.TextWrapped = false
	self.captureGuide.purpose.TextTruncate = Enum.TextTruncate.AtEnd
	self.captureGuide.purpose.TextSize = 11
	local contextParts = { effect.name }
	if releaseObject and releaseObject.Parent then
		table.insert(contextParts, releaseObject.Name)
	end
	if releaseData and tonumber(releaseData.releaseFrame) then
		table.insert(contextParts, "Frame " .. tostring(releaseData.releaseFrame))
	end
	self.captureGuide.purpose.Text = table.concat(contextParts, "  -  ")
	self.captureGuide.purpose.TextColor3 = self.theme.text
	self.captureGuide.purpose.Font = Enum.Font.GothamSemibold

	local readinessDetail = refs.checklist.Text
	refs.checklistPanel.Visible = true
	refs.checklistPanel.Position = UDim2.fromOffset(0, 44)
	refs.checklistPanel.Size = UDim2.new(1, 0, 0, 110)
	refs.checklistPanel.BackgroundColor3 = self.theme.panelAlt
	setPanelStroke(refs.checklistPanel, self.theme.border, 0.42)
	self.readyIndicator.frame.Visible = true
	self.readyIndicator.frame.Position = UDim2.new(0, 24, 0.5, 0)
	self.readyIndicator.frame.Size = UDim2.fromOffset(46, 46)
	self.readyIndicator.stroke.Color = effect.accent
	self.readyIndicator.stroke.Thickness = 4
	self.readyIndicator.check.Visible = ready
	self.readyIndicator.check.ImageColor3 = Color3.fromRGB(88, 224, 135)
	refs.checklist.Text = ready
		and "Ready to simulate\nThe result will play in the Studio viewport."
		or ("Finish setup\n" .. readinessDetail)
	refs.checklist.TextColor3 = self.theme.text
	refs.checklist.TextXAlignment = Enum.TextXAlignment.Left
	refs.checklist.TextYAlignment = Enum.TextYAlignment.Center
	refs.checklist.Font = Enum.Font.GothamSemibold
	refs.checklist.TextSize = 13
	local padding = refs.checklist:FindFirstChild("HandcraftedReadyPadding")
	if not padding then
		padding = make("UIPadding", {
			Name = "HandcraftedReadyPadding",
			PaddingLeft = UDim.new(0, 92),
			PaddingRight = UDim.new(0, 12),
		}, refs.checklist)
	end
	padding.PaddingLeft = UDim.new(0, 92)
	padding.PaddingRight = UDim.new(0, 12)

	refs.simulatePanel.Visible = true
	refs.simulatePanel.Position = UDim2.fromOffset(0, 170)
	refs.simulatePanel.Size = UDim2.new(1, 0, 0, 62)
	refs.simulatePanel.BackgroundTransparency = 1
	setPanelStroke(refs.simulatePanel, self.theme.border, 1)
	for _, child in ipairs(refs.simulatePanel:GetChildren()) do
		if child:IsA("TextLabel") then
			child.Visible = false
		end
	end
	refs.run.Position = UDim2.fromOffset(0, 0)
	refs.run.Size = UDim2.new(1, 0, 0, 56)
	setPrimaryButton(refs.run, effect.buttonAccent or effect.accent)

	self.captureInfo.frame.Visible = true
	self.captureInfo.frame.Position = UDim2.fromOffset(0, 246)
	self.captureInfo.frame.Size = UDim2.new(1, 0, 0, 134)
	self.captureInfo.frame.BackgroundColor3 = self.theme.panelAlt
	setPanelStroke(self.captureInfo.frame, self.theme.border, 0.42)
	self.captureInfo.durationValue.Text = string.format("%.2f sec", tonumber(maxDuration) or 0)
	self.captureInfo.durationValue.TextColor3 = self.theme.text
	self.captureInfo.durationValue.BackgroundColor3 = self.theme.button
	local durationStroke = self.captureInfo.durationValue:FindFirstChildOfClass("UIStroke")
	if durationStroke then
		durationStroke.Color = effect.accent
		durationStroke.Transparency = 0.24
	end
	self.captureInfo.statusValue.Text = take and "Captured" or ready and "Ready" or "Setup needed"
	self.captureInfo.statusValue.TextColor3 = take
		and effect.accent
		or ready and Color3.fromRGB(177, 223, 83)
		or self.theme.muted
	self.captureInfo.qualityDivider.BackgroundColor3 = self.theme.border
	self.captureInfo.qualityLabel.TextColor3 = self.theme.text
	for index, button in ipairs({ refs.fps30, refs.fps60 }) do
		local selected = button.BackgroundColor3 == self.theme.accent
		button.Visible = true
		button.Active = true
		button.Position = UDim2.new(index == 1 and 0.52 or 0.76, 0, 0, 96)
		button.Size = UDim2.new(0.24, index == 1 and -6 or -12, 0, 32)
		button.BackgroundColor3 = selected and effect.accent or self.theme.button
		button.BackgroundTransparency = 0
		button.Font = Enum.Font.GothamBold
		button.TextSize = 11
		button.TextColor3 = WHITE
		local stroke = button:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = selected and effect.accent or self.theme.border
			stroke.Transparency = selected and 0.12 or 0.38
			stroke.Thickness = 1
		end
	end

	refs.takePanel.Visible = true
	refs.takePanel.Position = UDim2.fromOffset(0, 0)
	refs.takePanel.Size = UDim2.new(1, 0, 0, 554)
	refs.takePanel.BackgroundTransparency = 1
	setPanelStroke(refs.takePanel, self.theme.border, 1)
	refs.takeHeading.Visible = false
	refs.take.Visible = false
	self.bakeSummary.frame.Visible = false
	self.bakeTimeline.frame.Visible = false

	if take then
		refs.preview.Visible = true
		refs.preview.Position = UDim2.fromOffset(0, 394)
		refs.preview.Size = UDim2.new(0.64, -6, 0, 42)
		setButtonSurface(refs.preview, self.theme.button, self.theme.text)
		refs.previewSpeed.Visible = true
		refs.previewSpeed.Position = UDim2.new(0.64, 6, 0, 394)
		refs.previewSpeed.Size = UDim2.new(0.36, -6, 0, 42)
		setOutlinedButton(refs.previewSpeed, self.theme, self.theme.border)
		refs.retake.Visible = true
		refs.retake.Position = UDim2.fromOffset(0, 446)
		refs.retake.Size = UDim2.new(0.5, -6, 0, 38)
		refs.retake.Text = "Retake"
		refs.retake.BackgroundTransparency = refs.retake.Active and 0 or 0.5
		setOutlinedButton(refs.retake, self.theme, self.theme.border)
		refs.reset.Visible = true
		refs.reset.Position = UDim2.new(0.5, 6, 0, 446)
		refs.reset.Size = UDim2.new(0.5, -6, 0, 38)
		setOutlinedButton(refs.reset, self.theme, self.theme.border)
		refs.push.Visible = false
		refs.continueBake.Position = UDim2.fromOffset(0, 496)
	else
		refs.preview.Visible = false
		refs.previewSpeed.Visible = false
		refs.retake.Visible = false
		refs.push.Visible = refs.push.Active
		refs.push.Position = UDim2.fromOffset(0, 394)
		refs.push.Size = UDim2.new(0.5, -6, 0, 42)
		refs.push.BackgroundTransparency = refs.push.Active and 0 or 0.5
		setOutlinedButton(refs.push, self.theme, self.theme.border)
		refs.reset.Visible = true
		refs.reset.Position = refs.push.Visible and UDim2.new(0.5, 6, 0, 394) or UDim2.fromOffset(0, 394)
		refs.reset.Size = refs.push.Visible and UDim2.new(0.5, -6, 0, 42) or UDim2.new(1, 0, 0, 42)
		setOutlinedButton(refs.reset, self.theme, self.theme.border)
		refs.continueBake.Position = UDim2.fromOffset(0, 448)
	end
	refs.continueBake.Visible = effectMode ~= "Character"
	refs.continueBake.Size = UDim2.new(1, 0, 0, 50)
	if take then
		setPrimaryButton(refs.continueBake, effect.buttonAccent or effect.accent)
		refs.continueBake.BackgroundTransparency = 0
	else
		setOutlinedButton(refs.continueBake, self.theme, self.theme.border)
		refs.continueBake.TextColor3 = self.theme.muted
		refs.continueBake.BackgroundTransparency = 0.35
	end
	if not ready then
		refs.run.BackgroundTransparency = 0.5
	end
	setNextAction(refs.run, effect.buttonAccent or effect.accent, ready and not take)
	setNextAction(refs.continueBake, effect.buttonAccent or effect.accent, effectMode ~= "Character" and take ~= nil)
	refs.stageContent.CanvasSize = UDim2.fromOffset(
		0,
		effectMode == "Character" and (take and 496 or 448) or (take and 554 or 516)
	)
end

function EffectSetupPresentation:_updateBake(effectMode, effect, take)
	local refs = self.refs
	self.captureGuide.frame.Visible = false
	self.captureInfo.frame.Visible = false
	self.readyIndicator.frame.Visible = false
	refs.takePanel.Position = UDim2.fromOffset(0, 0)
	refs.takePanel.Size = UDim2.new(1, 0, 0, 350)
	refs.takePanel.BackgroundTransparency = 1
	setPanelStroke(refs.takePanel, self.theme.border, 1)
	refs.takeHeading.Visible = false
	refs.take.Visible = false
	self.bakeSummary.frame.Visible = true
	self.bakeTimeline.frame.Visible = false
	self.bakeSummary.frame.Position = UDim2.fromOffset(0, 8)
	self.bakeSummary.frame.Size = UDim2.new(1, 0, 0, 168)
	local summaryKeys = { "duration", "samples", "fps", "tracks" }
	for index = 1, 4 do
		local y = (index - 1) * 42
		local key = summaryKeys[index]
		self.bakeSummary.icons[index].Position = UDim2.fromOffset(14, y)
		self.bakeSummary.icons[index].Size = UDim2.fromOffset(26, 42)
		self.bakeSummary.icons[index].TextColor3 = self.theme.text
		self.bakeSummary.icons[index].TextSize = 18
		self.bakeSummary.icons[index].Visible = false
		self.bakeSummary.labels[index].Position = UDim2.fromOffset(16, y)
		self.bakeSummary.labels[index].Size = UDim2.new(0.55, -16, 0, 42)
		self.bakeSummary.labels[index].Font = Enum.Font.GothamSemibold
		self.bakeSummary.labels[index].TextColor3 = self.theme.text
		self.bakeSummary.labels[index].TextSize = 12
		self.bakeSummary.values[key].Position = UDim2.new(0.55, 0, 0, y)
		self.bakeSummary.values[key].Size = UDim2.new(0.45, -16, 0, 42)
		self.bakeSummary.values[key].TextSize = 12
		if index &lt; 4 then
			self.bakeSummary.dividers[index].Position = UDim2.fromOffset(12, y + 41)
			self.bakeSummary.dividers[index].Size = UDim2.new(1, -24, 0, 1)
		end
	end
	local duration = take and tonumber(take.duration) or 0
	local samples = take and type(take.samples) == "table" and #take.samples or 0
	local fps = take and tonumber(take.fps) or 0
	self.bakeSummary.values.duration.Text = string.format("%.2f sec", duration)
	self.bakeSummary.values.samples.Text = tostring(samples)
	self.bakeSummary.values.fps.Text = fps &gt; 0 and string.format("%d FPS", fps) or "-"
	self.bakeSummary.values.tracks.Text = trackCountText(effectMode, take)
	refs.preview.Visible = true
	refs.preview.Position = UDim2.fromOffset(0, 188)
	refs.preview.Size = UDim2.new(0.66, -6, 0, 46)
	setButtonSurface(refs.preview, self.theme.button, self.theme.text)
	refs.preview.Font = Enum.Font.GothamBold
	refs.preview.TextSize = 13
	refs.preview.TextColor3 = WHITE
	refs.previewSpeed.Visible = true
	refs.previewSpeed.Position = UDim2.new(0.66, 6, 0, 188)
	refs.previewSpeed.Size = UDim2.new(0.34, -6, 0, 46)
	setOutlinedButton(refs.previewSpeed, self.theme, self.theme.border)
	refs.previewSpeed.Font = Enum.Font.GothamBold
	refs.previewSpeed.TextSize = 13
	refs.previewSpeed.TextColor3 = WHITE
	refs.import.Position = UDim2.fromOffset(0, 246)
	refs.import.Size = UDim2.new(1, 0, 0, 56)
	setPrimaryButton(refs.import, effect.buttonAccent or effect.accent)
	refs.import.Font = Enum.Font.GothamBold
	refs.import.TextSize = 20
	refs.import.TextColor3 = WHITE
	refs.import.TextTransparency = 0
	setNextAction(refs.import, effect.buttonAccent or effect.accent, take ~= nil)
	refs.retake.Position = UDim2.fromOffset(0, 314)
	refs.retake.Size = UDim2.new(1, 0, 0, 28)
	refs.retake.BackgroundTransparency = 1
	refs.retake.TextColor3 = effect.accent
	refs.retake.Text = "Retake simulation"
	refs.retake.Visible = true
	refs.retake.Font = Enum.Font.GothamBold
	refs.retake.TextSize = 13
	refs.retake.TextColor3 = WHITE
	refs.reset.Visible = false
	refs.continueBake.Visible = false
	refs.push.Visible = false
	refs.stageContent.CanvasPosition = Vector2.new(0, 0)
	refs.stageContent.CanvasSize = UDim2.fromOffset(0, 350)
end

function EffectSetupPresentation:Update(
	effectMode,
	movingObjectMode,
	uiStage,
	setupPage,
	advancedVisible,
	ready,
	take,
	maxDuration,
	releaseObject,
	releaseData,
	releaseCollisionsEnabled,
	startingPushTested,
	eventTested
)
	local refs = self.refs
	local effect = EFFECTS[effectMode] or EFFECTS.Drop
	local prepareVisible = uiStage == "Setup" and setupPage == "Prepare"
	local captureVisible = uiStage == "Capture"
	local bakeVisible = uiStage == "Bake"
	refs.advancedToggle.Visible = false
	refs.advancedPanel.Visible = false
	refs.fps30.Visible = captureVisible
	refs.fps60.Visible = captureVisible

	clearNextActions({
		refs.selectButton,
		refs.driverButton,
		refs.riderButton,
		refs.loadPath,
		refs.eventSource,
		refs.eventVFX,
		refs.projectileStart,
		refs.projectileEnd,
		refs.startingPush,
		refs.eventTest,
		refs.eventAdd,
		refs.setupContinue,
		refs.run,
		refs.continueBake,
		refs.import,
	})
	self:_updateHeader(effect, uiStage, setupPage)
	self:_updateStageNavigation(effect, uiStage)
	self.captureGuide.frame.Visible = captureVisible
	self.captureInfo.frame.Visible = captureVisible
	if refs.status then
		refs.status.Visible = true
	end
	if not captureVisible then
		self.durationPopup.frame.Visible = false
	end

	if refs.openQuick then
		refs.openQuick.Visible = prepareVisible
		refs.openQuick.Text = ""
		refs.openQuick.Position = UDim2.fromOffset(18, 16)
		refs.openQuick.Size = UDim2.fromOffset(32, 32)
		refs.openQuick.BackgroundTransparency = 1
		refs.openQuick.TextColor3 = self.theme.muted
		refs.openQuick.Font = Enum.Font.GothamMedium
		refs.openQuick.TextSize = 26
		if not self.backArrow then
			self.backArrow = make("ImageLabel", {
				Name = "BackArrowImage",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = BACK_ARROW_IMAGE,
				ImageColor3 = self.theme.muted,
				Position = UDim2.fromScale(0.5, 0.5),
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromOffset(22, 22),
			}, refs.openQuick)
		end
		self.backArrow.Visible = prepareVisible
		self.backArrow.ImageColor3 = self.theme.muted
		local stroke = refs.openQuick:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 1
		end
	end

	if prepareVisible then
		self.captureInfo.frame.Visible = false
		self:_updateSetup(
			effect,
			effectMode,
			movingObjectMode,
			advancedVisible,
			ready,
			releaseObject,
			releaseData,
			releaseCollisionsEnabled,
			startingPushTested,
			eventTested
		)
	elseif captureVisible then
		self:_updateCapture(effectMode, effect, ready, maxDuration, take, releaseObject, releaseData)
	elseif bakeVisible then
		self:_updateBake(effectMode, effect, take)
	end
	normalizeReadableText(refs.stageContent, self.theme)
	enforcePurpleButtonText(refs.stageContent)
end

return EffectSetupPresentation
