        <Properties>
          <string name="Name">ScreenEffectTrackService</string>
          <ProtectedString name="Source">local ScreenEffectTrackService = {}

ScreenEffectTrackService.TRACK_TYPE = "Screen Effect"
ScreenEffectTrackService.FADE_EFFECT = "Fade"

local EFFECT_ORDER = {
	"CameraFlash",
	"Letterbox",
	"Vignette",
	"FilmGrain",
	"Subtitle",
	"ColorWash",
	"DepthOfField",
	"Fade",
}

local FALLBACK_FONT_CHOICES = {
	"GothamSemibold",
	"GothamBold",
	"Gotham",
	"SourceSans",
	"SourceSansBold",
	"Cartoon",
	"Arcade",
	"Fantasy",
	"SciFi",
	"Code",
	"Bangers",
	"FredokaOne",
	"LuckiestGuy",
	"PatrickHand",
	"SpecialElite",
	"Kalam",
	"Oswald",
	"PermanentMarker",
	"Roboto",
	"RobotoMono",
}

local function getFontChoices()
	local ok, enumItems = pcall(function()
		return Enum.Font:GetEnumItems()
	end)
	if not ok or type(enumItems) ~= "table" then
		return FALLBACK_FONT_CHOICES
	end
	local names = {}
	for _, font in ipairs(enumItems) do
		table.insert(names, font.Name)
	end
	table.sort(names)
	return names
end

local TRANSITION_CHOICES = {
	"None",
	"Fade",
	"Popup",
	"Slide Bottom",
}

local FADE_PRESET_CHOICES = {
	"Fade Out",
	"Fade In",
	"Hold",
}

local EFFECT_DEFINITIONS = {
	CameraFlash = {
		id = "CameraFlash",
