		setStatus("Finish the current simulation before changing bounce.", THEME.yellow)
		return
	end
	if state.effectMode ~= "Drop" then
		return
	end
	state.bounceEnabled = not state.bounceEnabled
	setStatus(
		state.bounceEnabled and "Extra bounce will be applied during the next simulation." or "Objects will use their normal physical properties.",
		state.bounceEnabled and THEME.yellow or THEME.muted
	)
