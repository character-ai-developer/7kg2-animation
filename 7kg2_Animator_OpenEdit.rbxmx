      <Item class="ModuleScript" referent="RBX185">
        <Properties>
          <string name="Name">PerformanceDebugService</string>
          <ProtectedString name="Source">local PerformanceDebugService = {}

local enabled = false
local statsByLabel = {}
local recentEvents = {}
local sessionStartedAt = os.clock()
local maxRecentEvents = 16
local recentStatWindowSeconds = 8

local function ensureStat(label)
	local key = tostring(label or "Unknown")
	local stat = statsByLabel[key]
	if stat then
		return stat
	end

	stat = {
		label = key,
		count = 0,
		totalMs = 0,
		lastMs = 0,
		maxMs = 0,
		lastExtra = nil,
		lastAt = 0,
	}
	statsByLabel[key] = stat
	return stat
end

local function trimRecentEvents()
	while #recentEvents &gt; maxRecentEvents do
		table.remove(recentEvents, 1)
	end
end

function PerformanceDebugService.isEnabled()
	return enabled
end

function PerformanceDebugService.setEnabled(nextEnabled)
	enabled = nextEnabled == true
	return enabled
end

function PerformanceDebugService.toggle()
	enabled = not enabled
	return enabled
end

function PerformanceDebugService.reset()
	statsByLabel = {}
	recentEvents = {}
	sessionStartedAt = os.clock()
end

function PerformanceDebugService.begin(label)
	if not enabled then
		return nil
	end

	return {
		label = tostring(label or "Unknown"),
		startedAt = os.clock(),
	}
end

function PerformanceDebugService.finish(token, extra)
	if not token then
		return nil
	end

	local elapsedMs = math.max(0, (os.clock() - (token.startedAt or os.clock())) * 1000)
	local stat = ensureStat(token.label)
	stat.count += 1
	stat.totalMs += elapsedMs
	stat.lastMs = elapsedMs
	stat.maxMs = math.max(stat.maxMs, elapsedMs)
	stat.lastAt = os.clock()
	stat.lastExtra = extra

	table.insert(recentEvents, {
		label = token.label,
		durationMs = elapsedMs,
		extra = extra,
		at = stat.lastAt,
	})
	trimRecentEvents()
	return elapsedMs
end

function PerformanceDebugService.measure(label, callback, extra)
	local token = PerformanceDebugService.begin(label)
	local results = table.pack(pcall(callback))
	PerformanceDebugService.finish(token, extra)
	if not results[1] then
		error(results[2], 0)
	end
	return table.unpack(results, 2, results.n)
end

local function sortedStats(recentOnly)
	local stats = {}
	local now = os.clock()
	for _, stat in pairs(statsByLabel) do
		if not recentOnly or (now - (stat.lastAt or 0)) &lt;= recentStatWindowSeconds then
			table.insert(stats, stat)
		end
	end
	table.sort(stats, function(a, b)
		if a.lastMs == b.lastMs then
			return a.label &lt; b.label
		end
		return a.lastMs &gt; b.lastMs
	end)
	return stats
end

function PerformanceDebugService.getViewModel(snapshot)
	if not enabled then
		return {
			enabled = false,
			title = "Performance Debug: Off",
			summary = "Use Tools &gt; Performance Debug to measure UI refreshes, timeline rendering, and Motion Builder timings.",
			details = "",
		}
	end

	local stats = sortedStats(true)
	local summaryParts = {}
	local detailLines = {}
	local topCount = math.min(#stats, 4)
	local now = os.clock()
	for index = 1, topCount do
		local stat = stats[index]
		local averageMs = stat.count &gt; 0 and (stat.totalMs / stat.count) or 0
		table.insert(summaryParts, string.format("%s %.1fms", stat.label, stat.lastMs))
		table.insert(
			detailLines,
			string.format("%s  last %.1fms  avg %.1fms  max %.1fms  %.1fs ago  x%d", stat.label, stat.lastMs, averageMs, stat.maxMs, now - (stat.lastAt or now), stat.count)
		)
	end

	local snapshotParts = {}
	snapshot = snapshot or {}
	if snapshot.trackCount ~= nil then
		table.insert(snapshotParts, string.format("%d tracks", tonumber(snapshot.trackCount) or 0))
	end
	if snapshot.keyframeCount ~= nil then
		table.insert(snapshotParts, string.format("%d keys", tonumber(snapshot.keyframeCount) or 0))
	end
	if snapshot.markerCount ~= nil then
		table.insert(snapshotParts, string.format("%d markers", tonumber(snapshot.markerCount) or 0))
	end
	if snapshot.isPlaying ~= nil then
		table.insert(snapshotParts, snapshot.isPlaying and "Playback on" or "Playback off")
	end
	if snapshot.isMotionPreviewing ~= nil then
		table.insert(snapshotParts, snapshot.isMotionPreviewing and "Preview on" or "Preview off")
	end
	if snapshot.buildId then
		table.insert(snapshotParts, "Build " .. tostring(snapshot.buildId))
	end

	local uptimeSeconds = math.max(0, os.clock() - sessionStartedAt)
	local uptimeText = uptimeSeconds &gt;= 60
		and string.format("%.1fm", uptimeSeconds / 60)
		or string.format("%.0fs", uptimeSeconds)
	local header = string.format("Performance Debug: On  (%s)", uptimeText)
	local summary = #summaryParts &gt; 0
		and table.concat(summaryParts, "   ")
		or "No recent measured actions. Scrub, bake, play, or edit to gather fresh timings."
	if #snapshotParts &gt; 0 then
		summary = summary .. "\n" .. table.concat(snapshotParts, "   ")
	end

	return {
		enabled = true,
		title = header,
		summary = summary,
		details = table.concat(detailLines, "\n"),
		recentEvents = recentEvents,
	}
end

return PerformanceDebugService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX186">
        <Properties>
          <string name="Name">PersistentTrackballRearmSupport</string>
          <ProtectedString name="Source">local PersistentTrackballRearmSupport = {}

function PersistentTrackballRearmSupport.copySelection(timeline, selection)
	if type(selection) ~= "table" then
		return nil
	end

	local frame = tonumber(selection.frame)
	if frame == nil and timeline and type(timeline.getCurrentFrame) == "function" then
		frame = timeline:getCurrentFrame()
	end

	local paths = {}
	local seen = {}
	local function addPath(path)
		if type(path) ~= "string" or seen[path] then
			return
		end
		if timeline and type(timeline.getTrackByPath) == "function" and not timeline:getTrackByPath(path) then
			return
		end
		seen[path] = true
		table.insert(paths, path)
	end

	if type(selection.paths) == "table" then
		for _, path in ipairs(selection.paths) do
			addPath(path)
		end
	else
		addPath(selection.path)
	end

	if #paths &gt; 1 then
		return {
			paths = paths,
			frame = frame,
		}
	elseif #paths == 1 then
		return {
			path = paths[1],
			frame = frame,
		}
	end
	return nil
end

function PersistentTrackballRearmSupport.fromResult(timeline, result)
	if type(result) ~= "table" then
		return nil
	end

	local frame = tonumber(result.frame)
	if type(result.keys) == "table" and #result.keys &gt; 0 then
		local paths = {}
		local seen = {}
		for _, key in ipairs(result.keys) do
			local path = key and key.jointPath
			if type(path) == "string" and not seen[path] then
				seen[path] = true
				table.insert(paths, path)
				frame = frame or tonumber(key.frame)
			end
		end
		return PersistentTrackballRearmSupport.copySelection(timeline, {
			paths = paths,
			frame = frame,
		})
	end

	if type(result.path) == "string" then
		return PersistentTrackballRearmSupport.copySelection(timeline, {
			path = result.path,
			frame = frame,
		})
	end
	return nil
end

return PersistentTrackballRearmSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX187">
        <Properties>
          <string name="Name">PersistentTrackballSelectionSupport</string>
          <ProtectedString name="Source">local PersistentTrackballSelectionSupport = {}

function PersistentTrackballSelectionSupport.buildSelection(path, timeline, selectedPaths)
	local selection = {
		path = path,
		frame = timeline:getCurrentFrame(),
	}

	if #selectedPaths &gt; 1 then
		local rigPaths = {}
		for _, selectedPath in ipairs(selectedPaths) do
			if timeline:getMotorByPath(selectedPath) then
				table.insert(rigPaths, selectedPath)
			end
		end
		if #rigPaths &gt; 1 then
			selection = {
				paths = rigPaths,
				frame = timeline:getCurrentFrame(),
			}
		end
	end

	return selection
end

function PersistentTrackballSelectionSupport.matchesCurrentTarget(trackballTool, selection, path)
	local targetPaths = {}
	if type(trackballTool.GetTargetPaths) == "function" then
		targetPaths = trackballTool:GetTargetPaths() or {}
	end

	if selection.paths and #targetPaths == #selection.paths then
		local matches = true
		for index, selectedPath in ipairs(selection.paths) do
			if targetPaths[index] ~= selectedPath then
				matches = false
				break
			end
		end
		if matches then
			return true
		end
	elseif not selection.paths and #targetPaths == 1 and targetPaths[1] == path then
		return true
	end

	return false
end

return PersistentTrackballSelectionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX188">
        <Properties>
          <string name="Name">PhysicsAdaptiveWalkExportSupport</string>
          <ProtectedString name="Source">local ImportService = require(script.Parent:WaitForChild("ImportService"))
local MotionClipService = require(script.Parent:WaitForChild("MotionClipService"))
local MotionService = require(script.Parent:WaitForChild("MotionService"))
local PhysicsAnimatedPathExportSupport = require(script.Parent:WaitForChild("PhysicsAnimatedPathExportSupport"))

local PhysicsAdaptiveWalkExportSupport = {}

local function getBasePose(timeline, rig)
	local basePose = {}
	local originalByName = {}
	for _, motorData in ipairs(timeline:getMotors()) do
		local motor = motorData and motorData.instance
		if motorData.rigName == rig.Name and motor and motor.Parent and motor:IsA("Motor6D") then
			local original = timeline:getOriginalPose(motorData.path)
			local originalC0 = typeof(original) == "CFrame" and original or motor.C0
			basePose[motor] = originalC0
			originalByName[motor.Name] = originalC0
			if motor.Part1 then
				originalByName[motor.Part1.Name] = originalC0
			end
		end
	end
	return basePose, originalByName
end

local function getWalkEntry(rig, presetId)
	local rigType = MotionClipService.getRigTypeName(rig)
	if not rigType then
		return nil, nil, "7kg2 could not identify whether the selected rig is R6 or R15."
	end
	local entry = ImportService.findPresetEntryById(presetId, "Walk", rigType)
	if not entry then
		return nil, rigType, "Choose a Walk Style that is compatible with the selected rig."
	end
	return entry, rigType, nil
end

function PhysicsAdaptiveWalkExportSupport.listPresets(rig)
	local rigType = MotionClipService.getRigTypeName(rig)
	if not rigType then
		return nil, nil, "7kg2 could not identify whether the selected rig is R6 or R15."
	end
	local byMotion = MotionClipService.buildClipOptionsByMotion(ImportService, rigType, nil)
	return byMotion.Walk or {}, rigType, nil
end

function PhysicsAdaptiveWalkExportSupport.build(timeline, rig, presetId)
	local entry, rigType, entryMessage = getWalkEntry(rig, presetId)
	if not entry then
		return nil, entryMessage
	end

	local loaded, clipDataOrMessage = MotionClipService.loadPresetClip(
		ImportService,
		entry,
		rigType,
		tostring(entry.name or "walk preset")
	)
	if not loaded then
		return nil, clipDataOrMessage
	end

	local basePose, originalByName = getBasePose(timeline, rig)
	local sampler, samplerMessage = MotionService.createClipPoseSampler(rig, clipDataOrMessage, basePose)
	if not sampler then
		return nil, samplerMessage
	end

	local pathData, pathMessage = PhysicsAnimatedPathExportSupport.build(timeline, rig, {
		pathMode = "DrivenImpact",
		fullRootRange = true,
		rootTrackOnly = true,
	})
	if not pathData then
		return nil, pathMessage
	end

	for sampleIndex, sample in ipairs(pathData.samples or {}) do
		local sampleTime = tonumber(sample.time)
			or ((sampleIndex - 1) / math.max(1, tonumber(pathData.fps) or 30))
		local presetPose = sampler.sample(sampleTime)
		local jointValues = {}
		for motorIndex, motorDefinition in ipairs(pathData.motors or {}) do
			local value = presetPose[motorDefinition.part1] or presetPose[motorDefinition.name]
			if typeof(value) ~= "CFrame" then
				value = originalByName[motorDefinition.part1] or originalByName[motorDefinition.name]
			end
			jointValues[motorIndex] = typeof(value) == "CFrame" and value or CFrame.identity
		end
		sample.joints = jointValues
	end

	local neutralJoints = {}
	for motorIndex, motorDefinition in ipairs(pathData.motors or {}) do
		local value = originalByName[motorDefinition.part1] or originalByName[motorDefinition.name]
		neutralJoints[motorIndex] = typeof(value) == "CFrame" and value or CFrame.identity
	end

	pathData.mode = "AdaptiveWalk"
	pathData.neutralJoints = neutralJoints
	pathData.walkPresetId = tostring(entry.id or entry.numericId or presetId)
	pathData.walkPresetName = tostring(entry.name or "Walk")
	pathData.walkRigType = rigType
	pathData.walkCycleDuration = sampler.duration
	pathData.walkTimingMode = "Timeline"
	return pathData, string.format(
		"Loaded %s at its original cadence across the full %.2fs CFrame route. Terrain correction will be applied during capture.",
		pathData.walkPresetName,
		pathData.duration or 0
	)
end

return PhysicsAdaptiveWalkExportSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX189">
        <Properties>
          <string name="Name">PhysicsAnimatedPathExportSupport</string>
          <ProtectedString name="Source">local PhysicsAnimatedPathExportSupport = {}

local function calculateAngularVelocity(previousCFrame, currentCFrame, deltaTime)
	local previousRotation = previousCFrame - previousCFrame.Position
	local currentRotation = currentCFrame - currentCFrame.Position
	local relative = previousRotation:ToObjectSpace(currentRotation)
	local axis, angle = relative:ToAxisAngle()
	if math.abs(angle) &lt;= 0.00001 or deltaTime &lt;= 0 then
		return Vector3.zero
	end
	return previousCFrame:VectorToWorldSpace(axis) * (angle / deltaTime)
end

local function getMotorDefinitions(timeline, rigName)
	local definitions = {}
	for _, motorData in ipairs(timeline:getMotors()) do
		local motor = motorData and motorData.instance
		if motorData.rigName == rigName and motor and motor.Parent and motor:IsA("Motor6D") then
			table.insert(definitions, {
				name = motor.Name,
				part0 = motor.Part0 and motor.Part0.Name or motorData.part0,
				part1 = motor.Part1 and motor.Part1.Name or motorData.part1,
				path = motorData.path,
				original = timeline:getOriginalPose(motorData.path),
			})
		end
	end
	return definitions
end

local function getDrivenEndFrame(timeline, rigName, startFrame, rootFrames)
	local endFrame = nil
	for _, frame in ipairs(rootFrames or {}) do
		if frame &gt; startFrame then
			endFrame = math.max(endFrame or frame, frame)
		end
	end
	for _, motorData in ipairs(timeline:getMotors()) do
		if motorData and motorData.rigName == rigName and motorData.path then
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(motorData.path)) do
				if frame &gt; startFrame then
					endFrame = math.max(endFrame or frame, frame)
				end
			end
		end
	end
	return endFrame
end

function PhysicsAnimatedPathExportSupport.build(timeline, rig, options)
	if not (timeline and rig and rig.Parent) then
		return nil, "Add the rig to 7kg2 before loading its animated path."
	end
	options = options or {}
	local drivenImpact = options.pathMode == "DrivenImpact"

	local rootTrack = timeline:getRigPropertyTrack(rig.Name, "CFrame")
	if not rootTrack then
		return nil, "The selected rig does not have a CFrame path track."
	end
	local currentFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or 0))
	local rootFrames = timeline:getTrackKeyframeFrames(rootTrack.path)
	local startFrame = nil
	local endFrame = nil
	if options.fullRootRange == true then
		startFrame = rootFrames[1]
		endFrame = rootFrames[#rootFrames]
		if startFrame == nil or endFrame == nil or endFrame &lt;= startFrame then
			return nil, "Add at least two rig CFrame keys to define the full movement path."
		end
	elseif drivenImpact then
		startFrame = currentFrame
		if options.rootTrackOnly == true then
			for _, frame in ipairs(rootFrames) do
				if frame &gt; startFrame then
					endFrame = math.max(endFrame or frame, frame)
				end
			end
		else
			endFrame = getDrivenEndFrame(timeline, rig.Name, startFrame, rootFrames)
		end
		if endFrame == nil then
			return nil, "Place the playhead before the final rig CFrame key to load a Driven Impact path."
		end
	else
		endFrame = currentFrame
		for _, frame in ipairs(rootFrames) do
			if frame &lt;= endFrame then
				startFrame = startFrame or frame
			else
				break
			end
		end
		if startFrame == nil or endFrame &lt;= startFrame then
			return nil, "Add at least two rig CFrame keys, then place the playhead at the physics handoff frame."
		end
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 30)
	local motorDefinitions = getMotorDefinitions(timeline, rig.Name)
	local samples = {}
	for frame = startFrame, endFrame do
		local pose = timeline:samplePose(frame) or {}
		local rootCFrame = pose[rootTrack.path]
		if typeof(rootCFrame) ~= "CFrame" then
			rootCFrame = rootTrack.originalValue
		end
		if typeof(rootCFrame) ~= "CFrame" then
			return nil, "7kg2 could not sample the rig CFrame path at the requested frames."
		end

		local jointValues = {}
		for index, definition in ipairs(motorDefinitions) do
			local value = pose[definition.path]
			if typeof(value) ~= "CFrame" then
				value = definition.original
			end
			jointValues[index] = typeof(value) == "CFrame" and value or CFrame.identity
		end
		table.insert(samples, {
			time = (frame - startFrame) / fps,
			rootCFrame = rootCFrame,
			joints = jointValues,
		})
	end

	local previous = samples[#samples - 1]
	local final = samples[#samples]
	local deltaTime = 1 / fps
	local linearVelocity = (final.rootCFrame.Position - previous.rootCFrame.Position) / deltaTime
	local angularVelocity = calculateAngularVelocity(previous.rootCFrame, final.rootCFrame, deltaTime)
	if not drivenImpact and linearVelocity.Magnitude &lt;= 0.01 and angularVelocity.Magnitude &lt;= 0.01 then
		return nil, "The final path frames are stationary. Move the rig through the handoff frame so physics receives a direction and speed."
	end

	for _, definition in ipairs(motorDefinitions) do
		definition.path = nil
		definition.original = nil
	end
	local mode = drivenImpact and "DrivenImpact" or "Handoff"
	local importFrame = (drivenImpact or options.fullRootRange == true) and startFrame or endFrame
	local pathData = {
		rigName = rig.Name,
		mode = mode,
		fps = fps,
		startFrame = startFrame,
		endFrame = endFrame,
		handoffFrame = endFrame,
		importFrame = importFrame,
		duration = (endFrame - startFrame) / fps,
		motors = motorDefinitions,
		samples = samples,
		linearVelocity = linearVelocity,
		angularVelocity = angularVelocity,
	}
	if drivenImpact then
		return pathData, string.format(
			"Loaded %.2fs Driven Impact path from frame %d to %d. Physics objects react during the authored motion.",
			(endFrame - startFrame) / fps,
			startFrame,
			endFrame
		)
	end
	return pathData, string.format("Loaded %.2fs animated path. Physics begins at frame %d.", (endFrame - startFrame) / fps, endFrame)
end

return PhysicsAnimatedPathExportSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX190">
        <Properties>
          <string name="Name">PhysicsCaptureBridgeService</string>
          <ProtectedString name="Source">local PhysicsCaptureBridgeService = {}

local REQUEST_EVENT_NAME = "MegMoPhysicsCaptureImportTake"
local RESULT_EVENT_NAME = "MegMoPhysicsCaptureImportResult"
local REACTION_REQUEST_EVENT_NAME = "MegMoPhysicsReactionRequest"
local REACTION_RESULT_EVENT_NAME = "MegMoPhysicsReactionResult"

local function getBridgeEvent(parent, name)
	if not parent then
		return nil
	end
	local event = parent:FindFirstChild(name)
	if event and event:IsA("BindableEvent") then
		event.Archivable = false
		return event
	end
	if event then
		event:Destroy()
	end
	event = Instance.new("BindableEvent")
	event.Name = name
	event.Archivable = false
	event.Parent = parent
	return event
end

local function sendResult(resultEvent, payload, success, message, extra)
	if resultEvent then
		local result = {
			source = "MegMoAnimator",
			requestId = payload and payload.requestId or nil,
			success = success == true,
			message = tostring(message or (success and "Physics take imported." or "Physics take could not be imported.")),
		}
		for key, value in pairs(extra or {}) do
			result[key] = value
		end
		resultEvent:Fire(result)
	end
end

local function findMatchingRig(timeline, payload)
	local rigName = payload and payload.rigName
	if type(rigName) ~= "string" or rigName == "" then
		return nil
	end
	local rig = timeline:getRigByName(rigName)
	if not rig then
		return nil
	end
	if payload.rig and payload.rig.Parent and payload.rig ~= rig then
		return nil
	end
	return rig
end

local function isPhysicsSequence(sequence)
	return sequence
		and sequence:IsA("KeyframeSequence")
		and sequence:GetAttribute("MegMoPhysicsCapture") == true
end

local function ensureCapturedRigs(timeline, args, entries)
	local missingRigs = {}
	local seen = {}
	for _, entry in ipairs(entries or {}) do
		if not findMatchingRig(timeline, entry) then
			local rig = entry and entry.rig
			if not (rig and rig.Parent) then
				return false, string.format(
					"Captured rig '%s' is no longer available in Workspace.",
					tostring(entry and entry.rigName or "Unknown")
				)
			end
			if not seen[rig] then
				seen[rig] = true
				table.insert(missingRigs, rig)
			end
		end
	end
	if #missingRigs == 0 then
		return true
	end
	if type(args.ensureRigsOnTimeline) ~= "function" then
		return false, "Add the captured rig to the 7kg2 timeline, then try the import again."
	end
	local success, message = args.ensureRigsOnTimeline(missingRigs)
	if not success then
		return false, message or "7kg2 could not add the captured rig to the timeline."
	end
	for _, entry in ipairs(entries or {}) do
		if not findMatchingRig(timeline, entry) then
			return false, string.format(
				"7kg2 added captured rig '%s', but could not match its timeline tracks.",
				tostring(entry and entry.rigName or "Unknown")
			)
		end
	end
	return true, message
end

function PhysicsCaptureBridgeService.attach(args)
	args = args or {}
	local timeline = args.timeline
	if not (timeline and type(args.importKeyframeSequence) == "function") then
		return nil
	end

	if PhysicsCaptureBridgeService._connection then
		PhysicsCaptureBridgeService._connection:Disconnect()
		PhysicsCaptureBridgeService._connection = nil
	end
	if PhysicsCaptureBridgeService._reactionConnection then
		PhysicsCaptureBridgeService._reactionConnection:Disconnect()
		PhysicsCaptureBridgeService._reactionConnection = nil
	end

	local requestEvent = getBridgeEvent(args.eventParent, REQUEST_EVENT_NAME)
	local resultEvent = getBridgeEvent(args.eventParent, RESULT_EVENT_NAME)
	if not requestEvent then
		return nil
	end
	requestEvent:SetAttribute("MegMoBridgeReady", true)

	PhysicsCaptureBridgeService._connection = requestEvent.Event:Connect(function(payload)
		if type(payload) ~= "table" or payload.source ~= "MegMoPhysicsCapturePrototype" then
			return
		end
		if payload.action == "SetPhysicsPreviewFrame" then
			local frame = tonumber(payload.frame)
			if not frame then
				sendResult(resultEvent, payload, false, "The physics preview did not provide a valid timeline frame.", {
					action = "SetPhysicsPreviewFrame",
				})
				return
			end
			frame = math.clamp(math.floor(frame + 0.5), 0, timeline:getDurationFrames())
			timeline:setCurrentFrame(frame)
			local applied, applyError = pcall(function()
				timeline:applyCurrentFrame()
			end)
			if not applied then
				sendResult(resultEvent, payload, false, "7kg2 could not evaluate the physics preview frame: " .. tostring(applyError), {
					action = "SetPhysicsPreviewFrame",
					frame = frame,
				})
				return
			end
			if type(args.refreshSelectedGizmo) == "function" then
				args.refreshSelectedGizmo()
			end
			if type(args.refreshUi) == "function" then
				args.refreshUi(string.format("Physics preview finished at frame %d.", frame))
			end
			if type(args.refreshMicroWorkspace) == "function" then
				args.refreshMicroWorkspace()
			end
			sendResult(resultEvent, payload, true, string.format("7kg2 moved to physics preview frame %d.", frame), {
				action = "SetPhysicsPreviewFrame",
				frame = frame,
			})
			return
		end

		if payload.action == "LoadAnimatedPath" then
			local rig = findMatchingRig(timeline, payload)
			if not rig then
				sendResult(resultEvent, payload, false, "Add the selected rig to the 7kg2 timeline before loading its path.", {
					action = "LoadAnimatedPath",
				})
				return
			end
			local buildSucceeded, pathData, message = pcall(function()
				return require(script.Parent:WaitForChild("PhysicsAnimatedPathExportSupport")).build(timeline, rig, {
					pathMode = payload.pathMode,
				})
			end)
			if not buildSucceeded then
				sendResult(resultEvent, payload, false, "7kg2 could not build the rig path: " .. tostring(pathData), {
					action = "LoadAnimatedPath",
				})
				return
			end
			sendResult(resultEvent, payload, pathData ~= nil, message, {
				action = "LoadAnimatedPath",
				pathData = pathData,
			})
			return
		end
		if payload.action == "GetAdaptiveWalkPresets" then
			local rig = findMatchingRig(timeline, payload)
			if not rig then
				sendResult(resultEvent, payload, false, "Add the selected rig to the 7kg2 timeline before choosing a Walk Style.", {
					action = "GetAdaptiveWalkPresets",
				})
				return
			end
			local succeeded, presets, rigType, message = pcall(function()
				return require(script.Parent:WaitForChild("PhysicsAdaptiveWalkExportSupport")).listPresets(rig)
			end)
			if not succeeded then
				sendResult(resultEvent, payload, false, "7kg2 could not list the Walk Styles: " .. tostring(presets), {
					action = "GetAdaptiveWalkPresets",
				})
				return
			end
			sendResult(resultEvent, payload, presets ~= nil and #presets &gt; 0, message or string.format("Loaded %d %s Walk Styles.", #(presets or {}), rigType or "compatible"), {
				action = "GetAdaptiveWalkPresets",
				presets = presets,
				rigType = rigType,
			})
			return
		end
		if payload.action == "LoadAdaptiveWalkPath" then
			local rig = findMatchingRig(timeline, payload)
			if not rig then
				sendResult(resultEvent, payload, false, "Add the selected rig to the 7kg2 timeline before loading Adaptive Walk.", {
					action = "LoadAdaptiveWalkPath",
				})
				return
			end
			local succeeded, pathData, message = pcall(function()
				return require(script.Parent:WaitForChild("PhysicsAdaptiveWalkExportSupport")).build(timeline, rig, payload.presetId)
			end)
			if not succeeded then
				sendResult(resultEvent, payload, false, "7kg2 could not build the Adaptive Walk path: " .. tostring(pathData), {
					action = "LoadAdaptiveWalkPath",
				})
				return
			end
			sendResult(resultEvent, payload, pathData ~= nil, message, {
				action = "LoadAdaptiveWalkPath",
				pathData = pathData,
			})
			return
		end
		if payload.action == "LoadObjectPath" then
			local target = payload.driver
			local buildSucceeded, pathData, message = pcall(function()
				return require(script.Parent:WaitForChild("PhysicsObjectPathExportSupport")).build(timeline, target)
			end)
			if not buildSucceeded then
				sendResult(resultEvent, payload, false, "7kg2 could not build the Moving Object path: " .. tostring(pathData), {
					action = "LoadObjectPath",
				})
				return
			end
			sendResult(resultEvent, payload, pathData ~= nil, message, {
				action = "LoadObjectPath",
				pathData = pathData,
			})
			return
		end
		if payload.action == "LoadObjectRelease" then
			local target = payload.driver
			local buildSucceeded, releaseData, message = pcall(function()
				return require(script.Parent:WaitForChild("PhysicsObjectReleaseExportSupport")).build(timeline, target)
			end)
			if not buildSucceeded then
				sendResult(resultEvent, payload, false, "7kg2 could not build the release state: " .. tostring(releaseData), {
					action = "LoadObjectRelease",
				})
				return
			end
			sendResult(resultEvent, payload, releaseData ~= nil, message, {
				action = "LoadObjectRelease",
				releaseData = releaseData,
			})
			return
		end
		if payload.action == "ImportObjectTake" then
			local callSucceeded, success, message = pcall(
				args.importKeyframeSequence,
				nil,
				payload.sourceLabel or "Physics Objects",
				nil,
				payload.objects,
				payload.importFrame,
				payload.vfx
			)
			if not callSucceeded then
				sendResult(resultEvent, payload, false, "7kg2 could not import the object take: " .. tostring(success))
				return
			end
			if success and tonumber(payload.importFrame) then
				local importFrame = math.clamp(
					math.floor(tonumber(payload.importFrame) + 0.5),
					0,
					timeline:getDurationFrames()
				)
				timeline:setCurrentFrame(importFrame)
				timeline:applyCurrentFrame()
				if type(args.refreshSelectedGizmo) == "function" then
					args.refreshSelectedGizmo()
				end
				if type(args.refreshMicroWorkspace) == "function" then
					args.refreshMicroWorkspace()
				end
			end
			sendResult(resultEvent, payload, success, message)
			return
		end
		if payload.action == "ImportMultiRigTake" then
			local entries = payload.rigs
			if type(entries) ~= "table" or #entries &lt; 2 then
				sendResult(resultEvent, payload, false, "The multi-rig ragdoll capture did not contain at least two characters.", {
					action = "ImportMultiRigTake",
				})
				return
			end
			if payload.usesInternalRigIds == true then
				local importFrame = math.max(0, math.floor(tonumber(payload.importFrame) or tonumber(timeline:getCurrentFrame()) or 0))
				local callSucceeded, success, message = pcall(
					args.importKeyframeSequence,
					nil,
					payload.sourceLabel or "Ragdoll Capture",
					nil,
					payload.objects,
					importFrame,
					payload.vfx
				)
				if not callSucceeded or not success then
					sendResult(resultEvent, payload, false, string.format(
						"7kg2 could not import the internally identified ragdolls: %s",
						tostring(callSucceeded and message or success)
					), {
						action = "ImportMultiRigTake",
					})
					return
				end
				sendResult(resultEvent, payload, true, string.format(
					"Imported synchronized ragdoll captures for %d same-named characters at frame %d using hidden IDs.",
					#entries,
					importFrame
				), {
					action = "ImportMultiRigTake",
					importedCount = #entries,
				})
				return
			end
			for index, entry in ipairs(entries) do
				if not isPhysicsSequence(entry.sequence) then
					sendResult(resultEvent, payload, false, string.format("The ragdoll take for character %d was invalid.", index), {
						action = "ImportMultiRigTake",
					})
					return
				end
			end
			local rigsReady, rigMessage = ensureCapturedRigs(timeline, args, entries)
			if not rigsReady then
				sendResult(resultEvent, payload, false, rigMessage, {
					action = "ImportMultiRigTake",
				})
				return
			end
			local importFrame = math.max(0, math.floor(tonumber(payload.importFrame) or tonumber(timeline:getCurrentFrame()) or 0))
			local targetRigs = {}
			for index, entry in ipairs(entries) do
				local rig = findMatchingRig(timeline, entry)
				if not rig then
					sendResult(resultEvent, payload, false, string.format("Add captured rig '%s' to the 7kg2 timeline, then try again.", tostring(entry.rigName or index)), {
						action = "ImportMultiRigTake",
					})
					return
				end
				targetRigs[index] = rig
			end
			for index, entry in ipairs(entries) do
				local callSucceeded, success, message = pcall(
					args.importKeyframeSequence,
					entry.sequence,
					payload.sourceLabel or "Ragdoll Capture",
					targetRigs[index].Name,
					index == 1 and payload.objects or nil,
					importFrame,
					index == 1 and payload.vfx or nil,
					entry.take
				)
				if not callSucceeded or not success then
					sendResult(resultEvent, payload, false, string.format(
						"7kg2 could not import ragdoll take %d of %d: %s",
						index,
						#entries,
						tostring(callSucceeded and message or success)
					), {
						action = "ImportMultiRigTake",
						importedCount = index - 1,
					})
					return
				end
			end
			sendResult(resultEvent, payload, true, string.format(
				"Imported synchronized ragdoll captures for %d characters at frame %d.",
				#entries,
				importFrame
			), {
				action = "ImportMultiRigTake",
				importedCount = #entries,
			})
			return
		end

		local sequence = payload.sequence
		if not isPhysicsSequence(sequence) then
			sendResult(resultEvent, payload, false, "The physics prototype did not send a valid captured take.")
			return
		end

		local rigsReady, rigMessage = ensureCapturedRigs(timeline, args, { payload })
		if not rigsReady then
			sendResult(resultEvent, payload, false, rigMessage)
			return
		end
		local rig = findMatchingRig(timeline, payload)
		if not rig then
			sendResult(resultEvent, payload, false, "Add the same captured rig to the 7kg2 timeline, then try the import again.")
			return
		end

		local callSucceeded, success, message = pcall(
			args.importKeyframeSequence,
			sequence,
			payload.sourceLabel or "Physics Capture",
			rig.Name,
			payload.objects,
			payload.importFrame,
			payload.vfx,
			payload.take
		)
		if not callSucceeded then
			sendResult(resultEvent, payload, false, "7kg2 could not import the physics take: " .. tostring(success))
			return
		end
		sendResult(resultEvent, payload, success, message)
	end)

	local reactionRequestEvent = getBridgeEvent(args.eventParent, REACTION_REQUEST_EVENT_NAME)
	local reactionResultEvent = getBridgeEvent(args.eventParent, REACTION_RESULT_EVENT_NAME)
	if reactionRequestEvent then
		reactionRequestEvent:SetAttribute("MegMoBridgeReady", true)
		PhysicsCaptureBridgeService._reactionConnection = reactionRequestEvent.Event:Connect(function(payload)
			if type(payload) ~= "table" or payload.source ~= "MegMoPhysicsReactionPrototype" then
				return
			end
			if payload.action == "LoadActorPath" then
				local rig = findMatchingRig(timeline, payload)
				if not rig then
					sendResult(reactionResultEvent, payload, false, "Add the selected actor rig to the 7kg2 timeline before loading its path.", {
						action = "LoadActorPath",
					})
					return
				end
				local pathData, message = require(script.Parent:WaitForChild("PhysicsAnimatedPathExportSupport")).build(timeline, rig, {
					pathMode = "DrivenImpact",
				})
				sendResult(reactionResultEvent, payload, pathData ~= nil, message, {
					action = "LoadActorPath",
					pathData = pathData,
				})
				return
			end

			local sequence = payload.sequence
			if not (sequence and sequence:IsA("KeyframeSequence") and sequence:GetAttribute("MegMoPhysicsCapture") == true) then
				sendResult(reactionResultEvent, payload, false, "The reaction prototype did not send a valid captured take.")
				return
			end
			local rig = findMatchingRig(timeline, payload)
			if not rig then
				sendResult(reactionResultEvent, payload, false, "Add the reaction rig to the 7kg2 timeline before importing its take.")
				return
			end
			local callSucceeded, success, message = pcall(
				args.importKeyframeSequence,
				sequence,
				payload.sourceLabel or "Physics Reaction",
				rig.Name,
				nil,
				payload.importFrame
			)
			if not callSucceeded then
				sendResult(reactionResultEvent, payload, false, "7kg2 could not import the reaction take: " .. tostring(success))
				return
			end
			sendResult(reactionResultEvent, payload, success, message)
		end)
	end

	return requestEvent
end

return PhysicsCaptureBridgeService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX191">
        <Properties>
          <string name="Name">PhysicsCaptureImportSupport</string>
          <ProtectedString name="Source">local PhysicsCaptureImportSupport = {}

local PhysicsExplosionVFXImportSupport = require(script.Parent:WaitForChild("PhysicsExplosionVFXImportSupport"))
local PhysicsClipIntegritySupport = require(script.Parent:WaitForChild("PhysicsClipIntegritySupport"))
local PhysicsRuntimeClipSupport = require(script.Parent:WaitForChild("PhysicsRuntimeClipSupport"))

local CAPTURE_ATTRIBUTE = "MegMoPhysicsCapture"
local ROOT_CFRAME_ATTRIBUTE = "MegMoRootCFrame"
local CLIP_NAME_ATTRIBUTE = "MegMoPhysicsClipName"

local function makeKeyId(trackPath, frame)
	return tostring(trackPath) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

local function getPhysicsClipName(keyframeEditService, requestedName)
	local baseName = type(requestedName) == "string" and requestedName or ""
	baseName = string.gsub(baseName, "^%s+", "")
	baseName = string.gsub(baseName, "%s+$", "")
	if baseName == "" then
		baseName = "Physics Clip"
	end

	local count = 0
	for _, group in pairs(keyframeEditService and keyframeEditService:getGroups() or {}) do
		local groupName = tostring(group.name or "")
		if group.kind == "PhysicsClip"
			and (groupName == baseName or string.sub(groupName, 1, #baseName + 1) == baseName .. " ") then
			count += 1
		end
	end
	return count == 0 and baseName or string.format("%s %d", baseName, count + 1)
end

local function collectTimelineKeyIds(timeline)
	local keyIds = {}
	for _, track in ipairs(timeline and timeline:getTracks() or {}) do
		if type(track.path) == "string" then
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				keyIds[makeKeyId(track.path, frame)] = true
			end
		end
	end
	return keyIds
end

local function collectNewTimelineKeyRefs(timeline, existingKeyIds)
	local keyRefs = {}
	for _, track in ipairs(timeline and timeline:getTracks() or {}) do
		if type(track.path) == "string" then
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				if not existingKeyIds[makeKeyId(track.path, frame)] then
					keyRefs[#keyRefs + 1] = {
						jointPath = track.path,
						frame = frame,
					}
				end
			end
		end
	end
	table.sort(keyRefs, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return keyRefs
end

local function findObjectTrack(timeline, instance)
	for _, track in ipairs(timeline:getTracks()) do
		if track.instance == instance
			and track.targetScope == nil
			and (track.trackType == "Object" or track.trackType == "Model") then
			return track
		end
	end
	return nil
end

local function getImportFrameOffset(timeline, options)
	local frameOffset = tonumber(options and options.frameOffset)
	if frameOffset ~= nil then
		return math.max(0, math.floor(frameOffset + 0.5))
	end
	return math.max(0, (timeline:getLastKeyframe() or -1) + 1)
end

local function getTargetRigName(timeline, options)
	local rigName = options and options.rigName
	if type(rigName) == "string" and rigName ~= "" then
		return rigName
	end
	local rig = timeline:getRig()
	return rig and rig.Name or nil
end

local function importCapturedRootMotion(timeline, keyframeSequence, options)
	if keyframeSequence:GetAttribute(CAPTURE_ATTRIBUTE) ~= true then
		return 0, nil
	end

	local rigName = getTargetRigName(timeline, options)
	local rootTrack = rigName and timeline:getRigPropertyTrack(rigName, "CFrame") or nil
	if not rootTrack then
		return 0, "The joint poses were imported, but the matching rig CFrame track was not found."
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 30)
	local frameOffset = getImportFrameOffset(timeline, options)
	local importedCount = 0
	for _, keyframe in ipairs(keyframeSequence:GetKeyframes()) do
		local rootCFrame = keyframe:GetAttribute(ROOT_CFRAME_ATTRIBUTE)
		if typeof(rootCFrame) == "CFrame" then
			local localFrame = math.max(0, math.floor((tonumber(keyframe.Time) or 0) * fps + 0.5))
			local success = timeline:setTrackValueAtFrame(
				rootTrack.path,
				frameOffset + localFrame,
				rootCFrame,
				"Linear",
				"InOut"
			)
			if success then
				importedCount += 1
			end
		end
	end

	if importedCount == 0 then
		return 0, "The joint poses were imported, but this take did not contain usable root motion."
	end
	return importedCount, nil
end

local function importCapturedObjects(timeline, options)
	local entries = options and options.physicsObjects
	if type(entries) ~= "table" or #entries == 0 then
		return 0, 0, nil
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 30)
	local frameOffset = getImportFrameOffset(timeline, options)
	local folder = nil
	local importedTrackCount = 0
	local importedKeyCount = 0
	local importedKeyRefs = {}
	local importedKeyIds = {}
	local maxImportedFrame = nil
	local commonFolderPath = nil
	local hasMixedFolders = false
	local requestedClipName = options and options.clipName
	local runtimeTargets = {}
	for _, entry in ipairs(entries) do
		if requestedClipName == nil and type(entry and entry.clipName) == "string" then
			requestedClipName = entry.clipName
		end
		local instance = entry and entry.instance
		local samples = entry and entry.samples
		if instance and instance.Parent and (instance:IsA("BasePart") or instance:IsA("Model")) and type(samples) == "table" and #samples &gt; 0 then
			local objectTrack = findObjectTrack(timeline, instance)
			if not objectTrack then
				if not folder then
					folder = timeline:addGenericTrack("Folder", nil, "Physics Capture", {
						targetScope = "TimelineFolder",
						sortOrder = 2,
						defaultCollapsed = true,
					})
				end
				objectTrack = timeline:addGenericTrack(instance:IsA("Model") and "Model" or "Object", instance, entry.name or instance.Name, {
					folderPath = folder and folder.path or nil,
				})
				importedTrackCount += 1
			end
			local objectFolderPath = objectTrack.folderPath or (folder and folder.path) or nil
			if objectFolderPath then
				if commonFolderPath == nil then
					commonFolderPath = objectFolderPath
				elseif commonFolderPath ~= objectFolderPath then
					hasMixedFolders = true
				end
			end

			local cframeTrack = timeline:getObjectPropertyTrack(objectTrack.path, "CFrame")
			if not cframeTrack then
				cframeTrack = timeline:addGenericTrack("ObjectProperty", instance, "CFrame", {
					propertyName = "CFrame",
					targetScope = "ObjectProperty",
					parentTrackPath = objectTrack.path,
					parentTrackName = objectTrack.name,
					sortOrder = 1,
				})
			end
			if type(entry.runtimeSamples) == "table" and #entry.runtimeSamples &gt;= 2 then
				runtimeTargets[#runtimeTargets + 1] = {
					trackPath = cframeTrack.path,
					samples = entry.runtimeSamples,
				}
			end

			for _, sample in ipairs(samples) do
				if type(sample) == "table" and typeof(sample.value) == "CFrame" then
					local localFrame = math.max(0, math.floor((tonumber(sample.time) or 0) * fps + 0.5))
					local success = timeline:setTrackValueAtFrame(
						cframeTrack.path,
						frameOffset + localFrame,
						sample.value,
						"Linear",
						"InOut"
					)
					if success then
						importedKeyCount += 1
						local importedFrame = frameOffset + localFrame
						maxImportedFrame = maxImportedFrame and math.max(maxImportedFrame, importedFrame) or importedFrame
						local keyId = makeKeyId(cframeTrack.path, importedFrame)
						if not importedKeyIds[keyId] then
							importedKeyIds[keyId] = true
							importedKeyRefs[#importedKeyRefs + 1] = {
								jointPath = cframeTrack.path,
								frame = importedFrame,
							}
						end
					end
				end
			end
		end
	end
	if maxImportedFrame and maxImportedFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(maxImportedFrame)
	end
	return importedTrackCount, importedKeyCount, {
		keyRefs = importedKeyRefs,
		folderPath = not hasMixedFolders and commonFolderPath or nil,
		name = requestedClipName,
		runtimeCapture = PhysicsRuntimeClipSupport.SanitizeObjectCapture(runtimeTargets),
	}
end

function PhysicsCaptureImportSupport.createPhysicsClip(keyframeEditService, clipData, timeline)
	local keyRefs = clipData and clipData.keyRefs
	if not keyframeEditService or type(keyRefs) ~= "table" or #keyRefs &lt; 2 then
		return false, nil
	end

	local success, message, groupId = keyframeEditService:groupSelectedKeys(keyRefs)
	if not success then
		return false, message
	end
	local group = keyframeEditService:getGroups()[groupId]
	if not group then
		return false, "The physics keys were imported, but the Physics Clip could not be created."
	end

	local minFrame = nil
	local maxFrame = nil
	for _, keyRef in ipairs(keyRefs) do
		local frame = math.max(0, math.floor(tonumber(keyRef.frame) or 0))
		minFrame = minFrame and math.min(minFrame, frame) or frame
		maxFrame = maxFrame and math.max(maxFrame, frame) or frame
	end
	group.name = getPhysicsClipName(keyframeEditService, clipData.name)
	group.kind = "PhysicsClip"
	group.folderPath = clipData.folderPath
	group.mode = "Stretch"
	group.sourceSpanFrames = math.max(1, (maxFrame or 1) - (minFrame or 0))
	group.runtimeCapture = clipData.runtimeCapture
	group.runtimeKeyCount = nil
	group.runtimeKeySignature = nil
	group.runtimeCaptureValid = nil
	if group.runtimeCapture then
		PhysicsClipIntegritySupport.EstablishBaseline(group, timeline)
	end
	keyframeEditService:rebuildGroupMembership()
	return true, string.format("Created editable %s.", group.name), groupId
end

function PhysicsCaptureImportSupport.ensurePhysicsClips(timeline, keyframeEditService)
	if not timeline or not keyframeEditService then
		return 0, nil
	end

	local tracks = timeline:getTracks()
	local physicsFolders = {}
	local objectFolderByPath = {}
	for _, track in ipairs(tracks) do
		if track.targetScope == "TimelineFolder" and string.match(tostring(track.name or ""), "^Physics Capture") then
			physicsFolders[track.path] = true
		elseif (track.trackType == "Object" or track.trackType == "Model") and physicsFolders[track.folderPath] then
			objectFolderByPath[track.path] = track.folderPath
		end
	end
	-- Folder ordering is visual, so collect object parents again after all folders are known.
	for _, track in ipairs(tracks) do
		if (track.trackType == "Object" or track.trackType == "Model") and physicsFolders[track.folderPath] then
			objectFolderByPath[track.path] = track.folderPath
		end
	end

	local refsByFolder = {}
	local membership = keyframeEditService:getGroupMembership()
	for _, track in ipairs(tracks) do
		local folderPath = track.parentTrackPath and objectFolderByPath[track.parentTrackPath] or nil
		if folderPath
			and track.targetScope == "ObjectProperty"
			and (track.propertyName == "CFrame" or track.name == "CFrame") then
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				local keyId = makeKeyId(track.path, frame)
				if not membership[keyId] then
					refsByFolder[folderPath] = refsByFolder[folderPath] or {}
					refsByFolder[folderPath][#refsByFolder[folderPath] + 1] = {
						jointPath = track.path,
						frame = frame,
					}
				end
			end
		end
	end

	local createdCount = 0
	for folderPath, keyRefs in pairs(refsByFolder) do
		if #keyRefs &gt;= 2 then
			local success = PhysicsCaptureImportSupport.createPhysicsClip(keyframeEditService, {
				keyRefs = keyRefs,
				folderPath = folderPath,
			}, timeline)
			if success then
				createdCount += 1
			end
		end
	end
	return createdCount, createdCount &gt; 0
		and string.format("Restored %d editable Physics Clip%s.", createdCount, createdCount == 1 and "" or "s")
		or nil
end

function PhysicsCaptureImportSupport.importKeyframeSequence(timeline, keyframeSequence, options)
	local existingKeyIds = collectTimelineKeyIds(timeline)
	local success, message = timeline:importKeyframeSequence(keyframeSequence, options)
	if not success then
		return false, message
	end

	local rootKeyCount, warning = importCapturedRootMotion(timeline, keyframeSequence, options)
	if rootKeyCount &gt; 0 then
		message = string.format("%s Imported %d physics root keyframe%s.", message or "Imported physics take.", rootKeyCount, rootKeyCount == 1 and "" or "s")
	elseif warning then
		message = string.format("%s %s", message or "Imported physics take.", warning)
	end
	local objectTrackCount, objectKeyCount = importCapturedObjects(timeline, options)
	if objectKeyCount &gt; 0 then
		message = string.format(
			"%s Imported %d scene CFrame key%s across %d new object track%s.",
			message or "Imported physics take.",
			objectKeyCount,
			objectKeyCount == 1 and "" or "s",
			objectTrackCount,
			objectTrackCount == 1 and "" or "s"
		)
	end
	local _, vfxKeyCount, _, vfxMessage = PhysicsExplosionVFXImportSupport.Import(
		timeline,
		options and options.physicsVFX,
		options
	)
	if vfxKeyCount &gt; 0 then
		message = string.format("%s %s", message or "Imported physics take.", vfxMessage)
	end
	local physicsClip = {
		keyRefs = collectNewTimelineKeyRefs(timeline, existingKeyIds),
		name = keyframeSequence:GetAttribute(CLIP_NAME_ATTRIBUTE),
		runtimeCapture = PhysicsRuntimeClipSupport.SanitizeCapture(
			options and options.runtimeCapture,
			getTargetRigName(timeline, options)
		),
	}
	return true, message, physicsClip
end

function PhysicsCaptureImportSupport.importObjectCapture(timeline, entries, options)
	options = options or {}
	options.physicsObjects = entries
	local objectTrackCount, objectKeyCount, physicsClip = importCapturedObjects(timeline, options)
	local _, vfxKeyCount, vfxKeyRefs, vfxMessage = PhysicsExplosionVFXImportSupport.Import(
		timeline,
		options.physicsVFX,
		options
	)
	physicsClip = physicsClip or { keyRefs = {} }
	physicsClip.keyRefs = physicsClip.keyRefs or {}
	for _, keyRef in ipairs(vfxKeyRefs) do
		table.insert(physicsClip.keyRefs, keyRef)
	end
	if objectKeyCount == 0 and vfxKeyCount == 0 then
		return false, "The object capture did not contain any moving CFrame samples."
	end
	local message = objectKeyCount &gt; 0 and string.format(
		"Imported %d physics object CFrame key%s across %d new track%s.",
		objectKeyCount,
		objectKeyCount == 1 and "" or "s",
		objectTrackCount,
		objectTrackCount == 1 and "" or "s"
	) or "Imported Explosion VFX."
	if vfxMessage then
		message = string.format("%s %s", message, vfxMessage)
	end
	return true, message, physicsClip
end

return PhysicsCaptureImportSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX192">
        <Properties>
          <string name="Name">PhysicsClipClipboardSupport</string>
          <ProtectedString name="Source">local InstanceAddressSupport = require(script.Parent:WaitForChild("InstanceAddressSupport"))
local PhysicsCaptureImportSupport = require(script.Parent:WaitForChild("PhysicsCaptureImportSupport"))
local PhysicsClipIntegritySupport = require(script.Parent:WaitForChild("PhysicsClipIntegritySupport"))
local PhysicsRuntimeClipSupport = require(script.Parent:WaitForChild("PhysicsRuntimeClipSupport"))

local PhysicsClipClipboardSupport = {}

local function cloneValue(value, seen)
	if typeof(value) ~= "table" then
		return value
	end
	seen = seen or {}
	if seen[value] then
		return seen[value]
	end
	local copy = {}
	seen[value] = copy
	for key, child in pairs(value) do
		copy[cloneValue(key, seen)] = cloneValue(child, seen)
	end
	return copy
end

local function makeKeyId(path, frame)
	return tostring(path) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

local function decodeCFrame(value)
	if typeof(value) == "CFrame" then
		return value
	end
	if type(value) ~= "table" or #value &lt; 12 then
		return nil
	end
	local components = {}
	for index = 1, 12 do
		local component = tonumber(value[index])
		if not component then
			return nil
		end
		components[index] = component
	end
	return CFrame.new(table.unpack(components, 1, 12))
end

local function findSupportedRig(instance)
	local current = instance
	while current and current ~= workspace do
		if current:IsA("Model") then
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			local root = current:FindFirstChild("HumanoidRootPart", true)
			if humanoid and root and root:IsA("BasePart")
				and (humanoid.RigType == Enum.HumanoidRigType.R6 or humanoid.RigType == Enum.HumanoidRigType.R15) then
				return current, humanoid.RigType, root
			end
		end
		current = current.Parent
	end
	return nil, nil, nil
end

local function setCopiedGroupMetadata(keyframeEditService, groupId, clipboard, timeline)
	local group = keyframeEditService:getGroups()[groupId]
	if not group then
		return
	end
	group.mode = clipboard.mode == "Repeat" and "Repeat" or "Stretch"
	group.sourceSpanFrames = math.max(1, tonumber(clipboard.sourceSpanFrames) or 1)
	group.runtimeCapture = cloneValue(clipboard.runtimeCapture)
	group.runtimeKeyCount = nil
	group.runtimeKeySignature = nil
	group.runtimeCaptureValid = nil
	if group.runtimeCapture then
		PhysicsClipIntegritySupport.EstablishBaseline(group, timeline)
	end
	keyframeEditService:rebuildGroupMembership()
end

function PhysicsClipClipboardSupport.Capture(timeline, keyframeEditService, selectedKeyRefs, clipboardKeys)
	local groupIds = keyframeEditService:getGroupIdsForKeys(selectedKeyRefs or {})
	if #groupIds ~= 1 then
		return nil
	end
	local groupId = tonumber(groupIds[1]) or groupIds[1]
	local group = keyframeEditService:getGroups()[groupId]
	if not (group and group.kind == "PhysicsClip" and type(group.runtimeCapture) == "table") then
		return nil
	end
	if not PhysicsClipIntegritySupport.IsValid(group, timeline) then
		return nil
	end

	local selectedIds = {}
	for _, key in ipairs(selectedKeyRefs or {}) do
		selectedIds[makeKeyId(key.jointPath or key.path, key.frame)] = true
	end
	for keyId in pairs(group.keys or {}) do
		if not selectedIds[keyId] then
			return nil
		end
	end
	if PhysicsClipIntegritySupport.CountGroupKeys(group) ~= #selectedKeyRefs then
		return nil
	end

	local maxRelativeFrame = 1
	for _, key in ipairs(clipboardKeys or {}) do
		maxRelativeFrame = math.max(maxRelativeFrame, math.max(0, math.floor(tonumber(key.frame) or 0)))
	end
	return {
		name = tostring(group.name or "Physics Clip"),
		mode = group.mode,
		folderPath = group.folderPath,
		sourceSpanFrames = math.max(1, tonumber(group.sourceSpanFrames) or maxRelativeFrame),
		runtimeCapture = cloneValue(group.runtimeCapture),
		keys = cloneValue(clipboardKeys),
	}
end

local function findPasteCollision(timeline, keys, frameOffset)
	for _, key in ipairs(keys or {}) do
		local path = key.jointPath or key.path
		local frame = frameOffset + math.max(0, math.floor(tonumber(key.frame) or 0))
		if not (path and timeline:getTrackByPath(path)) then
			return "A source Physics track is no longer available. Copy the clip again."
		end
		if timeline:hasTrackKeyframe(path, frame) then
			return string.format("The Physics clip would overwrite existing keys at frame %d. Move the playhead and try again.", frame)
		end
	end
	return nil
end

function PhysicsClipClipboardSupport.PasteAtPlayhead(timeline, keyframeEditService, clipboard, frameOffset)
	if type(clipboard) ~= "table" or type(clipboard.runtimeCapture) ~= "table" then
		return false, "Copy an exact Physics Clip before pasting.", {}
	end
	frameOffset = math.max(0, math.floor(tonumber(frameOffset) or 0))
	local collision = findPasteCollision(timeline, clipboard.keys, frameOffset)
	if collision then
		return false, collision, {}
	end

	local success, message, pastedKeys = timeline:pasteTrackKeyframes(cloneValue(clipboard.keys), frameOffset)
	if not success then
		return false, message or "The Physics clip could not be pasted.", {}
	end
	local clipCreated, clipMessage, groupId = PhysicsCaptureImportSupport.createPhysicsClip(keyframeEditService, {
		keyRefs = pastedKeys,
		folderPath = clipboard.folderPath,
		name = clipboard.name,
		runtimeCapture = cloneValue(clipboard.runtimeCapture),
	}, timeline)
	if not clipCreated then
		timeline:deleteTrackKeyframes(pastedKeys)
		return false, clipMessage or "The pasted keys could not be rebuilt as an exact Physics Clip.", {}
	end
	setCopiedGroupMetadata(keyframeEditService, groupId, clipboard, timeline)
	return true, string.format("Pasted exact Physics Clip '%s' at frame %d.", clipboard.name, frameOffset), pastedKeys, groupId
end

local function collectSourceRigBuckets(timeline, clipboard)
	local capture = clipboard.runtimeCapture
	if type(capture) ~= "table" or capture.captureType ~= "Objects" then
		return nil, "Paste to Selected Rigs currently supports exact ragdoll object captures."
	end
	local visibleKeysByPath = {}
	for _, key in ipairs(clipboard.keys or {}) do
		local path = key.jointPath or key.path
		if path then
			visibleKeysByPath[path] = visibleKeysByPath[path] or {}
			table.insert(visibleKeysByPath[path], key)
		end
	end

	local buckets = {}
	local bucketByRig = {}
	for _, target in ipairs(capture.targets or {}) do
		local track = type(target.trackPath) == "string" and timeline:getTrackByPath(target.trackPath) or nil
		local part = track and track.instance
		local rig, rigType = findSupportedRig(part)
		if not (part and part:IsA("BasePart") and rig) then
			return nil, "This Physics Clip includes non-rig objects. Use Paste at Playhead for the complete clip."
		end
		local samples = {}
		for _, sample in ipairs(target.samples or {}) do
			local value = decodeCFrame(sample.value)
			if value then
				samples[#samples + 1] = {
					time = math.max(0, tonumber(sample.time) or 0),
					value = value,
				}
			end
		end
		if #samples &lt; 2 then
			return nil, "A copied ragdoll target does not contain enough exact samples."
		end
		local bucket = bucketByRig[rig]
		if not bucket then
			bucket = {
				rig = rig,
				rigType = rigType,
				targets = {},
			}
			bucketByRig[rig] = bucket
			buckets[#buckets + 1] = bucket
		end
		local sourceTarget = {
			part = part,
			partName = part.Name,
			trackPath = target.trackPath,
			samples = samples,
			visibleKeys = visibleKeysByPath[target.trackPath] or {},
		}
		bucket.targets[#bucket.targets + 1] = sourceTarget
		if part.Name == "HumanoidRootPart" then
			bucket.rootStart = samples[1].value
		end
	end
	if #buckets == 0 then
		return nil, "The copied Physics Clip does not contain ragdoll rigs."
	end
	for _, bucket in ipairs(buckets) do
		if typeof(bucket.rootStart) ~= "CFrame" then
			return nil, "A copied ragdoll is missing its HumanoidRootPart samples."
		end
	end
	return buckets, nil
end

local function collectSelectedRigs(selection)
	local rigs = {}
	local seen = {}
	local function addRigFrom(instance)
		local rig = findSupportedRig(instance)
		if rig and not seen[rig] then
			seen[rig] = true
			rigs[#rigs + 1] = rig
		end
	end
	for _, selected in ipairs(type(selection) == "table" and selection or {}) do
		addRigFrom(selected)
		if selected and selected:IsA("Model") then
			for _, descendant in ipairs(selected:GetDescendants()) do
				if descendant:IsA("Model") and descendant:FindFirstChildOfClass("Humanoid") then
					addRigFrom(descendant)
				end
			end
		end
	end
	return rigs
end

local function buildDestinationMappings(sourceBuckets, selection)
	local selectedRigs = collectSelectedRigs(selection)
	if #selectedRigs == 0 then
		return nil, "Select one or more destination R6/R15 rigs in Workspace first."
	end
	local sourceRigs = {}
	for _, bucket in ipairs(sourceBuckets) do
		sourceRigs[bucket.rig] = true
	end
	local mappings = {}
	local seen = {}
	for index, destinationRig in ipairs(selectedRigs) do
		if seen[destinationRig] then
			continue
		end
		seen[destinationRig] = true
		if sourceRigs[destinationRig] then
			return nil, "Select different destination rigs. Paste at Playhead repeats the clip on its original rigs."
		end
		local resolvedRig, rigType, destinationRoot = findSupportedRig(destinationRig)
		if resolvedRig ~= destinationRig then
			return nil, string.format("'%s' is not a supported R6/R15 rig.", tostring(destinationRig and destinationRig.Name or "Selection"))
		end
		local sourceBucket = sourceBuckets[((index - 1) % #sourceBuckets) + 1]
		if rigType ~= sourceBucket.rigType then
			return nil, string.format("'%s' must use the same R6/R15 rig type as its copied source motion.", destinationRig.Name)
		end
		local targetMappings = {}
		for _, sourceTarget in ipairs(sourceBucket.targets) do
			local destinationPart = destinationRig:FindFirstChild(sourceTarget.partName, true)
			if not (destinationPart and destinationPart:IsA("BasePart")) then
				return nil, string.format("'%s' is missing body part '%s'.", destinationRig.Name, sourceTarget.partName)
			end
			targetMappings[#targetMappings + 1] = {
				source = sourceTarget,
				destinationPart = destinationPart,
			}
		end
		mappings[#mappings + 1] = {
			destinationRig = destinationRig,
			destinationRoot = destinationRoot,
			offset = destinationRoot.CFrame * sourceBucket.rootStart:Inverse(),
			targets = targetMappings,
		}
	end
	if #mappings == 0 then
		return nil, "Select one or more destination R6/R15 rigs in Workspace first."
	end
	return mappings, nil
end

function PhysicsClipClipboardSupport.PasteToSelectedRigs(timeline, keyframeEditService, clipboard, selection, frameOffset)
	if type(clipboard) ~= "table" or type(clipboard.runtimeCapture) ~= "table" then
		return false, "Copy an exact Physics Clip before pasting it to selected rigs.", {}
	end
	local sourceBuckets, sourceMessage = collectSourceRigBuckets(timeline, clipboard)
	if not sourceBuckets then
		return false, sourceMessage, {}
	end
	local mappings, mappingMessage = buildDestinationMappings(sourceBuckets, selection)
	if not mappings then
		return false, mappingMessage, {}
	end

	frameOffset = math.max(0, math.floor(tonumber(frameOffset) or 0))
	local folder = timeline:addGenericTrack("Folder", nil, "Physics Capture", {
		targetScope = "TimelineFolder",
		sortOrder = 2,
		defaultCollapsed = true,
	})
	if not folder then
		return false, "7kg2 could not create the new Physics track folder.", {}
	end

	local pastedKeyData = {}
	local runtimeTargets = {}
	local createSucceeded, createError = pcall(function()
		for rigIndex, mapping in ipairs(mappings) do
			InstanceAddressSupport.ensureStableId(mapping.destinationRig)
			for _, targetMapping in ipairs(mapping.targets) do
				local sourceTarget = targetMapping.source
				local destinationPart = targetMapping.destinationPart
				local objectTrack = timeline:addGenericTrack("Object", destinationPart, string.format(
					"Rig %d / %s",
					rigIndex,
					destinationPart.Name
				), {
					folderPath = folder.path,
				})
				local cframeTrack = timeline:addGenericTrack("ObjectProperty", destinationPart, "CFrame", {
					propertyName = "CFrame",
					targetScope = "ObjectProperty",
					parentTrackPath = objectTrack.path,
					parentTrackName = objectTrack.name,
					sortOrder = 1,
				})
				for _, key in ipairs(sourceTarget.visibleKeys) do
					if typeof(key.value) == "CFrame" then
						pastedKeyData[#pastedKeyData + 1] = {
							jointPath = cframeTrack.path,
							frame = math.max(0, math.floor(tonumber(key.frame) or 0)),
							value = mapping.offset * key.value,
							easingStyle = key.easingStyle,
							easingDirection = key.easingDirection,
						}
					end
				end
				local runtimeSamples = {}
				for _, sample in ipairs(sourceTarget.samples) do
					runtimeSamples[#runtimeSamples + 1] = {
						time = sample.time,
						value = mapping.offset * sample.value,
					}
				end
				runtimeTargets[#runtimeTargets + 1] = {
					trackPath = cframeTrack.path,
					samples = runtimeSamples,
				}
			end
		end
	end)
	if not createSucceeded then
		timeline:removeTrack(folder.path)
		return false, "7kg2 could not create the destination Physics tracks: " .. tostring(createError), {}
	end
	if #pastedKeyData &lt; 2 then
		timeline:removeTrack(folder.path)
		return false, "The copied ragdoll did not contain enough editable CFrame keys.", {}
	end

	local pasted, pasteMessage, pastedKeys = timeline:pasteTrackKeyframes(pastedKeyData, frameOffset)
	if not pasted then
		timeline:removeTrack(folder.path)
		return false, pasteMessage or "The rebased ragdoll keys could not be pasted.", {}
	end
	local runtimeCapture = PhysicsRuntimeClipSupport.SanitizeObjectCapture(runtimeTargets)
	local clipCreated, clipMessage, groupId = PhysicsCaptureImportSupport.createPhysicsClip(keyframeEditService, {
		keyRefs = pastedKeys,
		folderPath = folder.path,
		name = clipboard.name,
		runtimeCapture = runtimeCapture,
	}, timeline)
	if not clipCreated then
		timeline:removeTrack(folder.path)
		return false, clipMessage or "The new rig tracks could not be grouped as an exact Physics Clip.", {}
	end
	setCopiedGroupMetadata(keyframeEditService, groupId, {
		name = clipboard.name,
		mode = clipboard.mode,
		sourceSpanFrames = clipboard.sourceSpanFrames,
		runtimeCapture = runtimeCapture,
	}, timeline)
	return true, string.format(
		"Pasted Physics Clip '%s' to %d selected rig%s on new tracks at frame %d.",
		clipboard.name,
		#mappings,
		#mappings == 1 and "" or "s",
		frameOffset
	), pastedKeys, groupId
end

return PhysicsClipClipboardSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX193">
        <Properties>
          <string name="Name">PhysicsClipIntegritySupport</string>
          <ProtectedString name="Source">local PhysicsClipIntegritySupport = {}

local HASH_MODULUS = 2147483647

local function makeHasher()
	return {
		first = 17,
		second = 29,
		bytes = 0,
		tokens = 0,
	}
end

local function feedRaw(hasher, text)
	for index = 1, #text do
		local byte = string.byte(text, index)
		hasher.first = ((hasher.first * 131) + byte) % HASH_MODULUS
		hasher.second = ((hasher.second * 257) + byte) % HASH_MODULUS
		hasher.bytes += 1
	end
end

local function feed(hasher, value)
	local text = tostring(value == nil and "&lt;nil&gt;" or value)
	feedRaw(hasher, tostring(#text))
	feedRaw(hasher, ":")
	feedRaw(hasher, text)
	feedRaw(hasher, "|")
	hasher.tokens += 1
end

local function formatNumber(value)
	if value ~= value then
		return "nan"
	end
	if value == math.huge then
		return "inf"
	end
	if value == -math.huge then
		return "-inf"
	end
	if value == 0 then
		return "0"
	end
	return string.format("%.17g", value)
end

local function feedValue(hasher, value, seenTables)
	local valueType = typeof(value)
	feed(hasher, valueType)
	if valueType == "CFrame" then
		for _, component in ipairs({ value:GetComponents() }) do
			feed(hasher, formatNumber(component))
		end
	elseif valueType == "Vector3" then
		feed(hasher, formatNumber(value.X))
		feed(hasher, formatNumber(value.Y))
		feed(hasher, formatNumber(value.Z))
	elseif valueType == "Vector2" then
		feed(hasher, formatNumber(value.X))
		feed(hasher, formatNumber(value.Y))
	elseif valueType == "Color3" then
		feed(hasher, formatNumber(value.R))
		feed(hasher, formatNumber(value.G))
		feed(hasher, formatNumber(value.B))
	elseif valueType == "number" then
		feed(hasher, formatNumber(value))
	elseif valueType == "table" then
		seenTables = seenTables or {}
		if seenTables[value] then
			feed(hasher, "&lt;cycle&gt;")
			return
		end
		seenTables[value] = true

		local keys = {}
		for key in pairs(value) do
			keys[#keys + 1] = key
		end
		table.sort(keys, function(left, right)
			local leftType = typeof(left)
			local rightType = typeof(right)
			if leftType ~= rightType then
				return leftType &lt; rightType
			end
			if leftType == "number" then
				return left &lt; right
			end
			if leftType == "string" then
				return left &lt; right
			end
			if leftType == "boolean" then
				return left == false and right == true
			end
			return tostring(left) &lt; tostring(right)
		end)
		feed(hasher, #keys)
		for _, key in ipairs(keys) do
			feedValue(hasher, key, seenTables)
			feedValue(hasher, value[key], seenTables)
		end
		seenTables[value] = nil
	else
		feed(hasher, value)
	end
end

local function parseKeyId(keyId)
	keyId = tostring(keyId or "")
	local divider = string.find(keyId, "\n", 1, true)
	if not divider then
		return nil, nil
	end
	return string.sub(keyId, 1, divider - 1), tonumber(string.sub(keyId, divider + 1))
end

local function collectGroupRefs(group, timeline)
	local refs = {}
	for keyId in pairs(group and group.keys or {}) do
		local path, frame = parseKeyId(keyId)
		if path and frame and timeline:hasTrackKeyframe(path, frame) then
			refs[#refs + 1] = {
				path = path,
				frame = math.max(0, math.floor(frame)),
			}
		end
	end
	table.sort(refs, function(left, right)
		if left.frame == right.frame then
			return left.path &lt; right.path
		end
		return left.frame &lt; right.frame
	end)
	return refs
end

local function collectRelevantPaths(group, timeline, refs)
	local seen = {}
	for _, ref in ipairs(refs) do
		seen[ref.path] = true
	end

	local capture = group and group.runtimeCapture
	if type(capture) == "table" and capture.captureType == "Objects" then
		for _, target in ipairs(capture.targets or {}) do
			if type(target) == "table" and type(target.trackPath) == "string" then
				seen[target.trackPath] = true
			end
		end
	elseif type(capture) == "table" and type(capture.rigName) == "string" then
		for _, path in ipairs(timeline:getRigTrackPaths(capture.rigName)) do
			seen[path] = true
		end
		local rootTrack = timeline:getRigPropertyTrack(capture.rigName, "CFrame")
		if rootTrack then
			seen[rootTrack.path] = true
		end
	end

	local paths = {}
	for path in pairs(seen) do
		paths[#paths + 1] = path
	end
	table.sort(paths)
	return paths
end

function PhysicsClipIntegritySupport.CountGroupKeys(group)
	local count = 0
	for _ in pairs(group and group.keys or {}) do
		count += 1
	end
	return count
end

function PhysicsClipIntegritySupport.Compute(group, timeline)
	if not group or not timeline then
		return nil
	end
	local refs = collectGroupRefs(group, timeline)
	if #refs &lt; 2 then
		return nil
	end

	local minFrame = refs[1].frame
	local maxFrame = refs[#refs].frame
	if maxFrame &lt;= minFrame then
		return nil
	end

	local hasher = makeHasher()
	feed(hasher, "PhysicsClipIntegrityV1")
	feed(hasher, maxFrame - minFrame)
	feed(hasher, #refs)
	for _, ref in ipairs(refs) do
		feed(hasher, "group")
		feed(hasher, ref.path)
		feed(hasher, ref.frame - minFrame)
	end

	for _, path in ipairs(collectRelevantPaths(group, timeline, refs)) do
		feed(hasher, "track")
		feed(hasher, path)
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(path) or {}) do
			frame = math.max(0, math.floor(tonumber(frame) or 0))
			if frame &gt;= minFrame and frame &lt;= maxFrame then
				feed(hasher, frame - minFrame)
				feedValue(hasher, timeline:getTrackValueAtFrame(path, frame))
				local options = timeline:getKeyOptions(path, frame)
				feed(hasher, options and options.easingStyle)
				feed(hasher, options and options.easingDirection)
			end
		end
	end

	return string.format(
		"v1:%08x:%08x:%d:%d",
		hasher.first,
		hasher.second,
		hasher.bytes,
		hasher.tokens
	)
end

function PhysicsClipIntegritySupport.EstablishBaseline(group, timeline)
	if not group or type(group.runtimeCapture) ~= "table" then
		return false
	end
	local signature = PhysicsClipIntegritySupport.Compute(group, timeline)
	group.runtimeKeyCount = PhysicsClipIntegritySupport.CountGroupKeys(group)
	group.runtimeKeySignature = signature
	group.runtimeCaptureValid = signature ~= nil
	return group.runtimeCaptureValid
end

function PhysicsClipIntegritySupport.IsValid(group, timeline)
	if not group
		or type(group.runtimeCapture) ~= "table"
		or group.runtimeCaptureValid == false
		or type(group.runtimeKeySignature) ~= "string" then
		return false
	end
	local expectedCount = math.max(0, math.floor(tonumber(group.runtimeKeyCount) or -1))
	if PhysicsClipIntegritySupport.CountGroupKeys(group) ~= expectedCount then
		return false
	end
	return PhysicsClipIntegritySupport.Compute(group, timeline) == group.runtimeKeySignature
end

return PhysicsClipIntegritySupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX194">
        <Properties>
          <string name="Name">PhysicsExplosionVFXImportSupport</string>
          <ProtectedString name="Source">local ParticleEmitterGroupService = require(script.Parent:WaitForChild("ParticleEmitterGroupService"))
local TrackPropertyDefaultsService = require(script.Parent:WaitForChild("TrackPropertyDefaultsService"))
local PhysicsPlaybackSpeedSupport = require(script.Parent:WaitForChild("PhysicsPlaybackSpeedSupport"))

local PhysicsExplosionVFXImportSupport = {}

local HOLDER_FOLDER_NAME = "7kg2 Physics VFX"
local HOLDER_ATTRIBUTE = "MegMoPhysicsExplosionVFXHolder"

local function getEmitterWorldCFrame(emitter)
	local parent = emitter and emitter.Parent
	if parent and parent:IsA("Attachment") then
		return parent.WorldCFrame
	end
	if parent and parent:IsA("BasePart") then
		return parent.CFrame
	end
	return CFrame.new()
end

local function getSourceReferenceCFrame(source, emitters)
	if not source then
		return nil
	end
	if source:IsA("ParticleEmitter") then
		source = source.Parent
	end
	local orientation = CFrame.new()
	if source and source:IsA("Attachment") then
		orientation = source.WorldCFrame
	elseif source and source:IsA("BasePart") then
		orientation = source.CFrame
	elseif source and source:IsA("Model") then
		orientation = source:GetPivot()
	end
	local center = Vector3.zero
	for _, emitter in ipairs(emitters or {}) do
		center += getEmitterWorldCFrame(emitter).Position
	end
	if #(emitters or {}) &gt; 0 then
		center /= #emitters
	else
		center = orientation.Position
	end
	return CFrame.new(center) * (orientation - orientation.Position)
end

local function getEmitterPlacementCFrame(sourceReference, emitter)
	local emitterWorld = getEmitterWorldCFrame(emitter)
	return sourceReference and sourceReference:ToObjectSpace(emitterWorld) or emitterWorld - emitterWorld.Position
end

local function getOrCreateFolder()
	local folder = workspace:FindFirstChild(HOLDER_FOLDER_NAME)
	if folder and folder:IsA("Folder") then
		return folder
	end
	if folder then
		folder = nil
	end
	folder = Instance.new("Folder")
	folder.Name = HOLDER_FOLDER_NAME
	folder.Parent = workspace
	return folder
end

local function createHolder(entry)
	local source = entry and entry.source
	local sourceEmitters = ParticleEmitterGroupService.collectEmitters(source)
	if #sourceEmitters == 0 or typeof(entry.position) ~= "Vector3" then
		return nil, nil
	end
	local sourceReference = getSourceReferenceCFrame(source, sourceEmitters)

	local holder = Instance.new("Part")
	holder.Name = string.format("%s Explosion VFX", tostring(entry.sourceName or source.Name))
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false
	holder.Size = Vector3.new(0.1, 0.1, 0.1)
	holder.Transparency = 1
	-- The baked holder uses the Blast Origin as the source reference while
	-- preserving the selected effect's internal emitter layout.
	holder.CFrame = CFrame.new(entry.position)
		* (sourceReference and (sourceReference - sourceReference.Position) or CFrame.new())
	holder:SetAttribute(HOLDER_ATTRIBUTE, true)
	holder.Parent = getOrCreateFolder()

	for index, emitter in ipairs(sourceEmitters) do
		local attachment = Instance.new("Attachment")
		attachment.Name = string.format("Emitter%d", index)
		attachment.CFrame = getEmitterPlacementCFrame(sourceReference, emitter)
		attachment.Parent = holder
		local clone = emitter:Clone()
		clone.Enabled = false
		clone.TimeScale = PhysicsPlaybackSpeedSupport.ParticleTimeScale(emitter.TimeScale, entry.playbackSpeed)
		clone.Parent = attachment
	end

	return holder, ParticleEmitterGroupService.collectEmitters(holder)
end

function PhysicsExplosionVFXImportSupport.Import(timeline, entries, options)
	if not timeline or type(entries) ~= "table" or #entries == 0 then
		return 0, 0, {}, nil
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 30)
	local frameOffset = math.max(0, math.floor(tonumber(options and options.frameOffset) or 0))
	local importedTrackCount = 0
	local importedKeyCount = 0
	local importedKeyRefs = {}
	local maxImportedFrame = nil

	for _, entry in ipairs(entries) do
		local holder, emitters = createHolder(entry)
		if holder and #emitters &gt; 0 then
			local groupTrack = timeline:addGenericTrack("EmitterGroup", holder, tostring(entry.sourceName or "Explosion VFX"), {
				targetScope = "EmitterGroup",
				emitters = emitters,
				sortOrder = 8,
			})
			local eventTrack = timeline:addGenericTrack("ParticleEvent", holder, "Emit", {
				propertyName = "Emit",
				eventName = "Emit",
				targetScope = "ParticleEvent",
				parentTrackPath = groupTrack.path,
				parentTrackName = groupTrack.name,
				emitters = emitters,
				sortOrder = TrackPropertyDefaultsService.getSortOrder("Emit"),
			})
			local localFrame = math.max(0, math.floor((tonumber(entry.time) or 0) * fps + 0.5))
			local frame = frameOffset + localFrame
			local success = timeline:setTrackValueAtFrame(eventTrack.path, frame, {
				actionName = "Emit",
				emitCount = math.clamp(math.floor(tonumber(entry.emitCount) or 16), 1, 500),
			}, "Linear", "InOut")
			if success then
				importedTrackCount += 2
				importedKeyCount += 1
				maxImportedFrame = maxImportedFrame and math.max(maxImportedFrame, frame) or frame
				table.insert(importedKeyRefs, {
					jointPath = eventTrack.path,
					frame = frame,
				})
			else
				holder:Destroy()
			end
		end
	end

	if maxImportedFrame and maxImportedFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(maxImportedFrame)
	end
	local message = importedKeyCount &gt; 0
		and string.format("Added %d Explosion VFX event%s.", importedKeyCount, importedKeyCount == 1 and "" or "s")
		or nil
	return importedTrackCount, importedKeyCount, importedKeyRefs, message
end

return PhysicsExplosionVFXImportSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX195">
        <Properties>
          <string name="Name">PhysicsObjectPathExportSupport</string>
          <ProtectedString name="Source">local PhysicsObjectPathExportSupport = {}

local function calculateAngularVelocity(previousCFrame, currentCFrame, deltaTime)
	local previousRotation = previousCFrame - previousCFrame.Position
	local currentRotation = currentCFrame - currentCFrame.Position
	local relative = previousRotation:ToObjectSpace(currentRotation)
	local axis, angle = relative:ToAxisAngle()
	if math.abs(angle) &lt;= 0.00001 or deltaTime &lt;= 0 then
		return Vector3.zero
	end
	return previousCFrame:VectorToWorldSpace(axis) * (angle / deltaTime)
end

local function findCFrameTrack(timeline, target)
	for _, track in ipairs(timeline:getTracks()) do
		if track.targetScope == "ObjectProperty"
			and track.propertyName == "CFrame"
			and track.instance == target then
			return track
		end
	end
	return nil
end

function PhysicsObjectPathExportSupport.build(timeline, target)
	if not (timeline and target and target.Parent and (target:IsA("BasePart") or target:IsA("Model"))) then
		return nil, "Select a Part or Model that has been added to the 7kg2 timeline."
	end
	local track = findCFrameTrack(timeline, target)
	if not track then
		return nil, "The selected driver does not have a CFrame track in 7kg2."
	end

	local startFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or 0))
	local endFrame = nil
	for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path) or {}) do
		if frame &gt; startFrame then
			endFrame = math.max(endFrame or frame, frame)
		end
	end
	if not endFrame then
		return nil, "Place the playhead before the final CFrame key on the animated driver."
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 30)
	local samples = {}
	for frame = startFrame, endFrame do
		local pose = timeline:samplePose(frame) or {}
		local cframe = pose[track.path]
		if typeof(cframe) ~= "CFrame" then
			cframe = track.originalValue
		end
		if typeof(cframe) ~= "CFrame" then
			return nil, "7kg2 could not sample the driver's CFrame path."
		end
		table.insert(samples, {
			time = (frame - startFrame) / fps,
			rootCFrame = cframe,
			joints = {},
		})
	end

	local previous = samples[#samples - 1]
	local final = samples[#samples]
	local deltaTime = 1 / fps
	local linearVelocity = (final.rootCFrame.Position - previous.rootCFrame.Position) / deltaTime
	local angularVelocity = calculateAngularVelocity(previous.rootCFrame, final.rootCFrame, deltaTime)
	return {
		objectName = target.Name,
		mode = "DrivenImpact",
		fps = fps,
		startFrame = startFrame,
		endFrame = endFrame,
		handoffFrame = endFrame,
		importFrame = startFrame,
		duration = (endFrame - startFrame) / fps,
		motors = {},
		samples = samples,
		linearVelocity = linearVelocity,
		angularVelocity = angularVelocity,
	}, string.format(
		"Loaded %.2fs Drive Impact path for %s from frame %d to %d.",
		(endFrame - startFrame) / fps,
		target.Name,
		startFrame,
		endFrame
	)
end

return PhysicsObjectPathExportSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX196">
        <Properties>
          <string name="Name">PhysicsObjectReleaseExportSupport</string>
          <ProtectedString name="Source">local PhysicsObjectReleaseExportSupport = {}

local ATTACHMENT_EVENT_KIND = "MegMoAttachmentEvent"
local SAMPLE_FRAME_COUNT = 3

local function isValidTarget(target)
	return target
		and target.Parent
		and (target:IsA("BasePart") or target:IsA("Model"))
end

local function resolveAttachmentTarget(timeline, value)
	if type(value.objectTrackPath) == "string" and value.objectTrackPath ~= "" then
		local objectTrack = timeline:getTrackByPath(value.objectTrackPath)
		if objectTrack and isValidTarget(objectTrack.instance) then
			return objectTrack.instance
		end
	end

	if type(value.objectPath) == "string" and value.objectPath ~= "" then
		for _, track in ipairs(timeline:getTracks()) do
			if isValidTarget(track.instance) and track.instance:GetFullName() == value.objectPath then
				return track.instance
			end
		end
	end

	return nil
end

local function findDetachTargetAtFrame(timeline, releaseFrame, preferredTarget)
	local targets = {}
	local seen = {}
	local unresolvedCount = 0

	for _, track in ipairs(timeline:getTracks()) do
		if track.valueType == "Event" then
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				if frame == releaseFrame then
					local value = timeline:getTrackValueAtFrame(track.path, frame)
					if type(value) == "table"
						and value.kind == ATTACHMENT_EVENT_KIND
						and value.action == "Detach" then
						local target = resolveAttachmentTarget(timeline, value)
						if target and not seen[target] then
							seen[target] = true
							targets[#targets + 1] = target
						elseif not target then
							unresolvedCount += 1
						end
					end
				end
			end
		end
	end

	if #targets == 1 then
		return targets[1]
	end
	if #targets &gt; 1 then
		if isValidTarget(preferredTarget) and seen[preferredTarget] then
			return preferredTarget
		end
		return nil, "More than one object has a Detach event at this frame. Select the held object, then load again."
	end
	if unresolvedCount &gt; 0 then
		return nil, "7kg2 found a Detach event at this frame, but its object is no longer available in the timeline."
	end
	return nil
end

local function getTargetParts(target)
	local parts = {}
	if target:IsA("BasePart") then
		parts[1] = target
	else
		for _, descendant in ipairs(target:GetDescendants()) do
			if descendant:IsA("BasePart") then
				parts[#parts + 1] = descendant
			end
		end
	end
	table.sort(parts, function(a, b)
		return a:GetFullName() &lt; b:GetFullName()
	end)
	return parts
end

local function getReferenceCFrame(parts)
	if #parts == 0 then
		return nil
	end
	local totalMass = 0
	local weightedPosition = Vector3.zero
	for _, part in ipairs(parts) do
		local mass = math.max(0.0001, part:GetMass())
		totalMass += mass
		weightedPosition += part.Position * mass
	end
	local rotation = parts[1].CFrame - parts[1].Position
	return CFrame.new(weightedPosition / totalMass) * rotation
end

local function calculateAngularVelocity(previousCFrame, currentCFrame, deltaTime)
	if deltaTime &lt;= 0 then
		return Vector3.zero
	end
	local previousRotation = previousCFrame - previousCFrame.Position
	local currentRotation = currentCFrame - currentCFrame.Position
	local relative = previousRotation:ToObjectSpace(currentRotation)
	local axis, angle = relative:ToAxisAngle()
	if math.abs(angle) &lt;= 0.00001 then
		return Vector3.zero
	end
	return previousCFrame:VectorToWorldSpace(axis) * (angle / deltaTime)
end

local function findCFrameTrack(timeline, target)
	local fallback = nil
	for _, track in ipairs(timeline:getTracks()) do
		if track.instance == target then
			if track.targetScope == "ObjectProperty" and track.propertyName == "CFrame" then
				return track
			end
			if track.trackType == "Object" or track.trackType == "Model" then
				fallback = fallback or track
			end
		end
	end
	return fallback
end

local function findLatestAttachmentEvent(timeline, objectPath, releaseFrame)
	local latest = nil
	for _, track in ipairs(timeline:getTracks()) do
		if track.valueType == "Event" then
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				if frame &lt;= releaseFrame then
					local value = timeline:getTrackValueAtFrame(track.path, frame)
					if type(value) == "table"
						and value.kind == ATTACHMENT_EVENT_KIND
						and value.objectPath == objectPath
						and (not latest or frame &gt;= latest.frame) then
						latest = {
							frame = frame,
							value = value,
						}
					end
				end
			end
		end
	end
	return latest
end

local function restorePartCFrames(savedParts)
	for _, item in ipairs(savedParts) do
		if item.part and item.part.Parent and typeof(item.cframe) == "CFrame" then
			item.part.CFrame = item.cframe
		end
	end
end

function PhysicsObjectReleaseExportSupport.build(timeline, target)
	if not timeline then
		return nil, "Open a 7kg2 timeline before loading Release to Physics."
	end
	local releaseFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or 0))
	local detectedTarget, detectionError = findDetachTargetAtFrame(timeline, releaseFrame, target)
	if detectionError then
		return nil, detectionError
	end
	target = detectedTarget or target
	if not isValidTarget(target) then
		return nil, "Put the playhead on the held object's Detach event, then load again. You can also select the held object manually."
	end
	if not findCFrameTrack(timeline, target) then
		return nil, "Add the held object to the 7kg2 timeline before loading its release state."
	end

	local objectPath = target:GetFullName()
	local latestAttachment = findLatestAttachmentEvent(timeline, objectPath, releaseFrame)
	if latestAttachment and latestAttachment.value.action == "Attach" then
		return nil, string.format(
			"Add a Detach event for %s at frame %d before loading Release to Physics.",
			target.Name,
			releaseFrame
		)
	end

	local parts = getTargetParts(target)
	if #parts == 0 then
		return nil, "The selected release object does not contain any BaseParts."
	end

	local savedParts = {}
	for _, part in ipairs(parts) do
		savedParts[#savedParts + 1] = {
			part = part,
			cframe = part.CFrame,
		}
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 30)
	local currentFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or releaseFrame))
	local firstFrame = math.max(0, releaseFrame - (SAMPLE_FRAME_COUNT - 1))
	local samples = {}
	local releasePartCFrames = nil
	local releaseTargetCFrame = nil
	local sampleSucceeded, sampleError = pcall(function()
		for frame = firstFrame, releaseFrame do
			timeline:applyFrame(frame)
			local cframe = getReferenceCFrame(parts)
			if typeof(cframe) ~= "CFrame" then
				error("the release object could not be sampled")
			end
			samples[#samples + 1] = {
				frame = frame,
				cframe = cframe,
			}
		end

		releasePartCFrames = {}
		for _, part in ipairs(parts) do
			releasePartCFrames[#releasePartCFrames + 1] = {
				instance = part,
				path = part:GetFullName(),
				cframe = part.CFrame,
			}
		end
		releaseTargetCFrame = target:IsA("Model") and target:GetPivot() or target.CFrame
	end)

	local restoreCallSucceeded, restoreSucceeded = pcall(function()
		return timeline:applyFrame(currentFrame)
	end)
	if not restoreCallSucceeded or restoreSucceeded ~= true then
		restorePartCFrames(savedParts)
	end
	if not sampleSucceeded then
		return nil, "7kg2 could not sample the release motion: " .. tostring(sampleError)
	end

	local linearVelocity = Vector3.zero
	local angularVelocity = Vector3.zero
	if #samples &gt;= 2 then
		local first = samples[1]
		local final = samples[#samples]
		local deltaTime = math.max(1 / fps, (final.frame - first.frame) / fps)
		linearVelocity = (final.cframe.Position - first.cframe.Position) / deltaTime
		angularVelocity = calculateAngularVelocity(first.cframe, final.cframe, deltaTime)
	end

	return {
		mode = "Release",
		objectName = target.Name,
		objectPath = objectPath,
		target = target,
		fps = fps,
		releaseFrame = releaseFrame,
		importFrame = releaseFrame,
		cframe = samples[#samples].cframe,
		targetCFrame = releaseTargetCFrame,
		partCFrames = releasePartCFrames,
		linearVelocity = linearVelocity,
		angularVelocity = angularVelocity,
	}, string.format(
		"Loaded %s release at frame %d with %.2f studs/s inherited speed.",
		target.Name,
		releaseFrame,
		linearVelocity.Magnitude
	)
end

return PhysicsObjectReleaseExportSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX197">
        <Properties>
          <string name="Name">PhysicsPlaybackSpeedSupport</string>
          <ProtectedString name="Source">local PhysicsPlaybackSpeedSupport = {}

local EXPLOSION_SPEED_PRESETS = {
	1,
	0.75,
	0.5,
	0.25,
	0.1,
	2,
	1.5,
	1.25,
}

function PhysicsPlaybackSpeedSupport.Clamp(speed)
	return math.clamp(tonumber(speed) or 1, 0.1, 2)
end

function PhysicsPlaybackSpeedSupport.Next(speed)
	local resolved = PhysicsPlaybackSpeedSupport.Clamp(speed)
	for index, preset in ipairs(EXPLOSION_SPEED_PRESETS) do
		if math.abs(preset - resolved) &lt; 0.001 then
			return EXPLOSION_SPEED_PRESETS[index % #EXPLOSION_SPEED_PRESETS + 1]
		end
	end
	return 1
end

function PhysicsPlaybackSpeedSupport.Format(speed)
	return string.format("Speed: %d%%", math.round(PhysicsPlaybackSpeedSupport.Clamp(speed) * 100))
end

function PhysicsPlaybackSpeedSupport.ToTimeFactor(speed)
	return 1 / PhysicsPlaybackSpeedSupport.Clamp(speed)
end

function PhysicsPlaybackSpeedSupport.FromMarker(marker)
	if type(marker) ~= "table" then
		return 1
	end
	if tonumber(marker.playbackSpeed) then
		return PhysicsPlaybackSpeedSupport.Clamp(marker.playbackSpeed)
	end
	local legacyFactor = math.clamp(tonumber(marker.slowMotion) or 1, 0.5, 10)
	return PhysicsPlaybackSpeedSupport.Clamp(1 / legacyFactor)
end

function PhysicsPlaybackSpeedSupport.ParticleTimeScale(sourceTimeScale, speed)
	local authoredScale = math.clamp(tonumber(sourceTimeScale) or 1, 0, 1)
	-- ParticleEmitter.TimeScale is limited by Roblox to 0..1. Slower Explosion
	-- presets can therefore match exactly; faster presets retain the emitter's
	-- authored speed instead of silently changing its look.
	return math.clamp(authoredScale * math.min(PhysicsPlaybackSpeedSupport.Clamp(speed), 1), 0, 1)
end

return PhysicsPlaybackSpeedSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX198">
        <Properties>
          <string name="Name">PhysicsRuntimeClipSupport</string>
          <ProtectedString name="Source">local PhysicsPlaybackSpeedSupport = require(script.Parent:WaitForChild("PhysicsPlaybackSpeedSupport"))
local PhysicsClipIntegritySupport = require(script.Parent:WaitForChild("PhysicsClipIntegritySupport"))

local PhysicsRuntimeClipSupport = {}
PhysicsRuntimeClipSupport.__index = PhysicsRuntimeClipSupport

local MAX_COMPONENT_MAGNITUDE = 1e12

local function isFiniteNumber(value)
	return type(value) == "number"
		and value == value
		and math.abs(value) &lt; math.huge
		and math.abs(value) &lt;= MAX_COMPONENT_MAGNITUDE
end

local function serializeCFrame(value)
	if typeof(value) ~= "CFrame" then
		return nil
	end
	local components = { value:GetComponents() }
	for index = 1, 12 do
		if not isFiniteNumber(components[index]) then
			return nil
		end
	end
	return components
end

local function deserializeCFrame(components)
	if type(components) ~= "table" then
		return nil
	end
	for index = 1, 12 do
		if not isFiniteNumber(components[index]) then
			return nil
		end
	end
	return CFrame.new(table.unpack(components, 1, 12))
end

local function isAccessoryPart(part, rig)
	local ancestor = part and part.Parent
	while ancestor and ancestor ~= rig do
		if ancestor:IsA("Accessory") then
			return true
		end
		ancestor = ancestor.Parent
	end
	return false
end

local function getGroupBounds(refs)
	local minFrame = nil
	local maxFrame = nil
	for _, ref in ipairs(refs or {}) do
		local frame = tonumber(ref and ref.frame)
		if frame then
			minFrame = minFrame and math.min(minFrame, frame) or frame
			maxFrame = maxFrame and math.max(maxFrame, frame) or frame
		end
	end
	return minFrame, maxFrame
end

function PhysicsRuntimeClipSupport.SanitizeCapture(take, rigName)
	if type(take) ~= "table" or type(take.samples) ~= "table" or #take.samples &lt; 2 then
		return nil
	end

	local sanitizedSamples = {}
	local capturedPartNames = {}
	for _, sample in ipairs(take.samples) do
		local sampleTime = tonumber(sample and sample.time)
		if isFiniteNumber(sampleTime) and type(sample.parts) == "table" then
			local parts = {}
			for partName, value in pairs(sample.parts) do
				if type(partName) == "string" and partName ~= "" then
					local components = serializeCFrame(value)
					if components then
						parts[partName] = components
						capturedPartNames[partName] = true
					end
				end
			end
			if next(parts) ~= nil then
				sanitizedSamples[#sanitizedSamples + 1] = {
					time = math.max(0, sampleTime),
					parts = parts,
				}
			end
		end
	end
	if #sanitizedSamples &lt; 2 or next(capturedPartNames) == nil then
		return nil
	end
	table.sort(sanitizedSamples, function(left, right)
		return left.time &lt; right.time
	end)

	local duration = tonumber(take.duration)
	if not isFiniteNumber(duration) or duration &lt;= 0 then
		duration = sanitizedSamples[#sanitizedSamples].time
	end
	if duration &lt;= 0 then
		return nil
	end

	return {
		version = 1,
		captureType = "Rig",
		rigName = type(rigName) == "string" and rigName ~= "" and rigName or take.rigName,
		duration = duration,
		samples = sanitizedSamples,
	}
end

function PhysicsRuntimeClipSupport.SanitizeObjectCapture(targets)
	if type(targets) ~= "table" or #targets == 0 then
		return nil
	end

	local sanitizedTargets = {}
	local duration = 0
	for _, target in ipairs(targets) do
		local trackPath = target and target.trackPath
		if type(trackPath) == "string" and trackPath ~= "" and type(target.samples) == "table" then
			local samples = {}
			for _, sample in ipairs(target.samples) do
				local sampleTime = tonumber(sample and sample.time)
				local components = serializeCFrame(sample and sample.value)
				if isFiniteNumber(sampleTime) and components then
					local clampedTime = math.max(0, sampleTime)
					samples[#samples + 1] = {
						time = clampedTime,
						value = components,
					}
					duration = math.max(duration, clampedTime)
				end
			end
			if #samples &gt;= 2 then
				table.sort(samples, function(left, right)
					return left.time &lt; right.time
				end)
				sanitizedTargets[#sanitizedTargets + 1] = {
					trackPath = trackPath,
					samples = samples,
				}
			end
		end
	end
	if #sanitizedTargets == 0 or duration &lt;= 0 then
		return nil
	end

	return {
		version = 1,
		captureType = "Objects",
		duration = duration,
		targets = sanitizedTargets,
	}
end

function PhysicsRuntimeClipSupport.new(timeline, keyframeEditService)
	return setmetatable({
		timeline = timeline,
		keyframeEditService = keyframeEditService,
		anchoredParts = {},
		authoredEmitterTimeScales = setmetatable({}, { __mode = "k" }),
		activeEmitterTimeScales = {},
		handoffMotorC0s = setmetatable({}, { __mode = "k" }),
		decodedCaptures = setmetatable({}, { __mode = "k" }),
		playbackHeldFinalClips = setmetatable({}, { __mode = "k" }),
		applyBuffers = {
			activeParts = {},
			bulkParts = {},
			bulkCFrames = {},
			bulkIndexes = {},
			activeHeldFinalClips = {},
		},
		preparedClips = nil,
		prepareReport = nil,
	}, PhysicsRuntimeClipSupport)
end

function PhysicsRuntimeClipSupport:_decodeCapture(capture)
	local cached = self.decodedCaptures[capture]
	if cached then
		return cached
	end

	if capture.captureType == "Objects" then
		local targets = {}
		local duration = 0
		for _, target in ipairs(capture.targets or {}) do
			local samples = {}
			for _, sample in ipairs(target.samples or {}) do
				local value = deserializeCFrame(sample.value)
				if value then
					local sampleTime = math.max(0, tonumber(sample.time) or 0)
					samples[#samples + 1] = {
						time = sampleTime,
						value = value,
					}
					duration = math.max(duration, sampleTime)
				end
			end
			if type(target.trackPath) == "string" and #samples &gt;= 2 then
				table.sort(samples, function(left, right)
					return left.time &lt; right.time
				end)
				targets[#targets + 1] = {
					trackPath = target.trackPath,
					samples = samples,
				}
			end
		end
		if #targets == 0 then
			return nil
		end
		local sharedSamples = targets[1].samples
		for targetIndex = 2, #targets do
			local samples = targets[targetIndex].samples
			if #samples ~= #sharedSamples then
				sharedSamples = nil
				break
			end
			for sampleIndex = 1, #samples do
				if math.abs(samples[sampleIndex].time - sharedSamples[sampleIndex].time) &gt; 0.000001 then
					sharedSamples = nil
					break
				end
			end
			if not sharedSamples then
				break
			end
		end
		cached = {
			captureType = "Objects",
			duration = math.max(0.001, tonumber(capture.duration) or duration),
			targets = targets,
			sharedSamples = sharedSamples,
		}
		self.decodedCaptures[capture] = cached
		return cached
	end

	local samples = {}
	for _, sample in ipairs(capture.samples or {}) do
		local parts = {}
		for partName, components in pairs(sample.parts or {}) do
			local value = deserializeCFrame(components)
			if value then
				parts[partName] = value
			end
		end
		if next(parts) ~= nil then
			samples[#samples + 1] = {
				time = math.max(0, tonumber(sample.time) or 0),
				parts = parts,
			}
		end
	end
	if #samples &lt; 2 then
		return nil
	end
	table.sort(samples, function(left, right)
		return left.time &lt; right.time
	end)
	cached = {
		captureType = "Rig",
		duration = math.max(0.001, tonumber(capture.duration) or samples[#samples].time),
		samples = samples,
	}
	self.decodedCaptures[capture] = cached
	return cached
end

function PhysicsRuntimeClipSupport:_restoreEmitterTimeScales()
	for emitter, authoredTimeScale in pairs(self.activeEmitterTimeScales) do
		if emitter and emitter.Parent then
			pcall(function()
				emitter.TimeScale = authoredTimeScale
			end)
		end
	end
	table.clear(self.activeEmitterTimeScales)
end

function PhysicsRuntimeClipSupport:freezeEmitters(state)
	local seen = {}
	for _, clip in ipairs(state and state.clips or {}) do
		for _, emitter in ipairs(clip.emitters or {}) do
			if typeof(emitter) == "Instance"
				and emitter:IsA("ParticleEmitter")
				and emitter.Parent
				and not seen[emitter] then
				seen[emitter] = true
				local authoredTimeScale = self.activeEmitterTimeScales[emitter]
					or self.authoredEmitterTimeScales[emitter]
					or emitter.TimeScale
				self.authoredEmitterTimeScales[emitter] = authoredTimeScale
				self.activeEmitterTimeScales[emitter] = authoredTimeScale
				pcall(function()
					emitter.TimeScale = 0
				end)
			end
		end
	end
end

function PhysicsRuntimeClipSupport:_prepareClipEmitterTiming(prepared, group, refs)
	local currentSpan = math.max(1, prepared.maxFrame - prepared.minFrame)
	local sourceSpan = math.max(1, tonumber(group.sourceSpanFrames) or currentSpan)
	local clipSpeed = PhysicsPlaybackSpeedSupport.Clamp(sourceSpan / currentSpan)
	local seen = {}
	local emitters = {}
	for _, ref in ipairs(refs or {}) do
		local track = type(ref.jointPath) == "string" and self.timeline:getTrackByPath(ref.jointPath) or nil
		if track and (track.targetScope == "ParticleEvent" or track.trackType == "Particle Event") then
			for _, emitter in ipairs(track.emitters or {}) do
				if typeof(emitter) == "Instance" and emitter:IsA("ParticleEmitter") and not seen[emitter] then
					seen[emitter] = true
					emitters[#emitters + 1] = emitter
					local authoredTimeScale = self.authoredEmitterTimeScales[emitter]
					if authoredTimeScale == nil then
						authoredTimeScale = emitter.TimeScale
						self.authoredEmitterTimeScales[emitter] = authoredTimeScale
					end
					self.activeEmitterTimeScales[emitter] = authoredTimeScale
					emitter.TimeScale = PhysicsPlaybackSpeedSupport.ParticleTimeScale(authoredTimeScale, clipSpeed)
				end
			end
		end
	end
	prepared.emitters = emitters
	prepared.playbackSpeed = clipSpeed
end

function PhysicsRuntimeClipSupport:prepare()
	self:_restoreEmitterTimeScales()
	table.clear(self.playbackHeldFinalClips)
	local preparedClips = {}
	local report = {
		physicsGroups = 0,
		preparedClips = 0,
		preparedParts = 0,
		rejected = {},
	}
	local function reject(reason)
		report.rejected[reason] = (report.rejected[reason] or 0) + 1
	end
	if not self.timeline or not self.keyframeEditService then
		self.preparedClips = preparedClips
		self.prepareReport = report
		return preparedClips
	end

	local groupIds = {}
	for groupId in pairs(self.keyframeEditService:getGroups() or {}) do
		groupIds[#groupIds + 1] = groupId
	end
	table.sort(groupIds, function(left, right)
		return tostring(left) &lt; tostring(right)
	end)

	for _, groupId in ipairs(groupIds) do
		local group = self.keyframeEditService:getGroups()[groupId]
		if group and group.kind == "PhysicsClip" then
			report.physicsGroups += 1
			local capture = group.runtimeCapture
			if type(capture) ~= "table" then
				reject("missing capture")
			elseif not PhysicsClipIntegritySupport.IsValid(group, self.timeline) then
				reject("clip was edited")
			else
				local refs = self.keyframeEditService:getKeyRefsForGroup(groupId, self.timeline)
				local minFrame, maxFrame = getGroupBounds(refs)
				if not minFrame or not maxFrame or maxFrame &lt;= minFrame then
					reject("invalid clip range")
				else
					local decoded = self:_decodeCapture(capture)
					if not decoded then
						reject("invalid capture")
					elseif decoded.captureType == "Objects" then
						local targets = {}
						local suppressedPaths = {}
						local partCount = 0
						for _, target in ipairs(decoded.targets or {}) do
							local track = self.timeline:getTrackByPath(target.trackPath)
							local instance = track and track.instance
							if instance and instance.Parent and (instance:IsA("BasePart") or instance:IsA("Model")) then
								local preparedTarget = {
									instance = instance,
									samples = target.samples,
								}
								targets[#targets + 1] = preparedTarget
								suppressedPaths[target.trackPath] = true
								if instance:IsA("BasePart") then
									partCount += 1
								else
									preparedTarget.parts = {}
									for _, descendant in ipairs(instance:GetDescendants()) do
										if descendant:IsA("BasePart") then
											preparedTarget.parts[#preparedTarget.parts + 1] = descendant
											partCount += 1
										end
									end
								end
							end
						end
						if #targets == 0 then
							reject("object tracks not found")
						else
							local prepared = {
								captureType = "Objects",
								capture = decoded,
								minFrame = minFrame,
								maxFrame = maxFrame,
								targets = targets,
								suppressedPaths = suppressedPaths,
							}
							self:_prepareClipEmitterTiming(prepared, group, refs)
							preparedClips[#preparedClips + 1] = prepared
							report.preparedClips += 1
							report.preparedParts += partCount
						end
					else
						if type(capture.rigName) ~= "string" or capture.rigName == "" then
							reject("missing rig name")
							continue
						end
						local rig = self.timeline:getRigByName(capture.rigName)
						if not (rig and rig.Parent) then
							reject("rig not found")
						else
							local partsByName = {}
							local partCount = 0
							for _, descendant in ipairs(rig:GetDescendants()) do
								if descendant:IsA("BasePart") and not isAccessoryPart(descendant, rig) then
									if not partsByName[descendant.Name] then
										partsByName[descendant.Name] = descendant
										partCount += 1
									end
								end
							end
							if partCount == 0 then
								reject("rig has no captured parts")
							else
								local suppressedPaths = {}
								for _, path in ipairs(self.timeline:getRigTrackPaths(capture.rigName)) do
									suppressedPaths[path] = true
								end
								local rootTrack = self.timeline:getRigPropertyTrack(capture.rigName, "CFrame")
								if rootTrack then
									suppressedPaths[rootTrack.path] = true
								end

								local prepared = {
									captureType = "Rig",
									rigName = capture.rigName,
									rig = rig,
									capture = decoded,
									minFrame = minFrame,
									maxFrame = maxFrame,
									partsByName = partsByName,
									suppressedPaths = suppressedPaths,
								}
								self:_prepareClipEmitterTiming(prepared, group, refs)
								preparedClips[#preparedClips + 1] = prepared
								report.preparedClips += 1
								report.preparedParts += partCount
							end
						end
					end
				end
			end
		end
	end
	table.sort(preparedClips, function(left, right)
		return (tonumber(left.minFrame) or 0) &lt; (tonumber(right.minFrame) or 0)
	end)
	self.preparedClips = preparedClips
	self.prepareReport = report
	return preparedClips
end

function PhysicsRuntimeClipSupport:getPrepareReport()
	return self.prepareReport
end

function PhysicsRuntimeClipSupport:hasPhysicsClipGroups()
	if not self.keyframeEditService then
		return false
	end
	for _, group in pairs(self.keyframeEditService:getGroups() or {}) do
		if group and group.kind == "PhysicsClip" then
			return true
		end
	end
	return false
end

function PhysicsRuntimeClipSupport:getFrameState(frame)
	local state = {
		clips = {},
		suppressedPaths = {},
	}
	local preparedClips = self.preparedClips or self:prepare()
	-- A normal timeline key holds its value after its frame. Exact Physics clips
	-- must do the same or Motor6Ds immediately rebuild a completed ragdoll into
	-- its keyed/default pose. Apply older clips first so a later Physics clip for
	-- the same target takes ownership when its start frame is reached.
	for _, prepared in ipairs(preparedClips) do
		if frame &gt;= prepared.minFrame then
			local alpha = math.clamp(
				(frame - prepared.minFrame) / (prepared.maxFrame - prepared.minFrame),
				0,
				1
			)
			local holdingFinalPose = frame &gt; prepared.maxFrame
			state.clips[#state.clips + 1] = {
				preparedClip = prepared,
				captureType = prepared.captureType,
				rigName = prepared.rigName,
				rig = prepared.rig,
				capture = prepared.capture,
				partsByName = prepared.partsByName,
				targets = prepared.targets,
				-- The captured pose holds after the block; its one-shot VFX does not.
				emitters = holdingFinalPose and {} or prepared.emitters,
				time = alpha * prepared.capture.duration,
				holdingFinalPose = holdingFinalPose,
			}
			for path in pairs(prepared.suppressedPaths) do
				state.suppressedPaths[path] = true
			end
		end
	end
	return state
end

function PhysicsRuntimeClipSupport:getInitialFrameState()
	local state = {
		clips = {},
		suppressedPaths = {},
	}
	local preparedClips = self.preparedClips or self:prepare()
	-- Apply later clips first so the earliest clip wins if several captures
	-- contain the same target. Frame zero should restore the first Physics state
	-- the timeline will encounter.
	for index = #preparedClips, 1, -1 do
		local prepared = preparedClips[index]
		state.clips[#state.clips + 1] = {
			preparedClip = prepared,
			captureType = prepared.captureType,
			rigName = prepared.rigName,
			rig = prepared.rig,
			capture = prepared.capture,
			partsByName = prepared.partsByName,
			targets = prepared.targets,
			emitters = prepared.emitters,
			time = 0,
			holdingFinalPose = false,
		}
		for path in pairs(prepared.suppressedPaths) do
			state.suppressedPaths[path] = true
		end
	end
	return state
end

function PhysicsRuntimeClipSupport.FilterPose(pose, suppressedPaths)
	if type(pose) ~= "table" or next(suppressedPaths or {}) == nil then
		return pose
	end
	local filtered = {}
	for path, value in pairs(pose) do
		if not suppressedPaths[path] then
			filtered[path] = value
		end
	end
	return filtered
end

local function findSamplePairIndexes(samples, time)
	if time &lt;= samples[1].time then
		return 1, 1, 0
	end
	if time &gt;= samples[#samples].time then
		return #samples, #samples, 0
	end

	local low = 1
	local high = #samples - 1
	while low &lt;= high do
		local middle = math.floor((low + high) / 2)
		local first = samples[middle]
		local second = samples[middle + 1]
		if time &lt; first.time then
			high = middle - 1
		elseif time &gt; second.time then
			low = middle + 1
		else
			local span = math.max(0.000001, second.time - first.time)
			return middle, middle + 1, math.clamp((time - first.time) / span, 0, 1)
		end
	end
	return #samples, #samples, 0
end

local function findSamplePair(samples, time)
	local firstIndex, secondIndex, alpha = findSamplePairIndexes(samples, time)
	return samples[firstIndex], samples[secondIndex], alpha
end

function PhysicsRuntimeClipSupport:apply(state, skipRepeatedFinalPoses)
	local buffers = self.applyBuffers
	local activeParts = buffers.activeParts
	local bulkParts = buffers.bulkParts
	local bulkCFrames = buffers.bulkCFrames
	local bulkIndexes = buffers.bulkIndexes
	local activeHeldFinalClips = buffers.activeHeldFinalClips
	table.clear(activeParts)
	table.clear(bulkParts)
	table.clear(bulkCFrames)
	table.clear(bulkIndexes)
	table.clear(activeHeldFinalClips)
	if not skipRepeatedFinalPoses then
		table.clear(self.playbackHeldFinalClips)
	end
	local function anchorPart(part)
		if self.anchoredParts[part] == nil then
			self.anchoredParts[part] = part.Anchored
			part.Anchored = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
		activeParts[part] = true
	end
	local function queuePart(part, value)
		anchorPart(part)
		local index = bulkIndexes[part]
		if index then
			bulkCFrames[index] = value
		else
			index = #bulkParts + 1
			bulkIndexes[part] = index
			bulkParts[index] = part
			bulkCFrames[index] = value
		end
	end
	local function keepClipPartsActive(clip)
		if clip.captureType == "Objects" then
			for _, target in ipairs(clip.targets or {}) do
				local instance = target.instance
				if instance and instance.Parent then
					if instance:IsA("BasePart") then
						anchorPart(instance)
					elseif instance:IsA("Model") then
						for _, part in ipairs(target.parts or {}) do
							if part and part.Parent then
								anchorPart(part)
							end
						end
					end
				end
			end
		else
			for _, part in pairs(clip.partsByName or {}) do
				if part and part.Parent then
					anchorPart(part)
				end
			end
		end
	end
	for _, clip in ipairs(state and state.clips or {}) do
		local preparedClip = clip.preparedClip
		local holdingFinalPose = skipRepeatedFinalPoses
			and clip.holdingFinalPose == true
			and preparedClip ~= nil
		if holdingFinalPose then
			activeHeldFinalClips[preparedClip] = true
		end
		local skipClipMove = holdingFinalPose
			and self.playbackHeldFinalClips[preparedClip] == clip.time
		if skipClipMove then
			keepClipPartsActive(clip)
		elseif clip.captureType == "Objects" then
			local sharedFirstIndex = nil
			local sharedSecondIndex = nil
			local sharedAlpha = nil
			if clip.capture.sharedSamples then
				sharedFirstIndex, sharedSecondIndex, sharedAlpha = findSamplePairIndexes(
					clip.capture.sharedSamples,
					clip.time
				)
			end
			for _, target in ipairs(clip.targets or {}) do
				local instance = target.instance
				if instance and instance.Parent then
					local first, second, alpha
					if sharedFirstIndex and target.samples[sharedSecondIndex] then
						first = target.samples[sharedFirstIndex]
						second = target.samples[sharedSecondIndex]
						alpha = sharedAlpha
					else
						first, second, alpha = findSamplePair(target.samples, clip.time)
					end
					local value = second.value and first.value:Lerp(second.value, alpha) or first.value
					if instance:IsA("BasePart") then
						queuePart(instance, value)
					elseif instance:IsA("Model") then
						for _, part in ipairs(target.parts or {}) do
							if part and part.Parent then
								anchorPart(part)
							end
						end
						instance:PivotTo(value)
					end
				end
			end
		else
			local rig = clip.rig
			if rig and rig.Parent then
			local first, second, alpha = findSamplePair(clip.capture.samples, clip.time)
			for partName, firstValue in pairs(first.parts) do
				local part = clip.partsByName[partName]
				if part and part.Parent then
					local secondValue = second.parts[partName]
					queuePart(part, secondValue and firstValue:Lerp(secondValue, alpha) or firstValue)
				end
			end
			end
		end
		if holdingFinalPose and not skipClipMove then
			self.playbackHeldFinalClips[preparedClip] = clip.time
		end
	end
	for preparedClip in pairs(self.playbackHeldFinalClips) do
		if not activeHeldFinalClips[preparedClip] then
			self.playbackHeldFinalClips[preparedClip] = nil
		end
	end

	if #bulkParts &gt; 0 then
		local moved = pcall(function()
			workspace:BulkMoveTo(bulkParts, bulkCFrames, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not moved then
			for index, part in ipairs(bulkParts) do
				if part and part.Parent then
					part.CFrame = bulkCFrames[index]
				end
			end
		end
	end

	for part, wasAnchored in pairs(self.anchoredParts) do
		if not activeParts[part] then
			if part and part.Parent then
				part.Anchored = wasAnchored
			end
			self.anchoredParts[part] = nil
		end
	end
end

function PhysicsRuntimeClipSupport:_collectCapturedRigParts(state)
	local capturedPartsByRig = {}
	local function addPart(part, knownRig)
		if not (part and part.Parent and part:IsA("BasePart")) then
			return
		end
		local rig = knownRig
		local ancestor = rig or part.Parent
		while not rig and ancestor and ancestor ~= workspace do
			if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
				rig = ancestor
				break
			end
			ancestor = ancestor.Parent
		end
		if not (rig and rig.Parent) then
			return
		end
		capturedPartsByRig[rig] = capturedPartsByRig[rig] or {}
		capturedPartsByRig[rig][part] = true
	end

	for _, clip in ipairs(state and state.clips or {}) do
		if clip.captureType == "Rig" then
			for _, part in pairs(clip.partsByName or {}) do
				addPart(part, clip.rig)
			end
		elseif clip.captureType == "Objects" then
			for _, target in ipairs(clip.targets or {}) do
				local instance = target.instance
				if instance and instance.Parent then
					if instance:IsA("BasePart") then
						addPart(instance)
					elseif instance:IsA("Model") then
						for _, part in ipairs(target.parts or {}) do
							addPart(part)
						end
					end
				end
			end
		end
	end
	return capturedPartsByRig
end

function PhysicsRuntimeClipSupport:restoreHandoffJoints()
	local restoredCount = 0
	for motor, originalC0 in pairs(self.handoffMotorC0s) do
		if motor and motor.Parent and typeof(originalC0) == "CFrame" then
			motor.C0 = originalC0
			restoredCount += 1
		end
	end
	table.clear(self.handoffMotorC0s)
	return restoredCount
end

function PhysicsRuntimeClipSupport:handoff(state, rememberPreviousJoints)
	-- Keep the exact captured world-space pose when temporary Physics playback
	-- releases ownership. Rebuilding the ordinary timeline pose here makes a
	-- ragdoll snap back to its keyed/default Motor6D pose on pause or at the end.
	local shouldRememberPreviousJoints = rememberPreviousJoints ~= false
	if not shouldRememberPreviousJoints then
		table.clear(self.handoffMotorC0s)
	end
	self:apply(state)
	for rig, capturedParts in pairs(self:_collectCapturedRigParts(state)) do
		for _, descendant in ipairs(rig:GetDescendants()) do
			if descendant:IsA("Motor6D")
				and capturedParts[descendant.Part0]
				and capturedParts[descendant.Part1] then
				if shouldRememberPreviousJoints and self.handoffMotorC0s[descendant] == nil then
					self.handoffMotorC0s[descendant] = descendant.C0
				end
				descendant.C0 = descendant.Part0.CFrame:ToObjectSpace(descendant.Part1.CFrame * descendant.C1)
			end
		end
	end
	self:restore()
	if not shouldRememberPreviousJoints then
		table.clear(self.handoffMotorC0s)
	end
end

function PhysicsRuntimeClipSupport:restore()
	self:_restoreEmitterTimeScales()
	table.clear(self.playbackHeldFinalClips)
	for part, wasAnchored in pairs(self.anchoredParts) do
		if part and part.Parent then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
			part.Anchored = wasAnchored
		end
	end
	table.clear(self.anchoredParts)
end

return PhysicsRuntimeClipSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX199">
        <Properties>
          <string name="Name">PhysicsThemeSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local PhysicsThemeSupport = {}

local BACKGROUND_ROLE_ATTRIBUTE = "MegMoThemeBackgroundRole"
local SCROLL_ROLE_ATTRIBUTE = "MegMoThemeScrollRole"
local TEXT_ROLE_ATTRIBUTE = "MegMoThemeTextRole"
local STROKE_ROLE_ATTRIBUTE = "MegMoThemeStrokeRole"

local appliedSignatures = setmetatable({}, { __mode = "k" })

local LEGACY_BACKGROUND_ROLES = {
	Background = {
		Color3.fromRGB(7, 11, 18),
		Color3.fromRGB(10, 14, 22),
	},
	Panel = {
		Color3.fromRGB(12, 18, 29),
		Color3.fromRGB(13, 18, 29),
		Color3.fromRGB(15, 21, 32),
		Color3.fromRGB(16, 23, 36),
		Color3.fromRGB(20, 27, 42),
	},
	PanelAlt = {
		Color3.fromRGB(17, 25, 39),
		Color3.fromRGB(20, 29, 44),
		Color3.fromRGB(22, 29, 43),
	},
	PanelSoft = {
		Color3.fromRGB(31, 40, 58),
		Color3.fromRGB(37, 47, 70),
		Color3.fromRGB(43, 53, 76),
		Color3.fromRGB(44, 52, 69),
	},
}

local LEGACY_TEXT_ROLES = {
	Text = {
		Color3.fromRGB(240, 244, 255),
		Color3.fromRGB(244, 247, 255),
		Color3.fromRGB(247, 249, 255),
		Color3.fromRGB(255, 255, 255),
	},
	MutedText = {
		Color3.fromRGB(158, 170, 197),
		Color3.fromRGB(202, 211, 229),
		Color3.fromRGB(218, 225, 240),
	},
}

local LEGACY_BORDER_COLORS = {
	Color3.fromRGB(53, 64, 84),
	Color3.fromRGB(56, 65, 84),
	Color3.fromRGB(56, 68, 91),
	Color3.fromRGB(61, 74, 96),
}

local function colorsMatch(a, b)
	if typeof(a) ~= "Color3" or typeof(b) ~= "Color3" then
		return false
	end
	return math.abs(a.R - b.R) &lt; 0.002
		and math.abs(a.G - b.G) &lt; 0.002
		and math.abs(a.B - b.B) &lt; 0.002
end

local function roleForColor(color, legacyRoles, currentColors)
	for roleName, legacyColors in pairs(legacyRoles) do
		if colorsMatch(color, currentColors[roleName]) then
			return roleName
		end
		for _, legacyColor in ipairs(legacyColors) do
			if colorsMatch(color, legacyColor) then
				return roleName
			end
		end
	end
	return nil
end

local function nearestVisibleBackgroundRole(instance, currentColors)
	local current = instance.Parent
	while current do
		if current:IsA("GuiObject") and current.BackgroundTransparency &lt; 0.95 then
			return current:GetAttribute(BACKGROUND_ROLE_ATTRIBUTE)
				or roleForColor(current.BackgroundColor3, LEGACY_BACKGROUND_ROLES, currentColors)
		end
		current = current.Parent
	end
	return nil
end

local function readableTextColor(backgroundColor)
	local function linearChannel(channel)
		if channel &lt;= 0.04045 then
			return channel / 12.92
		end
		return ((channel + 0.055) / 1.055) ^ 2.4
	end
	local luminance = (0.2126 * linearChannel(backgroundColor.R))
		+ (0.7152 * linearChannel(backgroundColor.G))
		+ (0.0722 * linearChannel(backgroundColor.B))
	return luminance &gt; 0.179
		and Color3.fromRGB(20, 24, 32)
		or Color3.fromRGB(245, 248, 255)
end

local function currentSignature()
	local colors = Constants.THEME
	return table.concat({
		tostring(Constants.CURRENT_THEME_ID or ""),
		tostring(colors.Background),
		tostring(colors.Panel),
		tostring(colors.PanelAlt),
		tostring(colors.PanelSoft),
		tostring(colors.Text),
		tostring(colors.MutedText),
		tostring(colors.Border),
	}, "|")
end

function PhysicsThemeSupport.SyncPalette(palette)
	if type(palette) ~= "table" then
		return nil
	end
	local colors = Constants.THEME
	local previousMuted = palette.muted
	palette.background = colors.Background
	palette.panel = colors.Panel
	palette.panelAlt = colors.PanelAlt
	palette.button = colors.PanelSoft
	palette.border = colors.Border
	palette.text = colors.Text
	palette.muted = colors.MutedText
	return previousMuted
end

function PhysicsThemeSupport.Apply(root, palette)
	if not root then
		return currentSignature()
	end

	PhysicsThemeSupport.SyncPalette(palette)
	local colors = Constants.THEME
	local instances = { root }
	for _, descendant in ipairs(root:GetDescendants()) do
		table.insert(instances, descendant)
	end

	for _, instance in ipairs(instances) do
		if instance:IsA("GuiObject") then
			if instance.BackgroundTransparency &lt; 1 then
				local backgroundRole = instance:GetAttribute(BACKGROUND_ROLE_ATTRIBUTE)
					or roleForColor(instance.BackgroundColor3, LEGACY_BACKGROUND_ROLES, colors)
				if backgroundRole and colors[backgroundRole] then
					instance:SetAttribute(BACKGROUND_ROLE_ATTRIBUTE, backgroundRole)
					instance.BackgroundColor3 = colors[backgroundRole]
				end
			end

			if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
				local textRole = instance:GetAttribute(TEXT_ROLE_ATTRIBUTE)
				local backgroundRole = instance:GetAttribute(BACKGROUND_ROLE_ATTRIBUTE)
				if (instance:IsA("TextButton") or instance:IsA("TextBox")) and backgroundRole then
					instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, "__physics_auto")
					instance.TextColor3 = readableTextColor(colors[backgroundRole])
				elseif not textRole then
					local surfaceRole = nil
					if instance.BackgroundTransparency &lt; 0.95 then
						surfaceRole = backgroundRole
					else
						surfaceRole = nearestVisibleBackgroundRole(instance, colors)
					end
					if surfaceRole then
						textRole = roleForColor(instance.TextColor3, LEGACY_TEXT_ROLES, colors)
					end
				end
				if textRole and colors[textRole] then
					instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, textRole)
					instance.TextColor3 = colors[textRole]
				end
			end

			if instance:IsA("ScrollingFrame") then
				instance:SetAttribute(SCROLL_ROLE_ATTRIBUTE, "Accent")
				instance.ScrollBarImageColor3 = colors.Accent
			end
		elseif instance:IsA("UIStroke") then
			local strokeRole = instance:GetAttribute(STROKE_ROLE_ATTRIBUTE)
			if not strokeRole then
				if colorsMatch(instance.Color, colors.Border) then
					strokeRole = "Border"
				else
					for _, legacyColor in ipairs(LEGACY_BORDER_COLORS) do
						if colorsMatch(instance.Color, legacyColor) then
							strokeRole = "Border"
							break
						end
					end
				end
			end
			if strokeRole == "Border" then
				instance:SetAttribute(STROKE_ROLE_ATTRIBUTE, "Border")
				instance.Color = colors.Border
			end
		end
	end

	local signature = currentSignature()
	appliedSignatures[root] = signature
	return signature
end

function PhysicsThemeSupport.ApplyIfChanged(root, palette)
	local signature = currentSignature()
	if appliedSignatures[root] == signature then
		return false, nil
	end
	local previousMuted = palette and palette.muted or nil
	PhysicsThemeSupport.Apply(root, palette)
	return true, previousMuted
end

return PhysicsThemeSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX200">
        <Properties>
          <string name="Name">PlaybackService</string>
          <ProtectedString name="Source">local RunService = game:GetService("RunService")

local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))
local PreviewBakeService = require(script.Parent:WaitForChild("PreviewBakeService"))
local PhysicsRuntimeClipSupport = require(script.Parent:WaitForChild("PhysicsRuntimeClipSupport"))

local PlaybackService = {}
PlaybackService.__index = PlaybackService

local function getTimelinePlaybackFeatures(timeline)
	local hasAttachmentEvents = false
	local hasVisualEffects = false
	local hasTimelineOneShots = false
	for _, track in ipairs(timeline:getTracks()) do
		if track.trackType == "Event" or track.valueType == "Event" or track.targetScope == "Event" then
			hasAttachmentEvents = true
			hasTimelineOneShots = true
		end
		if track.valueType == "ParticleEvent"
			or track.targetScope == "ParticleEvent"
			or track.trackType == "Sound"
			or track.valueType == "Sound"
			or track.targetScope == "Sound" then
			hasTimelineOneShots = true
		end
		if track.trackType == "Screen Effect"
			or track.trackType == "Lighting Effect"
			or track.trackType == "Face"
			or track.targetScope == "Face"
			or track.valueType == "Face" then
			hasVisualEffects = true
		end
		if hasAttachmentEvents and hasVisualEffects and hasTimelineOneShots then
			break
		end
	end
	return hasAttachmentEvents, hasVisualEffects, hasTimelineOneShots
end

function PlaybackService.new(deps)
	local service = setmetatable({
		timeline = deps.timeline,
		gizmoController = deps.gizmoController,
		widgetController = deps.widgetController,
		refreshUi = deps.refreshUi,
		refreshBakeStatus = deps.refreshBakeStatus or deps.refreshUi,
		getTimelineRevision = deps.getTimelineRevision or function() return nil end,
		renderEffects = deps.renderEffects or function() end,
		applyCameraLinks = deps.applyCameraLinks or function() end,
		onStop = deps.onStop or function() end,
		prepareAttachments = deps.prepareAttachments or function() end,
		applyAttachments = deps.applyAttachments or function() end,
		restoreAttachments = deps.restoreAttachments or function() end,
		setMotionMarkersVisible = deps.setMotionMarkersVisible or function() end,
		previewBakeService = deps.previewBakeService or PreviewBakeService.new(),
		physicsPreparedRevision = nil,
		isPlaying = false,
		playbackConnection = nil,
		renderPlaybackConnection = nil,
		playbackFrame = nil,
		uiUpdateInterval = deps.uiUpdateInterval or (1 / 15),
		previewApplyInterval = math.max(0, tonumber(deps.previewApplyInterval) or 0),
	}, PlaybackService)
	service.physicsRuntimeClipSupport = PhysicsRuntimeClipSupport.new(deps.timeline, deps.keyframeEditService)
	return service
end

function PlaybackService:getIsPlaying()
	return self.isPlaying
end

function PlaybackService:getPlaybackFrame()
	return self.playbackFrame
end

function PlaybackService:applyScrubFrame(frame, refreshPhysicsClips)
	frame = math.max(0, tonumber(frame) or self.timeline:getCurrentFrame())
	if refreshPhysicsClips or self.physicsRuntimeClipSupport:getPrepareReport() == nil then
		self.physicsRuntimeClipSupport:prepare()
	end

	local physicsState = self.physicsRuntimeClipSupport:getFrameState(frame)
	local restoringPhysicsStart = frame &lt;= 0.001
	if restoringPhysicsStart then
		self.physicsRuntimeClipSupport:restoreHandoffJoints()
		-- Frame zero must restore every Physics Clip's initial pose, including
		-- staggered clips that have not started yet. Using getFrameState(0) alone
		-- only includes clips whose block begins at frame zero.
		physicsState = self.physicsRuntimeClipSupport:getInitialFrameState()
	end
	local prepareReport = self.physicsRuntimeClipSupport:getPrepareReport()
	if #physicsState.clips == 0
		and not refreshPhysicsClips
		and prepareReport
		and prepareReport.physicsGroups == 0
		and self.physicsRuntimeClipSupport:hasPhysicsClipGroups() then
		-- Saved groups can finish loading after the first UI scrub callback. Avoid
		-- keeping that initial empty preparation result until Play is pressed.
		self.physicsRuntimeClipSupport:prepare()
		physicsState = restoringPhysicsStart
			and self.physicsRuntimeClipSupport:getInitialFrameState()
			or self.physicsRuntimeClipSupport:getFrameState(frame)
	end
	if #physicsState.clips == 0 then
		self.physicsRuntimeClipSupport:restoreHandoffJoints()
		self.physicsRuntimeClipSupport:restore()
		return self.timeline:applyFrame(frame)
	end

	local pose = select(1, self.timeline:samplePose(frame))
	if pose then
		self.timeline:applyPoseSnapshot(
			PhysicsRuntimeClipSupport.FilterPose(pose, physicsState.suppressedPaths)
		)
	end
	-- Scrubbing must be stateless. Playback handoff writes the displayed world
	-- pose back into Motor6D.C0 so a paused pose survives after parts are released;
	-- doing that on every scrub makes the next scrub depend on the previous one.
	-- Keep the captured parts temporarily anchored instead, so every requested
	-- frame is reconstructed directly from its saved world-space samples.
	if restoringPhysicsStart then
		self.physicsRuntimeClipSupport:handoff(physicsState, false)
	else
		self.physicsRuntimeClipSupport:apply(physicsState)
	end
	self.physicsRuntimeClipSupport:freezeEmitters(physicsState)
	return true, string.format("Previewed exact Physics pose at frame %.2f.", frame)
end

local function getSoundClipLastFrame(timeline)
	if not timeline or type(timeline.getSoundClipDataByPath) ~= "function" then
		return nil
	end

	local latestFrame = nil
	for _, clips in pairs(timeline:getSoundClipDataByPath() or {}) do
		for _, clip in ipairs(clips or {}) do
			local endFrame = tonumber(clip and clip.endFrame)
			if endFrame then
				latestFrame = latestFrame and math.max(latestFrame, endFrame) or endFrame
			end
		end
	end
	return latestFrame
end

local function triggerTimelineOneShots(timeline, startFrame, endFrame)
	timeline:triggerParticleEventsBetween(startFrame, endFrame)
	if timeline.triggerSoundEventsBetween then
		timeline:triggerSoundEventsBetween(startFrame, endFrame)
	end
	if timeline.triggerEventScriptsBetween then
		timeline:triggerEventScriptsBetween(startFrame, endFrame)
	end
end

function PlaybackService:bakePreview()
	if #self.timeline:getTracks() == 0 then
		self.refreshBakeStatus("Add a rig or object track before baking preview.")
		return false
	end

	if self.timeline:getKeyframeCount() == 0 then
		self.refreshBakeStatus("Add at least one keyframe before baking preview.")
		return false
	end

	if self.isPlaying then
		self:stop("Stopped playback before baking preview.", self.playbackFrame)
	end

	self.refreshBakeStatus("Preparing Preview...")
	if self.widgetController and self.widgetController.showBakeProgress then
		self.widgetController:showBakeProgress("Preparing Preview", "Building optimized playback data...", 0.12)
	end
	local perfToken = PerformanceDebugService.begin("Preview Bake")
	local bakeOk, cache, rebuilt, message = pcall(function()
		return self.previewBakeService:ensureCache(self.timeline, self.getTimelineRevision())
	end)
	PerformanceDebugService.finish(perfToken, rebuilt and "rebuilt" or "cached")
	if not bakeOk then
		warn("[7kg2 Animator] Manual preview bake failed:", cache)
		if self.widgetController and self.widgetController.updateBakeProgress then
			self.widgetController:updateBakeProgress(1, "Preview cache failed. Realtime playback is still available.")
		end
		if self.widgetController and self.widgetController.hideBakeProgress then
			task.delay(0.8, function()
				self.widgetController:hideBakeProgress()
			end)
		end
		self.refreshBakeStatus("Preview cache failed; realtime playback is still available.")
		return false
	end

	local status = message or (rebuilt and "Prepared preview cache." or "Using cached preview.")
	if rebuilt and cache and cache.keyCount and cache.keyCount &gt;= 1500 then
		status = status .. " This timeline has many keyframes; cached preview is recommended."
	end
	if self.physicsRuntimeClipSupport:hasPhysicsClipGroups() then
		self.refreshBakeStatus("Preparing Physics Playback...")
		if self.widgetController and self.widgetController.updateBakeProgress then
			self.widgetController:updateBakeProgress(0.72, "Preparing exact Physics playback...")
		end
		local physicsPerfToken = PerformanceDebugService.begin("Physics Preview Bake")
		local physicsOk, physicsResult = pcall(function()
			self.physicsRuntimeClipSupport:prepare()
			return self.physicsRuntimeClipSupport:getPrepareReport()
		end)
		PerformanceDebugService.finish(physicsPerfToken, physicsOk and "prepared" or "failed")
		if physicsOk then
			local physicsReport = physicsResult
			self.physicsPreparedRevision = self.getTimelineRevision()
			if physicsReport and physicsReport.preparedClips &gt; 0 then
				status = status .. string.format(
					" Prepared exact Physics playback: %d clip%s, %d parts.",
					physicsReport.preparedClips,
					physicsReport.preparedClips == 1 and "" or "s",
					physicsReport.preparedParts
				)
			else
				status = status .. " Physics clips will use editable timeline keys."
			end
		else
			self.physicsPreparedRevision = nil
			warn("[7kg2 Animator] Physics preview bake failed; Play will retry:", physicsResult)
			status = status .. " Physics preparation failed; Play will retry."
		end
	end
	if self.widgetController and self.widgetController.updateBakeProgress then
		self.widgetController:updateBakeProgress(1, status)
	end
	if self.widgetController and self.widgetController.hideBakeProgress then
		task.delay(0.45, function()
			self.widgetController:hideBakeProgress()
		end)
	end
	self.refreshBakeStatus(status)
	return true
end

function PlaybackService:stop(message, snapFrame, freezePhysicsVfx)
	self.isPlaying = false
	if self.playbackConnection then
		self.playbackConnection:Disconnect()
		self.playbackConnection = nil
	end
	if self.renderPlaybackConnection then
		self.renderPlaybackConnection:Disconnect()
		self.renderPlaybackConnection = nil
	end
	if snapFrame ~= nil then
		self.timeline:setCurrentFrame(snapFrame)
		self.prepareAttachments(snapFrame)
		local physicsState = self.physicsRuntimeClipSupport:getFrameState(snapFrame)
		local resetToStart = math.floor(tonumber(snapFrame) or 0) &lt;= 0
		if resetToStart then
			self.physicsRuntimeClipSupport:restoreHandoffJoints()
			-- Reset all Physics targets, not only clips already active at frame zero.
			-- This is required when closing or starting a new staggered project.
			physicsState = self.physicsRuntimeClipSupport:getInitialFrameState()
		end
		if #physicsState.clips &gt; 0 then
			local pose = select(1, self.timeline:samplePose(snapFrame))
			if pose then
				self.timeline:applyPoseSnapshot(
					PhysicsRuntimeClipSupport.FilterPose(pose, physicsState.suppressedPaths)
				)
			end
			self.physicsRuntimeClipSupport:handoff(physicsState, not resetToStart)
			if freezePhysicsVfx then
				self.physicsRuntimeClipSupport:freezeEmitters(physicsState)
			end
		else
			self.physicsRuntimeClipSupport:restoreHandoffJoints()
			self.physicsRuntimeClipSupport:restore()
			self.timeline:applyCurrentFrame()
		end
		self.applyAttachments(snapFrame)
		self.applyCameraLinks(snapFrame)
		self.renderEffects(snapFrame)
	else
		self.physicsRuntimeClipSupport:restore()
	end
	if self.timeline.stopSoundTracks then
		self.timeline:stopSoundTracks()
	end
	if snapFrame == nil or math.floor(tonumber(snapFrame) or 0) &lt;= 0 then
		if self.timeline.clearEventScriptPreviewObjects then
			self.timeline:clearEventScriptPreviewObjects()
		end
		self.restoreAttachments()
	end
	self.playbackFrame = nil
	self.gizmoController:setSuppressed(false)
	self.setMotionMarkersVisible(true)
	self.onStop()
	self.refreshUi(message or "Stopped playback.")
	if snapFrame ~= nil and self.widgetController and self.widgetController.updateScrubFrame then
		self.widgetController:updateScrubFrame(snapFrame, message)
	end
end

function PlaybackService:start()
	if #self.timeline:getTracks() == 0 then
		self.refreshUi("Add a rig, object, camera, or sound track before playing the timeline.")
		return
	end

	if self.timeline:getKeyframeCount() == 0 then
		self.refreshUi("Add at least one keyframe before playing.")
		return
	end

	if self.isPlaying then
		self:stop("Paused playback.", self.playbackFrame, true)
		return
	end

	self.isPlaying = true
	self.gizmoController:setSuppressed(true)
	self.setMotionMarkersVisible(false)
	local fps = self.timeline:getFps()
	local durationLastFrame = math.max(0, self.timeline:getDurationFrames())
	local firstKeyframe = self.timeline:getFirstKeyframe() or 0
	local lastKeyframe = self.timeline:getLastKeyframe() or durationLastFrame
	local soundClipLastFrame = getSoundClipLastFrame(self.timeline)
	if soundClipLastFrame then
		lastKeyframe = math.max(lastKeyframe, soundClipLastFrame)
	end
	lastKeyframe = math.min(lastKeyframe, durationLastFrame)
	firstKeyframe = math.min(firstKeyframe, lastKeyframe)
	local previewCache = nil
	local cacheMessage = nil
	local shouldShowPrepare = self.timeline:getKeyframeCount() &gt; 60 or #self.timeline:getTracks() &gt; 24
	if shouldShowPrepare then
		self.refreshUi("Preparing Preview...")
	end
	local perfToken = PerformanceDebugService.begin("Preview Bake")
	local bakeOk, cache, rebuilt, message = pcall(function()
		return self.previewBakeService:ensureCache(self.timeline, self.getTimelineRevision())
	end)
	PerformanceDebugService.finish(perfToken, rebuilt and "rebuilt" or "cached")
	if bakeOk then
		previewCache = cache
		cacheMessage = message
		if rebuilt and cache and cache.keyCount and cache.keyCount &gt;= 1500 then
			cacheMessage = cacheMessage .. " This timeline has many keyframes; cached preview is recommended."
		end
	else
		warn("[7kg2 Animator] Preview cache failed, falling back to realtime playback:", cache)
		cacheMessage = "Preview cache unavailable; using realtime playback."
	end
	local playbackStatus = cacheMessage or "Playing timeline preview..."
	local previewApplyInterval = self.previewApplyInterval
	local physicsRevision = self.getTimelineRevision()
	local physicsReport = self.physicsRuntimeClipSupport:getPrepareReport()
	local reusePreparedPhysics = physicsRevision ~= nil
		and self.physicsPreparedRevision == physicsRevision
		and physicsReport ~= nil
	if not reusePreparedPhysics then
		self.physicsRuntimeClipSupport:prepare()
		physicsReport = self.physicsRuntimeClipSupport:getPrepareReport()
	end
	-- Manual Bake prepares the next Play. Once playback consumes that prepared
	-- state, later Play presses may need to restore emitter timing again.
	self.physicsPreparedRevision = nil
	local hasAttachmentEvents, hasVisualEffects, hasTimelineOneShots = getTimelinePlaybackFeatures(self.timeline)
	if physicsReport and physicsReport.physicsGroups &gt; 0 then
		if physicsReport.preparedClips &gt; 0 then
			playbackStatus = playbackStatus .. string.format(
				" Exact Physics playback: %d clip%s, %d parts.",
				physicsReport.preparedClips,
				physicsReport.preparedClips == 1 and "" or "s",
				physicsReport.preparedParts
			)
		else
			local rejectionParts = {}
			for reason, count in pairs(physicsReport.rejected or {}) do
				-- A reversed or otherwise editable Physics Clip deliberately drops
				-- its exact runtime capture and plays from its timeline keys. That is
				-- a normal state, so do not report it as an Output warning on every Play.
				if reason ~= "missing capture" then
					rejectionParts[#rejectionParts + 1] = string.format("%s (%d)", reason, count)
				end
			end
			table.sort(rejectionParts)
			playbackStatus = playbackStatus .. " Using editable Physics keys."
			if #rejectionParts &gt; 0 then
				warn("[7kg2 Animator] Exact Physics playback was not prepared:", table.concat(rejectionParts, ", "))
			end
		end
	end

	local function applyPreviewFrame(frame)
		if hasAttachmentEvents then
			self.prepareAttachments(frame)
		end
		local physicsState = self.physicsRuntimeClipSupport:getFrameState(frame)
		if #physicsState.clips == 0 then
			self.physicsRuntimeClipSupport:restoreHandoffJoints()
		end
		if previewCache then
			self.previewBakeService:applyFrame(self.timeline, previewCache, frame, physicsState.suppressedPaths)
		else
			local pose = select(1, self.timeline:samplePose(frame))
			if pose then
				self.timeline:applyPoseSnapshot(PhysicsRuntimeClipSupport.FilterPose(pose, physicsState.suppressedPaths))
			end
		end
		self.physicsRuntimeClipSupport:apply(physicsState, true)
		if hasAttachmentEvents then
			self.applyAttachments(frame)
		end
		self.applyCameraLinks(frame)
		if hasVisualEffects then
			self.renderEffects(frame)
		end
	end

	local elapsedFrames = self.timeline:getCurrentFrame()
	if (not self.timeline:getLooping() and elapsedFrames &gt;= lastKeyframe) or elapsedFrames &gt; lastKeyframe then
		elapsedFrames = firstKeyframe
	end
	if elapsedFrames &lt;= firstKeyframe + 0.001 and self.timeline.clearEventScriptPreviewObjects then
		self.timeline:clearEventScriptPreviewObjects()
	end
	self.timeline:setCurrentFrame(elapsedFrames)
	if not hasAttachmentEvents then
		self.prepareAttachments(elapsedFrames)
	end
	applyPreviewFrame(elapsedFrames)
	if not hasAttachmentEvents then
		self.applyAttachments(elapsedFrames)
	end
	if not hasVisualEffects then
		self.renderEffects(elapsedFrames)
	end
	self.playbackFrame = elapsedFrames
	local hasExactPhysics = physicsReport and (tonumber(physicsReport.preparedClips) or 0) &gt; 0
	if hasTimelineOneShots and not hasExactPhysics then
		triggerTimelineOneShots(self.timeline, elapsedFrames - 0.001, elapsedFrames)
	end
	if self.timeline.resumeSoundTracksAtFrame then
		self.timeline:resumeSoundTracksAtFrame(elapsedFrames)
	end
	local lastTick = os.clock()
	local lastUiUpdate = 0
	local previewApplyAccumulator = 0

	local function advancePlayback(deltaValue)
		if not self.isPlaying then
			return false
		end

		local now = os.clock()
		local delta = math.max(0, tonumber(deltaValue) or (now - lastTick))
		lastTick = now
		local previousFrame = elapsedFrames
		elapsedFrames += delta * fps
		self.playbackFrame = elapsedFrames
		local playbackEndFrame = math.min(lastKeyframe, math.max(0, self.timeline:getDurationFrames()))
		local playbackStartFrame = math.min(firstKeyframe, playbackEndFrame)

		if elapsedFrames &gt; playbackEndFrame then
			if self.timeline:getLooping() then
				if hasTimelineOneShots and previousFrame &lt; playbackEndFrame then
					triggerTimelineOneShots(self.timeline, previousFrame, playbackEndFrame)
				end
				local overflow = elapsedFrames - playbackEndFrame
				elapsedFrames = playbackStartFrame + math.max(0, overflow)
				self.playbackFrame = elapsedFrames
				if hasTimelineOneShots then
					triggerTimelineOneShots(self.timeline, playbackStartFrame - 0.001, elapsedFrames)
				end
			else
				if hasTimelineOneShots and previousFrame &lt; playbackEndFrame then
					triggerTimelineOneShots(self.timeline, previousFrame, playbackEndFrame)
				end
				self.timeline:setCurrentFrame(playbackEndFrame)
				applyPreviewFrame(playbackEndFrame)
				self.playbackFrame = playbackEndFrame
				self:stop("Reached the end of the timeline.", playbackEndFrame)
				return false
			end
		elseif hasTimelineOneShots then
			triggerTimelineOneShots(self.timeline, previousFrame, elapsedFrames)
		end

		if now - lastUiUpdate &gt;= self.uiUpdateInterval then
			lastUiUpdate = now
			self.widgetController:updatePlaybackFrame(elapsedFrames, playbackStatus)
		end
		return true
	end

	if hasExactPhysics then
		-- Physics Preview advances and applies its interpolated samples from one
		-- visual clock. Do the same for exact timeline clips so RenderStepped
		-- never renders the previous Heartbeat value, which was visible as jitter
		-- when many captured rig parts were playing together.
		local waitingForFirstRenderedFrame = true
		self.renderPlaybackConnection = RunService.RenderStepped:Connect(function(renderDelta)
			if waitingForFirstRenderedFrame then
				-- RenderStepped's first delta can include the synchronous preparation
				-- time that happened before this connection was made. Keep the already
				-- applied starting pose for one rendered frame instead of skipping the
				-- beginning of a large exact Physics clip.
				waitingForFirstRenderedFrame = false
				lastTick = os.clock()
				-- Frame-zero particle bursts must be emitted after Roblox has consumed
				-- that stale render delta. Short-lived VFX can otherwise age past their
				-- complete lifetime before the first prepared Physics frame is shown.
				if hasTimelineOneShots then
					triggerTimelineOneShots(self.timeline, elapsedFrames - 0.001, elapsedFrames)
				end
				return
			end
			if advancePlayback(renderDelta) then
				applyPreviewFrame(elapsedFrames)
			end
		end)
	else
		self.renderPlaybackConnection = RunService.RenderStepped:Connect(function(renderDelta)
			if not advancePlayback(renderDelta) then
				return
			end

			previewApplyAccumulator += math.max(0, tonumber(renderDelta) or 0)
			if previewApplyInterval &gt; 0 and previewApplyAccumulator &lt; previewApplyInterval then
				return
			end
			if previewApplyInterval &gt; 0 then
				previewApplyAccumulator %= previewApplyInterval
			else
				previewApplyAccumulator = 0
			end
			applyPreviewFrame(elapsedFrames)
		end)
	end

	self.refreshUi(playbackStatus)
end

return PlaybackService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX201">
        <Properties>
          <string name="Name">PluginSettings</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local PluginSettings = {}

local PREFERRED_FPS_SETTING_KEY = "MegMoPreferredFPS"
local GIZMO_SIZE_SETTING_KEY = "MegMoAnimatorGizmoSizePercent"

local function normalizePreferredFps(value)
	local fps = tonumber(value)
	if not fps then
		return nil
	end
	return math.clamp(math.floor(fps + 0.5), 1, 240)
end

local function normalizeGizmoSizePercent(value)
	local percent = tonumber(value)
	if not percent then
		return nil
	end
	return math.clamp(
		math.floor(percent + 0.5),
		Constants.MIN_GIZMO_SIZE_PERCENT or 60,
		Constants.MAX_GIZMO_SIZE_PERCENT or 140
	)
end

function PluginSettings.getPreferredFps(plugin)
	local savedFps
	pcall(function()
		savedFps = plugin:GetSetting(PREFERRED_FPS_SETTING_KEY)
	end)
	return normalizePreferredFps(savedFps) or Constants.DEFAULT_FPS
end

function PluginSettings.savePreferredFps(plugin, fps)
	local normalized = normalizePreferredFps(fps)
	if not normalized then
		return nil
	end
	pcall(function()
		plugin:SetSetting(PREFERRED_FPS_SETTING_KEY, normalized)
	end)
	return normalized
end

function PluginSettings.getGizmoSizePercent(plugin)
	local savedSize
	pcall(function()
		savedSize = plugin:GetSetting(GIZMO_SIZE_SETTING_KEY)
	end)
	return normalizeGizmoSizePercent(savedSize) or Constants.DEFAULT_GIZMO_SIZE_PERCENT or 100
end

function PluginSettings.saveGizmoSizePercent(plugin, percent)
	local normalized = normalizeGizmoSizePercent(percent)
	if not normalized then
		return nil
	end
	pcall(function()
		plugin:SetSetting(GIZMO_SIZE_SETTING_KEY, normalized)
	end)
	return normalized
end

return PluginSettings
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX202">
        <Properties>
          <string name="Name">PoseKeyframeActionSupport</string>
          <ProtectedString name="Source">local PoseKeyframeActionSupport = {}

local function normalizeFrame(frame)
	return math.max(0, math.floor(tonumber(frame) or 0))
end

local function getSelectedKeyRefs(args)
	local selectionState = args.selectionState
	if selectionState and type(selectionState.getSelectedKeyRefs) == "function" then
		return selectionState.getSelectedKeyRefs(args.selectedKeys) or {}
	end
	return {}
end

local function getSelectedKeyPaths(args)
	local paths = {}
	local seen = {}
	for _, keyRef in ipairs(getSelectedKeyRefs(args)) do
		local path = keyRef.jointPath or keyRef.path
		if type(path) == "string" and not seen[path] and args.timeline and args.timeline:getTrackByPath(path) then
			seen[path] = true
			table.insert(paths, path)
		end
	end
	return paths
end

local function getSelectedTrackPaths(args)
	local paths = {}
	local seen = {}
	local selectedTrackPaths = args.selectedTrackPaths
	if type(selectedTrackPaths) ~= "table" then
		return paths
	end

	for key, value in pairs(selectedTrackPaths) do
		local path = nil
		if type(key) == "number" then
			path = value
		elseif value then
			path = key
		end
		if type(path) == "string" and not seen[path] and args.timeline and args.timeline:getTrackByPath(path) then
			seen[path] = true
			table.insert(paths, path)
		end
	end

	return paths
end

local function capturePathsAtFrame(args, paths, frame)
	local capturedKeys = {}
	for _, path in ipairs(paths or {}) do
		local success = false
		if type(args.timeline.captureTrackFrameAtFrame) == "function" then
			success = args.timeline:captureTrackFrameAtFrame(path, frame)
		else
			success = args.timeline:captureTrackFrame(path)
			frame = args.timeline:getCurrentFrame()
		end
		if success then
			table.insert(capturedKeys, {
				jointPath = path,
				frame = frame,
			})
		end
	end

	if #capturedKeys &gt; 0 then
		args.selectKeys(capturedKeys)
		return true
	end
	return false
end

function PoseKeyframeActionSupport.applyDefaultPose(args)
	local selectedKeyRefs = args.getSelectedKeyRefs()
	local success
	local message
	local changedKeys
	if #selectedKeyRefs &gt; 0 then
		args.pushUndo("Default Pose Keyframes")
		args.changeHistoryService:SetWaypoint("Before Default Pose Keyframes")
		success, message, changedKeys = args.timeline:setSelectedKeyframesToDefault(selectedKeyRefs)
		args.changeHistoryService:SetWaypoint("After Default Pose Keyframes")
	else
		local targetPaths = args.getSelectedTrackPaths()
		if args.selectedOnly and #targetPaths == 0 and args.selectedJointPath and args.timeline:getTrackByPath(args.selectedJointPath) then
			targetPaths = { args.selectedJointPath }
		end
		if args.selectedOnly and #targetPaths == 0 then
			return false, "Select a rig limb track or keyframe before pressing G.", nil, "precondition"
		end
		args.pushUndo("Add Default Pose Keyframes")
		args.changeHistoryService:SetWaypoint("Before Add Default Pose Keyframes")
		success, message, changedKeys = args.timeline:setDefaultPoseForTrackPaths(targetPaths, args.timeline:getCurrentFrame())
		args.changeHistoryService:SetWaypoint("After Add Default Pose Keyframes")
	end

	return success, message, changedKeys
end

function PoseKeyframeActionSupport.applyMirrorOrInvert(args)
	local selectedKeyRefs = args.getSelectedKeyRefs()
	if #selectedKeyRefs == 0 then
		return false, args.emptySelectionMessage, nil, "precondition"
	end

	args.pushUndo(args.undoLabel)
	args.changeHistoryService:SetWaypoint(args.beforeLabel)
	local success, message, changedKeys = args.action(args.timeline, selectedKeyRefs)
	args.changeHistoryService:SetWaypoint(args.afterLabel)
	return success, message, changedKeys
end

function PoseKeyframeActionSupport.hasTimelineSelection(selectedKeys, selectedKeyframeFrame, selectedTrackPaths, selectedJointPath)
	return not (next(selectedKeys) == nil and selectedKeyframeFrame == nil and next(selectedTrackPaths) == nil and not selectedJointPath)
end

function PoseKeyframeActionSupport.capturePoseFromViewport(args)
	if not args.timeline then
		return false
	end

	local currentFrame = normalizeFrame(args.timeline:getCurrentFrame())
	local selectedFrame = args.selectedKeyframeFrame ~= nil and normalizeFrame(args.selectedKeyframeFrame) or nil
	local shouldUpdateSelectedFrame = selectedFrame ~= nil and selectedFrame == currentFrame

	if shouldUpdateSelectedFrame and type(args.timeline.setCurrentFrame) == "function" then
		args.timeline:setCurrentFrame(selectedFrame)
	end

	local capturedKeys = shouldUpdateSelectedFrame
		and args.multiGizmoSelectionService.captureSameFrameRigKeys(args.timeline, args.selectedKeys, args.selectionState)
		or nil
	if capturedKeys then
		args.selectKeys(capturedKeys)
		return true
	end

	if not shouldUpdateSelectedFrame then
		local selectedKeyPaths = getSelectedKeyPaths(args)
		if #selectedKeyPaths &gt; 0 and capturePathsAtFrame(args, selectedKeyPaths, currentFrame) then
			return true
		end
	end

	local selectedTrackPaths = getSelectedTrackPaths(args)
	if #selectedTrackPaths &gt; 0 and capturePathsAtFrame(args, selectedTrackPaths, shouldUpdateSelectedFrame and selectedFrame or currentFrame) then
		return true
	end

	local selectedTrack = args.timeline:getTrackByPath(args.selectedJointPath)
	if selectedTrack then
		return capturePathsAtFrame(args, { selectedTrack.path }, shouldUpdateSelectedFrame and selectedFrame or currentFrame)
	end

	return false
end

return PoseKeyframeActionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX203">
        <Properties>
          <string name="Name">PresetPreviewSupport</string>
          <ProtectedString name="Source">local AnimationClipProvider = game:GetService("AnimationClipProvider")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local Players = game:GetService("Players")

local R15ToR6Converter = require(script.Parent:WaitForChild("AnimationConversion"):WaitForChild("R15ToR6Converter"))

local PresetPreviewSupport = {}

PresetPreviewSupport.SAMPLE_TIME = 0.35
local convertedPreviewClipCache = {}

local R6_PREVIEW_TRACK_NAMES = {
	["Torso"] = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
}

local R15_PREVIEW_TRACK_NAMES = {
	["LowerTorso"] = true,
	["UpperTorso"] = true,
	["LeftUpperArm"] = true,
	["LeftLowerArm"] = true,
	["LeftHand"] = true,
	["RightUpperArm"] = true,
	["RightLowerArm"] = true,
	["RightHand"] = true,
	["LeftUpperLeg"] = true,
	["LeftLowerLeg"] = true,
	["LeftFoot"] = true,
	["RightUpperLeg"] = true,
	["RightLowerLeg"] = true,
	["RightFoot"] = true,
}

local function createPreviewRigDescription()
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(214, 214, 224)
	description.TorsoColor = Color3.fromRGB(104, 84, 198)
	description.LeftArmColor = Color3.fromRGB(214, 214, 224)
	description.RightArmColor = Color3.fromRGB(214, 214, 224)
	description.LeftLegColor = Color3.fromRGB(214, 214, 224)
	description.RightLegColor = Color3.fromRGB(214, 214, 224)
	description.Face = 144075659
	return description
end

local function convertPreviewConstraintsToMotors(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			local attachment0 = descendant.Attachment0
			local attachment1 = descendant.Attachment1
			if attachment0
				and attachment1
				and attachment0.Parent
				and attachment1.Parent
				and attachment0.Parent:IsA("BasePart")
				and attachment1.Parent:IsA("BasePart") then
				local motor = Instance.new("Motor6D")
				motor.Name = descendant.Name
				motor.Part0 = attachment0.Parent
				motor.Part1 = attachment1.Parent
				motor.C0 = attachment0.CFrame
				motor.C1 = attachment1.CFrame
				motor.Parent = attachment0.Parent
			end
			descendant:Destroy()
		end
	end
end

function PresetPreviewSupport.createPresetPreviewRig(rigTypeName)
	local rigType = rigTypeName == "R6" and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
	local description = createPreviewRigDescription()
	local model = Players:CreateHumanoidModelFromDescription(description, rigType)
	model.Name = "PresetPreviewRig"
	convertPreviewConstraintsToMotors(model)

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if humanoid and not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = descendant.Name == "HumanoidRootPart"
			descendant.CanCollide = false
			descendant.CastShadow = false
		end
	end

	if model.PrimaryPart == nil then
		model.PrimaryPart = model:FindFirstChild("HumanoidRootPart")
	end
	if model.PrimaryPart then
		local previewHeight = rigTypeName == "R6" and 3.0 or 2.1
		model:PivotTo(CFrame.new(0, previewHeight, 0) * CFrame.Angles(0, math.pi, 0))
	end

	return model, animator
end

function PresetPreviewSupport.setPreviewViewportCamera(viewportFrame)
	local camera = Instance.new("Camera")
	camera.Name = "PreviewCamera"
	camera.CFrame = CFrame.new(Vector3.new(3.6, 3.0, 4.2), Vector3.new(0, 2.35, 0))
	camera.Parent = viewportFrame
	viewportFrame.CurrentCamera = camera
	return camera
end

function PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, loadingOverlay, state)
	state = tostring(state or "loading")
	if viewport then
		viewport.Visible = state == "ready"
	end
	if fallbackThumb then
		fallbackThumb.Visible = state == "fallback"
	end
	if loadingOverlay then
		loadingOverlay.Visible = state == "loading"
		loadingOverlay:SetAttribute("Done", state ~= "loading")
	end
end

function PresetPreviewSupport.alignPreviewRigToFloor(rig, floorY)
	if not rig or not rig.Parent then
		return
	end

	local boundingCFrame, boundingSize = rig:GetBoundingBox()
	local minY = boundingCFrame.Position.Y - (boundingSize.Y * 0.5)
	local targetMinY = floorY or 0.1
	local offsetY = targetMinY - minY
	if math.abs(offsetY) &lt; 0.001 then
		return
	end

	rig:PivotTo(rig:GetPivot() + Vector3.new(0, offsetY, 0))
end

function PresetPreviewSupport.keepPreviewRigAboveFloor(rig, floorY)
	if not rig or not rig.Parent then
		return
	end

	local boundingCFrame, boundingSize = rig:GetBoundingBox()
	local minY = boundingCFrame.Position.Y - (boundingSize.Y * 0.5)
	local targetMinY = floorY or 0.1
	local offsetY = targetMinY - minY
	if offsetY &lt;= 0.001 then
		return
	end

	rig:PivotTo(rig:GetPivot() + Vector3.new(0, offsetY, 0))
end

function PresetPreviewSupport.rebasePreviewRootFromPose(rigData, pose)
	if not rigData or not pose then
		return
	end

	local rootPath = rigData.rootPath
	local rootPart = rigData.rootPart
	local rootValue = rootPath and (pose[rootPath] or rigData.originalPose[rootPath])
	if rootPart and rootPart.Parent and typeof(rootValue) == "CFrame" then
		rigData.originalRootCFrame = rootPart.CFrame * rootValue:Inverse()
	end
end

local function normalizePreviewContentId(id)
	local numericId = tonumber(id)
	if numericId and numericId &gt; 0 then
		return "rbxassetid://" .. tostring(numericId), numericId
	end

	local text = tostring(id or "")
	local extracted = string.match(text, "(%d+)")
	local extractedId = tonumber(extracted)
	if extractedId and extractedId &gt; 0 then
		return "rbxassetid://" .. tostring(extractedId), extractedId
	end

	return nil, nil
end

function PresetPreviewSupport.loadPreviewAnimationClip(id)
	local contentId = normalizePreviewContentId(id)
	if not contentId then
		return nil
	end

	local success, clip = pcall(function()
		return AnimationClipProvider:GetAnimationClipAsync(contentId)
	end)
	if success and clip then
		return clip
	end

	local fallbackSuccess, fallbackClip = pcall(function()
		return KeyframeSequenceProvider:GetKeyframeSequenceAsync(contentId)
	end)
	if fallbackSuccess and fallbackClip then
		return fallbackClip
	end

	return nil
end

function PresetPreviewSupport.loadEntryPreviewAnimationClip(entry)
	if type(entry) ~= "table" then
		return nil
	end

	local clip = PresetPreviewSupport.loadPreviewAnimationClip(entry.id)
	if not clip then
		return nil
	end

	if entry.convertToR6 == true then
		local cacheKey = tostring(entry.id or "")
		if convertedPreviewClipCache[cacheKey] then
			return convertedPreviewClipCache[cacheKey]
		end

		local sourceSequence = clip
		if not sourceSequence:IsA("KeyframeSequence") then
			local convertedSourceOk, convertedSource = pcall(function()
				return R15ToR6Converter.LoadFromAnimationId(entry.id)
			end)
			if convertedSourceOk then
				sourceSequence = convertedSource
			end
		end
		if sourceSequence and sourceSequence:IsA("KeyframeSequence") then
			local convertOk, converted = pcall(function()
				return R15ToR6Converter.Convert(sourceSequence)
			end)
			if convertOk and converted then
				convertedPreviewClipCache[cacheKey] = converted
				return converted
			end
		end
	end

	return clip
end

function PresetPreviewSupport.detectRigTypeFromAnimationClip(clip)
	if not clip then
		return nil
	end

	local sawR6 = false
	local sawR15 = false
	for _, descendant in ipairs(clip:GetDescendants()) do
		if descendant:IsA("Pose") or descendant:IsA("Folder") then
			local name = descendant.Name
			if R6_PREVIEW_TRACK_NAMES[name] then
				sawR6 = true
			elseif R15_PREVIEW_TRACK_NAMES[name] then
				sawR15 = true
			end
		end
	end

	if sawR6 and not sawR15 then
		return "R6"
	end
	if sawR15 and not sawR6 then
		return "R15"
	end
	if sawR6 then
		return "R6"
	end
	return nil
end

function PresetPreviewSupport.getRigTypeNameForPreview(entry, clip)
	if entry and entry.convertToR6 == true then
		return "R6"
	end

	local detectedRigType = PresetPreviewSupport.detectRigTypeFromAnimationClip(clip)
	if detectedRigType == "R6" or detectedRigType == "R15" then
		return detectedRigType
	end

	return entry and entry.rigType == "R6" and "R6" or "R15"
end

function PresetPreviewSupport.describePreviewRigMotors(rig)
	local motors = {}
	local lookup = {}
	local originalPose = {}
	local partsByName = {}
	local originalPartCFrames = {}
	local childrenByPart0 = {}

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			partsByName[descendant.Name] = descendant
			originalPartCFrames[descendant] = descendant.CFrame
		end
	end

	local rootPart = partsByName.HumanoidRootPart or rig.PrimaryPart
	if rootPart then
		lookup[rootPart.Name] = rootPart.Name
		originalPose[rootPart.Name] = CFrame.new()
	end

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			local path = descendant.Name
			if descendant.Part1 then
				path = descendant.Part1.Name
				lookup[descendant.Part1.Name] = path
			end
			lookup[descendant.Name] = path
			motors[path] = descendant
			originalPose[path] = descendant.C0
			if descendant.Part0 and descendant.Part1 then
				local part0Name = descendant.Part0.Name
				local part1Name = descendant.Part1.Name
				childrenByPart0[part0Name] = childrenByPart0[part0Name] or {}
				table.insert(childrenByPart0[part0Name], {
					motor = descendant,
					path = path,
					part0 = descendant.Part0,
					part1 = descendant.Part1,
					part0Name = part0Name,
					part1Name = part1Name,
					c1 = descendant.C1,
				})
			end
		end
	end

	return {
		rig = rig,
		motors = motors,
		lookup = lookup,
		originalPose = originalPose,
		partsByName = partsByName,
		originalPartCFrames = originalPartCFrames,
		childrenByPart0 = childrenByPart0,
		rootPart = rootPart,
		rootPath = rootPart and rootPart.Name or nil,
		originalRootCFrame = rootPart and rootPart.CFrame or nil,
	}
end

function PresetPreviewSupport.buildPreviewPoseDataFromKeyframeSequence(keyframeSequence, rigData)
	if not keyframeSequence or not rigData then
		return nil
	end

	local keyframes = keyframeSequence:GetKeyframes()
	if #keyframes == 0 then
		return nil
	end

	local frames = {}
	local duration = 0
	for _, keyframe in ipairs(keyframes) do
		local time = tonumber(keyframe.Time) or 0
		local pose = {}
		local hasPose = false
		for _, descendant in ipairs(keyframe:GetDescendants()) do
			if descendant:IsA("Pose") then
				local path = rigData.lookup[descendant.Name]
				local originalC0 = path and rigData.originalPose[path]
				if path and typeof(originalC0) == "CFrame" then
					if path == rigData.rootPath then
						pose[path] = descendant.CFrame
					else
						pose[path] = originalC0 * descendant.CFrame
					end
					hasPose = true
				end
			end
		end

		if hasPose then
			table.insert(frames, {
				time = time,
				pose = pose,
			})
			duration = math.max(duration, time)
		end
	end

	if #frames == 0 then
		return nil
	end

	table.sort(frames, function(a, b)
		return a.time &lt; b.time
	end)

	return {
		frames = frames,
		duration = duration &gt; 0 and duration or frames[#frames].time or 0,
	}
end

function PresetPreviewSupport.samplePreviewPose(previewData, sampleTime)
	if not previewData or not previewData.frames or #previewData.frames == 0 then
		return nil
	end

	local frames = previewData.frames
	if sampleTime &lt;= frames[1].time then
		return frames[1].pose
	end

	for index = 1, #frames - 1 do
		local currentFrame = frames[index]
		local nextFrame = frames[index + 1]
		if sampleTime &lt;= nextFrame.time then
			local alphaDenominator = math.max(0.0001, nextFrame.time - currentFrame.time)
			local alpha = math.clamp((sampleTime - currentFrame.time) / alphaDenominator, 0, 1)
			local pose = {}
			local seen = {}

			for path, value in pairs(currentFrame.pose) do
				seen[path] = true
				local nextValue = nextFrame.pose[path]
				if typeof(value) == "CFrame" and typeof(nextValue) == "CFrame" then
					pose[path] = value:Lerp(nextValue, alpha)
				else
					pose[path] = nextValue or value
				end
			end

			for path, value in pairs(nextFrame.pose) do
				if not seen[path] then
					pose[path] = value
				end
			end

			return pose
		end
	end

	return frames[#frames].pose
end

function PresetPreviewSupport.applyPreviewPose(rigData, pose)
	if not rigData or not pose then
		return
	end

	local rootPath = rigData.rootPath
	local rootPart = rigData.rootPart
	local rootValue = rootPath and (pose[rootPath] or rigData.originalPose[rootPath])
	if rootPart and rootPart.Parent and typeof(rootValue) == "CFrame" then
		rootPart.CFrame = (rigData.originalRootCFrame or rootPart.CFrame) * rootValue
	end

	for path, motor in pairs(rigData.motors or {}) do
		if motor and motor.Parent then
			local value = pose[path] or rigData.originalPose[path]
			if typeof(value) == "CFrame" then
				motor.C0 = value
			end
		end
	end
end

function PresetPreviewSupport.applyPreviewPoseAboveFloor(rigData, pose, floorY)
	PresetPreviewSupport.applyPreviewPose(rigData, pose)
	if rigData and rigData.rig then
		PresetPreviewSupport.keepPreviewRigAboveFloor(rigData.rig, floorY or 0.1)
	end
end

function PresetPreviewSupport.applyPreviewPoseWorld(rigData, pose)
	if not rigData or not pose then
		return
	end

	PresetPreviewSupport.applyPreviewPose(rigData, pose)

	local rig = rigData.rig
	local partsByName = rigData.partsByName or {}
	local rootPart = partsByName.HumanoidRootPart or (rig and rig.PrimaryPart)
	if not rootPart then
		return
	end

	local worldByName = {
		[rootPart.Name] = rootPart.CFrame,
	}
	local visited = {}

	local function solveChildren(partName)
		if visited[partName] then
			return
		end
		visited[partName] = true

		for _, data in ipairs((rigData.childrenByPart0 or {})[partName] or {}) do
			local part0World = worldByName[data.part0Name]
			local part1 = data.part1
			if part0World and part1 and part1.Parent then
				local motorC0 = pose[data.path]
				if typeof(motorC0) ~= "CFrame" then
					motorC0 = rigData.originalPose and rigData.originalPose[data.path] or data.motor.C0
				end
				local motorC1 = data.c1 or CFrame.new()
				local part1World = part0World * motorC0 * motorC1:Inverse()
				worldByName[data.part1Name] = part1World
				part1.CFrame = part1World
				solveChildren(data.part1Name)
			end
		end
	end

	solveChildren(rootPart.Name)
end

function PresetPreviewSupport.restorePreviewWorkspaceRig(rigData)
	if not rigData then
		return
	end

	PresetPreviewSupport.applyPreviewPose(rigData, rigData.originalPose)

	for part, cframe in pairs(rigData.originalPartCFrames or {}) do
		if part and part.Parent and typeof(cframe) == "CFrame" then
			part.CFrame = cframe
		end
	end
end

return PresetPreviewSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX204">
        <Properties>
          <string name="Name">PreviewBakeService</string>
          <ProtectedString name="Source">local TweenService = game:GetService("TweenService")

local PreviewBakeService = {}
PreviewBakeService.__index = PreviewBakeService

local DEFAULT_EASING_STYLE = "Linear"
local DEFAULT_EASING_DIRECTION = "InOut"

local function cloneValue(value)
	if type(value) ~= "table" then
		return value
	end

	local cloned = {}
	for key, child in pairs(value) do
		cloned[key] = cloneValue(child)
	end
	return cloned
end

local function lerpValue(aValue, bValue, alpha)
	if typeof(aValue) == "CFrame" and typeof(bValue) == "CFrame" then
		return aValue:Lerp(bValue, alpha)
	end

	if typeof(aValue) == "CFrame" and type(bValue) == "table" and typeof(bValue.cframe or bValue.CFrame) == "CFrame" then
		local normalizedB = cloneValue(bValue)
		normalizedB.cframe = normalizedB.cframe or normalizedB.CFrame
		normalizedB.CFrame = nil
		local normalizedA = cloneValue(normalizedB)
		normalizedA.cframe = aValue
		return lerpValue(normalizedA, normalizedB, alpha)
	end

	if type(aValue) == "table" and typeof(aValue.cframe or aValue.CFrame) == "CFrame" and typeof(bValue) == "CFrame" then
		local normalizedA = cloneValue(aValue)
		normalizedA.cframe = normalizedA.cframe or normalizedA.CFrame
		normalizedA.CFrame = nil
		local normalizedB = cloneValue(normalizedA)
		normalizedB.cframe = bValue
		return lerpValue(normalizedA, normalizedB, alpha)
	end

	if type(aValue) == "number" and type(bValue) == "number" then
		return aValue + ((bValue - aValue) * alpha)
	end

	if type(aValue) == "boolean" and type(bValue) == "boolean" then
		return alpha &gt;= 1 and bValue or aValue
	end

	if typeof(aValue) == "Color3" and typeof(bValue) == "Color3" then
		return aValue:Lerp(bValue, alpha)
	end

	if typeof(aValue) == "ColorSequence" and typeof(bValue) == "ColorSequence" then
		local left = aValue.Keypoints[1] and aValue.Keypoints[1].Value or Color3.new(1, 1, 1)
		local right = bValue.Keypoints[1] and bValue.Keypoints[1].Value or left
		return ColorSequence.new(left:Lerp(right, alpha))
	end

	if typeof(aValue) == "NumberSequence" and typeof(bValue) == "NumberSequence" then
		local left = aValue.Keypoints[1] and aValue.Keypoints[1].Value or 0
		local right = bValue.Keypoints[1] and bValue.Keypoints[1].Value or left
		return NumberSequence.new(left + ((right - left) * alpha))
	end

	if typeof(aValue) == "NumberRange" and typeof(bValue) == "NumberRange" then
		return NumberRange.new(
			aValue.Min + ((bValue.Min - aValue.Min) * alpha),
			aValue.Max + ((bValue.Max - aValue.Max) * alpha)
		)
	end

	if typeof(aValue) == "Vector2" and typeof(bValue) == "Vector2" then
		return aValue:Lerp(bValue, alpha)
	end

	if typeof(aValue) == "Vector3" and typeof(bValue) == "Vector3" then
		return aValue:Lerp(bValue, alpha)
	end

	if type(aValue) == "table" and type(bValue) == "table" then
		local value = {}
		local seen = {}
		for key, leftValue in pairs(aValue) do
			seen[key] = true
			value[key] = bValue[key] ~= nil and lerpValue(leftValue, bValue[key], alpha) or cloneValue(leftValue)
		end
		for key, rightValue in pairs(bValue) do
			if not seen[key] then
				value[key] = cloneValue(rightValue)
			end
		end
		return value
	end

	if alpha &lt; 0.5 then
		return aValue
	end
	return bValue
end

local function easingEnum(enumType, name, fallback)
	local success, value = pcall(function()
		return enumType[name]
	end)
	return success and value or enumType[fallback]
end

local function applyEasing(alpha, options)
	alpha = math.clamp(alpha, 0, 1)
	options = options or {}
	local styleName = options.easingStyle or DEFAULT_EASING_STYLE
	if styleName == "None" then
		return alpha &gt;= 1 and 1 or 0
	end

	local direction = easingEnum(Enum.EasingDirection, options.easingDirection or DEFAULT_EASING_DIRECTION, DEFAULT_EASING_DIRECTION)
	if styleName == "Sextic" then
		if direction == Enum.EasingDirection.In then
			return alpha ^ 6
		elseif direction == Enum.EasingDirection.Out then
			return 1 - ((1 - alpha) ^ 6)
		end
		return alpha &lt; 0.5 and (0.5 * ((alpha * 2) ^ 6)) or (1 - (0.5 * (((1 - alpha) * 2) ^ 6)))
	end

	local style = easingEnum(Enum.EasingStyle, styleName, DEFAULT_EASING_STYLE)
	local success, eased = pcall(function()
		return TweenService:GetValue(alpha, style, direction)
	end)
	return success and eased or alpha
end

local function roundedNumber(value)
	return string.format("%.4f", tonumber(value) or 0)
end

local function valueFingerprint(value, depth)
	depth = depth or 0
	if depth &gt; 4 then
		return "..."
	end

	local valueType = typeof(value)
	if valueType == "CFrame" then
		local components = { value:GetComponents() }
		local parts = { "cf" }
		for _, component in ipairs(components) do
			table.insert(parts, roundedNumber(component))
		end
		return table.concat(parts, ",")
	elseif valueType == "Vector3" then
		return "v3," .. roundedNumber(value.X) .. "," .. roundedNumber(value.Y) .. "," .. roundedNumber(value.Z)
	elseif valueType == "Vector2" then
		return "v2," .. roundedNumber(value.X) .. "," .. roundedNumber(value.Y)
	elseif valueType == "Color3" then
		return "c3," .. roundedNumber(value.R) .. "," .. roundedNumber(value.G) .. "," .. roundedNumber(value.B)
	elseif valueType == "NumberRange" then
		return "nr," .. roundedNumber(value.Min) .. "," .. roundedNumber(value.Max)
	elseif valueType == "NumberSequence" or valueType == "ColorSequence" then
		return tostring(value)
	elseif valueType == "EnumItem" then
		return tostring(value)
	elseif type(value) == "table" then
		local keys = {}
		for key in pairs(value) do
			table.insert(keys, key)
		end
		table.sort(keys, function(a, b)
			return tostring(a) &lt; tostring(b)
		end)
		local parts = { "table" }
		for _, key in ipairs(keys) do
			table.insert(parts, tostring(key) .. "=" .. valueFingerprint(value[key], depth + 1))
		end
		return table.concat(parts, "|")
	end

	return tostring(value)
end

local function shouldBakeTrack(track)
	if not track or type(track.path) ~= "string" then
		return false
	end
	if track.trackType == "Rig Group" or track.trackType == "Folder" then
		return false
	end
	if track.trackType == "Particle Event" or track.targetScope == "ParticleEvent" or track.valueType == "Event" then
		return false
	end
	if track.trackType == "Screen Effect" or track.trackType == "Face" or track.targetScope == "Face" then
		return false
	end
	return true
end

function PreviewBakeService.new()
	return setmetatable({
		_signature = nil,
		_revision = nil,
		_cache = nil,
		_compileCount = 0,
	}, PreviewBakeService)
end

function PreviewBakeService:invalidate()
	self._signature = nil
	self._revision = nil
	self._cache = nil
end

function PreviewBakeService:_buildSignature(timeline)
	local parts = {
		"fps=" .. tostring(timeline:getFps()),
		"duration=" .. tostring(timeline:getDurationFrames()),
		"looping=" .. tostring(timeline:getLooping()),
	}

	for _, track in ipairs(timeline:getTracks()) do
		table.insert(parts, "track=" .. tostring(track.path) .. "|disabled=" .. tostring(timeline:isTrackDisabled(track.path)))
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
			local keyValues = timeline:getTrackKeyValues({ { jointPath = track.path, frame = frame } })
			local key = keyValues[1]
			local options = timeline:getKeyOptions(track.path, frame)
			table.insert(parts, table.concat({
				tostring(frame),
				tostring(options.easingStyle),
				tostring(options.easingDirection),
				key and valueFingerprint(key.value) or "nil",
			}, ":"))
		end
	end

	return table.concat(parts, ";")
end

local function buildSegments(keys)
	local segments = {}
	for index = 1, #keys - 1 do
		local left = keys[index]
		local right = keys[index + 1]
		if right.frame &gt; left.frame then
			table.insert(segments, {
				startFrame = left.frame,
				endFrame = right.frame,
				startValue = left.value,
				endValue = right.value,
				easing = {
					easingStyle = right.easingStyle or DEFAULT_EASING_STYLE,
					easingDirection = right.easingDirection or DEFAULT_EASING_DIRECTION,
				},
			})
		end
	end
	return segments
end

function PreviewBakeService:_compile(timeline, signature)
	local startedAt = os.clock()
	local compiledTracks = {}
	local bakedKeyCount = 0
	local timelineStartPose = select(1, timeline:samplePose(0)) or {}

	for _, track in ipairs(timeline:getTracks()) do
		if shouldBakeTrack(track) and not timeline:isTrackDisabled(track.path) then
			local keyRefs = {}
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				table.insert(keyRefs, { jointPath = track.path, frame = frame })
			end

			local keys = timeline:getTrackKeyValues(keyRefs)
			if #keys &gt; 0 then
				local hasBeforeFirstValue = keys[1].frame &gt; 0 and timelineStartPose[track.path] ~= nil
				bakedKeyCount += #keys
				table.insert(compiledTracks, {
					path = track.path,
					keys = keys,
					segments = buildSegments(keys),
					hasBeforeFirstValue = hasBeforeFirstValue,
					beforeFirstValue = hasBeforeFirstValue and cloneValue(timelineStartPose[track.path]) or nil,
				})
			end
		end
	end

	self._compileCount += 1
	return {
		signature = signature,
		tracks = compiledTracks,
		keyCount = bakedKeyCount,
		compiledAt = os.clock(),
		compileMs = (os.clock() - startedAt) * 1000,
		compileCount = self._compileCount,
	}
end

function PreviewBakeService:ensureCache(timeline, revision)
	if revision ~= nil and self._cache and self._revision == revision then
		return self._cache, false, "Using cached preview."
	end

	local signature = revision ~= nil
		and "revision=" .. tostring(revision)
		or self:_buildSignature(timeline)
	if revision == nil and self._cache and self._signature == signature then
		return self._cache, false, "Using cached preview."
	end

	local cache = self:_compile(timeline, signature)
	self._signature = signature
	self._revision = revision
	self._cache = cache
	return cache, true, string.format("Prepared preview cache: %d tracks, %d keys in %.1fms.", #cache.tracks, cache.keyCount, cache.compileMs)
end

local function sampleTrack(trackCache, frame)
	local keys = trackCache.keys
	if not keys or #keys == 0 then
		return nil
	end
	if frame &lt; keys[1].frame and trackCache.hasBeforeFirstValue then
		return trackCache.beforeFirstValue
	end
	if #keys == 1 or frame &lt;= keys[1].frame then
		return keys[1].value
	end
	if frame &gt;= keys[#keys].frame then
		return keys[#keys].value
	end

	local low = 1
	local high = #trackCache.segments
	while low &lt;= high do
		local middle = math.floor((low + high) / 2)
		local segment = trackCache.segments[middle]
		if frame &lt; segment.startFrame then
			high = middle - 1
		elseif frame &gt; segment.endFrame then
			low = middle + 1
		else
			local alpha = (frame - segment.startFrame) / (segment.endFrame - segment.startFrame)
			alpha = applyEasing(alpha, segment.easing)
			return lerpValue(segment.startValue, segment.endValue, alpha)
		end
	end

	return keys[#keys].value
end

function PreviewBakeService:sample(cache, frame, suppressedPaths)
	local pose = {}
	for _, trackCache in ipairs((cache and cache.tracks) or {}) do
		if not (suppressedPaths and suppressedPaths[trackCache.path]) then
			local value = sampleTrack(trackCache, frame)
			if value ~= nil then
				pose[trackCache.path] = value
			end
		end
	end
	return pose
end

function PreviewBakeService:applyFrame(timeline, cache, frame, suppressedPaths)
	if not cache then
		return timeline:applyFrame(frame)
	end
	return timeline:applyPoseSnapshot(self:sample(cache, frame, suppressedPaths))
end

return PreviewBakeService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX205">
        <Properties>
          <string name="Name">PropertyKeyframeEditorController</string>
          <ProtectedString name="Source">local PropertyKeyframeValueService = require(script.Parent:WaitForChild("PropertyKeyframeValueService"))
local TrackEasingOptionsSupport = require(script.Parent:WaitForChild("TrackEasingOptionsSupport"))
local UiHelpers = require(script.Parent:WaitForChild("UiHelpers"))
local UiMotion = require(script.Parent:WaitForChild("UiMotion"))
local Constants = require(script.Parent:WaitForChild("Constants"))
local ColorPickerPopup = require(script.Parent:WaitForChild("UI"):WaitForChild("ColorPickerPopup"))

local PropertyKeyframeEditorController = {}

local UserInputService = game:GetService("UserInputService")

local function parseRgbText(text)
	local raw = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local hex = raw:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		return Color3.fromRGB(
			tonumber(hex:sub(1, 2), 16),
			tonumber(hex:sub(3, 4), 16),
			tonumber(hex:sub(5, 6), 16)
		)
	end

	local values = {}
	for token in raw:gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value then
			table.insert(values, value)
		end
	end
	if #values &lt; 3 then
		return nil
	end

	if values[1] &lt;= 1 and values[2] &lt;= 1 and values[3] &lt;= 1 then
		return Color3.new(
			math.clamp(values[1], 0, 1),
			math.clamp(values[2], 0, 1),
			math.clamp(values[3], 0, 1)
		)
	end

	return Color3.fromRGB(
		math.clamp(math.floor(values[1] + 0.5), 0, 255),
		math.clamp(math.floor(values[2] + 0.5), 0, 255),
		math.clamp(math.floor(values[3] + 0.5), 0, 255)
	)
end

local function formatColor(color)
	return string.format(
		"%d,%d,%d",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function formatNumber(value)
	local number = tonumber(value)
	if not number then
		return ""
	end

	local text = string.format("%.3f", number)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text
end

local function isBooleanProperty(propertyName)
	return propertyName == "Enabled" or propertyName == "Shadows" or propertyName == "Visible"
end

local function isColorProperty(propertyName)
	return propertyName == "Color"
		or propertyName == "Color3"
		or propertyName == "TintColor"
		or propertyName == "TextColor3"
		or propertyName == "TextStrokeColor3"
		or propertyName == "BackgroundColor3"
end

local function readBooleanText(text)
	local raw = tostring(text or ""):lower():match("^%s*(.-)%s*$")
	return raw == "true" or raw == "on" or raw == "yes" or raw == "1"
end

local function setBooleanButtonState(button, value)
	if not button then
		return
	end
	button.Text = value and "On" or "Off"
	button.BackgroundColor3 = value and Constants.THEME.Accent or Constants.THEME.PanelSoft
	button.TextColor3 = Constants.THEME.Text
end

local function getCurrentTrack(host)
	return host:_getTrackViewModel(host._activePropertyKeyframeTrackPath)
end

local function getSelectedPropertyKeyValue(host, trackPath)
	local viewModel = host._lastViewModel or {}
	for _, key in ipairs(viewModel.selectedKeyValues or {}) do
		if key.jointPath == trackPath then
			return key.value, key.frame
		end
	end

	local targetFrame = viewModel.currentFrame
	for _, key in ipairs(viewModel.selectedKeys or {}) do
		if (key.jointPath or key.path) == trackPath then
			targetFrame = key.frame
			break
		end
	end

	local callbacks = host._propertyKeyframeEditorCallbacks
	local timeline = callbacks and type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
	if timeline and type(timeline.getTrackValueAtFrame) == "function" then
		local ok, value = pcall(function()
			return timeline:getTrackValueAtFrame(trackPath, targetFrame)
		end)
		if ok and value ~= nil then
			return value, targetFrame
		end
	end

	return nil, targetFrame
end

local function updateColorSwatch(host)
	if not host._propertyKeyframeEditorColorSwatch then
		return
	end

	local color = parseRgbText(host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or "")
	host._propertyKeyframeEditorColorSwatch.Visible = color ~= nil
	if color then
		host._propertyKeyframeEditorColorSwatch.BackgroundColor3 = color
	end
end

local function getInputLabel(propertyName)
	if propertyName == "Text" then
		return "Text"
	elseif isColorProperty(propertyName) then
		return "Color (R,G,B or #RRGGBB)"
	elseif isBooleanProperty(propertyName) then
		return tostring(propertyName) .. " toggle"
	elseif propertyName == "Transparency" then
		return "Transparency (0-1)"
	elseif propertyName == "TextTransparency" then
		return "Text Transparency (0-1)"
	elseif propertyName == "TextStrokeTransparency" then
		return "Text Stroke Transparency (0-1)"
	elseif propertyName == "BackgroundTransparency" then
		return "Background Transparency (0-1)"
	elseif propertyName == "Reflectance" then
		return "Reflectance (0-1)"
	elseif propertyName == "Scale" then
		return "Scale"
	elseif propertyName == "TextSize" then
		return "Text Size"
	elseif propertyName == "MaxVisibleGraphemes" then
		return "Max Visible Graphemes (-1 for all)"
	elseif propertyName == "Texture" then
		return "Texture image ID or URL"
	elseif propertyName == "Face" then
		return "Face (Front/Back/Left/Right/Top/Bottom)"
	end
	return "Value"
end

local function getNote(propertyName)
	if propertyName == "Text" then
		return "Type the label text to show at this keyframe."
	elseif isColorProperty(propertyName) then
		return "Use RGB values like 255,0,4 or a hex value like #ff0044."
	elseif isBooleanProperty(propertyName) then
		return "Boolean keys are instant toggles and use None easing."
	elseif propertyName == "Transparency" or propertyName == "TextTransparency" or propertyName == "TextStrokeTransparency" or propertyName == "BackgroundTransparency" then
		return "0 is fully visible. 1 is fully invisible."
	elseif propertyName == "Reflectance" then
		return "0 is matte. 1 is fully reflective."
	elseif propertyName == "Scale" then
		return "Scale uses Model ScaleTo or a part Size multiplier. 1 keeps original size."
	elseif propertyName == "TextSize" then
		return "Animates the TextSize value for TextLabel, TextButton, or TextBox."
	elseif propertyName == "MaxVisibleGraphemes" then
		return "-1 shows all text. Animate upward from 0 for a typewriter-style reveal."
	elseif propertyName == "Texture" then
		return "Accepts 123456789, rbxassetid://123456789, rbxasset:// paths, or Roblox asset URLs."
	elseif propertyName == "Face" then
		return "Moves the Decal/Texture to a different face of its parent part."
	end
	return "Edit the value, then Apply Keyframe."
end

local function formatValue(value, propertyName)
	if isColorProperty(propertyName) and typeof(value) == "Color3" then
		return formatColor(value)
	elseif propertyName == "Face" and typeof(value) == "EnumItem" then
		return value.Name
	elseif type(value) == "boolean" then
		return value and "true" or "false"
	elseif type(value) == "number" then
		return formatNumber(value)
	end
	return value ~= nil and tostring(value) or ""
end

local function applyEditorValue(host, callbacks, force)
	if not callbacks.onSetPropertyKeyframeValue then
		return false
	end
	if not force and not host._propertyKeyframePreviewDirty then
		return true
	end

	callbacks.onSetPropertyKeyframeValue(
		host._activePropertyKeyframeTrackPath,
		host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or ""
	)
	host._propertyKeyframePreviewDirty = false
	return true
end

local function previewEditorValue(host, callbacks)
	if host._propertyEditorSuppressTextChange or not callbacks.onPreviewPropertyKeyframeValue then
		return
	end

	host._propertyKeyframePreviewDirty = true
	callbacks.onPreviewPropertyKeyframeValue(
		host._activePropertyKeyframeTrackPath,
		host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or ""
	)
end

local function cancelPreview(host, callbacks)
	if host._propertyKeyframePreviewDirty and callbacks.onCancelPropertyKeyframePreview then
		callbacks.onCancelPropertyKeyframePreview()
	end
	host._propertyKeyframePreviewDirty = false
end

local function releaseEditorInputFocus(host)
	local valueInput = host and host._propertyKeyframeEditorValueInput or nil
	if valueInput and UserInputService:GetFocusedTextBox() == valueInput then
		pcall(function()
			valueInput:ReleaseFocus()
		end)
	end
end

local function openColorPicker(host, callbacks)
	if not host._propertyKeyframeEditorOverlay or not host._propertyKeyframeEditorOverlay.Parent then
		return
	end

	local editorOverlay = host._propertyKeyframeEditorOverlay
	local previousOverlayTransparency = editorOverlay.BackgroundTransparency
	editorOverlay.BackgroundTransparency = 1
	local restoredOverlay = false
	local function restoreEditorOverlay()
		if restoredOverlay then
			return
		end
		restoredOverlay = true
		if editorOverlay and editorOverlay.Parent then
			editorOverlay.BackgroundTransparency = previousOverlayTransparency
		end
	end

	local currentColor = parseRgbText(host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or "")
		or Color3.fromRGB(255, 255, 255)
	local originalText = host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or formatColor(currentColor)
	local pickerOverlay = ColorPickerPopup.open(host._propertyKeyframeEditorOverlay, {
		title = "Choose Property Color",
		description = "Pick a color for this track, or type RGB like 255,0,0 / hex like #ff0000.",
		initialColor = currentColor,
		showTransparency = false,
		zIndex = 180,
		backdropTransparency = 1,
		applyText = "Use Color",
		onPreview = function(color)
			if host._propertyKeyframeEditorValueInput then
				host._propertyEditorSuppressTextChange = true
				host._propertyKeyframeEditorValueInput.Text = formatColor(color)
				host._propertyEditorSuppressTextChange = false
			end
			updateColorSwatch(host)
			previewEditorValue(host, callbacks)
		end,
		onApply = function(color)
			restoreEditorOverlay()
			if host._propertyKeyframeEditorValueInput then
				host._propertyEditorSuppressTextChange = true
				host._propertyKeyframeEditorValueInput.Text = formatColor(color)
				host._propertyEditorSuppressTextChange = false
			end
			updateColorSwatch(host)
			previewEditorValue(host, callbacks)
		end,
		onCancel = function()
			restoreEditorOverlay()
			if host._propertyKeyframeEditorValueInput then
				host._propertyEditorSuppressTextChange = true
				host._propertyKeyframeEditorValueInput.Text = originalText
				host._propertyEditorSuppressTextChange = false
			end
			updateColorSwatch(host)
			cancelPreview(host, callbacks)
		end,
	})
	if pickerOverlay then
		pickerOverlay.Destroying:Connect(restoreEditorOverlay)
	end
end

local function refreshEasingPanel(host)
	local overlay = host._propertyKeyframeEditorOverlay
	local card = overlay and overlay:FindFirstChild("PropertyKeyframeEditorCard")
	if not card then
		return
	end
	card.Size = UDim2.new(0, 430, 0, 430)
	TrackEasingOptionsSupport.ensurePanel(host, {
		prefix = "propertyKeyframeEditor",
		card = card,
		create = UiHelpers.create,
		createCorner = UiHelpers.createCorner,
		createStroke = UiHelpers.createStroke,
		position = UDim2.new(0, 18, 0, 304),
		size = UDim2.new(1, -36, 0, 68),
		zIndex = 132,
	})
	TrackEasingOptionsSupport.updatePanel(host, "propertyKeyframeEditor")
	if host._propertyKeyframeEditorCallbacks then
		TrackEasingOptionsSupport.connectPanel(host, host._propertyKeyframeEditorCallbacks, "propertyKeyframeEditor", function()
			PropertyKeyframeEditorController.render(host)
		end)
	end
end

function PropertyKeyframeEditorController.isEditablePropertyTrack(track)
	return PropertyKeyframeValueService.isEditableValueTrack(track)
end

function PropertyKeyframeEditorController.show(host, trackPath)
	if not host._propertyKeyframeEditorOverlay then
		return
	end

	host._activePropertyKeyframeTrackPath = trackPath
	host._propertyKeyframePreviewDirty = false
	PropertyKeyframeEditorController.render(host)
	UiMotion.popupIn(host._propertyKeyframeEditorOverlay)
	host:_setShortcutHint("Property keyframe editor open: adjust the value, then Apply Keyframe")
end

function PropertyKeyframeEditorController.hide(host)
	releaseEditorInputFocus(host)
	if host._propertyKeyframeEditorOverlay then
		UiMotion.popupOut(host._propertyKeyframeEditorOverlay)
	end
	host._activePropertyKeyframeTrackPath = nil
	host._propertyKeyframePreviewDirty = false
end

function PropertyKeyframeEditorController.render(host)
	if not host._propertyKeyframeEditorOverlay then
		return
	end

	local track = getCurrentTrack(host)
	if not PropertyKeyframeEditorController.isEditablePropertyTrack(track) then
		if host._propertyKeyframeEditorItemLabel then
			host._propertyKeyframeEditorItemLabel.Text = "Track: Property"
		end
		if host._propertyKeyframeEditorHelpLabel then
			host._propertyKeyframeEditorHelpLabel.Text = "Select an editable property keyframe first."
		end
		return
	end

	local propertyName = track.propertyName or track.name or "Property"
	local value, frame = getSelectedPropertyKeyValue(host, track.path)
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local isColor = isColorProperty(propertyName)
	local isBoolean = isBooleanProperty(propertyName)
	if value == nil and isBoolean and track.originalValue ~= nil then
		value = track.originalValue
	end

	if host._propertyKeyframeEditorItemLabel then
		host._propertyKeyframeEditorItemLabel.Text = string.format(
			"%s: %s",
			tostring(track.parentTrackName or track.rigName or track.name or "Item"),
			tostring(propertyName)
		)
	end
	if host._propertyKeyframeEditorHelpLabel then
		host._propertyKeyframeEditorHelpLabel.Text = string.format(
			"Editing frame %s. This writes %s onto selected keyframes for this track.",
			tostring(frame or 0),
			tostring(propertyName)
		)
	end
	if host._propertyKeyframeEditorValueLabel then
		host._propertyKeyframeEditorValueLabel.Text = getInputLabel(propertyName)
	end
	if host._propertyKeyframeEditorValueInput then
		host._propertyKeyframeEditorValueInput.Visible = not isBoolean
		host._propertyKeyframeEditorValueInput.PlaceholderText = getInputLabel(propertyName)
		local shouldPreservePendingBoolean = isBoolean
			and host._propertyKeyframePreviewDirty == true
			and tostring(host._propertyKeyframeEditorValueInput.Text or "") ~= ""
		if focusedTextBox ~= host._propertyKeyframeEditorValueInput and value ~= nil and not shouldPreservePendingBoolean then
			host._propertyEditorSuppressTextChange = true
			host._propertyKeyframeEditorValueInput.Text = formatValue(value, propertyName)
			host._propertyEditorSuppressTextChange = false
		end
	end
	if host._propertyKeyframeEditorBooleanButton then
		host._propertyKeyframeEditorBooleanButton.Visible = isBoolean
		local booleanText = host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or nil
		if tostring(booleanText or "") == "" and value ~= nil then
			booleanText = formatValue(value, propertyName)
		end
		setBooleanButtonState(host._propertyKeyframeEditorBooleanButton, readBooleanText(booleanText))
	end
	if host._propertyKeyframeEditorColorPickerFrame then
		host._propertyKeyframeEditorColorPickerFrame.Visible = isColor and not isBoolean
	end
	if host._propertyKeyframeEditorNoteLabel then
		host._propertyKeyframeEditorNoteLabel.Text = getNote(propertyName)
	end

	updateColorSwatch(host)
	refreshEasingPanel(host)
end

function PropertyKeyframeEditorController.connect(host, callbacks)
	host._propertyKeyframeEditorCallbacks = callbacks
	if host._propertyKeyframeEditorCloseButton then
		host:_connect(host._propertyKeyframeEditorCloseButton.Activated, function()
			cancelPreview(host, callbacks)
			PropertyKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Property editor closed")
		end)
	end
	if host._propertyKeyframeEditorOkButton then
		host:_connect(host._propertyKeyframeEditorOkButton.Activated, function()
			if applyEditorValue(host, callbacks, true) then
				PropertyKeyframeEditorController.hide(host)
				host:_focusShortcutCapture("Property editor closed")
			end
		end)
	end
	if host._propertyKeyframeEditorValueInput then
		host:_connect(host._propertyKeyframeEditorValueInput.FocusLost, function(enterPressed)
			updateColorSwatch(host)
			if enterPressed then
				host:_focusShortcutCapture("Property preview ready. Click Apply Keyframe or OK to save it.")
			end
		end)
		host:_connect(host._propertyKeyframeEditorValueInput:GetPropertyChangedSignal("Text"), function()
			updateColorSwatch(host)
			previewEditorValue(host, callbacks)
		end)
	end
	if host._propertyKeyframeEditorBooleanButton then
		host:_connect(host._propertyKeyframeEditorBooleanButton.Activated, function()
			local nextValue = not readBooleanText(host._propertyKeyframeEditorValueInput and host._propertyKeyframeEditorValueInput.Text or "")
			if host._propertyKeyframeEditorValueInput then
				host._propertyKeyframeEditorValueInput.Text = nextValue and "true" or "false"
			end
			setBooleanButtonState(host._propertyKeyframeEditorBooleanButton, nextValue)
			previewEditorValue(host, callbacks)
		end)
	end
	if host._propertyKeyframeEditorColorPickerButton then
		host:_connect(host._propertyKeyframeEditorColorPickerButton.Activated, function()
			openColorPicker(host, callbacks)
		end)
	end
	if host._propertyKeyframeEditorColorSwatch then
		host:_connect(host._propertyKeyframeEditorColorSwatch.Activated, function()
			openColorPicker(host, callbacks)
		end)
	end
	if host._propertyKeyframeEditorApplyButton then
		host:_connect(host._propertyKeyframeEditorApplyButton.Activated, function()
			if applyEditorValue(host, callbacks, true) then
				PropertyKeyframeEditorController.hide(host)
				host:_focusShortcutCapture("Property editor closed")
			end
		end)
	end
end

return PropertyKeyframeEditorController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX206">
        <Properties>
          <string name="Name">PropertyKeyframeValueService</string>
          <ProtectedString name="Source">local PropertyKeyframeValueService = {}

local PART_PROPERTIES = {
	CFrame = true,
	Scale = true,
	Transparency = true,
	Color = true,
	Reflectance = true,
}

local DECAL_PROPERTIES = {
	Transparency = true,
	Color3 = true,
	Texture = true,
	Face = true,
}

local LIGHT_PROPERTIES = {
	Enabled = true,
	Brightness = true,
	Range = true,
	Color = true,
	Shadows = true,
	Angle = true,
	Face = true,
}

local POST_EFFECT_PROPERTY_OPTIONS_BY_CLASS = {
	ColorCorrectionEffect = {
		"Enabled",
		"Brightness",
		"Contrast",
		"Saturation",
		"TintColor",
	},
	BloomEffect = {
		"Enabled",
		"Intensity",
		"Size",
		"Threshold",
	},
	BlurEffect = {
		"Enabled",
		"Size",
	},
	DepthOfFieldEffect = {
		"Enabled",
		"FocusDistance",
		"InFocusRadius",
		"NearIntensity",
		"FarIntensity",
	},
	SunRaysEffect = {
		"Enabled",
		"Intensity",
		"Spread",
	},
}

local POST_EFFECT_PROPERTIES = {}
for _, propertyOptions in pairs(POST_EFFECT_PROPERTY_OPTIONS_BY_CLASS) do
	for _, propertyName in ipairs(propertyOptions) do
		POST_EFFECT_PROPERTIES[propertyName] = true
	end
end

local TEXT_GUI_PROPERTIES = {
	Text = true,
	TextColor3 = true,
	TextTransparency = true,
	TextStrokeColor3 = true,
	TextStrokeTransparency = true,
	TextSize = true,
	MaxVisibleGraphemes = true,
	BackgroundTransparency = true,
	BackgroundColor3 = true,
	Visible = true,
}

local WHOLE_RIG_PROPERTIES = {
	CFrame = true,
	Scale = true,
	Transparency = true,
	Color = true,
}

local NORMAL_ID_BY_NAME = {
	Back = Enum.NormalId.Back,
	Bottom = Enum.NormalId.Bottom,
	Down = Enum.NormalId.Bottom,
	Front = Enum.NormalId.Front,
	Left = Enum.NormalId.Left,
	Right = Enum.NormalId.Right,
	Top = Enum.NormalId.Top,
	Up = Enum.NormalId.Top,
}

local function getTrackInstance(track)
	local instance = track and track.instance
	if instance and instance:IsA("Motor6D") then
		return instance.Part1 or instance.Part0
	elseif instance and instance:IsA("Bone") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			return parent
		end
	end
	return instance
end

local function isDecalLike(instance)
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("Decal") or instance:IsA("Texture"))
end

local function isFaceTrack(track)
	return track ~= nil
		and (track.trackType == "Face"
			or track.targetScope == "Face"
			or track.valueType == "Face"
			or track.propertyName == "Face")
end

local function isLightLike(instance)
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("PointLight") or instance:IsA("SpotLight") or instance:IsA("SurfaceLight"))
end

local function isPostEffectLike(instance)
	return instance ~= nil
		and instance.Parent ~= nil
		and POST_EFFECT_PROPERTY_OPTIONS_BY_CLASS[instance.ClassName] ~= nil
end

local function isTextGuiLike(instance)
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
end

local function hasReadableProperty(instance, propertyName)
	local success = pcall(function()
		return instance[propertyName]
	end)
	return success
end

local function trim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function hasTrackableBasePart(instance)
	if not instance or not instance.Parent then
		return false
	end
	if instance:IsA("BasePart") then
		return true
	end
	if instance:IsA("Model") then
		return instance:FindFirstChildWhichIsA("BasePart", true) ~= nil
	end
	return false
end

local function normalizeTextureId(text)
	local raw = trim(text)
	if raw == "" then
		return nil
	end

	local assetId = raw:match("^%d+$")
		or raw:match("^rbxassetid://(%d+)$")
		or raw:match("[?&amp;]id=(%d+)")
	if assetId then
		return "rbxassetid://" .. assetId
	end

	if raw:match("^rbxasset://") or raw:match("^https?://") then
		return raw
	end

	return nil
end

function PropertyKeyframeValueService.getTargetInstance(track)
	return getTrackInstance(track)
end

function PropertyKeyframeValueService.isPostEffectInstance(instance)
	return isPostEffectLike(instance)
end

function PropertyKeyframeValueService.isTextGuiInstance(instance)
	return isTextGuiLike(instance)
end

function PropertyKeyframeValueService.getPostEffectPropertyOptions(instance)
	if not isPostEffectLike(instance) then
		return nil
	end
	return POST_EFFECT_PROPERTY_OPTIONS_BY_CLASS[instance.ClassName]
end

function PropertyKeyframeValueService.isPropertyAllowedForTrack(track, propertyName, isRigEditor)
	if not track or not propertyName then
		return false
	end

	if isRigEditor then
		return WHOLE_RIG_PROPERTIES[propertyName] == true
	end

	if isFaceTrack(track) then
		return propertyName == "Transparency"
	end

	local instance = getTrackInstance(track)
	if not instance or not instance.Parent then
		return false
	end

	if propertyName == "Scale" then
		return instance:IsA("Model") or instance:IsA("BasePart")
	end

	if DECAL_PROPERTIES[propertyName] and isDecalLike(instance) then
		return true
	end

	if LIGHT_PROPERTIES[propertyName] and isLightLike(instance) then
		return hasReadableProperty(instance, propertyName)
	end

	if POST_EFFECT_PROPERTIES[propertyName] and isPostEffectLike(instance) then
		return hasReadableProperty(instance, propertyName)
	end

	if TEXT_GUI_PROPERTIES[propertyName] and isTextGuiLike(instance) then
		return hasReadableProperty(instance, propertyName)
	end

	if PART_PROPERTIES[propertyName] then
		return hasTrackableBasePart(instance)
	end

	if DECAL_PROPERTIES[propertyName] then
		return false
	end

	return false
end

local function parseBooleanValue(propertyName, text)
	local raw = string.lower(trim(text))
	if raw == "true" or raw == "on" or raw == "yes" or raw == "1" then
		return true, true
	elseif raw == "false" or raw == "off" or raw == "no" or raw == "0" then
		return true, false
	end
	return false, "Type true/false or on/off for " .. tostring(propertyName) .. "."
end

function PropertyKeyframeValueService.isEditableValueTrack(track)
	if not track then
		return false
	end

	local propertyName = track.propertyName or track.name
	if track.targetScope == "RigProperty" then
		return propertyName == "Scale" or propertyName == "Transparency" or propertyName == "Color"
	end

	if track.targetScope == "ObjectProperty" then
		return PropertyKeyframeValueService.isPropertyAllowedForTrack(track, propertyName, false)
	end

	return false
end

local function parseNumberValue(propertyName, text, minValue, maxValue)
	local normalizedText = tostring(text or ""):gsub(",", ".")
	local value = tonumber(normalizedText)
	if not value then
		return false, "Type a number for " .. tostring(propertyName) .. "."
	end

	return true, math.clamp(value, minValue, maxValue)
end

local function parseColorValue(text)
	local raw = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local hex = raw:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		return true, Color3.fromRGB(
			tonumber(hex:sub(1, 2), 16),
			tonumber(hex:sub(3, 4), 16),
			tonumber(hex:sub(5, 6), 16)
		)
	end

	local values = {}
	for token in raw:gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value then
			table.insert(values, value)
		end
	end
	if #values &lt; 3 then
		return false, "Type Color as R,G,B or #RRGGBB."
	end

	if values[1] &lt;= 1 and values[2] &lt;= 1 and values[3] &lt;= 1 then
		return true, Color3.new(
			math.clamp(values[1], 0, 1),
			math.clamp(values[2], 0, 1),
			math.clamp(values[3], 0, 1)
		)
	end

	return true, Color3.fromRGB(
		math.clamp(math.floor(values[1] + 0.5), 0, 255),
		math.clamp(math.floor(values[2] + 0.5), 0, 255),
		math.clamp(math.floor(values[3] + 0.5), 0, 255)
	)
end

function PropertyKeyframeValueService.parseValue(propertyName, rawText)
	if propertyName == "Text" then
		return true, tostring(rawText or "")
	elseif propertyName == "Color" or propertyName == "Color3" or propertyName == "TintColor" or propertyName == "TextColor3" or propertyName == "TextStrokeColor3" or propertyName == "BackgroundColor3" then
		return parseColorValue(rawText)
	elseif propertyName == "Scale" then
		return parseNumberValue(propertyName, rawText, 0.01, 100)
	elseif propertyName == "Transparency" or propertyName == "Reflectance" or propertyName == "TextTransparency" or propertyName == "TextStrokeTransparency" or propertyName == "BackgroundTransparency" then
		return parseNumberValue(propertyName, rawText, 0, 1)
	elseif propertyName == "TextSize" then
		return parseNumberValue(propertyName, rawText, 1, 1000)
	elseif propertyName == "MaxVisibleGraphemes" then
		local ok, value = parseNumberValue(propertyName, rawText, -1, 100000)
		return ok, ok and math.floor(value + 0.5) or value
	elseif propertyName == "Contrast" or propertyName == "Saturation" then
		return parseNumberValue(propertyName, rawText, -1, 1)
	elseif propertyName == "Brightness" then
		return parseNumberValue(propertyName, rawText, -1, 100)
	elseif propertyName == "Range" then
		return parseNumberValue(propertyName, rawText, 0, 100)
	elseif propertyName == "Angle" then
		return parseNumberValue(propertyName, rawText, 0, 180)
	elseif propertyName == "Intensity" or propertyName == "NearIntensity" or propertyName == "FarIntensity" then
		return parseNumberValue(propertyName, rawText, 0, 10)
	elseif propertyName == "Size" then
		return parseNumberValue(propertyName, rawText, 0, 100)
	elseif propertyName == "Threshold" or propertyName == "Spread" then
		return parseNumberValue(propertyName, rawText, 0, 1)
	elseif propertyName == "FocusDistance" or propertyName == "InFocusRadius" then
		return parseNumberValue(propertyName, rawText, 0, 1000)
	elseif propertyName == "Enabled" or propertyName == "Shadows" or propertyName == "Visible" then
		return parseBooleanValue(propertyName, rawText)
	elseif propertyName == "Texture" then
		local normalizedTexture = normalizeTextureId(rawText)
		if normalizedTexture then
			return true, normalizedTexture
		end
		return false, "Type a Roblox image ID, rbxassetid:// ID, rbxasset:// path, or Roblox asset URL."
	elseif propertyName == "Face" then
		local raw = trim(rawText)
		local key = raw:sub(1, 1):upper() .. raw:sub(2):lower()
		local normalId = NORMAL_ID_BY_NAME[key]
		if normalId then
			return true, normalId
		end
		return false, "Type Front, Back, Left, Right, Top, or Bottom."
	end

	return false, "That property cannot be edited here."
end

return PropertyKeyframeValueService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX207">
        <Properties>
          <string name="Name">RepeatFramesService</string>
          <ProtectedString name="Source">local RepeatFramesService = {}

local DEFAULT_MAX_REPEATED_KEYS = 25000

local function trim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function parseFrameInput(input, fps)
	fps = math.max(1, math.floor(tonumber(fps) or 30))
	local text = trim(input)
	if text == "" then
		return nil
	end

	local secondsText = string.match(string.lower(text), "^([%d%.]+)%s*s$")
	if secondsText then
		return math.max(0, math.floor((tonumber(secondsText) or 0) * fps + 0.5))
	end

	local whole, subFrame = string.match(text, "^(%-?%d+)%s*:%s*(%-?%d+)$")
	if whole and subFrame then
		return math.max(0, (tonumber(whole) or 0) * fps + (tonumber(subFrame) or 0))
	end

	local value = tonumber(text)
	if value then
		return math.max(0, math.floor(value + 0.5))
	end

	return nil
end

local function formatFrameInput(frame, fps)
	fps = math.max(1, math.floor(tonumber(fps) or 30))
	frame = math.max(0, math.floor(tonumber(frame) or 0))
	return string.format("%d:%02d", math.floor(frame / fps), frame % fps)
end

local function getFrameBounds(keys)
	local minFrame = nil
	local maxFrame = nil
	for _, key in ipairs(keys or {}) do
		local frame = math.max(0, math.floor(tonumber(key.frame) or 0))
		minFrame = minFrame and math.min(minFrame, frame) or frame
		maxFrame = maxFrame and math.max(maxFrame, frame) or frame
	end
	return minFrame, maxFrame
end

local function cloneValue(value)
	if type(value) ~= "table" then
		return value
	end

	local cloned = {}
	for key, child in pairs(value) do
		cloned[key] = cloneValue(child)
	end
	return cloned
end

local function lerpValue(aValue, bValue, alpha)
	alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
	if typeof(aValue) == "CFrame" and typeof(bValue) == "CFrame" then
		return aValue:Lerp(bValue, alpha)
	end
	if type(aValue) == "number" and type(bValue) == "number" then
		return aValue + ((bValue - aValue) * alpha)
	end
	if typeof(aValue) == "Color3" and typeof(bValue) == "Color3" then
		return aValue:Lerp(bValue, alpha)
	end
	if typeof(aValue) == "Vector2" and typeof(bValue) == "Vector2" then
		return aValue:Lerp(bValue, alpha)
	end
	if typeof(aValue) == "Vector3" and typeof(bValue) == "Vector3" then
		return aValue:Lerp(bValue, alpha)
	end
	if type(aValue) == "table" and type(bValue) == "table" then
		local value = {}
		local seen = {}
		for key, leftValue in pairs(aValue) do
			seen[key] = true
			value[key] = bValue[key] ~= nil and lerpValue(leftValue, bValue[key], alpha) or cloneValue(leftValue)
		end
		for key, rightValue in pairs(bValue) do
			if not seen[key] then
				value[key] = cloneValue(rightValue)
			end
		end
		return value
	end
	return alpha &lt; 0.5 and aValue or bValue
end

local function makeKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

local function getLoopBlendFrames(options, spanFrames)
	spanFrames = math.max(0, math.floor(tonumber(spanFrames) or 0))
	if spanFrames &lt;= 4 or (options and options.disableLoopBlend == true) then
		return 0
	end

	local configured = options and tonumber(options.loopBlendFrames)
	if configured ~= nil then
		return math.clamp(math.floor(configured + 0.5), 0, spanFrames - 1)
	end

	return math.min(6, math.max(2, math.floor(spanFrames * 0.04 + 0.5)))
end

local function getLoopBlendAlpha(relativeFrame, spanFrames, blendFrames)
	relativeFrame = math.max(0, math.floor(tonumber(relativeFrame) or 0))
	spanFrames = math.max(0, math.floor(tonumber(spanFrames) or 0))
	blendFrames = math.max(0, math.floor(tonumber(blendFrames) or 0))
	if blendFrames &lt;= 0 or spanFrames &lt;= blendFrames then
		return 0
	end

	local blendStartFrame = spanFrames - blendFrames
	if relativeFrame &lt;= blendStartFrame then
		return 0
	end

	return math.clamp((relativeFrame - blendStartFrame) / blendFrames, 0, 1)
end

function RepeatFramesService.buildDefaults(timeline, selectedKeyRefs)
	local fps = timeline and timeline:getFps() or 30
	local durationFrames = timeline and timeline:getDurationFrames() or 0
	local keys = timeline and timeline:getTrackKeyValues(selectedKeyRefs or {}) or {}
	local minFrame, maxFrame = getFrameBounds(keys)
	local lengthFrames = 1
	if minFrame and maxFrame then
		lengthFrames = math.max(1, maxFrame - minFrame)
	end

	return {
		loopCount = "2",
		length = formatFrameInput(lengthFrames, fps),
		endTime = formatFrameInput((maxFrame or 0) + lengthFrames, fps),
		toEndTime = formatFrameInput(durationFrames, fps),
		selectedCount = #keys,
	}
end

function RepeatFramesService.repeatSelectedKeys(timeline, selectedKeyRefs, options)
	if not timeline then
		return false, "Timeline is not available.", {}
	end

	local sourceKeys = timeline:getTrackKeyValues(selectedKeyRefs or {})
	if #sourceKeys == 0 then
		return false, "Select keyframes before repeating.", {}
	end

	options = options or {}
	local fps = timeline:getFps()
	local minFrame, maxFrame = getFrameBounds(sourceKeys)
	if not minFrame or not maxFrame then
		return false, "No selected keyframe range could be repeated.", {}
	end

	local lengthFrames = tonumber(options.lengthFrames) or parseFrameInput(options.length, fps)
	if not lengthFrames or lengthFrames &lt;= 0 then
		lengthFrames = math.max(1, maxFrame - minFrame)
	end
	if lengthFrames &lt;= 0 then
		return false, "Repeat length must be at least 1 frame.", {}
	end

	table.sort(sourceKeys, function(a, b)
		local aFrame = math.max(0, math.floor(tonumber(a.frame) or 0))
		local bFrame = math.max(0, math.floor(tonumber(b.frame) or 0))
		if aFrame == bFrame then
			return tostring(a.jointPath or a.path or "") &lt; tostring(b.jointPath or b.path or "")
		end
		return aFrame &lt; bFrame
	end)

	local occupiedKeyIds = {}
	for _, key in ipairs(sourceKeys) do
		occupiedKeyIds[makeKeyId(key.jointPath or key.path, key.frame)] = true
	end

	local loopCount = math.max(0, math.floor(tonumber(options.loopCount) or 0))
	local repeatCopies = loopCount &gt; 0 and math.max(0, loopCount - 1) or 0
	local endFrame = nil
	if options.toEnd == true then
		endFrame = timeline:getDurationFrames()
		repeatCopies = 0
	else
		endFrame = tonumber(options.endFrame) or parseFrameInput(options.endTime, fps)
	end
	if repeatCopies &lt;= 0 and (not endFrame or endFrame &lt;= minFrame) then
		return false, "Enter a Loop Count of 2 or more, or choose an End Time after the selected keys.", {}
	end

	local repeatedKeys = {}
	local repeatedRefs = {}
	local sourceSeamKeys = {}
	local protectedKeyIds = type(options.protectedKeyIds) == "table" and options.protectedKeyIds or {}
	local skippedProtectedCount = 0
	local firstValueByPath = {}
	local loopBlendFrames = getLoopBlendFrames(options, maxFrame - minFrame)
	if loopBlendFrames &gt; 0 then
		for _, key in ipairs(sourceKeys) do
			local path = key.jointPath or key.path
			if path and firstValueByPath[path] == nil then
				firstValueByPath[path] = key.value
			end
		end

		for _, key in ipairs(sourceKeys) do
			local path = key.jointPath or key.path
			local relativeFrame = math.max(0, math.floor(tonumber(key.frame) or 0)) - minFrame
			local alpha = getLoopBlendAlpha(relativeFrame, maxFrame - minFrame, loopBlendFrames)
			local firstValue = path and firstValueByPath[path]
			if alpha &gt; 0 and firstValue ~= nil then
				table.insert(sourceSeamKeys, {
					jointPath = path,
					frame = key.frame,
					value = lerpValue(key.value, firstValue, alpha),
					easingStyle = "Linear",
					easingDirection = "InOut",
				})
			end
		end
	end
	local iterations = 0
	local index = 1
	while true do
		if repeatCopies &gt; 0 and index &gt; repeatCopies then
			break
		end
		local repeatStartFrame = minFrame + (lengthFrames * index)
		if endFrame and repeatStartFrame &gt; endFrame then
			break
		end

		local wroteAnyThisLoop = false
		for _, key in ipairs(sourceKeys) do
			local relativeFrame = math.max(0, math.floor(key.frame or 0)) - minFrame
			local targetFrame = repeatStartFrame + relativeFrame
			local targetId = makeKeyId(key.jointPath or key.path, targetFrame)
			local wouldOverwriteSeam = relativeFrame == 0 and targetFrame &gt; minFrame and occupiedKeyIds[targetId]
			local isProtectedTarget = protectedKeyIds[targetId] == true
			if isProtectedTarget then
				skippedProtectedCount += 1
			elseif (not wouldOverwriteSeam) and (not endFrame or targetFrame &lt;= endFrame) then
				local value = key.value
				local firstValue = firstValueByPath[key.jointPath or key.path]
				local loopBlendAlpha = getLoopBlendAlpha(relativeFrame, maxFrame - minFrame, loopBlendFrames)
				if loopBlendAlpha &gt; 0 and firstValue ~= nil then
					value = lerpValue(value, firstValue, loopBlendAlpha)
				end
				local easingStyle = key.easingStyle
				local easingDirection = key.easingDirection
				if loopBlendAlpha &gt; 0 then
					easingStyle = "Linear"
					easingDirection = "InOut"
				end
				table.insert(repeatedKeys, {
					jointPath = key.jointPath,
					frame = targetFrame,
					value = value,
					easingStyle = easingStyle,
					easingDirection = easingDirection,
				})
				table.insert(repeatedRefs, {
					jointPath = key.jointPath,
					frame = targetFrame,
				})
				occupiedKeyIds[targetId] = true
				wroteAnyThisLoop = true
				if #repeatedKeys &gt;= DEFAULT_MAX_REPEATED_KEYS then
					break
				end
			end
		end

		if wroteAnyThisLoop then
			iterations += 1
		end
		if #repeatedKeys &gt;= DEFAULT_MAX_REPEATED_KEYS then
			break
		end
		if repeatCopies &lt;= 0 and endFrame and repeatStartFrame + (maxFrame - minFrame) &gt;= endFrame then
			break
		end
		index += 1
	end

	if #repeatedKeys == 0 then
		local protectedMessage = skippedProtectedCount &gt; 0 and " Existing grouped keyframes were left untouched." or ""
		return false, "No repeat keyframes fit in that range." .. protectedMessage, {}
	end

	if #sourceSeamKeys &gt; 0 then
		timeline:pasteTrackKeyframes(sourceSeamKeys, 0)
	end

	local success, pasteMessage, pastedKeys = timeline:pasteTrackKeyframes(repeatedKeys, 0)
	if not success then
		return false, pasteMessage or "Could not repeat selected keyframes.", {}
	end

	local resultMessage = string.format(
		"Repeated %d keyframe%s across %d loop%s.",
		#pastedKeys,
		#pastedKeys == 1 and "" or "s",
		iterations,
		iterations == 1 and "" or "s"
	)
	if skippedProtectedCount &gt; 0 then
		resultMessage ..= string.format(" Skipped %d existing grouped keyframe%s.", skippedProtectedCount, skippedProtectedCount == 1 and "" or "s")
	end
	return true, resultMessage, repeatedRefs
end

return RepeatFramesService
</ProtectedString>
