        <Properties>
          <string name="Name">JointSelectionSupport</string>
          <ProtectedString name="Source">local JointSelectionSupport = {}

function JointSelectionSupport.isSelectableViewportMultiJoint(path, motorData)
	local motor = motorData and motorData.instance
	local isSelectableR6TorsoRoot = motor
		and motor:IsA("Motor6D")
		and motor.Part1
		and motor.Part1.Name == "Torso"
		and motor.Part0
		and motor.Part0.Name == "HumanoidRootPart"
		and motorData.rig
		and motorData.rig:FindFirstChildOfClass("Humanoid")
		and motorData.rig:FindFirstChildOfClass("Humanoid").RigType == Enum.HumanoidRigType.R6
	if tostring(path):find("HumanoidRootPart/Root", 1, true) ~= nil and not isSelectableR6TorsoRoot then
		return false
	end
	return true
end

function JointSelectionSupport.applyViewportMultiSelection(path, timeline, viewportMultiTrackPaths, selectedJointPath)
	local nextViewportMultiTrackPaths = {}
	for selectedPath, value in pairs(viewportMultiTrackPaths or {}) do
		if value and timeline:getMotorByPath(selectedPath) then
			nextViewportMultiTrackPaths[selectedPath] = true
		end
	end
	if selectedJointPath and timeline:getMotorByPath(selectedJointPath) then
		nextViewportMultiTrackPaths[selectedJointPath] = true
	end

	if not nextViewportMultiTrackPaths[path] then
		nextViewportMultiTrackPaths[path] = true
	end
	if next(nextViewportMultiTrackPaths) == nil then
		nextViewportMultiTrackPaths[path] = true
	end

	local nextSelectedTrackPaths = {}
	local nextSelectedJointPath = nil
	for selectedPath in pairs(nextViewportMultiTrackPaths) do
		if timeline:getMotorByPath(selectedPath)
			and (tostring(selectedPath):find("HumanoidRootPart/Root", 1, true) == nil or selectedPath == path) then
			nextSelectedTrackPaths[selectedPath] = true
			nextSelectedJointPath = nextSelectedJointPath or selectedPath
		end
	end
	if nextSelectedTrackPaths[path] then
		nextSelectedJointPath = path
	end

	return nextViewportMultiTrackPaths, nextSelectedTrackPaths, nextSelectedJointPath
end

function JointSelectionSupport.buildSelectionMessage(motorName, selectedCount)
	if selectedCount == 0 then
		return string.format("Deselected joint '%s'.", motorName)
	end
	return string.format("Selected joint '%s'%s.", motorName, selectedCount &gt; 1 and (" plus " .. tostring(selectedCount - 1) .. " more") or "")
end

return JointSelectionSupport
</ProtectedString>
