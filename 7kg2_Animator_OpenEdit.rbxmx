      <Item class="ModuleScript" referent="RBX134">
        <Properties>
          <string name="Name">EventKeyframeActionService</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local EventKeyframeActionService = {}

local function trimText(value)
	local text = tostring(value or "")
	text = string.gsub(text, "[%c]", " ")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	return text
end

local function normalizeCode(value)
	local text = tostring(value or "")
	text = string.gsub(text, "\r\n", "\n")
	text = string.gsub(text, "\r", "\n")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	return text
end

local function getDurationFrames(options, timeline)
	options = options or {}
	local explicitFrames = tonumber(options.durationFrames)
	if explicitFrames then
		return math.max(0, math.floor(explicitFrames + 0.5))
	end

	local seconds = tonumber(options.durationSeconds)
	if not seconds then
		return 0
	end

	local fps = timeline and type(timeline.getFps) == "function" and tonumber(timeline:getFps()) or 30
	return math.max(0, math.floor((seconds * math.max(1, fps)) + 0.5))
end

local function isEventTrack(track)
	return track ~= nil and (track.trackType == "Event" or track.valueType == "Event")
end

local function collectTargetFrames(deps, trackPath)
	local framesByKey = {}
	local selectedKeys = type(deps.getSelectedKeys) == "function" and deps.getSelectedKeys() or nil
	for _, key in pairs(selectedKeys or {}) do
		if key and key.jointPath == trackPath and key.frame ~= nil then
			framesByKey[math.max(0, math.floor(key.frame))] = true
		end
	end

	if next(framesByKey) == nil then
		local timeline = deps.timeline
		local frame = timeline and type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or 0
		framesByKey[math.max(0, math.floor(frame))] = true
	end

	local frames = {}
	for frame in pairs(framesByKey) do
		table.insert(frames, frame)
	end
	SelectionState.sortFrames(frames)
	return frames
end

function EventKeyframeActionService.setValue(deps, trackPath, eventName, payload, options)
	deps = deps or {}
	options = options or {}
	local timeline = deps.timeline
	local track = timeline and type(timeline.getTrackByPath) == "function" and timeline:getTrackByPath(trackPath) or nil
	if not isEventTrack(track) then
		local message = "Select an Event track or Event keyframe before naming an event."
		if type(deps.refreshUi) == "function" then
			deps.refreshUi(message)
		end
		return false, message
	end

	local cleanName = trimText(eventName)
	if cleanName == "" then
		cleanName = trimText(track.eventName or track.name)
	end
	if cleanName == "" then
		cleanName = "Event"
	end

	local value = {
		name = cleanName,
		payload = tostring(payload or ""),
	}
	local codeBegin = normalizeCode(options.codeBegin)
	local codeEnd = normalizeCode(options.codeEnd)
	local durationFrames = getDurationFrames(options, timeline)
	if codeBegin ~= "" then
		value.codeBegin = codeBegin
	end
	if codeEnd ~= "" then
		value.codeEnd = codeEnd
	end
	if durationFrames &gt; 0 then
		value.durationFrames = durationFrames
	end
	track.name = cleanName
	track.eventName = cleanName
	local frames = collectTargetFrames(deps, track.path)
	if type(deps.pushUndo) == "function" then
		deps.pushUndo("Name Event Keyframe")
	end
	if deps.changeHistoryService then
		deps.changeHistoryService:SetWaypoint("Before Name Event Keyframe")
	end

	local keyRefs = {}
	for _, frame in ipairs(frames) do
		local success, message = timeline:setTrackValueAtFrame(track.path, frame, value)
		if not success then
			if deps.historyService then
				deps.historyService:discardPendingUndo()
			end
			if type(deps.refreshUi) == "function" then
				deps.refreshUi(message or "Could not name the event keyframe.")
			end
			return false, message
		end
		table.insert(keyRefs, {
			jointPath = track.path,
			frame = frame,
		})
	end

	if type(deps.selectKeys) == "function" then
		deps.selectKeys(keyRefs)
	end
	if deps.changeHistoryService then
		deps.changeHistoryService:SetWaypoint("After Name Event Keyframe")
	end

	local message = string.format("Named %d event keyframe%s '%s'.", #frames, #frames == 1 and "" or "s", cleanName)
	if type(deps.refreshUi) == "function" then
		deps.refreshUi(message)
	end
	return true, message
end

return EventKeyframeActionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX135">
        <Properties>
          <string name="Name">EventScriptExecutionService</string>
          <ProtectedString name="Source">local EventScriptExecutionService = {}

local PREVIEW_FOLDER_NAME = "MegMoEventPreviewObjects"
local PREVIEW_OBJECT_ATTRIBUTE = "MegMoEventPreviewOwned"

local function trimText(value)
	local text = tostring(value or "")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	return text
end

local function markPreviewObject(instance)
	if typeof(instance) ~= "Instance" then
		return instance
	end

	pcall(function()
		instance:SetAttribute(PREVIEW_OBJECT_ATTRIBUTE, true)
	end)
	return instance
end

local function getPreviewFolder()
	local folder = workspace:FindFirstChild(PREVIEW_FOLDER_NAME)
	if folder and folder:IsA("Folder") then
		return folder
	end

	folder = Instance.new("Folder")
	folder.Name = PREVIEW_FOLDER_NAME
	folder.Archivable = false
	folder.Parent = workspace
	return folder
end

local function clearMarkedObjects(root)
	if typeof(root) ~= "Instance" then
		return 0
	end

	local cleared = 0
	for _, descendant in ipairs(root:GetDescendants()) do
		local ok, isPreviewObject = pcall(function()
			return descendant:GetAttribute(PREVIEW_OBJECT_ATTRIBUTE)
		end)
		if ok and isPreviewObject == true then
			cleared += 1
			descendant:Destroy()
		end
	end
	return cleared
end

function EventScriptExecutionService.clearPreviewObjects()
	local cleared = 0
	local folder = workspace:FindFirstChild(PREVIEW_FOLDER_NAME)
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			cleared += 1
			child:Destroy()
		end
	end

	cleared += clearMarkedObjects(workspace)
	local coreGuiOk, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if coreGuiOk then
		cleared += clearMarkedObjects(coreGui)
	end
	return cleared
end

local function createPreviewPart(name, properties)
	local part = Instance.new("Part")
	markPreviewObject(part)
	part.Name = tostring(name or "MegMoEventPreviewPart")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Size = Vector3.new(2, 2, 2)
	part.Parent = getPreviewFolder()

	for propertyName, propertyValue in pairs(properties or {}) do
		pcall(function()
			part[propertyName] = propertyValue
		end)
	end
	return part
end

local function createInstanceProxy()
	return setmetatable({
		new = function(className, parent)
			local instance = Instance.new(className)
			markPreviewObject(instance)
			if parent ~= nil then
				instance.Parent = parent
			end
			return instance
		end,
	}, {
		__index = Instance,
	})
end

local function attachPreviewHelpers(context)
	context.previewFolder = context.previewFolder or getPreviewFolder()
	context.markPreviewObject = context.markPreviewObject or markPreviewObject
	context.clearPreviewObjects = context.clearPreviewObjects or EventScriptExecutionService.clearPreviewObjects
	context.createPreviewPart = context.createPreviewPart or createPreviewPart
	context.MegMoPreview = context.MegMoPreview or {
		folder = context.previewFolder,
		mark = markPreviewObject,
		clear = EventScriptExecutionService.clearPreviewObjects,
		part = createPreviewPart,
	}
	return context
end

function EventScriptExecutionService.run(code, context)
	code = trimText(code)
	if code == "" then
		return true
	end

	if type(loadstring) ~= "function" then
		warn("[7kg2 Animator] Event code could not run because loadstring is unavailable in this Studio session.")
		return false, "loadstring unavailable"
	end

	local chunk, compileError = loadstring(code)
	if not chunk then
		warn("[7kg2 Animator] Event code compile error: " .. tostring(compileError))
		return false, compileError
	end

	context = attachPreviewHelpers(context or {})
	if type(setfenv) == "function" then
		local baseEnv = getfenv and getfenv() or _G
		local env = setmetatable({
			Instance = createInstanceProxy(),
			context = context,
			event = context.event,
			payload = context.payload,
			frame = context.frame,
			track = context.track,
			previewFolder = context.previewFolder,
			MegMoPreview = context.MegMoPreview,
		}, {
			__index = baseEnv,
		})
		setfenv(chunk, env)
	end

	local success, runtimeError = pcall(chunk)
	if not success then
		warn("[7kg2 Animator] Event code runtime error: " .. tostring(runtimeError))
	end
	return success, runtimeError
end

return EventScriptExecutionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX136">
        <Properties>
          <string name="Name">FadeClipVisualSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local FadeClipVisualSupport = {}

local HANDLE_COLOR = Color3.fromRGB(255, 246, 204)
local HANDLE_TEXT_COLOR = Color3.fromRGB(18, 13, 8)
local SELECTED_COLOR = Color3.fromRGB(132, 84, 255)

local lastClickKey = nil
local lastClickClock = 0

local function readableTextColor(color)
	if typeof(color) ~= "Color3" then
		return Color3.fromRGB(255, 248, 232)
	end
	local luminance = (color.R * 0.299) + (color.G * 0.587) + (color.B * 0.114)
	return luminance &gt; 0.58 and Color3.fromRGB(18, 13, 8) or Color3.fromRGB(255, 248, 232)
end

local function formatTransparency(value)
	return string.format("%.2f", math.clamp(tonumber(value) or 0, 0, 1)):gsub("0+$", ""):gsub("%.$", "")
end

function FadeClipVisualSupport.buildTooltip(label, clip)
	local lines = { tostring(label or "Fade") }
	if type(clip) == "table" then
		lines[#lines + 1] = string.format("Frames %d-%d", math.floor(tonumber(clip.frame) or 0), math.floor(tonumber(clip.endFrame) or 0))
		lines[#lines + 1] = string.format("Transparency %s -&gt; %s", formatTransparency(clip.startTransparency), formatTransparency(clip.endTransparency))
	end
	return table.concat(lines, "\n")
end

local function makeEdgeHandle(config)
	local make = config.make
	local parent = config.parent
	if type(make) ~= "function" or not parent then
		return nil
	end

	local side = config.side == "left" and "left" or "right"
	local clipWidth = math.max(24, tonumber(config.clipWidth) or 24)
	local clipHeight = math.max(12, tonumber(config.clipHeight) or 18)
	local startFrame = math.max(0, math.floor(tonumber(config.startFrame) or 0))
	local endFrame = math.max(startFrame + 1, math.floor(tonumber(config.endFrame) or (startFrame + 1)))
	local visibleStartFrame = tonumber(config.visibleStartFrame) or 0
	local visibleFrameRange = math.max(1, tonumber(config.visibleFrameRange) or 1)
	local timelinePixelWidth = math.max(1, tonumber(config.timelinePixelWidth) or 1)
	local durationFrames = math.max(1, tonumber(config.durationFrames) or 1)
	local timelineLayer = config.timelineLayer
	local gutter = tonumber(config.gutter) or 0
	local statusLabel = config.statusLabel
	local refresh = config.refresh
	local targetFrame = side == "left" and startFrame or endFrame
	local draggingAttribute = side == "left" and "MegMoFadeStartDragging" or "MegMoFadeEndDragging"
	local suppressAttribute = side == "left" and "MegMoFadeStartSuppressClick" or "MegMoFadeEndSuppressClick"

	local handle = make("TextButton", {
		Name = side == "left" and "FadeStartHandle" or "FadeEndHandle",
		Active = true,
		AutoButtonColor = true,
		AnchorPoint = side == "right" and Vector2.new(1, 0) or Vector2.new(0, 0),
		BackgroundColor3 = HANDLE_COLOR,
		BackgroundTransparency = 0.02,
		BorderSizePixel = 0,
		Position = side == "right" and UDim2.new(1, 0, 0, 0) or UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(math.min(14, math.max(9, math.floor(clipWidth * 0.22))), clipHeight),
		Font = Enum.Font.GothamBold,
		Text = "||",
		TextColor3 = HANDLE_TEXT_COLOR,
		TextSize = 10,
		TextTransparency = 0.04,
		ZIndex = (tonumber(config.zIndex) or 12) + 8,
	}, parent)

	local dragging = false
	local inputChangedConnection
	local inputEndedConnection
	local destroyConnection

	local function disconnect()
		if inputChangedConnection then
			inputChangedConnection:Disconnect()
			inputChangedConnection = nil
		end
		if inputEndedConnection then
			inputEndedConnection:Disconnect()
			inputEndedConnection = nil
		end
		if destroyConnection then
			destroyConnection:Disconnect()
			destroyConnection = nil
		end
	end

	local function frameFromInput(input)
		local absoluteX = input and input.Position and input.Position.X or 0
		if type(config.frameFromScreenX) == "function" then
			local rawFrame = tonumber(config.frameFromScreenX(absoluteX)) or targetFrame
			if side == "left" then
				return math.clamp(math.floor(rawFrame + 0.5), 0, endFrame - 1)
			end
			return math.clamp(math.floor(rawFrame + 0.5), startFrame + 1, durationFrames)
		end
		local layerX = timelineLayer and timelineLayer.AbsolutePosition.X or 0
		local alpha = (absoluteX - layerX - gutter) / timelinePixelWidth
		local rawFrame = visibleStartFrame + (alpha * visibleFrameRange)
		if side == "left" then
			return math.clamp(math.floor(rawFrame + 0.5), 0, endFrame - 1)
		end
		return math.clamp(math.floor(rawFrame + 0.5), startFrame + 1, durationFrames)
	end

	local function previewFrame(frame)
		targetFrame = math.floor(tonumber(frame) or targetFrame)
		local startX = gutter + (((startFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		local endX = gutter + (((endFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		if side == "left" then
			startX = gutter + (((targetFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		else
			endX = gutter + (((targetFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		end
		local nextWidth = math.max(24, endX - startX)
		if parent and parent.Parent then
			parent.Position = UDim2.fromOffset(startX, parent.Position.Y.Offset)
			parent.Size = UDim2.fromOffset(nextWidth, clipHeight)
		end
		if statusLabel then
			statusLabel.Text = string.format("%s fade: frame %d.", side == "left" and "Start" or "End", targetFrame)
		end
	end

	local function finishDrag()
		if not dragging then
			return
		end
		dragging = false
		if parent and parent.Parent then
			parent:SetAttribute(draggingAttribute, false)
			parent:SetAttribute(suppressAttribute, true)
		end
		local callback = side == "left" and config.onSetStartFrame or config.onSetEndFrame
		local ok, message = false, "Fade handle is not connected yet. Restart Studio to load the latest 7kg2 build."
		if type(callback) == "function" then
			ok, message = callback(config.trackPath, startFrame, targetFrame)
		end
		if statusLabel and message then
			statusLabel.Text = tostring(message)
		end
		if ok ~= false and type(refresh) == "function" then
			task.defer(refresh)
		end
		task.delay(0.16, function()
			if parent and parent.Parent then
				parent:SetAttribute(suppressAttribute, false)
			end
		end)
	end

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if parent and parent.Parent then
			parent:SetAttribute(draggingAttribute, true)
			parent:SetAttribute(suppressAttribute, true)
		end
		dragging = true
		previewFrame(frameFromInput(input))
	end)
	handle.MouseButton1Down:Connect(function()
		if parent and parent.Parent then
			parent:SetAttribute(draggingAttribute, true)
			parent:SetAttribute(suppressAttribute, true)
		end
	end)

	inputChangedConnection = UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			previewFrame(frameFromInput(input))
		end
	end)
	inputEndedConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finishDrag()
		end
	end)
	destroyConnection = parent.Destroying:Connect(disconnect)
	return handle
end

function FadeClipVisualSupport.renderMicroClips(config)
	config = config or {}
	local make = config.make
	local keyLayer = config.keyLayer
	local track = config.track
	if type(make) ~= "function" or not keyLayer or type(track) ~= "table" then
		return
	end

	local visibleStartFrame = tonumber(config.visibleStartFrame) or 0
	local visibleEndFrame = tonumber(config.visibleEndFrame) or visibleStartFrame
	local visibleFrameRange = math.max(1, tonumber(config.visibleFrameRange) or 1)
	local timelinePixelWidth = math.max(1, tonumber(config.timelinePixelWidth) or 1)
	local gutter = tonumber(config.gutter) or 0
	local trackHeight = math.max(12, tonumber(config.trackHeight) or 22)
	local y = math.floor(tonumber(config.y) or 0)
	local durationFrames = math.max(1, tonumber(config.durationFrames) or 1)
	local selectedKeyMap = type(config.selectedKeyMap) == "table" and config.selectedKeyMap or {}
	local selectedKeyId = type(config.selectedKeyId) == "function" and config.selectedKeyId or function(path, frame)
		return tostring(path) .. "@" .. tostring(frame)
	end
	local clips = type(config.clips) == "table" and config.clips or {}

	for clipIndex, clip in ipairs(clips) do
		local frame = math.max(0, math.floor(tonumber(clip.frame) or 0))
		local endFrame = math.max(frame + 1, math.floor(tonumber(clip.endFrame) or (frame + 1)))
		if endFrame &lt; visibleStartFrame or frame &gt; visibleEndFrame then
			continue
		end

		local startX = gutter + (((frame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		local endX = gutter + (((endFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		local clipWidth = math.max(30, endX - startX)
		local clipHeight = math.max(18, trackHeight - 2)
		local clipY = y + math.floor((trackHeight - clipHeight) * 0.5)
		local keyId = selectedKeyId(track.path, frame)
		local keySelected = selectedKeyMap[keyId] == true
		local label = tostring(clip.label or "Fade")
		local clipColor = keySelected and SELECTED_COLOR or (typeof(clip.color) == "Color3" and clip.color or Color3.fromRGB(0, 0, 0))
		local textColor = readableTextColor(clipColor)

		local key = make("TextButton", {
			Name = string.format("FadeClip%d_%d", tonumber(config.trackIndex) or 0, clipIndex),
			Active = true,
			AutoButtonColor = true,
			BackgroundColor3 = clipColor,
			BackgroundTransparency = keySelected and 0.02 or 0.12,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(startX, clipY),
			Size = UDim2.fromOffset(clipWidth, clipHeight),
			Text = "",
			TextColor3 = textColor,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = tonumber(config.zIndex) or 9,
		}, keyLayer)

		if type(config.corner) == "function" then
			config.corner(key, 6)
		end

		make("UIGradient", {
			Name = "FadeDirectionGradient",
			Rotation = 0,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, math.clamp(tonumber(clip.startTransparency) or 0.5, 0.04, 0.82)),
				NumberSequenceKeypoint.new(1, math.clamp(tonumber(clip.endTransparency) or 0.5, 0.04, 0.82)),
			}),
		}, key)

		make("TextLabel", {
			Name = "FadeClipLabel",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -32, 1, 0),
			Text = clipWidth &gt; 48 and label or "",
			TextColor3 = textColor,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = key.ZIndex + 2,
		}, key)

		makeEdgeHandle({
			make = make,
			parent = key,
			side = "left",
			trackPath = track.path,
			startFrame = frame,
			endFrame = endFrame,
			clipWidth = clipWidth,
			clipHeight = clipHeight,
			visibleStartFrame = visibleStartFrame,
			visibleFrameRange = visibleFrameRange,
			timelinePixelWidth = timelinePixelWidth,
			timelineLayer = keyLayer,
			gutter = gutter,
			durationFrames = durationFrames,
			statusLabel = config.statusLabel,
			refresh = config.refresh,
			onSetStartFrame = config.onSetStartFrame,
			zIndex = key.ZIndex + 4,
		})
		makeEdgeHandle({
			make = make,
			parent = key,
			side = "right",
			trackPath = track.path,
			startFrame = frame,
			endFrame = endFrame,
			clipWidth = clipWidth,
			clipHeight = clipHeight,
			visibleStartFrame = visibleStartFrame,
			visibleFrameRange = visibleFrameRange,
			timelinePixelWidth = timelinePixelWidth,
			timelineLayer = keyLayer,
			gutter = gutter,
			durationFrames = durationFrames,
			statusLabel = config.statusLabel,
			refresh = config.refresh,
			onSetEndFrame = config.onSetEndFrame,
			zIndex = key.ZIndex + 4,
		})

		if type(config.visibleKeyRects) == "table" then
			config.visibleKeyRects[#config.visibleKeyRects + 1] = {
				path = track.path,
				frame = frame,
				centerX = startX + (clipWidth * 0.5),
				centerY = y + math.floor(trackHeight * 0.5),
			}
		end
		if type(config.visibleKeyButtons) == "table" then
			config.visibleKeyButtons[keyId] = {
				button = key,
				path = track.path,
				frame = frame,
				centerFrame = frame + ((endFrame - frame) * 0.5),
				x = startX + (clipWidth * 0.5),
				y = clipY,
				size = math.max(clipWidth, clipHeight),
			}
		end

		key.MouseEnter:Connect(function()
			if type(config.positionTooltip) == "function" then
				config.positionTooltip(key, config.toolHint, FadeClipVisualSupport.buildTooltip(label, clip), 4)
			end
		end)
		key.MouseMoved:Connect(function()
			if type(config.positionTooltip) == "function" then
				config.positionTooltip(key, config.toolHint, FadeClipVisualSupport.buildTooltip(label, clip), 4)
			end
		end)
		key.MouseLeave:Connect(function()
			if config.toolHint then
				config.toolHint.Visible = false
			end
		end)

		key.MouseButton1Click:Connect(function()
			if type(config.isRecentKeyDragRelease) == "function" and config.isRecentKeyDragRelease() then
				return
			end
			if key:GetAttribute("MegMoFadeStartDragging") == true or key:GetAttribute("MegMoFadeEndDragging") == true then
				return
			end
			if key:GetAttribute("MegMoFadeStartSuppressClick") == true or key:GetAttribute("MegMoFadeEndSuppressClick") == true then
				return
			end
			local clickKey = tostring(track.path) .. ":" .. tostring(frame)
			local now = os.clock()
			local isDoubleClick = lastClickKey == clickKey and (now - lastClickClock) &lt;= 0.34
			lastClickKey = clickKey
			lastClickClock = now
			if isDoubleClick then
				lastClickKey = nil
				lastClickClock = 0
				if config.editorController and type(config.editorController.show) == "function" then
					config.editorController.show(config.host, track.path, frame)
				end
				if config.statusLabel then
					config.statusLabel.Text = "Editing fade clip."
				end
				return
			end
			task.delay(0.36, function()
				if lastClickKey ~= clickKey or lastClickClock ~= now then
					return
				end
				lastClickKey = nil
				lastClickClock = 0
				if type(config.runOption) == "function" then
					if type(config.options) == "table" then
						config.options._microLastSelectionScope = "track"
					end
					config.runOption(config.options, "onSelectKey", "selectKey", track.path, frame, false)
				end
				if type(config.refresh) == "function" then
					config.refresh()
				end
			end)
		end)

		local function beginFadeClipDrag()
			if key:GetAttribute("MegMoFadeStartDragging") == true or key:GetAttribute("MegMoFadeEndDragging") == true then
				return
			end
			if key:GetAttribute("MegMoFadeStartSuppressClick") == true or key:GetAttribute("MegMoFadeEndSuppressClick") == true then
				return
			end
			local mouseLocation = UserInputService:GetMouseLocation()
			if mouseLocation.X &lt;= key.AbsolutePosition.X + 18 or mouseLocation.X &gt;= key.AbsolutePosition.X + key.AbsoluteSize.X - 18 then
				return
			end
			if type(config.onBeginClipDrag) == "function" then
				config.onBeginClipDrag(key, clip, keyId, frame, startX + (clipWidth * 0.5), clipY, clipWidth, clipHeight)
			end
		end
		key.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				beginFadeClipDrag()
			end
		end)
		key.MouseButton1Down:Connect(function()
			beginFadeClipDrag()
		end)
	end
end

return FadeClipVisualSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX137">
        <Properties>
          <string name="Name">FontPreviewService</string>
          <ProtectedString name="Source">local ServerStorage = game:GetService("ServerStorage")

local FontPreviewService = {}

local DEFAULT_FONT_ATTRIBUTE = "MegMoOriginalFontName"
local PRESERVE_FONT_ATTRIBUTE = "MegMoPreserveFont"
local SETTING_KEY = "MegMoAnimator.FontName"
local SETTINGS_FOLDER_NAME = "MegMoAnimatorSettings"
local FONT_VALUE_NAME = "FontName"
local currentFontName = "Default"

FontPreviewService.PRESERVE_FONT_ATTRIBUTE = PRESERVE_FONT_ATTRIBUTE

local function shouldPreserveFont(instance)
	local cursor = instance
	while cursor do
		if cursor:GetAttribute(PRESERVE_FONT_ATTRIBUTE) == true then
			return true
		end
		cursor = cursor.Parent
	end
	return false
end

local function isTextGui(instance)
	if instance.Name == "MegMoButtonTextOverlay" then
		return false
	end
	if shouldPreserveFont(instance) then
		return false
	end
	return instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")
end

local function enumFontFromName(fontName)
	local ok, enumValue = pcall(function()
		return Enum.Font[tostring(fontName or "")]
	end)
	if ok and enumValue then
		return enumValue
	end
	return nil
end

local function isKnownFontName(fontName)
	if fontName == nil or tostring(fontName) == "" then
		return false
	end
	fontName = tostring(fontName)
	return fontName == "Default" or enumFontFromName(fontName) ~= nil
end

local function normalizeFontName(fontName)
	fontName = tostring(fontName or "Default")
	if fontName == "" then
		fontName = "Default"
	end
	return isKnownFontName(fontName) and fontName or "Default"
end

local function getSettingsFolder(shouldCreate)
	local folder = ServerStorage:FindFirstChild(SETTINGS_FOLDER_NAME)
	if not folder and shouldCreate then
		folder = Instance.new("Folder")
		folder.Name = SETTINGS_FOLDER_NAME
		folder.Parent = ServerStorage
	end
	return folder
end

local function readPlaceFontName()
	local folder = getSettingsFolder(false)
	local value = folder and folder:FindFirstChild(FONT_VALUE_NAME)
	if value and value:IsA("StringValue") and isKnownFontName(value.Value) then
		return value.Value
	end
	return nil
end

local function writePlaceFontName(fontName)
	local folder = getSettingsFolder(true)
	if not folder then
		return false
	end
	local value = folder:FindFirstChild(FONT_VALUE_NAME)
	if not value then
		value = Instance.new("StringValue")
		value.Name = FONT_VALUE_NAME
		value.Parent = folder
	end
	if not value:IsA("StringValue") then
		return false
	end
	value.Value = tostring(fontName or "Default")
	return true
end

function FontPreviewService.getCurrentFontName()
	return currentFontName
end

function FontPreviewService.loadSavedFont(plugin)
	local savedFontName = nil
	if plugin then
		pcall(function()
			savedFontName = plugin:GetSetting(SETTING_KEY)
		end)
	end
	if not isKnownFontName(savedFontName) then
		savedFontName = readPlaceFontName()
	end
	currentFontName = normalizeFontName(savedFontName)
	return currentFontName
end

function FontPreviewService.saveFont(plugin, fontName)
	local normalized = normalizeFontName(fontName)
	currentFontName = normalized
	local pluginSaved = false
	if plugin then
		pcall(function()
			plugin:SetSetting(SETTING_KEY, normalized)
			pluginSaved = true
		end)
	end
	local placeSaved = writePlaceFontName(normalized)
	if normalized == "Default" then
		return pluginSaved or placeSaved, "Font saved as Default."
	end
	return pluginSaved or placeSaved, "Font saved as " .. normalized .. "."
end

function FontPreviewService.getFontNames()
	local names = { "Default" }
	local seen = {
		Default = true,
	}

	local enumItems = Enum.Font:GetEnumItems()
	table.sort(enumItems, function(a, b)
		return a.Name &lt; b.Name
	end)

	for _, font in ipairs(enumItems) do
		if not seen[font.Name] then
			seen[font.Name] = true
			table.insert(names, font.Name)
		end
	end

	return names
end

function FontPreviewService.apply(root, fontName)
	if not root then
		return false, "Font preview root is unavailable."
	end

	fontName = normalizeFontName(fontName or currentFontName)
	local useDefault = fontName == "Default"
	local selectedFont = nil
	if not useDefault then
		selectedFont = enumFontFromName(fontName)
		if not selectedFont then
			return false, "That font is not available in this Studio version."
		end
	end

	local changed = 0
	local function applyTo(instance)
		if not isTextGui(instance) then
			return
		end

		local ok, currentFont = pcall(function()
			return instance.Font
		end)
		if not ok or not currentFont then
			return
		end

		if not instance:GetAttribute(DEFAULT_FONT_ATTRIBUTE) then
			instance:SetAttribute(DEFAULT_FONT_ATTRIBUTE, currentFont.Name)
		end

		if useDefault then
			local originalFont = enumFontFromName(instance:GetAttribute(DEFAULT_FONT_ATTRIBUTE))
			if originalFont then
				instance.Font = originalFont
				instance:SetAttribute(DEFAULT_FONT_ATTRIBUTE, nil)
				changed += 1
			end
		else
			instance.Font = selectedFont
			changed += 1
		end
	end

	applyTo(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		applyTo(descendant)
	end

	if useDefault then
		return true, string.format("Font set to Default (%d text items).", changed)
	end
	return true, string.format("Font set to %s on %d text items.", tostring(fontName), changed)
end

return FontPreviewService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX138">
        <Properties>
          <string name="Name">FrameKeySelectionSupport</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local FrameKeySelectionSupport = {}

local function copySelectedKeys(selectedKeys)
	local nextSelectedKeys = {}
	for keyId, value in pairs(selectedKeys or {}) do
		nextSelectedKeys[keyId] = {
			jointPath = value.jointPath,
			frame = value.frame,
		}
	end
	return nextSelectedKeys
end

local function addTrackKey(nextSelectedKeys, path, frame)
	local keyId = SelectionState.makeTrackKeyId(path, frame)
	nextSelectedKeys[keyId] = {
		jointPath = path,
		frame = frame,
	}
end

local function addFrameKeys(timeline, nextSelectedKeys, frame)
	local selectedCount = 0
	if not (timeline and type(timeline.getTrackKeyframesByPath) == "function") then
		return selectedCount
	end

	for path, frames in pairs(timeline:getTrackKeyframesByPath()) do
		for _, keyFrame in ipairs(frames) do
			if keyFrame == frame then
				addTrackKey(nextSelectedKeys, path, frame)
				selectedCount += 1
				break
			elseif keyFrame &gt; frame then
				break
			end
		end
	end

	return selectedCount
end

function FrameKeySelectionSupport.selectFrameKeys(timeline, selectedKeys, frame, additive)
	frame = math.max(0, math.floor(frame or 0))
	local nextSelectedKeys = additive and copySelectedKeys(selectedKeys) or {}
	local selectedCount = addFrameKeys(timeline, nextSelectedKeys, frame)
	return nextSelectedKeys, selectedCount, frame
end

function FrameKeySelectionSupport.selectKeyframeRange(timeline, selectedKeys, startFrame, endFrame)
	startFrame = math.max(0, math.floor(startFrame or 0))
	endFrame = math.max(0, math.floor(endFrame or 0))
	if startFrame &gt; endFrame then
		startFrame, endFrame = endFrame, startFrame
	end

	local nextSelectedKeys = copySelectedKeys(selectedKeys)

	local selectedCount = 0
	for _, frame in ipairs(timeline:getKeyframeFrames()) do
		if frame &gt;= startFrame and frame &lt;= endFrame then
			selectedCount += addFrameKeys(timeline, nextSelectedKeys, frame)
		end
	end

	return nextSelectedKeys, selectedCount, startFrame, endFrame
end

function FrameKeySelectionSupport.toggleFrameSelection(selectedKeys, frame)
	local nextSelectedKeys = copySelectedKeys(selectedKeys)

	local hasSelectedKeyAtFrame = false
	for _, key in pairs(nextSelectedKeys) do
		if key.frame == frame then
			hasSelectedKeyAtFrame = true
			break
		end
	end

	if hasSelectedKeyAtFrame then
		for keyId, key in pairs(nextSelectedKeys) do
			if key.frame == frame then
				nextSelectedKeys[keyId] = nil
			end
		end
		return nextSelectedKeys, true
	end

	return nextSelectedKeys, false
end

function FrameKeySelectionSupport.selectSingleKey(selectedKeys, jointPath, frame)
	frame = math.max(0, math.floor(frame or 0))
	local nextSelectedKeys = copySelectedKeys(selectedKeys)
	addTrackKey(nextSelectedKeys, jointPath, frame)
	return nextSelectedKeys
end

return FrameKeySelectionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX139">
        <Properties>
          <string name="Name">GizmoController</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local AdornedGizmoLayer = require(script.Parent.AdornedGizmoLayer)
local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))
local RigService = require(script.Parent:WaitForChild("RigService"))

local DEG_TO_RAD = math.pi / 180
local ENABLE_ADORNED_GIZMOS = true
local MOVE_SENSITIVITY = 1
local MOVE_HANDLE_MIN_SCREEN_DISTANCE = 52
local MOVE_HANDLE_MAX_PERP_DISTANCE = 26
local MOVE_PICK_GUARD_MIN_SCREEN_DISTANCE = 18
local MOVE_PICK_GUARD_MAX_PERP_DISTANCE = 34
local GIZMO_PICK_ENVELOPE_PIXELS = 220
local ROTATE_PICK_GUARD_RADIUS_STUDS = 2.6
local ROTATE_PICK_GUARD_MIN_RADIUS_PIXELS = 34
local ROTATE_PICK_GUARD_BAND_PIXELS = 30
local LOCAL_ROTATE_COLOR = Color3.fromRGB(132, 86, 255)
local WORLD_ROTATE_COLOR = LOCAL_ROTATE_COLOR
local NATIVE_HANDLE_HOVER_GRACE_SECONDS = 0.18
local ATTACH_ATTRIBUTE = "MegMoAttachment"
local DEFAULT_GIZMO_SIZE_PERCENT = 100
local MIN_GIZMO_SIZE_PERCENT = 60
local MAX_GIZMO_SIZE_PERCENT = 140
local MOVE_AXIS_HANDLES = {
	{
		name = "MoveHandlesX",
		color = Color3.fromRGB(255, 80, 80),
		faces = Faces.new(Enum.NormalId.Right, Enum.NormalId.Left),
	},
	{
		name = "MoveHandlesY",
		color = Color3.fromRGB(80, 220, 110),
		faces = Faces.new(Enum.NormalId.Top, Enum.NormalId.Bottom),
	},
	{
		name = "MoveHandlesZ",
		color = Color3.fromRGB(80, 140, 255),
		faces = Faces.new(Enum.NormalId.Front, Enum.NormalId.Back),
	},
}

local GizmoController = {}
GizmoController.__index = GizmoController

local function safeConnect(signal, callback)
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	return ok and connection or nil
end

local function setViewportSelectionHighlightSuppressed(suppressed)
	pcall(function()
		local service = require(script.Parent:WaitForChild("ViewportPartSelectService"))
		if service and type(service.setSelectionHighlightSuppressed) == "function" then
			service.setSelectionHighlightSuppressed(suppressed == true)
		end
	end)
end

local function createProxyPart()
	local part = Instance.new("Part")
	part.Name = "MegMoAnimatorGizmoProxy"
	part.Size = Vector3.new(0.6, 0.6, 0.6)
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Anchored = true
	part.Locked = true
	part.Archivable = false
	return part
end

local function sanitizeProxyPart(part)
	if part and part:IsA("BasePart") then
		part.Transparency = 1
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Anchored = true
		part.Locked = true
		part.Archivable = false
	end
end

local function removeViewportProxyParts(exceptPart)
	for _, instance in ipairs(workspace:GetDescendants()) do
		if instance.Name == "MegMoAnimatorGizmoProxy" and instance:IsA("BasePart") and instance ~= exceptPart then
			instance:Destroy()
		end
	end
end

local function appendInstance(list, instance)
	if typeof(instance) == "Instance" then
		table.insert(list, instance)
	end
end

local function resolveInstancePath(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end

	local segments = string.split(path, ".")
	local current = nil
	if segments[1] == "game" then
		current = game
		table.remove(segments, 1)
	elseif segments[1] == "Workspace" or segments[1] == "workspace" then
		current = workspace
		table.remove(segments, 1)
	elseif segments[1] == "ServerStorage" then
		current = game:GetService("ServerStorage")
		table.remove(segments, 1)
	elseif segments[1] == "ReplicatedStorage" then
		current = game:GetService("ReplicatedStorage")
		table.remove(segments, 1)
	end

	for _, name in ipairs(segments) do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end
	return current
end

local function getTrackGizmoTargetPart(track)
	local path = track and track.gizmoTargetPath
	local instance = resolveInstancePath(path)
	if instance and instance.Parent and instance:IsA("BasePart") then
		return instance
	end
	return nil
end

local function findLiveAttachmentMotorForPart(part)
	if not (part and part.Parent and part:IsA("BasePart")) then
		return nil
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Motor6D")
			and descendant:GetAttribute(ATTACH_ATTRIBUTE) == true
			and descendant.Part1 == part
			and descendant.Part0
			and descendant.Part0.Parent then
			return descendant
		end
	end
	return nil
end

local function applyPartCFrameByProperties(part, cframe)
	if not (part and part.Parent and part:IsA("BasePart") and typeof(cframe) == "CFrame") then
		return false
	end
	local x, y, z = cframe:ToOrientation()
	part.Position = cframe.Position
	part.Orientation = Vector3.new(math.deg(x), math.deg(y), math.deg(z))
	return true
end

local function applyAttachedPartCFrame(part, cframe)
	if not findLiveAttachmentMotorForPart(part) then
		return false
	end
	return applyPartCFrameByProperties(part, cframe)
end

local function applyAttachedModelPivotFromTarget(model, targetPart, targetCFrame)
	if not (model and model.Parent and model:IsA("Model")) then
		return false
	end
	if not (targetPart and targetPart.Parent and targetPart:IsDescendantOf(model)) then
		return false
	end
	if not findLiveAttachmentMotorForPart(targetPart) then
		return false
	end

	local currentPivot = model:GetPivot()
	local nextPivot = targetCFrame * targetPart.CFrame:Inverse() * currentPivot
	local delta = nextPivot * currentPivot:Inverse()
	local partTargets = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			partTargets[#partTargets + 1] = {
				part = descendant,
				cframe = delta * descendant.CFrame,
			}
		end
	end
	for _, item in ipairs(partTargets) do
		applyPartCFrameByProperties(item.part, item.cframe)
	end
	return #partTargets &gt; 0
end

local function appendMotorTargetInstances(list, motorData)
	local motor = motorData and motorData.instance
	appendInstance(list, motor)
	if motor and motor:IsA("Motor6D") then
		appendInstance(list, motor.Part0)
		appendInstance(list, motor.Part1)
	elseif motor and motor:IsA("Bone") then
		appendInstance(list, motor.Parent)
	end
end

local function appendTrackTargetInstances(list, trackData)
	if type(trackData) ~= "table" then
		return
	end
	for _, key in ipairs({ "instance", "target", "object", "part", "model", "adornee" }) do
		appendInstance(list, trackData[key])
	end
	appendInstance(list, getTrackGizmoTargetPart(trackData))
end

local function faceToOffset(face, distance)
	if face == Enum.NormalId.Right then
		return Vector3.new(distance, 0, 0)
	elseif face == Enum.NormalId.Left then
		return Vector3.new(-distance, 0, 0)
	elseif face == Enum.NormalId.Top then
		return Vector3.new(0, distance, 0)
	elseif face == Enum.NormalId.Bottom then
		return Vector3.new(0, -distance, 0)
	elseif face == Enum.NormalId.Back then
		return Vector3.new(0, 0, distance)
	elseif face == Enum.NormalId.Front then
		return Vector3.new(0, 0, -distance)
	end

	return Vector3.zero
end

local function getMousePoint(plugin)
	if plugin then
		local ok, mouse = pcall(function()
			return plugin:GetMouse()
		end)
		if ok and mouse then
			local x = tonumber(mouse.X)
			local y = tonumber(mouse.Y)
			if x and y then
				return Vector2.new(x, y)
			end
		end
	end

	local inputOk, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if inputOk and typeof(mouseLocation) == "Vector2" then
		return mouseLocation
	end

	return nil
end

local function appendScreenPoint(points, point)
	if typeof(point) == "Vector2" then
		table.insert(points, point)
	elseif type(point) == "table" then
		local x = tonumber(point.X)
		local y = tonumber(point.Y)
		if x and y then
			table.insert(points, Vector2.new(x, y))
		end
	end
end

local function collectScreenPoints(plugin, overridePoint)
	local points = {}
	appendScreenPoint(points, overridePoint)
	appendScreenPoint(points, getMousePoint(plugin))
	local inputOk, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if inputOk and typeof(mouseLocation) == "Vector2" then
		appendScreenPoint(points, mouseLocation)
		pcall(function()
			local guiInset = game:GetService("GuiService"):GetGuiInset()
			if typeof(guiInset) == "Vector2" then
				appendScreenPoint(points, mouseLocation - guiInset)
			end
		end)
	end
	return points
end

local function isScreenPointNearWorldPosition(screenPoint, worldPosition, maxDistance)
	local camera = workspace.CurrentCamera
	if not (camera and typeof(screenPoint) == "Vector2" and typeof(worldPosition) == "Vector3") then
		return false
	end
	local projected = camera:WorldToViewportPoint(worldPosition)
	if projected.Z &lt;= 0 then
		return false
	end
	return (screenPoint - Vector2.new(projected.X, projected.Y)).Magnitude &lt;= maxDistance
end

local function isPointerNearProjectedGizmoEnvelope(plugin, origin, overridePoint)
	for _, screenPoint in ipairs(collectScreenPoints(plugin, overridePoint)) do
		if isScreenPointNearWorldPosition(screenPoint, origin, GIZMO_PICK_ENVELOPE_PIXELS) then
			return true
		end
	end
	return false
end

local function worldDirectionToScreenDirection(camera, origin, worldDirection)
	if not (camera and typeof(origin) == "Vector3" and typeof(worldDirection) == "Vector3") then
		return nil, nil
	end
	if worldDirection.Magnitude &lt;= 0 then
		return nil, nil
	end

	local center = camera:WorldToViewportPoint(origin)
	local edge = camera:WorldToViewportPoint(origin + worldDirection.Unit)
	if center.Z &lt;= 0 or edge.Z &lt;= 0 then
		return nil, nil
	end

	local center2 = Vector2.new(center.X, center.Y)
	local direction2 = Vector2.new(edge.X - center.X, edge.Y - center.Y)
	if direction2.Magnitude &lt;= 0.001 then
		return nil, nil
	end

	return center2, direction2.Unit
end

local function isWorldPointVisibleFromCamera(worldPoint)
	local camera = workspace.CurrentCamera
	if not (camera and typeof(worldPoint) == "Vector3") then
		return true
	end

	local origin = camera.CFrame.Position
	local direction = worldPoint - origin
	local distance = direction.Magnitude
	if distance &lt;= 0.01 then
		return true
	end

	local params = RaycastParams.new()
	params.IgnoreWater = true
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {}

	local result = workspace:Raycast(origin, direction, params)
	if not result then
		return true
	end

	return (result.Position - origin).Magnitude &gt;= distance - 0.15
end

local function getProjectedAxisSamplePoint(plugin, origin, worldDirection, minAlong, maxPerpendicular, overridePoint)
	local mousePoint = typeof(overridePoint) == "Vector2" and overridePoint or getMousePoint(plugin)
	local camera = workspace.CurrentCamera
	local center2, axis2 = worldDirectionToScreenDirection(camera, origin, worldDirection)
	if not (mousePoint and center2 and axis2) then
		return true, typeof(worldDirection) == "Vector3" and worldDirection.Magnitude &gt; 0 and (origin + worldDirection.Unit) or origin
	end

	local delta = mousePoint - center2
	local along = delta:Dot(axis2)
	if along &lt; minAlong then
		return false, nil
	end

	local perpendicular = (delta - (axis2 * along)).Magnitude
	if perpendicular &gt; maxPerpendicular then
		return false, nil
	end

	local edge = camera:WorldToViewportPoint(origin + worldDirection.Unit)
	local pixelsPerStud = (Vector2.new(edge.X, edge.Y) - center2).Magnitude
	local studsAlong = pixelsPerStud &gt; 0.001 and math.clamp(along / pixelsPerStud, 0.35, 8) or 1
	return true, origin + (worldDirection.Unit * studsAlong)
end

local function getProjectedAxisSamplePointForAnyScreenPoint(plugin, origin, worldDirection, minAlong, maxPerpendicular, overridePoint)
	local points = collectScreenPoints(plugin, overridePoint)
	if #points == 0 then
		return getProjectedAxisSamplePoint(plugin, origin, worldDirection, minAlong, maxPerpendicular, nil)
	end

	for _, point in ipairs(points) do
		local near, samplePoint = getProjectedAxisSamplePoint(
			plugin,
			origin,
			worldDirection,
			minAlong,
			maxPerpendicular,
			point
		)
		if near == true then
			return true, samplePoint
		end
	end
	return false, nil
end

local function isMouseNearVisibleProjectedAxisEnd(plugin, origin, worldDirection, minAlong, maxPerpendicular, overridePoint)
	local near, samplePoint = getProjectedAxisSamplePointForAnyScreenPoint(
		plugin,
		origin,
		worldDirection,
		minAlong,
		maxPerpendicular,
		overridePoint
	)
	if not near then
		return false
	end
	return isWorldPointVisibleFromCamera(samplePoint)
end

local function isMouseNearProjectedAxisHandle(plugin, origin, worldDirection, minAlong, maxPerpendicular, overridePoint)
	local near = getProjectedAxisSamplePointForAnyScreenPoint(
		plugin,
		origin,
		worldDirection,
		minAlong,
		maxPerpendicular,
		overridePoint
	)
	return near == true
end

local function isMouseNearProjectedRotateHandle(plugin, origin, requireVisible, overridePoint)
	local camera = workspace.CurrentCamera
	if not (camera and typeof(origin) == "Vector3") then
		return false
	end

	local center = camera:WorldToViewportPoint(origin)
	if center.Z &lt;= 0 then
		return false
	end

	local edge = camera:WorldToViewportPoint(origin + camera.CFrame.RightVector * ROTATE_PICK_GUARD_RADIUS_STUDS)
	if edge.Z &lt;= 0 then
		return false
	end

	local center2 = Vector2.new(center.X, center.Y)
	local radius = math.max(ROTATE_PICK_GUARD_MIN_RADIUS_PIXELS, (Vector2.new(edge.X, edge.Y) - center2).Magnitude)
	for _, mousePoint in ipairs(collectScreenPoints(plugin, overridePoint)) do
		local distance = (mousePoint - center2).Magnitude
		if math.abs(distance - radius) &lt;= ROTATE_PICK_GUARD_BAND_PIXELS then
			local screenDirection = mousePoint - center2
			if screenDirection.Magnitude &lt;= 0.001 then
				return requireVisible == false or isWorldPointVisibleFromCamera(origin)
			end

			local unit = screenDirection.Unit
			local samplePoint = origin
				+ (camera.CFrame.RightVector * unit.X * ROTATE_PICK_GUARD_RADIUS_STUDS)
				- (camera.CFrame.UpVector * unit.Y * ROTATE_PICK_GUARD_RADIUS_STUDS)
			return requireVisible == false or isWorldPointVisibleFromCamera(samplePoint)
		end
	end
	return false
end

local function getMoveAxisFaces(axisConfig)
	if axisConfig.name == "MoveHandlesX" then
		return Enum.NormalId.Right, Enum.NormalId.Left
	elseif axisConfig.name == "MoveHandlesY" then
		return Enum.NormalId.Top, Enum.NormalId.Bottom
	elseif axisConfig.name == "MoveHandlesZ" then
		return Enum.NormalId.Front, Enum.NormalId.Back
	end
	return nil, nil
end

local function axisToRotation(axis, deltaAngle)
	if axis == Enum.Axis.X then
		return CFrame.Angles(deltaAngle, 0, 0)
	elseif axis == Enum.Axis.Y then
		return CFrame.Angles(0, deltaAngle, 0)
	elseif axis == Enum.Axis.Z then
		return CFrame.Angles(0, 0, deltaAngle)
	end

	return CFrame.new()
end

local function axisToVector(axis)
	if axis == Enum.Axis.X then
		return Vector3.xAxis
	elseif axis == Enum.Axis.Y then
		return Vector3.yAxis
	elseif axis == Enum.Axis.Z then
		return Vector3.zAxis
	end
	return Vector3.zero
end

local function getMotorJointCFrame(motorData)
	return RigService.getJointWorldCFrame(motorData)
end

local function getMotorVisualCFrame(motorData)
	local motor = motorData and motorData.instance
	if not motor or not motor.Parent then
		return nil
	end

	if motor:IsA("Motor6D") and motor.Part1 and motor.Part1:IsA("BasePart") then
		return motor.Part1.CFrame
	end

	return RigService.getJointGizmoWorldCFrame(motorData)
end

local function applyMotorJointWorldCFrame(motorData, jointWorldCFrame)
	return RigService.applyJointWorldCFrame(motorData, jointWorldCFrame)
end

local function translateMotorJointWorld(motorData, worldOffset)
	local jointWorld = getMotorJointCFrame(motorData)
	if not jointWorld then
		return false
	end

	return applyMotorJointWorldCFrame(motorData, jointWorld + worldOffset)
end

local function rotateMotorJointWorld(motorData, worldAxis, deltaAngle)
	local jointWorld = getMotorJointCFrame(motorData)
	if not jointWorld or worldAxis.Magnitude &lt;= 0 then
		return false
	end

	local rotation = CFrame.fromAxisAngle(worldAxis.Unit, deltaAngle)
	local jointRotationOnly = jointWorld - jointWorld.Position
	return applyMotorJointWorldCFrame(motorData, CFrame.new(jointWorld.Position) * rotation * jointRotationOnly)
end

local function isR6MotorData(motorData)
	local rig = motorData and motorData.rig
	local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.RigType == Enum.HumanoidRigType.R6
end

local function rotateSingleMotorLocal(motorData, proxyCFrame, axis, deltaAngle)
	if not (motorData and motorData.instance and motorData.instance.Parent) then
		return false
	end

	if isR6MotorData(motorData) and typeof(proxyCFrame) == "CFrame" then
		local worldAxis = proxyCFrame:VectorToWorldSpace(axisToVector(axis))
		return rotateMotorJointWorld(motorData, worldAxis, deltaAngle)
	end

	if RigService.isBoneJoint(motorData) and typeof(proxyCFrame) == "CFrame" then
		local worldAxis = proxyCFrame:VectorToWorldSpace(axisToVector(axis))
		return rotateMotorJointWorld(motorData, worldAxis, deltaAngle)
	end

	local pose = RigService.getJointPose(motorData)
	if not pose then
		return false
	end
	return RigService.setJointPose(motorData, pose * axisToRotation(axis, deltaAngle))
end

local function isRigCFrameTrack(track)
	return track
		and track.targetScope == "RigProperty"
		and track.propertyName == "CFrame"
end

local function getRigRootPart(instance)
	if not (instance and instance.Parent and instance:IsA("Model")) then
		return nil
	end
	local rootPart = instance:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	for _, rootName in ipairs({ "Torso", "LowerTorso", "UpperTorso" }) do
		local torsoPart = instance:FindFirstChild(rootName)
		if torsoPart and torsoPart:IsA("BasePart") then
			return torsoPart
		end
	end
	local primaryPart = instance.PrimaryPart
	if primaryPart and primaryPart.Parent and primaryPart:IsA("BasePart") then
		return primaryPart
	end
	return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getTrackTargetCFrame(track)
	if track and track.trackType == "Camera" then
		local camera = workspace.CurrentCamera
		if camera then
			return camera.CFrame
		end
	end

	local instance = track and track.instance
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("Camera") or instance:IsA("BasePart") then
		return instance.CFrame
	end

	if instance:IsA("Model") then
		local gizmoTargetPart = getTrackGizmoTargetPart(track)
		if gizmoTargetPart and gizmoTargetPart:IsDescendantOf(instance) then
			return gizmoTargetPart.CFrame
		end
		if isRigCFrameTrack(track) then
			local rootPart = getRigRootPart(instance)
			if rootPart then
				return rootPart.CFrame
			end
		end
		return instance:GetPivot()
	end

	return nil
end

local function applyTrackTargetCFrame(track, cframe)
	if track and track.trackType == "Camera" then
		local camera = workspace.CurrentCamera
		if camera and typeof(cframe) == "CFrame" then
			camera.CFrame = cframe
			return true
		end
	end

	local instance = track and track.instance
	if not instance or not instance.Parent or typeof(cframe) ~= "CFrame" then
		return false
	end

	if instance:IsA("Camera") then
		instance.CFrame = cframe
		return true
	end

	if instance:IsA("BasePart") then
		if applyAttachedPartCFrame(instance, cframe) then
			return true
		end
		instance.CFrame = cframe
		return true
	end

	if instance:IsA("Model") then
		local gizmoTargetPart = getTrackGizmoTargetPart(track)
		if gizmoTargetPart and gizmoTargetPart:IsDescendantOf(instance) then
			if applyAttachedModelPivotFromTarget(instance, gizmoTargetPart, cframe) then
				return true
			end
			instance:PivotTo(cframe * gizmoTargetPart.CFrame:Inverse() * instance:GetPivot())
			return true
		end
		if isRigCFrameTrack(track) then
			local rootPart = getRigRootPart(instance)
			if rootPart then
				instance:PivotTo(cframe * rootPart.CFrame:Inverse() * instance:GetPivot())
				return true
			end
		end
		instance:PivotTo(cframe)
		return true
	end

	return false
end

local function translateTrackTargetWorld(track, worldOffset)
	local cframe = getTrackTargetCFrame(track)
	if not cframe then
		return false
	end
	return applyTrackTargetCFrame(track, cframe + worldOffset)
end

local function quantizeDistance(distance, step)
	if step &lt;= 0 then
		return distance
	end

	return math.round(distance / step) * step
end

local function axisName(axis)
	if axis == Enum.Axis.X then
		return "X"
	elseif axis == Enum.Axis.Y then
		return "Y"
	elseif axis == Enum.Axis.Z then
		return "Z"
	end
	return "?"
end

local function faceName(face)
	if face == Enum.NormalId.Right or face == Enum.NormalId.Left then
		return "X"
	elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		return "Y"
	elseif face == Enum.NormalId.Front or face == Enum.NormalId.Back then
		return "Z"
	end
	return "?"
end

local function normalIdToWorldDirection(cframe, face)
	local offset = faceToOffset(face, 1)
	if offset.Magnitude &lt;= 0 then
		return nil
	end
	return cframe:VectorToWorldSpace(offset)
end

local function createDragReadout(parent, adornee)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GizmoDragReadout"
	billboard.Adornee = adornee
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Size = UDim2.fromOffset(150, 46)
	billboard.StudsOffset = Vector3.new(1.4, 1.2, 0)
	billboard.Parent = parent

	local label = Instance.new("TextLabel")
	label.BackgroundColor3 = Color3.fromRGB(18, 22, 34)
	label.BackgroundTransparency = 0.12
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamSemibold
	label.TextColor3 = Color3.fromRGB(236, 230, 255)
	label.TextSize = 12
	label.TextWrapped = true
	label.Size = UDim2.fromScale(1, 1)
	label.Text = ""
	label.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(132, 86, 255)
	stroke.Thickness = 1
	stroke.Transparency = 0.1
	stroke.Parent = label

	return billboard, label, stroke
end

function GizmoController.new(plugin)
	local self = setmetatable({}, GizmoController)
	self._plugin = plugin
	self._mode = "Move"
	self._motorData = nil
	self._motorDataList = nil
	self._trackData = nil
	self._suppressed = false
	self._hideHandleVisuals = false
	self._rotateSpace = "Local"
	self._callbacks = {}
	self._moveSnap = 0.25
	self._rotateSnap = 15 * DEG_TO_RAD
	self._gizmoSizePercent = DEFAULT_GIZMO_SIZE_PERCENT
	self._lastMoveDistance = 0
	self._lastArcAngle = 0
	self._dragReadout = nil
	self._dragReadoutLabel = nil
	self._moveDragAllowed = false
	self._nativeRotateHandleHoverUntil = 0
	self._useAdornedGizmos = ENABLE_ADORNED_GIZMOS
	self._targetConnections = {}

	self._folder = Instance.new("Folder")
	self._folder.Name = "MegMoAnimatorGizmos"
	self._folder.Parent = CoreGui

	removeViewportProxyParts()
	self._proxyPart = createProxyPart()

	self._moveHandles = {}
	for _, axisConfig in ipairs(MOVE_AXIS_HANDLES) do
		local moveHandles = Instance.new("Handles")
		moveHandles.Name = axisConfig.name
		moveHandles.Style = Enum.HandlesStyle.Movement
		moveHandles.Color3 = axisConfig.color
		moveHandles.Faces = axisConfig.faces
		moveHandles.Transparency = 0
		moveHandles.Adornee = self._proxyPart
		moveHandles.Parent = self._folder
		table.insert(self._moveHandles, moveHandles)
	end

	self._rotateHandles = Instance.new("ArcHandles")
	self._rotateHandles.Name = "RotateHandles"
	self._rotateHandles.Color3 = LOCAL_ROTATE_COLOR
	self._rotateHandles.Transparency = 0
	self._rotateHandles.Adornee = self._proxyPart
	self._rotateHandles.Parent = self._folder
	safeConnect(self._rotateHandles.MouseEnter, function()
		self._nativeRotateHandleHoverUntil = os.clock() + NATIVE_HANDLE_HOVER_GRACE_SECONDS
	end)
	safeConnect(self._rotateHandles.MouseLeave, function()
		self._nativeRotateHandleHoverUntil = 0
	end)

	self._dragReadout, self._dragReadoutLabel, self._dragReadoutStroke = createDragReadout(self._folder, self._proxyPart)
	if self._useAdornedGizmos then
		self._adornedLayer = AdornedGizmoLayer.new(self._proxyPart, {
			onMoveDown = function(face)
				self:_beginAdornedMoveDrag(face)
			end,
			onMoveDrag = function(face, distance)
				self:_updateMoveDrag(face, distance)
			end,
			onMoveUp = function()
				self:_endMoveDrag()
			end,
			onRotateDown = function()
				self:_beginRotateDrag()
			end,
			onRotateDrag = function(axis, relativeAngle)
				self:_updateRotateDrag(axis, relativeAngle)
			end,
			onRotateUp = function()
				self:_endRotateDrag()
			end,
		})
	end

	self:_bind()
	self:_refreshVisibility()

	return self
end

function GizmoController:_ensureProxyParent()
	if self._proxyPart then
		sanitizeProxyPart(self._proxyPart)
		if self._proxyPart.Parent ~= workspace then
			removeViewportProxyParts(self._proxyPart)
			self._proxyPart.Parent = workspace
		end
	end
end

function GizmoController:_showDragReadout(text)
	if self._dragReadoutLabel then
		self._dragReadoutLabel.Text = tostring(text or "")
		self._dragReadoutLabel.BackgroundColor3 = Color3.fromRGB(18, 22, 34)
		self._dragReadoutLabel.TextColor3 = Color3.fromRGB(236, 230, 255)
	end
	if self._dragReadoutStroke then
		self._dragReadoutStroke.Color = LOCAL_ROTATE_COLOR
	end
	if self._dragReadout then
		self._dragReadout.Enabled = self:_hasTarget()
	end
end

function GizmoController:_dragReadoutPrefix()
	return (self._rotateSpace == "World" and "World" or "Local")
		.. " "
		.. (self._mode == "Rotate" and "Rotation" or "Move")
end

function GizmoController:_hideDragReadout()
	if self._dragReadout then
		self._dragReadout.Enabled = false
	end
end

function GizmoController:_clearTargetWatch()
	for _, connection in ipairs(self._targetConnections or {}) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	self._targetConnections = {}
	self._targetRefreshQueued = false
end

function GizmoController:_watchTargetInstances(instances)
	self:_clearTargetWatch()
	local seen = {}
	local function scheduleTargetRefresh()
		if self._targetRefreshQueued then
			return
		end
		self._targetRefreshQueued = true
		task.defer(function()
			self._targetRefreshQueued = false
			if self:_hasTarget() then
				self:_refreshProxy()
			end
		end)
	end
	local function watchProperty(instance, propertyName)
		local ok, signal = pcall(function()
			return instance:GetPropertyChangedSignal(propertyName)
		end)
		if not ok or not signal then
			return
		end
		local connection = safeConnect(signal, scheduleTargetRefresh)
		if connection then
			table.insert(self._targetConnections, connection)
		end
	end
	local function watchInstance(instance, clearOnRemove)
		if typeof(instance) == "Instance" and not seen[instance] then
			seen[instance] = true
			if instance.Parent == nil then
				if clearOnRemove ~= false then
					task.defer(function()
						self:clearTarget()
					end)
				end
			else
				local function clearIfRemoved(_, parent)
					if parent == nil and clearOnRemove ~= false then
						task.defer(function()
							self:clearTarget()
						end)
					end
				end
				local ancestryConnection = safeConnect(instance.AncestryChanged, clearIfRemoved)
				if ancestryConnection then
					table.insert(self._targetConnections, ancestryConnection)
				end
				local destroyingConnection = instance.Destroying and safeConnect(instance.Destroying, function()
					if clearOnRemove ~= false then
						task.defer(function()
							self:clearTarget()
						end)
					end
				end) or nil
				if destroyingConnection then
					table.insert(self._targetConnections, destroyingConnection)
				end
				if instance:IsA("BasePart") then
					watchProperty(instance, "CFrame")
				elseif instance:IsA("Model") then
					watchProperty(instance, "WorldPivot")
					watchProperty(instance, "PrimaryPart")
					local pivotPart = instance.PrimaryPart
						or instance:FindFirstChild("HumanoidRootPart", true)
						or instance:FindFirstChildWhichIsA("BasePart", true)
					watchInstance(pivotPart, false)
				elseif instance:IsA("Motor6D") then
					watchProperty(instance, "C0")
					watchProperty(instance, "C1")
					watchProperty(instance, "Transform")
				elseif instance:IsA("Bone") then
					watchProperty(instance, "Transform")
					watchProperty(instance, "WorldCFrame")
				end
			end
		end
	end
	for _, instance in ipairs(instances or {}) do
		watchInstance(instance, true)
	end
end

function GizmoController:_beginAdornedMoveDrag(face)
	if not self:_hasTarget() then
		return
	end
	self._moveDragAllowed = true
	self._lastMoveDistance = 0
	setViewportSelectionHighlightSuppressed(true)
	self:_showDragReadout(self:_dragReadoutPrefix() .. "\n0.00 studs")
	if self._callbacks.onDragStart then
		self._callbacks.onDragStart()
	end
end

function GizmoController:_updateMoveDrag(face, distance)
	if not self._moveDragAllowed or not self:_hasTarget() then
		return
	end

	local adjustedDistance = distance * MOVE_SENSITIVITY
	local snappedDistance = quantizeDistance(adjustedDistance, self._moveSnap)
	local delta = snappedDistance - self._lastMoveDistance
	if math.abs(delta) &lt; 0.0001 then
		return
	end

	self._lastMoveDistance = snappedDistance
	self:_showDragReadout(string.format("%s %s\n%.2f studs", self:_dragReadoutPrefix(), faceName(face), snappedDistance))
	local worldOffset = self._proxyPart.CFrame:VectorToWorldSpace(faceToOffset(face, delta))
	if self._motorDataList then
		for _, motorData in ipairs(self._motorDataList) do
			translateMotorJointWorld(motorData, worldOffset)
		end
	elseif self._motorData then
		translateMotorJointWorld(self._motorData, worldOffset)
	elseif self._trackData then
		translateTrackTargetWorld(self._trackData, worldOffset)
	end
	self:_refreshProxy()
	if self._callbacks.onDragStep then
		self._callbacks.onDragStep()
	end
end

function GizmoController:_endMoveDrag()
	if not self._moveDragAllowed then
		self._lastMoveDistance = 0
		return
	end
	self._moveDragAllowed = false
	self._lastMoveDistance = 0
	setViewportSelectionHighlightSuppressed(false)
	self:_hideDragReadout()
	if self._callbacks.onDragEnd then
		self._callbacks.onDragEnd()
	end
end

function GizmoController:_beginRotateDrag()
	if not self:_hasTarget() then
		return
	end
	self._lastArcAngle = 0
	setViewportSelectionHighlightSuppressed(true)
	self:_showDragReadout(self:_dragReadoutPrefix() .. "\n0.00 deg")
	if self._callbacks.onDragStart then
		self._callbacks.onDragStart()
	end
end

function GizmoController:_updateRotateDrag(axis, relativeAngle)
	if not self:_hasTarget() then
		return
	end

	local snappedAngle = quantizeDistance(relativeAngle, self._rotateSnap)
	local delta = snappedAngle - self._lastArcAngle
	if math.abs(delta) &lt; 0.0001 then
		return
	end

	self._lastArcAngle = snappedAngle
	self:_showDragReadout(string.format("%s %s\n%.2f deg", self:_dragReadoutPrefix(), axisName(axis), snappedAngle / DEG_TO_RAD))
	local axisVector = axisToVector(axis)
	if self._motorDataList then
		local worldAxis = self._rotateSpace == "World" and axisVector or self._proxyPart.CFrame:VectorToWorldSpace(axisVector)
		for _, motorData in ipairs(self._motorDataList) do
			rotateMotorJointWorld(motorData, worldAxis, delta)
		end
	elseif self._motorData then
		if self._rotateSpace == "World" then
			rotateMotorJointWorld(self._motorData, axisVector, delta)
		else
			rotateSingleMotorLocal(self._motorData, self._proxyPart.CFrame, axis, delta)
		end
	elseif self._trackData then
		local cframe = getTrackTargetCFrame(self._trackData)
		if cframe then
			local rotated = nil
			if self._rotateSpace == "World" then
				rotated = CFrame.new(cframe.Position) * CFrame.fromAxisAngle(axisVector, delta) * (cframe - cframe.Position)
			else
				rotated = cframe * axisToRotation(axis, delta)
			end
			applyTrackTargetCFrame(self._trackData, rotated)
		end
	end
	self:_refreshProxy()
	if self._callbacks.onDragStep then
		self._callbacks.onDragStep()
	end
end

function GizmoController:_endRotateDrag()
	self._lastArcAngle = 0
	setViewportSelectionHighlightSuppressed(false)
	self:_hideDragReadout()
	if self._callbacks.onDragEnd then
		self._callbacks.onDragEnd()
	end
end

function GizmoController:_bind()
	for _, moveHandles in ipairs(self._moveHandles) do
		moveHandles.MouseButton1Down:Connect(function(face)
			local worldDirection = normalIdToWorldDirection(self._proxyPart.CFrame, face)
			self._moveDragAllowed = worldDirection == nil
				or isMouseNearVisibleProjectedAxisEnd(
					self._plugin,
					self._proxyPart.Position,
					worldDirection,
					MOVE_HANDLE_MIN_SCREEN_DISTANCE,
					MOVE_HANDLE_MAX_PERP_DISTANCE
				)
			if not self._moveDragAllowed then
				return
			end
			self._lastMoveDistance = 0
			setViewportSelectionHighlightSuppressed(true)
			self:_showDragReadout(self:_dragReadoutPrefix() .. "\n0.00 studs")
			if self._callbacks.onDragStart then
				self._callbacks.onDragStart()
			end
		end)

		moveHandles.MouseDrag:Connect(function(face, distance)
			if not self._moveDragAllowed then
				return
			end
			if not self:_hasTarget() then
				return
			end

			local adjustedDistance = distance * MOVE_SENSITIVITY
			local snappedDistance = quantizeDistance(adjustedDistance, self._moveSnap)
			local delta = snappedDistance - self._lastMoveDistance
			if math.abs(delta) &lt; 0.0001 then
				return
			end

			self._lastMoveDistance = snappedDistance
			self:_showDragReadout(string.format("%s %s\n%.2f studs", self:_dragReadoutPrefix(), faceName(face), snappedDistance))
			local worldOffset = self._proxyPart.CFrame:VectorToWorldSpace(faceToOffset(face, delta))
			if self._motorDataList then
				for _, motorData in ipairs(self._motorDataList) do
					translateMotorJointWorld(motorData, worldOffset)
				end
			elseif self._motorData then
				translateMotorJointWorld(self._motorData, worldOffset)
			elseif self._trackData then
				translateTrackTargetWorld(self._trackData, worldOffset)
			end
			self:_refreshProxy()
			if self._callbacks.onDragStep then
				self._callbacks.onDragStep()
			end
		end)

		moveHandles.MouseButton1Up:Connect(function()
			if not self._moveDragAllowed then
				self._lastMoveDistance = 0
				return
			end
			self._moveDragAllowed = false
			self._lastMoveDistance = 0
			setViewportSelectionHighlightSuppressed(false)
			self:_hideDragReadout()
			if self._callbacks.onDragEnd then
				self._callbacks.onDragEnd()
			end
		end)
	end

	self._rotateHandles.MouseButton1Down:Connect(function()
		self._nativeRotateHandleHoverUntil = os.clock() + NATIVE_HANDLE_HOVER_GRACE_SECONDS
		if not self:IsPointerOverHandle() then
			return
		end
		self._lastArcAngle = 0
		setViewportSelectionHighlightSuppressed(true)
		self:_showDragReadout(self:_dragReadoutPrefix() .. "\n0.00 deg")
		if self._callbacks.onDragStart then
			self._callbacks.onDragStart()
		end
	end)

	self._rotateHandles.MouseDrag:Connect(function(axis, relativeAngle)
		if not self:_hasTarget() then
			return
		end

		local snappedAngle = quantizeDistance(relativeAngle, self._rotateSnap)
		local delta = snappedAngle - self._lastArcAngle
		if math.abs(delta) &lt; 0.0001 then
			return
		end

		self._lastArcAngle = snappedAngle
		self:_showDragReadout(string.format("%s %s\n%.2f deg", self:_dragReadoutPrefix(), axisName(axis), snappedAngle / DEG_TO_RAD))
		local axisVector = axisToVector(axis)
		if self._motorDataList then
			local worldAxis = self._rotateSpace == "World" and axisVector or self._proxyPart.CFrame:VectorToWorldSpace(axisVector)
			for _, motorData in ipairs(self._motorDataList) do
				rotateMotorJointWorld(motorData, worldAxis, delta)
			end
		elseif self._motorData then
			if self._rotateSpace == "World" then
				rotateMotorJointWorld(self._motorData, axisVector, delta)
			else
				rotateSingleMotorLocal(self._motorData, self._proxyPart.CFrame, axis, delta)
			end
		elseif self._trackData then
			local cframe = getTrackTargetCFrame(self._trackData)
			if cframe then
				local rotated = nil
				if self._rotateSpace == "World" then
					rotated = CFrame.new(cframe.Position) * CFrame.fromAxisAngle(axisVector, delta) * (cframe - cframe.Position)
				else
					rotated = cframe * axisToRotation(axis, delta)
				end
				applyTrackTargetCFrame(self._trackData, rotated)
			end
		end
		self:_refreshProxy()
		if self._callbacks.onDragStep then
			self._callbacks.onDragStep()
		end
	end)

	self._rotateHandles.MouseButton1Up:Connect(function()
		self._lastArcAngle = 0
		setViewportSelectionHighlightSuppressed(false)
		self:_hideDragReadout()
		if self._callbacks.onDragEnd then
			self._callbacks.onDragEnd()
		end
	end)
end

function GizmoController:bindCallbacks(callbacks)
	self._callbacks = callbacks or {}
end

function GizmoController:_hasTarget()
	if self._motorDataList then
		for _, motorData in ipairs(self._motorDataList) do
			if motorData.instance and motorData.instance.Parent then
				return true
			end
		end
	end
	if self._motorData and self._motorData.instance and self._motorData.instance.Parent then
		return true
	end

	return getTrackTargetCFrame(self._trackData) ~= nil
end

function GizmoController:hasViewportTarget()
	return self:_hasTarget() and not self._suppressed and not self._hideHandleVisuals
end

function GizmoController:hasTrackViewportTarget()
	return self._trackData ~= nil
		and getTrackTargetCFrame(self._trackData) ~= nil
		and not self._suppressed
		and not self._hideHandleVisuals
end

function GizmoController:_refreshVisibility()
	local hasTarget = self:_hasTarget() and not self._suppressed
	local shouldShowHandles = hasTarget and not self._hideHandleVisuals
	local shouldShowNativeHandles = shouldShowHandles and not self._useAdornedGizmos
	if hasTarget and self._proxyPart and self._proxyPart.Parent == nil then
		self:_ensureProxyParent()
	end
	for _, moveHandles in ipairs(self._moveHandles) do
		moveHandles.Visible = shouldShowNativeHandles and self._mode == "Move"
	end
	self._rotateHandles.Visible = shouldShowNativeHandles and self._mode == "Rotate"
	if self._adornedLayer then
		self._adornedLayer:Refresh({
			visible = shouldShowHandles,
			mode = self._mode,
			space = self._rotateSpace,
			sizeScale = self._gizmoSizePercent / 100,
		})
	end
	if not shouldShowHandles then
		self:_hideDragReadout()
	end
end

function GizmoController:_refreshProxy()
	local perfToken = PerformanceDebugService.begin("Gizmo Proxy Refresh")
	if not self:_hasTarget() then
		self:_refreshVisibility()
		PerformanceDebugService.finish(perfToken, "no target")
		return
	end

	self:_ensureProxyParent()

	if self._motorDataList then
		local position = Vector3.zero
		local count = 0
		local firstVisualCFrame = nil
		for _, motorData in ipairs(self._motorDataList) do
			local visualCFrame = getMotorVisualCFrame(motorData)
			if visualCFrame then
				position += visualCFrame.Position
				firstVisualCFrame = firstVisualCFrame or visualCFrame
				count += 1
			end
		end
		if count &gt; 0 then
			self._proxyPart.CFrame = CFrame.new(position / count) * (firstVisualCFrame - firstVisualCFrame.Position)
		end
	elseif self._motorData then
		local visualCFrame = getMotorVisualCFrame(self._motorData)
		if visualCFrame then
			self._proxyPart.CFrame = visualCFrame
		end
	else
		local cframe = getTrackTargetCFrame(self._trackData)
		if cframe then
			self._proxyPart.CFrame = cframe
		end
	end
	if self._rotateSpace == "World" then
		self._proxyPart.CFrame = CFrame.new(self._proxyPart.Position)
	end
	self:_refreshVisibility()
	local targetCount = self._motorDataList and #self._motorDataList or ((self._motorData or self._trackData) and 1 or 0)
	PerformanceDebugService.finish(perfToken, string.format("%d target(s)", targetCount))
end

function GizmoController:setMotor(motorData)
	self._motorData = motorData
	self._motorDataList = nil
	self._trackData = nil
	local targets = {}
	appendMotorTargetInstances(targets, motorData)
	self:_watchTargetInstances(targets)
	self:_refreshProxy()
end

function GizmoController:setMotors(motorDataList)
	local validMotors = {}
	local targets = {}
	for _, motorData in ipairs(motorDataList or {}) do
		if motorData and motorData.instance and motorData.instance.Parent then
			table.insert(validMotors, motorData)
			appendMotorTargetInstances(targets, motorData)
		end
	end

	if #validMotors == 0 then
		self:clearTarget()
		return
	end

	if #validMotors == 1 then
		self:setMotor(validMotors[1])
		return
	end

	self._motorData = nil
	self._motorDataList = validMotors
	self._trackData = nil
	self:_watchTargetInstances(targets)
	self:_refreshProxy()
end

function GizmoController:setTrack(trackData)
	self._motorData = nil
	self._motorDataList = nil
	self._trackData = trackData
	local targets = {}
	appendTrackTargetInstances(targets, trackData)
	self:_watchTargetInstances(targets)
	self:_refreshProxy()
end

function GizmoController:clearTarget()
	setViewportSelectionHighlightSuppressed(false)
	self:_clearTargetWatch()
	self._motorData = nil
	self._motorDataList = nil
	self._trackData = nil
	self:_hideDragReadout()
	self:_refreshVisibility()
	if self._proxyPart then
		self._proxyPart.Parent = nil
	end
end

function GizmoController:getProxyPart()
	return self._proxyPart
end

function GizmoController:releaseWorkspaceProxy()
	self:clearTarget()
	if self._proxyPart then
		sanitizeProxyPart(self._proxyPart)
		self._proxyPart.Parent = nil
	end
	removeViewportProxyParts(self._proxyPart)
end

function GizmoController:setSuppressed(suppressed)
	self._suppressed = suppressed == true
	if self._suppressed then
		self:_refreshVisibility()
	else
		self:_refreshProxy()
	end
end

function GizmoController:setHandleVisualsHidden(hidden)
	self._hideHandleVisuals = hidden == true
	self:_refreshVisibility()
end

function GizmoController:setMode(mode)
	if mode ~= "Move" and mode ~= "Rotate" then
		return
	end

	self._mode = mode
	self:_refreshProxy()
end

function GizmoController:setRotateSpace(space)
	self._rotateSpace = space == "World" and "World" or "Local"
	self._rotateHandles.Color3 = LOCAL_ROTATE_COLOR
	self:_refreshProxy()
end

function GizmoController:getRotateSpace()
	return self._rotateSpace
end

function GizmoController:setMoveSnap(studs)
	studs = tonumber(studs) or 0
	self._moveSnap = math.max(0, studs)
end

function GizmoController:getMoveSnap()
	return self._moveSnap
end

function GizmoController:setRotateSnap(degrees)
	degrees = tonumber(degrees) or 0
	self._rotateSnap = math.max(0, degrees) * DEG_TO_RAD
end

function GizmoController:getRotateSnapDegrees()
	return self._rotateSnap / DEG_TO_RAD
end

function GizmoController:setSizePercent(percent)
	local value = math.clamp(tonumber(percent) or DEFAULT_GIZMO_SIZE_PERCENT, MIN_GIZMO_SIZE_PERCENT, MAX_GIZMO_SIZE_PERCENT)
	self._gizmoSizePercent = value
	self:_refreshVisibility()
end

function GizmoController:getSizePercent()
	return self._gizmoSizePercent
end

function GizmoController:getMode()
	return self._mode
end

function GizmoController:IsPointerOverHandle(screenPoint)
	if not self:_hasTarget() or self._suppressed or self._hideHandleVisuals then
		return false
	end

	if self._adornedLayer and self._adornedLayer:IsPointerOverHandle(screenPoint) then
		return true
	end
	if self._adornedLayer then
		return false
	end

	-- Fall back to projected hit tests for the first mouse-down before adorned hover state updates.
	if self._mode == "Rotate" then
		if os.clock() &lt;= (self._nativeRotateHandleHoverUntil or 0) then
			return true
		end
		return isMouseNearProjectedRotateHandle(self._plugin, self._proxyPart.Position, false, screenPoint)
	end

	if self._mode == "Move" then
		for _, axisConfig in ipairs(MOVE_AXIS_HANDLES) do
			local faceA, faceB = getMoveAxisFaces(axisConfig)
			for _, face in ipairs({ faceA, faceB }) do
				local worldDirection = face and normalIdToWorldDirection(self._proxyPart.CFrame, face) or nil
				if worldDirection
					and isMouseNearProjectedAxisHandle(
						self._plugin,
						self._proxyPart.Position,
						worldDirection,
						0,
						MOVE_PICK_GUARD_MAX_PERP_DISTANCE,
						screenPoint
					) then
					return true
				end
			end
		end
	end

	if screenPoint ~= nil then
		return false
	end
	return isPointerNearProjectedGizmoEnvelope(self._plugin, self._proxyPart.Position, screenPoint)
end

function GizmoController:refresh()
	self:_refreshProxy()
end

return GizmoController
</ProtectedString>
