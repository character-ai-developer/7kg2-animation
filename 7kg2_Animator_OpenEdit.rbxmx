local ScreenEffectKeyframeEditorController = require(script.Parent:WaitForChild("ScreenEffectKeyframeEditorController"))
local SoundKeyframeEditorController = require(script.Parent:WaitForChild("SoundKeyframeEditorController"))
local CameraGuideService = require(script.Parent:WaitForChild("CameraGuideService"))
local PresetPreviewSupport = require(script.Parent:WaitForChild("PresetPreviewSupport"))
local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))
local TimelineInputController = require(script.Parent:WaitForChild("TimelineInputController"))
local TimelineMiddlePanInputSink = require(script.Parent:WaitForChild("TimelineMiddlePanInputSink"))
local RigTrackHierarchyService = require(script.Parent:WaitForChild("RigTrackHierarchyService"))
local BoneSkeletonOverlayService = require(script.Parent:WaitForChild("BoneSkeletonOverlayService"))
