            <Properties>
              <string name="Name">PhysicsObjectReleaseRuntime</string>
              <ProtectedString name="Source">local PhysicsObjectReleaseRuntime = {}

local function restoreAnchors(runtimeTargets, anchoredByPart)
	for part, anchored in pairs(anchoredByPart) do
		if part and part.Parent then
			part.Anchored = anchored
		end
	end
end

local function findRuntimeTarget(rootPart, editTarget, objectPath)
	if editTarget and editTarget:IsA("BasePart") then
		return rootPart
	end
	local current = rootPart
	while current and current ~= workspace do
		if current:IsA("Model") and current:GetFullName() == objectPath then
			return current
		end
		current = current.Parent
	end
	return nil
end

function PhysicsObjectReleaseRuntime.Apply(
	runtimeTargets,
	editDescriptors,
	releaseCaptureTarget,
	releaseData,
	collisionsEnabled
)
	if type(releaseData) ~= "table"
		or typeof(releaseData.linearVelocity) ~= "Vector3"
		or typeof(releaseData.angularVelocity) ~= "Vector3"
		or type(releaseData.partCFrames) ~= "table"
		or not (releaseCaptureTarget and releaseCaptureTarget.instance and releaseCaptureTarget.id) then
		return false, "Reload the release state from 7kg2 before starting the simulation."
	end

	local editById = {}
	for _, descriptor in ipairs(editDescriptors or {}) do
		if descriptor.id then
			editById[descriptor.id] = descriptor
		end
	end

	local releaseByInstance = {}
	local releaseByPath = {}
	for _, item in ipairs(releaseData.partCFrames) do
		if item.instance then
			releaseByInstance[item.instance] = item.cframe
		end
		if type(item.path) == "string" then
			releaseByPath[item.path] = item.cframe
		end
	end

	local runtimeReference = nil
	for _, descriptor in ipairs(runtimeTargets or {}) do
		if descriptor.id == releaseCaptureTarget.id then
			runtimeReference = descriptor
			break
		end
	end
	local runtimeTarget = runtimeReference
		and runtimeReference.part
		and findRuntimeTarget(runtimeReference.part, releaseCaptureTarget.instance, releaseData.objectPath)
		or nil
	if not (runtimeReference and runtimeReference.part and runtimeReference.part.Parent and runtimeTarget) then
		return false, "The release object's capture root was not found in Run mode."
	end

	local anchoredByPart = {}
	local prepared = {}
	for _, runtimeDescriptor in ipairs(runtimeTargets or {}) do
		local part = runtimeDescriptor.part
		local editDescriptor = editById[runtimeDescriptor.id]
		local cframe = editDescriptor
			and (releaseByInstance[editDescriptor.instance] or releaseByPath[editDescriptor.path])
			or nil
		if not (part and part.Parent and typeof(cframe) == "CFrame") then
			restoreAnchors(runtimeTargets, anchoredByPart)
			return false, "One or more release-object parts could not be matched in Run mode. Return to Edit mode and load the release again."
		end
		anchoredByPart[part] = part.Anchored
		part.Anchored = true
		prepared[#prepared + 1] = {
			part = part,
			cframe = cframe,
			canCollide = part.CanCollide,
		}
	end

	for _, item in ipairs(prepared) do
		item.part.CFrame = item.cframe
		item.part.AssemblyLinearVelocity = Vector3.zero
		item.part.AssemblyAngularVelocity = Vector3.zero
	end
	for _, item in ipairs(prepared) do
		item.part.Anchored = false
	end

	local seenRoots = {}
	local roots = {}
	for _, item in ipairs(prepared) do
		local root = item.part.AssemblyRootPart or item.part
		if not seenRoots[root] then
			seenRoots[root] = true
			roots[#roots + 1] = root
		end
	end
	if releaseCaptureTarget
		and releaseCaptureTarget.instance
		and releaseCaptureTarget.instance:IsA("Model")
		and #roots ~= 1 then
		restoreAnchors(runtimeTargets, anchoredByPart)
		return false, "Release to Physics needs a rigid Model. Weld its parts into one assembly, then load the release again."
	end
	if collisionsEnabled == false then
		for _, item in ipairs(prepared) do
			item.part.CanCollide = false
		end
	end
	for _, root in ipairs(roots) do
		root.AssemblyLinearVelocity = releaseData.linearVelocity
		root.AssemblyAngularVelocity = releaseData.angularVelocity
	end

	local captureRuntimeDescriptor = nil
	if runtimeReference and runtimeReference.part and runtimeReference.part.Parent then
		local root = runtimeReference.part.AssemblyRootPart or runtimeReference.part
		local capturePart = releaseCaptureTarget.instance:IsA("BasePart") and runtimeReference.part or root
		local target = runtimeTarget
		if target:IsA("Model") and target.PrimaryPart == nil and typeof(releaseData.targetCFrame) == "CFrame" then
			pcall(function()
				target.WorldPivot = releaseData.targetCFrame
			end)
		end
		captureRuntimeDescriptor = {
			id = releaseCaptureTarget.id,
			name = releaseCaptureTarget.name,
			part = capturePart,
			target = target,
			rootName = target:IsA("Model") and capturePart.Name or nil,
			rootToTargetPivot = target:IsA("Model") and capturePart.CFrame:ToObjectSpace(target:GetPivot()) or nil,
		}
	end
	if not captureRuntimeDescriptor then
		for _, item in ipairs(prepared) do
			if item.part and item.part.Parent then
				item.part.CanCollide = item.canCollide
			end
		end
		return false, "The release object's capture root was not found in Run mode."
	end

	return true, string.format(
		"Released %d part%s with %.2f studs/s inherited speed.",
		#prepared,
		#prepared == 1 and "" or "s",
		releaseData.linearVelocity.Magnitude
	), captureRuntimeDescriptor
end

return PhysicsObjectReleaseRuntime
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX29">
            <Properties>
              <string name="Name">PhysicsPopupInteraction</string>
              <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local PhysicsPopupInteraction = {}
PhysicsPopupInteraction.__index = PhysicsPopupInteraction

local function connect(self, signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

local function readSetting(plugin, key)
	if not plugin then
		return nil
	end
	local success, value = pcall(function()
		return plugin:GetSetting(key)
	end)
	return success and tonumber(value) or nil
end

local function saveSetting(plugin, key, value)
	if not plugin then
		return
	end
	pcall(function()
		plugin:SetSetting(key, value)
	end)
end

function PhysicsPopupInteraction.new(options)
	options = options or {}
	local self = setmetatable({
		connections = {},
		dragging = false,
		enabled = false,
		geometryLoaded = false,
		maxSize = options.maxSize or Vector2.new(760, 760),
		minSize = options.minSize or Vector2.new(370, 440),
		plugin = options.plugin,
		prefix = options.settingPrefix or "MegMoMicroPhysicsPopup",
		resizing = false,
		target = options.target,
	}, PhysicsPopupInteraction)

	local target = self.target
	local dragHandle = options.dragHandle
	if not (target and dragHandle) then
		return self
	end

	self.resizeGrip = Instance.new("ImageButton")
	self.resizeGrip.Name = "ResizeGrip"
	self.resizeGrip.Active = true
	self.resizeGrip.AnchorPoint = Vector2.new(1, 1)
	self.resizeGrip.AutoButtonColor = false
	self.resizeGrip.BackgroundColor3 = Color3.fromRGB(37, 47, 70)
	self.resizeGrip.BackgroundTransparency = 1
	self.resizeGrip.BorderSizePixel = 0
	self.resizeGrip.Image = "rbxassetid://104703373565023"
	self.resizeGrip.ImageColor3 = Color3.fromRGB(240, 244, 255)
	self.resizeGrip.ImageTransparency = 1
	self.resizeGrip.Position = UDim2.new(1, -5, 1, -5)
	self.resizeGrip.ScaleType = Enum.ScaleType.Fit
	self.resizeGrip.Size = UDim2.fromOffset(18, 18)
	self.resizeGrip.Visible = false
	self.resizeGrip.ZIndex = 1000
	self.resizeGrip.Parent = target
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = self.resizeGrip

	connect(self, dragHandle.InputBegan, function(input)
		if not self.enabled or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		self.dragging = true
		self.dragStart = input.Position
		self.startPosition = target.Position
	end)
	connect(self, dragHandle.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:StopDrag()
		end
	end)
	connect(self, self.resizeGrip.InputBegan, function(input)
		if not self.enabled or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		self.resizing = true
		self.resizeStart = input.Position
		self.startSize = target.AbsoluteSize
		self:SetGripHighlighted(true)
	end)
	connect(self, self.resizeGrip.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:StopResize()
		end
	end)
	connect(self, self.resizeGrip.MouseEnter, function()
		self:SetGripHighlighted(true)
	end)
	connect(self, self.resizeGrip.MouseLeave, function()
		if not self.resizing then
			self:SetGripHighlighted(false)
		end
	end)
	connect(self, UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		if self.dragging and self.dragStart and self.startPosition then
			local delta = input.Position - self.dragStart
			target.Position = UDim2.new(
				self.startPosition.X.Scale,
				self.startPosition.X.Offset + delta.X,
				self.startPosition.Y.Scale,
				self.startPosition.Y.Offset + delta.Y
			)
		elseif self.resizing and self.resizeStart and self.startSize then
			local delta = input.Position - self.resizeStart
			target.Size = UDim2.fromOffset(
				math.clamp(self.startSize.X + delta.X, self.minSize.X, self.maxSize.X),
				math.clamp(self.startSize.Y + delta.Y, self.minSize.Y, self.maxSize.Y)
			)
		end
	end)
	connect(self, UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:StopDrag()
			self:StopResize()
		end
	end)

	return self
end

function PhysicsPopupInteraction:SetGripHighlighted(highlighted)
	if not self.resizeGrip then
		return
	end
	self.resizeGrip.BackgroundTransparency = highlighted and 0.42 or 1
	self.resizeGrip.ImageTransparency = highlighted and 0.08 or 1
end

function PhysicsPopupInteraction:SaveGeometry()
	if not (self.enabled and self.target) then
		return
	end
	saveSetting(self.plugin, self.prefix .. "X", self.target.Position.X.Offset)
	saveSetting(self.plugin, self.prefix .. "Y", self.target.Position.Y.Offset)
	saveSetting(self.plugin, self.prefix .. "W", self.target.AbsoluteSize.X)
	saveSetting(self.plugin, self.prefix .. "H", self.target.AbsoluteSize.Y)
end

function PhysicsPopupInteraction:LoadGeometry()
	if self.geometryLoaded or not self.target then
		return
	end
	self.geometryLoaded = true
	local x = readSetting(self.plugin, self.prefix .. "X")
	local y = readSetting(self.plugin, self.prefix .. "Y")
	local width = readSetting(self.plugin, self.prefix .. "W")
	local height = readSetting(self.plugin, self.prefix .. "H")
	if x and y then
		self.target.Position = UDim2.fromOffset(x, y)
	end
	if width and height then
		self.target.Size = UDim2.fromOffset(
			math.clamp(width, self.minSize.X, self.maxSize.X),
			math.clamp(height, self.minSize.Y, self.maxSize.Y)
		)
	else
		self.target.Size = UDim2.fromOffset(430, 590)
	end
end

function PhysicsPopupInteraction:StopDrag()
	if not self.dragging then
		return
	end
	self.dragging = false
	self:SaveGeometry()
end

function PhysicsPopupInteraction:StopResize()
	if not self.resizing then
		return
	end
	self.resizing = false
	self:SetGripHighlighted(false)
	self:SaveGeometry()
end

function PhysicsPopupInteraction:SetEnabled(enabled, settingPrefix)
	if type(settingPrefix) == "string" and settingPrefix ~= "" and self.prefix ~= settingPrefix then
		self.prefix = settingPrefix
		self.geometryLoaded = false
	end
	self.enabled = enabled == true
	if self.resizeGrip then
		self.resizeGrip.Visible = self.enabled
	end
	if self.enabled then
		self:LoadGeometry()
	else
		self.dragging = false
		self.resizing = false
		self:SetGripHighlighted(false)
	end
end

function PhysicsPopupInteraction:Destroy()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	if self.resizeGrip then
		self.resizeGrip:Destroy()
		self.resizeGrip = nil
	end
end

return PhysicsPopupInteraction
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX30">
            <Properties>
              <string name="Name">PhysicsProjectilePathUX</string>
              <ProtectedString name="Source">local PhysicsProjectilePathUX = {}
PhysicsProjectilePathUX.__index = PhysicsProjectilePathUX

local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GUIDE_FOLDER_NAME = "MegMoPhysicsProjectilePathGuides"
local HANDLE_FOLDER_NAME = "MegMoPhysicsProjectilePathHandles"
local START_COLOR = Color3.fromRGB(72, 214, 255)
local END_COLOR = Color3.fromRGB(255, 116, 62)
local EXPLOSION_COLOR = Color3.fromRGB(255, 159, 67)
local FORWARD_COLOR = Color3.fromRGB(72, 214, 255)
local EXPLOSION_HANDLE_SCALE_DISTANCE = 24
local EXPLOSION_HANDLE_MIN_SCALE = 0.85
local EXPLOSION_HANDLE_MAX_SCALE = 1.75
local EXPLOSION_HANDLE_CENTER_GAP = 0.75
local EXPLOSION_HANDLE_STEM_LENGTH = 1.15
local EXPLOSION_HANDLE_STEM_RADIUS = 0.085
local EXPLOSION_HANDLE_ARROW_HEIGHT = 0.64
local EXPLOSION_HANDLE_ARROW_RADIUS = 0.32
local EXPLOSION_HANDLE_HIT_RADIUS = 0.3
local EXPLOSION_HANDLE_HIT_ARROW_HEIGHT = 0.94
local EXPLOSION_HANDLE_HIT_ARROW_RADIUS = 0.58
local EXPLOSION_HANDLE_HIT_SPHERE_RADIUS = 0.7
local EXPLOSION_HANDLE_NORMAL_TRANSPARENCY = 0.38
local EXPLOSION_HANDLE_HOVER_TRANSPARENCY = 0.18
local EXPLOSION_HANDLE_HIT_TRANSPARENCY = 0.99
local EXPLOSION_HANDLE_HOVER_SCALE = 1.16
local FORWARD_STEM_LENGTH = 3.1
local FORWARD_STEM_RADIUS = 0.12
local FORWARD_ARROW_HEIGHT = 0.9
local FORWARD_ARROW_RADIUS = 0.44

local FACE_VECTORS = {
	[Enum.NormalId.Right] = Vector3.xAxis,
	[Enum.NormalId.Left] = -Vector3.xAxis,
	[Enum.NormalId.Top] = Vector3.yAxis,
	[Enum.NormalId.Bottom] = -Vector3.yAxis,
	[Enum.NormalId.Back] = Vector3.zAxis,
	[Enum.NormalId.Front] = -Vector3.zAxis,
}

local function safeDestroy(instance)
	if instance then
		instance:Destroy()
	end
end

local function safeConnect(signal, callback)
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	return ok and connection or nil
end

local function localCFrameForDirection(direction, distance)
	local resolvedDirection = direction.Magnitude &gt; 0 and direction.Unit or Vector3.zAxis
	local up = math.abs(resolvedDirection:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	local right = up:Cross(resolvedDirection).Unit
	local correctedUp = resolvedDirection:Cross(right).Unit
	return CFrame.fromMatrix(resolvedDirection * distance, right, correctedUp, resolvedDirection)
end

local function localCFrameAtPositionFacing(positionDirection, distance, facingDirection)
	local resolvedPosition = positionDirection.Magnitude &gt; 0 and positionDirection.Unit or Vector3.zAxis
	local resolvedFacing = facingDirection.Magnitude &gt; 0 and facingDirection.Unit or resolvedPosition
	local up = math.abs(resolvedFacing:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	local right = up:Cross(resolvedFacing).Unit
	local correctedUp = resolvedFacing:Cross(right).Unit
	return CFrame.fromMatrix(resolvedPosition * distance, right, correctedUp, resolvedFacing)
end

local function cframeFacing(position, direction)
	local resolvedDirection = direction.Magnitude &gt; 0.001 and direction.Unit or Vector3.zAxis
	local up = math.abs(resolvedDirection:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	return CFrame.lookAt(position, position + resolvedDirection, up)
end

local function explosionHandleScale(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local distance = (camera.CFrame.Position - position).Magnitude
	return math.clamp(
		distance / EXPLOSION_HANDLE_SCALE_DISTANCE,
		EXPLOSION_HANDLE_MIN_SCALE,
		EXPLOSION_HANDLE_MAX_SCALE
	)
end

local function makeExplosionArrowHandles(parent, marker)
	local handles = {}
	for face, direction in pairs(FACE_VECTORS) do
		local stem = Instance.new("CylinderHandleAdornment")
		stem.Name = "ExplosionOriginStem_" .. face.Name
		stem.Adornee = marker
		stem.AlwaysOnTop = true
		stem.Archivable = false
		stem.Color3 = EXPLOSION_COLOR
		stem.Transparency = EXPLOSION_HANDLE_NORMAL_TRANSPARENCY + 0.14
		stem.ZIndex = 20
		stem.Parent = parent

		local head = Instance.new("ConeHandleAdornment")
		head.Name = "ExplosionOriginArrow_" .. face.Name
		head.Adornee = marker
		head.AlwaysOnTop = true
		head.Archivable = false
		head.Color3 = EXPLOSION_COLOR
		head.Transparency = EXPLOSION_HANDLE_NORMAL_TRANSPARENCY
		head.ZIndex = 22
		head.Parent = parent

		local hitStem = Instance.new("CylinderHandleAdornment")
		hitStem.Name = "ExplosionOriginHitStem_" .. face.Name
		hitStem.Adornee = marker
		hitStem.AlwaysOnTop = true
		hitStem.Archivable = false
		hitStem.Color3 = EXPLOSION_COLOR
		hitStem.Transparency = EXPLOSION_HANDLE_HIT_TRANSPARENCY
		hitStem.ZIndex = 24
		hitStem.Parent = parent

		local hitHead = Instance.new("ConeHandleAdornment")
		hitHead.Name = "ExplosionOriginHitArrow_" .. face.Name
		hitHead.Adornee = marker
		hitHead.AlwaysOnTop = true
		hitHead.Archivable = false
		hitHead.Color3 = EXPLOSION_COLOR
		hitHead.Transparency = EXPLOSION_HANDLE_HIT_TRANSPARENCY
		hitHead.ZIndex = 25
		hitHead.Parent = parent

		local hitSphere = Instance.new("SphereHandleAdornment")
		hitSphere.Name = "ExplosionOriginHitTip_" .. face.Name
		hitSphere.Adornee = marker
		hitSphere.AlwaysOnTop = true
		hitSphere.Archivable = false
		hitSphere.Color3 = EXPLOSION_COLOR
		hitSphere.Transparency = EXPLOSION_HANDLE_HIT_TRANSPARENCY
		hitSphere.ZIndex = 26
		hitSphere.Parent = parent

		table.insert(handles, {
			face = face,
			direction = direction,
			stem = stem,
			head = head,
			hitStem = hitStem,
			hitHead = hitHead,
			hitSphere = hitSphere,
			visuals = { stem, head },
			hitAdornments = { hitStem, hitHead, hitSphere },
		})
	end
	return handles
end

local function refreshExplosionArrowHandles(handles, marker)
	if not (marker and marker.Parent) then
		return
	end
	local scale = explosionHandleScale(marker.Position)
	local centerGap = EXPLOSION_HANDLE_CENTER_GAP * scale
	local stemLength = EXPLOSION_HANDLE_STEM_LENGTH * scale
	local tipDistance = centerGap + stemLength
	for _, handle in ipairs(handles or {}) do
		handle.stem.Height = stemLength
		handle.stem.Radius = EXPLOSION_HANDLE_STEM_RADIUS * scale
		handle.stem.CFrame = localCFrameForDirection(handle.direction, centerGap + stemLength * 0.5)

		handle.hitStem.Height = stemLength
		handle.hitStem.Radius = EXPLOSION_HANDLE_HIT_RADIUS * scale
		handle.hitStem.CFrame = handle.stem.CFrame

		handle.arrowHeight = EXPLOSION_HANDLE_ARROW_HEIGHT * scale
		handle.arrowRadius = EXPLOSION_HANDLE_ARROW_RADIUS * scale
		local hoverScale = handle.active and EXPLOSION_HANDLE_HOVER_SCALE or 1
		handle.head.Height = handle.arrowHeight * hoverScale
		handle.head.Radius = handle.arrowRadius * hoverScale
		handle.head.CFrame = localCFrameAtPositionFacing(handle.direction, tipDistance, -handle.direction)

		handle.hitHead.Height = EXPLOSION_HANDLE_HIT_ARROW_HEIGHT * scale
		handle.hitHead.Radius = EXPLOSION_HANDLE_HIT_ARROW_RADIUS * scale
		handle.hitHead.CFrame = handle.head.CFrame
		handle.hitSphere.Radius = EXPLOSION_HANDLE_HIT_SPHERE_RADIUS * scale
		handle.hitSphere.CFrame = CFrame.new(handle.direction * tipDistance)
	end
end

local function getViewportMouseCandidates()
	local candidates = {}
	local ok, mouse = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if ok and typeof(mouse) == "Vector2" then
		table.insert(candidates, mouse)
		local insetOk, inset = pcall(function()
			return GuiService:GetGuiInset()
		end)
		if insetOk and typeof(inset) == "Vector2" then
			table.insert(candidates, mouse - inset)
		end
	end
	return candidates
end

local function intersectPlane(rayOrigin, rayDirection, planeOrigin, planeNormal)
	local denominator = planeNormal:Dot(rayDirection)
	if math.abs(denominator) &lt; 0.0001 then
		return nil
	end
	local distance = planeNormal:Dot(planeOrigin - rayOrigin) / denominator
	if distance &lt; 0 then
		return nil
	end
	return rayOrigin + rayDirection * distance
end

local function intersectViewportPlane(planeOrigin, planeNormal)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	for _, mouse in ipairs(getViewportMouseCandidates()) do
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y, 0)
		local point = intersectPlane(ray.Origin, ray.Direction, planeOrigin, planeNormal)
		if point then
			return point
		end
	end
	return nil
end

local function chooseMovePlaneNormal(axisDirection, origin)
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.yAxis
	end
	local cameraLook = -camera.CFrame.LookVector
	local bestNormal = nil
	local bestScore = -math.huge
	for _, candidate in ipairs({ camera.CFrame.RightVector, camera.CFrame.UpVector, cameraLook }) do
		local rejected = candidate - axisDirection * candidate:Dot(axisDirection)
		if rejected.Magnitude &gt; 0.001 then
			local normal = rejected.Unit
			local score = math.abs(normal:Dot(cameraLook))
			if score &gt; bestScore then
				bestScore = score
				bestNormal = normal
			end
		end
	end
	if bestNormal then
		local toCamera = camera.CFrame.Position - origin
		return bestNormal:Dot(toCamera) &lt; 0 and -bestNormal or bestNormal
	end
	return cameraLook
end

local function configureHandles(handles)
	handles.Style = Enum.HandlesStyle.Movement
	handles.Faces = Faces.new(
		Enum.NormalId.Right,
		Enum.NormalId.Left,
		Enum.NormalId.Top,
		Enum.NormalId.Bottom,
		Enum.NormalId.Front,
		Enum.NormalId.Back
	)
	pcall(function()
		handles.AlwaysOnTop = true
	end)
	pcall(function()
		handles.ZIndex = 20
	end)
end

local function makeMarker(parent, name)
	local marker = Instance.new("Part")
	marker.Name = name
	marker.Anchored = true
	marker.Archivable = false
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.CastShadow = false
	marker.Locked = true
	marker.Size = Vector3.new(0.4, 0.4, 0.4)
	marker.Transparency = 1
	marker.Parent = parent
	return marker
end

local function makePointAdornment(parent, name, marker, color)
	local sphere = Instance.new("SphereHandleAdornment")
	sphere.Name = name
	sphere.Adornee = marker
	sphere.AlwaysOnTop = true
	sphere.Archivable = false
	sphere.Color3 = color
	sphere.Radius = 0.65
	sphere.Transparency = 0.08
	sphere.ZIndex = 12
	sphere.Parent = parent
	return sphere
end

local function makePointLabel(parent, name, marker, title, color)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = name
	billboard.Adornee = marker
	billboard.AlwaysOnTop = true
	billboard.Archivable = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = 10000
	billboard.Size = UDim2.fromOffset(112, 30)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.35, 0)
	billboard.Parent = parent

	local text = Instance.new("TextLabel")
	text.BackgroundColor3 = Color3.fromRGB(12, 16, 24)
	text.BackgroundTransparency = 0.08
	text.BorderSizePixel = 0
	text.Font = Enum.Font.GothamBold
	text.Size = UDim2.fromScale(1, 1)
	text.Text = title
	text.TextColor3 = Color3.fromRGB(248, 250, 255)
	text.TextSize = 13
	text.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = text

	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1.5
	stroke.Transparency = 0.05
	stroke.Parent = text
	return billboard
end

local function makeBeam(startMarker, endMarker)
	local startAttachment = Instance.new("Attachment")
	startAttachment.Name = "PathStart"
	startAttachment.Parent = startMarker

	local endAttachment = Instance.new("Attachment")
	endAttachment.Name = "PathImpact"
	endAttachment.Parent = endMarker

	local beam = Instance.new("Beam")
	beam.Name = "ProjectilePath"
	beam.Archivable = false
	beam.Attachment0 = startAttachment
	beam.Attachment1 = endAttachment
	beam.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, START_COLOR),
		ColorSequenceKeypoint.new(1, END_COLOR),
	})
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Segments = 20
	beam.Transparency = NumberSequence.new(0.08)
	beam.Width0 = 0.15
	beam.Width1 = 0.08
	beam.Parent = startMarker
	return beam
end

function PhysicsProjectilePathUX.new(pluginInstance, coreGui, onPointChanged, onPointPlaced, onDirectionChanged)
	local self = setmetatable({
		plugin = pluginInstance,
		coreGui = coreGui,
		onPointChanged = onPointChanged,
		onPointPlaced = onPointPlaced,
		onDirectionChanged = onDirectionChanged,
		placementKind = nil,
		projectileVisible = false,
		explosionVisible = false,
		explosionDirection = Vector3.zAxis,
		explosionDirectionVisible = false,
		connections = {},
	}, PhysicsProjectilePathUX)
	self.mouse = pluginInstance:GetMouse()
	table.insert(self.connections, self.mouse.Button1Down:Connect(function()
		self:_handleViewportClick()
	end))
	table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			self:_updateExplosionDrag()
		end
	end))
	table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_endExplosionDrag()
		end
	end))
	table.insert(self.connections, RunService.Heartbeat:Connect(function()
		if self.explosionVisible then
			refreshExplosionArrowHandles(self.explosionArrowHandles, self.explosionMarker)
			self:_refreshExplosionDirectionVisual()
		end
	end))
	return self
end

function PhysicsProjectilePathUX:_ensureFolders()
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	if not (self.guideFolder and self.guideFolder.Parent == camera) then
		safeDestroy(self.guideFolder)
		local existing = camera:FindFirstChild(GUIDE_FOLDER_NAME)
		safeDestroy(existing)
		self.guideFolder = Instance.new("Folder")
		self.guideFolder.Name = GUIDE_FOLDER_NAME
		self.guideFolder.Archivable = false
		self.guideFolder.Parent = camera
	end
	if not (self.handleFolder and self.handleFolder.Parent == self.coreGui) then
		safeDestroy(self.handleFolder)
		local existing = self.coreGui:FindFirstChild(HANDLE_FOLDER_NAME)
		safeDestroy(existing)
		self.handleFolder = Instance.new("Folder")
		self.handleFolder.Name = HANDLE_FOLDER_NAME
		self.handleFolder.Archivable = false
		self.handleFolder.Parent = self.coreGui
	end
	return true
end

function PhysicsProjectilePathUX:_emitChanged(kind, position)
	if self.onPointChanged then
		self.onPointChanged(kind, position)
	end
end

function PhysicsProjectilePathUX:_emitDirectionChanged(direction, finished)
	if self.onDirectionChanged then
		self.onDirectionChanged(direction, finished == true)
	end
end

function PhysicsProjectilePathUX:_bindHandles(handles, marker, kind)
	local dragStart = nil
	table.insert(self.connections, handles.MouseButton1Down:Connect(function()
		dragStart = marker.CFrame
	end))
	table.insert(self.connections, handles.MouseDrag:Connect(function(face, distance)
		if not (dragStart and marker.Parent) then
			return
		end
		local axis = FACE_VECTORS[face]
		if not axis then
			return
		end
		marker.CFrame = dragStart + dragStart:VectorToWorldSpace(axis) * distance
		self:_refreshDistanceLabel()
		self:_emitChanged(kind, marker.Position)
	end))
	table.insert(self.connections, handles.MouseButton1Up:Connect(function()
		dragStart = nil
	end))
end

function PhysicsProjectilePathUX:_setExplosionHandleActive(handle, active)
	if not handle then
		return
	end
	handle.active = active == true
	for _, visual in ipairs(handle.visuals or {}) do
		visual.Transparency = handle.active
			and (visual:IsA("ConeHandleAdornment")
				and EXPLOSION_HANDLE_HOVER_TRANSPARENCY
				or EXPLOSION_HANDLE_HOVER_TRANSPARENCY + 0.1)
			or (visual:IsA("ConeHandleAdornment")
				and EXPLOSION_HANDLE_NORMAL_TRANSPARENCY
				or EXPLOSION_HANDLE_NORMAL_TRANSPARENCY + 0.14)
	end
	refreshExplosionArrowHandles(self.explosionArrowHandles, self.explosionMarker)
end

function PhysicsProjectilePathUX:_beginExplosionDrag(handle)
	if not (self.explosionVisible and handle and self.explosionMarker and self.explosionMarker.Parent) then
		return
	end
	pcall(function()
		self.plugin:Activate(true)
	end)
	local origin = self.explosionMarker.Position
	local axisDirection = self.explosionMarker.CFrame:VectorToWorldSpace(handle.direction).Unit
	local planeNormal = chooseMovePlaneNormal(axisDirection, origin)
	local point = intersectViewportPlane(origin, planeNormal)
	if not point then
		return
	end
	self.explosionDrag = {
		handle = handle,
		startCFrame = self.explosionMarker.CFrame,
		origin = origin,
		axisDirection = axisDirection,
		planeNormal = planeNormal,
		initialScalar = axisDirection:Dot(point - origin),
	}
	self:_setExplosionHandleActive(handle, true)
end

function PhysicsProjectilePathUX:_updateExplosionDrag()
	local drag = self.explosionDrag
	if not (drag and self.explosionMarker and self.explosionMarker.Parent) then
		return
	end
	local point = intersectViewportPlane(drag.origin, drag.planeNormal)
	if not point then
		return
	end
	local distance = drag.axisDirection:Dot(point - drag.origin) - drag.initialScalar
	self.explosionMarker.CFrame = drag.startCFrame + drag.axisDirection * distance
	self.explosionPosition = self.explosionMarker.Position
	self:_emitChanged("Explosion", self.explosionPosition)
end

function PhysicsProjectilePathUX:_endExplosionDrag()
	local drag = self.explosionDrag
	if not drag then
		return
	end
	self.explosionDrag = nil
	self:_setExplosionHandleActive(drag.handle, false)
end

function PhysicsProjectilePathUX:_bindExplosionArrowHandles(handles)
	for _, handle in ipairs(handles or {}) do
		for _, adornment in ipairs(handle.visuals or {}) do
			local enter = safeConnect(adornment.MouseEnter, function()
				pcall(function()
					self.plugin:Activate(true)
				end)
				self:_setExplosionHandleActive(handle, true)
			end)
			local leave = safeConnect(adornment.MouseLeave, function()
				if not (self.explosionDrag and self.explosionDrag.handle == handle) then
					self:_setExplosionHandleActive(handle, false)
				end
			end)
			local down = safeConnect(adornment.MouseButton1Down, function()
				self:_beginExplosionDrag(handle)
			end)
			if enter then table.insert(self.connections, enter) end
			if leave then table.insert(self.connections, leave) end
			if down then table.insert(self.connections, down) end
		end
		for _, adornment in ipairs(handle.hitAdornments or {}) do
			local enter = safeConnect(adornment.MouseEnter, function()
				pcall(function()
					self.plugin:Activate(true)
				end)
				self:_setExplosionHandleActive(handle, true)
			end)
			local leave = safeConnect(adornment.MouseLeave, function()
				if not (self.explosionDrag and self.explosionDrag.handle == handle) then
					self:_setExplosionHandleActive(handle, false)
				end
			end)
			local down = safeConnect(adornment.MouseButton1Down, function()
				self:_beginExplosionDrag(handle)
			end)
			if enter then table.insert(self.connections, enter) end
			if leave then table.insert(self.connections, leave) end
			if down then table.insert(self.connections, down) end
		end
	end
end

function PhysicsProjectilePathUX:_refreshExplosionDirectionVisual()
	if not (self.explosionMarker and self.explosionMarker.Parent
		and self.explosionDirectionMarker and self.explosionDirectionMarker.Parent) then
		return
	end
	local direction = self.explosionDirection.Magnitude &gt; 0.001
		and self.explosionDirection.Unit
		or Vector3.zAxis
	local position = self.explosionMarker.Position
	local scale = explosionHandleScale(position)
	self.explosionDirectionMarker.CFrame = cframeFacing(position, direction)

	local gap = 0.9 * scale
	local stemLength = FORWARD_STEM_LENGTH * scale
	local tipDistance = gap + stemLength
	self.forwardStem.Height = stemLength
	self.forwardStem.Radius = FORWARD_STEM_RADIUS * scale
	self.forwardStem.CFrame = localCFrameForDirection(-Vector3.zAxis, gap + stemLength * 0.5)
	self.forwardHead.Height = FORWARD_ARROW_HEIGHT * scale
	self.forwardHead.Radius = FORWARD_ARROW_RADIUS * scale
	self.forwardHead.CFrame = localCFrameAtPositionFacing(-Vector3.zAxis, tipDistance, Vector3.zAxis)
	self.forwardTipMarker.CFrame = CFrame.new(position + direction * (tipDistance + FORWARD_ARROW_HEIGHT * scale * 0.5))
end

function PhysicsProjectilePathUX:_bindExplosionDirectionHandles(handles)
	local axisVectors = {
		[Enum.Axis.X] = Vector3.xAxis,
		[Enum.Axis.Y] = Vector3.yAxis,
	}
	table.insert(self.connections, handles.MouseButton1Down:Connect(function()
		if not (self.explosionVisible and self.explosionDirectionVisible
			and self.explosionDirectionMarker and self.explosionDirectionMarker.Parent) then
			return
		end
		pcall(function()
			self.plugin:Activate(true)
		end)
		self.explosionDirectionDragStart = self.explosionDirectionMarker.CFrame
	end))
	table.insert(self.connections, handles.MouseDrag:Connect(function(axis, relativeAngle)
		local startCFrame = self.explosionDirectionDragStart
		local axisVector = axisVectors[axis]
		if not (startCFrame and axisVector) then
			return
		end
		local rotated = startCFrame * CFrame.fromAxisAngle(axisVector, relativeAngle)
		local direction = rotated.LookVector
		if direction.Magnitude &lt;= 0.001 then
			return
		end
		self.explosionDirection = direction.Unit
		self:_refreshExplosionDirectionVisual()
		self:_emitDirectionChanged(self.explosionDirection, false)
	end))
	table.insert(self.connections, handles.MouseButton1Up:Connect(function()
		if not self.explosionDirectionDragStart then
			return
		end
		self.explosionDirectionDragStart = nil
		self:_emitDirectionChanged(self.explosionDirection, true)
	end))
end

function PhysicsProjectilePathUX:_ensureVisuals()
	if not self:_ensureFolders() then
		return false
	end
	if self.startMarker and self.startMarker.Parent
		and self.endMarker and self.endMarker.Parent
		and self.explosionMarker and self.explosionMarker.Parent then
		return true
	end

	self.startMarker = makeMarker(self.guideFolder, "ProjectileStartPoint")
	self.endMarker = makeMarker(self.guideFolder, "ProjectileImpactPoint")
	self.explosionMarker = makeMarker(self.guideFolder, "ExplosionOriginPoint")
	self.explosionDirectionMarker = makeMarker(self.guideFolder, "ExplosionForwardDirection")
	self.explosionDirectionMarker.Size = Vector3.new(2.4, 2.4, 2.4)
	self.forwardTipMarker = makeMarker(self.guideFolder, "ExplosionForwardTip")
	self.startAdornment = makePointAdornment(self.handleFolder, "ProjectileStartVisual", self.startMarker, START_COLOR)
	self.endAdornment = makePointAdornment(self.handleFolder, "ProjectileImpactVisual", self.endMarker, END_COLOR)
	self.explosionAdornment = makePointAdornment(
		self.handleFolder,
		"ExplosionOriginVisual",
		self.explosionMarker,
		EXPLOSION_COLOR
	)
	self.explosionAdornment.Transparency = 0.3
	self.startLabel = makePointLabel(self.handleFolder, "ProjectileStartLabel", self.startMarker, "START", START_COLOR)
	self.endLabel = makePointLabel(self.handleFolder, "ProjectileImpactLabel", self.endMarker, "IMPACT", END_COLOR)
	self.explosionLabel = makePointLabel(
		self.handleFolder,
		"ExplosionOriginLabel",
		self.explosionMarker,
		"BLAST ORIGIN",
		EXPLOSION_COLOR
	)
	self.forwardStem = Instance.new("CylinderHandleAdornment")
	self.forwardStem.Name = "ExplosionForwardStem"
	self.forwardStem.Adornee = self.explosionDirectionMarker
	self.forwardStem.AlwaysOnTop = true
	self.forwardStem.Archivable = false
	self.forwardStem.Color3 = FORWARD_COLOR
	self.forwardStem.Transparency = 0.16
	self.forwardStem.ZIndex = 27
	self.forwardStem.Parent = self.handleFolder

	self.forwardHead = Instance.new("ConeHandleAdornment")
	self.forwardHead.Name = "ExplosionForwardArrow"
	self.forwardHead.Adornee = self.explosionDirectionMarker
	self.forwardHead.AlwaysOnTop = true
	self.forwardHead.Archivable = false
	self.forwardHead.Color3 = FORWARD_COLOR
	self.forwardHead.Transparency = 0.08
	self.forwardHead.ZIndex = 28
	self.forwardHead.Parent = self.handleFolder

	self.forwardLabel = makePointLabel(
		self.handleFolder,
		"ExplosionForwardLabel",
		self.forwardTipMarker,
		"FORWARD",
		FORWARD_COLOR
	)
	self.forwardLabel.StudsOffsetWorldSpace = Vector3.new(0, 0.8, 0)

	self.forwardArcHandles = Instance.new("ArcHandles")
	self.forwardArcHandles.Name = "ExplosionForwardRotateHandles"
	self.forwardArcHandles.Adornee = self.explosionDirectionMarker
	self.forwardArcHandles.Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y)
	self.forwardArcHandles.Color3 = FORWARD_COLOR
	pcall(function()
		self.forwardArcHandles.AlwaysOnTop = true
		self.forwardArcHandles.ZIndex = 29
	end)
	self.forwardArcHandles.Parent = self.handleFolder
	self:_bindExplosionDirectionHandles(self.forwardArcHandles)
	self.beam = makeBeam(self.startMarker, self.endMarker)

	self.startHandles = Instance.new("Handles")
	self.startHandles.Name = "ProjectileStartHandles"
	self.startHandles.Adornee = self.startMarker
	self.startHandles.Color3 = START_COLOR
	configureHandles(self.startHandles)
	self.startHandles.Parent = self.handleFolder
	self:_bindHandles(self.startHandles, self.startMarker, "Start")

	self.endHandles = Instance.new("Handles")
	self.endHandles.Name = "ProjectileImpactHandles"
	self.endHandles.Adornee = self.endMarker
	self.endHandles.Color3 = END_COLOR
	configureHandles(self.endHandles)
	self.endHandles.Parent = self.handleFolder
	self:_bindHandles(self.endHandles, self.endMarker, "End")

	self.explosionArrowHandles = makeExplosionArrowHandles(self.handleFolder, self.explosionMarker)
	self:_bindExplosionArrowHandles(self.explosionArrowHandles)
	refreshExplosionArrowHandles(self.explosionArrowHandles, self.explosionMarker)
	self:_refreshExplosionDirectionVisual()
	return true
end

function PhysicsProjectilePathUX:_refreshDistanceLabel()
	if not (self.startMarker and self.endMarker and self.startLabel and self.startLabel.Parent) then
		return
	end
	local text = self.startLabel:FindFirstChildWhichIsA("TextLabel")
	if text then
		text.Text = string.format("START  %.1f studs", (self.endMarker.Position - self.startMarker.Position).Magnitude)
	end
end

function PhysicsProjectilePathUX:_setVisualVisibility()
	local hasStart = self.startPosition ~= nil
	local hasEnd = self.endPosition ~= nil
	local showProjectile = self.projectileVisible
	if self.startAdornment then
		self.startAdornment.Visible = showProjectile and hasStart
		self.startLabel.Enabled = showProjectile and hasStart
		self.startHandles.Visible = showProjectile and hasStart
	end
	if self.endAdornment then
		self.endAdornment.Visible = showProjectile and hasEnd
		self.endLabel.Enabled = showProjectile and hasEnd
		self.endHandles.Visible = showProjectile and hasEnd
	end
	local hasExplosion = self.explosionPosition ~= nil
	if self.explosionAdornment then
		self.explosionAdornment.Visible = self.explosionVisible and hasExplosion
		self.explosionLabel.Enabled = self.explosionVisible and hasExplosion
		for _, handle in ipairs(self.explosionArrowHandles or {}) do
			for _, adornment in ipairs(handle.visuals or {}) do
				adornment.Visible = self.explosionVisible and hasExplosion
			end
			for _, adornment in ipairs(handle.hitAdornments or {}) do
				adornment.Visible = self.explosionVisible and hasExplosion
			end
		end
		local showDirection = self.explosionVisible and hasExplosion and self.explosionDirectionVisible
		self.forwardStem.Visible = showDirection
		self.forwardHead.Visible = showDirection
		self.forwardLabel.Enabled = showDirection
		self.forwardArcHandles.Visible = showDirection
	end
	if self.beam then
		self.beam.Enabled = showProjectile and hasStart and hasEnd
	end
end

function PhysicsProjectilePathUX:SetExplosionPoint(position, visible, direction, directionVisible)
	self.explosionPosition = typeof(position) == "Vector3" and position or nil
	self.explosionVisible = visible == true
	if typeof(direction) == "Vector3" and direction.Magnitude &gt; 0.001 then
		self.explosionDirection = direction.Unit
	end
	self.explosionDirectionVisible = directionVisible == true
	if not self:_ensureVisuals() then
		return
	end
	if self.explosionPosition then
		self.explosionMarker.Position = self.explosionPosition
	end
	self:_refreshExplosionDirectionVisual()
	self:_setVisualVisibility()
end

function PhysicsProjectilePathUX:SetPoints(startPosition, endPosition, visible)
	self.startPosition = typeof(startPosition) == "Vector3" and startPosition or nil
	self.endPosition = typeof(endPosition) == "Vector3" and endPosition or nil
	self.projectileVisible = visible == true
	if not self:_ensureVisuals() then
		return
	end
	if self.startPosition then
		self.startMarker.Position = self.startPosition
	end
	if self.endPosition then
		self.endMarker.Position = self.endPosition
	end
	self:_refreshDistanceLabel()
	self:_setVisualVisibility()
end

function PhysicsProjectilePathUX:BeginPlacement(kind)
	if kind ~= "Start" and kind ~= "End" and kind ~= "Explosion" then
		return
	end
	self.placementKind = kind
	self.plugin:Activate(true)
end

function PhysicsProjectilePathUX:_handleViewportClick()
	local kind = self.placementKind
	if not kind then
		return
	end
	local hit = self.mouse.Hit
	if typeof(hit) ~= "CFrame" then
		return
	end
	self.placementKind = nil
	pcall(function()
		self.plugin:Deactivate()
	end)
	if self.onPointPlaced then
		self.onPointPlaced(kind, hit.Position, self.mouse.Target)
	end
end

function PhysicsProjectilePathUX:CancelPlacement()
	self.placementKind = nil
	pcall(function()
		self.plugin:Deactivate()
	end)
end

function PhysicsProjectilePathUX:Clear()
	self:CancelPlacement()
	self:_endExplosionDrag()
	self.startPosition = nil
	self.endPosition = nil
	self.explosionPosition = nil
	self.projectileVisible = false
	self.explosionVisible = false
	self.explosionDirectionVisible = false
	self.explosionDirectionDragStart = nil
	self:_setVisualVisibility()
end

function PhysicsProjectilePathUX:Destroy()
	self:CancelPlacement()
	self:_endExplosionDrag()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	safeDestroy(self.guideFolder)
	safeDestroy(self.handleFolder)
	self.guideFolder = nil
	self.handleFolder = nil
end

return PhysicsProjectilePathUX
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX31">
            <Properties>
              <string name="Name">PhysicsRecorder</string>
              <ProtectedString name="Source">local PhysicsRecorder = {}
PhysicsRecorder.__index = PhysicsRecorder

local PhysicsRigFilter = require(script.Parent:WaitForChild("PhysicsRigFilter"))

local function collectParts(rig)
	local parts = {}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") and not PhysicsRigFilter.IsAccessoryPart(descendant, rig) then
			parts[descendant.Name] = descendant
		end
	end
	return parts
end

local function collectJoints(rig)
	local joints = {}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if PhysicsRigFilter.IsSkeletalMotor(descendant, rig) then
			table.insert(joints, {
				name = descendant.Name,
				part0 = descendant.Part0.Name,
				part1 = descendant.Part1.Name,
				c0 = descendant.C0,
				c1 = descendant.C1,
			})
		end
	end
	return joints
end

function PhysicsRecorder.ApplyJointBasePose(take, definitions, baseValues)
	if not (take and type(take.joints) == "table" and type(definitions) == "table" and type(baseValues) == "table") then
		return 0
	end

	local appliedCount = 0
	for definitionIndex, definition in ipairs(definitions) do
		local baseValue = baseValues[definitionIndex]
		if type(definition) == "table" and typeof(baseValue) == "CFrame" then
			for _, joint in ipairs(take.joints) do
				if joint.name == definition.name
					and (not definition.part0 or joint.part0 == definition.part0)
					and (not definition.part1 or joint.part1 == definition.part1) then
					joint.c0 = baseValue
					appliedCount += 1
					break
				end
			end
		end
	end
	return appliedCount
end

local function findSamplePair(samples, time)
	if time &lt;= (samples[1].time or 0) then
		return samples[1], samples[1], 0
	end
	local last = samples[#samples]
	if time &gt;= (last.time or 0) then
		return last, last, 0
	end
	local low = 1
	local high = #samples
	while low + 1 &lt; high do
		local middle = math.floor((low + high) / 2)
		if (samples[middle].time or 0) &lt;= time then
			low = middle
		else
			high = middle
		end
	end
	local first = samples[low]
	local second = samples[high]
	local span = math.max(0.0001, (second.time or 0) - (first.time or 0))
	return first, second, math.clamp((time - (first.time or 0)) / span, 0, 1)
end

local function interpolateMap(first, second, alpha)
	local result = {}
	for key, firstValue in pairs(first or {}) do
		local secondValue = second and second[key] or nil
		result[key] = typeof(firstValue) == "CFrame" and typeof(secondValue) == "CFrame"
			and firstValue:Lerp(secondValue, alpha)
			or firstValue
	end
	for key, secondValue in pairs(second or {}) do
		if result[key] == nil then
			result[key] = secondValue
		end
	end
	return result
end

local function interpolateSample(samples, time)
	local first, second, alpha = findSamplePair(samples, time)
	return {
		parts = interpolateMap(first.parts, second.parts, alpha),
		objects = interpolateMap(first.objects, second.objects, alpha),
		objectRoots = interpolateMap(first.objectRoots, second.objectRoots, alpha),
	}
end

function PhysicsRecorder.new(options)
	options = options or {}
	return setmetatable({
		fps = math.clamp(tonumber(options.fps) or 30, 1, 120),
		maxDuration = math.clamp(tonumber(options.maxDuration) or 20, 1, 120),
		accumulator = 0,
		elapsed = 0,
		take = nil,
		parts = nil,
		objectParts = nil,
		running = false,
	}, PhysicsRecorder)
end

function PhysicsRecorder:_sample()
	local take = self.take
	if not take then
		return
	end
	local sample = {
		time = self.elapsed,
		parts = {},
		objects = {},
		objectRoots = {},
	}
	for name, part in pairs(self.parts or {}) do
		if part and part.Parent then
			sample.parts[name] = part.CFrame
		end
	end
	for _, descriptor in ipairs(self.objectParts or {}) do
		local part = descriptor.part
		if descriptor.id and part and part.Parent then
			local target = descriptor.target
			if target and target.Parent and target:IsA("Model") then
				sample.objectRoots[descriptor.id] = part.CFrame
				local rootToTargetPivot = descriptor.rootToTargetPivot
				sample.objects[descriptor.id] = typeof(rootToTargetPivot) == "CFrame"
					and part.CFrame * rootToTargetPivot
					or target:GetPivot()
			else
				sample.objects[descriptor.id] = part.CFrame
			end
		end
	end
	table.insert(take.samples, sample)
	take.duration = self.elapsed
end

function PhysicsRecorder:Start(rig, objectParts)
	local root = rig:FindFirstChild("HumanoidRootPart", true)
		or rig.PrimaryPart
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("LowerTorso", true)
	if not (root and root:IsA("BasePart")) then
		return false, "Could not find a root part on the runtime rig."
	end

	self.parts = collectParts(rig)
	self.objectParts = objectParts or {}
	self.elapsed = 0
	self.accumulator = 0
	self.running = true
	self.take = {
		rigName = rig.Name,
		rootName = root.Name,
		fps = self.fps,
		duration = 0,
		joints = collectJoints(rig),
		objectCount = #self.objectParts,
		objectRootNames = {},
		samples = {},
	}
	for _, descriptor in ipairs(self.objectParts) do
		if descriptor.id and descriptor.rootName then
			self.take.objectRootNames[descriptor.id] = descriptor.rootName
		end
	end
	self:_sample()
	return true, nil
end

function PhysicsRecorder:StartObjects(objectParts)
	if type(objectParts) ~= "table" or #objectParts == 0 then
		return false, "Select at least one object to record."
	end
	self.parts = {}
	self.objectParts = objectParts
	self.elapsed = 0
	self.accumulator = 0
	self.running = true
	self.take = {
		rigName = nil,
		rootName = nil,
		fps = self.fps,
		duration = 0,
		joints = {},
		objectCount = #self.objectParts,
		objectOnly = true,
		objectRootNames = {},
		samples = {},
	}
	for _, descriptor in ipairs(self.objectParts) do
		if descriptor.id and descriptor.rootName then
			self.take.objectRootNames[descriptor.id] = descriptor.rootName
		end
	end
	self:_sample()
	return true, nil
end

function PhysicsRecorder:Step(deltaTime)
	if not self.running then
		return false
	end
	local dt = math.max(0, tonumber(deltaTime) or 0)
	self.elapsed += dt
	self.accumulator += dt
	local interval = 1 / self.fps
	if self.accumulator &gt;= interval then
		self.accumulator %= interval
		self:_sample()
	end
	if self.elapsed &gt;= self.maxDuration then
		self:Stop()
		return false, "limit"
	end
	return true, nil
end

function PhysicsRecorder:Stop()
	if self.running then
		self:_sample()
	end
	self.running = false
	return self.take
end

function PhysicsRecorder:GetTake()
	return self.take
end

function PhysicsRecorder.ApplyObjectSlowMotion(take, descriptors, startTime, factor)
	if not (take and type(take.samples) == "table" and #take.samples &gt;= 2) then
		return false
	end
	local affectedIds = {}
	local affectedCount = 0
	for _, descriptor in ipairs(descriptors or {}) do
		local id = type(descriptor) == "table" and descriptor.id or descriptor
		if type(id) == "string" and id ~= "" and not affectedIds[id] then
			affectedIds[id] = true
			affectedCount += 1
		end
	end
	if affectedCount == 0 then
		return false
	end

	local samples = take.samples
	local originalDuration = math.max(
		tonumber(take.duration) or 0,
		tonumber(samples[#samples].time) or 0
	)
	local resolvedStart = math.clamp(tonumber(startTime) or 0, 0, originalDuration)
	local resolvedFactor = math.clamp(tonumber(factor) or 1, 0.5, 10)
	if math.abs(resolvedFactor - 1) &lt;= 0.001 or resolvedStart &gt;= originalDuration then
		return false
	end

	local fps = math.clamp(tonumber(take.fps) or 30, 1, 120)
	local outputDuration = resolvedStart + (originalDuration - resolvedStart) * resolvedFactor
	local outputSamples = {}
	local function appendSample(outputTime)
		local normalTime = math.min(outputTime, originalDuration)
		local slowedTime = outputTime &lt;= resolvedStart
			and outputTime
			or resolvedStart + (outputTime - resolvedStart) / resolvedFactor
		slowedTime = math.min(slowedTime, originalDuration)

		local output = interpolateSample(samples, normalTime)
		local slowed = interpolateSample(samples, slowedTime)
		for id in pairs(affectedIds) do
			if slowed.objects[id] then
				output.objects[id] = slowed.objects[id]
			end
			if slowed.objectRoots[id] then
				output.objectRoots[id] = slowed.objectRoots[id]
			end
		end
		output.time = outputTime
		table.insert(outputSamples, output)
	end

	local interval = 1 / fps
	local wholeSteps = math.floor(outputDuration / interval)
	for step = 0, wholeSteps do
		appendSample(step * interval)
	end
	if outputSamples[#outputSamples].time &lt; outputDuration - 0.0001 then
		appendSample(outputDuration)
	end

	take.samples = outputSamples
	take.duration = outputDuration
	take.slowMotion = {
		startTime = resolvedStart,
		factor = resolvedFactor,
		playbackSpeed = 1 / resolvedFactor,
		affectedCount = affectedCount,
	}
	return true
end

-- Explosion speed is a property of the entire captured result, not one object
-- descriptor. Resample the complete take so rigs, loose objects and VFX event
-- timing all use the same 10%-200% playback choice.
function PhysicsRecorder.ApplyPlaybackSpeed(take, speed)
	if not (take and type(take.samples) == "table" and #take.samples &gt;= 2) then
		return false
	end
	local resolvedSpeed = math.clamp(tonumber(speed) or 1, 0.1, 2)
	if math.abs(resolvedSpeed - 1) &lt;= 0.001 then
		return false
	end

	local samples = take.samples
	local originalDuration = math.max(
		tonumber(take.duration) or 0,
		tonumber(samples[#samples].time) or 0
	)
	if originalDuration &lt;= 0 then
		return false
	end
	local outputDuration = originalDuration / resolvedSpeed
	local fps = math.clamp(tonumber(take.fps) or 30, 1, 120)
	local outputSamples = {}
	local function appendSample(outputTime)
		local inputTime = math.min(outputTime * resolvedSpeed, originalDuration)
		local output = interpolateSample(samples, inputTime)
		output.time = outputTime
		table.insert(outputSamples, output)
	end

	local interval = 1 / fps
	local wholeSteps = math.floor(outputDuration / interval)
	for step = 0, wholeSteps do
		appendSample(step * interval)
	end
	if outputSamples[#outputSamples].time &lt; outputDuration - 0.0001 then
		appendSample(outputDuration)
	end
	for _, marker in ipairs(take.physicsEvents or {}) do
		marker.time = math.max(0, tonumber(marker.time) or 0) / resolvedSpeed
		marker.playbackSpeed = resolvedSpeed
		marker.slowMotion = 1 / resolvedSpeed
	end

	take.samples = outputSamples
	take.duration = outputDuration
	take.slowMotion = {
		startTime = 0,
		factor = 1 / resolvedSpeed,
		playbackSpeed = resolvedSpeed,
		allCapturedObjects = true,
	}
	return true
end

return PhysicsRecorder
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX32">
            <Properties>
              <string name="Name">PhysicsRigFilter</string>
              <ProtectedString name="Source">local PhysicsRigFilter = {}

local function isAttachmentContainer(instance)
	return instance
		and (instance:IsA("Accessory")
			or instance:IsA("Accoutrement")
			or instance:IsA("Tool"))
end

function PhysicsRigFilter.IsInsideAccessory(instance, rig)
	local current = instance
	while current and current ~= rig do
		if isAttachmentContainer(current) then
			return true
		end
		current = current.Parent
	end
	return false
end

function PhysicsRigFilter.IsAccessoryPart(part, rig)
	return part
		and part:IsA("BasePart")
		and PhysicsRigFilter.IsInsideAccessory(part, rig)
end

function PhysicsRigFilter.IsSkeletalMotor(motor, rig)
	if not (motor
		and motor:IsA("Motor6D")
		and motor.Part0
		and motor.Part1
		and motor.Part0:IsDescendantOf(rig)
		and motor.Part1:IsDescendantOf(rig)) then
		return false
	end
	if motor.Name == "AccessoryWeld"
		or PhysicsRigFilter.IsInsideAccessory(motor, rig)
		or PhysicsRigFilter.IsInsideAccessory(motor.Part0, rig)
		or PhysicsRigFilter.IsInsideAccessory(motor.Part1, rig) then
		return false
	end
	return true
end

function PhysicsRigFilter.IsSupportedRagdollRig(rig)
	if not (rig and rig:IsA("Model") and rig.Parent) then
		return false
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if not humanoid or not rig:FindFirstChild("HumanoidRootPart", true) then
		return false
	end
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		if not rig:FindFirstChild("Torso", true) then
			return false
		end
	elseif humanoid.RigType == Enum.HumanoidRigType.R15 then
		if not (rig:FindFirstChild("UpperTorso", true) and rig:FindFirstChild("LowerTorso", true)) then
			return false
		end
	else
		return false
	end
	for _, descendant in ipairs(rig:GetDescendants()) do
		if PhysicsRigFilter.IsSkeletalMotor(descendant, rig) then
			return true
		end
	end
	return false
end

function PhysicsRigFilter.FindSupportedRagdollRig(instance)
	local current = instance
	while current and current ~= workspace do
		if current:IsA("Model") and PhysicsRigFilter.IsSupportedRagdollRig(current) then
			return current
		end
		current = current.Parent
	end
	return nil
end

return PhysicsRigFilter
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX33">
            <Properties>
              <string name="Name">PhysicsSelectionIsolation</string>
              <ProtectedString name="Source">local PhysicsSelectionIsolation = {}

local function assemblyRoot(part)
	return part.AssemblyRootPart or part
end

function PhysicsSelectionIsolation.FreezeUnselected(selectedDescriptors)
	local selectedRoots = {}
	for _, descriptor in ipairs(selectedDescriptors or {}) do
		local part = descriptor and (descriptor.part or descriptor.instance)
		if part and part.Parent and part:IsA("BasePart") then
			selectedRoots[assemblyRoot(part)] = true
		end
	end

	local seenRoots = {}
	local frozen = 0
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Archivable ~= false then
			local root = assemblyRoot(descendant)
			if not seenRoots[root] then
				seenRoots[root] = true
				if root.Parent and not root.Anchored and not selectedRoots[root] then
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					root.Anchored = true
					frozen += 1
				end
			end
		end
	end
	return frozen
end

return PhysicsSelectionIsolation
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX34">
            <Properties>
              <string name="Name">PhysicsStartingPushRuntime</string>
              <ProtectedString name="Source">local PhysicsStartingPushRuntime = {}

local DEFAULT_SPEED = 12
local MIN_SPEED = 2
local MAX_SPEED = 1000
local SPEED_PRESETS = {
	2,
	4,
	6,
	8,
	10,
	12,
	15,
	20,
	25,
	30,
	40,
	50,
	60,
	75,
	100,
	125,
	150,
	200,
	250,
	300,
	400,
	500,
	600,
	750,
	1000,
}

function PhysicsStartingPushRuntime.ClampSpeed(speed)
	return math.clamp(tonumber(speed) or DEFAULT_SPEED, MIN_SPEED, MAX_SPEED)
end

function PhysicsStartingPushRuntime.StepSpeed(speed, direction)
	local current = PhysicsStartingPushRuntime.ClampSpeed(speed)
	if (tonumber(direction) or 0) &gt;= 0 then
		for _, preset in ipairs(SPEED_PRESETS) do
			if preset &gt; current + 0.001 then
				return preset
			end
		end
		return MAX_SPEED
	end
	for index = #SPEED_PRESETS, 1, -1 do
		local preset = SPEED_PRESETS[index]
		if preset &lt; current - 0.001 then
			return preset
		end
	end
	return MIN_SPEED
end

function PhysicsStartingPushRuntime.Apply(runtimeTargets, push)
	if type(push) ~= "table" or type(push.targetId) ~= "string" or push.targetId == "" then
		return false, "The Starting Push target was not found in Run mode."
	end
	if typeof(push.contactPosition) ~= "Vector3" or typeof(push.originPosition) ~= "Vector3" then
		return false, "The Starting Push contact or direction point is missing."
	end

	local targetPart = nil
	for _, descriptor in ipairs(runtimeTargets or {}) do
		if descriptor.id == push.targetId and descriptor.part and descriptor.part.Parent then
			targetPart = descriptor.part
			break
		end
	end
	if not targetPart then
		return false, "The Starting Push target was not found among the selected physics objects."
	end

	local offset = push.contactPosition - push.originPosition
	if offset.Magnitude &lt; 0.05 then
		return false, "Move the PUSH FROM guide away from the contact point to set a direction."
	end
	local assemblyRoot = targetPart.AssemblyRootPart or targetPart
	if assemblyRoot.Anchored then
		return false, "The Starting Push target is still anchored in Run mode."
	end

	local speed = PhysicsStartingPushRuntime.ClampSpeed(push.speed)
	local mass = math.max(tonumber(assemblyRoot.AssemblyMass) or 0, 0.05)
	local direction = offset.Unit
	assemblyRoot:ApplyImpulseAtPosition(direction * mass * speed, push.contactPosition)
	return true, string.format(
		"Starting Push applied to %s at %.1f studs/s.",
		tostring(push.targetName or targetPart.Name),
		speed
	), {
		targetId = push.targetId,
		targetName = push.targetName or targetPart.Name,
		contactPosition = push.contactPosition,
		direction = direction,
		speed = speed,
	}
end

return PhysicsStartingPushRuntime
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX35">
            <Properties>
              <string name="Name">PhysicsStartingPushUX</string>
              <ProtectedString name="Source">local PhysicsStartingPushUX = {}
PhysicsStartingPushUX.__index = PhysicsStartingPushUX

local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GUIDE_FOLDER_NAME = "MegMoPhysicsStartingPushGuides"
local HANDLE_FOLDER_NAME = "MegMoPhysicsStartingPushHandles"
local PLACEMENT_OWNERSHIP_MARKER_NAME = "MegMoPhysicsStartingPushPlacementOwnership"
local CONTACT_COLOR = Color3.fromRGB(65, 145, 255)
local ORIGIN_COLOR = Color3.fromRGB(239, 72, 86)
local DEFAULT_SCALE_DISTANCE = 18
local MIN_SCALE = 0.75
local MAX_SCALE = 2.25
local HANDLE_CENTER_GAP = 0.34
local HANDLE_STEM_LENGTH = 1.5
local HANDLE_STEM_RADIUS = 0.055
local HANDLE_ARROW_HEIGHT = 0.72
local HANDLE_ARROW_RADIUS = 0.34
local HANDLE_CENTER_RADIUS = 0.39
local HANDLE_HIT_RADIUS = 0.32
local HANDLE_HIT_ARROW_RADIUS = 0.66
local HANDLE_HIT_ARROW_HEIGHT = 1.02
local HANDLE_HIT_SPHERE_RADIUS = 0.82
local HANDLE_HIT_TRANSPARENCY = 0.99
local NORMAL_TRANSPARENCY = 0.34
local HOVER_TRANSPARENCY = 0.08
local HANDLE_HOVER_SCALE = 1.18
local PREVIEW_PULSE_RADIUS = 0.46
local PREVIEW_MIN_TRAVEL_TIME = 0.08
local PREVIEW_MAX_TRAVEL_TIME = 1.8

local FACE_VECTORS = {
	[Enum.NormalId.Right] = Vector3.xAxis,
	[Enum.NormalId.Left] = -Vector3.xAxis,
	[Enum.NormalId.Top] = Vector3.yAxis,
	[Enum.NormalId.Bottom] = -Vector3.yAxis,
	[Enum.NormalId.Back] = Vector3.zAxis,
	[Enum.NormalId.Front] = -Vector3.zAxis,
}

local function safeDestroy(instance)
	if instance then
		instance:Destroy()
	end
end

local function safeConnect(signal, callback)
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	return ok and connection or nil
end

local function localCFrameForDirection(direction, distance)
	local resolvedDirection = direction.Magnitude &gt; 0 and direction.Unit or Vector3.zAxis
	local up = math.abs(resolvedDirection:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	local right = up:Cross(resolvedDirection).Unit
	local correctedUp = resolvedDirection:Cross(right).Unit
	return CFrame.fromMatrix(resolvedDirection * distance, right, correctedUp, resolvedDirection)
end

local function localCFrameAtPositionFacing(positionDirection, distance, facingDirection)
	local resolvedPosition = positionDirection.Magnitude &gt; 0 and positionDirection.Unit or Vector3.zAxis
	local resolvedFacing = facingDirection.Magnitude &gt; 0 and facingDirection.Unit or resolvedPosition
	local up = math.abs(resolvedFacing:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.zAxis or Vector3.yAxis
	local right = up:Cross(resolvedFacing).Unit
	local correctedUp = resolvedFacing:Cross(right).Unit
	return CFrame.fromMatrix(resolvedPosition * distance, right, correctedUp, resolvedFacing)
end

local function cameraScale(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local distance = (camera.CFrame.Position - position).Magnitude
	return math.clamp(distance / DEFAULT_SCALE_DISTANCE, MIN_SCALE, MAX_SCALE)
end

local function previewTravelTime(distance, speed)
	local resolvedSpeed = math.clamp(tonumber(speed) or 12, 2, 1000)
	local speedFactor = math.log(resolvedSpeed + 1) / math.log(1001)
	local distanceFactor = math.clamp(math.sqrt(math.max(distance, 0.05) / 5), 0.65, 1.6)
	return math.clamp(
		(0.95 - 0.78 * speedFactor) * distanceFactor,
		PREVIEW_MIN_TRAVEL_TIME,
		PREVIEW_MAX_TRAVEL_TIME
	)
end

local function makeArrowHandles(parent, prefix, marker, color, endpoint)
	local handles = {}
	for face, direction in pairs(FACE_VECTORS) do
		local stem = Instance.new("CylinderHandleAdornment")
		stem.Name = prefix .. "Stem_" .. face.Name
		stem.Adornee = marker
		stem.AlwaysOnTop = true
		stem.Archivable = false
		stem.Color3 = color
		stem.Height = HANDLE_STEM_LENGTH
		stem.Radius = HANDLE_STEM_RADIUS
		stem.Transparency = NORMAL_TRANSPARENCY + 0.18
		stem.ZIndex = 2
		stem.CFrame = localCFrameForDirection(direction, HANDLE_CENTER_GAP + HANDLE_STEM_LENGTH * 0.5)
		stem.Parent = parent

		local head = Instance.new("ConeHandleAdornment")
		head.Name = prefix .. "Arrow_" .. face.Name
		head.Adornee = marker
		head.AlwaysOnTop = true
		head.Archivable = false
		head.Color3 = color
		head.Height = HANDLE_ARROW_HEIGHT
		head.Radius = HANDLE_ARROW_RADIUS
		head.Transparency = NORMAL_TRANSPARENCY
		head.ZIndex = 5
		head.CFrame = localCFrameAtPositionFacing(
			direction,
			HANDLE_CENTER_GAP + HANDLE_STEM_LENGTH,
			-direction
		)
		head.Parent = parent

		local hitStem = Instance.new("CylinderHandleAdornment")
		hitStem.Name = prefix .. "HitStem_" .. face.Name
		hitStem.Adornee = marker
		hitStem.AlwaysOnTop = true
		hitStem.Archivable = false
		hitStem.Color3 = color
		hitStem.Height = HANDLE_STEM_LENGTH
		hitStem.Radius = HANDLE_HIT_RADIUS
		hitStem.Transparency = HANDLE_HIT_TRANSPARENCY
		hitStem.ZIndex = 6
		hitStem.CFrame = stem.CFrame
		hitStem.Parent = parent

		local hitHead = Instance.new("ConeHandleAdornment")
		hitHead.Name = prefix .. "HitArrow_" .. face.Name
		hitHead.Adornee = marker
		hitHead.AlwaysOnTop = true
		hitHead.Archivable = false
		hitHead.Color3 = color
		hitHead.Height = HANDLE_HIT_ARROW_HEIGHT
		hitHead.Radius = HANDLE_HIT_ARROW_RADIUS
		hitHead.Transparency = HANDLE_HIT_TRANSPARENCY
		hitHead.ZIndex = 7
		hitHead.CFrame = head.CFrame
		hitHead.Parent = parent

		local hitSphere = Instance.new("SphereHandleAdornment")
		hitSphere.Name = prefix .. "HitTip_" .. face.Name
		hitSphere.Adornee = marker
		hitSphere.AlwaysOnTop = true
		hitSphere.Archivable = false
		hitSphere.Color3 = color
		hitSphere.Radius = HANDLE_HIT_SPHERE_RADIUS
		hitSphere.Transparency = HANDLE_HIT_TRANSPARENCY
		hitSphere.ZIndex = 8
		hitSphere.CFrame = CFrame.new(direction * (HANDLE_CENTER_GAP + HANDLE_STEM_LENGTH))
		hitSphere.Parent = parent

		table.insert(handles, {
			endpoint = endpoint,
			face = face,
			direction = direction,
			color = color,
			stem = stem,
			head = head,
			hitStem = hitStem,
			hitHead = hitHead,
			hitSphere = hitSphere,
			visuals = { stem, head },
			hitAdornments = { hitStem, hitHead, hitSphere },
		})
	end
	return handles
end

local function makeTargetRing(parent, name, marker, color)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = name
	billboard.Adornee = marker
	billboard.AlwaysOnTop = true
	billboard.Archivable = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = 10000
	billboard.Size = UDim2.fromOffset(64, 64)
	billboard.Parent = parent

	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.BackgroundTransparency = 1
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromOffset(48, 48)
	ring.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ring
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 2.5
	stroke.Transparency = 0.12
	stroke.Parent = ring

	for _, spec in ipairs({
		{ UDim2.new(0.5, -1, 0, -1), UDim2.fromOffset(2, 12) },
		{ UDim2.new(0.5, -1, 1, -11), UDim2.fromOffset(2, 12) },
		{ UDim2.new(0, -1, 0.5, -1), UDim2.fromOffset(12, 2) },
		{ UDim2.new(1, -11, 0.5, -1), UDim2.fromOffset(12, 2) },
	}) do
		local tick = Instance.new("Frame")
		tick.BackgroundColor3 = color
		tick.BorderSizePixel = 0
		tick.Position = spec[1]
		tick.Size = spec[2]
		tick.Parent = billboard
	end
	return billboard
end

local function setBillboardText(billboard, text)
	local label = billboard and billboard:FindFirstChildWhichIsA("TextLabel")
	if label then
		label.Text = text
	end
end

local function makeCenterSphere(parent, name, marker, color)
	local sphere = Instance.new("SphereHandleAdornment")
	sphere.Name = name
	sphere.Adornee = marker
	sphere.AlwaysOnTop = true
	sphere.Archivable = false
	sphere.Color3 = color
	sphere.Radius = HANDLE_CENTER_RADIUS
	sphere.Transparency = NORMAL_TRANSPARENCY
	sphere.ZIndex = 4
	sphere.Parent = parent
	return sphere
end

local function makeDirectionChevrons(parent, marker)
	local chevrons = {}
	for index = 1, 3 do
		local chevron = Instance.new("ConeHandleAdornment")
		chevron.Name = "StartingPushDirectionChevron" .. index
		chevron.Adornee = marker
		chevron.AlwaysOnTop = true
		chevron.Archivable = false
		chevron.Color3 = ORIGIN_COLOR:Lerp(CONTACT_COLOR, index / 4)
		chevron.Transparency = 0.18
		chevron.ZIndex = 3
		chevron.Parent = parent
		table.insert(chevrons, chevron)
	end
	return chevrons
end

local function makePreviewPulse(parent, marker)
	local pulse = Instance.new("SphereHandleAdornment")
	pulse.Name = "StartingPushPreviewPulse"
	pulse.Adornee = marker
	pulse.AlwaysOnTop = true
	pulse.Archivable = false
	pulse.Color3 = ORIGIN_COLOR
	pulse.Radius = PREVIEW_PULSE_RADIUS
	pulse.Transparency = 0.04
	pulse.Visible = false
	pulse.ZIndex = 10
	pulse.Parent = parent
	return pulse
end

local function refreshArrowHandles(handles, marker)
	if not (marker and marker.Parent) then
		return
	end
	local scale = cameraScale(marker.Position)
	local stemLength = HANDLE_STEM_LENGTH * scale
	local centerGap = HANDLE_CENTER_GAP * scale
	local visualStemLength = math.max(0.05, stemLength - centerGap)
	local arrowHeight = HANDLE_ARROW_HEIGHT * scale
	local arrowHitHeight = HANDLE_HIT_ARROW_HEIGHT * scale
	for _, handle in ipairs(handles or {}) do
		handle.stem.Height = visualStemLength
		handle.stem.Radius = HANDLE_STEM_RADIUS * scale
		handle.stem.CFrame = localCFrameForDirection(
			handle.direction,
			centerGap + visualStemLength * 0.5
		)

		handle.hitStem.Height = visualStemLength
		handle.hitStem.Radius = HANDLE_HIT_RADIUS * scale
		handle.hitStem.CFrame = handle.stem.CFrame

		handle.arrowHeight = arrowHeight
		handle.arrowRadius = HANDLE_ARROW_RADIUS * scale
		handle.head.Height = arrowHeight * (handle.active and HANDLE_HOVER_SCALE or 1)
		handle.head.Radius = handle.arrowRadius * (handle.active and HANDLE_HOVER_SCALE or 1)
		handle.head.CFrame = localCFrameAtPositionFacing(handle.direction, stemLength, -handle.direction)

		handle.hitHead.Height = arrowHitHeight
		handle.hitHead.Radius = HANDLE_HIT_ARROW_RADIUS * scale
		handle.hitHead.CFrame = handle.head.CFrame
		handle.hitSphere.Radius = HANDLE_HIT_SPHERE_RADIUS * scale
		handle.hitSphere.CFrame = CFrame.new(handle.direction * stemLength)
	end
end

local function refreshCenterSphere(sphere, marker)
	if sphere and sphere.Parent and marker and marker.Parent then
		sphere.Radius = HANDLE_CENTER_RADIUS * cameraScale(marker.Position)
	end
end

local function getViewportMouseCandidates()
	local candidates = {}
	local ok, mouse = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if ok and typeof(mouse) == "Vector2" then
		table.insert(candidates, mouse)
		local insetOk, inset = pcall(function()
			return GuiService:GetGuiInset()
		end)
		if insetOk and typeof(inset) == "Vector2" then
			table.insert(candidates, mouse - inset)
		end
	end
	return candidates
end

local function isPointerOverMegMoGui(coreGui)
	local ok, mouse = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if not (ok and typeof(mouse) == "Vector2") then
		return false
	end
	local objectsOk, objects = pcall(function()
		return coreGui:GetGuiObjectsAtPosition(mouse.X, mouse.Y)
	end)
	if not (objectsOk and type(objects) == "table") then
		return false
	end
	for _, object in ipairs(objects) do
		local ancestor = object
		while ancestor do
			if ancestor:IsA("ScreenGui") and string.find(ancestor.Name, "7kg2", 1, true) then
				return true
			end
			ancestor = ancestor.Parent
		end
	end
	return false
end

local function raycastPlacementTargets(targetParts)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local filter = {}
	for _, part in ipairs(targetParts or {}) do
		if part and part.Parent and part:IsA("BasePart") then
			table.insert(filter, part)
		end
	end
	if #filter == 0 then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true
	for _, mouse in ipairs(getViewportMouseCandidates()) do
		if mouse.X &gt;= 0
			and mouse.Y &gt;= 0
			and mouse.X &lt;= camera.ViewportSize.X
			and mouse.Y &lt;= camera.ViewportSize.Y then
			local ray = camera:ViewportPointToRay(mouse.X, mouse.Y, 0)
			local result = workspace:Raycast(ray.Origin, ray.Direction * 10000, params)
			if result then
				return result
			end
		end
	end
	return nil
end

local function intersectPlane(rayOrigin, rayDirection, planeOrigin, planeNormal)
	local denominator = planeNormal:Dot(rayDirection)
	if math.abs(denominator) &lt; 0.0001 then
		return nil
	end
	local distance = planeNormal:Dot(planeOrigin - rayOrigin) / denominator
	if distance &lt; 0 then
		return nil
	end
	return rayOrigin + rayDirection * distance
end

local function intersectViewportPlane(planeOrigin, planeNormal)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	for _, mouse in ipairs(getViewportMouseCandidates()) do
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y, 0)
		local point = intersectPlane(ray.Origin, ray.Direction, planeOrigin, planeNormal)
		if point then
			return point
		end
	end
	return nil
end

local function chooseMovePlaneNormal(axisDirection, origin)
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.yAxis
	end
	local cameraLook = -camera.CFrame.LookVector
	local bestNormal = nil
	local bestScore = -math.huge
	for _, candidate in ipairs({ camera.CFrame.RightVector, camera.CFrame.UpVector, cameraLook }) do
		local rejected = candidate - axisDirection * candidate:Dot(axisDirection)
		if rejected.Magnitude &gt; 0.001 then
			local normal = rejected.Unit
			local score = math.abs(normal:Dot(cameraLook))
			if score &gt; bestScore then
				bestScore = score
				bestNormal = normal
			end
		end
	end
	if bestNormal then
		local toCamera = camera.CFrame.Position - origin
		return bestNormal:Dot(toCamera) &lt; 0 and -bestNormal or bestNormal
	end
	return cameraLook
end

local function makeMarker(parent, name)
	local marker = Instance.new("Part")
	marker.Name = name
	marker.Anchored = true
	marker.Archivable = false
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.CastShadow = false
	marker.Locked = true
	marker.Size = Vector3.new(0.4, 0.4, 0.4)
	marker.Transparency = 1
	marker.Parent = parent
	return marker
end

local function makeLabel(parent, name, marker, title, color)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = name
	billboard.Adornee = marker
	billboard.AlwaysOnTop = true
	billboard.Archivable = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = 10000
	billboard.Size = UDim2.fromOffset(118, 30)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.25, 0)
	billboard.Parent = parent

	local text = Instance.new("TextLabel")
	text.BackgroundColor3 = Color3.fromRGB(12, 16, 24)
	text.BackgroundTransparency = 0.08
	text.BorderSizePixel = 0
	text.Font = Enum.Font.GothamBold
	text.Size = UDim2.fromScale(1, 1)
	text.Text = title
	text.TextColor3 = Color3.fromRGB(248, 250, 255)
	text.TextSize = 12
	text.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = text
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1.5
	stroke.Transparency = 0.05
	stroke.Parent = text
	return billboard
end

local function makeBeam(contactMarker, originMarker)
	local originAttachment = Instance.new("Attachment")
	originAttachment.Name = "PushOrigin"
	originAttachment.Parent = originMarker
	local contactAttachment = Instance.new("Attachment")
	contactAttachment.Name = "PushContact"
	contactAttachment.Parent = contactMarker
	local beam = Instance.new("Beam")
	beam.Name = "StartingPushDirection"
	beam.Archivable = false
	beam.Attachment0 = originAttachment
	beam.Attachment1 = contactAttachment
	beam.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, ORIGIN_COLOR),
		ColorSequenceKeypoint.new(1, CONTACT_COLOR),
	})
	beam.FaceCamera = true
	beam.LightEmission = 0
	beam.LightInfluence = 1
	beam.Segments = 1
	beam.Transparency = NumberSequence.new(0.24)
	beam.Width0 = 0.22
	beam.Width1 = 0.08
	beam.Parent = originMarker
	return beam
end

function PhysicsStartingPushUX.new(plugin, coreGui, onChanged)
	local self = setmetatable({
		plugin = plugin,
		coreGui = coreGui,
		onChanged = onChanged,
		visible = false,
		activeEndpoint = nil,
		previewSpeed = 12,
		connections = {},
	}, PhysicsStartingPushUX)
	local changedConnection = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			self:_updateDrag()
		end
	end)
	local endedConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_endDrag()
		end
	end)
	local heartbeatConnection = RunService.Heartbeat:Connect(function()
		if self.visible then
			self:_refreshHandleGeometry()
			self:_stepPreview()
		end
	end)
	table.insert(self.connections, changedConnection)
	table.insert(self.connections, endedConnection)
	table.insert(self.connections, heartbeatConnection)
	return self
end

function PhysicsStartingPushUX:_setPlacementOwnership(active, graceSeconds)
	local marker = self.placementOwnershipMarker
	if not (marker and marker.Parent == self.coreGui) then
		marker = self.coreGui:FindFirstChild(PLACEMENT_OWNERSHIP_MARKER_NAME)
		if marker and not marker:IsA("Folder") then
			safeDestroy(marker)
			marker = nil
		end
		if not marker then
			marker = Instance.new("Folder")
			marker.Name = PLACEMENT_OWNERSHIP_MARKER_NAME
			marker.Archivable = false
			marker.Parent = self.coreGui
		end
		self.placementOwnershipMarker = marker
	end
	marker:SetAttribute("OwnsViewport", active == true)
	marker:SetAttribute(
		"IgnoreViewportPickerUntil",
		active == true and os.clock() + 3600 or os.clock() + math.max(0, tonumber(graceSeconds) or 0)
	)
end

function PhysicsStartingPushUX:CancelContactPlacement(graceSeconds)
	if self.placementConnection then
		self.placementConnection:Disconnect()
		self.placementConnection = nil
	end
	self.placementActive = false
	self.placementTargets = nil
	self.placementOnPlaced = nil
	self.placementOnMiss = nil
	self:_setPlacementOwnership(false, graceSeconds)
	self:_setVisible()
end

function PhysicsStartingPushUX:IsContactPlacementActive()
	return self.placementActive == true
end

function PhysicsStartingPushUX:BeginContactPlacement(targetParts, onPlaced, onMiss)
	self:CancelContactPlacement(0)
	local validTargets = {}
	for _, part in ipairs(targetParts or {}) do
		if part and part.Parent and part:IsA("BasePart") then
			table.insert(validTargets, part)
		end
	end
	if #validTargets == 0 then
		return false
	end
	self.placementActive = true
	self.placementTargets = validTargets
	self.placementOnPlaced = onPlaced
	self.placementOnMiss = onMiss
	self:_setPlacementOwnership(true)
	self:_setVisible()
	self.placementConnection = UserInputService.InputBegan:Connect(function(input)
		if not self.placementActive then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape then
			self:CancelContactPlacement(0.1)
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or isPointerOverMegMoGui(self.coreGui) then
			return
		end
		local result = raycastPlacementTargets(self.placementTargets)
		if not result then
			if type(self.placementOnMiss) == "function" then
				self.placementOnMiss()
			end
			return
		end
		local hitPart = result.Instance
		local contactPosition = result.Position
		local originPosition = contactPosition + result.Normal * 5
		local placedCallback = self.placementOnPlaced
		self:SetTarget(hitPart, contactPosition, originPosition, true)
		self:CancelContactPlacement(0.35)
		if type(placedCallback) == "function" then
			placedCallback(hitPart, contactPosition, originPosition)
		end
	end)
	return true
end

function PhysicsStartingPushUX:_claimPointerOwnership()
	if not self.plugin then
		return
	end
	pcall(function()
		self.plugin:Activate(true)
	end)
end

function PhysicsStartingPushUX:_ensureFolders()
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	if not (self.guideFolder and self.guideFolder.Parent == camera) then
		safeDestroy(self.guideFolder)
		safeDestroy(self.handleFolder)
		self.handleFolder = nil
		safeDestroy(camera:FindFirstChild(GUIDE_FOLDER_NAME))
		self.guideFolder = Instance.new("Folder")
		self.guideFolder.Name = GUIDE_FOLDER_NAME
		self.guideFolder.Archivable = false
		self.guideFolder.Parent = camera
	end
	if not (self.handleFolder and self.handleFolder.Parent == self.coreGui) then
		safeDestroy(self.handleFolder)
		safeDestroy(self.coreGui:FindFirstChild(HANDLE_FOLDER_NAME))
		self.handleFolder = Instance.new("Folder")
		self.handleFolder.Name = HANDLE_FOLDER_NAME
		self.handleFolder.Archivable = false
		self.handleFolder.Parent = self.coreGui
	end
	return true
end

function PhysicsStartingPushUX:_emitChanged()
	self.contactPosition = self.contactMarker and self.contactMarker.Position or self.contactPosition
	self.originPosition = self.originMarker and self.originMarker.Position or self.originPosition
	self:_refreshLabels()
	if self.onChanged then
		self.onChanged(self.contactPosition, self.originPosition)
	end
end

function PhysicsStartingPushUX:_setHandleActive(handle, active)
	handle.active = active == true
	if active and handle.endpoint then
		self:_showEndpointHandles(handle.endpoint)
	end
	for _, visual in ipairs(handle and handle.visuals or {}) do
		visual.Transparency = active
			and (visual:IsA("ConeHandleAdornment") and HOVER_TRANSPARENCY or HOVER_TRANSPARENCY + 0.12)
			or (visual:IsA("ConeHandleAdornment") and NORMAL_TRANSPARENCY or NORMAL_TRANSPARENCY + 0.18)
	end
	if handle and handle.head and handle.arrowHeight and handle.arrowRadius then
		local scale = active and HANDLE_HOVER_SCALE or 1
		handle.head.Height = handle.arrowHeight * scale
		handle.head.Radius = handle.arrowRadius * scale
	end
end

function PhysicsStartingPushUX:_showEndpointHandles(endpoint)
	if endpoint ~= "Contact" and endpoint ~= "Origin" then
		return
	end
	self.activeEndpoint = endpoint
	self:_refreshEndpointVisibility()
end

function PhysicsStartingPushUX:_refreshEndpointVisibility()
	local show = self.visible
		and self.placementActive ~= true
		and self.contactPosition ~= nil
		and self.originPosition ~= nil
	for endpoint, handles in pairs({
		Contact = self.contactArrowHandles or {},
		Origin = self.originArrowHandles or {},
	}) do
		local endpointVisible = show and self.activeEndpoint == endpoint
		for _, handle in ipairs(handles) do
			for _, adornment in ipairs(handle.visuals or {}) do
				adornment.Visible = endpointVisible
			end
			for _, adornment in ipairs(handle.hitAdornments or {}) do
				adornment.Visible = endpointVisible
			end
		end
	end
end

function PhysicsStartingPushUX:_refreshHandleGeometry()
	refreshArrowHandles(self.contactArrowHandles, self.contactMarker)
	refreshArrowHandles(self.originArrowHandles, self.originMarker)
	refreshCenterSphere(self.contactCenterSphere, self.contactMarker)
	refreshCenterSphere(self.originCenterSphere, self.originMarker)
	self:_refreshDirectionDecorations()
end

function PhysicsStartingPushUX:_refreshDirectionDecorations()
	if not (self.contactMarker and self.contactMarker.Parent and self.originMarker and self.originMarker.Parent) then
		return
	end
	local worldDelta = self.contactMarker.Position - self.originMarker.Position
	if worldDelta.Magnitude &lt; 0.05 then
		return
	end
	local localDelta = self.originMarker.CFrame:VectorToObjectSpace(worldDelta)
	local scale = cameraScale((self.contactMarker.Position + self.originMarker.Position) * 0.5)
	for index, chevron in ipairs(self.directionChevrons or {}) do
		local fraction = index / 4
		chevron.Height = 0.34 * scale
		chevron.Radius = 0.18 * scale
		chevron.CFrame = localCFrameAtPositionFacing(
			localDelta,
			localDelta.Magnitude * fraction,
			-localDelta
		)
	end
	if self.speedMarker then
		self.speedMarker.Position = self.originMarker.Position:Lerp(self.contactMarker.Position, 0.5)
	end
end

function PhysicsStartingPushUX:_stepPreview()
	if not (self.previewing and self.previewMarker and self.previewMarker.Parent and self.previewPulse) then
		return
	end
	local origin = self.originPosition
	local contact = self.contactPosition
	if typeof(origin) ~= "Vector3" or typeof(contact) ~= "Vector3" then
		self:StopPreview()
		return
	end
	local distance = (contact - origin).Magnitude
	if distance &lt; 0.05 then
		self.previewPulse.Visible = false
		return
	end
	local travelTime = previewTravelTime(distance, self.previewSpeed)
	local elapsed = os.clock() - (self.previewStartedAt or os.clock())
	if elapsed &gt;= travelTime then
		self.previewMarker.Position = contact
		self.previewPulse.Color3 = CONTACT_COLOR
		self.previewPulse.Radius = PREVIEW_PULSE_RADIUS * 1.35 * cameraScale(contact)
		self.previewPulse.Visible = self.visible
		self.previewing = false
		local onImpact = self.previewOnImpact
		self.previewOnImpact = nil
		if type(onImpact) == "function" then
			task.defer(onImpact)
		end
		return
	end
	local alpha = math.clamp(elapsed / travelTime, 0, 1)
	self.previewMarker.Position = origin:Lerp(contact, alpha)
	self.previewPulse.Color3 = ORIGIN_COLOR:Lerp(CONTACT_COLOR, alpha)
	self.previewPulse.Radius = PREVIEW_PULSE_RADIUS * cameraScale(self.previewMarker.Position)
	self.previewPulse.Visible = self.visible
end

function PhysicsStartingPushUX:_beginDrag(handle, marker)
	if not (self.visible and handle and marker and marker.Parent) then
		return
	end
	local origin = marker.Position
	local axisDirection = marker.CFrame:VectorToWorldSpace(handle.direction).Unit
	local planeNormal = chooseMovePlaneNormal(axisDirection, origin)
	local point = intersectViewportPlane(origin, planeNormal)
	if not point then
		return
	end
	self.dragging = {
		handle = handle,
		marker = marker,
		startCFrame = marker.CFrame,
		origin = origin,
		axisDirection = axisDirection,
		planeNormal = planeNormal,
		initialScalar = axisDirection:Dot(point - origin),
	}
	self:_setHandleActive(handle, true)
end

function PhysicsStartingPushUX:_updateDrag()
	local drag = self.dragging
	if not (drag and drag.marker and drag.marker.Parent) then
		return
	end
	local point = intersectViewportPlane(drag.origin, drag.planeNormal)
	if not point then
		return
	end
	local distance = drag.axisDirection:Dot(point - drag.origin) - drag.initialScalar
	drag.marker.CFrame = drag.startCFrame + drag.axisDirection * distance
	self:_emitChanged()
end

function PhysicsStartingPushUX:_endDrag()
	local drag = self.dragging
	if not drag then
		return
	end
	self.dragging = nil
	self:_setHandleActive(drag.handle, false)
end

function PhysicsStartingPushUX:_bindArrowHandles(handles, marker)
	for _, handle in ipairs(handles or {}) do
		for _, adornment in ipairs(handle.visuals or {}) do
			local enter = safeConnect(adornment.MouseEnter, function()
				self:_claimPointerOwnership()
				self:_setHandleActive(handle, true)
			end)
			local leave = safeConnect(adornment.MouseLeave, function()
				if not (self.dragging and self.dragging.handle == handle) then
					self:_setHandleActive(handle, false)
				end
			end)
			local down = safeConnect(adornment.MouseButton1Down, function()
				self:_claimPointerOwnership()
				self:_beginDrag(handle, marker)
			end)
			if enter then table.insert(self.connections, enter) end
			if leave then table.insert(self.connections, leave) end
			if down then table.insert(self.connections, down) end
		end
		for _, adornment in ipairs(handle.hitAdornments or {}) do
			local enter = safeConnect(adornment.MouseEnter, function()
				self:_claimPointerOwnership()
				self:_setHandleActive(handle, true)
			end)
			local leave = safeConnect(adornment.MouseLeave, function()
				if not (self.dragging and self.dragging.handle == handle) then
					self:_setHandleActive(handle, false)
				end
			end)
			local down = safeConnect(adornment.MouseButton1Down, function()
				self:_claimPointerOwnership()
				self:_beginDrag(handle, marker)
			end)
			if enter then
				table.insert(self.connections, enter)
			end
			if leave then
				table.insert(self.connections, leave)
			end
			if down then
				table.insert(self.connections, down)
			end
		end
	end
end

function PhysicsStartingPushUX:_bindCenterSphere(sphere, endpoint)
	if not sphere then
		return
	end
	local enter = safeConnect(sphere.MouseEnter, function()
		self:_claimPointerOwnership()
		self:_showEndpointHandles(endpoint)
		sphere.Transparency = HOVER_TRANSPARENCY
	end)
	local leave = safeConnect(sphere.MouseLeave, function()
		sphere.Transparency = NORMAL_TRANSPARENCY
	end)
	local down = safeConnect(sphere.MouseButton1Down, function()
		self:_claimPointerOwnership()
		self:_showEndpointHandles(endpoint)
	end)
	if enter then table.insert(self.connections, enter) end
	if leave then table.insert(self.connections, leave) end
	if down then table.insert(self.connections, down) end
end

function PhysicsStartingPushUX:_ensureVisuals()
	if not self:_ensureFolders() then
		return false
	end
	if self.contactMarker and self.contactMarker.Parent and self.originMarker and self.originMarker.Parent then
		return true
	end
	self.contactMarker = makeMarker(self.guideFolder, "StartingPushContact")
	self.originMarker = makeMarker(self.guideFolder, "StartingPushOrigin")
	self.speedMarker = makeMarker(self.guideFolder, "StartingPushSpeedLabelMarker")
	self.previewMarker = makeMarker(self.guideFolder, "StartingPushPreviewMarker")
	self.contactCenterSphere = makeCenterSphere(
		self.handleFolder,
		"StartingPushContactCenter",
		self.contactMarker,
		CONTACT_COLOR
	)
	self.originCenterSphere = makeCenterSphere(
		self.handleFolder,
		"StartingPushOriginCenter",
		self.originMarker,
		ORIGIN_COLOR
	)
	self.contactArrowHandles = makeArrowHandles(
		self.handleFolder,
		"StartingPushContact",
		self.contactMarker,
		CONTACT_COLOR,
		"Contact"
	)
	self.originArrowHandles = makeArrowHandles(
		self.handleFolder,
		"StartingPushOrigin",
		self.originMarker,
		ORIGIN_COLOR,
		"Origin"
	)
	self.contactRing = makeTargetRing(self.handleFolder, "StartingPushContactTarget", self.contactMarker, CONTACT_COLOR)
	self.originRing = makeTargetRing(self.handleFolder, "StartingPushOriginEmitter", self.originMarker, ORIGIN_COLOR)
	self.contactLabel = makeLabel(self.handleFolder, "StartingPushContactLabel", self.contactMarker, "CONTACT", CONTACT_COLOR)
	self.originLabel = makeLabel(self.handleFolder, "StartingPushOriginLabel", self.originMarker, "PUSH FROM", ORIGIN_COLOR)
	self.speedLabel = makeLabel(
		self.handleFolder,
		"StartingPushSpeedLabel",
		self.speedMarker,
		string.format("%.0f STUDS/S", self.previewSpeed or 12),
		ORIGIN_COLOR:Lerp(CONTACT_COLOR, 0.5)
	)
	self.speedLabel.Size = UDim2.fromOffset(104, 26)
	self.speedLabel.StudsOffsetWorldSpace = Vector3.new(0, 0.72, 0)
	self.beam = makeBeam(self.contactMarker, self.originMarker)
	self.directionChevrons = makeDirectionChevrons(self.handleFolder, self.originMarker)
	self.previewPulse = makePreviewPulse(self.handleFolder, self.previewMarker)
	self.targetHighlight = Instance.new("Highlight")
	self.targetHighlight.Name = "StartingPushTargetHighlight"
	self.targetHighlight.Adornee = self.targetPart
	self.targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	self.targetHighlight.FillColor = CONTACT_COLOR
	self.targetHighlight.FillTransparency = 0.88
	self.targetHighlight.OutlineColor = CONTACT_COLOR
	self.targetHighlight.OutlineTransparency = 0.04
	self.targetHighlight.Parent = self.guideFolder

	self:_bindArrowHandles(self.contactArrowHandles, self.contactMarker)
	self:_bindArrowHandles(self.originArrowHandles, self.originMarker)
	self:_bindCenterSphere(self.contactCenterSphere, "Contact")
	self:_bindCenterSphere(self.originCenterSphere, "Origin")
	self:_refreshHandleGeometry()
	return true
end

function PhysicsStartingPushUX:_refreshLabels()
	if not (self.contactPosition and self.originPosition) then
		return
	end
	local originText = self.originLabel and self.originLabel:FindFirstChildWhichIsA("TextLabel")
	if originText then
		originText.Text = "PUSH FROM"
	end
	local contactText = self.contactLabel and self.contactLabel:FindFirstChildWhichIsA("TextLabel")
	if contactText then
		contactText.Text = "CONTACT"
	end
end

function PhysicsStartingPushUX:_setVisible()
	local show = self.visible
		and self.placementActive ~= true
		and self.contactPosition ~= nil
		and self.originPosition ~= nil
	self:_refreshEndpointVisibility()
	if self.contactCenterSphere then
		self.contactCenterSphere.Visible = show
	end
	if self.originCenterSphere then
		self.originCenterSphere.Visible = show
	end
	if self.contactLabel then
		self.contactLabel.Enabled = show
		self.originLabel.Enabled = show
		self.contactRing.Enabled = show
		self.originRing.Enabled = show
		self.speedLabel.Enabled = show
		self.beam.Enabled = show
		self.targetHighlight.Enabled = show
	end
	for _, chevron in ipairs(self.directionChevrons or {}) do
		chevron.Visible = show
	end
	if self.previewPulse then
		self.previewPulse.Visible = show and self.previewing == true
	end
	if show then
		self:_refreshHandleGeometry()
	end
end

function PhysicsStartingPushUX:SetAdornee(targetPart)
	if not (targetPart and targetPart.Parent and targetPart:IsA("BasePart")) then
		return false
	end
	self.targetPart = targetPart
	if self:_ensureVisuals() and self.targetHighlight then
		self.targetHighlight.Adornee = targetPart
		self:_setVisible()
	end
	return true
end

function PhysicsStartingPushUX:SetTarget(targetPart, contactPosition, originPosition, visible)
	if not (targetPart and targetPart.Parent and targetPart:IsA("BasePart")) then
		return nil, nil
	end
	if typeof(contactPosition) ~= "Vector3" or typeof(originPosition) ~= "Vector3" then
		local contact = targetPart.Position + targetPart.CFrame.UpVector * math.min(targetPart.Size.Y * 0.32, 2)
		local camera = workspace.CurrentCamera
		local direction = camera and camera.CFrame.LookVector or targetPart.CFrame.LookVector
		direction = Vector3.new(direction.X, 0, direction.Z)
		if direction.Magnitude &lt; 0.05 then
			direction = Vector3.new(targetPart.CFrame.LookVector.X, 0, targetPart.CFrame.LookVector.Z)
		end
		if direction.Magnitude &lt; 0.05 then
			direction = Vector3.zAxis
		end
		local distance = math.clamp(targetPart.Size.Magnitude * 0.45, 2, 5)
		contactPosition = contact
		originPosition = contact - direction.Unit * distance
	end
	self.targetPart = targetPart
	self.contactPosition = contactPosition
	self.originPosition = originPosition
	self.visible = visible == true
	if self:_ensureVisuals() then
		self.targetHighlight.Adornee = targetPart
		self.contactMarker.Position = contactPosition
		self.originMarker.Position = originPosition
		self:_refreshLabels()
		self:_setVisible()
	end
	return contactPosition, originPosition
end

function PhysicsStartingPushUX:SetVisible(visible)
	self.visible = visible == true
	if not self.visible then
		self:CancelContactPlacement(0.1)
		self:_endDrag()
		self:StopPreview()
		self.activeEndpoint = nil
	end
	if self.contactPosition and self.originPosition then
		self:_ensureVisuals()
	end
	self:_setVisible()
end

function PhysicsStartingPushUX:SetSpeed(speed)
	self.previewSpeed = math.max(0.1, tonumber(speed) or self.previewSpeed or 12)
	setBillboardText(self.speedLabel, string.format("%.0f STUDS/S", self.previewSpeed))
end

function PhysicsStartingPushUX:StartPreview(speed, onImpact)
	self:StopPreview()
	self:SetSpeed(speed)
	if not (self.visible and self.contactPosition and self.originPosition and self:_ensureVisuals()) then
		return nil
	end
	local distance = (self.contactPosition - self.originPosition).Magnitude
	local travelTime = previewTravelTime(distance, self.previewSpeed)
	self.previewing = true
	self.previewStartedAt = os.clock()
	self.previewOnImpact = onImpact
	self.previewMarker.Position = self.originPosition
	self:_stepPreview()
	return travelTime
end

function PhysicsStartingPushUX:StopPreview()
	self.previewing = false
	self.previewStartedAt = nil
	self.previewOnImpact = nil
	if self.previewPulse then
		self.previewPulse.Visible = false
	end
	if self.previewMarker and self.previewMarker.Parent and self.originPosition then
		self.previewMarker.Position = self.originPosition
	end
end

function PhysicsStartingPushUX:Clear()
	self:CancelContactPlacement(0.1)
	self:_endDrag()
	self:StopPreview()
	self.targetPart = nil
	self.contactPosition = nil
	self.originPosition = nil
	self.visible = false
	self:_setVisible()
end

function PhysicsStartingPushUX:Destroy()
	self:CancelContactPlacement(0)
	self:_endDrag()
	self:StopPreview()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	safeDestroy(self.guideFolder)
	safeDestroy(self.handleFolder)
	safeDestroy(self.placementOwnershipMarker)
	self.guideFolder = nil
	self.handleFolder = nil
	self.placementOwnershipMarker = nil
	self.plugin = nil
end

return PhysicsStartingPushUX
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX36">
            <Properties>
              <string name="Name">PhysicsWorkflowUX</string>
              <ProtectedString name="Source">local PhysicsWorkflowUX = {}
PhysicsWorkflowUX.__index = PhysicsWorkflowUX

local FOLDER_NAME = "MegMoPhysicsCaptureHighlights"

local function makeHighlight(parent, name, adornee, color)
	local highlight = Instance.new("Highlight")
	highlight.Name = name
	highlight.Archivable = false
	highlight.Adornee = adornee
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = color
	highlight.FillTransparency = 0.9
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0.05
	highlight.Parent = parent
	return highlight
end

local function makeSelectionOutline(parent, name, adornee, color)
	if adornee and adornee:IsA("Model") then
		-- A Highlight on a Model traces every individual limb and accessory. A
		-- SelectionBox gives the workflow one clear outline for the whole model.
		local outline = Instance.new("SelectionBox")
		outline.Name = name
		outline.Archivable = false
		outline.Adornee = adornee
		outline.Color3 = color
		outline.LineThickness = 0.035
		outline.SurfaceColor3 = color
		outline.SurfaceTransparency = 1
		outline.Parent = parent
		return outline
	end
	return makeHighlight(parent, name, adornee, color)
end

local function findSelectionHighlightAdornee(instance)
	if not (instance and instance.Parent) then
		return nil
	end

	-- Physics captures individual BaseParts, but highlighting every captured part
	-- quickly exceeds Studio's visible Highlight budget for multi-rig selections.
	-- Prefer the containing character rig, or otherwise the highest containing
	-- Model, so the outline still represents the full captured selection while
	-- using only one Highlight per visible object.
	local current = instance
	local highestModel = nil
	while current and current ~= workspace do
		if current:IsA("Model") then
			highestModel = current
			if current:FindFirstChildOfClass("Humanoid") then
				return current
			end
		end
		current = current.Parent
	end
	return highestModel or instance
end

local function findAdornee(instance)
	if not (instance and instance.Parent) then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance
	end
	if instance:IsA("Attachment") and instance.Parent:IsA("BasePart") then
		return instance.Parent
	end
	if instance:IsA("Model") then
		return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local BLAST_GUIDE_NAMES = {
	BlastRadius = true,
	BlastCenter = true,
	BlastGuideLabel = true,
}

local function getBlastColor(strength, power)
	local resolvedPower = math.clamp(tonumber(power) or (strength == "Light" and 25 or strength == "Heavy" and 100 or 50), 10, 100)
	if resolvedPower &lt;= 50 then
		return Color3.fromRGB(255, 214, 92):Lerp(
			Color3.fromRGB(255, 150, 60),
			(resolvedPower - 10) / 40
		)
	end
	return Color3.fromRGB(255, 150, 60):Lerp(
		Color3.fromRGB(255, 80, 100),
		(resolvedPower - 50) / 50
	)
end

local function makeSphere(parent, name, adornee, worldPosition, radius, color, transparency, zIndex)
	local sphere = Instance.new("SphereHandleAdornment")
	sphere.Name = name
	sphere.Archivable = false
	sphere.Adornee = adornee
	sphere.AlwaysOnTop = true
	sphere.Color3 = color
	sphere.Transparency = transparency
	sphere.Radius = radius
	sphere.CFrame = adornee.CFrame:ToObjectSpace(CFrame.new(worldPosition))
	sphere.ZIndex = zIndex
	sphere.Parent = parent
	return sphere
end

local function makeBlastGuide(parent, eventSource, guide)
	local adornee = findAdornee(eventSource)
	if not (adornee and typeof(guide.position) == "Vector3") then
		return
	end

	local strength = tostring(guide.strength or "Medium")
	local power = math.clamp(tonumber(guide.power) or (strength == "Light" and 25 or strength == "Heavy" and 100 or 50), 10, 100)
	local radius = math.max(0.1, tonumber(guide.radius) or 1)
	-- The simulation keeps using the full blast radius. The viewport guide is a
	-- compact visual reference so high-power previews do not obscure the scene.
	local visualRadius = math.clamp(radius * 0.3, 1.5, 45)
	local color = getBlastColor(strength, power)
	makeSphere(parent, "BlastRadius", adornee, guide.position, visualRadius, color, 0.88, 1)
	makeSphere(parent, "BlastCenter", adornee, guide.position, math.clamp(visualRadius * 0.055, 0.45, 1.15), color, 0.12, 3)

	local label = Instance.new("BillboardGui")
	label.Name = "BlastGuideLabel"
	label.Archivable = false
	label.Adornee = adornee
	label.AlwaysOnTop = true
	label.LightInfluence = 0
	label.MaxDistance = 10000
	label.Size = UDim2.fromOffset(230, 42)
	label.StudsOffsetWorldSpace = guide.position - adornee.Position + Vector3.new(0, math.clamp(visualRadius * 0.25, 3, 8), 0)
	label.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	label.Parent = parent

	local text = Instance.new("TextLabel")
	text.Name = "PowerAndRadius"
	text.BackgroundColor3 = Color3.fromRGB(12, 16, 24)
	text.BackgroundTransparency = 0.1
	text.BorderSizePixel = 0
	text.Font = Enum.Font.GothamBold
	text.Size = UDim2.fromScale(1, 1)
	text.Text = string.format("Power: %d%%  |  Radius: %.1f studs", math.round(power), radius)
	text.TextColor3 = Color3.fromRGB(248, 250, 255)
	text.TextSize = 14
	text.TextStrokeTransparency = 0.8
	text.Parent = label

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = text

	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1.5
	stroke.Transparency = 0.1
	stroke.Parent = text
end

function PhysicsWorkflowUX.new(parent, folderName)
	folderName = folderName or FOLDER_NAME
	local existing = parent and parent:FindFirstChild(folderName)
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder.Archivable = false
	folder.Parent = parent
	return setmetatable({
		folder = folder,
	}, PhysicsWorkflowUX)
end

function PhysicsWorkflowUX:Clear()
	if not (self.folder and self.folder.Parent) then
		return
	end
	self.folder:ClearAllChildren()
end

function PhysicsWorkflowUX:ClearBlastGuide()
	if not (self.folder and self.folder.Parent) then
		return
	end
	for _, child in ipairs(self.folder:GetChildren()) do
		if BLAST_GUIDE_NAMES[child.Name] then
			child:Destroy()
		end
	end
end

function PhysicsWorkflowUX:SetBlastGuide(eventSource, blastGuide)
	self:ClearBlastGuide()
	if blastGuide and self.folder and self.folder.Parent then
		makeBlastGuide(self.folder, eventSource, blastGuide)
	end
end

function PhysicsWorkflowUX:Refresh(rig, descriptors, eventSource, blastGuide)
	self:Clear()
	if not (self.folder and self.folder.Parent) then
		return
	end
	local highlighted = {}
	if rig and rig.Parent then
		makeSelectionOutline(self.folder, "BoundRig", rig, Color3.fromRGB(72, 214, 255))
		highlighted[rig] = true
	end
	local highlightIndex = 0
	for _, descriptor in ipairs(descriptors or {}) do
		local instance = descriptor.instance
		if instance and instance.Parent then
			local adornee = findSelectionHighlightAdornee(instance)
			local color = instance:IsA("UnionOperation")
				and Color3.fromRGB(244, 88, 112)
				or Color3.fromRGB(255, 174, 58)
			if adornee and not highlighted[adornee] then
				highlightIndex += 1
				highlighted[adornee] = true
				makeSelectionOutline(self.folder, string.format("Target_%03d", highlightIndex), adornee, color)
			end
		end
	end
	if eventSource and eventSource.Parent then
		makeHighlight(self.folder, "EventPoint", eventSource, Color3.fromRGB(255, 159, 67))
	end
	if blastGuide then
		makeBlastGuide(self.folder, eventSource, blastGuide)
	end
end

function PhysicsWorkflowUX:Destroy()
	if self.folder then
		self.folder:Destroy()
		self.folder = nil
	end
end

return PhysicsWorkflowUX
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX37">
            <Properties>
              <string name="Name">QuickPhysicsCaptureSupport</string>
              <ProtectedString name="Source">local QuickPhysicsCaptureSupport = {}

local DEFAULT_CAPTURE_DURATION = 4
local MINIMUM_CAPTURE_DURATION = 0.45
local SETTLED_HOLD_DURATION = 0.4
local LINEAR_SETTLED_SPEED = 0.12
local ANGULAR_SETTLED_SPEED = 0.12

local function targetsAreSettled(runtimeTargets, linearThreshold, angularThreshold)
	local checked = 0
	local settled = true
	local seenRoots = {}
	for _, descriptor in ipairs(runtimeTargets or {}) do
		local part = descriptor and (descriptor.part or descriptor.instance)
		if part and part.Parent and part:IsA("BasePart") then
			local root = part.AssemblyRootPart or part
			if not seenRoots[root] then
				seenRoots[root] = true
				checked += 1
				if root.AssemblyLinearVelocity.Magnitude &gt; (linearThreshold or LINEAR_SETTLED_SPEED)
					or root.AssemblyAngularVelocity.Magnitude &gt; (angularThreshold or ANGULAR_SETTLED_SPEED) then
					settled = false
				end
			end
		end
	end
	return checked &gt; 0 and settled
end

local function isCaptureTarget(instance)
	return instance
		and instance.Parent
		and (instance:IsA("BasePart") or instance:IsA("Model") or instance:IsA("Folder"))
end

local function countSelectedTargets(selection)
	local count = 0
	local first = nil
	for _, instance in ipairs(selection or {}) do
		if isCaptureTarget(instance) then
			count += 1
			first = first or instance
		end
	end
	return count, first
end

local function getSubjectText(flow, selection)
	if flow.subjectName and flow.subjectName ~= "" then
		return flow.subjectName
	end
	local count, first = countSelectedTargets(selection)
	if count == 1 then
		return first.Name
	end
	if count &gt; 1 then
		return string.format("%d selected objects", count)
	end
	return "Select a Part or Model"
end

local function getRangeText(flow, releaseData, take, fps)
	local startFrame = releaseData and tonumber(releaseData.releaseFrame) or nil
	if startFrame and take and tonumber(take.duration) then
		local endFrame = startFrame + math.max(1, math.floor(take.duration * math.max(1, tonumber(fps) or 30) + 0.5))
		return string.format("Frames %d-%d", startFrame, endFrame)
	end
	if startFrame then
		return string.format("Frame %d until resting", startFrame)
	end
	if flow.effectMode == "Drop" then
		return take and string.format("%.2fs from playhead", math.max(0, tonumber(take.duration) or 0))
			or "Current playhead until resting"
	end
	return "Current playhead"
end

function QuickPhysicsCaptureSupport.NewState()
	return {
		visible = true,
		effectMode = "Release",
		phase = "Configure",
		subjectName = nil,
		activeCapture = false,
		autoPreview = false,
		settledDuration = 0,
		captureDuration = DEFAULT_CAPTURE_DURATION,
	}
end

function QuickPhysicsCaptureSupport.BuildContext(
	flow,
	selection,
	releaseData,
	take,
	fps,
	running,
	previewing,
	releaseCollisionsEnabled
)
	flow = flow or QuickPhysicsCaptureSupport.NewState()
	local phase = flow.phase or "Configure"
	return {
		visible = flow.visible ~= false,
		effectMode = flow.effectMode or "Release",
		phase = phase,
		subject = getSubjectText(flow, selection),
		range = getRangeText(flow, releaseData, take, fps),
		startingMotion = flow.effectMode == "Release" and "Inherit from animation" or "From current pose",
		endBehavior = "Until resting",
		collision = releaseCollisionsEnabled == false and "Off" or "On",
		running = running == true,
		previewing = previewing == true,
		takeReady = take ~= nil,
	}
end

function QuickPhysicsCaptureSupport.BeginCapture(flow, subjectName)
	flow.subjectName = subjectName
	flow.phase = "Capturing"
	flow.activeCapture = true
	flow.autoPreview = false
	flow.settledDuration = 0
	flow.captureDuration = math.max(1, tonumber(flow.captureDuration) or DEFAULT_CAPTURE_DURATION)
end

function QuickPhysicsCaptureSupport.CancelCapture(flow)
	flow.activeCapture = false
	flow.autoPreview = false
	flow.settledDuration = 0
	if flow.phase == "Capturing" or flow.phase == "Loading" or flow.phase == "Returning" then
		flow.phase = "Configure"
	end
end

function QuickPhysicsCaptureSupport.ShouldFinish(flow, recorder, runtimeTargets, deltaTime)
	if not (flow and flow.activeCapture and recorder) then
		return false
	end
	local elapsed = math.max(0, tonumber(recorder.elapsed) or 0)
	if elapsed &gt;= math.max(1, tonumber(flow.captureDuration) or DEFAULT_CAPTURE_DURATION) then
		return true, "duration"
	end
	if elapsed &lt; MINIMUM_CAPTURE_DURATION then
		flow.settledDuration = 0
		return false
	end

	local settled = targetsAreSettled(runtimeTargets)
	if not settled and #(runtimeTargets or {}) == 0 then
		flow.settledDuration = 0
		return false
	end
	if settled then
		flow.settledDuration += math.max(0, tonumber(deltaTime) or 0)
	else
		flow.settledDuration = 0
	end
	return flow.settledDuration &gt;= SETTLED_HOLD_DURATION, "settled"
end

function QuickPhysicsCaptureSupport.TargetsAreSettled(runtimeTargets, linearThreshold, angularThreshold)
	return targetsAreSettled(runtimeTargets, linearThreshold, angularThreshold)
end

return QuickPhysicsCaptureSupport
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX38">
            <Properties>
              <string name="Name">RagdollRuntime</string>
              <ProtectedString name="Source">local RagdollRuntime = {}

local PhysicsRigFilter = require(script.Parent:WaitForChild("PhysicsRigFilter"))

local GENERATED_PREFIX = "MegMoPhysicsCapture_"
local AIR_MOTION_DELAY = 0.04
local AIR_MOTION_REVERSE_AT = 0.34
local AIR_MOTION_END = 0.62
local AIR_MOTION_BLEND = 0.75

local function trySet(instance, property, value)
	local ok = pcall(function()
		instance[property] = value
	end)
	return ok
end

local function rememberProperty(session, instance, property)
	local ok, value = pcall(function()
		return instance[property]
	end)
	if ok then
		table.insert(session.properties, {
			instance = instance,
			property = property,
			value = value,
		})
	end
end

local function collectMotors(rig)
	local motors = {}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if PhysicsRigFilter.IsSkeletalMotor(descendant, rig) then
			table.insert(motors, descendant)
		end
	end
	return motors
end

local function cloneRigForStructuralRestore(rig)
	local tagged = {}
	local restoreById = {}
	local backupAttribute = "MegMoBreakApartBackupId"
	local instances = { rig }
	for _, descendant in ipairs(rig:GetDescendants()) do
		table.insert(instances, descendant)
	end

	for index, instance in ipairs(instances) do
		local id = tostring(index)
		local oldAttribute = instance:GetAttribute(backupAttribute)
		table.insert(tagged, {
			instance = instance,
			archivable = instance.Archivable,
			oldAttribute = oldAttribute,
		})
		restoreById[id] = {
			archivable = instance.Archivable,
			oldAttribute = oldAttribute,
		}
		instance.Archivable = true
		instance:SetAttribute(backupAttribute, id)
	end

	local ok, backup = pcall(function()
		return rig:Clone()
	end)
	for _, item in ipairs(tagged) do
		if item.instance then
			item.instance.Archivable = item.archivable
			item.instance:SetAttribute(backupAttribute, item.oldAttribute)
		end
	end

	if not ok or not (backup and backup:IsA("Model")) then
		if backup then
			backup:Destroy()
		end
		return nil
	end

	local backupInstances = { backup }
	for _, descendant in ipairs(backup:GetDescendants()) do
		table.insert(backupInstances, descendant)
	end
	for _, instance in ipairs(backupInstances) do
		local id = instance:GetAttribute(backupAttribute)
		local restore = id and restoreById[tostring(id)]
		if restore then
			instance.Archivable = restore.archivable
			instance:SetAttribute(backupAttribute, restore.oldAttribute)
		end
	end
	return backup
end

local function breakApartStructureIsComplete(session)
	local rig = session and session.rig
	if not (rig and rig.Parent) then
		return false
	end
	for _, item in ipairs(session.breakApartParts or {}) do
		if not (item.part and item.part:IsDescendantOf(rig)) then
			return false
		end
	end
	for _, motor in ipairs(session.motors or {}) do
		if not (motor and motor:IsDescendantOf(rig)) then
			return false
		end
	end
	if session.humanoid and not session.humanoid:IsDescendantOf(rig) then
		return false
	end
	return true
end

local function restoreBreakApartStructure(session)
	local rig = session and session.rig
	local backup = session and session.structuralBackup
	if not (rig and rig.Parent and backup and backup:IsA("Model")) then
		return false
	end

	local backupPrimaryPart = backup.PrimaryPart
	for _, child in ipairs(rig:GetChildren()) do
		child:Destroy()
	end
	for _, child in ipairs(backup:GetChildren()) do
		child.Parent = rig
	end
	if backupPrimaryPart and backupPrimaryPart:IsDescendantOf(rig) then
		rig.PrimaryPart = backupPrimaryPart
	end
	backup:Destroy()
	session.structuralBackup = nil
	if typeof(session.modelPivot) == "CFrame" then
		rig:PivotTo(session.modelPivot)
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	return true
end

local function isRootMotor(motor)
	return motor
		and motor.Part0
		and motor.Part1
		and (motor.Part0.Name == "HumanoidRootPart" or motor.Part1.Name == "HumanoidRootPart")
end

local function makeAttachment(parent, name, cframe, session)
	local attachment = Instance.new("Attachment")
	attachment.Name = GENERATED_PREFIX .. name
	attachment.CFrame = cframe
	attachment.Parent = parent
	table.insert(session.generated, attachment)
	return attachment
end

local function makeConstraint(motor, session)
	local attachment0 = makeAttachment(motor.Part0, motor.Name .. "_A0", motor.C0, session)
	local attachment1 = makeAttachment(motor.Part1, motor.Name .. "_A1", motor.C1, session)

	local socket = Instance.new("BallSocketConstraint")
	socket.Name = GENERATED_PREFIX .. motor.Name
	socket.Attachment0 = attachment0
	socket.Attachment1 = attachment1
	socket.LimitsEnabled = true
	socket.UpperAngle = string.find(string.lower(motor.Name), "neck", 1, true) and 45 or 80
	socket.TwistLimitsEnabled = true
	socket.TwistLowerAngle = -65
	socket.TwistUpperAngle = 65
	socket.Parent = motor.Part0
	table.insert(session.generated, socket)

	local noCollision = Instance.new("NoCollisionConstraint")
	noCollision.Name = GENERATED_PREFIX .. motor.Name .. "_NoCollision"
	noCollision.Part0 = motor.Part0
	noCollision.Part1 = motor.Part1
	noCollision.Parent = motor.Part0
	table.insert(session.generated, noCollision)
end

function RagdollRuntime.Prepare(rig)
	if not (rig and rig:IsA("Model") and rig.Parent) then
		return nil, "The runtime rig is no longer available."
	end

	local motors = collectMotors(rig)
	if #motors == 0 then
		return nil, "The selected rig has no Motor6D joints to convert into a ragdoll."
	end

	local session = {
		rig = rig,
		generated = {},
		properties = {},
		motors = motors,
		rootMotors = {},
	}
	local involvedParts = {}

	for _, motor in ipairs(motors) do
		involvedParts[motor.Part0] = true
		involvedParts[motor.Part1] = true
		rememberProperty(session, motor, "Enabled")
		if isRootMotor(motor) then
			table.insert(session.rootMotors, motor)
			trySet(motor, "Enabled", true)
		else
			makeConstraint(motor, session)
			trySet(motor, "Enabled", false)
		end
	end

	for part in pairs(involvedParts) do
		rememberProperty(session, part, "Anchored")
		rememberProperty(session, part, "CanCollide")
		rememberProperty(session, part, "Massless")
		local isRootPart = part.Name == "HumanoidRootPart"
		part.Anchored = false
		part.CanCollide = not isRootPart
		part.Massless = isRootPart
	end

	-- Accessories must keep their original welds instead of becoming ragdoll
	-- joints. Make their parts passive for the simulation so a collidable or
	-- anchored handle cannot pull away from (or pin) the character body.
	for _, descendant in ipairs(rig:GetDescendants()) do
		if PhysicsRigFilter.IsAccessoryPart(descendant, rig) then
			rememberProperty(session, descendant, "Anchored")
			rememberProperty(session, descendant, "CanCollide")
			rememberProperty(session, descendant, "Massless")
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
		end
	end

	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		session.humanoid = humanoid
		rememberProperty(session, humanoid, "PlatformStand")
		rememberProperty(session, humanoid, "AutoRotate")
		rememberProperty(session, humanoid, "RequiresNeck")
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		humanoid.RequiresNeck = false
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	return session, nil
end

-- Push explosions should move a character as one solid body, not detach its
-- joints or let the Humanoid immediately fight the applied impulse. This
-- temporary profile keeps every Motor6D intact while giving the body reliable
-- collision and putting the Humanoid into a passive physics state. Restore()
-- returns every changed property when the test/capture ends.
function RagdollRuntime.PrepareRigidPush(rig)
	if not (rig and rig:IsA("Model") and rig.Parent) then
		return nil, "The runtime rig is no longer available."
	end

	local motors = collectMotors(rig)
	if #motors == 0 then
		return nil, "The selected rig has no Motor6D joints to move as a character."
	end

	local session = {
		rig = rig,
		generated = {},
		properties = {},
		motors = motors,
		rootMotors = {},
		rigidPush = true,
	}
	local involvedParts = {}
	for _, motor in ipairs(motors) do
		if motor.Part0 then
			involvedParts[motor.Part0] = true
		end
		if motor.Part1 then
			involvedParts[motor.Part1] = true
		end
	end

	for part in pairs(involvedParts) do
		rememberProperty(session, part, "Anchored")
		rememberProperty(session, part, "CanCollide")
		rememberProperty(session, part, "Massless")
		local isRootPart = part.Name == "HumanoidRootPart"
		part.Anchored = false
		part.CanCollide = not isRootPart
		part.Massless = isRootPart
	end

	for _, descendant in ipairs(rig:GetDescendants()) do
		if PhysicsRigFilter.IsAccessoryPart(descendant, rig) then
			rememberProperty(session, descendant, "Anchored")
			rememberProperty(session, descendant, "CanCollide")
			rememberProperty(session, descendant, "Massless")
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
		end
	end

	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		session.humanoid = humanoid
		rememberProperty(session, humanoid, "PlatformStand")
		rememberProperty(session, humanoid, "AutoRotate")
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	return session, nil
end

function RagdollRuntime.PrepareBreakApart(rig)
	if not (rig and rig:IsA("Model") and rig.Parent) then
		return nil, "The runtime rig is no longer available."
	end

	local motors = collectMotors(rig)
	if #motors == 0 then
		return nil, "The selected rig has no Motor6D joints to separate."
	end
	local structuralBackup = cloneRigForStructuralRestore(rig)
	if not structuralBackup then
		return nil, "7kg2 could not create the safety backup required for Break Apart."
	end

	local session = {
		rig = rig,
		generated = {},
		properties = {},
		motors = motors,
		rootMotors = {},
		modelPivot = rig:GetPivot(),
		breakApartParts = {},
		structuralBackup = structuralBackup,
	}

	-- Protect the Humanoid before disabling the Neck Motor6D. This keeps a
	-- break-apart preview from killing or respawning the character.
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		session.humanoid = humanoid
		rememberProperty(session, humanoid, "PlatformStand")
		rememberProperty(session, humanoid, "AutoRotate")
		rememberProperty(session, humanoid, "RequiresNeck")
		rememberProperty(session, humanoid, "BreakJointsOnDeath")
		rememberProperty(session, humanoid, "Health")
		rememberProperty(session, humanoid, "HealthDisplayType")
		trySet(humanoid, "PlatformStand", true)
		trySet(humanoid, "AutoRotate", false)
		trySet(humanoid, "RequiresNeck", false)
		trySet(humanoid, "BreakJointsOnDeath", false)
		trySet(humanoid, "Health", math.max(humanoid.Health, 1))
		trySet(humanoid, "HealthDisplayType", Enum.HumanoidHealthDisplayType.AlwaysOff)
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	local involvedParts = {}
	for _, motor in ipairs(motors) do
		involvedParts[motor.Part0] = true
		involvedParts[motor.Part1] = true
	end
	-- Break Apart temporarily turns one character assembly into many independent
	-- assemblies. Keep an exact transform snapshot of the skeletal pieces so
	-- Restore() can put them back before the Motor6Ds are enabled again. Accessory
	-- handles remain welded to those pieces and therefore do not need to be moved
	-- independently during this early restore pass.
	for part in pairs(involvedParts) do
		table.insert(session.breakApartParts, {
			part = part,
			cframe = part.CFrame,
			anchored = part.Anchored,
		})
	end
	for _, motor in ipairs(motors) do
		rememberProperty(session, motor, "Enabled")
		trySet(motor, "Enabled", false)
	end

	-- Some imported rigs retain body-to-body physics constraints in addition to
	-- their Motor6Ds. Leaving those enabled turns Break Apart back into a
	-- ragdoll, so temporarily disable only constraints joining skeletal parts.
	-- Accessory constraints remain untouched and every changed value is restored
	-- with the rest of the preview session.
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Constraint")
			and not PhysicsRigFilter.IsInsideAccessory(descendant, rig) then
			local attachment0 = descendant.Attachment0
			local attachment1 = descendant.Attachment1
			local part0 = attachment0 and attachment0:FindFirstAncestorWhichIsA("BasePart")
			local part1 = attachment1 and attachment1:FindFirstAncestorWhichIsA("BasePart")
			if involvedParts[part0] and involvedParts[part1] then
				rememberProperty(session, descendant, "Enabled")
				trySet(descendant, "Enabled", false)
			end
		end
	end

	for part in pairs(involvedParts) do
		rememberProperty(session, part, "Anchored")
		rememberProperty(session, part, "CanCollide")
		rememberProperty(session, part, "Massless")
		local isRootPart = part.Name == "HumanoidRootPart"
		part.Anchored = false
		part.CanCollide = not isRootPart
		part.Massless = isRootPart
	end

	-- Preserve accessory welds. The accessory stays attached to whichever body
	-- part owns it while the skeletal Motor6Ds separate.
	for _, descendant in ipairs(rig:GetDescendants()) do
		if PhysicsRigFilter.IsAccessoryPart(descendant, rig) then
			rememberProperty(session, descendant, "Anchored")
			rememberProperty(session, descendant, "CanCollide")
			rememberProperty(session, descendant, "Massless")
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
		end
	end

	return session, nil
end

local function applyAirMotion(session, strength, direction)
	local rig = session and session.rig
	if not (rig and rig.Parent) then
		return false
	end

	local pivot = rig:GetPivot()
	local right = pivot.RightVector
	local up = pivot.UpVector
	local look = pivot.LookVector
	local scale = math.clamp(tonumber(strength) or 1, 0, 2)
	local changed = 0
	local seenAssemblies = {}

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") and not descendant.Anchored then
			local lowerName = string.lower(descendant.Name)
			local isArm = string.find(lowerName, "arm", 1, true) ~= nil
				or string.find(lowerName, "hand", 1, true) ~= nil
			local isLeg = string.find(lowerName, "leg", 1, true) ~= nil
				or string.find(lowerName, "foot", 1, true) ~= nil
			if isArm or isLeg then
				local assembly = descendant.AssemblyRootPart or descendant
				if not seenAssemblies[assembly] then
					seenAssemblies[assembly] = true
					local side = string.find(lowerName, "right", 1, true) and 1
						or string.find(lowerName, "left", 1, true) and -1
						or 1
					local distal = (string.find(lowerName, "lower", 1, true)
						or string.find(lowerName, "hand", 1, true)
						or string.find(lowerName, "foot", 1, true)) and 1.2 or 1
					local axis = isArm
						and (look * side + right * 0.35 - up * 0.15)
						or (right * side + look * 0.3 + up * 0.1)
					local speed = (isArm and 5.2 or 3.4) * distal * scale
					local ok = pcall(function()
						local targetVelocity = axis.Unit * speed * direction
						assembly.AssemblyAngularVelocity =
							assembly.AssemblyAngularVelocity:Lerp(targetVelocity, AIR_MOTION_BLEND)
					end)
					if ok then
						changed += 1
					end
				end
			end
		end
	end

	return changed &gt; 0
end

function RagdollRuntime.PrimeAirMotion(session, strength)
	local rig = session and session.rig
	if not (rig and rig.Parent) or session.airMotionQueued then
		return false
	end
	session.airMotionQueued = true
	session.airMotionStrength = math.clamp(tonumber(strength) or 1, 0, 2)
	return true
end

function RagdollRuntime.Step(session, deltaTime)
	if not (session and session.airMotionQueued) or session.airMotionApplied then
		return false
	end

	local stepTime = tonumber(deltaTime)
	if not stepTime or stepTime &lt;= 0 then
		stepTime = 1 / 60
	end
	session.airMotionElapsed = (session.airMotionElapsed or 0) + math.min(stepTime, 0.1)
	if session.airMotionElapsed &lt; AIR_MOTION_DELAY then
		return false
	end

	local direction = session.airMotionElapsed &lt; AIR_MOTION_REVERSE_AT and 1 or -0.65
	local changed = applyAirMotion(session, session.airMotionStrength, direction)
	if session.airMotionElapsed &gt;= AIR_MOTION_END then
		session.airMotionApplied = true
	end
	return changed
end

function RagdollRuntime.ApplyImpulse(session, strength)
	local rig = session and session.rig
	if not (rig and rig.Parent) then
		return false
	end
	local root = rig:FindFirstChild("UpperTorso", true)
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("HumanoidRootPart", true)
	if not (root and root:IsA("BasePart")) then
		return false
	end
	local amount = tonumber(strength) or 42
	local pivot = rig:GetPivot()
	local direction = pivot.LookVector * amount
		+ pivot.UpVector * (amount * 0.24)
		+ pivot.RightVector * (amount * 0.08)
	local impactPoint = root.Position
		+ pivot.UpVector * (root.Size.Y * 0.42)
		+ pivot.RightVector * (root.Size.X * 0.2)
	root:ApplyImpulseAtPosition(direction * math.max(root.AssemblyMass, 1), impactPoint)
	pcall(function()
		root.AssemblyAngularVelocity += pivot.RightVector * 5.5 + pivot.LookVector * 1.4
	end)
	applyAirMotion(session, 1.35, -1)
	return true
end

function RagdollRuntime.ApplyDirectionalImpulse(session, contactPosition, originPosition, speed)
	local rig = session and session.rig
	if not (rig and rig.Parent) then
		return false, "The runtime ragdoll is no longer available."
	end
	if typeof(contactPosition) ~= "Vector3" or typeof(originPosition) ~= "Vector3" then
		return false, "Set the Knockback direction before starting the simulation."
	end
	local offset = contactPosition - originPosition
	if offset.Magnitude &lt; 0.05 then
		return false, "Move PUSH FROM away from CONTACT to set the Knockback direction."
	end
	local root = rig:FindFirstChild("UpperTorso", true)
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("HumanoidRootPart", true)
	if not (root and root:IsA("BasePart")) then
		return false, "The runtime ragdoll has no torso part to push."
	end
	local assemblyRoot = root.AssemblyRootPart or root
	if assemblyRoot.Anchored then
		return false, "The runtime ragdoll is still anchored."
	end
	local resolvedSpeed = math.clamp(tonumber(speed) or 12, 2, 1000)
	local direction = offset.Unit
	local mass = math.max(tonumber(assemblyRoot.AssemblyMass) or 0, 0.05)
	assemblyRoot:ApplyImpulseAtPosition(direction * mass * resolvedSpeed, contactPosition)
	pcall(function()
		local tumbleAxis = direction:Cross(Vector3.yAxis)
		if tumbleAxis.Magnitude &lt; 0.05 then
			tumbleAxis = rig:GetPivot().RightVector
		end
		assemblyRoot.AssemblyAngularVelocity += tumbleAxis.Unit * math.clamp(resolvedSpeed * 0.12, 2.5, 12)
	end)
	applyAirMotion(session, math.clamp(resolvedSpeed / 28, 0.8, 1.7), -1)
	return true, string.format("Knockback applied at %.1f studs/s.", resolvedSpeed)
end

function RagdollRuntime.ApplyExplosionImpulse(session, direction, speed, ragdollReaction)
	local rig = session and session.rig
	if not (rig and rig.Parent) then
		return false, "The runtime character is no longer available."
	end
	if typeof(direction) ~= "Vector3" or direction.Magnitude &lt; 0.001 then
		return false, "Move the Blast Origin away from the character to set its direction."
	end

	local root = rig:FindFirstChild("UpperTorso", true)
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("HumanoidRootPart", true)
	if not (root and root:IsA("BasePart")) then
		return false, "The runtime character has no torso part to push."
	end
	local assemblyRoot = root.AssemblyRootPart or root
	if assemblyRoot.Anchored then
		return false, "The runtime character is still anchored."
	end

	local resolvedSpeed = math.clamp(tonumber(speed) or 55, 2, 1000)
	local resolvedDirection = direction.Unit
	local mass = math.max(tonumber(assemblyRoot.AssemblyMass) or 0, 0.05)
	-- Apply at the assembly centre. Applying at the world-space blast origin
	-- creates excessive torque and was the reason Push rigs mostly jumped or
	-- buried themselves instead of travelling away from the explosion.
	assemblyRoot:ApplyImpulse(resolvedDirection * mass * resolvedSpeed)
	pcall(function()
		local tumbleAxis = resolvedDirection:Cross(Vector3.yAxis)
		if tumbleAxis.Magnitude &lt; 0.05 then
			tumbleAxis = rig:GetPivot().RightVector
		end
		local tumbleSpeed = ragdollReaction
			and math.clamp(resolvedSpeed * 0.055, 3.5, 14)
			or math.clamp(resolvedSpeed * 0.012, 0.8, 3.5)
		assemblyRoot.AssemblyAngularVelocity += tumbleAxis.Unit * tumbleSpeed
	end)
	if ragdollReaction then
		applyAirMotion(session, math.clamp(resolvedSpeed / 90, 0.9, 1.8), -1)
	end
	return true, string.format("Explosion impulse applied at %.1f studs/s.", resolvedSpeed)
end

function RagdollRuntime.ApplyVelocity(sessionOrRig, linearVelocity, angularVelocity)
	local rig = sessionOrRig and sessionOrRig.rig or sessionOrRig
	if not (rig and rig.Parent) then
		return false
	end
	linearVelocity = typeof(linearVelocity) == "Vector3" and linearVelocity or Vector3.zero
	angularVelocity = typeof(angularVelocity) == "Vector3" and angularVelocity or Vector3.zero
	local changed = 0
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") and not descendant.Anchored then
			local ok = pcall(function()
				descendant.AssemblyLinearVelocity = linearVelocity
				descendant.AssemblyAngularVelocity = angularVelocity
			end)
			if ok then
				changed += 1
			end
		end
	end
	return changed &gt; 0
end

function RagdollRuntime.Restore(session)
	if not session then
		return
	end
	if session.breakApartParts
		and not breakApartStructureIsComplete(session)
		and restoreBreakApartStructure(session) then
		return true
	end
	-- Restore detached Break Apart pieces while their skeletal joints are still
	-- disabled. Re-enabling the motors first makes subsequent CFrame assignments
	-- move the newly connected assembly and can leave stale/skewed model bounds.
	for _, item in ipairs(session.breakApartParts or {}) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	for _, item in ipairs(session.breakApartParts or {}) do
		local part = item.part
		if part and part.Parent and typeof(item.cframe) == "CFrame" then
			part.CFrame = item.cframe
		end
	end
	for index = #session.generated, 1, -1 do
		local instance = session.generated[index]
		if instance and instance.Parent then
			instance:Destroy()
		end
	end
	for index = #session.properties, 1, -1 do
		local item = session.properties[index]
		if item.instance and item.instance.Parent then
			trySet(item.instance, item.property, item.value)
		end
	end
	for _, item in ipairs(session.breakApartParts or {}) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = item.anchored == true
		end
	end
	if session.rig and session.rig.Parent and session.rig.PrimaryPart == nil
		and typeof(session.modelPivot) == "CFrame" then
		-- Models without a PrimaryPart retain an explicit WorldPivot. Synchronise it
		-- after the pieces are restored so Studio and 7kg2 draw the bounds at the
		-- original orientation and position.
		pcall(function()
			session.rig.WorldPivot = session.modelPivot
		end)
	end
	if session.humanoid and session.humanoid.Parent then
		pcall(function()
			session.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	if session.structuralBackup then
		session.structuralBackup:Destroy()
		session.structuralBackup = nil
	end
	return false
end

return RagdollRuntime
</ProtectedString>
            </Properties>
