          <Item class="ModuleScript" referent="RBX15">
            <Properties>
              <string name="Name">AnimatedPathRuntime</string>
              <ProtectedString name="Source">local AnimatedPathRuntime = {}

local function calculateAngularVelocity(previousCFrame, currentCFrame, deltaTime)
	local previousRotation = previousCFrame - previousCFrame.Position
	local currentRotation = currentCFrame - currentCFrame.Position
	local relative = previousRotation:ToObjectSpace(currentRotation)
	local axis, angle = relative:ToAxisAngle()
	if math.abs(angle) &lt;= 0.00001 or deltaTime &lt;= 0 then
		return Vector3.zero
	end
	return previousCFrame:VectorToWorldSpace(axis) * (angle / deltaTime)
end

local function findRootPart(rig)
	if rig:IsA("BasePart") then
		return rig
	end
	return rig:FindFirstChild("HumanoidRootPart", true)
		or rig.PrimaryPart
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("LowerTorso", true)
		or rig:FindFirstChildWhichIsA("BasePart", true)
end

local function findMotor(rig, definition)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D")
			and descendant.Name == definition.name
			and (not definition.part0 or (descendant.Part0 and descendant.Part0.Name == definition.part0))
			and (not definition.part1 or (descendant.Part1 and descendant.Part1.Name == definition.part1)) then
			return descendant
		end
	end
	return nil
end

local function applySample(session, sampleIndex)
	local samples = session.pathData.samples
	local first = samples[math.clamp(sampleIndex, 1, #samples)]
	local second = samples[math.clamp(sampleIndex + 1, 1, #samples)]
	local framePosition = session.elapsed * session.pathData.fps
	local alpha = math.clamp(framePosition - math.floor(framePosition), 0, 1)

	local rootCFrame = first.rootCFrame:Lerp(second.rootCFrame, alpha)
	session.root.CFrame = rootCFrame
	for index, motor in ipairs(session.motors) do
		local firstValue = first.joints[index]
		local secondValue = second.joints[index] or firstValue
		if motor and motor.Parent and typeof(firstValue) == "CFrame" and typeof(secondValue) == "CFrame" then
			motor.C0 = firstValue:Lerp(secondValue, alpha)
		end
	end
end

function AnimatedPathRuntime.Start(rig, pathData)
	if not (rig and rig.Parent and type(pathData) == "table" and type(pathData.samples) == "table" and #pathData.samples &gt;= 2) then
		return nil, "The animated path data is incomplete. Reload it from 7kg2."
	end
	local root = findRootPart(rig)
	if not (root and root:IsA("BasePart")) then
		return nil, "The Moving Object does not have a usable root part."
	end

	local motors = {}
	for index, definition in ipairs(pathData.motors or {}) do
		motors[index] = findMotor(rig, definition) or false
	end
	local session = {
		rig = rig,
		root = root,
		rootWasAnchored = root.Anchored,
		motors = motors,
		pathData = pathData,
		elapsed = 0,
		finished = false,
	}
	root.Anchored = true
	applySample(session, 1)
	return session, nil
end

function AnimatedPathRuntime.Step(session, deltaTime)
	if not (session and not session.finished and session.root and session.root.Parent) then
		return false, "stopped"
	end
	session.elapsed = math.min(session.pathData.duration, session.elapsed + math.max(0, tonumber(deltaTime) or 0))
	local framePosition = session.elapsed * session.pathData.fps
	applySample(session, math.floor(framePosition) + 1)
	local linearVelocity, angularVelocity = AnimatedPathRuntime.GetVelocity(session)
	if session.elapsed &gt;= session.pathData.duration then
		return false, "complete", linearVelocity, angularVelocity
	end
	return true, nil, linearVelocity, angularVelocity
end

function AnimatedPathRuntime.GetVelocity(session)
	local pathData = session and session.pathData
	local samples = pathData and pathData.samples
	if not (samples and #samples &gt;= 2) then
		return Vector3.zero, Vector3.zero
	end
	local fps = math.max(1, tonumber(pathData.fps) or 30)
	local framePosition = math.max(0, tonumber(session.elapsed) or 0) * fps
	local firstIndex = math.clamp(math.floor(framePosition) + 1, 1, #samples - 1)
	local first = samples[firstIndex]
	local second = samples[firstIndex + 1]
	local deltaTime = 1 / fps
	local linearVelocity = (second.rootCFrame.Position - first.rootCFrame.Position) / deltaTime
	local angularVelocity = calculateAngularVelocity(first.rootCFrame, second.rootCFrame, deltaTime)
	return linearVelocity, angularVelocity
end

function AnimatedPathRuntime.Finish(session)
	if not session then
		return Vector3.zero, Vector3.zero
	end
	if session.pathData and session.pathData.samples then
		session.elapsed = session.pathData.duration
		applySample(session, #session.pathData.samples)
	end
	if session.root and session.root.Parent then
		session.root.Anchored = session.rootWasAnchored
	end
	session.finished = true
	return session.pathData.linearVelocity or Vector3.zero, session.pathData.angularVelocity or Vector3.zero
end

function AnimatedPathRuntime.HoldAtEnd(session)
	if not session then
		return
	end
	if session.pathData and session.pathData.samples then
		session.elapsed = session.pathData.duration
		applySample(session, #session.pathData.samples)
	end
	if session.root and session.root.Parent then
		session.root.Anchored = true
		session.root.AssemblyLinearVelocity = Vector3.zero
		session.root.AssemblyAngularVelocity = Vector3.zero
	end
	session.finished = true
end

function AnimatedPathRuntime.Cancel(session)
	if not session then
		return
	end
	if session.root and session.root.Parent then
		session.root.AssemblyLinearVelocity = Vector3.zero
		session.root.AssemblyAngularVelocity = Vector3.zero
		session.root.Anchored = session.rootWasAnchored
	end
	session.finished = true
end

return AnimatedPathRuntime
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX16">
            <Properties>
              <string name="Name">BreakApartSupportRuntime</string>
              <ProtectedString name="Source">local BreakApartSupportRuntime = {}

local SUPPORT_RAY_START_OFFSET = 0.12
local SUPPORT_RAY_DEPTH = 0.52
local PROBE_SPREAD = 0.65

local function isValidPart(part)
	return part and part.Parent and part:IsA("BasePart")
end

local function worldVerticalHalfExtent(part)
	local halfSize = part.Size * 0.5
	local cframe = part.CFrame
	return math.abs(cframe.RightVector.Y) * halfSize.X
		+ math.abs(cframe.UpVector.Y) * halfSize.Y
		+ math.abs(cframe.LookVector.Y) * halfSize.Z
end

local function horizontalOffset(vector, scale)
	return Vector3.new(vector.X, 0, vector.Z) * scale
end

local function getProbeOffsets(part)
	local cframe = part.CFrame
	local right = horizontalOffset(cframe.RightVector, part.Size.X * 0.5 * PROBE_SPREAD)
	local look = horizontalOffset(cframe.LookVector, part.Size.Z * 0.5 * PROBE_SPREAD)
	return {
		Vector3.zero,
		right,
		-right,
		look,
		-look,
	}
end

local function addJointDependencies(part, candidates, directlyReleased, dependencies)
	local externallySupported = false
	local connectedParts = {}
	pcall(function()
		connectedParts = part:GetConnectedParts(true)
	end)
	for _, connectedPart in ipairs(connectedParts) do
		if connectedPart ~= part and isValidPart(connectedPart) and not directlyReleased[connectedPart] then
			if candidates[connectedPart] then
				dependencies[connectedPart] = true
			else
				externallySupported = true
			end
		end
	end
	return externallySupported
end

function BreakApartSupportRuntime.ReleaseUnsupported(selectedParts, directlyReleasedParts, shouldInclude)
	local directlyReleased = {}
	for _, part in ipairs(directlyReleasedParts or {}) do
		if isValidPart(part) then
			directlyReleased[part] = true
		end
	end

	local candidates = {}
	local ignoredParts = {}
	for _, part in ipairs(selectedParts or {}) do
		if isValidPart(part) then
			local included = not directlyReleased[part]
				and (type(shouldInclude) ~= "function" or shouldInclude(part) == true)
			if included then
				candidates[part] = true
			else
				ignoredParts[#ignoredParts + 1] = part
			end
		end
	end
	if next(candidates) == nil then
		return 0
	end

	local dependencies = {}
	local supported = {}
	for part in pairs(candidates) do
		local partDependencies = {}
		dependencies[part] = partDependencies
		if addJointDependencies(part, candidates, directlyReleased, partDependencies) then
			supported[part] = true
		end

		local filter = table.clone(ignoredParts)
		filter[#filter + 1] = part
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = filter
		params.IgnoreWater = true
		params.RespectCanCollide = true

		local verticalHalfExtent = worldVerticalHalfExtent(part)
		local basePosition = part.Position - Vector3.yAxis * (verticalHalfExtent - SUPPORT_RAY_START_OFFSET)
		for _, offset in ipairs(getProbeOffsets(part)) do
			local result = workspace:Raycast(
				basePosition + offset,
				-Vector3.yAxis * SUPPORT_RAY_DEPTH,
				params
			)
			local supportPart = result and result.Instance
			if isValidPart(supportPart) then
				if candidates[supportPart] then
					partDependencies[supportPart] = true
				else
					supported[part] = true
				end
			end
		end
	end

	local changed = true
	while changed do
		changed = false
		for part, partDependencies in pairs(dependencies) do
			if not supported[part] then
				for supportPart in pairs(partDependencies) do
					if supported[supportPart] then
						supported[part] = true
						changed = true
						break
					end
				end
			end
		end
	end

	local releasedCount = 0
	for part in pairs(candidates) do
		if not supported[part] and isValidPart(part) then
			part.Anchored = false
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
			pcall(function()
				part:SetNetworkOwner(nil)
			end)
			releasedCount += 1
		end
	end
	return releasedCount
end

return BreakApartSupportRuntime
</ProtectedString>
