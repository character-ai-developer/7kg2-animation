			return runOption(options, "onToggleRigPartHighlight", "toggleRigPartHighlight")
		end
	elseif tabName == "Track" then
		if actionName == "Add Rig Track" then
			resumeMicroViewportOwnership()
			return MicroWidgetController._runBindRig(options)
		elseif actionName == "Camera" then
