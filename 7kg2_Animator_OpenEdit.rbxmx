local function createHeaderMenu(topActions, spec, xOffset, refs)
	local button = create("TextButton", {
		Name = spec.key .. "MenuButton",
		Parent = topActions,
		AutoButtonColor = true,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, xOffset, 0, 0),
		Size = UDim2.new(0, spec.buttonWidth, 1, 0),
		Text = spec.key,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 90,
	})
	createCorner(button, 6)

	local optionHeight = 26
	local visibleOptions = math.min(#spec.options, 7)
	local menu = create("ScrollingFrame", {
		Name = spec.key .. "Menu",
		Parent = topActions,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, xOffset, 0, 25),
		ScrollBarThickness = #spec.options &gt; visibleOptions and 4 or 0,
		Size = UDim2.new(0, spec.menuWidth, 0, visibleOptions * optionHeight + 8),
		Visible = false,
		ZIndex = 100,
	})
	createCorner(menu, 9)
	createStroke(menu)
	create("UIListLayout", {
		Parent = menu,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = menu,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	refs._topMenuButtons[spec.key] = button
	refs._topMenuFrames[spec.key] = menu
	refs._topMenuOptionButtons[spec.key] = {}

	for index, option in ipairs(spec.options) do
		local optionButton = create("TextButton", {
			Name = option.id .. "MenuOption",
			Parent = menu,
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, optionHeight - 2),
			Text = option.text,
			TextColor3 = Constants.THEME.Text,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 101,
		})
		createCorner(optionButton, 7)
		create("UIPadding", {
			Parent = optionButton,
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		})
		refs._topMenuOptionButtons[spec.key][option.id] = optionButton
	end

	return xOffset + spec.buttonWidth + 12
end

function HeaderUI.mount(parent, context)
	if not parent then
		error("HeaderUI.mount requires parent")
	end

	local refs = {
		_topMenuButtons = {},
		_topMenuFrames = {},
		_topMenuOptionButtons = {},
	}

	local modeTabs = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.new(0, 638, 0, 30),
	})
	local modeLayout = create("UIListLayout", {
		Parent = modeTabs,
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local activeTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 94, 1, 0),
		Text = "ANIMATE",
	})
	styleModeTab(activeTab, true)

	local layoutTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 86, 1, 0),
		Text = "LAYOUT",
	})
	styleModeTab(layoutTab, false)

	local scriptTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 92, 1, 0),
		Text = "CUTSCENE",
	})
	styleModeTab(scriptTab, false)

	local presetsTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 84, 1, 0),
		Text = "PRESETS",
	})
	styleModeTab(presetsTab, false)

	local effectsTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 82, 1, 0),
		Text = "EFFECTS",
	})
	styleModeTab(effectsTab, false)

	local physicsTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 86, 1, 0),
		Text = "PHYSICS",
	})
	styleModeTab(physicsTab, false)
	physicsTab.Activated:Connect(function()
		require(script.Parent:WaitForChild("PhysicsLauncherPopupSupport")).open(
			(context and context.root) or parent,
			{
				compact = false,
				movable = true,
				plugin = context and context.plugin,
			}
		)
	end)

	local facesTab = create("TextButton", {
		Parent = modeTabs,
		Size = UDim2.new(0, 76, 1, 0),
		Text = "FACES",
	})
	styleModeTab(facesTab, false)

	local topActions = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 60),
		Size = UDim2.new(1, -32, 0, 22),
		ZIndex = 89,
	})

	local xOffset = 0
	for _, spec in ipairs(MENU_SPECS) do
		xOffset = createHeaderMenu(topActions, spec, xOffset, refs)
	end

	refs._animateTab = activeTab
	refs._layoutTab = layoutTab
	refs._scriptTab = scriptTab
	refs._presetsTab = presetsTab
	refs._effectsTab = effectsTab
	refs._physicsTab = physicsTab
	refs._facesTab = facesTab
	refs._modeTabs = modeTabs
	refs._modeLayout = modeLayout
	refs._topActions = topActions

	local closePluginButton = create("TextButton", {
		Name = "ClosePluginButton",
		Parent = parent,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 12),
		Size = UDim2.new(0, 34, 0, 28),
		Text = "X",
		ZIndex = 91,
	})
	styleGhostButton(closePluginButton)
	closePluginButton.TextSize = 12
	createCorner(closePluginButton, 9)
	refs._closePluginButton = closePluginButton

	local autoSaveIndicator = create("Frame", {
		Name = "AutoSaveIndicator",
		Parent = parent,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -212, 0, 58),
		Size = UDim2.new(0, 168, 0, 22),
		ZIndex = 91,
	})
	local autoSaveDot = create("Frame", {
		Name = "AutoSaveDot",
		Parent = autoSaveIndicator,
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Constants.THEME.Success,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 7, 0, 7),
		ZIndex = 92,
	})
	createCorner(autoSaveDot, 8)
	local autoSaveLabel = create("TextLabel", {
		Name = "AutoSaveLabel",
		Parent = autoSaveIndicator,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 13, 0, 0),
		Size = UDim2.new(1, -13, 1, 0),
		Text = "Auto Save - Ready",
		TextColor3 = Constants.THEME.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 92,
	})
	refs._autoSaveIndicator = autoSaveIndicator
	refs._autoSaveDot = autoSaveDot
	refs._autoSaveLabel = autoSaveLabel

	return refs
end

function HeaderUI.update(_context)
end

function HeaderUI.destroy()
end

return HeaderUI
