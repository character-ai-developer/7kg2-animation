<roblox version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Model" referent="RBX0">
    <Properties>
      <string name="Name">7kg2 Animator</string>
    </Properties>
    <Item class="Folder" referent="RBX1">
      <Properties>
        <string name="Name">Features</string>
      </Properties>
      <Item class="Folder" referent="RBX2">
        <Properties>
          <string name="Name">Faces</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX3">
          <Properties>
            <string name="Name">FacePresetStore</string>
            <ProtectedString name="Source">local HttpService = game:GetService("HttpService")
local Selection = game:GetService("Selection")
local ServerStorage = game:GetService("ServerStorage")

local FacePresetStore = {}
FacePresetStore.__index = FacePresetStore

local SETTING_KEY = "MegMoAnimatorFacePresetsV1"
local RECOVERY_SETTING_KEY = "MegMoAnimatorFacePresetsRecoveryV1"
local INITIALIZED_SETTING_KEY = "MegMoAnimatorFacePresetsInitializedV1"
local CURRENT_PAYLOAD_VERSION = 4
local SETTING_IO_ATTEMPTS = 5
local SETTING_RETRY_DELAY_SECONDS = 0.12
local BACKUP_FOLDER_NAME = "MegMoFacePresetBackups"
local BACKUP_KIND = "MegMoFacePresetBackup"
local BACKUP_VERSION = 1
local AUTOSAVE_BACKUP_NAME = "FacePresets_Autosave"
local LAYER_ORDER = {
	"LeftEyebrow",
	"RightEyebrow",
	"BothEyes",
	"LeftEye",
	"RightEye",
	"Mouth",
}
local LAYER_TRANSFORM_KEYS = { "X", "Y", "Scale" }
local LAYER_OFFSET_LIMIT = 0.35
local LAYER_SCALE_MIN = 0.35
local LAYER_SCALE_MAX = 1.75
local TRANSFORM_EPSILON = 0.001

local function trim(value)
	return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function cloneTable(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = cloneTable(child)
	end
	return result
end

local function sequenceValues(value)
	if type(value) ~= "table" then
		return {}
	end

	local indexed = {}
	for key, child in pairs(value) do
		local index = tonumber(key)
		if index and index &gt;= 1 and index % 1 == 0 then
			table.insert(indexed, {
				index = index,
				value = child,
			})
		end
	end
	table.sort(indexed, function(a, b)
		return a.index &lt; b.index
	end)

	local result = {}
	for _, entry in ipairs(indexed) do
		table.insert(result, entry.value)
	end
	return result
end

local function readSettingWithRetry(pluginObject, key)
	local lastError = nil
	for attempt = 1, SETTING_IO_ATTEMPTS do
		local ok, value = pcall(function()
			return pluginObject:GetSetting(key)
		end)
		if ok and value ~= nil then
			return value, nil
		end
		if not ok then
			lastError = tostring(value)
		end
		if attempt &lt; SETTING_IO_ATTEMPTS then
			task.wait(SETTING_RETRY_DELAY_SECONDS * attempt)
		end
	end
	return nil, lastError or "Roblox returned no saved value."
end

local function readSettingOnce(pluginObject, key)
	local ok, value = pcall(function()
		return pluginObject:GetSetting(key)
	end)
	if ok then
		return value
	end
	return nil
end

local function writeInitializedMarker(pluginObject)
	for attempt = 1, SETTING_IO_ATTEMPTS do
		local wrote = pcall(function()
			pluginObject:SetSetting(INITIALIZED_SETTING_KEY, true)
		end)
		if wrote then
			task.wait(SETTING_RETRY_DELAY_SECONDS * attempt)
			local readOk, value = pcall(function()
				return pluginObject:GetSetting(INITIALIZED_SETTING_KEY)
			end)
			if readOk and value == true then
				return true
			end
		end
		if attempt &lt; SETTING_IO_ATTEMPTS then
			task.wait(SETTING_RETRY_DELAY_SECONDS * attempt)
		end
	end
	return false
end

local function writeSettingVerified(pluginObject, key, payload)
	local writeToken = tostring(payload.writeToken or "")
	local lastError = nil
	for attempt = 1, SETTING_IO_ATTEMPTS do
		local ok, err = pcall(function()
			pluginObject:SetSetting(key, payload)
		end)
		if not ok then
			lastError = tostring(err)
		else
			task.wait(SETTING_RETRY_DELAY_SECONDS * attempt)
			local readOk, savedValue = pcall(function()
				return pluginObject:GetSetting(key)
			end)
			if readOk
				and type(savedValue) == "table"
				and tostring(savedValue.writeToken or "") == writeToken
			then
				return true, nil
			end
			if not readOk then
				lastError = tostring(savedValue)
			else
				lastError = "Roblox did not confirm the saved value."
			end
		end
		if attempt &lt; SETTING_IO_ATTEMPTS then
			task.wait(SETTING_RETRY_DELAY_SECONDS * attempt)
		end
	end
	return false, lastError
end

local function payloadSavedAt(payload)
	return type(payload) == "table" and tonumber(payload.savedAt) or 0
end

local function payloadRevision(payload)
	return type(payload) == "table" and tonumber(payload.revision) or 0
end

local function payloadWriteToken(payload)
	return type(payload) == "table" and tostring(payload.writeToken or "") or ""
end

local function payloadNeedsProtection(payload)
	if type(payload) ~= "table" then
		return false
	end
	return tonumber(payload.version) ~= CURRENT_PAYLOAD_VERSION
		or payloadRevision(payload) &lt;= 0
		or type(payload.presets) ~= "table"
end

local function newestSavedPayload(primary, recovery)
	if type(primary) == "table" and type(recovery) == "table" then
		if payloadRevision(recovery) ~= payloadRevision(primary) then
			return payloadRevision(recovery) &gt; payloadRevision(primary) and recovery or primary
		end
		if payloadSavedAt(recovery) &gt; payloadSavedAt(primary) then
			return recovery
		end
		return primary
	end
	if type(primary) == "table" then
		return primary
	end
	if type(recovery) == "table" then
		return recovery
	end
	return nil
end

local function normalizeImageId(value)
	local text = trim(value)
	if text == "" then
		return nil
	end

	local digits = string.match(text, "^rbxassetid://(%d+)$") or string.match(text, "^(%d+)$")
	if digits then
		return "rbxassetid://" .. digits
	end

	local urlAssetId = string.match(text, "[%?&amp;]id=(%d+)")
		or string.match(text, "/asset/(%d+)")
		or string.match(text, "/library/(%d+)")
		or string.match(text, "/catalog/(%d+)")
	if urlAssetId then
		return "rbxassetid://" .. urlAssetId
	end

	-- Built-in Roblox assets such as rbxasset://textures/face.png are valid
	-- Content/Image URIs even though they are not numeric asset IDs.
	if string.match(text, "^rbxasset://[%w%p]+$") then
		return text
	end

	return nil
end

local function sanitizeLayerTable(rawLayers)
	local layers = {}
	local count = 0
	if type(rawLayers) ~= "table" then
		return layers, count
	end

	for _, layerName in ipairs(LAYER_ORDER) do
		local imageId = normalizeImageId(rawLayers[layerName])
		if imageId then
			layers[layerName] = imageId
			count += 1
		end
	end

	return layers, count
end

local function roundTransformValue(value)
	return math.floor((tonumber(value) or 0) * 1000 + 0.5) / 1000
end

local function sanitizeLayerTransforms(rawTransforms, layers)
	local transforms = {}
	local count = 0
	if type(rawTransforms) ~= "table" then
		return transforms, count
	end

	for _, layerName in ipairs(LAYER_ORDER) do
		if type(layers) ~= "table" or layers[layerName] ~= nil then
			local rawTransform = rawTransforms[layerName]
			if type(rawTransform) == "table" then
				local x = math.clamp(tonumber(rawTransform.X or rawTransform.x or rawTransform.OffsetX or rawTransform.offsetX) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
				local y = math.clamp(tonumber(rawTransform.Y or rawTransform.y or rawTransform.OffsetY or rawTransform.offsetY) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
				local scale = math.clamp(tonumber(rawTransform.Scale or rawTransform.scale) or 1, LAYER_SCALE_MIN, LAYER_SCALE_MAX)
				x = roundTransformValue(x)
				y = roundTransformValue(y)
				scale = roundTransformValue(scale)
				if math.abs(x) &gt; TRANSFORM_EPSILON or math.abs(y) &gt; TRANSFORM_EPSILON or math.abs(scale - 1) &gt; TRANSFORM_EPSILON then
					transforms[layerName] = {
						X = x,
						Y = y,
						Scale = scale,
					}
					count += 1
				end
			end
		end
	end

	return transforms, count
end

local function sanitizePreset(rawPreset)
	if type(rawPreset) ~= "table" then
		return nil, "Preset data was not valid."
	end

	local name = trim(rawPreset.Name or rawPreset.name)
	if name == "" then
		return nil, "Preset names cannot be empty."
	end

	local presetType = tostring(rawPreset.Type or rawPreset.type or "Single")
	local id = trim(rawPreset.Id or rawPreset.id)
	if id == "" then
		id = HttpService:GenerateGUID(false)
	end

	local folderId = trim(rawPreset.FolderId or rawPreset.folderId)
	if folderId == "" or folderId == "All" or folderId == "Unsorted" then
		folderId = nil
	end

	if presetType == "Layered" then
		local layers, layerCount = sanitizeLayerTable(rawPreset.Layers or rawPreset.layers)
		if layerCount == 0 then
			return nil, "Layered presets need at least one valid image ID."
		end
		local transforms, transformCount = sanitizeLayerTransforms(rawPreset.LayerTransforms or rawPreset.layerTransforms or rawPreset.Transforms or rawPreset.transforms, layers)
		local preset = {
			Id = id,
			Name = name,
			Type = "Layered",
			Layers = layers,
			FolderId = folderId,
		}
		if transformCount &gt; 0 then
			preset.LayerTransforms = transforms
		end
		return preset
	end

	local imageId = normalizeImageId(rawPreset.ImageId or rawPreset.imageId)
	if not imageId then
		return nil, "Single face presets need a valid Roblox image ID."
	end

	return {
		Id = id,
		Name = name,
		Type = "Single",
		ImageId = imageId,
		FolderId = folderId,
	}
end

local function sanitizeFolder(rawFolder)
	if type(rawFolder) ~= "table" then
		return nil, "Folder data was not valid."
	end
	local name = trim(rawFolder.Name or rawFolder.name)
	if name == "" then
		return nil, "Folder names cannot be empty."
	end
	local id = trim(rawFolder.Id or rawFolder.id)
	if id == "" or id == "All" or id == "Unsorted" then
		id = HttpService:GenerateGUID(false)
	end
	return {
		Id = id,
		Name = name,
	}
end

local function makeUniquePresetName(presets, baseName)
	local rootName = trim(baseName)
	if rootName == "" then
		rootName = "Face"
	end

	local taken = {}
	for _, preset in ipairs(presets or {}) do
		taken[string.lower(tostring(preset.Name or ""))] = true
	end

	local candidate = rootName .. " Copy"
	if not taken[string.lower(candidate)] then
		return candidate
	end

	local index = 2
	while true do
		candidate = string.format("%s Copy %d", rootName, index)
		if not taken[string.lower(candidate)] then
			return candidate
		end
		index += 1
	end
end

local function normalizeFolderId(folderId)
	local value = trim(folderId)
	if value == "" or value == "All" or value == "Unsorted" then
		return nil
	end
	return value
end

local function folderExists(folders, folderId)
	if not folderId then
		return true
	end
	for _, folder in ipairs(folders or {}) do
		if folder.Id == folderId then
			return true
		end
	end
	return false
end

local function folderNameForId(folders, folderId)
	if not folderId then
		return "Unsorted"
	end
	for _, folder in ipairs(folders or {}) do
		if folder.Id == folderId then
			return tostring(folder.Name or "Folder")
		end
	end
	return "Folder"
end

local function getOrCreateBackupFolder()
	local folder = ServerStorage:FindFirstChild(BACKUP_FOLDER_NAME)
	if folder and not folder:IsA("Folder") then
		local index = 1
		local newName = BACKUP_FOLDER_NAME .. "_Old"
		while ServerStorage:FindFirstChild(newName) do
			index += 1
			newName = BACKUP_FOLDER_NAME .. "_Old" .. tostring(index)
		end
		folder.Name = newName
		folder = nil
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = BACKUP_FOLDER_NAME
		folder.Parent = ServerStorage
	end
	return folder
end

local function makeBackupName()
	return "FacePresets_" .. os.date("!%Y%m%d_%H%M%S")
end

local function makeUniqueChildName(parent, baseName)
	local name = baseName
	local index = 2
	while parent:FindFirstChild(name) do
		name = baseName .. "_" .. tostring(index)
		index += 1
	end
	return name
end

local function isBackupInstance(instance)
	return instance
		and instance:IsA("StringValue")
		and (
			instance:GetAttribute("MegMoBackupKind") == BACKUP_KIND
			or instance.Name == "MegMoFacePresetBackup"
			or (instance.Parent and instance.Parent.Name == BACKUP_FOLDER_NAME)
		)
end

local function findLatestBackup()
	local folder = ServerStorage:FindFirstChild(BACKUP_FOLDER_NAME)
	if not folder then
		return nil
	end
	local latest = nil
	local latestTime = -math.huge
	for _, child in ipairs(folder:GetChildren()) do
		if isBackupInstance(child) then
			local exportedAt = tonumber(child:GetAttribute("MegMoExportedAtUnix")) or 0
			if exportedAt &gt;= latestTime then
				latest = child
				latestTime = exportedAt
			end
		end
	end
	return latest
end

local function writeAutosaveBackup(payload)
	local ok, encodedOrMessage = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if not ok then
		return false, tostring(encodedOrMessage)
	end

	local folder = getOrCreateBackupFolder()
	local backup = folder:FindFirstChild(AUTOSAVE_BACKUP_NAME)
	if backup and not backup:IsA("StringValue") then
		backup.Name = makeUniqueChildName(folder, AUTOSAVE_BACKUP_NAME .. "_Old")
		backup = nil
	end
	if not backup then
		backup = Instance.new("StringValue")
		backup.Name = AUTOSAVE_BACKUP_NAME
		backup.Parent = folder
	end

	local savedAt = tonumber(payload.savedAt) or os.time()
	backup.Value = encodedOrMessage
	backup:SetAttribute("MegMoBackupKind", BACKUP_KIND)
	backup:SetAttribute("MegMoBackupVersion", BACKUP_VERSION)
	backup:SetAttribute("MegMoExportedAtUnix", savedAt)
	backup:SetAttribute("PresetCount", type(payload.presets) == "table" and #payload.presets or 0)
	backup:SetAttribute("FolderCount", type(payload.folders) == "table" and #payload.folders or 0)
	return true, nil
end

local function makeAvailablePresetName(presets, baseName)
	local rootName = trim(baseName)
	if rootName == "" then
		rootName = "Face"
	end

	local taken = {}
	for _, preset in ipairs(presets or {}) do
		taken[string.lower(tostring(preset.Name or ""))] = true
	end
	if not taken[string.lower(rootName)] then
		return rootName
	end

	return makeUniquePresetName(presets, rootName)
end

local function findSelectedBackup()
	for _, instance in ipairs(Selection:Get()) do
		if isBackupInstance(instance) then
			return instance
		end
		if instance and instance:IsA("Folder") then
			for _, child in ipairs(instance:GetChildren()) do
				if isBackupInstance(child) then
					return child
				end
			end
		end
	end
	return nil
end

local function decodeBackup(instance)
	if not isBackupInstance(instance) then
		return nil, "Select a 7kg2 face preset backup first."
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(instance.Value)
	end)
	if not ok or type(decoded) ~= "table" then
		return nil, "That face preset backup could not be read."
	end
	local kind = tostring(decoded.kind or decoded.Kind or "")
	if kind ~= "" and kind ~= BACKUP_KIND then
		return nil, "That backup is not a 7kg2 face preset backup."
	end
	return decoded
end

local function samePresetContent(left, right)
	if not left or not right then
		return false
	end
	if tostring(left.Type or "Single") ~= tostring(right.Type or "Single") then
		return false
	end
	if tostring(left.ImageId or "") ~= tostring(right.ImageId or "") then
		return false
	end
	for _, layerName in ipairs(LAYER_ORDER) do
		local leftLayer = type(left.Layers) == "table" and left.Layers[layerName] or nil
		local rightLayer = type(right.Layers) == "table" and right.Layers[layerName] or nil
		if tostring(leftLayer or "") ~= tostring(rightLayer or "") then
			return false
		end
		local leftTransform = type(left.LayerTransforms) == "table" and left.LayerTransforms[layerName] or nil
		local rightTransform = type(right.LayerTransforms) == "table" and right.LayerTransforms[layerName] or nil
		for _, transformKey in ipairs(LAYER_TRANSFORM_KEYS) do
			local defaultValue = transformKey == "Scale" and 1 or 0
			local leftValue = type(leftTransform) == "table" and tonumber(leftTransform[transformKey]) or defaultValue
			local rightValue = type(rightTransform) == "table" and tonumber(rightTransform[transformKey]) or defaultValue
			if math.abs((leftValue or defaultValue) - (rightValue or defaultValue)) &gt; TRANSFORM_EPSILON then
				return false
			end
		end
	end
	return true
end

function FacePresetStore.normalizeImageId(value)
	return normalizeImageId(value)
end

function FacePresetStore:normalizePreset(rawPreset)
	return sanitizePreset(rawPreset)
end

function FacePresetStore.new(pluginObject)
	return setmetatable({
		_plugin = pluginObject,
		_presets = {},
		_folders = {},
		_loaded = false,
		_loadStatus = "not_loaded",
		_loadMessage = nil,
		_loadedWriteToken = "",
	}, FacePresetStore)
end

function FacePresetStore:_loadRaw()
	if not self._plugin then
		return nil, "unavailable", "Plugin settings are unavailable. Face presets were not replaced with an empty library."
	end

	local primary, primaryError = readSettingWithRetry(self._plugin, SETTING_KEY)
	local recovery, recoveryError = readSettingWithRetry(self._plugin, RECOVERY_SETTING_KEY)
	if type(primary) == "table" and type(recovery) == "table" then
		local copiesDiffer = payloadWriteToken(primary) ~= payloadWriteToken(recovery)
		local newest = newestSavedPayload(primary, recovery)
		if newest == recovery then
			return recovery, "recovery", "Loaded face presets from the verified recovery copy.",
				copiesDiffer or payloadNeedsProtection(recovery)
		end
		return primary, "primary", "Loaded saved face presets.",
			copiesDiffer or payloadNeedsProtection(primary)
	end
	if type(primary) == "table" then
		return primary, "primary", "Loaded saved face presets.", true
	end
	if type(recovery) == "table" then
		return recovery, "recovery", "Loaded face presets from the verified recovery copy.", true
	end

	local backup = findLatestBackup()
	if backup then
		local decoded = decodeBackup(backup)
		if type(decoded) == "table" and (type(decoded.presets) == "table" or type(decoded.Presets) == "table") then
			return decoded, "place_backup", "Recovered face presets from this place's automatic backup.", true
		end
	end

	local initialized = readSettingWithRetry(self._plugin, INITIALIZED_SETTING_KEY)
	if initialized == true then
		return nil, "unavailable", "Saved face presets could not be read. Nothing was overwritten; close other Studio windows and reopen Faces to retry."
	end
	return {}, "empty", tostring(primaryError or recoveryError or "No saved face preset library was found.")
end

function FacePresetStore:load()
	if self._loaded then
		return self:list()
	end

	local raw, loadStatus, loadMessage, needsProtection = self:_loadRaw()
	if type(raw) ~= "table" then
		self._loadStatus = loadStatus or "unavailable"
		self._loadMessage = loadMessage
		return {}, self._loadMessage, false
	end
	local rawPresets = raw
	local rawFolders = {}
	if type(raw.presets) == "table" or type(raw.Presets) == "table" then
		rawPresets = raw.presets or raw.Presets or {}
		rawFolders = raw.folders or raw.Folders or {}
	end
	local folders = {}
	local folderIds = {}
	for _, rawFolder in ipairs(sequenceValues(rawFolders)) do
		local folder = sanitizeFolder(rawFolder)
		if folder and not folderIds[folder.Id] then
			folderIds[folder.Id] = true
			table.insert(folders, folder)
		end
	end
	table.sort(folders, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)

	local presets = {}
	for _, rawPreset in ipairs(sequenceValues(rawPresets)) do
		local preset = sanitizePreset(rawPreset)
		if preset then
			if preset.FolderId and not folderIds[preset.FolderId] then
				preset.FolderId = nil
			end
			table.insert(presets, preset)
		end
	end

	table.sort(presets, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)

	self._presets = presets
	self._folders = folders
	self._loaded = true
	self._loadStatus = loadStatus or "loaded"
	self._loadMessage = loadMessage
	self._loadedWriteToken = payloadWriteToken(raw)
	if loadStatus == "place_backup" or needsProtection then
		local restored, restoreMessage = self:save()
		if restored then
			if loadStatus == "place_backup" then
				self._loadMessage = "Recovered face presets from this place's automatic backup and restored the global library."
			elseif loadStatus == "recovery" then
				self._loadMessage = "Loaded the recovery copy and repaired the global face preset library."
			else
				self._loadMessage = "Upgraded and protected the existing face preset library for this 7kg2 version."
			end
		elseif restoreMessage then
			self._loadMessage = loadMessage .. " " .. tostring(restoreMessage)
		end
	end
	return self:list(), self._loadMessage, true
end

function FacePresetStore:getLoadStatus()
	return self._loadStatus, self._loadMessage, self._loaded
end

function FacePresetStore:_canMutate()
	if not self._loaded then
		local _, loadMessage, loaded = self:load()
		if not loaded then
			return false, loadMessage or "Face preset storage is unavailable."
		end
	end
	if not self._plugin then
		return false, "Plugin settings are unavailable."
	end

	local primary = readSettingOnce(self._plugin, SETTING_KEY)
	local recovery = readSettingOnce(self._plugin, RECOVERY_SETTING_KEY)
	local currentToken = payloadWriteToken(newestSavedPayload(primary, recovery))
	if currentToken ~= "" and currentToken ~= self._loadedWriteToken then
		return false,
			"Face presets changed in another Studio window. Nothing was overwritten. Close other Studio windows and reopen 7kg2 before editing presets."
	end
	return true, nil
end

function FacePresetStore:save()
	if not self._plugin then
		return false, "Plugin settings are unavailable."
	end
	local savedPrimary = readSettingOnce(self._plugin, SETTING_KEY)
	local savedRecovery = readSettingOnce(self._plugin, RECOVERY_SETTING_KEY)
	local nextRevision = math.max(payloadRevision(savedPrimary), payloadRevision(savedRecovery)) + 1

	local payload = {
		version = CURRENT_PAYLOAD_VERSION,
		revision = nextRevision,
		savedAt = os.time(),
		writeToken = HttpService:GenerateGUID(false),
		folders = self:listFolders(),
		presets = self:list(),
	}
	local recoveryOk, recoveryError = writeSettingVerified(self._plugin, RECOVERY_SETTING_KEY, payload)
	local primaryOk, primaryError = writeSettingVerified(self._plugin, SETTING_KEY, payload)
	if not primaryOk and not recoveryOk then
		return false, "Could not verify the face preset save: "
			.. tostring(primaryError or recoveryError or "Roblox plugin settings were unavailable.")
	end
	self._loadedWriteToken = tostring(payload.writeToken or "")
	if not primaryOk then
		writeInitializedMarker(self._plugin)
		writeAutosaveBackup(payload)
		return true, "Face presets saved to the verified recovery copy."
	end
	if not recoveryOk then
		writeInitializedMarker(self._plugin)
		writeAutosaveBackup(payload)
		return true, "Face presets saved, but the recovery copy could not be verified."
	end
	writeInitializedMarker(self._plugin)
	local autosaveOk = writeAutosaveBackup(payload)
	if not autosaveOk then
		return true, "Face presets saved, but this place's automatic backup could not be updated."
	end
	return true, "Face presets saved and backed up in this place."
end

function FacePresetStore:listFolders()
	if not self._loaded then
		self:load()
	end

	local result = {}
	for _, folder in ipairs(self._folders) do
		table.insert(result, cloneTable(folder))
	end
	return result
end

function FacePresetStore:list()
	if not self._loaded then
		self:load()
	end

	local result = {}
	for _, preset in ipairs(self._presets) do
		table.insert(result, cloneTable(preset))
	end
	return result
end

function FacePresetStore:get(presetId)
	if not self._loaded then
		self:load()
	end

	for _, preset in ipairs(self._presets) do
		if preset.Id == presetId then
			return cloneTable(preset)
		end
	end
	return nil
end

function FacePresetStore:upsert(rawPreset)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	local preset, message = sanitizePreset(rawPreset)
	if not preset then
		return false, message, nil
	end

	local replaced = false
	for index, existing in ipairs(self._presets) do
		if existing.Id == preset.Id then
			if not preset.FolderId then
				preset.FolderId = existing.FolderId
			end
			self._presets[index] = preset
			replaced = true
			break
		end
	end
	if not replaced then
		table.insert(self._presets, preset)
	end

	table.sort(self._presets, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)

	local ok, saveMessage = self:save()
	if not ok then
		return false, saveMessage, nil
	end

	return true, replaced and "Updated face preset '" .. preset.Name .. "'." or "Saved face preset '" .. preset.Name .. "'.", cloneTable(preset)
end

function FacePresetStore:rename(presetId, newName)
	local preset = self:get(presetId)
	if not preset then
		return false, "That face preset could not be found."
	end
	preset.Name = newName
	return self:upsert(preset)
end

function FacePresetStore:delete(presetId)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage
	end

	for index, preset in ipairs(self._presets) do
		if preset.Id == presetId then
			table.remove(self._presets, index)
			local ok, message = self:save()
			if not ok then
				return false, message
			end
			return true, "Deleted face preset '" .. tostring(preset.Name or "Preset") .. "'."
		end
	end

	return false, "That face preset could not be found."
end

function FacePresetStore:duplicatePreset(presetId)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	for _, preset in ipairs(self._presets) do
		if preset.Id == presetId then
			local duplicate = cloneTable(preset)
			duplicate.Id = HttpService:GenerateGUID(false)
			duplicate.Name = makeUniquePresetName(self._presets, preset.Name)
			table.insert(self._presets, duplicate)
			table.sort(self._presets, function(a, b)
				return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
			end)

			local ok, message = self:save()
			if not ok then
				return false, message, nil
			end
			return true, "Duplicated face preset as '" .. duplicate.Name .. "'.", cloneTable(duplicate)
		end
	end

	return false, "That face preset could not be found.", nil
end

function FacePresetStore:movePresetToFolder(presetId, folderId)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	local targetFolderId = normalizeFolderId(folderId)
	if not folderExists(self._folders, targetFolderId) then
		return false, "That destination face folder could not be found.", nil
	end

	for _, preset in ipairs(self._presets) do
		if preset.Id == presetId then
			preset.FolderId = targetFolderId
			local ok, message = self:save()
			if not ok then
				return false, message, nil
			end
			return true, "Moved '" .. tostring(preset.Name or "Face") .. "' to " .. folderNameForId(self._folders, targetFolderId) .. ".", cloneTable(preset)
		end
	end

	return false, "That face preset could not be found.", nil
end

function FacePresetStore:copyPresetToFolder(presetId, folderId)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	local targetFolderId = normalizeFolderId(folderId)
	if not folderExists(self._folders, targetFolderId) then
		return false, "That destination face folder could not be found.", nil
	end

	for _, preset in ipairs(self._presets) do
		if preset.Id == presetId then
			local duplicate = cloneTable(preset)
			duplicate.Id = HttpService:GenerateGUID(false)
			duplicate.Name = makeUniquePresetName(self._presets, preset.Name)
			duplicate.FolderId = targetFolderId
			table.insert(self._presets, duplicate)
			table.sort(self._presets, function(a, b)
				return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
			end)

			local ok, message = self:save()
			if not ok then
				return false, message, nil
			end
			return true, "Copied '" .. tostring(preset.Name or "Face") .. "' to " .. folderNameForId(self._folders, targetFolderId) .. ".", cloneTable(duplicate)
		end
	end

	return false, "That face preset could not be found.", nil
end

function FacePresetStore:createFolder(name)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	local folder, message = sanitizeFolder({
		Name = name,
	})
	if not folder then
		return false, message, nil
	end

	for _, existing in ipairs(self._folders) do
		if string.lower(existing.Name) == string.lower(folder.Name) then
			return false, "A face folder with that name already exists.", nil
		end
	end

	table.insert(self._folders, folder)
	table.sort(self._folders, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)
	local ok, saveMessage = self:save()
	if not ok then
		return false, saveMessage, nil
	end
	return true, "Created face folder '" .. folder.Name .. "'.", cloneTable(folder)
end

function FacePresetStore:renameFolder(folderId, newName)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage
	end

	newName = trim(newName)
	if newName == "" then
		return false, "Folder names cannot be empty."
	end

	for _, existing in ipairs(self._folders) do
		if existing.Id ~= folderId and string.lower(existing.Name) == string.lower(newName) then
			return false, "A face folder with that name already exists."
		end
	end

	for _, folder in ipairs(self._folders) do
		if folder.Id == folderId then
			folder.Name = newName
			local ok, message = self:save()
			if not ok then
				return false, message
			end
			return true, "Renamed face folder to '" .. newName .. "'."
		end
	end

	return false, "Select a custom face folder before renaming."
end

function FacePresetStore:deleteFolder(folderId)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage
	end

	for index, folder in ipairs(self._folders) do
		if folder.Id == folderId then
			table.remove(self._folders, index)
			for _, preset in ipairs(self._presets) do
				if preset.FolderId == folderId then
					preset.FolderId = nil
				end
			end
			local ok, message = self:save()
			if not ok then
				return false, message
			end
			return true, "Deleted face folder '" .. folder.Name .. "'. Presets were moved to Unsorted."
		end
	end

	return false, "Select a custom face folder before deleting."
end

function FacePresetStore:exportBackup()
	if not self._loaded then
		self:load()
	end

	local folders = self:listFolders()
	local presets = self:list()
	if #folders == 0 and #presets == 0 then
		return false, "Create at least one face preset before exporting.", nil
	end

	local exportedAtUnix = os.time()
	local payload = {
		kind = BACKUP_KIND,
		version = BACKUP_VERSION,
		exportedAt = os.date("!%Y-%m-%dT%H:%M:%SZ", exportedAtUnix),
		folders = folders,
		presets = presets,
	}
	local ok, encodedOrMessage = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if not ok then
		return false, "Could not export face presets: " .. tostring(encodedOrMessage), nil
	end

	local folder = getOrCreateBackupFolder()
	local backup = Instance.new("StringValue")
	backup.Name = makeUniqueChildName(folder, makeBackupName())
	backup.Value = encodedOrMessage
	backup:SetAttribute("MegMoBackupKind", BACKUP_KIND)
	backup:SetAttribute("MegMoBackupVersion", BACKUP_VERSION)
	backup:SetAttribute("MegMoExportedAtUnix", exportedAtUnix)
	backup:SetAttribute("PresetCount", #presets)
	backup:SetAttribute("FolderCount", #folders)
	backup.Parent = folder
	pcall(function()
		Selection:Set({ backup })
	end)

	return true, string.format("Exported %d face preset%s to ServerStorage.%s.%s.", #presets, #presets == 1 and "" or "s", BACKUP_FOLDER_NAME, backup.Name), backup
end

function FacePresetStore:importBackup()
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	local backup = findSelectedBackup() or findLatestBackup()
	if not backup then
		return false, "Select a face preset backup in ServerStorage first, or export one from another device.", nil
	end

	local decoded, decodeMessage = decodeBackup(backup)
	if not decoded then
		return false, decodeMessage, nil
	end

	local rawFolders = type(decoded.folders) == "table" and decoded.folders or decoded.Folders
	local rawPresets = type(decoded.presets) == "table" and decoded.presets or decoded.Presets
	if type(rawPresets) ~= "table" then
		return false, "That face preset backup has no preset list.", nil
	end

	local folderByImportedId = {}
	local existingFolderNames = {}
	for _, folder in ipairs(self._folders) do
		existingFolderNames[string.lower(tostring(folder.Name or ""))] = folder.Id
	end

	local importedFolders = 0
	for _, rawFolder in ipairs(type(rawFolders) == "table" and rawFolders or {}) do
		local folder = sanitizeFolder(rawFolder)
		if folder then
			local existingId = existingFolderNames[string.lower(folder.Name)]
			if existingId then
				folderByImportedId[folder.Id] = existingId
			else
				local originalId = folder.Id
				folder.Id = HttpService:GenerateGUID(false)
				folderByImportedId[originalId] = folder.Id
				table.insert(self._folders, folder)
				existingFolderNames[string.lower(folder.Name)] = folder.Id
				importedFolders += 1
			end
		end
	end

	local importedPresets = 0
	local skippedPresets = 0
	for _, rawPreset in ipairs(rawPresets) do
		local preset = sanitizePreset(rawPreset)
		if preset then
			local duplicateContent = false
			for _, existing in ipairs(self._presets) do
				if tostring(existing.Name or "") == tostring(preset.Name or "") and samePresetContent(existing, preset) then
					duplicateContent = true
					break
				end
			end
			if duplicateContent then
				skippedPresets += 1
			else
				local importedFolderId = preset.FolderId
				preset.Id = HttpService:GenerateGUID(false)
				preset.FolderId = folderByImportedId[importedFolderId] or nil
				preset.Name = makeAvailablePresetName(self._presets, preset.Name)
				table.insert(self._presets, preset)
				importedPresets += 1
			end
		end
	end

	table.sort(self._folders, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)
	table.sort(self._presets, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)

	local ok, saveMessage = self:save()
	if not ok then
		return false, saveMessage, nil
	end

	return true, string.format(
		"Imported %d face preset%s from %s. %d duplicate%s skipped.",
		importedPresets,
		importedPresets == 1 and "" or "s",
		backup.Name,
		skippedPresets,
		skippedPresets == 1 and "" or "s"
	), {
		importedPresets = importedPresets,
		importedFolders = importedFolders,
		skippedPresets = skippedPresets,
		backup = backup,
	}
end

function FacePresetStore:importSelectionPresets(rawPresets, folderName, options)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	options = type(options) == "table" and options or {}
	local skipFolder = options.skipFolder == true
	local originalPresets = self:list()
	local originalFolders = self:listFolders()
	local requestedFolderName = trim(folderName)
	if not skipFolder and requestedFolderName == "" then
		requestedFolderName = "Imported Faces"
	end

	local destinationFolder = nil
	if not skipFolder then
		for _, folder in ipairs(self._folders) do
			if string.lower(tostring(folder.Name or "")) == string.lower(requestedFolderName) then
				destinationFolder = folder
				break
			end
		end
		if not destinationFolder then
			destinationFolder = sanitizeFolder({
				Name = requestedFolderName,
			})
		end
	end

	local folderAdded = false
	local importedPresets = 0
	local skippedPresets = 0
	local invalidPresets = 0
	for _, rawPreset in ipairs(sequenceValues(rawPresets)) do
		local preset = sanitizePreset(rawPreset)
		if not preset then
			invalidPresets += 1
		else
			local duplicateContent = false
			for _, existing in ipairs(self._presets) do
				if samePresetContent(existing, preset) then
					duplicateContent = true
					break
				end
			end
			if duplicateContent then
				skippedPresets += 1
			else
				if destinationFolder and not folderAdded and not folderExists(self._folders, destinationFolder.Id) then
					table.insert(self._folders, destinationFolder)
					folderAdded = true
				end
				preset.Id = HttpService:GenerateGUID(false)
				preset.FolderId = destinationFolder and destinationFolder.Id or nil
				preset.Name = makeAvailablePresetName(self._presets, preset.Name)
				table.insert(self._presets, preset)
				importedPresets += 1
			end
		end
	end

	if importedPresets == 0 then
		return true, string.format(
			"No new face presets were imported. %d existing image%s skipped.",
			skippedPresets,
			skippedPresets == 1 and "" or "s"
		), {
			importedPresets = 0,
			skippedPresets = skippedPresets,
			invalidPresets = invalidPresets,
			folderId = destinationFolder and destinationFolder.Id or nil,
			folderName = destinationFolder and destinationFolder.Name or (skipFolder and "All Faces" or requestedFolderName),
		}
	end

	table.sort(self._folders, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)
	table.sort(self._presets, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)

	local ok, saveMessage = self:save()
	if not ok then
		self._presets = originalPresets
		self._folders = originalFolders
		return false, saveMessage, nil
	end

	local destinationName = destinationFolder and destinationFolder.Name or "All Faces"
	return true, string.format(
		"Imported %d face preset%s into '%s'. %d existing image%s skipped.",
		importedPresets,
		importedPresets == 1 and "" or "s",
		tostring(destinationName),
		skippedPresets,
		skippedPresets == 1 and "" or "s"
	), {
		importedPresets = importedPresets,
		skippedPresets = skippedPresets,
		invalidPresets = invalidPresets,
		folderId = destinationFolder and destinationFolder.Id or nil,
		folderName = destinationName,
	}
end

function FacePresetStore:recoverPresets(rawPresets)
	if not self._loaded then
		self:load()
	end
	local canMutate, conflictMessage = self:_canMutate()
	if not canMutate then
		return false, conflictMessage, nil
	end

	local originalPresets = self:list()
	local recoveredPresets = 0
	local skippedPresets = 0
	local invalidPresets = 0
	for _, rawPreset in ipairs(sequenceValues(rawPresets)) do
		local preset = sanitizePreset(rawPreset)
		if not preset then
			invalidPresets += 1
		else
			local duplicateContent = false
			for _, existing in ipairs(self._presets) do
				if tostring(existing.Name or "") == tostring(preset.Name or "")
					and samePresetContent(existing, preset)
				then
					duplicateContent = true
					break
				end
			end
			if duplicateContent then
				skippedPresets += 1
			else
				preset.Id = HttpService:GenerateGUID(false)
				preset.FolderId = nil
				preset.Name = makeAvailablePresetName(self._presets, preset.Name)
				table.insert(self._presets, preset)
				recoveredPresets += 1
			end
		end
	end

	if recoveredPresets == 0 then
		return true, string.format(
			"No new presets were recovered. %d existing duplicate%s skipped.",
			skippedPresets,
			skippedPresets == 1 and "" or "s"
		), {
			recoveredPresets = 0,
			skippedPresets = skippedPresets,
			invalidPresets = invalidPresets,
		}
	end

	table.sort(self._presets, function(a, b)
		return tostring(a.Name or ""):lower() &lt; tostring(b.Name or ""):lower()
	end)

	local ok, saveMessage = self:save()
	if not ok then
		self._presets = originalPresets
		return false, saveMessage, nil
	end

	return true, string.format(
		"Recovered %d face preset%s from this project. %d duplicate%s skipped.",
		recoveredPresets,
		recoveredPresets == 1 and "" or "s",
		skippedPresets,
		skippedPresets == 1 and "" or "s"
	), {
		recoveredPresets = recoveredPresets,
		skippedPresets = skippedPresets,
		invalidPresets = invalidPresets,
	}
end

return FacePresetStore
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX4">
          <Properties>
            <string name="Name">FacePreviewRenderer</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("UiHelpers"))

local FacePreviewRenderer = {}

local create = UiHelpers.create
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke

local PREVIEW_BACKGROUND = Color3.fromRGB(95, 104, 120)
local PREVIEW_FACE_BASE = Color3.fromRGB(128, 137, 154)

local LAYER_RENDER_ORDER = {
	"BothEyes",
	"LeftEyebrow",
	"RightEyebrow",
	"LeftEye",
	"RightEye",
	"Mouth",
}
local LAYER_OFFSET_LIMIT = 0.35
local LAYER_SCALE_MIN = 0.35
local LAYER_SCALE_MAX = 1.75

local function clearChildren(parent)
	for _, child in ipairs(parent:GetChildren()) do
		child:Destroy()
	end
end

local function createPlaceholder(parent, text)
	create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Size = UDim2.fromScale(1, 1),
		Text = text or "No Preview",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextWrapped = true,
		ZIndex = (parent.ZIndex or 1) + 1,
	})
end

local function getLayerTransform(preset, layerName)
	local transforms = type(preset) == "table" and preset.LayerTransforms or nil
	local raw = type(transforms) == "table" and transforms[layerName] or nil
	if type(raw) ~= "table" then
		return 0, 0, 1
	end
	local x = math.clamp(tonumber(raw.X or raw.x) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
	local y = math.clamp(tonumber(raw.Y or raw.y) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
	local scale = math.clamp(tonumber(raw.Scale or raw.scale) or 1, LAYER_SCALE_MIN, LAYER_SCALE_MAX)
	return x, y, scale
end

function FacePreviewRenderer.render(parent, preset, options)
	if not parent then
		return
	end
	options = options or {}
	clearChildren(parent)

	parent.BackgroundColor3 = PREVIEW_BACKGROUND
	parent.BorderSizePixel = 0
	createCorner(parent, 10)
	createStroke(parent, Constants.THEME.Border, 1)

	if type(preset) ~= "table" then
		createPlaceholder(parent)
		return
	end

	if preset.Type == "Single" then
		if type(preset.ImageId) ~= "string" or preset.ImageId == "" then
			createPlaceholder(parent)
			return
		end

		create("ImageLabel", {
			Parent = parent,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = preset.ImageId,
			Position = UDim2.fromScale(0.5, 0.5),
			ScaleType = Enum.ScaleType.Fit,
			Size = options.large and UDim2.fromScale(0.9, 0.9) or UDim2.fromScale(0.78, 0.78),
			ZIndex = (parent.ZIndex or 1) + 1,
		})
		return
	end

	if preset.Type == "Layered" then
		local baseScale = options.large and 0.94 or 0.84
		local faceBase = create("Frame", {
			Parent = parent,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = PREVIEW_FACE_BASE,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(baseScale, baseScale),
			ZIndex = (parent.ZIndex or 1) + 1,
		})
		createCorner(faceBase, 18)

		local hasLayer = false
		for _, layerName in ipairs(LAYER_RENDER_ORDER) do
			local imageId = preset.Layers and preset.Layers[layerName]
			if type(imageId) == "string" and imageId ~= "" then
				hasLayer = true
				local offsetX, offsetY, layerScale = getLayerTransform(preset, layerName)
				create("ImageLabel", {
					Parent = faceBase,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundTransparency = 1,
					Image = imageId,
					Position = UDim2.fromScale(0.5 + offsetX, 0.5 + offsetY),
					ScaleType = Enum.ScaleType.Fit,
					Size = UDim2.fromScale(layerScale, layerScale),
					ZIndex = faceBase.ZIndex + 1,
				})
			end
		end

		if not hasLayer then
			createPlaceholder(parent)
		end
		return
	end

	createPlaceholder(parent)
end

return FacePreviewRenderer
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX5">
          <Properties>
            <string name="Name">FaceRigAdapter</string>
            <ProtectedString name="Source">local TweenService = game:GetService("TweenService")

local FaceRigAdapter = {}

local IMAGE_STRING_PROPERTIES = {
	Decal = "Texture",
	Texture = "Texture",
	ImageLabel = "Image",
	ImageButton = "Image",
}

local IMAGE_CONTENT_PROPERTIES = {
	Decal = { "ColorMapContent", "TextureContent" },
	Texture = { "ColorMapContent", "TextureContent" },
}

local TRANSPARENCY_PROPERTIES = {
	Decal = "Transparency",
	Texture = "Transparency",
	ImageLabel = "ImageTransparency",
	ImageButton = "ImageTransparency",
}

local LAYER_NAMES = {
	"BothEyes",
	"LeftEye",
	"RightEye",
	"Mouth",
	"LeftEyebrow",
	"RightEyebrow",
}

local GENERATED_LAYER_ATTRIBUTE = "MegMoGeneratedFaceLayer"
local GENERATED_STANDARD_ATTRIBUTE = "MegMoGeneratedStandardFace"
local GENERATED_LAYER_GUI_NAME = "MegMoLayeredFaceGui"
local GENERATED_LAYER_SHELL_ATTRIBUTE = "MegMoGeneratedFaceShell"
local GENERATED_LAYER_SHELL_PREFIX = "MegMoFaceShell_"
local GENERATED_LAYER_MOTOR_PREFIX = "MegMoFaceShellMotor_"
local FACE_SHELL_FRONT_OFFSET = 0.012
local FACE_SHELL_LAYER_DEPTH_STEP = 0.003
local LAYER_OFFSET_LIMIT = 0.35
local LAYER_SCALE_MIN = 0.35
local LAYER_SCALE_MAX = 1.75
local TRANSFORM_EPSILON = 0.001

local LAYER_INDEX_BY_NAME = {}
for index, layerName in ipairs(LAYER_NAMES) do
	LAYER_INDEX_BY_NAME[layerName] = index
end

local function normalizeLayerName(name)
	return string.lower(tostring(name or "")):gsub("[%s_%-%./]", "")
end

local function getLayerTransform(layerTransforms, layerName)
	local raw = type(layerTransforms) == "table" and layerTransforms[layerName] or nil
	if type(raw) ~= "table" then
		return 0, 0, 1
	end
	local x = math.clamp(tonumber(raw.X or raw.x) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
	local y = math.clamp(tonumber(raw.Y or raw.y) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
	local scale = math.clamp(tonumber(raw.Scale or raw.scale) or 1, LAYER_SCALE_MIN, LAYER_SCALE_MAX)
	return x, y, scale
end

local function hasLayerTransformOverrides(layerTransforms)
	if type(layerTransforms) ~= "table" then
		return false
	end
	for _, layerName in ipairs(LAYER_NAMES) do
		local x, y, scale = getLayerTransform(layerTransforms, layerName)
		if math.abs(x) &gt; TRANSFORM_EPSILON or math.abs(y) &gt; TRANSFORM_EPSILON or math.abs(scale - 1) &gt; TRANSFORM_EPSILON then
			return true
		end
	end
	return false
end

local function hasLayerTransformOverride(layerTransforms, layerName)
	local x, y, scale = getLayerTransform(layerTransforms, layerName)
	return math.abs(x) &gt; TRANSFORM_EPSILON
		or math.abs(y) &gt; TRANSFORM_EPSILON
		or math.abs(scale - 1) &gt; TRANSFORM_EPSILON
end

local function isSupportedImageInstance(instance)
	return instance and IMAGE_STRING_PROPERTIES[instance.ClassName] ~= nil
end

local function getStringImageProperty(instance)
	return instance and IMAGE_STRING_PROPERTIES[instance.ClassName] or nil
end

local function getTransparencyProperty(instance)
	return instance and TRANSPARENCY_PROPERTIES[instance.ClassName] or nil
end

local function getVisualTransparency(instance)
	local propertyName = getTransparencyProperty(instance)
	if not propertyName then
		return nil
	end
	local ok, value = pcall(function()
		return instance[propertyName]
	end)
	if ok then
		return value
	end
	return nil
end

local function setVisualTransparency(instance, value)
	local propertyName = getTransparencyProperty(instance)
	if not propertyName then
		return false
	end
	local ok = pcall(function()
		instance[propertyName] = value
	end)
	return ok
end

local function showImageInstance(instance)
	return setVisualTransparency(instance, 0)
end

local function hideImageInstance(instance)
	return setVisualTransparency(instance, 1)
end

local function hasProperty(instance, propertyName)
	if not instance or not propertyName then
		return false
	end
	local ok = pcall(function()
		return instance[propertyName]
	end)
	return ok
end

local function getImageValue(instance)
	local stringProperty = getStringImageProperty(instance)
	if stringProperty then
		local ok, value = pcall(function()
			return instance[stringProperty]
		end)
		if ok and type(value) == "string" and value ~= "" then
			return value
		end
	end

	for _, propertyName in ipairs(IMAGE_CONTENT_PROPERTIES[instance.ClassName] or {}) do
		if hasProperty(instance, propertyName) then
			local ok, value = pcall(function()
				return instance[propertyName]
			end)
			if ok and value ~= nil then
				local text = tostring(value)
				if text ~= "" then
					return text
				end
			end
		end
	end

	return ""
end

local function createContentValue(imageId)
	if type(Content) ~= "table" then
		return nil
	end

	if type(Content.fromUri) == "function" then
		local ok, value = pcall(function()
			return Content.fromUri(imageId)
		end)
		if ok then
			return value
		end
	end

	local assetId = string.match(tostring(imageId or ""), "rbxassetid://(%d+)") or string.match(tostring(imageId or ""), "^(%d+)$")
	if assetId and type(Content.fromAssetId) == "function" then
		local ok, value = pcall(function()
			return Content.fromAssetId(tonumber(assetId))
		end)
		if ok then
			return value
		end
	end

	return nil
end

local function applyImageProperties(instance, imageId)
	local wroteAny = false
	local stringProperty = getStringImageProperty(instance)
	if stringProperty then
		local ok = pcall(function()
			instance[stringProperty] = imageId
		end)
		wroteAny = wroteAny or ok
	end

	local contentValue = createContentValue(imageId)
	if contentValue then
		for _, propertyName in ipairs(IMAGE_CONTENT_PROPERTIES[instance.ClassName] or {}) do
			if hasProperty(instance, propertyName) then
				local ok = pcall(function()
					instance[propertyName] = contentValue
				end)
				wroteAny = wroteAny or ok
			end
		end
	end

	return wroteAny
end

local function safeTween(instance, tweenInfo, props)
	local ok, tween = pcall(function()
		return TweenService:Create(instance, tweenInfo, props)
	end)
	if ok and tween then
		tween:Play()
		return tween
	end
	return nil
end

local function matchesFaceLayer(instance, head, layerName)
	if not isSupportedImageInstance(instance) then
		return false
	end

	local normalizedTarget = normalizeLayerName(layerName)
	local instanceName = normalizeLayerName(instance.Name)
	if instanceName == normalizedTarget
		or instanceName == normalizedTarget .. "decal"
		or instanceName == normalizedTarget .. "image"
		or instanceName == normalizedTarget .. "texture" then
		return true
	end

	local parent = instance.Parent
	while parent and parent ~= head do
		local parentName = normalizeLayerName(parent.Name)
		if parentName == normalizedTarget then
			return true
		end
		parent = parent.Parent
	end
	return false
end

local function collectFaceLayers(head, layerName)
	local layers = {}
	local seen = {}
	if not head then
		return layers
	end

	local function add(instance)
		if instance and not seen[instance] and matchesFaceLayer(instance, head, layerName) then
			seen[instance] = true
			table.insert(layers, instance)
		end
	end

	add(head:FindFirstChild(tostring(layerName or "")))
	for _, child in ipairs(head:GetChildren()) do
		add(child)
	end
	for _, descendant in ipairs(head:GetDescendants()) do
		add(descendant)
	end

	return layers
end

local function getSafeLayerSuffix(layerName)
	local suffix = normalizeLayerName(layerName)
	suffix = suffix:gsub("[^%w]", "_")
	return suffix ~= "" and suffix or "layer"
end

local function isGeneratedLayerShell(instance)
	return instance and instance:IsA("BasePart") and instance:GetAttribute(GENERATED_LAYER_SHELL_ATTRIBUTE) == true
end

local function isInsideGeneratedLayerShell(instance, head)
	local current = instance and instance.Parent or nil
	while current and current ~= head do
		if isGeneratedLayerShell(current) then
			return true
		end
		current = current.Parent
	end
	return false
end

local function clearShellChildren(shell)
	for _, child in ipairs(shell:GetChildren()) do
		if not child:IsA("SpecialMesh") then
			child:Destroy()
		end
	end
end

local function configureShellPart(shell)
	shell:SetAttribute(GENERATED_LAYER_SHELL_ATTRIBUTE, true)
	shell:SetAttribute(GENERATED_LAYER_ATTRIBUTE, true)
	pcall(function()
		shell.Transparency = 1
	end)
	pcall(function()
		shell.CanCollide = false
		shell.CanTouch = false
		shell.CanQuery = false
		shell.CastShadow = false
		shell.Massless = true
		shell.Anchored = false
		shell.Locked = true
	end)
end

local function getOrCreateLayerShell(head, layerName)
	if not (head and head:IsA("BasePart")) then
		return nil
	end

	local shellName = GENERATED_LAYER_SHELL_PREFIX .. getSafeLayerSuffix(layerName)
	local existing = head:FindFirstChild(shellName)
	if existing and existing:IsA("BasePart") then
		configureShellPart(existing)
		return existing
	end

	local wasArchivable = head.Archivable
	pcall(function()
		head.Archivable = true
	end)
	local ok, shell = pcall(function()
		return head:Clone()
	end)
	pcall(function()
		head.Archivable = wasArchivable
	end)
	if not ok or not shell or not shell:IsA("BasePart") then
		return nil
	end

	shell.Name = shellName
	clearShellChildren(shell)
	configureShellPart(shell)
	shell.Parent = head
	return shell
end

local function getOrCreateLayerShellMotor(head, shell, layerName)
	if not (head and shell) then
		return nil
	end
	local motorName = GENERATED_LAYER_MOTOR_PREFIX .. getSafeLayerSuffix(layerName)
	local existing = head:FindFirstChild(motorName)
	if existing and existing:IsA("Motor6D") then
		existing.Part0 = head
		existing.Part1 = shell
		return existing
	end

	local motor = Instance.new("Motor6D")
	motor.Name = motorName
	motor.Part0 = head
	motor.Part1 = shell
	motor.Parent = head
	return motor
end

local function applyLayerShellTransform(instance, layerTransforms, layerName, head)
	local shell = instance and instance.Parent
	if not isGeneratedLayerShell(shell) then
		return false
	end
	head = head or shell.Parent
	if not (head and head:IsA("BasePart")) then
		return false
	end

	local offsetX, offsetY, scale = getLayerTransform(layerTransforms, layerName)
	local baseSize = head.Size
	local shellSize = Vector3.new(
		math.max(0.05, baseSize.X * scale),
		math.max(0.05, baseSize.Y * scale),
		math.max(0.05, baseSize.Z * scale)
	)
	pcall(function()
		shell.Size = shellSize
	end)

	local layerDepth = (LAYER_INDEX_BY_NAME[layerName] or 1) * FACE_SHELL_LAYER_DEPTH_STEP
	local scaleDepth = math.max(0, shellSize.Z - baseSize.Z) * 0.5
	local offset = CFrame.new(offsetX * baseSize.X, -offsetY * baseSize.Y, -(FACE_SHELL_FRONT_OFFSET + layerDepth + scaleDepth))

	local motor = getOrCreateLayerShellMotor(head, shell, layerName)
	if motor then
		motor.C0 = offset
		motor.C1 = CFrame.identity
		motor.Transform = CFrame.identity
	end
	return true
end

local function applyLayerTransform(instance, layerTransforms, layerName, head)
	if instance and (instance:IsA("Decal") or instance:IsA("Texture")) then
		return applyLayerShellTransform(instance, layerTransforms, layerName, head)
	end
	if not (instance and (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))) then
		return false
	end
	local offsetX, offsetY, scale = getLayerTransform(layerTransforms, layerName)
	instance.AnchorPoint = Vector2.new(0.5, 0.5)
	instance.BackgroundTransparency = 1
	instance.Position = UDim2.fromScale(0.5 + offsetX, 0.5 + offsetY)
	instance.Size = UDim2.fromScale(scale, scale)
	instance.ScaleType = Enum.ScaleType.Fit
	instance.ZIndex = LAYER_INDEX_BY_NAME[layerName] or 1
	return true
end

local function getOrCreateLayerGui(head)
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local gui = head:FindFirstChild(GENERATED_LAYER_GUI_NAME)
	if gui and gui:IsA("SurfaceGui") then
		return gui
	end

	local ok, created = pcall(function()
		local surfaceGui = Instance.new("SurfaceGui")
		surfaceGui.Name = GENERATED_LAYER_GUI_NAME
		surfaceGui.Face = Enum.NormalId.Front
		surfaceGui.LightInfluence = 0
		surfaceGui.AlwaysOnTop = false
		surfaceGui:SetAttribute(GENERATED_LAYER_ATTRIBUTE, true)
		pcall(function()
			surfaceGui.CanvasSize = Vector2.new(512, 512)
		end)
		pcall(function()
			surfaceGui.PixelsPerStud = 256
		end)
		surfaceGui.Parent = head
		return surfaceGui
	end)

	return ok and created or nil
end

function FaceRigAdapter.GetSelectedRig(selectionService, timeline)
	if selectionService and type(selectionService.getSelectedRig) == "function" then
		local selectedRig = selectionService.getSelectedRig()
		if selectedRig and selectedRig.Parent then
			return selectedRig
		end
	end

	if timeline and type(timeline.getRig) == "function" then
		local rig = timeline:getRig()
		if rig and rig.Parent then
			return rig
		end
	end

	if timeline and type(timeline.getRigs) == "function" then
		local rigs = timeline:getRigs()
		for _, rig in ipairs(rigs or {}) do
			if rig and rig.Parent then
				return rig
			end
		end
	end

	return nil
end

function FaceRigAdapter.GetHead(rig)
	if not rig then
		return nil
	end
	local head = rig:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

function FaceRigAdapter.FindFaceLayer(head, layerName)
	local fallback = nil
	for _, layer in ipairs(collectFaceLayers(head, layerName)) do
		if not isInsideGeneratedLayerShell(layer, head) then
			if layer:IsA("Decal") or layer:IsA("Texture") then
				return layer
			end
			fallback = fallback or layer
		end
	end
	return fallback
end

function FaceRigAdapter.FindCurvedFaceLayer(head, layerName)
	for _, layer in ipairs(collectFaceLayers(head, layerName)) do
		if (layer:IsA("Decal") or layer:IsA("Texture")) and not isInsideGeneratedLayerShell(layer, head) then
			return layer
		end
	end
	return nil
end

function FaceRigAdapter.CreateFaceLayer(head, layerName)
	if not (head and head:IsA("BasePart")) then
		return nil
	end

	local existing = FaceRigAdapter.FindCurvedFaceLayer(head, layerName)
	if existing then
		return existing
	end

	local ok, layer = pcall(function()
		local decal = Instance.new("Decal")
		decal.Name = tostring(layerName or "FaceLayer")
		decal.Face = Enum.NormalId.Front
		decal.Transparency = 1
		decal:SetAttribute(GENERATED_LAYER_ATTRIBUTE, true)
		decal.Parent = head
		return decal
	end)

	if ok then
		return layer
	end
	return nil
end

function FaceRigAdapter.CreateMovableFaceLayer(head, layerName)
	if not (head and head:IsA("BasePart")) then
		return nil
	end

	local shell = getOrCreateLayerShell(head, layerName)
	if not shell then
		return nil
	end
	local existing = shell:FindFirstChild(tostring(layerName or "FaceLayer"))
	if existing and (existing:IsA("Decal") or existing:IsA("Texture")) then
		return existing
	end

	local ok, layer = pcall(function()
		local decal = Instance.new("Decal")
		decal.Name = tostring(layerName or "FaceLayer")
		decal.Face = Enum.NormalId.Front
		decal.Transparency = 1
		decal:SetAttribute(GENERATED_LAYER_ATTRIBUTE, true)
		decal.Parent = shell
		return decal
	end)

	return ok and layer or nil
end

function FaceRigAdapter.FindStandardFace(head)
	if not head then
		return nil
	end

	local namedFace = head:FindFirstChild("face")
	if namedFace and isSupportedImageInstance(namedFace) then
		return namedFace
	end

	for _, child in ipairs(head:GetChildren()) do
		if isSupportedImageInstance(child) and string.lower(child.Name) == "face" then
			return child
		end
	end

	return nil
end

function FaceRigAdapter.CreateStandardFace(head)
	if not (head and head:IsA("BasePart")) then
		return nil
	end

	local existing = FaceRigAdapter.FindStandardFace(head)
	if existing then
		return existing
	end

	local ok, face = pcall(function()
		local decal = Instance.new("Decal")
		decal.Name = "face"
		decal.Face = Enum.NormalId.Front
		decal.Transparency = 1
		decal:SetAttribute(GENERATED_STANDARD_ATTRIBUTE, true)
		decal.Parent = head
		return decal
	end)

	if ok then
		return face
	end
	return nil
end

function FaceRigAdapter.SetStandardFaceVisible(head, visible)
	local face = FaceRigAdapter.FindStandardFace(head)
	if not face then
		return false
	end
	return visible and showImageInstance(face) or hideImageInstance(face)
end

function FaceRigAdapter.SetLayeredFaceVisible(head, visible)
	if not head then
		return 0
	end

	local changed = 0
	for _, layerName in ipairs(LAYER_NAMES) do
		for _, layer in ipairs(collectFaceLayers(head, layerName)) do
			local ok = visible and showImageInstance(layer) or hideImageInstance(layer)
			if ok then
				changed += 1
			end
		end
	end
	return changed
end

function FaceRigAdapter.ApplyImageToInstance(instance, imageId, transition, fadeTime)
	if not isSupportedImageInstance(instance) then
		return false, "That face layer type is not supported yet."
	end

	local transparencyProperty = getTransparencyProperty(instance)
	local useFade = transition == "CrossFade" and tonumber(fadeTime) and tonumber(fadeTime) &gt; 0

	if not useFade or not transparencyProperty then
		return applyImageProperties(instance, imageId), nil
	end

	local originalTransparency = instance[transparencyProperty]
	local ok, overlay = pcall(function()
		local clone = instance:Clone()
		clone[transparencyProperty] = originalTransparency
		clone.Name = instance.Name .. "_FaceFadeOut"
		clone.Parent = instance.Parent
		return clone
	end)

	if not ok or not overlay then
		return applyImageProperties(instance, imageId), "CrossFade could not create an overlay, applied instantly."
	end

	local wroteImage = applyImageProperties(instance, imageId)
	instance[transparencyProperty] = 1

	local tweenInfo = TweenInfo.new(math.clamp(tonumber(fadeTime) or 0.15, 0.03, 2), Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local fadeIn = safeTween(instance, tweenInfo, {
		[transparencyProperty] = originalTransparency,
	})
	local fadeOut = safeTween(overlay, tweenInfo, {
		[transparencyProperty] = 1,
	})

	if fadeOut then
		fadeOut.Completed:Connect(function()
			if overlay and overlay.Parent then
				overlay:Destroy()
			end
		end)
	else
		if overlay and overlay.Parent then
			overlay:Destroy()
		end
	end

	if not fadeIn then
		instance[transparencyProperty] = originalTransparency
	end

	return wroteImage
end

function FaceRigAdapter.ApplySingleFace(rig, imageId, transition, fadeTime)
	local head = FaceRigAdapter.GetHead(rig)
	if not head then
		return false, { "No Head found on selected rig." }
	end

	local face = FaceRigAdapter.FindStandardFace(head) or FaceRigAdapter.CreateStandardFace(head)
	if not face then
		return false, { "Could not create a standard face decal on the selected rig." }
	end

	FaceRigAdapter.SetLayeredFaceVisible(head, false)
	showImageInstance(face)
	local ok, warning = FaceRigAdapter.ApplyImageToInstance(face, imageId, transition, fadeTime)
	if not ok then
		return false, { warning or "Could not apply face image." }
	end

	return true, warning and { warning } or {}
end

function FaceRigAdapter.ApplyLayeredFace(rig, layers, transition, fadeTime, layerTransforms)
	local head = FaceRigAdapter.GetHead(rig)
	if not head then
		return false, { "No Head found on selected rig." }
	end

	local warnings = {}
	local appliedCount = 0
	FaceRigAdapter.SetStandardFaceVisible(head, false)
	FaceRigAdapter.SetLayeredFaceVisible(head, false)

	if hasLayerTransformOverrides(layerTransforms) then
		for _, layerName in ipairs(LAYER_NAMES) do
			local imageId = type(layers) == "table" and layers[layerName] or nil
			if imageId and imageId ~= "" then
				local useMovableLayer = hasLayerTransformOverride(layerTransforms, layerName)
				local layer = useMovableLayer and FaceRigAdapter.CreateMovableFaceLayer(head, layerName)
					or FaceRigAdapter.CreateFaceLayer(head, layerName)
				if layer then
					if useMovableLayer then
						applyLayerTransform(layer, layerTransforms, layerName, head)
					end
					showImageInstance(layer)
					local ok, warning = FaceRigAdapter.ApplyImageToInstance(layer, imageId, transition, fadeTime)
					if ok then
						appliedCount += 1
					end
					if warning then
						table.insert(warnings, warning)
					end
				else
					table.insert(warnings, "Could not create " .. tostring(layerName) .. " face layer.")
				end
			end
		end

		if appliedCount == 0 then
			return false, warnings
		end
		return true, warnings
	end

	for layerName, imageId in pairs(layers or {}) do
		if imageId and imageId ~= "" then
			local layer = FaceRigAdapter.FindFaceLayer(head, layerName) or FaceRigAdapter.CreateFaceLayer(head, layerName)
			if layer then
				applyLayerTransform(layer, nil, layerName)
				showImageInstance(layer)
				local ok, warning = FaceRigAdapter.ApplyImageToInstance(layer, imageId, transition, fadeTime)
				if ok then
					appliedCount += 1
				end
				if warning then
					table.insert(warnings, warning)
				end
			else
				table.insert(warnings, "Could not find " .. tostring(layerName) .. " on selected rig.")
			end
		end
	end

	if appliedCount == 0 then
		return false, warnings
	end

	return true, warnings
end

function FaceRigAdapter.IsFaceStateSnapshot(value)
	return type(value) == "table" and value.type == "FaceSnapshot"
end

function FaceRigAdapter.CaptureFaceState(rig)
	local head = FaceRigAdapter.GetHead(rig)
	local snapshot = {
		type = "FaceSnapshot",
		rigName = rig and rig.Name or "",
		standard = nil,
		layers = {},
	}
	if not head then
		return snapshot
	end

	local standardFace = FaceRigAdapter.FindStandardFace(head)
	if standardFace then
		snapshot.standard = {
			imageId = getImageValue(standardFace),
			transparency = getVisualTransparency(standardFace),
		}
	end

	for _, layerName in ipairs(LAYER_NAMES) do
		local layer = FaceRigAdapter.FindFaceLayer(head, layerName)
		if layer then
			snapshot.layers[layerName] = {
				imageId = getImageValue(layer),
				transparency = getVisualTransparency(layer),
				generatedShell = isInsideGeneratedLayerShell(layer, head),
			}
			if layer:IsA("GuiObject") then
				snapshot.layers[layerName].position = layer.Position
				snapshot.layers[layerName].size = layer.Size
				snapshot.layers[layerName].anchorPoint = layer.AnchorPoint
				snapshot.layers[layerName].scaleType = (layer:IsA("ImageLabel") or layer:IsA("ImageButton")) and layer.ScaleType or nil
			end
		end
	end

	return snapshot
end

function FaceRigAdapter.RestoreFaceState(rig, snapshot)
	if not FaceRigAdapter.IsFaceStateSnapshot(snapshot) then
		return false
	end

	local head = FaceRigAdapter.GetHead(rig)
	if not head then
		return false
	end

	local changed = false
	local standardFace = FaceRigAdapter.FindStandardFace(head)
	if standardFace then
		if type(snapshot.standard) == "table" then
			if type(snapshot.standard.imageId) == "string" then
				applyImageProperties(standardFace, snapshot.standard.imageId)
			end
			if type(snapshot.standard.transparency) == "number" then
				setVisualTransparency(standardFace, snapshot.standard.transparency)
			else
				showImageInstance(standardFace)
			end
			changed = true
		elseif standardFace:GetAttribute(GENERATED_STANDARD_ATTRIBUTE) == true then
			hideImageInstance(standardFace)
			changed = true
		end
	end

	for _, layerName in ipairs(LAYER_NAMES) do
		for _, layer in ipairs(collectFaceLayers(head, layerName)) do
			local savedLayer = type(snapshot.layers) == "table" and snapshot.layers[layerName] or nil
			local layerIsShell = isInsideGeneratedLayerShell(layer, head)
			if type(savedLayer) == "table" and (not layerIsShell or savedLayer.generatedShell == true) then
				if type(savedLayer.imageId) == "string" then
					applyImageProperties(layer, savedLayer.imageId)
				end
				if type(savedLayer.transparency) == "number" then
					setVisualTransparency(layer, savedLayer.transparency)
				end
				if layer:IsA("GuiObject") then
					if typeof(savedLayer.position) == "UDim2" then
						layer.Position = savedLayer.position
					end
					if typeof(savedLayer.size) == "UDim2" then
						layer.Size = savedLayer.size
					end
					if typeof(savedLayer.anchorPoint) == "Vector2" then
						layer.AnchorPoint = savedLayer.anchorPoint
					end
					if (layer:IsA("ImageLabel") or layer:IsA("ImageButton")) and typeof(savedLayer.scaleType) == "EnumItem" then
						layer.ScaleType = savedLayer.scaleType
					end
				end
			else
				if layer:GetAttribute(GENERATED_LAYER_ATTRIBUTE) == true then
					hideImageInstance(layer)
				else
					hideImageInstance(layer)
				end
			end
			changed = true
		end
	end

	return changed
end

return FaceRigAdapter
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX6">
          <Properties>
            <string name="Name">FacesController</string>
            <ProtectedString name="Source">local FacePresetStore = require(script.Parent:WaitForChild("FacePresetStore"))
local FaceRigAdapter = require(script.Parent:WaitForChild("FaceRigAdapter"))
local FaceSelectionImport = require(script.Parent:WaitForChild("FaceSelectionImport"))
local FaceTimelineAdapter = require(script.Parent:WaitForChild("FaceTimelineAdapter"))

local FacesController = {}
FacesController.__index = FacesController

local DEFAULT_STATUS = "Create a face preset, then click it to key the selected rig."

local function cloneTable(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = cloneTable(child)
	end
	return result
end

local function hasImages(preset)
	if type(preset) ~= "table" then
		return false
	end
	if preset.Type == "Single" then
		return type(preset.ImageId) == "string" and preset.ImageId ~= ""
	end
	if preset.Type == "Layered" and type(preset.Layers) == "table" then
		for _, imageId in pairs(preset.Layers) do
			if type(imageId) == "string" and imageId ~= "" then
				return true
			end
		end
	end
	return false
end

local function warningSummary(warnings)
	if type(warnings) ~= "table" or #warnings == 0 then
		return nil
	end
	return table.concat(warnings, " ")
end

local function faceTrackName(rigName)
	return string.format("%s Face", tostring(rigName or "Rig"))
end

local function isFaceTrack(track)
	return track and (track.trackType == "Face" or track.valueType == "Face")
end

local function isFaceValue(value)
	return type(value) == "table"
		and (value.type == "Face" or value.faceType ~= nil or value.imageId ~= nil or value.layers ~= nil)
end

local function findTimelineRigByName(timeline, rigName)
	if not timeline or type(timeline.getRigs) ~= "function" then
		return nil
	end
	for _, rig in ipairs(timeline:getRigs() or {}) do
		if rig and rig.Parent and rig.Name == rigName then
			return rig
		end
	end
	return nil
end

local function findRigByName(timeline, rigName)
	if not timeline or not rigName or rigName == "" then
		return nil
	end
	if type(timeline.getRigByName) == "function" then
		local rig = timeline:getRigByName(rigName)
		if rig and rig.Parent then
			return rig
		end
	end
	return findTimelineRigByName(timeline, rigName)
end

local function findHeadTrackByRig(timeline, rigName)
	if not timeline or type(timeline.getTracks) ~= "function" then
		return nil
	end
	for _, track in ipairs(timeline:getTracks() or {}) do
		if track and track.trackType == "Rig" and track.rigName == rigName then
			if track.part1 == "Head" or track.name == "Head" then
				return track
			end
		end
	end
	return nil
end

local function makeTrackValue(keyframe)
	local value = {
		type = "Face",
		presetName = keyframe.PresetName,
		presetId = keyframe.PresetId,
		transition = keyframe.Transition,
		fadeTime = keyframe.FadeTime,
	}
	if keyframe.Type == "Layered" then
		value.faceType = "Layered"
		value.layers = cloneTable(keyframe.Layers)
		value.layerTransforms = cloneTable(keyframe.LayerTransforms)
	else
		value.faceType = "Single"
		value.imageId = keyframe.ImageId
	end
	return value
end

function FacesController.new(deps)
	deps = deps or {}
	local self = setmetatable({
		_plugin = deps.plugin,
		_timeline = deps.timeline,
		_selectionService = deps.selectionService,
		_changeHistoryService = deps.changeHistoryService,
		_markDirty = deps.markDirty or function() end,
		_store = FacePresetStore.new(deps.plugin),
		_timelineAdapter = FaceTimelineAdapter.new(),
		_transition = "Instant",
		_fadeTime = 0.15,
		_getSelectedKeyRefs = nil,
		_getSelectedTrackPaths = nil,
		_searchText = "",
		_selectedFolderId = "All",
		_draftPreviewRig = nil,
		_draftPreviewSnapshot = nil,
		_selectionImportScan = nil,
		_status = DEFAULT_STATUS,
	}, FacesController)

	local _, loadMessage, loaded = self._store:load()
	local loadStatus = self._store:getLoadStatus()
	if not loaded or loadStatus == "place_backup" or loadStatus == "recovery" then
		self._status = tostring(loadMessage or "Face preset storage is temporarily unavailable.")
	end
	return self
end

function FacesController:setSelectedKeyProvider(provider)
	self._getSelectedKeyRefs = type(provider) == "function" and provider or nil
end

function FacesController:setSelectedTrackPathProvider(provider)
	self._getSelectedTrackPaths = type(provider) == "function" and provider or nil
end

function FacesController:_rigFromTrack(track, seen)
	if not track or not self._timeline then
		return nil
	end
	if track.rig and track.rig.Parent then
		return track.rig
	end
	if track.rigName then
		local rig = findRigByName(self._timeline, track.rigName)
		if rig then
			return rig
		end
	end
	if track.instance and track.instance.Parent and track.instance:IsA("Model") then
		return track.instance
	end
	if track.parentTrackPath and type(self._timeline.getTrackByPath) == "function" then
		seen = seen or {}
		if seen[track.parentTrackPath] then
			return nil
		end
		seen[track.parentTrackPath] = true
		return self:_rigFromTrack(self._timeline:getTrackByPath(track.parentTrackPath), seen)
	end
	return nil
end

function FacesController:_getSelectedTimelineRig()
	local provider = self._getSelectedTrackPaths
	if not provider or not self._timeline or type(self._timeline.getTrackByPath) ~= "function" then
		return nil
	end
	for _, path in ipairs(provider() or {}) do
		local rig = self:_rigFromTrack(self._timeline:getTrackByPath(path))
		if rig and rig.Parent then
			return rig
		end
	end
	return nil
end

function FacesController:_getTargetRig()
	return self:_getSelectedTimelineRig() or FaceRigAdapter.GetSelectedRig(self._selectionService, self._timeline)
end

function FacesController:_clearDraftPreview()
	if self._draftPreviewRig and self._draftPreviewSnapshot then
		FaceRigAdapter.RestoreFaceState(self._draftPreviewRig, self._draftPreviewSnapshot)
	end
	self._draftPreviewRig = nil
	self._draftPreviewSnapshot = nil
end

function FacesController:_getSelectedFaceKeyValues()
	local provider = self._getSelectedKeyRefs
	if not provider or not self._timeline or type(self._timeline.getTrackKeyValues) ~= "function" then
		return {}
	end

	local selectedKeyRefs = provider() or {}
	local selectedValues = self._timeline:getTrackKeyValues(selectedKeyRefs)
	local faceKeys = {}
	for _, key in ipairs(selectedValues or {}) do
		local track = self._timeline:getTrackByPath(key.jointPath)
		if isFaceTrack(track) and isFaceValue(key.value) then
			table.insert(faceKeys, key)
		end
	end
	return faceKeys
end

function FacesController:_getSelectedFaceKeySummary()
	local selectedFaceKeys = self:_getSelectedFaceKeyValues()
	local first = selectedFaceKeys[1]
	if not first then
		return nil
	end

	local value = first.value or {}
	return {
		count = #selectedFaceKeys,
		transition = value.transition == "CrossFade" and "CrossFade" or "Instant",
		fadeTime = math.max(0, tonumber(value.fadeTime or value.FadeTime) or 0),
	}
end

function FacesController:_updateSelectedFaceKeyframes(updates)
	local selectedFaceKeys = self:_getSelectedFaceKeyValues()
	if #selectedFaceKeys == 0 then
		return nil
	end

	if self._changeHistoryService then
		pcall(function()
			self._changeHistoryService:SetWaypoint("Before Face Transition Edit")
		end)
	end

	local changed = 0
	local lastMessage = nil
	for _, key in ipairs(selectedFaceKeys) do
		local value = cloneTable(key.value)
		if type(value) == "table" then
			if updates.transition ~= nil then
				value.transition = updates.transition == "CrossFade" and "CrossFade" or "Instant"
			end
			if updates.fadeTime ~= nil then
				value.fadeTime = math.max(0, tonumber(updates.fadeTime) or 0)
			end

			local ok, message = self._timeline:setTrackValueAtFrame(
				key.jointPath,
				key.frame,
				value,
				key.easingStyle,
				key.easingDirection
			)
			if ok then
				changed += 1
			else
				lastMessage = message
			end
		end
	end

	if changed == 0 then
		self._status = tostring(lastMessage or "Could not update the selected face keyframe.")
		return false, self._status
	end

	self._timelineAdapter:syncFromTimeline(self._timeline)
	if self._timeline and type(self._timeline.getCurrentFrame) == "function" then
		self._timelineAdapter:applyFaceAtTime(self._timeline, FaceRigAdapter, self._timeline:getCurrentFrame())
	end
	if self._changeHistoryService then
		pcall(function()
			self._changeHistoryService:SetWaypoint("After Face Transition Edit")
		end)
	end
	self._markDirty()

	self._status = string.format(
		"Updated %d selected face keyframe%s.",
		changed,
		changed == 1 and "" or "s"
	)
	return true, self._status
end

function FacesController:getViewModel()
	local presets = self._store:list()
	local folders = self._store:listFolders()
	local searchText = tostring(self._searchText or "")
	local filtered = {}
	local query = string.lower(searchText)
	local selectedFolderId = self._selectedFolderId or "All"
	for _, preset in ipairs(presets) do
		local folderMatches = selectedFolderId == "All"
			or (selectedFolderId == "Unsorted" and (preset.FolderId == nil or preset.FolderId == ""))
			or preset.FolderId == selectedFolderId
		local searchMatches = searchText == ""
			or string.find(string.lower(tostring(preset.Name or "")), query, 1, true) ~= nil
		if folderMatches and searchMatches then
			table.insert(filtered, preset)
		end
	end
	local selectedFaceKey = self:_getSelectedFaceKeySummary()
	local transition = selectedFaceKey and selectedFaceKey.transition or self._transition
	local fadeTime = selectedFaceKey and selectedFaceKey.fadeTime or self._fadeTime
	local status = self._status
	local targetRig = self:_getTargetRig()
	if selectedFaceKey and status == DEFAULT_STATUS then
		status = "Editing selected face keyframe. Transition controls update the selected key; deselect to change new-key defaults."
	end

	return {
		presets = filtered,
		folders = folders,
		allPresetCount = #presets,
		selectedFolderId = selectedFolderId,
		searchText = searchText,
		transition = transition,
		fadeTime = fadeTime,
		status = status,
		targetRigName = targetRig and targetRig.Name or nil,
		editingSelectedFaceKey = selectedFaceKey ~= nil,
		selectedFaceKeyCount = selectedFaceKey and selectedFaceKey.count or 0,
		keyframes = self._timelineAdapter:getFaceKeyframes(),
	}
end

function FacesController:setSearchText(text)
	self._searchText = tostring(text or "")
	return true
end

function FacesController:selectFolder(folderId)
	folderId = tostring(folderId or "All")
	if folderId == "" then
		folderId = "All"
	end
	self._selectedFolderId = folderId
	self._status = folderId == "All" and "Showing all face presets."
		or (folderId == "Unsorted" and "Showing unsorted face presets." or "Showing selected face folder.")
	return true, self._status
end

function FacesController:createFolder(name)
	local success, message, folder = self._store:createFolder(name)
	if success and folder then
		self._selectedFolderId = folder.Id
	end
	self._status = message
	return success, message, folder
end

function FacesController:renameSelectedFolder(name)
	local folderId = self._selectedFolderId
	if folderId == "All" or folderId == "Unsorted" then
		self._status = "Select a custom face folder before renaming."
		return false, self._status
	end
	local success, message = self._store:renameFolder(folderId, name)
	self._status = message
	return success, message
end

function FacesController:deleteSelectedFolder()
	local folderId = self._selectedFolderId
	if folderId == "All" or folderId == "Unsorted" then
		self._status = "Select a custom face folder before deleting."
		return false, self._status
	end
	local success, message = self._store:deleteFolder(folderId)
	if success then
		self._selectedFolderId = "Unsorted"
	end
	self._status = message
	return success, message
end

function FacesController:setTransition(transition)
	self._transition = transition == "CrossFade" and "CrossFade" or "Instant"
	local selectedFaceKey = self:_getSelectedFaceKeySummary()
	local fadeTime = 0
	if self._transition == "CrossFade" then
		fadeTime = selectedFaceKey and selectedFaceKey.fadeTime &gt; 0 and selectedFaceKey.fadeTime or self._fadeTime
	end
	local updates = {
		transition = self._transition,
		fadeTime = fadeTime,
	}
	local selectedUpdated, selectedMessage = self:_updateSelectedFaceKeyframes(updates)
	if selectedUpdated ~= nil then
		return selectedUpdated, selectedMessage
	end
	self._status = "New face keyframes will use " .. self._transition .. "."
	return true, self._status
end

function FacesController:setFadeTime(value)
	local number = tonumber(value)
	if not number then
		return false, "Fade duration needs to be a number."
	end
	self._fadeTime = math.clamp(number, 0, 5)
	local updates = {
		transition = self._fadeTime &gt; 0 and "CrossFade" or "Instant",
		fadeTime = self._fadeTime,
	}
	local selectedUpdated, selectedMessage = self:_updateSelectedFaceKeyframes(updates)
	if selectedUpdated ~= nil then
		return selectedUpdated, selectedMessage
	end
	self._status = string.format("Face fade duration set to %.2fs. Use CrossFade for new keyframes to use it.", self._fadeTime)
	return true, self._status
end

function FacesController:savePreset(rawPreset)
	rawPreset = rawPreset or {}
	if not rawPreset.FolderId or rawPreset.FolderId == "" or rawPreset.FolderId == "All" then
		rawPreset.FolderId = self._selectedFolderId ~= "All" and self._selectedFolderId or nil
	end
	local success, message, preset = self._store:upsert(rawPreset)
	self._status = message
	return success, message, preset
end

function FacesController:previewPresetDraft(rawPreset)
	local rig = self:_getTargetRig()
	if not rig then
		self:_clearDraftPreview()
		self._status = "Select a rig to preview this face preset."
		return false, self._status
	end

	local preset, message = self._store:normalizePreset(rawPreset)
	if not preset then
		self:_clearDraftPreview()
		self._status = message
		return false, message
	end
	if not hasImages(preset) then
		self:_clearDraftPreview()
		self._status = "This preset has no valid image IDs."
		return false, self._status
	end

	if self._draftPreviewRig ~= rig then
		self:_clearDraftPreview()
		self._draftPreviewRig = rig
		self._draftPreviewSnapshot = FaceRigAdapter.CaptureFaceState(rig)
	end

	local applied, warnings
	if preset.Type == "Layered" then
		applied, warnings = FaceRigAdapter.ApplyLayeredFace(rig, preset.Layers, "Instant", 0, preset.LayerTransforms)
	else
		applied, warnings = FaceRigAdapter.ApplySingleFace(rig, preset.ImageId, "Instant", 0)
	end

	if not applied then
		self:_clearDraftPreview()
		self._status = warningSummary(warnings) or "Could not preview that face preset."
		return false, self._status
	end

	self._status = "Previewing face preset on selected rig."
	return true, self._status
end

function FacesController:endPresetDraftPreview()
	self:_clearDraftPreview()
	return true, self._status
end

function FacesController:renamePreset(presetId, name)
	local success, message = self._store:rename(presetId, name)
	self._status = message
	return success, message
end

function FacesController:deletePreset(presetId)
	local success, message = self._store:delete(presetId)
	self._status = message
	return success, message
end

function FacesController:duplicatePreset(presetId)
	local success, message, preset = self._store:duplicatePreset(presetId)
	if success and preset and preset.FolderId then
		self._selectedFolderId = preset.FolderId
	end
	self._status = message
	return success, message, preset
end

function FacesController:movePresetToFolder(payload)
	payload = payload or {}
	local success, message, preset = self._store:movePresetToFolder(payload.presetId, payload.folderId)
	if success then
		self._selectedFolderId = preset and preset.FolderId or "Unsorted"
	end
	self._status = message
	return success, message, preset
end

function FacesController:copyPresetToFolder(payload)
	payload = payload or {}
	local success, message, preset = self._store:copyPresetToFolder(payload.presetId, payload.folderId)
	if success then
		self._selectedFolderId = preset and preset.FolderId or "Unsorted"
	end
	self._status = message
	return success, message, preset
end

function FacesController:exportPresetBackup()
	local success, message, backup = self._store:exportBackup()
	self._status = message
	return success, message, backup
end

function FacesController:importPresetBackup()
	local success, message, result = self._store:importBackup()
	if success then
		self._selectedFolderId = "All"
	end
	self._status = message
	return success, message, result
end

function FacesController:recoverPresetsFromProject()
	if self._timeline then
		self._timelineAdapter:syncFromTimeline(self._timeline)
	end

	local candidates = {}
	for _, keyframe in ipairs(self._timelineAdapter:getFaceKeyframes()) do
		local presetName = tostring(keyframe.PresetName or "")
		if presetName == "" then
			presetName = "Recovered Face"
		end
		local candidate = {
			Id = keyframe.PresetId,
			Name = presetName,
			Type = keyframe.Type == "Layered" and "Layered" or "Single",
		}
		if candidate.Type == "Layered" then
			candidate.Layers = cloneTable(keyframe.Layers)
			candidate.LayerTransforms = cloneTable(keyframe.LayerTransforms)
		else
			candidate.ImageId = keyframe.ImageId
		end
		table.insert(candidates, candidate)
	end

	if #candidates == 0 then
		self._status = "No saved Face keyframes were found in this project."
		return false, self._status, nil
	end

	local success, message, result = self._store:recoverPresets(candidates)
	if success then
		self._selectedFolderId = "All"
	end
	self._status = message
	return success, message, result
end

function FacesController:scanSelectionForPresets()
	local success, message, scan = FaceSelectionImport.scan(self._selectionService)
	if not success then
		self._selectionImportScan = nil
		self._status = message
		return false, message, nil
	end
	self._selectionImportScan = scan
	self._status = message
	return true, message, FaceSelectionImport.makePreview(scan)
end

function FacesController:importSelectionPresets(payload)
	payload = type(payload) == "table" and payload or {}
	local built, buildMessage, importPayload = FaceSelectionImport.buildPresets(
		self._selectionImportScan,
		payload.groupIds
	)
	if not built then
		self._status = buildMessage
		return false, buildMessage, nil
	end

	local skipFolder = importPayload.skipFolder == true
	local folderName = tostring(payload.folderName or "")
	if not skipFolder and folderName == "" then
		folderName = importPayload.folderName
	end
	local success, message, result = self._store:importSelectionPresets(importPayload.presets, folderName, {
		skipFolder = skipFolder,
	})
	if success and result then
		if result.folderId then
			self._selectedFolderId = result.folderId
		else
			self._selectedFolderId = "All"
		end
		result.duplicateReferences = importPayload.duplicateReferences
		local destinationName = result.folderName or (skipFolder and "All Faces" or folderName)
		message = string.format(
			"Imported %d face preset%s into '%s'. %d source duplicate%s and %d existing image%s skipped.",
			tonumber(result.importedPresets) or 0,
			tonumber(result.importedPresets) == 1 and "" or "s",
			tostring(destinationName),
			tonumber(importPayload.duplicateReferences) or 0,
			tonumber(importPayload.duplicateReferences) == 1 and "" or "s",
			tonumber(result.skippedPresets) or 0,
			tonumber(result.skippedPresets) == 1 and "" or "s"
		)
		self._selectionImportScan = nil
	end
	self._status = message
	return success, message, result
end

function FacesController:_findFaceTrack(rigName)
	if not self._timeline then
		return nil
	end
	if type(self._timeline._genericTracks) == "table" then
		for _, track in ipairs(self._timeline._genericTracks) do
			if track.trackType == "Face" and track.rigName == rigName then
				return track
			end
		end
	end
	if type(self._timeline.getTracks) ~= "function" then
		return nil
	end
	for _, track in ipairs(self._timeline:getTracks()) do
		if track.trackType == "Face" and track.rigName == rigName then
			return track
		end
	end
	return nil
end

function FacesController:_ensureFaceTrack(rigName, rig)
	local existing = self:_findFaceTrack(rigName)
	rig = rig or findTimelineRigByName(self._timeline, rigName)
	local headTrack = findHeadTrackByRig(self._timeline, rigName)
	if existing then
		if rig and not FaceRigAdapter.IsFaceStateSnapshot(existing.originalValue) then
			existing.originalValue = FaceRigAdapter.CaptureFaceState(rig)
		end
		if headTrack then
			existing.parentTrackPath = headTrack.path
			existing.parentTrackName = headTrack.part1 or headTrack.name or "Head"
		end
		return existing
	end
	if not self._timeline or type(self._timeline.addGenericTrack) ~= "function" then
		return nil
	end
	return self._timeline:addGenericTrack("Face", nil, faceTrackName(rigName), {
		rigName = rigName,
		propertyName = "Face",
		targetScope = "Face",
		parentTrackPath = headTrack and headTrack.path or nil,
		parentTrackName = headTrack and (headTrack.part1 or headTrack.name or "Head") or nil,
		originalValue = rig and FaceRigAdapter.CaptureFaceState(rig) or nil,
	})
end

function FacesController:_writeFaceTrackKeyframe(keyframe)
	local track = self:_ensureFaceTrack(keyframe.Character)
	if not track then
		return false
	end
	local frame = math.max(0, math.floor(tonumber(keyframe.Frame) or 0))
	return self._timeline:setTrackValueAtFrame(track.path, frame, makeTrackValue(keyframe), "None", "InOut")
end

function FacesController:_syncVisibleFaceTracks()
	for _, keyframe in ipairs(self._timelineAdapter:getFaceKeyframes()) do
		self:_writeFaceTrackKeyframe(keyframe)
	end
end

function FacesController:applyPreset(presetId)
	if not self._timeline then
		self._status = "Current timeline is unavailable."
		return false, self._status
	end

	local rig = self:_getTargetRig()
	if not rig then
		self._status = "Select a rig before applying a face."
		return false, self._status
	end

	local preset = self._store:get(presetId)
	if not preset then
		self._status = "That face preset could not be found."
		return false, self._status
	end
	if not hasImages(preset) then
		self._status = "This preset has no valid image IDs."
		return false, self._status
	end

	local faceTrack = self:_ensureFaceTrack(rig.Name, rig)
	if not faceTrack then
		self._status = "Could not create a face track for the selected rig."
		return false, self._status
	end

	if self._changeHistoryService then
		pcall(function()
			self._changeHistoryService:SetWaypoint("Before Face Keyframe")
		end)
	end

	local transition = self._transition
	local fadeTime = transition == "CrossFade" and self._fadeTime or 0
	local applied, warnings
	if preset.Type == "Layered" then
		applied, warnings = FaceRigAdapter.ApplyLayeredFace(rig, preset.Layers, transition, fadeTime, preset.LayerTransforms)
	else
		applied, warnings = FaceRigAdapter.ApplySingleFace(rig, preset.ImageId, transition, fadeTime)
	end

	if not applied then
		self._status = warningSummary(warnings) or "Could not apply that face preset."
		return false, self._status
	end

	local added, keyframe = self._timelineAdapter:addFaceKeyframe(self._timeline, rig, cloneTable(preset), transition, fadeTime)
	if not added then
		self._status = tostring(keyframe or "Could not add face keyframe.")
		return false, self._status
	end
	local wroteTrack, writeMessage = self:_writeFaceTrackKeyframe(keyframe)
	if not wroteTrack then
		self._status = tostring(writeMessage or "Face changed, but the timeline keyframe could not be written.")
		return false, self._status
	end

	if self._changeHistoryService then
		pcall(function()
			self._changeHistoryService:SetWaypoint("After Face Keyframe")
		end)
	end
	self._markDirty()

	local seconds = keyframe.Time or 0
	self._status = string.format("Added %s face keyframe at %.2fs.", tostring(preset.Name or "Face"), seconds)
	local warningText = warningSummary(warnings)
	if warningText then
		self._status = self._status .. " " .. warningText
	end
	return true, self._status, keyframe
end

function FacesController:applyAtFrame(frame)
	self._timelineAdapter:syncFromTimeline(self._timeline)
	self._timelineAdapter:applyFaceAtTime(self._timeline, FaceRigAdapter, frame)
end

function FacesController:getSaveData()
	self._timelineAdapter:syncFromTimeline(self._timeline)
	return self._timelineAdapter:getSaveData()
end

function FacesController:syncFromTimeline()
	self._timelineAdapter:syncFromTimeline(self._timeline)
	self._status = "Synced face keyframes from the timeline."
end

function FacesController:restoreSaveData(data)
	self._timelineAdapter:restoreSaveData(data, self._timeline)
	self:_syncVisibleFaceTracks()
	self._status = "Loaded face keyframes."
end

function FacesController:clearTimelineData()
	self._timelineAdapter:restoreDefaultFaces(self._timeline, FaceRigAdapter)
	self._timelineAdapter:clear()
	self._status = "Cleared face keyframes."
end

return FacesController
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX7">
          <Properties>
            <string name="Name">FaceSelectionImport</string>
            <ProtectedString name="Source">local FacePresetStore = require(script.Parent:WaitForChild("FacePresetStore"))

local FaceSelectionImport = {}

local GENERIC_IMAGE_NAMES = {
	decal = true,
	face = true,
	image = true,
	imagebutton = true,
	imagelabel = true,
	part = true,
	texture = true,
}

local COMPONENT_HINTS = {
	"addition",
	"brow",
	"effect",
	"eye",
	"mouth",
	"pupil",
	"separate",
	"speech",
}

local function trim(value)
	return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function imageValue(instance)
	if instance:IsA("Decal") or instance:IsA("Texture") then
		local ok, value = pcall(function()
			return instance.Texture
		end)
		return ok and FacePresetStore.normalizeImageId(value) or nil
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		local ok, value = pcall(function()
			return instance.Image
		end)
		return ok and FacePresetStore.normalizeImageId(value) or nil
	end
	return nil
end

local function groupPath(root, instance)
	local names = {}
	local cursor = instance.Parent
	while cursor and cursor ~= root do
		if cursor:IsA("Folder") or cursor:IsA("Model") then
			table.insert(names, 1, cursor.Name)
		end
		cursor = cursor.Parent
	end
	if #names == 0 then
		return "(Selected Model)"
	end
	return table.concat(names, " / ")
end

local function classifyGroup(path)
	local lower = string.lower(tostring(path or ""))
	if string.find(lower, "full face", 1, true)
		or string.find(lower, "misc face", 1, true)
	then
		return "Full"
	end
	for _, hint in ipairs(COMPONENT_HINTS) do
		if string.find(lower, hint, 1, true) then
			return "Component"
		end
	end
	return "Other"
end

local function displayGroupName(path)
	local parts = {}
	for part in string.gmatch(tostring(path or ""), "[^/]+") do
		local clean = trim(part)
		local lower = string.lower(clean)
		if clean ~= ""
			and lower ~= "decals"
			and lower ~= "[new]"
			and lower ~= "[old]"
			and not string.find(lower, "face pack", 1, true)
		then
			table.insert(parts, clean)
		end
	end
	if #parts == 0 then
		return "Selected Model"
	end
	if string.find(string.lower(tostring(path or "")), "previous version", 1, true) then
		return "Previous - " .. parts[#parts]
	end
	return parts[#parts]
end

local function groupPriority(group)
	local path = string.lower(tostring(group.Path or ""))
	if group.Kind == "Full" then
		if string.find(path, "previous version", 1, true)
			or string.find(path, "[old]", 1, true)
		then
			return 2
		end
		return 1
	end
	if group.Kind == "Other" then
		return 3
	end
	return 4
end

local function meaningfulImageName(value)
	local name = trim(value)
	if name == "" or GENERIC_IMAGE_NAMES[string.lower(name)] then
		return nil
	end
	return name
end

local function candidatePart(instance)
	local cursor = instance and instance.Parent
	while cursor do
		if cursor:IsA("BasePart") then
			return cursor
		end
		cursor = cursor.Parent
	end
	return nil
end

local function candidatePosition(instance)
	local part = candidatePart(instance)
	return part and part.Position or nil
end

local function sortCandidates(candidates)
	local xMin, xMax = math.huge, -math.huge
	local zMin, zMax = math.huge, -math.huge
	for _, candidate in ipairs(candidates) do
		local position = candidate.Position
		if position then
			xMin = math.min(xMin, position.X)
			xMax = math.max(xMax, position.X)
			zMin = math.min(zMin, position.Z)
			zMax = math.max(zMax, position.Z)
		end
	end
	local horizontalAxis = (xMax - xMin) &gt;= (zMax - zMin) and "X" or "Z"
	table.sort(candidates, function(left, right)
		local leftPosition = left.Position
		local rightPosition = right.Position
		if leftPosition and rightPosition then
			if math.abs(leftPosition.Y - rightPosition.Y) &gt; 0.05 then
				return leftPosition.Y &gt; rightPosition.Y
			end
			local leftHorizontal = leftPosition[horizontalAxis]
			local rightHorizontal = rightPosition[horizontalAxis]
			if math.abs(leftHorizontal - rightHorizontal) &gt; 0.05 then
				return leftHorizontal &lt; rightHorizontal
			end
		elseif leftPosition ~= nil then
			return true
		elseif rightPosition ~= nil then
			return false
		end
		return tostring(left.ImageId) &lt; tostring(right.ImageId)
	end)
end

local function selectedRoot(selectionService)
	local selected = {}
	if selectionService and type(selectionService.getSelection) == "function" then
		selected = selectionService.getSelection() or {}
	elseif selectionService and type(selectionService.Get) == "function" then
		selected = selectionService:Get() or {}
	end
	if #selected ~= 1 then
		return nil, "Select one Model, Folder, or Part containing face images first."
	end
	local root = selected[1]
	if not root
		or not root.Parent
		or (not root:IsA("Model") and not root:IsA("Folder") and not root:IsA("BasePart"))
	then
		return nil, "Select one Model, Folder, or Part containing face images first."
	end
	return root
end

function FaceSelectionImport.scan(selectionService)
	local root, rootMessage = selectedRoot(selectionService)
	if not root then
		return false, rootMessage, nil
	end

	local groupsByPath = {}
	local validReferences = 0
	local invalidReferences = 0
	for _, instance in ipairs(root:GetDescendants()) do
		if instance:IsA("Decal")
			or instance:IsA("Texture")
			or instance:IsA("ImageLabel")
			or instance:IsA("ImageButton")
		then
			local imageId = imageValue(instance)
			if not imageId then
				invalidReferences += 1
			else
				validReferences += 1
				local path = groupPath(root, instance)
				local group = groupsByPath[path]
				if not group then
					group = {
						Id = path,
						Path = path,
						Name = displayGroupName(path),
						Kind = classifyGroup(path),
						ReferenceCount = 0,
						DuplicateCount = 0,
						Candidates = {},
						_seenImages = {},
					}
					groupsByPath[path] = group
				end
				group.ReferenceCount += 1
				if group._seenImages[imageId] then
					group.DuplicateCount += 1
				else
					group._seenImages[imageId] = true
					local sourcePart = candidatePart(instance)
					table.insert(group.Candidates, {
						ImageId = imageId,
						SourceName = instance.Name,
						SourcePartName = sourcePart and sourcePart.Name or nil,
						Position = candidatePosition(instance),
					})
				end
			end
		end
	end

	local groups = {}
	local fullGroupCount = 0
	for _, group in pairs(groupsByPath) do
		group._seenImages = nil
		sortCandidates(group.Candidates)
		group.UniqueCount = #group.Candidates
		group.Selectable = group.Kind ~= "Component"
		if group.Kind == "Full" then
			fullGroupCount += 1
		end
		table.insert(groups, group)
	end
	table.sort(groups, function(left, right)
		local leftPriority = groupPriority(left)
		local rightPriority = groupPriority(right)
		if leftPriority ~= rightPriority then
			return leftPriority &lt; rightPriority
		end
		return string.lower(left.Name) &lt; string.lower(right.Name)
	end)

	for _, group in ipairs(groups) do
		group.DefaultSelected = group.Kind == "Full"
			or (fullGroupCount == 0 and group.Kind == "Other")
	end

	if #groups == 0 or validReferences == 0 then
		return false, "No supported face images were found inside '" .. root.Name .. "'.", nil
	end

	return true, string.format(
		"Found %d image reference%s in %d group%s.",
		validReferences,
		validReferences == 1 and "" or "s",
		#groups,
		#groups == 1 and "" or "s"
	), {
		RootName = root.Name,
		RootPath = root:GetFullName(),
		RootIsPart = root:IsA("BasePart"),
		Groups = groups,
		ValidReferenceCount = validReferences,
		InvalidReferenceCount = invalidReferences,
	}
end

function FaceSelectionImport.makePreview(scan)
	if type(scan) ~= "table" then
		return nil
	end
	local preview = {
		rootName = scan.RootName,
		rootPath = scan.RootPath,
		rootIsPart = scan.RootIsPart == true,
		validReferenceCount = scan.ValidReferenceCount,
		invalidReferenceCount = scan.InvalidReferenceCount,
		groups = {},
	}
	for _, group in ipairs(scan.Groups or {}) do
		local assetKeys = {}
		for _, candidate in ipairs(group.Candidates or {}) do
			table.insert(assetKeys, candidate.ImageId)
		end
		table.insert(preview.groups, {
			id = group.Id,
			name = group.Name,
			path = group.Path,
			kind = group.Kind,
			referenceCount = group.ReferenceCount,
			uniqueCount = group.UniqueCount,
			duplicateCount = group.DuplicateCount,
			selectable = group.Selectable,
			defaultSelected = group.DefaultSelected,
			assetKeys = assetKeys,
		})
	end
	return preview
end

function FaceSelectionImport.buildPresets(scan, selectedGroupIds)
	if type(scan) ~= "table" or type(scan.Groups) ~= "table" then
		return false, "Scan the selected face model again.", nil
	end
	local selected = {}
	for _, groupId in ipairs(selectedGroupIds or {}) do
		selected[tostring(groupId)] = true
	end

	local presets = {}
	local seenImages = {}
	local duplicateReferences = 0
	local genericIndex = 0
	local selectedGroupCount = 0
	for _, group in ipairs(scan.Groups) do
		if selected[group.Id] and group.Selectable then
			selectedGroupCount += 1
			duplicateReferences += tonumber(group.DuplicateCount) or 0
			for _, candidate in ipairs(group.Candidates or {}) do
				if seenImages[candidate.ImageId] then
					duplicateReferences += 1
				else
					seenImages[candidate.ImageId] = true
					genericIndex += 1
					table.insert(presets, {
						Name = meaningfulImageName(candidate.SourceName)
							or meaningfulImageName(candidate.SourcePartName)
							or string.format("Face %03d", genericIndex),
						Type = "Single",
						ImageId = candidate.ImageId,
					})
				end
			end
		end
	end

	if selectedGroupCount == 0 then
		return false, "Choose at least one complete-face group to import.", nil
	end
	if #presets == 0 then
		return false, "The selected groups did not contain any new face images.", nil
	end
	return true, nil, {
		folderName = scan.RootIsPart == true and "" or scan.RootName,
		skipFolder = scan.RootIsPart == true,
		presets = presets,
		duplicateReferences = duplicateReferences,
		selectedGroupCount = selectedGroupCount,
	}
end

return FaceSelectionImport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX8">
          <Properties>
            <string name="Name">FaceSelectionImportUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("UiHelpers"))

local FaceSelectionImportUI = {}

local create = UiHelpers.create
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applyPanelSurface = UiHelpers.applyPanelSurface
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local styleInput = UiHelpers.styleInput

local function makeLabel(parent, text, position, size, textSize, semibold)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = semibold and Enum.Font.GothamSemibold or Enum.Font.Gotham,
		Position = position,
		Size = size,
		Text = text,
		TextColor3 = semibold and Constants.THEME.Text or Constants.THEME.MutedText,
		TextSize = textSize or 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = (parent.ZIndex or 1) + 1,
	})
end

local function makeButton(parent, text, position, size, primary)
	local button = create("TextButton", {
		Parent = parent,
		Position = position,
		Size = size,
		Text = text,
		ZIndex = (parent.ZIndex or 1) + 2,
	})
	if primary then
		styleTextButton(button)
	else
		styleGhostButton(button)
	end
	createCorner(button, 9)
	return button
end

local function clearRows(state)
	for _, child in ipairs(state.groupList:GetChildren()) do
		if child.Name == "FaceSelectionImportGroup" then
			child:Destroy()
		end
	end
	table.clear(state.groupRows)
end

local function selectedSummary(state)
	local seen = {}
	local uniqueCount = 0
	local duplicateCount = 0
	local componentCount = 0
	local componentSeen = {}
	local selectedGroupCount = 0
	for _, group in ipairs(state.preview and state.preview.groups or {}) do
		if group.selectable and state.selectedGroups[group.id] then
			selectedGroupCount += 1
			duplicateCount += tonumber(group.duplicateCount) or 0
			for _, assetKey in ipairs(group.assetKeys or {}) do
				if seen[assetKey] then
					duplicateCount += 1
				else
					seen[assetKey] = true
					uniqueCount += 1
				end
			end
		elseif not group.selectable then
			for _, assetKey in ipairs(group.assetKeys or {}) do
				if not componentSeen[assetKey] then
					componentSeen[assetKey] = true
					componentCount += 1
				end
			end
		end
	end
	return uniqueCount, duplicateCount, componentCount, selectedGroupCount
end

local function updateRow(state, group)
	local row = state.groupRows[group.id]
	if not row then
		return
	end
	local selected = group.selectable and state.selectedGroups[group.id] == true
	row.button.BackgroundColor3 = selected and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt
	row.button.AutoButtonColor = group.selectable
	row.button.Active = group.selectable
	row.state.Text = not group.selectable and "COMPONENT"
		or (selected and "INCLUDED" or "SKIPPED")
	row.state.TextColor3 = selected and Constants.THEME.Accent
		or (not group.selectable and Constants.THEME.MutedText or Constants.THEME.Text)
	row.stroke.Color = selected and Constants.THEME.Accent or Constants.THEME.Border
	row.stroke.Thickness = selected and 2 or 1
end

local function refreshSummary(state)
	local uniqueCount, duplicateCount, componentCount, selectedGroupCount = selectedSummary(state)
	state.summary.Text = string.format(
		"%d unique face%s ready  |  %d duplicate%s skipped  |  %d component image%s excluded",
		uniqueCount,
		uniqueCount == 1 and "" or "s",
		duplicateCount,
		duplicateCount == 1 and "" or "s",
		componentCount,
		componentCount == 1 and "" or "s"
	)
	state.importButton.Text = uniqueCount &gt; 0
		and string.format("Import %d Preset%s", uniqueCount, uniqueCount == 1 and "" or "s")
		or "Select a Face Group"
	state.importButton.Active = uniqueCount &gt; 0
	state.importButton.AutoButtonColor = uniqueCount &gt; 0
	state.importButton.TextTransparency = uniqueCount &gt; 0 and 0 or 0.45
	state.importButton.BackgroundColor3 = uniqueCount &gt; 0 and Constants.THEME.Accent or Constants.THEME.PanelSoft
	state.selectedUniqueCount = uniqueCount
	state.selectedGroupCount = selectedGroupCount
end

local function addGroupRow(state, group, order)
	local button = create("TextButton", {
		Name = "FaceSelectionImportGroup",
		Parent = state.groupList,
		AutoButtonColor = group.selectable == true,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 58),
		Text = "",
		ZIndex = state.groupList.ZIndex + 1,
	})
	createCorner(button, 10)
	local stroke = createStroke(button, Constants.THEME.Border, 1)
	makeLabel(button, tostring(group.name or "Face Group"), UDim2.new(0, 12, 0, 8), UDim2.new(1, -126, 0, 20), 13, true)
	local detail = group.selectable
		and string.format(
			"%s | %d unique image%s",
			group.kind == "Full" and "Complete faces" or "Unclassified images",
			tonumber(group.uniqueCount) or 0,
			tonumber(group.uniqueCount) == 1 and "" or "s"
		)
		or string.format(
			"Layer components | %d image%s | not imported as complete faces",
			tonumber(group.uniqueCount) or 0,
			tonumber(group.uniqueCount) == 1 and "" or "s"
		)
	makeLabel(button, detail, UDim2.new(0, 12, 0, 31), UDim2.new(1, -126, 0, 18), 10, false)
	local stateLabel = create("TextLabel", {
		Parent = button,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -108, 0.5, -13),
		Size = UDim2.new(0, 96, 0, 26),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 10,
		ZIndex = button.ZIndex + 1,
	})
	createCorner(stateLabel, 7)
	state.groupRows[group.id] = {
		button = button,
		state = stateLabel,
		stroke = stroke,
	}
	if group.selectable then
		button.Activated:Connect(function()
			state.selectedGroups[group.id] = not state.selectedGroups[group.id]
			updateRow(state, group)
			refreshSummary(state)
		end)
	end
	updateRow(state, group)
end

function FaceSelectionImportUI.mount(parent)
	local overlay = create("Frame", {
		Name = "FaceSelectionImportOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 960,
	})
	local card = create("Frame", {
		Name = "FaceSelectionImportCard",
		Parent = overlay,
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.82, 0, 0.86, 0),
		ZIndex = 961,
	})
	applyPanelSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)
	create("UISizeConstraint", {
		Parent = card,
		MinSize = Vector2.new(430, 420),
		MaxSize = Vector2.new(720, 620),
	})

	makeLabel(card, "Import Faces from Selection", UDim2.new(0, 20, 0, 16), UDim2.new(1, -72, 0, 26), 18, true)
	local rootLabel = makeLabel(card, "Selected model", UDim2.new(0, 20, 0, 44), UDim2.new(1, -40, 0, 20), 11, false)
	local closeButton = makeButton(card, "X", UDim2.new(1, -52, 0, 14), UDim2.new(0, 34, 0, 34), false)
	closeButton.Font = Enum.Font.GothamBold

	local summary = create("TextLabel", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 20, 0, 72),
		Size = UDim2.new(1, -40, 0, 42),
		Text = "Scan a selected model to preview its face images.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 962,
	})
	createCorner(summary, 9)
	createStroke(summary, Constants.THEME.Border, 1)
	create("UIPadding", {
		Parent = summary,
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	})

	makeLabel(card, "Choose face groups", UDim2.new(0, 20, 0, 126), UDim2.new(1, -40, 0, 20), 12, true)
	local groupList = create("ScrollingFrame", {
		Name = "FaceSelectionImportGroupList",
		Parent = card,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 20, 0, 150),
		ScrollBarThickness = 5,
		Size = UDim2.new(1, -40, 1, -292),
		ZIndex = 962,
	})
	createCorner(groupList, 10)
	createStroke(groupList, Constants.THEME.Border, 1)
	create("UIPadding", {
		Parent = groupList,
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	create("UIListLayout", {
		Parent = groupList,
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local folderLabel = makeLabel(card, "Preset folder", UDim2.new(0, 20, 1, -130), UDim2.new(0, 100, 0, 18), 11, true)
	local folderInput = create("TextBox", {
		Parent = card,
		ClearTextOnFocus = false,
		PlaceholderText = "Folder name",
		Position = UDim2.new(0, 120, 1, -136),
		Size = UDim2.new(1, -140, 0, 30),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 963,
	})
	styleInput(folderInput)
	createCorner(folderInput, 9)
	create("UIPadding", {
		Parent = folderInput,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local status = makeLabel(
		card,
		"Complete-face groups are selected automatically. Component images stay untouched.",
		UDim2.new(0, 20, 1, -94),
		UDim2.new(1, -40, 0, 28),
		10,
		false
	)
	local cancelButton = makeButton(card, "Cancel", UDim2.new(0, 20, 1, -52), UDim2.new(0.34, -26, 0, 34), false)
	local importButton = makeButton(card, "Import Presets", UDim2.new(0.34, 2, 1, -52), UDim2.new(0.66, -22, 0, 34), true)

	local state = {
		overlay = overlay,
		card = card,
		rootLabel = rootLabel,
		summary = summary,
		groupList = groupList,
		groupRows = {},
		selectedGroups = {},
		folderLabel = folderLabel,
		folderInput = folderInput,
		status = status,
		cancelButton = cancelButton,
		importButton = importButton,
		preview = nil,
		onImport = nil,
	}
	closeButton.Activated:Connect(function()
		FaceSelectionImportUI.close(state)
	end)
	cancelButton.Activated:Connect(function()
		FaceSelectionImportUI.close(state)
	end)
	importButton.Activated:Connect(function()
		if state.selectedUniqueCount == 0 or type(state.onImport) ~= "function" then
			return
		end
		local selectedGroupIds = {}
		for _, group in ipairs(state.preview and state.preview.groups or {}) do
			if group.selectable and state.selectedGroups[group.id] then
				table.insert(selectedGroupIds, group.id)
			end
		end
		state.status.Text = "Importing and verifying the preset library..."
		local success, message = state.onImport(selectedGroupIds, state.folderInput.Text)
		if success then
			FaceSelectionImportUI.close(state)
		else
			state.status.Text = tostring(message or "The face presets could not be imported.")
		end
	end)
	return state
end

function FaceSelectionImportUI.open(state, preview, onImport)
	if not state or type(preview) ~= "table" then
		return false
	end
	clearRows(state)
	state.preview = preview
	state.onImport = onImport
	state.selectedGroups = {}
	state.rootLabel.Text = "Selected: " .. tostring(preview.rootName or "Model")
	local usesFolder = preview.rootIsPart ~= true
	state.folderLabel.Visible = usesFolder
	state.folderInput.Visible = usesFolder
	state.folderInput.Text = usesFolder and tostring(preview.rootName or "Imported Faces") or ""
	state.status.Text = usesFolder
		and "Complete-face groups are selected automatically. Component images stay untouched."
		or "This face will be saved directly to All Faces without creating a folder."
	for index, group in ipairs(preview.groups or {}) do
		state.selectedGroups[group.id] = group.selectable and group.defaultSelected == true
		addGroupRow(state, group, index)
	end
	refreshSummary(state)
	state.overlay.Visible = true
	return true
end

function FaceSelectionImportUI.close(state)
	if not state then
		return
	end
	state.overlay.Visible = false
	state.preview = nil
	state.onImport = nil
end

return FaceSelectionImportUI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX9">
          <Properties>
            <string name="Name">FacesView</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("UiHelpers"))
local FacePreviewRenderer = require(script.Parent:WaitForChild("FacePreviewRenderer"))
local FaceSelectionImportUI = require(script.Parent:WaitForChild("FaceSelectionImportUI"))

local UserInputService = game:GetService("UserInputService")

local FacesView = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local styleInput = UiHelpers.styleInput
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applyPanelSurface = UiHelpers.applyPanelSurface

local LAYER_LABELS = {
	{ key = "BothEyes", label = "Both Eyes Image ID" },
	{ key = "LeftEye", label = "Left Eye Image ID" },
	{ key = "RightEye", label = "Right Eye Image ID" },
	{ key = "Mouth", label = "Mouth Image ID" },
	{ key = "LeftEyebrow", label = "Left Eyebrow Image ID" },
	{ key = "RightEyebrow", label = "Right Eyebrow Image ID" },
}
local LAYER_PICKER_LABELS = {
	{ key = "BothEyes", label = "Eyes" },
	{ key = "BothBrows", label = "Brows" },
	{ key = "Mouth", label = "Mouth" },
	{ key = "LeftEye", label = "L Eye" },
	{ key = "RightEye", label = "R Eye" },
	{ key = "LeftEyebrow", label = "L Brow" },
	{ key = "RightEyebrow", label = "R Brow" },
}
local LAYER_TRANSFORM_GROUPS = {
	BothEyes = { "BothEyes", "LeftEye", "RightEye" },
	BothBrows = { "LeftEyebrow", "RightEyebrow" },
}
local LAYER_OFFSET_LIMIT = 0.35
local LAYER_SCALE_MIN = 0.35
local LAYER_SCALE_MAX = 1.75
local LAYER_NUDGE_STEP = 0.025
local TRANSFORM_EPSILON = 0.001

local FACE_LAYER_ARROW_ICONS = {
	Up = {
		image = "rbxassetid://112500484159395",
		rotation = 0,
		fallback = "^",
	},
	Down = {
		image = "rbxassetid://112500484159395",
		rotation = 180,
		fallback = "v",
	},
	Left = {
		image = "rbxassetid://80694422752272",
		rotation = 180,
		fallback = "&lt;",
	},
	Right = {
		image = "rbxassetid://80694422752272",
		rotation = 0,
		fallback = "&gt;",
	},
}

local confirmActions = setmetatable({}, { __mode = "k" })

local function makeLabel(parent, text, position, size, textSize)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = position,
		Size = size,
		Text = text,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = textSize or 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = (parent.ZIndex or 1) + 1,
	})
end

local function makeHeader(parent, text, position, size)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = position,
		Size = size,
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = (parent.ZIndex or 1) + 1,
	})
end

local function makeButton(parent, text, position, size, isPrimary)
	local button = create("TextButton", {
		Parent = parent,
		Position = position,
		Size = size,
		Text = text,
		ZIndex = (parent.ZIndex or 1) + 2,
	})
	if isPrimary then
		styleTextButton(button)
	else
		styleGhostButton(button)
	end
	createCorner(button, 9)
	return button
end

local function makePlainTextButton(button)
	if not button then
		return
	end
	local icon = button:FindFirstChild("MegMoButtonIcon")
	if icon then
		icon:Destroy()
	end
	local padding = button:FindFirstChild("MegMoButtonIconPadding")
	if padding then
		padding:Destroy()
	end
	button.TextXAlignment = Enum.TextXAlignment.Center
	button.TextYAlignment = Enum.TextYAlignment.Center
	local overlay = button:FindFirstChild("MegMoButtonTextOverlay")
	if overlay and overlay:IsA("TextLabel") then
		overlay.TextXAlignment = Enum.TextXAlignment.Center
		overlay.TextYAlignment = Enum.TextYAlignment.Center
	end
	local gradient = button:FindFirstChild("MegMoButtonGradientOverlay")
	if gradient and gradient:IsA("GuiObject") then
		gradient.Position = UDim2.fromScale(0, 0)
		gradient.Size = UDim2.fromScale(1, 1)
	end
end

local function makeInput(parent, placeholder, position, size)
	local input = create("TextBox", {
		Parent = parent,
		ClearTextOnFocus = false,
		PlaceholderText = placeholder,
		Position = position,
		Size = size,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = (parent.ZIndex or 1) + 2,
	})
	styleInput(input)
	createCorner(input, 9)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	return input
end

local function imageTextFromValue(value)
	if value == nil then
		return nil
	end
	local text = tostring(value)
	if text == "" then
		return nil
	end
	local digits = text:match("^%d+$")
	if digits then
		return "rbxassetid://" .. digits
	end
	return text
end

local function getArrowImage(direction)
	local spec = FACE_LAYER_ARROW_ICONS[direction]
	return type(spec) == "table" and spec.image or nil
end

local function getArrowRotation(direction)
	local spec = FACE_LAYER_ARROW_ICONS[direction]
	return type(spec) == "table" and (tonumber(spec.rotation) or 0) or 0
end

local function getArrowFallback(direction)
	local spec = FACE_LAYER_ARROW_ICONS[direction]
	return type(spec) == "table" and tostring(spec.fallback or direction or "") or tostring(direction or "")
end

local function makeArrowButton(parent, direction, position)
	local button = makeButton(parent, getArrowFallback(direction), position, UDim2.new(0, 30, 0, 30), false)
	button.TextSize = 10
	local image = getArrowImage(direction)
	if image then
		button.Text = ""
		create("ImageLabel", {
			Name = "FaceLayerArrowIcon",
			Parent = button,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = image,
			ImageColor3 = Constants.THEME.Text,
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = getArrowRotation(direction),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(0.58, 0.58),
			ZIndex = button.ZIndex + 4,
		})
	end
	return button
end

local function getSelectedFaceImage()
	local selectionService = game:GetService("Selection")
	local selected = selectionService:Get()
	for _, instance in ipairs(selected) do
		if instance and instance.Parent then
			if instance:IsA("Decal") or instance:IsA("Texture") then
				for _, propertyName in ipairs({ "Texture", "ColorMapContent", "TextureContent" }) do
					local ok, value = pcall(function()
						return instance[propertyName]
					end)
					local imageText = ok and imageTextFromValue(value) or nil
					if imageText then
						return imageText
					end
				end
			elseif instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
				local ok, value = pcall(function()
					return instance.Image
				end)
				local imageText = ok and imageTextFromValue(value) or nil
				if imageText then
					return imageText
				end
			end
		end
	end
	return nil
end

local function clearPresetCards(list)
	if not list then
		return
	end
	for _, child in ipairs(list:GetChildren()) do
		if child.Name == "FacePresetCard" then
			child:Destroy()
		end
	end
end

local function clearFloatingPresetMenus(rootCard)
	if not rootCard then
		return
	end
	for _, child in ipairs(rootCard:GetChildren()) do
		if child.Name == "FacePresetFolderMenu" then
			child:Destroy()
		end
	end
end

local function clearFolderButtons(list)
	if not list then
		return
	end
	for _, child in ipairs(list:GetChildren()) do
		if child.Name == "FaceFolderButton" or child.Name == "FaceFolderDropdownOption" then
			child:Destroy()
		end
	end
end

local function clearPresetFolderOptions(list)
	if not list then
		return
	end
	for _, child in ipairs(list:GetChildren()) do
		if child.Name == "FacePresetFolderOption" then
			child:Destroy()
		end
	end
end

local function isPresetModalOpen(controller)
	return controller
		and controller._facesPresetModal
		and controller._facesPresetModal.Visible == true
end

local function getPresetModalState(controller)
	if controller and controller._facesPresetModalRefs then
		return controller._facesPresetModalRefs
	end
	return controller
end

local function getPresetActionCallbacks(controller, state)
	if controller and controller._callbacks then
		return controller._callbacks
	end
	if state and state._callbacks then
		return state._callbacks
	end
	return nil
end

local function setButtonSelected(button, selected)
	if not button then
		return
	end
	button.BackgroundColor3 = selected and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	button.TextColor3 = selected and Constants.THEME.Text or Constants.THEME.MutedText
end

local function cloneLayerTransforms(rawTransforms)
	local transforms = {}
	if type(rawTransforms) ~= "table" then
		return transforms
	end
	for _, layerInfo in ipairs(LAYER_LABELS) do
		local raw = rawTransforms[layerInfo.key]
		if type(raw) == "table" then
			local x = math.clamp(tonumber(raw.X or raw.x) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
			local y = math.clamp(tonumber(raw.Y or raw.y) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
			local scale = math.clamp(tonumber(raw.Scale or raw.scale) or 1, LAYER_SCALE_MIN, LAYER_SCALE_MAX)
			transforms[layerInfo.key] = {
				X = x,
				Y = y,
				Scale = scale,
			}
		end
	end
	return transforms
end

local function getLayerTransform(controller, layerName)
	controller._facesLayerTransforms = controller._facesLayerTransforms or {}
	local transform = controller._facesLayerTransforms[layerName]
	if type(transform) ~= "table" then
		transform = {
			X = 0,
			Y = 0,
			Scale = 1,
		}
		controller._facesLayerTransforms[layerName] = transform
	end
	transform.X = math.clamp(tonumber(transform.X) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
	transform.Y = math.clamp(tonumber(transform.Y) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
	transform.Scale = math.clamp(tonumber(transform.Scale) or 1, LAYER_SCALE_MIN, LAYER_SCALE_MAX)
	return transform
end

local function getLayerTransformTargets(layerName)
	local group = LAYER_TRANSFORM_GROUPS[layerName]
	if type(group) == "table" then
		return group
	end
	return { layerName }
end

local function getLayerPickerLabel(layerName)
	for _, layerInfo in ipairs(LAYER_PICKER_LABELS) do
		if layerInfo.key == layerName then
			return layerInfo.label
		end
	end
	return tostring(layerName or "Layer")
end

local function transformsMatch(a, b)
	return type(a) == "table"
		and type(b) == "table"
		and math.abs((tonumber(a.X) or 0) - (tonumber(b.X) or 0)) &lt;= TRANSFORM_EPSILON
		and math.abs((tonumber(a.Y) or 0) - (tonumber(b.Y) or 0)) &lt;= TRANSFORM_EPSILON
		and math.abs((tonumber(a.Scale) or 1) - (tonumber(b.Scale) or 1)) &lt;= TRANSFORM_EPSILON
end

local function collectLayerTransforms(controller)
	local transforms = {}
	local hasTransforms = false
	for _, layerInfo in ipairs(LAYER_LABELS) do
		local transform = type(controller._facesLayerTransforms) == "table" and controller._facesLayerTransforms[layerInfo.key] or nil
		if type(transform) == "table" then
			local x = math.clamp(tonumber(transform.X) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
			local y = math.clamp(tonumber(transform.Y) or 0, -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
			local scale = math.clamp(tonumber(transform.Scale) or 1, LAYER_SCALE_MIN, LAYER_SCALE_MAX)
			if math.abs(x) &gt; TRANSFORM_EPSILON or math.abs(y) &gt; TRANSFORM_EPSILON or math.abs(scale - 1) &gt; TRANSFORM_EPSILON then
				transforms[layerInfo.key] = {
					X = math.floor(x * 1000 + 0.5) / 1000,
					Y = math.floor(y * 1000 + 0.5) / 1000,
					Scale = math.floor(scale * 1000 + 0.5) / 1000,
				}
				hasTransforms = true
			end
		end
	end
	return hasTransforms and transforms or nil
end

local function updateLayerTransformControls(controller)
	if not controller then
		return
	end
	local selectedLayer = controller._facesSelectedLayerTransform or "Mouth"
	controller._facesSelectedLayerTransform = selectedLayer
	for layerName, button in pairs(controller._facesLayerTransformButtons or {}) do
		setButtonSelected(button, layerName == selectedLayer)
	end
	if controller._facesLayerTransformStatus then
		local targets = getLayerTransformTargets(selectedLayer)
		local firstTransform = getLayerTransform(controller, targets[1])
		local mixed = false
		for index = 2, #targets do
			if not transformsMatch(firstTransform, getLayerTransform(controller, targets[index])) then
				mixed = true
				break
			end
		end
		controller._facesLayerTransformStatus.Text = mixed
			and string.format("%s  Mixed", getLayerPickerLabel(selectedLayer))
			or string.format(
				"%s  X %.2f  Y %.2f",
				getLayerPickerLabel(selectedLayer),
				firstTransform.X,
				firstTransform.Y
			)
	end
end

local function selectLayerTransform(controller, layerName)
	controller._facesSelectedLayerTransform = layerName or controller._facesSelectedLayerTransform or "Mouth"
	updateLayerTransformControls(controller)
	FacesView.renderModalPreview(controller)
end

local function adjustLayerTransform(controller, deltaX, deltaY, deltaScale)
	local layerName = controller._facesSelectedLayerTransform or "Mouth"
	for _, targetLayer in ipairs(getLayerTransformTargets(layerName)) do
		local transform = getLayerTransform(controller, targetLayer)
		transform.X = math.clamp(transform.X + (deltaX or 0), -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
		transform.Y = math.clamp(transform.Y + (deltaY or 0), -LAYER_OFFSET_LIMIT, LAYER_OFFSET_LIMIT)
		transform.Scale = math.clamp(transform.Scale + (deltaScale or 0), LAYER_SCALE_MIN, LAYER_SCALE_MAX)
	end
	updateLayerTransformControls(controller)
	FacesView.renderModalPreview(controller)
end

local function resetLayerTransform(controller)
	local layerName = controller._facesSelectedLayerTransform or "Mouth"
	controller._facesLayerTransforms = controller._facesLayerTransforms or {}
	for _, targetLayer in ipairs(getLayerTransformTargets(layerName)) do
		controller._facesLayerTransforms[targetLayer] = {
			X = 0,
			Y = 0,
			Scale = 1,
		}
	end
	updateLayerTransformControls(controller)
	FacesView.renderModalPreview(controller)
end

local function collectModalPreset(controller)
	local presetType = controller._facesPresetType or "Single"
	local raw = {
		Id = controller._facesEditingPresetId,
		Name = controller._facesPresetNameInput and controller._facesPresetNameInput.Text or "",
		Type = presetType,
	}

	if presetType == "Layered" then
		raw.Layers = {}
		for _, layerInfo in ipairs(LAYER_LABELS) do
			local input = controller._facesLayerInputs and controller._facesLayerInputs[layerInfo.key]
			raw.Layers[layerInfo.key] = input and input.Text or ""
		end
		raw.LayerTransforms = collectLayerTransforms(controller)
	else
		raw.ImageId = controller._facesSingleImageInput and controller._facesSingleImageInput.Text or ""
	end

	return raw
end

local function makeFolderChoices(folders, includeAll)
	local choices = {}
	if includeAll then
		table.insert(choices, { Id = "All", Name = "All Faces" })
	end
	table.insert(choices, { Id = "Unsorted", Name = "Unsorted" })
	for _, folder in ipairs(folders or {}) do
		table.insert(choices, {
			Id = folder.Id,
			Name = folder.Name,
		})
	end
	return choices
end

function FacesView.setPresetFormType(controller, presetType)
	local state = getPresetModalState(controller)
	if not state then
		return
	end
	state._facesPresetType = presetType == "Layered" and "Layered" or "Single"
	setButtonSelected(state._facesSingleTypeButton, state._facesPresetType == "Single")
	setButtonSelected(state._facesLayeredTypeButton, state._facesPresetType == "Layered")

	if state._facesSingleRow then
		state._facesSingleRow.Visible = state._facesPresetType == "Single"
	end
	for _, row in pairs(state._facesLayerRows or {}) do
		row.Visible = state._facesPresetType == "Layered"
	end
	if state._facesLayerTransformFrame then
		state._facesLayerTransformFrame.Visible = state._facesPresetType == "Layered"
	end
	updateLayerTransformControls(state)
	FacesView.renderModalPreview(state)
end

function FacesView.renderModalPreview(controller)
	local state = getPresetModalState(controller)
	if not state or not state._facesPresetPreviewFrame then
		return
	end
	local preset = collectModalPreset(state)
	FacePreviewRenderer.render(state._facesPresetPreviewFrame, preset, {
		large = true,
	})
	local callbacks = getPresetActionCallbacks(controller, state)
	if callbacks and callbacks.onFacesAction and state._facesPresetModal and state._facesPresetModal.Visible == true then
		callbacks.onFacesAction("previewPresetDraft", preset)
	end
end

function FacesView.openLargePreview(controller)
	local state = getPresetModalState(controller)
	if not state or not state._facesLargePreviewModal or not state._facesLargePreviewFrame then
		return
	end

	local preset = collectModalPreset(state)
	if state._facesLargePreviewTitle then
		local name = tostring(preset.Name or "")
		state._facesLargePreviewTitle.Text = name ~= "" and ("Preview: " .. name) or "Face Preview"
	end
	if state._facesLargePreviewHint then
		state._facesLargePreviewHint.Text = preset.Type == "Layered"
			and "Layered preview uses the same approximate positions as preset cards."
			or "Single decal preview uses a grey canvas so light face details stay visible."
	end
	FacePreviewRenderer.render(state._facesLargePreviewFrame, preset, {
		large = true,
	})
	state._facesLargePreviewModal.Visible = true
end

function FacesView.closeLargePreview(controller)
	local state = getPresetModalState(controller)
	if state and state._facesLargePreviewModal then
		state._facesLargePreviewModal.Visible = false
	end
end

function FacesView.closeDeleteConfirmation(controller)
	if controller and controller._facesConfirmOverlay then
		controller._facesConfirmOverlay.Visible = false
		confirmActions[controller._facesConfirmOverlay] = nil
	end
	if controller then
		controller._facesConfirmAction = nil
	end
end

function FacesView.openDeleteConfirmation(controller, options)
	if not controller or not controller._facesConfirmOverlay then
		return false
	end
	options = options or {}
	local confirmAction = type(options.onConfirm) == "function" and options.onConfirm or nil
	controller._facesConfirmAction = confirmAction
	confirmActions[controller._facesConfirmOverlay] = confirmAction
	if controller._facesConfirmTitle then
		controller._facesConfirmTitle.Text = tostring(options.title or "Delete face item?")
	end
	if controller._facesConfirmMessage then
		controller._facesConfirmMessage.Text = tostring(options.message or "This cannot be undone.")
	end
	if controller._facesConfirmDeleteButton then
		controller._facesConfirmDeleteButton.Text = tostring(options.confirmText or "Delete")
		controller._facesConfirmDeleteButton.BackgroundColor3 = options.danger == false
			and Constants.THEME.Accent
			or (Constants.THEME.Danger or Color3.fromRGB(190, 72, 100))
	end
	controller._facesConfirmOverlay.Visible = true
	return true
end

function FacesView.openSelectionImport(controller, preview, onImport)
	return FaceSelectionImportUI.open(
		controller and controller._facesSelectionImportUi,
		preview,
		onImport
	)
end

function FacesView.closeSelectionImport(controller)
	FaceSelectionImportUI.close(controller and controller._facesSelectionImportUi)
end

function FacesView.confirmDeleteSelectedFolder(controller, onConfirm)
	local folderId = controller and controller._facesSelectedFolderId or nil
	if folderId == "All" or folderId == "Unsorted" or folderId == nil then
		if type(onConfirm) == "function" then
			onConfirm()
		end
		return
	end
	local folderName = controller._facesSelectedFolderName or "Selected Folder"
	FacesView.openDeleteConfirmation(controller, {
		title = "Delete face folder?",
		message = string.format(
			"Delete '%s'? This cannot be undone. Presets in this folder will be moved to Unsorted.",
			tostring(folderName)
		),
		confirmText = "Delete Folder",
		onConfirm = onConfirm,
	})
end

function FacesView.openPresetModal(controller, preset)
	local state = getPresetModalState(controller)
	if not state or not state._facesPresetModal then
		return
	end

	state._facesEditingPresetId = type(preset) == "table" and preset.Id or nil
	state._facesEditingFolderId = type(preset) == "table" and preset.FolderId or controller._facesSelectedFolderId
	state._facesSelectedFolderId = controller._facesSelectedFolderId
	state._facesSelectedFolderName = controller._facesSelectedFolderName
	state._facesFolderNameById = controller._facesFolderNameById
	if state._facesPresetModalBlocker then
		state._facesPresetModalBlocker.Visible = true
	end
	state._facesPresetModal.Visible = true
	if state._facesPresetNameInput then
		state._facesPresetNameInput.Text = type(preset) == "table" and tostring(preset.Name or "") or ""
	end
	if state._facesSingleImageInput then
		state._facesSingleImageInput.Text = type(preset) == "table" and tostring(preset.ImageId or "") or ""
	end
	for _, layerInfo in ipairs(LAYER_LABELS) do
		local input = state._facesLayerInputs and state._facesLayerInputs[layerInfo.key]
		if input then
			input.Text = type(preset) == "table" and type(preset.Layers) == "table" and tostring(preset.Layers[layerInfo.key] or "") or ""
		end
	end
	state._facesLayerTransforms = cloneLayerTransforms(type(preset) == "table" and preset.LayerTransforms or nil)
	state._facesSelectedLayerTransform = "Mouth"

	FacesView.setPresetFormType(state, type(preset) == "table" and preset.Type or "Single")
	if state._facesPresetFolderLabel then
		local folderId = state._facesEditingFolderId
		if folderId == nil and type(preset) == "table" then
			folderId = "Unsorted"
		end
		folderId = folderId or controller._facesSelectedFolderId or "All"
		local folderNames = controller._facesFolderNameById or {}
		state._facesPresetFolderLabel.Text = "Folder: " .. tostring(folderNames[folderId] or controller._facesSelectedFolderName or "All Faces")
	end
end

function FacesView.closePresetModal(controller)
	local state = getPresetModalState(controller)
	local callbacks = getPresetActionCallbacks(controller, state)
	if callbacks and callbacks.onFacesAction then
		callbacks.onFacesAction("endPresetDraftPreview")
	end
	if state and state._facesPresetModal then
		state._facesPresetModal.Visible = false
	end
	if state and state._facesPresetModalBlocker then
		state._facesPresetModalBlocker.Visible = false
	end
	FacesView.closeLargePreview(state)
	if state then
		state._facesEditingPresetId = nil
		state._facesEditingFolderId = nil
	end
end

function FacesView.collectPresetForm(controller)
	local state = getPresetModalState(controller)
	local preset = collectModalPreset(state)
	preset.FolderId = state._facesEditingFolderId or controller._facesSelectedFolderId
	return preset
end

local function createPresetCard(controller, list, preset, index)
	local rootCard = controller._facesCard or list
	local card = create("TextButton", {
		Name = "FacePresetCard",
		Parent = list,
		AutoButtonColor = true,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		LayoutOrder = index,
		Text = "",
		ZIndex = 143,
	})
	createCorner(card, 12)
	createStroke(card, Constants.THEME.Border, 1)

	local preview = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 0, 10),
		Size = UDim2.new(0, 70, 0, 70),
		ZIndex = 144,
	})
	FacePreviewRenderer.render(preview, preset)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 90, 0, 12),
		Size = UDim2.new(1, -132, 0, 22),
		Text = tostring(preset.Name or "Face"),
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 144,
	})

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 90, 0, 36),
		Size = UDim2.new(1, -100, 0, 34),
		Text = preset.Type == "Layered" and "Layered face preset" or "Single face decal",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 144,
	})

	local applyButton = makeButton(card, "Apply", UDim2.new(0, 90, 1, -32), UDim2.new(0, 50, 0, 24), true)
	local editButton = makeButton(card, "Edit", UDim2.new(0, 146, 1, -32), UDim2.new(0, 40, 0, 24), false)
	local copyButton = makeButton(card, "Copy", UDim2.new(0, 192, 1, -32), UDim2.new(0, 46, 0, 24), false)
	local moveButton = makeButton(card, "Move", UDim2.new(0, 244, 1, -32), UDim2.new(0, 56, 0, 24), false)
	moveButton.Font = Enum.Font.GothamSemibold
	moveButton.Text = "Move"
	moveButton.TextSize = 11
	moveButton.TextTransparency = 0
	moveButton.TextXAlignment = Enum.TextXAlignment.Center
	moveButton.TextYAlignment = Enum.TextYAlignment.Center
	local moveIcon = moveButton:FindFirstChild("MegMoButtonIcon")
	if moveIcon then
		moveIcon:Destroy()
	end
	local moveIconPadding = moveButton:FindFirstChild("MegMoButtonIconPadding")
	if moveIconPadding then
		moveIconPadding:Destroy()
	end
	local moveTextOverlay = moveButton:FindFirstChild("MegMoButtonTextOverlay")
	if moveTextOverlay and moveTextOverlay:IsA("TextLabel") then
		moveTextOverlay.Position = UDim2.fromScale(0, 0)
		moveTextOverlay.Size = UDim2.fromScale(1, 1)
		moveTextOverlay.Text = "Move"
		moveTextOverlay.TextSize = 11
		moveTextOverlay.TextXAlignment = Enum.TextXAlignment.Center
		moveTextOverlay.TextYAlignment = Enum.TextYAlignment.Center
	end
	local deleteButton = makeButton(card, "X", UDim2.new(1, -34, 0, 10), UDim2.new(0, 24, 0, 24), false)
	deleteButton.BackgroundColor3 = Constants.THEME.Danger or Color3.fromRGB(190, 72, 100)

	local destinationMenu = create("ScrollingFrame", {
		Name = "FacePresetFolderMenu",
		Parent = rootCard,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 142, 1, -4),
		ScrollBarThickness = 4,
		Size = UDim2.new(0, 158, 0, 126),
		Visible = false,
		ZIndex = 210,
	})
	createCorner(destinationMenu, 10)
	createStroke(destinationMenu)
	create("UIListLayout", {
		Parent = destinationMenu,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = destinationMenu,
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
	})

	local callbacks = controller._callbacks or {}
	local function applyPreset()
		if isPresetModalOpen(controller) then
			return
		end
		if callbacks.onFacesAction then
			callbacks.onFacesAction("applyPreset", preset.Id)
		end
	end
	card.Activated:Connect(function()
		applyPreset()
	end)
	applyButton.Activated:Connect(function()
		applyPreset()
	end)
	editButton.Activated:Connect(function()
		if isPresetModalOpen(controller) then
			return
		end
		FacesView.openPresetModal(controller, preset)
	end)
	deleteButton.Activated:Connect(function()
		if isPresetModalOpen(controller) then
			return
		end
		FacesView.openDeleteConfirmation(controller, {
			title = "Delete face preset?",
			message = string.format(
				"Delete '%s'? This preset will be removed from your saved Faces list and cannot be undone.",
				tostring(preset.Name or "Face")
			),
			confirmText = "Delete Preset",
			onConfirm = function()
				if callbacks.onFacesAction then
					callbacks.onFacesAction("deletePreset", preset.Id)
				end
			end,
		})
	end)

	local function addDestinationOption(label, action, payload, order)
		local button = create("TextButton", {
			Name = "FacePresetFolderOption",
			Parent = destinationMenu,
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 26),
			Text = label,
			TextColor3 = Constants.THEME.Text,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 211,
		})
		createCorner(button, 7)
		create("UIPadding", {
			Parent = button,
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		})
		button.Activated:Connect(function()
			if isPresetModalOpen(controller) then
				return
			end
			destinationMenu.Visible = false
			if callbacks.onFacesAction then
				callbacks.onFacesAction(action, payload)
			end
		end)
	end

	local function showDestinationMenu(mode)
		if isPresetModalOpen(controller) then
			return
		end
		clearPresetFolderOptions(destinationMenu)
		local order = 1
		if mode == "copy" then
			addDestinationOption("Duplicate here", "duplicatePreset", preset.Id, order)
			order += 1
		end
		for _, folder in ipairs(controller._facesMoveFolderChoices or makeFolderChoices({}, false)) do
			local folderName = tostring(folder.Name or "Folder")
			addDestinationOption(
				(mode == "copy" and "Copy to " or "Move to ") .. folderName,
				mode == "copy" and "copyPresetToFolder" or "movePresetToFolder",
				{
					presetId = preset.Id,
					folderId = folder.Id,
				},
				order
			)
			order += 1
		end
		local visibleRows = math.min(math.max(order - 1, 1), 5)
		local menuHeight = visibleRows * 30 + 12
		destinationMenu.Size = UDim2.new(0, 158, 0, menuHeight)
		local anchor = mode == "copy" and copyButton or moveButton
		local rootPosition = rootCard.AbsolutePosition
		local anchorPosition = anchor.AbsolutePosition
		local x = math.max(12, anchorPosition.X - rootPosition.X)
		local y = math.max(12, anchorPosition.Y - rootPosition.Y + anchor.AbsoluteSize.Y + 4)
		local maxX = math.max(12, rootCard.AbsoluteSize.X - 170)
		local maxY = math.max(12, rootCard.AbsoluteSize.Y - menuHeight - 12)
		destinationMenu.Position = UDim2.fromOffset(math.min(x, maxX), math.min(y, maxY))
		destinationMenu.Visible = not destinationMenu.Visible
	end

	copyButton.Activated:Connect(function()
		showDestinationMenu("copy")
	end)
	moveButton.Activated:Connect(function()
		showDestinationMenu("move")
	end)
end

function FacesView.render(controller, viewModel)
	viewModel = viewModel or {}
	controller._facesSelectedFolderId = viewModel.selectedFolderId or "All"
	controller._facesSelectedFolderName = "All Faces"

	if controller._facesStatusLabel then
		local presetCount = tonumber(viewModel.allPresetCount) or 0
		local statusText = viewModel.status or string.format("%d saved face preset%s.", presetCount, presetCount == 1 and "" or "s")
		local targetRigName = tostring(viewModel.targetRigName or "")
		if targetRigName ~= "" then
			statusText = "Target: " .. targetRigName .. "\n" .. statusText
		end
		controller._facesStatusLabel.Text = statusText
	end
	if controller._facesSearchInput and UserInputService:GetFocusedTextBox() ~= controller._facesSearchInput then
		controller._facesSearchInput.Text = tostring(viewModel.searchText or "")
	end
	if controller._facesFadeDurationInput and UserInputService:GetFocusedTextBox() ~= controller._facesFadeDurationInput then
		controller._facesFadeDurationInput.Text = string.format("%.2f", tonumber(viewModel.fadeTime) or 0.15)
	end
	if controller._facesTransitionScopeLabel then
		local selectedCount = tonumber(viewModel.selectedFaceKeyCount) or 0
		if viewModel.editingSelectedFaceKey then
			controller._facesTransitionScopeLabel.Text = selectedCount &gt; 1 and string.format("Editing %d keys", selectedCount) or "Editing selected key"
			controller._facesTransitionScopeLabel.TextColor3 = Constants.THEME.Accent
		else
			controller._facesTransitionScopeLabel.Text = "New keyframes"
			controller._facesTransitionScopeLabel.TextColor3 = Constants.THEME.MutedText
		end
	end
	setButtonSelected(controller._facesInstantButton, viewModel.transition ~= "CrossFade")
	setButtonSelected(controller._facesCrossFadeButton, viewModel.transition == "CrossFade")
	if controller._facesFolderNameInput and UserInputService:GetFocusedTextBox() ~= controller._facesFolderNameInput then
		controller._facesFolderNameInput.Text = ""
	end
	local folderChoices = makeFolderChoices(viewModel.folders or {}, true)
	controller._facesFolderChoices = folderChoices
	controller._facesMoveFolderChoices = makeFolderChoices(viewModel.folders or {}, false)
	controller._facesFolderNameById = {}
	for _, folder in ipairs(folderChoices) do
		controller._facesFolderNameById[folder.Id] = folder.Name
		if folder.Id == controller._facesSelectedFolderId then
			controller._facesSelectedFolderName = folder.Name
		end
	end
	if controller._facesFolderDropdownButton then
		controller._facesFolderDropdownButton.Text = tostring(controller._facesSelectedFolderName or "All Faces") .. "  v"
	end
	if controller._facesFolderDropdownMenu then
		clearFolderButtons(controller._facesFolderDropdownMenu)
		local callbacks = controller._callbacks or {}
		for index, folder in ipairs(folderChoices) do
			local button = create("TextButton", {
				Name = "FaceFolderDropdownOption",
				Parent = controller._facesFolderDropdownMenu,
				AutoButtonColor = true,
				BackgroundColor3 = folder.Id == controller._facesSelectedFolderId and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamSemibold,
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, 28),
				Text = tostring(folder.Name or "Folder"),
				TextColor3 = Constants.THEME.Text,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 191,
			})
			createCorner(button, 8)
			create("UIPadding", {
				Parent = button,
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
			})
			button.Activated:Connect(function()
				controller._facesFolderDropdownMenu.Visible = false
				if callbacks.onFacesAction then
					callbacks.onFacesAction("selectFolder", folder.Id)
				end
			end)
		end
		local visibleRows = math.min(math.max(#folderChoices, 1), 6)
		controller._facesFolderDropdownMenu.Size = UDim2.new(0, 196, 0, visibleRows * 30 + 12)
	end

	local list = controller._facesPresetList
	if not list then
		return
	end

	clearPresetCards(list)
	clearFloatingPresetMenus(controller._facesCard)
	local presets = viewModel.presets or {}
	if controller._facesEmptyLabel then
		controller._facesEmptyLabel.Visible = #presets == 0
	end
	for index, preset in ipairs(presets) do
		createPresetCard(controller, list, preset, index)
	end
end

function FacesView.mount(parent, context)
	if not parent then
		error("FacesView.mount requires parent")
	end
	context = context or {}
	local embeddedPopup = context.embeddedPopup == true
	local hideHeader = context.hideHeader == true
	local hideCloseButton = context.hideCloseButton == true
	local topOffset = hideHeader and -56 or 0

	local refs = {}
	local overlay = create("Frame", {
		Name = "FacesOverlay",
		Parent = parent,
		BackgroundColor3 = Color3.fromRGB(3, 6, 12),
		BackgroundTransparency = embeddedPopup and 1 or 0.18,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 140,
	})

	local card = create("Frame", {
		Parent = overlay,
		AnchorPoint = embeddedPopup and Vector2.new(0, 0) or Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = embeddedPopup and UDim2.fromOffset(0, 0) or UDim2.fromScale(0.5, 0.5),
		Size = embeddedPopup and UDim2.fromScale(1, 1) or UDim2.new(0.88, 0, 0.82, 0),
		ZIndex = 141,
	})
	if embeddedPopup then
		applyPanelSurface(card)
	else
		createCorner(card, 16)
		createStroke(card)
	end

	local titleLabel = makeHeader(card, "Faces", UDim2.new(0, 22, 0, 18 + topOffset), UDim2.new(0, 220, 0, 28))
	local descriptionLabel = makeLabel(
		card,
		"Save reusable face presets, preview them, then click a preset to add a face keyframe at the current timeline time.",
		UDim2.new(0, 22, 0, 48 + topOffset),
		UDim2.new(1, -68, 0, 36),
		12
	)
	titleLabel.Visible = not hideHeader
	descriptionLabel.Visible = not hideHeader

	local closeButton = makeButton(card, "X", UDim2.new(1, -48, 0, 16 + topOffset), UDim2.new(0, 34, 0, 34), false)
	closeButton.Font = Enum.Font.GothamBold
	closeButton.Visible = not hideCloseButton

	local addButton = makeButton(card, "+ Preset", UDim2.new(0, 22, 0, 86 + topOffset), UDim2.new(0, 96, 0, 32), true)
	local importSelectionButton = makeButton(card, "From Model", UDim2.new(0, 124, 0, 86 + topOffset), UDim2.new(0, 96, 0, 32), false)
	local searchInput = makeInput(card, "Search faces...", UDim2.new(0, 226, 0, 86 + topOffset), UDim2.new(1, -520, 0, 32))
	local recoverPresetsButton = makeButton(card, "Recover", UDim2.new(1, -282, 0, 86 + topOffset), UDim2.new(0, 86, 0, 32), false)
	local importPresetsButton = makeButton(card, "Import", UDim2.new(1, -190, 0, 86 + topOffset), UDim2.new(0, 78, 0, 32), false)
	local exportPresetsButton = makeButton(card, "Export", UDim2.new(1, -106, 0, 86 + topOffset), UDim2.new(0, 84, 0, 32), false)
	local compactToolsButton = makeButton(card, "Tools v", UDim2.new(1, -112, 0, 86 + topOffset), UDim2.new(0, 90, 0, 32), false)
	compactToolsButton.Visible = false
	makePlainTextButton(importSelectionButton)
	makePlainTextButton(recoverPresetsButton)
	makePlainTextButton(importPresetsButton)
	makePlainTextButton(exportPresetsButton)
	makePlainTextButton(compactToolsButton)

	local folderPanel = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 22, 0, 128 + topOffset),
		Size = UDim2.new(1, -44, 0, 56),
		ZIndex = 142,
	})
	createCorner(folderPanel, 12)
	createStroke(folderPanel)
	makeLabel(folderPanel, "Folder", UDim2.new(0, 14, 0, 8), UDim2.new(0, 70, 0, 16), 11)

	local folderDropdownButton = makeButton(folderPanel, "All Faces  v", UDim2.new(0, 14, 0, 26), UDim2.new(0, 196, 0, 26), false)
	folderDropdownButton.TextXAlignment = Enum.TextXAlignment.Left
	local folderDropdownMenu = create("ScrollingFrame", {
		Parent = card,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 36, 0, 182 + topOffset),
		ScrollBarThickness = 4,
		Size = UDim2.new(0, 196, 0, 132),
		Visible = false,
		ZIndex = 190,
	})
	createCorner(folderDropdownMenu, 10)
	createStroke(folderDropdownMenu)
	create("UIListLayout", {
		Parent = folderDropdownMenu,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = folderDropdownMenu,
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
	})
	folderDropdownButton.Activated:Connect(function()
		folderDropdownMenu.Visible = not folderDropdownMenu.Visible
	end)

	local folderNameInput = makeInput(folderPanel, "New / selected folder name", UDim2.new(0, 224, 0, 26), UDim2.new(1, -452, 0, 26))
	local addFolderButton = makeButton(folderPanel, "+ Folder", UDim2.new(1, -218, 0, 26), UDim2.new(0, 76, 0, 26), false)
	local renameFolderButton = makeButton(folderPanel, "Rename", UDim2.new(1, -136, 0, 26), UDim2.new(0, 66, 0, 26), false)
	local deleteFolderButton = makeButton(folderPanel, "Delete", UDim2.new(1, -64, 0, 26), UDim2.new(0, 54, 0, 26), false)
	deleteFolderButton.BackgroundColor3 = Constants.THEME.Danger or Color3.fromRGB(190, 72, 100)

	local transitionPanel = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 22, 0, 190 + topOffset),
		Size = UDim2.new(0, 360, 0, 54),
		ZIndex = 142,
	})
	createCorner(transitionPanel, 12)
	createStroke(transitionPanel)
