local function captureTrackAtPlayhead(path)
	local success, track, capturedKeys, message = require(Modules:WaitForChild("CaptureFrameActionSupport")).captureTrackAtPlayhead({
		captureSelectionSupport = require(Modules:WaitForChild("CaptureSelectionSupport")),
		changeHistoryService = ChangeHistoryService,
		discardPendingUndo = function()
			historyService:discardPendingUndo()
		end,
		path = path,
		pushUndo = pushUndo,
		timeline = timeline,
	})
	if not success then
		refreshUi(message)
		return
	end

	selectedJointPath = path
	selectedTrackPaths = {}
	selectedTrackPaths[path] = true
	selectKeys(capturedKeys)
	enableMoveGizmoForKeySelection()
	refreshUi(message)
end

local function addDefaultPoseKeyframes(selectedOnly)
	if #timeline:getMotors() == 0 then
		refreshUi("Bind a rig before adding default pose keyframes.")
		return
	end

	local success, message, changedKeys, failureKind = require(Modules:WaitForChild("PoseKeyframeActionSupport")).applyDefaultPose({
		changeHistoryService = ChangeHistoryService,
		getSelectedKeyRefs = getSelectedKeyRefs,
		getSelectedTrackPaths = getSelectedTrackPaths,
		pushUndo = pushUndo,
		selectedJointPath = selectedJointPath,
		selectedOnly = selectedOnly,
		timeline = timeline,
	})
	if failureKind == "precondition" then
		refreshUi(message)
		return
	end

	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not add default pose keyframes.")
		return
	end

	if changedKeys and #changedKeys &gt; 0 then
		selectKeys(changedKeys)
	end
	if not selectedOnly then
		clearSelectedTracks()
	end
	timeline:applyCurrentFrame()
	if editorActions._trackballTool and type(editorActions._trackballTool.SyncToCurrentPose) == "function" then
		editorActions._trackballTool:SyncToCurrentPose()
	end
	refreshUi(message)
end

editorActions.defaultPoseKeyframes = addDefaultPoseKeyframes

local function mirrorSelectedKeyframes()
	local success, message, changedKeys, failureKind = require(Modules:WaitForChild("PoseKeyframeActionSupport")).applyMirrorOrInvert({
		action = function(activeTimeline, selectedKeyRefs)
			return keyframeEditService:mirrorSelectedKeys(activeTimeline, selectedKeyRefs)
		end,
		afterLabel = "After Mirror Keyframes",
		beforeLabel = "Before Mirror Keyframes",
		changeHistoryService = ChangeHistoryService,
		emptySelectionMessage = "Select one or more rig keyframes before mirroring.",
		getSelectedKeyRefs = getSelectedKeyRefs,
		pushUndo = pushUndo,
		timeline = timeline,
		undoLabel = "Mirror Keyframes",
	})
	if failureKind == "precondition" then
		refreshUi(message)
		return
	end

	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not mirror selected keyframes.")
		return
	end

	if changedKeys and #changedKeys &gt; 0 then
		selectKeys(changedKeys)
	end
	clearSelectedTracks()
	timeline:applyCurrentFrame()
	enableMoveGizmoForKeySelection()
	refreshUi(message)
end

editorActions.mirrorSelectedKeyframes = mirrorSelectedKeyframes

local function invertSelectedKeyframes()
	local success, message, changedKeys, failureKind = require(Modules:WaitForChild("PoseKeyframeActionSupport")).applyMirrorOrInvert({
		action = function(activeTimeline, selectedKeyRefs)
			return keyframeEditService:invertSelectedKeys(activeTimeline, selectedKeyRefs)
		end,
		afterLabel = "After Invert Keyframes",
		beforeLabel = "Before Invert Keyframes",
		changeHistoryService = ChangeHistoryService,
		emptySelectionMessage = "Select one or more rig keyframes before inverting.",
		getSelectedKeyRefs = getSelectedKeyRefs,
		pushUndo = pushUndo,
		timeline = timeline,
		undoLabel = "Invert Keyframes",
	})
	if failureKind == "precondition" then
		refreshUi(message)
		return
	end

	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not invert selected keyframes.")
		return
	end

	if changedKeys and #changedKeys &gt; 0 then
		selectKeys(changedKeys)
	end
	clearSelectedTracks()
	timeline:applyCurrentFrame()
	enableMoveGizmoForKeySelection()
	refreshUi(message)
end

editorActions.invertSelectedKeyframes = invertSelectedKeyframes

local function clearTimelineKeySelection()
	if not require(Modules:WaitForChild("PoseKeyframeActionSupport")).hasTimelineSelection(
		selectedKeys,
		selectedKeyframeFrame,
		selectedTrackPaths,
		selectedJointPath
	) then
		return
	end

	clearSelectedKeyframes()
	clearSelectedTracks()
	refreshUi("Deselected timeline selection.")
end

local function capturePoseFromViewport()
	require(Modules:WaitForChild("PoseKeyframeActionSupport")).capturePoseFromViewport({
		multiGizmoSelectionService = require(Modules:WaitForChild("MultiGizmoSelectionService")),
		selectedJointPath = selectedJointPath,
		selectedKeyframeFrame = selectedKeyframeFrame,
		selectedKeys = selectedKeys,
		selectedTrackPaths = selectedTrackPaths,
		selectKeys = selectKeys,
		selectionState = SelectionState,
		setSingleSelectedKey = setSingleSelectedKey,
		timeline = timeline,
	})
end

editorActions.captureTrackFrame = captureTrackAtPlayhead

local function applyCurrentFrame()
	if #timeline:getTracks() == 0 then
		refreshUi("Add a rig or object track before applying a frame.")
		return
	end

	ChangeHistoryService:SetWaypoint("Before Apply Keyframe")
	local success, message = timeline:applyCurrentFrame()
	ChangeHistoryService:SetWaypoint("After Apply Keyframe")
	refreshUi(message or (success and "Applied frame." or "Could not apply frame."))
end

require(Modules:WaitForChild("IKPrototypeBridgeService")).attach({
	changeHistoryService = ChangeHistoryService,
	clearSelectedTracks = clearSelectedTracks,
	eventParent = game:GetService("CoreGui"),
	pushUndo = pushUndo,
	refreshUi = refreshUi,
	selectKeys = selectKeys,
	timeline = timeline,
})

local function stopPlayback(message, snapFrame)
	playbackService:stop(message, snapFrame)
	if editorActions._trackballTool and type(editorActions._trackballTool.SetVisualSuppressed) == "function" then
		editorActions._trackballTool:SetVisualSuppressed(false)
	end
end

function editorActions.pausePlaybackAtCurrent(message)
	if not playbackService:getIsPlaying() then
		return false, "Playback is not running."
	end
	local currentFrame = playbackService:getPlaybackFrame() or timeline:getCurrentFrame()
	stopPlayback(message or "Paused playback.", currentFrame)
	return true, message or "Paused playback."
end

local function startPlayback(bakeOnly)
	if MotionService.getMotionPreviewState().isPreviewing then
		MotionService.stopMotionPreview(motionServiceDeps(), bakeOnly and "Stopped Motion Builder preview before baking timeline." or "Stopped Motion Builder preview before timeline playback.")
	end
	if bakeOnly then
		playbackService:bakePreview()
		return
	end
	if widgetController._onionSkinService then
		widgetController._onionSkinService:clear()
	end
	playbackService:start()
	if editorActions._trackballTool and type(editorActions._trackballTool.SetVisualSuppressed) == "function" then
		editorActions._trackballTool:SetVisualSuppressed(playbackService:getIsPlaying())
	end
	if widgetController._hideDuringPlaybackEnabled == true and playbackService:getIsPlaying() then
		widget:SetAttribute("MegMoHiddenForPlayback", true)
		setWidgetEnabled(false)
	end
end

editorActions.playPause = startPlayback

local handleFacesAction

do
	handleFacesAction = function(action, payload)
		local controller = widgetController._facesController
		local success = true
		local message = nil
		local result = nil
		if action == "search" then
			controller:setSearchText(payload)
		elseif action == "setTransition" then
			success, message = controller:setTransition(payload)
		elseif action == "setFadeTime" then
			success, message = controller:setFadeTime(payload)
		elseif action == "savePreset" then
			success, message = controller:savePreset(payload)
		elseif action == "deletePreset" then
			success, message = controller:deletePreset(payload)
		elseif action == "duplicatePreset" then
			success, message = controller:duplicatePreset(payload)
		elseif action == "movePresetToFolder" then
			success, message = controller:movePresetToFolder(payload)
		elseif action == "copyPresetToFolder" then
			success, message = controller:copyPresetToFolder(payload)
		elseif action == "exportPresets" then
			success, message = controller:exportPresetBackup()
		elseif action == "importPresets" then
			success, message = controller:importPresetBackup()
		elseif action == "recoverPresetsFromProject" then
			success, message = controller:recoverPresetsFromProject()
		elseif action == "scanSelectionPresets" then
			success, message, result = controller:scanSelectionForPresets()
		elseif action == "importSelectionPresets" then
			success, message, result = controller:importSelectionPresets(payload)
		elseif action == "applyPreset" then
			success, message = controller:applyPreset(payload)
		elseif action == "previewPresetDraft" then
			success, message = controller:previewPresetDraft(payload)
		elseif action == "endPresetDraftPreview" then
			success, message = controller:endPresetDraftPreview()
		elseif action == "selectFolder" then
			success, message = controller:selectFolder(payload)
		elseif action == "createFolder" then
			success, message = controller:createFolder(payload)
		elseif action == "renameFolder" then
			success, message = controller:renameSelectedFolder(payload)
		elseif action == "deleteFolder" then
			success, message = controller:deleteSelectedFolder()
		end
		refreshUi(message)
		return success, message, result
	end

	local microAttachAttempts = 0
	local function attachMicroWorkspace(reason)
		if microController then
			return true
		end
		microAttachAttempts += 1
		local uiFolder = Modules:FindFirstChild("UI")
		local microMainScript = uiFolder and uiFolder:FindFirstChild("MicroMain")
		if not microMainScript then
			warn("[7kg2 Micro] MicroMain module is missing from this build.")
			return false
		end

		local ok, message = pcall(function()
			microController = require(microMainScript).attach({
				plugin = plugin,
				toolbar = toolbar,
				constants = Constants,
				editorActions = editorActions,
				getTimeline = function()
					return timeline
				end,
				getIsPlaying = function()
					return playbackService and playbackService:getIsPlaying() or false
				end,
				getPlaybackFrame = function()
					return playbackService and playbackService:getPlaybackFrame() or nil
				end,
				onPausePlaybackAtCurrent = editorActions.pausePlaybackAtCurrent,
				onPreviewScrubToFrame = function(frame)
					local callback = editorActions._previewPlayhead
					if type(callback) == "function" then
						return callback(frame)
					end
					return false
				end,
				onScrubToFrame = function(frame)
					local callback = editorActions._setPlayhead
					if type(callback) == "function" then
						return callback(frame)
					end
					return false
				end,
				getEditorState = function()
					local recorder = editorActions._motionRecorder
					local trackballMode = editorActions._persistentTrackballMode or editorActions._requestedTrackballMode or editorActions._lastTrackballMode
					if editorActions._trackballTool
						and type(editorActions._trackballTool.IsActive) == "function"
						and editorActions._trackballTool:IsActive() then
						trackballMode = editorActions._lastTrackballMode or editorActions._persistentTrackballMode or trackballMode
					end
					return {
						autoSave = getAutoSaveViewModel(),
						gizmoMode = gizmoController and gizmoController:getMode() or nil,
						rotateSpace = gizmoController and gizmoController:getRotateSpace() or nil,
						trackballMode = trackballMode,
						trackballArmed = editorActions._persistentTrackballMode ~= nil,
						persistentTrackballActive = editorActions.isPersistentTrackballActive(),
						workspaceGrabActive = editorActions.isWorkspaceGrabActive
							and editorActions.isWorkspaceGrabActive()
							or false,
						hideDuringPlayback = widgetController._hideDuringPlaybackEnabled == true,
						moveSnap = gizmoController and gizmoController:getMoveSnap() or Constants.DEFAULT_MOVE_SNAP,
						rotateSnapDegrees = gizmoController and gizmoController:getRotateSnapDegrees() or Constants.DEFAULT_ROTATE_SNAP_DEGREES,
						gizmoSizePercent = gizmoController and gizmoController:getSizePercent() or Constants.DEFAULT_GIZMO_SIZE_PERCENT,
						selectedKeyOptions = getSelectedKeyOptions(),
						groups = keyframeEditService:getGroups(),
						selectedGroupIds = getSelectedGroupIds(),
						motionRecorder = {
							armed = recorder and recorder:IsArmed() or false,
							recording = recorder and recorder:IsRecording() or false,
						},
					}
				end,
				getMotionBuilderViewModel = function()
					return require(Modules:WaitForChild("MotionBuilderViewModelSupport")).build({
						timeline = timeline,
						motionService = MotionService,
						motionBuilderState = motionBuilderState,
						motionClipService = MotionClipService,
						importService = ImportService,
						importAnimationEntries = importAnimationEntries,
						motionRecipeEntries = motionRecipeEntries,
						motionRecipeStatus = motionRecipeStatus,
						selectedMotionRecipeName = selectedMotionRecipeName,
					})
				end,
				getSelectedTrackPaths = getSelectedTrackPaths,
				getSelectedKeyRefs = getSelectedKeyRefs,
				getEffectsViewModel = function()
					return widgetController._lastViewModel or {}
				end,
				getPerformanceViewModel = function()
					return PerformanceDebugService.getViewModel({
						trackCount = #timeline:getTracks(),
						keyframeCount = timeline:getKeyframeCount(),
						markerCount = #MotionService.listMotionMarkers(),
						isPlaying = playbackService and playbackService:getIsPlaying() or false,
						buildId = BuildInfo.BUILD_ID,
					})
				end,
				onTogglePerformanceDebug = togglePerformanceDebug,
				onAddKeyframe = applyCurrentFrame,
				onCaptureFrame = captureCurrentFrame,
				onCaptureTrackFrame = captureTrackAtPlayhead,
				onDefaultPoseKeyframes = addDefaultPoseKeyframes,
				onClearKeySelection = clearTimelineKeySelection,
				onResetPose = function()
					require(Modules:WaitForChild("ResetPoseActionService")).reset(timeline, ChangeHistoryService, refreshUi)
					if editorActions._trackballTool and type(editorActions._trackballTool.SyncToCurrentPose) == "function" then
						editorActions._trackballTool:SyncToCurrentPose()
					end
				end,
				onSelectKey = selectKey,
				onSelectKeySet = selectKeys,
				onToggleKeySet = toggleKeySet,
				onSelectTrack = editorActions.selectTrack,
				onMoveKeyToFrame = moveKeyToFrame,
				onSetSoundClipEndFrame = editorActions.setSoundClipEndFrame,
				onSetSubtitleClipEndFrame = editorActions.setSubtitleClipEndFrame,
				onSetFadeClipStartFrame = editorActions.setFadeClipStartFrame,
				onSetFadeClipEndFrame = editorActions.setFadeClipEndFrame,
				onMoveSelectedKeysByOffset = moveSelectedKeysByOffset,
				onMoveKeyRefsByOffset = moveKeyRefsByOffset,
				onSetSelectedGroupEditMode = setSelectedGroupEditMode,
				onEditSelectedGroupsAtPlayhead = editorActions.editSelectedGroupsAtPlayhead,
				onReverseSelectedGroups = editorActions.reverseSelectedGroups,
				onStretchGroupToFrame = stretchGroupToFrame,
				onRepeatGroupToFrame = repeatGroupToFrame,
				onMoveKeyframeLeft = function()
					if type(editorActions.moveKeyframeLeft) == "function" then
						return editorActions.moveKeyframeLeft()
					end
				end,
				onMoveKeyframeRight = function()
					if type(editorActions.moveKeyframeRight) == "function" then
						return editorActions.moveKeyframeRight()
					end
				end,
				onToggleTrackEnabled = editorActions.toggleTrackEnabled,
				onRemoveSelectedTrack = editorActions.removeSelectedTrack,
				onBindRig = addSelectedRigs,
				onBindMotionRig = editorActions.bindMotionBuilderRig,
				onInsertDefaultRig = insertDefaultRig,
				onInsertAvatarRig = insertAvatarRig,
				onAddMotionMarker = addMotionMarker,
				onDeleteMotionMarker = deleteMotionMarker,
				onSelectMotionMarker = selectMotionMarker,
				onClearMotionMarkers = clearMotionMarkers,
				onBakePreview = function()
					if playbackService then
						return playbackService:bakePreview()
					end
					return false, "Playback service is not ready yet."
				end,
				onCaptureCameraTrack = editorActions.captureCameraTrackAtPlayhead,
				onEnsureCameraFovTrack = editorActions.ensureCameraFovTrack,
				onApplyCameraFov = editorActions.applySelectedCameraFov,
				onApplyCameraRotation = editorActions.applyCameraRotation,
				onApplyCameraPreset = editorActions.applyCameraPreset,
				onSetTrackKeyEasing = editorActions.setTrackKeyEasing,
				onPreviewMotionPath = previewMotionPathFromMarkers,
				onPreviewMotionSegment = previewMotionSegment,
				onStopMotionPreview = stopMotionPreview,
				onCreateMotionAnimation = function()
					return createMotionAnimationFromMarkers()
				end,
				onSetMotionSegmentMotion = setMotionSegmentMotion,
				onSetMotionSegmentClip = setMotionSegmentClip,
				onSetMotionDefaultClip = setMotionDefaultClip,
				onSetMotionSegmentPauseIdle = setMotionSegmentPauseIdle,
				onSetMotionSegmentDuration = setMotionSegmentDuration,
				onSetMotionSegmentPause = setMotionSegmentPause,
				onSetMotionSegmentBlend = setMotionSegmentBlend,
				onResetMotionSegments = resetMotionSegments,
				onCycleEasingStyle = function(...)
					if type(editorActions.cycleSelectedEasingStyle) == "function" then
						return editorActions.cycleSelectedEasingStyle(...)
					end
				end,
				onCycleEasingDirection = function(...)
					if type(editorActions.cycleSelectedEasingDirection) == "function" then
						return editorActions.cycleSelectedEasingDirection(...)
					end
				end,
				onSetEasingStyle = function(...)
					if type(editorActions.setSelectedEasingStyle) == "function" then
						return editorActions.setSelectedEasingStyle(...)
					end
				end,
				onSetEasingDirection = function(...)
					if type(editorActions.setSelectedEasingDirection) == "function" then
						return editorActions.setSelectedEasingDirection(...)
					end
				end,
				onPlay = function()
					return startPlayback(false)
				end,
				onPlayPause = startPlayback,
				onPausePlaybackAtCurrent = editorActions.pausePlaybackAtCurrent,
				onToggleCameraTrackEnabled = editorActions.toggleCameraTrackEnabled,
				onStop = function()
					return stopPlayback("Stopped from Micro.", 0)
				end,
				onApplyAnimationEffect = function(effectId, options)
					local selectedKeyRefs = getSelectedKeyRefs()
					if #selectedKeyRefs == 0 then
						refreshUi("Select one or more keyframes before applying an animation effect.")
						return
					end

					pushUndo("Apply Animation Effect")
					ChangeHistoryService:SetWaypoint("Before Apply Animation Effect")
					local success, message, changedKeys = AnimationEffectsService.apply(timeline, selectedKeyRefs, effectId, options)
					ChangeHistoryService:SetWaypoint("After Apply Animation Effect")
					if success then
						selectKeys(changedKeys)
						timeline:applyCurrentFrame()
					else
						historyService:discardPendingUndo()
					end
					refreshUi(message)
					return success, message
				end,
				onRepeatFrames = function(repeatOptions)
					local selectedKeyRefs = getSelectedKeyRefs()
					if #selectedKeyRefs == 0 then
						refreshUi("Select keyframes before repeating.")
						return
					end

					pushUndo("Repeat Frames")
					ChangeHistoryService:SetWaypoint("Before Repeat Frames")
					local success, message, repeatedKeys = require(Modules:WaitForChild("RepeatFramesService")).repeatSelectedKeys(timeline, selectedKeyRefs, repeatOptions or {
						loopCount = "2",
					})
					if success then
						clearSelectedKeyframes()
						for _, key in ipairs(repeatedKeys or {}) do
							selectedKeys[SelectionState.makeTrackKeyId(key.jointPath, key.frame)] = {
								jointPath = key.jointPath,
								frame = key.frame,
							}
						end
						local selectedFrames = getSelectedKeyframeFrames()
						selectedKeyframeFrame = selectedFrames[#selectedFrames]
						timeline:applyCurrentFrame()
						ChangeHistoryService:SetWaypoint("After Repeat Frames")
					else
						historyService:discardPendingUndo()
					end
					refreshUi(message)
					return success, message
				end,
				onGetRepeatFrameDefaults = function()
					return require(Modules:WaitForChild("RepeatFramesService")).buildDefaults(timeline, getSelectedKeyRefs())
				end,
				onMoveTrackToFolder = editorActions.moveTrackToFolder,
				onMoveSelectedTracksToFolder = editorActions.moveSelectedTracksToFolder,
				onRenameTimelineFolder = editorActions.renameTimelineFolder,
				onSetTimelineFolderColor = editorActions.setTimelineFolderColor,
				onReorderTrack = editorActions.reorderTrack,
				onSetParticleEmitterPropertyKey = editorActions.setParticleEmitterPropertyKey,
				getTimeline = function()
					return timeline
				end,
				onSetPropertyKeyframeValue = editorActions.setPropertyKeyframeValue,
				onSetEventKeyframeValue = editorActions.setEventKeyframeValue,
				onPreviewPropertyKeyframeValue = editorActions.previewPropertyKeyframeValue,
				onCancelPropertyKeyframePreview = editorActions.cancelPropertyKeyframePreview,
				onSetSoundKeyframeValue = editorActions.setSoundKeyframeValue,
				onSetSoundClipEndFrame = editorActions.setSoundClipEndFrame,
				onSetSubtitleClipEndFrame = editorActions.setSubtitleClipEndFrame,
				onSetFadeClipStartFrame = editorActions.setFadeClipStartFrame,
				onSetFadeClipEndFrame = editorActions.setFadeClipEndFrame,
				onPreviewSoundKeyframeValue = editorActions.previewSoundKeyframeValue,
				onCancelSoundKeyframePreview = editorActions.cancelSoundKeyframePreview,
				onFpsChanged = function(fps)
					pushUndo("Change FPS")
					local changed = timeline:setFps(fps)
					if changed then
						PluginSettings.savePreferredFps(plugin, fps)
						refreshUi(string.format("Playback FPS set to %d. Timing preserved.", fps))
					else
						historyService:discardPendingUndo()
					end
				end,
				onDurationChanged = function(frameCount)
					if playbackService and playbackService:getIsPlaying() then
						stopPlayback("Stopped playback before changing timeline duration.", playbackService:getPlaybackFrame())
					end
					pushUndo("Change Duration")
					local changed = timeline:setDurationFrames(frameCount)
					if changed then
						refreshUi(string.format("Timeline duration set to %d frames.", frameCount))
					else
						historyService:discardPendingUndo()
					end
				end,
				onLoopingChanged = function(looping)
					pushUndo("Change Looping")
					local changed = timeline:setLooping(looping)
					if changed then
						refreshUi(looping and "Looping enabled." or "Looping disabled.")
					else
						historyService:discardPendingUndo()
					end
				end,
				onPriorityChanged = function(priority)
					pushUndo("Change Priority")
					local changed = timeline:setPriority(priority)
					if changed then
						refreshUi("Animation priority set to " .. tostring(priority) .. ".")
					else
						historyService:discardPendingUndo()
						refreshUi("Animation priority is already " .. tostring(timeline:getPriority()) .. ".")
					end
				end,
				onMoveSnapChanged = editorActions.setMoveSnap,
				onRotateSnapChanged = editorActions.setRotateSnap,
				onGizmoSizeChanged = editorActions.setGizmoSizePercent,
				onToggleOnionSkin = editorActions.toggleOnionSkin,
				onSetTrackballAxis = editorActions.setTrackballAxis,
				onGetTrackballAxis = editorActions.getTrackballAxis,
				getFacesViewModel = function()
					return widgetController._facesController:getViewModel()
				end,
				onFacesAction = handleFacesAction,
				onOpenFull = function(destination)
					widget:SetAttribute("MegMoHiddenForMicro", nil)
					setWidgetEnabled(true)
					if destination == "Presets" then
						widgetController:_setWorkspaceMode("Presets")
						widgetController:_setShortcutHint("Presets workspace.")
					elseif destination == "Cutscene" then
						widgetController:_setWorkspaceMode("Script")
						widgetController:_setShortcutHint("Cutscene Maker workspace.")
					elseif destination == "Faces" then
						widgetController:_setWorkspaceMode("Animate")
						widgetController:_setFacesOverlayVisible(true)
					elseif destination == "Effects" then
						widgetController:_setWorkspaceMode("Animate")
						widgetController:_setEffectsOverlayVisible(true)
					elseif destination == "Camera" then
						widgetController:_setWorkspaceMode("Animate")
						widgetController:_setEffectsOverlayVisible(true)
						if type(widgetController._effectsShowPage) == "function" then
							widgetController._effectsShowPage("Camera")
						end
						widgetController:_setShortcutHint("Camera Effects open: choose Orbit, Follow, or another camera helper.")
					elseif destination == "Audio" then
						widgetController:_setWorkspaceMode("Animate")
						widgetController:_setShortcutHint("Audio tools open: select a sound track to edit properties and events.")
					else
						widgetController:_setWorkspaceMode("Animate")
						if destination == "Motion" then
							widgetController._motionBuilderSuspendedViewportPicker = true
							editorActions.suspendViewportRigPartPicker("Motion Builder workspace.")
							pcall(function()
								plugin:Deactivate()
							end)
							widgetController:_setShortcutHint("Motion Builder workspace.")
						elseif widgetController._motionBuilderSuspendedViewportPicker == true then
							editorActions.resumeViewportRigPartPicker()
						end
					end
				end,
				onOpenMicro = function()
					widget:SetAttribute("MegMoHiddenForMicro", true)
					setWidgetEnabled(false)
				end,
				onCloseMicro = function()
					if type(editorActions.releaseWorkspaceGrab) == "function" then
						editorActions.releaseWorkspaceGrab("Free Grab turned off because the Micro workspace closed.", "WorkspaceClosed")
					end
					editorActions._microMultiSelectLocked = nil
					widgetController._viewportPartPickerArmed = false
					widget:SetAttribute("MegMoHiddenForMicro", nil)
					require(Modules:WaitForChild("ViewportToolCleanupService")).clear({
						editorActions = editorActions,
						gizmoController = gizmoController,
						modules = Modules,
					})
					clearMotionMarkersSilently()
					local restored, appliedCount = restoreOriginalWorkspaceState("Close Micro")
					RigWorkspaceLockService.unlockTimelineRigs(timeline)
					if type(editorActions.clearProjectForMicroClose) == "function" then
						editorActions.clearProjectForMicroClose()
					end
					local message = restored
						and string.format("Micro workspace closed and project cleared. Restored %d track%s to the original pose.", appliedCount, appliedCount == 1 and "" or "s")
						or "Micro workspace closed and project cleared."
					refreshUi(message)
					return true, message
				end,
			})
		end)
		if not ok or not microController then
			warn(string.format(
				"[7kg2 Micro] Micro workspace failed to attach (%s attempt %d): %s",
				tostring(reason or "startup"),
				microAttachAttempts,
				tostring(message or "attach returned nil")
			))
			return false
		end
		return true
	end

	local function retryMicroAttach(delaySeconds)
		task.delay(delaySeconds, function()
			if not microController then
				attachMicroWorkspace("startup-retry-" .. tostring(delaySeconds))
			end
		end)
	end

	if not attachMicroWorkspace("startup") then
		retryMicroAttach(0.5)
		retryMicroAttach(1.5)
		retryMicroAttach(3)
	end
end

local function deleteCurrentFrame()
	if #timeline:getTracks() == 0 then
		refreshUi("Add a rig or object track before deleting keyframes.")
		return
	end
	if playbackService and playbackService:getIsPlaying() then
		stopPlayback("Stopped playback before deleting keyframes.", playbackService:getPlaybackFrame())
	end

	pushUndo("Delete Keyframes")
	local selectedKeyRefs = getSelectedKeyRefs()
	local affectedKeyRefs = selectedKeyRefs
	if #affectedKeyRefs == 0 then
		affectedKeyRefs = {}
		local currentFrame = timeline:getCurrentFrame()
		for _, track in ipairs(timeline:getTracks()) do
			if track.path and timeline:hasTrackKeyframe(track.path, currentFrame) then
				table.insert(affectedKeyRefs, {
					jointPath = track.path,
					frame = currentFrame,
				})
			end
		end
	end
	local success, message
	if #selectedKeyRefs &gt; 0 then
		success, message = timeline:deleteTrackKeyframes(selectedKeyRefs)
		if success then
			clearSelectedKeyframes()
		end
	else
		success, message = timeline:deleteCurrentFrame()
	end

	if success then
		local deletedFrame = timeline:getCurrentFrame()
		for keyId, key in pairs(selectedKeys) do
			if key.frame == deletedFrame then
				selectedKeys[keyId] = nil
			end
		end
		if selectedKeyframeFrame == deletedFrame then
			selectedKeyframeFrame = nil
		end
		removeDeletedKeysFromGroups()
	end
	if not success then
		refreshUi(message)
		historyService:discardPendingUndo()
		return
	end

	local restoredEmptyTimeline, restoredCount = restoreOriginalStateIfTimelineEmpty("Delete Keyframes")
	if restoredEmptyTimeline then
		message = tostring(message or "Deleted keyframes.") .. string.format(" Restored %d track%s to the original pose because the timeline has no keyframes.", restoredCount, restoredCount == 1 and "" or "s")
	else
		timeline:applyCurrentFrame()
		local restoredTrackCount = timeline:restoreEmptyTrackOriginalStates(affectedKeyRefs)
		if restoredTrackCount &gt; 0 then
			message = tostring(message or "Deleted keyframes.") .. string.format(
				" Restored %d empty track%s to the starting pose.",
				restoredTrackCount,
				restoredTrackCount == 1 and "" or "s"
			)
		end
	end
	refreshUi(message)
end

local function nudgeCurrentKeyframe(offset)
	if #timeline:getTracks() == 0 then
		refreshUi("Add a rig or object track before editing keyframes.")
		return
	end

	local selectedKeyRefs = getSelectedKeyRefs()
	local success, message
	if #selectedKeyRefs &gt; 0 then
		pushUndo("Nudge Keyframes")
			success, message = timeline:moveTrackKeyframes(selectedKeyRefs, offset)
			if success then
				local newSelected = {}
				local movedKeys = {}
				for _, key in ipairs(selectedKeyRefs) do
					local targetFrame = math.max(0, math.min(timeline:getDurationFrames(), key.frame + offset))
					newSelected[SelectionState.makeTrackKeyId(key.jointPath, targetFrame)] = {
						jointPath = key.jointPath,
						frame = targetFrame,
					}
					table.insert(movedKeys, {
						jointPath = key.jointPath,
						frame = targetFrame,
					})
				end
				remapGroupsAfterMove(selectedKeyRefs, movedKeys)
				selectedKeys = newSelected
				selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
			local sorted = getSelectedKeyframeFrames()
			selectedKeyframeFrame = sorted[#sorted]
		end
	else
		local sourceFrame = selectedKeyframeFrame or timeline:getCurrentFrame()
		local targetFrame = sourceFrame + offset
		local sourceJointPath = selectedJointPath
		pushUndo("Nudge Keyframe")
		success, message = timeline:moveTrackKeyframe(sourceJointPath, sourceFrame, targetFrame)
		if success then
			setSingleSelectedKey(sourceJointPath, math.max(0, math.min(timeline:getDurationFrames(), math.floor(targetFrame))))
		end
	end
	if not success then
		historyService:discardPendingUndo()
	end
	if success then
		timeline:setCurrentFrame(selectedKeyframeFrame or timeline:getCurrentFrame())
		timeline:applyCurrentFrame()
	end
	refreshUi(message)
end

editorActions.moveKeyframeLeft = function()
	return nudgeCurrentKeyframe(-1)
end

editorActions.moveKeyframeRight = function()
	return nudgeCurrentKeyframe(1)
end

