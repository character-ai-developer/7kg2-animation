		local finishMicroTrackReorder
		local routeMicroWheelDirection
		local routeMicroWheel
		local lastMicroWheelClock = 0
		local playheadLine = nil
		local playheadHandle = nil
		miniTimelineSignature = nil
		local miniTimelineTrackSignature = nil
		local miniTimelineRulerTickLabels = {}
		local lastMicroScrubFrame = nil
		local lastMicroLaneClickClock = 0
		local function buildMicroDisplayTrackState(trackList)
			options._microDefaultCollapsedFolderTokens = options._microDefaultCollapsedFolderTokens or {}
			for _, track in ipairs(trackList or {}) do
				if track.targetScope == "TimelineFolder" and track.defaultCollapsed == true then
					local token = tostring(track.defaultCollapseToken or track.path)
					if not options._microDefaultCollapsedFolderTokens[token] then
						options._microDefaultCollapsedFolderTokens[token] = true
						microCollapsedTrackPaths[track.path] = true
					end
				end
			end
			local hierarchyState = RigTrackHierarchyService.buildState(trackList, microCollapsedTrackPaths)
			local collapsedRigNames = {}
			local collapsedFolders = {}
			local childCountByParentPath = {}
			local displayedRigGroups = {}
			local rigDisplayBuckets = {}
			local insertedRigDisplayBuckets = {}
			local collapsedRigBodies = {}
			local collapsedRigProperties = {}
			local function getRigGroupIdentity(track)
				if not track then
					return nil
				end
				return track.rigName or track.part0 or track.name
			end
			local function microRigHeaderPath(rigName)
				return "__microRigHeader:" .. tostring(rigName or "Rig")
			end
			local function microRigPropertiesPath(rigName)
				return "__microRigProperties:" .. tostring(rigName or "Rig")
			end
			local function makeMicroVirtualTrack(rigName, kind, name, depth)
				local path = kind == "RigHeader" and microRigHeaderPath(rigName) or microRigPropertiesPath(rigName)
				return {
					path = path,
					name = name,
					rigName = rigName,
					trackType = "Micro Section",
					valueType = "Section",
					isMicroVirtualTrack = true,
					virtualKind = kind,
					microDepth = depth or 0,
				}
			end
			local function ensureRigDisplayBucket(rigName)
				local key = tostring(rigName or "")
				if key == "" then
					return nil
				end
				local bucket = rigDisplayBuckets[key]
				if not bucket then
					bucket = {
						group = nil,
						events = {},
						properties = {},
						joints = {},
						extras = {},
						extrasByParentPath = {},
						propertiesRow = makeMicroVirtualTrack(key, "Properties", "Properties", 1),
						headerRow = makeMicroVirtualTrack(key, "RigHeader", key, 0),
					}
					rigDisplayBuckets[key] = bucket
				end
				return bucket
			end
			for _, track in ipairs(trackList or {}) do
				if track.trackType == "Rig Group" and microCollapsedTrackPaths[track.path] then
					collapsedRigBodies[track.rigName] = true
				end
				if track.trackType == "Rig Group" and track.rigName and microCollapsedTrackPaths[microRigHeaderPath(track.rigName)] then
					collapsedRigNames[track.rigName] = true
				end
				if track.trackType == "Rig Group" and track.rigName and microCollapsedTrackPaths[microRigPropertiesPath(track.rigName)] then
					collapsedRigProperties[track.rigName] = true
				end
				if track.targetScope == "TimelineFolder" and microCollapsedTrackPaths[track.path] then
					collapsedFolders[track.path] = true
				end
				if track.parentTrackPath then
					childCountByParentPath[track.parentTrackPath] = (childCountByParentPath[track.parentTrackPath] or 0) + 1
				end
				local rigIdentity = track.trackType == "Rig Group" and getRigGroupIdentity(track) or track.rigName
				local rigBucket = ensureRigDisplayBucket(rigIdentity)
				if rigBucket then
					if track.trackType == "Rig Group" and not rigBucket.group then
						rigBucket.group = track
						rigBucket.headerRow.reorderPath = track.path
						rigBucket.headerRow.reorderScope = getTrackReorderScope(track)
						rigBucket.headerRow.folderPath = track.folderPath
					elseif (track.trackType == "Event" or track.valueType == "Event") and track.targetScope == "RigEvent" then
						rigBucket.events[#rigBucket.events + 1] = track
					elseif track.trackType == "Rig Property" or track.trackType == "Rig CFrame" or track.targetScope == "RigProperty" then
						rigBucket.properties[#rigBucket.properties + 1] = track
					elseif track.trackType == "Rig" then
						rigBucket.joints[#rigBucket.joints + 1] = track
					else
						if track.parentTrackPath then
							local parentExtras = rigBucket.extrasByParentPath[track.parentTrackPath]
							if not parentExtras then
								parentExtras = {}
								rigBucket.extrasByParentPath[track.parentTrackPath] = parentExtras
							end
							parentExtras[#parentExtras + 1] = track
						else
							rigBucket.extras[#rigBucket.extras + 1] = track
						end
					end
				end
			end
			local displayTrackList = {}
			local visiblePathSet = {}
			local function addTrackIfVisible(track)
				if not track then
					return
				end
				local hidden = false
				if track.isMicroVirtualTrack then
					if track.virtualKind ~= "RigHeader" and track.rigName and collapsedRigNames[track.rigName] then
						hidden = true
					end
				end
				local isRigGroupTrack = track.trackType == "Rig Group"
				if isRigGroupTrack then
					local rigIdentity = getRigGroupIdentity(track)
					if rigIdentity and displayedRigGroups[rigIdentity] then
						hidden = true
					elseif rigIdentity then
						displayedRigGroups[rigIdentity] = true
					end
				end
				if track.trackType == "Rig" and hierarchyState.hiddenByPath[track.path] then
					hidden = true
				end
				if not track.isMicroVirtualTrack and track.rigName and collapsedRigNames[track.rigName] then
					hidden = true
				end
				if track.trackType == "Rig" and track.rigName and collapsedRigBodies[track.rigName] then
					hidden = true
				end
				if (track.trackType == "Rig Property" or track.trackType == "Rig CFrame" or track.targetScope == "RigProperty") and track.rigName and collapsedRigProperties[track.rigName] then
					hidden = true
				end
				if track.folderPath and collapsedFolders[track.folderPath] then
					hidden = true
				end
				if track.parentTrackPath and (microCollapsedTrackPaths[track.parentTrackPath] or not visiblePathSet[track.parentTrackPath]) then
					hidden = true
				end
				if not hidden then
					displayTrackList[#displayTrackList + 1] = track
					visiblePathSet[track.path] = true
				end
			end
			for _, track in ipairs(trackList or {}) do
				local rigIdentity = track.trackType == "Rig Group" and getRigGroupIdentity(track) or track.rigName
				local rigBucket = rigIdentity and rigDisplayBuckets[tostring(rigIdentity)] or nil
				if rigBucket and rigBucket.group then
					local bucketKey = tostring(rigIdentity)
					if not insertedRigDisplayBuckets[bucketKey] then
						insertedRigDisplayBuckets[bucketKey] = true
						addTrackIfVisible(rigBucket.headerRow)
						for _, eventTrack in ipairs(rigBucket.events) do
							addTrackIfVisible(eventTrack)
						end
						addTrackIfVisible(rigBucket.propertiesRow)
						for _, propertyTrack in ipairs(rigBucket.properties) do
							addTrackIfVisible(propertyTrack)
							for _, extraTrack in ipairs(rigBucket.extrasByParentPath[propertyTrack.path] or {}) do
								addTrackIfVisible(extraTrack)
							end
						end
						addTrackIfVisible(rigBucket.group)
						for _, jointTrack in ipairs(rigBucket.joints) do
							addTrackIfVisible(jointTrack)
							for _, extraTrack in ipairs(rigBucket.extrasByParentPath[jointTrack.path] or {}) do
								addTrackIfVisible(extraTrack)
							end
						end
						for _, extraTrack in ipairs(rigBucket.extras) do
							addTrackIfVisible(extraTrack)
						end
					end
				else
					addTrackIfVisible(track)
				end
			end
			return RigTrackHierarchyService.arrangeDisplayTracksParentFirst(displayTrackList), hierarchyState, childCountByParentPath
		end
		local function saveMicroFrameWindow()
			setSettingNumber(plugin, FRAME_START_SETTING, math.floor(microFrameStart + 0.5))
			setSettingNumber(plugin, VISIBLE_FRAMES_SETTING, math.floor(microVisibleFrames + 0.5))
		end
		local function clampMicroFrameWindow(durationFrames, keepFrameVisible)
			durationFrames = math.max(1, math.floor(tonumber(durationFrames) or 1))
			microVisibleFrames = math.clamp(
				snapMicroVisibleFrames(microVisibleFrames),
				MICRO_MIN_VISIBLE_FRAMES,
				math.min(MICRO_MAX_VISIBLE_FRAMES, math.max(MICRO_MIN_VISIBLE_FRAMES, durationFrames))
			)
			local maxStart = math.max(0, durationFrames - microVisibleFrames)
			if keepFrameVisible ~= nil then
				keepFrameVisible = math.clamp(math.floor(tonumber(keepFrameVisible) or 0), 0, durationFrames)
				if keepFrameVisible &lt; microFrameStart or keepFrameVisible &gt; microFrameStart + microVisibleFrames then
					microFrameStart = keepFrameVisible - math.floor(microVisibleFrames * 0.5)
				end
			end
			microFrameStart = math.clamp(math.floor(tonumber(microFrameStart) or 0), 0, maxStart)
			return microFrameStart, math.min(durationFrames, microFrameStart + microVisibleFrames)
		end
		local function setMicroFrameWindow(startFrame, visibleFrames, keepFrameVisible, shouldPersist)
			if shouldPersist == nil then
				shouldPersist = true
			end
			if visibleFrames ~= nil then
				microVisibleFrames = snapMicroVisibleFrames(visibleFrames)
			end
			if startFrame ~= nil then
				microFrameStart = math.max(0, math.floor(tonumber(startFrame) or 0))
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if keepFrameVisible == nil and (startFrame ~= nil or visibleFrames ~= nil) then
				microUiHost._manualFrameWindowAnchor = timeline and math.floor(getMicroDisplayFrame(timeline, options) + 0.5) or 0
			end
			local durationFrames = timeline and math.max(1, tonumber(timeline:getDurationFrames()) or 300) or MICRO_DEFAULT_VISIBLE_FRAMES
			clampMicroFrameWindow(durationFrames, keepFrameVisible)
			if shouldPersist then
				saveMicroFrameWindow()
			end
			miniTimelineSignature = nil
			refresh()
		end
		local function beginMicroMiddlePan(input)
			if not input then
				return false
			end
			if microMiddlePanState then
				return true
			end
			local mouseLocation = UserInputService:GetMouseLocation()
			local startPoint = input.UserInputType == Enum.UserInputType.MouseButton3
				and Vector2.new(mouseLocation.X, mouseLocation.Y)
				or Vector2.new(input.Position.X, input.Position.Y)
			microMiddlePanState = {
				start = startPoint,
				startFrame = microFrameStart,
				startTrackOffset = microTrackOffset,
			}
			microUiHost._middlePanBlocker = setMiddlePanModalBlocker(gui, microUiHost._middlePanBlocker, true, "MicroMiddlePanCameraBlocker", 100000)
			pcall(function()
				plugin:Activate(true)
			end)
			if statusLabel then
				statusLabel.Text = "Middle-drag: pan the timeline."
			end
			return true
		end
		local function updateMicroMiddlePan(input)
			if not microMiddlePanState or not input or input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return false
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return false
			end
			local delta = Vector2.new(input.Position.X, input.Position.Y) - microMiddlePanState.start
			local usableWidth = math.max(1, lanes.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2))
			local frameDelta = -(delta.X / usableWidth) * math.max(1, microVisibleFrames)
			local trackList = timeline:getTracks()
			local displayTrackList = buildMicroDisplayTrackState(trackList)
			local visibleRows = math.max(1, math.floor((trackListFrame.AbsoluteSize.Y - 4) / microTrackHeight))
			local maxOffset = math.max(0, #displayTrackList - visibleRows)
			local rowDelta = math.floor((delta.Y / math.max(1, microTrackHeight)) + 0.5)
			microTrackOffset = math.clamp((microMiddlePanState.startTrackOffset or 0) - rowDelta, 0, maxOffset)
			setMicroFrameWindow((microMiddlePanState.startFrame or 0) + frameDelta, microVisibleFrames, nil, false)
			return true
		end
		local function endMicroMiddlePan()
			if not microMiddlePanState then
				return false
			end
			microMiddlePanState = nil
			microUiHost._middlePanBlocker = setMiddlePanModalBlocker(gui, microUiHost._middlePanBlocker, false)
			saveMicroFrameWindow()
			if statusLabel then
				statusLabel.Text = "Middle-drag pan finished."
			end
			return true
		end
		local function getMicroKeyBounds(timeline)
			if not timeline or type(timeline.getTrackKeyframesByPath) ~= "function" then
				return nil, nil
			end
			local keyframesByPath = timeline:getTrackKeyframesByPath()
			local minFrame = nil
			local maxFrame = nil
			for _, frames in pairs(keyframesByPath or {}) do
				for _, frame in ipairs(frames) do
					frame = tonumber(frame)
					if frame then
						minFrame = minFrame and math.min(minFrame, frame) or frame
						maxFrame = maxFrame and math.max(maxFrame, frame) or frame
					end
				end
			end
			return minFrame, maxFrame
		end
		local function fitMicroFrameWindowToKeys()
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return
			end
			local minFrame, maxFrame = getMicroKeyBounds(timeline)
			if not minFrame or not maxFrame then
				local currentFrame = type(timeline.getCurrentFrame) == "function" and math.max(0, tonumber(timeline:getCurrentFrame()) or 0) or 0
				setMicroFrameWindow(currentFrame - (MICRO_DEFAULT_VISIBLE_FRAMES * 0.5), MICRO_DEFAULT_VISIBLE_FRAMES, currentFrame)
				return
			end
			local span = math.max(1, maxFrame - minFrame)
			local pad = math.max(15, math.floor(span * 0.16 + 0.5))
			setMicroFrameWindow(minFrame - pad, span + (pad * 2), nil)
		end
		local function zoomMicroTimeline(multiplier)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return
			end
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			local currentFrame = type(timeline.getCurrentFrame) == "function" and math.max(0, tonumber(timeline:getCurrentFrame()) or 0) or 0
			local visibleStart, visibleEnd = clampMicroFrameWindow(durationFrames, nil)
			local centerFrame = currentFrame
			if currentFrame &lt; visibleStart or currentFrame &gt; visibleEnd then
				centerFrame = visibleStart + ((visibleEnd - visibleStart) * 0.5)
			end
			local nextVisible = math.clamp(
				snapMicroVisibleFrames(microVisibleFrames * multiplier),
				MICRO_MIN_VISIBLE_FRAMES,
				math.min(MICRO_MAX_VISIBLE_FRAMES, math.max(MICRO_MIN_VISIBLE_FRAMES, durationFrames))
			)
			setMicroFrameWindow(centerFrame - (nextVisible * 0.5), nextVisible, currentFrame)
		end
		local function getMicroZoomAlpha(durationFrames)
			durationFrames = math.max(MICRO_MIN_VISIBLE_FRAMES, tonumber(durationFrames) or MICRO_DEFAULT_VISIBLE_FRAMES)
			local maxVisible = math.min(MICRO_MAX_VISIBLE_FRAMES, durationFrames)
			if maxVisible &lt;= MICRO_MIN_VISIBLE_FRAMES then
				return 1
			end
			local currentVisible = math.clamp(microVisibleFrames, MICRO_MIN_VISIBLE_FRAMES, maxVisible)
			local minLog = math.log(MICRO_MIN_VISIBLE_FRAMES)
			local maxLog = math.log(maxVisible)
			return math.clamp(1 - ((math.log(currentVisible) - minLog) / math.max(0.0001, maxLog - minLog)), 0, 1)
		end
		local function applyMicroZoomAlpha(alpha, shouldPersist)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return
			end
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			local maxVisible = math.min(MICRO_MAX_VISIBLE_FRAMES, math.max(MICRO_MIN_VISIBLE_FRAMES, durationFrames))
			local nextVisible = MICRO_MIN_VISIBLE_FRAMES
			if maxVisible &gt; MICRO_MIN_VISIBLE_FRAMES then
				alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
				nextVisible = math.exp(math.log(maxVisible) + ((math.log(MICRO_MIN_VISIBLE_FRAMES) - math.log(maxVisible)) * alpha))
			end
			local currentFrame = type(timeline.getCurrentFrame) == "function" and math.max(0, tonumber(timeline:getCurrentFrame()) or 0) or 0
			local visibleStart, visibleEnd = clampMicroFrameWindow(durationFrames, nil)
			local centerFrame = currentFrame
			if currentFrame &lt; visibleStart or currentFrame &gt; visibleEnd then
				centerFrame = visibleStart + ((visibleEnd - visibleStart) * 0.5)
			end
			setMicroFrameWindow(centerFrame - (nextVisible * 0.5), nextVisible, nil, shouldPersist)
		end
		local function setMicroZoomFromX(screenX, shouldPersist)
			if zoomMicroSlider.AbsoluteSize.X &lt;= 1 then
				return
			end
			local usableWidth = math.max(1, zoomMicroSlider.AbsoluteSize.X - 6)
			local alpha = math.clamp((screenX - zoomMicroSlider.AbsolutePosition.X - 3) / usableWidth, 0, 1)
			applyMicroZoomAlpha(alpha, shouldPersist)
		end
		local function updateMicroZoomSlider(durationFrames)
			local alpha = getMicroZoomAlpha(durationFrames)
			local usableWidth = math.max(1, zoomMicroSlider.AbsoluteSize.X - 6)
			local x = math.floor((usableWidth * alpha) + 0.5)
			zoomMicroFill.Size = UDim2.fromOffset(x, 6)
			zoomMicroHandle.Position = UDim2.new(0, math.clamp(3 + x - 4, 0, math.max(0, zoomMicroSlider.AbsoluteSize.X - 8)), 0.5, -4)
		end
		local function scrollMicroFrameWindow(deltaDirection)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return false
			end
			local amount = math.max(12, math.floor(microVisibleFrames * 0.08 + 0.5))
			setMicroFrameWindow(microFrameStart + (deltaDirection * amount), microVisibleFrames, nil)
			return true
		end
		local function scrollMicroTracksByDirection(deltaDirection)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if timeline then
				local trackList = timeline:getTracks()
				local displayTrackList = buildMicroDisplayTrackState(trackList)
				local visibleRows = math.max(1, math.floor((trackListFrame.AbsoluteSize.Y - 4) / microTrackHeight))
				local scrollRows = math.max(1, math.floor((visibleRows * 0.2) + 0.5))
				local wheelDelta = deltaDirection * scrollRows
				microTrackOffset = math.clamp(microTrackOffset + wheelDelta, 0, math.max(0, #displayTrackList - visibleRows))
				miniTimelineSignature = nil
				refresh()
			end
			return true
		end
		local function scrollMicroTracks(input)
			if input.UserInputType ~= Enum.UserInputType.MouseWheel then
				return false
			end
			local direction = input.Position.Z &gt;= 0 and -1 or 1
			return scrollMicroTracksByDirection(direction)
		end
		local function zoomMicroTimelineAtInput(input)
			if input.UserInputType ~= Enum.UserInputType.MouseWheel then
				return false
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline or lanes.AbsoluteSize.X &lt;= 1 then
				return false
			end
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			local visibleStart, visibleEnd = clampMicroFrameWindow(durationFrames, nil)
			local visibleRange = math.max(1, visibleEnd - visibleStart)
			local usableWidth = math.max(1, lanes.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2))
			local cursorAlpha = math.clamp((input.Position.X - lanes.AbsolutePosition.X - MICRO_FRAME_GUTTER) / usableWidth, 0, 1)
			local cursorFrame = visibleStart + (visibleRange * cursorAlpha)
			local zoomingIn = input.Position.Z &gt;= 0
			local multiplier = zoomingIn and 0.82 or 1.22
			local maxVisible = math.min(MICRO_MAX_VISIBLE_FRAMES, math.max(MICRO_MIN_VISIBLE_FRAMES, durationFrames))
			local nextVisible = math.clamp(
				snapMicroVisibleFrames(microVisibleFrames * multiplier),
				MICRO_MIN_VISIBLE_FRAMES,
				maxVisible
			)
			if zoomingIn and nextVisible &gt;= microVisibleFrames and microVisibleFrames &gt; MICRO_MIN_VISIBLE_FRAMES then
				nextVisible = math.max(MICRO_MIN_VISIBLE_FRAMES, snapMicroVisibleFrames(microVisibleFrames - 30))
			elseif not zoomingIn and nextVisible &lt;= microVisibleFrames and microVisibleFrames &lt; maxVisible then
				nextVisible = math.min(maxVisible, snapMicroVisibleFrames(microVisibleFrames + 30))
			end
			if zoomingIn and nextVisible &lt;= MICRO_MIN_VISIBLE_FRAMES * 2 then
				nextVisible = MICRO_MIN_VISIBLE_FRAMES
			elseif not zoomingIn and nextVisible &gt;= maxVisible - 30 then
				nextVisible = maxVisible
			end
			setMicroFrameWindow(cursorFrame - (nextVisible * cursorAlpha), nextVisible, nil)
			updateMicroZoomSlider(durationFrames)
			return true
		end
		local function isMicroPointInside(guiObject, input)
			if not guiObject or not guiObject.Parent or not input then
				return false
			end
			local x
			local y
			if typeof(input) == "Vector2" then
				x = input.X
				y = input.Y
			else
				x = input.Position.X
				y = input.Position.Y
			end
			local pos = guiObject.AbsolutePosition
			local size = guiObject.AbsoluteSize
			return x &gt;= pos.X and x &lt;= pos.X + size.X and y &gt;= pos.Y and y &lt;= pos.Y + size.Y
		end
		TimelineMiddlePanInputSink.bind(MICRO_MIDDLE_PAN_ACTION_NAME, function(inputState, input)
			if not gui or not gui.Enabled or not panel or not panel.Parent then
				return false
			end
			if microMiddlePanState then
				return true
			end
			if input.UserInputType ~= Enum.UserInputType.MouseButton3 then
				return false
			end

			local mouseLocation = UserInputService:GetMouseLocation()
			local point = Vector2.new(mouseLocation.X, mouseLocation.Y)
			local shouldPan = isMicroPointInside(scrubSurface, point) or isMicroPointInside(lanes, point)
			if shouldPan and inputState == Enum.UserInputState.Begin then
				beginMicroMiddlePan(input)
			end
			return shouldPan
		end)
		routeMicroWheelDirection = function(deltaDirection, preferredArea, mousePoint)
			if preferredArea == "tracks" then
				return scrollMicroTracksByDirection(deltaDirection)
			elseif preferredArea == "timeline" then
				local fakeInput = {
					UserInputType = Enum.UserInputType.MouseWheel,
					Position = Vector3.new(mousePoint.X, mousePoint.Y, deltaDirection &lt; 0 and 1 or -1),
				}
				return zoomMicroTimelineAtInput(fakeInput)
			end
			if isMicroPointInside(tracks, mousePoint) then
				return scrollMicroTracksByDirection(deltaDirection)
			elseif isMicroPointInside(lanes, mousePoint) then
				local fakeInput = {
					UserInputType = Enum.UserInputType.MouseWheel,
					Position = Vector3.new(mousePoint.X, mousePoint.Y, deltaDirection &lt; 0 and 1 or -1),
				}
				return zoomMicroTimelineAtInput(fakeInput)
			end
			return false
		end
		routeMicroWheel = function(input, preferredArea)
			if input.UserInputType ~= Enum.UserInputType.MouseWheel then
				return false
			end
			local now = os.clock()
			if now - lastMicroWheelClock &lt; 0.015 then
				return true
			end
			lastMicroWheelClock = now
			local mouseLocation = UserInputService:GetMouseLocation()
			local mousePoint = Vector2.new(mouseLocation.X, mouseLocation.Y)
			local direction = input.Position.Z &gt;= 0 and -1 or 1
			return routeMicroWheelDirection(direction, preferredArea, mousePoint)
		end
		local function attachMicroWheelGui(guiObject, preferredArea)
			return
		end
		local function getMicroFrameAtX(screenX)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline or lanes.AbsoluteSize.X &lt;= 1 then
				return nil
			end
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			local visibleStart, visibleEnd = clampMicroFrameWindow(durationFrames, nil)
			local visibleRange = math.max(1, visibleEnd - visibleStart)
			local usableWidth = math.max(1, lanes.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2))
			local alpha = math.clamp((screenX - lanes.AbsolutePosition.X - MICRO_FRAME_GUTTER) / usableWidth, 0, 1)
			return math.floor((visibleStart + (visibleRange * alpha)) + 0.5)
		end
		local function getMicroFrameX(frame, durationFrames)
			durationFrames = math.max(1, tonumber(durationFrames) or 300)
			local visibleStart, visibleEnd = clampMicroFrameWindow(durationFrames, nil)
			local visibleRange = math.max(1, visibleEnd - visibleStart)
			local usableWidth = math.max(1, keyLayer.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2))
			local alpha = math.clamp(((tonumber(frame) or 0) - visibleStart) / visibleRange, 0, 1)
			return MICRO_FRAME_GUTTER + (alpha * usableWidth)
		end
		local function updateMicroPlayheadVisual(timeline, frame)
			if not timeline or keyLayer.AbsoluteSize.X &lt;= 1 then
				return
			end
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			local visibleStart, visibleEnd = clampMicroFrameWindow(durationFrames, nil)
			local visibleRange = math.max(1, visibleEnd - visibleStart)
			local timelinePixelWidth = math.max(1, keyLayer.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2))
			local rawAlpha = ((tonumber(frame) or 0) - visibleStart) / visibleRange
			local playheadVisible = rawAlpha &gt;= 0 and rawAlpha &lt;= 1
			local alpha = math.clamp(rawAlpha, 0, 1)
			local playheadX = MICRO_FRAME_GUTTER + (alpha * timelinePixelWidth)
			microUiHost._lastPlayheadVisualX = playheadVisible and playheadX or nil
			if playheadLine and playheadLine.Parent then
				playheadLine.Visible = playheadVisible
				playheadLine.Position = UDim2.fromOffset(playheadX - 1, 0)
			end
			if playheadHandle and playheadHandle.Parent then
				playheadHandle.Visible = playheadVisible
				playheadHandle.Position = UDim2.fromOffset(playheadX - 3, 0)
			end
			local fps = math.max(1, tonumber(timeline:getFps()) or 60)
			timeBadge.Text = getTimelineLabel(timeline, options, frame)
			frameBadge.Text = getTimelineFrameLabel(timeline, options)
			local scrollVisibleRatio = math.clamp(microVisibleFrames / durationFrames, 0, 1)
			local scrollHandleRatio = math.max(0.06, scrollVisibleRatio)
			local maxFrameStart = math.max(1, durationFrames - microVisibleFrames)
			local scrollStartRatio = durationFrames &lt;= microVisibleFrames
				and 0
				or math.clamp(microFrameStart / maxFrameStart, 0, 1) * (1 - scrollHandleRatio)
			frameScrollHandle.Position = UDim2.new(scrollStartRatio, 0, 0, 0)
			frameScrollHandle.Size = UDim2.new(scrollHandleRatio, 0, 1, 0)
			frameScrollTrack.Visible = durationFrames &gt; microVisibleFrames
			updateMicroZoomSlider(durationFrames)
		end
		microUiHost._updatePlayheadVisual = updateMicroPlayheadVisual
		local function autoScrollMicroFrameWindowForScreenX(screenX)
			if lanes.AbsoluteSize.X &lt;= 1 then
				return false
			end
			local leftBound = lanes.AbsolutePosition.X + MICRO_FRAME_GUTTER
			local rightBound = lanes.AbsolutePosition.X + lanes.AbsoluteSize.X - MICRO_FRAME_GUTTER
			local edgeZone = math.clamp(lanes.AbsoluteSize.X * 0.12, 32, 92)
			local direction = 0
			local proximity = 0
			if screenX &lt; leftBound + edgeZone then
				direction = -1
				proximity = math.clamp((leftBound + edgeZone - screenX) / edgeZone, 0, 1)
			elseif screenX &gt; rightBound - edgeZone then
				direction = 1
				proximity = math.clamp((screenX - (rightBound - edgeZone)) / edgeZone, 0, 1)
			end
			if direction == 0 then
				microUiHost._edgeFramePanClock = nil
				microUiHost._edgeFramePanRemainder = 0
				return false
			end
			local now = os.clock()
			if now - lastMicroEdgeFramePanClock &lt; 0.012 then
				return false
			end
			local elapsed = math.clamp(now - (tonumber(microUiHost._edgeFramePanClock) or now), 1 / 120, 1 / 20)
			microUiHost._edgeFramePanClock = now
			lastMicroEdgeFramePanClock = now
			local rawDelta = direction * math.max(1, microVisibleFrames) * (0.1 + (0.75 * proximity)) * elapsed
			rawDelta += tonumber(microUiHost._edgeFramePanRemainder) or 0
			local deltaFrames = rawDelta &gt;= 0 and math.floor(rawDelta) or math.ceil(rawDelta)
			microUiHost._edgeFramePanRemainder = rawDelta - deltaFrames
			if deltaFrames == 0 then
				return false
			end
			local previousStart = microFrameStart
			microFrameStart = math.max(0, microFrameStart + deltaFrames)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			clampMicroFrameWindow(timeline and math.max(1, tonumber(timeline:getDurationFrames()) or 300) or MICRO_DEFAULT_VISIBLE_FRAMES, nil)
			if microFrameStart == previousStart then
				return false
			end
			miniTimelineSignature = nil
			return true
		end
		local function autoScrollMicroTracksForScreenY(screenY)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline or keyLayer.AbsoluteSize.Y &lt;= 1 or trackListFrame.AbsoluteSize.Y &lt;= 1 then
				return false
			end
			local topBound = keyLayer.AbsolutePosition.Y
			local bottomBound = keyLayer.AbsolutePosition.Y + keyLayer.AbsoluteSize.Y
			local deltaRows = 0
			if screenY &lt; topBound then
				local overflow = topBound - screenY
				deltaRows = -math.max(1, math.floor((overflow / math.max(8, microTrackHeight * 0.6)) + 0.5))
			elseif screenY &gt; bottomBound then
				local overflow = screenY - bottomBound
				deltaRows = math.max(1, math.floor((overflow / math.max(8, microTrackHeight * 0.6)) + 0.5))
			end
			if deltaRows == 0 then
				return false
			end
			local now = os.clock()
			if now - lastMicroEdgeTrackPanClock &lt; 0.04 then
				return false
			end
			lastMicroEdgeTrackPanClock = now
			local trackList = timeline:getTracks()
			local displayTrackList = buildMicroDisplayTrackState(trackList)
			local visibleRows = math.max(1, math.floor((trackListFrame.AbsoluteSize.Y - 4) / microTrackHeight))
			local maxOffset = math.max(0, #displayTrackList - visibleRows)
			local nextOffset = math.clamp(microTrackOffset + deltaRows, 0, maxOffset)
			if nextOffset == microTrackOffset then
				return false
			end
			microTrackOffset = nextOffset
			miniTimelineSignature = nil
			refresh()
			return true
		end
		local function ensureMicroMarqueeBox()
			if not microMarqueeState then
				return
			end
			if microMarqueeBox and microMarqueeBox.Parent == scrubSurface then
				return
			end
			microMarqueeBox = make("Frame", {
				Name = "MicroMarquee",
				BackgroundColor3 = theme().Accent,
				BackgroundTransparency = 0.82,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(1, 1),
				ZIndex = 14,
			}, scrubSurface)
			microMarqueeBox:SetAttribute("MegMoThemeBackgroundRole", "Accent")
			stroke(microMarqueeBox, theme().Accent, 0.12, 1, "Accent")
		end
		local function scrubTimelineAtInput(input, previewOnly, allowEdgePan)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			local scrolledWindow = allowEdgePan == true and autoScrollMicroFrameWindowForScreenX(input.Position.X) or false
			local frame = getMicroFrameAtX(input.Position.X)
			if not timeline or not frame then
				return
			end
			if previewOnly ~= false and frame == lastMicroScrubFrame and not scrolledWindow then
				return
			end
			lastMicroScrubFrame = frame
			if not runOption(options, previewOnly == true and "onPreviewScrubToFrame" or "onScrubToFrame", nil, frame)
				and not (previewOnly == true and runOption(options, "onScrubToFrame", nil, frame)) then
				if type(timeline.setCurrentFrame) == "function" then
					timeline:setCurrentFrame(frame)
				end
				if type(timeline.applyCurrentFrame) == "function" then
					timeline:applyCurrentFrame()
				end
			end
			microUiHost._manualFrameWindowAnchor = nil
			updateMicroPlayheadVisual(timeline, frame)
			if scrolledWindow then
				miniTimelineSignature = nil
				refresh()
			end
		end
		RunService.RenderStepped:Connect(function()
			if microScrubbing and microScrubMoved and microLastScrubInput then
				scrubTimelineAtInput(microLastScrubInput, true, true)
			end
		end)
		local function jumpMicroToFrame(frame)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return
			end
			frame = math.clamp(math.floor((tonumber(frame) or 0) + 0.5), 0, math.max(1, tonumber(timeline:getDurationFrames()) or 1))
			microUiHost._manualFrameWindowAnchor = nil
			if not runOption(options, "onScrubToFrame", nil, frame) then
				if type(timeline.setCurrentFrame) == "function" then
					timeline:setCurrentFrame(frame)
				end
				if type(timeline.applyCurrentFrame) == "function" then
					timeline:applyCurrentFrame()
				end
			end
			setMicroFrameWindow(microFrameStart, microVisibleFrames, frame)
		end
		options.onJumpTimelineStart = function()
			jumpMicroToFrame(0)
			return true, "Jumped to timeline start."
		end
		options.onJumpTimelineEnd = function()
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			jumpMicroToFrame(timeline and timeline:getDurationFrames() or 0)
			return true, "Jumped to timeline end."
		end
		options.onFitTimelineKeys = function()
			fitMicroFrameWindowToKeys()
			return true, "Fitted Micro timeline to keys."
		end
		local function consumeMicroTrackDoubleClick(path)
			local now = os.clock()
			local isDoubleClick = lastMicroTrackClickPath == path and (now - (lastMicroTrackClickTime or 0)) &lt;= TRACK_DOUBLE_CLICK_SECONDS
			lastMicroTrackClickPath = path
			lastMicroTrackClickTime = now
			if isDoubleClick then
				lastMicroTrackClickPath = nil
				lastMicroTrackClickTime = 0
				return true
			end
			return false
		end
		local function selectMicroKeyList(keyList, additive, preservePlayhead)
			if type(keyList) ~= "table" then
				return
			end
			microUiHost._selectedMicroGroupIds = nil
			options._microSelectedGroupIds = nil
			if #keyList &gt; 0 then
				options._microLastSelectionScope = "track"
			end
			if type(options.onSelectKeysInBox) == "function" then
				options.onSelectKeysInBox(keyList, additive == true, preservePlayhead == true)
				return
			end
			if #keyList == 0 then
				return
			end
			if not additive and type(options.onSelectKeySet) == "function" then
				options.onSelectKeySet(keyList, preservePlayhead == true)
				return
			end
			for index, key in ipairs(keyList) do
				runOption(options, "onSelectKey", "selectKey", key.jointPath, key.frame, additive == true or index &gt; 1)
			end
		end
		local function isMicroPointOnVisibleKey(point)
			if not point or not keyLayer or not keyLayer.Parent then
				return false
			end
			local localX = point.X - keyLayer.AbsolutePosition.X
			local localY = point.Y - keyLayer.AbsolutePosition.Y
			for _, keyInfo in pairs(microVisibleKeyButtons) do
				local keyX = tonumber(keyInfo.x)
				local keyY = tonumber(keyInfo.y)
				local keySize = tonumber(keyInfo.size) or MICRO_KEY_SIZE
				if keyX and keyY then
					local halfSize = keySize * 0.5
					if localX &gt;= keyX - halfSize - 4
						and localX &lt;= keyX + halfSize + 4
						and localY &gt;= keyY - 4
						and localY &lt;= keyY + keySize + 4 then
						return true
					end
				end
			end
			return false
		end
		local function clearMicroKeySelectionForBlankTimelineTap(point, additive)
			if additive == true or isMicroPointOnVisibleKey(point) then
				return false
			end
			microUiHost._selectedMicroGroupIds = nil
			options._microSelectedGroupIds = nil
			options._microLastSelectionScope = "timeline"
			local ok = runOption(options, "onClearKeySelection", "clearTimelineKeySelection")
			if ok then
				miniTimelineSignature = nil
			end
			return ok
		end
		options._microSelectAllFromBlankTimeline = function()
			if not keyLayer or not keyLayer.Parent or keyLayer.AbsoluteSize.X &lt;= 1 or keyLayer.AbsoluteSize.Y &lt;= 1 then
				return false
			end
			local mousePoint = UserInputService:GetMouseLocation()
			local point = Vector2.new(mousePoint.X, mousePoint.Y)
			local layerPosition = keyLayer.AbsolutePosition
			local layerSize = keyLayer.AbsoluteSize
			if point.X &lt; layerPosition.X
				or point.X &gt; layerPosition.X + layerSize.X
				or point.Y &lt; layerPosition.Y
				or point.Y &gt; layerPosition.Y + layerSize.Y then
				return false
			end
			return not isMicroPointOnVisibleKey(point)
		end
		local function getMicroDisplayTrackListSnapshot()
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return nil
			end
			local trackList = timeline:getTracks()
			return buildMicroDisplayTrackState(trackList)
		end
		local function getMicroGlobalTrackIndexAtScreenY(screenY)
			local displayTrackList = getMicroDisplayTrackListSnapshot()
			if not displayTrackList or #displayTrackList == 0 or keyLayer.AbsoluteSize.Y &lt;= 1 then
				return nil
			end
			local localY = math.clamp(screenY - keyLayer.AbsolutePosition.Y, 0, math.max(0, keyLayer.AbsoluteSize.Y - 1))
			local row = math.clamp(math.floor(localY / microTrackHeight) + 1, 1, #displayTrackList)
			return math.clamp(microTrackOffset + row, 1, #displayTrackList)
		end
		local function updateMicroMarquee(input)
			if not microMarqueeState or not input then
				return
			end
			local scrolledWindow = autoScrollMicroFrameWindowForScreenX(input.Position.X)
			autoScrollMicroTracksForScreenY(input.Position.Y)
			local startPoint = microMarqueeState.start
			local currentPoint = Vector2.new(input.Position.X, input.Position.Y)
			local layerPos = keyLayer.AbsolutePosition
			local layerSize = keyLayer.AbsoluteSize
			local minX = math.clamp(math.min(startPoint.X, currentPoint.X) - layerPos.X, 0, layerSize.X)
			local maxX = math.clamp(math.max(startPoint.X, currentPoint.X) - layerPos.X, 0, layerSize.X)
			local minY = math.clamp(math.min(startPoint.Y, currentPoint.Y) - layerPos.Y, 0, layerSize.Y)
			local maxY = math.clamp(math.max(startPoint.Y, currentPoint.Y) - layerPos.Y, 0, layerSize.Y)
			microMarqueeState.rect = { minX = minX, maxX = maxX, minY = minY, maxY = maxY }
			microMarqueeState.currentFrame = getMicroFrameAtX(currentPoint.X) or microMarqueeState.currentFrame or microMarqueeState.anchorFrame
			microMarqueeState.currentTrackIndex = getMicroGlobalTrackIndexAtScreenY(currentPoint.Y) or microMarqueeState.currentTrackIndex or microMarqueeState.anchorTrackIndex
			microMarqueeState.moved = microMarqueeState.moved or (Vector2.new(maxX - minX, maxY - minY).Magnitude &gt;= 4)
			if scrolledWindow then
				refresh()
			end
			ensureMicroMarqueeBox()
			if microMarqueeBox then
				microMarqueeBox.Position = UDim2.fromOffset(
					(keyLayer.AbsolutePosition.X - scrubSurface.AbsolutePosition.X) + minX,
					(keyLayer.AbsolutePosition.Y - scrubSurface.AbsolutePosition.Y) + minY
				)
				microMarqueeBox.Size = UDim2.fromOffset(math.max(1, maxX - minX), math.max(1, maxY - minY))
			end
		end
		local function finishMicroMarquee()
			local state = microMarqueeState
			microMarqueeState = nil
			if microMarqueeBox then
				microMarqueeBox:Destroy()
				microMarqueeBox = nil
			end
			if not state or not state.moved or not state.rect then
				return false
			end
			local selected = {}
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			local displayTrackList = getMicroDisplayTrackListSnapshot()
			if timeline and displayTrackList and #displayTrackList &gt; 0 and type(timeline.getTrackKeyframesByPath) == "function" then
				local keyframesByPath = timeline:getTrackKeyframesByPath() or {}
				local anchorFrame = tonumber(state.anchorFrame)
				local currentFrame = tonumber(state.currentFrame)
				local anchorTrackIndex = tonumber(state.anchorTrackIndex)
				local currentTrackIndex = tonumber(state.currentTrackIndex)
				if anchorFrame and currentFrame and anchorTrackIndex and currentTrackIndex then
					local minFrame = math.min(anchorFrame, currentFrame)
					local maxFrame = math.max(anchorFrame, currentFrame)
					local minTrack = math.max(1, math.min(anchorTrackIndex, currentTrackIndex))
					local maxTrack = math.min(#displayTrackList, math.max(anchorTrackIndex, currentTrackIndex))
					for trackIndex = minTrack, maxTrack do
						local track = displayTrackList[trackIndex]
						local frames = track and keyframesByPath[track.path]
						if track and track.trackType == "Rig Group" and track.rigName then
							for _, sourceTrack in ipairs(timeline:getTracks() or {}) do
								if (sourceTrack.trackType or "Rig") == "Rig" and sourceTrack.rigName == track.rigName then
									for _, frame in ipairs(keyframesByPath[sourceTrack.path] or {}) do
										frame = tonumber(frame)
										if frame and frame &gt;= minFrame and frame &lt;= maxFrame then
											selected[#selected + 1] = {
												jointPath = sourceTrack.path,
												frame = frame,
											}
										end
									end
								end
							end
						elseif track and type(frames) == "table" then
							for _, frame in ipairs(frames) do
								frame = tonumber(frame)
								if frame and frame &gt;= minFrame and frame &lt;= maxFrame then
									selected[#selected + 1] = {
										jointPath = track.path,
										frame = frame,
									}
								end
							end
						end
					end
				end
			end
			selectMicroKeyList(selected, state.additive)
			miniTimelineSignature = nil
			refresh()
			return #selected &gt; 0
		end
		local function beginMicroMarquee(input, additiveOverride, startPointOverride)
			if not input or keyLayer.AbsoluteSize.X &lt;= 1 or keyLayer.AbsoluteSize.Y &lt;= 1 then
				return false
			end
			if input.Position.Y &lt; keyLayer.AbsolutePosition.Y then
				return false
			end
			microMarqueeState = {
				start = startPointOverride or Vector2.new(input.Position.X, input.Position.Y),
				additive = additiveOverride == true,
				anchorFrame = getMicroFrameAtX((startPointOverride or Vector2.new(input.Position.X, input.Position.Y)).X),
				currentFrame = getMicroFrameAtX(input.Position.X),
				anchorTrackIndex = getMicroGlobalTrackIndexAtScreenY((startPointOverride or Vector2.new(input.Position.X, input.Position.Y)).Y),
				currentTrackIndex = getMicroGlobalTrackIndexAtScreenY(input.Position.Y),
				moved = false,
				rect = nil,
			}
			ensureMicroMarqueeBox()
			updateMicroMarquee(input)
			return true
		end

		keyLayer.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton3 then
				MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, nil)
				beginMicroMiddlePan(input)
				return
			end
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, nil)
			if type(options.getIsPlaying) == "function" and options.getIsPlaying() and type(options.onPausePlaybackAtCurrent) == "function" then
				options.onPausePlaybackAtCurrent("Paused playback for timeline selection.")
			end
			microLanePressState = {
				start = Vector2.new(input.Position.X, input.Position.Y),
				additive = isMicroAdditiveSelection(),
				moved = false,
			}
		end)

		scrubSurface.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton3 then
				MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, nil)
				beginMicroMiddlePan(input)
				return
			end
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, nil)
			if input.Position.Y &gt;= keyLayer.AbsolutePosition.Y then
				if type(options.getIsPlaying) == "function" and options.getIsPlaying() and type(options.onPausePlaybackAtCurrent) == "function" then
					options.onPausePlaybackAtCurrent("Paused playback for timeline selection.")
				end
				microLanePressState = {
					start = Vector2.new(input.Position.X, input.Position.Y),
					additive = isMicroAdditiveSelection(),
					moved = false,
				}
				return
			end
			if type(options.getIsPlaying) == "function" and options.getIsPlaying() and type(options.onPausePlaybackAtCurrent) == "function" then
				options.onPausePlaybackAtCurrent("Paused playback for timeline scrub.")
			end
			microScrubbing = true
			microScrubStartPoint = Vector2.new(input.Position.X, input.Position.Y)
			microScrubMoved = false
			microLastScrubInput = input
			scrubTimelineAtInput(input, true, false)
			local now = os.clock()
			if now - lastMicroLaneClickClock &lt;= 0.32 then
				runOption(options, "onCaptureFrame", "captureFrame")
				miniTimelineSignature = nil
				refresh()
				lastMicroLaneClickClock = 0
			else
				lastMicroLaneClickClock = now
			end
		end)
		scrubSurface.InputChanged:Connect(function(input)
			if routeMicroWheel(input, "timeline") then
				return
			end
			if microLanePressState and input.UserInputType == Enum.UserInputType.MouseMovement then
				local currentPoint = Vector2.new(input.Position.X, input.Position.Y)
				microLanePressState.moved = microLanePressState.moved or ((currentPoint - microLanePressState.start).Magnitude &gt;= 4)
				if microLanePressState.moved then
					if not microMarqueeState then
						beginMicroMarquee(input, microLanePressState.additive, microLanePressState.start)
					else
						updateMicroMarquee(input)
					end
				end
				return
			end
			if microMarqueeState and input.UserInputType == Enum.UserInputType.MouseMovement then
				updateMicroMarquee(input)
				return
			end
			if not microScrubbing or input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end
			if microScrubStartPoint then
				local currentPoint = Vector2.new(input.Position.X, input.Position.Y)
				microScrubMoved = microScrubMoved or ((currentPoint - microScrubStartPoint).Magnitude &gt;= 5)
			end
			microLastScrubInput = input
			scrubTimelineAtInput(input, true, false)
		end)
		tracks.InputChanged:Connect(function(input)
			routeMicroWheel(input, "tracks")
		end)
		trackHeader.InputChanged:Connect(function(input)
			routeMicroWheel(input, "tracks")
		end)
		trackListFrame.InputChanged:Connect(function(input)
			routeMicroWheel(input, "tracks")
		end)
		attachMicroWheelGui(scrubSurface, "timeline")
		attachMicroWheelGui(tracks, "tracks")
		attachMicroWheelGui(trackHeader, "tracks")
		attachMicroWheelGui(trackListFrame, "tracks")
		trackScrollTrack.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline or trackScrollTrack.AbsoluteSize.Y &lt;= 1 then
				return
			end
			local trackList = timeline:getTracks()
			local displayTrackList = buildMicroDisplayTrackState(trackList)
			local visibleRows = math.max(1, math.floor((trackListFrame.AbsoluteSize.Y - 4) / microTrackHeight))
			local maxOffset = math.max(0, #displayTrackList - visibleRows)
			local alpha = math.clamp((input.Position.Y - trackScrollTrack.AbsolutePosition.Y) / trackScrollTrack.AbsoluteSize.Y, 0, 1)
			microTrackOffset = math.floor((maxOffset * alpha) + 0.5)
			microTrackDragging = true
			miniTimelineSignature = nil
			refresh()
		end)
		trackScrollHandle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				microTrackDragging = true
			end
		end)
		zoomInMicroButton.MouseButton1Click:Connect(function()
			zoomMicroTimeline(0.5)
		end)
		zoomOutMicroButton.MouseButton1Click:Connect(function()
			zoomMicroTimeline(2)
		end)
		zoomMicroSlider.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			microZoomDragging = true
			setMicroZoomFromX(input.Position.X, false)
		end)
		zoomMicroHandle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			microZoomDragging = true
		end)
		local function beginMicroFrameScrollDragFromX(screenX, dragMode)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline or frameScrollTrack.AbsoluteSize.X &lt;= 1 then
				return
			end
			microFrameDragMode = dragMode or "handle"
			if microFrameDragMode == "track" then
				local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
				local alpha = math.clamp((screenX - frameScrollTrack.AbsolutePosition.X) / frameScrollTrack.AbsoluteSize.X, 0, 1)
				setMicroFrameWindow((durationFrames * alpha) - (microVisibleFrames * 0.5), microVisibleFrames, nil)
			end
			microFrameDragging = true
			microFrameDragStartX = screenX
			microFrameDragStartFrame = microFrameStart
		end
		frameScrollTrack.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			beginMicroFrameScrollDragFromX(input.Position.X, "track")
		end)
		frameScrollTrack.MouseButton1Down:Connect(function()
			local mouseLocation = UserInputService:GetMouseLocation()
			beginMicroFrameScrollDragFromX(mouseLocation.X, "track")
		end)
		frameScrollHandle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			beginMicroFrameScrollDragFromX(input.Position.X, "handle")
		end)
		frameScrollHandle.MouseButton1Down:Connect(function()
			local mouseLocation = UserInputService:GetMouseLocation()
			beginMicroFrameScrollDragFromX(mouseLocation.X, "handle")
		end)
		UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton3 then
				local mouseLocation = UserInputService:GetMouseLocation()
				local mousePoint = Vector2.new(mouseLocation.X, mouseLocation.Y)
				if isMicroPointInside(scrubSurface, mousePoint) or isMicroPointInside(lanes, mousePoint) then
					beginMicroMiddlePan(input)
				end
				return
			end
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			local mouseLocation = UserInputService:GetMouseLocation()
			local mousePoint = Vector2.new(mouseLocation.X, mouseLocation.Y)
			if frameScrollHandle.Visible and isMicroPointInside(frameScrollHandle, mousePoint) then
				beginMicroFrameScrollDragFromX(mousePoint.X, "handle")
				return
			end
			if frameScrollTrack.Visible and isMicroPointInside(frameScrollTrack, mousePoint) then
				beginMicroFrameScrollDragFromX(mousePoint.X, "track")
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel and routeMicroWheel(input) then
				return
			end
			if updateMicroMiddlePan(input) then
				return
			end
			if microTrackReorderState and updateMicroTrackReorder(input) then
				return
			end
			if microMarqueeState and input.UserInputType == Enum.UserInputType.MouseMovement then
				updateMicroMarquee(input)
				return
			end
			if microKeyDragButton and input.UserInputType == Enum.UserInputType.MouseMovement then
				local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
				local scrolledWindow = autoScrollMicroFrameWindowForScreenX(input.Position.X)
				local cursorFrame = getMicroFrameAtX(input.Position.X)
				if timeline and cursorFrame then
					local frame = cursorFrame - math.max(0, math.floor(tonumber(microKeyDragCursorFrameOffset) or 0))
					frame = math.clamp(frame, 0, math.max(1, tonumber(timeline:getDurationFrames()) or frame))
					microKeyDragTargetFrame = frame
					microKeyDragMoved = microKeyDragMoved or frame ~= microKeyDragSourceFrame
					local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
					local x = getMicroFrameX(frame, durationFrames)
					if type(microKeyDragPreviewKeys) == "table" then
						local offsetFrames = frame - (microKeyDragSourceFrame or frame)
						for _, previewKey in ipairs(microKeyDragPreviewKeys) do
							if previewKey.button and previewKey.button.Parent then
								local previewFrame = previewKey.centerFrame or previewKey.frame or 0
								local previewX = getMicroFrameX(previewFrame + offsetFrames, durationFrames)
								local halfWidth = math.floor(math.max(1, previewKey.button.AbsoluteSize.X) * 0.5)
								previewKey.button.Position = UDim2.fromOffset(previewX - halfWidth, previewKey.y or previewKey.button.Position.Y.Offset)
							end
						end
					elseif microKeyDragButton then
						local dragHalfWidth = math.floor(math.max(1, microKeyDragButton.AbsoluteSize.X) * 0.5)
						microKeyDragButton.Position = UDim2.fromOffset(x - dragHalfWidth, microKeyDragButton.Position.Y.Offset)
					end
					setMicroKeyDragRulerHighlight(
						microUiHost,
						ruler,
						(microUiHost._microKeyDragRulerReferenceFrame or microKeyDragSourceFrame or frame) + (frame - (microKeyDragSourceFrame or frame)),
						microFrameStart,
						microVisibleFrames,
						type(timeline.getFps) == "function" and timeline:getFps() or 60,
						options
					)
				end
				if scrolledWindow then
					refresh()
				end
				return
			end
			if microZoomDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				setMicroZoomFromX(input.Position.X, false)
				return
			end
			if not microFrameDragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
				if not microTrackDragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
					return
				end
				local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
				if timeline and trackScrollTrack.AbsoluteSize.Y &gt; 1 then
					local trackList = timeline:getTracks()
					local displayTrackList = buildMicroDisplayTrackState(trackList)
					local visibleRows = math.max(1, math.floor((trackListFrame.AbsoluteSize.Y - 4) / microTrackHeight))
					local maxOffset = math.max(0, #displayTrackList - visibleRows)
					local alpha = math.clamp((input.Position.Y - trackScrollTrack.AbsolutePosition.Y) / trackScrollTrack.AbsoluteSize.Y, 0, 1)
					microTrackOffset = math.floor((maxOffset * alpha) + 0.5)
					miniTimelineSignature = nil
					refresh()
				end
				return
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline or frameScrollTrack.AbsoluteSize.X &lt;= 1 then
				return
			end
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			if microFrameDragMode == "track" then
				local alpha = math.clamp((input.Position.X - frameScrollTrack.AbsolutePosition.X) / frameScrollTrack.AbsoluteSize.X, 0, 1)
				setMicroFrameWindow((durationFrames * alpha) - (microVisibleFrames * 0.5), microVisibleFrames, nil, false)
			else
				local handleRatio = math.max(0.06, math.clamp(microVisibleFrames / durationFrames, 0, 1))
				local usableWidth = math.max(1, frameScrollTrack.AbsoluteSize.X * (1 - handleRatio))
				local maxFrameStart = math.max(0, durationFrames - microVisibleFrames)
				local deltaFrames = ((input.Position.X - microFrameDragStartX) / usableWidth) * maxFrameStart
				setMicroFrameWindow(microFrameDragStartFrame + deltaFrames, microVisibleFrames, nil, false)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton3 then
				endMicroMiddlePan()
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				if microTrackReorderState then
					finishMicroTrackReorder()
					return
				end
				local lanePressState = microLanePressState
				microLanePressState = nil
				if microMarqueeState then
					finishMicroMarquee()
					MicroWidgetController._armMicroTimelineOwnershipDeferred(options, plugin, statusLabel, "Micro timeline shortcuts active.", true)
				elseif lanePressState then
					if not lanePressState.moved then
						clearMicroKeySelectionForBlankTimelineTap(Vector2.new(input.Position.X, input.Position.Y), lanePressState.additive)
						options._microLastSelectionScope = "timeline"
						MicroWidgetController._armMicroTimelineOwnershipDeferred(options, plugin, statusLabel, "Micro timeline shortcuts active.", true)
					end
					scrubTimelineAtInput(input, false, false)
					local now = os.clock()
					if now - lastMicroLaneClickClock &lt;= 0.32 then
						runOption(options, "onCaptureFrame", "captureFrame")
						miniTimelineSignature = nil
						refresh()
						lastMicroLaneClickClock = 0
					else
						lastMicroLaneClickClock = now
					end
				end
				if microKeyDragButton and microKeyDragPath and microKeyDragSourceFrame and microKeyDragTargetFrame ~= nil then
					if not microKeyDragMoved
						and microKeyDragButton.Name == "MicroGroupedKeys"
						and microKeyDragButton:GetAttribute("MegMoGroupSelectionId") ~= nil then
						-- A no-drag release rebuilds the timeline before MouseButton1Click can
						-- reliably run. Commit the existing group-click selection first.
						selectMicroKeyList(microUiHost._microKeyDragClickRefs or microKeyDragSelectedRefs or {}, isMicroAdditiveSelection(), true)
						microUiHost._selectedMicroGroupIds = { microKeyDragButton:GetAttribute("MegMoGroupSelectionId") }
						options._microSelectedGroupIds = microUiHost._selectedMicroGroupIds
					end
					if microKeyDragMoved and microKeyDragTargetFrame ~= microKeyDragSourceFrame then
						local offset = math.floor(microKeyDragTargetFrame) - math.floor(microKeyDragSourceFrame)
						if microKeyDragSelected and (microKeyDragSelectedCount or 0) &gt; 1 and type(microKeyDragSelectedRefs) == "table" and #microKeyDragSelectedRefs &gt; 1 then
							if statusLabel then
								statusLabel.Text = string.format("Moved %d keyframes by %d frame%s.", #microKeyDragSelectedRefs, offset, math.abs(offset) == 1 and "" or "s")
							end
							runOption(options, "onMoveKeyRefsByOffset", "moveKeyRefsByOffset", microKeyDragSelectedRefs, offset)
						elseif microKeyDragSelected and (microKeyDragSelectedCount or 0) &gt; 1 then
							if statusLabel then
								statusLabel.Text = string.format("Moved %d keyframes by %d frame%s.", microKeyDragSelectedCount or 0, offset, math.abs(offset) == 1 and "" or "s")
							end
							runOption(options, "onMoveSelectedKeysByOffset", "moveSelectedKeysByOffset", offset)
						else
							if statusLabel then
								statusLabel.Text = string.format("Moved keyframe by %d frame%s.", offset, math.abs(offset) == 1 and "" or "s")
							end
							runOption(options, "onMoveKeyToFrame", "moveKeyToFrame", microKeyDragPath, microKeyDragSourceFrame, microKeyDragTargetFrame)
						end
						lastMicroKeyDragReleaseClock = os.clock()
					end
					microKeyDragButton = nil
					microKeyDragPath = nil
					microKeyDragSourceFrame = nil
					microKeyDragTargetFrame = nil
					microKeyDragCursorFrameOffset = 0
					microKeyDragMoved = false
					microKeyDragSelected = nil
					microKeyDragSelectedCount = 0
					microKeyDragSelectedRefs = nil
					microUiHost._microKeyDragClickRefs = nil
					microKeyDragPreviewKeys = nil
					microUiHost._microKeyDragRulerReferenceFrame = nil
					hideMicroKeyDragRulerHighlight(microUiHost)
					miniTimelineSignature = nil
					refresh()
				end
				if microScrubbing then
					scrubTimelineAtInput(input, false, false)
				end
				microScrubbing = false
				microScrubStartPoint = nil
				microScrubMoved = false
				microLastScrubInput = nil
				microUiHost._edgeFramePanClock = nil
				microUiHost._edgeFramePanRemainder = 0
				if microFrameDragging then
					microFrameDragging = false
					microFrameDragMode = nil
					saveMicroFrameWindow()
				end
				if microZoomDragging then
					microZoomDragging = false
					saveMicroFrameWindow()
				end
				microTrackDragging = false
				lastMicroScrubFrame = nil
			end
		end)

		renderMiniTimeline = function(timeline)
			if not timeline or not tracks.Parent or not lanes.Parent then
				return
			end
			layoutMiniTimelineColumns()
			local trackList = timeline:getTracks()
			local keyframesByPath = type(timeline.getTrackKeyframesByPath) == "function" and timeline:getTrackKeyframesByPath() or {}
			local soundClipsByPath = type(timeline.getSoundClipDataByPath) == "function" and timeline:getSoundClipDataByPath() or ((microUiHost._lastViewModel or {}).trackSoundClipsByPath or {})
			local subtitleClipsByPath = type(timeline.getSubtitleClipDataByPath) == "function" and timeline:getSubtitleClipDataByPath() or ((microUiHost._lastViewModel or {}).trackSubtitleClipsByPath or {})
			local fadeClipsByPath = type(timeline.getFadeClipDataByPath) == "function" and timeline:getFadeClipDataByPath() or ((microUiHost._lastViewModel or {}).trackFadeClipsByPath or {})
			local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 300)
			local currentFrame = getMicroDisplayFrame(timeline, options)
			local fps = math.max(1, tonumber(timeline:getFps()) or 60)
			local trackHeight = microTrackHeight
			local displayTrackList, hierarchyState, childCountByParentPath = buildMicroDisplayTrackState(trackList)
			local microTrackByPath = {}
			for _, sourceTrack in ipairs(trackList or {}) do
				if sourceTrack.path then
					microTrackByPath[sourceTrack.path] = sourceTrack
				end
			end
			for _, displayTrack in ipairs(displayTrackList or {}) do
				if displayTrack.path then
					microTrackByPath[displayTrack.path] = displayTrack
				end
			end
			local rigFrameKeys = {}
			for _, sourceTrack in ipairs(trackList or {}) do
				if sourceTrack.trackType == "Rig" and sourceTrack.rigName then
					local rigName = sourceTrack.rigName
					rigFrameKeys[rigName] = rigFrameKeys[rigName] or {}
					for _, frame in ipairs(keyframesByPath[sourceTrack.path] or {}) do
						local normalizedFrame = math.max(0, math.floor(tonumber(frame) or 0))
						local frameBucket = rigFrameKeys[rigName][normalizedFrame]
						if not frameBucket then
							frameBucket = {}
							rigFrameKeys[rigName][normalizedFrame] = frameBucket
						end
						frameBucket[#frameBucket + 1] = {
							jointPath = sourceTrack.path,
							frame = normalizedFrame,
						}
					end
				end
			end
			local availableRows = math.max(1, math.floor((trackListFrame.AbsoluteSize.Y - 4) / trackHeight))
			local visibleWidth = math.max(180, lanes.AbsoluteSize.X)
			if not microScrubbing and not microFrameDragging and not microKeyDragButton and not microMarqueeState and not microMiddlePanState then
				local manualFrameWindowAnchor = tonumber(microUiHost._manualFrameWindowAnchor)
				if isMicroPlaybackActive(options) or (manualFrameWindowAnchor ~= nil and math.abs(currentFrame - manualFrameWindowAnchor) &gt;= 0.5) then
					microUiHost._manualFrameWindowAnchor = nil
					manualFrameWindowAnchor = nil
				end
				if isMicroPlaybackActive(options) then
					local followStart = getMicroPlaybackFollowStart(currentFrame, microFrameStart, microVisibleFrames, durationFrames)
					if followStart and followStart ~= microFrameStart then
						microFrameStart = followStart
						clampMicroFrameWindow(durationFrames, nil)
						miniTimelineSignature = nil
					end
				elseif manualFrameWindowAnchor == nil and (currentFrame &lt; microFrameStart or currentFrame &gt; microFrameStart + microVisibleFrames) then
					setMicroFrameWindow(microFrameStart, microVisibleFrames, currentFrame, false)
					miniTimelineSignature = nil
				end
			end
			local visibleStartFrame, visibleEndFrame = clampMicroFrameWindow(durationFrames, nil)
			local visibleFrameRange = math.max(1, visibleEndFrame - visibleStartFrame)
			microTrackOffset = math.clamp(microTrackOffset, 0, math.max(0, #displayTrackList - availableRows))
			local maxTrackOffset = math.max(0, #displayTrackList - availableRows)
			trackScrollTrack.Visible = maxTrackOffset &gt; 0
			if maxTrackOffset &gt; 0 then
				local trackScrollHeight = math.max(18, math.floor(trackScrollTrack.AbsoluteSize.Y * math.clamp(availableRows / #displayTrackList, 0.08, 1)))
				local trackScrollUsable = math.max(1, trackScrollTrack.AbsoluteSize.Y - trackScrollHeight)
				trackScrollHandle.Size = UDim2.new(1, 0, 0, trackScrollHeight)
				trackScrollHandle.Position = UDim2.fromOffset(0, math.floor(trackScrollUsable * (microTrackOffset / maxTrackOffset)))
			end
			local looping = type(timeline.getLooping) == "function" and timeline:getLooping() == true
			loopMicroButton.BackgroundColor3 = looping and theme().Accent or theme().PanelSoft
			loopMicroButton.TextColor3 = ThemeService.getReadableTextColor(loopMicroButton.BackgroundColor3)
			loopMicroButton:SetAttribute("MegMoThemeBackgroundRole", looping and "Accent" or "PanelSoft")
			local timelinePixelWidth = math.max(1, keyLayer.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2))
			local function frameAlphaToX(alpha)
				return MICRO_FRAME_GUTTER + (math.clamp(alpha, 0, 1) * timelinePixelWidth)
			end
			local function updateMiniPlayhead()
				local playheadAlpha = (currentFrame - visibleStartFrame) / visibleFrameRange
				local playheadVisible = playheadAlpha &gt;= 0 and playheadAlpha &lt;= 1
				local playheadX = frameAlphaToX(playheadAlpha)
				if playheadLine and playheadLine.Parent then
					playheadLine.Visible = playheadVisible
					playheadLine.Position = UDim2.fromOffset(playheadX - 1, 0)
				end
				if playheadHandle and playheadHandle.Parent then
					playheadHandle.Visible = playheadVisible
					playheadHandle.Position = UDim2.fromOffset(playheadX - 3, 0)
				end
				local scrollVisibleRatio = math.clamp(microVisibleFrames / durationFrames, 0, 1)
				local scrollHandleRatio = math.max(0.06, scrollVisibleRatio)
				local maxFrameStart = math.max(1, durationFrames - microVisibleFrames)
				local scrollStartRatio = durationFrames &lt;= microVisibleFrames
					and 0
					or math.clamp(microFrameStart / maxFrameStart, 0, 1) * (1 - scrollHandleRatio)
				frameScrollHandle.Position = UDim2.new(scrollStartRatio, 0, 0, 0)
				frameScrollHandle.Size = UDim2.new(scrollHandleRatio, 0, 1, 0)
				frameScrollTrack.Visible = durationFrames &gt; microVisibleFrames
				updateMicroZoomSlider(durationFrames)
			end
			local visibleTrackCount = math.min(math.max(0, #displayTrackList - microTrackOffset), availableRows)
			local usedRulerTickLabels = {}
			local function renderMicroRulerTick(frame, alpha)
				local key = tostring(frame)
				usedRulerTickLabels[key] = true
				local label = miniTimelineRulerTickLabels[key]
				if not label or not label.Parent then
					label = text(ruler, {
						Name = "Tick" .. frame,
						Text = "",
						TextColor3 = theme().Text,
						TextSize = MICRO_RULER_TEXT_SIZE,
						Font = Enum.Font.GothamMedium,
						TextXAlignment = Enum.TextXAlignment.Center,
						Position = UDim2.fromOffset(0, 3),
						Size = UDim2.fromOffset(40, 16),
						ZIndex = 5,
					})
					miniTimelineRulerTickLabels[key] = label
				end
				label.Text = formatMicroFrameTick(frame, fps, options)
				label.TextColor3 = theme().Text
				label.Position = UDim2.fromOffset(frameAlphaToX(alpha) - 20, 3)
				label.Visible = true
			end
			local function pruneUnusedMicroRulerTicks()
				for key, label in pairs(miniTimelineRulerTickLabels) do
					if not usedRulerTickLabels[key] then
						if label and label.Parent then
							label:Destroy()
						end
						miniTimelineRulerTickLabels[key] = nil
					end
				end
			end
			local signatureParts = {
				tostring(#trackList),
				tostring(timeline:getKeyframeCount()),
				tostring(durationFrames),
				tostring(availableRows),
				tostring(microTrackOffset),
				tostring(looping),
				tostring(math.floor(visibleWidth)),
				tostring(math.floor(visibleStartFrame)),
				tostring(math.floor(microVisibleFrames)),
				tostring(options and options._microPlayheadDisplayMode or "seconds"),
			}
			local collapsedSignaturePaths = {}
			for path, isCollapsed in pairs(microCollapsedTrackPaths) do
				if isCollapsed then
					collapsedSignaturePaths[#collapsedSignaturePaths + 1] = tostring(path)
				end
			end
			table.sort(collapsedSignaturePaths)
			for _, path in ipairs(collapsedSignaturePaths) do
				signatureParts[#signatureParts + 1] = "collapsed:" .. path
			end
			local hiddenSignaturePaths = {}
			for path, isHidden in pairs(microHiddenTracks) do
				if isHidden then
					hiddenSignaturePaths[#hiddenSignaturePaths + 1] = tostring(path)
				end
			end
			table.sort(hiddenSignaturePaths)
			for _, path in ipairs(hiddenSignaturePaths) do
				signatureParts[#signatureParts + 1] = "hidden:" .. path
			end
			local selectedTrackMap, selectedTrackList = getMicroSelectedTrackMap(options)
			if #selectedTrackList == 0 then
				selectedMicroTrackPath = nil
			elseif not selectedMicroTrackPath or not selectedTrackMap[selectedMicroTrackPath] then
				selectedMicroTrackPath = selectedTrackList[#selectedTrackList]
			elseif selectedMicroTrackPath and not hasMicroTrack(selectedMicroTrackPath) then
				selectedMicroTrackPath = nil
			end
			for _, path in ipairs(selectedTrackList) do
				signatureParts[#signatureParts + 1] = tostring(path)
			end
			local selectedKeyMap, selectedKeyList = getMicroSelectedKeyMap(options)
			for _, key in ipairs(selectedKeyList) do
				signatureParts[#signatureParts + 1] = tostring(key.jointPath) .. "@" .. tostring(key.frame)
				if type(timeline.getKeyOptions) == "function" then
					local ok, keyOptions = pcall(timeline.getKeyOptions, timeline, key.jointPath, key.frame)
					if ok and type(keyOptions) == "table" then
						signatureParts[#signatureParts + 1] = tostring(keyOptions.easingStyle) .. "/" .. tostring(keyOptions.easingDirection)
					end
				end
			end
			local trackSignatureParts = {
				tostring(#trackList),
				tostring(#displayTrackList),
				tostring(availableRows),
				tostring(visibleTrackCount),
				tostring(microTrackOffset),
				tostring(math.floor(trackColumnWidth)),
				tostring(math.floor(trackListFrame.AbsoluteSize.X)),
				tostring(math.floor(trackHeight)),
			}
			for row = 1, visibleTrackCount do
				local trackIndex = microTrackOffset + row
				local track = displayTrackList[trackIndex]
				if track then
					trackSignatureParts[#trackSignatureParts + 1] = table.concat({
						tostring(track.path),
						tostring(track.trackType),
						tostring(track.targetScope),
						tostring(track.name),
						tostring(track.part1),
						tostring(track.parentTrackName),
						tostring(track.rigName),
						tostring(track.reorderPath),
						tostring(track.reorderScope),
						tostring(track.disabled == true),
						tostring(selectedTrackMap[track.path] == true or selectedMicroTrackPath == track.path),
						tostring(microCollapsedTrackPaths[track.path] == true),
						tostring(microHiddenTracks[track.path] == true),
						tostring(childCountByParentPath[track.path] or 0),
						tostring((hierarchyState.metaByPath[track.path] or {}).hasChildren == true),
					}, "|")
				end
			end
			local trackSignature = table.concat(trackSignatureParts, ":")
			local shouldRebuildTrackList = trackSignature ~= miniTimelineTrackSignature
			for _, sourceTrack in ipairs(trackList or {}) do
				local frames = keyframesByPath[sourceTrack.path]
				if type(frames) == "table" and #frames &gt; 0 then
					signatureParts[#signatureParts + 1] = "keys:" .. tostring(sourceTrack.path)
					for _, frame in ipairs(frames) do
						signatureParts[#signatureParts + 1] = tostring(frame)
					end
				end
				local clips = soundClipsByPath[sourceTrack.path]
				if type(clips) == "table" and #clips &gt; 0 then
					signatureParts[#signatureParts + 1] = "sound:" .. tostring(sourceTrack.path)
					for _, clip in ipairs(clips) do
						signatureParts[#signatureParts + 1] = tostring(clip.frame) .. "-" .. tostring(clip.endFrame)
						signatureParts[#signatureParts + 1] = tostring(clip.startOffsetSeconds or 0)
						signatureParts[#signatureParts + 1] = tostring(clip.endTrimSeconds or 0)
						signatureParts[#signatureParts + 1] = tostring(clip.fadeInSeconds or 0)
						signatureParts[#signatureParts + 1] = tostring(clip.fadeOutSeconds or 0)
						signatureParts[#signatureParts + 1] = tostring(clip.clipDurationSeconds or 0)
					end
				end
				local subtitleClips = subtitleClipsByPath[sourceTrack.path]
				if type(subtitleClips) == "table" and #subtitleClips &gt; 0 then
					signatureParts[#signatureParts + 1] = "subtitle:" .. tostring(sourceTrack.path)
					for _, clip in ipairs(subtitleClips) do
						signatureParts[#signatureParts + 1] = tostring(clip.frame) .. "-" .. tostring(clip.endFrame)
						signatureParts[#signatureParts + 1] = tostring(clip.text or "")
					end
				end
				local fadeClips = fadeClipsByPath[sourceTrack.path]
				if type(fadeClips) == "table" and #fadeClips &gt; 0 then
					signatureParts[#signatureParts + 1] = "fade:" .. tostring(sourceTrack.path)
					for _, clip in ipairs(fadeClips) do
						signatureParts[#signatureParts + 1] = tostring(clip.frame) .. "-" .. tostring(clip.endFrame)
						signatureParts[#signatureParts + 1] = tostring(clip.label or "")
						signatureParts[#signatureParts + 1] = tostring(clip.startTransparency or "")
						signatureParts[#signatureParts + 1] = tostring(clip.endTransparency or "")
					end
				end
			end
			MicroKeyGroupSupport.appendSignatureParts(signatureParts, microUiHost._lastViewModel)
			local signature = table.concat(signatureParts, ":")
			if signature == miniTimelineSignature then
				microUiHost._miniTimelineRendered = true
				updateMiniPlayhead()
				return
			end
			miniTimelineSignature = signature

			if shouldRebuildTrackList then
				clearGuiChildren(trackListFrame)
				miniTimelineTrackSignature = trackSignature
			end
			clearGuiChildren(keyLayer)
			microVisibleKeyRects = {}
			microVisibleKeyButtons = {}
			if shouldRebuildTrackList then
				microTrackReorderTargets = {}
			end
			local microGroupDragState = MicroKeyGroupSupport.buildDragState(microUiHost._lastViewModel)
			local microGroupVisualState = MicroKeyGroupSupport.buildVisualState(microUiHost._lastViewModel)

			local frameTickStep = chooseMicroFrameTickStep(visibleFrameRange, visibleWidth, fps)
			local function renderMicroGroupClip(clip, trackPath, rowY, trackColor)
				if not clip or not trackPath or clip.maxFrame &lt; visibleStartFrame or clip.minFrame &gt; visibleEndFrame then
					return
				end
				local groupBlockVisualSupport = require(script.Parent.Parent:WaitForChild("KeyframeGroupBlockVisualSupport"))
				local startX = MICRO_FRAME_GUTTER + (((clip.minFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
				local endX = MICRO_FRAME_GUTTER + (((clip.maxFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
				local clipWidth = groupBlockVisualSupport.getWidth(clip, startX, endX)
				local clipCenterX = startX + ((endX - startX) * 0.5)
				local clipHeight = math.max(16, trackHeight - 8)
				local clipY = rowY + math.floor((trackHeight - clipHeight) * 0.5)
				local clipSelected = true
				for _, keyRef in ipairs(clip.selectKeys or {}) do
					if not selectedKeyMap[MicroKeyGroupSupport.selectedKeyId(keyRef.jointPath, keyRef.frame)] then
						clipSelected = false
						break
					end
				end
				local clipMode = clip.mode
				local clipColor = groupBlockVisualSupport.getColor(clipMode, nil, trackColor)
				local clipButton = make("TextButton", {
					Name = "MicroGroupedKeys",
					Active = true,
					AutoButtonColor = true,
					BackgroundColor3 = clipColor,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(clipCenterX - math.floor(clipWidth * 0.5), clipY),
					Size = UDim2.fromOffset(clipWidth, clipHeight),
					Text = groupBlockVisualSupport.getLabel(clip, clipWidth),
					TextColor3 = groupBlockVisualSupport.getTextColor(clipMode, clipColor),
					TextSize = 10,
					Font = Enum.Font.GothamBold,
					ZIndex = 10,
				}, keyLayer)
				clipButton:SetAttribute("MegMoGroupSelectionId", clip.groupId)
				clipButton.BackgroundTransparency = 0.04
				corner(clipButton, 6)
				make("UIStroke", {
					Color = clipSelected and theme().Text or clipColor:Lerp(Color3.new(0, 0, 0), 0.45),
					Thickness = clipSelected and 2.4 or 1.4,
					Transparency = clipSelected and 0 or 0.08,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				}, clipButton)
				groupBlockVisualSupport.attachTimingHandle({
					makeInstance = make,
					parent = clipButton,
					mode = clipMode,
					groupId = clip.groupId,
					startFrame = clip.minFrame,
					endFrame = clip.maxFrame,
					sourceSpanFrames = clip.sourceSpanFrames,
					clipWidth = clipWidth,
					clipHeight = clipHeight,
					visibleStartFrame = visibleStartFrame,
					visibleFrameRange = visibleFrameRange,
					timelinePixelWidth = timelinePixelWidth,
					timelineLayer = keyLayer,
					gutter = MICRO_FRAME_GUTTER,
					durationFrames = durationFrames,
					statusLabel = statusLabel,
					refresh = refresh,
					onStretchGroupToFrame = function(...)
						return runOption(options, "onStretchGroupToFrame", "stretchGroupToFrame", ...)
					end,
					onRepeatGroupToFrame = function(...)
						return runOption(options, "onRepeatGroupToFrame", "repeatGroupToFrame", ...)
					end,
					onPreviewTimingFrame = function(targetFrame, nextWidth)
						local nextCenterX = startX + (nextWidth * 0.5)
						clipButton.Position = UDim2.fromOffset(nextCenterX - math.floor(nextWidth * 0.5), clipY)
						clipButton.Size = UDim2.fromOffset(math.max(20, nextWidth), clipHeight)
						setMicroKeyDragRulerHighlight(
							microUiHost,
							ruler,
							targetFrame,
							visibleStartFrame,
							visibleFrameRange,
							fps,
							options
						)
						local previewClip = {
							groupId = clip.groupId,
							mode = clipMode,
							name = clip.name,
							kind = clip.kind,
							isAggregate = clip.isAggregate,
							minFrame = clip.minFrame,
							maxFrame = targetFrame,
							sourceSpanFrames = clip.sourceSpanFrames,
						}
						clipButton.Text = groupBlockVisualSupport.getLabel(previewClip, nextWidth)
					end,
					zIndex = 12,
				})
				local clipId = "groupclip:" .. tostring(clip.groupId) .. ":" .. tostring(trackPath) .. ":" .. tostring(clip.firstFrame)
				microVisibleKeyRects[#microVisibleKeyRects + 1] = {
					path = trackPath,
					frame = clip.firstFrame,
					centerX = clipCenterX,
					centerY = rowY + math.floor(trackHeight * 0.5),
				}
				microVisibleKeyButtons[clipId] = {
					button = clipButton,
					path = trackPath,
					frame = clip.firstFrame,
					centerFrame = clip.minFrame + ((clip.maxFrame - clip.minFrame) * 0.5),
					groupId = clip.groupId,
					x = clipCenterX,
					y = clipY,
					size = clipWidth,
				}
				local function beginGroupClipDrag(point)
					if clipButton:GetAttribute("MegMoGroupTimingSuppressClick") then
						return
					end
					if microKeyDragButton == clipButton then
						return
					end
					local clickRefs = clip.selectKeys or {}
					local refs = clip.dragKeys or clickRefs
					if #refs == 0 then
						return
					end
					microKeyDragButton = clipButton
					microUiHost._selectedMicroGroupIds = { clip.groupId }
					options._microSelectedGroupIds = { clip.groupId }
					microKeyDragPath = refs[1].jointPath or trackPath
					microKeyDragSourceFrame = math.floor(tonumber(clip.firstFrame) or 0)
					microKeyDragTargetFrame = microKeyDragSourceFrame
					local cursorFrame = point and getMicroFrameAtX(point.X)
					microKeyDragCursorFrameOffset = cursorFrame and math.floor(cursorFrame - microKeyDragSourceFrame) or 0
					microKeyDragMoved = false
					microKeyDragSelected = true
					microKeyDragSelectedCount = #refs
					microKeyDragSelectedRefs = {}
					microUiHost._microKeyDragClickRefs = MicroWidgetController._copyMicroKeyRefs(clickRefs)
					for _, keyRef in ipairs(refs) do
						microKeyDragSelectedRefs[#microKeyDragSelectedRefs + 1] = {
							jointPath = keyRef.jointPath,
							frame = keyRef.frame,
						}
					end
					microKeyDragPreviewKeys = {}
					for _, previewInfo in pairs(microVisibleKeyButtons) do
						if previewInfo.groupId == clip.groupId
							and previewInfo.path == trackPath
							and previewInfo.button
							and previewInfo.button.Parent then
							microKeyDragPreviewKeys[#microKeyDragPreviewKeys + 1] = previewInfo
							previewInfo.button.ZIndex = 12
						end
					end
					if #microKeyDragPreviewKeys == 0 then
						microKeyDragPreviewKeys[1] = microVisibleKeyButtons[clipId]
					end
					microUiHost._microKeyDragRulerReferenceFrame = getMicroKeyDragRulerReferenceFrame(microKeyDragSelectedRefs, microKeyDragSourceFrame)
					if statusLabel then
						statusLabel.Text = string.format("Dragging grouped keyframes (%d).", #refs)
					end
				end
				clipButton.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						beginGroupClipDrag(Vector2.new(input.Position.X, input.Position.Y))
					end
				end)
				clipButton.MouseButton1Down:Connect(function(x, yPos)
					beginGroupClipDrag(Vector2.new(x, yPos))
				end)
				clipButton.MouseButton1Click:Connect(function()
					if clipButton:GetAttribute("MegMoGroupTimingSuppressClick") then
						return
					end
					if os.clock() - lastMicroKeyDragReleaseClock &lt; 0.12 then
						return
					end
					selectMicroKeyList(clip.selectKeys or {}, isMicroAdditiveSelection(), true)
					microUiHost._selectedMicroGroupIds = { clip.groupId }
					options._microSelectedGroupIds = { clip.groupId }
					miniTimelineSignature = nil
					refresh()
				end)
			end
			local function getTrackDisplay(track)
				local trackType = tostring(track.trackType or "")
				if track.isMicroVirtualTrack then
					local depth = tonumber(track.microDepth) or 0
					local indent = string.rep(" ", depth * 2)
					local label = tostring(track.name or "Section")
					local color = track.virtualKind == "RigHeader" and theme().Text or theme().MutedText
					return indent .. label, depth, color
				end
				if trackType == "Rig Group" then
					return "  Rig", 1, theme().Text
				end
				local rawName = track.part1 or track.parentTrackName or track.name or track.propertyName or track.path
				local depth = 0
				if trackType == "Rig" then
					local meta = hierarchyState.metaByPath[track.path] or {}
					depth = 2 + (tonumber(meta.depth) or 0)
					if track.rigName and tostring(rawName or "") == tostring(track.rigName) then
						rawName = track.part1 or track.name or "Root"
						if tostring(rawName or "") == tostring(track.rigName) then
							rawName = "Root"
						end
					end
				elseif (trackType == "Event" or track.valueType == "Event") and track.rigName and track.targetScope == "RigEvent" then
					depth = 1
					rawName = track.name or "Events"
				elseif trackType == "Rig Property" or trackType == "Rig CFrame" or track.targetScope == "RigProperty" then
					depth = 2
				elseif track.parentTrackPath then
					local parentTrack = microTrackByPath[track.parentTrackPath]
					if parentTrack and tostring(parentTrack.trackType or "") == "Rig" then
						local parentMeta = hierarchyState.metaByPath[parentTrack.path] or {}
						depth = 3 + (tonumber(parentMeta.depth) or 0)
					elseif parentTrack and parentTrack.isMicroVirtualTrack then
						depth = (tonumber(parentTrack.microDepth) or 0) + 1
					else
						depth = 1
					end
				elseif track.targetScope == "TimelineFolder" then
					depth = 0
				end
				local indent = string.rep(" ", depth * 2)
				local color = theme().Text
				return indent .. tostring(rawName or "Track"), depth, color
			end
			local function getFullTrackDisplayName(track)
				if not track then
					return "Track"
				end
				if track.isMicroVirtualTrack then
					return tostring(track.name or "Section")
				end
				if tostring(track.trackType or "") == "Rig Group" then
					return "Rig - key all rig parts"
				end
				if (track.trackType == "Event" or track.valueType == "Event") and track.rigName and track.targetScope == "RigEvent" then
					return "Events - developer animation event keyframes"
				end
				return tostring(track.part1 or track.parentTrackName or track.name or track.propertyName or track.path or "Track")
			end
			local function isTrackCollapsible(track)
				if not track then
					return false
				end
				if track.isMicroVirtualTrack then
					return track.virtualKind == "RigHeader" or track.virtualKind == "Properties"
				end
				if track.trackType == "Rig Group" or track.targetScope == "TimelineFolder" then
					return true
				end
				local meta = hierarchyState.metaByPath[track.path] or {}
				return meta.hasChildren == true or (childCountByParentPath[track.path] or 0) &gt; 0
			end
			local function getMicroTrackRowColors(track, isSelected)
				local colors = WidgetVisualSupport.getTrackRowColors(
					track,
					isSelected,
					track.disabled == true,
					(track.targetScope == "TimelineFolder" or track.trackType == "Folder") and getFolderColor(track) or nil
				)
				if not isSelected
					and (track.targetScope == "TimelineFolder" or track.trackType == "Folder") then
					colors.trackCard = theme().Panel
				end
				return colors
			end
			local function getMicroReorderTarget(track, direction)
				if not track then
					return nil
				end
				local sourcePath = track.reorderPath or track.path
				local sourceScope = track.reorderScope or getTrackReorderScope(track)
				local sourceIndex = nil
				for index, candidate in ipairs(displayTrackList) do
					if (candidate.reorderPath or candidate.path) == sourcePath then
						sourceIndex = index
						break
					end
				end
				if not sourceIndex then
					return nil
				end
				local step = direction == "Up" and -1 or 1
				local candidate = displayTrackList[sourceIndex + step]
				if not candidate or (candidate.reorderScope or getTrackReorderScope(candidate)) ~= sourceScope then
					return nil
				end
				return candidate
			end
			local function shouldShowMicroReorder(track)
				if not track then
					return false
				end
				if track.isMicroVirtualTrack then
					return track.virtualKind == "RigHeader" and track.reorderPath ~= nil
				end
				return track.trackType ~= "Rig Group" and track.rigName == nil and track.parentTrackPath == nil
			end
			local function shouldShowMicroTrackMenu(track)
				if not track then
					return false
				end
				if track.isMicroVirtualTrack then
					return track.virtualKind == "RigHeader"
				end
				local trackType = track.trackType
				return trackType == "Screen Effect"
					or trackType == "Lighting Effect"
					or trackType == "Camera"
					or trackType == "Camera Property"
					or trackType == "Event"
					or track.valueType == "Event"
					or trackType == "Rig"
					or trackType == "Rig Group"
					or trackType == "Rig Property"
					or trackType == "Object"
					or trackType == "Object Property"
					or trackType == "Emitter Group"
					or trackType == "Emitter Group Property"
					or trackType == "Folder"
					or track.targetScope == "TimelineFolder"
					or trackType == "Model"
					or trackType == "Rig CFrame"
					or trackType == "Sound"
			end
			local function hideMicroTrackReorderIndicator()
				if microTrackReorderIndicator and microTrackReorderIndicator.Parent then
					microTrackReorderIndicator.Visible = false
				end
			end
			local function showMicroTrackReorderIndicator(contentY)
				if not microTrackReorderIndicator or microTrackReorderIndicator.Parent ~= trackListFrame then
					microTrackReorderIndicator = make("Frame", {
						Name = "MicroTrackReorderIndicator",
						BackgroundColor3 = theme().Accent,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(2, 0),
						Size = UDim2.new(1, -4, 0, 4),
						Visible = false,
						ZIndex = 20,
					}, trackListFrame)
					stroke(microTrackReorderIndicator, theme().Accent, 0, 1, "Accent")
				end
				microTrackReorderIndicator.Position = UDim2.fromOffset(2, math.floor(contentY - 2))
				microTrackReorderIndicator.Visible = true
			end
			local function getMicroTrackReorderDropTarget(point, sourcePath)
				local best = nil
				local bestDistance = math.huge
				local sourceScope = nil
				local sourceTop = nil
				local sourceBottom = nil
				for _, target in ipairs(microTrackReorderTargets or {}) do
					if target.path == sourcePath and target.gui and target.gui.Parent then
						sourceScope = target.scope
						sourceTop = target.gui.AbsolutePosition.Y
						sourceBottom = sourceTop + target.gui.AbsoluteSize.Y
						break
					end
				end
				if sourceTop and sourceBottom and point.Y &gt;= sourceTop - 2 and point.Y &lt;= sourceBottom + 2 then
					return nil
				end
				for _, target in ipairs(microTrackReorderTargets or {}) do
					local gui = target.gui
					if target.path ~= sourcePath and (not sourceScope or target.scope == sourceScope) and gui and gui.Parent then
						local rowTop = gui.AbsolutePosition.Y
						local rowBottom = rowTop + gui.AbsoluteSize.Y
						local distance = 0
						if point.Y &lt; rowTop then
							distance = rowTop - point.Y
						elseif point.Y &gt; rowBottom then
							distance = point.Y - rowBottom
						end
						if distance &lt; bestDistance then
							local placement = point.Y &gt; ((rowTop + rowBottom) * 0.5) and "After" or "Before"
							local edgeY = placement == "After" and rowBottom or rowTop
							bestDistance = distance
							best = {
								path = target.path,
								placement = placement,
								contentY = edgeY - trackListFrame.AbsolutePosition.Y,
								name = target.name,
							}
						end
					end
				end
				return best
			end
			beginMicroTrackReorder = function(track, inputObject)
				if not shouldShowMicroReorder(track) then
					return
				end
				local startPoint = inputObject and inputObject.Position and Vector2.new(inputObject.Position.X, inputObject.Position.Y)
				if not startPoint then
					local mouseLocation = UserInputService:GetMouseLocation()
					startPoint = Vector2.new(mouseLocation.X, mouseLocation.Y)
				end
				microTrackReorderState = {
					path = track.reorderPath or track.path,
					scope = track.reorderScope or getTrackReorderScope(track),
					startPoint = startPoint,
					latestPoint = startPoint,
					started = false,
					target = nil,
				}
				hideMicroTrackReorderIndicator()
				if statusLabel then
					statusLabel.Text = "Drag track handle up or down to reorder."
				end
			end
			updateMicroTrackReorder = function(inputObject)
				local state = microTrackReorderState
				if not state or not inputObject or inputObject.UserInputType ~= Enum.UserInputType.MouseMovement then
					return false
				end
				local point = Vector2.new(inputObject.Position.X, inputObject.Position.Y)
				state.latestPoint = point
				if not state.started and (point - state.startPoint).Magnitude &gt;= 2 then
					state.started = true
				end
				autoScrollMicroTracksForScreenY(point.Y)
				local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
				if not timeline then
					state.target = nil
					hideMicroTrackReorderIndicator()
					return true
				end
				local target = getMicroTrackReorderDropTarget(point, state.path)
				if not target then
					state.target = nil
					hideMicroTrackReorderIndicator()
					if statusLabel and state.started then
						statusLabel.Text = "Move over another parent track in the same section."
					end
					return true
				end
				state.target = target
				showMicroTrackReorderIndicator(target.contentY)
				if statusLabel and state.started then
					statusLabel.Text = string.format("Drop %s %s", target.placement == "Before" and "before" or "after", tostring(target.name))
				end
				return true
			end
			finishMicroTrackReorder = function()
				local state = microTrackReorderState
				microTrackReorderState = nil
				hideMicroTrackReorderIndicator()
				if not state then
					return false
				end
				if state.started and state.target then
					local ok, message = runOption(options, "onReorderTrack", "reorderTrack", state.path, state.target.path, state.target.placement)
					if ok then
						miniTimelineSignature = nil
						refresh()
						if statusLabel then
							statusLabel.Text = tostring(message or "Track reordered.")
						end
						return true
					end
					if statusLabel then
						statusLabel.Text = tostring(message or "Track reorder failed.")
					end
					return false
				end
				if statusLabel then
					statusLabel.Text = "Track reorder cancelled."
				end
				return false
			end
			local firstTickFrame = math.ceil(visibleStartFrame / frameTickStep) * frameTickStep
			local minorTickStep = frameTickStep &gt;= 10 and math.max(1, math.floor(frameTickStep / 2)) or nil
			if minorTickStep and (visibleWidth / math.max(1, visibleFrameRange / minorTickStep)) &gt;= 18 then
				local firstMinorTick = math.ceil(visibleStartFrame / minorTickStep) * minorTickStep
				for frame = firstMinorTick, visibleEndFrame, minorTickStep do
					if frame % frameTickStep ~= 0 then
						local alpha = math.clamp((frame - visibleStartFrame) / visibleFrameRange, 0, 1)
						make("Frame", {
							Name = "MinorGridTick" .. frame,
							BackgroundColor3 = theme().Border,
							BackgroundTransparency = MICRO_GRID_MINOR_TRANSPARENCY,
							BorderSizePixel = 0,
							Position = UDim2.fromOffset(frameAlphaToX(alpha), 0),
							Size = UDim2.new(0, 1, 1, 0),
							ZIndex = 4,
						}, keyLayer)
					end
				end
			end
			for frame = firstTickFrame, visibleEndFrame, frameTickStep do
				local alpha = math.clamp((frame - visibleStartFrame) / visibleFrameRange, 0, 1)
				make("Frame", {
					Name = "GridTick" .. frame,
					BackgroundColor3 = theme().Border,
					BackgroundTransparency = MICRO_GRID_MAJOR_TRANSPARENCY,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(frameAlphaToX(alpha), 0),
					Size = UDim2.new(0, 1, 1, 0),
					ZIndex = 4,
				}, keyLayer)
				renderMicroRulerTick(frame, alpha)
			end
			pruneUnusedMicroRulerTicks()
			if microKeyDragButton and microKeyDragTargetFrame ~= nil then
				setMicroKeyDragRulerHighlight(
					microUiHost,
					ruler,
					(microUiHost._microKeyDragRulerReferenceFrame or microKeyDragSourceFrame or microKeyDragTargetFrame) + (microKeyDragTargetFrame - (microKeyDragSourceFrame or microKeyDragTargetFrame)),
					visibleStartFrame,
					visibleFrameRange,
					fps,
					options
				)
			else
				hideMicroKeyDragRulerHighlight(microUiHost)
			end

			for row = 1, visibleTrackCount do
				local trackIndex = microTrackOffset + row
				local track = displayTrackList[trackIndex]
				local y = (row - 1) * trackHeight + 1
				local labelText, _, labelColor = getTrackDisplay(track)
				local isMicroSelected = selectedTrackMap[track.path] == true or selectedMicroTrackPath == track.path
				local collapsible = isTrackCollapsible(track)
				local isCollapsed = microCollapsedTrackPaths[track.path] == true
				local isTrackHidden = microHiddenTracks[track.path] == true
				local showReorderControls = shouldShowMicroReorder(track)
				local showTrackMenu = shouldShowMicroTrackMenu(track)
				local rowColors = getMicroTrackRowColors(track, isMicroSelected)
				if shouldRebuildTrackList then
					local rowButton = make("TextButton", {
						Name = "TrackRow" .. row,
						AutoButtonColor = true,
						BackgroundColor3 = rowColors.trackCard,
						BackgroundTransparency = isMicroSelected and 0.18 or 0,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(2, y - 1),
						Size = UDim2.new(1, -4, 0, trackHeight),
						Text = "",
						ZIndex = 4,
					}, trackListFrame)
					if isTrackHidden then
						rowButton.BackgroundTransparency = 0.35
					end
					stroke(rowButton, isMicroSelected and theme().Accent or theme().Border, isMicroSelected and 0.05 or 0.2, isMicroSelected and 1.2 or 1, isMicroSelected and "Accent" or "Border")
					rowButton.MouseEnter:Connect(function()
						rowButton.BackgroundTransparency = isTrackHidden and 0.22 or 0.08
					end)
					rowButton.MouseLeave:Connect(function()
						if isTrackHidden then
							rowButton.BackgroundTransparency = (selectedMicroTrackPath == track.path or selectedTrackMap[track.path] == true) and 0.28 or 0.35
						else
							rowButton.BackgroundTransparency = (selectedMicroTrackPath == track.path or selectedTrackMap[track.path] == true) and 0.18 or 0
						end
					end)
					rowButton.MouseButton1Click:Connect(function()
						local mouseLocation = UserInputService:GetMouseLocation()
						if featurePopup
							and featurePopup.Parent
							and featurePopup.Visible
							and isMicroPointInside(featurePopup, Vector2.new(mouseLocation.X, mouseLocation.Y)) then
							return
						end
						if track.isMicroVirtualTrack then
							if collapsible then
								microCollapsedTrackPaths[track.path] = not microCollapsedTrackPaths[track.path]
								microTrackOffset = math.max(0, microTrackOffset - 1)
								miniTimelineSignature = nil
								miniTimelineTrackSignature = nil
								refresh()
							end
							return
						end
						if track.trackType ~= "Folder" and track.targetScope ~= "TimelineFolder" and consumeMicroTrackDoubleClick(track.path) then
							runOption(options, "onCaptureTrackFrame", "captureTrackFrame", track.path)
							selectedMicroTrackPath = track.path
							options._microLastSelectionScope = "track"
							statusLabel.Text = "Added key at playhead"
							miniTimelineSignature = nil
							refresh()
							return
						end
						selectedMicroTrackPath = track.path
						options._microLastSelectionScope = "track"
						local additiveSelection = isMicroAdditiveSelection()
						local alreadyOnlySelectedTrack = (not additiveSelection)
							and selectedTrackMap[track.path] == true
							and #selectedTrackList == 1
						if alreadyOnlySelectedTrack then
							selectedMicroTrackPath = nil
						end
						runOption(
							options,
							"onSelectTrack",
							"selectTrack",
							track.path,
							additiveSelection
						)
						if alreadyOnlySelectedTrack then
							MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
							statusLabel.Text = "Selection cleared"
						else
							statusLabel.Text = truncateName(track.name or track.part1 or track.path or "Track", 42)
						end
						miniTimelineSignature = nil
						refresh()
					end)
					if showReorderControls then
						microTrackReorderTargets[#microTrackReorderTargets + 1] = {
							path = track.reorderPath or track.path,
							gui = rowButton,
							scope = track.reorderScope or getTrackReorderScope(track),
							name = track.name or track.part1 or track.rigName or track.path,
						}
					end
					local collapseButton = make("TextButton", {
						Name = "Collapse" .. row,
						AutoButtonColor = true,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Font = Enum.Font.GothamBold,
						Text = collapsible and (isCollapsed and "&gt;" or "v") or "",
						TextColor3 = collapsible and theme().Accent or theme().MutedText,
						TextSize = 11,
						TextXAlignment = Enum.TextXAlignment.Center,
						Position = UDim2.fromOffset(showReorderControls and 18 or 4, y),
						Size = UDim2.fromOffset(12, trackHeight),
						ZIndex = 7,
					}, trackListFrame)
					if collapsible then
						collapseButton.MouseButton1Click:Connect(function()
							microCollapsedTrackPaths[track.path] = not microCollapsedTrackPaths[track.path]
							microTrackOffset = math.max(0, microTrackOffset - 1)
							miniTimelineSignature = nil
							miniTimelineTrackSignature = nil
							refresh()
						end)
					end
					local iconImage = WidgetVisualSupport.getTrackIconImage(track)
					if iconImage then
						local icon = make("ImageLabel", {
						Name = "TrackTypeIcon" .. row,
						BackgroundTransparency = 1,
						Image = iconImage,
						ImageColor3 = rowColors.baseline,
						ImageTransparency = track.disabled and 0.45 or 0,
						Position = UDim2.fromOffset(showReorderControls and 32 or 18, y + math.floor((trackHeight - 12) * 0.5)),
						ScaleType = Enum.ScaleType.Fit,
						Size = UDim2.fromOffset(12, 12),
						ZIndex = 6,
					}, trackListFrame)
					setImageRole(icon, nil)
				else
					local colorDot = make("Frame", {
						Name = "TrackTypeDot" .. row,
						BackgroundColor3 = rowColors.baseline,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(showReorderControls and 34 or 20, y + math.floor((trackHeight - 8) * 0.5)),
						Size = UDim2.fromOffset(8, 8),
						ZIndex = 6,
					}, trackListFrame)
					corner(colorDot, 99)
				end
				local trackLabel = text(trackListFrame, {
					Name = "TrackLabel" .. row,
					Text = labelText,
					TextColor3 = (track.disabled or isTrackHidden) and theme().MutedText or labelColor,
					TextSize = MICRO_TRACK_TEXT_SIZE,
					Font = Enum.Font.GothamMedium,
					Position = UDim2.fromOffset(showReorderControls and 48 or 34, y),
					Size = UDim2.new(1, (showReorderControls and -124 or -106) - (showTrackMenu and 0 or -18), 0, trackHeight),
					TextTruncate = Enum.TextTruncate.AtEnd,
					ZIndex = 5,
				})
				local function updateTrackNameTooltip(x, y)
					if not toolHint then
						return
					end
					local fullTrackName = getFullTrackDisplayName(track)
					toolHint.Text = fullTrackName
					local parentSize = toolHint.Parent and toolHint.Parent.AbsoluteSize or Vector2.new(360, 240)
					local tooltipWidth = math.clamp((toolHint.TextBounds.X or 0) + 18, 120, math.max(120, math.min(520, parentSize.X - 12)))
					toolHint.Size = UDim2.fromOffset(tooltipWidth, 20)
					local parentOffset = toolHint.Parent and toolHint.Parent.AbsolutePosition or Vector2.new(0, 0)
					local tooltipX = math.floor((x or trackLabel.AbsolutePosition.X) - parentOffset.X + 12)
					local tooltipY = math.floor((y or trackLabel.AbsolutePosition.Y) - parentOffset.Y + 18)
					tooltipX = math.clamp(tooltipX, 6, math.max(6, parentSize.X - tooltipWidth - 6))
					tooltipY = math.clamp(tooltipY, 6, math.max(6, parentSize.Y - 26))
					toolHint.Position = UDim2.fromOffset(tooltipX, tooltipY)
					toolHint.Visible = true
				end
				rowButton.MouseEnter:Connect(function(x, y)
					updateTrackNameTooltip(x, y)
				end)
				rowButton.MouseMoved:Connect(function(x, y)
					updateTrackNameTooltip(x, y)
				end)
				trackLabel.MouseEnter:Connect(function(x, y)
					updateTrackNameTooltip(x, y)
				end)
				trackLabel.MouseMoved:Connect(function(x, y)
					updateTrackNameTooltip(x, y)
				end)
				trackLabel.MouseLeave:Connect(function()
					if toolHint then
						toolHint.Visible = false
					end
				end)
				rowButton.MouseLeave:Connect(function()
					if toolHint then
						toolHint.Visible = false
					end
				end)
				if showReorderControls then
					local reorderHandle = make("TextButton", {
						Name = "ReorderHandle" .. row,
						AutoButtonColor = true,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Font = Enum.Font.Code,
						Text = ":::",
						TextColor3 = theme().MutedText,
						TextSize = 12,
						TextXAlignment = Enum.TextXAlignment.Center,
						Position = UDim2.fromOffset(2, y),
						Size = UDim2.fromOffset(14, trackHeight),
						ZIndex = 7,
					}, trackListFrame)
					reorderHandle.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							beginMicroTrackReorder(track, input)
						end
					end)
					reorderHandle.MouseButton1Down:Connect(function()
						local mouseLocation = UserInputService:GetMouseLocation()
						beginMicroTrackReorder(track, {
							UserInputType = Enum.UserInputType.MouseButton1,
							Position = Vector3.new(mouseLocation.X, mouseLocation.Y, 0),
						})
					end)
				end
				local rowMenuButton = make("TextButton", {
					Name = "TrackMenu" .. row,
					AutoButtonColor = true,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamBold,
					Text = "...",
					TextColor3 = theme().Text,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.new(1, -70, 0, y),
					Size = UDim2.fromOffset(18, trackHeight),
					Visible = showTrackMenu,
					ZIndex = 6,
				}, trackListFrame)
				rowMenuButton.MouseButton1Click:Connect(function()
					local currentTimeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
					microUiHost._lastViewModel = buildMicroEditorViewModel(currentTimeline)
					local selectedGroupIds = require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).getSelectedGroupIdsFromViewModel(
						microUiHost._lastViewModel,
						microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
					)
					if #selectedGroupIds &gt; 0 then
						microUiHost._selectedMicroGroupIds = selectedGroupIds
						options._microSelectedGroupIds = selectedGroupIds
					end
					selectedMicroTrackPath = track.path
					options._microLastSelectionScope = "track"
					if track.isMicroVirtualTrack then
						microShowTrackActions(track.path, track)
					else
						runOption(options, "onSelectTrack", "selectTrack", track.path, false)
						microShowTrackActions(track.path)
					end
				end)
				local visibilityButton = make("TextButton", {
					Name = "VisibilityIcon" .. row,
					AutoButtonColor = true,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamBold,
					Text = track.disabled and "D" or "E",
					TextColor3 = track.disabled and theme().MutedText or rowColors.baseline,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.new(1, -34, 0, y),
					Size = UDim2.fromOffset(14, trackHeight),
					Visible = not track.isMicroVirtualTrack and track.trackType ~= "Rig Group" and track.targetScope ~= "TimelineFolder" and track.trackType ~= "Folder",
					ZIndex = 6,
				}, trackListFrame)
				visibilityButton.MouseButton1Click:Connect(function()
					runOption(options, "onToggleTrackEnabled", "toggleTrackEnabled", track.path, not track.disabled)
					miniTimelineSignature = nil
					refresh()
				end)
				local hideButton = make("TextButton", {
					Name = "HideIcon" .. row,
					AutoButtonColor = true,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamBold,
					Text = isTrackHidden and "H" or "V",
					TextColor3 = isTrackHidden and theme().MutedText or rowColors.baseline,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.new(1, -52, 0, y),
					Size = UDim2.fromOffset(14, trackHeight),
					Visible = not track.isMicroVirtualTrack and track.trackType ~= "Rig Group" and track.targetScope ~= "TimelineFolder" and track.trackType ~= "Folder",
					ZIndex = 6,
				}, trackListFrame)
				hideButton.MouseButton1Click:Connect(function()
					microHiddenTracks[track.path] = not isTrackHidden
					miniTimelineSignature = nil
					miniTimelineTrackSignature = nil
					refresh()
				end)
				end
				make("Frame", {
					Name = "LaneLine" .. row,
					BackgroundColor3 = rowColors.baseline,
					BackgroundTransparency = isTrackHidden and 0.75 or MICRO_LANE_LINE_TRANSPARENCY,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 5, 0, y + math.floor(trackHeight * 0.5)),
					Size = UDim2.new(1, -16, 0, 1),
					ZIndex = 4,
				}, keyLayer)
				if isTrackHidden then
					text(keyLayer, {
						Name = "HiddenLabel" .. row,
						Text = "Hidden",
						TextColor3 = theme().MutedText,
						TextSize = 10,
						Font = Enum.Font.Gotham,
						Position = UDim2.fromOffset(10, y + 2),
						Size = UDim2.new(0, 80, 0, trackHeight - 4),
						ZIndex = 5,
					})
				end

				if track.trackType == "Rig Group" and track.rigName and rigFrameKeys[track.rigName] then
					for _, clip in ipairs((microGroupVisualState.groupedRigClipsByName[track.rigName]) or {}) do
						renderMicroGroupClip(clip, track.path, y, rowColors.baseline)
					end
					local rigFrames = {}
					for frame in pairs(rigFrameKeys[track.rigName]) do
						rigFrames[#rigFrames + 1] = frame
					end
					table.sort(rigFrames)
					for _, frame in ipairs(rigFrames) do
						if isTrackHidden or frame &lt; visibleStartFrame or frame &gt; visibleEndFrame then
							continue
						end
						local keyRefs = rigFrameKeys[track.rigName][frame] or {}
						if #keyRefs == 0 then
							continue
						end
						local allKeysGrouped = true
						local selectedCount = 0
						for _, keyRef in ipairs(keyRefs) do
							if not microGroupVisualState.groupedKeyMap[MicroKeyGroupSupport.editorKeyId(keyRef.jointPath, keyRef.frame)] then
								allKeysGrouped = false
							end
							if selectedKeyMap[MicroKeyGroupSupport.selectedKeyId(keyRef.jointPath, keyRef.frame)] == true then
								selectedCount += 1
							end
						end
						if allKeysGrouped then
							continue
						end
						local keySelected = selectedCount == #keyRefs
						local keyPartiallySelected = selectedCount &gt; 0 and not keySelected
						local alpha = math.clamp((frame - visibleStartFrame) / visibleFrameRange, 0, 1)
						local keySize = (keySelected or keyPartiallySelected) and MICRO_SELECTED_KEY_SIZE or MICRO_KEY_SIZE
						local keyX = frameAlphaToX(alpha)
						local keyY = y + math.floor((trackHeight - keySize) * 0.5)
						local keyColor = keySelected and theme().Accent or Color3.fromRGB(255, 191, 64)
						local aggregateId = "rig:" .. tostring(track.rigName) .. ":" .. tostring(frame)
						local key = make("ImageButton", {
							Name = string.format("RigGroupKey%d_%d", trackIndex, frame),
							Active = true,
							AutoButtonColor = true,
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							Image = KEY_DIAMOND_IMAGE,
							ImageColor3 = keyColor,
							ImageTransparency = 0,
							Position = UDim2.fromOffset(keyX - math.floor(keySize / 2), keyY),
							ScaleType = Enum.ScaleType.Fit,
							Size = UDim2.fromOffset(keySize, keySize),
							ZIndex = 9,
						}, keyLayer)
						if keySelected or keyPartiallySelected then
							local outlineSize = keySize + 8
							make("ImageLabel", {
								Name = string.format("RigGroupKeyOutline%d_%d", trackIndex, frame),
								BackgroundTransparency = 1,
								BorderSizePixel = 0,
								Image = KEY_DIAMOND_IMAGE,
								ImageColor3 = keySelected and theme().Accent or Color3.fromRGB(255, 215, 98),
								ImageTransparency = keySelected and 0.06 or 0.18,
								Position = UDim2.fromOffset(keyX - math.floor(outlineSize / 2), y + math.floor((trackHeight - outlineSize) * 0.5)),
								ScaleType = Enum.ScaleType.Fit,
								Size = UDim2.fromOffset(outlineSize, outlineSize),
								ZIndex = 8,
							}, keyLayer)
						end
						microVisibleKeyRects[#microVisibleKeyRects + 1] = {
							path = track.path,
							frame = frame,
							centerX = keyX,
							centerY = y + math.floor(trackHeight * 0.5),
						}
						microVisibleKeyButtons[aggregateId] = {
							button = key,
							path = track.path,
							frame = frame,
							x = keyX,
							y = keyY,
							size = keySize,
						}
						local function setRigGroupKeyHover(isHovering)
							local hoverSize = keySize + (isHovering and 2 or 0)
							key.Size = UDim2.fromOffset(hoverSize, hoverSize)
							key.Position = UDim2.fromOffset(keyX - math.floor(hoverSize / 2), y + math.floor((trackHeight - hoverSize) * 0.5))
						end
						key.MouseEnter:Connect(function()
							setRigGroupKeyHover(true)
						end)
						key.MouseLeave:Connect(function()
							setRigGroupKeyHover(false)
						end)
						local function beginRigGroupKeyDrag(point)
							if microKeyDragButton == key then
								return
							end
							if isMicroAdditiveSelection() and not keySelected then
								return
							end
							if not keySelected then
								selectMicroKeyList(keyRefs, false)
							end
							local dragRefs = keyRefs
							if keySelected or keyPartiallySelected then
								local _, latestSelectedKeyList = getMicroSelectedKeyMap(options)
								if type(latestSelectedKeyList) == "table" and #latestSelectedKeyList &gt; #dragRefs then
									dragRefs = latestSelectedKeyList
								elseif type(selectedKeyList) == "table" and #selectedKeyList &gt; #dragRefs then
									dragRefs = selectedKeyList
								end
							end
							microKeyDragButton = key
							microKeyDragPath = (dragRefs[1] and dragRefs[1].jointPath) or (keyRefs[1] and keyRefs[1].jointPath) or track.path
							microKeyDragSourceFrame = frame
							microKeyDragTargetFrame = frame
							local cursorFrame = point and getMicroFrameAtX(point.X)
							microKeyDragCursorFrameOffset = cursorFrame and math.floor(cursorFrame - frame) or 0
							microKeyDragMoved = false
							microKeyDragSelected = true
							microKeyDragSelectedCount = #dragRefs
							microKeyDragSelectedRefs = {}
							for _, keyRef in ipairs(dragRefs) do
								microKeyDragSelectedRefs[#microKeyDragSelectedRefs + 1] = {
									jointPath = keyRef.jointPath,
									frame = keyRef.frame,
								}
							end
							microKeyDragPreviewKeys = {}
							local aggregatePreview = microVisibleKeyButtons[aggregateId]
							if aggregatePreview then
								microKeyDragPreviewKeys[#microKeyDragPreviewKeys + 1] = aggregatePreview
							end
							for _, keyRef in ipairs(dragRefs) do
								local previewInfo = microVisibleKeyButtons[MicroKeyGroupSupport.selectedKeyId(keyRef.jointPath, keyRef.frame)]
								if previewInfo and previewInfo.button and previewInfo.button.Parent then
									microKeyDragPreviewKeys[#microKeyDragPreviewKeys + 1] = previewInfo
								end
							end
							microUiHost._microKeyDragRulerReferenceFrame = getMicroKeyDragRulerReferenceFrame(microKeyDragSelectedRefs, frame)
							for _, previewInfo in ipairs(microKeyDragPreviewKeys) do
								if previewInfo.button and previewInfo.button.Parent then
									previewInfo.button.ZIndex = 12
								end
							end
							if statusLabel then
								statusLabel.Text = string.format("Dragging %d rig keyframes.", #microKeyDragSelectedRefs)
							end
						end
						key.InputBegan:Connect(function(input)
							if input.UserInputType == Enum.UserInputType.MouseButton1 then
								beginRigGroupKeyDrag(Vector2.new(input.Position.X, input.Position.Y))
							end
						end)
						key.MouseButton1Down:Connect(function(x, yPos)
							beginRigGroupKeyDrag(Vector2.new(x, yPos))
						end)
						key.MouseButton1Click:Connect(function()
							if os.clock() - lastMicroKeyDragReleaseClock &lt; 0.12 then
								return
							end
							selectMicroKeyList(keyRefs, isMicroAdditiveSelection())
							statusLabel.Text = string.format("Selected %d rig key%s at frame %d.", #keyRefs, #keyRefs == 1 and "" or "s", frame)
							miniTimelineSignature = nil
							refresh()
						end)
					end
				end

				local isSoundTrack = track.trackType == "Sound" or track.targetScope == "Sound" or track.valueType == "Sound"
				local isSubtitleTrack = ScreenEffectTrackService.isSubtitleTrack(track)
				local isFadeTrack = ScreenEffectTrackService.isFadeTrack(track)
				if isSoundTrack and not isTrackHidden then
					for clipIndex, clip in ipairs(soundClipsByPath[track.path] or {}) do
						local frame = math.max(0, math.floor(tonumber(clip.frame) or 0))
						local endFrame = math.max(frame + 1, tonumber(clip.endFrame) or (frame + 1))
						if endFrame &lt; visibleStartFrame or frame &gt; visibleEndFrame then
							continue
						end
						local startX = MICRO_FRAME_GUTTER + (((frame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
						local endX = MICRO_FRAME_GUTTER + (((endFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
						local clipWidth = math.max(24, endX - startX)
						local clipX = startX + (clipWidth * 0.5)
						local clipHeight = math.max(18, trackHeight - 2)
						local clipY = y + math.floor((trackHeight - clipHeight) * 0.5)
						local keyId = MicroKeyGroupSupport.selectedKeyId(track.path, frame)
						local keySelected = selectedKeyMap[keyId] == true
						local clipColor = keySelected and theme().Accent or Color3.fromRGB(71, 178, 217)
						local soundClipLabel = tostring(track.name or track.part1 or "Sound")
						if soundClipLabel == "" then
							soundClipLabel = "Sound"
						end
						local key = make("TextButton", {
							Name = string.format("SoundClip%d_%d", trackIndex, clipIndex),
							Active = true,
							AutoButtonColor = true,
							BackgroundColor3 = clipColor,
							BackgroundTransparency = keySelected and 0.02 or 0.14,
							BorderSizePixel = 0,
							ClipsDescendants = true,
							Font = Enum.Font.GothamBold,
							Position = UDim2.fromOffset(clipX - math.floor(clipWidth * 0.5), clipY),
							Size = UDim2.fromOffset(clipWidth, clipHeight),
							Text = "",
							TextColor3 = Color3.fromRGB(5, 18, 26),
							TextTruncate = Enum.TextTruncate.AtEnd,
							TextSize = 11,
							ZIndex = 9,
						}, keyLayer)
						corner(key, 6)
						require(script.Parent.Parent:WaitForChild("AudioClipVisualSupport")).drawFadeIndicators(make, key, clip, clipWidth, clipHeight, clip.durationFrames or (endFrame - frame), fps, 11)
						require(script.Parent.Parent:WaitForChild("AudioClipVisualSupport")).attachStopHandle({
							makeInstance = make,
							parent = key,
							trackPath = track.path,
							startFrame = frame,
							endFrame = endFrame,
							clipWidth = clipWidth,
							clipHeight = clipHeight,
							visibleStartFrame = visibleStartFrame,
							visibleFrameRange = visibleFrameRange,
							timelinePixelWidth = timelinePixelWidth,
							timelineLayer = keyLayer,
							gutter = MICRO_FRAME_GUTTER,
							durationFrames = durationFrames,
							statusLabel = statusLabel,
							refresh = refresh,
							onSetStopFrame = function(...)
								return runOption(options, "onSetSoundClipEndFrame", "setSoundClipEndFrame", ...)
							end,
							zIndex = 12,
						})
						local barCount = math.clamp(math.floor(clipWidth / 10), 3, 12)
						for barIndex = 1, barCount do
							local barAlpha = barIndex / math.max(1, barCount)
							local barHeight = math.floor(4 + ((math.sin(barIndex * 1.7) + 1) * 0.5 * math.max(3, clipHeight - 8)))
							make("Frame", {
								Name = "WaveBar",
								AnchorPoint = Vector2.new(0.5, 0.5),
								BackgroundColor3 = Color3.fromRGB(219, 247, 255),
								BackgroundTransparency = 0.28,
								BorderSizePixel = 0,
								Position = UDim2.new(barAlpha, -3, 0.5, 0),
								Size = UDim2.fromOffset(2, math.min(clipHeight - 4, barHeight)),
								ZIndex = 10,
							}, key)
						end
						make("TextLabel", {
							Name = "SoundClipLabel",
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							Font = Enum.Font.GothamBold,
							Position = UDim2.fromOffset(4, 0),
							Size = UDim2.new(1, -8, 1, 0),
							Text = clipWidth &gt; 42 and soundClipLabel or "",
							TextColor3 = Color3.fromRGB(5, 18, 26),
							TextSize = 11,
							TextTruncate = Enum.TextTruncate.AtEnd,
							TextXAlignment = Enum.TextXAlignment.Center,
							TextYAlignment = Enum.TextYAlignment.Center,
							ZIndex = 12,
						}, key)
						key.MouseEnter:Connect(function()
							MicroWidgetController._positionMicroTooltipNear(key, toolHint, require(script.Parent.Parent:WaitForChild("AudioClipVisualSupport")).buildTooltip(soundClipLabel, clip), 4)
						end)
						key.MouseMoved:Connect(function()
							MicroWidgetController._positionMicroTooltipNear(key, toolHint, require(script.Parent.Parent:WaitForChild("AudioClipVisualSupport")).buildTooltip(soundClipLabel, clip), 4)
						end)
						key.MouseLeave:Connect(function()
							if toolHint then
								toolHint.Visible = false
							end
						end)
						microVisibleKeyRects[#microVisibleKeyRects + 1] = {
							path = track.path,
							frame = frame,
							centerX = clipX,
							centerY = y + math.floor(trackHeight * 0.5),
						}
						microVisibleKeyButtons[keyId] = {
							button = key,
							path = track.path,
							frame = frame,
							centerFrame = frame + ((endFrame - frame) * 0.5),
							x = clipX,
							y = clipY,
							size = math.max(clipWidth, clipHeight),
						}
						local function beginSoundClipDrag()
							if microKeyDragButton == key then
								return
							end
							if key:GetAttribute("MegMoSoundStopDragging") == true or key:GetAttribute("MegMoSoundStopSuppressClick") == true then
								return
							end
							local mouseLocation = UserInputService:GetMouseLocation()
							if mouseLocation.X &gt;= key.AbsolutePosition.X + key.AbsoluteSize.X - 18 then
								return
							end
							local dragClickKey = tostring(track.path) .. ":" .. tostring(frame)
							if lastMicroSoundClipClickKey == dragClickKey and (os.clock() - lastMicroSoundClipClickClock) &lt;= 0.34 then
								return
							end
							local additive = isMicroAdditiveSelection()
							local alreadySelected = selectedKeyMap[keyId] == true
							if additive and not alreadySelected then
								return
							end
							microKeyDragButton = key
							microKeyDragPath = track.path
							microKeyDragSourceFrame = frame
							microKeyDragTargetFrame = frame
							microKeyDragCursorFrameOffset = math.clamp(
								(getMicroFrameAtX(mouseLocation.X) or frame) - frame,
								0,
								math.max(0, math.floor((endFrame or frame) - frame))
							)
							microKeyDragMoved = false
							microKeyDragSelected = alreadySelected
							microKeyDragSelectedCount = alreadySelected and #selectedKeyList or 1
							microKeyDragSelectedRefs = {}
							if alreadySelected then
								for _, selectedKey in ipairs(selectedKeyList) do
									if selectedKey and selectedKey.jointPath and selectedKey.frame ~= nil then
										microKeyDragSelectedRefs[#microKeyDragSelectedRefs + 1] = {
											jointPath = selectedKey.jointPath,
											frame = selectedKey.frame,
										}
									end
								end
							else
								microKeyDragSelectedRefs[1] = {
									jointPath = track.path,
									frame = frame,
								}
							end
							if statusLabel then
								local movingCount = math.max(1, tonumber(microKeyDragSelectedCount) or 1)
								statusLabel.Text = movingCount &gt; 1 and string.format("Dragging %d keyframes.", movingCount) or "Dragging audio clip."
							end
							microKeyDragPreviewKeys = {}
							if alreadySelected then
								for selectedId in pairs(selectedKeyMap) do
									local previewInfo = microVisibleKeyButtons[selectedId]
									if previewInfo and previewInfo.button and previewInfo.button.Parent then
										microKeyDragPreviewKeys[#microKeyDragPreviewKeys + 1] = previewInfo
									end
								end
							end
							if #microKeyDragPreviewKeys == 0 then
								microKeyDragPreviewKeys[1] = microVisibleKeyButtons[keyId] or {
									button = key,
									path = track.path,
									frame = frame,
									centerFrame = frame + ((endFrame - frame) * 0.5),
									x = clipX,
									y = clipY,
									size = math.max(clipWidth, clipHeight),
								}
							end
							microUiHost._microKeyDragRulerReferenceFrame = getMicroKeyDragRulerReferenceFrame(microKeyDragSelectedRefs, frame)
							for _, previewInfo in ipairs(microKeyDragPreviewKeys) do
								if previewInfo.button and previewInfo.button.Parent then
									previewInfo.button.ZIndex = 12
								end
							end
						end
						key.InputBegan:Connect(function(input)
							if input.UserInputType == Enum.UserInputType.MouseButton1 then
								beginSoundClipDrag()
							end
						end)
						key.MouseButton1Down:Connect(function()
							beginSoundClipDrag()
						end)
						key.MouseButton1Click:Connect(function()
							if os.clock() - lastMicroKeyDragReleaseClock &lt; 0.12 then
								return
							end
							if key:GetAttribute("MegMoSoundStopDragging") == true or key:GetAttribute("MegMoSoundStopSuppressClick") == true then
								return
							end
							local clickKey = tostring(track.path) .. ":" .. tostring(frame)
							local now = os.clock()
							local isDoubleClick = lastMicroSoundClipClickKey == clickKey and (now - lastMicroSoundClipClickClock) &lt;= 0.34
							lastMicroSoundClipClickKey = clickKey
							lastMicroSoundClipClickClock = now
							if isDoubleClick then
								lastMicroSoundClipClickKey = nil
								lastMicroSoundClipClickClock = 0
								SoundKeyframeEditorController.show(microUiHost, track.path, frame)
								statusLabel.Text = "Editing audio clip."
							else
								task.delay(0.36, function()
									if lastMicroSoundClipClickKey ~= clickKey or lastMicroSoundClipClickClock ~= now then
										return
									end
									lastMicroSoundClipClickKey = nil
									lastMicroSoundClipClickClock = 0
									options._microLastSelectionScope = "track"
									if isMicroAdditiveSelection() then
										runOption(options, "onToggleKeySelection", "toggleKeySelection", track.path, frame)
									else
										runOption(options, "onSelectKey", "selectKey", track.path, frame, false)
									end
									lastMicroScrubFrame = nil
									miniTimelineSignature = nil
									refresh()
									task.defer(function()
										focusMicroShortcutCapture(options, statusLabel, nil)
									end)
								end)
							end
						end)
					end
				end

				if isSubtitleTrack and not isTrackHidden then
					SubtitleClipVisualSupport.renderMicroClips({
						make = make,
						corner = corner,
						keyLayer = keyLayer,
						track = track,
						trackIndex = trackIndex,
						clips = subtitleClipsByPath[track.path],
						y = y,
						trackHeight = trackHeight,
						visibleStartFrame = visibleStartFrame,
						visibleEndFrame = visibleEndFrame,
						visibleFrameRange = visibleFrameRange,
						timelinePixelWidth = timelinePixelWidth,
						gutter = MICRO_FRAME_GUTTER,
						durationFrames = durationFrames,
						selectedKeyMap = selectedKeyMap,
						selectedKeyId = MicroKeyGroupSupport.selectedKeyId,
						statusLabel = statusLabel,
						refresh = refresh,
						runOption = runOption,
						options = options,
						editorController = ScreenEffectKeyframeEditorController,
						host = microUiHost,
						toolHint = toolHint,
						positionTooltip = MicroWidgetController._positionMicroTooltipNear,
						visibleKeyRects = microVisibleKeyRects,
						visibleKeyButtons = microVisibleKeyButtons,
						isRecentKeyDragRelease = function()
							return os.clock() - lastMicroKeyDragReleaseClock &lt; 0.12
						end,
						onBeginClipDrag = function(key, clip, keyId, frame, clipX, clipY, clipWidth, clipHeight)
							if microKeyDragButton == key then
								return
							end
							local mouseLocation = UserInputService:GetMouseLocation()
							if mouseLocation.X &gt;= key.AbsolutePosition.X + key.AbsoluteSize.X - 18 then
								return
							end
							local additive = isMicroAdditiveSelection()
							local alreadySelected = selectedKeyMap[keyId] == true
							if additive and not alreadySelected then
								return
							end
							if not alreadySelected and not additive then
								runOption(options, "onSelectKey", "selectKey", track.path, frame, false)
							end
							microKeyDragButton = key
							microKeyDragPath = track.path
							microKeyDragSourceFrame = frame
							microKeyDragTargetFrame = frame
							local endFrame = math.max(frame + 1, math.floor(tonumber(clip and clip.endFrame) or (frame + 1)))
							microKeyDragCursorFrameOffset = math.clamp(
								(getMicroFrameAtX(mouseLocation.X) or frame) - frame,
								0,
								math.max(0, math.floor((endFrame or frame) - frame))
							)
							microKeyDragMoved = false
							microKeyDragSelected = false
							microKeyDragSelectedCount = 1
							microKeyDragSelectedRefs = {
								{
									jointPath = track.path,
									frame = frame,
								},
							}
							microKeyDragPreviewKeys = {
								microVisibleKeyButtons[keyId] or {
									button = key,
									path = track.path,
									frame = frame,
									centerFrame = frame + ((endFrame - frame) * 0.5),
									x = clipX,
									y = clipY,
									size = math.max(clipWidth, clipHeight),
								},
							}
							microUiHost._microKeyDragRulerReferenceFrame = getMicroKeyDragRulerReferenceFrame(microKeyDragSelectedRefs, frame)
							key.ZIndex = 12
							if statusLabel then
								statusLabel.Text = "Dragging subtitle clip."
							end
						end,
					})
				end

				if isFadeTrack and not isTrackHidden then
					require(script.Parent.Parent:WaitForChild("FadeClipVisualSupport")).renderMicroClips({
						make = make,
						corner = corner,
						keyLayer = keyLayer,
						track = track,
						trackIndex = trackIndex,
						clips = fadeClipsByPath[track.path],
						y = y,
						trackHeight = trackHeight,
						visibleStartFrame = visibleStartFrame,
						visibleEndFrame = visibleEndFrame,
						visibleFrameRange = visibleFrameRange,
						timelinePixelWidth = timelinePixelWidth,
						gutter = MICRO_FRAME_GUTTER,
						durationFrames = durationFrames,
						selectedKeyMap = selectedKeyMap,
						selectedKeyId = MicroKeyGroupSupport.selectedKeyId,
						statusLabel = statusLabel,
						refresh = refresh,
						runOption = runOption,
						options = options,
						editorController = ScreenEffectKeyframeEditorController,
						host = microUiHost,
						toolHint = toolHint,
						positionTooltip = MicroWidgetController._positionMicroTooltipNear,
						visibleKeyRects = microVisibleKeyRects,
						visibleKeyButtons = microVisibleKeyButtons,
						isRecentKeyDragRelease = function()
							return os.clock() - lastMicroKeyDragReleaseClock &lt; 0.12
						end,
						onSetStartFrame = function(...)
							return runOption(options, "onSetFadeClipStartFrame", "setFadeClipStartFrame", ...)
						end,
						onSetEndFrame = function(...)
							return runOption(options, "onSetFadeClipEndFrame", "setFadeClipEndFrame", ...)
						end,
						onBeginClipDrag = function(key, clip, keyId, frame, clipX, clipY, clipWidth, clipHeight)
							if microKeyDragButton == key then
								return
							end
							local additive = isMicroAdditiveSelection()
							local alreadySelected = selectedKeyMap[keyId] == true
							if additive and not alreadySelected then
								return
							end
							if not alreadySelected and not additive then
								runOption(options, "onSelectKey", "selectKey", track.path, frame, false)
							end
							microKeyDragButton = key
							microKeyDragPath = track.path
							microKeyDragSourceFrame = frame
							microKeyDragTargetFrame = frame
							local mouseLocation = UserInputService:GetMouseLocation()
							local endFrame = math.max(frame + 1, math.floor(tonumber(clip and clip.endFrame) or (frame + 1)))
							microKeyDragCursorFrameOffset = math.clamp(
								(getMicroFrameAtX(mouseLocation.X) or frame) - frame,
								0,
								math.max(0, endFrame - frame)
							)
							microKeyDragMoved = false
							microKeyDragSelected = false
							microKeyDragSelectedCount = 1
							microKeyDragSelectedRefs = {
								{
									jointPath = track.path,
									frame = frame,
								},
							}
							microKeyDragPreviewKeys = {
								microVisibleKeyButtons[keyId] or {
									button = key,
									path = track.path,
									frame = frame,
									centerFrame = frame + ((endFrame - frame) * 0.5),
									x = clipX,
									y = clipY,
									size = math.max(clipWidth, clipHeight),
								},
							}
							microUiHost._microKeyDragRulerReferenceFrame = getMicroKeyDragRulerReferenceFrame(microKeyDragSelectedRefs, frame)
							key.ZIndex = 12
							if statusLabel then
								statusLabel.Text = "Dragging fade clip."
							end
						end,
					})
				end

				for _, clip in ipairs((microGroupVisualState.groupedTrackClipsByPath[track.path]) or {}) do
					renderMicroGroupClip(clip, track.path, y, rowColors.baseline)
				end

				local fadeClipsForTrack = fadeClipsByPath[track.path]
				local frames = (isSoundTrack or isSubtitleTrack or (isFadeTrack and type(fadeClipsForTrack) == "table" and #fadeClipsForTrack &gt; 0)) and {} or (keyframesByPath[track.path] or {})
				local maxKeysForTrack = 90
				local step = #frames &gt; maxKeysForTrack and math.ceil(#frames / maxKeysForTrack) or 1
				for frameIndex = 1, #frames, step do
					if isTrackHidden then
						break
					end
					local frame = frames[frameIndex]
					if frame &lt; visibleStartFrame or frame &gt; visibleEndFrame then
						continue
					end
					if microGroupVisualState.groupedKeyMap[MicroKeyGroupSupport.editorKeyId(track.path, frame)] then
						continue
					end
					local alpha = math.clamp((frame - visibleStartFrame) / visibleFrameRange, 0, 1)
					local keyId = MicroKeyGroupSupport.selectedKeyId(track.path, frame)
					local keyGroup = microGroupDragState.byKey[MicroKeyGroupSupport.editorKeyId(track.path, frame)]
					local keySelected = selectedKeyMap[keyId] == true
					local keyOptions = {}
					if timeline and type(timeline.getKeyOptions) == "function" then
						local ok, optionsForKey = pcall(timeline.getKeyOptions, timeline, track.path, frame)
						if ok and type(optionsForKey) == "table" then
							keyOptions = optionsForKey
						end
					end
					local baseKeyColor = rowColors.baseline or theme().Text
					local keyColor = baseKeyColor
					local keySize = keySelected and MICRO_SELECTED_KEY_SIZE or MICRO_KEY_SIZE
					local keyY = y + math.floor((trackHeight - keySize) * 0.5)
					local keyX = frameAlphaToX(alpha)
					local easingHighlightColor = WidgetVisualSupport.getEasingHighlightColor(keyOptions.easingStyle)
					if easingHighlightColor then
						local easingOutlineSize = keySize + (keySelected and 12 or 6)
						make("ImageLabel", {
							Name = string.format("EasingKeyOutline%d_%d", trackIndex, frameIndex),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							Image = KEY_DIAMOND_IMAGE,
							ImageColor3 = easingHighlightColor,
							ImageTransparency = keySelected and 0.1 or 0.24,
							Position = UDim2.fromOffset(keyX - math.floor(easingOutlineSize / 2), y + math.floor((trackHeight - easingOutlineSize) * 0.5)),
							ScaleType = Enum.ScaleType.Fit,
							Size = UDim2.fromOffset(easingOutlineSize, easingOutlineSize),
							ZIndex = 7,
						}, keyLayer)
					end
					local key = make("ImageButton", {
						Name = string.format("Key%d_%d", trackIndex, frameIndex),
						Active = true,
						AutoButtonColor = true,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Image = KEY_DIAMOND_IMAGE,
						ImageColor3 = keyColor,
						ImageTransparency = 0,
						Position = UDim2.fromOffset(keyX - math.floor(keySize / 2), keyY),
						ScaleType = Enum.ScaleType.Fit,
						Size = UDim2.fromOffset(keySize, keySize),
						ZIndex = 9,
					}, keyLayer)
					if keySelected or keyGroup then
						local isGroupedKey = keyGroup ~= nil
						local outlineSize = keySize + (isGroupedKey and 10 or 8)
						make("ImageLabel", {
							Name = string.format("SelectedKeyOutline%d_%d", trackIndex, frameIndex),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							Image = KEY_DIAMOND_IMAGE,
							ImageColor3 = isGroupedKey and Color3.fromRGB(255, 191, 64) or theme().Accent,
							ImageTransparency = isGroupedKey and 0.02 or 0.06,
							Position = UDim2.fromOffset(keyX - math.floor(outlineSize / 2), y + math.floor((trackHeight - outlineSize) * 0.5)),
							ScaleType = Enum.ScaleType.Fit,
							Size = UDim2.fromOffset(outlineSize, outlineSize),
							ZIndex = 8,
						}, keyLayer)
					end
					microVisibleKeyRects[#microVisibleKeyRects + 1] = {
						path = track.path,
						frame = frame,
						centerX = keyX,
						centerY = y + math.floor(trackHeight * 0.5),
					}
					microVisibleKeyButtons[keyId] = {
						button = key,
						path = track.path,
						frame = frame,
						x = keyX,
						y = keyY,
						size = keySize,
					}
					local function setKeyHover(isHovering)
						if microKeyDragButton == key then
							return
						end
						local hoverSize = keySize + (isHovering and 2 or 0)
						key.Size = UDim2.fromOffset(hoverSize, hoverSize)
						key.Position = UDim2.fromOffset(keyX - math.floor(hoverSize / 2), y + math.floor((trackHeight - hoverSize) * 0.5))
					end
					key.MouseEnter:Connect(function()
						setKeyHover(true)
						MicroWidgetController._positionMicroTooltipNear(key, toolHint, WidgetVisualSupport.getEasingTooltip(keyOptions.easingStyle, keyOptions.easingDirection), 4)
					end)
					key.MouseMoved:Connect(function()
						MicroWidgetController._positionMicroTooltipNear(key, toolHint, WidgetVisualSupport.getEasingTooltip(keyOptions.easingStyle, keyOptions.easingDirection), 4)
					end)
					key.MouseLeave:Connect(function()
						setKeyHover(false)
						if toolHint then
							toolHint.Visible = false
						end
					end)
					local function beginMicroKeyDrag()
						if microKeyDragButton == key then
							return
						end
						local additive = isMicroAdditiveSelection()
						local latestSelectedKeyMap, latestSelectedKeyList = getMicroSelectedKeyMap(options)
						local alreadySelected = latestSelectedKeyMap[keyId] == true or selectedKeyMap[keyId] == true
						if additive and not alreadySelected then
							return
						end
						if not alreadySelected and not additive then
							runOption(options, "onSelectKey", "selectKey", track.path, frame, false)
							latestSelectedKeyMap, latestSelectedKeyList = getMicroSelectedKeyMap(options)
						end
						microKeyDragButton = key
						microKeyDragPath = track.path
						microKeyDragSourceFrame = frame
						microKeyDragTargetFrame = frame
						microKeyDragCursorFrameOffset = 0
						microKeyDragMoved = false
						if keyGroup and type(keyGroup.keys) == "table" then
							microKeyDragSelectedRefs = MicroWidgetController._copyMicroKeyRefs(keyGroup.keys)
						elseif alreadySelected then
							microKeyDragSelectedRefs = MicroWidgetController._copyMicroKeyRefs(latestSelectedKeyList)
							if #microKeyDragSelectedRefs &lt;= 1 then
								local visibleRefs = {}
								for selectedId in pairs(latestSelectedKeyMap) do
									local info = microVisibleKeyButtons[selectedId]
									if info and info.path and info.frame ~= nil then
										visibleRefs[#visibleRefs + 1] = {
											jointPath = info.path,
											frame = info.frame,
										}
									end
								end
								for selectedId in pairs(selectedKeyMap) do
									local info = microVisibleKeyButtons[selectedId]
									if info and info.path and info.frame ~= nil then
										visibleRefs[#visibleRefs + 1] = {
											jointPath = info.path,
											frame = info.frame,
										}
									end
								end
								if #visibleRefs &gt; #microKeyDragSelectedRefs then
									microKeyDragSelectedRefs = MicroWidgetController._copyMicroKeyRefs(visibleRefs)
								end
							end
						else
							microKeyDragSelectedRefs = {
								{
									jointPath = track.path,
									frame = frame,
								},
							}
						end
						if #microKeyDragSelectedRefs == 0 then
							microKeyDragSelectedRefs = {
								{
									jointPath = track.path,
									frame = frame,
								},
							}
						end
						microKeyDragSelected = keyGroup ~= nil or alreadySelected or #microKeyDragSelectedRefs &gt; 1
						microKeyDragSelectedCount = #microKeyDragSelectedRefs
						-- Keep the clicked selection snapshot stable for the whole drag.
						-- Otherwise selected multi-key drags can collapse back to one key mid-gesture.
						if statusLabel then
							local movingCount = math.max(1, tonumber(microKeyDragSelectedCount) or 1)
							statusLabel.Text = movingCount &gt; 1 and string.format("Dragging %d keyframes.", movingCount) or "Dragging keyframe."
						end
						microKeyDragPreviewKeys = {}
						if keyGroup and type(keyGroup.keys) == "table" then
							for _, groupKey in ipairs(keyGroup.keys) do
								local previewInfo = microVisibleKeyButtons[MicroKeyGroupSupport.selectedKeyId(groupKey.jointPath, groupKey.frame)]
								if previewInfo and previewInfo.button and previewInfo.button.Parent then
									microKeyDragPreviewKeys[#microKeyDragPreviewKeys + 1] = previewInfo
								end
							end
						elseif alreadySelected then
							for _, selectedRef in ipairs(microKeyDragSelectedRefs) do
								local selectedId = MicroKeyGroupSupport.selectedKeyId(selectedRef.jointPath, selectedRef.frame)
								local previewInfo = microVisibleKeyButtons[selectedId]
								if previewInfo and previewInfo.button and previewInfo.button.Parent then
									microKeyDragPreviewKeys[#microKeyDragPreviewKeys + 1] = previewInfo
								end
							end
						end
						if #microKeyDragPreviewKeys == 0 then
							local previewInfo = microVisibleKeyButtons[keyId] or {
								button = key,
								path = track.path,
								frame = frame,
								x = keyX,
								y = keyY,
								size = keySize,
							}
							microKeyDragPreviewKeys[1] = previewInfo
						end
						microUiHost._microKeyDragRulerReferenceFrame = getMicroKeyDragRulerReferenceFrame(microKeyDragSelectedRefs, frame)
						for _, previewInfo in ipairs(microKeyDragPreviewKeys) do
							if previewInfo.button and previewInfo.button.Parent then
								previewInfo.button.ZIndex = 12
								if previewInfo.button:IsA("ImageButton") or previewInfo.button:IsA("ImageLabel") then
									previewInfo.button.ImageTransparency = 0
								end
							end
						end
					end
					key.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							beginMicroKeyDrag()
						end
					end)
					key.MouseButton1Down:Connect(function()
						beginMicroKeyDrag()
					end)
					key.MouseButton1Click:Connect(function()
						if os.clock() - lastMicroKeyDragReleaseClock &lt; 0.12 then
							return
						end
						local now = os.clock()
						local isFaceDoubleClick = false
						if isMicroFaceTrack(track) then
							isFaceDoubleClick = lastMicroFaceKeyClickId == keyId and (now - (lastMicroFaceKeyClickClock or 0)) &lt;= 0.34
							lastMicroFaceKeyClickId = keyId
							lastMicroFaceKeyClickClock = now
							if isFaceDoubleClick then
								lastMicroFaceKeyClickId = nil
								lastMicroFaceKeyClickClock = 0
							end
						else
							lastMicroFaceKeyClickId = nil
							lastMicroFaceKeyClickClock = 0
						end
						options._microLastSelectionScope = "track"
						microUiHost._selectedMicroGroupIds = nil
						options._microSelectedGroupIds = nil
						if isMicroAdditiveSelection() then
							runOption(options, "onToggleKeySelection", "toggleKeySelection", track.path, frame)
						else
							runOption(options, "onSelectKey", "selectKey", track.path, frame, false)
						end
						lastMicroScrubFrame = nil
						miniTimelineSignature = nil
						refresh()
						task.defer(function()
							if isFaceDoubleClick then
								openMicroTrackOptionsForTrack(track)
							else
								focusMicroShortcutCapture(options, statusLabel, nil)
							end
						end)
					end)
				end
			end

			if #trackList == 0 then
				text(trackListFrame, {
					Name = "EmptyLabel",
					Text = "Select a rig in Workspace, then click + Rig.",
					TextColor3 = theme().MutedText,
					TextSize = 11,
					Position = UDim2.fromOffset(12, 20),
					Size = UDim2.new(1, -18, 0, 36),
					TextWrapped = true,
					ZIndex = 4,
				})
			elseif #displayTrackList &gt; visibleTrackCount then
				local belowCount = math.max(0, #displayTrackList - (microTrackOffset + visibleTrackCount))
				local moreText = microTrackOffset &gt; 0 and tostring(microTrackOffset) .. " above" or ""
				if belowCount &gt; 0 then
					moreText = moreText ~= "" and (moreText .. " | " .. tostring(belowCount) .. " more") or ("+" .. tostring(belowCount) .. " more")
				end
				text(trackListFrame, {
					Name = "MoreLabel",
					Text = moreText,
					TextColor3 = theme().MutedText,
					TextSize = 10,
					Position = UDim2.new(0, 10, 1, -22),
					Size = UDim2.new(1, -18, 0, 16),
					ZIndex = 4,
				})
			end

			playheadLine = make("Frame", {
				Name = "Playhead",
				BackgroundColor3 = theme().Accent,
				BorderSizePixel = 0,
				Position = UDim2.new(0, -1, 0, 0),
				Size = UDim2.new(0, 2, 1, 0),
				ZIndex = 8,
			}, keyLayer)
			playheadLine:SetAttribute("MegMoThemeBackgroundRole", "Accent")
			playheadLine.BackgroundTransparency = 0.08
			playheadHandle = make("Frame", {
				Name = "PlayheadHandle",
				BackgroundColor3 = theme().Accent,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.new(0, -3, 0, 0),
				Size = UDim2.fromOffset(0, 0),
				ZIndex = 10,
			}, ruler)
			playheadHandle:SetAttribute("MegMoThemeBackgroundRole", "Accent")
			corner(playheadHandle, 3)
			updateMiniPlayhead()
			microUiHost._miniTimelineRendered = true
		end

		local railButtons = {}
		local railButtonStrokes = {}
		local radialHub
		setRadialMenuOpen = function(open)
			if radialHub and type(radialHub.setOpen) == "function" then
				radialHub.setOpen(open)
			end
		end
		updateRadialDockPlacement = function()
			if radialHub and type(radialHub.updatePlacement) == "function" then
				radialHub.updatePlacement()
			end
		end
		local function applyRailMode()
			local width = getRailWidth()
			sideRail.Size = UDim2.new(0, width, 1, -34)
			menuBar.Position = UDim2.fromOffset(width, 34)
			menuBar.Size = UDim2.new(1, -width, 0, 30)
			body.Position = UDim2.fromOffset(width, 64)
			body.Size = UDim2.new(1, -width, 1, -64)
			railToggle.Size = UDim2.fromOffset(width - 10, 20)
			railToggle.Text = railExpanded and "  &lt;&lt; Tools" or "&gt;&gt;"
			railToggle.TextXAlignment = railExpanded and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
			for _, railButton in pairs(railButtons) do
				syncMicroRailButtonMode(railButton, railExpanded, width)
			end
			updateRadialDockPlacement()
		end
		local function openFeaturePopup(tabName)
			closeFeaturePopup()
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("feature")
			end
			options._microGui = gui
			options._microUiHost = microUiHost
			if tabName == "Motion" then
				featurePopup = MicroWidgetController._createMotionPopup(gui, panel, options, closeFeaturePopup)
				return
			end
			featurePopup = MicroWidgetController._createFeaturePopup(gui, panel, tabName, options, closeFeaturePopup, refresh)
		end
		options.onOpenPopup = openFeaturePopup
		options.onOpenProjectSummary = function()
			options._microGui = gui
			options._microUiHost = microUiHost
			if microUiHost._projectPopup and microUiHost._projectPopup.Parent then
				microUiHost._projectPopup:Destroy()
				microUiHost._projectPopup = nil
				return true, "Project summary closed."
			end
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("project")
			end
			microUiHost._projectPopup = MicroProjectPopupSupport.open(gui, panel, options, function()
				if microUiHost._projectPopup and microUiHost._projectPopup.Parent then
					microUiHost._projectPopup:Destroy()
				end
				microUiHost._projectPopup = nil
				refresh()
			end)
			return true, "Project summary opened."
		end
		if microUiHost._projectEditButton then
			microUiHost._projectEditButton.MouseButton1Click:Connect(function()
				options.onOpenProjectSummary()
			end)
		end
		if microUiHost._hidePlaybackButton then
			microUiHost._hidePlaybackButton.MouseButton1Click:Connect(function()
				local _, message = runOption(options, "onToggleHideDuringPlayback", "toggleHideDuringPlayback")
				if statusLabel then
					statusLabel.Text = tostring(message or "Hide During Playback toggled.")
				end
				refresh()
			end)
		end

		setMicroTab = function(tabName)
			if not isKnownWorkspaceTab(tabName) then
				tabName = "Timeline"
			end
			if tabName == "File" then
				closeFeaturePopup()
				if type(options.onOpenProjectSummary) == "function" then
					options.onOpenProjectSummary()
				end
				return
			end
			activeTab = tabName
			setSettingString(plugin, ACTIVE_TAB_SETTING, activeTab)
			for name, railButton in pairs(railButtons) do
				local selected = name == activeTab
				railButton.BackgroundColor3 = selected and theme().Accent or theme().PanelSoft
				railButton.TextColor3 = selected and ThemeService.getReadableTextColor(theme().Accent) or ThemeService.getReadableTextColor(theme().PanelSoft)
				railButton:SetAttribute("MegMoThemeBackgroundRole", selected and "Accent" or "PanelSoft")
				local railIcon = railButton:FindFirstChild("RailIcon")
				if railIcon then
					railIcon.ImageColor3 = railButton.TextColor3
				end
				local railStroke = railButtonStrokes[name]
				if railStroke then
					railStroke.Transparency = selected and 0 or 0.36
					railStroke.Thickness = selected and 1.6 or 1
				end
			end
			timelineView.Visible = true
			if activeTab == "Timeline" then
				closeFeaturePopup()
			else
				openFeaturePopup(activeTab)
			end
		end

		for index, item in ipairs(MICRO_SHELL_MENU_ITEMS) do
			local railButton = make("TextButton", {
				Name = item.name .. "RailButton",
				AutoButtonColor = true,
				BackgroundColor3 = theme().PanelSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Position = UDim2.fromOffset(5, 29 + ((index - 1) * 21)),
				Size = UDim2.fromOffset(getRailWidth() - 10, 19),
				Text = railExpanded and ("  " .. item.name) or item.label,
				TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
				TextSize = railExpanded and 10 or 9,
				TextXAlignment = railExpanded and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
				TextWrapped = false,
				ZIndex = 24,
			}, sideRail)
			railButton:SetAttribute("MegMoRailName", item.name)
			railButton:SetAttribute("MegMoRailLabel", item.label)
			railButton:SetAttribute("MegMoRailIndex", index)
			railButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
			railButton:SetAttribute("MegMoThemeTextRole", "__auto")
			corner(railButton, 5)
			createMicroRailIcon(railButton, item.name)
			railButtons[item.name] = railButton
			railButton.MouseEnter:Connect(function()
				if railExpanded then
					return
				end
				railHint.Text = item.name == "Export" and "Cutscene" or item.name
				railHint.Position = UDim2.fromOffset(
					math.max(4, panel.AbsolutePosition.X - railHint.AbsoluteSize.X - 6),
					math.max(4, railButton.AbsolutePosition.Y - 1)
				)
				railHint.Visible = true
			end)
			railButton.MouseLeave:Connect(function()
				railHint.Visible = false
			end)
			railButton.MouseButton1Click:Connect(function()
				railHint.Visible = false
				setRadialMenuOpen(false)
				setMicroTab(item.name)
			end)
		end
		radialHub = mountMicroRadialHub({
			gui = gui,
			panel = panel,
			toolStrip = toolStrip,
			toolHint = toolHint,
			railHint = railHint,
			isRailExpanded = function()
				return railExpanded
			end,
			onOpenSummary = function()
				if type(options.onOpenProjectSummary) == "function" then
					options.onOpenProjectSummary()
				end
			end,
			onSelectTab = setMicroTab,
		})
		railToggle.MouseButton1Click:Connect(function()
			railExpanded = not railExpanded
			setSettingNumber(plugin, RAIL_EXPANDED_SETTING, railExpanded and 1 or 0)
			railHint.Visible = false
			setRadialMenuOpen(false)
			applyRailMode()
			refresh()
		end)
		applyRailMode()
		task.defer(updateRadialDockPlacement)
		setMicroTab(activeTab)

		microUiHost._resizeGrip = make("ImageButton", {
			Name = "ResizeGrip",
			Active = true,
			AnchorPoint = Vector2.new(1, 1),
			AutoButtonColor = false,
			BackgroundColor3 = theme().PanelSoft,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = "rbxassetid://104703373565023",
			ImageColor3 = theme().Text,
			ImageTransparency = 1,
			Position = UDim2.new(1, -5, 1, -5),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(18, 18),
			ZIndex = 20,
		}, panel)
		microUiHost._resizeGrip:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		microUiHost._resizeGrip:SetAttribute("MegMoThemeImageRole", "Text")
		corner(microUiHost._resizeGrip, 4)
		blockClickThrough(microUiHost._resizeGrip)
		microUiHost._resizeGripResizing = false
		microUiHost._setResizeGripVisible = function(visible)
			if microUiHost._resizeGrip then
				microUiHost._resizeGrip.BackgroundTransparency = visible and 0.42 or 1
				microUiHost._resizeGrip.ImageTransparency = visible and 0.08 or 1
			end
		end
		microUiHost._resizeGrip.MouseEnter:Connect(function()
			microUiHost._setResizeGripVisible(true)
		end)
		microUiHost._resizeGrip.MouseLeave:Connect(function()
			if microUiHost._resizeGripResizing then
				return
			end
			microUiHost._setResizeGripVisible(false)
		end)
		MicroWidgetController._makeResizable(microUiHost._resizeGrip, panel, function(isResizing)
			microUiHost._resizeGripResizing = isResizing
			microUiHost._setResizeGripVisible(isResizing)
			panelStroke.Color = isResizing and Color3.fromRGB(58, 176, 255) or theme().Accent
			panelStroke.Transparency = isResizing and 0 or 0.15
			panelStroke.Thickness = isResizing and 2 or 1
			if not isResizing then
				saveGeometry(plugin, PANEL_SETTING_PREFIX, panel)
				updateRadialDockPlacement()
				miniTimelineSignature = nil
				refresh()
			end
		end)

		close.MouseButton1Click:Connect(function()
			options.onRequestCloseMicroWorkspace()
		end)
		options._triggerMicroSelectedOptions = function()
			if not gui or not gui.Enabled or not microActive then
				return
			end
			local focusedTextBox = UserInputService:GetFocusedTextBox()
			if focusedTextBox and focusedTextBox ~= options._microShortcutCaptureInput then
				return
			end
			pcall(function()
				plugin:Activate(true)
			end)
			if statusLabel then
				statusLabel.Text = "Opening selected options..."
			end
			local opened, message = openMicroSelectedOptions()
			if statusLabel and type(message) == "string" and message ~= "" then
				statusLabel.Text = message
			end
			if opened then
				miniTimelineSignature = nil
			end
		end
		keyboardInputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if input
				and (input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3)
				and microActive
				and gui
				and gui.Enabled
				and panel
				and panel.Parent then
				local mouseLocation = UserInputService:GetMouseLocation()
				local point = Vector2.new(mouseLocation.X, mouseLocation.Y)
				-- The rig/property editor is a full-screen Micro modal. Its buttons can
				-- sit outside the floating panel, so do not let those left-clicks enter
				-- the viewport-pick ownership path and clear the selected keyframes
				-- before an easing/property action is applied.
				if input.UserInputType == Enum.UserInputType.MouseButton1
					and microUiHost._rigPropertyEditorOverlay
					and microUiHost._rigPropertyEditorOverlay.Visible then
					return
				end
				if input.UserInputType == Enum.UserInputType.MouseButton1
					and featurePopup
					and featurePopup.Parent
					and featurePopup.Visible
					and isMicroPointInside(featurePopup, point) then
					return
				end
				local panelPosition = panel.AbsolutePosition
				local panelSize = panel.AbsoluteSize
				if point.X &lt; panelPosition.X
					or point.X &gt; panelPosition.X + panelSize.X
					or point.Y &lt; panelPosition.Y
					or point.Y &gt; panelPosition.Y + panelSize.Y then
					-- An explicitly armed Workspace Grab owns outside left-clicks.
					-- Preserve Micro's existing ownership state so disarming Grab
					-- returns directly to the normal rig-part picker.
					if input.UserInputType == Enum.UserInputType.MouseButton1
						and require(script.Parent.Parent:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
						options._microViewportOutsideReleaseToken = nil
						return
					end
					-- Right/middle mouse must release Studio camera navigation without
					-- suspending Micro's left-click rig picker.
					if input.UserInputType == Enum.UserInputType.MouseButton2
						or input.UserInputType == Enum.UserInputType.MouseButton3 then
						options._microViewportCameraNavigationActive = true
						options._microViewportCameraNavigationUntil = os.clock() + 10
						options._microViewportOutsideReleaseToken = nil
						options._microCtrlShortcutCaptureActive = false
						releaseMicroShortcutCapture(options)
						runOption(
							options,
							"onBeginMicroViewportCameraNavigation",
							"beginMicroViewportCameraNavigation",
							input.UserInputType.Name
						)
						pcall(function()
							if plugin then
								plugin:Deactivate()
							end
						end)
						if statusLabel then
							statusLabel.Text = "Studio camera controls active. Micro timeline shortcuts remain active."
						end
						return
					end
					if input.UserInputType == Enum.UserInputType.MouseButton1
						and MicroWidgetController._shouldAttemptViewportRigPartPick(options, plugin, gui, microActive)
						and MicroWidgetController._tryViewportRigPartPick(options, plugin, point, false, true) then
						MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
						return
					end
					if input.UserInputType == Enum.UserInputType.MouseButton1
						and type(options.onIsViewportGizmoPointerOverHandle) == "function"
						and options.onIsViewportGizmoPointerOverHandle(point) == true then
						if type(options.onKeepViewportGizmoOwnership) == "function" then
							pcall(options.onKeepViewportGizmoOwnership)
						end
						MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
						return
					end
					if input.UserInputType == Enum.UserInputType.MouseButton1
						and MicroWidgetController._shouldAttemptViewportRigPartPick(options, plugin, gui, microActive) then
						local ownsTimeline = MicroWidgetController._ownsMicroTimelineShortcuts(options, gui, microActive)
						local picked = MicroWidgetController._tryViewportRigPartPick(options, plugin, point, ownsTimeline)
						if picked then
							MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
							return
						end
					end
					if os.clock() &lt;= (tonumber(options._microTimelineArmGraceUntil) or 0) then
						return
					end
					MicroWidgetController._releaseMicroTimelineOwnershipAfterViewportSettle(
						options,
						plugin,
						statusLabel,
						"Studio shortcuts active: click Micro to resume timeline shortcuts.",
						gui,
						microActive,
						point
					)
					return
				end
				if input.UserInputType == Enum.UserInputType.MouseButton1
					and require(script.Parent.Parent:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive()
					and not (
						microToolButtons.workspaceGrab
						and microToolButtons.workspaceGrab.Parent
						and point.X &gt;= microToolButtons.workspaceGrab.AbsolutePosition.X
						and point.X &lt;= microToolButtons.workspaceGrab.AbsolutePosition.X
							+ microToolButtons.workspaceGrab.AbsoluteSize.X
						and point.Y &gt;= microToolButtons.workspaceGrab.AbsolutePosition.Y
						and point.Y &lt;= microToolButtons.workspaceGrab.AbsolutePosition.Y
							+ microToolButtons.workspaceGrab.AbsoluteSize.Y
					) then
					local _, message = runOption(
						options,
						"onReleaseWorkspaceGrabFromPluginUi",
						"releaseWorkspaceGrabFromPluginUi",
						"Free Grab turned off because you returned to 7kg2.",
						"PluginUiFocused"
					)
					if statusLabel and type(message) == "string" then
						statusLabel.Text = message
					end
					task.defer(refresh)
				end
				MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
				return
			end
			if input
				and (input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3) then
				runOption(
					options,
					"onEndMicroViewportCameraNavigation",
					"endMicroViewportCameraNavigation",
					input.UserInputType.Name
				)
				options._microViewportCameraNavigationActive = false
				options._microViewportCameraNavigationUntil = os.clock() + 0.35
			end
			if MicroWidgetController._tryMicroTimelineControlShortcut(options, plugin, gui, microActive, statusLabel, refresh, options._triggerMicroSelectedOptions, input) then
				return
			end
			handleMicroToolShortcut(options, plugin, gui, microActive, statusLabel, refresh, options._triggerMicroSelectedOptions, input, gameProcessed)
		end)
		keyboardInputEndedConnection = UserInputService.InputEnded:Connect(function(input)
			if input
				and (input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3) then
				runOption(
					options,
					"onEndMicroViewportCameraNavigation",
					"endMicroViewportCameraNavigation",
					input.UserInputType.Name
				)
				options._microViewportCameraNavigationActive = false
				options._microViewportCameraNavigationUntil = os.clock() + 0.35
			end
			if input and input.UserInputType == Enum.UserInputType.Keyboard then
				local key = normalizeMicroShortcutName(input.KeyCode.Name)
				if (input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl)
					and options._microCtrlShortcutCaptureActive then
					options._microCtrlShortcutCaptureActive = false
					releaseMicroShortcutCapture(options)
				end
				if (key == "previousframe" or key == "nextframe") and type(options._microFrameStepShortcutDown) == "table" then
					options._microFrameStepShortcutDown[key] = nil
				end
				if (key == "z" or key == "y") and type(options._microOneShotShortcutDown) == "table" then
					options._microOneShotShortcutDown[key] = nil
				end
				if (key == "c" or key == "v") and isMicroShortcutShiftDown(options) then
					microShortcutDebug("inputEndedFallback", "key=" .. tostring(input.KeyCode.Name), "normalized=" .. tostring(key), "shift=" .. tostring(isMicroShortcutShiftDown(options)), "selectedKeys=" .. tostring(getMicroShortcutSelectedKeyCount(options)))
					if not shouldSkipDuplicateMicroToolShortcut(key, true, false) then
						runMicroShortcutAction(options, statusLabel, refresh, options._triggerMicroSelectedOptions, key, true, false)
					end
				end
			end
			observeMicroShortcutInput(input, false)
		end)
		options._bindMicroShortcutSink("mount")
		pcall(function()
			local mouse = plugin:GetMouse()
			if mouse then
				pluginMouseKeyConnection = mouse.KeyDown:Connect(function(key)
					handleMicroToolShortcutKeyName(options, plugin, gui, microActive, statusLabel, refresh, options._triggerMicroSelectedOptions, key)
				end)
				pluginMouseKeyEndedConnection = mouse.KeyUp:Connect(function(key)
					local normalizedKey = normalizeMicroShortcutName(key)
					if (normalizedKey == "previousframe" or normalizedKey == "nextframe") and type(options._microFrameStepShortcutDown) == "table" then
						options._microFrameStepShortcutDown[normalizedKey] = nil
					end
					if (normalizedKey == "z" or normalizedKey == "y") and type(options._microOneShotShortcutDown) == "table" then
						options._microOneShotShortcutDown[normalizedKey] = nil
					end
					observeMicroShortcutKeyName(key, false)
				end)
			end
		end)
		prevKey.MouseButton1Click:Connect(function()
			jumpToNeighborKey(-1)
		end)
		nextKey.MouseButton1Click:Connect(function()
			jumpToNeighborKey(1)
		end)
		play.MouseButton1Click:Connect(function()
			microUiHost._manualFrameWindowAnchor = nil
			if type(options.onPlayPause) == "function" then
				safeCall(options.onPlayPause)
			else
				safeCall(options.onPlay)
			end
			refresh()
		end)
		stop.MouseButton1Click:Connect(function()
			microUiHost._manualFrameWindowAnchor = nil
			safeCall(options.onStop)
			refresh()
		end)
		bakeButton.MouseButton1Click:Connect(function()
			runOption(options, "onBakePreview", "bakePreview")
			refresh()
		end)
		removeTrack.MouseButton1Click:Connect(function()
			closeMicroTrackToolsMenu()
			closeMicroAddTrackMenu()
			runOption(options, "onRemoveSelectedTrack", "removeSelectedTrack")
			refresh()
		end)
		addRig.MouseButton1Click:Connect(function()
			closeMicroTrackToolsMenu()
			closeMicroAddTrackMenu()
			positionMicroRigMenu()
			microRigMenu.Visible = not microRigMenu.Visible
		end)
		if avatarImportRefs._avatarImportRigTypeButton then
			avatarImportRefs._avatarImportRigTypeButton.Activated:Connect(function()
				cycleMicroAvatarRigType()
			end)
		end
		if avatarImportRefs._avatarImportCloseButton then
			avatarImportRefs._avatarImportCloseButton.Activated:Connect(function()
				hideMicroAvatarImportDialog()
			end)
		end
		if avatarImportRefs._avatarImportCancelButton then
			avatarImportRefs._avatarImportCancelButton.Activated:Connect(function()
				hideMicroAvatarImportDialog()
			end)
		end
		if avatarImportRefs._avatarImportInsertButton then
			avatarImportRefs._avatarImportInsertButton.Activated:Connect(function()
				insertMicroAvatarFromDialog()
			end)
		end
		if avatarImportRefs._avatarImportInput then
			avatarImportRefs._avatarImportInput.FocusLost:Connect(function(enterPressed)
				if enterPressed then
					insertMicroAvatarFromDialog()
				end
			end)
		end
		appliedThemeSignature = nil
		refresh()
		return gui
	end

	toolbarButton.Click:Connect(function()
		local wasVisible = gui and gui.Enabled == true
		ensurePanel()
		if wasVisible then
			options.onRequestCloseMicroWorkspace()
		else
			setActive(true)
		end
		refresh()
	end)

	task.spawn(function()
		while not closed do
			if gui and gui.Enabled then
				refresh()
			elseif gui and not gui.Enabled and microActive and microUiHost._screenshotHidden ~= true then
				microActive = false
				toolbarButton:SetActive(false)
				closeFeaturePopup()
			end
			if gui and gui.Enabled and isMicroPlaybackActive(options) then
				task.wait(0.1)
			else
				task.wait(0.35)
			end
		end
	end)

	pcall(function()
		plugin.Unloading:Connect(function()
			closed = true
			destroyPanel()
		end)
	end)

	return {
		SetActive = function(active)
			if active then
				ensurePanel()
			end
			setActive(active)
			if active then
				refresh()
			end
		end,
		Refresh = function()
			if gui and gui.Enabled then
				refresh()
			end
		end,
		SetScreenshotHidden = function(hidden)
			microUiHost._screenshotHidden = hidden == true
			if gui then
				gui.Enabled = microActive and microUiHost._screenshotHidden ~= true
			end
			if microActive then
				toolbarButton:SetActive(true)
			end
			if gui and gui.Enabled then
				refresh()
			end
		end,
		Destroy = function()
			closed = true
			destroyPanel()
		end,
	}
end

return MicroWidgetController
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX93">
          <Properties>
            <string name="Name">MicroWiggleFramesPopupSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local WidgetOverlayStateSupport = require(script.Parent.Parent:WaitForChild("WidgetOverlayStateSupport"))
local WiggleFramesUI = require(script.Parent:WaitForChild("WiggleFramesUI"))

local MicroWiggleFramesPopupSupport = {}

local function setStatus(config, message)
	if type(config.setStatus) == "function" then
		config.setStatus(message)
	end
end

local function connect(config, signal, handler)
	if type(config.connect) == "function" then
		return config.connect(signal, handler)
	end
	if signal and type(handler) == "function" then
		return signal:Connect(handler)
	end
	return nil
end

local function getOptions(controller)
	return {
		angleX = controller._wiggleFramesAngleXInput and controller._wiggleFramesAngleXInput.Text or "2",
		angleY = controller._wiggleFramesAngleYInput and controller._wiggleFramesAngleYInput.Text or "2",
		angleZ = controller._wiggleFramesAngleZInput and controller._wiggleFramesAngleZInput.Text or "2",
		posX = controller._wiggleFramesPosXInput and controller._wiggleFramesPosXInput.Text or "0",
		posY = controller._wiggleFramesPosYInput and controller._wiggleFramesPosYInput.Text or "0",
		posZ = controller._wiggleFramesPosZInput and controller._wiggleFramesPosZInput.Text or "0",
		interval = controller._wiggleFramesIntervalInput and controller._wiggleFramesIntervalInput.Text or "0:02",
		easingStyle = controller._wiggleFramesEasingStyle or "Linear",
		easingDirection = controller._wiggleFramesEasingDirection or Constants.DEFAULT_EASING_DIRECTION,
	}
end

function MicroWiggleFramesPopupSupport.mount(parent, controller, config)
	if not parent or not controller then
		return nil
	end

	config = config or {}
	local refs = WiggleFramesUI.mount(parent, {})
	for key, value in pairs(refs or {}) do
		controller[key] = value
	end

	function controller:_showWiggleFramesOverlay()
		local success, message = WidgetOverlayStateSupport.showWiggleFramesOverlay(self)
		setStatus(config, message or "Wiggle open: choose offsets and interval, then press OK.")
		return success, message
	end

	function controller:_hideWiggleFramesOverlay()
		WidgetOverlayStateSupport.hideWiggleFramesOverlay(self)
	end

	function controller:_getWiggleFramesOptions()
		return getOptions(self)
	end

	connect(config, controller._wiggleFramesCloseButton and controller._wiggleFramesCloseButton.Activated, function()
		controller:_hideWiggleFramesOverlay()
		setStatus(config, "Wiggle settings closed.")
	end)

	connect(config, controller._wiggleFramesCancelButton and controller._wiggleFramesCancelButton.Activated, function()
		controller:_hideWiggleFramesOverlay()
		setStatus(config, "Wiggle settings closed.")
	end)

	connect(config, controller._wiggleFramesEasingStyleButton and controller._wiggleFramesEasingStyleButton.Activated, function()
		if controller._wiggleFramesEasingDirectionDropdown then
			controller._wiggleFramesEasingDirectionDropdown.Visible = false
		end
		if controller._wiggleFramesEasingStyleDropdown then
			controller._wiggleFramesEasingStyleDropdown.Visible = not controller._wiggleFramesEasingStyleDropdown.Visible
		end
	end)

	connect(config, controller._wiggleFramesEasingDirectionButton and controller._wiggleFramesEasingDirectionButton.Activated, function()
		if controller._wiggleFramesEasingStyleDropdown then
			controller._wiggleFramesEasingStyleDropdown.Visible = false
		end
		if controller._wiggleFramesEasingDirectionDropdown then
			controller._wiggleFramesEasingDirectionDropdown.Visible = not controller._wiggleFramesEasingDirectionDropdown.Visible
		end
	end)

	for easingStyle, optionButton in pairs(controller._wiggleFramesEasingStyleOptionButtons or {}) do
		connect(config, optionButton.Activated, function()
			controller._wiggleFramesEasingStyle = easingStyle
			if controller._wiggleFramesEasingStyleButton then
				controller._wiggleFramesEasingStyleButton.Text = easingStyle .. " v"
			end
			if controller._wiggleFramesEasingStyleDropdown then
				controller._wiggleFramesEasingStyleDropdown.Visible = false
			end
		end)
	end

	for easingDirection, optionButton in pairs(controller._wiggleFramesEasingDirectionOptionButtons or {}) do
		connect(config, optionButton.Activated, function()
			controller._wiggleFramesEasingDirection = easingDirection
			if controller._wiggleFramesEasingDirectionButton then
				controller._wiggleFramesEasingDirectionButton.Text = easingDirection .. " v"
			end
			if controller._wiggleFramesEasingDirectionDropdown then
				controller._wiggleFramesEasingDirectionDropdown.Visible = false
			end
		end)
	end

	connect(config, controller._wiggleFramesOkButton and controller._wiggleFramesOkButton.Activated, function()
		if type(config.onApplyAnimationEffect) == "function" then
			config.onApplyAnimationEffect("Wiggle", controller:_getWiggleFramesOptions())
		end
		controller:_hideWiggleFramesOverlay()
		setStatus(config, "Wiggle applied.")
		if type(config.refresh) == "function" then
			config.refresh()
		end
	end)

	return refs
end

return MicroWiggleFramesPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX94">
          <Properties>
            <string name="Name">MotionBuilderUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local MotionBuilderUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createMetaLabel = UiHelpers.createMetaLabel
local createListLayout = UiHelpers.createListLayout

local function applySolidSectionSurface(surface)
	surface.BackgroundColor3 = Constants.THEME.PanelAlt
	surface:SetAttribute("MegMoThemeBackgroundRole", "PanelAlt")
end

local function createBorderOnlyStroke(parent, transparency)
	local stroke = create("UIStroke", {
		Parent = parent,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Border,
		Thickness = 1,
		Transparency = transparency or 0.48,
	})
	stroke:SetAttribute("MegMoThemeStrokeRole", "Border")
	return stroke
end

local function strengthenButtonGradient(button)
	for _, descendant in ipairs(button:GetDescendants()) do
		if descendant:IsA("UIGradient") and descendant.Name == "MegMoButtonGradient" then
			descendant.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.56),
				NumberSequenceKeypoint.new(0.14, 0.74),
				NumberSequenceKeypoint.new(0.5, 1),
				NumberSequenceKeypoint.new(0.82, 0.8),
				NumberSequenceKeypoint.new(1, 0.52),
			})
		end
	end
end

local MOTION_CARD_BACKGROUNDS = {
	AddMarkers = "rbxassetid://77997605040903",
	Build = "rbxassetid://86370757687638",
	Camera = "rbxassetid://101328315523008",
	Rig = "rbxassetid://109107029401598",
}

local function addCardBackgroundIcon(card, iconKey)
	local image = MOTION_CARD_BACKGROUNDS[iconKey]
	if not card or not image then
		return nil
	end

	local icon = create("ImageLabel", {
		Name = "MotionCardBackgroundIcon",
		Parent = card,
		Active = false,
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Image = image,
		ImageColor3 = Constants.THEME.Text,
		ImageTransparency = 0.92,
		Position = UDim2.new(1, -10, 0.5, 2),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(40, 40),
		ZIndex = card.ZIndex,
	})
	icon:SetAttribute("MegMoThemeImageRole", "Text")
	return icon
end

local function createStepBadge(parent, numberText)
	local badge = create("TextLabel", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 22, 0, 22),
		Font = Enum.Font.GothamSemibold,
		Text = numberText,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	createCorner(badge, 11)
	return badge
end

local function createStepCard(parent, position, size, stepNumber, titleText, bodyText)
	local card = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = position,
		Size = size,
		ZIndex = 6,
	})
	applySolidSectionSurface(card)
	createCorner(card, 10)
	createBorderOnlyStroke(card)

	local badge = createStepBadge(card, stepNumber)
	badge.Position = UDim2.new(0, 12, 0, 12)
	badge.ZIndex = 7

	local title = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 42, 0, 12),
		Size = UDim2.new(1, -54, 0, 22),
		Font = Enum.Font.GothamBold,
		Text = titleText,
		TextColor3 = Constants.THEME.Text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
	})

	local body = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 38),
		Size = UDim2.new(1, -24, 0, 54),
		Font = Enum.Font.GothamSemibold,
		Text = bodyText,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.None,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 7,
	})

	return card, title, body
end

function MotionBuilderUI.mount(parent, context)
	if not parent then
		error("MotionBuilderUI.mount requires parent")
	end

	context = context or {}
	local refs = {}
	local useOwnPanel = context.useOwnPanel ~= false
	local topInset = context.topInset or 0
	local bottomInset = context.bottomInset or 0
	local function getLayoutScale()
		local scale
		if type(context.getLayoutScale) == "function" then
			scale = tonumber(context.getLayoutScale())
		end
		if not scale and parent and parent.GetAttribute then
			scale = tonumber(parent:GetAttribute("MegMoLayoutScale"))
		end
		if not scale or scale &lt;= 0 then
			return 1
		end
		return scale
	end

	local panelProps = {
		Name = "MotionBuilderPanel",
		Parent = parent,
		BackgroundColor3 = Color3.fromRGB(17, 22, 34),
		BackgroundTransparency = useOwnPanel and 0 or 1,
		BorderSizePixel = 0,
		Position = useOwnPanel and UDim2.new(0, 14, 0, 48) or UDim2.new(0, 16, 0, topInset),
		Size = useOwnPanel and UDim2.new(1, -28, 1, -62) or UDim2.new(1, -32, 1, -(topInset + bottomInset)),
		ClipsDescendants = true,
		ZIndex = 5,
	}
	local panel = create("Frame", panelProps)
	if useOwnPanel then
		createCorner(panel, 12)
		createStroke(panel)
	end

	local contentScroll = create("ScrollingFrame", {
		Name = "MotionBuilderContentScroll",
		Parent = panel,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ClipsDescendants = true,
		Position = UDim2.new(0, 0, 0, 0),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 5,
	})
	local content = create("Frame", {
		Name = "MotionBuilderContent",
		Parent = contentScroll,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 320),
		ZIndex = 5,
	})

	if useOwnPanel then
		create("TextLabel", {
			Parent = content,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.new(0, 120, 0, 22),
			Font = Enum.Font.GothamBold,
			Text = "Motion Builder",
			TextColor3 = Constants.THEME.Text,
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 6,
		})
		local headerDescription = createMetaLabel(content, "Create animations using markers, movements, and built-in clips.", 20)
		headerDescription.Position = UDim2.new(0, 132, 0, 3)
		headerDescription.Size = UDim2.new(1, -140, 0, 18)
		headerDescription.Font = Enum.Font.GothamSemibold
		headerDescription.TextColor3 = Constants.THEME.Text
		headerDescription.TextSize = 12
	end

	local currentFlowCard = create("Frame", {
		Parent = content,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0.36, 0, 0, 0),
		Size = UDim2.new(0.64, -12, 0, 48),
		Visible = false,
		ZIndex = 6,
	})
	applySolidSectionSurface(currentFlowCard)
	createCorner(currentFlowCard, 10)
	createBorderOnlyStroke(currentFlowCard)
	create("TextLabel", {
		Parent = currentFlowCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Font = Enum.Font.GothamBold,
		Text = "Current Flow",
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
	})
	create("TextLabel", {
		Parent = currentFlowCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 24),
		Size = UDim2.new(1, -24, 0, 16),
		Font = Enum.Font.GothamSemibold,
		Text = "Refresh/select rig, add markers, then Build Timeline to generate the rig path.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 7,
	})

	local topCardY = useOwnPanel and 40 or 4
	local topCardHeight = 96
	local workflowColumnWidth = 0.19
	local buildColumnWidth = 0.18
	local motionsColumnWidth = 1 - workflowColumnWidth - buildColumnWidth
	local topCardWidth = workflowColumnWidth
	local autoFillMotionsButton = nil
	local applyResponsiveLayout
	local collapsibleSections = context.enableCollapsibleSections == true
	local collapsedSections = {}
	local sectionControls = {}
	local sectionToggles = {}

	local function setControlsVisible(controls, isVisible)
		for _, instance in ipairs(controls or {}) do
			if instance and instance.Parent then
				instance.Visible = isVisible
			end
		end
	end

	local function isSectionCollapsed(sectionId)
		return collapsibleSections and collapsedSections[sectionId] == true
	end

	local function updateSectionCollapse(sectionId)
		if not collapsibleSections then
			return
		end
		local collapsed = isSectionCollapsed(sectionId)
		setControlsVisible(sectionControls[sectionId], not collapsed)
		local toggle = sectionToggles[sectionId]
		if toggle then
			toggle.Text = collapsed and "+" or "-"
		end
	end

	local function makeCollapseToggle(sectionId, card, controls)
		if not collapsibleSections or not card then
			return
		end
		sectionControls[sectionId] = controls or {}
		local toggle = create("TextButton", {
			Name = "CollapseToggle",
			Parent = card,
			AnchorPoint = Vector2.new(1, 0),
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Position = UDim2.new(1, -10, 0, 10),
			Size = UDim2.fromOffset(28, 22),
			Font = Enum.Font.GothamBold,
			Text = "-",
			TextColor3 = Constants.THEME.Text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 12,
		})
		createCorner(toggle, 7)
		createBorderOnlyStroke(toggle, 0.35)
		sectionToggles[sectionId] = toggle
		toggle.Activated:Connect(function()
			collapsedSections[sectionId] = not collapsedSections[sectionId]
			updateSectionCollapse(sectionId)
			if applyResponsiveLayout then
				applyResponsiveLayout()
			end
		end)
		updateSectionCollapse(sectionId)
	end

	local rigCard, _, rigBody = createStepCard(
		content,
		UDim2.new(0, 12, 0, topCardY),
		UDim2.new(topCardWidth, -18, 0, topCardHeight),
		"1",
		"Select Rig",
		"Choose the rig you want to animate."
	)
	local rigBackgroundIcon = addCardBackgroundIcon(rigCard, "Rig")
	local rigRow = create("Frame", {
		Parent = rigCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -34),
		Size = UDim2.new(1, -24, 0, 24),
		ZIndex = 8,
	})
	local rigValue = create("TextLabel", {
		Parent = rigRow,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(0.46, -4, 1, 0),
		Font = Enum.Font.Gotham,
		Text = "No rig bound",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 8,
	})
	createCorner(rigValue, 8)
	createBorderOnlyStroke(rigValue, 0.38)
	create("UIPadding", {
		Parent = rigValue,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	local selectRigButton = create("TextButton", {
		Name = "MotionSelectRigButton",
		Parent = rigRow,
		Position = UDim2.new(0.46, 4, 0, 0),
		Size = UDim2.new(0.54, -4, 1, 0),
		Text = "Use Selected Rig",
		ZIndex = 8,
	})
	styleGhostButton(selectRigButton)
	selectRigButton.TextSize = 12
	createCorner(selectRigButton, 8)
	makeCollapseToggle("rig", rigCard, { rigBody, rigRow, rigBackgroundIcon })

	local addMarkersCard, _, addMarkersBody = createStepCard(
		content,
		UDim2.new(0, 12, 0, topCardY + topCardHeight + 8),
		UDim2.new(topCardWidth, -18, 0, topCardHeight),
		"2",
		"Add Markers",
		"Insert markers in the workspace and position them."
	)
	local addMarkersBackgroundIcon = addCardBackgroundIcon(addMarkersCard, "AddMarkers")
	local markerButtonsRow = create("Frame", {
		Parent = addMarkersCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -34),
		Size = UDim2.new(1, -24, 0, 24),
		ZIndex = 8,
	})
	local addMarkerButton = create("TextButton", {
		Name = "MotionAddMarkerButton",
		Parent = markerButtonsRow,
		Size = UDim2.new(0.34, -5, 1, 0),
		Text = "Add",
		ZIndex = 8,
	})
	styleTextButton(addMarkerButton)
	addMarkerButton.TextSize = 12
	createCorner(addMarkerButton, 8)
	local clearMarkersButton = create("TextButton", {
		Name = "MotionClearMarkersButton",
		Parent = markerButtonsRow,
		Position = UDim2.new(0.34, 4, 0, 0),
		Size = UDim2.new(0.33, -5, 1, 0),
		Text = "Delete",
		ZIndex = 8,
	})
	styleGhostButton(clearMarkersButton)
	clearMarkersButton.TextSize = 12
	createCorner(clearMarkersButton, 8)
	local resetMarkersButton = create("TextButton", {
		Name = "MotionResetMarkersButton",
		Parent = markerButtonsRow,
		Position = UDim2.new(0.67, 4, 0, 0),
		Size = UDim2.new(0.33, -4, 1, 0),
		Text = "Reset",
		ZIndex = 8,
	})
	styleGhostButton(resetMarkersButton)
	resetMarkersButton.TextSize = 12
	createCorner(resetMarkersButton, 8)
	makeCollapseToggle("markers", addMarkersCard, { addMarkersBody, markerButtonsRow, addMarkersBackgroundIcon })

	local cameraCard, _, cameraBody = createStepCard(
		content,
		UDim2.new(1 - buildColumnWidth, 6, 0, topCardY + topCardHeight + 8),
		UDim2.new(buildColumnWidth, -18, 0, topCardHeight),
		"5",
		"Camera",
		"Add a camera track or open camera effects for Orbit and Follow presets."
	)
	local cameraBackgroundIcon = addCardBackgroundIcon(cameraCard, "Camera")
	local cameraButtonsRow = create("Frame", {
		Parent = cameraCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -34),
		Size = UDim2.new(1, -24, 0, 24),
		ZIndex = 8,
	})
	local addCameraButton = create("TextButton", {
		Name = "MotionAddCameraButton",
		Parent = cameraButtonsRow,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Add Camera",
		ZIndex = 8,
	})
	styleTextButton(addCameraButton)
	addCameraButton.TextSize = 12
	createCorner(addCameraButton, 8)
	local cameraEffectsButton = create("TextButton", {
		Name = "MotionCameraEffectsButton",
		Parent = cameraButtonsRow,
		Position = UDim2.new(0.5, 4, 0, 0),
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Effects",
		ZIndex = 8,
	})
	styleGhostButton(cameraEffectsButton)
	cameraEffectsButton.TextSize = 12
	createCorner(cameraEffectsButton, 8)
	makeCollapseToggle("camera", cameraCard, { cameraBody, cameraButtonsRow, cameraBackgroundIcon })

	local buildCard, _, buildBody = createStepCard(
		content,
		UDim2.new(1 - buildColumnWidth, 6, 0, topCardY),
		UDim2.new(buildColumnWidth, -18, 0, topCardHeight),
		"4",
		"Adjust &amp; Build",
		"Use the listed markers, then build the rig path."
	)
	local buildBackgroundIcon = addCardBackgroundIcon(buildCard, "Build")
	local markerListFrame = create("Frame", {
		Parent = content,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 0, 174),
		Size = UDim2.new(0.34, -6, 1, -178),
		Visible = false,
		ZIndex = 6,
	})
	applySolidSectionSurface(markerListFrame)
	createCorner(markerListFrame, 10)
	createBorderOnlyStroke(markerListFrame)
	create("TextLabel", {
		Parent = markerListFrame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 8),
		Size = UDim2.new(1, -20, 0, 18),
		Font = Enum.Font.GothamBold,
		Text = "Markers In Workspace",
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
	})
	local markerDescription = createMetaLabel(markerListFrame, "Add markers to the scene. These define the positions your rig will move between.", 30)
	markerDescription.Position = UDim2.new(0, 10, 0, 28)
	markerDescription.Size = UDim2.new(1, -20, 0, 30)
	markerDescription.TextWrapped = true
	markerDescription.TextYAlignment = Enum.TextYAlignment.Top
	local markerList = create("ScrollingFrame", {
		Name = "MotionMarkersList",
		Parent = markerListFrame,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 8, 0, 58),
		Size = UDim2.new(1, -16, 1, -66),
		ScrollBarThickness = 6,
		ZIndex = 7,
	})
	createListLayout(markerList, 6)
	create("UIPadding", {
		Parent = markerList,
		PaddingBottom = UDim.new(0, 4),
	})
	local markerEmptyLabel = create("TextLabel", {
		Name = "MotionMarkersEmptyLabel",
		Parent = markerList,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 54),
		Font = Enum.Font.GothamBold,
		Text = "No markers yet. Click Add Marker to place Marker1, then keep adding more waypoints.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 7,
	})

	local buildButtonsRow = create("Frame", {
		Parent = buildCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -34),
		Size = UDim2.new(1, -24, 0, 24),
		ZIndex = 8,
	})
	local previewPathButton = create("TextButton", {
		Name = "MotionPreviewPathButton",
		Parent = buildButtonsRow,
		Size = UDim2.new(0.42, -4, 1, 0),
		Text = "Preview",
		ZIndex = 8,
	})
	styleGhostButton(previewPathButton)
	previewPathButton.TextSize = 12
	createCorner(previewPathButton, 8)
	local createAnimationButton = create("TextButton", {
		Name = "MotionCreateAnimationButton",
		Parent = buildButtonsRow,
		Position = UDim2.new(0.42, 4, 0, 0),
		Size = UDim2.new(0.58, -4, 1, 0),
		Text = "Build Timeline",
		ZIndex = 8,
	})
	styleTextButton(createAnimationButton)
	createCorner(createAnimationButton, 8)
	makeCollapseToggle("build", buildCard, { buildBody, buildButtonsRow, buildBackgroundIcon })

	local motionsPreviewFrame = create("Frame", {
		Parent = content,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.new(workflowColumnWidth, 6, 0, topCardY),
		Size = UDim2.new(motionsColumnWidth, -12, 1, -(topCardY + 4)),
		ZIndex = 6,
	})
	applySolidSectionSurface(motionsPreviewFrame)
