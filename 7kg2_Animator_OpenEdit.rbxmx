		local baseOnClose = onClose
		local mountedPresets
		local wrappedOnClose
		wrappedOnClose = function()
			if type(baseOnClose) == "function" then
				baseOnClose()
			elseif mountedPresets and type(mountedPresets.destroy) == "function" then
				mountedPresets.destroy()
				mountedPresets = nil
			end
		end
		local function consumeMicroMotionPresetId(animationId)
			local picker = options and options._microMotionPresetPicker
			if not picker then
				return false
			end
			local clipId = tostring(animationId or "")
			if clipId == "" then
				return false
			end
			options._microMotionPresetPicker = nil
			local defaultMotion = tostring(picker.defaultMotion or "")
			local segmentKey = tostring(picker.segmentKey or "")
			local pauseIdlePrefix = "__pause_idle__:"
			if defaultMotion ~= "" and type(options.onSetMotionDefaultClip) == "function" then
				options.onSetMotionDefaultClip(defaultMotion, clipId)
			elseif segmentKey:sub(1, #pauseIdlePrefix) == pauseIdlePrefix and type(options.onSetMotionSegmentPauseIdle) == "function" then
				options.onSetMotionSegmentPauseIdle(segmentKey:sub(#pauseIdlePrefix + 1), clipId)
			elseif segmentKey ~= "" and type(options.onSetMotionSegmentClip) == "function" then
				options.onSetMotionSegmentClip(segmentKey, clipId)
			elseif statusLabel then
				statusLabel.Text = "Motion Builder custom clip picker is not connected."
				return true
			end
			if statusLabel then
				statusLabel.Text = "Motion Builder custom clip selected."
			end
			task.defer(function()
				if type(wrappedOnClose) == "function" then
					wrappedOnClose()
				end
				if type(options.onOpenPopup) == "function" then
					options.onOpenPopup("Motion")
				end
			end)
			return true
		end
		mountedPresets = MicroPresetsPopupSupport.mount(presetsHost, {
			onImportAnimationId = function(animationId, sourceLabel, importEntry)
				if consumeMicroMotionPresetId(animationId) then
					return true
				end
				if options and type(options.onImportAnimationId) == "function" then
					return options.onImportAnimationId(animationId, sourceLabel, importEntry)
				end
				return nil
			end,
			onImportSelectedAnimation = options and options.onImportSelectedAnimation,
			onLoadSavedProjects = options and options.onLoadSavedProjects,
			onLoadMyAnimations = options and options.onLoadMyAnimations,
			onLoadMoreMyAnimations = options and options.onLoadMoreMyAnimations,
			onLoadPresetAnimations = options and options.onLoadPresetAnimations,
			onLoadBulkKeyframeSequences = options and options.onLoadBulkKeyframeSequences,
			onSearchMarketplaceAnimations = options and options.onSearchMarketplaceAnimations,
			onSearchMyAnimations = options and options.onSearchMyAnimations,
			onImportBulkKeyframeSequence = options and options.onImportBulkKeyframeSequence,
			onOpenR15ToR6Converter = function()
				if options and type(options.onOpenR15ToR6Converter) == "function" then
					return options.onOpenR15ToR6Converter(popup)
				end
				return false, "R15 -&gt; R6 Converter is not connected yet."
			end,
