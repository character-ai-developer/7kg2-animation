		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 40),
		Text = "Hover over any Advanced setting to see what it changes.",
		TextColor3 = theme.muted,
		TextSize = 10,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, self.advancedHelp)
	for _, entry in ipairs(ADVANCED_HELP) do
		local button = refs[entry.ref]
		if button then
			local helpTitle = entry.title
			local helpBody = entry.body
			button.MouseEnter:Connect(function()
				self.advancedHelpTitle.Text = helpTitle
				self.advancedHelpBody.Text = helpBody
			end)
		end
	end

	refs.takeHeading.Font = Enum.Font.GothamBold
