end)
connect(refs.movement.Activated, function()
	if RunService:IsRunning() then
		setStatus("Finish the current simulation before changing movement style.", THEME.yellow)
		return
	end
	if state.effectMode ~= "Impact" then
		return
	end
	state.movingObjectMode = state.movingObjectMode == "PhysicsDrive" and "FollowPath" or "PhysicsDrive"
	if state.movingObjectMode == "PhysicsDrive" then
		state.objectEditSnapshots = ObjectCaptureSnapshot.Capture(state.objectTargets)
	end
	state.take = nil
	state.takes = {}
	state.takeIndex = 0
	setStatus(
		state.movingObjectMode == "PhysicsDrive"
			and "Physics Drive uses the path's start, end, and timing as launch velocity. Selected anchored loose objects are released on impact; unselected anchored ramps remain static."
			or "Follow Path drives the Moving Object through every authored CFrame and releases selected objects on impact.",
		THEME.cyan
	)
	updateUI()
end)
connect(refs.keepUpright.Activated, function()
	if RunService:IsRunning() or state.effectMode ~= "Impact" or state.movingObjectMode ~= "PhysicsDrive" then
		return
	end
	state.keepUpright = not state.keepUpright
	state.take = nil
	state.takes = {}
	state.takeIndex = 0
	setStatus(
		state.keepUpright
			and "Keep Upright follows the ramp while grounded, then levels the vehicle in the air to prevent flips."
			or "Keep Upright is off. The vehicle can roll or topple naturally.",
		state.keepUpright and THEME.green or THEME.muted
	)
	updateUI()
end)
connect(refs.pathMode.Activated, function()
	if RunService:IsRunning() then
		setStatus("Stop Run mode before changing the animated path mode.", THEME.yellow)
		return
	end
	if state.captureMode == "Objects" then
		setStatus("Object Only mode does not use an animated rig path.", THEME.muted)
		return
	end
	if state.effectMode == "AdaptiveWalk" then
		setStatus("Adaptive Walk always preserves the authored path while correcting terrain contacts.", THEME.muted)
		return
	end
	state.pathMode = state.pathMode == "DrivenImpact" and "Handoff" or "DrivenImpact"
	state.animatedPath = nil
	setStatus(
		state.pathMode == "DrivenImpact"
			and "Driven Impact preserves the remaining authored path and releases selected objects on contact."
			or "Physics Handoff follows the path to the playhead, then releases the rig to physics.",
		THEME.cyan
	)
	updateUI()
end)
