		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 6),
		Size = UDim2.new(1, -20, 0, 14),
		Font = Enum.Font.GothamSemibold,
		Text = "Color selector",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 133,
	})

	local colorPickerButton = create("TextButton", {
		Parent = colorPickerFrame,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 10, 0, 26),
		Size = UDim2.new(1, -20, 0, 26),
		Text = "Open Color Selector",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		ZIndex = 133,
	})
	createCorner(colorPickerButton, 8)
	createStroke(colorPickerButton, Constants.THEME.Accent, 1)

	local noteLabel = create("TextLabel", {
		Parent = card,
