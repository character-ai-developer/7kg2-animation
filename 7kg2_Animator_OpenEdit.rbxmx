      <Item class="ModuleScript" referent="RBX118">
        <Properties>
          <string name="Name">BuildInfo</string>
          <ProtectedString name="Source">local BuildInfo = {
	VERSION = "1.0.0-rc1",
	BUILD_ID = "20260814-095322",
	BUILD_TIME = "2026-08-14 09:53:22",
	LABEL = "v1.0.0-rc1 build 20260814-095322",
}

return BuildInfo</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX119">
        <Properties>
          <string name="Name">CameraCinematicPresetService</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local CameraCinematicPresetService = {}

local KNOWN_PRESETS = {
	OrbitShot = true,
	DollyIn = true,
	DollyOut = true,
	HeroReveal = true,
	OverShoulder = true,
	CrashZoom = true,
	FollowCam = true,
}

local function getTargetPart(instance)
	if not instance then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance
	end
	if instance:IsA("Model") then
		return instance.PrimaryPart
			or instance:FindFirstChild("HumanoidRootPart", true)
			or instance:FindFirstChildWhichIsA("BasePart", true)
	end
	return instance:FindFirstAncestorWhichIsA("BasePart")
end

local function getIntensity(options)
	return math.clamp(tonumber(options and (options.intensity or options.explosionAggression)) or 1, 0.1, 5)
end

local function getSmoothness(options)
	return math.clamp(tonumber(options and (options.smoothness or options.handheldSmoothness)) or 1, 0.1, 5)
end

local function parseOffset(value)
	if typeof(value) == "Vector3" then
		return value
	end
	if type(value) ~= "string" or value == "" then
		return Vector3.zero
	end

	local x, y, z = string.match(value, "^%s*([%-%.%d]+)%s*,%s*([%-%.%d]+)%s*,%s*([%-%.%d]+)%s*$")
	if not x then
		return Vector3.zero
	end
	return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
end

local function getBlendedOffset(options, alpha)
	local startOffset = parseOffset(options and options.startOffset)
	local endOffset = parseOffset(options and options.endOffset)
	return startOffset:Lerp(endOffset, math.clamp(tonumber(alpha) or 0, 0, 1))
end

local function applyUserOffset(position, targetCFrame, options, alpha)
	local offset = getBlendedOffset(options, alpha)
	if offset.Magnitude &lt;= 0 then
		return position
	end
	return position + targetCFrame:VectorToWorldSpace(offset)
end

local function getPresetEasing(options, defaultStyle, defaultDirection)
	return tostring(options and options.easingStyle or defaultStyle or Constants.DEFAULT_EASING_STYLE),
		tostring(options and options.easingDirection or defaultDirection or Constants.DEFAULT_EASING_DIRECTION)
end

local function resolveSubject(timeline, selectionService, options)
	local subject = nil
	if options and options.useBoundRig == true and timeline then
		subject = timeline:getRig()
	end
	if not subject and selectionService and selectionService.getFirstSelected then
		subject = selectionService.getFirstSelected()
	end
	if not subject and timeline then
		subject = timeline:getRig()
	end
	if not subject then
		return nil
	end
	if not subject:IsA("Model") and not subject:IsA("BasePart") then
		subject = subject:FindFirstAncestorOfClass("Model") or subject:FindFirstAncestorWhichIsA("BasePart")
	end
	local part = getTargetPart(subject)
	if not part then
		return nil
	end

	local targetTrack = nil
	for _, track in ipairs(timeline:getTracks() or {}) do
		if track.trackType ~= "Camera" and track.targetScope ~= "CameraProperty" then
			if track.instance == subject or track.instance == part then
				targetTrack = track
				break
			end
			if subject:IsA("Model") and track.instance and track.instance:IsDescendantOf(subject) and track.trackType ~= "Rig" then
				targetTrack = track
				break
			end
		end
	end

	return {
		instance = subject,
		part = part,
		track = targetTrack,
	}
end

local function sampleTrackCFrame(timeline, targetTrack, frame)
	if not targetTrack then
		return nil
	end
	local pose = timeline:samplePose(frame)
	local value = pose and pose[targetTrack.path]
	if typeof(value) == "CFrame" then
		return value
	end
	if type(value) == "table" and typeof(value.cframe) == "CFrame" then
		return value.cframe
	end
	return nil
end

local function buildSampleFrames(startFrame, endFrame, sampleCount)
	startFrame = math.max(0, math.floor(tonumber(startFrame) or 0))
	endFrame = math.max(startFrame, math.floor(tonumber(endFrame) or startFrame))
	sampleCount = math.max(2, math.floor(tonumber(sampleCount) or 2))
	if startFrame == endFrame then
		return { startFrame }
	end
	local frames = {}
	for index = 0, sampleCount - 1 do
		local alpha = index / math.max(1, sampleCount - 1)
		local frame = math.floor(startFrame + ((endFrame - startFrame) * alpha) + 0.5)
		if #frames == 0 or frames[#frames] ~= frame then
			table.insert(frames, frame)
		end
	end
	return frames
end

local function getSubjectCFrame(timeline, subject, frame)
	if subject and subject.track then
		local sampled = sampleTrackCFrame(timeline, subject.track, frame)
		if sampled then
			return sampled
		end
	end
	return subject and subject.part and subject.part.CFrame or CFrame.new()
end

local function cameraState(cframe, focusPosition, fieldOfView)
	return {
		cframe = cframe,
		focus = CFrame.new(focusPosition),
		fieldOfView = math.clamp(tonumber(fieldOfView) or 70, 1, 120),
	}
end

local function getHorizontalLook(cframe)
	local look = Vector3.new(cframe.LookVector.X, 0, cframe.LookVector.Z)
	if look.Magnitude &lt; 0.001 then
		return Vector3.new(0, 0, -1)
	end
	return look.Unit
end

local function getAngleDirection(angleMode)
	angleMode = tostring(angleMode or "Auto")
	if angleMode == "Right" then
		return 1
	end
	return -1
end

local function getSideSign(angleMode)
	angleMode = tostring(angleMode or "Auto")
	if angleMode == "Right" then
		return 1
	end
	return -1
end

local function getSubjectFocus(targetCFrame, height)
	return targetCFrame.Position + Vector3.new(0, tonumber(height) or 2.4, 0)
end

local function smoothFocus(previousFocus, focus, options, fallback)
	local smoothing = math.clamp(tonumber(options and options.lookAtSmoothing) or fallback or 0, 0, 0.95)
	if previousFocus then
		return previousFocus:Lerp(focus, 1 - smoothing)
	end
	return focus
end

local function addEntry(entries, frame, value, easingStyle, easingDirection)
	table.insert(entries, {
		frame = math.max(0, math.floor((tonumber(frame) or 0) + 0.5)),
		value = value,
		easingStyle = easingStyle or Constants.DEFAULT_EASING_STYLE,
		easingDirection = easingDirection or Constants.DEFAULT_EASING_DIRECTION,
	})
end

local function addSubtleDrift(position, index, intensity)
	intensity = math.clamp(tonumber(intensity) or 0, 0, 3)
	if intensity &lt;= 0 then
		return position
	end
	local x = math.noise(index * 0.31, 0.19, 2.1) * 0.12 * intensity
	local y = math.noise(index * 0.23, 1.07, 4.9) * 0.08 * intensity
	return position + Vector3.new(x, y, 0)
end

local function buildSubjectFrames(timeline, subject, startFrame, durationFrames, samples)
	local endFrame = startFrame + durationFrames
	local trackFrames = subject and subject.track and timeline:getTrackKeyframeFrames(subject.track.path) or {}
	if type(trackFrames) == "table" and #trackFrames &gt; 1 then
		local firstFrame = math.max(startFrame, trackFrames[1])
		local lastFrame = math.max(firstFrame, trackFrames[#trackFrames])
		endFrame = math.max(endFrame, lastFrame)
	end
	return buildSampleFrames(startFrame, endFrame, samples)
end

local function getSmoothnessAlpha(options)
	return math.clamp((getSmoothness(options) - 0.1) / 4.9, 0, 1)
end

local function getPresetSampleCount(presetId, durationFrames, options)
	durationFrames = math.max(1, math.floor(tonumber(durationFrames) or 1))
	local smoothnessAlpha = getSmoothnessAlpha(options)
	local minSamples = 6
	local maxSamples = math.clamp(math.floor(durationFrames / 5) + 1, minSamples, 28)

	if presetId == "OrbitShot" then
		minSamples = 9
		maxSamples = math.clamp(math.floor(durationFrames / 2) + 1, minSamples, 90)
	elseif presetId == "FollowCam" then
		minSamples = 8
		maxSamples = math.clamp(math.floor(durationFrames / 3) + 1, minSamples, 56)
	elseif presetId == "HeroReveal" then
		minSamples = 8
		maxSamples = math.clamp(math.floor(durationFrames / 4) + 1, minSamples, 42)
	elseif presetId == "CrashZoom" then
		minSamples = 4
		maxSamples = math.clamp(math.floor(durationFrames / 2) + 1, minSamples, 12)
	end

	return math.clamp(math.floor(minSamples + ((maxSamples - minSamples) * smoothnessAlpha) + 0.5), minSamples, maxSamples)
end

local function buildOrbitShot(deps, subject, frames, options)
	local entries = {}
	local orbitDegrees = tonumber(options.orbitAngle) or (tostring(options.followAngle or "Auto") == "Above" and 360 or 180)
	orbitDegrees = math.clamp(orbitDegrees, 1, 360)
	local direction = tostring(options.orbitDirection or "Clockwise") == "Counterclockwise" and -1 or 1
	local radius = (tonumber(options.radius) or 10) * math.clamp(getIntensity(options), 0.5, 2.5)
	local heightOffset = tonumber(options.heightOffset) or 2
	local fov = tonumber(options.fovOverride) or 50
	local smoothness = getSmoothness(options)
	local easingStyle, easingDirection = getPresetEasing(options, "Sine", "InOut")
	local previousFocus = nil
	for index, frame in ipairs(frames) do
		local alpha = (index - 1) / math.max(1, #frames - 1)
		local targetCFrame = getSubjectCFrame(deps.timeline, subject, frame)
		local focus = smoothFocus(previousFocus, getSubjectFocus(targetCFrame, 2.25), options, 0.15)
		previousFocus = focus
		local forward = getHorizontalLook(targetCFrame)
		local startOffset = (-forward * radius) + Vector3.new(0, heightOffset, 0)
		local angle = math.rad((orbitDegrees * alpha - orbitDegrees * 0.5) * direction)
		local offset = CFrame.Angles(0, angle, 0):VectorToWorldSpace(startOffset)
		local position = addSubtleDrift(focus + offset, index, smoothness &lt;= 0.75 and 0.3 or 0)
		position = applyUserOffset(position, targetCFrame, options, alpha)
		addEntry(entries, frame, cameraState(CFrame.lookAt(position, focus), focus, fov), easingStyle, easingDirection)
	end
	return entries, string.format("Added Orbit Shot around %s.", subject.instance.Name)
end

local function buildDolly(deps, subject, frames, options, isOut)
	local entries = {}
	local distanceScale = math.clamp(getIntensity(options), 0.5, 2.5)
	local farDistance = 18 * distanceScale
	local nearDistance = 7 * distanceScale
	local tightFov = math.clamp(tonumber(options.fovOverride) or 42, 10, 90)
	local wideFov = math.deg(2 * math.atan((farDistance / nearDistance) * math.tan(math.rad(tightFov) * 0.5)))
	wideFov = math.clamp(wideFov, tightFov + 5, 110)
	local startDistance = isOut and nearDistance or farDistance
	local endDistance = isOut and farDistance or nearDistance
	local startFov = isOut and wideFov or tightFov
	local endFov = isOut and tightFov or wideFov
	local side = getSideSign(options.followAngle) * 0.8
	local heightOffset = tonumber(options.heightOffset) or 2.7
	local easingStyle, easingDirection = getPresetEasing(options, "Quad", "Out")
	local previousFocus = nil
	for index, frame in ipairs(frames) do
		local alpha = (index - 1) / math.max(1, #frames - 1)
		local targetCFrame = getSubjectCFrame(deps.timeline, subject, frame)
		local focus = smoothFocus(previousFocus, getSubjectFocus(targetCFrame, 2.3), options, 0.15)
		previousFocus = focus
		local forward = getHorizontalLook(targetCFrame)
		local right = targetCFrame.RightVector.Magnitude &gt; 0 and targetCFrame.RightVector.Unit or Vector3.new(1, 0, 0)
		local distance = startDistance + ((endDistance - startDistance) * alpha)
		local fov = startFov + ((endFov - startFov) * alpha)
		local height = heightOffset + ((isOut and 1.2 or -0.4) * alpha)
		local position = focus - (forward * distance) + (right * side) + Vector3.new(0, height, 0)
		position = applyUserOffset(position, targetCFrame, options, alpha)
		addEntry(entries, frame, cameraState(CFrame.lookAt(position, focus), focus, fov), easingStyle, easingDirection)
	end
	return entries, string.format("Added %s dolly zoom for %s.", isOut and "reverse" or "forward", subject.instance.Name)
end

local function buildHeroReveal(deps, subject, frames, options)
	local entries = {}
	local fov = tonumber(options.fovOverride) or 40
	local side = getSideSign(options.followAngle)
	local intensity = getIntensity(options)
	local heightOffset = tonumber(options.heightOffset) or 4.1
	local easingStyle, easingDirection = getPresetEasing(options, "Cubic", "Out")
	local previousFocus = nil
	for index, frame in ipairs(frames) do
		local alpha = (index - 1) / math.max(1, #frames - 1)
		local targetCFrame = getSubjectCFrame(deps.timeline, subject, frame)
		local focus = smoothFocus(previousFocus, getSubjectFocus(targetCFrame, 2.8), options, 0.15)
		previousFocus = focus
		local forward = getHorizontalLook(targetCFrame)
		local right = targetCFrame.RightVector.Magnitude &gt; 0 and targetCFrame.RightVector.Unit or Vector3.new(1, 0, 0)
		local height = 0.4 + (heightOffset * alpha * math.clamp(intensity, 0.6, 1.7))
		local distance = 10 - (2.5 * alpha)
		local orbitShift = math.sin(alpha * math.pi) * 2.2 * side * math.clamp(intensity, 0.5, 2)
		local position = focus - (forward * distance) + (right * orbitShift) + Vector3.new(0, height, 0)
		if alpha &gt; 0.88 then
			position = addSubtleDrift(position, index, 0.25 * intensity)
		end
		position = applyUserOffset(position, targetCFrame, options, alpha)
		addEntry(entries, frame, cameraState(CFrame.lookAt(position, focus), focus, fov), easingStyle, easingDirection)
	end
	return entries, string.format("Added Hero Reveal for %s.", subject.instance.Name)
end

local function buildOverShoulder(deps, subject, frames, options)
	local entries = {}
	local fov = tonumber(options.fovOverride) or 55
	local side = getSideSign(options.followAngle)
	local intensity = getIntensity(options)
	local heightOffset = tonumber(options.heightOffset) or 2.5
	local easingStyle, easingDirection = getPresetEasing(options, "Sine", "InOut")
	local previousFocus = nil
	for index, frame in ipairs(frames) do
		local alpha = (index - 1) / math.max(1, #frames - 1)
		local targetCFrame = getSubjectCFrame(deps.timeline, subject, frame)
		local focus = smoothFocus(previousFocus, getSubjectFocus(targetCFrame, 2.5), options, 0.15)
		previousFocus = focus
		local forward = getHorizontalLook(targetCFrame)
		local right = targetCFrame.RightVector.Magnitude &gt; 0 and targetCFrame.RightVector.Unit or Vector3.new(1, 0, 0)
		local sway = math.sin(alpha * math.pi * 2) * 0.12 * intensity
		local position = focus - (forward * (5 * math.clamp(intensity, 0.7, 1.8))) + (right * (2 * side + sway)) + Vector3.new(0, heightOffset, 0)
		position = applyUserOffset(position, targetCFrame, options, alpha)
		addEntry(entries, frame, cameraState(CFrame.lookAt(position, focus + forward * 2), focus, fov), easingStyle, easingDirection)
	end
	return entries, string.format("Added Over-the-Shoulder shot for %s.", subject.instance.Name)
end

local function buildCrashZoom(deps, subject, frames, options)
	local entries = {}
	local base = deps.base
	local focus = base.focus and base.focus.Position or (base.cframe.Position + base.cframe.LookVector * 16)
	local targetCFrameForOffset = base.cframe
	if subject then
		targetCFrameForOffset = getSubjectCFrame(deps.timeline, subject, deps.startFrame)
		focus = getSubjectFocus(targetCFrameForOffset, 2.3)
	end
	local startPosition = base.cframe.Position
	local direction = (focus - startPosition)
	if direction.Magnitude &lt; 0.001 then
		direction = base.cframe.LookVector
	else
		direction = direction.Unit
	end
	local intensity = math.clamp(getIntensity(options), 0.5, 4)
	local fovOverride = tonumber(options.fovOverride)
	local startFov = fovOverride and math.min(120, fovOverride + 45) or 70
	local endFov = fovOverride or 25
	local easingStyle, easingDirection = getPresetEasing(options, "Exponential", "Out")
	for index, frame in ipairs(frames) do
		local alpha = (index - 1) / math.max(1, #frames - 1)
		local fov = startFov + ((endFov - startFov) * alpha)
		local shake = alpha &gt; 0.65 and Vector3.new(math.noise(index, 0, 0), math.noise(0, index, 0), 0) * 0.22 * intensity or Vector3.zero
		local position = startPosition + (direction * (2.5 * alpha * intensity)) + shake
		position = applyUserOffset(position, targetCFrameForOffset, options, alpha)
		addEntry(entries, frame, cameraState(CFrame.lookAt(position, focus), focus, fov), easingStyle, easingDirection)
	end
	return entries, subject and string.format("Added Crash Zoom on %s.", subject.instance.Name) or "Added Crash Zoom."
end

local function buildFollowCam(deps, subject, frames, options)
	local entries = {}
	local fov = tonumber(options.fovOverride) or 60
	local lastTargetPosition = nil
	local intensity = math.clamp(getIntensity(options), 0.5, 2.5)
	local smoothness = getSmoothness(options)
	local heightOffset = tonumber(options.heightOffset) or 3
	local easingStyle, easingDirection = getPresetEasing(options, "Sine", "InOut")
	local previousLookAhead = nil
	for index, frame in ipairs(frames) do
		local alpha = (index - 1) / math.max(1, #frames - 1)
		local targetCFrame = getSubjectCFrame(deps.timeline, subject, frame)
		local focus = getSubjectFocus(targetCFrame, 2.6)
		local forward = getHorizontalLook(targetCFrame)
		local movement = lastTargetPosition and (targetCFrame.Position - lastTargetPosition) or forward
		if movement.Magnitude &gt; 0.2 then
			forward = Vector3.new(movement.X, 0, movement.Z).Magnitude &gt; 0.001 and Vector3.new(movement.X, 0, movement.Z).Unit or forward
		end
		lastTargetPosition = targetCFrame.Position
		local angleMode = tostring(options.followAngle or "Auto")
		local side = angleMode == "Left" and -2.4 or (angleMode == "Right" and 2.4 or 0)
		local right = targetCFrame.RightVector.Magnitude &gt; 0 and targetCFrame.RightVector.Unit or Vector3.new(1, 0, 0)
		if angleMode == "Auto" then
			side = math.sin(alpha * math.pi * 2) * 1.2
		end
		local lookAhead = focus + (forward * 4)
		local distance = 8 * intensity
		local height = heightOffset
		if angleMode == "Above" then
			height = math.max(heightOffset, 7)
			distance = 6
		elseif angleMode == "Front" then
			distance = -6 * intensity
		elseif angleMode == "Behind" then
			side = 0
		end
		local dampedLookAhead = focus:Lerp(lookAhead, math.clamp(1 / smoothness, 0.2, 1))
		dampedLookAhead = smoothFocus(previousLookAhead, dampedLookAhead, options, 0.12)
		previousLookAhead = dampedLookAhead
		local position = focus - (forward * distance) + (right * side) + Vector3.new(0, height, 0)
		position = applyUserOffset(position, targetCFrame, options, alpha)
		addEntry(entries, frame, cameraState(CFrame.lookAt(position, dampedLookAhead), dampedLookAhead, fov), easingStyle, easingDirection)
	end
	return entries, string.format("Added Follow Cam for %s.", subject.instance.Name)
end

function CameraCinematicPresetService.buildPresetEntries(deps, presetId)
	if not KNOWN_PRESETS[presetId] then
		return nil, nil
	end

	local timeline = deps and deps.timeline
	local base = deps and deps.base
	if not timeline or not base then
		return nil, "Camera preset setup is missing timeline data."
	end

	local options = deps.options or {}
	local fps = timeline:getFps()
	local startFrame = math.max(0, math.floor(tonumber(deps.startFrame) or timeline:getCurrentFrame()))
	local durationScale = math.clamp(tonumber(options.durationScale) or 1, 0.25, 8)
	local explicitDurationSeconds = tonumber(options.durationSeconds)
	local durationSecondsByPreset = {
		OrbitShot = 3.5,
		DollyIn = 2.5,
		DollyOut = 3,
		HeroReveal = 4,
		OverShoulder = 2.5,
		CrashZoom = 0.35,
		FollowCam = 3,
	}
	local durationSeconds = (explicitDurationSeconds and explicitDurationSeconds &gt; 0)
		and explicitDurationSeconds
		or (durationSecondsByPreset[presetId] or 2)
	local durationFrames = math.max(1, math.floor((durationSeconds * durationScale * fps) + 0.5))
	local subject = resolveSubject(timeline, deps.selectionService, options)
	if presetId ~= "CrashZoom" and not subject then
		return nil, "Select a rig, model, or part in Studio before using that camera preset."
	end
	if subject and options.subjectTracking == false then
		subject = {
			instance = subject.instance,
			part = subject.part,
			track = nil,
		}
	end

	local sampleCount = getPresetSampleCount(presetId, durationFrames, options)
	local shouldExtendToSubjectMotion = subject and subject.track and not explicitDurationSeconds and options.subjectTracking ~= false
	local frames = shouldExtendToSubjectMotion and buildSubjectFrames(timeline, subject, startFrame, durationFrames, sampleCount)
		or buildSampleFrames(startFrame, startFrame + durationFrames, sampleCount)

	if presetId == "OrbitShot" then
		return buildOrbitShot(deps, subject, frames, options)
	elseif presetId == "DollyIn" then
		return buildDolly(deps, subject, frames, options, false)
	elseif presetId == "DollyOut" then
		return buildDolly(deps, subject, frames, options, true)
	elseif presetId == "HeroReveal" then
		return buildHeroReveal(deps, subject, frames, options)
	elseif presetId == "OverShoulder" then
		return buildOverShoulder(deps, subject, frames, options)
	elseif presetId == "CrashZoom" then
		return buildCrashZoom(deps, subject, frames, options)
	elseif presetId == "FollowCam" then
		return buildFollowCam(deps, subject, frames, options)
	end

	return nil, nil
end

return CameraCinematicPresetService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX120">
        <Properties>
          <string name="Name">CameraGuideService</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local CameraGuideService = {}

local SCREEN_GUI_NAME = "MegMoCameraGuideOverlay"
local GUIDE_COLOR = Color3.fromRGB(126, 86, 255)
local GUIDE_TEXT_COLOR = Color3.fromRGB(238, 244, 255)
local DIM_COLOR = Color3.fromRGB(4, 8, 18)
local MODES = {
	{ id = "Off", label = "Off" },
	{ id = "Shorts", label = "9:16 Shorts", ratio = 9 / 16 },
	{ id = "Square", label = "1:1 Square", ratio = 1 },
}

local currentModeIndex = 1
local gui = nil
local guideFrame = nil
local dimFrames = nil
local label = nil
local viewportConnection = nil
local lastViewportSize = nil

local function create(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function getViewportSize()
	local camera = workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		if size.X &gt; 0 and size.Y &gt; 0 then
			return size
		end
	end
	return Vector2.new(1920, 1080)
end

local function disconnectViewport()
	if viewportConnection then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end
end

local function ensureGui()
	if gui and gui.Parent then
		return gui
	end

	local existing = CoreGui:FindFirstChild(SCREEN_GUI_NAME)
	if existing then
		existing:Destroy()
	end

	gui = create("ScreenGui", {
		Name = SCREEN_GUI_NAME,
		DisplayOrder = 45000,
		Enabled = false,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, CoreGui)

	dimFrames = {
		Top = create("Frame", {
			Name = "TopDim",
			Active = false,
			BackgroundColor3 = DIM_COLOR,
			BackgroundTransparency = 0.68,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, gui),
		Bottom = create("Frame", {
			Name = "BottomDim",
			Active = false,
			BackgroundColor3 = DIM_COLOR,
			BackgroundTransparency = 0.68,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, gui),
		Left = create("Frame", {
			Name = "LeftDim",
			Active = false,
			BackgroundColor3 = DIM_COLOR,
			BackgroundTransparency = 0.68,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, gui),
		Right = create("Frame", {
			Name = "RightDim",
			Active = false,
			BackgroundColor3 = DIM_COLOR,
			BackgroundTransparency = 0.68,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, gui),
	}

	guideFrame = create("Frame", {
		Name = "GuideFrame",
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, gui)
	create("UIStroke", {
		Name = "GuideStroke",
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = GUIDE_COLOR,
		Thickness = 2,
		Transparency = 0.02,
	}, guideFrame)
	for index = 1, 2 do
		create("Frame", {
			Name = "VerticalThird" .. index,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = GUIDE_COLOR,
			BackgroundTransparency = 0.46,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(index / 3, 0),
			Size = UDim2.new(0, 1, 1, 0),
			ZIndex = 3,
		}, guideFrame)
		create("Frame", {
			Name = "HorizontalThird" .. index,
			Active = false,
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = GUIDE_COLOR,
			BackgroundTransparency = 0.46,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, index / 3),
			Size = UDim2.new(1, 0, 0, 1),
			ZIndex = 3,
		}, guideFrame)
	end

	label = create("TextLabel", {
		Name = "GuideLabel",
		Active = false,
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.fromRGB(20, 24, 36),
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(160, 28),
		TextColor3 = GUIDE_TEXT_COLOR,
		TextSize = 13,
		ZIndex = 4,
	}, guideFrame)
	create("UICorner", {
		CornerRadius = UDim.new(0, 9),
	}, label)
	create("UIStroke", {
		Color = GUIDE_COLOR,
		Thickness = 1,
		Transparency = 0.25,
	}, label)

	return gui
end

local function layout(mode)
	local overlay = ensureGui()
	local viewport = getViewportSize()
	lastViewportSize = viewport
	local width = viewport.X
	local height = viewport.Y
	local viewportRatio = width / math.max(1, height)
	local targetRatio = mode.ratio or 1
	local guideWidth
	local guideHeight

	if viewportRatio &gt; targetRatio then
		guideHeight = height
		guideWidth = guideHeight * targetRatio
	else
		guideWidth = width
		guideHeight = guideWidth / targetRatio
	end

	local left = math.floor((width - guideWidth) * 0.5 + 0.5)
	local top = math.floor((height - guideHeight) * 0.5 + 0.5)
	local right = math.max(0, width - left - guideWidth)
	local bottom = math.max(0, height - top - guideHeight)

	guideFrame.Position = UDim2.fromOffset(math.floor(width * 0.5), math.floor(height * 0.5))
	guideFrame.Size = UDim2.fromOffset(math.floor(guideWidth + 0.5), math.floor(guideHeight + 0.5))
	label.Text = mode.label
	label.Position = UDim2.new(0.5, 0, 0, -8)

	dimFrames.Top.Position = UDim2.fromOffset(0, 0)
	dimFrames.Top.Size = UDim2.fromOffset(width, top)
	dimFrames.Bottom.Position = UDim2.fromOffset(0, top + guideHeight)
	dimFrames.Bottom.Size = UDim2.fromOffset(width, bottom)
	dimFrames.Left.Position = UDim2.fromOffset(0, top)
	dimFrames.Left.Size = UDim2.fromOffset(left, guideHeight)
	dimFrames.Right.Position = UDim2.fromOffset(left + guideWidth, top)
	dimFrames.Right.Size = UDim2.fromOffset(right, guideHeight)

	overlay.Enabled = true
end

local function watchViewport()
	disconnectViewport()
	viewportConnection = RunService.RenderStepped:Connect(function()
		local mode = MODES[currentModeIndex]
		if not mode or not mode.ratio then
			disconnectViewport()
			return
		end
		local viewport = getViewportSize()
		if not lastViewportSize or viewport ~= lastViewportSize then
			layout(mode)
		end
	end)
end

function CameraGuideService.setMode(modeId)
	local selectedIndex = 1
	for index, mode in ipairs(MODES) do
		if mode.id == modeId then
			selectedIndex = index
			break
		end
	end

	currentModeIndex = selectedIndex
	local mode = MODES[currentModeIndex]
	if mode.ratio then
		layout(mode)
		watchViewport()
	else
		disconnectViewport()
		if gui then
			gui.Enabled = false
		end
	end
	return mode.id, mode.label
end

function CameraGuideService.cycle()
	currentModeIndex += 1
	if currentModeIndex &gt; #MODES then
		currentModeIndex = 1
	end
	local mode = MODES[currentModeIndex]
	return CameraGuideService.setMode(mode.id)
end

function CameraGuideService.getMode()
	local mode = MODES[currentModeIndex] or MODES[1]
	return mode.id, mode.label
end

function CameraGuideService.clear()
	return CameraGuideService.setMode("Off")
end

return CameraGuideService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX121">
        <Properties>
          <string name="Name">CameraTrackService</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local CameraCinematicPresetService = require(script.Parent:WaitForChild("CameraCinematicPresetService"))
local RigService = require(script.Parent:WaitForChild("RigService"))
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local CameraTrackService = {}
local firstPersonSessions = {}
local previewToken = 0

local function normalizeFieldOfView(value, fallback)
	return math.clamp(tonumber(value) or tonumber(fallback) or 70, 1, 120)
end

local function easingEnum(enumType, name, fallback)
	local success, value = pcall(function()
		return enumType[name]
	end)
	return success and value or enumType[fallback]
end

local function easeAlpha(alpha, easingStyle, easingDirection)
	alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
	easingStyle = tostring(easingStyle or Constants.DEFAULT_EASING_STYLE)
	if easingStyle == "None" then
		return alpha &gt;= 1 and 1 or 0
	end
	if easingStyle == "Sextic" then
		local direction = tostring(easingDirection or Constants.DEFAULT_EASING_DIRECTION)
		if direction == "In" then
			return alpha ^ 6
		elseif direction == "Out" then
			return 1 - ((1 - alpha) ^ 6)
		end
		return alpha &lt; 0.5 and (0.5 * ((alpha * 2) ^ 6)) or (1 - (0.5 * (((1 - alpha) * 2) ^ 6)))
	end

	local style = easingEnum(Enum.EasingStyle, easingStyle, Constants.DEFAULT_EASING_STYLE)
	local direction = easingEnum(Enum.EasingDirection, easingDirection or Constants.DEFAULT_EASING_DIRECTION, Constants.DEFAULT_EASING_DIRECTION)
	local success, eased = pcall(function()
		return TweenService:GetValue(alpha, style, direction)
	end)
	return success and eased or alpha
end

local function getFirstPersonSessionForTrack(trackPath)
	local session = firstPersonSessions[trackPath]
	if session then
		return session, trackPath
	end

	local fallbackSession = nil
	local fallbackPath = nil
	local count = 0
	for path, candidate in pairs(firstPersonSessions) do
		count += 1
		fallbackPath = path
		fallbackSession = candidate
	end
	if count == 1 then
		return fallbackSession, fallbackPath
	end

	return nil, nil
end

local function clearPartAttachSessions()
	local clearedCount = 0
	for path, session in pairs(firstPersonSessions) do
		if session and session.kind == "PartAttach" then
			firstPersonSessions[path] = nil
			clearedCount += 1
		end
	end
	return clearedCount
end

function CameraTrackService.isCameraTrack(track)
	return track and track.trackType == "Camera"
end

function CameraTrackService.isCameraPropertyTrack(track)
	return track and track.targetScope == "CameraProperty"
end

function CameraTrackService.getPrimaryCameraTrack(timeline, track)
	if CameraTrackService.isCameraTrack(track) then
		return track
	end
	if timeline then
		for _, existingTrack in ipairs(timeline:getTracks() or {}) do
			if CameraTrackService.isCameraTrack(existingTrack) then
				return existingTrack
			end
		end
	end
	return nil
end

function CameraTrackService.getCameraForTrack(track)
	local camera = workspace.CurrentCamera
	if not camera then
		local instance = track and track.instance
		if instance and instance.Parent and instance:IsA("Camera") then
			camera = instance
		end
	end
	return camera
end

function CameraTrackService.captureStudioCameraValue(track)
	local camera = CameraTrackService.getCameraForTrack(track)
	if not camera then
		return nil
	end

	return {
		cframe = camera.CFrame,
		focus = camera.Focus,
		fieldOfView = camera.FieldOfView,
	}
end

function CameraTrackService.getSelectedCameraState(track)
	local camera = CameraTrackService.getCameraForTrack(track)
	if not (CameraTrackService.isCameraTrack(track) or CameraTrackService.isCameraPropertyTrack(track)) or not camera then
		return nil
	end

	local focusPosition = camera.Focus.Position
	return {
		fieldOfView = camera.FieldOfView,
		focusDistance = (focusPosition - camera.CFrame.Position).Magnitude,
	}
end

function CameraTrackService.getFovTrack(timeline)
	for _, track in ipairs(timeline:getTracks() or {}) do
		if CameraTrackService.isCameraPropertyTrack(track) and track.propertyName == "FieldOfView" then
			return track
		end
	end
	return nil
end

function CameraTrackService.ensureFovTrack(timeline)
	local existing = CameraTrackService.getFovTrack(timeline)
	if existing then
		return existing, false, "Selected the existing Camera FOV track."
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return nil, false, "Studio does not have an active camera yet."
	end

	local track = timeline:addGenericTrack("CameraProperty", camera, "FOV", {
		propertyName = "FieldOfView",
		targetScope = "CameraProperty",
		sortOrder = 6,
		parentTrackType = "Camera",
	})
	return track, true, "Added Camera FOV track."
end

local function getTimelineFovAtFrame(timeline, frame)
	if not timeline then
		return nil
	end

	local fovTrack = CameraTrackService.getFovTrack(timeline)
	if not fovTrack then
		return nil
	end

	local pose = timeline:samplePose(frame)
	local value = pose and pose[fovTrack.path]
	if type(value) == "number" then
		return normalizeFieldOfView(value)
	end
	return nil
end

local function getTargetPart(instance)
	if not instance then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance
	end
	if instance:IsA("Model") then
		return instance.PrimaryPart
			or instance:FindFirstChild("HumanoidRootPart", true)
			or instance:FindFirstChildWhichIsA("BasePart", true)
	end
	return instance:FindFirstAncestorWhichIsA("BasePart")
end

local function getFollowTrackTarget(track)
	local instance = track and track.instance
	if not instance then
		return nil
	end
	if instance:IsA("Motor6D") then
		return instance.Part1 or instance.Part0
	end
	if instance:IsA("Bone") then
		return instance
	end
	return getTargetPart(instance) or instance
end

local function getFollowTrackScore(track)
	local target = getFollowTrackTarget(track)
	local name = target and target.Name or track and track.name or ""
	if track and track.targetScope == "RigProperty" and track.propertyName == "CFrame" then
		return 70
	end
	if name == "UpperTorso" or name == "Torso" then
		return 100
	elseif name == "LowerTorso" then
		return 94
	elseif name == "Head" then
		return 76
	elseif name == "HumanoidRootPart" or name == "RootPart" then
		return 72
	elseif string.find(name, "Hand") or string.find(name, "Foot") or string.find(name, "Finger") or string.find(name, "Toe") then
		return 18
	elseif string.find(name, "Arm") or string.find(name, "Leg") then
		return 32
	end
	return 45
end

local function chooseAnimatedFollowTrack(timeline, subject)
	local bestTrack = nil
	local bestScore = -math.huge
	for _, track in ipairs(timeline and timeline:getTracks() or {}) do
		if track.trackType == "Camera" or track.targetScope == "CameraProperty" or track.disabled == true then
			continue
		end
		local instance = track.instance
		local matches = instance == subject
			or (instance and subject and instance:IsDescendantOf(subject))
			or (track.rigName and subject and track.rigName == subject.Name)
		if matches and #(timeline:getTrackKeyframeFrames(track.path) or {}) &gt; 0 then
			local score = getFollowTrackScore(track)
			if score &gt; bestScore then
				bestScore = score
				bestTrack = track
			end
		end
	end
	return bestTrack
end

local function resolveFollowTarget(timeline, selectionService, options)
	local useBoundRig = options.useBoundRig == true
	local selected = useBoundRig and timeline:getRig()
		or (selectionService and selectionService.getFirstSelected and selectionService.getFirstSelected() or nil)
	if not selected then
		return nil
	end

	local subject = selected
	if not subject:IsA("Model") and not subject:IsA("BasePart") then
		subject = selected:FindFirstAncestorOfClass("Model") or selected:FindFirstAncestorWhichIsA("BasePart")
	end
	if not subject then
		return nil
	end

	local targetPart = getTargetPart(subject)
	local targetTrack = nil
	if subject:IsA("Model") and timeline and type(timeline.getRigPropertyTrack) == "function" then
		targetTrack = timeline:getRigPropertyTrack(subject.Name, "CFrame")
		local animatedTrack = chooseAnimatedFollowTrack(timeline, subject)
		if animatedTrack then
			targetTrack = animatedTrack
			local trackTarget = getFollowTrackTarget(animatedTrack)
			if trackTarget and trackTarget:IsA("BasePart") then
				targetPart = trackTarget
			end
		end
	end
	for _, track in ipairs(timeline:getTracks() or {}) do
		if targetTrack then
			break
		end
		if track.trackType ~= "Camera" and track.targetScope ~= "CameraProperty" then
			local trackTarget = getFollowTrackTarget(track)
			if track.instance == subject or track.instance == targetPart then
				targetTrack = track
				break
			end
			if trackTarget and targetPart and trackTarget == targetPart then
				targetTrack = track
				break
			end
			if subject:IsA("Model") and track.instance and track.instance:IsDescendantOf(subject) and track.trackType ~= "Rig" then
				targetTrack = track
				break
			end
		end
	end

	return {
		instance = subject,
		part = targetPart,
		track = targetTrack,
	}
end

local function getTrackSampleCFrame(timeline, targetTrack, sampleFrame)
	if not targetTrack then
		return nil
	end

	local pose = timeline:samplePose(sampleFrame)
	local value = pose and pose[targetTrack.path] or nil
	if typeof(value) == "CFrame" then
		return value
	end
	if type(value) == "table" and typeof(value.cframe) == "CFrame" then
		return value.cframe
	end
	return nil
end

local function readFollowTargetWorldCFrame(target)
	if not target then
		return nil
	end
	local trackTarget = getFollowTrackTarget(target.track)
	if trackTarget then
		if trackTarget:IsA("BasePart") then
			return trackTarget.CFrame
		elseif trackTarget:IsA("Bone") then
			return RigService.getJointWorldCFrame({
				instance = trackTarget,
				jointType = "Bone",
				isBone = true,
			})
		end
	end
	if target.part and target.part.Parent then
		return target.part.CFrame
	end
	if target.instance and target.instance:IsA("Model") then
		return target.instance:GetPivot()
	end
	return nil
end

local function needsTimelineWorldSampling(track)
	if not track then
		return false
	end
	if track.targetScope == "RigProperty" and track.propertyName == "CFrame" then
		return false
	end
	if track.targetScope == "ObjectProperty" and track.propertyName == "CFrame" then
		return false
	end
	return track.trackType == "Rig" or track.jointType ~= nil or track.isBone == true
end

local function sampleFollowTargetCFrame(timeline, target, frame)
	local shouldApplyTimeline = target
		and timeline
		and type(timeline.applyFrame) == "function"
		and (target.part ~= nil or needsTimelineWorldSampling(target.track) or target.track == nil)
	if shouldApplyTimeline then
		local applied = timeline:applyFrame(frame)
		if applied then
			return readFollowTargetWorldCFrame(target)
		end
	end
	return getTrackSampleCFrame(timeline, target and target.track, frame) or readFollowTargetWorldCFrame(target)
end

local function restoreTimelineAfterSampling(timeline, frame, cameraState)
	if timeline and type(timeline.applyFrame) == "function" then
		pcall(function()
			timeline:applyFrame(frame)
		end)
	end
	local camera = workspace.CurrentCamera
	if camera and cameraState then
		camera.CFrame = cameraState.cframe
		camera.Focus = cameraState.focus
		camera.FieldOfView = cameraState.fieldOfView
	end
end

local function buildSampleFrames(startFrame, endFrame, step)
	local frames = {}
	startFrame = math.max(0, tonumber(startFrame) or 0)
	endFrame = math.max(startFrame, tonumber(endFrame) or startFrame)
	step = math.max(1, math.floor(tonumber(step) or 1))
	local frame = startFrame
	while frame &lt; endFrame do
		table.insert(frames, frame)
		frame += step
	end
	if #frames == 0 or frames[#frames] ~= endFrame then
		table.insert(frames, endFrame)
	end
	return frames
end

local function buildSparseSampleFrames(startFrame, endFrame, sampleCount)
	startFrame = math.max(0, tonumber(startFrame) or 0)
	endFrame = math.max(startFrame, tonumber(endFrame) or startFrame)
	sampleCount = math.max(2, math.floor(tonumber(sampleCount) or 2))
	if endFrame &lt;= startFrame then
		return { startFrame }
	end

	local frames = {}
	for index = 0, sampleCount - 1 do
		local alpha = index / math.max(1, sampleCount - 1)
		local frame = math.floor(startFrame + ((endFrame - startFrame) * alpha) + 0.5)
		if #frames == 0 or frames[#frames] ~= frame then
			table.insert(frames, frame)
		end
	end
	return frames
end

local function smoothVector(previous, current, blendAlpha)
	if typeof(previous) ~= "Vector3" then
		return current
	end
	blendAlpha = math.clamp(tonumber(blendAlpha) or 1, 0, 1)
	return previous:Lerp(current, blendAlpha)
end

local function addUniqueSampleFrame(frames, seen, frame, startFrame, endFrame)
	frame = math.max(0, math.floor((tonumber(frame) or 0) + 0.5))
	if frame &lt; startFrame or frame &gt; endFrame or seen[frame] then
		return
	end
	seen[frame] = true
	table.insert(frames, frame)
end

local function getFollowTransitionSpacingFrames(fps, followStyle, options)
	local smoothness = math.clamp(tonumber(options and (options.smoothness or options.handheldSmoothness)) or 3, 0.1, 5)
	local smoothAlpha = math.clamp((smoothness - 0.1) / 4.9, 0, 1)
	local baseSeconds = tostring(followStyle or "Regular") == "Cinematic" and 0.24 or 0.18
	local extraSeconds = tostring(followStyle or "Regular") == "Cinematic" and 0.12 or 0.10
	return math.max(2, math.floor((math.max(1, tonumber(fps) or Constants.DEFAULT_FPS) * (baseSeconds + extraSeconds * smoothAlpha)) + 0.5))
end

local function addFollowTargetSampleFrames(frames, seen, targetFrames, startFrame, endFrame, fps, followStyle, options)
	local sortedTargetFrames = {}
	for _, frame in ipairs(targetFrames or {}) do
		local rounded = math.max(0, math.floor((tonumber(frame) or 0) + 0.5))
		if rounded &gt;= startFrame and rounded &lt;= endFrame then
			table.insert(sortedTargetFrames, rounded)
		end
	end
	table.sort(sortedTargetFrames)

	local minSpacingFrames = getFollowTransitionSpacingFrames(fps, followStyle, options)
	local lastKeptFrame = nil
	for _, frame in ipairs(sortedTargetFrames) do
		local isBoundary = frame == startFrame or frame == endFrame
		if isBoundary or not lastKeptFrame or (frame - lastKeptFrame) &gt;= minSpacingFrames then
			addUniqueSampleFrame(frames, seen, frame, startFrame, endFrame)
			lastKeptFrame = frame
		end
	end
end

local function buildFollowSampleFrames(startFrame, endFrame, targetFrames, fps, followStyle, options)
	startFrame = math.max(0, math.floor((tonumber(startFrame) or 0) + 0.5))
	endFrame = math.max(startFrame, math.floor((tonumber(endFrame) or startFrame) + 0.5))
	fps = math.max(1, tonumber(fps) or Constants.DEFAULT_FPS)

	local frames = {}
	local seen = {}
	addUniqueSampleFrame(frames, seen, startFrame, startFrame, endFrame)
	addUniqueSampleFrame(frames, seen, endFrame, startFrame, endFrame)

	local sampleEverySeconds = tostring(followStyle or "Regular") == "Cinematic" and 0.9 or 0.7
	local step = math.max(1, math.floor((fps * sampleEverySeconds) + 0.5))
	local frame = startFrame + step
	while frame &lt; endFrame do
		addUniqueSampleFrame(frames, seen, frame, startFrame, endFrame)
		frame += step
	end

	table.sort(frames)

	local maxSamples = tostring(followStyle or "Regular") == "Cinematic" and 18 or 24
	if #frames &lt;= maxSamples then
		return frames
	end

	local reduced = {}
	local reducedSeen = {}
	for _, frameValue in ipairs(buildSparseSampleFrames(startFrame, endFrame, maxSamples)) do
		addUniqueSampleFrame(reduced, reducedSeen, frameValue, startFrame, endFrame)
	end
	table.sort(reduced)
	return reduced
end

local function getFollowTargetSmoothingPasses(options, followStyle)
	local smoothness = math.clamp(tonumber(options and (options.smoothness or options.handheldSmoothness)) or 3, 0.1, 5)
	local basePasses = tostring(followStyle or "Regular") == "Cinematic" and 3 or 2
	return math.clamp(basePasses + math.floor((smoothness - 1) / 2), 1, 4)
end

local function smoothFollowPositions(samples, options, followStyle)
	local positions = {}
	for index, sample in ipairs(samples or {}) do
		positions[index] = sample.cframe and sample.cframe.Position or Vector3.zero
	end
	local count = #positions
	if count &lt;= 2 then
		return positions
	end

	for _ = 1, getFollowTargetSmoothingPasses(options, followStyle) do
		local smoothed = {}
		for index, position in ipairs(positions) do
			local previous = positions[math.max(1, index - 1)]
			local nextPosition = positions[math.min(count, index + 1)]
			if index == 1 or index == count then
				smoothed[index] = (position * 0.72) + (((index == 1 and nextPosition) or previous) * 0.28)
			else
				smoothed[index] = (previous * 0.26) + (position * 0.48) + (nextPosition * 0.26)
			end
		end
		positions = smoothed
	end

	return positions
end

local function buildStableFollowCFrames(samples, positions)
	local cframes = {}
	local previousForward = nil
	for index, sample in ipairs(samples or {}) do
		local position = positions[index] or (sample.cframe and sample.cframe.Position) or Vector3.zero
		local previousPosition = positions[math.max(1, index - 1)] or position
		local nextPosition = positions[math.min(#positions, index + 1)] or position
		local motion = Vector3.new(nextPosition.X - previousPosition.X, 0, nextPosition.Z - previousPosition.Z)
		local rawLook = sample.cframe and sample.cframe.LookVector or Vector3.new(0, 0, -1)
		local flatLook = Vector3.new(rawLook.X, 0, rawLook.Z)
		local desiredForward = nil
		if motion.Magnitude &gt; 0.025 then
			desiredForward = motion.Unit
		elseif flatLook.Magnitude &gt; 0.001 then
			desiredForward = flatLook.Unit
		else
			desiredForward = previousForward or Vector3.new(0, 0, -1)
		end
		if previousForward then
			local blended = previousForward:Lerp(desiredForward, 0.35)
			desiredForward = blended.Magnitude &gt; 0.001 and blended.Unit or desiredForward
		end
		previousForward = desiredForward
		cframes[index] = CFrame.lookAt(position, position + desiredForward, Vector3.yAxis)
	end
	return cframes
end

local function trimDuplicateStartFrame(frames, startFrame)
	if type(frames) ~= "table" or #frames == 0 then
		return frames
	end
	if frames[1] == startFrame and #frames &gt; 1 then
		table.remove(frames, 1)
	end
	return frames
end

local function getAnimatedFrameRange(startFrame, trackFrames, fallbackEndFrame)
	local firstFrame = startFrame
	local lastFrame = fallbackEndFrame or startFrame
	if type(trackFrames) == "table" and #trackFrames &gt; 0 then
		firstFrame = math.max(startFrame, trackFrames[1])
		lastFrame = math.max(firstFrame, trackFrames[#trackFrames])
	end
	return firstFrame, lastFrame
end

local function smoothStep(alpha)
	alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
	return alpha * alpha * (3 - (2 * alpha))
end

local function interpolateAutoFollowDirection(alpha, sideWeight, backWeight, frontWeight)
	local points = {
		Vector3.new(-sideWeight, 0, -backWeight),
		Vector3.new(0, 0, frontWeight),
		Vector3.new(sideWeight, 0, -backWeight),
		Vector3.new(0, 0, -1),
	}
	local scaled = math.clamp(tonumber(alpha) or 0, 0, 1) * (#points - 1)
	local index = math.floor(scaled) + 1
	if index &gt;= #points then
		return points[#points]
	end
	local t = smoothStep(scaled - math.floor(scaled))
	return points[index]:Lerp(points[index + 1], t)
end

local function computeFollowOffsets(angleMode, followStyle, alpha)
	angleMode = tostring(angleMode or "Auto")
	alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
	local cinematic = followStyle == "Cinematic"
	local height = cinematic and 6.5 or 4.5
	local distance = cinematic and 15 or 10
	local sideWeight = cinematic and 0.7 or 0.62
	local backWeight = cinematic and 0.82 or 0.72
	local frontWeight = cinematic and 0.92 or 0.78
	local aboveHeight = cinematic and 10.5 or 8

	if angleMode == "Left" then
		return height, distance, Vector3.new(-sideWeight, 0, -backWeight)
	elseif angleMode == "Right" then
		return height, distance, Vector3.new(sideWeight, 0, -backWeight)
	elseif angleMode == "Above" then
		return aboveHeight, distance * 0.55, Vector3.new(0, 0, -0.35)
	elseif angleMode == "Front" then
		return height, distance, Vector3.new(0, 0, frontWeight)
	elseif angleMode == "Behind" then
		return height, distance, Vector3.new(0, 0, -1)
	end

	return height, distance, interpolateAutoFollowDirection(alpha, sideWeight, backWeight, frontWeight)
end

local function computeFollowCameraPosition(targetCFrame, followStyle, followAngle, alpha)
	local targetPosition = targetCFrame.Position
	local focusHeight = followStyle == "Cinematic" and 3 or 2.25
	local height, distance, localDirection = computeFollowOffsets(followAngle, followStyle, alpha)
	local rightVector = targetCFrame.RightVector.Magnitude &gt; 0 and targetCFrame.RightVector.Unit or Vector3.new(1, 0, 0)
	local forwardVector = targetCFrame.LookVector.Magnitude &gt; 0 and targetCFrame.LookVector.Unit or Vector3.new(0, 0, -1)
	local horizontalDirection = (rightVector * localDirection.X) + (forwardVector * localDirection.Z)
	if horizontalDirection.Magnitude &lt; 0.001 then
		horizontalDirection = -forwardVector
	else
		horizontalDirection = horizontalDirection.Unit
	end

	local focusPoint = targetPosition + Vector3.new(0, focusHeight, 0)
	local cameraPosition = focusPoint + (horizontalDirection * distance) + Vector3.new(0, height, 0)
	local separation = cameraPosition - focusPoint
	if separation.Magnitude &lt; distance then
		cameraPosition = focusPoint + (separation.Magnitude &gt; 0 and separation.Unit or -forwardVector) * distance
	end
	return cameraPosition, focusPoint
end

local function getFollowPathBlendAlpha(options, followStyle)
	local smoothness = math.clamp(tonumber(options and (options.smoothness or options.handheldSmoothness)) or 3, 0.1, 5)
	local smoothAlpha = math.clamp((smoothness - 0.1) / 4.9, 0, 1)
	local defaultSmoothing = tostring(followStyle or "Regular") == "Cinematic"
		and (0.42 + (0.12 * smoothAlpha))
		or (0.3 + (0.1 * smoothAlpha))
	local smoothing = math.clamp(tonumber(options and (options.followPathSmoothing or options.cameraPathSmoothing)) or defaultSmoothing, 0, 0.92)
	return 1 - smoothing
end

local function getFollowFocusBlendAlpha(options, followStyle)
	local smoothness = math.clamp(tonumber(options and (options.smoothness or options.handheldSmoothness)) or 3, 0.1, 5)
	local smoothAlpha = math.clamp((smoothness - 0.1) / 4.9, 0, 1)
	local defaultSmoothing = tostring(followStyle or "Regular") == "Cinematic"
		and (0.36 + (0.1 * smoothAlpha))
		or (0.22 + (0.08 * smoothAlpha))
	local smoothing = math.clamp(tonumber(options and options.lookAtSmoothing) or defaultSmoothing, 0, 0.92)
	return 1 - smoothing
end

local function findRigHead(rig)
	if not rig then
		return nil
	end
	local head = rig:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

local function resolveFirstPersonRig(timeline, selectionService, options)
	if options and options.useBoundRig == true then
		return timeline and timeline:getRig() or nil
	end

	local selected = selectionService and selectionService.getFirstSelected and selectionService.getFirstSelected() or nil
	if not selected then
		return nil
	end
	if selected:IsA("Model") then
		return selected
	end
	return selected:FindFirstAncestorOfClass("Model")
end

local function buildFirstPersonCameraValue(head, fieldOfView, eyeOffset)
	eyeOffset = eyeOffset or Vector3.new(0, 0.12, -0.18)
	local cframe = head.CFrame * CFrame.new(eyeOffset)
	return {
		cframe = cframe,
		focus = CFrame.new(cframe.Position + cframe.LookVector * 16),
		fieldOfView = normalizeFieldOfView(fieldOfView),
	}
end

local function buildAttachedCameraValue(targetCFrame, session, fieldOfView)
	if typeof(targetCFrame) ~= "CFrame" or type(session) ~= "table" then
		return nil
	end

	local cameraOffset = typeof(session.cameraOffset) == "CFrame" and session.cameraOffset or CFrame.identity
	local focusOffset = typeof(session.focusOffset) == "CFrame" and session.focusOffset or cameraOffset
	local cframe = targetCFrame * cameraOffset
	local focus = targetCFrame * focusOffset
	return {
		cframe = cframe,
		focus = focus,
		fieldOfView = normalizeFieldOfView(fieldOfView, session.fieldOfView),
	}
end

local function getAttachTargetLabel(target)
	local instance = target and (target.part or target.instance)
	if not instance then
		return "selection"
	end
	local success, fullName = pcall(function()
		return instance:GetFullName()
	end)
	return success and fullName or instance.Name
end

local function getRigRoot(rig)
	if not rig then
		return nil
	end
	return rig.PrimaryPart or rig:FindFirstChild("HumanoidRootPart", true) or rig:FindFirstChildWhichIsA("BasePart", true)
end

local function buildFaceFocusEntries(timeline, selectionService, options, base)
	local rig = resolveFirstPersonRig(timeline, selectionService, options)
	if not rig then
		return nil, "Select a rig or Head in Studio before using Face Focus."
	end

	local head = findRigHead(rig)
	if not head then
		return nil, string.format("No Head found on '%s'.", rig.Name)
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or Constants.DEFAULT_FPS)
	local startFrame = math.max(0, timeline:getCurrentFrame())
	local durationSeconds = math.clamp(tonumber(options.durationSeconds) or 2.5, 0.1, 30)
	local endFrame = math.max(startFrame + 1, startFrame + math.floor((durationSeconds * fps) + 0.5))
	local sampleCount = math.clamp(math.floor((durationSeconds * 10) + 0.5), 8, 48)
	local frames = buildSparseSampleFrames(startFrame, endFrame, sampleCount)
	local distance = math.clamp(tonumber(options.radius) or 4.5, 1.5, 24)
	local heightOffset = math.clamp(tonumber(options.heightOffset) or 0.05, -4, 4)
	local fov = math.clamp(tonumber(options.fovOverride) or 42, 1, 120)
	local smoothness = math.clamp(tonumber(options.smoothness or options.handheldSmoothness) or 5, 0.1, 5)
	local blendAlpha = math.clamp(0.92 - (smoothness * 0.12), 0.28, 0.8)
	local previousCameraPosition = nil
	local previousFocus = nil
	local entries = {}
	local originalFrame = timeline:getCurrentFrame()

	for _, frame in ipairs(frames) do
		timeline:applyFrame(frame)
		local headCFrame = head.CFrame
		local faceDirection = headCFrame.LookVector.Magnitude &gt; 0 and headCFrame.LookVector.Unit or Vector3.new(0, 0, -1)
		local rawFocus = headCFrame.Position + Vector3.new(0, heightOffset, 0)
		local rawCameraPosition = rawFocus + (faceDirection * distance)
		local focus = smoothVector(previousFocus, rawFocus, blendAlpha)
		local cameraPosition = smoothVector(previousCameraPosition, rawCameraPosition, blendAlpha)
		previousFocus = focus
		previousCameraPosition = cameraPosition
		table.insert(entries, {
			frame = frame,
			value = {
				cframe = CFrame.lookAt(cameraPosition, focus, Vector3.yAxis),
				focus = CFrame.new(focus),
				fieldOfView = fov,
			},
			easingStyle = "Linear",
			easingDirection = "InOut",
		})
	end
	timeline:applyFrame(originalFrame)

	return entries, string.format("Added Face Focus for %s.Head.", rig.Name)
end

local function addFrameInRange(frames, seen, frame, startFrame, endFrame)
	frame = math.max(0, math.floor((tonumber(frame) or 0) + 0.5))
	if frame &lt; startFrame or frame &gt; endFrame or seen[frame] then
		return
	end
	seen[frame] = true
	table.insert(frames, frame)
end

local function addFrameRange(frames, seen, startFrame, endFrame)
	startFrame = math.max(0, math.floor((tonumber(startFrame) or 0) + 0.5))
	endFrame = math.max(startFrame, math.floor((tonumber(endFrame) or startFrame) + 0.5))
	for frame = startFrame, endFrame do
		addFrameInRange(frames, seen, frame, startFrame, endFrame)
	end
end

local function buildFirstPersonFrames(timeline, rigName, startFrame, endFrame, cameraTrack)
	local frames = {}
	local seen = {}
	addFrameInRange(frames, seen, startFrame, startFrame, endFrame)
	addFrameInRange(frames, seen, endFrame, startFrame, endFrame)

	for _, path in ipairs(timeline:getRigTrackPaths(rigName) or {}) do
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(path) or {}) do
			addFrameInRange(frames, seen, frame, startFrame, endFrame)
		end
	end

	local rigCFrameTrack = timeline:getRigPropertyTrack(rigName, "CFrame")
	if rigCFrameTrack then
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(rigCFrameTrack.path) or {}) do
			addFrameInRange(frames, seen, frame, startFrame, endFrame)
		end
	end

	if cameraTrack and cameraTrack.path then
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(cameraTrack.path) or {}) do
			addFrameInRange(frames, seen, frame, startFrame, endFrame)
		end
	end

	table.sort(frames)
	return frames
end

local function buildCameraAttachFrames(timeline, target, startFrame, endFrame, cameraTrack)
	local frames = {}
	local seen = {}
	addFrameRange(frames, seen, startFrame, endFrame)

	local targetTrack = target and target.track
	if targetTrack and targetTrack.path then
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(targetTrack.path) or {}) do
			addFrameInRange(frames, seen, frame, startFrame, endFrame)
		end
		if targetTrack.rigName then
			for _, path in ipairs(timeline:getRigTrackPaths(targetTrack.rigName) or {}) do
				for _, frame in ipairs(timeline:getTrackKeyframeFrames(path) or {}) do
					addFrameInRange(frames, seen, frame, startFrame, endFrame)
				end
			end
			local rigCFrameTrack = timeline:getRigPropertyTrack(targetTrack.rigName, "CFrame")
			if rigCFrameTrack then
				for _, frame in ipairs(timeline:getTrackKeyframeFrames(rigCFrameTrack.path) or {}) do
					addFrameInRange(frames, seen, frame, startFrame, endFrame)
				end
			end
		end
	end

	if cameraTrack and cameraTrack.path then
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(cameraTrack.path) or {}) do
			addFrameInRange(frames, seen, frame, startFrame, endFrame)
		end
	end

	table.sort(frames)
	return frames
end

local function getRigAnimationFrames(timeline, rigName)
	local frames = {}
	local seen = {}

	for _, path in ipairs(timeline:getRigTrackPaths(rigName) or {}) do
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(path) or {}) do
			addFrameInRange(frames, seen, frame, 0, math.huge)
		end
	end

	local rigCFrameTrack = timeline:getRigPropertyTrack(rigName, "CFrame")
	if rigCFrameTrack then
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(rigCFrameTrack.path) or {}) do
			addFrameInRange(frames, seen, frame, 0, math.huge)
		end
	end

	table.sort(frames)
	return frames
end

local function buildFirstPersonAttachEntries(timeline, track, selectionService, options, base)
	local rig = resolveFirstPersonRig(timeline, selectionService, options)
	if not rig then
		return nil, "Select a rig or Head in Studio before using First-Person Mode."
	end

	local head = findRigHead(rig)
	if not head then
		return nil, string.format("No Head found on '%s'.", rig.Name)
	end

	local frame = timeline:getCurrentFrame()
	local endFrame = math.max(frame, math.floor(tonumber(timeline:getDurationFrames()) or frame))
	local eyeOffset = Vector3.new(0, 0.12, -0.18)
	local fieldOfView = normalizeFieldOfView(options and options.fovOverride, base.fieldOfView)
	firstPersonSessions[track.path] = {
		rig = rig,
		rigName = rig.Name,
		startFrame = frame,
		endFrame = endFrame,
		fieldOfView = fieldOfView,
		eyeOffset = eyeOffset,
	}

	local originalFrame = timeline:getCurrentFrame()
	local frames = buildFirstPersonFrames(timeline, rig.Name, frame, endFrame, track)
	local entries = {}
	for _, sampleFrame in ipairs(frames) do
		timeline:applyFrame(sampleFrame)
		table.insert(entries, {
			frame = sampleFrame,
			value = buildFirstPersonCameraValue(head, getTimelineFovAtFrame(timeline, sampleFrame) or fieldOfView, eyeOffset),
			easingStyle = "Linear",
			easingDirection = "InOut",
		})
	end
	timeline:applyFrame(originalFrame)

	return entries, string.format("First-person camera attached to %s.Head at frame %d and auto-detaches after frame %d.", rig.Name, frame, endFrame)
end

local function buildFirstPersonDetachEntries(timeline, track, base)
	local session, sessionPath = getFirstPersonSessionForTrack(track.path)
	if not session then
		return nil, "Use First-Person Mode first, then move the playhead and detach."
	end

	local rig = session.rig and session.rig.Parent and session.rig or timeline:getRigByName(session.rigName)
	local head = findRigHead(rig)
	if not head then
		firstPersonSessions[sessionPath or track.path] = nil
		return nil, string.format("Could not find %s.Head for the active first-person camera.", tostring(session.rigName or "rig"))
	end

	local startFrame = math.max(0, math.floor(tonumber(session.startFrame) or timeline:getCurrentFrame()))
	local endFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or startFrame))
	if endFrame &lt; startFrame then
		return nil, "Move the playhead after the first-person attach frame before detaching."
	end

	local originalFrame = timeline:getCurrentFrame()
	local eyeOffset = session.eyeOffset or Vector3.new(0, 0.12, -0.18)
	local fieldOfView = normalizeFieldOfView(session.fieldOfView, base.fieldOfView)
	local frames = buildFirstPersonFrames(timeline, session.rigName, startFrame, endFrame, track)
	local valuesByFrame = {}
	for _, frame in ipairs(frames) do
		timeline:applyFrame(frame)
		valuesByFrame[frame] = buildFirstPersonCameraValue(head, getTimelineFovAtFrame(timeline, frame) or fieldOfView, eyeOffset)
	end
	timeline:applyFrame(originalFrame)

	local entries = {}
	local endValue = valuesByFrame[endFrame] or buildFirstPersonCameraValue(head, getTimelineFovAtFrame(timeline, endFrame) or fieldOfView, eyeOffset)
	table.insert(entries, {
		frame = endFrame,
		value = endValue,
		easingStyle = "Linear",
		easingDirection = "InOut",
	})
	for _, frame in ipairs(frames) do
		if frame ~= endFrame and valuesByFrame[frame] then
			table.insert(entries, {
				frame = frame,
				value = valuesByFrame[frame],
				easingStyle = "Linear",
				easingDirection = "InOut",
			})
		end
	end

	firstPersonSessions[sessionPath or track.path] = nil
	return entries, string.format("Detached first-person camera from %s.Head and baked %d camera keyframes.", rig.Name, #entries)
end

local function buildCameraAttachEntries(timeline, track, selectionService, options, base)
	local target = resolveFollowTarget(timeline, selectionService, options)
	if not target or not target.part then
		return nil, "Select a part, rig body part, or model before attaching the camera."
	end

	local frame = math.max(0, timeline:getCurrentFrame())
	local originalFrame = timeline:getCurrentFrame()
	local cameraState = CameraTrackService.captureStudioCameraValue(track) or base
	local targetCFrame = sampleFollowTargetCFrame(timeline, target, frame) or readFollowTargetWorldCFrame(target)
	if typeof(targetCFrame) ~= "CFrame" then
		restoreTimelineAfterSampling(timeline, originalFrame, cameraState)
		return nil, "Could not read the selected camera attach target."
	end

	clearPartAttachSessions()
	local session = {
		kind = "PartAttach",
		target = target,
		targetName = getAttachTargetLabel(target),
		startFrame = frame,
		fieldOfView = normalizeFieldOfView(options and options.fovOverride, base.fieldOfView),
		cameraOffset = CFrame.identity,
		focusOffset = CFrame.new(0, 0, -16),
	}
	firstPersonSessions[track.path] = session

	local value = buildAttachedCameraValue(targetCFrame, session, getTimelineFovAtFrame(timeline, frame) or session.fieldOfView)
	restoreTimelineAfterSampling(timeline, originalFrame, cameraState)

	if not value then
		firstPersonSessions[track.path] = nil
		return nil, "Could not build a camera attach keyframe for the selected target."
	end
	return {
		{
			frame = frame,
			value = value,
			easingStyle = "Linear",
			easingDirection = "InOut",
		},
	}, string.format("Camera attached to %s at frame %d. Move the playhead and detach to bake the followed segment.", session.targetName, frame)
end

local function buildCameraDetachEntries(timeline, track, base)
	local session, sessionPath = getFirstPersonSessionForTrack(track.path)
	if not session then
		return nil, "Attach the camera to a selected part first, then move the playhead and detach."
	end
	if session.kind ~= "PartAttach" then
		return buildFirstPersonDetachEntries(timeline, track, base)
	end

	local startFrame = math.max(0, math.floor(tonumber(session.startFrame) or timeline:getCurrentFrame()))
	local endFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or startFrame))
	if endFrame &lt; startFrame then
		return nil, "Move the playhead after the camera attach frame before detaching."
	end

	local originalFrame = timeline:getCurrentFrame()
	local cameraState = CameraTrackService.captureStudioCameraValue(track) or base
	local entries = {}
	for _, sampleFrame in ipairs(buildCameraAttachFrames(timeline, session.target, startFrame, endFrame, track)) do
		local targetCFrame = sampleFollowTargetCFrame(timeline, session.target, sampleFrame)
		local value = buildAttachedCameraValue(targetCFrame, session, getTimelineFovAtFrame(timeline, sampleFrame) or session.fieldOfView)
		if value then
			table.insert(entries, {
				frame = sampleFrame,
				value = value,
				easingStyle = "Linear",
				easingDirection = "InOut",
			})
		end
	end
	restoreTimelineAfterSampling(timeline, originalFrame, cameraState)

	firstPersonSessions[sessionPath or track.path] = nil
	clearPartAttachSessions()
	if #entries == 0 then
		return nil, "Could not bake camera detach keyframes for the selected target."
	end
	return entries, string.format("Detached camera from %s and baked %d camera keyframes.", session.targetName or "selection", #entries)
end

function CameraTrackService.applyActiveFirstPersonPreview(timeline, frame)
	if not timeline then
		return false, 0
	end

	local appliedCount = 0
	frame = math.max(0, tonumber(frame) or timeline:getCurrentFrame())
	for sessionPath, session in pairs(firstPersonSessions) do
		if not timeline:getTrackByPath(sessionPath) then
			firstPersonSessions[sessionPath] = nil
			continue
		end
		local startFrame = math.max(0, tonumber(session.startFrame) or 0)
		local endFrame = tonumber(session.endFrame)
		if frame &gt;= startFrame and (not endFrame or frame &lt;= endFrame) then
			if session.kind == "PartAttach" then
				local value = buildAttachedCameraValue(readFollowTargetWorldCFrame(session.target), session, getTimelineFovAtFrame(timeline, frame) or session.fieldOfView)
				if value and typeof(value.cframe) == "CFrame" then
					local camera = workspace.CurrentCamera
					if camera then
						camera.CFrame = value.cframe
						camera.Focus = value.focus
						camera.FieldOfView = value.fieldOfView
						appliedCount += 1
					end
				end
			else
				local rig = session.rig and session.rig.Parent and session.rig or timeline:getRigByName(session.rigName)
				local head = findRigHead(rig)
				if head then
					local value = buildFirstPersonCameraValue(head, getTimelineFovAtFrame(timeline, frame) or session.fieldOfView, session.eyeOffset)
					if value and typeof(value.cframe) == "CFrame" then
						local camera = workspace.CurrentCamera
						if camera then
							camera.CFrame = value.cframe
							camera.Focus = value.focus
							camera.FieldOfView = value.fieldOfView
							appliedCount += 1
						end
					end
				end
			end
		end
	end

	return appliedCount &gt; 0, appliedCount
end

function CameraTrackService.previewPresetEntries(entries, options)
	local camera = workspace.CurrentCamera
	if not camera or type(entries) ~= "table" or #entries == 0 then
		return false
	end
	options = options or {}
	previewToken += 1
	local runToken = previewToken
	local originalCFrame = camera.CFrame
	local originalFocus = camera.Focus
	local originalFieldOfView = camera.FieldOfView
	table.sort(entries, function(a, b)
		return (tonumber(a.frame) or 0) &lt; (tonumber(b.frame) or 0)
	end)
	task.spawn(function()
		local previewEntries = {}
		for _, entry in ipairs(entries) do
			local value = entry.value
			if type(value) == "table" and typeof(value.cframe) == "CFrame" then
				table.insert(previewEntries, {
					frame = math.max(0, math.floor((tonumber(entry.frame) or 0) + 0.5)),
					value = value,
					easingStyle = entry.easingStyle,
					easingDirection = entry.easingDirection,
				})
			end
		end
		if #previewEntries == 0 then
			return
		end
		if #previewEntries == 1 then
			local value = previewEntries[1].value
			camera.CFrame = value.cframe
			camera.Focus = value.focus or CFrame.new(value.cframe.Position + value.cframe.LookVector * 16)
			camera.FieldOfView = value.fieldOfView or camera.FieldOfView
			task.wait(0.25)
			if runToken == previewToken then
				camera.CFrame = originalCFrame
				camera.Focus = originalFocus
				camera.FieldOfView = originalFieldOfView
			end
			return
		end

		local firstFrame = previewEntries[1].frame
		local lastFrame = previewEntries[#previewEntries].frame
		local frameSpan = math.max(0, lastFrame - firstFrame)
		local fps = math.max(1, tonumber(options.fps) or Constants.DEFAULT_FPS)
		local totalDuration = tonumber(options.durationSeconds)
		if not totalDuration or totalDuration &lt;= 0 then
			totalDuration = frameSpan &gt; 0 and (frameSpan / fps) or 1.1
		end
		totalDuration = math.clamp(totalDuration, 0.05, 30)

		for index = 1, #previewEntries - 1 do
			local startEntry = previewEntries[index]
			local endEntry = previewEntries[index + 1]
			local startValue = startEntry.value
			local endValue = endEntry.value
			local segmentFrames = math.max(0, endEntry.frame - startEntry.frame)
			local segmentDuration = frameSpan &gt; 0
				and (totalDuration * (segmentFrames / frameSpan))
				or (totalDuration / math.max(1, #previewEntries - 1))
			segmentDuration = math.max(0.01, segmentDuration)
			local elapsed = 0
			while elapsed &lt; segmentDuration do
				local dt = RunService.Heartbeat:Wait()
				elapsed += dt
				local alpha = math.clamp(elapsed / segmentDuration, 0, 1)
				local easedAlpha = easeAlpha(alpha, endEntry.easingStyle, endEntry.easingDirection)
				local cframe = startValue.cframe:Lerp(endValue.cframe, easedAlpha)
				local focus = (startValue.focus or CFrame.new(startValue.cframe.Position + startValue.cframe.LookVector * 16))
					:Lerp(endValue.focus or CFrame.new(endValue.cframe.Position + endValue.cframe.LookVector * 16), easedAlpha)
				camera.CFrame = cframe
				camera.Focus = focus
				camera.FieldOfView = (startValue.fieldOfView or camera.FieldOfView)
					+ (((endValue.fieldOfView or camera.FieldOfView) - (startValue.fieldOfView or camera.FieldOfView)) * easedAlpha)
			end
		end
		if runToken == previewToken then
			camera.CFrame = originalCFrame
			camera.Focus = originalFocus
			camera.FieldOfView = originalFieldOfView
		end
	end)
	return true
end

function CameraTrackService.buildPresetEntries(deps, presetId)
	local timeline = deps and deps.timeline
	local track = deps and deps.track
	local selectionService = deps and deps.selectionService
	local options = deps and deps.options or {}
	if not timeline or not CameraTrackService.isCameraTrack(track) then
		return nil, "Select a camera track first."
	end

	local base = CameraTrackService.captureStudioCameraValue(track)
	if not base then
		return nil, "Select a camera track and make sure Studio has an active camera."
	end
	base.fieldOfView = normalizeFieldOfView(options.fovOverride, base.fieldOfView)

	local fps = timeline:getFps()
	local startFrame = timeline:getCurrentFrame()
	local focusPosition = base.focus and base.focus.Position or (base.cframe.Position + base.cframe.LookVector * 16)
	local rig = timeline:getRig()
	local rigRoot = rig and (rig.PrimaryPart or rig:FindFirstChild("HumanoidRootPart", true))
	local durationScale = math.clamp(tonumber(options.durationScale) or 1, 0.25, 8)
	local explicitDurationSeconds = tonumber(options.durationSeconds)
	if options.durationToEnd == true then
		explicitDurationSeconds = math.max(0.1, ((tonumber(timeline:getDurationFrames()) or startFrame) - startFrame) / math.max(1, fps))
	end
	if presetId == "Orbit"
		and options.useBoundRig == true
		and options.durationToEnd ~= true
		and explicitDurationSeconds ~= nil
		and math.abs(explicitDurationSeconds - 2.4) &lt; 0.001 then
		explicitDurationSeconds = nil
	end
	local hasExplicitDuration = explicitDurationSeconds ~= nil and explicitDurationSeconds &gt; 0
	local smoothness = math.clamp(tonumber(options.handheldSmoothness) or 1, 0.25, 3)
	local aggression = math.clamp(tonumber(options.explosionAggression) or 1, 0.25, 4)
	local followStyle = tostring(options.followStyle or "Regular")
	local followAngle = tostring(options.followAngle or "Auto")

	local function presetDuration(defaultSeconds)
		local seconds = hasExplicitDuration and explicitDurationSeconds or (defaultSeconds * durationScale)
		return math.clamp(seconds, 0.1, 300)
	end

	local function scaleSeconds(seconds)
		if hasExplicitDuration then
			return seconds
		end
		return seconds * durationScale
	end

	local function cameraState(cframe, focusPositionOrCFrame, fieldOfView)
		local focusCFrame = typeof(focusPositionOrCFrame) == "CFrame"
			and focusPositionOrCFrame
			or CFrame.new(focusPositionOrCFrame or focusPosition)
		return {
			cframe = cframe,
			focus = focusCFrame,
			fieldOfView = normalizeFieldOfView(fieldOfView, base.fieldOfView),
		}
	end

	local function offsetState(positionOffset, rotationDegrees, fieldOfView)
		local rotation = CFrame.Angles(
			math.rad(rotationDegrees.X or 0),
			math.rad(rotationDegrees.Y or 0),
			math.rad(rotationDegrees.Z or 0)
		)
		local offset = base.cframe:VectorToWorldSpace(positionOffset)
		local newPosition = base.cframe.Position + offset
		local lookTarget = focusPosition + (positionOffset * 0.15)
		local cframe = CFrame.lookAt(newPosition, lookTarget) * rotation
		return cameraState(cframe, lookTarget, fieldOfView)
	end

	if presetId == "FirstPersonAttach" then
		return buildFirstPersonAttachEntries(timeline, track, selectionService, options, base)
	elseif presetId == "FirstPersonDetach" then
		return buildFirstPersonDetachEntries(timeline, track, base)
	elseif presetId == "CameraAttachSelection" then
		return buildCameraAttachEntries(timeline, track, selectionService, options, base)
	elseif presetId == "CameraDetachSelection" then
		return buildCameraDetachEntries(timeline, track, base)
	elseif presetId == "FaceFocus" then
		return buildFaceFocusEntries(timeline, selectionService, options, base)
	end

	local entries = {}
	local function addAt(seconds, value, easingStyle, easingDirection)
		table.insert(entries, {
			frame = startFrame + math.floor((scaleSeconds(seconds) * fps) + 0.5),
			value = value,
			easingStyle = easingStyle or Constants.DEFAULT_EASING_STYLE,
			easingDirection = easingDirection or Constants.DEFAULT_EASING_DIRECTION,
		})
	end

	addAt(0, base, "Linear", "InOut")

	if presetId == "ExplosionShake" then
		local samples = {
			{ 0.08, Vector3.new(0.55, 0.25, -0.20) * aggression, Vector3.new(1.4, -2.5, 1.2) * aggression, base.fieldOfView + (5 * aggression) },
			{ 0.16, Vector3.new(-0.42, -0.22, 0.18) * aggression, Vector3.new(-1.1, 2.1, -0.8) * aggression, base.fieldOfView + (3.5 * aggression) },
			{ 0.26, Vector3.new(0.28, 0.16, -0.10) * aggression, Vector3.new(0.9, -1.4, 0.4) * aggression, base.fieldOfView + (2 * aggression) },
			{ 0.38, Vector3.new(-0.16, -0.10, 0.06) * aggression, Vector3.new(-0.5, 0.8, -0.2) * aggression, base.fieldOfView + aggression },
			{ 0.52, Vector3.new(0, 0, 0), Vector3.new(0, 0, 0), base.fieldOfView },
		}
		for _, sample in ipairs(samples) do
			addAt(sample[1], offsetState(sample[2], sample[3], sample[4]), "Linear", "InOut")
		end
		return entries, "Added Explosion Shake camera preset."
	elseif presetId == "SoftHandheld" then
		local duration = presetDuration(5.8)
		local samples = {
			{ 0.18, Vector3.new(0.04, 0.022, 0) / smoothness, Vector3.new(0.14, 0.24, 0.07) / smoothness, base.fieldOfView + (0.06 / smoothness) },
			{ 0.40, Vector3.new(-0.035, 0.018, 0.022) / smoothness, Vector3.new(-0.13, -0.22, -0.05) / smoothness, base.fieldOfView + (0.03 / smoothness) },
			{ 0.62, Vector3.new(0.028, -0.018, -0.018) / smoothness, Vector3.new(0.09, 0.17, 0.04) / smoothness, base.fieldOfView - (0.04 / smoothness) },
			{ 0.82, Vector3.new(-0.024, 0.012, 0.012) / smoothness, Vector3.new(-0.07, -0.12, -0.03) / smoothness, base.fieldOfView + (0.015 / smoothness) },
			{ 1.00, Vector3.new(0, 0, 0), Vector3.new(0, 0, 0), base.fieldOfView },
		}
		for _, sample in ipairs(samples) do
			addAt(duration * sample[1], offsetState(sample[2], sample[3], sample[4]), "Sine", "InOut")
		end
		return entries, "Added Soft Handheld camera preset."
	elseif presetId == "Orbit" then
		local orbitDuration = presetDuration(2.4)
		local target = resolveFollowTarget(timeline, selectionService, options)
		if not target or not target.part then
			local offset = base.cframe.Position - focusPosition
			if offset.Magnitude &lt; 2 then
				offset = (-base.cframe.LookVector * 12) + Vector3.new(0, 4, 0)
			end
			local radius = tonumber(options.radius)
			if radius and radius &gt; 0 then
				local flatOffset = Vector3.new(offset.X, 0, offset.Z)
				if flatOffset.Magnitude &gt; 0.01 then
					offset = (flatOffset.Unit * radius) + Vector3.new(0, offset.Y, 0)
				else
					offset = Vector3.new(0, offset.Y, radius)
				end
			end
			local orbitDegrees = options.durationToEnd == true and 360 or math.clamp(tonumber(options.orbitAngle) or 56, 1, 360)
			local orbitDirection = tostring(options.orbitDirection or "Clockwise") == "Counterclockwise" and -1 or 1
			local startAngle = options.durationToEnd == true and 0 or (-orbitDegrees * 0.5)
			local sampleCount = math.clamp(math.floor((orbitDuration * 10) + 0.5), 10, 90)
			for index = 1, sampleCount do
				local alpha = (index - 1) / math.max(1, sampleCount - 1)
				local angle = (startAngle + (orbitDegrees * alpha)) * orbitDirection
				local rotatedOffset = CFrame.Angles(0, math.rad(angle), 0):VectorToWorldSpace(offset)
				local position = focusPosition + rotatedOffset
				local cframe = CFrame.lookAt(position, focusPosition)
				addAt(orbitDuration * alpha, cameraState(cframe, focusPosition, base.fieldOfView), "Linear", "InOut")
			end
			return entries, "Added Orbit camera preset."
		end

		local targetTrackFrames = target.track and timeline:getTrackKeyframeFrames(target.track.path) or {}
		local usingRigAnimationRange = false
		local rigAnimationStartFrame = nil
		local rigAnimationEndFrame = nil
		if not hasExplicitDuration and target.instance and target.instance:IsA("Model") then
			local rigAnimationFrames = getRigAnimationFrames(timeline, target.instance.Name)
			if #rigAnimationFrames &gt; 0 then
				targetTrackFrames = rigAnimationFrames
				usingRigAnimationRange = true
				rigAnimationStartFrame = rigAnimationFrames[1]
				rigAnimationEndFrame = rigAnimationFrames[#rigAnimationFrames]
			end
		end
		local orbitEndFrame = startFrame + math.floor(orbitDuration * fps + 0.5)
		local animatedEndFrame = orbitEndFrame
		if not hasExplicitDuration then
			if usingRigAnimationRange and rigAnimationStartFrame ~= nil and rigAnimationEndFrame ~= nil then
				local rigSpanFrames = math.max(0, rigAnimationEndFrame - rigAnimationStartFrame)
				animatedEndFrame = startFrame + rigSpanFrames
			else
				local _, rangeEndFrame = getAnimatedFrameRange(startFrame, targetTrackFrames, orbitEndFrame)
				animatedEndFrame = rangeEndFrame
			end
		end
		local orbitSpanSeconds = orbitDuration
		if usingRigAnimationRange and not hasExplicitDuration then
			orbitSpanSeconds = math.max(0.1, (animatedEndFrame - startFrame) / math.max(1, fps))
		else
			orbitSpanSeconds = math.max(orbitDuration, (animatedEndFrame - startFrame) / math.max(1, fps))
		end
		local orbitSampleCount = math.clamp(math.floor((orbitSpanSeconds * 10) + 0.5), 10, 120)
		local orbitFrames = buildSparseSampleFrames(startFrame, animatedEndFrame, orbitSampleCount)
		local total = math.max(1, #orbitFrames - 1)
		local radius = tonumber(options.radius) or (followStyle == "Cinematic" and 16 or 13)
		local orbitDegrees = options.durationToEnd == true and 360 or math.clamp(tonumber(options.orbitAngle) or 360, 1, 360)
		local orbitDirection = tostring(options.orbitDirection or "Clockwise") == "Counterclockwise" and -1 or 1
		local focusBlend = math.clamp(0.78 - (smoothness * 0.14), 0.32, 0.72)
		local previousFocus = nil
		entries = {}
		for index, frame in ipairs(orbitFrames) do
			local targetCFrame = getTrackSampleCFrame(timeline, target.track, frame) or target.part.CFrame
			local alpha = (index - 1) / total
			local angle = math.rad((alpha * orbitDegrees) * orbitDirection)
			local targetPosition = targetCFrame.Position
			local heightOffset = tonumber(options.heightOffset) or ((followAngle == "Above") and 8 or 4.5)
			local rawFocusPoint = targetPosition + Vector3.new(0, followStyle == "Cinematic" and 3 or 2.5, 0)
			local focusPoint = smoothVector(previousFocus, rawFocusPoint, focusBlend)
			previousFocus = focusPoint
			local orbitOffset = Vector3.new(math.sin(angle) * radius, heightOffset, math.cos(angle) * radius)
			local cameraPosition = focusPoint + orbitOffset
			table.insert(entries, {
				frame = frame,
				value = cameraState(CFrame.lookAt(cameraPosition, focusPoint, Vector3.yAxis), focusPoint, tonumber(options.fovOverride) or base.fieldOfView),
				easingStyle = "Linear",
				easingDirection = "InOut",
			})
		end
		return entries, string.format("Added orbit preset for %s.", target.instance.Name)
	elseif presetId == "FollowRig" then
		local target = resolveFollowTarget(timeline, selectionService, options)
		if not target or not target.part then
			return nil, "Select a rig, model, or part in Studio before using a follow preset."
		end

		local sampleFrames = target.track and timeline:getTrackKeyframeFrames(target.track.path) or {}
		if #sampleFrames &gt; 0 then
			local _, followEndFrame = getAnimatedFrameRange(startFrame, sampleFrames, startFrame + math.floor(scaleSeconds(1.2) * fps + 0.5))
			local sparseFrames = buildFollowSampleFrames(startFrame, followEndFrame, sampleFrames, fps, followStyle, options)
			local positionBlendAlpha = getFollowPathBlendAlpha(options, followStyle)
			local focusBlendAlpha = getFollowFocusBlendAlpha(options, followStyle)
			local restoreFrame = timeline:getCurrentFrame()
			local restoreCameraState = {
				cframe = base.cframe,
				focus = base.focus,
				fieldOfView = base.fieldOfView,
			}
			local followSamples = {}
			for _, frame in ipairs(sparseFrames) do
				table.insert(followSamples, {
					frame = frame,
					cframe = sampleFollowTargetCFrame(timeline, target, frame) or target.part.CFrame,
				})
			end
			local stableTargetCFrames = buildStableFollowCFrames(
				followSamples,
				smoothFollowPositions(followSamples, options, followStyle)
			)
			local previousPosition = nil
			local previousFocus = nil
			entries = {}
			for index, frame in ipairs(sparseFrames) do
				local targetCFrame = stableTargetCFrames[index] or followSamples[index] and followSamples[index].cframe or target.part.CFrame
				local alpha = (index - 1) / math.max(1, #sparseFrames - 1)
				local rawPosition, rawFocus = computeFollowCameraPosition(targetCFrame, followStyle, followAngle, alpha)
				local endPosition = smoothVector(previousPosition, rawPosition, positionBlendAlpha)
				local endFocus = smoothVector(previousFocus, rawFocus, focusBlendAlpha)
				previousPosition = endPosition
				previousFocus = endFocus
				table.insert(entries, {
					frame = frame,
					value = cameraState(CFrame.lookAt(endPosition, endFocus), endFocus, base.fieldOfView),
					easingStyle = "Linear",
					easingDirection = "InOut",
				})
			end
			restoreTimelineAfterSampling(timeline, restoreFrame, restoreCameraState)
			return entries, string.format("Added %s follow preset for %s using animated movement.", string.lower(followStyle), target.instance.Name)
		end

		local fallbackFrames = buildSparseSampleFrames(startFrame, startFrame + math.floor(scaleSeconds(1.2) * fps + 0.5), 4)
		local positionBlendAlpha = getFollowPathBlendAlpha(options, followStyle)
		local focusBlendAlpha = getFollowFocusBlendAlpha(options, followStyle)
		local previousPosition = nil
		local previousFocus = nil
		entries = {}
		for _, frame in ipairs(fallbackFrames) do
			local alpha = math.clamp((frame - startFrame) / math.max(1, (fallbackFrames[#fallbackFrames] - startFrame)), 0, 1)
			local rawPosition, rawFocus = computeFollowCameraPosition(target.part.CFrame, followStyle, followAngle, alpha)
			local endPosition = smoothVector(previousPosition, rawPosition, positionBlendAlpha)
			local endFocus = smoothVector(previousFocus, rawFocus, focusBlendAlpha)
			previousPosition = endPosition
			previousFocus = endFocus
			table.insert(entries, {
				frame = frame,
				value = cameraState(CFrame.lookAt(endPosition, endFocus), endFocus, base.fieldOfView),
				easingStyle = "Linear",
				easingDirection = "InOut",
			})
		end
		return entries, string.format("Added %s follow preset for %s.", string.lower(followStyle), target.instance.Name)
	end

	local cinematicEntries, cinematicMessage = CameraCinematicPresetService.buildPresetEntries({
		timeline = timeline,
		track = track,
		selectionService = selectionService,
		options = options,
		base = base,
		startFrame = startFrame,
	}, presetId)
	if cinematicEntries or cinematicMessage then
		return cinematicEntries, cinematicMessage
	end

	return nil, "That camera preset is not available yet."
end

return CameraTrackService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX122">
        <Properties>
          <string name="Name">CaptureFrameActionSupport</string>
          <ProtectedString name="Source">local CaptureFrameActionSupport = {}
local PropertyKeyframeValueService = require(script.Parent:WaitForChild("PropertyKeyframeValueService"))
local TrackPropertyDefaultsService = require(script.Parent:WaitForChild("TrackPropertyDefaultsService"))

local function isPropertyContainerObjectTrack(track)
	local instance = track and track.instance
	return instance ~= nil
		and instance.Parent ~= nil
		and PropertyKeyframeValueService.isPostEffectInstance(instance)
end

local function getOrCreateChildPropertyTrackPaths(timeline, track)
	if not (track and type(timeline.getChildPropertyTrackPaths) == "function") then
		return {}
	end
	local childPaths = timeline:getChildPropertyTrackPaths(track.path)
	if #childPaths == 0 then
		TrackPropertyDefaultsService.addDefaultLightPropertyTracks(timeline, track)
		childPaths = timeline:getChildPropertyTrackPaths(track.path)
	end
	return childPaths
end

local function getTargetPathsForTrack(timeline, track, path)
	if track.trackType == "Rig Group" then
		return timeline:getRigTrackPaths(track.rigName)
	end
	if isPropertyContainerObjectTrack(track) then
		local childPaths = getOrCreateChildPropertyTrackPaths(timeline, track)
		if #childPaths &gt; 0 then
			return childPaths
		end
	end
	return { path }
end

function CaptureFrameActionSupport.captureCurrentFrame(args)
	local capturePaths = args.getCaptureTrackPaths()
	if #capturePaths == 0 then
		return false, "Select one or more tracks before adding a keyframe."
	end

	args.pushUndo("Add Keyframe")
	args.changeHistoryService:SetWaypoint("Before Add Keyframe")
	local capturedKeys = {}
	local messages = {}
	for _, path in ipairs(capturePaths) do
		local success, message = args.timeline:captureTrackFrame(path)
		if success then
			table.insert(capturedKeys, {
				jointPath = path,
				frame = args.timeline:getCurrentFrame(),
			})
		elseif message then
			table.insert(messages, message)
		end
	end
	args.changeHistoryService:SetWaypoint("After Add Keyframe")

	if #capturedKeys &gt; 0 then
		return true, capturedKeys, string.format("Added %d keyframe%s at frame %d.", #capturedKeys, #capturedKeys == 1 and "" or "s", args.timeline:getCurrentFrame())
	end

	args.discardPendingUndo()
	return false, nil, messages[1] or "Nothing was added. Verify the selected tracks are still available."
end

function CaptureFrameActionSupport.captureTrackAtPlayhead(args)
	local track = args.timeline:getTrackByPath(args.path)
	if not track then
		return false, nil, nil, "That track is no longer available."
	end

	local targetPaths = getTargetPathsForTrack(args.timeline, track, args.path)
	if #targetPaths == 0 then
		return false, track, nil, "That rig does not have any keyable tracks yet."
	end

	args.pushUndo("Add Track Keyframe")
	args.changeHistoryService:SetWaypoint("Before Add Track Keyframe")
	local capturedKeys, messages = args.captureSelectionSupport.buildCaptureResult(args.timeline, targetPaths)
	args.changeHistoryService:SetWaypoint("After Add Track Keyframe")

	if #capturedKeys == 0 then
		args.discardPendingUndo()
		return false, track, nil, messages[1] or "Nothing was added."
	end

	return true, track, capturedKeys, args.captureSelectionSupport.buildTrackCaptureMessage(track, #capturedKeys, args.timeline:getCurrentFrame())
end

return CaptureFrameActionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX123">
        <Properties>
          <string name="Name">CaptureSelectionSupport</string>
          <ProtectedString name="Source">local CaptureSelectionSupport = {}

function CaptureSelectionSupport.buildCaptureResult(timeline, targetPaths)
	local capturedKeys = {}
	local messages = {}
	for _, targetPath in ipairs(targetPaths or {}) do
		local success, message = timeline:captureTrackFrame(targetPath)
		if success then
			table.insert(capturedKeys, {
				jointPath = targetPath,
				frame = timeline:getCurrentFrame(),
			})
		elseif message then
			table.insert(messages, message)
		end
	end
	return capturedKeys, messages
end

function CaptureSelectionSupport.buildTrackCaptureMessage(track, capturedCount, currentFrame)
	if track and track.trackType == "Rig Group" then
		return string.format("Added %d rig keyframes at frame %d.", capturedCount, currentFrame)
	end
	return string.format("Added keyframe at frame %d.", currentFrame)
end

return CaptureSelectionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX124">
        <Properties>
          <string name="Name">CaptureTrackPathSupport</string>
          <ProtectedString name="Source">local SelectedTrackPathSupport = require(script.Parent:WaitForChild("SelectedTrackPathSupport"))
local PropertyKeyframeValueService = require(script.Parent:WaitForChild("PropertyKeyframeValueService"))
local TrackPropertyDefaultsService = require(script.Parent:WaitForChild("TrackPropertyDefaultsService"))

local CaptureTrackPathSupport = {}

local function isPropertyContainerObjectTrack(track)
	local instance = track and track.instance
	return instance ~= nil
		and instance.Parent ~= nil
		and PropertyKeyframeValueService.isPostEffectInstance(instance)
end

local function getOrCreateChildPropertyTrackPaths(timeline, track)
	if not (track and type(timeline.getChildPropertyTrackPaths) == "function") then
		return {}
	end
	local childPaths = timeline:getChildPropertyTrackPaths(track.path)
	if #childPaths == 0 then
		TrackPropertyDefaultsService.addDefaultLightPropertyTracks(timeline, track)
		childPaths = timeline:getChildPropertyTrackPaths(track.path)
	end
	return childPaths
end

local function addExpandedTrackPaths(timeline, expanded, seen, path)
	local track = timeline:getTrackByPath(path)
	if track and track.trackType == "Rig Group" then
		for _, rigPath in ipairs(timeline:getRigTrackPaths(track.rigName)) do
			if not seen[rigPath] then
				seen[rigPath] = true
				table.insert(expanded, rigPath)
			end
		end
		return
	end

	if track and isPropertyContainerObjectTrack(track) then
		local childPaths = getOrCreateChildPropertyTrackPaths(timeline, track)
		if #childPaths &gt; 0 then
			for _, childPath in ipairs(childPaths) do
				if not seen[childPath] then
					seen[childPath] = true
					table.insert(expanded, childPath)
				end
			end
			return
		end
	end

	if path and not seen[path] then
		seen[path] = true
		table.insert(expanded, path)
	end
end

function CaptureTrackPathSupport.getCaptureTrackPaths(timeline, selectedTrackPaths, selectedJointPath)
	local selected = SelectedTrackPathSupport.getSelectedTrackPaths(timeline, selectedTrackPaths)
	if #selected &gt; 0 then
		local expanded = {}
		local seen = {}

		for _, path in ipairs(selected) do
			addExpandedTrackPaths(timeline, expanded, seen, path)
		end

		return expanded
	end

	if selectedJointPath and timeline:getTrackByPath(selectedJointPath) then
		local track = timeline:getTrackByPath(selectedJointPath)
		if track and track.trackType == "Rig Group" then
			return timeline:getRigTrackPaths(track.rigName)
		end
		if track and isPropertyContainerObjectTrack(track) then
			local childPaths = getOrCreateChildPropertyTrackPaths(timeline, track)
			if #childPaths &gt; 0 then
				return childPaths
			end
		end
		return { selectedJointPath }
	end

	return {}
end

return CaptureTrackPathSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX125">
        <Properties>
