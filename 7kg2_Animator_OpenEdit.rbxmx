local function addRigModel(rig, message)
	if RigInsertService.prepareExternalRigForBinding then
		RigInsertService.prepareExternalRigForBinding(rig)
	elseif RigInsertService.rebindAvatarAccessories then
		RigInsertService.rebindAvatarAccessories(rig)
	end
	local success, addMessage = require(Modules:WaitForChild("RigBindingActionSupport")).addRigModel({
		message = message,
		onAdded = function(addedRig, rigData)
			selectedJointPath = rigData.motors[1] and rigData.motors[1].path or nil
			selectedTrackPaths = {}
			clearSelectedKeyframes()
			SelectionService.setSelection({ addedRig })
		end,
		rig = rig,
		rigService = RigService,
		rigWorkspaceLockService = RigWorkspaceLockService,
		timeline = timeline,
	})
	refreshUi(addMessage)
	return success
end

local function hasWorkspaceRigNameConflict(rig, selectedRigs)
	return require(Modules:WaitForChild("RigSelectionValidationSupport")).hasWorkspaceRigNameConflict(workspace, RigService, rig, selectedRigs)
end

function addSelectedRigs(allowLastSelection, selectedRigsOverride)
	local success, message = require(Modules:WaitForChild("RigBindingActionSupport")).addSelectedRigs({
		addRigModel = addRigModel,
		allowLastSelection = allowLastSelection,
		changeHistoryService = ChangeHistoryService,
		discardPendingUndo = function()
			historyService:discardPendingUndo()
		end,
		hasWorkspaceRigNameConflict = hasWorkspaceRigNameConflict,
		prepareRigForBinding = function(rig)
			if RigInsertService.prepareExternalRigForBinding then
				RigInsertService.prepareExternalRigForBinding(rig)
			elseif RigInsertService.rebindAvatarAccessories then
				RigInsertService.rebindAvatarAccessories(rig)
			end
		end,
		pushUndo = pushUndo,
		rigService = RigService,
		selectionService = selectedRigsOverride and {
			getSelectedRigs = function()
				return selectedRigsOverride
			end,
		} or SelectionService,
		showDuplicateNameAlert = function(duplicateNameMessage)
			widgetController:showAlert("Rig Names Must Be Unique", duplicateNameMessage)
		end,
		timeline = timeline,
		useExistingRig = function(entry)
			if RigInsertService.prepareExternalRigForBinding then
				RigInsertService.prepareExternalRigForBinding(entry.rig)
			elseif RigInsertService.rebindAvatarAccessories then
				RigInsertService.rebindAvatarAccessories(entry.rig)
			end
			local wasActivated = type(timeline.setActiveRig) == "function" and timeline:setActiveRig(entry.rig)
			if wasActivated then
				selectedJointPath = entry.rigData.motors[1] and entry.rigData.motors[1].path or selectedJointPath
				selectedTrackPaths = {}
				clearSelectedKeyframes()
				SelectionService.setSelection({ entry.rig })
				return true
			end
			return false
		end,
		validationSupport = require(Modules:WaitForChild("RigSelectionValidationSupport")),
	})
	if not success then
		refreshUi(message)
		return false, message
	end
	refreshUi(message)
	return success, message
end

editorActions.bindMotionBuilderRig = function()
	return addSelectedRigs(true)
end

