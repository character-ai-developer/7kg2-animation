		enabled = "Enabled",
		fillColor = "FillColor",
		outlineColor = "OutlineColor",
		fillTransparency = "FillTransparency",
		outlineTransparency = "OutlineTransparency",
	},
}

local RESTORE_STATE_KEY = "_megmoRestoreState"

local function cloneValue(value)
	if typeof(value) == "table" then
		local clone = {}
		for key, childValue in pairs(value) do
			clone[key] = cloneValue(childValue)
		end
		return clone
	end
	return value
end

local function trim(text)
	return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function normalizeEffectType(effectType)
	local raw = tostring(effectType or "")
	raw = ALIASES[raw] or raw:gsub("%s+", "")
	return EFFECT_DEFINITIONS[raw] and raw or "Lighting"
end

local function parseColor(text)
	if typeof(text) == "Color3" then
		return text
	end
	local raw = trim(text)
	local hex = raw:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
	end
	local values = {}
	for token in raw:gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value then
			table.insert(values, value)
		end
	end
	if #values &lt; 3 then
		return nil
	end
	if values[1] &lt;= 1 and values[2] &lt;= 1 and values[3] &lt;= 1 then
		return Color3.new(math.clamp(values[1], 0, 1), math.clamp(values[2], 0, 1), math.clamp(values[3], 0, 1))
	end
	return Color3.fromRGB(
		math.clamp(math.floor(values[1] + 0.5), 0, 255),
		math.clamp(math.floor(values[2] + 0.5), 0, 255),
		math.clamp(math.floor(values[3] + 0.5), 0, 255)
	)
end

local function formatNumber(value)
	local number = tonumber(value)
	if not number then
		return ""
	end
	local text = string.format("%.3f", number)
	return text:gsub("0+$", ""):gsub("%.$", "")
end

local function formatColor(color)
	if typeof(color) ~= "Color3" then
		return ""
	end
	return string.format("%d,%d,%d", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function choiceValue(value, choices, fallback)
	local text = trim(value)
	for _, choice in ipairs(choices or {}) do
		if string.lower(text) == string.lower(tostring(choice)) then
			return choice
		end
	end
	return fallback
end

local function parseBoolean(value)
	if type(value) == "boolean" then
		return value
	end
	local text = string.lower(trim(value))
	return text == "true" or text == "1" or text == "yes" or text == "on" or text == "enabled"
end

local function clampNumber(value, field, fallback)
	local number = tonumber(value)
	if not number then
		return fallback
	end
	if field.min ~= nil or field.max ~= nil then
		number = math.clamp(number, field.min or -math.huge, field.max or math.huge)
	end
	return number
end

local function normalizeAssetId(value)
	local raw = trim(value)
	if raw == "" then
		return ""
	end
	local id = raw:match("rbxassetid://(%d+)") or raw:match("[?&amp;]id=(%d+)") or raw:match("^(%d+)$")
	if id then
		return "rbxassetid://" .. id
	end
	return raw
end

local function getEffectInstance(definition)
	if definition.id == "Lighting" then
		return Lighting
	end
	if definition.id == "Highlight" then
		local existing = workspace:FindFirstChild(definition.instanceName)
		if existing and existing:IsA("Highlight") then
			return existing
		end
		local highlight = Instance.new("Highlight")
		highlight.Name = definition.instanceName
		highlight.Parent = workspace
		return highlight
	end
	local existing = Lighting:FindFirstChild(definition.instanceName)
	if existing and existing.ClassName == definition.instanceClass then
		return existing
	end
	local created = Instance.new(definition.instanceClass)
	created.Name = definition.instanceName
	created.Parent = Lighting
	return created
end

local function findExistingEffectInstance(definition)
	if definition.id == "Lighting" then
		return Lighting
	end
	if definition.id == "Highlight" then
		local existing = workspace:FindFirstChild(definition.instanceName)
		return existing and existing:IsA("Highlight") and existing or nil
	end
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.ClassName == definition.instanceClass and (child.Name == definition.instanceName or child.Name == definition.name) then
			return child
		end
	end
	return nil
end

local function resolveInstancePath(path)
	local raw = trim(path)
	if raw == "" then
		return nil
	end
	if raw:sub(1, 5) == "game." then
		raw = raw:sub(6)
	end
	local current = nil
	for token in raw:gmatch("[^%.]+") do
		if not current then
			if token == "Workspace" or token == "workspace" then
				current = workspace
			elseif token == "Lighting" then
				current = Lighting
			else
				current = game:FindFirstChild(token)
			end
		else
			current = current:FindFirstChild(token)
		end
		if not current then
			return nil
		end
	end
	return current
end

local function safeRead(instance, propertyName, fallback)
	local success, value = pcall(function()
		return instance[propertyName]
	end)
	return success and value ~= nil and value or fallback
end

local function safeWrite(instance, propertyName, value)
	pcall(function()
		instance[propertyName] = value
	end)
end

local function captureInstanceValue(effectId, definition, instance, restoreState)
	local value = cloneValue(definition.defaultValue)
	local propertyMap = PROPERTY_MAP[effectId] or {}
	if instance then
		for key, propertyName in pairs(propertyMap) do
			value[key] = safeRead(instance, propertyName, value[key])
		end
	end
	if effectId == "Highlight" and instance then
		value.adorneePath = instance.Adornee and instance.Adornee:GetFullName() or ""
		value.depthMode = tostring(instance.DepthMode.Name)
	end
	if restoreState then
		value[RESTORE_STATE_KEY] = restoreState
	end
	return value
end

local function restoreCapturedValue(effectId, definition, value)
	local restoreState = type(value) == "table" and value[RESTORE_STATE_KEY] or nil
	if restoreState == "destroy" and effectId ~= "Lighting" then
		local existing = findExistingEffectInstance(definition)
		if existing then
			existing:Destroy()
		end
		return true
	end

	local instance = effectId == "Lighting" and Lighting or getEffectInstance(definition)
	local propertyMap = PROPERTY_MAP[effectId] or {}
	for key, propertyName in pairs(propertyMap) do
		if value[key] ~= nil then
			safeWrite(instance, propertyName, value[key])
		end
	end
	if effectId == "Highlight" then
		if value.depthMode ~= nil then
			local depthMode = value.depthMode == "Occluded" and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
			safeWrite(instance, "DepthMode", depthMode)
		end
		if value.adorneePath ~= nil then
			safeWrite(instance, "Adornee", resolveInstancePath(value.adorneePath))
		end
	end
	return true
end

function LightingEffectTrackService.normalizeEffectType(effectType)
	return normalizeEffectType(effectType)
end

function LightingEffectTrackService.getEffectDefinition(effectType)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	return definition and cloneValue(definition) or nil
end

function LightingEffectTrackService.getTrackEffectType(track)
	if not LightingEffectTrackService.isLightingEffectTrack(track) then
		return nil
	end
	return normalizeEffectType(track.valueType or track.effectType or track.name)
end

function LightingEffectTrackService.getEffectDefinitions()
	local definitions = {}
	for _, effectType in ipairs(EFFECT_ORDER) do
		local definition = EFFECT_DEFINITIONS[effectType]
		table.insert(definitions, {
			id = definition.id,
			name = definition.name,
			description = definition.description,
		})
	end
	return definitions
end

function LightingEffectTrackService.getEditorFields(effectType)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	return definition and cloneValue(definition.fields) or {}
end

function LightingEffectTrackService.getDefaultValueForEffect(effectType)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	return cloneValue(definition.defaultValue)
end

function LightingEffectTrackService.captureCurrentValue(effectType)
	local effectId = normalizeEffectType(effectType)
	local definition = EFFECT_DEFINITIONS[effectId]
	local instance = findExistingEffectInstance(definition)
	local value = captureInstanceValue(effectId, definition, instance, nil)
	return LightingEffectTrackService.normalizeValue(effectId, value)
end

function LightingEffectTrackService.captureOriginalValue(effectType)
	local effectId = normalizeEffectType(effectType)
	local definition = EFFECT_DEFINITIONS[effectId]
	local instance = findExistingEffectInstance(definition)
	if effectId == "Lighting" then
		instance = Lighting
	end
	local restoreState = instance and "restore" or "destroy"
	return captureInstanceValue(effectId, definition, instance, restoreState)
end

function LightingEffectTrackService.getDefaultValueForTrack(track)
	if LightingEffectTrackService.isLightingEffectTrack(track) then
		return LightingEffectTrackService.captureCurrentValue(track.valueType or track.effectType)
	end
	return nil
end

function LightingEffectTrackService.normalizeValue(effectType, value)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	local normalized = cloneValue(definition.defaultValue)
	if type(value) ~= "table" then
		return normalized
	end
	for _, field in ipairs(definition.fields or {}) do
		local incoming = value[field.key]
		if incoming == nil then
			continue
		end
		if field.kind == "boolean" then
			normalized[field.key] = parseBoolean(incoming)
		elseif field.kind == "number" then
			normalized[field.key] = clampNumber(incoming, field, normalized[field.key])
		elseif field.kind == "color" then
			normalized[field.key] = parseColor(incoming) or normalized[field.key]
		elseif field.kind == "choice" then
			normalized[field.key] = choiceValue(incoming, field.choices, normalized[field.key])
		elseif field.kind == "asset" then
			normalized[field.key] = normalizeAssetId(incoming)
		elseif field.kind == "text" then
			normalized[field.key] = string.sub(tostring(incoming or ""), 1, 240)
		end
	end
	return normalized
end

function LightingEffectTrackService.formatFieldValue(field, value)
	if not field then
		return ""
	end
	if field.kind == "color" then
		return formatColor(value)
	elseif field.kind == "number" then
		return formatNumber(value)
	elseif field.kind == "boolean" then
		return value == true and "On" or "Off"
	end
	return tostring(value or "")
end

function LightingEffectTrackService.parseEditorFields(effectType, fieldValues)
	local effectId = normalizeEffectType(effectType)
	local definition = EFFECT_DEFINITIONS[effectId]
	local value = cloneValue(definition.defaultValue)
	for _, field in ipairs(definition.fields or {}) do
		local rawValue = fieldValues and fieldValues[field.key]
		if rawValue == nil then
			continue
		end
		if field.kind == "boolean" then
			value[field.key] = parseBoolean(rawValue)
		elseif field.kind == "number" then
			local number = tonumber(rawValue)
			if not number then
				return false, string.format("%s needs a number.", field.label or field.key)
			end
			value[field.key] = clampNumber(number, field, value[field.key])
		elseif field.kind == "color" then
			local color = parseColor(rawValue)
			if not color then
				return false, string.format("%s needs RGB like 255,255,255 or #ffffff.", field.label or field.key)
			end
			value[field.key] = color
		elseif field.kind == "choice" then
			value[field.key] = choiceValue(rawValue, field.choices, value[field.key])
		elseif field.kind == "asset" then
			value[field.key] = normalizeAssetId(rawValue)
		elseif field.kind == "text" then
			value[field.key] = string.sub(tostring(rawValue or ""), 1, 240)
		end
	end
	return true, value
end

function LightingEffectTrackService.isLightingEffectTrack(track)
	return track and track.trackType == LightingEffectTrackService.TRACK_TYPE
end

function LightingEffectTrackService.findTrack(timeline, effectType)
	local effectId = normalizeEffectType(effectType)
	for _, track in ipairs(timeline:getTracks()) do
		if LightingEffectTrackService.isLightingEffectTrack(track) and normalizeEffectType(track.valueType or track.effectType) == effectId then
			return track
		end
	end
	return nil
end

function LightingEffectTrackService.addTrack(timeline, effectType, options)
	options = type(options) == "table" and options or {}
	local effectId = normalizeEffectType(effectType)
	local definition = EFFECT_DEFINITIONS[effectId]
	local existingTrack = LightingEffectTrackService.findTrack(timeline, effectId)
	local parentTrack = nil
	local changedExistingTrack = false
	if effectId ~= "Lighting" then
		parentTrack = timeline and LightingEffectTrackService.findTrack(timeline, "Lighting") or nil
		if not parentTrack and timeline then
			local lightingDefinition = EFFECT_DEFINITIONS.Lighting
			parentTrack = timeline:addGenericTrack("LightingEffect", nil, lightingDefinition.trackName or lightingDefinition.name, {
				effectType = "Lighting",
				sortOrder = lightingDefinition.sortOrder or 3,
			})
			changedExistingTrack = true
		end
	end
	if existingTrack then
		if effectId ~= "Lighting" and parentTrack and not existingTrack.parentTrackPath then
			existingTrack.parentTrackPath = options.parentTrackPath or parentTrack.path
			existingTrack.parentTrackName = parentTrack.name or "Lighting"
			changedExistingTrack = true
		end
		return existingTrack, changedExistingTrack
	end
	return timeline:addGenericTrack("LightingEffect", nil, definition.trackName or definition.name, {
		effectType = effectId,
		parentTrackPath = effectId ~= "Lighting" and (options.parentTrackPath or (parentTrack and parentTrack.path)) or nil,
		parentTrackName = effectId ~= "Lighting" and ((parentTrack and parentTrack.name) or "Lighting") or nil,
		sortOrder = definition.sortOrder or 3,
	}), true
end

function LightingEffectTrackService.applyTrackValue(track, value)
	if not LightingEffectTrackService.isLightingEffectTrack(track) then
		return false
	end
	local effectId = normalizeEffectType(track.valueType or track.effectType or track.name)
	local definition = EFFECT_DEFINITIONS[effectId]
	if type(value) == "table" and value[RESTORE_STATE_KEY] then
		return restoreCapturedValue(effectId, definition, value)
	end
	local normalized = LightingEffectTrackService.normalizeValue(effectId, value)
	local instance = getEffectInstance(definition)
	local propertyMap = PROPERTY_MAP[effectId] or {}
	for key, propertyName in pairs(propertyMap) do
		if normalized[key] ~= nil then
			safeWrite(instance, propertyName, normalized[key])
		end
	end
	if effectId == "Highlight" then
		local depthMode = normalized.depthMode == "Occluded" and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
		safeWrite(instance, "DepthMode", depthMode)
		local adornee = resolveInstancePath(normalized.adorneePath)
		if adornee then
			safeWrite(instance, "Adornee", adornee)
		end
	end
	return true
end

function LightingEffectTrackService.applyTimelineEffects(timeline, frame)
	local pose = timeline:samplePose(frame or timeline:getCurrentFrame())
	if type(pose) ~= "table" then
		return
	end
	for _, track in ipairs(timeline:getTracks()) do
		if LightingEffectTrackService.isLightingEffectTrack(track) and not timeline:isTrackDisabled(track.path) then
			local value = pose[track.path]
			if value ~= nil then
				LightingEffectTrackService.applyTrackValue(track, value)
			end
		end
	end
end

return LightingEffectTrackService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX159">
        <Properties>
          <string name="Name">MainShortcutPluginActions</string>
          <ProtectedString name="Source">local MainShortcutPluginActions = {}

local createdActions = {}
local actionConnections = {}

local ACTIONS = {
	{
		id = "MegMoMainTimelineCopyKeys",
		text = "7kg2 Main: Copy Keyframes",
		statusTip = "Copy selected 7kg2 timeline keyframes when the Main timeline owns shortcut focus.",
		method = "copySelectedKeys",
		hint = "Last shortcut: Ctrl+C -&gt; Copy",
	},
	{
		id = "MegMoMainTimelinePasteKeys",
		text = "7kg2 Main: Paste Keyframes",
		statusTip = "Paste copied 7kg2 timeline keyframes at the playhead when the Main timeline owns shortcut focus.",
		method = "pasteKeysAtPlayhead",
		hint = "Last shortcut: Ctrl+V -&gt; Paste",
	},
	{
		id = "MegMoMainTimelineCutKeys",
		text = "7kg2 Main: Cut Keyframes",
		statusTip = "Cut selected 7kg2 timeline keyframes when the Main timeline owns shortcut focus.",
		method = "cutSelectedKeys",
		hint = "Last shortcut: Ctrl+X -&gt; Cut",
	},
	{
		id = "MegMoMainTimelineDeleteKeys",
		text = "7kg2 Main: Delete Keyframes",
		statusTip = "Delete selected 7kg2 timeline keyframes when the Main timeline owns shortcut focus.",
		method = "deleteCurrentFrame",
		hint = "Last shortcut: Ctrl+D -&gt; Delete",
	},
	{
		id = "MegMoMainTimelineUndo",
		text = "7kg2 Main: Undo Timeline Edit",
		statusTip = "Undo the last 7kg2 timeline edit when the Main timeline owns shortcut focus.",
		method = "undoLastEdit",
		hint = "Last shortcut: Ctrl+Z -&gt; Undo",
	},
	{
		id = "MegMoMainTimelineRedo",
		text = "7kg2 Main: Redo Timeline Edit",
		statusTip = "Redo the last 7kg2 timeline edit when the Main timeline owns shortcut focus.",
		method = "redoLastEdit",
		hint = "Last shortcut: Ctrl+Y -&gt; Redo",
	},
}

local SELECT_ALL_ACTION = {
	id = "MegMoMainTimelineSelectAllKeys",
	text = "7kg2 Main: Select All Keyframes",
	statusTip = "Select all 7kg2 timeline keyframes, or all keyframes for selected tracks.",
}

local function debug(controller, eventName, ...)
	if controller and type(controller._mainShortcutDebug) == "function" then
		controller:_mainShortcutDebug(eventName, ...)
	end
end

local function setHint(controller, hint)
	if controller and type(controller._setShortcutHint) == "function" then
		controller:_setShortcutHint(hint)
	end
end

local function ownsMainTimeline(options)
	local widget = options and options.widget
	local controller = options and options.widgetController
	return widget
		and widget.Enabled == true
		and widget:GetAttribute("MegMoHiddenForMicro") ~= true
		and controller
		and type(controller._ownsMainTimelineShortcuts) == "function"
		and controller:_ownsMainTimelineShortcuts()
end

local function clearStudioSelectionSoon(controller)
	if not controller or type(controller._clearStudioSelectionForTimelineKeys) ~= "function" then
		return
	end

	task.defer(function()
		controller:_clearStudioSelectionForTimelineKeys()
	end)
	task.delay(0.05, function()
		controller:_clearStudioSelectionForTimelineKeys()
	end)
end

local function runSelectAll(options)
	local controller = options.widgetController
	local viewModel = controller and controller._lastViewModel or {}
	local hasSelectedTracks = type(viewModel.selectedTrackPaths) == "table" and #viewModel.selectedTrackPaths &gt; 0
	local hasSelectedKeys = type(viewModel.selectedKeys) == "table" and #viewModel.selectedKeys &gt; 0
	local scopeMode = (hasSelectedTracks and not hasSelectedKeys) and "track" or "timeline"

	options.selectAllKeys(scopeMode)
	clearStudioSelectionSoon(controller)
	setHint(controller, scopeMode == "track" and "Last shortcut: Ctrl+A -&gt; Select All Track Keys" or "Last shortcut: Ctrl+A -&gt; Select All Timeline Keys")
end

local function bindAction(options, actionInfo, runner)
	local plugin = options.plugin
	local controller = options.widgetController
	local actionId = actionInfo.id

	if not plugin or type(plugin.CreatePluginAction) ~= "function" then
		debug(controller, "PluginAction:createSkipped", "source=" .. tostring(actionId), "result=Ignored", "reason=CreatePluginActionUnavailable")
		return nil
	end
	if createdActions[actionId] then
		local existingConnection = actionConnections[actionId]
		if existingConnection and type(existingConnection.Disconnect) == "function" then
			pcall(function()
				existingConnection:Disconnect()
			end)
		end
		local action = createdActions[actionId]
		local connected = nil
		pcall(function()
			connected = action.Triggered:Connect(function()
				if not ownsMainTimeline(options) then
					debug(controller, "PluginAction:passNoTimelineOwner", "source=" .. tostring(actionId), "result=Pass", "reason=noTimelineOwner")
					return
				end

				debug(controller, "PluginAction:triggered", "source=" .. tostring(actionId), "result=Sink")
				local success, messageOrErr = pcall(runner)
				if not success then
					debug(controller, "PluginAction:failed", "source=" .. tostring(actionId), "result=Ignored", "reason=" .. tostring(messageOrErr))
				end
			end)
		end)
		actionConnections[actionId] = connected
		debug(controller, "PluginAction:rebound", "source=" .. tostring(actionId), "result=Info", "reason=existingAction")
		return action
	end

	local ok, actionOrErr = pcall(function()
		return plugin:CreatePluginAction(actionId, actionInfo.text, actionInfo.statusTip, "", true)
	end)
	if not ok or not actionOrErr then
		debug(controller, "PluginAction:createFailed", "source=" .. tostring(actionId), "result=Ignored", "reason=" .. tostring(actionOrErr))
		return nil
	end

	local action = actionOrErr
	createdActions[actionId] = action
	local connected = nil
	pcall(function()
		connected = action.Triggered:Connect(function()
			if not ownsMainTimeline(options) then
				debug(controller, "PluginAction:passNoTimelineOwner", "source=" .. tostring(actionId), "result=Pass", "reason=noTimelineOwner")
				return
			end

			debug(controller, "PluginAction:triggered", "source=" .. tostring(actionId), "result=Sink")
			local success, messageOrErr = pcall(runner)
			if not success then
				debug(controller, "PluginAction:failed", "source=" .. tostring(actionId), "result=Ignored", "reason=" .. tostring(messageOrErr))
			end
		end)
	end)
	actionConnections[actionId] = connected
	debug(controller, "PluginAction:created", "source=" .. tostring(actionId), "result=Created", "reason=allowBinding")
	return action
end

function MainShortcutPluginActions.register(options)
	if type(options) ~= "table" then
		return
	end

	for _, actionInfo in ipairs(ACTIONS) do
		local callback = options[actionInfo.method]
		if type(callback) == "function" then
			bindAction(options, actionInfo, function()
				callback()
				setHint(options.widgetController, actionInfo.hint)
			end)
		end
	end

	if type(options.selectAllKeys) == "function" then
		bindAction(options, SELECT_ALL_ACTION, function()
			runSelectAll(options)
		end)
	end
end

return MainShortcutPluginActions
</ProtectedString>
