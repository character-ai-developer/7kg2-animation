	applyResponsiveLayout = function()
		local panelSize = panel.AbsoluteSize
		local layoutScale = getLayoutScale()
		local contentWidth = math.max(320, ((panelSize.X &gt; 0 and panelSize.X or 1000) / layoutScale) - 8)
		local panelHeight = (panelSize.Y &gt; 0 and panelSize.Y or 320) / layoutScale
		local compact = contentWidth &lt; 760 or panelHeight &lt; 260
		local margin = 12
		local gap = 8
		local headerOffset = useOwnPanel and 40 or 4
		local collapsedHeight = 32
		local function sectionHeight(sectionId, expandedHeight)
			return isSectionCollapsed(sectionId) and collapsedHeight or expandedHeight
		end

		contentScroll.ScrollBarThickness = compact and 5 or 0
		contentScroll.Size = UDim2.new(1, 0, 1, 0)

		if compact then
			local cardWidth = contentWidth - (margin * 2)
			local cardHeight = 96
			local rigHeight = sectionHeight("rig", cardHeight)
			local markerHeight = sectionHeight("markers", cardHeight)
			local rigY = headerOffset
			local markerY = rigY + rigHeight + gap
			local motionsY = markerY + markerHeight + gap
			local expandedMotionsHeight = math.max(190, math.min(320, panelHeight - 24))
			local motionsHeight = sectionHeight("motions", expandedMotionsHeight)
			local buildY = motionsY + motionsHeight + gap
			local buildHeight = sectionHeight("build", cardHeight)
			local cameraY = buildY + buildHeight + gap
			local cameraHeight = sectionHeight("camera", cardHeight)
			local contentHeight = cameraY + cameraHeight + 16

			rigCard.Position = UDim2.new(0, margin, 0, rigY)
			rigCard.Size = UDim2.new(0, cardWidth, 0, rigHeight)
			addMarkersCard.Position = UDim2.new(0, margin, 0, markerY)
			addMarkersCard.Size = UDim2.new(0, cardWidth, 0, markerHeight)
			motionsPreviewFrame.Position = UDim2.new(0, margin, 0, motionsY)
			motionsPreviewFrame.Size = UDim2.new(0, cardWidth, 0, motionsHeight)
			buildCard.Position = UDim2.new(0, margin, 0, buildY)
			buildCard.Size = UDim2.new(0, cardWidth, 0, buildHeight)
			cameraCard.Position = UDim2.new(0, margin, 0, cameraY)
			cameraCard.Size = UDim2.new(0, cardWidth, 0, cameraHeight)
			content.Size = UDim2.new(1, -8, 0, contentHeight)
			return
		end

		local topY = useOwnPanel and 40 or 4
		local minCardHeight = 96
		local workflowWidth = math.max(240, math.floor(contentWidth * workflowColumnWidth))
		local buildWidth = math.max(180, math.floor(contentWidth * buildColumnWidth))
		local motionsX = workflowWidth + gap
		local motionsWidth = math.max(360, contentWidth - motionsX - buildWidth - (gap * 2))
		local buildX = motionsX + motionsWidth + gap
		local contentHeight = math.max(panelHeight, topY + (minCardHeight * 2) + gap + 20)
		local columnBottom = contentHeight - 4
		local sideCardHeight = math.clamp(math.floor((columnBottom - topY - gap) / 2), minCardHeight, 168)
		local rigHeight = sectionHeight("rig", sideCardHeight)
		local markerHeight = sectionHeight("markers", sideCardHeight)
		local buildHeight = sectionHeight("build", sideCardHeight)
		local cameraHeight = sectionHeight("camera", sideCardHeight)
		local motionsHeight = sectionHeight("motions", contentHeight - topY - 4)

		rigCard.Position = UDim2.new(0, margin, 0, topY)
		rigCard.Size = UDim2.new(0, workflowWidth - margin - 6, 0, rigHeight)
		addMarkersCard.Position = UDim2.new(0, margin, 0, topY + rigHeight + gap)
		addMarkersCard.Size = UDim2.new(0, workflowWidth - margin - 6, 0, markerHeight)
		buildCard.Position = UDim2.new(0, buildX, 0, topY)
		buildCard.Size = UDim2.new(0, buildWidth - margin, 0, buildHeight)
		cameraCard.Position = UDim2.new(0, buildX, 0, topY + buildHeight + gap)
		cameraCard.Size = UDim2.new(0, buildWidth - margin, 0, cameraHeight)
		motionsPreviewFrame.Position = UDim2.new(0, motionsX, 0, topY)
		motionsPreviewFrame.Size = UDim2.new(0, motionsWidth, 0, motionsHeight)
		content.Size = UDim2.new(1, -8, 0, contentHeight)
	end

	panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyResponsiveLayout)
	if parent and parent.GetAttributeChangedSignal then
		parent:GetAttributeChangedSignal("MegMoLayoutScale"):Connect(applyResponsiveLayout)
	end
	task.defer(applyResponsiveLayout)

	refs._motionBuilderPanel = panel
	refs._motionRigValueLabel = rigValue
	refs._motionSelectRigButton = selectRigButton
	refs._motionAddMarkerButton = addMarkerButton
	refs._motionDeleteMarkerButton = clearMarkersButton
	refs._motionClearMarkersButton = resetMarkersButton
	refs._motionAddCameraButton = addCameraButton
	refs._motionCameraEffectsButton = cameraEffectsButton
	refs._motionResetSegmentsButton = autoFillMotionsButton
	refs._motionSaveRecipeButton = saveRecipeButton
	refs._motionOpenRecipesButton = openRecipesButton
	refs._motionPreviewPathButton = previewPathButton
	refs._motionDefaultsFrame = defaultsFrame
	refs._motionSegmentsList = segmentList
	refs._motionSegmentsEmptyLabel = segmentEmptyLabel
	refs._motionSegmentSummaryLabel = segmentSummary
	refs._motionCreateAnimationButton = createAnimationButton

	for _, descendant in ipairs(content:GetDescendants()) do
		if descendant:IsA("TextButton") then
			strengthenButtonGradient(descendant)
		end
	end

	return refs
end

function MotionBuilderUI.update(_context)
end

function MotionBuilderUI.destroy()
end

return MotionBuilderUI
