		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -34),
		Size = UDim2.new(1, -24, 0, 26),
		Parent = browser,
	})
	local countLabel = create("TextLabel", {
		Name = "ProjectCount",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
