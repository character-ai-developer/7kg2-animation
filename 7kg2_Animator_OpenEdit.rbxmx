            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local HelpUI = {}

local create = UiHelpers.create
local styleInput = UiHelpers.styleInput
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createListLayout = UiHelpers.createListLayout
local applySectionSurface = UiHelpers.applySectionSurface

local GUIDE_ORDER = {
	"HelpQuickAnswers",
	"HelpGettingStarted",
	"HelpMotionBuilder",
	"HelpTimeline",
	"HelpPoseTools",
	"HelpCutsceneMaker",
	"HelpFaces",
	"HelpSoundAndMusic",
	"HelpImportExport",
	"HelpR15ToR6Converter",
	"HelpEffects",
	"HelpPhysics",
	"HelpTroubleshooting",
	"HelpShortcuts",
	"HelpSupport",
}

local GUIDES = {
	HelpQuickAnswers = {
		title = "What do I want to do?",
		subtitle = "Fast answers for common beginner goals.",
		sections = {
			{
				heading = "Animate a rig manually",
				body = "Add a rig, select a body-part track, choose Move Tool or Rotate Tool, pose the rig in the Studio viewport, then click Add Keyframe. Scrub forward and repeat.",
			},
			{
				heading = "Make a rig walk or run between points",
				body = "Open Motion Builder, click Add Marker for each waypoint, move the markers in Workspace, choose Walk or Run for each segment, preview the path, then Build Timeline.",
			},
			{
				heading = "Use one of my own animations",
				body = "Open Presets or Import, choose My Animations, preview the animation, then import it. In Motion Builder, choose Custom from a motion default or style picker to use your own clip.",
			},
			{
				heading = "Convert an R15 animation to R6",
				body = "Open Presets, click R15 -&gt; R6, load an R15 animation by ID or Explorer selection, preview it, then convert, save, or import the R6 result.",
			},
			{
				heading = "Add a camera or object movement",
				body = "Use Track &gt; Add Camera Track, Track &gt; Add Object Track, or Track &gt; Add Rig CFrame. Select the track, move or rotate the target, then Add Keyframe.",
			},
			{
				heading = "Move and key a whole rig or scene object",
				body = "Toggle Free Grab in Animation Settings or the Micro viewport strip. Its hand is white when ready and red while armed. Click-drag any limb to move its whole rig Model, or click-drag another Model or standalone Part. Tracked targets get a CFrame key at the playhead. Toggle Free Grab off or click back inside 7kg2 to return to normal posing.",
			},
			{
				heading = "Add a fade or screen effect",
				body = "Open Effects, add a Fade track, select the effect keyframe, then use Keypad 7 or Tools &gt; Open Options to change color and transparency.",
			},
			{
				heading = "Add real physics to an animation",
				body = "Open Physics, choose the effect that matches the shot, follow the highlighted Setup and Capture steps, preview the captured take when you are ready, then bake it to the timeline.",
			},
			{
				heading = "Export a playable cutscene",
				body = "Open Cutscene, choose Playback, Trigger, Character, and Sound options, then click Generate Package. 7kg2 creates ReplicatedStorage &gt; MegMoCutscenes with scripts and a READ ME.",
			},
			{
				heading = "Play the cutscene as the player",
				body = "In Cutscene &gt; Character, choose Player Avatar. 7kg2 uses your dummy animation as the template, then plays it on a temporary clone of the triggering player's avatar.",
			},
			{
				heading = "Change faces during an animation",
				body = "Open Faces, create Single or Layered face presets, then click a preset to add a face keyframe at the playhead and update the selected rig immediately.",
			},
		},
	},
	HelpGettingStarted = {
		title = "Getting Started",
		subtitle = "A quick path from empty workspace to first editable animation.",
		sections = {
			{
				heading = "1. Add or select a rig",
				body = "Use Rig &gt; Insert R15 Classic, Rig &gt; Insert R6 Rig, or select an existing rig in Workspace and click Add Rig. Each rig should have a unique name before adding it to the timeline.",
			},
			{
				heading = "2. Choose what you want to key",
				body = "Select a rig part track, click a rig body part in the viewport while part picking is active, or choose a Rig CFrame, Camera, Object, Model, or Screen Effect track. Add Keyframe only writes to selected tracks, which keeps the timeline clean.",
			},
			{
				heading = "3. Pose, move, or rotate",
				body = "Use Animation Settings to switch between Move Tool, Rotate Tool, Trackball Rotate, and Trackball Move. R toggles Move/Rotate, and Y toggles Local/World transform space when Trackball is not active.",
			},
			{
				heading = "4. Place whole scene objects with Free Grab",
				body = "Toggle Free Grab, then click-drag rigs, Models, or standalone Parts directly in the Studio viewport. The hand turns red while armed. If the target is already on the timeline, Free Grab adds or updates its CFrame key at the playhead. Moving a bound rig automatically adds its Rig CFrame track when needed. Toggle Grab off or click back inside 7kg2 before resuming limb posing.",
			},
			{
				heading = "5. Record motion",
				body = "Select one or more same-frame rig tracks, choose Trackball Rotate or Trackball Move, then press Shift+R or click Record Motion. 7kg2 records your Trackball movement and converts it into editable keyframes. Right-click remains available for Studio camera rotation while recording; Escape cancels.",
			},
			{
				heading = "6. Save often",
				body = "Use File &gt; Save to create a 7kg2 save in ServerStorage. In Micro, reopen it from Project &amp; Session Summary. Main also keeps File &gt; Import &gt; Saved as a fallback.",
			},
			{
				heading = "7. Use Preview Bake for heavier timelines",
				body = "Click Bake before playback if the animation has lots of keys. 7kg2 prepares a preview cache so playback can start smoother without rebuilding the timeline.",
			},
		},
	},
	HelpMotionBuilder = {
		title = "Motion Builder",
		subtitle = "Use workspace markers to build path animations quickly.",
		sections = {
			{
				heading = "1. Select the rig",
				body = "Add your rig to 7kg2, then use Select Rig in Studio if you need the workspace selection to match.",
			},
			{
				heading = "2. Place markers",
				body = "Click Add Marker for each waypoint. Move the marker parts in Workspace. 7kg2 keeps the rig at the correct height above each marker.",
			},
			{
				heading = "3. Pick motion and style",
				body = "Each row controls the movement between two markers. Choose Walk, Run, Jump, Climb, or Path Only, then choose a style or custom animation.",
			},
			{
				heading = "4. Add pauses if needed",
				body = "Set Pause to hold at a marker. If you choose an Idle Style, 7kg2 adds idle keyframes during the pause instead of leaving the rig frozen.",
			},
			{
				heading = "5. Preview, then build",
				body = "Use Preview to test the path without changing timeline keys. Use Build Timeline when the route looks right.",
			},
			{
				heading = "6. Add camera help",
				body = "Use the Camera step to add a camera track or open camera effects. This keeps camera setup close to the marker workflow instead of hiding it elsewhere.",
			},
		},
	},
	HelpTimeline = {
		title = "Timeline Editing",
		subtitle = "The familiar keyframe workflow for keys and tracks.",
		sections = {
			{
				heading = "Scrub",
				body = "Click or drag across the ruler area to move the playhead. Use the zoom controls to see more or less timeline detail.",
			},
			{
				heading = "Select keyframes",
				body = "Click a keyframe, right-click keys to add more keys to the selection, press N or use the Multi Select toggle, or drag a selection box over multiple keyframes.",
			},
			{
				heading = "Move keyframes",
				body = "Drag selected keyframes along the timeline. Grouping can make a large set behave as one editable block. A single selected track group moves independently; select more groups only when you want them to move together.",
			},
			{
				heading = "Edit groups and Physics Clips",
				body = "Select a group block to move it or open its options for Split at Playhead, Stretch, Repeat, or other timing edits. Ungroup exposes the individual keyframes for fine adjustment. Selecting a group does not move the playhead; click the ruler when you want to change time.",
			},
			{
				heading = "Track rows",
				body = "Double-click a track name to add a keyframe at the playhead. Double-click the Rig row to add default keys across that rig.",
			},
			{
				heading = "Keep the playhead still while editing",
				body = "Clicking a keyframe selects it without moving the playhead. To move the playhead, click empty timeline space or drag the playhead/ruler area.",
			},
		},
	},
	HelpPoseTools = {
		title = "Pose Tools",
		subtitle = "Move, rotate, preview, and pose rigs with less guesswork.",
		sections = {
			{
				heading = "Move and Rotate tools",
				body = "Select a track or keyframe, then use Move Tool or Rotate Tool in Animation Settings. The gizmo edits the selected animation target and writes back to keyframes.",
			},
			{
				heading = "Trackball controls",
				body = "Use Trackball Rotate or Trackball Move for camera-relative posing. T starts Trackball Rotate, Shift+T starts Trackball Move, X/Y/Z lock an axis while Trackball is active, Shift is fine movement, Ctrl snaps, and Escape/right click cancels. While Record Motion is armed, right-click rotates the Studio camera and Escape cancels.",
			},
			{
				heading = "Viewport part selection",
				body = "Press H to enable part picking, then hover and click body parts directly in the Studio viewport. With Multi Select on, you can click multiple body parts and move, rotate, or Trackball them together.",
			},
			{
				heading = "Free Grab",
				body = "Free Grab places whole scene objects and writes animation placement for tracked targets. Its hand is white when ready and red while armed. Click-dragging a rig limb moves the containing rig Model, and you can immediately grab another Model or standalone Part. On release, 7kg2 adds or updates the matching CFrame key at the playhead; a bound rig gets a Rig CFrame track automatically when needed. Untracked objects still move with Studio Undo but are not keyed. Toggle Grab off or click anywhere back inside 7kg2 to restore body-part picking and 7kg2 gizmos.",
			},
			{
				heading = "Rig handles",
				body = "Press Shift+B or use Tools &gt; Rig/Bone Handles to show selectable handles on rig parts and skinned-mesh bones. Use the viewport part picker to click the visible handles without changing the animation.",
			},
			{
				heading = "Motion Recorder",
				body = "Press Shift+R or click Record Motion to perform a pose with Trackball instead of placing every key manually. Recording starts on the first Trackball movement, stops when you release or after the time limit, then writes editable keyframes. Right-click remains available for Studio camera rotation; Escape cancels.",
			},
			{
				heading = "Multiple recorded tracks",
				body = "Select multiple rig tracks or same-frame keyframes before recording to capture several joints together. This is useful for recording both arms, both legs, or a head-and-torso motion in one pass.",
			},
			{
				heading = "Onion skin",
				body = "Use the Onion button in Keyframe Tools or press B to show a red ghost of the previous pose. It updates as you move the playhead so you can compare motion arcs.",
			},
			{
				heading = "Multi-key pose edits",
				body = "Select multiple same-frame keyframes, then move or rotate them together. This is useful for posing both arms, both legs, or several object tracks at once.",
			},
			{
				heading = "Attach and detach props",
				body = "Select any rig body-part track, select a prop in Workspace, then use Attach Object. 7kg2 adds attach/detach events so props can be picked up, worn, carried, thrown, or released later.",
			},
		},
	},
	HelpCutsceneMaker = {
		title = "Cutscene Maker",
		subtitle = "Turn your 7kg2 timeline into a playable cutscene package.",
		sections = {
			{
				heading = "1. Choose playback and trigger",
				body = "Open Cutscene, then choose whether the cutscene plays for the Local Player or Everyone. Choose Manual, Part Touched, Timed, or Auto Start for the trigger.",
			},
			{
				heading = "2. Choose the character mode",
				body = "Dummy Rig plays the workspace rig you animated. Player Avatar uses the dummy as a template and plays the cutscene on a temporary clone of the triggering player's avatar.",
			},
			{
				heading = "3. Choose the end behaviour",
				body = "Return To Start keeps the real player where they started. End At Cutscene Finish moves the player to the final dummy rig position after the cutscene.",
			},
			{
				heading = "4. Generate the package",
				body = "Click Generate Package. 7kg2 creates ReplicatedStorage &gt; MegMoCutscenes with data, scripts, rig animations, settings, and a READ ME module.",
			},
			{
				heading = "5. Teleport after playback",
				body = "In Generate, change After: Stay Here to After: Teleport, then enter the destination Place ID. The generated server trigger teleports the triggering player, or everyone when Plays For is Everyone.",
			},
			{
				heading = "6. Test in your game",
				body = "Move PlayServerTriggerExample into ServerScriptService and enable it. Move PlayClientReceiver into StarterPlayerScripts and enable it. Keep the cutscene folder in ReplicatedStorage.",
			},
			{
				heading = "Export safety",
				body = "When generating a package, 7kg2 resets exported rigs to their stored base pose temporarily, then restores your editor pose. This helps avoid messy cutscene poses from rigs left mid-walk.",
			},
		},
	},
	HelpFaces = {
