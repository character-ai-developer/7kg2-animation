function state.startingPushActions.Configure()
	if RunService:IsRunning() then
		return
	end
	if state.effectMode == "Character" and state.ragdollMode == "Knockback" then
		if not (state.selectedRig and state.selectedRig.Parent) then
			setStatus("Select the character rig before setting its Knockback direction.", THEME.yellow)
			updateUI()
			return
		end
		local targetPart = state.selectedRig:FindFirstChild("UpperTorso", true)
			or state.selectedRig:FindFirstChild("Torso", true)
			or state.selectedRig:FindFirstChild("HumanoidRootPart", true)
		if not (targetPart and targetPart:IsA("BasePart")) then
			setStatus("The selected rig has no torso part for the Knockback guide.", THEME.yellow)
			updateUI()
			return
		end
		local keepGuide = state.startingPushTarget == targetPart
		state.startingPushTarget = targetPart
		state.startingPushContact, state.startingPushOrigin = state.startingPushUX:SetTarget(
			targetPart,
			keepGuide and state.startingPushContact or nil,
			keepGuide and state.startingPushOrigin or nil,
			true
		)
		if not keepGuide then
			state.startingPushSpeed = 200
		end
		state.take = nil
		state.rigTakes = {}
		state.takes = {}
		state.takeIndex = 0
		setStatus(
			string.format(
				"Knockback direction set at %.1f studs/s. Drag CONTACT to set the hit point and PUSH FROM to set the direction.",
				state.startingPushSpeed
			),
			THEME.green
		)
		state.refreshWorkflowUX()
		updateUI()
		return
	end
	if state.effectMode ~= "Scene" then
		return
	end
	local selection = Selection:Get()
	if #selection ~= 1 then
		setStatus("Select exactly one of the prepared physics objects, then click Add Starting Push.", THEME.yellow)
		updateUI()
		return
	end
	local selected = selection[1]
	local descriptor = nil
	local eligibleDescriptors = {}
	for _, candidate in ipairs(state.objectTargets) do
		if candidate.instance == selected
			or selected:IsA("Model") and candidate.instance:IsDescendantOf(selected) then
			table.insert(eligibleDescriptors, candidate)
			if not descriptor
				or selected:IsA("BasePart")
				or selected:IsA("Model") and selected.PrimaryPart == candidate.instance then
				descriptor = candidate
			end
		end
	end
	if not descriptor then
		setStatus("The Starting Push target must be one of the objects already prepared for this scene.", THEME.yellow)
		updateUI()
		return
	end
	local keepGuide = state.startingPushTarget == descriptor.instance
	state.startingPushUX:Clear()
	state.startingPushTarget = nil
	state.startingPushTargetId = nil
	state.startingPushContact = nil
	state.startingPushOrigin = nil
	if not keepGuide then
		state.startingPushSpeed = 12
	end
	state.take = nil
	state.takes = {}
	state.takeIndex = 0
	local targetParts = {}
	for _, candidate in ipairs(eligibleDescriptors) do
		table.insert(targetParts, candidate.instance)
	end
	local placementStarted = state.startingPushUX:BeginContactPlacement(
		targetParts,
		function(hitPart, contactPosition, originPosition)
			local hitDescriptor = nil
			for _, candidate in ipairs(eligibleDescriptors) do
				if candidate.instance == hitPart then
					hitDescriptor = candidate
					break
				end
			end
			if not hitDescriptor then
				return
			end
			state.startingPushTarget = hitDescriptor.instance
			state.startingPushTargetId = nil
			state.startingPushContact = contactPosition
			state.startingPushOrigin = originPosition
			state.startingPushTestedSpeed = nil
			state.take = nil
			state.takes = {}
			state.takeIndex = 0
			setStatus(
				string.format(
					"CONTACT placed on %s. Adjust PUSH FROM if needed, choose a speed, then test the push.",
					hitDescriptor.instance.Name
				),
				THEME.green
			)
			state.refreshWorkflowUX()
			updateUI()
		end,
		function()
			setStatus("Click directly on a prepared part inside the selected object or model.", THEME.yellow)
			updateUI()
		end
	)
	if not placementStarted then
		setStatus("The selected object has no prepared BasePart available for contact placement.", THEME.yellow)
		updateUI()
		return
	end
	setStatus(
		string.format(
			"NEXT: Click the exact surface point on %s in the Studio viewport where the push should HIT. PUSH FROM will appear 5 studs outside that surface.",
			selected.Name
		),
		THEME.cyan
	)
	state.refreshWorkflowUX()
	updateUI()
end

function state.startingPushActions.ChangeSpeed(direction)
	if RunService:IsRunning() or not state.findStartingPushDescriptor() then
		return
	end
	state.startingPushSpeed = state.startingPushRuntime.StepSpeed(state.startingPushSpeed, direction)
	state.startingPushTestedSpeed = nil
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(string.format("Starting Push speed set to %.0f studs/s.", state.startingPushSpeed), THEME.green)
	updateUI()
end

function state.startingPushActions.Clear()
	if RunService:IsRunning() then
		return
	end
	state.clearStartingPush()
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(
		state.effectMode == "Character"
			and "Knockback direction removed. Set it again before continuing."
			or "Starting Push removed. The selected objects will begin with no added impulse.",
		THEME.muted
	)
	updateUI()
end

closePhysicsPopup = function()
	state.explosionTestCache = nil
	state.largeSelectionWarningBypass = false
	if state.largeSelectionWarning then
		state.largeSelectionWarning:Hide()
	end
	local discardStartingPushTest = state.startingPushTestMode
	local discardEventTest = state.eventTestMode
	if state.eventTestLivePreviewSession then
		TakePreviewRuntime.Stop(state.eventTestLivePreviewSession, false)
		state.eventTestLivePreviewSession = nil
	end
	state.eventTestLiveCaptureComplete = false
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
	end
	if RunService:IsRunning() then
		if state.capturing then
			finishRuntimeCapture("Physics window closed. The temporary simulation was stopped.")
		end
		pcall(function()
			RunService:Stop()
		end)
	end
	restoreAdaptiveWalkOriginal()
	restoreRagdollOriginal()
	if discardStartingPushTest or discardEventTest or #state.previewRestoreSnapshots &gt; 0 then
		state.restorePreviewScene()
	else
		restoreOriginalSetup()
	end
	if discardStartingPushTest then
		state.startingPushTestMode = false
		state.fullEffectTestMode = false
		state.startingPushTestDuration = 4
		state.armed = false
		clearStartingPushTestTake()
	end
	if discardEventTest then
		state.eventTestMode = false
		state.eventTestCompleted = false
		state.armed = false
		clearStartingPushTestTake()
	end
	if state.guidedMode then
		state.guidedMode:Hide()
	end
	refs.popupGui.Enabled = false
end
connect(refs.close.Activated, closePhysicsPopup)
