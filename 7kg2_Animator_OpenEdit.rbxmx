	Default = "Reset selected limb, keyframe, or track data to its default pose.",
	Onion = "Toggle onion-skin pose ghosts for easier motion spacing.",
	Mirror = "Mirror selected rig keyframes left-to-right.",
	Invert = "Invert selected rig keyframes.",
	["Ease Style"] = "Choose the easing curve used by selected keyframes.",
	["Ease Dir"] = "Choose the easing direction used by selected keyframes.",
	Smooth = "Smooth selected motion to reduce jitter.",
	Repeat = "Repeat the selected keyframe block.",
	Group = "Group selected keyframes so they move together.",
	Ungroup = "Ungroup selected keyframes.",
	Bake = "Bake the timeline preview cache for smoother playback.",
	Record = "Record motion into keyframes.",
	Wiggle = "Apply an editable wiggle effect to selected keys.",
	Attach = "Attach the selected prop or object to a rig part.",
	Detach = "Detach the selected prop or object.",
	Priority = "Set the animation priority used for playback and export.",
}

