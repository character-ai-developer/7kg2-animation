          <Item class="ModuleScript" referent="RBX18">
            <Properties>
              <string name="Name">ImpactBreakRuntime</string>
              <ProtectedString name="Source">local ImpactBreakRuntime = {}

local function isFromSource(part, source)
	return part == source or (part and source and part:IsDescendantOf(source))
end

local function getSourceParts(source)
	if source:IsA("BasePart") then
		return { source }
	end
	local parts = {}
	for _, descendant in ipairs(source:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function getAttachmentPart(attachment)
	local current = attachment and attachment.Parent
	while current and current ~= workspace do
		if current:IsA("BasePart") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function collectBreakLinks(parts)
	local selected = {}
	for _, item in ipairs(parts) do
		if item.part then
			selected[item.part] = true
		end
	end

	local links = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("WeldConstraint") then
			local part0 = descendant.Part0
			local part1 = descendant.Part1
			if selected[part0] or selected[part1] then
				table.insert(links, {
					kind = "Parts",
					instance = descendant,
					part0 = part0,
					part1 = part1,
				})
			end
		elseif descendant:IsA("JointInstance") then
			local part0 = descendant.Part0
			local part1 = descendant.Part1
			if selected[part0] or selected[part1] then
				table.insert(links, {
					kind = "Parts",
					instance = descendant,
					part0 = part0,
					part1 = part1,
				})
			end
		elseif descendant:IsA("Constraint") then
			local part0 = getAttachmentPart(descendant.Attachment0)
			local part1 = getAttachmentPart(descendant.Attachment1)
			if selected[part0] or selected[part1] then
				table.insert(links, {
					kind = "Enabled",
					instance = descendant,
					enabled = descendant.Enabled,
				})
			end
		end
	end
	return links
end

local function breakLinks(session)
	for _, link in ipairs(session.links or {}) do
		local instance = link.instance
		if instance and instance.Parent then
			pcall(function()
				if link.kind == "Parts" then
					instance.Part0 = nil
					instance.Part1 = nil
				else
					instance.Enabled = false
				end
			end)
		end
	end
end

local function restoreLinks(session)
	for index = #(session.links or {}), 1, -1 do
		local link = session.links[index]
		local instance = link.instance
		if instance and instance.Parent then
			pcall(function()
				if link.kind == "Parts" then
					instance.Part0 = link.part0
					instance.Part1 = link.part1
				else
					instance.Enabled = link.enabled
				end
			end)
		end
	end
end

local function release(session, hitPart, sourceVelocityOverride)
	if not (session and session.armed and not session.released) then
		return
	end
	session.released = true
	breakLinks(session)
	local sourcePosition = hitPart and hitPart.Position or Vector3.zero
	local sourceVelocity = typeof(sourceVelocityOverride) == "Vector3"
		and sourceVelocityOverride
		or (hitPart and hitPart.AssemblyLinearVelocity or Vector3.zero)
	for _, item in ipairs(session.parts) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = false
			local offset = part.Position - sourcePosition
			local away = offset.Magnitude &gt; 0.01 and offset.Unit or Vector3.yAxis
			local transferredVelocity = sourceVelocity * 0.55 + away * math.min(12, sourceVelocity.Magnitude * 0.2)
			pcall(function()
				part:ApplyImpulse(transferredVelocity * part.AssemblyMass)
			end)
		end
	end
end

function ImpactBreakRuntime.Prepare(rig, runtimeTargets)
	if not (rig and rig.Parent and type(runtimeTargets) == "table" and #runtimeTargets &gt; 0) then
		return nil
	end
	local session = {
		rig = rig,
		parts = {},
		connections = {},
		armed = false,
		released = false,
	}
	local overlapParts = {}
	for _, descriptor in ipairs(runtimeTargets) do
		local part = descriptor.part
		if part and part.Parent then
			table.insert(session.parts, {
				part = part,
				anchored = part.Anchored,
			})
			table.insert(overlapParts, part)
			part.Anchored = true
			table.insert(session.connections, part.Touched:Connect(function(hit)
			if isFromSource(hit, rig) then
					release(session, hit)
				end
			end))
		end
	end
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Include
	overlapParams.FilterDescendantsInstances = overlapParts
	overlapParams.MaxParts = 1
	session.overlapParams = overlapParams
	session.links = collectBreakLinks(session.parts)
	return session
end

function ImpactBreakRuntime.Arm(session)
	if session then
		session.armed = true
	end
end

function ImpactBreakRuntime.CheckDrivenCollision(session, sourceVelocity)
	if not (session and session.armed and not session.released and session.overlapParams) then
		return false
	end
	for _, sourcePart in ipairs(getSourceParts(session.rig)) do
		local ok, hits = pcall(function()
			return workspace:GetPartsInPart(sourcePart, session.overlapParams)
		end)
		if ok and hits and #hits &gt; 0 then
			release(session, sourcePart, sourceVelocity)
			return true
		end
	end
	return false
end

function ImpactBreakRuntime.Restore(session)
	if not session then
		return
	end
	for _, connection in ipairs(session.connections) do
		connection:Disconnect()
	end
	restoreLinks(session)
	for _, item in ipairs(session.parts) do
		if item.part and item.part.Parent then
			item.part.Anchored = item.anchored
		end
	end
	session.connections = {}
	session.links = {}
end

return ImpactBreakRuntime
</ProtectedString>
