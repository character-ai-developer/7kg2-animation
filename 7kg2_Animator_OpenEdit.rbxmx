	})
	UiHelpers.createCorner(card, 16)
	UiHelpers.createStroke(card, Constants.THEME.Border, 1)

	local title = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 20, 0, 16),
		Size = UDim2.new(1, -72, 0, 24),
		Text = "R15 -&gt; R6 Converter",
		TextColor3 = Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 131,
	})
	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.new(0, 32, 0, 32),
		Text = "X",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextStrokeTransparency = 1,
		ZIndex = 131,
	})
	UiHelpers.createCorner(closeButton, 9)

	local hideUiButton = create("TextButton", {
		Parent = card,
