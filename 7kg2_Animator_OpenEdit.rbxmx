              <string name="Name">EffectSetupPresentation</string>
              <ProtectedString name="Source">local EffectSetupPresentation = {}
EffectSetupPresentation.__index = EffectSetupPresentation

local WHITE = Color3.fromRGB(244, 247, 255)
local SUBTEXT = Color3.fromRGB(218, 225, 240)
local PANEL = Color3.fromRGB(12, 18, 29)
local STATUS = Color3.fromRGB(20, 29, 44)
local BORDER = Color3.fromRGB(56, 68, 91)
local BACK_ARROW_IMAGE = "rbxassetid://74487777821767"
local READY_CHECK_IMAGE = "rbxassetid://87057299671477"

local ADVANCED_HELP = {
	{ ref = "ragdoll", title = "Auto Ragdoll", body = "Automatically converts the captured character to a ragdoll when physics begins." },
	{ ref = "pathMode", title = "Path Mode", body = "Chooses how authored 7kg2 movement hands control over to the physics simulation." },
	{ ref = "impact", title = "Impact Break", body = "Allows selected impact objects to separate when the moving object hits them." },
	{ ref = "scopeRig", title = "Rig Only", body = "Records only the selected character rig and ignores loose scene objects." },
	{ ref = "scopeSelected", title = "Selected", body = "Records the rig plus the loose scene objects you explicitly selected." },
	{ ref = "scopeScene", title = "Entire Scene", body = "Records every eligible loose physics object in the scene, up to the safety limit." },
	{ ref = "fps30", title = "30 FPS", body = "Captures fewer samples for a lighter timeline and standard animation playback." },
	{ ref = "fps60", title = "60 FPS", body = "Captures twice as many samples for faster motion and more detailed impacts." },
	{ ref = "duration10", title = "10 seconds", body = "Stops the simulation after ten seconds if the motion has not already settled." },
	{ ref = "duration20", title = "20 seconds", body = "Uses the balanced default limit for most falls, impacts and scene simulations." },
	{ ref = "duration30", title = "30 seconds", body = "Allows extra time for long rolls, large scenes and slow-moving objects." },
	{ ref = "capture", title = "Manual Capture", body = "Arms Physics so you can start Roblox Run mode yourself before recording begins." },
	{ ref = "bake", title = "Workspace KeyframeSequence", body = "Creates a standalone KeyframeSequence in Workspace for inspection or manual use." },
}

local EFFECTS = {
	Release = {
		name = "Release to Physics",
		purpose = "Release an animated prop while preserving its current movement.",
		steps = {
			"Place the playhead on the Detach event.",
			"Load it; 7kg2 detects the held object.",
			"Review the setup and continue to Capture.",
		},
		accent = Color3.fromRGB(72, 214, 255),
		image = "rbxassetid://88271717750306",
	},
	Drop = {
		name = "Drop or bounce",
		purpose = "Drop loose objects and capture their real falls, collisions, rolling and bounce.",
		steps = {
			"Select every loose Part or Model to move.",
			"Confirm them and choose whether to add bounce.",
			"Review the setup and continue to Capture.",
		},
		accent = Color3.fromRGB(82, 139, 255),
		image = "rbxassetid://101930051479581",
	},
	Character = {
		name = "Ragdoll",
		purpose = "Turn one or more characters into temporary ragdolls for a natural fall or directed Knockback reaction.",
		steps = {
			"Select one or more R6 or R15 character rigs.",
			"Choose Natural Fall or Knockback and set its direction.",
			"Simulate and capture the reaction.",
		},
		accent = Color3.fromRGB(126, 86, 255),
		image = "rbxassetid://85022907825347",
	},
	Impact = {
		name = "Drive &amp; Impact",
		purpose = "Drive an animated object or vehicle into targets and capture the resulting collision.",
		steps = {
			"Select the moving object or vehicle.",
			"Choose movement, riders and collision targets.",
			"Load its 7kg2 path and continue.",
		},
		accent = Color3.fromRGB(255, 201, 92),
		image = "rbxassetid://101298906973815",
	},
	Projectile = {
		name = "Launch projectile",
		purpose = "Launch a projectile between two points and capture its timed impact on selected objects.",
		steps = {
			"Select the projectile and reacting objects.",
			"Place its Start and Impact points.",
			"Set timing and power, then add the event.",
		},
		accent = Color3.fromRGB(255, 116, 62),
		image = "rbxassetid://122613049511323",
	},
	Explosion = {
		name = "Create explosion",
		purpose = "Create a blast that pushes, ragdolls, or breaks apart selected physics objects.",
		steps = {
			"Select the objects that should react.",
			"Press Blast Origin, choose the reaction and power, and optionally add Explosion VFX.",
			"Test the blast, then continue to Capture.",
		},
		accent = Color3.fromRGB(255, 159, 67),
		buttonAccent = Color3.fromRGB(255, 184, 92),
		image = "rbxassetid://119229108932478",
	},
	Scene = {
		name = "Simulate selected objects",
		purpose = "Simulate loose objects together, with an optional directed push to start a chain reaction.",
		steps = {
			"Select every loose Part or Model to include.",
			"Optional: Add a Starting Push, then click its impact point in the Studio viewport.",
			"Continue to Capture and simulate them.",
		},
		accent = Color3.fromRGB(91, 224, 165),
		image = "rbxassetid://123485720397312",
	},
	AdaptiveWalk = {
		name = "Adapt movement to ground",
		purpose = "Fit an animated walk route to steps, slopes and uneven ground without rebuilding it by hand.",
		steps = {
			"Select the animated character rig.",
			"Choose a compatible Walk Style.",
			"Load its CFrame route and continue.",
		},
		accent = Color3.fromRGB(177, 223, 83),
		image = "rbxassetid://136403303423933",
	},
}

local function make(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function corner(parent, radius)
	return make("UICorner", {
		CornerRadius = UDim.new(0, radius or 6),
	}, parent)
end

local function border(parent, color, transparency)
	return make("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color,
		Thickness = 1,
		Transparency = transparency or 0,
	}, parent)
end

local function setOffsetY(instance, y)
	if instance then
		instance.Position = UDim2.new(instance.Position.X.Scale, instance.Position.X.Offset, 0, y)
	end
end

local function setPanelStroke(panel, color, transparency)
	local stroke = panel and panel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = color
		stroke.Transparency = transparency or 0.48
		stroke.Thickness = 1
	end
end

local function setButtonSurface(button, color, textColor)
	if not button then
		return
	end
	button.BackgroundColor3 = color
	button.TextColor3 = textColor
	button.Font = Enum.Font.GothamSemibold
	button.TextSize = math.max(button.TextSize, 12)
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
		stroke.Transparency = 0.55
		stroke.Thickness = 1
	end
end

local function setOutlinedButton(button, theme, accent)
	setButtonSurface(button, theme.button, theme.text)
	local gradient = button and button:FindFirstChild("HandcraftedActionGradient")
	if gradient then
		gradient:Destroy()
	end
	local stroke = button and button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = accent
		stroke.Transparency = 0.28
	end
end

local function readableTextColor(backgroundColor)
	local function linearChannel(channel)
		if channel &lt;= 0.04045 then
			return channel / 12.92
		end
		return ((channel + 0.055) / 1.055) ^ 2.4
	end
	local luminance = (0.2126 * linearChannel(backgroundColor.R))
		+ (0.7152 * linearChannel(backgroundColor.G))
		+ (0.0722 * linearChannel(backgroundColor.B))
	return luminance &gt; 0.179
		and Color3.fromRGB(12, 18, 24)
		or Color3.fromRGB(245, 248, 255)
end

local function isPurpleActionColor(color)
	return color.B &gt;= 0.55
		and color.B &gt; color.G * 1.12
		and color.R &gt; color.G * 1.02
end

local function enforcePurpleButtonText(root)
	if not root then
		return
	end
	for _, button in ipairs(root:GetDescendants()) do
		if button:IsA("TextButton") then
			local readableLabel = button:FindFirstChild("PurpleReadableLabel")
			local purpleAction = button.BackgroundTransparency &lt; 0.8
				and isPurpleActionColor(button.BackgroundColor3)
			if purpleAction and button.Text ~= "" then
				if not readableLabel then
					readableLabel = make("TextLabel", {
						Name = "PurpleReadableLabel",
						Active = false,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.fromScale(1, 1),
					}, button)
				end
				button.Font = Enum.Font.GothamBold
				button.TextTransparency = 1
				readableLabel.ZIndex = button.ZIndex + 2
				readableLabel.Font = Enum.Font.GothamBold
				readableLabel.Text = button.Text
				readableLabel.TextColor3 = WHITE
				readableLabel.TextSize = button.TextSize
				readableLabel.TextTransparency = 0
				readableLabel.TextWrapped = button.TextWrapped
				readableLabel.TextXAlignment = button.TextXAlignment
				readableLabel.TextYAlignment = button.TextYAlignment
			else
				button.TextTransparency = 0
				if readableLabel then
					readableLabel:Destroy()
				end
			end
		end
	end
	for _, textObject in ipairs(root:GetDescendants()) do
		if textObject:IsA("TextLabel") and textObject.Name ~= "PurpleReadableLabel" then
			local surface = textObject
			while surface and surface ~= root do
				if surface:IsA("TextButton")
					and surface.BackgroundTransparency &lt; 0.8
					and isPurpleActionColor(surface.BackgroundColor3) then
					textObject.TextColor3 = WHITE
					break
				end
				surface = surface.Parent
			end
		end
	end
end

local function contrastRatio(first, second)
	local function linearChannel(channel)
		if channel &lt;= 0.04045 then
			return channel / 12.92
		end
		return ((channel + 0.055) / 1.055) ^ 2.4
	end
	local firstLuminance = (0.2126 * linearChannel(first.R))
		+ (0.7152 * linearChannel(first.G))
		+ (0.0722 * linearChannel(first.B))
	local secondLuminance = (0.2126 * linearChannel(second.R))
		+ (0.7152 * linearChannel(second.G))
		+ (0.0722 * linearChannel(second.B))
	local lighter = math.max(firstLuminance, secondLuminance)
	local darker = math.min(firstLuminance, secondLuminance)
	return (lighter + 0.05) / (darker + 0.05)
end

local function readableAccentColor(accent, background, fallback)
	if contrastRatio(accent, background) &gt;= 4.5 then
		return accent
	end
	for step = 1, 10 do
		local candidate = accent:Lerp(fallback, step / 10)
		if contrastRatio(candidate, background) &gt;= 4.5 then
			return candidate
		end
	end
	return fallback
end

local function setPrimaryButton(button, accent)
	setButtonSurface(button, accent, readableTextColor(accent))
	local gradient = button:FindFirstChild("HandcraftedActionGradient")
	if not gradient then
		gradient = make("UIGradient", {
			Name = "HandcraftedActionGradient",
			Rotation = 90,
		}, button)
	end
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, accent:Lerp(Color3.new(1, 1, 1), 0.12)),
		ColorSequenceKeypoint.new(1, accent:Lerp(Color3.new(0, 0, 0), 0.1)),
	})
end

local function stripGloss(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("UIGradient") and descendant.Name == "MegMoSetupGradient" then
			descendant:Destroy()
		elseif descendant:IsA("TextButton") and descendant.Text ~= "" then
			descendant.Font = Enum.Font.GothamSemibold
			descendant.TextSize = math.max(descendant.TextSize, 12)
		elseif descendant:IsA("UIStroke") then
			descendant.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end
	end
end

local function normalizeReadableText(root, theme)
	if not root then
		return
	end
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			if descendant.Font == Enum.Font.Gotham or descendant.Font == Enum.Font.GothamMedium then
				descendant.Font = Enum.Font.GothamSemibold
			end
			if descendant.TextColor3 == theme.muted then
				descendant.TextColor3 = theme.text
			end
			if descendant.Text ~= "" and descendant.Name ~= "PhysicsNextActionBadge" then
				descendant.TextSize = math.max(descendant.TextSize, 11)
			end
		end
	end
end

local function setNextAction(button, accent, isNext)
	if not button then
		return
	end
	local badgeColor = Color3.fromRGB(235, 67, 84)
	local badge = button:FindFirstChild("PhysicsNextActionBadge")
	if not badge then
		badge = make("TextLabel", {
			Name = "PhysicsNextActionBadge",
			AnchorPoint = Vector2.new(1, 0),
			BackgroundColor3 = badgeColor,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(1, -5, 0, 4),
			Size = UDim2.fromOffset(40, 16),
			Text = "NEXT",
			TextColor3 = readableTextColor(badgeColor),
			TextSize = 8,
			Visible = false,
			ZIndex = button.ZIndex + 2,
		}, button)
		corner(badge, 4)
	end
	badge.BackgroundColor3 = badgeColor
	badge.TextColor3 = readableTextColor(badgeColor)
	badge.Visible = isNext == true and button.Visible and button.Active
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke and isNext then
		stroke.Color = accent
		stroke.Thickness = 2
		stroke.Transparency = 0
	elseif stroke then
		stroke.Thickness = 1
	end
end

local function clearNextActions(buttons)
	for _, button in ipairs(buttons) do
		if button then
			local badge = button:FindFirstChild("PhysicsNextActionBadge")
			if badge then
				badge.Visible = false
			end
			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = 1
			end
		end
	end
end

local function createDurationPopup(parent, theme, callbacks)
	local popup = make("Frame", {
		Name = "PhysicsDurationPopup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(320, 226),
		Visible = false,
		ZIndex = 220,
	}, parent)
	corner(popup, 8)
	border(popup, theme.border, 0.12)
	local title = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -58, 0, 24),
		Text = "Maximum duration",
		TextColor3 = theme.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 221,
	}, popup)
	local close = make("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = theme.button,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -42, 0, 10),
		Size = UDim2.fromOffset(30, 30),
		Text = "x",
		TextColor3 = theme.text,
		TextSize = 13,
		ZIndex = 221,
	}, popup)
	corner(close, 5)
	local subtitle = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(16, 44),
		Size = UDim2.new(1, -32, 0, 34),
		Text = "Physics stops at this limit if the motion has not already settled.",
		TextColor3 = theme.text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 221,
	}, popup)
	local input = make("TextBox", {
		BackgroundColor3 = theme.panelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(16, 86),
		Size = UDim2.new(1, -32, 0, 40),
		PlaceholderText = "Seconds (0.1-120)",
		Text = "",
		TextColor3 = theme.text,
		TextSize = 13,
		ZIndex = 221,
	}, popup)
	corner(input, 5)
	border(input, theme.border, 0.3)
	local presets = {}
	for index, value in ipairs({ 10, 20, 30 }) do
		local preset = make("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = theme.button,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.new((index - 1) / 3, index == 1 and 16 or 6, 0, 136),
			Size = UDim2.new(1 / 3, index == 1 and -22 or index == 3 and -22 or -12, 0, 34),
			Text = tostring(value) .. " sec",
			TextColor3 = theme.text,
			TextSize = 11,
			ZIndex = 221,
		}, popup)
		corner(preset, 5)
		border(preset, theme.border, 0.42)
		preset.Activated:Connect(function()
			if callbacks and callbacks.onDurationChanged and callbacks.onDurationChanged(value) then
				popup.Visible = false
			end
		end)
		presets[index] = preset
	end
	local apply = make("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = theme.accent,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(16, 180),
		Size = UDim2.new(1, -32, 0, 34),
		Text = "Apply duration",
		TextColor3 = readableTextColor(theme.accent),
		TextSize = 12,
		ZIndex = 221,
	}, popup)
	corner(apply, 5)
	close.Activated:Connect(function()
		popup.Visible = false
	end)
	apply.Activated:Connect(function()
		local value = tonumber(input.Text)
		if not value or value &lt; 0.1 or value &gt; 120 then
			if callbacks and callbacks.onValidationMessage then
				callbacks.onValidationMessage("Enter a maximum duration between 0.1 and 120 seconds.")
			end
			return
		end
		if callbacks and callbacks.onDurationChanged and callbacks.onDurationChanged(value) then
			popup.Visible = false
		end
	end)
	return {
		frame = popup,
		input = input,
		title = title,
		subtitle = subtitle,
		presets = presets,
		apply = apply,
		close = close,
	}
end

local function createStepRows(parent, theme)
	local rows = {}
	for index = 1, 3 do
		local y = (index - 1) * 28
		local number = make("TextLabel", {
			Name = "StepNumber" .. index,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.fromOffset(24, 24),
			Text = tostring(index),
			TextColor3 = theme.muted,
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, parent)
		local text = make("TextLabel", {
			Name = "StepText" .. index,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.fromOffset(30, y + 1),
			Size = UDim2.new(1, -30, 0, 23),
			Text = "",
			TextColor3 = theme.text,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.None,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, parent)
		if index &lt; 3 then
			make("Frame", {
				Name = "Divider" .. index,
				BackgroundColor3 = theme.border,
				BackgroundTransparency = 0.62,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(30, y + 26),
				Size = UDim2.new(1, -30, 0, 1),
			}, parent)
		end
		table.insert(rows, {
			number = number,
			text = text,
		})
	end
	return rows
end

