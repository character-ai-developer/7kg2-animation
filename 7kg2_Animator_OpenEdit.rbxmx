        <Item class="ModuleScript" referent="RBX63">
          <Properties>
            <string name="Name">EnhanceAnimationUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local EnhanceAnimationUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local function createAssistButton(parent, name, text, description, order, accent)
	local card = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(0.5, -8, 0, 94),
		ZIndex = 132,
	})
	applySectionSurface(card)
	createCorner(card, 12)
	createStroke(card, Constants.THEME.Border, 1)

	local button = create("TextButton", {
		Name = name,
		Parent = card,
		BackgroundColor3 = accent or Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 0, 12),
		Size = UDim2.new(1, -24, 0, 32),
		Font = Enum.Font.GothamSemibold,
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		ZIndex = 133,
	})
	if accent then
		styleTextButton(button, accent)
	else
		styleGhostButton(button)
	end
	createCorner(button, 9)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 52),
		Size = UDim2.new(1, -24, 0, 32),
		Font = Enum.Font.GothamSemibold,
		Text = description,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 133,
	})

	return button
end

function EnhanceAnimationUI.mount(parent, _context)
	if not parent then
		error("EnhanceAnimationUI.mount requires parent")
	end

	local refs = {}

	local overlay = create("Frame", {
		Name = "EnhanceAnimationOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 128,
	})

	local card = create("Frame", {
		Name = "EnhanceAnimationCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.66, 0, 0.52, 0),
		ZIndex = 129,
	})
	applySectionSurface(card)
	createCorner(card, 16)
	createStroke(card, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 18),
		Size = UDim2.new(1, -80, 0, 26),
		Font = Enum.Font.GothamBold,
		Text = "Enhance Animation",
		TextColor3 = Constants.THEME.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 130,
	})

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 50),
		Size = UDim2.new(1, -80, 0, 36),
		Font = Enum.Font.GothamSemibold,
		Text = "One-shot assist tools. They calculate, bake keyframes, then stop; no live solvers or timeline rendering changes.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 130,
	})

	local closeButton = create("TextButton", {
		Name = "EnhanceCloseButton",
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -18, 0, 18),
		Size = UDim2.new(0, 34, 0, 34),
		Font = Enum.Font.GothamBold,
		Text = "x",
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		ZIndex = 131,
	})
	createCorner(closeButton, 10)

	local buttonGrid = create("Frame", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 104),
		Size = UDim2.new(1, -44, 1, -170),
		ZIndex = 131,
	})
	create("UIGridLayout", {
		Parent = buttonGrid,
		CellPadding = UDim2.new(0, 12, 0, 12),
		CellSize = UDim2.new(0.5, -8, 0, 94),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local attachHandButton = createAssistButton(buttonGrid, "AttachHandButton", "Attach Object", "Select a rig body-part track and a prop. 7kg2 adds a temporary Motor6D helper.", 1, Constants.THEME.AccentSoft)
	local detachObjectButton = createAssistButton(buttonGrid, "DetachObjectButton", "Detach Object", "Release the attached prop and bake its world CFrame at the playhead.", 2, Constants.THEME.AccentSoft)
	local smoothMotionButton = createAssistButton(buttonGrid, "SmoothMotionButton", "Smooth Motion", "Select a sparse motion section. 7kg2 adds editable in-between keys to make it smoother.", 3, Constants.THEME.AccentSoft)

	local status = create("TextLabel", {
		Name = "EnhanceStatus",
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 22, 1, -54),
		Size = UDim2.new(1, -44, 0, 32),
		Font = Enum.Font.GothamSemibold,
		Text = "Tip: these tools only run when you click them, then bake normal keyframes.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 130,
	})
	createCorner(status, 9)
	createStroke(status)
	create("UIPadding", {
		Parent = status,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	refs._enhanceOverlay = overlay
	refs._enhanceCloseButton = closeButton
	refs._attachHandButton = attachHandButton
	refs._detachObjectButton = detachObjectButton
	refs._smoothMotionButton = smoothMotionButton
	refs._enhanceStatus = status

	return refs
end

function EnhanceAnimationUI.update(_context)
end

function EnhanceAnimationUI.destroy()
end

return EnhanceAnimationUI
