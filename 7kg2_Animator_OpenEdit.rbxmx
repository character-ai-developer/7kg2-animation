        <Item class="ModuleScript" referent="RBX109">
          <Properties>
            <string name="Name">ViewportToolsUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local ViewportToolsUI = {}

local create = UiHelpers.create
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createMetaLabel = UiHelpers.createMetaLabel
local createCard = UiHelpers.createCard
local createGridPreview = UiHelpers.createGridPreview
local applySectionSurface = UiHelpers.applySectionSurface

function ViewportToolsUI.mount(parent, _context)
	if not parent then
		error("ViewportToolsUI.mount requires parent")
	end

	local refs = {}

	local viewportCard = createCard(parent, UDim2.new(1, 0, 0, 390))
	viewportCard.Position = UDim2.new(0, 0, 0, 0)

	local viewportTitle = create("TextLabel", {
		Parent = viewportCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(0, 122, 0, 20),
		Font = Enum.Font.GothamSemibold,
		Text = "Viewport Tools",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local viewportCollapseButton = create("TextButton", {
		Parent = viewportCard,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 28, 0, 24),
		Text = "-",
	})
	styleGhostButton(viewportCollapseButton)
	createCorner(viewportCollapseButton, 7)

	local viewportSubtitle = createMetaLabel(
		viewportCard,
		"Inspector already contains the active Move and Rotate controls. This panel now acts as a compact workflow guide.",
		28
	)
	viewportSubtitle.Position = UDim2.new(0, 150, 0, 14)
	viewportSubtitle.Size = UDim2.new(1, -210, 0, 18)

	local previewFrame = createGridPreview(create("Frame", {
		Parent = viewportCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 66),
		Size = UDim2.new(1, -32, 1, -82),
	}))

	local previewStatus = create("TextLabel", {
		Parent = previewFrame,
		BackgroundColor3 = Color3.fromRGB(17, 22, 34),
		Position = UDim2.new(0, 14, 0, 14),
		Size = UDim2.new(0, 430, 0, 24),
		Font = Enum.Font.GothamSemibold,
		Text = "Ready to bind a rig",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
	})
	createCorner(previewStatus, 9)
	createStroke(previewStatus)

	local viewportGuide = create("Frame", {
		Parent = previewFrame,
		BackgroundColor3 = Color3.fromRGB(17, 22, 34),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0, 48),
		Size = UDim2.new(0, 320, 0, 132),
	})
	applySectionSurface(viewportGuide)
	createCorner(viewportGuide, 12)
	createStroke(viewportGuide)

	local viewportGuideTitle = create("TextLabel", {
		Parent = viewportGuide,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 10),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "How To Use The Viewport",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local viewportGuideSteps = create("TextLabel", {
		Parent = viewportGuide,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 34),
		Size = UDim2.new(1, -24, 0, 64),
		Font = Enum.Font.GothamSemibold,
		Text = "1. Bind a rig or add a CFrame track.\n2. Choose Move Tool or Rotate Tool.\n3. Manipulate the target in Studio's 3D viewport.\n4. Add Keyframe saves; scrubbing previews the pose.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	local viewportActionRow = create("Frame", {
		Parent = viewportGuide,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -34),
		Size = UDim2.new(1, -24, 0, 24),
	})

	local selectRigButton = create("TextButton", {
		Name = "SelectRigButton",
		Parent = viewportActionRow,
		Size = UDim2.new(0.48, -4, 1, 0),
		Text = "Select Rig",
	})
	styleGhostButton(selectRigButton)
	createCorner(selectRigButton, 8)

	local selectJointPartButton = create("TextButton", {
		Name = "SelectJointPartButton",
		Parent = viewportActionRow,
		Position = UDim2.new(0.52, 4, 0, 0),
		Size = UDim2.new(0.48, -4, 1, 0),
		Text = "Select Joint Part",
	})
	styleGhostButton(selectJointPartButton)
	createCorner(selectJointPartButton, 8)

	local motionBuilderRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("MotionBuilderUI")
		local requireOk, motionBuilderModule = pcall(require, moduleScript)
		if requireOk and type(motionBuilderModule.mount) == "function" then
			local mountOk, mountedRefs = pcall(motionBuilderModule.mount, viewportCard, {
				useOwnPanel = false,
				topInset = 40,
				bottomInset = 12,
			})
			if mountOk then
				motionBuilderRefs = mountedRefs or {}
				viewportTitle.Text = "Motion Builder"
				viewportSubtitle.Text = "Create animations using markers, movements, and built-in clips."
				viewportSubtitle.Visible = true
				previewFrame.Visible = false
				viewportGuide.Visible = false
			else
				warn("[7kg2 Animator] Failed to mount UI module: MotionBuilderUI", mountedRefs)
			end
		elseif not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: MotionBuilderUI", motionBuilderModule)
		else
			warn("[7kg2 Animator] UI module missing mount: MotionBuilderUI")
		end
	end

	local viewportCollapsedBar = createCard(parent, UDim2.new(1, 0, 0, 44))
	viewportCollapsedBar.Position = UDim2.new(0, 0, 0, 0)
	viewportCollapsedBar.Visible = false
	create("TextLabel", {
		Parent = viewportCollapsedBar,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(1, -64, 0, 20),
		Font = Enum.Font.GothamSemibold,
		Text = "Motion Builder",
		TextColor3 = Constants.THEME.Text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local viewportExpandButton = create("TextButton", {
		Parent = viewportCollapsedBar,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 28, 0, 24),
		Text = "+",
	})
	styleGhostButton(viewportExpandButton)
	createCorner(viewportExpandButton, 7)

	refs._previewStatus = previewStatus
	refs._viewportGuideTitle = viewportGuideTitle
	refs._viewportGuideSteps = viewportGuideSteps
	refs._viewportCard = viewportCard
	refs._viewportCollapseButton = viewportCollapseButton
	refs._viewportCollapsedBar = viewportCollapsedBar
	refs._viewportExpandButton = viewportExpandButton
	refs._selectRigButton = selectRigButton
	refs._selectJointPartButton = selectJointPartButton
	for key, value in pairs(motionBuilderRefs) do
		refs[key] = value
	end

	return refs
end

function ViewportToolsUI.update(_context)
end

function ViewportToolsUI.destroy()
end

return ViewportToolsUI
</ProtectedString>
