</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX100">
          <Properties>
            <string name="Name">R15ToR6ConverterPopup</string>
            <ProtectedString name="Source">local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local UserInputService = game:GetService("UserInputService")

local Modules = script.Parent.Parent
local Constants = require(Modules:WaitForChild("Constants"))
local Converter = require(Modules:WaitForChild("AnimationConversion"):WaitForChild("R15ToR6Converter"))
local ImportService = require(Modules:WaitForChild("ImportService"))
local PresetPreviewSupport = require(Modules:WaitForChild("PresetPreviewSupport"))
local UiHelpers = require(Modules:WaitForChild("UiHelpers"))

local R15ToR6ConverterPopup = {}

local activePopup = nil

local function create(className, props)
	return UiHelpers.create(className, props)
end

local function stylePrimary(button, color, textColor)
	button.BackgroundColor3 = color or Constants.THEME.Accent
	button.TextColor3 = textColor or Color3.fromRGB(10, 14, 24)
	button.Font = Enum.Font.GothamSemibold
	button.TextSize = 14
	button.TextScaled = true
	button.TextWrapped = true
	button.BorderSizePixel = 0
	local textConstraint = button:FindFirstChild("MegMoButtonTextSize")
	if not textConstraint then
		textConstraint = Instance.new("UITextSizeConstraint")
		textConstraint.Name = "MegMoButtonTextSize"
		textConstraint.MinTextSize = 11
		textConstraint.MaxTextSize = 14
		textConstraint.Parent = button
	end
	UiHelpers.createCorner(button, 9)
end

local function clearChildren(parent)
	if not parent then
		return
	end
	for _, child in ipairs(parent:GetChildren()) do
		child:Destroy()
	end
end

local function findHideUiRoot(parent)
	local current = parent
	while current do
		if current:IsA("DockWidgetPluginGui") or current:IsA("ScreenGui") then
			return current
		end
		current = current.Parent
	end
	return parent
end

local function setHostUiHidden(state, root, hidden)
	if not root then
		return
	end

	if hidden then
		if state.hiddenHostUiStates then
			return
		end
		local states = {}
		for _, child in ipairs(root:GetChildren()) do
			if child:IsA("GuiObject") then
				states[child] = child.Visible
				child.Visible = false
			end
		end
		state.hiddenHostUiStates = states
		return
	end

	local states = state.hiddenHostUiStates
	state.hiddenHostUiStates = nil
	if not states then
		return
	end
	for child, wasVisible in pairs(states) do
		if child and child.Parent then
			child.Visible = wasVisible
		end
	end
end

local function makeWorldPart(parent, name, size, cframe, color, transparency)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Transparency = transparency or 0
	part.Material = Enum.Material.SmoothPlastic
	part.Parent = parent
	return part
end

local function buildPreviewEnvironment(world)
	makeWorldPart(
		world,
		"PreviewFloor",
		Vector3.new(10, 0.03, 10),
		CFrame.new(0, 0, 0),
		Color3.fromRGB(39, 49, 69),
		0.08
	)
	for index = -5, 5 do
		local color = index == 0 and Color3.fromRGB(82, 160, 255) or Color3.fromRGB(42, 82, 126)
		makeWorldPart(world, "GridX" .. index, Vector3.new(10, 0.012, 0.012), CFrame.new(0, 0.028, index), color, 0.18)
		makeWorldPart(world, "GridZ" .. index, Vector3.new(0.012, 0.012, 10), CFrame.new(index, 0.03, 0), color, 0.18)
	end
end

local function prepareViewport(viewport)
	clearChildren(viewport)
	viewport.BackgroundColor3 = Color3.fromRGB(37, 45, 63)
	viewport.BackgroundTransparency = 0
	viewport.Ambient = Color3.fromRGB(190, 196, 220)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-0.45, -1, -0.6)

	local camera = Instance.new("Camera")
	camera.Name = "PreviewCamera"
	camera.FieldOfView = 72
	camera.CFrame = CFrame.new(Vector3.new(5.4, 3.6, 7.4), Vector3.new(0, 2.05, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local world = Instance.new("WorldModel")
	world.Name = "PreviewWorld"
	world.Parent = viewport
	buildPreviewEnvironment(world)

	return {
		viewport = viewport,
		world = world,
		camera = camera,
		rig = nil,
		rigData = nil,
		previewData = nil,
		duration = 0,
		label = "",
	}
end

local function clearPreview(preview)
	if not preview then
		return
	end
	preview.rig = nil
	preview.rigData = nil
	preview.previewData = nil
	preview.duration = 0
	local prepared = prepareViewport(preview.viewport)
	preview.world = prepared.world
	preview.camera = prepared.camera
end

local function loadPreview(preview, rigTypeName, sequence)
	if not preview or not sequence then
		return false, "No animation loaded for preview."
	end

	clearPreview(preview)
	for _, child in ipairs(preview.world:GetChildren()) do
		if child:IsA("Model") then
			child:Destroy()
		end
	end
	local rig = PresetPreviewSupport.createPresetPreviewRig(rigTypeName)
	rig.Name = rigTypeName .. " Preview"
	rig.Parent = preview.world
	PresetPreviewSupport.alignPreviewRigToFloor(rig, 0.05)

	local rigData = PresetPreviewSupport.describePreviewRigMotors(rig)
	local previewData = PresetPreviewSupport.buildPreviewPoseDataFromKeyframeSequence(sequence, rigData)
	if not previewData then
		return false, "The animation loaded, but no previewable keyframes were found."
	end

	preview.rig = rig
	preview.rigData = rigData
	preview.previewData = previewData
	preview.duration = tonumber(previewData.duration) or 0
	return true
end

local function updatePreview(preview, timePosition)
	if not preview or not preview.previewData or not preview.rigData then
		return
	end
	local pose = PresetPreviewSupport.samplePreviewPose(preview.previewData, timePosition or 0)
	PresetPreviewSupport.applyPreviewPose(preview.rigData, pose)
end

local function getKeyframeCount(sequence)
	if not (sequence and sequence:IsA("KeyframeSequence")) then
		return 0
	end
	local ok, keyframes = pcall(function()
		return sequence:GetKeyframes()
	end)
	return ok and #keyframes or 0
end

local function describeSource(sourceInstance, fallback)
	local ok, label = pcall(function()
		return ImportService.describeImportSource(sourceInstance, fallback)
	end)
	return ok and label or tostring(fallback or "selection")
end

local function loadSequenceFromSelection()
	for _, selected in ipairs(Selection:Get()) do
		local sourceType, source, sourceInstance = ImportService.findAnimationImportSource(selected)
		if sourceType == "KeyframeSequence" then
			return true, source, describeSource(sourceInstance, selected.Name)
		elseif sourceType == "AnimationId" then
			local ok, sequenceOrMessage = pcall(function()
				return Converter.LoadFromAnimationId(source)
			end)
			if ok then
				return true, sequenceOrMessage, describeSource(sourceInstance, selected.Name)
			end
			return false, tostring(sequenceOrMessage)
		elseif sourceType == "CurveAnimation" then
			return false, "Selected CurveAnimation conversion is not exposed yet. Paste its Animation ID or select a KeyframeSequence."
		end
	end
	return false, "Select an R15 Animation or KeyframeSequence in Explorer, or paste an Animation ID."
end

local function makeTextBox(parent, placeholder, order)
	local box = create("TextBox", {
		Parent = parent,
		BackgroundColor3 = Color3.fromRGB(43, 55, 78),
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = order,
		PlaceholderColor3 = Color3.fromRGB(190, 199, 218),
		PlaceholderText = placeholder,
		Size = UDim2.new(1, 0, 0, 38),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})
	UiHelpers.createCorner(box, 9)
	UiHelpers.createStroke(box, Color3.fromRGB(86, 104, 140), 1)
	create("UIPadding", {
		Parent = box,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	return box
end

local function createTooltip(parent)
	local tooltip = create("TextLabel", {
		Parent = parent,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(8, 12, 22),
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		Size = UDim2.new(0, 284, 0, 0),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Visible = false,
		ZIndex = 180,
	})
	UiHelpers.createCorner(tooltip, 9)
	UiHelpers.createStroke(tooltip, Constants.THEME.AccentSoft, 1, 0.35)
	create("UIPadding", {
		Parent = tooltip,
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 8),
	})
	return tooltip
end

local function positionTooltip(overlay, tooltip, target)
	local overlaySize = overlay.AbsoluteSize
	local rootPosition = overlay.AbsolutePosition
	local targetPosition = target.AbsolutePosition
	local targetSize = target.AbsoluteSize
	local width = tooltip.AbsoluteSize.X &gt; 0 and tooltip.AbsoluteSize.X or 284
	local x = targetPosition.X - rootPosition.X + targetSize.X + 10
	local y = targetPosition.Y - rootPosition.Y
	if x + width + 10 &gt; overlaySize.X then
		x = targetPosition.X - rootPosition.X - width - 10
	end
	x = math.clamp(x, 10, math.max(10, overlaySize.X - width - 10))
	y = math.clamp(y, 10, math.max(10, overlaySize.Y - 92))
	tooltip.Position = UDim2.fromOffset(x, y)
end

local function attachTooltip(state, overlay, tooltip, target, text)
	if not (state and overlay and tooltip and target) then
		return
	end
	table.insert(state.connections, target.MouseEnter:Connect(function()
		if state.uiHidden then
			return
		end
		tooltip.Text = tostring(text or "")
		positionTooltip(overlay, tooltip, target)
		tooltip.Visible = true
	end))
	table.insert(state.connections, target.MouseLeave:Connect(function()
		tooltip.Visible = false
	end))
	table.insert(state.connections, target.MouseMoved:Connect(function()
		if tooltip.Visible then
			positionTooltip(overlay, tooltip, target)
		end
	end))
end

local function makeButton(parent, text, color, order)
	local button = create("TextButton", {
		Parent = parent,
		AutoButtonColor = true,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 36),
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextStrokeTransparency = 1,
		ZIndex = 132,
	})
	stylePrimary(button, color)
	return button
end

local function makeButtonRow(parent, order)
	local row = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 36),
		ZIndex = 132,
	})
	create("UIListLayout", {
		Parent = row,
