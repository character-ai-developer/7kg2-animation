        </Item>
        <Item class="ModuleScript" referent="RBX73">
          <Properties>
            <string name="Name">MicroAnimationSettingsPopupSupport</string>
            <ProtectedString name="Source">local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))
local InspectorUI = require(script.Parent:WaitForChild("InspectorUI"))
local KeyframeToolsUI = require(script.Parent:WaitForChild("KeyframeToolsUI"))

local MicroAnimationSettingsPopupSupport = {}

local function connect(controller, signal, callback)
	if signal and type(callback) == "function" then
		local connection = signal:Connect(callback)
		table.insert(controller._connections, connection)
		return connection
	end
	return nil
end

local function disconnectAll(controller)
	for _, connection in ipairs(controller._connections or {}) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	controller._connections = {}
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then
		return false, nil, nil
	end
	local ok, first, second, third = pcall(callback, ...)
	if not ok then
		warn("[7kg2 Micro Settings] " .. tostring(first))
		return false, tostring(first), nil
	end
	local message = type(second) == "string" and second or (type(first) == "string" and first or nil)
	if first == false then
		return false, message, nil
	end
	return true, message, third
end

local function runOption(options, callbackName, fallbackActionName, ...)
	options = options or {}
	if type(options[callbackName]) == "function" then
		return safeCall(options[callbackName], ...)
	end
	if fallbackActionName and type(options.onEditorAction) == "function" then
		return safeCall(options.onEditorAction, fallbackActionName, ...)
	end
	return false, nil
end

local function getTimeline(options)
	return type(options) == "table" and type(options.getTimeline) == "function" and options.getTimeline() or nil
end

local function getEditorState(options)
	if type(options) == "table" and type(options.getEditorState) == "function" then
		local ok, state = pcall(options.getEditorState)
		if ok and type(state) == "table" then
			return state
		end
	end
	return {}
end

local function formatNumber(value)
	value = tonumber(value) or 0
	if math.abs(value - math.floor(value + 0.5)) &lt; 0.0005 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.3f", value):gsub("0+$", ""):gsub("%.$", "")
end

local function frameToDisplay(frame, fps, unitMode)
	frame = math.max(0, math.floor(tonumber(frame) or 0))
	fps = math.max(1, tonumber(fps) or Constants.DEFAULT_FPS)
	if unitMode == "Frames" then
		return tostring(frame)
	end
	return formatNumber(frame / fps)
end

local function displayToFrame(textValue, fps, unitMode)
	local value = tonumber(textValue)
	if not value then
		return nil
	end
	if unitMode == "Frames" then
		return math.max(0, math.floor(value + 0.5))
	end
	return math.max(0, math.floor((value * math.max(1, tonumber(fps) or Constants.DEFAULT_FPS)) + 0.5))
end

local function setHint(controller, message)
	controller._lastHint = tostring(message or "")
	if controller.refs._shortcutHint then
		controller.refs._shortcutHint.Text = controller._lastHint ~= "" and controller._lastHint or "Shortcuts: + add keyframe, Ctrl+D delete keys, Ctrl+A select all, G default pose, [/] prev/next frame, Space play/pause, B onion skin, H highlight"
	end
	if controller.refs._shortcutCaptureInput then
		controller.refs._shortcutCaptureInput.Text = controller._lastHint
	end
end

local function afterAction(controller, message)
	if message then
		setHint(controller, message)
	end
	if type(controller.context.onAfterAction) == "function" then
		controller.context.onAfterAction()
	end
	if type(controller.options.onRefresh) == "function" then
		safeCall(controller.options.onRefresh)
	end
	task.defer(function()
		if controller.root and controller.root.Parent then
			controller.refresh()
		end
	end)
end

local function closeDropdowns(refs)
	for _, dropdown in ipairs({
		refs._priorityDropdown,
		refs._easingStyleDropdown,
		refs._easingDirectionDropdown,
	}) do
		if dropdown then
			dropdown.Visible = false
		end
	end
	if refs._microDropdownShield then
		refs._microDropdownShield.Visible = false
	end
end

local function liftDropdownAbovePopup(dropdown, root)
	if not dropdown then
		return
	end

	local baseZ = 260
	dropdown.Active = true
	dropdown.ClipsDescendants = false
	dropdown.ZIndex = baseZ
	for _, descendant in ipairs(dropdown:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex = math.max(descendant.ZIndex, baseZ + 1)
			descendant.ClipsDescendants = false
		end
	end

	local current = dropdown.Parent
	while current and current ~= root do
		if current:IsA("GuiObject") then
			current.ClipsDescendants = false
			current.ZIndex = math.max(current.ZIndex, baseZ - 2)
		end
		current = current.Parent
	end
	if root and root:IsA("GuiObject") then
		root.ClipsDescendants = false
	end
end

local function positionDropdown(dropdown, root, button)
	if not (dropdown and root and button) then
		return
	end

	local menuHeight = dropdown.Size.Y.Offset
	local menuWidth = math.max(140, button.AbsoluteSize.X)
	local rootSize = root.AbsoluteSize
	local buttonX = button.AbsolutePosition.X - root.AbsolutePosition.X
	local buttonY = button.AbsolutePosition.Y - root.AbsolutePosition.Y
	local x = math.clamp(buttonX, 0, math.max(0, rootSize.X - menuWidth))
	local y = buttonY + button.AbsoluteSize.Y + 4
	if y + menuHeight &gt; rootSize.Y then
		y = math.max(0, buttonY - menuHeight - 4)
	end
	dropdown.Position = UDim2.fromOffset(x, y)
	dropdown.Size = UDim2.fromOffset(menuWidth, menuHeight)
end

local function toggleDropdown(refs, dropdown, root, button)
	if not dropdown then
		return
	end
	local nextVisible = not dropdown.Visible
	closeDropdowns(refs)
	if nextVisible then
		positionDropdown(dropdown, root, button)
		liftDropdownAbovePopup(dropdown, root)
		if refs._microDropdownShield then
			refs._microDropdownShield.Visible = true
		end
	end
	dropdown.Visible = nextVisible
end

local function runAndRefresh(controller, callbackName, fallbackActionName, ...)
	local ok, message, result = runOption(controller.options, callbackName, fallbackActionName, ...)
	afterAction(controller, message)
	return ok, message, result
end

local function bindButton(controller, button, callbackName, fallbackActionName, ...)
	if not button then
		return
	end
	local args = { ... }
	connect(controller, button.Activated, function()
		local ok, _, result = runAndRefresh(controller, callbackName, fallbackActionName, table.unpack(args))
		if ok and callbackName == "onGroupKeys" and result ~= nil then
			controller.options._microSelectedGroupIds = { result }
		elseif ok and callbackName == "onUngroupKeys" then
			controller.options._microSelectedGroupIds = nil
		end
	end)
end

local function setMenuClipping(button, root)
	if button then
		button.ClipsDescendants = false
		local current = button.Parent
		while current and current ~= root do
			if current:IsA("GuiObject") then
				current.ClipsDescendants = false
			end
			current = current.Parent
		end
	end
end

local function selectedKeyOptionsFromTimeline(options)
	local timeline = getTimeline(options)
	local getSelectedKeyRefs = type(options) == "table" and options.getSelectedKeyRefs or nil
	if not (timeline and type(timeline.getKeyOptions) == "function" and type(getSelectedKeyRefs) == "function") then
		return {}
	end
	local ok, refs = pcall(getSelectedKeyRefs)
	if not ok or type(refs) ~= "table" or #refs == 0 then
		return {}
	end
	for _, keyRef in ipairs(refs) do
		local path = keyRef.jointPath or keyRef.path
		local frame = keyRef.frame
		if type(path) == "string" and frame ~= nil then
			local keyOptions = timeline:getKeyOptions(path, frame)
			if type(keyOptions) == "table" then
				return keyOptions
			end
		end
	end
	return {}
end

local function getSelectedKeyOptions(options)
	local state = getEditorState(options)
	if type(state.selectedKeyOptions) == "table" then
		return state.selectedKeyOptions
	end
	return selectedKeyOptionsFromTimeline(options)
end

local function getSelectedTrackInfo(options)
	local state = getEditorState(options)
	local selectedPath = state.selectedJointPath
	local timeline = getTimeline(options)
	if type(selectedPath) ~= "string" and type(options.getSelectedTrackPaths) == "function" then
		local ok, paths = pcall(options.getSelectedTrackPaths)
		if ok and type(paths) == "table" then
			selectedPath = paths[1] or next(paths)
		end
	end
	local track = timeline and type(selectedPath) == "string" and timeline:getTrackByPath(selectedPath) or nil
	return selectedPath, track, state
end

local function bindInspectorControls(controller)
	local refs = controller.refs
	local options = controller.options
	bindButton(controller, refs._moveModeInspectorButton, "onSetGizmoMode", "setGizmoMode", "Move")
	bindButton(controller, refs._rotateModeInspectorButton, "onSetGizmoMode", "setGizmoMode", "Rotate")
	bindButton(controller, refs._rotateSpaceButton, "onToggleRotateSpace", "toggleRotateSpace")
	bindButton(controller, refs._trackballRotateInspectorButton, "onBeginTrackballMode", "beginTrackballMode", "Rotate")
	bindButton(controller, refs._trackballMoveInspectorButton, "onBeginTrackballMode", "beginTrackballMode", "Move")
	bindButton(controller, refs._motionRecorderButton, "onRecordMotion", "recordMotion")
	bindButton(controller, refs._onionSkinToggleButton, "onToggleOnionSkin", "toggleOnionSkin")
	bindButton(controller, refs._resetButton, "onResetPose", "resetPose")
	bindButton(controller, refs._copyButton, "onCopyKeys", "copySelectedKeys")
	bindButton(controller, refs._cutButton, "onCutKeys", "cutSelectedKeys")
	bindButton(controller, refs._pasteButton, "onPasteKeys", "pasteKeysAtPlayhead")
	bindButton(controller, refs._selectAllButton, "onSelectAllKeys", "selectAllKeys")
	bindButton(controller, refs._undoButton, "onUndo", "undoLastEdit")
	bindButton(controller, refs._redoButton, "onRedo", "redoLastEdit")
	bindButton(controller, refs._deleteButton, "onDeleteKeys", "deleteCurrentFrame")
	bindButton(controller, refs._groupButton, "onGroupKeys", "groupSelectedKeys")
	bindButton(controller, refs._ungroupButton, "onUngroupKeys", "ungroupSelectedKeys")
	bindButton(controller, refs._mirrorButton, "onMirrorKeys", "mirrorSelectedKeyframes")
	bindButton(controller, refs._invertButton, "onInvertKeys", "invertSelectedKeyframes")
	bindButton(controller, refs._defaultPoseButton, "onDefaultPoseKeyframes", "defaultPoseKeyframes", true)
	bindButton(controller, refs._keyframeAttachObjectButton, "onAttachSelection", "attachHandToSelection")
	bindButton(controller, refs._keyframeDetachObjectButton, "onDetachSelection", "detachAttachedObject")

	if refs._loopingButton then
		connect(controller, refs._loopingButton.Activated, function()
			local timeline = getTimeline(options)
			local looping = timeline and type(timeline.getLooping) == "function" and timeline:getLooping() == true
			runAndRefresh(controller, "onLoopingChanged", "loopingChanged", not looping)
		end)
	end
	if refs._repeatButton then
		connect(controller, refs._repeatButton.Activated, function()
			if type(options.onOpenRepeatFramesPopup) == "function" then
				local ok, message = safeCall(options.onOpenRepeatFramesPopup)
				afterAction(controller, message)
				return ok
			end
			return runAndRefresh(controller, "onRepeatFrames", "repeatFrames", {
				loopCount = "2",
			})
		end)
	end

	if refs._fpsInput then
		connect(controller, refs._fpsInput.FocusLost, function(enterPressed)
			if enterPressed then
				local value = tonumber(refs._fpsInput.Text)
				if value then
					runAndRefresh(controller, "onFpsChanged", "fpsChanged", value)
				end
			end
		end)
	end
	if refs._durationInspectorInput then
		connect(controller, refs._durationInspectorInput.FocusLost, function(enterPressed)
			if enterPressed then
				local timeline = getTimeline(options)
				local fps = timeline and type(timeline.getFps) == "function" and timeline:getFps() or Constants.DEFAULT_FPS
				local frameCount = displayToFrame(refs._durationInspectorInput.Text, fps, controller.timeUnitMode)
				if frameCount then
					runAndRefresh(controller, "onDurationChanged", "durationChanged", frameCount)
				end
			end
		end)
	end
	if refs._moveSnapInput then
		connect(controller, refs._moveSnapInput.FocusLost, function(enterPressed)
			if enterPressed then
				local value = tonumber(refs._moveSnapInput.Text)
				if value then
					runAndRefresh(controller, "onMoveSnapChanged", "setMoveSnap", value)
				end
			end
		end)
	end
	if refs._rotateSnapInput then
		connect(controller, refs._rotateSnapInput.FocusLost, function(enterPressed)
			if enterPressed then
				local value = tonumber(refs._rotateSnapInput.Text)
				if value then
					runAndRefresh(controller, "onRotateSnapChanged", "setRotateSnap", value)
				end
			end
		end)
	end
	if refs._gizmoSizeInput then
		connect(controller, refs._gizmoSizeInput.FocusLost, function(enterPressed)
			if enterPressed then
				local value = tonumber(refs._gizmoSizeInput.Text)
				if value then
					runAndRefresh(controller, "onGizmoSizeChanged", "setGizmoSizePercent", value)
				end
			end
		end)
	end
	if refs._compactGizmoSizeInput then
		connect(controller, refs._compactGizmoSizeInput.FocusLost, function(enterPressed)
			if enterPressed then
				local value = tonumber(refs._compactGizmoSizeInput.Text)
				if value then
					runAndRefresh(controller, "onGizmoSizeChanged", "setGizmoSizePercent", value)
				end
			end
		end)
	end
	if refs._timeUnitToggle then
		connect(controller, refs._timeUnitToggle.Activated, function()
			controller.timeUnitMode = controller.timeUnitMode == "Frames" and "Seconds" or "Frames"
			controller.refresh()
		end)
	end

	controller.refs._microDropdownShield = UiHelpers.create("TextButton", {
		Name = "DropdownClickShield",
		Parent = controller.root,
		Active = true,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Modal = true,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Visible = false,
		ZIndex = 259,
	})
	connect(controller, controller.refs._microDropdownShield.Activated, function()
		closeDropdowns(refs)
	end)

	for _, dropdown in ipairs({
		refs._priorityDropdown,
		refs._easingStyleDropdown,
		refs._easingDirectionDropdown,
	}) do
		if dropdown then
			dropdown.Parent = controller.root
		end
	end
	liftDropdownAbovePopup(refs._priorityDropdown, controller.root)
	liftDropdownAbovePopup(refs._easingStyleDropdown, controller.root)
	liftDropdownAbovePopup(refs._easingDirectionDropdown, controller.root)
	if refs._priorityButton then
		connect(controller, refs._priorityButton.Activated, function()
			toggleDropdown(refs, refs._priorityDropdown, controller.root, refs._priorityButton)
		end)
	end
	for priorityName, optionButton in pairs(refs._priorityOptionButtons or {}) do
		connect(controller, optionButton.Activated, function()
			closeDropdowns(refs)
			runAndRefresh(controller, "onPriorityChanged", "priorityChanged", priorityName)
		end)
	end
	if refs._easingStyleButton then
		connect(controller, refs._easingStyleButton.Activated, function()
			toggleDropdown(refs, refs._easingStyleDropdown, controller.root, refs._easingStyleButton)
		end)
	end
	for easingStyle, optionButton in pairs(refs._easingStyleOptionButtons or {}) do
		connect(controller, optionButton.Activated, function()
			closeDropdowns(refs)
			runAndRefresh(controller, "onSetEasingStyle", "setSelectedEasingStyle", easingStyle)
		end)
	end
	if refs._easingDirectionButton then
		connect(controller, refs._easingDirectionButton.Activated, function()
			toggleDropdown(refs, refs._easingDirectionDropdown, controller.root, refs._easingDirectionButton)
		end)
	end
	for easingDirection, optionButton in pairs(refs._easingDirectionOptionButtons or {}) do
		connect(controller, optionButton.Activated, function()
			closeDropdowns(refs)
			runAndRefresh(controller, "onSetEasingDirection", "setSelectedEasingDirection", easingDirection)
		end)
	end

	if refs._cameraApplyFovButton then
		connect(controller, refs._cameraApplyFovButton.Activated, function()
			runAndRefresh(controller, "onApplyCameraFov", "applySelectedCameraFov", refs._cameraFovInput and refs._cameraFovInput.Text or "")
		end)
	end
	if refs._cameraCaptureButton then
		connect(controller, refs._cameraCaptureButton.Activated, function()
			runAndRefresh(controller, "onCaptureCameraTrack", "captureCameraTrackAtPlayhead")
		end)
	end
	local cameraPresets = {
		{ refs._cameraPresetShakeButton, "ExplosionShake" },
		{ refs._cameraPresetHandheldButton, "SoftHandheld" },
		{ refs._cameraPresetOrbitButton, "Orbit" },
		{ refs._cameraPresetFollowButton, "FollowRig" },
	}
	for _, pair in ipairs(cameraPresets) do
		local button = pair[1]
		local presetId = pair[2]
		if button then
			connect(controller, button.Activated, function()
				runAndRefresh(controller, "onApplyCameraPreset", "applyCameraPreset", presetId, {})
			end)
		end
	end
end

local function updateDropdownOptionHighlight(optionButtons, selectedOption)
	if type(UiHelpers.updateDropdownOptionHighlight) == "function" then
		UiHelpers.updateDropdownOptionHighlight(optionButtons, selectedOption)
	end
end

local function applyTileState(button, active)
	if button then
		UiHelpers.setIconTileActive(button, active == true)
	end
end

function MicroAnimationSettingsPopupSupport.mount(parent, context)
	if not parent then
		error("MicroAnimationSettingsPopupSupport.mount requires parent")
	end

	local controller = {
		context = context or {},
		options = (context and context.options) or {},
		_connections = {},
		_lastHint = "",
		timeUnitMode = "Seconds",
		root = parent,
		refs = {},
	}

	local inspectorRefs = InspectorUI.mount(parent, {})
	for key, value in pairs(inspectorRefs or {}) do
		controller.refs[key] = value
	end
	if controller.refs._inspectorCard then
		controller.refs._inspectorCard.Position = UDim2.fromOffset(6, 6)
		controller.refs._inspectorCard.Size = UDim2.new(1, -14, 1, -12)
	end
	if controller.refs._inspectorCollapseButton then
		controller.refs._inspectorCollapseButton.Visible = false
	end
	if controller.refs._keyframeToolsHost then
		local keyframeRefs = KeyframeToolsUI.mount(controller.refs._keyframeToolsHost, {
			embedded = true,
		})
		for key, value in pairs(keyframeRefs or {}) do
			controller.refs[key] = value
		end
	end

	bindInspectorControls(controller)

	function controller.refresh()
		local timeline = getTimeline(controller.options)
		local state = getEditorState(controller.options)
		local focusedTextBox = UserInputService:GetFocusedTextBox()
		local fps = timeline and type(timeline.getFps) == "function" and timeline:getFps() or Constants.DEFAULT_FPS
		local durationFrames = timeline and type(timeline.getDurationFrames) == "function" and timeline:getDurationFrames() or Constants.DEFAULT_DURATION_FRAMES
		local looping = timeline and type(timeline.getLooping) == "function" and timeline:getLooping() == true
		local priority = timeline and type(timeline.getPriority) == "function" and tostring(timeline:getPriority() or "Action") or "Action"
		local keyOptions = getSelectedKeyOptions(controller.options)
		local selectedEasingStyle = tostring(keyOptions.easingStyle or Constants.DEFAULT_EASING_STYLE)
		local selectedEasingDirection = tostring(keyOptions.easingDirection or Constants.DEFAULT_EASING_DIRECTION)
		local selectedPath, selectedTrack = getSelectedTrackInfo(controller.options)

		if controller.refs._fpsInput and focusedTextBox ~= controller.refs._fpsInput then
			controller.refs._fpsInput.Text = tostring(fps)
		end
		if controller.refs._durationInspectorInput and focusedTextBox ~= controller.refs._durationInspectorInput then
			controller.refs._durationInspectorInput.Text = frameToDisplay(durationFrames, fps, controller.timeUnitMode)
		end
		if controller.refs._durationInspectorLabel then
			controller.refs._durationInspectorLabel.Text = controller.timeUnitMode == "Frames" and "Animation Length (Frames)" or "Animation Length (Seconds)"
		end
		if controller.refs._timeUnitToggle then
			controller.refs._timeUnitToggle.Text = controller.timeUnitMode
			controller.refs._timeUnitToggle.BackgroundColor3 = controller.timeUnitMode == "Seconds" and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		end
		if controller.refs._moveSnapInput and focusedTextBox ~= controller.refs._moveSnapInput then
			controller.refs._moveSnapInput.Text = formatNumber(state.moveSnap or Constants.DEFAULT_MOVE_SNAP)
		end
		if controller.refs._rotateSnapInput and focusedTextBox ~= controller.refs._rotateSnapInput then
			controller.refs._rotateSnapInput.Text = formatNumber(state.rotateSnapDegrees or Constants.DEFAULT_ROTATE_SNAP_DEGREES)
		end
		if controller.refs._gizmoSizeInput and focusedTextBox ~= controller.refs._gizmoSizeInput then
			controller.refs._gizmoSizeInput.Text = tostring(math.floor((state.gizmoSizePercent or Constants.DEFAULT_GIZMO_SIZE_PERCENT or 100) + 0.5))
		end
		if controller.refs._compactGizmoSizeInput and focusedTextBox ~= controller.refs._compactGizmoSizeInput then
			controller.refs._compactGizmoSizeInput.Text = tostring(math.floor((state.gizmoSizePercent or Constants.DEFAULT_GIZMO_SIZE_PERCENT or 100) + 0.5))
		end
		if controller.refs._rotateSpaceButton then
			local rotateSpace = state.rotateSpace == "World" and "World" or "Local"
			controller.refs._rotateSpaceButton.Text = "Space: " .. rotateSpace
			controller.refs._rotateSpaceButton.BackgroundColor3 = rotateSpace == "World" and Color3.fromRGB(255, 160, 55) or Constants.THEME.PanelSoft
			controller.refs._rotateSpaceButton.TextColor3 = rotateSpace == "World" and Color3.fromRGB(24, 18, 8) or Constants.THEME.Text
		end
		if controller.refs._loopingButton then
			controller.refs._loopingButton.Text = looping and "Looping: On" or "Looping: Off"
			controller.refs._loopingButton.BackgroundColor3 = looping and Constants.THEME.Success or Constants.THEME.PanelSoft
		end
		if controller.refs._priorityButton then
			controller.refs._priorityButton.Text = priority .. " v"
		end
		local activeTrackballMode = state.trackballMode
		applyTileState(controller.refs._moveModeInspectorButton, not activeTrackballMode and state.gizmoMode == "Move")
		applyTileState(controller.refs._rotateModeInspectorButton, not activeTrackballMode and state.gizmoMode == "Rotate")
		applyTileState(controller.refs._trackballRotateInspectorButton, activeTrackballMode == "Rotate")
		applyTileState(controller.refs._trackballMoveInspectorButton, activeTrackballMode == "Move")
		if controller.refs._motionRecorderButton then
			local recorderState = state.motionRecorder or {}
			local recording = recorderState.recording == true
			local armed = recorderState.armed == true
			controller.refs._motionRecorderButton.Text = recording and "Recording..." or (armed and "Record Armed" or "Record Motion")
			UiHelpers.setIconTileActive(controller.refs._motionRecorderButton, recording or armed)
			controller.refs._motionRecorderButton.BackgroundColor3 = (recording or armed) and Constants.THEME.Danger or Constants.THEME.PanelSoft
		end
		if controller.refs._onionSkinToggleButton then
			local onion = state.onionSkin or {}
			local enabled = onion.enabled == true
			controller.refs._onionSkinToggleButton.Text = ""
			controller.refs._onionSkinToggleButton.TextTransparency = 1
			controller.refs._onionSkinToggleButton.TextSize = 1
			controller.refs._onionSkinToggleButton.BackgroundColor3 = enabled and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		end
		if controller.refs._easingStyleButton then
			controller.refs._easingStyleButton.Text = ""
			controller.refs._easingStyleButton.TextTransparency = 1
			controller.refs._easingStyleButton.TextSize = 1
			local subtext = controller.refs._easingStyleButton:FindFirstChild("MegMoActionSubtext")
			if subtext and subtext:IsA("TextLabel") then
				subtext.Text = selectedEasingStyle
				subtext.Visible = true
			end
		end
		if controller.refs._easingDirectionButton then
			controller.refs._easingDirectionButton.Text = ""
			controller.refs._easingDirectionButton.TextTransparency = 1
			controller.refs._easingDirectionButton.TextSize = 1
			local subtext = controller.refs._easingDirectionButton:FindFirstChild("MegMoActionSubtext")
			if subtext and subtext:IsA("TextLabel") then
				subtext.Text = selectedEasingDirection
				subtext.Visible = true
			end
		end
		updateDropdownOptionHighlight(controller.refs._easingStyleOptionButtons, selectedEasingStyle)
		updateDropdownOptionHighlight(controller.refs._easingDirectionOptionButtons, selectedEasingDirection)
		updateDropdownOptionHighlight(controller.refs._priorityOptionButtons, priority)
		if controller.refs._cameraToolsCard then
			local showCamera = selectedTrack and (selectedTrack.trackType == "Camera" or selectedTrack.trackType == "Camera Property")
			controller.refs._cameraToolsCard.Visible = showCamera == true
		end
		if controller.refs._keyframeAttachObjectButton and controller.refs._keyframeDetachObjectButton then
			local showAttach = selectedTrack and selectedTrack.trackType == "Rig" and type(selectedPath) == "string"
			controller.refs._keyframeAttachObjectButton.Visible = showAttach == true
			controller.refs._keyframeDetachObjectButton.Visible = showAttach == true
		end
		if controller.refs._status then
			local selectedKeys = type(controller.options.getSelectedKeyRefs) == "function" and controller.options.getSelectedKeyRefs() or {}
			local trackLabel = selectedTrack and tostring(selectedTrack.name or selectedTrack.path or "Selected track") or "No track selected"
			controller.refs._status.Text = string.format(
				"%s\n%d selected key%s. Use the same edit, easing, repeat, attach, and pose controls as Main.",
				trackLabel,
				#selectedKeys,
				#selectedKeys == 1 and "" or "s"
			)
		end
	end

	controller._heartbeat = RunService.Heartbeat:Connect(function()
		if not controller.root or not controller.root.Parent then
			disconnectAll(controller)
			return
		end
		local now = os.clock()
		if now - (controller._lastRefresh or 0) &gt;= 0.25 then
			controller._lastRefresh = now
			controller.refresh()
		end
	end)
	table.insert(controller._connections, controller._heartbeat)

	function controller.destroy()
		disconnectAll(controller)
		if parent and parent.Parent then
			parent:ClearAllChildren()
		end
	end

	controller.refresh()
	ThemeService.applyToGui(parent)
	return controller
end

return MicroAnimationSettingsPopupSupport
