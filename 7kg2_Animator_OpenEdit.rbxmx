			self:_hideWiggleFramesOverlay()
			self:_focusShortcutCapture("Shortcut capture: active after Wiggle")
		end)
	end
	if self._wiggleFramesCancelButton then
		self:_connect(self._wiggleFramesCancelButton.Activated, function()
			self:_hideWiggleFramesOverlay()
			self:_focusShortcutCapture("Shortcut capture: active after Wiggle")
		end)
	end
	if self._wiggleFramesEasingStyleButton then
		self:_connect(self._wiggleFramesEasingStyleButton.Activated, function()
			if self._wiggleFramesEasingDirectionDropdown then
				self._wiggleFramesEasingDirectionDropdown.Visible = false
			end
			if self._wiggleFramesEasingStyleDropdown then
				self._wiggleFramesEasingStyleDropdown.Visible = not self._wiggleFramesEasingStyleDropdown.Visible
			end
		end)
	end
	if self._wiggleFramesEasingDirectionButton then
		self:_connect(self._wiggleFramesEasingDirectionButton.Activated, function()
			if self._wiggleFramesEasingStyleDropdown then
				self._wiggleFramesEasingStyleDropdown.Visible = false
			end
			if self._wiggleFramesEasingDirectionDropdown then
				self._wiggleFramesEasingDirectionDropdown.Visible = not self._wiggleFramesEasingDirectionDropdown.Visible
			end
		end)
	end
	for easingStyle, optionButton in pairs(self._wiggleFramesEasingStyleOptionButtons or {}) do
		self:_connect(optionButton.Activated, function()
			self._wiggleFramesEasingStyle = easingStyle
			if self._wiggleFramesEasingStyleButton then
				self._wiggleFramesEasingStyleButton.Text = easingStyle .. " v"
			end
			if self._wiggleFramesEasingStyleDropdown then
				self._wiggleFramesEasingStyleDropdown.Visible = false
			end
		end)
	end
	for easingDirection, optionButton in pairs(self._wiggleFramesEasingDirectionOptionButtons or {}) do
		self:_connect(optionButton.Activated, function()
			self._wiggleFramesEasingDirection = easingDirection
			if self._wiggleFramesEasingDirectionButton then
				self._wiggleFramesEasingDirectionButton.Text = easingDirection .. " v"
			end
			if self._wiggleFramesEasingDirectionDropdown then
				self._wiggleFramesEasingDirectionDropdown.Visible = false
			end
		end)
	end
	if self._wiggleFramesOkButton then
		self:_connect(self._wiggleFramesOkButton.Activated, function()
			if callbacks.onApplyAnimationEffect then
				callbacks.onApplyAnimationEffect("Wiggle", self:_getWiggleFramesOptions())
			end
			self:_hideWiggleFramesOverlay()
			self:_focusShortcutCapture("Shortcut capture: active after Wiggle")
		end)
	end

	self:_connect(self._defaultPoseButton.Activated, function()
		if callbacks.onDefaultPoseKeyframes then
			callbacks.onDefaultPoseKeyframes(true)
		end
		self:_focusShortcutCapture("Shortcut capture: active after Reset Selected Limb")
	end)

	self:_connect(self._easingStyleButton.Activated, function()
		self:_toggleDropdown("style")
	end)

	self:_connect(self._easingDirectionButton.Activated, function()
		self:_toggleDropdown("direction")
	end)

	for easingStyle, optionButton in pairs(self._easingStyleOptionButtons or {}) do
		self:_connect(optionButton.Activated, function()
			self:_closeDropdowns()
			if callbacks.onSetEasingStyle then
				callbacks.onSetEasingStyle(easingStyle)
			end
			self:_focusShortcutCapture("Shortcut capture: active after easing change")
		end)
	end

	for easingDirection, optionButton in pairs(self._easingDirectionOptionButtons or {}) do
		self:_connect(optionButton.Activated, function()
			self:_closeDropdowns()
			if callbacks.onSetEasingDirection then
				callbacks.onSetEasingDirection(easingDirection)
			end
			self:_focusShortcutCapture("Shortcut capture: active after easing change")
		end)
	end

	self:_connect(self._resetButton.Activated, function()
		callbacks.onResetPose()
	end)

	self:_connect(self._playPauseButton.Activated, function()
		callbacks.onPlayPause()
	end)

	self:_connect(self._stopButton.Activated, function()
		callbacks.onStop()
	end)

	if self._bakePreviewButton then
		self:_connect(self._bakePreviewButton.Activated, function()
			if callbacks.onBakePreview then
				callbacks.onBakePreview()
			elseif callbacks.onPlayPause then
				callbacks.onPlayPause(true)
			end
		end)
	end

	self:_connect(self._prevButton.Activated, function()
		callbacks.onPreviousKeyframe()
	end)

	self:_connect(self._nextButton.Activated, function()
		callbacks.onNextKeyframe()
	end)

	self:_connect(self._moveLeftButton.Activated, function()
		callbacks.onMoveKeyframeLeft()
	end)

	self:_connect(self._moveRightButton.Activated, function()
		callbacks.onMoveKeyframeRight()
	end)

	self:_connect(self._frameInput.FocusLost, function(enterPressed)
		if not enterPressed then
			return
		end

		local value = self:_valueToFrame(self._frameInput.Text, self._lastViewModel and self._lastViewModel.fps or Constants.DEFAULT_FPS)
		if value then
			callbacks.onFrameChanged(value)
		end
	end)
	self:_connect(self._frameInput.InputBegan, function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		task.defer(function()
			if self._frameInput and self._frameInput.Parent then
				self._frameInput:ReleaseFocus()
				self:_setTimeUnitMode(self:_getTimeUnitMode() == "Frames" and "Seconds" or "Frames")
			end
		end)
	end)

	self:_connect(self._fpsInput.FocusLost, function(enterPressed)
		local value = tonumber(self._fpsInput.Text)
		if value then
			callbacks.onFpsChanged(value)
		end
	end)

	self:_connect(self._moveSnapInput.FocusLost, function(enterPressed)
		if not enterPressed then
			return
		end

		local value = tonumber(self._moveSnapInput.Text)
		if value then
			callbacks.onMoveSnapChanged(value)
		end
	end)

	self:_connect(self._rotateSnapInput.FocusLost, function(enterPressed)
		if not enterPressed then
			return
		end

		local value = tonumber(self._rotateSnapInput.Text)
		if value then
			callbacks.onRotateSnapChanged(value)
		end
	end)

	if self._gizmoSizeInput then
		self:_connect(self._gizmoSizeInput.FocusLost, function(enterPressed)
			if not enterPressed then
				return
			end

			local value = tonumber(self._gizmoSizeInput.Text)
			if value and callbacks.onGizmoSizeChanged then
				callbacks.onGizmoSizeChanged(value)
			end
		end)
	end

	if self._cameraFovInput then
		self:_connect(self._cameraFovInput.FocusLost, function(enterPressed)
			if not enterPressed then
				return
			end

			if callbacks.onApplyCameraFov then
				callbacks.onApplyCameraFov(self._cameraFovInput.Text)
			end
		end)
	end

	if self._cameraTrackEditorFovInput then
		self:_connect(self._cameraTrackEditorFovInput.FocusLost, function(enterPressed)
			if not enterPressed then
				return
			end

			if callbacks.onApplyCameraFov then
				callbacks.onApplyCameraFov(self._cameraTrackEditorFovInput.Text)
			end
		end)
	end

	self:_connect(self._durationInput.FocusLost, function(enterPressed)
		if not enterPressed then
			return
		end

		local value = self:_valueToFrame(self._durationInput.Text, self._lastViewModel and self._lastViewModel.fps or Constants.DEFAULT_FPS)
		if value then
			callbacks.onDurationChanged(value)
		end
	end)
	self:_connect(self._durationInput.InputBegan, function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		task.defer(function()
			if self._durationInput and self._durationInput.Parent then
				self._durationInput:ReleaseFocus()
			end
			self._layoutPanelVisibility.Inspector = true
			self._collapsedPanels.Inspector = false
			self:_refreshLayoutVisibility()
			if type(self._showAnimationTimingSettings) == "function" then
				self._showAnimationTimingSettings()
			end
			if self._durationInspectorInput and self._durationInspectorInput.Parent then
				self._durationInspectorInput:CaptureFocus()
			end
		end)
	end)

	self:_connect(self._durationInspectorInput.FocusLost, function(enterPressed)
		if not enterPressed then
			return
		end

		local value = self:_valueToFrame(self._durationInspectorInput.Text, self._lastViewModel and self._lastViewModel.fps or Constants.DEFAULT_FPS)
		if value then
			callbacks.onDurationChanged(value)
		end
	end)

	self:_connect(self._timeUnitToggle.Activated, function()
		self:_setTimeUnitMode(self:_getTimeUnitMode() == "Frames" and "Seconds" or "Frames")
	end)

	self:_connect(self._loopingButton.Activated, function()
		local isLooping = self._loopingButton.Text == "Looping: On"
		callbacks.onLoopingChanged(not isLooping)
	end)

	if self._priorityButton then
		self:_connect(self._priorityButton.Activated, function()
			self:_toggleDropdown("priority")
		end)
	end
	for priorityName, optionButton in pairs(self._priorityOptionButtons or {}) do
		self:_connect(optionButton.Activated, function()
			self:_closeDropdowns()
			if callbacks.onPriorityChanged then
				callbacks.onPriorityChanged(priorityName)
			end
			self:_focusShortcutCapture("Animation priority set to " .. tostring(priorityName))
		end)
	end
end

function WidgetController:update(viewModel)
	local perfToken = PerformanceDebugService.begin("UI Refresh")
	local savedLaneCanvasPosition = self._laneContainer and self._laneContainer.CanvasPosition or Vector2.new()
	local savedTrackCanvasPosition = Vector2.new(0, savedLaneCanvasPosition.Y)
	local savedJointCanvasPosition = self._jointsList and self._jointsList.CanvasPosition or Vector2.new()
	local pendingScrollRestore = self._pendingTimelineCanvasRestore
	if pendingScrollRestore and os.clock() &lt;= (pendingScrollRestore.expiresAt or 0) then
		savedLaneCanvasPosition = pendingScrollRestore.laneCanvasPosition or savedLaneCanvasPosition
		savedTrackCanvasPosition = Vector2.new(
			savedTrackCanvasPosition.X,
			pendingScrollRestore.trackCanvasY or savedLaneCanvasPosition.Y
		)
		self._pendingTimelineCanvasRestore = nil
	end
	local shouldRestoreTimelineCanvas = pendingScrollRestore and os.clock() &lt;= (pendingScrollRestore.expiresAt or 0)
	self._lastViewModel = viewModel
	local themeId = viewModel.theme and viewModel.theme.currentThemeId
	if themeId and themeId ~= self._lastAppliedThemeId then
		self._lastAppliedThemeId = themeId
		self:_applyMountedTheme()
	end
	if self._status then
		self._status.Text = viewModel.status or ""
	end
	if self._autoSaveLabel then
		local autoSave = viewModel.autoSave or {}
		self._autoSaveLabel.Text = "Auto Save - " .. (autoSave.label or "Ready")
	end
	if self._autoSaveDot then
		local autoSave = viewModel.autoSave or {}
		if autoSave.state == "error" then
			self._autoSaveDot.BackgroundColor3 = Color3.fromRGB(218, 86, 112)
		elseif autoSave.state == "pending" or autoSave.isPending then
			self._autoSaveDot.BackgroundColor3 = Color3.fromRGB(236, 190, 92)
		else
			self._autoSaveDot.BackgroundColor3 = Constants.THEME.Success
		end
	end
	if self._rigPropertyEditorOverlay and self._rigPropertyEditorOverlay.Visible then
		self:_renderRigPropertyEditor()
	end
	if self._effectTrackEditorOverlay and self._effectTrackEditorOverlay.Visible then
		self:_renderEffectTrackEditor()
	end
	if self._cameraTrackEditorOverlay and self._cameraTrackEditorOverlay.Visible then
		self:_renderCameraTrackEditor()
	end
	if self._particleKeyframeEditorOverlay and self._particleKeyframeEditorOverlay.Visible then
		self:_renderParticleKeyframeEditor()
	end
	if self._propertyKeyframeEditorOverlay and self._propertyKeyframeEditorOverlay.Visible then
		self:_renderPropertyKeyframeEditor()
	end
	if self._soundKeyframeEditorOverlay and self._soundKeyframeEditorOverlay.Visible then
		self:_renderSoundKeyframeEditor()
	end
	if self._cameraFollowOverlay and self._cameraFollowOverlay.Visible and self._cameraFollowModeLabel then
		-- keep the follow overlay mounted above the camera popup without changing its selection context
	end
	if self._importStatusLabel then
		self._importStatusLabel.Text = viewModel.importActionStatus
			or viewModel.importBrowserStatus
			or "Ready to import."
	end
	self:_setPresetSource(viewModel.importBrowserSource)
	self:_renderImportAnimationEntries(viewModel.importAnimationEntries or {}, viewModel.importBrowserStatus)
	self:_renderMotionRecipeEntries(viewModel)
	if self._presetStatusLabel then
		local pickerMotion = tostring(self._motionDefaultPickerMotion or "")
		local segmentPickerKey = tostring(self._motionSegmentPickerKey or "")
		self._presetStatusLabel.Text = pickerMotion ~= ""
			and ((viewModel.importBrowserStatus or "Loading your animations.") .. " Choose one to use as the default " .. pickerMotion .. " clip.")
			or segmentPickerKey ~= ""
				and ((viewModel.importBrowserStatus or "Loading your animations.") .. " Choose one to use as the custom " .. tostring(self._motionSegmentPickerLabel or "segment") .. " clip.")
			or viewModel.importActionStatus
			or viewModel.importBrowserStatus
			or "Click Roblox Starter to load official Roblox starter animations."
	end
	self:_renderPresetBrowserEntries(viewModel.importAnimationEntries or {}, viewModel.importBrowserStatus)
	self:_renderScreenEffects(viewModel)
	if self._uiSections.FacesUI and type(self._uiSections.FacesUI.render) == "function" then
		local ok, err = pcall(self._uiSections.FacesUI.render, self, viewModel.faces or {})
		if not ok then
			warn("[7kg2 Animator] Failed to render Faces UI", err)
		end
	end
	local timelineMetrics = self:_syncTimelineCanvas(viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
	local zoomAlpha = math.log((self._timelineZoom or 1) / TIMELINE_MIN_ZOOM) / math.log(TIMELINE_MAX_ZOOM / TIMELINE_MIN_ZOOM)
	if self._zoomSliderFill then
		self._zoomSliderFill.Size = UDim2.new(math.clamp(zoomAlpha, 0, 1), 0, 1, 0)
	end
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local fps = viewModel.fps or Constants.DEFAULT_FPS
	local durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
	local currentFrame = viewModel.currentFrame or 0
	local unitMode = self:_getTimeUnitMode()
	local durationText = self:_formatFrameValue(durationFrames, fps)
	local frameText = self:_formatFrameValue(currentFrame, fps)
	if self._animationNameInput and focusedTextBox ~= self._animationNameInput then
		self._animationNameInput.Text = viewModel.animationName or "Untitled Animation"
	end
	if self._rigLabel then
		self._rigLabel.Text = "Rig: " .. (viewModel.rigName or "No rig bound")
	end
	if self._boundRigValue then
		self._boundRigValue.Text = viewModel.rigName or "No rig bound"
	end
	if self._keyframeSummary then
		self._keyframeSummary.Text = string.format("Keyframes: %d", viewModel.keyframeCount or 0)
	end
	if self._keyframeSummaryValue then
		self._keyframeSummaryValue.Text = tostring(viewModel.keyframeCount or 0)
	end
	if self._durationSummary then
		self._durationSummary.Text = self:_formatTimelineSummary(durationFrames, fps)
	end
	if self._durationSummaryValue then
		self._durationSummaryValue.Text = string.format("%.2f sec", durationFrames / math.max(1, fps))
	end
	if self._fpsSummaryValue then
		self._fpsSummaryValue.Text = tostring(fps)
	end
	if self._selectedJointSummary then
		self._selectedJointSummary.Text = "Selected Track: " .. (viewModel.selectedJointPath or "none")
	end
	if self._performanceDebugLabel then
		local perf = viewModel.performanceDebug or {}
		self._performanceDebugLabel.Visible = perf.enabled == true
		self._performanceDebugLabel.Text = perf.enabled == true
			and ((perf.title or "Performance Debug: On") .. "\n" .. (perf.summary or ""))
			or "Performance Debug: Off"
	end
	if focusedTextBox ~= self._frameInput then
		self._frameInput.Text = frameText
	end
	if focusedTextBox ~= self._durationInput then
		self._durationInput.Text = durationText
	end
	if focusedTextBox ~= self._fpsInput then
		self._fpsInput.Text = tostring(fps)
	end
	if focusedTextBox ~= self._durationInspectorInput then
		self._durationInspectorInput.Text = durationText
	end
	if focusedTextBox ~= self._moveSnapInput then
		self._moveSnapInput.Text = formatNumber(viewModel.moveSnap or Constants.DEFAULT_MOVE_SNAP)
	end
	if focusedTextBox ~= self._rotateSnapInput then
		self._rotateSnapInput.Text = formatNumber(viewModel.rotateSnapDegrees or Constants.DEFAULT_ROTATE_SNAP_DEGREES)
	end
	if self._gizmoSizeInput and focusedTextBox ~= self._gizmoSizeInput then
		self._gizmoSizeInput.Text = tostring(math.floor((viewModel.gizmoSizePercent or Constants.DEFAULT_GIZMO_SIZE_PERCENT or 100) + 0.5))
	end
	if focusedTextBox ~= self._cameraFovInput and self._cameraFovInput then
		local cameraState = viewModel.selectedCameraState or {}
		local fieldOfView = tonumber(cameraState.fieldOfView)
		self._cameraFovInput.Text = fieldOfView and formatNumber(fieldOfView) or ""
	end
	if self._frameInput then
		self._frameInput.PlaceholderText = unitMode == "Seconds" and "Seconds" or "Frame"
	end
	if self._durationInput then
		self._durationInput.PlaceholderText = unitMode == "Seconds" and "Seconds" or "Length"
	end
	if self._durationInspectorInput then
		self._durationInspectorInput.PlaceholderText = unitMode == "Seconds" and "Seconds" or "Frames"
	end
	if self._durationInspectorLabel then
		self._durationInspectorLabel.Text = unitMode == "Seconds" and "Animation Length (Seconds)" or "Animation Length (Frames)"
	end
	if self._timeUnitToggle then
		self._timeUnitToggle.Text = unitMode
		self._timeUnitToggle.BackgroundColor3 = unitMode == "Seconds" and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	end
	if self._loopingButton then
		self._loopingButton.Text = (viewModel.looping and "Looping: On" or "Looping: Off")
		self._loopingButton.BackgroundColor3 = viewModel.looping and Constants.THEME.Success or Constants.THEME.PanelSoft
	end
	local selectedPriority = viewModel.priority or "Action"
	if self._priorityButton then
		self._priorityButton.Text = selectedPriority .. " v"
	elseif self._priorityLabel then
		self._priorityLabel.Text = selectedPriority
	end
	if self._cameraToolsCard then
		self._cameraToolsCard.Visible = false
	end
	if self._playPauseButton then
		self._playPauseButton.Text = viewModel.isPlaying and "Pause" or "Play"
		UiHelpers.setButtonIcon(self._playPauseButton, viewModel.isPlaying and "Pause" or "Play")
	end
	local activeTrackballMode = viewModel.trackballMode
	if self._moveModeButton then
		UiHelpers.setIconTileActive(self._moveModeButton, not activeTrackballMode and viewModel.gizmoMode == "Move")
	end
	if self._rotateModeButton then
		UiHelpers.setIconTileActive(self._rotateModeButton, not activeTrackballMode and viewModel.gizmoMode == "Rotate")
	end
	if self._moveModeInspectorButton then
		UiHelpers.setIconTileActive(self._moveModeInspectorButton, not activeTrackballMode and viewModel.gizmoMode == "Move")
	end
	if self._rotateModeInspectorButton then
		UiHelpers.setIconTileActive(self._rotateModeInspectorButton, not activeTrackballMode and viewModel.gizmoMode == "Rotate")
	end
	if self._rotateSpaceButton then
		local rotateSpace = viewModel.rotateSpace == "World" and "World" or "Local"
		self._rotateSpaceButton.Text = "Space: " .. rotateSpace
		self._rotateSpaceButton.BackgroundColor3 = rotateSpace == "World" and Color3.fromRGB(255, 160, 55) or Constants.THEME.PanelSoft
		self._rotateSpaceButton.TextColor3 = rotateSpace == "World" and Color3.fromRGB(24, 18, 8) or Constants.THEME.Text
	end
	if self._trackballRotateInspectorButton then
		UiHelpers.setIconTileActive(self._trackballRotateInspectorButton, activeTrackballMode == "Rotate")
	end
	if self._trackballMoveInspectorButton then
		UiHelpers.setIconTileActive(self._trackballMoveInspectorButton, activeTrackballMode == "Move")
	end
	self:_setWorkspaceGrabButtonActive(viewModel.workspaceGrabActive == true)
	if self._motionRecorderButton then
		local recorderState = viewModel.motionRecorder or {}
		local isRecording = recorderState.recording == true
		local isArmed = recorderState.armed == true
		local recordActive = isRecording or isArmed
		self._motionRecorderButton.Text = isRecording and "Recording..." or (isArmed and "Record Armed" or "Record Motion")
		UiHelpers.setButtonIcon(self._motionRecorderButton, "RecordMotion", {
			iconOnly = true,
			color = recordActive and Constants.THEME.Danger or nil,
			noPadding = true,
			position = UDim2.fromScale(0.5, 0.5),
			size = 34,
		})
		UiHelpers.setIconTileActive(self._motionRecorderButton, recordActive)
		local recordIcon = self._motionRecorderButton:FindFirstChild("MegMoButtonIcon")
		if recordIcon and recordIcon:IsA("ImageLabel") then
			recordIcon.ImageColor3 = recordActive and Constants.THEME.Danger or Constants.THEME.Text
			recordIcon:SetAttribute("MegMoThemeImageRole", recordActive and "Danger" or "Text")
		end
		self._motionRecorderButton.BackgroundColor3 = Constants.THEME.PanelSoft
		self._motionRecorderButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	end
	if self._onionSkinToggleButton then
		local onionSkin = viewModel.onionSkin or {}
		local enabled = onionSkin.enabled == true
		self._onionSkinToggleButton.Text = ""
		self._onionSkinToggleButton.TextTransparency = 1
		self._onionSkinToggleButton.TextSize = 1
		self._onionSkinToggleButton.BackgroundColor3 = enabled and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	end
	if self._avatarRigTypeButton then
		self:_setAvatarRigType(self._avatarRigType or "R15Classic")
	end
	if self._multiSelectButton then
		self._multiSelectButton.Text = self._multiSelectLocked and "Multi Select: On" or "Multi Select: Off"
		self._multiSelectButton.BackgroundColor3 = self._multiSelectLocked and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	end
	if self._selectRigButton then
		self._selectRigButton.Text = viewModel.rigName and viewModel.rigName ~= "No rig bound" and "Select Rig In Studio" or "Select Rig"
	end
	if self._selectJointPartButton then
		self._selectJointPartButton.Text = viewModel.selectedJointPartName and ("Select " .. viewModel.selectedJointPartName) or "Select Joint Part"
	end
	if self._motionRigValueLabel then
		self._motionRigValueLabel.Text = viewModel.rigName or "No rig bound"
	end
	if self._motionSelectRigButton then
		self._motionSelectRigButton.Text = "Use Selected Rig"
	end
	local motionPreview = viewModel.motionPreview or {}
	local isMotionPreviewing = motionPreview.isPreviewing == true
	if self._motionPreviewPathButton then
		self._motionPreviewPathButton.Text = isMotionPreviewing and "Stop Preview" or "Preview"
		self._motionPreviewPathButton.BackgroundColor3 = isMotionPreviewing and Constants.THEME.Danger or Constants.THEME.PanelSoft
		self._motionPreviewPathButton.TextColor3 = Constants.THEME.Text
	end
	if self._motionCreateAnimationButton then
		self._motionCreateAnimationButton.Text = isMotionPreviewing and "Preview Running" or "Build Timeline"
		self._motionCreateAnimationButton.BackgroundColor3 = isMotionPreviewing and Constants.THEME.PanelSoft or Constants.THEME.Accent
		self._motionCreateAnimationButton.TextColor3 = isMotionPreviewing and Constants.THEME.MutedText or Constants.THEME.Text
	end
	local selectedKeyCount = #(viewModel.selectedKeys or {})
	self._timelineKeySelectionActive = selectedKeyCount &gt; 0
	if selectedKeyCount &gt; 0 then
		if self._timelineKeyboardFocus then
			self:_clearStudioSelectionForTimelineKeys()
		elseif self._shortcutFocus or self._mouseInsideWidget or self:_isShortcutCaptureFocused() then
			self:_enterTimelineKeyboardFocus("Timeline keyframes focused: Delete removes selected keyframes")
		end
	elseif self._timelineKeyboardFocus then
		self:_exitTimelineKeyboardFocus()
	end
	local selectedTrackCount = #(viewModel.selectedTrackPaths or {})
	if self._removeSelectedTrackToolbarButton then
		self._removeSelectedTrackToolbarButton.Text = selectedTrackCount &gt; 0 and "Remove" or "Select"
		self._removeSelectedTrackToolbarButton.BackgroundTransparency = selectedTrackCount &gt; 0 and 0 or 0.35
	end
	local keyOptions = viewModel.selectedKeyOptions or {}
	local selectedEasingStyle = keyOptions.easingStyle or Constants.DEFAULT_EASING_STYLE
	local selectedEasingDirection = keyOptions.easingDirection or Constants.DEFAULT_EASING_DIRECTION
	if self._easingStyleButton then
		self._easingStyleButton.Text = ""
		self._easingStyleButton.TextTransparency = 1
		self._easingStyleButton.TextSize = 1
		local subtext = self._easingStyleButton:FindFirstChild("MegMoActionSubtext")
		if subtext and subtext:IsA("TextLabel") then
			subtext.Text = selectedEasingStyle
			subtext.Visible = true
		end
	end
	if self._easingDirectionButton then
		self._easingDirectionButton.Text = ""
		self._easingDirectionButton.TextTransparency = 1
		self._easingDirectionButton.TextSize = 1
		local subtext = self._easingDirectionButton:FindFirstChild("MegMoActionSubtext")
		if subtext and subtext:IsA("TextLabel") then
			subtext.Text = selectedEasingDirection
			subtext.Visible = true
		end
	end
	if self._keyframeAttachObjectButton and self._keyframeDetachObjectButton then
		self._keyframeAttachObjectButton.Visible = true
		self._keyframeDetachObjectButton.Visible = true
	end
	updateDropdownOptionHighlight(self._easingStyleOptionButtons, selectedEasingStyle)
	updateDropdownOptionHighlight(self._easingDirectionOptionButtons, selectedEasingDirection)
	updateDropdownOptionHighlight(self._priorityOptionButtons, selectedPriority)
	local selectedGroupCount = #(viewModel.selectedGroupIds or {})
	if self._timelineHintLabel then
		self._timelineHintLabel.Text = selectedGroupCount &gt; 0
			and string.format("Selected %d key%s in %d group%s. Drag any grouped key to move together.", selectedKeyCount, selectedKeyCount == 1 and "" or "s", selectedGroupCount, selectedGroupCount == 1 and "" or "s")
			or (selectedTrackCount &gt; 0
				and string.format("Selected %d track%s. Add Keyframe will key only selected tracks.", selectedTrackCount, selectedTrackCount == 1 and "" or "s")
			or (selectedKeyCount &gt; 1
				and ("Selected " .. tostring(selectedKeyCount) .. " keys. Use Group to lock them together.")
				or "Scrub on ruler. Drag empty lane space to range-select."))
	end
	if self._viewportGuideTitle then
		self._viewportGuideTitle.Text = viewModel.selectedJointPath and "Viewport Workflow" or "How To Use The Viewport"
	end
	if self._viewportGuideSteps then
		self._viewportGuideSteps.Text = viewModel.selectedJointPath
			and string.format(
				"Selected track: %s\nActive tool: %s\nUse the viewport gizmo, then Add Keyframe saves the pose at the playhead.",
				viewModel.selectedJointPath,
				viewModel.gizmoMode or "Move"
			)
			or "1. Bind a rig or add a CFrame track.\n2. Choose Move Tool or Rotate Tool.\n3. Manipulate the target in Studio's 3D viewport.\n4. Add Keyframe saves; scrubbing previews the pose."
	end
	if self._previewStatus then
		self._previewStatus.Text = string.format(
			"%s    Target: %s    Playhead: %s%s%s%s    Snap: %s / %s",
			viewModel.isPlaying and "Viewport active" or "Viewport ready",
			viewModel.selectedJointPath or "none",
			frameText .. (unitMode == "Seconds" and "s" or "f"),
			viewModel.selectedKeyframeFrame and ("    Selected Key: " .. tostring(viewModel.selectedKeyframeFrame)) or "",
			selectedKeyCount &gt; 1 and ("    Multi: " .. tostring(selectedKeyCount)) or "",
			"    Gizmo: " .. (viewModel.gizmoMode or "Move"),
			formatNumber(viewModel.moveSnap or Constants.DEFAULT_MOVE_SNAP) .. " st",
			formatNumber(viewModel.rotateSnapDegrees or Constants.DEFAULT_ROTATE_SNAP_DEGREES) .. " deg"
		)
	end
	self:_renderMotionMarkers(viewModel.motionMarkers or {})
	self:_renderMotionDefaults(viewModel)
	self:_renderMotionSegments(viewModel.motionSegments or {})

	local skipRulerDuringInteraction = self._timelineSession
		and self._timelineSession.suppressRulerRefresh
		and math.abs((self._laneContainer and self._laneContainer.CanvasPosition.X or 0) - (self._lastTimelineRulerScrollX or -1000000)) &lt; 160
	if not skipRulerDuringInteraction then
		self:_renderTimelineRuler(viewModel)
	end
	self:_positionPlayhead(viewModel)

	local selectedKeyMap = {}
	local selectedFrameMap = {}
	for _, key in ipairs(viewModel.selectedKeys or {}) do
		selectedKeyMap[makeTrackKeyId(key.jointPath, key.frame)] = true
		selectedFrameMap[key.frame] = true
	end
	local selectedTrackMap = {}
	for _, path in ipairs(viewModel.selectedTrackPaths or {}) do
		selectedTrackMap[path] = true
	end
	local hasSelectedTracks = #(viewModel.selectedTrackPaths or {}) &gt; 0
	local groupedKeyMap = {}
	for _, group in pairs(viewModel.groups or {}) do
		for keyId in pairs(group.keys or {}) do
			groupedKeyMap[keyId] = true
		end
	end
	local groupedTrackClipsByPath = {}
	local groupedRigClipsByName = {}
	local trackDataByPath = {}
	for _, trackData in ipairs(viewModel.tracks or viewModel.joints or {}) do
		if type(trackData.path) == "string" then
			trackDataByPath[trackData.path] = trackData
		end
	end
	for groupId, group in pairs(viewModel.groups or {}) do
		local selectKeys = {}
		local groupKeys = {}
		local clipsByPath = {}
		local clipsByRigName = {}
		for keyId in pairs(group.keys or {}) do
			local jointPath, frame = parseTrackKeyId(keyId)
			if jointPath and frame ~= nil then
				groupKeys[keyId] = true
				table.insert(selectKeys, {
					jointPath = jointPath,
					frame = frame,
				})
				local clip = clipsByPath[jointPath]
				if not clip then
					clip = {
						groupId = groupId,
						jointPath = jointPath,
						mode = group.mode,
						name = group.name,
						kind = group.kind,
						sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
						minFrame = frame,
						maxFrame = frame,
						firstFrame = frame,
						selectKeys = {},
					}
					clipsByPath[jointPath] = clip
				else
					clip.minFrame = math.min(clip.minFrame, frame)
					clip.maxFrame = math.max(clip.maxFrame, frame)
					clip.firstFrame = math.min(clip.firstFrame, frame)
				end
				table.insert(clip.selectKeys, {
					jointPath = jointPath,
					frame = frame,
				})
				for _, trackData in ipairs(viewModel.tracks or viewModel.joints or {}) do
					if trackData.path == jointPath and trackData.rigName then
						local rigClip = clipsByRigName[trackData.rigName]
						if not rigClip then
							rigClip = {
								groupId = groupId,
								rigName = trackData.rigName,
								mode = group.mode,
								name = group.name,
								kind = group.kind,
								sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
								minFrame = frame,
								maxFrame = frame,
								firstFrame = frame,
							}
							clipsByRigName[trackData.rigName] = rigClip
						else
							rigClip.minFrame = math.min(rigClip.minFrame, frame)
							rigClip.maxFrame = math.max(rigClip.maxFrame, frame)
							rigClip.firstFrame = math.min(rigClip.firstFrame, frame)
						end
						break
					end
				end
			end
		end
		table.sort(selectKeys, function(a, b)
			if a.frame == b.frame then
				return tostring(a.jointPath) &lt; tostring(b.jointPath)
			end
			return a.frame &lt; b.frame
		end)
		local physicsFolderPath = type(group.folderPath) == "string" and group.folderPath or nil
		if group.kind == "PhysicsClip" then
			for _, keyRef in ipairs(selectKeys) do
				local keyTrack = trackDataByPath[keyRef.jointPath]
				local parentTrack = keyTrack and keyTrack.parentTrackPath and trackDataByPath[keyTrack.parentTrackPath] or nil
				local currentFolderPath = (parentTrack and parentTrack.folderPath) or (keyTrack and keyTrack.folderPath)
				if type(currentFolderPath) == "string" then
					physicsFolderPath = currentFolderPath
					break
				end
			end
		end
		if group.kind == "PhysicsClip" and type(physicsFolderPath) == "string" and #selectKeys &gt; 0 then
			local folderClip = {
				groupId = groupId,
				jointPath = physicsFolderPath,
				mode = group.mode,
				name = group.name,
				kind = group.kind,
				isAggregate = true,
				sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
				minFrame = selectKeys[1].frame,
				maxFrame = selectKeys[#selectKeys].frame,
				firstFrame = selectKeys[1].frame,
				selectKeys = selectKeys,
				groupKeys = groupKeys,
			}
			groupedTrackClipsByPath[physicsFolderPath] = groupedTrackClipsByPath[physicsFolderPath] or {}
			table.insert(groupedTrackClipsByPath[physicsFolderPath], folderClip)
		end
		for jointPath, clip in pairs(clipsByPath) do
			local keyTrack = trackDataByPath[jointPath]
			local isPhysicsEventTrack = group.kind == "PhysicsClip"
				and keyTrack
				and (keyTrack.targetScope == "ParticleEvent"
					or keyTrack.trackType == "Particle Event"
					or keyTrack.trackType == "ParticleEvent")
			-- Particle events are intentionally instantaneous, but their visual clip
			-- belongs to the complete Physics Clip. Drawing the event's one key as a
			-- zero-length stretch block makes the timing handle snap back even though
			-- the parent clip has already been retimed. Keep the event key at its real
			-- frame while presenting the shared clip range on the Emit lane.
			if isPhysicsEventTrack and #selectKeys &gt; 0 then
				clip.minFrame = selectKeys[1].frame
				clip.maxFrame = selectKeys[#selectKeys].frame
			end
			groupedTrackClipsByPath[jointPath] = groupedTrackClipsByPath[jointPath] or {}
			table.sort(clip.selectKeys, function(a, b)
				return a.frame &lt; b.frame
			end)
			clip.groupKeys = {}
			for _, keyRef in ipairs(clip.selectKeys) do
				clip.groupKeys[makeTrackKeyId(keyRef.jointPath, keyRef.frame)] = true
			end
			table.insert(groupedTrackClipsByPath[jointPath], clip)
		end
		for rigClipName, rigClip in pairs(clipsByRigName) do
			groupedRigClipsByName[rigClipName] = groupedRigClipsByName[rigClipName] or {}
			rigClip.selectKeys = selectKeys
			rigClip.groupKeys = groupKeys
			rigClip.isAggregate = true
			table.insert(groupedRigClipsByName[rigClipName], rigClip)
		end
	end
	self:_ensureTimelineFolderDefaultCollapsed(viewModel.tracks or viewModel.joints or {})
	self:_ensureRigHierarchyDefaultExpanded(viewModel.tracks or viewModel.joints or {})
	local timelineSignature = self:_buildTimelineRenderSignature(viewModel)
	local shouldRebuildTimeline = timelineSignature ~= self._lastTimelineRenderSignature
	if shouldRebuildTimeline then
		self._lastTimelineRenderSignature = timelineSignature
		local timelineRebuildToken = PerformanceDebugService.begin("Timeline Rebuild")
		self:_hideTrackNameTooltip()

		if self._jointsList and self:_isLayoutPanelVisible("RigExplorer") then
			for _, child in ipairs(self._jointsList:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end
		end

		for _, child in ipairs(self._trackColumnList:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for _, child in ipairs(self._laneContainer:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		self._laneOverlays = {}
		self._timelineMarkers = {}
		self._trackWidgets = {}
		self._trackStickyRows = {}
		self._visibleGridLanes = {}
		self._lastGridScrollX = nil
		self._lastGridZoom = nil
		self._lastGridDuration = nil
		self._timelineCurrentFrameLaneLines = {}
		if self._keyframeRenderer then
			self._keyframeRenderer:Begin(self._laneContainer)
		end

		local joints = viewModel.tracks or viewModel.joints or {}
		local renderMetrics = self:_getTimelineMetrics(viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
		local renderScrollX = savedLaneCanvasPosition.X or 0
		self._lastTimelineScrollX = renderScrollX
		self._lastTimelineCullBucket = math.floor(renderScrollX / 160)
		local diamondWindow = nil
		if self._timelineDiamondCache then
			diamondWindow = self._timelineDiamondCache:prepare(viewModel, {
				durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
				pixelsPerFrame = renderMetrics.pixelsPerFrame,
				visibleWidth = renderMetrics.visibleWidth,
				scrollX = renderScrollX,
				paddingX = TIMELINE_PADDING_X,
				renderAllKeyLimit = TIMELINE_RENDER_ALL_KEY_LIMIT,
			})
		end
		local cullPadding = diamondWindow and diamondWindow.cullPadding or math.max(160, renderMetrics.visibleWidth * 0.85)
		local visibleMinX = diamondWindow and diamondWindow.visibleMinX or (renderScrollX - cullPadding)
		local visibleMaxX = diamondWindow and diamondWindow.visibleMaxX or (renderScrollX + renderMetrics.visibleWidth + cullPadding)
		local function isMarkerVisible(x, halfWidth)
			halfWidth = halfWidth or 14
			return (x + halfWidth) &gt;= visibleMinX and (x - halfWidth) &lt;= visibleMaxX
		end
		local function isClipVisible(startX, endX)
			return endX &gt;= visibleMinX and startX &lt;= visibleMaxX
		end
		local rigTrackCounts = {}
		local rigFrameKeys = {}
		for _, trackData in ipairs(joints) do
			if trackData.rigName then
				local rigName = trackData.rigName or "Rig"
				rigTrackCounts[rigName] = (rigTrackCounts[rigName] or 0) + 1
			end
		end
		local rigPropertyTrackState = viewModel.rigPropertyTrackState or {}
		local trackKeyframesByPath = viewModel.trackKeyframesByPath or {}
		for _, trackData in ipairs(joints) do
			if (trackData.trackType or "Rig") == "Rig" and trackData.rigName then
				local rigName = trackData.rigName
				rigFrameKeys[rigName] = rigFrameKeys[rigName] or {}
				for _, keyframe in ipairs(trackKeyframesByPath[trackData.path] or {}) do
					local frameBucket = rigFrameKeys[rigName][keyframe]
					if not frameBucket then
						frameBucket = {}
						rigFrameKeys[rigName][keyframe] = frameBucket
					end
					table.insert(frameBucket, {
						jointPath = trackData.path,
						frame = keyframe,
					})
				end
			end
		end
	local rigTrackBuckets = {}
	local rigTrackOrder = {}
	local orderedTracks = {}
	local orderedChildTracksByParent = {}
	local orderedTrackIndex = 0
	for _, trackData in ipairs(joints) do
			orderedTrackIndex += 1
			if trackData.rigName then
				local rigName = trackData.rigName
				local bucket = rigTrackBuckets[rigName]
				if not bucket then
					bucket = {
						firstIndex = orderedTrackIndex,
						groupTrack = nil,
						propertyTracks = {},
						jointTracks = {},
					}
					rigTrackBuckets[rigName] = bucket
					table.insert(rigTrackOrder, rigName)
				end
				if (trackData.trackType or "Rig") == "Rig Group" then
					bucket.groupTrack = trackData
				elseif (trackData.trackType or "Rig") == "Rig Property" then
					table.insert(bucket.propertyTracks, trackData)
				else
					table.insert(bucket.jointTracks, trackData)
				end
			else
				if trackData.parentTrackPath then
					local childTracks = orderedChildTracksByParent[trackData.parentTrackPath]
					if not childTracks then
						childTracks = {}
						orderedChildTracksByParent[trackData.parentTrackPath] = childTracks
					end
					table.insert(childTracks, trackData)
				else
				table.insert(orderedTracks, trackData)
				end
			end
		end
		local topLevelUnits = {}
		local function getUnitOrder(trackData, fallbackOrder)
			local order = tonumber(trackData and trackData.visualOrder)
			return order or fallbackOrder
		end
		local function appendTopLevelUnit(unit)
			local fallbackOrder = (#topLevelUnits + 1) * 10
			unit.index = #topLevelUnits + 1
			unit.order = getUnitOrder(unit.trackData or (unit.bucket and unit.bucket.groupTrack), fallbackOrder)
			table.insert(topLevelUnits, unit)
		end
		for _, rigName in ipairs(rigTrackOrder) do
			local bucket = rigTrackBuckets[rigName]
			if bucket then
				appendTopLevelUnit({
					bucket = bucket,
					rigName = rigName,
				})
			end
		end
		for _, trackData in ipairs(orderedTracks) do
			appendTopLevelUnit({
				trackData = trackData,
			})
		end
		table.sort(topLevelUnits, function(a, b)
			if a.order ~= b.order then
				return a.order &lt; b.order
			end
			return (a.index or 0) &lt; (b.index or 0)
		end)

		local groupedTracks = {}
		for _, unit in ipairs(topLevelUnits) do
			local bucket = unit.bucket
			if bucket then
				for _, trackData in ipairs(bucket.propertyTracks) do
					table.insert(groupedTracks, trackData)
				end
				if bucket.groupTrack then
					table.insert(groupedTracks, bucket.groupTrack)
				end
				for _, trackData in ipairs(bucket.jointTracks) do
					table.insert(groupedTracks, trackData)
				end
			elseif unit.trackData then
				table.insert(groupedTracks, unit.trackData)
				local childTracks = orderedChildTracksByParent[unit.trackData.path]
				if childTracks then
					table.sort(childTracks, function(a, b)
						if (a.sortOrder or 100) ~= (b.sortOrder or 100) then
							return (a.sortOrder or 100) &lt; (b.sortOrder or 100)
						end
						return tostring(a.name or a.propertyName or a.path) &lt; tostring(b.name or b.propertyName or b.path)
					end)
					for _, childTrack in ipairs(childTracks) do
						table.insert(groupedTracks, childTrack)
					end
				end
			end
		end

		local trackChildByPath = {}
		local primaryCameraTrackPath = nil
		for _, trackData in ipairs(groupedTracks) do
			if trackData.trackType == "Camera" then
				primaryCameraTrackPath = primaryCameraTrackPath or trackData.path
			end
		end
		for _, trackData in ipairs(groupedTracks) do
			if trackData.folderPath then
				trackChildByPath[trackData.folderPath] = true
			end
			if trackData.parentTrackPath then
				trackChildByPath[trackData.parentTrackPath] = true
			end
			if (trackData.targetScope == "CameraProperty" or trackData.trackType == "Camera Property") and primaryCameraTrackPath then
				trackChildByPath[primaryCameraTrackPath] = true
			end
			if trackData.rigName and trackData.trackType ~= "Rig Group" then
				trackChildByPath[makeRigGroupTrackPath(trackData.rigName)] = true
			end
		end

		local rigHierarchyState = RigTrackHierarchyService.buildState(groupedTracks, self._collapsedTracks)
		local compactTimelineRows = self:_shouldUseCompactTimelineRows()
		local visibleTrackIndex = 0
		local lastRenderedRigGroup = nil
		local renderedTimelineRows = 0
		local renderedTimelineContentHeight = 0
		local function registerTimelineRow(rowHeight)
			if renderedTimelineRows &gt; 0 then
				renderedTimelineContentHeight += compactTimelineRows and 5 or 8
			end
			local rowY = renderedTimelineContentHeight
			renderedTimelineRows += 1
			renderedTimelineContentHeight += rowHeight
			return rowY
		end
		self._trackReorderTargets = {}
		for index, motorData in ipairs(groupedTracks) do
			local isSelected = selectedTrackMap[motorData.path] or ((not hasSelectedTracks) and motorData.path == viewModel.selectedJointPath)
			local trackType = motorData.trackType or "Rig"
			if trackType ~= "Folder" and motorData.folderPath and self._collapsedTracks[motorData.folderPath] == true then
				continue
			end
			local isTrackHidden = self._hiddenTracks[motorData.path] == true
			local isTrackDisabled = motorData.disabled == true
			local rigName = motorData.rigName
			local rigCollapsed = false
			local rigSectionCollapsed = false
			if rigName then
				local rigCollapseKey = makeRigGroupCollapseKey(rigName)
				rigCollapsed = self._collapsedTracks[rigCollapseKey] == true
				rigSectionCollapsed = self._collapsedTracks[makeRigGroupTrackPath(rigName)] == true
				if rigName ~= lastRenderedRigGroup then
					lastRenderedRigGroup = rigName
					local groupHeight = 34
					local groupRowY = registerTimelineRow(groupHeight)
					local groupLabel = create("TextButton", {
						Parent = self._trackColumnList,
						AutoButtonColor = true,
						BackgroundColor3 = Constants.THEME.PanelAlt,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(0, groupRowY),
						Size = UDim2.new(1, -2, 0, groupHeight),
						Text = "",
					})
					createCorner(groupLabel, 10)
					createStroke(groupLabel, Constants.THEME.Border)
					self:_attachTimelineTrackWheelScroll(groupLabel)
					table.insert(self._trackStickyRows, {
						gui = groupLabel,
						y = groupRowY,
					})
					table.insert(self._trackReorderTargets, {
						path = makeRigGroupTrackPath(rigName),
						gui = groupLabel,
						scope = getTrackReorderScope({
							rigName = rigName,
							trackType = "Rig Group",
						}),
					})
					self:_connect(groupLabel.MouseEnter, function(x, y)
						local mouseX = tonumber(x)
						local mouseY = tonumber(y)
						self:_showTrackNameTooltip(
							groupLabel,
							rigName,
							string.format("Rig group - %d tracks", rigTrackCounts[rigName] or 0),
							(mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil
						)
					end)
					self:_connect(groupLabel.MouseMoved, function(x, y)
						local mouseX = tonumber(x)
						local mouseY = tonumber(y)
						self:_showTrackNameTooltip(
							groupLabel,
							rigName,
							string.format("Rig group - %d tracks", rigTrackCounts[rigName] or 0),
							(mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil
						)
					end)
					self:_connect(groupLabel.MouseLeave, function()
						self:_hideTrackNameTooltip()
					end)
					local rigMoveUpButton = create("TextButton", {
						Parent = groupLabel,
						Active = true,
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.new(0, 6, 0, 3),
						Selectable = false,
						Size = UDim2.new(0, 18, 0, 12),
						BackgroundColor3 = Constants.THEME.PanelSoft,
						BorderSizePixel = 0,
						Font = Enum.Font.GothamBold,
						Text = "^",
						TextColor3 = Constants.THEME.MutedText,
						TextSize = 10,
						ZIndex = 8,
					})
					createCorner(rigMoveUpButton, 6)
					self:_connect(rigMoveUpButton.Activated, function()
						self:_reorderTrackByStep(makeRigGroupTrackPath(rigName), "Up")
					end)
					local rigMoveDownButton = create("TextButton", {
						Parent = groupLabel,
						Active = true,
						AnchorPoint = Vector2.new(0, 1),
						Position = UDim2.new(0, 6, 1, -3),
						Selectable = false,
						Size = UDim2.new(0, 18, 0, 12),
						BackgroundColor3 = Constants.THEME.PanelSoft,
						BorderSizePixel = 0,
						Font = Enum.Font.GothamBold,
						Text = "v",
						TextColor3 = Constants.THEME.MutedText,
						TextSize = 10,
						ZIndex = 8,
					})
					createCorner(rigMoveDownButton, 6)
					self:_connect(rigMoveDownButton.Activated, function()
						self:_reorderTrackByStep(makeRigGroupTrackPath(rigName), "Down")
					end)
					self:_createTrackTypeIndicator(groupLabel, { trackType = "Rig Group" }, Constants.THEME.MutedText, 44, false)
					create("TextLabel", {
						Parent = groupLabel,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 50, 0, 8),
						Size = UDim2.new(1, -128, 0, 16),
						Font = Enum.Font.GothamSemibold,
						Text = string.format("%s", rigName),
						TextColor3 = Constants.THEME.Text,
						TextSize = 12,
						TextTruncate = Enum.TextTruncate.AtEnd,
						TextXAlignment = Enum.TextXAlignment.Left,
					})
					local rigMenuButton = create("TextButton", {
						Parent = groupLabel,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -36, 0.5, 0),
						Size = UDim2.new(0, 24, 0, 20),
						BackgroundColor3 = Constants.THEME.PanelSoft,
						BorderSizePixel = 0,
						Font = Enum.Font.GothamBold,
						Text = "...",
						TextColor3 = Constants.THEME.Text,
						TextSize = 12,
						ZIndex = 4,
					})
					createCorner(rigMenuButton, 7)
					local rigCollapseButton = create("TextButton", {
						Parent = groupLabel,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -8, 0.5, 0),
						Size = UDim2.new(0, 24, 0, 20),
						BackgroundColor3 = Constants.THEME.PanelSoft,
						BorderSizePixel = 0,
						Font = Enum.Font.GothamBold,
						Text = rigCollapsed and "+" or "-",
						TextColor3 = Constants.THEME.Text,
						TextSize = 14,
						ZIndex = 4,
					})
					createCorner(rigCollapseButton, 7)
					local function toggleRigGroup()
						self._collapsedTracks[rigCollapseKey] = not self._collapsedTracks[rigCollapseKey]
						if self._callbacks and self._callbacks.onRefresh then
							self._callbacks.onRefresh()
						end
					end
					self:_connect(groupLabel.Activated, toggleRigGroup)
					self:_connect(rigCollapseButton.Activated, toggleRigGroup)
					self:_connect(rigMenuButton.Activated, function()
						self:_showTrackActions(makeRigGroupTrackPath(rigName))
					end)

					local groupLane = create("Frame", {
						Parent = self._laneContainer,
						BackgroundColor3 = Constants.THEME.PanelAlt,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(0, groupRowY),
						Size = UDim2.new(0, self._timelinePixelWidth, 0, groupHeight),
					})
					createCorner(groupLane, 10)
					create("TextLabel", {
						Parent = groupLane,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 12, 0, 8),
						Size = UDim2.new(1, -24, 0, 16),
						Font = Enum.Font.Gotham,
						Text = rigCollapsed
							and string.format("%d tracks hidden", rigTrackCounts[rigName] or 0)
							or string.format("%d tracks expanded", rigTrackCounts[rigName] or 0),
						TextColor3 = Constants.THEME.MutedText,
						TextSize = 11,
						TextXAlignment = Enum.TextXAlignment.Left,
					})
					local groupLaneHitbox = create("TextButton", {
						Parent = groupLane,
						AutoButtonColor = false,
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 1, 0),
						Text = "",
						ZIndex = 20,
					})
					self:_connect(groupLaneHitbox.MouseButton1Down, function(x, y)
						if self._keyframeDragSession or self._timelineSession then
							return
						end
						local startPos = Vector2.new(x, y)
						local durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
						local function shouldClearSelectionForTimelineTap(point)
							return point ~= nil
						end
						self:_acquireMainTimelineShortcuts("timeline-group-lane")
						self:_focusShortcutCapture("Shortcut capture: active after timeline click")
						self:_startTimelineSession({
							button = groupLaneHitbox,
							startPos = startPos,
							startImmediately = true,
							suppressRulerRefresh = true,
							onChange = function(currentPos)
								self:_autoScrollTimelineForPoint(currentPos, durationFrames)
								local frame = self:_positionToTimelineFrame(currentPos, durationFrames)
								if self._callbacks.onPreviewScrubToFrame then
									self._callbacks.onPreviewScrubToFrame(frame)
								else
									self._callbacks.onScrubToFrame(frame)
								end
							end,
							onEnd = function(currentPos)
								if self._callbacks.onClearKeySelection
									and (currentPos - startPos).Magnitude &lt; KEYFRAME_DRAG_THRESHOLD
									and shouldClearSelectionForTimelineTap(currentPos) then
									self._callbacks.onClearKeySelection()
								end
								self._callbacks.onScrubToFrame(self:_positionToTimelineFrame(currentPos, durationFrames))
							end,
							onTap = function(currentPos)
								if self._callbacks.onClearKeySelection and shouldClearSelectionForTimelineTap(currentPos) then
									self._callbacks.onClearKeySelection()
								end
								self._callbacks.onScrubToFrame(self:_positionToTimelineFrame(currentPos, durationFrames))
							end,
						})
					end)
				end
			end
			if rigCollapsed then
				continue
			end
			if trackType ~= "Rig Group" and rigSectionCollapsed then
				continue
			end
			local hierarchyMeta = rigHierarchyState.metaByPath[motorData.path]
			local parentHierarchyMeta = motorData.parentTrackPath and rigHierarchyState.metaByPath[motorData.parentTrackPath]
			if trackType == "Rig" and rigHierarchyState.hiddenByPath[motorData.path] then
				continue
			end
			if trackType ~= "Rig" and motorData.parentTrackPath then
				if self._collapsedTracks[motorData.parentTrackPath] == true or rigHierarchyState.hiddenByPath[motorData.parentTrackPath] == true then
					continue
				end
			end
			visibleTrackIndex += 1
			local displayName = trackType == "Folder"
				and (motorData.name or motorData.part1 or motorData.path)
				or (motorData.part1 or motorData.name or motorData.path)
			local hasRigChildren = hierarchyMeta and hierarchyMeta.hasChildren == true
			local hasTrackChildren = hasRigChildren
				or trackChildByPath[motorData.path] == true
				or (trackType == "Rig Group" and (rigTrackCounts[rigName] or 0) &gt; 0)
			local isCollapsed = hasTrackChildren and self._collapsedTracks[motorData.path] == true
			local showTrackDetail = trackType == "Rig Group" or trackType == "Camera Property" or trackType == "Folder"
			local showReorderControls = rigName == nil and motorData.parentTrackPath == nil
			local trackRowHeight = isCollapsed and (compactTimelineRows and 24 or 28)
				or (showTrackDetail and (compactTimelineRows and 36 or 42) or (compactTimelineRows and 28 or 32))
			local nameIndent = 10
			if rigName then
				if trackType == "Rig Group" then
					nameIndent = 26
				else
					local hierarchyDepth = (hierarchyMeta and hierarchyMeta.depth) or 0
					if parentHierarchyMeta then
						hierarchyDepth = (parentHierarchyMeta.depth or 0) + 1
					end
					nameIndent = 30 + (hierarchyDepth * 6)
				end
			elseif trackType == "Folder" then
				nameIndent = 10
			elseif motorData.folderPath then
				nameIndent = 28
			elseif motorData.parentTrackPath then
				nameIndent = 20
			elseif trackType == "Camera Property" then
				nameIndent = 26
			end
			nameIndent += showReorderControls and 34 or 12
			local showTrackToggles = trackType ~= "Rig Group" and trackType ~= "Folder"
			local showTrackMenu = trackType == "Screen Effect"
				or trackType == "Lighting Effect"
				or trackType == "Camera"
				or trackType == "Camera Property"
				or trackType == "Event"
				or motorData.valueType == "Event"
				or trackType == "Rig"
				or trackType == "Object"
				or trackType == "Object Property"
				or trackType == "Emitter Group"
				or trackType == "Emitter Group Property"
				or trackType == "Folder"
				or trackType == "Model"
				or trackType == "Rig CFrame"
				or trackType == "Sound"
			local rightControlOffset = 8
			local collapseOffset = nil
			if hasTrackChildren then
				collapseOffset = rightControlOffset
				rightControlOffset += 27
			end
			local enableOffset = nil
			local hideOffset = nil
			if showTrackToggles then
				enableOffset = rightControlOffset
				rightControlOffset += 27
				hideOffset = rightControlOffset
				rightControlOffset += 27
			end
			local menuOffset = nil
			if showTrackMenu then
				menuOffset = rightControlOffset
				rightControlOffset += 27
			end
			local labelWidthOffset = math.max(20, nameIndent + rightControlOffset + 6)
			local detailWidthOffset = labelWidthOffset
			local detailText = trackType == "Rig"
				and string.format("%s -&gt; %s", motorData.part0 or "Rig", motorData.part1 or motorData.name or "Joint")
					or (trackType == "Rig Group"
						and "Double-click to add keyframes for this rig"
					or (trackType == "Folder"
						and "Timeline folder"
					or (trackType == "Camera Property"
						and string.format("Camera / %s", motorData.propertyName or motorData.valueType or "Property")
					or (trackType == "Rig Property"
						and string.format("Rig / %s", motorData.valueType or motorData.propertyName or "Property")
						or string.format("%s / %s", trackType, motorData.valueType or "Key")))))
			local trackRowY = registerTimelineRow(trackRowHeight)
			local trackNameY = showTrackDetail and (compactTimelineRows and 5 or 6) or (compactTimelineRows and 7 or 9)
			local trackDetailY = compactTimelineRows and 20 or 22
			local trackNameTextSize = compactTimelineRows and 11 or 12
			local trackDetailTextSize = compactTimelineRows and 10 or 11
			local folderAccentColor = getFolderColor(motorData)
			local rowColors = WidgetVisualSupport.getTrackRowColors(motorData, isSelected, isTrackDisabled, folderAccentColor)
			local trackCardColor = rowColors.trackCard
			local laneColor = rowColors.lane
			local baselineColor = rowColors.baseline

		local jointButton = create("TextButton", {
			Name = "Joint_" .. index,
			Parent = self._jointsList,
			AutoButtonColor = true,
			BackgroundColor3 = trackCardColor,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -6, 0, 48),
			Font = Enum.Font.Code,
			Text = string.format("%s\n%s", displayName, detailText),
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
		})
		createCorner(jointButton, 10)
				createStroke(jointButton, isSelected and Constants.THEME.Accent or Constants.THEME.Border)
				self:_connect(jointButton.Activated, function()
					if trackType ~= "Folder" and self:_consumeTrackDoubleClick(motorData.path) and self._callbacks.onCaptureTrackFrame then
						self._suppressNextTrackAutoScroll = true
						self:_rememberTimelineCanvasForNextRefresh()
						self._callbacks.onCaptureTrackFrame(motorData.path)
						self:_acquireMainTimelineShortcuts("track-double-click")
						self:_focusShortcutCapture("Double-click: added keyframe at playhead")
						return
					end

					self._suppressNextTrackAutoScroll = true
					self:_rememberTimelineCanvasForNextRefresh()
					local additive = self:_isAdditiveSelectionActive()
					if trackType == "Rig" and type(self._callbacks.onSelectJoint) == "function" then
						self._callbacks.onSelectJoint(motorData.path, additive)
					elseif type(self._callbacks.onSelectTrack) == "function" then
						self._callbacks.onSelectTrack(motorData.path, additive)
					end
					if additive then
						self:_setShortcutHint("Shift selection: track selection updated")
					else
						self:_acquireMainTimelineShortcuts("joint-selection")
						self:_focusShortcutCapture("Shortcut capture: active after joint selection")
					end
				end)
		create("UIPadding", {
			Parent = jointButton,
			PaddingLeft = UDim.new(0, nameIndent),
			PaddingRight = UDim.new(0, 10),
		})

		local trackLabel = create("TextButton", {
			Parent = self._trackColumnList,
				AutoButtonColor = true,
				BackgroundColor3 = trackCardColor,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, trackRowY),
				Size = UDim2.new(1, -2, 0, trackRowHeight),
				Text = "",
			})
			createCorner(trackLabel, 10)
			createStroke(trackLabel, isSelected and Constants.THEME.Accent or Constants.THEME.Border)
			self:_attachTimelineTrackWheelScroll(trackLabel)
			table.insert(self._trackStickyRows, {
				gui = trackLabel,
				y = trackRowY,
			})
			local trackIndicator = self:_createTrackTypeIndicator(
				trackLabel,
				motorData,
				baselineColor,
				nameIndent,
				isTrackDisabled
			)
				self:_connect(trackLabel.Activated, function()
					if trackType ~= "Folder" and self:_consumeTrackDoubleClick(motorData.path) and self._callbacks.onCaptureTrackFrame then
						self._suppressNextTrackAutoScroll = true
						self:_rememberTimelineCanvasForNextRefresh()
						self._callbacks.onCaptureTrackFrame(motorData.path)
						self:_acquireMainTimelineShortcuts("track-double-click")
						self:_focusShortcutCapture("Double-click: added keyframe at playhead")
						return
					end

					self._suppressNextTrackAutoScroll = true
					self:_rememberTimelineCanvasForNextRefresh()
					local additive = self:_isAdditiveSelectionActive()
					if trackType == "Rig" and type(self._callbacks.onSelectJoint) == "function" then
						self._callbacks.onSelectJoint(motorData.path, additive)
					elseif type(self._callbacks.onSelectTrack) == "function" then
						self._callbacks.onSelectTrack(motorData.path, additive)
					end
					if additive then
						self:_setShortcutHint("Shift selection: track selection updated")
					else
						self:_acquireMainTimelineShortcuts("track-selection")
						self:_focusShortcutCapture("Shortcut capture: active after track selection")
					end
				end)
				self:_connect(trackLabel.MouseEnter, function(x, y)
					local mouseX = tonumber(x)
					local mouseY = tonumber(y)
					self:_showTrackNameTooltip(trackLabel, displayName, detailText, (mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil)
				end)
				self:_connect(trackLabel.MouseMoved, function(x, y)
					local mouseX = tonumber(x)
					local mouseY = tonumber(y)
					self:_showTrackNameTooltip(trackLabel, displayName, detailText, (mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil)
				end)
				self:_connect(trackLabel.MouseLeave, function()
					self:_hideTrackNameTooltip()
				end)

			if showReorderControls then
				local moveUpButton = create("TextButton", {
					Parent = trackLabel,
					Active = true,
					AnchorPoint = Vector2.new(0, 0),
					Position = UDim2.new(0, 6, 0, 2),
					Selectable = false,
					Size = UDim2.new(0, 18, 0, 12),
					BackgroundColor3 = Constants.THEME.PanelSoft,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamBold,
					Text = "^",
					TextColor3 = Constants.THEME.MutedText,
					TextSize = 10,
					ZIndex = 8,
				})
				createCorner(moveUpButton, 6)
				self:_connect(moveUpButton.Activated, function()
					self:_reorderTrackByStep(motorData.path, "Up")
				end)

				local moveDownButton = create("TextButton", {
					Parent = trackLabel,
					Active = true,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 6, 1, -2),
					Selectable = false,
					Size = UDim2.new(0, 18, 0, 12),
					BackgroundColor3 = Constants.THEME.PanelSoft,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamBold,
					Text = "v",
					TextColor3 = Constants.THEME.MutedText,
					TextSize = 10,
					ZIndex = 8,
				})
				createCorner(moveDownButton, 6)
				self:_connect(moveDownButton.Activated, function()
					self:_reorderTrackByStep(motorData.path, "Down")
				end)
			end

		create("TextLabel", {
			Parent = trackLabel,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, nameIndent, 0, trackNameY),
				Size = UDim2.new(1, -labelWidthOffset, 0, 14),
				Font = Enum.Font.GothamSemibold,
					Text = displayName,
			TextColor3 = isTrackDisabled and Constants.THEME.MutedText or Constants.THEME.Text,
			TextSize = trackNameTextSize,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			})

			local detailLabel = create("TextLabel", {
				Parent = trackLabel,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, nameIndent, 0, trackDetailY),
				Size = UDim2.new(1, -detailWidthOffset, 0, 12),
				Font = Enum.Font.Code,
				Text = (trackType == "Rig" and "CFrame")
					or ((trackType == "Camera Property") and "Manual camera property track")
					or ((trackType == "Folder") and (isCollapsed and "Collapsed" or "Expanded"))
				or detailText,
				TextColor3 = Constants.THEME.MutedText,
				TextSize = trackDetailTextSize,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			detailLabel.Visible = showTrackDetail and not isCollapsed

			local collapseButton = create("TextButton", {
				Parent = trackLabel,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -(collapseOffset or 8), 0.5, 0),
				Size = UDim2.new(0, 24, 0, 20),
				BackgroundColor3 = Constants.THEME.PanelAlt,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = isCollapsed and "+" or "-",
				TextColor3 = Constants.THEME.Text,
				TextSize = 14,
				Visible = hasTrackChildren,
				ZIndex = 4,
			})
			createCorner(collapseButton, 7)
			self:_connect(collapseButton.Activated, function()
				if not hasTrackChildren then
					return
				end
				self._collapsedTracks[motorData.path] = not self._collapsedTracks[motorData.path]
				if self._callbacks and self._callbacks.onRefresh then
					self._callbacks.onRefresh()
				end
			end)

			local hideButton = create("TextButton", {
				Parent = trackLabel,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -(hideOffset or 8), 0.5, 0),
				Size = UDim2.new(0, 22, 0, 20),
				BackgroundColor3 = isTrackHidden and Constants.THEME.PanelAlt or Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = isTrackHidden and "H" or "V",
				TextColor3 = isTrackHidden and Constants.THEME.MutedText or Constants.THEME.Text,
				TextSize = 11,
				Visible = showTrackToggles,
				ZIndex = 4,
			})
			createCorner(hideButton, 7)
			self:_connect(hideButton.Activated, function()
				self._hiddenTracks[motorData.path] = not self._hiddenTracks[motorData.path]
				if self._callbacks and self._callbacks.onRefresh then
					self._callbacks.onRefresh()
				end
			end)

			local enableButton = create("TextButton", {
				Parent = trackLabel,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -(enableOffset or 8), 0.5, 0),
				Size = UDim2.new(0, 22, 0, 20),
				BackgroundColor3 = isTrackDisabled and Constants.THEME.Danger or Constants.THEME.Success,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = isTrackDisabled and "D" or "E",
				TextColor3 = Constants.THEME.Text,
				TextSize = 11,
				Visible = showTrackToggles,
				ZIndex = 4,
			})
			createCorner(enableButton, 7)
			self:_connect(enableButton.Activated, function()
				if self._callbacks and self._callbacks.onToggleTrackEnabled then
					self._callbacks.onToggleTrackEnabled(motorData.path, not isTrackDisabled)
				end
			end)

			local effectMenuButton = create("TextButton", {
				Parent = trackLabel,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -(menuOffset or 8), 0.5, 0),
				Size = UDim2.new(0, 22, 0, 20),
				BackgroundColor3 = Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = "...",
				TextColor3 = Constants.THEME.Text,
				TextSize = 11,
				Visible = showTrackMenu,
				ZIndex = 4,
			})
			createCorner(effectMenuButton, 7)
			self:_connect(effectMenuButton.Activated, function()
				self:_showTrackActions(motorData.path)
			end)
			self._trackWidgets[motorData.path] = {
				trackLabel = trackLabel,
				trackData = motorData,
				isTrackDisabled = isTrackDisabled,
				folderAccentColor = folderAccentColor,
				trackColorDot = trackIndicator.dot,
				trackTypeIcon = trackIndicator.icon,
			}
			if trackType ~= "Rig Group" and showReorderControls then
				table.insert(self._trackReorderTargets, {
					path = motorData.path,
					gui = trackLabel,
					scope = getTrackReorderScope(motorData),
				})
			end

		local lane = create("Frame", {
				Parent = self._laneContainer,
				BackgroundColor3 = laneColor,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, trackRowY),
				Size = UDim2.new(0, self._timelinePixelWidth, 0, trackRowHeight),
			})
		createCorner(lane, 10)
		self._trackWidgets[motorData.path].lane = lane

		self:_addTimelineLaneGrid(lane, viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES, trackRowHeight)

		local laneHitbox = nil

		local baseline = create("Frame", {
			Parent = lane,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(TIMELINE_PADDING_X, math.floor(trackRowHeight / 2)),
			Size = UDim2.new(0, math.max(1, self._timelinePixelWidth - (TIMELINE_PADDING_X * 2)), 0, 1),
			BackgroundColor3 = baselineColor,
			BorderSizePixel = 0,
		})
		self._trackWidgets[motorData.path].baseline = baseline
		baseline.BackgroundTransparency = isTrackHidden and 0.75 or 0.16

		if isTrackHidden then
			create("TextLabel", {
				Parent = lane,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(TIMELINE_PADDING_X, 6),
				Size = UDim2.new(0, 160, 0, 18),
				Font = Enum.Font.Gotham,
				Text = "Hidden",
				TextColor3 = Constants.THEME.MutedText,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 3,
			})
		end

		local trackKeyframesByPath = viewModel.trackKeyframesByPath or {}
		local trackSoundClipsByPath = viewModel.trackSoundClipsByPath or {}
		local trackKeyOptionsByPath = viewModel.trackKeyOptionsByPath or {}
		local keyOptionsByFrame = trackKeyOptionsByPath[motorData.path] or {}
		if trackType == "Rig Group" and rigName and rigFrameKeys[rigName] then
			for _, clip in ipairs(isTrackHidden and {} or (groupedRigClipsByName[rigName] or {})) do
				local startX = self:_frameToTimelineX(clip.minFrame, viewModel.durationFrames)
				local endX = self:_frameToTimelineX(clip.maxFrame, viewModel.durationFrames)
				if not isClipVisible(startX, endX) then
					continue
				end
				local clipWidth = KeyframeGroupBlockVisualSupport.getWidth(clip, startX, endX)
				local clipCenterX = startX + ((endX - startX) / 2)
				local isClipSelected = true
				for _, keyRef in ipairs(clip.selectKeys or {}) do
					if not selectedKeyMap[makeTrackKeyId(keyRef.jointPath, keyRef.frame)] then
						isClipSelected = false
						break
					end
				end
				if false and isClipSelected then
					local selectionHalo = create("Frame", {
						Parent = lane,
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
						Size = UDim2.new(0, clipWidth + 8, 0, 24),
						BackgroundColor3 = Constants.THEME.Accent,
						BorderSizePixel = 0,
						ZIndex = 2,
					})
					selectionHalo.BackgroundTransparency = 0.45
					createCorner(selectionHalo, 6)
					create("UIStroke", {
						Parent = selectionHalo,
						Color = Constants.THEME.Text,
						Thickness = 1.5,
						Transparency = 0.1,
					})
				end
				local clipMode = clip.mode
				local clipColor = KeyframeGroupBlockVisualSupport.getColor(clipMode, nil, baselineColor)
				local marker = create("TextButton", {
					Parent = lane,
					AutoButtonColor = true,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, clipWidth, 0, math.max(16, trackRowHeight - 10)),
					BackgroundColor3 = clipColor,
					BorderSizePixel = 0,
					Text = KeyframeGroupBlockVisualSupport.getLabel(clip, clipWidth),
					TextColor3 = KeyframeGroupBlockVisualSupport.getTextColor(clipMode, clipColor),
					TextSize = 10,
					Font = Enum.Font.GothamBold,
					ZIndex = 3,
				})
				marker.BackgroundTransparency = 0.02
				createCorner(marker, 6)
				create("UIStroke", {
					Parent = marker,
					Color = clipColor:Lerp(Color3.new(0, 0, 0), 0.45),
					Thickness = 1.5,
					Transparency = 0.08,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				})
				local markerHitbox = create("TextButton", {
					Parent = lane,
					Active = true,
					AutoButtonColor = false,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Constants.THEME.Accent,
					BackgroundTransparency = 0.99,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, clipWidth + 10, 0, 24),
					Text = "",
					TextTransparency = 1,
					ZIndex = 4,
				})
				KeyframeGroupBlockVisualSupport.attachTimingHandle({
					makeInstance = create,
					parent = marker,
					mode = clipMode,
					groupId = clip.groupId,
					startFrame = clip.minFrame,
					endFrame = clip.maxFrame,
					sourceSpanFrames = clip.sourceSpanFrames,
					clipWidth = clipWidth,
					clipHeight = math.max(16, trackRowHeight - 10),
					visibleStartFrame = 0,
					visibleFrameRange = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					timelinePixelWidth = math.max(1, (viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES) * renderMetrics.pixelsPerFrame),
					durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					onStretchGroupToFrame = self._callbacks and self._callbacks.onStretchGroupToFrame,
					onRepeatGroupToFrame = self._callbacks and self._callbacks.onRepeatGroupToFrame,
					frameFromScreenX = function(screenX)
						return self:_positionToTimelineFrame(Vector2.new(screenX, 0), viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
					end,
					onPreviewTimingFrame = function(targetFrame, nextWidth)
						local nextCenterX = startX + (nextWidth * 0.5)
						local nextWidthInt = math.max(20, nextWidth)
						marker.Position = UDim2.fromOffset(nextCenterX, math.floor(trackRowHeight / 2))
						marker.Size = UDim2.new(0, nextWidthInt, 0, math.max(16, trackRowHeight - 10))
						markerHitbox.Position = UDim2.fromOffset(nextCenterX, math.floor(trackRowHeight / 2))
						markerHitbox.Size = UDim2.new(0, nextWidthInt + 10, 0, 24)
						self:_setKeyframeDragRulerHighlightFrame(targetFrame)
						marker.Text = KeyframeGroupBlockVisualSupport.getLabel({
							groupId = clip.groupId,
							mode = clipMode,
							name = clip.name,
							kind = clip.kind,
							isAggregate = clip.isAggregate,
							minFrame = clip.minFrame,
							maxFrame = targetFrame,
							sourceSpanFrames = clip.sourceSpanFrames,
						}, nextWidthInt)
					end,
					refresh = function()
						if self._callbacks and self._callbacks.onRefresh then
							self._callbacks.onRefresh()
						end
					end,
					zIndex = 6,
				})
				local markerData = {
					frame = clip.firstFrame,
					jointPath = motorData.path,
					keyId = makeTrackKeyId(motorData.path, clip.firstFrame),
					button = marker,
					hitbox = markerHitbox,
					lane = lane,
					laneHitbox = laneHitbox,
					x = clipCenterX,
					hitSize = 18,
					hitWidth = clipWidth + 10,
					hitHeight = 24,
					basePosition = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					baseTransparency = 0.04,
					selected = isClipSelected,
					durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					groupId = clip.groupId,
					groupKeys = clip.groupKeys,
					selectKeys = clip.selectKeys,
					preservePlayhead = true,
					dragMinFrame = clip.minFrame,
					dragMaxFrame = clip.maxFrame,
				}
				self._timelineMarkers[#self._timelineMarkers + 1] = markerData
				self:_connectKeyframeRightClick(markerData)
				self:_connect(markerHitbox.MouseButton1Down, function(x, y)
					if marker:GetAttribute("MegMoGroupTimingSuppressClick") then
						return
					end
					local startPos = Vector2.new(x, y)
					if self:_beginKeyframeDrag(markerData, startPos) then
						return
					end
				end)
			end

			local rigFrameList = {}
			for frame in pairs(rigFrameKeys[rigName]) do
				table.insert(rigFrameList, frame)
			end
			table.sort(rigFrameList)
			for _, keyframe in ipairs(rigFrameList) do
				local markerX = self:_frameToTimelineX(keyframe, viewModel.durationFrames)
				local keyRefs = rigFrameKeys[rigName][keyframe]
				local groupKeys = {}
				local isSelectedKey = #keyRefs &gt; 0
				local allKeysGrouped = #keyRefs &gt; 0
				local firstJointPath = keyRefs[1] and keyRefs[1].jointPath or motorData.path
				for _, keyRef in ipairs(keyRefs) do
					local actualKeyId = makeTrackKeyId(keyRef.jointPath, keyRef.frame)
					groupKeys[actualKeyId] = true
					if not selectedKeyMap[actualKeyId] then
						isSelectedKey = false
					end
					if not groupedKeyMap[actualKeyId] then
						allKeysGrouped = false
					end
				end
				if allKeysGrouped then
					continue
				end
				if not isMarkerVisible(markerX, 18) then
					continue
				end
				local markerSize = 10
				if false and isSelectedKey then
					local selectionHalo = create("Frame", {
						Parent = lane,
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromOffset(markerX, math.floor(trackRowHeight / 2)),
						Size = UDim2.new(0, 28, 0, 28),
						BackgroundColor3 = Constants.THEME.Accent,
						BorderSizePixel = 0,
						Rotation = 0,
						ZIndex = 2,
					})
					selectionHalo.BackgroundTransparency = 0.45
					createCorner(selectionHalo, 6)
					create("UIStroke", {
						Parent = selectionHalo,
						Color = Constants.THEME.Text,
						Thickness = 1.5,
						Transparency = 0.1,
					})
				end
				local marker = create("TextButton", {
					Parent = lane,
					AutoButtonColor = true,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(markerX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, markerSize, 0, markerSize),
					BackgroundColor3 = Color3.fromRGB(255, 191, 64),
					BorderSizePixel = 0,
					Rotation = 45,
					Text = "",
					ZIndex = 3,
				})
				marker.BackgroundTransparency = 0.05
				createCorner(marker, 5)
				create("UIStroke", {
					Parent = marker,
					Color = Color3.fromRGB(36, 22, 8),
					Thickness = 1.25,
					Transparency = 0.12,
				})
				local markerHitbox = create("TextButton", {
					Parent = lane,
					Active = true,
					AutoButtonColor = false,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Constants.THEME.Accent,
					BackgroundTransparency = 0.99,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(markerX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, 28, 0, 24),
					Text = "",
					TextTransparency = 1,
					ZIndex = 4,
				})
				local markerKeyId = makeTrackKeyId(motorData.path, keyframe)
				local markerData = {
					frame = keyframe,
					jointPath = firstJointPath,
					keyId = markerKeyId,
					button = marker,
					hitbox = markerHitbox,
					lane = lane,
					laneHitbox = laneHitbox,
					x = markerX,
					hitSize = 14,
					basePosition = UDim2.fromOffset(markerX, math.floor(trackRowHeight / 2)),
					baseTransparency = 0.05,
					selected = isSelectedKey,
					durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					groupKeys = groupKeys,
					selectKeys = keyRefs,
				}
				self._timelineMarkers[#self._timelineMarkers + 1] = markerData
				self:_connectKeyframeRightClick(markerData)
				self:_connect(markerHitbox.MouseButton1Down, function(x, y)
					local startPos = Vector2.new(x, y)
					if self:_beginKeyframeDrag(markerData, startPos) then
						return
					end
				end)
			end
		end
		for _, clip in ipairs(isTrackHidden and {} or (groupedTrackClipsByPath[motorData.path] or {})) do
			local startX = self:_frameToTimelineX(clip.minFrame, viewModel.durationFrames)
			local endX = self:_frameToTimelineX(clip.maxFrame, viewModel.durationFrames)
			if not isClipVisible(startX, endX) then
				continue
			end
			local clipWidth = KeyframeGroupBlockVisualSupport.getWidth(clip, startX, endX)
			local clipCenterX = startX + ((endX - startX) / 2)
			local isClipSelected = true
			for _, keyRef in ipairs(clip.selectKeys or {}) do
				if not selectedKeyMap[makeTrackKeyId(keyRef.jointPath, keyRef.frame)] then
					isClipSelected = false
					break
				end
			end
			if false and isClipSelected then
				local selectionHalo = create("Frame", {
					Parent = lane,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, clipWidth + 8, 0, 24),
					BackgroundColor3 = Constants.THEME.Accent,
					BorderSizePixel = 0,
					ZIndex = 2,
				})
				selectionHalo.BackgroundTransparency = 0.45
				createCorner(selectionHalo, 6)
				create("UIStroke", {
					Parent = selectionHalo,
					Color = Constants.THEME.Text,
					Thickness = 1.5,
					Transparency = 0.1,
				})
			end
			local clipMode = clip.mode
			local clipColor = KeyframeGroupBlockVisualSupport.getColor(clipMode, nil, baselineColor)
			local marker = create("TextButton", {
				Parent = lane,
				AutoButtonColor = true,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
				Size = UDim2.new(0, clipWidth, 0, math.max(16, trackRowHeight - 10)),
				BackgroundColor3 = clipColor,
				BorderSizePixel = 0,
				Text = KeyframeGroupBlockVisualSupport.getLabel(clip, clipWidth),
				TextColor3 = KeyframeGroupBlockVisualSupport.getTextColor(clipMode, clipColor),
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				ZIndex = 3,
			})
			marker.BackgroundTransparency = 0.02
			createCorner(marker, 6)
			create("UIStroke", {
				Parent = marker,
				Color = clipColor:Lerp(Color3.new(0, 0, 0), 0.45),
				Thickness = 1.5,
				Transparency = 0.08,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			})
			local markerHitbox = create("TextButton", {
				Parent = lane,
				Active = true,
				AutoButtonColor = false,
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Constants.THEME.Accent,
				BackgroundTransparency = 0.99,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
				Size = UDim2.new(0, clipWidth + 10, 0, 24),
				Text = "",
				TextTransparency = 1,
				ZIndex = 4,
			})
			KeyframeGroupBlockVisualSupport.attachTimingHandle({
				makeInstance = create,
				parent = marker,
				mode = clipMode,
				groupId = clip.groupId,
				startFrame = clip.minFrame,
				endFrame = clip.maxFrame,
				sourceSpanFrames = clip.sourceSpanFrames,
				clipWidth = clipWidth,
				clipHeight = math.max(16, trackRowHeight - 10),
				visibleStartFrame = 0,
				visibleFrameRange = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
				timelinePixelWidth = math.max(1, (viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES) * renderMetrics.pixelsPerFrame),
				durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
				onStretchGroupToFrame = self._callbacks and self._callbacks.onStretchGroupToFrame,
				onRepeatGroupToFrame = self._callbacks and self._callbacks.onRepeatGroupToFrame,
				frameFromScreenX = function(screenX)
					return self:_positionToTimelineFrame(Vector2.new(screenX, 0), viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
				end,
				onPreviewTimingFrame = function(targetFrame, nextWidth)
					local nextCenterX = startX + (nextWidth * 0.5)
					local nextWidthInt = math.max(20, nextWidth)
					marker.Position = UDim2.fromOffset(nextCenterX, math.floor(trackRowHeight / 2))
					marker.Size = UDim2.new(0, nextWidthInt, 0, math.max(16, trackRowHeight - 10))
					markerHitbox.Position = UDim2.fromOffset(nextCenterX, math.floor(trackRowHeight / 2))
					markerHitbox.Size = UDim2.new(0, nextWidthInt + 10, 0, 24)
					self:_setKeyframeDragRulerHighlightFrame(targetFrame)
					marker.Text = KeyframeGroupBlockVisualSupport.getLabel({
						groupId = clip.groupId,
						mode = clipMode,
						name = clip.name,
						kind = clip.kind,
						isAggregate = clip.isAggregate,
						minFrame = clip.minFrame,
						maxFrame = targetFrame,
						sourceSpanFrames = clip.sourceSpanFrames,
					}, nextWidthInt)
				end,
				refresh = function()
					if self._callbacks and self._callbacks.onRefresh then
						self._callbacks.onRefresh()
					end
				end,
				zIndex = 6,
			})
			local markerData = {
				frame = clip.firstFrame,
				jointPath = motorData.path,
				keyId = makeTrackKeyId(motorData.path, clip.firstFrame),
				button = marker,
				hitbox = markerHitbox,
				lane = lane,
				laneHitbox = laneHitbox,
				x = clipCenterX,
				hitSize = 18,
				hitWidth = clipWidth + 10,
				hitHeight = 24,
				basePosition = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
				baseTransparency = 0.04,
				selected = isClipSelected,
				durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
				groupId = clip.groupId,
				groupKeys = clip.groupKeys,
				selectKeys = clip.selectKeys,
				preservePlayhead = true,
				dragMinFrame = clip.minFrame,
				dragMaxFrame = clip.maxFrame,
			}
			self._timelineMarkers[#self._timelineMarkers + 1] = markerData
			self:_connectKeyframeRightClick(markerData)
			self:_connect(markerHitbox.MouseButton1Down, function(x, y)
				if marker:GetAttribute("MegMoGroupTimingSuppressClick") then
					return
				end
				local startPos = Vector2.new(x, y)
				if self:_beginKeyframeDrag(markerData, startPos) then
					return
				end
			end)
		end
		local isSoundTrack = trackType == "Sound" or motorData.targetScope == "Sound" or motorData.valueType == "Sound"
		if isSoundTrack and not isTrackHidden then
			for _, clip in ipairs(trackSoundClipsByPath[motorData.path] or {}) do
				local startFrame = tonumber(clip.frame) or 0
				local endFrame = math.max(startFrame + 1, tonumber(clip.endFrame) or (startFrame + 1))
				local startX = self:_frameToTimelineX(startFrame, viewModel.durationFrames)
				local endX = self:_frameToTimelineX(endFrame, viewModel.durationFrames)
				if not isClipVisible(startX, endX) then
					continue
				end
				local clipWidth = math.max(30, endX - startX)
				local clipCenterX = startX + (clipWidth / 2)
				local keyId = makeTrackKeyId(motorData.path, startFrame)
				local isSelectedKey = selectedKeyMap[keyId] == true
				local clipHeight = math.max(20, trackRowHeight - 8)
				local clipColor = isSelectedKey and Constants.THEME.Accent or Color3.fromRGB(69, 174, 214)
				local soundClipLabel = tostring(motorData.name or motorData.part1 or "Sound")
				if soundClipLabel == "" then
					soundClipLabel = "Sound"
				end
				if isSelectedKey then
					local selectionHalo = create("Frame", {
						Parent = lane,
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
						Size = UDim2.new(0, clipWidth + 8, 0, clipHeight + 8),
						BackgroundColor3 = Constants.THEME.Accent,
						BorderSizePixel = 0,
						ZIndex = 2,
					})
					selectionHalo.BackgroundTransparency = 0.58
					createCorner(selectionHalo, 7)
				end
				local marker = create("TextButton", {
					Parent = lane,
					Active = true,
					AutoButtonColor = true,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = clipColor,
					BorderSizePixel = 0,
					ClipsDescendants = true,
					Font = Enum.Font.GothamBold,
					Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, clipWidth, 0, clipHeight),
					Text = "",
					TextColor3 = Color3.fromRGB(5, 18, 26),
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextSize = 12,
					ZIndex = 3,
				})
				marker.BackgroundTransparency = isSelectedKey and 0.02 or 0.12
				createCorner(marker, 7)
				require(script.Parent:WaitForChild("AudioClipVisualSupport")).drawFadeIndicators(create, marker, clip, clipWidth, clipHeight, clip.durationFrames or (endFrame - startFrame), viewModel.fps or Constants.DEFAULT_FPS, 5)
				local barCount = math.clamp(math.floor(clipWidth / 12), 3, 18)
				for barIndex = 1, barCount do
					local barAlpha = barIndex / math.max(1, barCount)
					local barHeight = math.floor(5 + ((math.sin(barIndex * 1.73) + 1) * 0.5 * math.max(4, clipHeight - 10)))
					create("Frame", {
						Parent = marker,
						AnchorPoint = Vector2.new(0.5, 0.5),
						BackgroundColor3 = Color3.fromRGB(219, 247, 255),
						BackgroundTransparency = 0.28,
						BorderSizePixel = 0,
						Position = UDim2.new(barAlpha, -3, 0.5, 0),
						Size = UDim2.new(0, 2, 0, math.min(clipHeight - 5, barHeight)),
						ZIndex = 4,
					})
				end
				create("TextLabel", {
					Parent = marker,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamBold,
					Position = UDim2.fromOffset(4, 0),
					Size = UDim2.new(1, -8, 1, 0),
					Text = clipWidth &gt; 48 and soundClipLabel or "",
					TextColor3 = Color3.fromRGB(5, 18, 26),
					TextSize = 12,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Center,
					ZIndex = 6,
				})
				local markerHitbox = create("TextButton", {
					Parent = lane,
					Active = true,
					AutoButtonColor = false,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Constants.THEME.Accent,
					BackgroundTransparency = 0.99,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					Size = UDim2.new(0, clipWidth + 12, 0, clipHeight + 8),
					Text = "",
					TextTransparency = 1,
					ZIndex = 5,
				})
				require(script.Parent:WaitForChild("AudioClipVisualSupport")).attachStopHandle({
					makeInstance = create,
					parent = marker,
					trackPath = motorData.path,
					startFrame = startFrame,
					endFrame = endFrame,
					clipWidth = clipWidth,
					clipHeight = clipHeight,
					visibleStartFrame = 0,
					visibleFrameRange = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					timelinePixelWidth = math.max(1, (viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES) * renderMetrics.pixelsPerFrame),
					durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					onSetStopFrame = self._callbacks and self._callbacks.onSetSoundClipEndFrame,
					frameFromScreenX = function(screenX)
						return self:_positionToTimelineFrame(Vector2.new(screenX, 0), viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
					end,
					onPreviewStopFrame = function(_targetFrame, nextWidth)
						local nextCenterX = startX + (nextWidth * 0.5)
						marker.Position = UDim2.fromOffset(nextCenterX, math.floor(trackRowHeight / 2))
						marker.Size = UDim2.new(0, nextWidth, 0, clipHeight)
						markerHitbox.Position = UDim2.fromOffset(nextCenterX, math.floor(trackRowHeight / 2))
						markerHitbox.Size = UDim2.new(0, nextWidth + 12, 0, clipHeight + 8)
					end,
					refresh = function()
						if self._callbacks and self._callbacks.onRefresh then
							self._callbacks.onRefresh()
						end
					end,
					zIndex = 6,
				})
				self:_connect(markerHitbox.MouseEnter, function(x, y)
					local mouseX = tonumber(x)
					local mouseY = tonumber(y)
					self:_showTrackNameTooltip(markerHitbox, require(script.Parent:WaitForChild("AudioClipVisualSupport")).buildTooltip(soundClipLabel, clip), "Sound clip", (mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil)
				end)
				self:_connect(markerHitbox.MouseMoved, function(x, y)
					local mouseX = tonumber(x)
					local mouseY = tonumber(y)
					self:_showTrackNameTooltip(markerHitbox, require(script.Parent:WaitForChild("AudioClipVisualSupport")).buildTooltip(soundClipLabel, clip), "Sound clip", (mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil)
				end)
				self:_connect(markerHitbox.MouseLeave, function()
					self:_hideTrackNameTooltip()
				end)
				local markerData = {
					frame = startFrame,
					jointPath = motorData.path,
					keyId = keyId,
					button = marker,
					hitbox = markerHitbox,
					lane = lane,
					laneHitbox = laneHitbox,
					x = clipCenterX,
					hitSize = 18,
					hitWidth = clipWidth + 12,
					hitHeight = clipHeight + 8,
					basePosition = UDim2.fromOffset(clipCenterX, math.floor(trackRowHeight / 2)),
					baseTransparency = marker.BackgroundTransparency,
					selected = isSelectedKey,
					durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
				}
				self._timelineMarkers[#self._timelineMarkers + 1] = markerData
				self:_connectKeyframeRightClick(markerData)
				self:_connect(markerHitbox.MouseButton1Down, function(x, y)
					local startPos = Vector2.new(x, y)
					if self:_beginKeyframeDrag(markerData, startPos) then
						return
					end
				end)
			end
		end
		local keyframeEntries = nil
		if not isTrackHidden and not isSoundTrack and self._timelineDiamondCache then
			keyframeEntries = self._timelineDiamondCache:getTrackEntries(motorData.path, visibleMinX, visibleMaxX)
		end
		if not keyframeEntries then
			keyframeEntries = {}
			for _, keyframe in ipairs((isTrackHidden or isSoundTrack) and {} or (trackKeyframesByPath[motorData.path] or {})) do
				local markerX = self:_frameToTimelineX(keyframe, viewModel.durationFrames)
				if isMarkerVisible(markerX, 18) then
					keyframeEntries[#keyframeEntries + 1] = {
						frame = keyframe,
						x = markerX,
					}
				end
			end
		end
		for _, keyframeEntry in ipairs(keyframeEntries) do
			local keyframe = keyframeEntry.frame
			local markerX = keyframeEntry.x or self:_frameToTimelineX(keyframe, viewModel.durationFrames)
			local isCurrentMarker = keyframe == viewModel.currentFrame
				local keyId = makeTrackKeyId(motorData.path, keyframe)
				local isSelectedKey = selectedKeyMap[keyId]
				local isGroupedKey = groupedKeyMap[keyId]
				if isGroupedKey then
					continue
				end
				local keyOptions = keyOptionsByFrame[keyframe] or {}
				local easingStyle = keyOptions.easingStyle or Constants.DEFAULT_EASING_STYLE
				local easingDirection = keyOptions.easingDirection or Constants.DEFAULT_EASING_DIRECTION
				local markerColor = getTrackKeyframeColor(motorData, easingStyle)
				local markerData = self:_createTimelineKeyframeMarker({
					durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
					easingDirection = easingDirection,
					easingStyle = easingStyle,
					isCurrentMarker = isCurrentMarker,
					isGroupedKey = isGroupedKey,
					isSelectedKey = isSelectedKey,
					keyId = keyId,
					keyframe = keyframe,
					lane = lane,
					laneHitbox = laneHitbox,
					markerColor = markerColor,
					markerX = markerX,
					trackPath = motorData.path,
					trackRowHeight = trackRowHeight,
					trackRowY = trackRowY,
				})
				self._timelineMarkers[#self._timelineMarkers + 1] = markerData
		end

		if visibleTrackIndex == 1 then
			local currentFrameLine = create("Frame", {
				Parent = lane,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromOffset(self:_frameToTimelineX(viewModel.currentFrame or 0, viewModel.durationFrames), 0),
				Size = UDim2.new(0, 2, 1, 0),
				BackgroundColor3 = Constants.THEME.Accent,
				BorderSizePixel = 0,
			})
			currentFrameLine.BackgroundTransparency = 0.15
			table.insert(self._timelineCurrentFrameLaneLines, currentFrameLine)
		end
		end

		if self._keyframeRenderer then
			self._keyframeRenderer:End()
		end

		local timelineCanvasHeight = math.max(0, renderedTimelineContentHeight + 20)
		if self._trackColumnList then
			self._trackColumnList.CanvasSize = UDim2.new(0, 0, 0, timelineCanvasHeight)
			self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
		end
		if self._laneContainer then
			self._laneContainer.CanvasSize = UDim2.new(0, self._timelinePixelWidth, 0, timelineCanvasHeight)
		end
		self:_positionStickyTrackRows(savedTrackCanvasPosition.Y)

		self._suppressNextTrackAutoScroll = false
		self._lastAutoScrolledJointPath = viewModel.selectedJointPath

		if self._jointsList and self:_isLayoutPanelVisible("RigExplorer") then
			self._jointsList.CanvasPosition = savedJointCanvasPosition
		end
		self:_restoreTimelineCanvasPosition(savedLaneCanvasPosition, savedTrackCanvasPosition.Y)
		if not self._suppressTimelineUpdateDefers then
			task.defer(function()
				self:_restoreTimelineCanvasPosition(savedLaneCanvasPosition, savedTrackCanvasPosition.Y)
				if self._lastViewModel == viewModel then
					self:_refreshTimelineForLayout()
				end
				if shouldRestoreTimelineCanvas then
					task.delay(0.03, function()
						self:_restoreTimelineCanvasPosition(savedLaneCanvasPosition, savedTrackCanvasPosition.Y)
					end)
					task.delay(0.12, function()
						self:_restoreTimelineCanvasPosition(savedLaneCanvasPosition, savedTrackCanvasPosition.Y)
					end)
				end
			end)
			if not self._pendingTimelineLayoutRefresh then
				self._pendingTimelineLayoutRefresh = true
				task.delay(0.15, function()
					self._pendingTimelineLayoutRefresh = false
					if not self._lastViewModel then
						return
					end
					self:_refreshTimelineForLayout()
					self:_refreshTimelineLaneGrids(self._lastViewModel, true)
					self:_scheduleTimelineHorizontalRefresh()
				end)
			end
		end
		PerformanceDebugService.finish(timelineRebuildToken, string.format("%d tracks", #groupedTracks))
	else
		self:_positionPlayhead(viewModel)
	end
	self:_refreshTrackSelectionVisuals(viewModel)
	self:_refreshTimelineSelectionVisuals(selectedKeyMap)
	PerformanceDebugService.finish(
		perfToken,
		string.format(
			"%d tracks, %d keys%s",
			viewModel.tracks and #viewModel.tracks or 0,
			viewModel.keyframeCount or 0,
			shouldRebuildTimeline and "" or " (cached timeline)"
		)
	)
end

return WidgetController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX268">
        <Properties>
          <string name="Name">WidgetControllerUtilitySupport</string>
          <ProtectedString name="Source">local WidgetControllerUtilitySupport = {}

function WidgetControllerUtilitySupport.applySectionRefs(target, refs)
	if type(refs) ~= "table" then
		return
	end

	for key, value in pairs(refs) do
		target[key] = value
	end
end

function WidgetControllerUtilitySupport.compactDisplayText(text, maxLength)
	text = tostring(text or "")
	maxLength = tonumber(maxLength) or 100
	if #text &lt;= maxLength then
		return text
	end
	return string.sub(text, 1, math.max(1, maxLength - 3)) .. "..."
end

function WidgetControllerUtilitySupport.makeRigGroupCollapseKey(collapseKeyPrefix, rigName)
	return string.format("%s:%s", collapseKeyPrefix, tostring(rigName or "Rig"))
end

function WidgetControllerUtilitySupport.makeRigGroupTrackPath(rigName)
	return string.format("riggroup:%s", tostring(rigName or "Rig"))
end

function WidgetControllerUtilitySupport.isAttachEndpointName(name)
	local normalized = string.gsub(string.lower(tostring(name or "")), "%s+", "")
	return string.find(normalized, "hand", 1, true) ~= nil
		or string.find(normalized, "foot", 1, true) ~= nil
		or normalized == "rightarm"
		or normalized == "leftarm"
		or normalized == "rightleg"
		or normalized == "leftleg"
end

function WidgetControllerUtilitySupport.appendSignatureValue(parts, value)
	parts[#parts + 1] = tostring(value)
end

function WidgetControllerUtilitySupport.getFolderColor(folderColorById, folderTrack)
	local colorId = tostring((folderTrack and folderTrack.folderColorId) or "Yellow")
	return folderColorById[colorId] or folderColorById.Yellow or Color3.fromRGB(255, 225, 90)
end

function WidgetControllerUtilitySupport.getTrackReorderScope(track)
	if not track then
		return nil
	end
	if track.trackType == "Rig" and track.rigName then
		return "rig-joints:" .. tostring(track.rigName)
	end
	if track.trackType == "Rig Property" and track.rigName then
		return "rig-properties:" .. tostring(track.rigName)
	end
	if track.parentTrackPath then
		return "parent:" .. tostring(track.parentTrackPath)
	end
	if track.targetScope == "CameraProperty" or track.trackType == "Camera Property" then
		return "camera-properties"
	end
	if track.folderPath then
		return "folder:" .. tostring(track.folderPath)
	end
	return "top"
end

function WidgetControllerUtilitySupport.ensureCameraCanPreviewRoll(camera, zDegrees)
	if camera and camera.CameraType == Enum.CameraType.Fixed and math.abs(tonumber(zDegrees) or 0) &gt; 0.001 then
		camera.CameraType = Enum.CameraType.Scriptable
	end
end

function WidgetControllerUtilitySupport.isShiftDown(widgetMathSupport, userInputService)
	return widgetMathSupport.isShiftDown(userInputService)
end

return WidgetControllerUtilitySupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX269">
        <Properties>
          <string name="Name">WidgetDialogStateSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local WidgetDialogStateSupport = {}

function WidgetDialogStateSupport.hideImportDialog(controller)
	if controller._importOverlay then
		controller._importOverlay.Visible = false
	end
	if controller._importIdInput then
		controller._importIdInput.Text = ""
	end
	controller:_setShortcutHint("Import dialog closed")
end

function WidgetDialogStateSupport.showMotionRecipeOverlay(controller, defaultName, captureFocus)
	if not controller._motionRecipeOverlay then
		return false
	end

	local viewModel = controller._lastViewModel or {}
	if defaultName and controller._motionRecipeNameInput and UserInputService:GetFocusedTextBox() ~= controller._motionRecipeNameInput then
		controller._motionRecipeNameInput.Text = tostring(defaultName)
	end
	controller._selectedMotionRecipeName = tostring(controller._selectedMotionRecipeName or viewModel.selectedMotionRecipeName or "")
	controller._motionRecipeOverlay.Visible = true
	controller:_renderMotionRecipeEntries(viewModel)
	controller:_setShortcutHint("Motion recipes open: save, load, rename, delete, or close")

	if captureFocus then
		task.defer(function()
			if controller._motionRecipeNameInput and controller._motionRecipeOverlay.Visible then
				controller._motionRecipeNameInput:CaptureFocus()
				controller._motionRecipeNameInput.CursorPosition = #controller._motionRecipeNameInput.Text + 1
			end
		end)
	end

	return true
end

function WidgetDialogStateSupport.hideMotionRecipeOverlay(controller)
	if controller._motionRecipeOverlay then
		controller._motionRecipeOverlay.Visible = false
	end
	controller:_setShortcutHint("Motion recipe manager closed")
end

return WidgetDialogStateSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX270">
        <Properties>
          <string name="Name">WidgetEffectFadeSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local Constants = require(script.Parent:WaitForChild("Constants"))

local WidgetEffectFadeSupport = {}

local function colorsAreClose(left, right)
	if typeof(left) ~= "Color3" or typeof(right) ~= "Color3" then
		return false
	end

	return math.abs(left.R - right.R) &lt; 0.01
		and math.abs(left.G - right.G) &lt; 0.01
		and math.abs(left.B - right.B) &lt; 0.01
end

function WidgetEffectFadeSupport.renderEffectFadeCustomControls(controller, customFadeColors)
	local transparency = math.clamp(tonumber(controller._effectFadeCustomTransparency) or 0.5, 0, 1)
	controller._effectFadeCustomTransparency = transparency

	if controller._effectFadeTransparencyLabel then
		controller._effectFadeTransparencyLabel.Text = string.format("Transparency: %d%%", math.floor((transparency * 100) + 0.5))
	end
	if controller._effectFadeTransparencyFill then
		controller._effectFadeTransparencyFill.Size = UDim2.new(transparency, 0, 1, 0)
	end
	if controller._effectFadeTransparencyKnob then
		controller._effectFadeTransparencyKnob.Position = UDim2.new(transparency, 0, 0.5, 0)
	end

	for colorName, button in pairs(controller._effectFadeColorButtons or {}) do
		local color = customFadeColors[colorName] or customFadeColors.Black
		local selected = colorsAreClose(controller._effectFadeCustomColor, color)
		button.BackgroundColor3 = selected and Constants.THEME.AccentSoft or color
		button.TextColor3 = colorName == "Black" and Constants.THEME.Text or Color3.fromRGB(18, 20, 26)
		button.Text = selected and (colorName .. " *") or colorName
	end
end

function WidgetEffectFadeSupport.setEffectFadeCustomColor(controller, colorName, customFadeColors)
	controller._effectFadeCustomColor = customFadeColors[colorName] or customFadeColors.Black
end

function WidgetEffectFadeSupport.writeEffectFadeCustomKey(controller, commitToHistory)
	local trackPath = controller._activeEffectTrackPath
	local callbacks = controller._callbacks
	if not trackPath or not callbacks then
		return
	end

	if commitToHistory and callbacks.onSetScreenEffectCustomKey then
		callbacks.onSetScreenEffectCustomKey(trackPath, controller._effectFadeCustomColor, controller._effectFadeCustomTransparency)
	elseif (not commitToHistory) and callbacks.onPreviewScreenEffectCustomKey then
		callbacks.onPreviewScreenEffectCustomKey(trackPath, controller._effectFadeCustomColor, controller._effectFadeCustomTransparency)
	end
end

function WidgetEffectFadeSupport.setEffectFadeTransparencyFromX(controller, screenX)
	local track = controller._effectFadeTransparencyTrack
	screenX = tonumber(screenX)
	if not screenX or not track or track.AbsoluteSize.X &lt;= 0 then
		return false
	end

	local previousTransparency = math.clamp(tonumber(controller._effectFadeCustomTransparency) or 0.5, 0, 1)
	local alpha = (screenX - track.AbsolutePosition.X) / track.AbsoluteSize.X
	controller._effectFadeCustomTransparency = math.clamp(alpha, 0, 1)
	return math.abs(previousTransparency - controller._effectFadeCustomTransparency) &gt; 0.001
end

function WidgetEffectFadeSupport.setEffectFadeTransparencyFromDelta(controller, deltaX)
	local track = controller._effectFadeTransparencyTrack
	deltaX = tonumber(deltaX) or 0
	if deltaX == 0 or not track or track.AbsoluteSize.X &lt;= 0 then
		return false
	end

	local previousTransparency = math.clamp(tonumber(controller._effectFadeCustomTransparency) or 0.5, 0, 1)
	controller._effectFadeCustomTransparency = math.clamp(previousTransparency + (deltaX / track.AbsoluteSize.X), 0, 1)
	return math.abs(previousTransparency - controller._effectFadeCustomTransparency) &gt; 0.001
end

function WidgetEffectFadeSupport.clearEffectFadeTransparencyDrag(controller)
	local drag = controller._effectFadeTransparencyDrag
	if not drag then
		return
	end

	for _, connection in pairs(drag) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	controller._effectFadeTransparencyDrag = nil
end

function WidgetEffectFadeSupport.beginEffectFadeTransparencyDragAtX(controller, screenX, deltaToVector2)
	if not tonumber(screenX) then
		return
	end

	controller:_clearEffectFadeTransparencyDrag()
	controller:_setEffectFadeTransparencyFromX(screenX)
	controller:_writeEffectFadeCustomKey(true)
	controller._effectFadeTransparencyDrag = {
		rootMove = controller._root and controller._root.InputChanged:Connect(function(changedInput)
			if changedInput.UserInputType ~= Enum.UserInputType.MouseMovement and changedInput.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			if controller:_setEffectFadeTransparencyFromDelta(deltaToVector2(changedInput.Delta).X) then
				controller:_writeEffectFadeCustomKey(false)
			end
		end),
		release = UserInputService.InputEnded:Connect(function(endedInput)
			if endedInput.UserInputType == Enum.UserInputType.MouseButton1 or endedInput.UserInputType == Enum.UserInputType.Touch then
				controller:_clearEffectFadeTransparencyDrag()
			end
		end),
	}
end

function WidgetEffectFadeSupport.beginEffectFadeTransparencyDrag(controller, inputObject, positionToVector2)
	if not inputObject
		or (inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 and inputObject.UserInputType ~= Enum.UserInputType.Touch)
	then
		return
	end

	controller:_beginEffectFadeTransparencyDragAtX(positionToVector2(inputObject.Position).X)
end

return WidgetEffectFadeSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX271">
        <Properties>
          <string name="Name">WidgetImportBrowserSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent:WaitForChild("ThemeService"))

local WidgetImportBrowserSupport = {}

local function createPreviewLoadingOverlay(parent, deps)
	local create = deps.create
	local createCorner = deps.createCorner
	local overlay = create("Frame", {
		Name = "PreviewLoadingOverlay",
		Parent = parent,
		BackgroundColor3 = Color3.fromRGB(38, 42, 52),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Visible = true,
		ZIndex = 3,
	})
	createCorner(overlay, 10)
	create("TextLabel", {
		Parent = overlay,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 18),
		Text = "Loading preview...",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 4,
	})
	local track = create("Frame", {
		Parent = overlay,
		BackgroundColor3 = Color3.fromRGB(24, 28, 38),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.new(0, 18, 1, -22),
		Size = UDim2.new(1, -36, 0, 5),
		ZIndex = 4,
	})
	createCorner(track, 3)
	local fill = create("Frame", {
		Parent = track,
		BackgroundColor3 = Constants.THEME.Accent,
		BorderSizePixel = 0,
		Position = UDim2.new(-0.35, 0, 0, 0),
		Size = UDim2.new(0.35, 0, 1, 0),
		ZIndex = 5,
	})
	createCorner(fill, 3)
	task.spawn(function()
		while overlay.Parent and overlay:GetAttribute("Done") ~= true do
			if overlay.Visible then
				for step = 0, 40 do
					if not overlay.Parent or not overlay.Visible or overlay:GetAttribute("Done") == true then
						break
					end
					fill.Position = UDim2.new(-0.35 + (step / 40) * 1.35, 0, 0, 0)
					task.wait(0.025)
				end
			else
				task.wait(0.15)
			end
		end
	end)
	return overlay
end

function WidgetImportBrowserSupport.buildImportEntriesSignature(entries, statusText)
	local signatureParts = { statusText or "" }
	for _, entry in ipairs(entries or {}) do
		table.insert(signatureParts, tostring(entry.id) .. ":" .. tostring(entry.name) .. ":" .. tostring(entry.numericId) .. ":" .. tostring(entry.entryType))
	end
	return table.concat(signatureParts, "|")
end

local function clearGuiObjects(parent)
	for _, child in ipairs(parent and parent:GetChildren() or {}) do
		if child:IsA("GuiObject") or child:IsA("UIGridStyleLayout") then
			child:Destroy()
		end
	end
end

local function formatSavedProjectTime(value)
	local text = tostring(value or "")
	local year, month, day, hour, minute =
		string.match(text, "^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):%d+Z$")
	if year then
		return string.format("%s/%s/%s  %s:%s UTC", day, month, year, hour, minute)
	end
	return text ~= "" and text or "Unknown"
end

local function createSavedProjectActionButton(parent, props, deps)
	local button = deps.create("TextButton", {
		Parent = parent,
		AutoButtonColor = true,
		BackgroundColor3 = props.primary and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = props.position,
		Size = props.size,
		Text = props.text,
		TextColor3 = ThemeService.getReadableTextColor(
			props.primary and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt
		),
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 125,
	})
	deps.createCorner(button, 5)
	deps.create("UIStroke", {
		Parent = button,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = props.primary and Constants.THEME.Accent or Constants.THEME.Border,
		Thickness = 1,
		Transparency = props.primary and 0.22 or 0.46,
	})
	return button
end

local function renderSavedProjectsTable(controller, entries, statusText, deps)
	local rows = controller._savedProjectsRows
	local pagination = controller._savedProjectsPagination
	if not rows or not pagination then
		return false
	end

	controller._savedProjectEntries = entries or {}
	controller._savedProjectsPageIndex = math.max(1, tonumber(controller._savedProjectsPageIndex) or 1)

	controller._renderSavedProjectsPage = function()
		local searchText = controller._savedProjectsSearchInput
				and string.lower(tostring(controller._savedProjectsSearchInput.Text or ""))
			or ""
		searchText = searchText:gsub("^%s+", ""):gsub("%s+$", "")

		local filtered = {}
		for _, entry in ipairs(controller._savedProjectEntries or {}) do
			local searchable = string.lower(table.concat({
				tostring(entry.name or ""),
				tostring(entry.category or ""),
				tostring(entry.priceLabel or ""),
			}, " "))
			if searchText == "" or string.find(searchable, searchText, 1, true) then
				table.insert(filtered, entry)
			end
		end

		local pageSize = 5
		local pageCount = math.max(1, math.ceil(#filtered / pageSize))
		controller._savedProjectsPageIndex = math.clamp(controller._savedProjectsPageIndex, 1, pageCount)
		local startIndex = (controller._savedProjectsPageIndex - 1) * pageSize + 1
		local endIndex = math.min(#filtered, startIndex + pageSize - 1)

		clearGuiObjects(rows)
		deps.create("UIListLayout", {
			Parent = rows,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})

		if #filtered == 0 then
			deps.create("TextLabel", {
				Parent = rows,
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamSemibold,
				Size = UDim2.new(1, 0, 0, 52),
				Text = searchText ~= "" and "No saved projects match that search."
					or statusText
					or "No saved projects were found.",
				TextColor3 = Constants.THEME.MutedText,
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				ZIndex = 123,
			})
		else
			for index = startIndex, endIndex do
				local entry = filtered[index]
				local row = deps.create("Frame", {
					Parent = rows,
					BackgroundColor3 = Constants.THEME.PanelSoft,
					BorderSizePixel = 0,
					LayoutOrder = index,
					Size = UDim2.new(1, 0, 0, 48),
					ZIndex = 123,
				})
				deps.createCorner(row, 5)
				deps.create("UIStroke", {
					Parent = row,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Color = Constants.THEME.Border,
					Thickness = 1,
					Transparency = 0.5,
				})

				for _, cell in ipairs({
					{ text = tostring(entry.name or entry.numericId or "Untitled Project"), x = 0, width = 0.22, bold = true },
					{ text = tostring(entry.category or "Project"), x = 0.22, width = 0.16 },
					{ text = formatSavedProjectTime(entry.priceLabel), x = 0.38, width = 0.22 },
				}) do
					deps.create("TextLabel", {
						Parent = row,
						BackgroundTransparency = 1,
						Font = cell.bold and Enum.Font.GothamBold or Enum.Font.GothamSemibold,
						Position = UDim2.new(cell.x, 12, 0, 0),
						Size = UDim2.new(cell.width, -12, 1, 0),
						Text = cell.text,
						TextColor3 = Constants.THEME.Text,
						TextSize = 11,
						TextTruncate = Enum.TextTruncate.AtEnd,
						TextXAlignment = Enum.TextXAlignment.Left,
						ZIndex = 124,
					})
				end

				local openButton = createSavedProjectActionButton(row, {
					position = UDim2.new(0.6, 4, 0, 8),
					size = UDim2.new(0.18, -10, 0, 32),
					text = "Open Project",
				}, deps)
				local mapButton = createSavedProjectActionButton(row, {
					position = UDim2.new(0.78, 2, 0, 8),
					size = UDim2.new(0.22, -6, 0, 32),
					text = "Import onto Selected Rig",
					primary = true,
				}, deps)

				openButton.Activated:Connect(function()
					if controller._importStatusLabel then
						controller._importStatusLabel.Text = "Opening saved project " .. tostring(entry.name or entry.id) .. "..."
					end
					if controller._callbacks and controller._callbacks.onOpenSavedProject then
						local handled = controller._callbacks.onOpenSavedProject(entry.id)
						if handled == true then
							controller:_hideImportDialog()
							controller:_focusShortcutCapture("Import closed after opening saved project")
						end
					end
				end)
				mapButton.Activated:Connect(function()
					if controller._importStatusLabel then
						controller._importStatusLabel.Text =
							"Checking the selected rig for " .. tostring(entry.name or entry.id) .. "..."
					end
					local callback = controller._callbacks and controller._callbacks.onImportSavedProjectToSelectedRig
					if callback then
						callback(entry.id, controller._root or controller._importOverlay or rows, function()
							controller:_hideImportDialog()
							controller:_focusShortcutCapture("Import closed after mapping saved project")
						end)
					end
				end)
			end
		end

		if controller._savedProjectsCountLabel then
			controller._savedProjectsCountLabel.Text = #filtered == 0
					and (searchText ~= "" and "No matching projects" or "No saved projects")
				or string.format("Showing %d-%d of %d projects", startIndex, endIndex, #filtered)
		end

		clearGuiObjects(pagination)
		deps.create("UIListLayout", {
			Parent = pagination,
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})

		local function addPageButton(text, order, targetPage, selected)
			local button = deps.create("TextButton", {
				Parent = pagination,
				AutoButtonColor = not selected,
				BackgroundColor3 = selected and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				LayoutOrder = order,
				Size = UDim2.fromOffset(30, 30),
				Text = text,
				TextColor3 = Constants.THEME.Text,
				TextSize = 12,
				ZIndex = 124,
			})
			deps.createCorner(button, 5)
			deps.create("UIStroke", {
				Parent = button,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = selected and Constants.THEME.Accent or Constants.THEME.Border,
				Thickness = 1,
				Transparency = selected and 0.2 or 0.5,
			})
			button.Active = targetPage ~= nil and targetPage ~= controller._savedProjectsPageIndex
			if button.Active then
				button.Activated:Connect(function()
					controller._savedProjectsPageIndex = targetPage
					controller._renderSavedProjectsPage()
				end)
			end
		end

		addPageButton("&lt;", 1, controller._savedProjectsPageIndex &gt; 1 and controller._savedProjectsPageIndex - 1 or nil, false)
		local firstPage = math.max(1, math.min(controller._savedProjectsPageIndex - 2, pageCount - 4))
		local lastPage = math.min(pageCount, firstPage + 4)
		for page = firstPage, lastPage do
			addPageButton(tostring(page), page + 1, page, page == controller._savedProjectsPageIndex)
		end
		addPageButton(
			"&gt;",
			pageCount + 3,
			controller._savedProjectsPageIndex &lt; pageCount and controller._savedProjectsPageIndex + 1 or nil,
			false
		)
	end

	if controller._savedProjectsSearchInput and not controller._savedProjectsSearchBound then
		controller._savedProjectsSearchBound = true
		local signal = controller._savedProjectsSearchInput:GetPropertyChangedSignal("Text")
		local onSearchChanged = function()
			controller._savedProjectsPageIndex = 1
			if type(controller._renderSavedProjectsPage) == "function" then
				controller._renderSavedProjectsPage()
			end
		end
		if type(controller._connect) == "function" then
			controller:_connect(signal, onSearchChanged)
		else
			signal:Connect(onSearchChanged)
		end
	end

	controller._renderSavedProjectsPage()
	return true
end

function WidgetImportBrowserSupport.renderImportAnimationEntries(controller, entries, statusText, deps)
	if not controller._ownedAnimationsList then
		return false
	end

	entries = entries or {}
	local create = deps.create
	local createCorner = deps.createCorner

	if controller._savedProjectsCard and controller._savedProjectsCard.Visible then
		return renderSavedProjectsTable(controller, entries, statusText, deps)
	end

	for _, child in ipairs(controller._ownedAnimationsList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	if #entries == 0 then
		create("TextLabel", {
			Parent = controller._ownedAnimationsList,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 44),
			Font = Enum.Font.Gotham,
			Text = statusText or "Click My Animations to browse animations owned by your Studio account, or select two workspace markers and use Import Selected.",
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 113,
		})
		return true
	end

	for _, entry in ipairs(entries) do
		local numericId = tostring(entry.numericId or entry.id or "")
		local displayName = tostring(entry.name or "")
		local metaParts = {}
		if entry.pack then
			table.insert(metaParts, tostring(entry.pack))
		end
		if entry.rigType then
			table.insert(metaParts, tostring(entry.rigType))
		end
		if entry.category then
			table.insert(metaParts, tostring(entry.category))
		end
		if entry.source then
			table.insert(metaParts, tostring(entry.source))
		end
		if entry.creatorName then
			table.insert(metaParts, tostring(entry.creatorName))
		end
		if entry.priceLabel then
			table.insert(metaParts, tostring(entry.priceLabel))
		end
		local detailText = #metaParts &gt; 0 and table.concat(metaParts, "  |  ") or "Click to import"
		local buttonText
		if entry.entryType == "BulkKeyframeSequence" then
			local countText = entry.keyframeCount and (tostring(entry.keyframeCount) .. " keyframes") or "KeyframeSequence"
			local pathText = tostring(entry.instancePath or "")
			local shortPath = pathText ~= "" and string.gsub(pathText, "^game%.", "") or detailText
			buttonText = string.format("%s\n%s  |  %s", displayName ~= "" and displayName or "KeyframeSequence", shortPath, countText)
		elseif entry.entryType == "LoadMoreMyAnimations" then
			buttonText = string.format("%s\n%s", displayName ~= "" and displayName or "Load More Animations", detailText)
		else
			buttonText = displayName ~= ""
				and string.format("%s\n%s  |  #%s", displayName, detailText, numericId)
				or string.format("Animation #%s\n%s", numericId, detailText)
		end
		if entry.entryType == "SavedProject" then
			local row = create("Frame", {
				Parent = controller._ownedAnimationsList,
				BackgroundColor3 = Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 76),
				ZIndex = 113,
			})
			createCorner(row, 5)
			create("UIStroke", {
				Parent = row,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = Constants.THEME.Border,
				Thickness = 1,
				Transparency = 0.5,
			})
			create("TextLabel", {
				Parent = row,
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Position = UDim2.fromOffset(12, 7),
				Size = UDim2.new(1, -24, 0, 32),
				Text = buttonText,
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelSoft),
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 114,
			})
			local openButton = create("TextButton", {
				Parent = row,
				AutoButtonColor = true,
				BackgroundColor3 = Constants.THEME.PanelAlt,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Position = UDim2.new(0, 8, 1, -34),
				Size = UDim2.new(0.42, -10, 0, 28),
				Text = "Open Project",
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelAlt),
				TextSize = 11,
				ZIndex = 114,
			})
			createCorner(openButton, 5)
			create("UIStroke", {
				Parent = openButton,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = Constants.THEME.Border,
				Thickness = 1,
				Transparency = 0.48,
			})
			local mapButton = create("TextButton", {
				Parent = row,
				AutoButtonColor = true,
				BackgroundColor3 = Constants.THEME.AccentSoft,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Position = UDim2.new(0.42, 2, 1, -34),
				Size = UDim2.new(0.58, -10, 0, 28),
				Text = "Import onto Selected Rig",
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.AccentSoft),
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 114,
			})
			createCorner(mapButton, 5)
			create("UIStroke", {
				Parent = mapButton,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = Constants.THEME.Accent,
				Thickness = 1,
				Transparency = 0.26,
			})

			openButton.Activated:Connect(function()
				if controller._importStatusLabel then
					controller._importStatusLabel.Text = "Opening saved project " .. (displayName ~= "" and displayName or numericId) .. "..."
				end
				if controller._callbacks and controller._callbacks.onOpenSavedProject then
					local handled = controller._callbacks.onOpenSavedProject(entry.id)
					if handled == true then
						controller:_hideImportDialog()
						controller:_focusShortcutCapture("Import closed after opening saved project")
					end
				end
			end)
			mapButton.Activated:Connect(function()
				if controller._importStatusLabel then
					controller._importStatusLabel.Text = "Checking the selected rig for " .. (displayName ~= "" and displayName or numericId) .. "..."
				end
				local callback = controller._callbacks and controller._callbacks.onImportSavedProjectToSelectedRig
				if callback then
					callback(entry.id, controller._root or controller._importOverlay or controller._ownedAnimationsList, function()
						controller:_hideImportDialog()
						controller:_focusShortcutCapture("Import closed after mapping saved project")
					end)
				end
			end)
		else
			local button = create("TextButton", {
				Parent = controller._ownedAnimationsList,
				AutoButtonColor = true,
				BackgroundColor3 = entry.entryType == "LoadMoreMyAnimations" and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 52),
				Font = Enum.Font.GothamSemibold,
				Text = buttonText,
				TextColor3 = ThemeService.getReadableTextColor(entry.entryType == "LoadMoreMyAnimations" and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft),
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				ZIndex = 113,
			})
			createCorner(button, 5)
			create("UIStroke", {
				Parent = button,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = Constants.THEME.Border,
				Thickness = 1,
				Transparency = 0.52,
			})
			create("UIPadding", {
				Parent = button,
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
			})
			button.Activated:Connect(function()
				if entry.entryType == "BulkKeyframeSequence" then
				if controller._importStatusLabel then
					controller._importStatusLabel.Text = "Importing " .. (displayName ~= "" and displayName or "selected KeyframeSequence") .. "..."
				end
				if controller._callbacks and controller._callbacks.onImportBulkKeyframeSequence then
					controller._callbacks.onImportBulkKeyframeSequence(entry.id)
				end
			elseif entry.entryType == "LoadMoreMyAnimations" then
				if controller._importStatusLabel then
					controller._importStatusLabel.Text = "Loading more animations..."
				end
				if controller._callbacks and controller._callbacks.onLoadMoreMyAnimations then
					controller._callbacks.onLoadMoreMyAnimations()
				end
			else
				if controller._importIdInput then
					controller._importIdInput.Text = tostring(entry.id or "")
				end
				if controller._importStatusLabel then
					controller._importStatusLabel.Text = "Importing " .. (displayName ~= "" and displayName or ("animation " .. numericId)) .. "..."
				end
				if controller._callbacks and controller._callbacks.onImportAnimationId then
					controller._callbacks.onImportAnimationId(entry.id, entry.name, entry)
				end
				end
			end)
		end
	end

	return true
end

function WidgetImportBrowserSupport.buildPresetEntriesSignature(controller, entries, statusText)
	local pickerMotion = tostring(controller._motionDefaultPickerMotion or "")
	local presetSource = tostring(controller._presetSource or "")
	local expectedEntrySource = presetSource == "MyAnimations" and "My Animations"
		or (presetSource == "RobloxStarter" and "Roblox Starter" or nil)
	local filteredEntries = {}
	for _, entry in ipairs(entries or {}) do
		local sourceMatches = not expectedEntrySource or tostring(entry.source or "") == expectedEntrySource
		local entryRigType = entry.rigType
		local rigMatches = entry.entryType == "LoadMoreMyAnimations"
			or controller._presetRigFilter == "All"
			or entryRigType == nil
			or tostring(entryRigType) == controller._presetRigFilter
		if sourceMatches and rigMatches then
			table.insert(filteredEntries, entry)
		end
	end

	local signatureParts = { controller._workspaceMode or "", presetSource, #filteredEntries == 0 and (statusText or "") or "" }
	table.insert(signatureParts, controller._presetRigFilter or "All")
	table.insert(signatureParts, pickerMotion)
	for _, entry in ipairs(filteredEntries) do
		table.insert(signatureParts, tostring(entry.id) .. ":" .. tostring(entry.name) .. ":" .. tostring(entry.numericId) .. ":" .. tostring(entry.entryType))
	end
	return table.concat(signatureParts, "|"), filteredEntries, pickerMotion ~= ""
end

function WidgetImportBrowserSupport.renderPresetBrowserEntries(controller, filteredEntries, statusText, isChoosingMotionDefault, pickerMotion, deps)
	if not controller._presetGrid then
		return false
	end

	local create = deps.create
	local createCorner = deps.createCorner
	local createStroke = deps.createStroke

	for _, previewState in pairs(controller._presetPreviewStates or {}) do
		if previewState.connection then
			pcall(function()
				previewState.connection:Disconnect()
			end)
		end
	end
	controller._presetPreviewStates = {}

	for _, child in ipairs(controller._presetGrid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	if #filteredEntries == 0 then
		create("TextLabel", {
			Parent = controller._presetGrid,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 48),
			Font = Enum.Font.Gotham,
			Text = controller._presetRigFilter ~= "All"
				and ("No " .. controller._presetRigFilter .. " preset variants are available in the current results yet.")
				or (isChoosingMotionDefault and ("Loading your animations. Choose one to use as the default " .. pickerMotion .. " clip.") or (statusText or "Click Roblox Starter or My Animations to load animation clips here.")),
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		return true
	end

	for _, entry in ipairs(filteredEntries) do
		if entry.entryType == "LoadMoreMyAnimations" then
			local loadMoreCard = create("TextButton", {
				Parent = controller._presetGrid,
				AutoButtonColor = true,
				BackgroundColor3 = Constants.THEME.AccentSoft,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 170, 0, 186),
				Font = Enum.Font.GothamSemibold,
				Text = tostring(entry.name or "Load More Animations") .. "\n\n" .. tostring(entry.category or "Browse older uploads"),
				TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.AccentSoft),
				TextSize = 13,
				TextWrapped = true,
			})
			createCorner(loadMoreCard, 12)
			createStroke(loadMoreCard, Constants.THEME.Border)
			controller:_connect(loadMoreCard.Activated, function()
				if controller._presetStatusLabel then
					controller._presetStatusLabel.Text = "Loading more animations..."
				end
				if controller._callbacks and controller._callbacks.onLoadMoreMyAnimations then
					controller._callbacks.onLoadMoreMyAnimations()
				end
			end)
		else
			local card = create("TextButton", {
				Parent = controller._presetGrid,
				AutoButtonColor = true,
				BackgroundColor3 = Constants.THEME.PanelAlt,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 170, 0, 186),
				Text = "",
			})
			createCorner(card, 12)
			createStroke(card, Constants.THEME.Border)

			local previewFrame = create("Frame", {
				Parent = card,
				BackgroundColor3 = Color3.fromRGB(48, 52, 60),
				BorderSizePixel = 0,
				Position = UDim2.new(0, 12, 0, 12),
				Size = UDim2.new(1, -24, 0, 100),
			})
			createCorner(previewFrame, 10)

			local viewport = create("ViewportFrame", {
				Parent = previewFrame,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				Ambient = Color3.fromRGB(184, 186, 214),
				LightColor = Color3.fromRGB(236, 238, 255),
				LightDirection = Vector3.new(-1, -1, -0.35),
				ZIndex = 1,
			})
			createCorner(viewport, 10)

			local fallbackThumb = create("ImageLabel", {
				Parent = previewFrame,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				Image = string.format("rbxthumb://type=Asset&amp;id=%s&amp;w=420&amp;h=420", tostring(entry.numericId or entry.id or 0)),
				ScaleType = Enum.ScaleType.Crop,
				Visible = false,
				ZIndex = 1,
			})
			createCorner(fallbackThumb, 10)
			local loadingOverlay = createPreviewLoadingOverlay(previewFrame, deps)

			local previewButton = create("TextButton", {
				Parent = card,
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -10, 0, 108),
				Size = UDim2.new(0, 58, 0, 22),
				BackgroundColor3 = Constants.THEME.Panel,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamSemibold,
				Text = "Enlarge",
				TextColor3 = Constants.THEME.Text,
				TextSize = 10,
				ZIndex = 4,
			})
			createCorner(previewButton, 7)
			createStroke(previewButton)

			create("TextLabel", {
				Parent = card,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 120),
				Size = UDim2.new(1, -24, 0, 34),
				Font = Enum.Font.GothamSemibold,
				Text = tostring(entry.name or ("Animation #" .. tostring(entry.numericId or entry.id or ""))),
				TextColor3 = Constants.THEME.Text,
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			})

			local metaText = tostring(entry.pack or entry.source or "Library")
			if entry.rigType then
				metaText = metaText .. "  |  " .. tostring(entry.rigType)
			end
			if entry.category then
				metaText = metaText .. "  |  " .. tostring(entry.category)
			end
			if entry.creatorName then
				metaText = metaText .. "  |  " .. tostring(entry.creatorName)
			end
			if entry.priceLabel then
				metaText = metaText .. "  |  " .. tostring(entry.priceLabel)
			end
			create("TextLabel", {
				Parent = card,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 154),
				Size = UDim2.new(1, -24, 0, 20),
				Font = Enum.Font.Gotham,
				Text = metaText,
				TextColor3 = Constants.THEME.MutedText,
				TextSize = 10,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			})

			controller:_connect(card.Activated, function()
				controller:_usePresetEntryForCurrentPurpose(entry)
			end)
			controller:_connect(previewButton.Activated, function()
				controller:_showPresetPreview(entry)
			end)

			controller:_connect(card.MouseEnter, function()
				controller:_setPresetPreviewPlaying(viewport, true)
			end)
			controller:_connect(card.MouseLeave, function()
				controller:_setPresetPreviewPlaying(viewport, false)
			end)

			controller:_populatePresetPreview(viewport, fallbackThumb, entry, {
				autoPlay = false,
				loadingOverlay = loadingOverlay,
			})
		end
	end

	return true
end

return WidgetImportBrowserSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX272">
        <Properties>
          <string name="Name">WidgetMathSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local WidgetMathSupport = {}

function WidgetMathSupport.formatNumber(value)
	if value == nil then
		return "0.00"
	end
	return string.format("%.2f", value)
end

function WidgetMathSupport.safeFps(fps)
	return math.max(1, tonumber(fps) or Constants.DEFAULT_FPS)
end

function WidgetMathSupport.positionToVector2(position)
	return Vector2.new(position.X, position.Y)
end

function WidgetMathSupport.deltaToVector2(delta)
	return Vector2.new(delta.X, delta.Y)
end

function WidgetMathSupport.frameFromPosition(guiObject, position, durationFrames)
	local width = math.max(1, guiObject.AbsoluteSize.X)
	local relativeX = math.clamp(position.X - guiObject.AbsolutePosition.X, 0, width)
	local alpha = relativeX / width
	return math.floor(alpha * math.max(1, durationFrames or 1) + 0.5)
end

function WidgetMathSupport.frameFromInput(guiObject, inputObject, durationFrames)
	return WidgetMathSupport.frameFromPosition(guiObject, WidgetMathSupport.positionToVector2(inputObject.Position), durationFrames)
end

function WidgetMathSupport.thresholdPassed(delta, threshold)
	if not threshold or threshold &lt;= 0 then
		return true
	end

	return delta.Magnitude &gt;= threshold
end

function WidgetMathSupport.isShiftDown(userInputService)
	if userInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or userInputService:IsKeyDown(Enum.KeyCode.RightShift) then
		return true
	end

	local ok, pressedKeys = pcall(function()
		return userInputService:GetKeysPressed()
	end)
	if ok then
		for _, inputObject in ipairs(pressedKeys) do
			if inputObject.KeyCode == Enum.KeyCode.LeftShift or inputObject.KeyCode == Enum.KeyCode.RightShift then
				return true
			end
		end
	end

	return false
end

function WidgetMathSupport.isShiftKey(keyCode)
	return keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift
end

function WidgetMathSupport.isShiftKeyString(key)
	local lowered = string.lower(tostring(key or ""))
	lowered = string.gsub(lowered, "%s+", "")
	lowered = string.gsub(lowered, "_", "")
	return lowered == "leftshift"
		or lowered == "rightshift"
		or lowered == "shift"
		or string.find(lowered, "shift", 1, true) ~= nil
end

function WidgetMathSupport.isPointInsideGui(guiObject, point)
	local position = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize
	return point.X &gt;= position.X
		and point.X &lt;= position.X + size.X
		and point.Y &gt;= position.Y
		and point.Y &lt;= position.Y + size.Y
end

function WidgetMathSupport.makeTrackKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(frame)
end

function WidgetMathSupport.parseTrackKeyId(keyId)
	local divider = string.find(tostring(keyId or ""), "\n", 1, true)
	if not divider then
		return nil, nil
	end

	local jointPath = string.sub(keyId, 1, divider - 1)
	local frame = tonumber(string.sub(keyId, divider + 1))
	if not jointPath or frame == nil then
		return nil, nil
	end

	return jointPath, frame
end

function WidgetMathSupport.rectsOverlap(aMinX, aMinY, aMaxX, aMaxY, bMinX, bMinY, bMaxX, bMaxY)
	return aMinX &lt;= bMaxX and aMaxX &gt;= bMinX and aMinY &lt;= bMaxY and aMaxY &gt;= bMinY
end

function WidgetMathSupport.getTimelineMarkerRect(markerData)
	local lane = markerData and markerData.lane
	if not lane or not lane.Parent then
		return nil
	end

	local lanePosition = lane.AbsolutePosition
	local laneSize = lane.AbsoluteSize
	local centerX = lanePosition.X + (markerData.x or 0)
	local centerY = lanePosition.Y + (laneSize.Y / 2)
	local width = math.max(1, markerData.hitWidth or markerData.hitSize or 14)
	local height = math.max(1, markerData.hitHeight or markerData.hitSize or 14)
	local halfWidth = width / 2
	local halfHeight = height / 2
	return centerX - halfWidth, centerY - halfHeight, centerX + halfWidth, centerY + halfHeight
end

return WidgetMathSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX273">
        <Properties>
          <string name="Name">WidgetMotionDefaultsSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local WidgetMotionDefaultsSupport = {}

function WidgetMotionDefaultsSupport.buildMotionDefaultsSignature(viewModel, motionOptions, openMotion, appendSignatureValue)
	local defaultsSignatureParts = {}
	for _, motionName in ipairs(motionOptions) do
		appendSignatureValue(defaultsSignatureParts, motionName)
		appendSignatureValue(defaultsSignatureParts, (viewModel.motionDefaultClips or {})[motionName] or "")
	end
	appendSignatureValue(defaultsSignatureParts, openMotion or "")
	return table.concat(defaultsSignatureParts, "|")
end

function WidgetMotionDefaultsSupport.renderMotionDefaults(controller, viewModel, deps)
	local defaultsFrame = controller._motionDefaultsFrame
	if not defaultsFrame then
		return false
	end

	local create = deps.create
	local createCorner = deps.createCorner
	local createStroke = deps.createStroke
	local motionOptions = deps.motionOptions
	local defaults = viewModel.motionDefaultClips or {}
	local optionsByMotion = viewModel.motionClipOptionsByMotion or {}

	local function findClipLabel(options, clipId, fallback)
		clipId = tostring(clipId or "")
		for _, option in ipairs(options or {}) do
			if tostring(option.id or "") == clipId then
				return tostring(option.name or option.pack or fallback)
			end
		end
		return fallback
	end

	for _, child in ipairs(defaultsFrame:GetChildren()) do
		if not child:IsA("UICorner") and not child:IsA("UIStroke") then
			child:Destroy()
		end
	end

	create("TextLabel", {
		Parent = defaultsFrame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 5),
		Size = UDim2.new(0, 100, 0, 26),
		Font = Enum.Font.GothamSemibold,
		Text = "Motion Defaults",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 9,
	})

	local buttonRow = create("Frame", {
		Parent = defaultsFrame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 116, 0, 8),
		Size = UDim2.new(1, -126, 0, 24),
		ZIndex = 9,
	})
	local layout = create("UIListLayout", {
		Parent = buttonRow,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	local defaultButtonScale = 1 / math.max(1, #motionOptions)
	for index, motionName in ipairs(motionOptions) do
		local selectedId = tostring(defaults[motionName] or "")
		local label = findClipLabel(optionsByMotion[motionName], selectedId, selectedId ~= "" and "Custom" or "Auto")
		local isOpen = controller._openMotionDefaultMotion == motionName
		local button = create("TextButton", {
			Parent = buttonRow,
			BackgroundColor3 = selectedId ~= "" and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Size = UDim2.new(defaultButtonScale, -5, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Text = string.format("%s: %s %s", motionName, label, isOpen and "^" or "v"),
			TextColor3 = Constants.THEME.Text,
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 10,
		})
		createCorner(button, 7)
		controller:_connect(button.Activated, function()
			controller._openMotionSegmentKey = nil
			controller._openMotionSegmentMenuType = nil
			controller._openMotionDefaultMotion = isOpen and nil or motionName
			controller:_renderMotionDefaults(viewModel)
			controller:_renderMotionSegments(viewModel.motionSegments or {})
		end)
	end

	local openMotion = controller._openMotionDefaultMotion
	if not openMotion then
		return true
	end

	local options = optionsByMotion[openMotion] or {}
	local selectedId = tostring(defaults[openMotion] or "")
	local menu = create("Frame", {
		Parent = defaultsFrame,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 34),
		Size = UDim2.new(1, -16, 0, 34),
		ZIndex = 20,
	})
	createCorner(menu, 8)
	createStroke(menu)

	create("TextLabel", {
		Parent = menu,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 6),
		Size = UDim2.new(0, 70, 0, 20),
		Font = Enum.Font.GothamSemibold,
		Text = openMotion,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 21,
	})

	local strip = create("ScrollingFrame", {
		Parent = menu,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 82, 0, 4),
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.X,
		Size = UDim2.new(1, -90, 0, 28),
		ZIndex = 21,
	})
	local stripLayout = create("UIListLayout", {
		Parent = strip,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	stripLayout.VerticalAlignment = Enum.VerticalAlignment.Center

	local allOptions = {
		{
			id = "",
			name = "Auto",
		},
		{
			id = "__load_custom__",
			name = openMotion == "Action" and "Browse..." or "Custom...",
		},
	}
	for _, option in ipairs(options) do
		table.insert(allOptions, option)
	end

	for optionIndex, option in ipairs(allOptions) do
		local optionId = tostring(option.id or "")
		local optionText = tostring(option.name or option.pack or optionId)
		local optionButton = create("TextButton", {
			Parent = strip,
			BackgroundColor3 = selectedId == optionId and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			LayoutOrder = optionIndex,
			Size = UDim2.new(0, optionIndex == 1 and 84 or 112, 0, 22),
			Font = Enum.Font.GothamSemibold,
			Text = optionText,
			TextColor3 = Constants.THEME.Text,
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 22,
		})
		createCorner(optionButton, 7)
		controller:_connect(optionButton.Activated, function()
			if optionId == "__load_custom__" then
				local useStarterBrowser = openMotion == "Action" and controller._callbacks and controller._callbacks.onLoadPresetAnimations
				controller._openMotionDefaultMotion = nil
				controller._motionDefaultPickerMotion = openMotion
				controller._lastPresetEntriesSignature = nil
				controller:_setWorkspaceMode("Presets")
				if controller._presetStatusLabel then
					controller._presetStatusLabel.Text = useStarterBrowser
						and ("Opening Roblox Starter presets. Pick one to use as the default " .. tostring(openMotion) .. " clip.")
						or ("Loading your animations. Pick one to use as the default " .. tostring(openMotion) .. " clip.")
				end
				controller:_setShortcutHint("Choose a custom " .. tostring(openMotion) .. " animation from the visual browser.")
				if useStarterBrowser then
					controller._callbacks.onLoadPresetAnimations()
				elseif controller._callbacks and controller._callbacks.onLoadMyAnimations then
					controller._callbacks.onLoadMyAnimations()
				else
					controller:_setShortcutHint("My Animations browser is not connected yet.")
				end
				controller:_renderMotionDefaults(viewModel)
				return
			end
			controller._openMotionDefaultMotion = nil
			if controller._callbacks and controller._callbacks.onSetMotionDefaultClip then
				controller._callbacks.onSetMotionDefaultClip(openMotion, optionId)
			else
				controller:_setShortcutHint("Default style picker is not connected yet.")
				controller:_renderMotionDefaults(viewModel)
			end
		end)
	end

	return true
end

return WidgetMotionDefaultsSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX274">
        <Properties>
          <string name="Name">WidgetMotionMarkersSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local WidgetMotionMarkersSupport = {}

function WidgetMotionMarkersSupport.buildMotionMarkersSignature(markerEntries, appendSignatureValue)
	local signatureParts = {}
	for _, marker in ipairs(markerEntries or {}) do
		appendSignatureValue(signatureParts, marker.name or marker.path or "Marker")
		appendSignatureValue(signatureParts, marker.path or "")
		appendSignatureValue(signatureParts, marker.pauseSeconds or 0)
	end
	return table.concat(signatureParts, "|")
end

function WidgetMotionMarkersSupport.renderMotionMarkers(args)
	local markerEntries = args.markerEntries or {}
	local motionMarkersList = args.motionMarkersList
	if not motionMarkersList then
		return
	end

	for _, child in ipairs(motionMarkersList:GetChildren()) do
		if child ~= args.motionMarkersEmptyLabel and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	if args.motionMarkersEmptyLabel then
		args.motionMarkersEmptyLabel.Visible = #markerEntries == 0
	end
	if #markerEntries == 0 then
		return
	end

	for index, marker in ipairs(markerEntries) do
		local item = args.create("TextButton", {
			Parent = motionMarkersList,
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = index,
			Text = "",
			ZIndex = 8,
		})
		args.createCorner(item, 8)
		args.createStroke(item)
		args.connect(item.Activated, function()
			if args.callbacks and args.callbacks.onSelectMotionMarker then
				args.callbacks.onSelectMotionMarker(marker.path)
			end
		end)

		args.create("TextLabel", {
			Parent = item,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 4),
			Size = UDim2.new(1, -20, 0, 16),
			Font = Enum.Font.GothamSemibold,
			Text = string.format("%d. %s", index, tostring(marker.name or ("Marker " .. tostring(index)))),
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 9,
		})

		local detail = tostring(marker.path or "")
		local pauseSeconds = tonumber(marker.pauseSeconds)
		if pauseSeconds and pauseSeconds &gt; 0 then
			detail = detail .. string.format("    Pause: %.2fs", pauseSeconds)
		end

		args.create("TextLabel", {
			Parent = item,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 19),
			Size = UDim2.new(1, -20, 0, 14),
			Font = Enum.Font.Gotham,
			Text = detail ~= "" and detail or "Workspace marker",
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 9,
		})
	end
end

return WidgetMotionMarkersSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX275">
        <Properties>
          <string name="Name">WidgetMotionRecipeSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local Constants = require(script.Parent:WaitForChild("Constants"))

local WidgetMotionRecipeSupport = {}

function WidgetMotionRecipeSupport.renderMotionRecipeEntries(controller, viewModel, deps)
	if not controller._motionRecipeList then
		return false
	end

	viewModel = viewModel or controller._lastViewModel or {}
	local entries = viewModel.motionRecipeEntries or {}
	local statusText = viewModel.motionRecipeStatus or "No Motion Builder recipes saved yet."
	local selectedName = tostring(controller._selectedMotionRecipeName or viewModel.selectedMotionRecipeName or "")
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local create = deps.create
	local createCorner = deps.createCorner
	local createStroke = deps.createStroke

	if controller._motionRecipeStatusLabel then
		controller._motionRecipeStatusLabel.Text = statusText
	end
	if controller._motionRecipeNameInput and focusedTextBox ~= controller._motionRecipeNameInput then
		if selectedName ~= "" then
			controller._motionRecipeNameInput.Text = selectedName
		elseif controller._motionRecipeOverlay and controller._motionRecipeOverlay.Visible and controller._motionRecipeNameInput.Text == "" then
			local animationName = viewModel.animationName or "Untitled Animation"
			controller._motionRecipeNameInput.Text = tostring(animationName)
		end
	end

	for _, child in ipairs(controller._motionRecipeList:GetChildren()) do
		if child ~= controller._motionRecipeEmptyLabel and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	controller._motionRecipeListButtons = {}
	if controller._motionRecipeEmptyLabel then
		controller._motionRecipeEmptyLabel.Visible = #entries == 0
		controller._motionRecipeEmptyLabel.Text = statusText
	end

	for index, entry in ipairs(entries) do
		local recipeName = tostring(entry.name or entry.id or ("Recipe " .. tostring(index)))
		local isSelected = recipeName == selectedName
		local item = create("TextButton", {
			Parent = controller._motionRecipeList,
			AutoButtonColor = true,
			BackgroundColor3 = isSelected and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 42),
			Text = "",
			ZIndex = 121,
		})
		createCorner(item, 8)
		createStroke(item, isSelected and Constants.THEME.Accent or Constants.THEME.Border, isSelected and 1.5 or 1)

		local titleLabel = create("TextLabel", {
			Parent = item,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 5),
			Size = UDim2.new(1, -20, 0, 16),
			Font = Enum.Font.GothamSemibold,
			Text = recipeName,
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 122,
		})

		local detailText = tostring(entry.creatorName or entry.source or "Motion Builder recipe")
		if entry.priceLabel and tostring(entry.priceLabel) ~= "" then
			detailText = detailText .. "  " .. tostring(entry.priceLabel)
		end
		local detailLabel = create("TextLabel", {
			Parent = item,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 21),
			Size = UDim2.new(1, -20, 0, 14),
			Font = Enum.Font.Gotham,
			Text = detailText,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 122,
		})

		controller._motionRecipeListButtons[recipeName] = {
			button = item,
			titleLabel = titleLabel,
			detailLabel = detailLabel,
		}

		controller:_connect(item.Activated, function()
			controller._selectedMotionRecipeName = recipeName
			if controller._motionRecipeNameInput and UserInputService:GetFocusedTextBox() ~= controller._motionRecipeNameInput then
				controller._motionRecipeNameInput.Text = recipeName
			end
			controller:_renderMotionRecipeEntries(controller._lastViewModel or viewModel)
			controller:_setShortcutHint("Selected Motion Builder recipe '" .. recipeName .. "'.")
		end)
	end

	local hasSelection = selectedName ~= ""
	local selectionFill = hasSelection and Constants.THEME.Accent or Constants.THEME.PanelSoft
	local selectionText = hasSelection and Constants.THEME.Text or Constants.THEME.MutedText
	if controller._motionRecipeLoadButton then
		controller._motionRecipeLoadButton.BackgroundColor3 = selectionFill
		controller._motionRecipeLoadButton.TextColor3 = selectionText
	end
	if controller._motionRecipeRenameButton then
		controller._motionRecipeRenameButton.BackgroundColor3 = hasSelection and Constants.THEME.PanelSoft or Constants.THEME.PanelAlt
		controller._motionRecipeRenameButton.TextColor3 = selectionText
	end
	if controller._motionRecipeDeleteButton then
		controller._motionRecipeDeleteButton.BackgroundColor3 = hasSelection and Constants.THEME.Danger or Constants.THEME.PanelAlt
		controller._motionRecipeDeleteButton.TextColor3 = hasSelection and Constants.THEME.Text or Constants.THEME.MutedText
	end

	return true
end

return WidgetMotionRecipeSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX276">
        <Properties>
          <string name="Name">WidgetOverlayStateSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local WidgetOverlayStateSupport = {}

function WidgetOverlayStateSupport.showAlert(controller, title, message)
	if not controller._alertOverlay then
		return false
	end

	controller._alertTitle.Text = title or "Notice"
	controller._alertMessage.Text = message or ""
	controller._alertOverlay.Visible = true
	return true
end

function WidgetOverlayStateSupport.hideAlert(controller)
	if controller._alertOverlay then
		controller._alertOverlay.Visible = false
	end
end

function WidgetOverlayStateSupport.showRepeatFramesOverlay(controller, defaults)
	if not controller._repeatFramesOverlay then
		return false
	end

	defaults = defaults or {}
	controller._repeatFramesToEnd = false
	if controller._repeatFramesLoopCountInput then
		controller._repeatFramesLoopCountInput.Text = tostring(defaults.loopCount or "1")
	end
	if controller._repeatFramesLengthInput then
		controller._repeatFramesLengthInput.Text = tostring(defaults.length or "0:30")
	end
	if controller._repeatFramesEndTimeInput then
		controller._repeatFramesEndTimeInput.Text = tostring(defaults.endTime or defaults.toEndTime or "")
	end
	if controller._repeatFramesToEndButton then
		controller._repeatFramesToEndButton.Text = "To End"
		controller._repeatFramesToEndButton.BackgroundColor3 = Constants.THEME.PanelSoft
	end
	if controller._repeatFramesStatusLabel then
		local selectedCount = tonumber(defaults.selectedCount) or 0
		controller._repeatFramesStatusLabel.Text = selectedCount &gt; 0
			and string.format("%d selected key%s", selectedCount, selectedCount == 1 and "" or "s")
			or "Select keyframes first"
	end
	controller._repeatFramesOverlay.Visible = true
	return true
end

function WidgetOverlayStateSupport.hideRepeatFramesOverlay(controller)
	if controller._repeatFramesOverlay then
		controller._repeatFramesOverlay.Visible = false
	end
end

function WidgetOverlayStateSupport.getRepeatFramesOptions(controller)
	return {
		loopCount = controller._repeatFramesLoopCountInput and controller._repeatFramesLoopCountInput.Text or "",
		length = controller._repeatFramesLengthInput and controller._repeatFramesLengthInput.Text or "",
		endTime = controller._repeatFramesEndTimeInput and controller._repeatFramesEndTimeInput.Text or "",
		toEnd = controller._repeatFramesToEnd == true,
	}
end

function WidgetOverlayStateSupport.showWiggleFramesOverlay(controller)
	if not controller._wiggleFramesOverlay then
		return false, "Wiggle settings are not available in this build."
	end
	controller._wiggleFramesEasingStyle = controller._wiggleFramesEasingStyle or "Linear"
	controller._wiggleFramesEasingDirection = controller._wiggleFramesEasingDirection or Constants.DEFAULT_EASING_DIRECTION
	if controller._wiggleFramesAngleXInput then
		controller._wiggleFramesAngleXInput.Text = controller._wiggleFramesAngleXInput.Text ~= "" and controller._wiggleFramesAngleXInput.Text or "2"
	end
	if controller._wiggleFramesAngleYInput then
		controller._wiggleFramesAngleYInput.Text = controller._wiggleFramesAngleYInput.Text ~= "" and controller._wiggleFramesAngleYInput.Text or "2"
	end
	if controller._wiggleFramesAngleZInput then
		controller._wiggleFramesAngleZInput.Text = controller._wiggleFramesAngleZInput.Text ~= "" and controller._wiggleFramesAngleZInput.Text or "2"
	end
	if controller._wiggleFramesPosXInput then
		controller._wiggleFramesPosXInput.Text = controller._wiggleFramesPosXInput.Text ~= "" and controller._wiggleFramesPosXInput.Text or "0"
	end
	if controller._wiggleFramesPosYInput then
		controller._wiggleFramesPosYInput.Text = controller._wiggleFramesPosYInput.Text ~= "" and controller._wiggleFramesPosYInput.Text or "0"
	end
	if controller._wiggleFramesPosZInput then
		controller._wiggleFramesPosZInput.Text = controller._wiggleFramesPosZInput.Text ~= "" and controller._wiggleFramesPosZInput.Text or "0"
	end
	if controller._wiggleFramesIntervalInput then
		controller._wiggleFramesIntervalInput.Text = controller._wiggleFramesIntervalInput.Text ~= "" and controller._wiggleFramesIntervalInput.Text or "0:02"
	end
	if controller._wiggleFramesEasingStyleButton then
		controller._wiggleFramesEasingStyleButton.Text = controller._wiggleFramesEasingStyle .. " v"
	end
	if controller._wiggleFramesEasingDirectionButton then
		controller._wiggleFramesEasingDirectionButton.Text = controller._wiggleFramesEasingDirection .. " v"
	end
	if controller._wiggleFramesStatusLabel then
		local selectedCount = controller._lastViewModel and #(controller._lastViewModel.selectedKeys or {}) or 0
		controller._wiggleFramesStatusLabel.Text = selectedCount &gt; 0
			and string.format("%d selected keyframe%s.", selectedCount, selectedCount == 1 and "" or "s")
			or "Select keyframes first."
	end
	controller._wiggleFramesOverlay.Visible = true
	return true
end

function WidgetOverlayStateSupport.hideWiggleFramesOverlay(controller)
	if controller._wiggleFramesOverlay then
		controller._wiggleFramesOverlay.Visible = false
	end
	if controller._wiggleFramesEasingStyleDropdown then
		controller._wiggleFramesEasingStyleDropdown.Visible = false
	end
	if controller._wiggleFramesEasingDirectionDropdown then
		controller._wiggleFramesEasingDirectionDropdown.Visible = false
	end
end

return WidgetOverlayStateSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX277">
        <Properties>
          <string name="Name">WidgetPresetPreviewSupport</string>
          <ProtectedString name="Source">local WidgetPresetPreviewSupport = {}

local function getImportButtonText(controller)
	local pickerMotion = tostring(controller._motionDefaultPickerMotion or "")
	if pickerMotion ~= "" then
		return "Use as " .. pickerMotion
	end
	if tostring(controller._motionSegmentPickerKey or ""):sub(1, 15) == "__pause_idle__:" then
		return "Use as Idle"
	end
	if tostring(controller._motionSegmentPickerKey or "") ~= "" then
		return "Use as Style"
	end
	return "Import"
end

local function buildMetaText(entry)
	local metaParts = {}
	if entry.pack then
		table.insert(metaParts, tostring(entry.pack))
	end
	if entry.rigType then
		table.insert(metaParts, tostring(entry.rigType))
	end
	if entry.category then
		table.insert(metaParts, tostring(entry.category))
	end
	if entry.creatorName then
		table.insert(metaParts, tostring(entry.creatorName))
	end
	if entry.priceLabel then
		table.insert(metaParts, tostring(entry.priceLabel))
	end
	return #metaParts &gt; 0 and table.concat(metaParts, "  |  ") or "Preview"
end

function WidgetPresetPreviewSupport.showPresetPreview(controller, entry)
	if not controller._presetPreviewOverlay or not entry then
		return false
	end

	controller._presetPreviewEntry = entry
	controller._presetPreviewTitle.Text = tostring(entry.name or ("Animation #" .. tostring(entry.id or "")))
	if controller._presetPreviewImportButton then
		controller._presetPreviewImportButton.Text = getImportButtonText(controller)
	end
	controller._presetPreviewMeta.Text = buildMetaText(entry)
	controller._presetPreviewFallback.Image = string.format(
		"rbxthumb://type=Asset&amp;id=%s&amp;w=420&amp;h=420",
		tostring(entry.numericId or entry.id or 0)
	)
	controller._presetPreviewOverlay.Visible = true
	controller:_populatePresetPreview(controller._presetPreviewViewport, controller._presetPreviewFallback, entry, {
		autoPlay = true,
	})
	controller:_setShortcutHint("Preset preview open: inspect animation or close")
	return true
end

function WidgetPresetPreviewSupport.hidePresetPreview(controller)
	if controller._presetPreviewOverlay then
		controller._presetPreviewOverlay.Visible = false
	end
	if controller._presetPreviewViewport then
		controller:_setPresetPreviewPlaying(controller._presetPreviewViewport, false)
	end
	controller._presetPreviewEntry = nil
end

return WidgetPresetPreviewSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX278">
        <Properties>
          <string name="Name">WidgetRigPropertyEditorSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local TrackEasingOptionsSupport = require(script.Parent:WaitForChild("TrackEasingOptionsSupport"))
local WidgetVisualSupport = require(script.Parent:WaitForChild("WidgetVisualSupport"))

local WidgetRigPropertyEditorSupport = {}

local function makeTrackKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

local function getSelectedGroupIds(viewModel)
	local selectedGroupIds = {}
	local seen = {}
	local function addGroupId(groupId)
		if groupId ~= nil and not seen[groupId] then
			seen[groupId] = true
			table.insert(selectedGroupIds, groupId)
		end
	end

	for _, groupId in ipairs(viewModel.selectedGroupIds or {}) do
		addGroupId(groupId)
	end
	if #selectedGroupIds &gt; 0 then
		table.sort(selectedGroupIds, function(a, b)
			return tostring(a) &lt; tostring(b)
		end)
		return selectedGroupIds
	end

	local selectedKeyIds = {}
	for _, key in ipairs(viewModel.selectedKeys or {}) do
		local jointPath = key.jointPath or key.path
		if jointPath ~= nil and key.frame ~= nil then
			selectedKeyIds[makeTrackKeyId(jointPath, key.frame)] = true
		end
	end
	if next(selectedKeyIds) == nil then
		return selectedGroupIds
	end

	for groupId, group in pairs(viewModel.groups or {}) do
		for keyId in pairs((group and group.keys) or {}) do
			if selectedKeyIds[keyId] then
				addGroupId(groupId)
				break
			end
		end
	end
	table.sort(selectedGroupIds, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)
	return selectedGroupIds
end

local EVENT_EDITOR_CARD_SIZE = UDim2.new(0, 620, 0, 620)
local EVENT_EDITOR_OPTIONS_SIZE = UDim2.new(1, -36, 1, -198)

local function applyRigPropertyEditorLayout(controller, isEventEditor)
	local optionsList = controller._rigPropertyOptionsList
	local optionsFrame = optionsList and optionsList.Parent
	local editorCard = optionsFrame and optionsFrame.Parent
	if not editorCard or not editorCard:IsA("GuiObject") or not optionsFrame or not optionsFrame:IsA("GuiObject") then
		return
	end

	local defaults = controller._rigPropertyEditorDefaultLayout
	if not defaults or defaults.editorCard ~= editorCard or defaults.optionsFrame ~= optionsFrame then
		defaults = {
			editorCard = editorCard,
			editorCardAnchorPoint = editorCard.AnchorPoint,
			editorCardPosition = editorCard.Position,
			editorCardSize = editorCard.Size,
			optionsFrame = optionsFrame,
			optionsFramePosition = optionsFrame.Position,
			optionsFrameSize = optionsFrame.Size,
		}
		controller._rigPropertyEditorDefaultLayout = defaults
	end

	if isEventEditor then
		editorCard.AnchorPoint = Vector2.new(0.5, 0.5)
		editorCard.Position = UDim2.fromScale(0.5, 0.5)
		editorCard.Size = EVENT_EDITOR_CARD_SIZE
		optionsFrame.Position = UDim2.new(0, 18, 0, 120)
		optionsFrame.Size = EVENT_EDITOR_OPTIONS_SIZE
		return
	end

	editorCard.AnchorPoint = defaults.editorCardAnchorPoint
	editorCard.Position = defaults.editorCardPosition
	editorCard.Size = defaults.editorCardSize
	optionsFrame.Position = defaults.optionsFramePosition
	optionsFrame.Size = defaults.optionsFrameSize
end

local function isRigEditorTrack(track)
	if not track then
		return false
	end
	if track.trackType == "Rig Group" or track.trackType == "Rig Property" then
		return true
	end
	if track.targetScope == "RigProperty" then
		return true
	end
	if track.isMicroVirtualTrack and (track.virtualKind == "RigHeader" or track.virtualKind == "Properties") then
		return true
	end
	return false
end

function WidgetRigPropertyEditorSupport.renderRigPropertyEditor(controller, viewModel, deps)
	if not controller._rigPropertyOptionsList then
		return false
	end

	viewModel = viewModel or controller._lastViewModel or {}
	local create = deps.create
	local createCorner = deps.createCorner
	local callbacks = deps.callbacks or controller._callbacks or {}
	local rigName = controller._activeRigPropertyMenuRigName
	local rigPropertyTrackState = viewModel.rigPropertyTrackState or {}
	local objectPropertyTrackState = viewModel.objectPropertyTrackState or {}
	local selectedTrack = nil
	local parentTrack = nil
	if controller._activeRigPropertyTrackPath and viewModel.tracks then
		for _, track in ipairs(viewModel.tracks) do
			if track.path == controller._activeRigPropertyTrackPath then
				selectedTrack = track
			end
			if selectedTrack and (not selectedTrack.parentTrackPath or parentTrack) then
				break
			end
		end
		if selectedTrack and selectedTrack.parentTrackPath then
			for _, track in ipairs(viewModel.tracks) do
				if track.path == selectedTrack.parentTrackPath then
					parentTrack = track
					break
				end
			end
		end
	end

	local selectedTrackType = selectedTrack and selectedTrack.trackType or "Rig"
	local usesPropertyParent = selectedTrack
		and selectedTrack.parentTrackPath
		and (
			selectedTrack.targetScope == "ObjectProperty"
			or selectedTrack.targetScope == "EmitterGroupProperty"
			or selectedTrack.trackType == "Object Property"
			or selectedTrack.trackType == "Emitter Group Property"
			or selectedTrack.trackType == "Particle Event"
	)
	local selectedTrackPath = selectedTrack and (usesPropertyParent and selectedTrack.parentTrackPath or selectedTrack.path) or controller._activeRigPropertyTrackPath
	local editorTrack = usesPropertyParent and (parentTrack or selectedTrack) or selectedTrack
	local isRigEditor = isRigEditorTrack(selectedTrack)
	local isParticleEmitterEditor = (not isRigEditor) and WidgetVisualSupport.isParticleEmitterTrack(editorTrack)
	local isEventEditor = selectedTrack and (selectedTrack.trackType == "Event" or selectedTrack.valueType == "Event")
	local propertyState = isRigEditor and (rigName and rigPropertyTrackState[rigName]) or (selectedTrackPath and objectPropertyTrackState[selectedTrackPath])
	applyRigPropertyEditorLayout(controller, isEventEditor == true)

	if controller._rigPropertyEditorItemLabel then
		controller._rigPropertyEditorItemLabel.Text = "Item: " .. tostring((editorTrack and editorTrack.name) or rigName or (selectedTrack and selectedTrack.name) or "Track")
	end
	if controller._rigPropertyEditorTypeLabel then
		local particleTypeLabel = selectedTrackType == "Emitter Group" and "Emitter Group" or "ParticleEmitter"
		controller._rigPropertyEditorTypeLabel.Text = "Type: " .. tostring(isRigEditor and "Rig" or (isParticleEmitterEditor and particleTypeLabel or (selectedTrackType ~= "" and selectedTrackType or "Track")))
	end
	if controller._rigPropertyDeleteButton then
		controller._rigPropertyDeleteButton.Text = selectedTrack and "Delete" or "Delete"
	end

	for _, child in ipairs(controller._rigPropertyOptionsList:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	local function createSectionLabel(text, color)
		return create("TextLabel", {
			Parent = controller._rigPropertyOptionsList,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 18),
			Font = Enum.Font.GothamSemibold,
			Text = text,
			TextColor3 = color or Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 111,
		})
	end

	local function createInput(name, placeholder, text, height, multiline)
		local input = create("TextBox", {
			Name = name,
			Parent = controller._rigPropertyOptionsList,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = multiline == true and Enum.Font.Code or Enum.Font.Gotham,
			PlaceholderText = placeholder,
			Text = text or "",
			TextColor3 = Constants.THEME.Text,
			PlaceholderColor3 = Constants.THEME.MutedText,
			TextSize = multiline == true and 13 or 12,
			TextWrapped = true,
			MultiLine = multiline == true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, -8, 0, height or 30),
			ZIndex = 111,
		})
		createCorner(input, 7)
		create("UIPadding", {
			Parent = input,
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 7),
			PaddingBottom = UDim.new(0, 6),
		})
		return input
	end

	local function createActionButton(text, callback)
		local actionButton = create("TextButton", {
			Parent = controller._rigPropertyOptionsList,
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.Accent,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			Text = text,
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			Size = UDim2.new(1, -8, 0, 30),
			ZIndex = 111,
		})
		createCorner(actionButton, 8)
		controller:_connect(actionButton.Activated, callback)
		return actionButton
	end

	local function createHelpText(text, height)
		return create("TextLabel", {
			Parent = controller._rigPropertyOptionsList,
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = text,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, -8, 0, height or 34),
			ZIndex = 111,
		})
	end

	local selectedKeyCount = #(viewModel.selectedKeys or {})
	local selectedGroupIds = getSelectedGroupIds(viewModel)
	local selectedGroupCount = #selectedGroupIds
	local hasSelectedPhysicsGroup = false
	for _, groupId in ipairs(selectedGroupIds) do
		local group = (viewModel.groups or {})[groupId] or (viewModel.groups or {})[tostring(groupId)]
		if group and group.kind == "PhysicsClip" then
			hasSelectedPhysicsGroup = true
			break
		end
	end
	if selectedKeyCount &gt; 1 or selectedGroupCount &gt; 0 then
		createSectionLabel("Selected Keyframes", Constants.THEME.Accent)
		if hasSelectedPhysicsGroup and callbacks.onCopyKeys then
			createActionButton("Copy Exact Physics Clip", function()
				callbacks.onCopyKeys()
			end)
		end
		if hasSelectedPhysicsGroup and callbacks.onPasteKeys then
			createActionButton("Paste Physics Clip at Playhead", function()
				callbacks.onPasteKeys()
				if type(deps.rerender) == "function" then
					task.defer(deps.rerender)
				end
			end)
		end
		if hasSelectedPhysicsGroup and callbacks.onPastePhysicsClipToSelectedRigs then
			createActionButton("Paste to Selected Rigs (New Track)", function()
				callbacks.onPastePhysicsClipToSelectedRigs()
				if type(deps.rerender) == "function" then
					task.defer(deps.rerender)
				end
			end)
		end
		if selectedGroupCount &gt; 0 and callbacks.onUngroupKeys then
			createActionButton("Ungroup Selected Keys", function()
				callbacks.onUngroupKeys()
				if type(deps.rerender) == "function" then
					task.defer(deps.rerender)
				end
			end)
		end
		if selectedKeyCount &gt; 1 and callbacks.onGroupKeys then
			createActionButton(selectedGroupCount &gt; 0 and "Regroup Selected Keys" or "Group Selected Keys", function()
				callbacks.onGroupKeys()
				if type(deps.rerender) == "function" then
					task.defer(deps.rerender)
				end
			end)
		end
		if selectedGroupCount &gt; 0 and callbacks.onSetSelectedGroupEditMode then
			createActionButton("Stretch Group Block", function()
				callbacks.onSetSelectedGroupEditMode("Stretch", selectedGroupIds)
				if type(deps.rerender) == "function" then
					task.defer(deps.rerender)
				end
			end)
			createActionButton("Repeat Group Block", function()
				callbacks.onSetSelectedGroupEditMode("Repeat", selectedGroupIds)
				if type(deps.rerender) == "function" then
					task.defer(deps.rerender)
				end
			end)
		end
	end

	if isEventEditor then
		local eventName = selectedTrack.eventName or selectedTrack.name or "Event"
		local eventPayload = ""
		local eventCodeBegin = ""
		local eventCodeEnd = ""
		local eventDurationSeconds = ""
		for _, key in ipairs(viewModel.selectedKeyValues or {}) do
			if key.jointPath == selectedTrack.path then
				if type(key.value) == "table" then
					eventName = key.value.name or key.value.eventName or key.value.action or eventName
					eventPayload = key.value.payload ~= nil and tostring(key.value.payload) or eventPayload
					eventCodeBegin = key.value.codeBegin ~= nil and tostring(key.value.codeBegin) or eventCodeBegin
					eventCodeEnd = key.value.codeEnd ~= nil and tostring(key.value.codeEnd) or eventCodeEnd
					if tonumber(key.value.durationFrames) then
						local fps = math.max(1, tonumber(viewModel.fps) or 30)
						eventDurationSeconds = string.format("%.2f", math.max(0, tonumber(key.value.durationFrames) or 0) / fps)
					end
				elseif key.value ~= nil then
					eventPayload = tostring(key.value)
				end
				break
			end
		end

		createSectionLabel("Event Keyframe", Constants.THEME.Accent)
		local nameInput = createInput("EventNameInput", "Event name, e.g. DoorOpen", eventName, 34)
		local payloadInput = createInput("EventPayloadInput", "Marker payload/value sent to scripts", eventPayload, 46)
		createHelpText("Payload is exported as marker data. Use the code below only for Studio preview during event timing.", 42)
		local codeBeginInput = createInput("EventCodeBeginInput", "Begin code - runs when playback reaches this event", eventCodeBegin, 132, true)
		local codeEndInput = createInput("EventCodeEndInput", "End code - runs after Duration, if set", eventCodeEnd, 132, true)
		local durationInput = createInput("EventDurationInput", "Duration in seconds for End code, e.g. 0.25", eventDurationSeconds, 34)
		createActionButton("Apply Event", function()
			if callbacks.onSetEventKeyframeValue then
				callbacks.onSetEventKeyframeValue(selectedTrack.path, nameInput.Text, payloadInput.Text, {
					codeBegin = codeBeginInput.Text,
					codeEnd = codeEndInput.Text,
					durationSeconds = tonumber(durationInput.Text),
				})
			end
		end)
	end

	create("TextLabel", {
		Parent = controller._rigPropertyOptionsList,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Animation Events",
		TextColor3 = Constants.THEME.Accent,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 111,
	})

	TrackEasingOptionsSupport.renderListSection(controller, viewModel, controller._rigPropertyOptionsList, {
		create = create,
		createCorner = createCorner,
		callbacks = deps.callbacks,
		rerender = deps.rerender,
	})

	if isEventEditor then
		return true
	end

	create("TextLabel", {
		Parent = controller._rigPropertyOptionsList,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Properties",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 111,
	})

	local propertyOptions = WidgetVisualSupport.getPropertyOptionsForTrack(editorTrack or selectedTrack, isRigEditor)
	for _, propertyName in ipairs(propertyOptions) do
		local isEnabled = propertyState and propertyState[propertyName] == true
		local propertyAllowed = WidgetVisualSupport.isPropertyAllowedForTrack(editorTrack or selectedTrack, propertyName, isRigEditor)
		if not propertyAllowed then
			continue
		end

		local propertyLabel = WidgetVisualSupport.getPropertyLabel(propertyName)
		local optionButton = create("TextButton", {
			Parent = controller._rigPropertyOptionsList,
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -8, 0, 26),
			Font = Enum.Font.Gotham,
			Text = string.format("%s %s", isEnabled and "[x]" or "[ ]", propertyLabel),
			TextColor3 = propertyAllowed and (isEnabled and Constants.THEME.Accent or Constants.THEME.Text) or Constants.THEME.MutedText,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 111,
		})
		createCorner(optionButton, 7)
		optionButton.AutoButtonColor = propertyAllowed
		optionButton.BackgroundTransparency = propertyAllowed and 0 or 0.35
		create("UIPadding", {
			Parent = optionButton,
			PaddingLeft = UDim.new(0, 10),
		})
		controller:_connect(optionButton.Activated, function()
			if not propertyAllowed then
				return
			end
			if isRigEditor and callbacks.onToggleRigPropertyTrack and rigName then
				callbacks.onToggleRigPropertyTrack(rigName, propertyName, not isEnabled)
			elseif callbacks.onTogglePropertyTrack and selectedTrackPath then
				callbacks.onTogglePropertyTrack(selectedTrackPath, propertyName, not isEnabled)
			end
		end)
	end

	return true
end

return WidgetRigPropertyEditorSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX279">
        <Properties>
          <string name="Name">WidgetTooltipSupport</string>
          <ProtectedString name="Source">local TextService = game:GetService("TextService")

local WidgetTooltipSupport = {}

local function measureLabelText(label, text)
	if not label then
		return 0
	end
	local ok, size = pcall(function()
		return TextService:GetTextSize(
			tostring(text or ""),
			tonumber(label.TextSize) or 12,
			label.Font,
			Vector2.new(10000, math.max(18, label.AbsoluteSize.Y))
		)
	end)
	return ok and size and size.X or 0
end

function WidgetTooltipSupport.showTrackNameTooltip(args)
	local rowGui = args.rowGui
	local tooltip = args.tooltip
	if not rowGui or not rowGui.Parent or not tooltip then
		return false
	end

	local parent = tooltip.Parent
	if not parent then
		return false
	end

	local title = tostring(args.title or "Track")
	local detail = tostring(args.detail or "")
	if args.tooltipTitle then
		args.tooltipTitle.Text = title
	end
	if args.tooltipDetail then
		args.tooltipDetail.Text = detail
	end

	local parentAbs = parent.AbsolutePosition
	local parentSize = parent.AbsoluteSize
	local measuredTitleWidth = measureLabelText(args.tooltipTitle, title)
	local measuredDetailWidth = measureLabelText(args.tooltipDetail, detail)
	local maxAvailableWidth = math.max(260, parentSize.X - 16)
	local tooltipWidth = math.clamp(math.max(260, measuredTitleWidth + 36, measuredDetailWidth + 36), 260, math.min(520, maxAvailableWidth))
	local tooltipHeight = math.max(48, tooltip.AbsoluteSize.Y &gt; 0 and tooltip.AbsoluteSize.Y or 54)
	tooltip.Size = UDim2.fromOffset(tooltipWidth, tooltipHeight)
	local cursorPoint = args.cursorPoint

	if not cursorPoint then
		local mouseLocation = args.userInputService:GetMouseLocation()
		if mouseLocation then
			cursorPoint = Vector2.new(mouseLocation.X, mouseLocation.Y)
		end
	end

	local x
	local y
	if cursorPoint then
		x = cursorPoint.X - parentAbs.X + 12
		y = cursorPoint.Y - parentAbs.Y + 14
	else
		local rowAbs = rowGui.AbsolutePosition
		x = rowAbs.X - parentAbs.X + 12
		y = rowAbs.Y - parentAbs.Y + 12
	end

	if x + tooltipWidth &gt; parentSize.X - 8 then
		x = math.max(8, x - tooltipWidth - 24)
	end
	if y + tooltipHeight &gt; parentSize.Y - 8 then
		y = math.max(8, y - tooltipHeight - 18)
	end
	x = math.clamp(x, 8, math.max(8, parentSize.X - tooltipWidth - 8))
	y = math.clamp(y, 8, math.max(8, parentSize.Y - tooltipHeight - 8))
	tooltip.Position = UDim2.fromOffset(x, y)
	tooltip.Visible = true
	return true
end

return WidgetTooltipSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX280">
        <Properties>
          <string name="Name">WidgetTrackIndicatorSupport</string>
          <ProtectedString name="Source">local WidgetTrackIndicatorSupport = {}

function WidgetTrackIndicatorSupport.createTrackTypeIndicator(args)
	local iconImage = args.widgetVisualSupport.getTrackIconImage(args.trackData)
	local x = math.max(8, (args.nameIndent or 24) - 16)
	if iconImage then
		return {
			icon = args.uiHelpers.create("ImageLabel", {
				Parent = args.parent,
				AnchorPoint = Vector2.new(0, 0.5),
				BackgroundTransparency = 1,
				Image = iconImage,
				ImageColor3 = args.baselineColor,
				ImageTransparency = args.isTrackDisabled and 0.45 or 0,
				Position = UDim2.new(0, x - 2, 0.5, 0),
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.new(0, 14, 0, 14),
				ZIndex = 5,
			}),
		}
	end

	local dot = args.uiHelpers.create("Frame", {
		Parent = args.parent,
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = args.baselineColor,
		BorderSizePixel = 0,
		Position = UDim2.new(0, x, 0.5, 0),
		Size = UDim2.new(0, 8, 0, 8),
		ZIndex = 5,
	})
	args.uiHelpers.createCorner(dot, 99)
	return {
		dot = dot,
	}
end

return WidgetTrackIndicatorSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX281">
        <Properties>
          <string name="Name">WidgetVisualSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local ParticleEmitterPropertyService = require(script.Parent:WaitForChild("ParticleEmitterPropertyService"))
local ParticleEmitterGroupService = require(script.Parent:WaitForChild("ParticleEmitterGroupService"))
local PropertyKeyframeValueService = require(script.Parent:WaitForChild("PropertyKeyframeValueService"))
local TrackColorService = require(script.Parent:WaitForChild("TrackColorService"))
local TrackIconService = require(script.Parent:WaitForChild("TrackIconService"))

local WidgetVisualSupport = {}

WidgetVisualSupport.RIG_PROPERTY_OPTIONS = {
	"CFrame",
	"Scale",
	"Transparency",
	"Color",
	"Reflectance",
}

WidgetVisualSupport.DECAL_PROPERTY_OPTIONS = {
	"Transparency",
	"Color3",
	"Texture",
	"Face",
}

WidgetVisualSupport.LIGHT_PROPERTY_OPTIONS = {
	"Enabled",
	"Brightness",
	"Range",
	"Color",
	"Shadows",
	"Angle",
	"Face",
}

WidgetVisualSupport.TEXT_GUI_PROPERTY_OPTIONS = {
	"Text",
	"MaxVisibleGraphemes",
	"TextColor3",
	"TextTransparency",
	"TextSize",
	"TextStrokeColor3",
	"TextStrokeTransparency",
	"BackgroundColor3",
	"BackgroundTransparency",
	"Visible",
}

WidgetVisualSupport.PARTICLE_EMITTER_PROPERTY_OPTIONS = ParticleEmitterPropertyService.PROPERTY_OPTIONS

function WidgetVisualSupport.isParticleEmitterTrack(track)
	return track ~= nil
		and (
			(track.instance ~= nil and track.instance.Parent ~= nil and track.instance:IsA("ParticleEmitter"))
			or ParticleEmitterGroupService.isEmitterGroupLikeTrack(track)
		)
end

function WidgetVisualSupport.isDecalTrack(track)
	local instance = track and track.instance
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("Decal") or instance:IsA("Texture"))
end

function WidgetVisualSupport.isLightTrack(track)
	local instance = track and track.instance
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("PointLight") or instance:IsA("SpotLight") or instance:IsA("SurfaceLight"))
end

function WidgetVisualSupport.isPostEffectTrack(track)
	local instance = track and track.instance
	return PropertyKeyframeValueService.isPostEffectInstance(instance)
end

function WidgetVisualSupport.isTextGuiTrack(track)
	local instance = track and track.instance
	return PropertyKeyframeValueService.isTextGuiInstance(instance)
end

function WidgetVisualSupport.getPropertyOptionsForTrack(track, isRigEditor)
	if not isRigEditor and WidgetVisualSupport.isParticleEmitterTrack(track) then
		return WidgetVisualSupport.PARTICLE_EMITTER_PROPERTY_OPTIONS
	end
	if not isRigEditor and WidgetVisualSupport.isDecalTrack(track) then
		return WidgetVisualSupport.DECAL_PROPERTY_OPTIONS
	end
	if not isRigEditor and WidgetVisualSupport.isLightTrack(track) then
		return WidgetVisualSupport.LIGHT_PROPERTY_OPTIONS
	end
	if not isRigEditor and WidgetVisualSupport.isPostEffectTrack(track) then
		return PropertyKeyframeValueService.getPostEffectPropertyOptions(track.instance) or {}
	end
	if not isRigEditor and WidgetVisualSupport.isTextGuiTrack(track) then
		return WidgetVisualSupport.TEXT_GUI_PROPERTY_OPTIONS
	end
	return WidgetVisualSupport.RIG_PROPERTY_OPTIONS
end

function WidgetVisualSupport.getPropertyLabel(propertyName)
	return ParticleEmitterPropertyService.getDisplayLabel(propertyName)
end

function WidgetVisualSupport.isPropertyAllowedForTrack(track, propertyName, isRigEditor)
	if not isRigEditor and WidgetVisualSupport.isParticleEmitterTrack(track) then
		return ParticleEmitterPropertyService.isTrackableProperty(propertyName)
			or ParticleEmitterPropertyService.isOneShotAction(propertyName)
	end
	return PropertyKeyframeValueService.isPropertyAllowedForTrack(track, propertyName, isRigEditor)
end

function WidgetVisualSupport.getEasingStyleColor(easingStyle)
	return TrackColorService.getEasingTint(easingStyle)
end

local function normalizeEasingName(value, fallback)
	if typeof(value) == "EnumItem" then
		return value.Name
	end
	if value == nil or value == "" then
		return fallback
	end
	return tostring(value)
end

function WidgetVisualSupport.getEasingHighlightColor(easingStyle)
	local styleName = normalizeEasingName(easingStyle, Constants.DEFAULT_EASING_STYLE)
	if styleName == "" or styleName == Constants.DEFAULT_EASING_STYLE then
		return nil
	end
	return WidgetVisualSupport.getEasingStyleColor(styleName)
end

function WidgetVisualSupport.getEasingTooltip(easingStyle, easingDirection)
	return string.format(
		"Style: %s | Direction: %s",
		normalizeEasingName(easingStyle, Constants.DEFAULT_EASING_STYLE),
		normalizeEasingName(easingDirection, Constants.DEFAULT_EASING_DIRECTION)
	)
end

function WidgetVisualSupport.getTrackKeyframeColor(trackData, easingStyle)
	return TrackColorService.getTrackColor(trackData, easingStyle)
end

function WidgetVisualSupport.getTrackIconImage(trackData)
	return TrackIconService.getIconImage(trackData)
end

function WidgetVisualSupport.getTrackRowColors(trackData, isSelected, isTrackDisabled, folderAccentColor)
	trackData = trackData or {}
	local trackType = trackData.trackType or "Rig"
	local keyColor = WidgetVisualSupport.getTrackKeyframeColor(trackData, Constants.DEFAULT_EASING_STYLE)
	local propertyTrackBaseColor = Color3.fromRGB(43, 57, 76)
	local propertyTrackSelectedColor = Color3.fromRGB(74, 103, 146)
	local propertyTrackLaneColor = Color3.fromRGB(25, 35, 49)
	local propertyTrackBaselineColor = Color3.fromRGB(96, 183, 224)
	local cameraPropertyBaseColor = Color3.fromRGB(48, 63, 88)
	local cameraPropertySelectedColor = Color3.fromRGB(92, 126, 182)
	local cameraPropertyLaneColor = Color3.fromRGB(29, 40, 57)
	local cameraPropertyBaselineColor = Color3.fromRGB(135, 196, 255)
	local effectTrackBaseColor = Color3.fromRGB(72, 39, 54)
	local effectTrackSelectedColor = Color3.fromRGB(119, 57, 82)
	local effectTrackLaneColor = Color3.fromRGB(37, 25, 34)
	local effectTrackBaselineColor = Color3.fromRGB(255, 118, 132)
	local folderColor = folderAccentColor or Constants.THEME.Accent

	local trackCardColor = isTrackDisabled and Color3.fromRGB(31, 33, 40)
		or ((trackType == "Rig Property")
			and (isSelected and propertyTrackSelectedColor or propertyTrackBaseColor)
			or ((trackType == "Camera Property")
				and (isSelected and cameraPropertySelectedColor or cameraPropertyBaseColor)
			or ((trackType == "Screen Effect")
				and (isSelected and effectTrackSelectedColor or effectTrackBaseColor)
			or ((trackType == "Folder")
				and (isSelected and folderColor:Lerp(Constants.THEME.Panel, 0.25) or folderColor:Lerp(Constants.THEME.Panel, 0.75))
			or (isSelected and Constants.THEME.AccentSoft or Constants.THEME.Panel))
		)))
	local laneColor = isTrackDisabled and Color3.fromRGB(20, 23, 30)
		or ((trackType == "Rig Property")
			and (isSelected and Color3.fromRGB(36, 48, 66) or propertyTrackLaneColor)
			or ((trackType == "Camera Property")
				and (isSelected and Color3.fromRGB(42, 57, 82) or cameraPropertyLaneColor)
			or ((trackType == "Screen Effect")
				and (isSelected and Color3.fromRGB(54, 34, 46) or effectTrackLaneColor)
			or ((trackType == "Folder")
				and (isSelected and folderColor:Lerp(Constants.THEME.Panel, 0.68) or folderColor:Lerp(Constants.THEME.Panel, 0.86))
			or (isSelected and Color3.fromRGB(34, 42, 58) or Constants.THEME.Panel))
		)))
	local baselineColor = isTrackDisabled and Constants.THEME.Border
		or ((trackType == "Rig Property")
			and (isSelected and Color3.fromRGB(122, 210, 247) or propertyTrackBaselineColor)
			or ((trackType == "Camera Property")
				and (isSelected and Color3.fromRGB(167, 220, 255) or cameraPropertyBaselineColor)
			or ((trackType == "Screen Effect")
				and (isSelected and Color3.fromRGB(255, 154, 169) or effectTrackBaselineColor)
			or ((trackType == "Folder")
				and folderColor
			or (isSelected and keyColor:Lerp(Constants.THEME.Text, 0.18) or keyColor))
		)))

	return {
		trackCard = trackCardColor,
		lane = laneColor,
		baseline = baselineColor,
	}
end

return WidgetVisualSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX282">
        <Properties>
          <string name="Name">WorkspaceGrabController</string>
          <ProtectedString name="Source">local ChangeHistoryService = game:GetService("ChangeHistoryService")
local CoreGui = game:GetService("CoreGui")
local Selection = game:GetService("Selection")

local WorkspaceGrabController = {}
WorkspaceGrabController.__index = WorkspaceGrabController

local GIZMO_FOLDER_NAME = "MegMoWorkspaceGrabGizmos"
local OWNERSHIP_MARKER_NAME = "MegMoWorkspaceGrabOwnership"
local OWNERSHIP_MARKER_OWNER = "MegMoAnimator"

local function isValidTarget(target)
	return target
		and target.Parent ~= nil
		and (target:IsA("BasePart") or target:IsA("Model"))
end

local function getLockedPart(target)
	if target:IsA("BasePart") then
		return target.Locked and target or nil
	end
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Locked then
			return descendant
		end
	end
	return nil
end

local function resolveInstanceTarget(instance)
	if not instance then
		return nil
	end
	if instance:IsA("Model") then
		return instance
	end
	local part = instance:IsA("BasePart")
		and instance
		or instance:FindFirstAncestorWhichIsA("BasePart")
	if part then
		return part:FindFirstAncestorOfClass("Model") or part
	end
	return instance:FindFirstAncestorOfClass("Model")
end

local function resolveSelectedTarget()
	for _, selected in ipairs(Selection:Get()) do
		local target = resolveInstanceTarget(selected)
		if target then
			return target
		end
	end
	return nil
end

local function collectTargetParts(target)
	if not isValidTarget(target) then
		return {}
	end
	if target:IsA("BasePart") then
		return { target }
	end
	local parts = {}
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function getTargetCFrame(target)
	if not isValidTarget(target) then
		return nil
	end
	if target:IsA("BasePart") then
		return target.CFrame
	end
	local ok, cframe = pcall(function()
		return target:GetPivot()
	end)
	return ok and cframe or nil
end

local function targetMoved(startCFrame, target)
	local finalCFrame = getTargetCFrame(target)
	if typeof(startCFrame) ~= "CFrame" or typeof(finalCFrame) ~= "CFrame" then
		return false
	end
	local delta = startCFrame:ToObjectSpace(finalCFrame)
	local _, angle = delta:ToAxisAngle()
	return delta.Position.Magnitude &gt; 0.0001 or math.abs(angle) &gt; 0.0001
end

local function isPartWithinTarget(part, target)
	if not (part and part:IsA("BasePart") and isValidTarget(target)) then
		return false
	end
	if target:IsA("BasePart") then
		return part == target
	end
	return part:IsDescendantOf(target)
end

local function beginRecording(name)
	local inProgress = false
	pcall(function()
		inProgress = ChangeHistoryService:IsRecordingInProgress()
	end)
	if inProgress then
		return nil
	end
	local ok, recording = pcall(function()
		return ChangeHistoryService:TryBeginRecording(name)
	end)
	return ok and recording or nil
end

local function finishRecording(recording)
	if not recording then
		return
	end
	pcall(function()
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end)
end

local function createDragger()
	local ok, dragger = pcall(function()
		return Instance.new("Dragger")
	end)
	return ok and dragger or nil
end

function WorkspaceGrabController.new(plugin, onChanged)
	local self = setmetatable({}, WorkspaceGrabController)
	self._plugin = plugin
	self._onChanged = onChanged
	self._target = nil
	self._active = false
	self._drag = nil
	self._targetConnection = nil
	self._connections = {}
	self._ownershipMarker = nil
	self._dragger = createDragger()
	self._mouse = plugin:GetMouse()
	self._lastMessage = ""

	self._folder = Instance.new("Folder")
	self._folder.Name = GIZMO_FOLDER_NAME
	self._folder.Archivable = false
	self._folder.Parent = CoreGui

	self._highlight = Instance.new("Highlight")
	self._highlight.Name = "WorkspaceGrabTargetHighlight"
	self._highlight.Archivable = false
	self._highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	self._highlight.FillColor = Color3.fromRGB(255, 170, 55)
	self._highlight.FillTransparency = 0.82
	self._highlight.OutlineColor = Color3.fromRGB(255, 196, 92)
	self._highlight.OutlineTransparency = 0
	self._highlight.Enabled = false
	self._highlight.Parent = self._folder

	self:_bindMouse()
	table.insert(self._connections, plugin.Deactivation:Connect(function()
		self:HandlePluginDeactivation()
	end))
	return self
end

function WorkspaceGrabController:_setViewportOwnershipActive(active)
	if active == true then
		if self._ownershipMarker and self._ownershipMarker.Parent then
			self._ownershipMarker:SetAttribute("Active", true)
			return
		end
		for _, child in ipairs(CoreGui:GetChildren()) do
			if child.Name == OWNERSHIP_MARKER_NAME
				and child:GetAttribute("Owner") == OWNERSHIP_MARKER_OWNER then
				child:Destroy()
			end
		end
		local marker = Instance.new("Folder")
		marker.Name = OWNERSHIP_MARKER_NAME
		marker.Archivable = false
		marker:SetAttribute("Active", true)
		marker:SetAttribute("Owner", OWNERSHIP_MARKER_OWNER)
		marker:SetAttribute("ProtocolVersion", 1)
		marker.Parent = CoreGui
		self._ownershipMarker = marker
		return
	end

	if self._ownershipMarker then
		self._ownershipMarker:Destroy()
		self._ownershipMarker = nil
	end
	for _, child in ipairs(CoreGui:GetChildren()) do
		if child.Name == OWNERSHIP_MARKER_NAME
			and child:GetAttribute("Owner") == OWNERSHIP_MARKER_OWNER then
			child:Destroy()
		end
	end
end

function WorkspaceGrabController:_notify(message, reason)
	self._lastMessage = tostring(message or "")
	if type(self._onChanged) == "function" then
		self._onChanged({
			active = self._active,
			message = self._lastMessage,
			reason = reason,
			target = self._target,
		})
	end
	return self._lastMessage
end

function WorkspaceGrabController:_clearTargetConnection()
	if self._targetConnection then
		self._targetConnection:Disconnect()
		self._targetConnection = nil
	end
end

function WorkspaceGrabController:_setTarget(target)
	self:_clearTargetConnection()
	self._target = isValidTarget(target) and target or nil
	self._highlight.Adornee = self._target
	self._highlight.Enabled = self._target ~= nil
	if not self._target then
		return
	end

	local watchedTarget = self._target
	self._targetConnection = watchedTarget.AncestryChanged:Connect(function()
		if self._target == watchedTarget and not isValidTarget(watchedTarget) then
			self:_setTarget(nil)
			if self._active then
				self:_notify("The grabbed object was removed. Free Grab remains armed for another object.")
			end
		end
	end)
end

function WorkspaceGrabController:_finishDrag()
	local drag = self._drag
	if not drag then
		return
	end
	self._drag = nil
	pcall(function()
		self._dragger:MouseUp()
	end)
	finishRecording(drag.recording)
	if isValidTarget(self._target) then
		if targetMoved(drag.startCFrame, drag.target) then
			self:_notify(
				"Free Grab complete. Click-drag another object, or toggle Grab off to resume posing.",
				"DragCompleted"
			)
		else
			self:_notify("Free Grab target unchanged. Click-drag another object, or toggle Grab off to resume posing.")
		end
	else
		self:_setTarget(nil)
		self:_notify("The grabbed object is no longer available. Free Grab remains armed.")
	end
end

function WorkspaceGrabController:_beginDrag()
	if not self._active or self._drag or not self._dragger then
		return
	end
	local mousePart = self._mouse.Target
	local target = resolveInstanceTarget(mousePart)
	if not target or not isPartWithinTarget(mousePart, target) then
		return
	end
	self:_setTarget(target)

	local lockedPart = getLockedPart(target)
	if lockedPart then
		self:_notify(string.format(
			"'%s' is locked. Unlock it, or click-drag another object.",
			lockedPart:GetFullName()
		))
		return
	end

	local parts = collectTargetParts(target)
	if #parts == 0 then
		self:_notify("That object has no movable parts. Click-drag another object.")
		return
	end

	local ok, errorMessage = pcall(function()
		local pointOnMousePart = mousePart.CFrame:PointToObjectSpace(self._mouse.Hit.Position)
		self._dragger:MouseDown(mousePart, pointOnMousePart, parts)
	end)
	if not ok then
		self:_notify("Studio could not begin Free Grab: " .. tostring(errorMessage))
		return
	end

	local recording = beginRecording("7kg2 Free Grab")
	if not recording then
		pcall(function()
			self._dragger:MouseUp()
		end)
		self:_notify("Finish the active Studio edit before starting a Free Grab.")
		return
	end

	self._drag = {
		recording = recording,
		target = target,
		startCFrame = getTargetCFrame(target),
	}
	self:_notify("Free Grab moving scene object. Release the mouse to finish this Undo step.")
end

function WorkspaceGrabController:_moveDrag()
	if not self._drag or not self._dragger then
		return
	end
	local ok, errorMessage = pcall(function()
		self._dragger:MouseMove(self._mouse.UnitRay)
	end)
	if not ok then
		self:_finishDrag()
		self:_notify("Studio ended Free Grab: " .. tostring(errorMessage))
	end
end

function WorkspaceGrabController:_bindMouse()
	table.insert(self._connections, self._mouse.Button1Down:Connect(function()
		self:_beginDrag()
	end))
	table.insert(self._connections, self._mouse.Move:Connect(function()
		self:_moveDrag()
	end))
	table.insert(self._connections, self._mouse.Button1Up:Connect(function()
		self:_finishDrag()
	end))
end

function WorkspaceGrabController:IsActive()
	return self._active == true
end

function WorkspaceGrabController:Arm()
	if self._active then
		local message = "Free Grab is already armed. Click-drag any Part or Model."
		self:_notify(message)
		return true, message
	end
	if not self._dragger then
		local message = "Free Grab is unavailable in this Studio version."
		self:_notify(message)
		return false, message
	end

	local target = resolveSelectedTarget()
	self:_setTarget(target)
	self._active = true
	self:_setViewportOwnershipActive(true)

	local activated = pcall(function()
		self._plugin:Activate(true)
	end)
	if not activated then
		local message = "Studio could not arm Free Grab."
		self:Release(message)
		return false, message
	end

	local message
	if target then
		message = string.format(
			"Free Grab armed. Current target: %s '%s'. Click-drag it or any other object.",
			target.ClassName,
			target:GetFullName()
		)
	else
		message = "Free Grab armed. Click-hold any Part or Model, drag, then release."
	end
	self:_notify(message)
	return true, message
end

function WorkspaceGrabController:HandlePluginDeactivation()
	if self._active then
		self:Release(
			"Free Grab turned off because another Studio tool took control.",
			"ExternalDeactivation"
		)
	end
end

function WorkspaceGrabController:Release(message, reason)
	if self._drag then
		self:_finishDrag()
	end
	self._active = false
	self:_setTarget(nil)
	self:_setViewportOwnershipActive(false)
	local resolvedMessage = message or "Free Grab off. 7kg2 posing and viewport selection restored."
	self:_notify(resolvedMessage, reason)
	return false, resolvedMessage
end

function WorkspaceGrabController:Toggle()
	if self._active then
		return self:Release()
	end
	return self:Arm()
end

function WorkspaceGrabController:Destroy()
	self._onChanged = nil
	self:Release("Free Grab closed.", "Destroy")
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	if self._folder then
		self._folder:Destroy()
	end
	if self._dragger then
		self._dragger:Destroy()
	end
end

return WorkspaceGrabController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX283">
        <Properties>
          <string name="Name">WorkspaceGrabKeyframeSupport</string>
          <ProtectedString name="Source">local TrackPropertyDefaultsService = require(script.Parent:WaitForChild("TrackPropertyDefaultsService"))

local WorkspaceGrabKeyframeSupport = {}

local function isValidTarget(target)
	return target
		and target.Parent ~= nil
		and (target:IsA("BasePart") or target:IsA("Model"))
end

local function trackTargetsInstance(track, target)
	return track
		and (track.instance == target or track.rig == target)
end

local function getCFrameTrackPriority(track, target)
	if not trackTargetsInstance(track, target) then
		return nil
	end
	if track.targetScope == "RigProperty" and track.propertyName == "CFrame" then
		return 1
	end
	if track.trackType == "Rig CFrame" then
		return 2
	end
	if track.targetScope == "ObjectProperty" and track.propertyName == "CFrame" then
		return 3
	end
	if (track.trackType == "Object" or track.trackType == "Model") and track.valueType == "CFrame" then
		return 4
	end
	return nil
end

local function findBestCFrameTrack(timeline, target)
	local bestTrack = nil
	local bestPriority = nil
	for _, track in ipairs(timeline:getTracks()) do
		local priority = getCFrameTrackPriority(track, target)
		if priority and (bestPriority == nil or priority &lt; bestPriority) then
			bestTrack = track
			bestPriority = priority
		end
	end
	return bestTrack
end

local function findTrackedRig(timeline, target)
	if not target:IsA("Model") or type(timeline.getRigs) ~= "function" then
		return nil
	end
	for _, rig in ipairs(timeline:getRigs()) do
		if rig == target and rig.Parent then
			return rig
		end
	end
	return nil
end

local function setWaypoint(changeHistoryService, name)
	if not changeHistoryService then
		return
	end
	pcall(function()
		changeHistoryService:SetWaypoint(name)
	end)
end

function WorkspaceGrabKeyframeSupport.capture(args)
	local timeline = args and args.timeline
	local target = args and args.target
	if not timeline or not isValidTarget(target) then
		return false, "Free Grab complete, but the moved object is no longer available for keying."
	end

	local track = findBestCFrameTrack(timeline, target)
	local trackedRig = not track and findTrackedRig(timeline, target) or nil
	if not track and not trackedRig then
		return false, string.format(
			"Free Grab complete. Add '%s' to the timeline before moving it if you want CFrame keys.",
			target.Name
		)
	end

	if track and type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(track.path) then
		return false, string.format(
			"Free Grab complete. Enable '%s' before moving it to write a CFrame key.",
			track.name or "the CFrame track"
		)
	end

	if type(args.pushUndo) == "function" then
		args.pushUndo("Free Grab CFrame Keyframe")
	end
	setWaypoint(args.changeHistoryService, "Before Free Grab CFrame Keyframe")

	local createdTrack = false
	if not track then
		track = timeline:addGenericTrack("RigProperty", trackedRig, "CFrame", {
			rig = trackedRig,
			rigName = trackedRig.Name,
			propertyName = "CFrame",
			targetScope = "RigProperty",
			sortOrder = TrackPropertyDefaultsService.getSortOrder("CFrame"),
		})
		createdTrack = track ~= nil
	end

	local success = false
	local message = nil
	if track then
		success, message = timeline:captureTrackFrame(track.path)
	end
	if not success then
		if createdTrack and track then
			timeline:removeTrack(track.path)
		end
		if type(args.discardPendingUndo) == "function" then
			args.discardPendingUndo()
		end
		return false, message or "Free Grab completed, but 7kg2 could not write the CFrame key."
	end

	setWaypoint(args.changeHistoryService, "After Free Grab CFrame Keyframe")
	local frame = timeline:getCurrentFrame()
	if createdTrack then
		return true, string.format(
			"Free Grab complete. Added a Rig CFrame track and keyed '%s' at frame %d.",
			target.Name,
			frame
		)
	end
	return true, string.format(
		"Free Grab complete. Added or updated '%s' CFrame key at frame %d.",
		target.Name,
		frame
	)
end

return WorkspaceGrabKeyframeSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX284">
        <Properties>
          <string name="Name">WorkspaceGrabOwnershipSupport</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")

local WorkspaceGrabOwnershipSupport = {}

local OWNERSHIP_MARKER_NAME = "MegMoWorkspaceGrabOwnership"

function WorkspaceGrabOwnershipSupport.isActive()
	for _, marker in ipairs(CoreGui:GetChildren()) do
		if marker.Name == OWNERSHIP_MARKER_NAME
			and marker:IsA("Folder")
			and marker:GetAttribute("Active") == true then
			return true
		end
	end
	return false
end

return WorkspaceGrabOwnershipSupport
</ProtectedString>
        </Properties>
      </Item>
    <Item class="ModuleScript" referent="RBX7KG2A"><Properties><string name="Name">BrandLogo</string><ProtectedString name="Source">-- 7kg2 Animator brand logo, drawn entirely in code (no image assets).
-- A rounded blue tile with a glossy "K" mark built from rotated bars.

local BrandLogo = {}

BrandLogo.PALETTE = {
	Deep = Color3.fromRGB(6, 16, 42),
	Mid = Color3.fromRGB(22, 86, 214),
	Bright = Color3.fromRGB(86, 182, 255),
	Glow = Color3.fromRGB(146, 216, 255),
	Mark = Color3.fromRGB(240, 249, 255),
}

local function make(className, props)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	instance.Parent = parent
	return instance
end

local function addBar(parent, size, position, rotation, zIndex)
	local bar = make("Frame", {
		Name = "Bar",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = BrandLogo.PALETTE.Mark,
		BorderSizePixel = 0,
		Position = position,
		Rotation = rotation or 0,
		Size = size,
		ZIndex = zIndex or 4,
	})
	make("UICorner", {
		Parent = bar,
		CornerRadius = UDim.new(0.5, 0),
	})
	make("UIGradient", {
		Parent = bar,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, BrandLogo.PALETTE.Mark),
			ColorSequenceKeypoint.new(1, BrandLogo.PALETTE.Glow),
		}),
		Rotation = 90,
	})
	return bar
end

-- Creates the logo inside `parent`.
-- options: name, size, position, anchorPoint, zIndex, showTile (default true)
function BrandLogo.create(parent, options)
	options = options or {}

	local root = make("Frame", {
		Name = options.name or "BrandLogo",
		Parent = parent,
		AnchorPoint = options.anchorPoint or Vector2.new(0, 0),
		BackgroundColor3 = BrandLogo.PALETTE.Deep,
		BackgroundTransparency = options.showTile == false and 1 or 0,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Position = options.position or UDim2.fromOffset(0, 0),
		Size = options.size or UDim2.fromOffset(28, 28),
		ZIndex = options.zIndex or 2,
	})

	make("UICorner", {
		Parent = root,
		CornerRadius = UDim.new(0.28, 0),
	})

	if options.showTile ~= false then
		make("UIGradient", {
			Parent = root,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, BrandLogo.PALETTE.Bright),
				ColorSequenceKeypoint.new(0.55, BrandLogo.PALETTE.Mid),
				ColorSequenceKeypoint.new(1, BrandLogo.PALETTE.Deep),
			}),
			Rotation = 125,
		})

		make("UIStroke", {
			Name = "LogoStroke",
			Parent = root,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = BrandLogo.PALETTE.Glow,
			Thickness = 1,
			Transparency = 0.45,
		})

		-- soft top sheen
		local sheen = make("Frame", {
			Name = "Sheen",
			Parent = root,
			BackgroundColor3 = BrandLogo.PALETTE.Glow,
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, 0),
			Size = UDim2.fromScale(1, 0.45),
			ZIndex = 2,
		})
		make("UICorner", {
			Parent = sheen,
			CornerRadius = UDim.new(0.28, 0),
		})
		make("UIGradient", {
			Parent = sheen,
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		})
	end

	local mark = make("Frame", {
		Name = "Mark",
		Parent = root,
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
	})

	-- vertical stem of the K
	addBar(mark, UDim2.fromScale(0.13, 0.56), UDim2.fromScale(0.32, 0.5), 0, 4)
	-- upper diagonal
	addBar(mark, UDim2.fromScale(0.115, 0.40), UDim2.fromScale(0.575, 0.335), 38, 4)
	-- lower diagonal
	addBar(mark, UDim2.fromScale(0.115, 0.42), UDim2.fromScale(0.585, 0.655), -38, 4)
	-- small accent dot
	local dot = make("Frame", {
		Name = "AccentDot",
		Parent = mark,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = BrandLogo.PALETTE.Glow,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.795, 0.205),
		Size = UDim2.fromScale(0.11, 0.11),
		ZIndex = 5,
	})
	make("UICorner", {
		Parent = dot,
		CornerRadius = UDim.new(0.5, 0),
	})

	return root
end

-- Convenience: logo + wordmark row, returns the container frame.
function BrandLogo.createLockup(parent, options)
	options = options or {}
	local container = make("Frame", {
		Name = options.name or "BrandLockup",
		Parent = parent,
		BackgroundTransparency = 1,
		Position = options.position or UDim2.fromOffset(0, 0),
		Size = options.size or UDim2.new(0, 220, 0, 32),
		ZIndex = options.zIndex or 2,
	})

	BrandLogo.create(container, {
		size = UDim2.new(0, 30, 0, 30),
		position = UDim2.new(0, 0, 0.5, 0),
		anchorPoint = Vector2.new(0, 0.5),
		zIndex = (options.zIndex or 2) + 1,
	})

	make("TextLabel", {
		Name = "Wordmark",
		Parent = container,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 40, 0, 0),
		Size = UDim2.new(1, -40, 1, 0),
		Text = options.text or "7kg2 Animator",
		TextColor3 = options.textColor or Color3.fromRGB(233, 242, 255),
		TextSize = options.textSize or 20,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	return container
end

return BrandLogo
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7KG2B"><Properties><string name="Name">ResponsiveScaleService</string><ProtectedString name="Source">-- Keeps the whole plugin UI proportional when the widget/window is resized.
-- A UIScale is attached to each root GuiObject of the widget, and the root is
-- resized by 1/scale so the scaled content still fills the available area.

local ResponsiveScaleService = {}

local SCALE_NAME = "SevenKg2ResponsiveScale"
local REFERENCE = Vector2.new(1180, 820)
local MIN_SCALE = 0.6
local MAX_SCALE = 1.35
local SOFTEN_POWER = 0.55

local function computeScale(absoluteSize)
	if not absoluteSize or absoluteSize.X &lt;= 1 or absoluteSize.Y &lt;= 1 then
		return 1
	end
	local ratio = math.min(absoluteSize.X / REFERENCE.X, absoluteSize.Y / REFERENCE.Y)
	if ratio &lt;= 0 then
		return 1
	end
	local softened = ratio ^ SOFTEN_POWER
	return math.clamp(softened, MIN_SCALE, MAX_SCALE)
end

function ResponsiveScaleService.attach(widget, options)
	if typeof(widget) ~= "Instance" then
		return nil
	end
	options = options or {}

	local connections = {}
	local applying = false
	local currentScale = 1

	local function applyTo(frame)
		if not frame or not frame:IsA("GuiObject") then
			return
		end
		local scaleObject = frame:FindFirstChild(SCALE_NAME)
		if not scaleObject or not scaleObject:IsA("UIScale") then
			scaleObject = Instance.new("UIScale")
			scaleObject.Name = SCALE_NAME
			scaleObject.Parent = frame
		end

		currentScale = computeScale(widget.AbsoluteSize)
		applying = true
		local ok = pcall(function()
			scaleObject.Scale = currentScale
			frame.Size = UDim2.fromScale(1 / currentScale, 1 / currentScale)
		end)
		applying = false
		return ok
	end

	local function trackFrame(frame)
		if not frame or not frame:IsA("GuiObject") then
			return
		end
		applyTo(frame)
		table.insert(
			connections,
			frame:GetPropertyChangedSignal("Size"):Connect(function()
				if applying then
					return
				end
				applyTo(frame)
			end)
		)
	end

	local function refreshAll()
		for _, child in ipairs(widget:GetChildren()) do
			if child:IsA("GuiObject") then
				applyTo(child)
			end
		end
	end

	for _, child in ipairs(widget:GetChildren()) do
		trackFrame(child)
	end

	table.insert(
		connections,
		widget.ChildAdded:Connect(function(child)
			if child:IsA("GuiObject") then
				task.defer(trackFrame, child)
			end
		end)
	)

	table.insert(
		connections,
		widget:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshAll)
	)

	refreshAll()

	return {
		refresh = refreshAll,
		getScale = function()
			return currentScale
		end,
		destroy = function()
			for _, connection in ipairs(connections) do
				pcall(function()
					connection:Disconnect()
				end)
			end
			connections = {}
		end,
	}
end

return ResponsiveScaleService
</ProtectedString></Properties></Item></Item>
    <Item class="Script" referent="RBX285">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source">local ChangeHistoryService = {
	SetWaypoint = function() end,
}

local Modules = script.Parent:WaitForChild("Modules")

local BuildInfo = require(Modules:WaitForChild("BuildInfo"))
local AnimationEffectsService = require(Modules:WaitForChild("AnimationEffectsService"))
local AutoSaveStatusViewModel = require(Modules:WaitForChild("AutoSaveStatusViewModel"))
local CameraTrackService = require(Modules:WaitForChild("CameraTrackService"))
local Constants = require(Modules:WaitForChild("Constants"))
local EditorHistoryService = require(Modules:WaitForChild("EditorHistoryService"))
local EffectsService = require(Modules:WaitForChild("EffectsService"))
local GizmoController = require(Modules:WaitForChild("GizmoController"))
local ImportService = require(Modules:WaitForChild("ImportService"))
local KeyframeEditService = require(Modules:WaitForChild("KeyframeEditService"))
local MotionBuilderState = require(Modules:WaitForChild("MotionBuilderState"))
local MotionClipService = require(Modules:WaitForChild("MotionClipService"))
local MotionService = require(Modules:WaitForChild("MotionService"))
local ParticleEmitterPropertyService = require(Modules:WaitForChild("ParticleEmitterPropertyService"))
local ParticleEmitterGroupService = require(Modules:WaitForChild("ParticleEmitterGroupService"))
local PerformanceDebugService = require(Modules:WaitForChild("PerformanceDebugService"))
local PlaybackService = require(Modules:WaitForChild("PlaybackService"))
local PluginSettings = require(Modules:WaitForChild("PluginSettings"))
local PropertyKeyframeValueService = require(Modules:WaitForChild("PropertyKeyframeValueService"))
local RigInsertService = require(Modules:WaitForChild("RigInsertService"))
local RigWorkspaceLockService = require(Modules:WaitForChild("RigWorkspaceLockService"))
local RigService = require(Modules:WaitForChild("RigService"))
local SaveExportService = require(Modules:WaitForChild("SaveExportService"))
local ScreenEffectsRenderer = require(Modules:WaitForChild("ScreenEffectsRenderer"))
local ScreenEffectTrackService = require(Modules:WaitForChild("ScreenEffectTrackService"))
local SelectionState = require(Modules:WaitForChild("SelectionState"))
local StudioSelectionActions = require(Modules:WaitForChild("StudioSelectionActions"))
local SelectionService = require(Modules:WaitForChild("SelectionService"))
local SoundTimelineService = require(Modules:WaitForChild("SoundTimelineService"))
local ThemeService = require(Modules:WaitForChild("ThemeService"))
local TimelineModel = require(Modules:WaitForChild("TimelineModel"))
local WidgetController = require(Modules:WaitForChild("WidgetController"))

ThemeService.loadSavedTheme(plugin)
pcall(function()
	SaveExportService.pruneAutoSaves()
end)
pcall(function()
	RigWorkspaceLockService.unlockTaggedDescendants(workspace)
end)
pcall(function()
	require(Modules:WaitForChild("BoneSkeletonOverlayService")).clear()
end)

local toolbar = plugin:CreateToolbar(Constants.TOOLBAR_NAME)
local toggleButton = toolbar:CreateButton(
	Constants.BUTTON_ID,
	Constants.BUTTON_TOOLTIP,
	Constants.BUTTON_ICON,
	Constants.BRAND_NAME
)
toggleButton.ClickableWhenViewportHidden = true

local widgetInfo = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Left,
	false,
	false,
	Constants.WIDGET_SIZE.X,
	Constants.WIDGET_SIZE.Y,
	Constants.WIDGET_MIN_SIZE.X,
	Constants.WIDGET_MIN_SIZE.Y
)

local widget = plugin:CreateDockWidgetPluginGui(Constants.WIDGET_ID, widgetInfo)
widget.Title = Constants.WIDGET_TITLE
SoundTimelineService.setPreviewParent(widget)

local timeline = TimelineModel.new(PluginSettings.getPreferredFps(plugin), Constants.DEFAULT_DURATION_FRAMES)
local widgetController = WidgetController.new(widget, plugin)
pcall(function()
	require(Modules:WaitForChild("ResponsiveScaleService")).attach(widget)
end)
widgetController._onionSkinService = require(Modules:WaitForChild("OnionSkinService")).new()
widgetController._onionSkinEnabled = false
widgetController._onionSkinFrameStep = 5
local gizmoController = GizmoController.new(plugin)
gizmoController:setMoveSnap(Constants.DEFAULT_MOVE_SNAP)
gizmoController:setRotateSnap(Constants.DEFAULT_ROTATE_SNAP_DEGREES)
gizmoController:setSizePercent(PluginSettings.getGizmoSizePercent(plugin))
local selectedJointPath = nil
local selectedKeyframeFrame = nil
local selectedKeys = {}
local selectedTrackPaths = {}
local editorActions = {}
local importAnimationEntries = {}
local importBrowserStatus = "Paste an Animation ID, search Roblox Starter animations, select an Animation/KeyframeSequence, or browse your animations."
local importActionStatus = "Ready to import."
widgetController._importBrowserSource = "Saves"
local importRequestId = 0
local motionBuilderState = MotionBuilderState.new(MotionService)
local effectsService = EffectsService.new()
local screenEffectsRenderer = ScreenEffectsRenderer.new()
local playbackService = nil
local microController = nil
local getGroupSaveData
local getMotionBuilderSaveData
local getEffectsSaveData
local keyframeEditService = KeyframeEditService.new(SelectionState)
local historyService = EditorHistoryService.new(50)
local motionRecipeEntries = {}
local motionRecipeStatus = "No Motion Builder recipes saved yet."
local selectedMotionRecipeName = nil
local autoSaveState = {
	changeToken = 0,
	savedToken = 0,
	intervalSeconds = 30,
	nextSaveClock = os.clock() + 30,
	lastSavedText = nil,
	lastErrorText = nil,
}
widgetController._facesController = require(script.Parent:WaitForChild("Features"):WaitForChild("Faces"):WaitForChild("FacesController")).new({
	plugin = plugin,
	timeline = timeline,
	selectionService = SelectionService,
	changeHistoryService = ChangeHistoryService,
	markDirty = function()
		autoSaveState.changeToken += 1
		autoSaveState.lastErrorText = nil
	end,
})

local function getAutoSaveViewModel()
	return AutoSaveStatusViewModel.build(autoSaveState)
end

local function clearSelectedKeyframes()
	selectedKeys, selectedKeyframeFrame = require(Modules:WaitForChild("SelectionClearSupport")).clearSelectedKeyframes()
end

local function clearSelectedTracks()
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectionClearSupport")).clearSelectedTracks()
end

local function refreshMotionRecipes()
	motionRecipeEntries, motionRecipeStatus, selectedMotionRecipeName = require(Modules:WaitForChild("MotionRecipeRefreshSupport")).refresh(
		SaveExportService.listMotionRecipes,
		selectedMotionRecipeName
	)
end

local function enableMoveGizmoForKeySelection()
	require(Modules:WaitForChild("MoveGizmoSelectionSupport")).enableForKeySelection(gizmoController)
end

local function getSelectedTrackPaths()
	return require(Modules:WaitForChild("SelectedTrackPathSupport")).getSelectedTrackPaths(timeline, selectedTrackPaths)
end

if widgetController._facesController and type(widgetController._facesController.setSelectedTrackPathProvider) == "function" then
	widgetController._facesController:setSelectedTrackPathProvider(getSelectedTrackPaths)
end

local function buildEffectsViewModel(frame)
	return require(Modules:WaitForChild("EffectsViewModelBuilder")).build(effectsService, timeline, frame)
end

local function renderScreenEffects(frame)
	require(Modules:WaitForChild("ScreenEffectsRenderSupport")).render({
		effectsViewModel = effectsService:getViewModel(),
		buildEffectsViewModel = buildEffectsViewModel,
		facesController = widgetController._facesController,
		frame = frame,
		screenEffectsRenderer = screenEffectsRenderer,
		timeline = timeline,
	})
end

local function updateOnionSkinPreview(frame, force)
	require(Modules:WaitForChild("OnionSkinPreviewSupport")).update(widgetController, timeline, playbackService, frame, force)
end

local function getCaptureTrackPaths()
	return require(Modules:WaitForChild("CaptureTrackPathSupport")).getCaptureTrackPaths(
		timeline,
		selectedTrackPaths,
		selectedJointPath
	)
end

function editorActions.resumeMicroViewportToolsForTimelineSelection()
	if widget:GetAttribute("MegMoHiddenForMicro") ~= true then
		return
	end
	widgetController._viewportToolsSuspendedForStudio = false
	widgetController._motionBuilderSuspendedViewportPicker = nil
	pcall(function()
		gizmoController:setSuppressed(false)
	end)
	pcall(function()
		if SelectionService and type(SelectionService.setStudioSelectionGuardSuspended) == "function" then
			SelectionService.setStudioSelectionGuardSuspended(false)
		end
	end)
	pcall(function()
		plugin:Activate(false)
	end)
end

function editorActions._refreshMicroWorkspace()
	if microController and type(microController.Refresh) == "function" then
		pcall(function()
			microController.Refresh()
		end)
	end
	local recorder = editorActions._motionRecorder
	if recorder and editorActions._debugRecordMotion then
		local stateText = string.format(
			"armed=%s recording=%s",
			tostring(recorder:IsArmed()),
			tostring(recorder:IsRecording())
		)
		if editorActions._lastMotionRecorderMicroDebugState ~= stateText then
			editorActions._lastMotionRecorderMicroDebugState = stateText
			editorActions._debugRecordMotion("micro-refresh-state", {
				state = stateText,
			})
		end
	end
end

function editorActions._debugRecordMotion(eventName, details)
end

function editorActions.getImportTargetRigName()
	return require(Modules:WaitForChild("ImportTargetRigSupport")).getImportTargetRigName(
		timeline,
		selectedJointPath,
		selectedTrackPaths,
		SelectionService
	)
end

local function setSingleSelectedTrack(path)
	local nextSelectedTrackPaths, nextSelectedJointPath, shouldClearTracks = require(Modules:WaitForChild("TrackSelectionStateSupport")).setSingleSelectedTrack(
		path,
		timeline
	)
	if shouldClearTracks then
		clearSelectedTracks()
		return
	end

	selectedTrackPaths = nextSelectedTrackPaths
	selectedJointPath = nextSelectedJointPath
	clearSelectedKeyframes()
	editorActions.resumeMicroViewportToolsForTimelineSelection()
end

local function toggleSelectedTrack(path)
	local nextSelectedTrackPaths, nextSelectedJointPath, shouldClearKeys = require(Modules:WaitForChild("TrackSelectionStateSupport")).toggleSelectedTrack(
		path,
		timeline,
		selectedTrackPaths,
		selectedJointPath
	)
	if not shouldClearKeys then
		return
	end

	selectedTrackPaths = nextSelectedTrackPaths
	selectedJointPath = nextSelectedJointPath
	clearSelectedKeyframes()
	editorActions.resumeMicroViewportToolsForTimelineSelection()
end

local function isOnlySelectedTrack(path)
	return require(Modules:WaitForChild("TrackSelectionStateSupport")).isOnlySelectedTrack(path, selectedTrackPaths)
end

local function getGroupIdsForKeys(keys)
	return require(Modules:WaitForChild("KeyframeGroupSelectionSupport")).getGroupIdsForKeys(keyframeEditService, keys)
end

local function getSelectedGroupIds()
	return require(Modules:WaitForChild("KeyframeGroupSelectionSupport")).getSelectedGroupIds(keyframeEditService, selectedKeys)
end

local function getKeyRefsForGroup(groupId)
	return require(Modules:WaitForChild("KeyframeGroupSelectionSupport")).getKeyRefsForGroup(keyframeEditService, groupId, timeline)
end

local syncPlayheadToSelectedKeyframe

local function selectKeys(keys, preservePlayhead)
	clearSelectedTracks()
	clearSelectedKeyframes()
	selectedKeys, selectedKeyframeFrame, selectedJointPath = require(Modules:WaitForChild("SelectedKeySetSupport")).selectKeys(keys)
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	if not preservePlayhead then
		syncPlayheadToSelectedKeyframe()
	end
	if next(selectedKeys) then
		enableMoveGizmoForKeySelection()
		editorActions.resumeMicroViewportToolsForTimelineSelection()
	end
end

local function toggleKeySet(keyList, preservePlayhead)
	local nextSelectedKeys, nextSelectedKeyframeFrame, nextSelectedJointPath, shouldDeselect, normalizedCount, foundValidKeys =
		require(Modules:WaitForChild("SelectedKeySetSupport")).toggleKeySet(keyList, timeline, selectedKeys)
	if not foundValidKeys then
		refreshUi("Those keyframes are no longer available.")
		return
	end

	selectedKeys = nextSelectedKeys
	selectedKeyframeFrame = nextSelectedKeyframeFrame
	if selectedKeyframeFrame then
		selectedJointPath = nextSelectedJointPath
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
		if not preservePlayhead then
			syncPlayheadToSelectedKeyframe()
		end
		enableMoveGizmoForKeySelection()
	else
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	end
	refreshUi(string.format("%s %d rig keyframe%s.", shouldDeselect and "Deselected" or "Selected", normalizedCount, normalizedCount == 1 and "" or "s"))
end

editorActions.selectKeySet = selectKeys
editorActions.toggleKeySet = toggleKeySet

local function getSelectedKeyRefs()
	local normalized, normalizedMap = require(Modules:WaitForChild("SelectedKeyQuerySupport")).getSelectedKeyRefs(selectedKeys, timeline)
	selectedKeys = normalizedMap
	return normalized
end

if widgetController._facesController and type(widgetController._facesController.setSelectedKeyProvider) == "function" then
	widgetController._facesController:setSelectedKeyProvider(getSelectedKeyRefs)
end

local function getSelectedKeyOptions()
	local selectedKeyQuerySupport = require(Modules:WaitForChild("SelectedKeyQuerySupport"))
	local _, normalizedMap = selectedKeyQuerySupport.getSelectedKeyRefs(selectedKeys, timeline)
	selectedKeys = normalizedMap
	return selectedKeyQuerySupport.getSelectedKeyOptions(selectedKeys, timeline)
end

local function getSelectedKeyframeFrames()
	return require(Modules:WaitForChild("SelectedKeyQuerySupport")).getSelectedKeyframeFrames(selectedKeys)
end

local function preserveTrackSelectionWhenScrubbingAway(frame)
	if next(selectedKeys) == nil then
		return
	end

	local targetFrame = math.max(0, math.floor(tonumber(frame) or 0))
	if selectedKeyframeFrame ~= nil and math.max(0, math.floor(selectedKeyframeFrame)) == targetFrame then
		return
	end

	local nextSelectedTrackPaths, nextSelectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(
		timeline,
		selectedKeys,
		selectedJointPath
	)
	clearSelectedKeyframes()
	selectedTrackPaths = nextSelectedTrackPaths
	selectedJointPath = nextSelectedJointPath
end

syncPlayheadToSelectedKeyframe = function()
	if selectedKeyframeFrame == nil then
		return
	end
	local frame = math.max(0, math.floor(selectedKeyframeFrame))
	timeline:setCurrentFrame(frame)
end

local function setSingleSelectedKey(jointPath, frame)
	clearSelectedTracks()
	selectedKeys, selectedKeyframeFrame, selectedJointPath = require(Modules:WaitForChild("SelectedKeyMutationSupport")).setSingleSelectedKey(jointPath, frame)
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	syncPlayheadToSelectedKeyframe()
	enableMoveGizmoForKeySelection()
end

local function setSingleSelectedKeyframe(frame)
	clearSelectedTracks()
	clearSelectedKeyframes()
	selectedKeys, selectedKeyframeFrame = require(Modules:WaitForChild("SelectedKeyMutationSupport")).setSingleSelectedKeyframe(frame, timeline)
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	syncPlayheadToSelectedKeyframe()
end

local function rebuildGroupMembership()
	require(Modules:WaitForChild("KeyframeGroupMembershipSupport")).rebuildGroupMembership(keyframeEditService)
end

local function remapGroupsAfterMove(oldKeys, newKeys)
	require(Modules:WaitForChild("KeyframeGroupMembershipSupport")).remapGroupsAfterMove(keyframeEditService, oldKeys, newKeys)
end

local function removeDeletedKeysFromGroups()
	require(Modules:WaitForChild("KeyframeGroupMembershipSupport")).removeDeletedKeysFromGroups(keyframeEditService, timeline)
end

local function createEditorSnapshot(label)
	return require(Modules:WaitForChild("EditorSnapshotSupport")).create(
		label,
		timeline,
		selectedJointPath,
		selectedKeyframeFrame,
		selectedKeys,
		selectedTrackPaths,
		keyframeEditService,
		widgetController._facesController
	)
end

local function restoreEditorSnapshot(snapshot)
	local ok, restoredState = require(Modules:WaitForChild("EditorSnapshotSupport")).restore(snapshot, {
		editorActions = editorActions,
		facesController = widgetController._facesController,
		keyframeEditService = keyframeEditService,
		modules = Modules,
		timeline = timeline,
	})
	if not ok then
		return false
	end
	selectedJointPath = restoredState.selectedJointPath
	selectedKeyframeFrame = restoredState.selectedKeyframeFrame
	selectedKeys = restoredState.selectedKeys
	selectedTrackPaths = restoredState.selectedTrackPaths
	return true
end

local function pushUndo(label)
	autoSaveState.changeToken += require(Modules:WaitForChild("EditorHistoryMutationSupport")).push(
		historyService,
		label,
		createEditorSnapshot(label)
	)
end

local function resetHistory()
	require(Modules:WaitForChild("EditorHistoryMutationSupport")).reset(historyService)
end

local function getSelectedJointTransform()
	return require(Modules:WaitForChild("SelectedJointTransformSupport")).getSelectedJointTransform(selectedJointPath, timeline)
end

local function clearStudioSelectionForViewportTool()
	widgetController._suppressViewportSelectionSync = true
	pcall(function()
		SelectionService.setSelection({}, {
			preserveWorkspaceSelection = true,
		})
	end)
	task.defer(function()
		widgetController._suppressViewportSelectionSync = false
	end)
end

local function refreshSelectedGizmo()
	if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
		require(Modules:WaitForChild("ViewportToolCleanupService")).clear({
			editorActions = editorActions,
			gizmoController = gizmoController,
			modules = Modules,
		})
		return
	end

	if widgetController._viewportToolsSuspendedForStudio == true then
		RigWorkspaceLockService.unlockTimelineRigs(timeline)
		pcall(function()
			require(Modules:WaitForChild("RigPartHighlightService")).clear()
		end)
		pcall(function()
			gizmoController:clearTarget()
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(false)
			end
		end)
		return
	end

	RigWorkspaceLockService.syncFromSelection(timeline, selectedJointPath, selectedTrackPaths, selectedKeys, SelectionState)
	if editorActions.syncViewportRigPartPicker then
		editorActions.syncViewportRigPartPicker()
	end
	local selectedGizmoSupport = require(Modules:WaitForChild("SelectedGizmoSupport"))
	local highlightService = selectedGizmoSupport.loadHighlightService(Modules)
	local function showRigPartHighlight(motors)
		selectedGizmoSupport.showRigPartHighlight(highlightService, widgetController._rigPartHighlightEnabled, motors)
	end
	local function clearRigPartHighlight()
		selectedGizmoSupport.clearRigPartHighlight(highlightService)
	end
	local function selectedTrackMotors()
		return selectedGizmoSupport.getSelectedTrackMotors(timeline, getSelectedTrackPaths())
	end
	local function getSingleSelectedTrack()
		local selectedPath = nil
		for path in pairs(selectedTrackPaths or {}) do
			if selectedPath ~= nil then
				return nil
			end
			selectedPath = path
		end
		return selectedPath and timeline:getTrackByPath(selectedPath) or nil
	end

	if require(Modules:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
		gizmoController:setSuppressed(true)
		if type(gizmoController.setHandleVisualsHidden) == "function" then
			gizmoController:setHandleVisualsHidden(true)
		end
		clearRigPartHighlight()
		return
	end

	if playbackService and playbackService:getIsPlaying() then
		gizmoController:setSuppressed(true)
		clearRigPartHighlight()
		return
	end

	if editorActions._persistentTrackballMode ~= nil then
		gizmoController:setSuppressed(true)
		local motors = selectedTrackMotors()
		if #motors == 0 then
			local selectedMotor = timeline:getMotorByPath(selectedJointPath)
			if selectedMotor then
				table.insert(motors, selectedMotor)
			end
		end
		showRigPartHighlight(motors)
		return
	end
	gizmoController:setSuppressed(false)
	if type(gizmoController.setHandleVisualsHidden) == "function" then
		gizmoController:setHandleVisualsHidden(widgetController._rigPartHighlightEnabled == true)
	end

	local motors = require(Modules:WaitForChild("MultiGizmoSelectionService")).getSameFrameRigMotors(timeline, selectedKeys, SelectionState)
	if motors and type(gizmoController.setMotors) == "function" then
		gizmoController:setMotors(motors)
		showRigPartHighlight(motors)
		return
	end

	if type(gizmoController.setMotors) == "function" then
		local trackMotors = selectedTrackMotors()
		if #trackMotors &gt; 1 then
			gizmoController:setMotors(trackMotors)
			showRigPartHighlight(trackMotors)
			return
		end
	end

	local selectedMotor = timeline:getMotorByPath(selectedJointPath)
	if selectedMotor then
		gizmoController:setMotor(selectedMotor)
		showRigPartHighlight({ selectedMotor })
		return
	end

	local selectedTrack = timeline:getTrackByPath(selectedJointPath) or getSingleSelectedTrack()
	if selectedTrack and selectedTrack.valueType == "CFrame" then
		clearRigPartHighlight()
		if selectedTrack.trackType == "Camera" or selectedTrack.targetScope == "CameraProperty" or selectedTrack.parentTrackType == "Camera" then
			gizmoController:clearTarget()
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(false)
			end
			return
		end
		gizmoController:setTrack(selectedTrack)
		if widget:GetAttribute("MegMoHiddenForMicro") == true then
			editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
			pcall(function()
				plugin:Activate(true)
			end)
		end
		return
	end

	clearRigPartHighlight()
	gizmoController:clearTarget()
end

function editorActions.retargetPersistentTrackball(path)
	if not path
		or not editorActions._persistentTrackballMode
		or not editorActions._trackballTool
		or type(editorActions._trackballTool.Retarget) ~= "function" then
		return false
	end
	local selectedPaths = getSelectedTrackPaths()
	local selection = require(Modules:WaitForChild("PersistentTrackballSelectionSupport")).buildSelection(path, timeline, selectedPaths)

	if type(editorActions._trackballTool.IsActive) ~= "function" or not editorActions._trackballTool:IsActive() then
		local mode = editorActions._persistentTrackballMode
		if editorActions.beginTrackballMode then
			editorActions.beginTrackballMode(mode, selection, {
				sticky = true,
				rearm = true,
			})
		end
		return editorActions.isPersistentTrackballActive()
	end

	if require(Modules:WaitForChild("PersistentTrackballSelectionSupport")).matchesCurrentTarget(editorActions._trackballTool, selection, path) then
		return true
	end

	local ok, success, message = pcall(function()
		return editorActions._trackballTool:Retarget(selection)
	end)
	if ok and success then
		return true
	end
	return false
end

function editorActions.isPersistentTrackballActive()
	return editorActions._persistentTrackballMode ~= nil
		and editorActions._trackballTool ~= nil
		and type(editorActions._trackballTool.IsActive) == "function"
		and editorActions._trackballTool:IsActive()
end

function editorActions.isViewportRigPartPickerActive()
	if require(Modules:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
		return false
	end
	if widgetController._motionBuilderSuspendedViewportPicker == true then
		widgetController._viewportPartPickerSuspended = true
		widgetController._viewportPartPickerArmed = false
		return false
	end
	local studioSelectionIsActiveRig = false
	if selectedJointPath == nil and next(selectedTrackPaths) == nil and next(selectedKeys) == nil then
		local selectedRig = SelectionService.getSelectedRig()
		if selectedRig then
			for _, rig in ipairs(timeline:getRigs()) do
				if rig == selectedRig then
					studioSelectionIsActiveRig = true
					break
				end
			end
		end
	end
	local isActive, nextArmed = require(Modules:WaitForChild("ViewportRigPartPickerSupport")).isActive({
		persistentTrackballActive = editorActions.isPersistentTrackballActive(),
		rigCount = #timeline:getRigs(),
		rigPartHighlightEnabled = widgetController._rigPartHighlightEnabled == true,
		selectedJointPath = selectedJointPath,
		selectedTrackPaths = selectedTrackPaths,
		timeline = timeline,
		viewportPartPickerArmed = widgetController._viewportPartPickerArmed == true,
		viewportPartPickerSuspended = widgetController._viewportPartPickerSuspended == true,
		microWorkspaceActive = widget:GetAttribute("MegMoHiddenForMicro") == true,
		studioSelectionIsActiveRig = studioSelectionIsActiveRig,
		widgetEnabled = widget.Enabled or widget:GetAttribute("MegMoHiddenForMicro") == true,
	})
	widgetController._viewportPartPickerArmed = nextArmed == true
	return isActive
end

function editorActions.suspendViewportRigPartPicker(message)
	local recorder = editorActions._motionRecorder
	local recorderActive = recorder and (recorder:IsArmed() or recorder:IsRecording()) or false
	local trackballActive = editorActions._trackballTool
		and type(editorActions._trackballTool.IsActive) == "function"
		and editorActions._trackballTool:IsActive()
	if recorderActive and trackballActive then
		editorActions._debugRecordMotion("suspend-preserve-record-motion", {
			message = message,
			armed = recorder:IsArmed(),
			recording = recorder:IsRecording(),
		})
		widgetController._viewportPartPickerSuspended = false
		widgetController._viewportToolsSuspendedForStudio = false
		return true, "Motion Recorder is using Trackball. Release or cancel Trackball to stop recording."
	end
	widgetController._viewportPartPickerArmed = false
	widgetController._viewportPartPickerSuspended = true
	widgetController._viewportToolsSuspendedForStudio = true
	widgetController._rigPartHighlightEnabled = false
	editorActions._persistentTrackballMode = nil
	editorActions._requestedTrackballMode = nil
	pcall(function()
		if SelectionService and type(SelectionService.setStudioSelectionGuardSuspended) == "function" then
			SelectionService.setStudioSelectionGuardSuspended(true)
		end
	end)
	pcall(function()
		toggleButton:SetActive(false)
	end)
	pcall(function()
		if editorActions._trackballTool then
			if type(editorActions._trackballTool.SetSticky) == "function" then
				editorActions._trackballTool:SetSticky(false)
			end
			if type(editorActions._trackballTool.IsActive) == "function"
				and editorActions._trackballTool:IsActive()
				and type(editorActions._trackballTool.Cancel) == "function" then
				editorActions._trackballTool:Cancel()
			end
		end
	end)
	pcall(function()
		require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
	end)
	pcall(function()
		require(Modules:WaitForChild("RigPartHighlightService")).clear()
	end)
	pcall(function()
		gizmoController:clearTarget()
		if type(gizmoController.setHandleVisualsHidden) == "function" then
			gizmoController:setHandleVisualsHidden(false)
		end
	end)
	return true, message or "Studio viewport controls active."
end

function editorActions.resumeViewportRigPartPicker()
	widgetController._motionBuilderSuspendedViewportPicker = nil
	widgetController._viewportToolsSuspendedForStudio = false
	widgetController._viewportPartPickerClickGraceUntil = os.clock() + 1.25
	pcall(function()
		gizmoController:setSuppressed(false)
	end)
	pcall(function()
		if SelectionService and type(SelectionService.setStudioSelectionGuardSuspended) == "function" then
			SelectionService.setStudioSelectionGuardSuspended(false)
		end
	end)
	if widgetController._viewportPartPickerSuspended == true then
		widgetController._viewportPartPickerSuspended = false
		widgetController._viewportPartPickerArmed = true
	end
	pcall(function()
		if widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
			toggleButton:SetActive(true)
		end
	end)
	if type(editorActions.syncViewportRigPartPicker) == "function" then
		editorActions.syncViewportRigPartPicker()
	end
	return true, "7kg2 viewport picker active."
end

-- Fragile Micro handoff path. Before changing this block, run
-- docs/micro-viewport-ownership-regression-checklist.md.
function editorActions.isMicroViewportCameraNavigationActive()
	if widgetController._microViewportCameraNavigationActive == true then
		return true
	end
	local navigationUntil = tonumber(widgetController._microViewportCameraNavigationUntil) or 0
	if navigationUntil &gt; 0 and os.clock() &lt;= navigationUntil then
		return true
	end
	widgetController._microViewportCameraNavigationUntil = nil
	return false
end

function editorActions.beginMicroViewportCameraNavigation()
	widgetController._microViewportCameraNavigationActive = true
	widgetController._microViewportCameraNavigationUntil = os.clock() + 10
	widgetController._viewportPartPickerSuspended = false
	widgetController._viewportPartPickerArmed = true
	if editorActions.hasViewportGizmoTarget and editorActions.hasViewportGizmoTarget() then
		editorActions._viewportGizmoKeepAliveUntil = os.clock() + 10
	end
	pcall(function()
		plugin:Deactivate()
	end)
	task.delay(10, function()
		if widgetController._microViewportCameraNavigationActive == true
			and os.clock() &gt;= (tonumber(widgetController._microViewportCameraNavigationUntil) or 0) then
			editorActions.endMicroViewportCameraNavigation()
		end
	end)
	return true, "Studio camera controls active."
end

function editorActions.endMicroViewportCameraNavigation()
	widgetController._microViewportCameraNavigationActive = false
	widgetController._microViewportCameraNavigationUntil = nil
	if editorActions.hasViewportGizmoTarget and editorActions.hasViewportGizmoTarget() then
		editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
	end
	if widget:GetAttribute("MegMoHiddenForMicro") == true then
		widgetController._viewportPartPickerSuspended = false
		widgetController._viewportPartPickerArmed = true
		task.defer(function()
			if type(editorActions.syncViewportRigPartPicker) == "function" then
				editorActions.syncViewportRigPartPicker()
			end
			refreshSelectedGizmo()
		end)
	end
	return true, "Micro viewport picker restored."
end

-- Keep keyboard ownership, rig-part picking, 7kg2 gizmos, Studio tools, and
-- Studio camera navigation as separate states. See the Micro viewport checklist.
function editorActions.syncViewportRigPartPicker()
	pcall(function()
		if require(Modules:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
			return
		end
		if widgetController._motionBuilderSuspendedViewportPicker == true then
			widgetController._viewportPartPickerSuspended = true
			widgetController._viewportPartPickerArmed = false
			plugin:Deactivate()
			pcall(function()
				toggleButton:SetActive(false)
			end)
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(false)
			end
			return
		end
		if editorActions.isMicroViewportCameraNavigationActive() then
			plugin:Deactivate()
			return
		end
		if editorActions.isViewportRigPartPickerActive() then
			plugin:Activate(true)
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(
					widgetController._rigPartHighlightEnabled == true or editorActions.isPersistentTrackballActive()
				)
			end
		elseif widgetController._rigPartHighlightEnabled ~= true then
			local mainTimelineShortcutsActive = widgetController
				and type(widgetController._ownsMainTimelineShortcuts) == "function"
				and widgetController:_ownsMainTimelineShortcuts()
			if mainTimelineShortcutsActive then
				if type(gizmoController.setHandleVisualsHidden) == "function" then
					gizmoController:setHandleVisualsHidden(false)
				end
				return
			end
			plugin:Deactivate()
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(false)
			end
		end
	end)
end

pcall(function()
	local deactivationSignal = plugin.Deactivation
	if deactivationSignal and deactivationSignal.Connect then
		deactivationSignal:Connect(function()
			if widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
				if editorActions.isMicroViewportCameraNavigationActive() then
					widgetController._viewportPartPickerSuspended = false
					widgetController._viewportPartPickerArmed = true
					if editorActions.hasViewportGizmoTarget and editorActions.hasViewportGizmoTarget() then
						editorActions._viewportGizmoKeepAliveUntil = os.clock() + 10
					end
					return
				end
				if editorActions._viewportGizmoDragActive == true
					or os.clock() &lt;= (editorActions._viewportGizmoKeepAliveUntil or 0) then
					return
				end
				if gizmoController
					and type(gizmoController.IsPointerOverHandle) == "function"
					and gizmoController:IsPointerOverHandle() then
					editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
					pcall(function()
						plugin:Activate(true)
					end)
					return
				end
				if os.clock() &lt;= (widgetController._viewportPartPickerIgnoreDeactivateUntil or 0) then
					widgetController._viewportPartPickerSuspended = false
					widgetController._viewportPartPickerArmed = true
					if editorActions.syncViewportRigPartPicker then
						editorActions.syncViewportRigPartPicker()
					end
					return
				end
				if widgetController._motionBuilderSuspendedViewportPicker == true then
					widgetController._viewportPartPickerSuspended = true
					widgetController._viewportPartPickerArmed = false
					pcall(function()
						toggleButton:SetActive(false)
					end)
					pcall(function()
						require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
					end)
					pcall(function()
						if type(gizmoController.setHandleVisualsHidden) == "function" then
							gizmoController:setHandleVisualsHidden(false)
						end
					end)
					return
				end
				if widgetController._viewportPartPickerArmed == true
					or widgetController._rigPartHighlightEnabled == true
					or selectedJointPath ~= nil
					or next(selectedTrackPaths) ~= nil then
					widgetController._viewportPartPickerClickGraceUntil = math.max(
						tonumber(widgetController._viewportPartPickerClickGraceUntil) or 0,
						os.clock() + 0.35
					)
				end
				widgetController._viewportPartPickerSuspended = true
				widgetController._viewportPartPickerArmed = false
				pcall(function()
					require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
				end)
				pcall(function()
					if type(gizmoController.setHandleVisualsHidden) == "function" then
						gizmoController:setHandleVisualsHidden(false)
					end
				end)
			end
		end)
	end
end)

local function refreshUi(message)
	local perfToken = PerformanceDebugService.begin("Refresh ViewModel")
	local themePreferenceResyncCount = widgetController._themePreferenceResyncCount or 0
	if themePreferenceResyncCount &lt; 3 then
		widgetController._themePreferenceResyncCount = themePreferenceResyncCount + 1
		ThemeService.loadSavedTheme(plugin)
	end
	if type(timeline.syncDurationToSoundClips) == "function" then
		timeline:syncDurationToSoundClips()
	end
	if widget:GetAttribute("MegMoHiddenForMicro") == true and not widget.Enabled then
		refreshSelectedGizmo()
		PerformanceDebugService.finish(perfToken, string.format("Micro active, %d tracks, %d keys", #timeline:getTracks(), timeline:getKeyframeCount()))
		local screenPerfToken = PerformanceDebugService.begin("Render Screen Effects")
		renderScreenEffects()
		PerformanceDebugService.finish(screenPerfToken, "micro")
		local onionPerfToken = PerformanceDebugService.begin("Onion Skin Preview")
		updateOnionSkinPreview(timeline:getCurrentFrame(), false)
		PerformanceDebugService.finish(onionPerfToken, "micro")
		pcall(function()
			require(Modules:WaitForChild("RigHandleOverlayService")).refreshIfEnabled(timeline)
		end)
		return
	end
	local rig = timeline:getRig()
	local rigs = timeline:getRigs()
	local motors = timeline:getMotors()
	local selectedMotor = timeline:getMotorByPath(selectedJointPath)
	local selectedTrack = timeline:getTrackByPath(selectedJointPath)
	local motionRigType = MotionClipService.getRigTypeName(rig) or "R15"
	local effectsViewModel = buildEffectsViewModel()
	local recorder = editorActions._motionRecorder
	local trackballMode = editorActions._persistentTrackballMode or editorActions._requestedTrackballMode
	if editorActions._trackballTool
		and type(editorActions._trackballTool.IsActive) == "function"
		and editorActions._trackballTool:IsActive() then
		trackballMode = editorActions._lastTrackballMode or editorActions._persistentTrackballMode
	end
	refreshSelectedGizmo()

	local rigLabel = "No rig bound"
	if #rigs == 1 and rigs[1] then
		rigLabel = rigs[1].Name
	elseif #rigs &gt; 1 then
		rigLabel = rig and string.format("Using %s (%d rigs)", rig.Name, #rigs) or string.format("%d rigs bound", #rigs)
	end

	local widgetUpdatePerfToken = PerformanceDebugService.begin("WidgetController Update")
	widgetController:update({
		status = message,
		animationName = timeline:getAnimationName(),
		rigName = rigLabel,
		boundRigPath = rig and rig.Parent and rig:GetFullName() or nil,
		currentFrame = timeline:getCurrentFrame(),
		fps = timeline:getFps(),
		durationFrames = timeline:getDurationFrames(),
		looping = timeline:getLooping(),
		priority = timeline:getPriority(),
		keyframeCount = timeline:getKeyframeCount(),
		keyframeFrames = timeline:getKeyframeFrames(),
		trackKeyframesByPath = timeline:getTrackKeyframesByPath(),
		trackSoundClipsByPath = timeline:getSoundClipDataByPath(),
		trackSubtitleClipsByPath = timeline:getSubtitleClipDataByPath(),
		trackFadeClipsByPath = timeline:getFadeClipDataByPath(),
		trackKeyOptionsByPath = timeline:getTrackKeyOptionsByPath(),
		joints = motors,
		tracks = timeline:getTracks(),
		groups = keyframeEditService:getGroups(),
		selectedGroupIds = getSelectedGroupIds(),
		isPlaying = playbackService:getIsPlaying(),
		gizmoMode = gizmoController:getMode(),
		rotateSpace = gizmoController:getRotateSpace(),
		rigPartHighlightEnabled = widgetController._rigPartHighlightEnabled ~= false,
		trackballMode = trackballMode,
		trackballArmed = editorActions._persistentTrackballMode ~= nil,
		workspaceGrabActive = editorActions.isWorkspaceGrabActive
			and editorActions.isWorkspaceGrabActive()
			or false,
		motionRecorder = {
			armed = recorder and recorder:IsArmed() or false,
			recording = recorder and recorder:IsRecording() or false,
		},
		moveSnap = gizmoController:getMoveSnap(),
		rotateSnapDegrees = gizmoController:getRotateSnapDegrees(),
		gizmoSizePercent = gizmoController:getSizePercent(),
		selectedKeyframeFrame = selectedKeyframeFrame,
		selectedKeys = getSelectedKeyRefs(),
		selectedKeyValues = timeline:getTrackKeyValues(getSelectedKeyRefs()),
		selectedTrackPaths = getSelectedTrackPaths(),
		selectedKeyOptions = getSelectedKeyOptions(),
		rigPropertyTrackState = timeline:getRigPropertyTrackState(),
		objectPropertyTrackState = timeline:getObjectPropertyTrackState(),
		selectedJointPath = selectedJointPath,
		importAnimationEntries = importAnimationEntries,
		importBrowserStatus = importBrowserStatus,
		importActionStatus = importActionStatus,
		importBrowserSource = widgetController._importBrowserSource or "Saves",
		selectedJointPartName = selectedMotor and selectedMotor.part1 or (selectedTrack and selectedTrack.name or nil),
		selectedTrackType = selectedTrack and selectedTrack.trackType or nil,
		selectedCameraState = CameraTrackService.getSelectedCameraState(selectedTrack),
		selectedJointTransform = getSelectedJointTransform(),
		onionSkin = {
			enabled = widgetController._onionSkinEnabled == true,
			frameStep = widgetController._onionSkinFrameStep or 5,
		},
		motionMarkers = MotionService.listMotionMarkers(),
		motionPreview = MotionService.getMotionPreviewState(),
		motionRigType = motionRigType,
		motionSegments = motionBuilderState:listSegments({ rigType = motionRigType }),
		motionDefaultClips = motionBuilderState:getDefaultClips(motionRigType),
		motionClipOptionsByMotion = MotionClipService.buildClipOptionsByMotion(ImportService, motionRigType, importAnimationEntries),
		motionRecipeEntries = motionRecipeEntries,
		motionRecipeStatus = motionRecipeStatus,
		selectedMotionRecipeName = selectedMotionRecipeName,
		effects = effectsViewModel,
		faces = widgetController._facesController:getViewModel(),
		theme = {
			currentThemeId = ThemeService.getCurrentThemeId(),
			currentThemeName = ThemeService.getCurrentTheme().name,
			themes = ThemeService.getThemes(),
		},
		autoSave = getAutoSaveViewModel(),
		performanceDebug = PerformanceDebugService.getViewModel({
			trackCount = #timeline:getTracks(),
			keyframeCount = timeline:getKeyframeCount(),
			markerCount = #MotionService.listMotionMarkers(),
			isPlaying = playbackService and playbackService:getIsPlaying() or false,
			isMotionPreviewing = MotionService.getMotionPreviewState().isPreviewing == true,
			buildId = BuildInfo.BUILD_ID,
		}),
	})
	PerformanceDebugService.finish(widgetUpdatePerfToken, string.format("%d tracks, %d keys", #timeline:getTracks(), timeline:getKeyframeCount()))
	PerformanceDebugService.finish(perfToken, string.format("%d tracks, %d keys", #timeline:getTracks(), timeline:getKeyframeCount()))
	local screenPerfToken = PerformanceDebugService.begin("Render Screen Effects")
	renderScreenEffects()
	PerformanceDebugService.finish(screenPerfToken)
	local onionPerfToken = PerformanceDebugService.begin("Onion Skin Preview")
	updateOnionSkinPreview(timeline:getCurrentFrame(), false)
	PerformanceDebugService.finish(onionPerfToken)
	pcall(function()
		require(Modules:WaitForChild("RigHandleOverlayService")).refreshIfEnabled(timeline)
	end)
end

editorActions.toggleTrackEnabled = require(Modules:WaitForChild("TrackEnabledAction")).create({
	timeline = timeline,
	pushUndo = pushUndo,
	refreshUi = refreshUi,
	invalidateTimelineRenderCache = function()
		widgetController:invalidateTimelineRenderCache()
	end,
})

local function markProjectDirty()
	autoSaveState.changeToken += 1
	autoSaveState.lastErrorText = nil
end

local function buildSaveExtra()
	return {
		groups = getGroupSaveData(),
		motionBuilder = getMotionBuilderSaveData(),
		effects = getEffectsSaveData(),
		faces = widgetController._facesController:getSaveData(),
	}
end

local function restoreUiHiddenForPlayback()
	if widget:GetAttribute("MegMoHiddenForPlayback") ~= true then
		return
	end
	widget:SetAttribute("MegMoHiddenForPlayback", nil)
	if widget:GetAttribute("MegMoHiddenForMicro") == true then
		toggleButton:SetActive(false)
		if microController and type(microController.SetActive) == "function" then
			microController.SetActive(true)
			return
		end
		pcall(function()
			local microGui = game:GetService("CoreGui"):FindFirstChild("MegMoMicroFloatingPanel")
			if microGui then
				microGui.Enabled = true
			end
		end)
		return
	end
	widget.Enabled = true
	toggleButton:SetActive(true)
end

playbackService = PlaybackService.new({
	timeline = timeline,
	keyframeEditService = keyframeEditService,
	gizmoController = gizmoController,
	widgetController = widgetController,
	refreshUi = refreshUi,
	refreshBakeStatus = function(message)
		widgetController:updateStatus(message)
	end,
	getTimelineRevision = function()
		return autoSaveState.changeToken
	end,
	renderEffects = renderScreenEffects,
	applyCameraLinks = function(frame)
		CameraTrackService.applyActiveFirstPersonPreview(timeline, frame)
	end,
	prepareAttachments = function(frame)
		local ok, service = pcall(require, Modules:WaitForChild("AttachService"))
		if ok and service and type(service.prepareTimelineState) == "function" then
			service.prepareTimelineState(timeline, frame or timeline:getCurrentFrame())
		end
	end,
	applyAttachments = function(frame)
		local ok, service = pcall(require, Modules:WaitForChild("AttachService"))
		if ok and service and type(service.applyTimelineState) == "function" then
			service.applyTimelineState(timeline, frame or timeline:getCurrentFrame())
		end
	end,
	restoreAttachments = function()
		local ok, service = pcall(require, Modules:WaitForChild("AttachService"))
		if ok and service then
			if type(service.restoreOriginalAttachmentObjects) == "function" then
				service.restoreOriginalAttachmentObjects(timeline)
			elseif type(service.applyTimelineState) == "function" then
				if type(service.prepareTimelineState) == "function" then
					service.prepareTimelineState(timeline, 0)
				end
				service.applyTimelineState(timeline, 0)
			elseif type(service.clearRuntimeAttachments) == "function" then
				service.clearRuntimeAttachments()
			end
		end
	end,
	onStop = function()
		if editorActions._trackballTool and type(editorActions._trackballTool.SetVisualSuppressed) == "function" then
			editorActions._trackballTool:SetVisualSuppressed(false)
		end
		restoreUiHiddenForPlayback()
	end,
	setMotionMarkersVisible = MotionService.setMotionMarkersVisible,
})

do
	local selectedKeyAutoUpdater = require(Modules:WaitForChild("SelectedKeyAutoUpdateService")).new({
		getTimeline = function()
			return timeline
		end,
		getSelectedKeyRefs = getSelectedKeyRefs,
		getIsPlaying = function()
			return playbackService and playbackService:getIsPlaying() or false
		end,
		onTimelineChanged = markProjectDirty,
	})

	game:GetService("RunService").Heartbeat:Connect(function()
		selectedKeyAutoUpdater:Step()
	end)
end

local function setWidgetEnabled(enabled)
	if not enabled
		and widget:GetAttribute("MegMoHiddenForMicro") ~= true
		and type(editorActions.releaseWorkspaceGrab) == "function" then
		editorActions.releaseWorkspaceGrab("Free Grab turned off because the Main workspace closed.", "WorkspaceClosed")
	end
	if not enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
		require(Modules:WaitForChild("ViewportToolCleanupService")).clear({
			editorActions = editorActions,
			gizmoController = gizmoController,
			modules = Modules,
		})
	end
	if enabled then
		widget:SetAttribute("MegMoHiddenForMicro", nil)
		pcall(function()
			local microGui = game:GetService("CoreGui"):FindFirstChild("MegMoMicroFloatingPanel")
			if microGui then
				microGui.Enabled = false
			end
		end)
	end
	widget.Enabled = enabled
	toggleButton:SetActive(enabled)
	if not enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
		pcall(function()
			require(Modules:WaitForChild("RigHandleOverlayService")).clear()
		end)
	end
end

function editorActions.toggleHideDuringPlayback()
	widgetController._hideDuringPlaybackEnabled = not widgetController._hideDuringPlaybackEnabled
	local message = widgetController._hideDuringPlaybackEnabled and "Hide During Playback enabled." or "Hide During Playback disabled."
	if widgetController._hideDuringPlaybackEnabled == true and playbackService:getIsPlaying() then
		widget:SetAttribute("MegMoHiddenForPlayback", true)
		setWidgetEnabled(false)
		message = "Hide During Playback enabled. Plugin hidden while playback continues."
	elseif widget:GetAttribute("MegMoHiddenForPlayback") == true then
		restoreUiHiddenForPlayback()
	end
	refreshUi(message)
	return widgetController._hideDuringPlaybackEnabled, message
end

function editorActions.toggleScreenshotUiHidden()
	local shouldHide = widget:GetAttribute("MegMoHiddenForScreenshot") ~= true
	if shouldHide then
		widget:SetAttribute("MegMoHiddenForScreenshot", true)
		if microController and type(microController.SetScreenshotHidden) == "function" then
			microController.SetScreenshotHidden(true)
		end
		if widget.Enabled then
			setWidgetEnabled(false)
		end
		return true, "7kg2 UI hidden. Press * to show it again."
	end

	widget:SetAttribute("MegMoHiddenForScreenshot", nil)
	if microController and type(microController.SetScreenshotHidden) == "function" then
		microController.SetScreenshotHidden(false)
	end
	if widget:GetAttribute("MegMoHiddenForMicro") == true then
		toggleButton:SetActive(false)
	elseif widget:GetAttribute("MegMoHiddenForPlayback") ~= true then
		setWidgetEnabled(true)
	end
	refreshUi("7kg2 UI shown.")
	return false, "7kg2 UI shown."
end

function editorActions.toggleRigPartHighlight()
	if widgetController._motionBuilderSuspendedViewportPicker == true then
		widgetController._rigPartHighlightEnabled = false
		widgetController._viewportPartPickerSuspended = true
		widgetController._viewportPartPickerArmed = false
		pcall(function()
			toggleButton:SetActive(false)
			plugin:Deactivate()
			require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
			gizmoController:setHandleVisualsHidden(false)
		end)
		refreshUi("Motion Builder is using Studio tools. Return to the timeline to re-enable 7kg2 picking.")
		return false, "Motion Builder is using Studio tools."
	end
	widgetController._rigPartHighlightEnabled = not (widgetController._rigPartHighlightEnabled ~= false)
	widgetController._viewportPartPickerSuspended = false
	pcall(function()
		if widgetController._rigPartHighlightEnabled then
			plugin:Activate(true)
			gizmoController:setHandleVisualsHidden(true)
		else
			require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
			editorActions.syncViewportRigPartPicker()
		end
	end)
	refreshSelectedGizmo()
	refreshUi(widgetController._rigPartHighlightEnabled and "Part picker enabled. Click a rig part in the viewport." or "Part picker disabled.")
	return widgetController._rigPartHighlightEnabled, widgetController._rigPartHighlightEnabled and "Part picker enabled." or "Part picker disabled."
end

function editorActions.toggleSelectionHighlight()
	local enabled, message = require(Modules:WaitForChild("ViewportPartSelectService")).toggleSelectionHighlight()
	refreshUi(message)
	return enabled, message
end

function editorActions.toggleRigHandles()
	local enabled, message = false, "Rig handles unavailable."
	pcall(function()
		local service = require(Modules:WaitForChild("RigHandleOverlayService"))
		enabled = service.toggle()
		if enabled then
			service.refresh(timeline)
		end
		message = enabled and "Rig and bone handles visible." or "Rig and bone handles hidden."
	end)
	refreshUi(message)
	return enabled, message
end

function editorActions.toggleOnionSkin()
	widgetController._onionSkinEnabled = not widgetController._onionSkinEnabled
	if not widgetController._onionSkinEnabled and widgetController._onionSkinService then
		widgetController._onionSkinService:clear()
	end
	refreshUi(widgetController._onionSkinEnabled and "Onion skin enabled." or "Onion skin disabled.")
	return widgetController._onionSkinEnabled, widgetController._onionSkinEnabled and "Onion skin enabled." or "Onion skin disabled."
end

