end)
local function openEffectSetup(effectMode)
	state.quickPhysicsActions.OpenAdvanced(effectMode)
end
local openPhysicsEvent = CoreGui:FindFirstChild("MegMoPhysicsOpenRequest")
if openPhysicsEvent and not openPhysicsEvent:IsA("BindableEvent") then
	openPhysicsEvent:Destroy()
	openPhysicsEvent = nil
end
if not openPhysicsEvent then
	openPhysicsEvent = Instance.new("BindableEvent")
	openPhysicsEvent.Name = "MegMoPhysicsOpenRequest"
	openPhysicsEvent.Archivable = false
	openPhysicsEvent.Parent = CoreGui
end
openPhysicsEvent:SetAttribute("MegMoPhysicsReady", true)
connect(openPhysicsEvent.Event, function(payload)
	if type(payload) ~= "table" or payload.source ~= "MegMoAnimator" then
		return
	end
	state.microPopup = payload.compact == true
	if state.popupInteraction then
		state.popupInteraction:SetEnabled(
			state.microPopup or payload.movable == true,
			state.microPopup and "MegMoMicroPhysicsPopup" or "MegMoMainPhysicsPopup"
		)
	end
	if not state.microPopup and payload.movable ~= true then
		root.Position = UDim2.fromOffset(12, 62)
		root.Size = UDim2.new(0, 430, 1, -78)
	end
	refs.popupGui.Enabled = true
	if type(payload.effectMode) == "string" and payload.effectMode ~= "" then
		openEffectSetup(payload.effectMode)
	else
		state.quickPhysics.visible = true
		state.uiStage = "Setup"
		state.setupPage = "Choose"
		setStatus("Choose a physics effect to open its setup.", THEME.cyan)
		updateUI()
	end
end)
