        <Item class="ModuleScript" referent="RBX107">
          <Properties>
            <string name="Name">SoundKeyframeEditorUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local SoundKeyframeEditorUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local FIELD_ROWS = {
	{ key = "soundId", label = "Sound ID", placeholder = "123456789 or rbxassetid://123456789", row = 0, column = 0 },
	{ key = "volume", label = "Volume", placeholder = "0.5", row = 1, column = 0 },
	{ key = "playbackSpeed", label = "Playback Speed", placeholder = "1", row = 1, column = 1 },
	{ key = "startOffsetSeconds", label = "Start Offset (s)", placeholder = "0", row = 2, column = 0 },
	{ key = "endTrimSeconds", label = "End Trim (s)", placeholder = "0", row = 2, column = 1 },
	{ key = "fadeInSeconds", label = "Fade In (s)", placeholder = "0", row = 3, column = 0 },
	{ key = "fadeOutSeconds", label = "Fade Out (s)", placeholder = "0", row = 3, column = 1 },
	{ key = "rollOffMinDistance", label = "RollOff Min", placeholder = "10", row = 4, column = 0 },
	{ key = "rollOffMaxDistance", label = "RollOff Max", placeholder = "10000", row = 4, column = 1 },
	{ key = "rollOffMode", label = "RollOff Mode", placeholder = "Inverse", row = 5, column = 0 },
}

local function createField(parent, field)
	local x = field.column == 0 and 18 or 268
	local y = 130 + (field.row * 46)
	local width = field.row == 0 and 480 or 230

	local label = create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, x, 0, y),
		Size = UDim2.new(0, width, 0, 16),
		Font = Enum.Font.GothamSemibold,
		Text = field.label,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})

	local input = create("TextBox", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, x, 0, y + 20),
		Size = UDim2.new(0, width, 0, 28),
		Font = Enum.Font.GothamSemibold,
		PlaceholderColor3 = Constants.THEME.MutedText,
		PlaceholderText = field.placeholder,
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})
	createCorner(input, 8)
	createStroke(input)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	return label, input
end

function SoundKeyframeEditorUI.mount(parent, _context)
	if not parent then
		error("SoundKeyframeEditorUI.mount requires parent")
	end

	local refs = {}
	local overlay = create("Frame", {
		Name = "SoundKeyframeEditorOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.34,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 130,
	})

	local card = create("Frame", {
		Name = "SoundKeyframeEditorCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 530, 0, 590),
		ZIndex = 131,
	})
	applySectionSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 14),
		Size = UDim2.new(1, -58, 0, 24),
		Font = Enum.Font.GothamSemibold,
		Text = "Edit Sound Keyframe",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 28, 0, 28),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "x",
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		ZIndex = 132,
	})
	createCorner(closeButton, 8)

	local meta = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 50),
		Size = UDim2.new(1, -36, 0, 70),
		ZIndex = 132,
	})
	applySectionSurface(meta)
	createCorner(meta, 10)
	createStroke(meta)

	local itemLabel = create("TextLabel", {
		Parent = meta,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Track: Sound",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 133,
	})

	local helpLabel = create("TextLabel", {
		Parent = meta,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 30),
		Size = UDim2.new(1, -24, 0, 32),
		Font = Enum.Font.GothamSemibold,
		Text = "Sound keyframes play when playback crosses them. Scrubbing previews settings without playing audio.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 133,
	})

	local inputs = {}
	for _, field in ipairs(FIELD_ROWS) do
		local _, input = createField(card, field)
		inputs[field.key] = input
	end

	local noteLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 420),
		Size = UDim2.new(1, -36, 0, 30),
		Font = Enum.Font.GothamSemibold,
		Text = "Trim and fade values are in audio seconds. Fade In/Out ramps the clip volume during playback and export.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 132,
	})

	local testButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 18, 1, -48),
		Size = UDim2.new(0, 118, 0, 32),
		Text = "Stop At Playhead",
		ZIndex = 132,
	})
	styleGhostButton(testButton)
	createCorner(testButton, 9)

	local previewButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 144, 1, -48),
		Size = UDim2.new(0, 96, 0, 32),
		Text = "Test Play",
		ZIndex = 132,
	})
	styleGhostButton(previewButton)
	createCorner(previewButton, 9)

	local applyButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 248, 1, -48),
		Size = UDim2.new(0, 132, 0, 32),
		Text = "Apply Keyframe",
		ZIndex = 132,
	})
	styleTextButton(applyButton)
	createCorner(applyButton, 9)

	local okButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(1, -132, 1, -48),
		Size = UDim2.new(0, 114, 0, 32),
		Text = "OK",
		ZIndex = 132,
