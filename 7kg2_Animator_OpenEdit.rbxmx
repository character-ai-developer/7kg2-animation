	if compactActionPopup then
		local isHelpPopup = tabName == "Help"
		local isImageActionPopup = tabName == "Edit" or tabName == "Rig" or tabName == "Keyframes"
		local hasManualTimeLength = tabName == "Time"
		local hasDescription = tostring(info.description or "") ~= ""
		local statusHeight = isHelpPopup and 124 or 30
		local actionGridTop = hasDescription and (isHelpPopup and 184 or (hasManualTimeLength and 142 or 88)) or 50
		local actionGridBottomInset = hasDescription and (isHelpPopup and 198 or (hasManualTimeLength and 156 or 102)) or 64
		local compactCellHeight = isImageActionPopup and 76 or (tabName == "Theme" and 45 or 30)
		local statusText = nil
		local setCompactStatus
		if hasDescription then
			statusText = text(popup, {
				Name = "CompactStatus",
				BackgroundColor3 = theme().PanelSoft,
				BackgroundTransparency = 0,
				Font = Enum.Font.GothamMedium,
				Text = isHelpPopup and "Choose a help guide below. The selected guide will appear here." or info.description,
				TextColor3 = theme().MutedText,
				TextSize = 11,
				TextTruncate = isHelpPopup and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
				TextWrapped = isHelpPopup,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = isHelpPopup and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
				Position = UDim2.fromOffset(14, 48),
				Size = UDim2.new(1, -28, 0, statusHeight),
				ZIndex = 73,
			})
			statusText:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
			statusText:SetAttribute("MegMoThemeTextRole", "MutedText")
			corner(statusText, 7)
			padding(statusText, 9)
		end
		setCompactStatus = function(message, fallback)
			local textValue = tostring(message or fallback or "")
			if statusText then
				statusText.Text = textValue ~= "" and textValue or tostring(info.title or tabName)
			end
		end
		local function closeTimePopupAfterDurationSelection()
			if tabName == "Time" and type(onClose) == "function" then
				onClose()
			end
		end

		local manualDurationInput = nil
		local function getTimelineDurationSeconds()
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return nil
			end
			local fps = type(timeline.getFps) == "function" and math.max(1, tonumber(timeline:getFps()) or 60) or 60
			local durationFrames = type(timeline.getDurationFrames) == "function" and math.max(1, tonumber(timeline:getDurationFrames()) or 1) or 1
			return durationFrames / fps
		end
		local function parseManualDurationFrames(inputText)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return nil, "No timeline is available."
			end
			local fps = type(timeline.getFps) == "function" and math.max(1, tonumber(timeline:getFps()) or 60) or 60
			local textValue = string.lower(tostring(inputText or "")):gsub("^%s+", ""):gsub("%s+$", "")
			if textValue == "" then
				return nil, "Enter an animation length."
			end
			local frameText = textValue:match("^([%d%.]+)%s*f$")
				or textValue:match("^([%d%.]+)%s*frames?$")
			if frameText then
				local frames = tonumber(frameText)
				if frames and frames &gt; 0 then
					return math.max(1, math.floor(frames + 0.5)), nil
				end
			end
			local secondsText = textValue:match("^([%d%.]+)%s*s?$")
				or textValue:match("^([%d%.]+)%s*seconds?$")
			if secondsText then
				local seconds = tonumber(secondsText)
				if seconds and seconds &gt; 0 then
					return math.max(1, math.floor((seconds * fps) + 0.5)), nil
				end
			end
			local minutes, seconds = textValue:match("^(%d+):([%d%.]+)$")
			if minutes and seconds then
				local totalSeconds = (tonumber(minutes) or 0) * 60 + (tonumber(seconds) or 0)
				if totalSeconds &gt; 0 then
					return math.max(1, math.floor((totalSeconds * fps) + 0.5)), nil
				end
			end
			return nil, "Use seconds, frames, or mm:ss, for example 7.5, 180f, or 1:30."
		end
		local function applyManualDuration()
			local frameCount, parseMessage = parseManualDurationFrames(manualDurationInput and manualDurationInput.Text or "")
			if not frameCount then
				setCompactStatus(parseMessage, "Invalid animation length.")
				return
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			local fps = timeline and type(timeline.getFps) == "function" and math.max(1, tonumber(timeline:getFps()) or 60) or 60
			local ok = runOption(options, "onDurationChanged", "durationChanged", frameCount)
			if not ok and timeline and type(timeline.setDurationFrames) == "function" then
				timeline:setDurationFrames(frameCount)
			end
			local seconds = frameCount / fps
			if manualDurationInput then
				manualDurationInput.Text = string.format("%.2f", seconds):gsub("0+$", ""):gsub("%.$", "")
			end
			setCompactStatus(string.format("Animation length set to %.2f seconds (%d frames).", seconds, frameCount), "Animation length updated.")
			if type(onAfterAction) == "function" then
				onAfterAction()
			end
			closeTimePopupAfterDurationSelection()
		end

		if hasManualTimeLength then
			local lengthRow = make("Frame", {
				Name = "ManualDurationRow",
				BackgroundColor3 = theme().PanelSoft,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(14, 86),
				Size = UDim2.new(1, -28, 0, 42),
				ZIndex = 73,
			}, popup)
			lengthRow:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
			corner(lengthRow, 7)
			stroke(lengthRow, theme().Border, 0.45, 1, "Border")
			text(lengthRow, {
				Name = "ManualDurationLabel",
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamSemibold,
				Text = "Animation Length",
				TextColor3 = theme().Text,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(0, 130, 1, 0),
				ZIndex = 74,
			})
			manualDurationInput = make("TextBox", {
				Name = "ManualDurationInput",
				BackgroundColor3 = theme().Panel,
				BorderSizePixel = 0,
				ClearTextOnFocus = false,
				Font = Enum.Font.Gotham,
				PlaceholderText = "Seconds",
				Text = string.format("%.2f", getTimelineDurationSeconds() or 5):gsub("0+$", ""):gsub("%.$", ""),
				TextColor3 = ThemeService.getReadableTextColor(theme().Panel),
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 142, 0, 8),
				Size = UDim2.new(1, -236, 0, 26),
				ZIndex = 74,
			}, lengthRow)
			manualDurationInput:SetAttribute("MegMoThemeBackgroundRole", "Panel")
			manualDurationInput:SetAttribute("MegMoThemeTextRole", "__auto")
			corner(manualDurationInput, 6)
			padding(manualDurationInput, 8)
			local applyDurationButton = button(lengthRow, "Apply", theme().Accent)
			applyDurationButton.Name = "ApplyManualDurationButton"
			applyDurationButton.AnchorPoint = Vector2.new(1, 0)
			applyDurationButton.Position = UDim2.new(1, -8, 0, 8)
			applyDurationButton.Size = UDim2.fromOffset(78, 26)
			applyDurationButton.TextSize = 11
			applyDurationButton.ZIndex = 74
			applyDurationButton.MouseButton1Click:Connect(applyManualDuration)
			manualDurationInput.FocusLost:Connect(function(enterPressed)
				if enterPressed then
					applyManualDuration()
				end
			end)
		end

		local actionGrid = make("ScrollingFrame", {
			Name = "CompactActionGrid",
			Active = true,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			Position = UDim2.fromOffset(14, actionGridTop),
			ScrollBarImageColor3 = theme().Border,
			ScrollBarThickness = 5,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Size = UDim2.new(1, -28, 1, -actionGridBottomInset),
			ZIndex = 73,
		}, popup)
		blockClickThrough(actionGrid)
		local actionCount = info.actions and #info.actions or 0
		local columns = actionCount &lt;= 4 and 2 or 3
		if isImageActionPopup then
			columns = 3
		end
		if tabName == "Enhance" then
			columns = 4
		end
		local cellWidth = columns == 2 and 0.5 or 0.333
		if columns == 4 then
			cellWidth = 0.25
		end
		make("UIGridLayout", {
			CellPadding = UDim2.fromOffset(8, 8),
			CellSize = UDim2.new(cellWidth, -6, 0, compactCellHeight),
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
		}, actionGrid)
		make("UIPadding", {
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 2),
			PaddingLeft = UDim.new(0, 2),
			PaddingRight = UDim.new(0, 8),
		}, actionGrid)

		local dropdownLayer = make("Frame", {
			Name = "CompactDropdownLayer",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 90,
		}, popup)
		blockClickThrough(dropdownLayer)
		local compactToolHint = gui and gui:FindFirstChild("ToolHint") or nil

		for index, actionName in ipairs(info.actions or {}) do
			local actionColor = MicroParityPopupSupport.getActionButtonColor(tabName, actionName)
			if tabName == "Keyframes" then
				actionColor = theme().PanelSoft
			end
			local actionButton = button(actionGrid, MicroWidgetController._getCompactActionButtonText(tabName, actionName, options), actionColor or (index == 1 and theme().Accent or theme().PanelSoft))
			if actionColor then
				actionButton:SetAttribute("MegMoPreserveColor", true)
				actionButton:SetAttribute("MegMoThemeBackgroundRole", nil)
				actionButton.BackgroundColor3 = actionColor
				actionButton.TextColor3 = ThemeService.getReadableTextColor(actionColor)
				local overlayLabel = actionButton:FindFirstChild("MegMoButtonTextOverlay")
				if overlayLabel and overlayLabel:IsA("TextLabel") then
					overlayLabel.TextColor3 = actionButton.TextColor3
				end
				local actionStroke = actionButton:FindFirstChild("MegMoButtonStroke")
				if actionStroke and actionStroke:IsA("UIStroke") then
					actionStroke.Color = actionColor:Lerp(actionButton.TextColor3, 0.3)
					actionStroke:SetAttribute("MegMoThemeStrokeRole", nil)
					actionStroke:SetAttribute("MegMoPreserveColor", true)
				end
			end
			actionButton.TextSize = 11
			actionButton.TextTruncate = Enum.TextTruncate.AtEnd
			actionButton.ZIndex = 74
			if isImageActionPopup then
				local actionIconImage = getMicroActionIconImage(tabName, actionName)
				actionButton.Text = actionIconImage and "" or MicroWidgetController._getCompactActionButtonText(tabName, actionName, options)
				actionButton.TextTransparency = actionIconImage and 1 or 0
				if actionIconImage then
					MicroWidgetController._prepareCompactImageButton(actionButton)
					local actionIcon = make("ImageLabel", {
						Name = "CompactActionIcon",
						AnchorPoint = Vector2.new(0.5, 0),
						BackgroundTransparency = 1,
						Image = actionIconImage,
						ImageColor3 = tabName == "Keyframes" and theme().Accent or ThemeService.getReadableTextColor(actionButton.BackgroundColor3),
						Position = UDim2.new(0.5, 0, 0, 8),
						ScaleType = Enum.ScaleType.Fit,
						Size = UDim2.fromOffset(28, 28),
						ZIndex = 75,
					}, actionButton)
					actionIcon:SetAttribute("MegMoThemeImageRole", "__auto")
					local actionLabel = text(actionButton, {
						Name = "CompactActionLabel",
						Font = Enum.Font.GothamBold,
						Text = MicroWidgetController._getCompactActionButtonText(tabName, actionName, options),
						TextColor3 = ThemeService.getReadableTextColor(actionButton.BackgroundColor3),
						TextSize = 11,
						TextTruncate = Enum.TextTruncate.AtEnd,
						TextXAlignment = Enum.TextXAlignment.Center,
						TextYAlignment = Enum.TextYAlignment.Center,
						Position = UDim2.fromOffset(6, 42),
						Size = UDim2.new(1, -12, 0, 24),
						ZIndex = 75,
					})
					actionLabel:SetAttribute("MegMoThemeTextRole", "__auto")
					if tabName == "Keyframes" then
						MicroWidgetController._styleKeyframeActionStroke(actionButton)
					end
				end
			end
			local tooltipText = MicroWidgetController._getCompactActionTooltipText(info, actionName)
			if compactToolHint and tooltipText ~= "" then
				MicroWidgetController._attachMicroSimpleTooltip(actionButton, compactToolHint, tooltipText)
			end
			actionButton.MouseButton1Click:Connect(function()
				if compactToolHint then
					compactToolHint.Visible = false
				end
				local dropdownSpec = info.dropdowns and info.dropdowns[actionName]
				if dropdownSpec then
					if dropdownLayer.Visible and dropdownLayer:GetAttribute("MegMoOpenAction") == tostring(actionName) then
						MicroWidgetController._clearCompactDropdown(dropdownLayer)
						return
					end
					MicroWidgetController._showCompactActionDropdown(dropdownLayer, popup, actionButton, info, tabName, actionName, dropdownSpec, options, setCompactStatus, onAfterAction)
					return
				end
				MicroWidgetController._clearCompactDropdown(dropdownLayer)
				local didRun, result = runMicroAction(tabName, actionName, options, nil)
				if didRun then
					setCompactStatus(result, actionName .. " sent to 7kg2.")
					if type(onAfterAction) == "function" then
						onAfterAction()
					end
					if actionName == "15 sec" or actionName == "30 sec" or actionName == "60 sec" then
						closeTimePopupAfterDurationSelection()
					end
				else
					setCompactStatus(result, actionName .. " is not available in Micro yet.")
				end
			end)
		end

		local resizeGrip = make("ImageButton", {
			Name = "ResizeGrip",
			Active = true,
			AnchorPoint = Vector2.new(1, 1),
			AutoButtonColor = false,
			BackgroundColor3 = theme().PanelSoft,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = "rbxassetid://104703373565023",
			ImageColor3 = theme().Text,
			ImageTransparency = 1,
			Position = UDim2.new(1, -5, 1, -5),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(16, 16),
			ZIndex = 80,
		}, popup)
		resizeGrip:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		resizeGrip:SetAttribute("MegMoThemeImageRole", "Text")
		corner(resizeGrip, 4)
		blockClickThrough(resizeGrip)

		local gripResizing = false
		local function setResizeGripVisible(visible)
			resizeGrip.BackgroundTransparency = visible and 0.42 or 1
			resizeGrip.ImageTransparency = visible and 0.08 or 1
		end
		resizeGrip.MouseEnter:Connect(function()
			setResizeGripVisible(true)
		end)
		resizeGrip.MouseLeave:Connect(function()
			if gripResizing then
				return
			end
			setResizeGripVisible(false)
		end)
		MicroWidgetController._makeResizable(resizeGrip, popup, function(isResizing)
			gripResizing = isResizing
			setResizeGripVisible(isResizing)
			popupStroke.Color = isResizing and Color3.fromRGB(58, 176, 255) or theme().Accent
			popupStroke.Transparency = isResizing and 0 or 0.12
			popupStroke.Thickness = isResizing and 2 or 1
			if not isResizing then
				saveGeometry(plugin, popupSettingPrefix, popup)
			end
		end, minPopupSize, maxPopupSize)

		close.MouseButton1Click:Connect(function()
			if type(onClose) == "function" then
				onClose()
			end
		end)

		ThemeService.applyToGui(popup)
		UiMotion.popupIn(popup)
		return popup
	end

	local content = make("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 48),
		Size = UDim2.new(1, -28, 1, -62),
		ZIndex = 72,
	}, popup)
	blockClickThrough(content)

	text(content, {
		Name = "Description",
		Text = info.description,
		TextColor3 = theme().MutedText,
		TextSize = 12,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 42),
		ZIndex = 73,
	})

	local card = make("Frame", {
		Name = "MicroToolCard",
		BackgroundColor3 = theme().PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 0, 132),
		ZIndex = 73,
	}, content)
	setBackgroundRole(card, "PanelAlt")
	UiHelpers.applySectionSurface(card)
	blockClickThrough(card)
	corner(card, 7)
	stroke(card, theme().Border, 0.45, 1, "Border")

	local statusText = text(card, {
		Name = "Status",
		Text = tabName == "Settings" and getMicroProjectSummary(options) or "Choose a quick action below. Micro keeps the viewport clear while using 7kg2 tools.",
		TextColor3 = theme().MutedText,
		TextSize = 12,
		TextWrapped = true,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.new(1, -24, 0, 32),
		ZIndex = 74,
	})

	local itemLabels = {}
	local importIdBox = nil
	local importBrowserLabel = nil
	local cutsceneTriggerBox = nil
	local cutsceneDelayBox = nil
	local syncCutsceneInputs = nil
	local refreshPopupState = function() end
	local function setDetailRows(items)
		items = items or info.items or {}
		for index, label in ipairs(itemLabels) do
			label.Text = items[index] or ""
		end
	end

	if tabName == "Settings" then
		text(card, {
			Name = "ProjectNameLabel",
			Text = "Project",
			TextColor3 = theme().MutedText,
			TextSize = 10,
			Position = UDim2.fromOffset(12, 50),
			Size = UDim2.fromOffset(52, 22),
			ZIndex = 75,
		})
		local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
		local projectNameBox = make("TextBox", {
			Name = "ProjectNameBox",
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Untitled Animation",
			Text = timeline and type(timeline.getAnimationName) == "function" and tostring(timeline:getAnimationName() or "") or "",
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(68, 48),
			Size = UDim2.new(1, -80, 0, 24),
			ZIndex = 75,
		}, card)
		projectNameBox:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		projectNameBox:SetAttribute("MegMoThemeTextRole", "__auto")
		corner(projectNameBox, 5)
		padding(projectNameBox, 7)
		projectNameBox.FocusLost:Connect(function()
			local currentTimeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if currentTimeline and type(currentTimeline.renameAnimation) == "function" then
				currentTimeline:renameAnimation(projectNameBox.Text)
				refreshPopupState()
				if type(onAfterAction) == "function" then
					onAfterAction()
				end
			end
		end)
		local settingsBadgeRow = make("Frame", {
			Name = "SettingsBadgeRow",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 84),
			Size = UDim2.new(1, -24, 0, 28),
			ZIndex = 75,
		}, card)
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}, settingsBadgeRow)
		local function settingsBadge(name)
			local badge = text(settingsBadgeRow, {
				Name = name .. "Badge",
				BackgroundTransparency = 0,
				BackgroundColor3 = theme().PanelSoft,
				Text = name,
				TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(0.25, -5, 0, 24),
				ZIndex = 76,
			})
			badge:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
			badge:SetAttribute("MegMoThemeTextRole", "__auto")
			corner(badge, 5)
			return badge
		end
		local fpsBadge = settingsBadge("FPS")
		local lengthBadge = settingsBadge("Length")
		local loopBadge = settingsBadge("Loop")
		local priorityBadge = settingsBadge("Priority")
		refreshPopupState = function()
			local currentTimeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			statusText.Text = getMicroProjectSummary(options)
			if currentTimeline and type(currentTimeline.getAnimationName) == "function" then
				projectNameBox.Text = tostring(currentTimeline:getAnimationName() or projectNameBox.Text)
			end
			local fps = currentTimeline and type(currentTimeline.getFps) == "function" and math.max(1, tonumber(currentTimeline:getFps()) or 60) or 60
			local durationFrames = currentTimeline and type(currentTimeline.getDurationFrames) == "function" and math.max(1, tonumber(currentTimeline:getDurationFrames()) or 1) or 1
			fpsBadge.Text = tostring(fps) .. " FPS"
			lengthBadge.Text = string.format("%.1fs", durationFrames / fps)
			loopBadge.Text = currentTimeline and type(currentTimeline.getLooping) == "function" and (currentTimeline:getLooping() and "Loop On" or "Loop Off") or "Loop"
			priorityBadge.Text = currentTimeline and type(currentTimeline.getPriority) == "function" and tostring(currentTimeline:getPriority() or "Action") or "Action"
		end
		refreshPopupState()
	elseif tabName == "Presets" then
		text(card, {
			Name = "ImportIdLabel",
			Text = "Animation ID / URL",
			TextColor3 = theme().MutedText,
			TextSize = 10,
			Position = UDim2.fromOffset(12, 48),
			Size = UDim2.fromOffset(116, 20),
			ZIndex = 75,
		})
		importIdBox = make("TextBox", {
			Name = "ImportIdBox",
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Paste Animation ID or URL",
			Text = "",
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(12, 68),
			Size = UDim2.new(1, -24, 0, 25),
			ZIndex = 75,
		}, card)
		importIdBox:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		importIdBox:SetAttribute("MegMoThemeTextRole", "__auto")
		corner(importIdBox, 5)
		padding(importIdBox, 7)
		importBrowserLabel = text(card, {
			Name = "ImportBrowserStatus",
			Text = getMicroImportBrowserStatus(options) or "Load Saves, Roblox Starter, or My Animations to show quick entries here.",
			TextColor3 = theme().MutedText,
			TextSize = 10,
			TextWrapped = true,
			Position = UDim2.fromOffset(12, 100),
			Size = UDim2.new(1, -24, 0, 24),
			ZIndex = 75,
		})
		refreshPopupState = function()
			if importBrowserLabel then
				importBrowserLabel.Text = getMicroImportBrowserStatus(options) or importBrowserLabel.Text
			end
		end
	elseif tabName == "Export" then
		local cutsceneOptions = getMicroCutsceneOptions(options)
		text(card, {
			Name = "TriggerPathLabel",
			Text = "Touch Part Path",
			TextColor3 = theme().MutedText,
			TextSize = 10,
			Position = UDim2.fromOffset(12, 48),
			Size = UDim2.fromOffset(120, 20),
			ZIndex = 75,
		})
		cutsceneTriggerBox = make("TextBox", {
			Name = "TriggerPartPathBox",
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Workspace.CutsceneTrigger",
			Text = tostring(cutsceneOptions.triggerPartPath or "Workspace.CutsceneTrigger"),
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(12, 68),
			Size = UDim2.new(1, -24, 0, 25),
			ZIndex = 75,
		}, card)
		cutsceneTriggerBox:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		cutsceneTriggerBox:SetAttribute("MegMoThemeTextRole", "__auto")
		corner(cutsceneTriggerBox, 5)
		padding(cutsceneTriggerBox, 7)
		text(card, {
			Name = "DelayLabel",
			Text = "Delay seconds",
			TextColor3 = theme().MutedText,
			TextSize = 10,
			Position = UDim2.fromOffset(12, 98),
			Size = UDim2.fromOffset(120, 20),
			ZIndex = 75,
		})
		cutsceneDelayBox = make("TextBox", {
			Name = "DelaySecondsBox",
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "0",
			Text = tostring(cutsceneOptions.delaySeconds or 0),
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 118, 0, 96),
			Size = UDim2.new(1, -130, 0, 25),
			ZIndex = 75,
		}, card)
		cutsceneDelayBox:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		cutsceneDelayBox:SetAttribute("MegMoThemeTextRole", "__auto")
		corner(cutsceneDelayBox, 5)
		padding(cutsceneDelayBox, 7)
		syncCutsceneInputs = function()
			local currentOptions = getMicroCutsceneOptions(options)
			currentOptions.triggerPartPath = trimText(cutsceneTriggerBox.Text)
			if currentOptions.triggerPartPath == "" then
				currentOptions.triggerPartPath = "Workspace.CutsceneTrigger"
				cutsceneTriggerBox.Text = currentOptions.triggerPartPath
			end
			currentOptions.delaySeconds = math.max(0, tonumber(cutsceneDelayBox.Text) or 0)
			cutsceneDelayBox.Text = tostring(currentOptions.delaySeconds)
		end
		cutsceneTriggerBox.FocusLost:Connect(syncCutsceneInputs)
		cutsceneDelayBox.FocusLost:Connect(syncCutsceneInputs)
		refreshPopupState = function()
			syncCutsceneInputs()
			statusText.Text = "Cutscene: " .. describeMicroCutsceneOptions(options)
		end
	else
		for index, item in ipairs(info.items or {}) do
			local itemRow = make("Frame", {
				Name = "Item" .. tostring(index),
				BackgroundColor3 = theme().PanelSoft,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(12, 48 + ((index - 1) * 32)),
				Size = UDim2.new(1, -24, 0, 26),
				ZIndex = 74,
			}, card)
			setBackgroundRole(itemRow, "PanelSoft")
			blockClickThrough(itemRow)
			corner(itemRow, 5)

			local dot = make("Frame", {
				Name = "Dot",
				AnchorPoint = Vector2.new(0, 0.5),
				BackgroundColor3 = theme().Accent,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(9, 13),
				Size = UDim2.fromOffset(5, 5),
				ZIndex = 75,
			}, itemRow)
			dot:SetAttribute("MegMoThemeBackgroundRole", "Accent")

			itemLabels[index] = text(itemRow, {
				Name = "Text",
				Text = item,
				TextColor3 = theme().Text,
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Position = UDim2.fromOffset(22, 0),
				Size = UDim2.new(1, -30, 1, 0),
				ZIndex = 75,
			})
		end
	end

	if tabName == "Export" then
		local previousRefresh = refreshPopupState
		statusText.Text = "Cutscene: " .. describeMicroCutsceneOptions(options)
		refreshPopupState = function()
			previousRefresh()
			statusText.Text = "Cutscene: " .. describeMicroCutsceneOptions(options)
		end
	end

	local function collectActions()
		local actions = {}
		for _, actionName in ipairs(info.actions or {}) do
			actions[#actions + 1] = {
				label = actionName,
				actionName = actionName,
				details = info.actionDetails and info.actionDetails[actionName] or nil,
			}
		end
		if tabName == "Faces" then
			local facePresets = getMicroFacePresets(options)
			if #facePresets &gt; 0 then
				statusText.Text = "Pick a saved face preset below to apply it at the current playhead."
				for index = 1, math.min(#facePresets, 6) do
					local preset = facePresets[index]
					local presetName = tostring(preset.Name or ("Face " .. tostring(index)))
					actions[#actions + 1] = {
						label = presetName,
						actionName = "__FacePreset",
						presetId = preset.Id,
						details = {
							"Apply '" .. presetName .. "' at the current playhead.",
							"Creates or updates the Head face track automatically.",
							"Works with single, both-eyes, and layered face presets.",
						},
					}
				end
			else
				statusText.Text = "No saved face presets yet. Create one from the Faces popup first."
			end
		elseif tabName == "Presets" then
			local entries = getMicroImportEntries(options)
			if #entries &gt; 0 then
				for index = 1, math.min(#entries, 7) do
					local entry = entries[index]
					local entryName = tostring(entry.name or entry.title or entry.id or ("Entry " .. tostring(index)))
					if entry.entryType == "LoadMoreMyAnimations" then
						entryName = "Load More"
					end
					actions[#actions + 1] = {
						label = entryName,
						actionName = "__ImportEntry",
						importEntry = entry,
						details = {
							"Import or open '" .. entryName .. "'.",
							"Uses the same importer as the full workspace.",
							"Keys are placed using the current import rules.",
						},
					}
				end
			end
		end
		return actions
	end
	local actions = collectActions()
	local denseActions = tabName == "Presets" or tabName == "Export" or #actions &gt; 8
	local actionGrid = make("ScrollingFrame", {
		Name = "ActionGrid",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.fromOffset(0, denseActions and 190 or 202),
		ScrollBarImageColor3 = theme().Border,
		ScrollBarThickness = 5,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, -102, 1, denseActions and -232 or -244),
		ZIndex = 73,
	}, content)
	blockClickThrough(actionGrid)
	make("UIGridLayout", {
		CellPadding = UDim2.fromOffset(6, 6),
		CellSize = denseActions and UDim2.new(0.333, -5, 0, 20) or UDim2.new(0.5, -4, 0, 26),
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, actionGrid)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 8),
	}, actionGrid)

	local actionButtons = {}
	local function setActionActive(activeButton)
		for _, actionButton in ipairs(actionButtons) do
			actionButton.BackgroundColor3 = actionButton == activeButton and theme().Accent or theme().PanelSoft
			actionButton.TextColor3 = ThemeService.getReadableTextColor(actionButton.BackgroundColor3)
		end
	end

	local function renderActionButtons()
		for _, child in ipairs(actionGrid:GetChildren()) do
			if child:IsA("GuiButton") then
				child:Destroy()
			end
		end
		actionButtons = {}
		actions = collectActions()
		for index, actionEntry in ipairs(actions) do
			local actionName = actionEntry.label or actionEntry.actionName
			local actionButton = button(
				actionGrid,
				actionName,
				index == 1 and theme().Accent or theme().PanelSoft
			)
			actionButtons[#actionButtons + 1] = actionButton
			actionButton.TextSize = 11
			actionButton.TextTruncate = Enum.TextTruncate.AtEnd
			actionButton.ZIndex = 74
			actionButton.MouseButton1Click:Connect(function()
				setActionActive(actionButton)
				statusText.Text = actionName .. " compact workflow"
				setDetailRows(actionEntry.details or info.items)
				local didRun, result
				if actionEntry.actionName == "__FacePreset" then
					didRun, result = runMicroFacePreset(options, actionEntry.presetId)
				elseif actionEntry.actionName == "__ImportEntry" then
					didRun, result = runMicroImportEntry(options, actionEntry.importEntry)
				else
					if syncCutsceneInputs then
						syncCutsceneInputs()
					end
					local payload = tabName == "Presets" and actionEntry.actionName == "Import ID" and importIdBox and importIdBox.Text or nil
					didRun, result = runMicroAction(tabName, actionEntry.actionName or actionName, options, payload)
				end
				if didRun then
					refreshPopupState()
					if tabName == "Presets" then
						task.defer(renderActionButtons)
						task.delay(0.8, function()
							if popup.Parent then
								refreshPopupState()
								renderActionButtons()
							end
						end)
						task.delay(2.0, function()
							if popup.Parent then
								refreshPopupState()
								renderActionButtons()
							end
						end)
					end
					statusText.Text = tabName == "Settings" and getMicroProjectSummary(options) or tostring(result or (actionName .. " sent to 7kg2."))
					if type(onAfterAction) == "function" then
						onAfterAction()
					end
					if tabName == "Presets"
						and type(onClose) == "function"
						and (actionEntry.actionName == "__ImportEntry"
							or actionEntry.actionName == "Import ID"
							or actionEntry.actionName == "Selected") then
						task.defer(onClose)
					end
				else
					statusText.Text = tostring(result or (actionName .. " is not available in Micro yet."))
				end
			end)
		end
	end
	renderActionButtons()

	local closeButton = button(content, "Close", theme().PanelSoft)
	closeButton.AnchorPoint = Vector2.new(1, 1)
	closeButton.Position = UDim2.new(1, 0, 1, 0)
	closeButton.Size = UDim2.fromOffset(90, 28)
	closeButton.ZIndex = 73

	local resizeGrip = make("ImageButton", {
		Name = "ResizeGrip",
		Active = true,
		AnchorPoint = Vector2.new(1, 1),
		AutoButtonColor = false,
		BackgroundColor3 = theme().PanelSoft,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = "rbxassetid://104703373565023",
		ImageColor3 = theme().Text,
		ImageTransparency = 1,
		Position = UDim2.new(1, -5, 1, -5),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(16, 16),
		ZIndex = 80,
	}, popup)
	resizeGrip:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	resizeGrip:SetAttribute("MegMoThemeImageRole", "Text")
	corner(resizeGrip, 4)
	blockClickThrough(resizeGrip)

	local gripResizing = false
	local function setResizeGripVisible(visible)
		resizeGrip.BackgroundTransparency = visible and 0.42 or 1
		resizeGrip.ImageTransparency = visible and 0.08 or 1
	end
	resizeGrip.MouseEnter:Connect(function()
		setResizeGripVisible(true)
	end)
	resizeGrip.MouseLeave:Connect(function()
		if gripResizing then
			return
		end
		setResizeGripVisible(false)
	end)
	MicroWidgetController._makeResizable(resizeGrip, popup, function(isResizing)
		gripResizing = isResizing
		setResizeGripVisible(isResizing)
		popupStroke.Color = isResizing and Color3.fromRGB(58, 176, 255) or theme().Accent
		popupStroke.Transparency = isResizing and 0 or 0.12
		popupStroke.Thickness = isResizing and 2 or 1
		if not isResizing then
			saveGeometry(plugin, popupSettingPrefix, popup)
		end
	end, MICRO_POPUP_MIN_SIZE, MAX_PANEL_SIZE)

	close.MouseButton1Click:Connect(function()
		if type(onClose) == "function" then
			onClose()
		end
	end)
	closeButton.MouseButton1Click:Connect(function()
		if type(onClose) == "function" then
			onClose()
		end
	end)

	ThemeService.applyToGui(popup)
	UiMotion.popupIn(popup)
	return popup
end

function MicroWidgetController.createToolbarButton(plugin, toolbar, constants)
	local icon = "rbxassetid://107452252831027"
	local tooltip = "Open compact floating 7kg2 panel"
	local function tryCreateButton(targetToolbar, buttonId)
		if not targetToolbar then
			return nil, "toolbar unavailable"
		end
		local ok, result = pcall(function()
			return targetToolbar:CreateButton(buttonId, tooltip, icon, "Micro")
		end)
		if ok and result then
			pcall(function()
				result.ClickableWhenViewportHidden = true
			end)
			return result
		end
		return nil, tostring(result)
	end

	for _, buttonId in ipairs({
		"OpenMegMoMicro",
		"OpenMegMoMicroCompact",
		"OpenMegMoMicro_" .. tostring(math.floor((os.clock() or 0) * 100000)),
	}) do
		local button = tryCreateButton(toolbar, buttonId)
		if button then
			return button
		end
	end

	local microToolbar = nil
	pcall(function()
		microToolbar = plugin:CreateToolbar("7kg2 Micro")
	end)
	for _, buttonId in ipairs({
		"OpenMegMoMicroFallback",
		"OpenMegMoMicroFallbackCompact",
		"OpenMegMoMicroFallback_" .. tostring(math.floor((os.clock() or 0) * 100000)),
	}) do
		local button = tryCreateButton(microToolbar, buttonId)
		if button then
			return button
		end
	end

	warn("[7kg2 Micro] Toolbar button creation failed for all button IDs.")
	return nil
end

function MicroWidgetController.attach(options)
	if not ENABLE_MICRO_FLOATING_PANEL then
		return nil
	end

	options = options or {}
	local plugin = options.plugin
	local toolbar = options.toolbar
	local constants = options.constants
	if not plugin or not toolbar or not constants then
		return nil
	end

	local toolbarButton = MicroWidgetController.createToolbarButton(plugin, toolbar, constants)
	if not toolbarButton then
		return nil
	end
	toolbarButton.ClickableWhenViewportHidden = true

	local gui
	local panel
	local featurePopup
	local timeBadge
	local frameBadge
	local statusLabel
	local renderMiniTimeline
	local setMicroTab
	local activeTab = "Timeline"
	setSettingString(plugin, ACTIVE_TAB_SETTING, activeTab)
	local closed = false
	local appliedThemeSignature = nil
	local microActive = false
	local closeFeaturePopup
	local refreshMicroEditors
	local buildMicroEditorViewModel
	local openMicroSelectedOptions
	local updateMicroViewportToolState
	local setRadialMenuOpen
	local updateRadialDockPlacement
	local microUiHost = {}
	microUiHost._callbacks = options or {}
	local microUiConnections = {}
	local keyboardInputConnection
	local keyboardInputEndedConnection
	local pluginMouseKeyConnection
	local pluginMouseKeyEndedConnection
	local microShiftSelection = MicroShiftSelectionSupport.new({
		plugin = plugin,
		isActive = function()
			return microActive and gui and gui.Enabled
		end,
	})
	options._microShiftSelection = microShiftSelection

	local function disconnectMicroUiConnections()
		for index = #microUiConnections, 1, -1 do
			local connection = microUiConnections[index]
			if connection then
				pcall(function()
					connection:Disconnect()
				end)
			end
			microUiConnections[index] = nil
		end
	end

	local function setActive(active)
		active = active == true
		if active then
			microUiHost._screenshotHidden = false
		end
		if not active and type(microUiHost.closePopupSurfaces) == "function" then
			microUiHost.closePopupSurfaces()
		end
		if active then
			safeCall(options.onOpenMicro)
		end
		microActive = active
		toolbarButton:SetActive(active)
		if gui then
			gui.Enabled = active and microUiHost._screenshotHidden ~= true
		end
		if active then
			pcall(function()
				plugin:Activate(true)
			end)
		else
			options._microFrameStepShortcutDown = nil
			MicroWidgetController._releaseMicroTimelineOwnership(options, statusLabel, nil, false)
		end
	end

	options.onBeforeOpenFull = function()
		setActive(false)
	end
	options.onCloseMicroWorkspace = function()
		safeCall(options.onCloseMicro)
		setActive(false)
		return true, "Micro workspace closed."
	end
	options.onRequestCloseMicroWorkspace = function()
		if microUiHost._preferencePopups and type(microUiHost._preferencePopups.openClosePrompt) == "function" then
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("preferences")
			end
			microUiHost._preferencePopups.openClosePrompt()
			return true, "Close prompt opened."
		end
		return options.onCloseMicroWorkspace()
	end

	local function refresh()
		if not timeBadge or not frameBadge or not statusLabel then
			return
		end
		if gui then
			local signature = getThemeSignature()
			if signature ~= appliedThemeSignature then
				appliedThemeSignature = signature
				ThemeService.applyToGui(gui)
				FontPreviewService.apply(gui, FontPreviewService.getCurrentFontName())
			end
		end
		local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
		if microUiHost._projectTitleLabel then
			local projectName = "Untitled Animation"
			if timeline and type(timeline.getAnimationName) == "function" then
				projectName = tostring(timeline:getAnimationName() or projectName)
			end
			microUiHost._projectTitleLabel.Text = projectName ~= "" and projectName or "Untitled Animation"
		end
		timeBadge.Text = getTimelineLabel(timeline, options)
		frameBadge.Text = getTimelineFrameLabel(timeline, options)
		statusLabel.Text = ""
		local playbackActive = isMicroPlaybackActive(options)
		if microUiHost._playButton then
			MicroWidgetController._setMicroCenteredButtonIcon(microUiHost._playButton, playbackActive and "Pause" or "Play", 18)
		end
		local editorState = type(options.getEditorState) == "function" and (options.getEditorState() or {}) or {}
		microUiHost._lastViewModel = microUiHost._lastViewModel or {}
		microUiHost._lastViewModel.groups = type(editorState.groups) == "table" and editorState.groups or {}
		microUiHost._lastViewModel.tracks = timeline and timeline:getTracks() or {}
		updateMicroAutoSaveStatus(microUiHost, editorState)
		updateMicroHidePlaybackToggle(microUiHost, editorState)
		if type(updateMicroViewportToolState) == "function" then
			updateMicroViewportToolState()
		end
		if type(renderMiniTimeline) == "function" then
			if playbackActive
				and microUiHost._miniTimelineRendered == true
				and type(microUiHost._updatePlayheadVisual) == "function" then
				local now = os.clock()
				local lastFullRender = tonumber(microUiHost._lastPlaybackTimelineRenderClock) or 0
				if now - lastFullRender &gt;= 1.0 then
					microUiHost._lastPlaybackTimelineRenderClock = now
					renderMiniTimeline(timeline)
				else
					microUiHost._updatePlayheadVisual(timeline, getMicroDisplayFrame(timeline, options))
				end
			else
				microUiHost._lastPlaybackTimelineRenderClock = 0
				renderMiniTimeline(timeline)
			end
		end
	end

	closeFeaturePopup = function()
		if featurePopup then
			local popup = featurePopup
			featurePopup = nil
			UiMotion.popupOut(popup, nil, function()
				if popup and popup.Parent then
					popup:Destroy()
				end
			end)
		end
	end

	microUiHost.closePopupSurfaces = function(exceptKind)
		if exceptKind ~= "feature" then
			closeFeaturePopup()
		end
		if exceptKind ~= "project" and microUiHost._projectPopup and microUiHost._projectPopup.Parent then
			microUiHost._projectPopup:Destroy()
			microUiHost._projectPopup = nil
		end
		if exceptKind ~= "preferences"
			and microUiHost._preferencePopups
			and type(microUiHost._preferencePopups.closeAll) == "function" then
			microUiHost._preferencePopups.closeAll()
		end
		if exceptKind ~= "repeatFrames"
			and microUiHost._repeatFramesPopup
			and type(microUiHost._repeatFramesPopup.close) == "function" then
			microUiHost._repeatFramesPopup.close()
		end
		if exceptKind ~= "avatar" and type(microUiHost._hideAvatarImportDialog) == "function" then
			microUiHost._hideAvatarImportDialog()
		end
		if exceptKind ~= "trackActions" and microUiHost._trackActionsOverlay then
			microUiHost._trackActionsOverlay.Visible = false
			microUiHost._pendingTrackActionPath = nil
		end
		if exceptKind ~= "rigProperty" and microUiHost._rigPropertyEditorOverlay then
			microUiHost._rigPropertyEditorOverlay.Visible = false
			microUiHost._activeRigPropertyTrackPath = nil
			microUiHost._activeRigPropertyMenuRigName = nil
		end
		if exceptKind ~= "keyframeEditor" then
			if microUiHost._particleKeyframeEditorOverlay then
				microUiHost._particleKeyframeEditorOverlay.Visible = false
			end
			if microUiHost._propertyKeyframeEditorOverlay then
				microUiHost._propertyKeyframeEditorOverlay.Visible = false
			end
			if microUiHost._soundKeyframeEditorOverlay then
				microUiHost._soundKeyframeEditorOverlay.Visible = false
			end
			if microUiHost._effectTrackEditorOverlay then
				microUiHost._effectTrackEditorOverlay.Visible = false
			end
			if type(microUiHost._hideCameraTrackEditor) == "function" then
				microUiHost:_hideCameraTrackEditor()
			else
				if microUiHost._cameraTrackEditorOverlay then
					microUiHost._cameraTrackEditorOverlay.Visible = false
				end
				if microUiHost._cameraRotationOverlay then
					microUiHost._cameraRotationOverlay.Visible = false
				end
				if microUiHost._cameraFollowOverlay then
					microUiHost._cameraFollowOverlay.Visible = false
				end
			end
		end
	end

	local function destroyPanel()
		microUiHost.closePopupSurfaces()
		if microUiHost._preferencePopups and type(microUiHost._preferencePopups.destroy) == "function" then
			microUiHost._preferencePopups.destroy()
			microUiHost._preferencePopups = nil
		end
		if microUiHost._repeatFramesPopup and type(microUiHost._repeatFramesPopup.destroy) == "function" then
			microUiHost._repeatFramesPopup.destroy()
			microUiHost._repeatFramesPopup = nil
		end
		if microUiHost._projectPopup and microUiHost._projectPopup.Parent then
			microUiHost._projectPopup:Destroy()
			microUiHost._projectPopup = nil
		end
		if keyboardInputConnection then
			pcall(function()
				keyboardInputConnection:Disconnect()
			end)
			keyboardInputConnection = nil
		end
		if keyboardInputEndedConnection then
			pcall(function()
				keyboardInputEndedConnection:Disconnect()
			end)
			keyboardInputEndedConnection = nil
		end
		if pluginMouseKeyConnection then
			pcall(function()
				pluginMouseKeyConnection:Disconnect()
			end)
			pluginMouseKeyConnection = nil
		end
		if pluginMouseKeyEndedConnection then
			pcall(function()
				pluginMouseKeyEndedConnection:Disconnect()
			end)
			pluginMouseKeyEndedConnection = nil
		end
		if microShiftSelection then
			microShiftSelection:destroy()
		end
		if microUiHost._pluginDeactivationConnection then
			pcall(function()
				microUiHost._pluginDeactivationConnection:Disconnect()
			end)
			microUiHost._pluginDeactivationConnection = nil
		end
		pcall(function()
			ContextActionService:UnbindAction(MICRO_SHORTCUT_ACTION_NAME)
		end)
		TimelineMiddlePanInputSink.unbind(MICRO_MIDDLE_PAN_ACTION_NAME)
		disconnectMicroUiConnections()
		if gui then
			gui:Destroy()
			gui = nil
			panel = nil
			options._microShortcutPanel = nil
			options._microGui = nil
		end
		setActive(false)
	end

	local function ensurePanel()
		if gui and gui.Parent then
			return gui
		end

		local existing = CoreGui:FindFirstChild(SCREEN_GUI_NAME)
		if existing then
			existing:Destroy()
		end

		gui = make("ScreenGui", {
			Name = SCREEN_GUI_NAME,
			DisplayOrder = 99999,
			Enabled = true,
			IgnoreGuiInset = false,
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}, CoreGui)
		options._microGui = gui

		microUiHost._preferencePopups = MicroPreferencesPopupSupport.mount(gui, {
			plugin = plugin,
			onRefresh = refresh,
			onStatus = function(message)
				if statusLabel then
					statusLabel.Text = tostring(message or "")
				end
			end,
			onSaveAndClose = function()
				local ok, message = runOption(options, "onSaveAnimation", "saveAnimation")
				if ok == false then
					if statusLabel then
						statusLabel.Text = tostring(message or "Save failed, so Micro stayed open.")
					end
					return
				end
				options.onCloseMicroWorkspace()
			end,
			onCloseWithoutSaving = function()
				options.onCloseMicroWorkspace()
			end,
		})
		microUiHost._repeatFramesPopup = MicroRepeatFramesPopupSupport.mount(gui, {
			getDefaults = function()
				if type(options.onGetRepeatFrameDefaults) == "function" then
					return options.onGetRepeatFrameDefaults() or {}
				end
				return {}
			end,
			onRepeatFrames = function(repeatOptions)
				return runOption(options, "onRepeatFrames", "repeatFrames", repeatOptions)
			end,
			onStatus = function(message)
				if statusLabel then
					statusLabel.Text = tostring(message or "")
				end
			end,
		})
		options.onOpenRepeatFramesPopup = function()
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("repeatFrames")
			end
			if microUiHost._repeatFramesPopup and type(microUiHost._repeatFramesPopup.open) == "function" then
				microUiHost._repeatFramesPopup.open()
				return true, "Repeat Frames open."
			end
			return false, "Repeat Frames popup is not ready yet."
		end
		options.onOpenCustomThemeEditor = function()
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("preferences")
			end
			return microUiHost._preferencePopups.openCustomThemeEditor()
		end
		options.onOpenFontPicker = function()
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("preferences")
			end
			return microUiHost._preferencePopups.openFontPicker()
		end

		local avatarImportRefs = AvatarImportUI.mount(gui, {})
		local microAvatarRigType = "R15Classic"
		local function getMicroAvatarRigTypeLabel()
			if microAvatarRigType == "R6" then
				return "Avatar Type: R6"
			elseif microAvatarRigType == "R15Modern" then
				return "Avatar Type: R15 Modern"
			end
			return "Avatar Type: R15 Classic"
		end
		local function setMicroAvatarRigType(rigType)
			microAvatarRigType = tostring(rigType or "R15Classic")
			if microAvatarRigType ~= "R6" and microAvatarRigType ~= "R15Modern" then
				microAvatarRigType = "R15Classic"
			end
			if avatarImportRefs._avatarImportRigTypeButton then
				avatarImportRefs._avatarImportRigTypeButton.Text = getMicroAvatarRigTypeLabel()
			end
		end
		local function cycleMicroAvatarRigType()
			if microAvatarRigType == "R6" then
				setMicroAvatarRigType("R15Classic")
			elseif microAvatarRigType == "R15Classic" then
				setMicroAvatarRigType("R15Modern")
			else
				setMicroAvatarRigType("R6")
			end
			if statusLabel then
				statusLabel.Text = "Avatar importer rig type: " .. getMicroAvatarRigTypeLabel()
			end
		end
		local function hideMicroAvatarImportDialog()
			if avatarImportRefs._avatarImportOverlay then
				avatarImportRefs._avatarImportOverlay.Visible = false
			end
		end
		microUiHost._hideAvatarImportDialog = hideMicroAvatarImportDialog
		local function insertMicroAvatarFromDialog()
			local query = avatarImportRefs._avatarImportInput and avatarImportRefs._avatarImportInput.Text or ""
			query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if avatarImportRefs._avatarImportStatusLabel then
				avatarImportRefs._avatarImportStatusLabel.Text = query == "" and "Picking random avatar..." or "Loading avatar..."
			end
			hideMicroAvatarImportDialog()
			local ok, message = safeCall(options.onInsertAvatarRig, query, microAvatarRigType)
			if statusLabel then
				statusLabel.Text = tostring(message or (ok and "Inserting avatar..." or "Avatar import failed."))
			end
		end
		local function showMicroAvatarImportDialog()
			setMicroAvatarRigType(microAvatarRigType)
			if avatarImportRefs._avatarImportStatusLabel then
				avatarImportRefs._avatarImportStatusLabel.Text = "Tip: leave blank to pick a random avatar."
			end
			if avatarImportRefs._avatarImportOverlay then
				avatarImportRefs._avatarImportOverlay.Visible = true
			end
			task.defer(function()
				if avatarImportRefs._avatarImportOverlay and avatarImportRefs._avatarImportOverlay.Visible and avatarImportRefs._avatarImportInput then
					avatarImportRefs._avatarImportInput:CaptureFocus()
				end
			end)
			if statusLabel then
				statusLabel.Text = "Avatar import open: enter username/userId or leave blank for random, choose rig type, then Insert Avatar."
			end
		end
		options.onOpenAvatarImporter = function()
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("avatar")
			end
			showMicroAvatarImportDialog()
			return true, "Avatar importer opened."
		end

		local toolStrip = make("Frame", {
			Name = "ViewportToolStrip",
			AnchorPoint = Vector2.new(0, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = theme().Panel,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(260, 46),
			ZIndex = 50,
		}, gui)
		setBackgroundRole(toolStrip, "Panel")
		blockClickThrough(toolStrip)
		corner(toolStrip, 5)
		stroke(toolStrip, theme().Border, 0.32, 1, "Border")
		padding(toolStrip, 4)
		makeDraggable(toolStrip, toolStrip, function()
			savePosition(plugin, TOOLSTRIP_SETTING_PREFIX, toolStrip)
			if type(updateRadialDockPlacement) == "function" then
				updateRadialDockPlacement()
			end
		end, function()
			if type(updateRadialDockPlacement) == "function" then
				updateRadialDockPlacement()
			end
		end)
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}, toolStrip)

		local toolHint = text(gui, {
			Name = "ToolHint",
			BackgroundTransparency = 0,
			BackgroundColor3 = theme().PanelSoft,
			Text = "",
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.None,
			Position = UDim2.fromOffset(0, 32),
			Size = UDim2.fromOffset(220, 20),
			Visible = false,
			ZIndex = 96,
		})
		toolHint:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		toolHint:SetAttribute("MegMoThemeTextRole", "__auto")
		corner(toolHint, 5)
		stroke(toolHint, theme().Border, 0.34, 1, "Border")

		local activeToolButton
		local microToolButtons = {}
		local selectedMicroTrackPath = nil
		local railExpanded = getSettingNumber(plugin, RAIL_EXPANDED_SETTING, 0) == 1
		local function getRailWidth()
			return railExpanded and 124 or 40
		end
		local function setToolButtonActive(toolButton)
			if activeToolButton and activeToolButton.Parent then
				activeToolButton.BackgroundColor3 = theme().PanelSoft
				activeToolButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
			end
			activeToolButton = toolButton
			if activeToolButton then
				activeToolButton.BackgroundColor3 = theme().Accent
				activeToolButton:SetAttribute("MegMoThemeBackgroundRole", "Accent")
			end
		end
		updateMicroViewportToolState = function()
			local state = type(options.getEditorState) == "function" and (options.getEditorState() or {}) or {}
			if state.hideDuringPlayback == true and isMicroPlaybackActive(options) then
				task.defer(function()
					if gui and gui.Enabled then
						setActive(false)
					end
				end)
				return
			end
			if type(state.rotateSpace) == "string" and microToolButtons.space and microToolButtons.space.Parent then
				microToolButtons.space.Text = state.rotateSpace
			end
			if state.workspaceGrabActive == true then
				setToolButtonActive(microToolButtons.workspaceGrab)
			elseif state.trackballArmed == true or state.persistentTrackballActive == true then
				if state.trackballMode == "Move" then
					setToolButtonActive(microToolButtons.trackballMove)
				else
					setToolButtonActive(microToolButtons.trackballRotate)
				end
			elseif state.gizmoMode == "Move" then
				setToolButtonActive(microToolButtons.move)
			elseif state.gizmoMode == "Rotate" then
				setToolButtonActive(microToolButtons.rotate)
			else
				setToolButtonActive(nil)
			end
			if microToolButtons.workspaceGrab and microToolButtons.workspaceGrab.Parent then
				local workspaceGrabIcon = microToolButtons.workspaceGrab:FindFirstChild("MegMoWorkspaceGrabIcon")
				if workspaceGrabIcon and workspaceGrabIcon:IsA("ImageLabel") then
					workspaceGrabIcon.ImageColor3 = state.workspaceGrabActive == true
						and Color3.fromRGB(255, 82, 82)
						or Color3.new(1, 1, 1)
					workspaceGrabIcon:SetAttribute("MegMoThemeImageRole", "__workspaceGrabState")
				end
				local workspaceGrabStroke = microToolButtons.workspaceGrab:FindFirstChildWhichIsA("UIStroke")
				if workspaceGrabStroke then
					workspaceGrabStroke.Color = state.workspaceGrabActive == true
						and Color3.fromRGB(255, 82, 82)
						or theme().Accent
					workspaceGrabStroke:SetAttribute(
						"MegMoThemeStrokeRole",
						state.workspaceGrabActive == true and "__workspaceGrabState" or "Accent"
					)
				end
			end
			if microToolButtons.record and microToolButtons.record.Parent then
				local recorderState = type(state.motionRecorder) == "table" and state.motionRecorder or nil
				local recordActive = recorderState and (recorderState.armed or recorderState.recording) or false
				microToolButtons.record.BackgroundColor3 = recordActive and theme().PanelSoft or theme().PanelSoft
				microToolButtons.record:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
				local recordIcon = microToolButtons.record:FindFirstChild("MegMoButtonIcon")
				if recordIcon and recordIcon:IsA("ImageLabel") then
					recordIcon.ImageColor3 = recordActive and theme().Danger or theme().Text
					recordIcon:SetAttribute("MegMoThemeImageRole", recordActive and "Danger" or "Text")
				end
			end
		end

		local function isMicroPathSelected(path)
			if not path or type(options.getSelectedTrackPaths) ~= "function" then
				return false
			end
			for _, selectedPath in ipairs(options.getSelectedTrackPaths() or {}) do
				if selectedPath == path then
					return true
				end
			end
			return false
		end

		buildMicroEditorViewModel = function(currentTimeline)
			local timeline = currentTimeline
			local selectedKeyRefs = type(options.getSelectedKeyRefs) == "function" and (options.getSelectedKeyRefs() or {}) or {}
			local selectedTrackPaths = type(options.getSelectedTrackPaths) == "function" and (options.getSelectedTrackPaths() or {}) or {}
			local editorState = type(options.getEditorState) == "function" and (options.getEditorState() or {}) or {}
			local tracks = timeline and type(timeline.getTracks) == "function" and timeline:getTracks() or {}
			local selectedKeyValues = {}
			local selectedKeyOptions = type(editorState.selectedKeyOptions) == "table" and editorState.selectedKeyOptions or nil
			if timeline and #selectedKeyRefs &gt; 0 and type(timeline.getTrackKeyValues) == "function" then
				local ok, values = pcall(function()
					return timeline:getTrackKeyValues(selectedKeyRefs)
				end)
				if ok and type(values) == "table" then
					selectedKeyValues = values
				end
			end
			if not selectedKeyOptions and timeline and #selectedKeyRefs &gt; 0 and type(timeline.getKeyOptions) == "function" then
				local firstKey = selectedKeyRefs[1]
				local path = firstKey and (firstKey.jointPath or firstKey.path)
				local frame = firstKey and firstKey.frame
				if type(path) == "string" and frame ~= nil then
					local ok, keyOptions = pcall(function()
						return timeline:getKeyOptions(path, frame)
					end)
					if ok and type(keyOptions) == "table" then
						selectedKeyOptions = keyOptions
					end
				end
			end
			local selectedJointPath = selectedMicroTrackPath
			if not selectedJointPath and #selectedKeyRefs &gt; 0 then
				selectedJointPath = selectedKeyRefs[1].jointPath
			end
			if not selectedJointPath and #selectedTrackPaths &gt; 0 then
				selectedJointPath = selectedTrackPaths[1]
			end
			return {
				currentFrame = timeline and type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or 0,
				selectedJointPath = selectedJointPath,
				selectedKeys = selectedKeyRefs,
				selectedKeyValues = selectedKeyValues,
				selectedKeyOptions = selectedKeyOptions,
				selectedTrackPaths = selectedTrackPaths,
				rigPropertyTrackState = timeline and type(timeline.getRigPropertyTrackState) == "function" and timeline:getRigPropertyTrackState() or {},
				objectPropertyTrackState = timeline and type(timeline.getObjectPropertyTrackState) == "function" and timeline:getObjectPropertyTrackState() or {},
				groups = type(editorState.groups) == "table" and editorState.groups or {},
				selectedGroupIds = require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).getSelectedGroupIds(
					editorState.selectedGroupIds,
					selectedKeyRefs,
					editorState.groups,
					microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
				),
				tracks = tracks,
			}
		end

		refreshMicroEditors = function(currentTimeline)
			microUiHost._lastViewModel = buildMicroEditorViewModel(currentTimeline)
			if microUiHost._particleKeyframeEditorOverlay and microUiHost._particleKeyframeEditorOverlay.Visible then
				ParticleKeyframeEditorController.render(microUiHost)
			end
			if microUiHost._propertyKeyframeEditorOverlay and microUiHost._propertyKeyframeEditorOverlay.Visible then
				PropertyKeyframeEditorController.render(microUiHost)
			end
			if microUiHost._soundKeyframeEditorOverlay and microUiHost._soundKeyframeEditorOverlay.Visible then
				SoundKeyframeEditorController.render(microUiHost)
			end
			if microUiHost._effectTrackEditorOverlay and microUiHost._effectTrackEditorOverlay.Visible then
				ScreenEffectKeyframeEditorController.render(microUiHost)
			end
			if microUiHost._cameraTrackEditorOverlay
				and microUiHost._cameraTrackEditorOverlay.Visible
				and type(microUiHost._renderCameraTrackEditor) == "function" then
				microUiHost:_renderCameraTrackEditor()
			end
		end

		local function getMicroOptionsTrack(currentTimeline)
			microUiHost._lastViewModel = buildMicroEditorViewModel(currentTimeline)
			local viewModel = microUiHost._lastViewModel or {}
			for _, key in ipairs(viewModel.selectedKeys or {}) do
				local track = microUiHost:_getTrackViewModel(key.jointPath or key.path)
				if track then
					return track
				end
			end
			if viewModel.selectedJointPath then
				local selectedTrack = microUiHost:_getTrackViewModel(viewModel.selectedJointPath)
				if selectedTrack then
					return selectedTrack
				end
			end
			for _, path in ipairs(viewModel.selectedTrackPaths or {}) do
				local track = microUiHost:_getTrackViewModel(path)
				if track then
					return track
				end
			end
			return nil
		end

		local microShowRigPropertyEditor
		local openMicroTrackOptionsForTrack
		local function isMicroFaceTrack(track)
			return track ~= nil
				and (track.trackType == "Face"
					or track.targetScope == "Face"
					or track.valueType == "Face"
					or track.propertyName == "Face")
		end

		openMicroTrackOptionsForTrack = function(track)
			if not track then
				if statusLabel then
					statusLabel.Text = "Keypad 7: select a keyframe or track first."
				end
				return false, "No selected track."
			end
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("keyframeEditor")
			end
			if track.isMicroVirtualTrack and (track.virtualKind == "RigHeader" or track.virtualKind == "Properties") then
				return microShowRigPropertyEditor(track.path, track.rigName or track.name)
			end
			if require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).hasSelectedGroup(
				microUiHost._lastViewModel,
				microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
			) then
				return microShowRigPropertyEditor(track.path, track.rigName or track.name)
			end
			if ParticleKeyframeEditorController.isParticlePropertyTrack(track) then
				local ok, err = pcall(function()
					ParticleKeyframeEditorController.show(microUiHost, track.path)
				end)
				if not ok then
					if statusLabel then
						statusLabel.Text = "Particle options failed: " .. tostring(err)
					end
					return false, err
				end
				return true, "Particle keyframe settings open."
			end
			if SoundKeyframeEditorController.isSoundTrack(track) then
				local ok, err = pcall(function()
					local activeFrame = nil
					for _, key in ipairs((microUiHost._lastViewModel and microUiHost._lastViewModel.selectedKeyValues) or {}) do
						if key.jointPath == track.path then
							activeFrame = key.frame
							break
						end
					end
					SoundKeyframeEditorController.show(microUiHost, track.path, activeFrame)
				end)
				if not ok then
					if statusLabel then
						statusLabel.Text = "Sound options failed: " .. tostring(err)
					end
					return false, err
				end
				return true, "Sound keyframe settings open."
			end
			if isMicroFaceTrack(track) then
				return microShowRigPropertyEditor(track.path, track.name)
			end
			if PropertyKeyframeEditorController.isEditablePropertyTrack(track) then
				local ok, err = pcall(function()
					PropertyKeyframeEditorController.show(microUiHost, track.path)
				end)
				if not ok then
					if statusLabel then
						statusLabel.Text = "Property options failed: " .. tostring(err)
					end
					return false, err
				end
				return true, "Property keyframe settings open."
			end
			if track.trackType == "Screen Effect" or track.trackType == "Lighting Effect" then
				local ok, err = pcall(function()
					local activeFrame = nil
					for _, key in ipairs((microUiHost._lastViewModel and microUiHost._lastViewModel.selectedKeyValues) or {}) do
						if key.jointPath == track.path then
							activeFrame = key.frame
							break
						end
					end
					ScreenEffectKeyframeEditorController.show(microUiHost, track.path, activeFrame)
				end)
				if not ok then
					if statusLabel then
						statusLabel.Text = "Effect options failed: " .. tostring(err)
					end
					return false, err
				end
				if statusLabel then
					statusLabel.Text = "Effect keyframe settings open."
				end
				return true, "Effect keyframe settings open."
			end
			if track.trackType == "Camera" or track.trackType == "Camera Property" then
				if type(microUiHost._showCameraTrackEditor) == "function" then
					local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
					microUiHost._lastViewModel = buildMicroEditorViewModel(timeline)
					local activeFrame = nil
					for _, key in ipairs((microUiHost._lastViewModel and microUiHost._lastViewModel.selectedKeyValues) or {}) do
						if key.jointPath == track.path then
							activeFrame = key.frame
							break
						end
					end
					if activeFrame == nil and timeline and type(timeline.getCurrentFrame) == "function" then
						activeFrame = timeline:getCurrentFrame()
					end
					microUiHost:_showCameraTrackEditor(track.path, activeFrame)
				elseif type(options.onOpenPopup) == "function" then
					options.onOpenPopup("Camera")
				else
					setMicroTab("Camera")
				end
				if statusLabel then
					statusLabel.Text = "Camera track options open."
				end
				return true, "Camera track options open."
			end
			if track.trackType == "Event" or track.valueType == "Event" then
				return microShowRigPropertyEditor(track.path, track.name)
			end
			if track.trackType == "Rig" then
				return microShowRigPropertyEditor(track.path, track.name)
			end
			if track.trackType == "Rig Group" or track.trackType == "Rig Property" then
				return microShowRigPropertyEditor(track.path, track.rigName or track.name)
			end
			if track.trackType == "Emitter Group"
				or track.trackType == "Object"
				or track.trackType == "Part"
				or track.trackType == "BasePart"
				or track.trackType == "Model"
				or track.trackType == "Rig CFrame"
				or track.trackType == "Object Property" then
				return microShowRigPropertyEditor(track.path, track.name)
			end
			if statusLabel then
				statusLabel.Text = "No Micro track options are available for that selection yet."
			end
			return false, "No Micro options available."
		end

		local function hasMicroTrack(path)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not (timeline and type(timeline.getTrackByPath) == "function") then
				return path ~= nil
			end
			return path ~= nil and timeline:getTrackByPath(path) ~= nil
		end

		local function toolButton(label, width, callback, iconKey, hint)
			local tool = button(toolStrip, label, theme().PanelSoft)
			tool.Size = UDim2.fromOffset(width or 42, 36)
			tool.TextSize = 13
			tool.ZIndex = 52
			if iconKey then
				tool.Text = ""
				UiHelpers.setButtonIcon(tool, iconKey, {
					noPadding = true,
					position = UDim2.new(0.5, -9, 0.5, 0),
					size = 18,
				})
			end
			MicroViewportButtonStyleSupport.apply(tool)
			tool.MouseEnter:Connect(function()
				MicroWidgetController._positionMicroTooltipNear(tool, toolHint, hint or label, 8)
			end)
			tool.MouseLeave:Connect(function()
				toolHint.Visible = false
			end)
			tool.Activated:Connect(function()
				pcall(function()
					plugin:Activate(true)
				end)
				if type(callback) == "function" then
					callback(tool)
				end
				task.defer(refresh)
			end)
			return tool
		end

		microToolButtons.move = toolButton("M", 42, function(tool)
			setToolButtonActive(tool)
			runOption(options, "onSetGizmoMode", "setGizmoMode", "Move")
		end, "Move", "Move Tool")
		microToolButtons.rotate = toolButton("R", 42, function(tool)
			setToolButtonActive(tool)
			runOption(options, "onSetGizmoMode", "setGizmoMode", "Rotate")
		end, "Rotate", "Rotate Tool")
		microToolButtons.trackballRotate = toolButton("TR", 51, function(tool)
			setToolButtonActive(tool)
			runOption(options, "onBeginTrackballMode", "beginTrackballMode", "Rotate")
		end, "TrackballRotate", "Trackball Rotate")
		microToolButtons.trackballMove = toolButton("TM", 51, function(tool)
			setToolButtonActive(tool)
			runOption(options, "onBeginTrackballMode", "beginTrackballMode", "Move")
		end, "TrackballMove", "Trackball Move")
		microToolButtons.space = toolButton("Local", 81, function(tool)
			setToolButtonActive(tool)
			runOption(options, "onToggleRotateSpace", "toggleRotateSpace")
			tool.Text = tool.Text == "Local" and "World" or "Local"
		end, nil, "Toggle Local / World")
		microToolButtons.space.BackgroundColor3 = theme().PanelSoft
		microToolButtons.workspaceGrab = make("ImageButton", {
			Name = "WorkspaceGrabButton",
			AutoButtonColor = true,
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			Image = Constants.WORKSPACE_GRAB_ICON,
			ImageTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(42, 36),
			ZIndex = 52,
		}, toolStrip)
		microToolButtons.workspaceGrab:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		make("ImageLabel", {
			Name = "MegMoWorkspaceGrabIcon",
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = Constants.WORKSPACE_GRAB_ICON,
			ImageColor3 = Color3.new(1, 1, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(26, 26),
			ZIndex = 55,
		}, microToolButtons.workspaceGrab):SetAttribute("MegMoThemeImageRole", "__workspaceGrabState")
		corner(microToolButtons.workspaceGrab, 5)
		stroke(microToolButtons.workspaceGrab, theme().Accent, 0.28, 1, "Accent")
		MicroViewportButtonStyleSupport.apply(microToolButtons.workspaceGrab)
		microToolButtons.workspaceGrab.MouseEnter:Connect(function()
			MicroWidgetController._positionMicroTooltipNear(
				microToolButtons.workspaceGrab,
				toolHint,
				"Free Grab: white is ready and red is armed. Click-drag whole rigs, Models, or standalone Parts. Tracked targets get a CFrame key at the playhead. Toggle off or click back inside 7kg2 to resume posing.",
				8
			)
		end)
		microToolButtons.workspaceGrab.MouseLeave:Connect(function()
			toolHint.Visible = false
		end)
		microToolButtons.workspaceGrab.Activated:Connect(function()
			local _, message = runOption(options, "onToggleWorkspaceGrab", "toggleWorkspaceGrab")
			if statusLabel and type(message) == "string" then
				statusLabel.Text = message
			end
			task.defer(refresh)
		end)
		microToolButtons.record = toolButton("Rec", 51, function()
			runOption(options, "onRecordMotion", "recordMotion")
		end, "RecordMotion", "Record Motion (Shift+R)")
		microToolButtons.physics = make("ImageButton", {
			Name = "PhysicsButton",
			AutoButtonColor = true,
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			Image = MICRO_MENU_IMAGE_ASSETS.Physics,
			ImageColor3 = theme().Text,
			LayoutOrder = 890,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(42, 36),
			ZIndex = 52,
		}, toolStrip)
		microToolButtons.physics:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		microToolButtons.physics:SetAttribute("MegMoThemeImageRole", "Text")
		corner(microToolButtons.physics, 5)
		stroke(microToolButtons.physics, theme().Accent, 0.28, 1, "Accent")
		MicroViewportButtonStyleSupport.apply(microToolButtons.physics)
		microToolButtons.physics.MouseEnter:Connect(function()
			MicroWidgetController._positionMicroTooltipNear(microToolButtons.physics, toolHint, "Add Physics", 8)
		end)
		microToolButtons.physics.MouseLeave:Connect(function()
			toolHint.Visible = false
		end)
		microToolButtons.physics.Activated:Connect(function()
			require(script.Parent:WaitForChild("PhysicsLauncherPopupSupport")).open(gui, {
				compact = true,
				plugin = plugin,
			})
		end)
		microToolButtons.animationTools = make("ImageButton", {
			Name = "AnimationToolsButton",
			AutoButtonColor = true,
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			Image = MICRO_MENU_IMAGE_ASSETS.AnimationTools,
			ImageColor3 = theme().Text,
			LayoutOrder = 900,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(42, 36),
			ZIndex = 52,
		}, toolStrip)
		microToolButtons.animationTools:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		microToolButtons.animationTools:SetAttribute("MegMoThemeImageRole", "Text")
		corner(microToolButtons.animationTools, 5)
		stroke(microToolButtons.animationTools, theme().Accent, 0.28, 1, "Accent")
		MicroViewportButtonStyleSupport.apply(microToolButtons.animationTools)
		microToolButtons.animationTools.MouseEnter:Connect(function()
			MicroWidgetController._positionMicroTooltipNear(microToolButtons.animationTools, toolHint, "Animation Tools", 8)
		end)
		microToolButtons.animationTools.MouseLeave:Connect(function()
			toolHint.Visible = false
		end)
		microToolButtons.animationTools.Activated:Connect(function()
			pcall(function()
				plugin:Activate(true)
			end)
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Enhance")
			elseif type(setMicroTab) == "function" then
				setMicroTab("Tools")
			end
			if statusLabel then
				statusLabel.Text = "Animation Tools opened."
			end
			task.defer(refresh)
		end)
		MicroViewportEditButtonsSupport.mount({
			parent = toolStrip,
			plugin = plugin,
			toolHint = toolHint,
			statusLabel = statusLabel,
			refresh = refresh,
			layoutOrderStart = 910,
			runAction = function(action)
				return runOption(options, action.callbackName, action.fallbackActionName)
			end,
		})
		local stripGrip = make("TextLabel", {
			Name = "ToolStripDragGrip",
			Active = false,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			LayoutOrder = 1000,
			Size = UDim2.fromOffset(14, 30),
			Text = ":\n:\n:",
			TextColor3 = theme().MutedText,
			TextSize = 9,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 53,
		}, toolStrip)
		stripGrip:SetAttribute("MegMoThemeTextRole", "MutedText")

		panel = make("Frame", {
			Name = "Panel",
			AnchorPoint = Vector2.new(0, 0),
			BackgroundColor3 = theme().Panel,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Position = readSavedPosition(plugin, PANEL_SETTING_PREFIX, UDim2.fromOffset(96, 230)),
			Size = readSavedSize(plugin, PANEL_SETTING_PREFIX, UDim2.fromOffset(520, 300), MIN_PANEL_SIZE, MAX_PANEL_SIZE),
			ZIndex = 1,
		}, gui)
		options._microShortcutPanel = panel
		setBackgroundRole(panel, "Panel")
		UiHelpers.applyPanelSurface(panel)
		blockClickThrough(panel)
		makeInputSink(panel)
		panel.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, nil)
			end
		end)
		panel.MouseLeave:Connect(function()
			if options._microShortcutArmed == true then
				focusMicroShortcutCapture(options, statusLabel, "Micro shortcuts stay active. Click Studio viewport to return shortcuts to Studio.")
			else
				releaseMicroShortcutCapture(options)
			end
		end)
		corner(panel, 8)
