          <Properties>
            <string name="Name">ParticleKeyframeEditorUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local ParticleKeyframeEditorUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local function createLabel(parent, text, y)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, y),
		Size = UDim2.new(1, -36, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = text,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})
end

function ParticleKeyframeEditorUI.mount(parent, _context)
	if not parent then
		error("ParticleKeyframeEditorUI.mount requires parent")
	end

	local refs = {}

	local overlay = create("Frame", {
		Name = "ParticleKeyframeEditorOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.34,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 130,
	})

	local card = create("Frame", {
		Name = "ParticleKeyframeEditorCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 430, 0, 344),
		ZIndex = 131,
	})
	applySectionSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 14),
		Size = UDim2.new(1, -58, 0, 24),
		Font = Enum.Font.GothamSemibold,
		Text = "Edit Particle Keyframe",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 28, 0, 28),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "x",
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		ZIndex = 132,
	})
	createCorner(closeButton, 8)

	local meta = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 50),
		Size = UDim2.new(1, -36, 0, 62),
		ZIndex = 132,
	})
	applySectionSurface(meta)
	createCorner(meta, 10)
	createStroke(meta)

	local itemLabel = create("TextLabel", {
		Parent = meta,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Track: ParticleEmitter",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 133,
	})

	local helpLabel = create("TextLabel", {
		Parent = meta,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 26),
		Font = Enum.Font.GothamSemibold,
		Text = "Edit the value, then write it to the selected property keyframe.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 133,
	})

	local valueLabel = createLabel(card, "Value", 128)
	local valueInput = create("TextBox", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 150),
		Size = UDim2.new(1, -36, 0, 34),
		Font = Enum.Font.GothamSemibold,
		PlaceholderColor3 = Constants.THEME.MutedText,
		PlaceholderText = "Value",
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})
	createCorner(valueInput, 9)
	createStroke(valueInput)
	create("UIPadding", {
		Parent = valueInput,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local booleanButton = create("TextButton", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.AccentSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 150),
		Size = UDim2.new(1, -36, 0, 34),
		Font = Enum.Font.GothamSemibold,
		Text = "Boolean: true",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		Visible = false,
		ZIndex = 133,
	})
	createCorner(booleanButton, 9)

	local colorSwatch = create("Frame", {
		Parent = card,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Position = UDim2.new(1, -56, 0, 154),
		Size = UDim2.new(0, 26, 0, 26),
		Visible = false,
		ZIndex = 134,
	})
	createCorner(colorSwatch, 13)
	createStroke(colorSwatch, Constants.THEME.Border, 1)

	local colorPickerFrame = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 192),
		Size = UDim2.new(1, -36, 0, 62),
		Visible = false,
		ZIndex = 132,
	})
	applySectionSurface(colorPickerFrame)
	createCorner(colorPickerFrame, 10)
	createStroke(colorPickerFrame)

	create("TextLabel", {
		Parent = colorPickerFrame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 6),
		Size = UDim2.new(1, -20, 0, 14),
		Font = Enum.Font.GothamSemibold,
		Text = "Quick colors",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 133,
	})

	local paletteColors = {
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(0, 0, 0),
		Color3.fromRGB(255, 70, 70),
		Color3.fromRGB(255, 170, 60),
		Color3.fromRGB(255, 230, 70),
		Color3.fromRGB(85, 220, 120),
		Color3.fromRGB(70, 210, 255),
		Color3.fromRGB(80, 130, 255),
		Color3.fromRGB(170, 90, 255),
		Color3.fromRGB(255, 95, 180),
	}
	local colorButtons = {}
	for index, color in ipairs(paletteColors) do
		local column = (index - 1) % 10
		local button = create("TextButton", {
			Parent = colorPickerFrame,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 10 + column * 39, 0, 28),
			Size = UDim2.new(0, 28, 0, 24),
			Text = "",
			ZIndex = 133,
		})
		createCorner(button, 7)
		createStroke(button, Constants.THEME.Border, 1)
		colorButtons[index] = button
	end

	local noteLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 264),
		Size = UDim2.new(1, -36, 0, 34),
		Font = Enum.Font.GothamSemibold,
		Text = "Examples: Color 255,0,4  |  Range 1,3  |  Vector 0,4,0",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 132,
	})

	local applyButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 18, 1, -48),
		Size = UDim2.new(0.5, -24, 0, 32),
		Text = "Apply Keyframe",
		ZIndex = 132,
	})
	styleTextButton(applyButton)
	createCorner(applyButton, 9)

	local okButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.5, 6, 1, -48),
		Size = UDim2.new(0.5, -24, 0, 32),
		Text = "OK",
		ZIndex = 132,
	})
	styleGhostButton(okButton)
	createCorner(okButton, 9)

	refs._particleKeyframeEditorOverlay = overlay
	refs._particleKeyframeEditorCloseButton = closeButton
	refs._particleKeyframeEditorOkButton = okButton
	refs._particleKeyframeEditorApplyButton = applyButton
	refs._particleKeyframeEditorItemLabel = itemLabel
	refs._particleKeyframeEditorHelpLabel = helpLabel
	refs._particleKeyframeEditorValueLabel = valueLabel
	refs._particleKeyframeEditorValueInput = valueInput
	refs._particleKeyframeEditorBooleanButton = booleanButton
	refs._particleKeyframeEditorColorSwatch = colorSwatch
	refs._particleKeyframeEditorColorPickerFrame = colorPickerFrame
	refs._particleKeyframeEditorColorButtons = colorButtons
	refs._particleKeyframeEditorNoteLabel = noteLabel

	return refs
end

function ParticleKeyframeEditorUI.update(_context)
end

function ParticleKeyframeEditorUI.destroy()
end

return ParticleKeyframeEditorUI
