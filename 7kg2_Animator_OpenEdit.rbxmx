		Text = "0 projects",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = footer,
	})
	countLabel:SetAttribute("MegMoThemeTextRole", "MutedText")
	local previousButton = create("TextButton", {
		Name = "PreviousPage",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -112, 0, 0),
		Size = UDim2.fromOffset(48, 24),
		Text = "&lt; Prev",
		TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelSoft),
		TextSize = 10,
		Parent = footer,
	})
	previousButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	previousButton:SetAttribute("MegMoThemeTextRole", "__auto")
	UiHelpers.createCorner(previousButton, 5)
	local pageLabel = create("TextLabel", {
		Name = "PageLabel",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -54, 0, 0),
		Size = UDim2.fromOffset(54, 24),
		Text = "1 / 1",
		TextColor3 = Constants.THEME.Text,
		TextSize = 10,
		Parent = footer,
	})
	pageLabel:SetAttribute("MegMoThemeTextRole", "Text")
	local nextButton = create("TextButton", {
		Name = "NextPage",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(52, 24),
		Text = "Next &gt;",
		TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelSoft),
		TextSize = 10,
		Parent = footer,
	})
	nextButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	nextButton:SetAttribute("MegMoThemeTextRole", "__auto")
	UiHelpers.createCorner(nextButton, 5)

	local function clearRows()
		for _, row in ipairs(rows) do
			if row and row.Parent then
				row:Destroy()
			end
		end
		table.clear(rows)
	end

	local function openEntry(entry)
		local ok, message = call(options.onOpenSavedProject, entry.id)
		if type(options.setStatus) == "function" then
			options.setStatus(message or (ok and ("Opened '" .. tostring(entry.name or "project") .. "'.") or "That saved project could not be opened."))
		end
		if ok and type(options.onProjectOpened) == "function" then
			options.onProjectOpened()
		end
	end

	local function mapEntry(entry)
		local ok, message = call(
			options.onImportSavedProjectToSelectedRig,
			entry.id,
			options.promptParent or parent,
			options.onProjectOpened
		)
		if type(options.setStatus) == "function" then
			options.setStatus(message or (ok and "Confirm the selected rig mapping." or "That saved project could not be mapped."))
		end
	end

	local function createEntryRow(entry, order)
		local row = create("Frame", {
			Name = "SavedProjectRow",
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 52),
			Parent = list,
		})
		row:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		UiHelpers.createCorner(row, 5)
		local rowStroke = UiHelpers.createStroke(row, Constants.THEME.Border, 1)
		rowStroke.Transparency = 0.42
		rowStroke:SetAttribute("MegMoThemeStrokeRole", "Border")
		row.MouseEnter:Connect(function()
			rowStroke.Color = Constants.THEME.Accent
			rowStroke.Transparency = 0.08
			rowStroke:SetAttribute("MegMoThemeStrokeRole", "Accent")
		end)
		row.MouseLeave:Connect(function()
			rowStroke.Color = Constants.THEME.Border
			rowStroke.Transparency = 0.42
			rowStroke:SetAttribute("MegMoThemeStrokeRole", "Border")
		end)
		local nameLabel = create("TextLabel", {
			Name = "ProjectName",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(9, 5),
			Size = UDim2.new(0.43, -12, 0, 18),
			Text = tostring(entry.name or "Untitled Project"),
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		nameLabel:SetAttribute("MegMoThemeTextRole", "Text")
		local savedAt = formatSavedAt(entry.priceLabel)
		local category = tostring(entry.category or "Project")
		local meta = savedAt ~= "" and (category .. "  |  " .. savedAt) or category
		local metaLabel = create("TextLabel", {
			Name = "ProjectMeta",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.fromOffset(9, 27),
			Size = UDim2.new(0.43, -12, 0, 15),
			Text = meta,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		metaLabel:SetAttribute("MegMoThemeTextRole", "MutedText")
		local openButton = create("TextButton", {
			Name = "OpenButton",
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(0.43, 2, 0, 10),
			Size = UDim2.new(0.19, -5, 0, 32),
			Text = "Open",
			TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.PanelAlt),
			TextSize = 10,
			Parent = row,
		})
		openButton:SetAttribute("MegMoThemeBackgroundRole", "PanelAlt")
		openButton:SetAttribute("MegMoThemeTextRole", "__auto")
		UiHelpers.createCorner(openButton, 5)
		local openStroke = UiHelpers.createStroke(openButton, Constants.THEME.Border, 1)
		openStroke.Transparency = 0.35
		openStroke:SetAttribute("MegMoThemeStrokeRole", "Border")
		local mapButton = create("TextButton", {
			Name = "MapButton",
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.AccentSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(0.62, 2, 0, 10),
			Size = UDim2.new(0.38, -8, 0, 32),
			Text = "To Selected Rig",
			TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.AccentSoft),
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		mapButton:SetAttribute("MegMoThemeBackgroundRole", "AccentSoft")
		mapButton:SetAttribute("MegMoThemeTextRole", "__auto")
		UiHelpers.createCorner(mapButton, 5)
		local mapStroke = UiHelpers.createStroke(mapButton, Constants.THEME.Accent, 1)
		mapStroke.Transparency = 0.3
		mapStroke:SetAttribute("MegMoThemeStrokeRole", "Accent")
		openButton.Activated:Connect(function()
			openEntry(entry)
		end)
		mapButton.Activated:Connect(function()
			mapEntry(entry)
		end)
		table.insert(rows, row)
	end

	local function renderPage()
		clearRows()
		local total = #filteredEntries
		local pageCount = math.max(1, math.ceil(total / pageSize))
		currentPage = math.clamp(currentPage, 1, pageCount)
		local firstIndex = ((currentPage - 1) * pageSize) + 1
		local lastIndex = math.min(total, firstIndex + pageSize - 1)
		emptyLabel.Visible = total == 0
		for index = firstIndex, lastIndex do
			createEntryRow(filteredEntries[index], index - firstIndex + 2)
		end
		if total &gt; 0 then
			countLabel.Text = string.format("%d-%d of %d", firstIndex, lastIndex, total)
		else
			countLabel.Text = "0 projects"
		end
		pageLabel.Text = string.format("%d / %d", currentPage, pageCount)
		previousButton.Active = currentPage &gt; 1
		previousButton.AutoButtonColor = currentPage &gt; 1
		previousButton.TextTransparency = currentPage &gt; 1 and 0 or 0.55
		nextButton.Active = currentPage &lt; pageCount
		nextButton.AutoButtonColor = currentPage &lt; pageCount
		nextButton.TextTransparency = currentPage &lt; pageCount and 0 or 0.55
	end

	local function applySearch()
		local query = string.lower(string.gsub(searchInput.Text or "", "^%s*(.-)%s*$", "%1"))
		table.clear(filteredEntries)
		for _, entry in ipairs(allEntries) do
			local savedAt = formatSavedAt(entry.priceLabel)
			local haystack = string.lower(table.concat({
				tostring(entry.name or ""),
				tostring(entry.category or ""),
				savedAt,
			}, " "))
			if query == "" or string.find(haystack, query, 1, true) then
				table.insert(filteredEntries, entry)
			end
		end
		currentPage = 1
		renderPage()
	end

	function controller.refresh(reload)
		local loadOk, loadMessage = true, nil
		if reload then
			loadOk, loadMessage = call(options.onLoadSavedProjects)
		end
		allEntries = getSavedEntries(options)
		applySearch()
		if type(options.setStatus) == "function" and reload then
			options.setStatus(loadMessage or (loadOk and string.format("Found %d saved project%s.", #allEntries, #allEntries == 1 and "" or "s") or "Saved projects could not be loaded."))
		end
	end

	refreshButton.Activated:Connect(function()
		controller.refresh(true)
	end)
	backButton.Activated:Connect(function()
		controller.hide()
	end)
	searchInput:GetPropertyChangedSignal("Text"):Connect(applySearch)
	previousButton.Activated:Connect(function()
		if currentPage &gt; 1 then
			currentPage -= 1
			renderPage()
		end
	end)
	nextButton.Activated:Connect(function()
		local pageCount = math.max(1, math.ceil(#filteredEntries / pageSize))
		if currentPage &lt; pageCount then
			currentPage += 1
			renderPage()
		end
	end)

	function controller.show()
		browser.Visible = true
		searchInput:CaptureFocus()
	end

	function controller.hide()
		browser.Visible = false
		searchInput:ReleaseFocus()
		if type(options.onClose) == "function" then
			options.onClose()
		end
	end

	function controller.destroy()
		clearRows()
		if browser.Parent then
			browser:Destroy()
		end
	end

	return controller
end

return MicroSavedProjectsSupport
