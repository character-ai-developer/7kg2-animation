        <Item class="ModuleScript" referent="RBX79">
          <Properties>
            <string name="Name">MicroHelpPopupSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local HelpUI = require(script.Parent:WaitForChild("HelpUI"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local MicroHelpPopupSupport = {}

local ACTION_TO_GUIDE = {
	Quick = "HelpQuickAnswers",
	["Getting Started"] = "HelpGettingStarted",
	Motion = "HelpMotionBuilder",
	Timeline = "HelpTimeline",
	Pose = "HelpPoseTools",
	Cutscene = "HelpCutsceneMaker",
	Faces = "HelpFaces",
	Audio = "HelpSoundAndMusic",
	Import = "HelpImportExport",
	["R15 -&gt; R6"] = "HelpR15ToR6Converter",
	Effects = "HelpEffects",
	Physics = "HelpPhysics",
	Trouble = "HelpTroubleshooting",
	Shortcuts = "HelpShortcuts",
	Support = "HelpSupport",
}

local DEFAULT_ACTIONS = {
	"Quick",
	"Getting Started",
	"Motion",
	"Timeline",
	"Pose",
	"Cutscene",
	"Faces",
	"Audio",
	"Import",
	"R15 -&gt; R6",
	"Effects",
	"Physics",
	"Trouble",
	"Shortcuts",
	"Support",
}

local function clearGuiObjects(parent)
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function makeLabel(parent, text, textSize, color, font, order)
	local label = UiHelpers.create("TextLabel", {
		Parent = parent,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = font or Enum.Font.Gotham,
		LayoutOrder = order or 1,
		Size = UDim2.new(1, 0, 0, 0),
		Text = text,
		TextColor3 = color,
		TextSize = textSize,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 76,
	})
	return label
end

local function setButtonSelected(button, selected)
	if not button then
		return
	end
	button.BackgroundColor3 = selected and Constants.THEME.Accent or Constants.THEME.PanelSoft
	button.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Constants.THEME.Text
end

function MicroHelpPopupSupport.mount(host, context)
	context = context or {}
	local actions = context.actions or DEFAULT_ACTIONS
	local selectedAction = actions[1] or "Quick"
	local navButtons = {}

	local nav = UiHelpers.create("ScrollingFrame", {
		Parent = host,
		Name = "HelpGuideNav",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.fromOffset(14, 14),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(0, 152, 1, -28),
		ZIndex = 74,
	})
	UiHelpers.createCorner(nav, 9)
	UiHelpers.createStroke(nav, Constants.THEME.Border, 1, 0.55)
	UiHelpers.create("UIPadding", {
		Parent = nav,
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 8),
	})
	UiHelpers.createListLayout(nav, 7)

	local content = UiHelpers.create("ScrollingFrame", {
		Parent = host,
		Name = "HelpGuideContent",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.fromOffset(178, 14),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 5,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, -192, 1, -28),
		ZIndex = 74,
	})
	UiHelpers.applySectionSurface(content)
	UiHelpers.create("UIPadding", {
		Parent = content,
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 12),
	})
	UiHelpers.createListLayout(content, 8)

	local function renderGuide(actionName)
		selectedAction = actionName or selectedAction
		clearGuiObjects(content)
		for name, button in pairs(navButtons) do
			setButtonSelected(button, name == selectedAction)
		end

		local guide = HelpUI.getGuide(ACTION_TO_GUIDE[selectedAction] or "HelpQuickAnswers") or HelpUI.getGuide("HelpQuickAnswers")
		makeLabel(content, guide.title or "Help Guide", 18, Constants.THEME.Text, Enum.Font.GothamBold, 1)
		makeLabel(content, guide.subtitle or "", 11, Constants.THEME.MutedText, Enum.Font.Gotham, 2)

		for index, section in ipairs(guide.sections or {}) do
			local card = UiHelpers.create("Frame", {
				Parent = content,
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				LayoutOrder = 10 + index,
				Size = UDim2.new(1, 0, 0, 0),
				ZIndex = 75,
			})
			UiHelpers.createCorner(card, 8)
			UiHelpers.createStroke(card, Constants.THEME.Border, 1, 0.65)
			UiHelpers.create("UIPadding", {
				Parent = card,
				PaddingBottom = UDim.new(0, 9),
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
				PaddingTop = UDim.new(0, 9),
			})
			UiHelpers.createListLayout(card, 5)
			makeLabel(card, section.heading or ("Guide " .. tostring(index)), 13, Constants.THEME.Text, Enum.Font.GothamSemibold, 1)
			makeLabel(card, section.body or "", 11, Constants.THEME.MutedText, Enum.Font.Gotham, 2)
		end
	end

	for index, actionName in ipairs(actions) do
		local button = UiHelpers.create("TextButton", {
			Parent = nav,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 32),
			Text = actionName,
			TextColor3 = Constants.THEME.Text,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 75,
		})
		UiHelpers.createCorner(button, 7)
		UiHelpers.createStroke(button, Constants.THEME.Border, 1, 0.7)
		navButtons[actionName] = button
		button.MouseButton1Click:Connect(function()
			renderGuide(actionName)
		end)
	end

	renderGuide(selectedAction)

	return {
		destroy = function()
			if host and host.Parent then
				clearGuiObjects(host)
			end
		end,
		openGuide = renderGuide,
	}
end

return MicroHelpPopupSupport
