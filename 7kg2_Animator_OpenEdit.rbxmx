		elseif actionName == "Particles" then
			resumeMicroViewportOwnership()
			return runOption(options, "onAddTrack", "addTrack", "EmitterGroup")
		elseif actionName == "Lighting" then
			resumeMicroViewportOwnership()
			return runOption(options, "onAddLightingEffectTrack", "addLightingEffectTrack", "Lighting")
		elseif actionName == "Folder" then
			resumeMicroViewportOwnership()
			return runOption(options, "onAddTrack", "addTrack", "Folder")
		elseif actionName == "Track Options" then
