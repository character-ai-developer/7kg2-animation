function MicroWidgetController._prepareCompactImageButton(actionButton)
	for _, childName in ipairs({ "MegMoButtonIcon", "MegMoButtonTextOverlay" }) do
		local child = actionButton and actionButton:FindFirstChild(childName)
		if child and child:IsA("GuiObject") then
			child.Visible = false
		end
	end
	local inheritedPadding = actionButton and actionButton:FindFirstChild("MegMoButtonIconPadding")
	if inheritedPadding and inheritedPadding:IsA("UIPadding") then
		inheritedPadding.PaddingTop = UDim.new()
		inheritedPadding.PaddingBottom = UDim.new()
		inheritedPadding.PaddingLeft = UDim.new()
		inheritedPadding.PaddingRight = UDim.new()
	end
end

function MicroWidgetController._styleKeyframeActionStroke(actionButton)
	local actionStroke = actionButton and actionButton:FindFirstChild("MegMoButtonStroke")
	if actionStroke and actionStroke:IsA("UIStroke") then
		actionStroke.Color = theme().Accent
		actionStroke.Transparency = 0.25
		actionStroke:SetAttribute("MegMoThemeStrokeRole", "Accent")
	end
end

function MicroWidgetController._createFeaturePopup(gui, panel, tabName, options, onClose, onAfterAction)
	local info = WORKSPACE_POPUPS[tabName] or {
		title = tabName,
		description = "Use these compact controls while keeping the viewport visible.",
	}
	local panelPosition = panel and panel.Position or UDim2.fromOffset(96, 230)
	local panelSize = panel and panel.AbsoluteSize or Vector2.new(540, 310)
	local startX = panelPosition.X.Offset + math.min(panelSize.X + 12, 560)
	local startY = panelPosition.Y.Offset + 24
	local plugin = options and options.plugin
	local popupSettingPrefix = POPUP_SETTING_PREFIX .. tostring(tabName)
	local defaultPopupSize = MICRO_POPUP_SIZE
	local minPopupSize = MICRO_POPUP_MIN_SIZE
	local maxPopupSize = MAX_PANEL_SIZE
	local compactActionPopup = MICRO_SHELL_MENU_TABS[tabName]
		or tabName == "Theme"
		or tabName == "Help"
		or tabName == "Enhance"
		or tabName == "Summary"
		or tabName == "Settings"
		or tabName == "Camera"
		or tabName == "Audio"
		or tabName == "Keyframes"

	if compactActionPopup then
		local actionCount = info.actions and #info.actions or 0
		local rows = math.max(1, math.ceil(actionCount / 3))
		defaultPopupSize = Vector2.new(430, math.clamp(96 + (rows * 38), 170, 310))
		minPopupSize = Vector2.new(340, 160)
		maxPopupSize = Vector2.new(620, math.max(defaultPopupSize.Y + 80, minPopupSize.Y))
		if tabName == "Enhance" then
			defaultPopupSize = Vector2.new(620, 700)
			minPopupSize = Vector2.new(500, 520)
			maxPopupSize = Vector2.new(820, 820)
		elseif tabName == "Help" then
			defaultPopupSize = Vector2.new(560, 420)
			minPopupSize = Vector2.new(430, 330)
			maxPopupSize = Vector2.new(680, 560)
		elseif tabName == "Settings" then
			defaultPopupSize = Vector2.new(500, 720)
			minPopupSize = Vector2.new(420, 560)
			maxPopupSize = Vector2.new(640, 840)
		elseif tabName == "Edit" then
			defaultPopupSize = Vector2.new(560, 430)
			minPopupSize = Vector2.new(440, 340)
			maxPopupSize = Vector2.new(680, 560)
		elseif tabName == "Rig" then
			defaultPopupSize = Vector2.new(560, 540)
			minPopupSize = Vector2.new(440, 400)
			maxPopupSize = Vector2.new(720, 640)
		elseif tabName == "Keyframes" then
			defaultPopupSize = Vector2.new(500, 520)
			minPopupSize = Vector2.new(400, 420)
			maxPopupSize = Vector2.new(650, 680)
		elseif tabName == "Theme" then
			defaultPopupSize = Vector2.new(540, 420)
			minPopupSize = Vector2.new(430, 330)
			maxPopupSize = Vector2.new(680, 560)
		end
	end
	if tabName == "Faces" then
		defaultPopupSize = Vector2.new(900, 640)
		minPopupSize = Vector2.new(440, 320)
	elseif tabName == "Motion" then
		defaultPopupSize = Vector2.new(980, 640)
		minPopupSize = Vector2.new(840, 560)
	elseif tabName == "Presets" then
		defaultPopupSize = Vector2.new(940, 640)
		minPopupSize = Vector2.new(800, 560)
	elseif tabName == "Export" then
		defaultPopupSize = Vector2.new(980, 470)
		minPopupSize = Vector2.new(860, 430)
	end
	local modalShield = nil

	local popup = make("Frame", {
		Name = tabName .. "Popup",
		BackgroundColor3 = theme().Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = readSavedPosition(plugin, popupSettingPrefix, UDim2.fromOffset(startX, startY)),
		Size = readSavedSize(plugin, popupSettingPrefix, UDim2.fromOffset(defaultPopupSize.X, defaultPopupSize.Y), minPopupSize, maxPopupSize),
		Visible = false,
		ZIndex = 70,
	}, gui)
	popup.Destroying:Connect(function()
		if modalShield and modalShield.Parent then
			modalShield:Destroy()
		end
	end)
	setBackgroundRole(popup, "Panel")
	corner(popup, 8)
	UiHelpers.applyPanelSurface(popup)
	blockClickThrough(popup)
	local popupStroke = stroke(popup, theme().Accent, 0.12, 1, "Accent")

	local inputSink = make("TextButton", {
		Name = "InputSink",
		Active = true,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Modal = true,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 71,
	}, popup)
	blockClickThrough(inputSink)

	local titleBar = make("Frame", {
		Name = "TitleBar",
		BackgroundColor3 = theme().PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
		ZIndex = 72,
	}, popup)
	setBackgroundRole(titleBar, "PanelAlt")
	blockClickThrough(titleBar)
	corner(titleBar, 8)
	make("Frame", {
		Name = "TitleBarMask",
		BackgroundColor3 = titleBar.BackgroundColor3,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 8),
		ZIndex = 72,
	}, titleBar)
	makeDraggable(titleBar, popup, function()
		saveGeometry(plugin, popupSettingPrefix, popup)
	end)

	local titleText = text(titleBar, {
		Name = "Title",
		Font = Enum.Font.GothamBold,
		Text = info.title,
		TextSize = 13,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -86, 1, 0),
		ZIndex = 73,
	})

	local close = button(titleBar, "X", theme().PanelSoft)
	close.Position = UDim2.new(1, -32, 0, 6)
	close.Size = UDim2.fromOffset(24, 22)
	close.ZIndex = 74

	if tabName == "Enhance" then
		return MicroWidgetController._mountAnimationToolsPopup(popup, titleText, close, popupStroke, plugin, popupSettingPrefix, minPopupSize, maxPopupSize, options, onClose, onAfterAction, gui)
	end

	if tabName == "Settings" then
		return MicroWidgetController._mountAnimationSettingsPopup(popup, titleText, close, popupStroke, plugin, popupSettingPrefix, minPopupSize, maxPopupSize, options, onClose, onAfterAction)
	end

	if tabName == "Help" then
		local helpHost = make("Frame", {
			Name = "HelpHost",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 34),
			Size = UDim2.new(1, 0, 1, -34),
			ZIndex = 72,
		}, popup)
		blockClickThrough(helpHost)
		local mountedHelp = MicroHelpPopupSupport.mount(helpHost, {
			actions = info.actions,
		})
		popup.Destroying:Connect(function()
			if mountedHelp and type(mountedHelp.destroy) == "function" then
				mountedHelp.destroy()
				mountedHelp = nil
			end
		end)

		local resizeGrip = make("ImageButton", {
			Name = "ResizeGrip",
			Active = true,
			AnchorPoint = Vector2.new(1, 1),
			AutoButtonColor = false,
			BackgroundColor3 = theme().PanelSoft,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = "rbxassetid://104703373565023",
			ImageColor3 = theme().Text,
			ImageTransparency = 1,
			Position = UDim2.new(1, -5, 1, -5),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(16, 16),
			ZIndex = 80,
		}, popup)
		resizeGrip:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		resizeGrip:SetAttribute("MegMoThemeImageRole", "Text")
		corner(resizeGrip, 4)
		blockClickThrough(resizeGrip)

		local gripResizing = false
		local function setResizeGripVisible(visible)
			resizeGrip.BackgroundTransparency = visible and 0.42 or 1
			resizeGrip.ImageTransparency = visible and 0.08 or 1
		end
		resizeGrip.MouseEnter:Connect(function()
			setResizeGripVisible(true)
		end)
		resizeGrip.MouseLeave:Connect(function()
			if gripResizing then
				return
			end
			setResizeGripVisible(false)
		end)
		MicroWidgetController._makeResizable(resizeGrip, popup, function(isResizing)
			gripResizing = isResizing
			setResizeGripVisible(isResizing)
			popupStroke.Color = isResizing and Color3.fromRGB(58, 176, 255) or theme().Accent
			popupStroke.Transparency = isResizing and 0 or 0.12
			popupStroke.Thickness = isResizing and 2 or 1
			if not isResizing then
				saveGeometry(plugin, popupSettingPrefix, popup)
			end
		end, minPopupSize, maxPopupSize)

		close.MouseButton1Click:Connect(function()
			if type(onClose) == "function" then
				onClose()
			end
		end)

		ThemeService.applyToGui(popup)
		UiMotion.popupIn(popup)
		return popup
	end

	if tabName == "Faces" then
		local facesHost = make("Frame", {
			Name = "FacesHost",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 34),
			Size = UDim2.new(1, 0, 1, -34),
			ZIndex = 72,
		}, popup)
		local baseOnClose = onClose
		local mountedFaces
		local wrappedOnClose
		wrappedOnClose = function()
			if mountedFaces and type(mountedFaces.destroy) == "function" then
				mountedFaces.destroy()
				mountedFaces = nil
			end
			if type(baseOnClose) == "function" then
				baseOnClose()
			end
		end
		mountedFaces = MicroFacesPopupSupport.mount(facesHost, {
			getFacesViewModel = options and options.getFacesViewModel,
			onFacesAction = options and options.onFacesAction,
			onClose = wrappedOnClose,
		})
		popup.Destroying:Connect(function()
			if mountedFaces and type(mountedFaces.destroy) == "function" then
				mountedFaces.destroy()
				mountedFaces = nil
			end
		end)
		if mountedFaces and type(mountedFaces.refresh) == "function" then
			mountedFaces.refresh()
		end
		onClose = wrappedOnClose

		local resizeGrip = make("ImageButton", {
			Name = "ResizeGrip",
			Active = true,
			AnchorPoint = Vector2.new(1, 1),
			AutoButtonColor = false,
			BackgroundColor3 = theme().PanelSoft,
			BackgroundTransparency = 1,
