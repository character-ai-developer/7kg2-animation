          </Item>
          <Item class="ModuleScript" referent="RBX19">
            <Properties>
              <string name="Name">MegMoPathBridgeClient</string>
              <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local MegMoPathBridgeClient = {}

local REQUEST_EVENT_NAME = "MegMoPhysicsCaptureImportTake"
local RESULT_EVENT_NAME = "MegMoPhysicsCaptureImportResult"

local activeRequest = nil

local function finishRequest(request, result)
	if activeRequest ~= request then
		return
	end
	activeRequest = nil
	if request.connection then
		request.connection:Disconnect()
		request.connection = nil
	end
	if type(request.onComplete) == "function" then
		request.onComplete(result)
	end
end

function MegMoPathBridgeClient.Request(options)
	options = options or {}
	local requestEvent = CoreGui:FindFirstChild(REQUEST_EVENT_NAME)
	local resultEvent = CoreGui:FindFirstChild(RESULT_EVENT_NAME)
	if not (requestEvent and requestEvent:IsA("BindableEvent") and requestEvent:GetAttribute("MegMoBridgeReady") == true) then
		return false, "Open 7kg2 and add the Moving Object to its timeline before loading the path."
	end
	if not (resultEvent and resultEvent:IsA("BindableEvent")) then
		return false, "7kg2's physics bridge is not ready. Reopen 7kg2 and try again."
	end

	if activeRequest then
		finishRequest(activeRequest, {
			success = false,
			message = "The previous 7kg2 path request was replaced by a new request.",
		})
	end

	local request = {
		requestId = HttpService:GenerateGUID(false),
		action = options.action,
		onComplete = options.onComplete,
	}
	activeRequest = request
	request.connection = resultEvent.Event:Connect(function(result)
		if type(result) ~= "table"
			or result.source ~= "MegMoAnimator"
			or result.requestId ~= request.requestId
			or result.action ~= request.action then
			return
		end
		finishRequest(request, result)
	end)

	local payload = options.payload or {}
	payload.action = request.action
	payload.source = "MegMoPhysicsCapturePrototype"
	payload.requestId = request.requestId

	local fired, fireError = pcall(function()
		requestEvent:Fire(payload)
	end)
	if not fired then
		finishRequest(request, {
			success = false,
			message = "7kg2 could not receive the path request: " .. tostring(fireError),
		})
		return true
	end

	task.delay(4, function()
		if activeRequest == request then
			finishRequest(request, {
				success = false,
				message = "7kg2 did not answer the path request. Reopen the 7kg2 workspace, then try again.",
			})
		end
	end)
	return true
end

return MegMoPathBridgeClient
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX20">
            <Properties>
              <string name="Name">MultiRigRagdollSupport</string>
              <ProtectedString name="Source">local HttpService = game:GetService("HttpService")

local MultiRigRagdollSupport = {}

local ObjectCaptureSnapshot = require(script.Parent:WaitForChild("ObjectCaptureSnapshot"))
local PhysicsRecorder = require(script.Parent:WaitForChild("PhysicsRecorder"))
local RagdollRuntime = require(script.Parent:WaitForChild("RagdollRuntime"))

local function findTorso(rig)
	return rig and (rig:FindFirstChild("UpperTorso", true)
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("HumanoidRootPart", true)) or nil
end

local function restoreSessions(capture)
	for _, session in ipairs(capture and capture.sessions or {}) do
		RagdollRuntime.Restore(session)
	end
end

local function stopRecorders(capture)
	local takes = {}
	for _, recorder in ipairs(capture and capture.recorders or {}) do
		local take = recorder:Stop()
		if take then
			table.insert(takes, take)
		end
	end
	return takes
end

function MultiRigRagdollSupport.CollectSelected(selection, findRigFromInstance)
	local rigs = {}
	local seen = {}
	for _, selected in ipairs(selection or {}) do
		local rig = findRigFromInstance(selected)
		if rig and not seen[rig] then
			seen[rig] = true
			table.insert(rigs, rig)
		end
	end
	return rigs
end

function MultiRigRagdollSupport.SameRigs(first, second)
	if #(first or {}) ~= #(second or {}) then
		return false
	end
	for index, rig in ipairs(first or {}) do
		if second[index] ~= rig then
			return false
		end
	end
	return true
end

function MultiRigRagdollSupport.FindDuplicateName(rigs)
	local seen = {}
	for _, rig in ipairs(rigs or {}) do
		if seen[rig.Name] then
			return rig.Name
		end
		seen[rig.Name] = true
	end
	return nil
end

function MultiRigRagdollSupport.ClearCaptureAttributes(entries, attributeName)
	for _, entry in ipairs(entries or {}) do
		local rig = entry.rig
		if rig and rig.Parent and rig:GetAttribute(attributeName) == entry.id then
			rig:SetAttribute(attributeName, nil)
		end
	end
end

function MultiRigRagdollSupport.PrepareCaptureEntries(rigs, attributeName)
	local entries = {}
	for index, rig in ipairs(rigs or {}) do
		local id = HttpService:GenerateGUID(false)
		rig:SetAttribute(attributeName, id)
		entries[index] = {
			rig = rig,
			id = id,
			name = rig.Name,
			path = rig:GetFullName(),
		}
	end
	return entries
end

function MultiRigRagdollSupport.CaptureSnapshots(rigs)
	local descriptors = {}
	for _, rig in ipairs(rigs or {}) do
		table.insert(descriptors, { instance = rig })
	end
	return ObjectCaptureSnapshot.Capture(descriptors)
end

function MultiRigRagdollSupport.FindRuntimeRigs(entries, attributeName)
	local wanted = {}
	for _, entry in ipairs(entries or {}) do
		wanted[entry.id] = true
	end
	local foundById = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") then
			local id = descendant:GetAttribute(attributeName)
			if id and wanted[id] then
				foundById[id] = descendant
			end
		end
	end
	local rigs = {}
	local missing = 0
	for _, entry in ipairs(entries or {}) do
		local rig = foundById[entry.id]
		if rig then
			table.insert(rigs, rig)
		else
			missing += 1
		end
	end
	return rigs, missing
end

function MultiRigRagdollSupport.RestoreOriginals(entries, snapshots, attributeName)
	local resolvedById = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") then
			local id = descendant:GetAttribute(attributeName)
			if id then
				resolvedById[id] = descendant
			end
		end
	end

	local reboundRigs = {}
	for index, entry in ipairs(entries or {}) do
		local rig = resolvedById[entry.id]
		if not rig and entry.rig and entry.rig.Parent then
			rig = entry.rig
		end
		if not rig and entry.name then
			for _, descendant in ipairs(workspace:GetDescendants()) do
				if descendant:IsA("Model") and descendant.Name == entry.name then
					rig = descendant
					break
				end
			end
		end
		if rig then
			local snapshot = snapshots and snapshots[index]
			if snapshot then
				ObjectCaptureSnapshot.RebindSnapshot(snapshot, rig)
			end
			entry.rig = rig
			table.insert(reboundRigs, rig)
		end
	end
	return ObjectCaptureSnapshot.Restore(snapshots), reboundRigs
end

function MultiRigRagdollSupport.Start(runtimeRigs, options)
	options = options or {}
	local capture = {
		rigs = runtimeRigs,
		sessions = {},
		recorders = {},
	}
	for index, rig in ipairs(runtimeRigs or {}) do
		local session, sessionMessage = RagdollRuntime.Prepare(rig)
		if not session then
			stopRecorders(capture)
			restoreSessions(capture)
			return nil, string.format("Could not prepare %s: %s", rig.Name, tostring(sessionMessage))
		end
		table.insert(capture.sessions, session)

		local recorder = PhysicsRecorder.new({
			fps = options.fps,
			maxDuration = options.maxDuration,
		})
		local ok, recorderMessage = recorder:Start(rig, index == 1 and options.objectTargets or {})
		if not ok then
			stopRecorders(capture)
			restoreSessions(capture)
			return nil, string.format("Could not record %s: %s", rig.Name, tostring(recorderMessage))
		end
		table.insert(capture.recorders, recorder)
		RagdollRuntime.PrimeAirMotion(session)
	end

	if options.mode == "Knockback" then
		if typeof(options.contactPosition) ~= "Vector3"
			or typeof(options.originPosition) ~= "Vector3" then
			stopRecorders(capture)
			restoreSessions(capture)
			return nil, "Set the Knockback direction before starting the simulation."
		end
		local directionOffset = options.contactPosition - options.originPosition
		if directionOffset.Magnitude &lt; 0.05 then
			stopRecorders(capture)
			restoreSessions(capture)
			return nil, "Move PUSH FROM away from CONTACT to set the Knockback direction."
		end
		local primaryTorso = findTorso(runtimeRigs[1])
		if not (primaryTorso and primaryTorso:IsA("BasePart")) then
			stopRecorders(capture)
			restoreSessions(capture)
			return nil, "The first selected rig has no torso part for Knockback."
		end
		local contactOffset = options.contactPosition - primaryTorso.Position
		for index, session in ipairs(capture.sessions) do
			local torso = findTorso(session.rig)
			if not (torso and torso:IsA("BasePart")) then
				stopRecorders(capture)
				restoreSessions(capture)
				return nil, string.format("%s has no torso part for Knockback.", session.rig.Name)
			end
			local contact = torso.Position + contactOffset
			local origin = contact - directionOffset
			local applied, message = RagdollRuntime.ApplyDirectionalImpulse(
				session,
				contact,
				origin,
				options.speed
			)
			if not applied then
				stopRecorders(capture)
				restoreSessions(capture)
				return nil, string.format("Could not knock back %s: %s", session.rig.Name, tostring(message))
			end
			capture.recorders[index].take.ragdollKnockback = {
				contactPosition = contact,
				originPosition = origin,
				direction = directionOffset.Unit,
				speed = options.speed,
			}
		end
	end
	return capture, nil
end

function MultiRigRagdollSupport.StepRagdolls(capture, deltaTime)
	for _, session in ipairs(capture and capture.sessions or {}) do
		RagdollRuntime.Step(session, deltaTime)
	end
end

function MultiRigRagdollSupport.StepRecorders(capture, deltaTime)
	local reason = nil
	for _, recorder in ipairs(capture and capture.recorders or {}) do
		local _, recorderReason = recorder:Step(deltaTime)
		reason = reason or recorderReason
	end
	return reason
end

function MultiRigRagdollSupport.StopRecorders(capture)
	return stopRecorders(capture)
end

function MultiRigRagdollSupport.RestoreSessions(capture)
	restoreSessions(capture)
end

function MultiRigRagdollSupport.ApplyImpulse(capture, strength)
	local applied = 0
	for _, session in ipairs(capture and capture.sessions or {}) do
		if RagdollRuntime.ApplyImpulse(session, strength) then
			applied += 1
		end
	end
	return applied
end

return MultiRigRagdollSupport
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX21">
            <Properties>
              <string name="Name">ObjectCaptureSnapshot</string>
              <ProtectedString name="Source">local ObjectCaptureSnapshot = {}

local function getRelativePath(instance, ancestor)
	local path = {}
	local current = instance
	while current and current ~= ancestor do
		table.insert(path, 1, current.Name)
		current = current.Parent
	end
	return current == ancestor and path or nil
end

local function resolveRelativePath(ancestor, path)
	local current = ancestor
	for _, name in ipairs(path or {}) do
		current = current and current:FindFirstChild(name) or nil
		if not current then
			return nil
		end
	end
	return current
end

function ObjectCaptureSnapshot.Capture(descriptors)
	local snapshots = {}
	for _, descriptor in ipairs(descriptors or {}) do
		local target = descriptor.instance
		if target and target.Parent and target:IsA("BasePart") then
			table.insert(snapshots, {
				target = target,
				cframe = target.CFrame,
				parts = { { part = target, anchored = target.Anchored, cframe = target.CFrame } },
			})
		elseif target and target.Parent and target:IsA("Model") then
			local parts = {}
			for _, descendant in ipairs(target:GetDescendants()) do
				if descendant:IsA("BasePart") then
					table.insert(parts, {
						part = descendant,
						anchored = descendant.Anchored,
						cframe = descendant.CFrame,
						relativePath = getRelativePath(descendant, target),
					})
				end
			end
			if #parts &gt; 0 then
				table.insert(snapshots, {
					target = target,
					cframe = target:GetPivot(),
					parts = parts,
				})
			end
		end
	end
	return snapshots
end

function ObjectCaptureSnapshot.RebindSnapshot(snapshot, target)
	if not (target and target.Parent and target:IsA("Model")) then
		return false
	end
	local originalTarget = snapshot and snapshot.target
	if not (originalTarget and originalTarget:IsA("Model")) then
		return false
	end
	snapshot.target = target
	for _, item in ipairs(snapshot.parts or {}) do
		local part = resolveRelativePath(target, item.relativePath)
		if part and part:IsA("BasePart") then
			item.part = part
		end
	end
	return true
end

function ObjectCaptureSnapshot.RebindModel(snapshots, target)
	local rebound = false
	for _, snapshot in ipairs(snapshots or {}) do
		rebound = ObjectCaptureSnapshot.RebindSnapshot(snapshot, target) or rebound
	end
	return rebound
end

function ObjectCaptureSnapshot.Restore(snapshots)
	local valid = {}
	for _, snapshot in ipairs(snapshots or {}) do
		local target = snapshot.target
		if target and target.Parent then
			table.insert(valid, snapshot)
			for _, item in ipairs(snapshot.parts or {}) do
				local part = item.part
				if part and part.Parent then
					part.Anchored = true
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end
	end

	for _, snapshot in ipairs(valid) do
		if snapshot.target:IsA("Model") then
			local restoredParts = 0
			for _, item in ipairs(snapshot.parts or {}) do
				if item.part and item.part.Parent and typeof(item.cframe) == "CFrame" then
					item.part.CFrame = item.cframe
					restoredParts += 1
				end
			end
			if restoredParts == 0 then
				snapshot.target:PivotTo(snapshot.cframe)
			elseif snapshot.target.PrimaryPart == nil and typeof(snapshot.cframe) == "CFrame" then
				-- Restoring descendant CFrames does not restore WorldPivot on models
				-- without a PrimaryPart. Leaving that stale separates 7kg2's gizmo
				-- from the visible assembly on the next preview or retake.
				pcall(function()
					snapshot.target.WorldPivot = snapshot.cframe
				end)
			end
		else
			snapshot.target.CFrame = snapshot.cframe
		end
	end
	for _, snapshot in ipairs(valid) do
		for _, item in ipairs(snapshot.parts or {}) do
			if item.part and item.part.Parent then
				item.part.Anchored = item.anchored
			end
		end
	end
	return #valid
end

return ObjectCaptureSnapshot
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX22">
            <Properties>
              <string name="Name">PhysicsDriveRuntime</string>
              <ProtectedString name="Source">local PhysicsDriveRuntime = {}

local POSITION_GAIN = 1.5
local MIN_ASSIST_ACCELERATION = 35
local MAX_ASSIST_ACCELERATION = 360
local UPHILL_ACCELERATION_MARGIN = 30
local MIN_EXTRA_SPEED = 3
local MAX_EXTRA_SPEED = 12
local COURSE_POSITION_GAIN = 5
local MAX_COURSE_SPEED = 18
local COURSE_ASSIST_ACCELERATION = 280
local MAX_PITCH_SPEED = math.rad(150)
local MAX_OTHER_ANGULAR_SPEED = math.rad(45)
local OTHER_ANGULAR_DAMPING = 8
local UPRIGHT_RESPONSE = 8
local MAX_UPRIGHT_SPEED = math.rad(180)
local DRIVE_WHEEL_FRICTION = 0.05
local DRIVE_WHEEL_FRICTION_WEIGHT = 100
local DRIVE_SURFACE_RAY_EXTRA_HEIGHT = 2
local DRIVE_SURFACE_RAY_EXTRA_DEPTH = 5
local MIN_DRIVE_SURFACE_NORMAL_Y = 0.15

local function findNamedPart(target, names)
	for _, name in ipairs(names) do
		local candidate = target:FindFirstChild(name, true)
		if candidate and candidate:IsA("BasePart") then
			return candidate
		end
	end
	return nil
end

local function findLargestNonWheelPart(target)
	local bestPart = nil
	local bestVolume = -1
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local lowerName = string.lower(descendant.Name)
			if not string.find(lowerName, "wheel", 1, true) and not string.find(lowerName, "tire", 1, true) then
				local size = descendant.Size
				local volume = size.X * size.Y * size.Z
				if volume &gt; bestVolume then
					bestPart = descendant
					bestVolume = volume
				end
			end
		end
	end
	return bestPart
end

local function findRoot(target)
	if target:IsA("BasePart") then
		return target
	end
	return findNamedPart(target, { "Chassis", "DriveSeat", "VehicleSeat", "Body", "Main" })
		or target:FindFirstChildWhichIsA("VehicleSeat", true)
		or target.PrimaryPart
		or target:FindFirstChild("HumanoidRootPart", true)
		or findLargestNonWheelPart(target)
		or target:FindFirstChildWhichIsA("BasePart", true)
end

local function findBodyAssemblyRoot(target, preferredRoot)
	local assemblyRoot = preferredRoot and preferredRoot.AssemblyRootPart
	if assemblyRoot and (assemblyRoot == target or assemblyRoot:IsDescendantOf(target)) then
		return assemblyRoot
	end
	return preferredRoot
end

local function collectParts(target)
	if target:IsA("BasePart") then
		return { target }
	end
	local parts = {}
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function suspendTargetControllers(session)
	session.suspendedScripts = {}
	session.suspendedBodyMovers = {}
	for _, descendant in ipairs(session.target:GetDescendants()) do
		if descendant:IsA("BaseScript") then
			table.insert(session.suspendedScripts, {
				script = descendant,
				disabled = descendant.Disabled,
			})
			descendant.Disabled = true
		elseif descendant:IsA("BodyMover") then
			table.insert(session.suspendedBodyMovers, {
				mover = descendant,
				parent = descendant.Parent,
			})
			descendant.Parent = nil
		end
	end
end

local function restoreTargetControllers(session)
	for _, item in ipairs(session.suspendedBodyMovers or {}) do
		if item.mover and item.parent and item.parent.Parent then
			item.mover.Parent = item.parent
		end
	end
	for _, item in ipairs(session.suspendedScripts or {}) do
		if item.script and item.script.Parent then
			item.script.Disabled = item.disabled
		end
	end
	session.suspendedBodyMovers = nil
	session.suspendedScripts = nil
end

local function findWheelOwner(part, target)
	local current = part
	while current do
		local lowerName = string.lower(current.Name)
		if string.find(lowerName, "wheel", 1, true) or string.find(lowerName, "tire", 1, true) then
			return current
		end
		if current == target then
			break
		end
		current = current.Parent
	end
	return nil
end

local function readCollisionFidelity(part)
	local ok, value = pcall(function()
		return part.CollisionFidelity
	end)
	return ok and value or nil
end

local function writeCollisionFidelity(part, value)
	if value == nil then
		return
	end
	pcall(function()
		part.CollisionFidelity = value
	end)
end

local function applyVehicleCollisionProfile(session)
	if not session.target:IsA("Model") then
		return
	end

	local wheelSources = {}
	for _, item in ipairs(session.parts) do
		local owner = findWheelOwner(item.part, session.target)
		if owner then
			local size = item.part.Size
			local diameter = math.max(size.X, size.Y, size.Z)
			local existing = wheelSources[owner]
			if not existing or diameter &gt; existing.diameter then
				wheelSources[owner] = {
					part = item.part,
					diameter = diameter,
				}
			end
		end
	end

	local wheelContacts = 0
	for _ in pairs(wheelSources) do
		wheelContacts += 1
	end
	if wheelContacts &lt; 2 then
		return
	end

	local disabledBodyColliders = 0
	for _, item in ipairs(session.parts) do
		if item.canCollide then
			item.part.CanCollide = false
			disabledBodyColliders += 1
		end
	end

	session.contactProxies = {}
	for _, source in pairs(wheelSources) do
		local proxy = Instance.new("Part")
		proxy.Name = "__MegMoPhysicsDriveWheelContact"
		proxy.Shape = Enum.PartType.Ball
		proxy.Size = Vector3.one * source.diameter
		proxy.CFrame = CFrame.new(source.part.Position)
		proxy.Transparency = 1
		proxy.CastShadow = false
		proxy.CanCollide = true
		proxy.CanQuery = false
		proxy.CanTouch = false
		proxy.Massless = true
		proxy.Anchored = true
		proxy.Archivable = false
		proxy.CustomPhysicalProperties = PhysicalProperties.new(
			0.7,
			DRIVE_WHEEL_FRICTION,
			0,
			DRIVE_WHEEL_FRICTION_WEIGHT,
			100
		)
		pcall(function()
			proxy.CollisionGroup = source.part.CollisionGroup
		end)
		proxy.Parent = session.target

		local weld = Instance.new("WeldConstraint")
		weld.Name = "__MegMoPhysicsDriveWheelWeld"
		weld.Part0 = session.root
		weld.Part1 = proxy
		weld.Parent = proxy
		table.insert(session.contactProxies, proxy)
	end

	session.vehicleCollisionProfile = true
	session.vehicleWheelColliderCount = wheelContacts
	session.disabledBodyColliderCount = disabledBodyColliders
end

local function getSurfaceDriveDirection(session, pathDirection)
	session.surfaceNormal = nil
	local contacts = session.contactProxies
	if type(contacts) ~= "table" or #contacts == 0 then
		return pathDirection
	end
	local horizontalDirection = Vector3.new(pathDirection.X, 0, pathDirection.Z)
	if horizontalDirection.Magnitude &lt;= 0.001 then
		return pathDirection
	end
	horizontalDirection = horizontalDirection.Unit

	local leadingContact = nil
	local leadingDistance = -math.huge
	for _, proxy in ipairs(contacts) do
		if proxy and proxy.Parent then
			local distance = proxy.Position:Dot(horizontalDirection)
			if distance &gt; leadingDistance then
				leadingDistance = distance
				leadingContact = proxy
			end
		end
	end
	if not leadingContact then
		return pathDirection
	end

	local radius = math.max(leadingContact.Size.X, leadingContact.Size.Y, leadingContact.Size.Z) * 0.5
	local rayHeight = radius + DRIVE_SURFACE_RAY_EXTRA_HEIGHT
	local result = workspace:Raycast(
		leadingContact.Position + Vector3.yAxis * rayHeight,
		-Vector3.yAxis * (rayHeight + radius + DRIVE_SURFACE_RAY_EXTRA_DEPTH),
		session.surfaceRaycastParams
	)
	if not result or result.Normal.Y &lt; MIN_DRIVE_SURFACE_NORMAL_Y then
		return pathDirection
	end

	local tangent = pathDirection - result.Normal * pathDirection:Dot(result.Normal)
	if tangent.Magnitude &lt;= 0.001 or tangent:Dot(pathDirection) &lt;= 0 then
		return pathDirection
	end
	session.surfaceNormal = result.Normal
	return tangent.Unit
end

local function setTargetCFrame(target, cframe)
	if target:IsA("BasePart") then
		target.CFrame = cframe
	else
		target:PivotTo(cframe)
	end
end

local function setTargetFromRootCFrame(target, root, rootCFrame)
	if target:IsA("BasePart") then
		target.CFrame = rootCFrame
		return nil
	end
	local worldDelta = rootCFrame * root.CFrame:Inverse()
	target:PivotTo(worldDelta * target:GetPivot())
	return worldDelta
end

local function syncModelWorldPivot(target, targetCFrame)
	if not (target and target:IsA("Model") and target.PrimaryPart == nil and typeof(targetCFrame) == "CFrame") then
		return
	end
	pcall(function()
		target.WorldPivot = targetCFrame
	end)
end

local function getPathMotion(session, elapsed)
	local pathData = session.pathData
	local samples = pathData.samples
	local fps = math.max(1, tonumber(pathData.fps) or 30)
	local framePosition = math.clamp(elapsed * fps, 0, #samples - 1)
	local firstIndex = math.clamp(math.floor(framePosition) + 1, 1, #samples - 1)
	local secondIndex = firstIndex + 1
	local alpha = math.clamp(framePosition - math.floor(framePosition), 0, 1)
	local firstCFrame = samples[firstIndex].rootCFrame * session.rootPathOffset
	local secondCFrame = samples[secondIndex].rootCFrame * session.rootPathOffset
	return firstCFrame:Lerp(secondCFrame, alpha), (secondCFrame.Position - firstCFrame.Position) * fps
end

local function applyUprightAssist(session)
	if not (session.keepUpright and session.uprightAxisLocal) then
		return
	end
	local root = session.root
	local vehicleUp = root.CFrame:VectorToWorldSpace(session.uprightAxisLocal)
	if vehicleUp.Magnitude &lt;= 0.001 then
		return
	end
	vehicleUp = vehicleUp.Unit
	local targetUp = session.surfaceNormal or Vector3.yAxis
	if targetUp.Magnitude &lt;= 0.001 then
		return
	end
	targetUp = targetUp.Unit
	local angularVelocity = root.AssemblyAngularVelocity
	local yawVelocity = targetUp * angularVelocity:Dot(targetUp)
	local correctionVector = vehicleUp:Cross(targetUp)
	if correctionVector.Magnitude &lt;= 0.001 then
		root.AssemblyAngularVelocity = yawVelocity
		return
	end
	local correctionAxis = correctionVector.Unit
	local tiltAngle = math.atan2(
		correctionVector.Magnitude,
		math.clamp(vehicleUp:Dot(targetUp), -1, 1)
	)
	local correctionSpeed = math.min(tiltAngle * UPRIGHT_RESPONSE, MAX_UPRIGHT_SPEED)
	root.AssemblyAngularVelocity = yawVelocity + correctionAxis * correctionSpeed
end

function PhysicsDriveRuntime.MakeEditDescriptor(target, id)
	if not (target and target.Parent and (target:IsA("BasePart") or target:IsA("Model"))) then
		return nil
	end
	return {
		id = id,
		instance = target,
		name = target.Name,
		path = target:GetFullName(),
	}
end

function PhysicsDriveRuntime.Start(target, pathData, id, options)
	local samples = pathData and pathData.samples
	if not (target and target.Parent and type(samples) == "table" and #samples &gt;= 2) then
		return nil, "The Moving Object or its animated path is incomplete."
	end
	local root = findBodyAssemblyRoot(target, findRoot(target))
	local parts = collectParts(target)
	if not (root and root:IsA("BasePart") and #parts &gt; 0) then
		return nil, "The Moving Object does not contain a usable physics part."
	end
	local firstCFrame = samples[1].rootCFrame
	local lastCFrame = samples[#samples].rootCFrame
	if typeof(firstCFrame) ~= "CFrame" or typeof(lastCFrame) ~= "CFrame" then
		return nil, "The Moving Object path does not contain valid CFrame samples."
	end
	local duration = math.max(1 / math.max(1, tonumber(pathData.fps) or 30), tonumber(pathData.duration) or 0)
	local session = {
		target = target,
		root = root,
		pathData = pathData,
		duration = duration,
		elapsed = 0,
		parts = {},
		descriptor = {
			id = id,
			name = target.Name,
			part = root,
			target = target,
		},
		finished = false,
		keepUpright = type(options) == "table" and options.keepUpright == true,
	}
	print(string.format(
		"[7kg2 Physics Drive] target=%s root=%s assemblyRoot=%s parts=%d",
		target:GetFullName(),
		root.Name,
		root.AssemblyRootPart and root.AssemblyRootPart.Name or "&lt;none&gt;",
		#parts
	))
	suspendTargetControllers(session)
	print(string.format(
		"[7kg2 Physics Drive] suspended scripts=%d bodyMovers=%d",
		#session.suspendedScripts,
		#session.suspendedBodyMovers
	))
	for _, part in ipairs(parts) do
		table.insert(session.parts, {
			part = part,
			anchored = part.Anchored,
			canCollide = part.CanCollide,
			customPhysicalProperties = part.CustomPhysicalProperties,
			collisionFidelity = readCollisionFidelity(part),
		})
		part.Anchored = true
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
	applyVehicleCollisionProfile(session)
	local surfaceRaycastParams = RaycastParams.new()
	surfaceRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
	surfaceRaycastParams.FilterDescendantsInstances = { target }
	surfaceRaycastParams.IgnoreWater = true
	session.surfaceRaycastParams = surfaceRaycastParams
	setTargetCFrame(target, firstCFrame)
	session.rootPathOffset = firstCFrame:ToObjectSpace(root.CFrame)
	session.finalRootCFrame = lastCFrame * session.rootPathOffset
	if target:IsA("Model") then
		session.descriptor.rootToTargetPivot = root.CFrame:ToObjectSpace(target:GetPivot())
		session.descriptor.rootName = root.Name
	end
	for _, item in ipairs(session.parts) do
		item.part.Anchored = false
	end
	for _, proxy in ipairs(session.contactProxies or {}) do
		if proxy and proxy.Parent then
			proxy.Anchored = false
		end
	end
	local linearVelocity = (lastCFrame.Position - firstCFrame.Position) / duration
	session.lastPathDirection = linearVelocity.Magnitude &gt; 0.001 and linearVelocity.Unit or firstCFrame.LookVector
	session.forwardAxisLocal = root.CFrame:VectorToObjectSpace(session.lastPathDirection)
	session.uprightAxisLocal = root.CFrame:VectorToObjectSpace(firstCFrame.UpVector)
	session.launchSpeed = linearVelocity.Magnitude
	for _, item in ipairs(session.parts) do
		item.part.AssemblyLinearVelocity = linearVelocity
		item.part.AssemblyAngularVelocity = Vector3.zero
	end
	return session, nil
end

function PhysicsDriveRuntime.Step(session, deltaTime)
	if not (session and not session.finished and session.root and session.root.Parent) then
		return false, "stopped"
	end
	if session.assistFinished then
		return false, "complete"
	end

	local dt = math.clamp(tonumber(deltaTime) or 0, 0, 0.1)
	if dt &lt;= 0 then
		return true, nil
	end
	session.elapsed = math.min(session.duration, session.elapsed + dt)

	local targetCFrame, pathVelocity = getPathMotion(session, session.elapsed)
	local pathSpeed = pathVelocity.Magnitude
	local direction = pathSpeed &gt; 0.001 and pathVelocity.Unit or session.lastPathDirection
	if direction.Magnitude &gt; 0.001 then
		session.lastPathDirection = direction
		local driveDirection = getSurfaceDriveDirection(session, direction)
		local currentVelocity = session.root.AssemblyLinearVelocity
		local currentPathSpeed = currentVelocity:Dot(driveDirection)
		local lag = (targetCFrame.Position - session.root.Position):Dot(direction)
		local authoredSpeed = pathSpeed
		local recoveryReferenceSpeed = math.max(authoredSpeed, session.launchSpeed * 0.25)
		local maximumRecoverySpeed = math.clamp(
			recoveryReferenceSpeed * 0.35,
			MIN_EXTRA_SPEED,
			MAX_EXTRA_SPEED
		)
		local timingCorrection = math.clamp(
			lag * POSITION_GAIN,
			-authoredSpeed,
			maximumRecoverySpeed
		)
		local desiredPathSpeed = math.max(0, authoredSpeed + timingCorrection)
		local speedError = desiredPathSpeed - currentPathSpeed
		if math.abs(speedError) &gt; 0.01 then
			local uphillAcceleration = math.max(0, driveDirection.Y) * workspace.Gravity
			local acceleration = math.clamp(
				recoveryReferenceSpeed * 8 + uphillAcceleration + UPHILL_ACCELERATION_MARGIN,
				MIN_ASSIST_ACCELERATION,
				MAX_ASSIST_ACCELERATION
			)
			local speedCorrection = math.clamp(speedError, -acceleration * dt, acceleration * dt)
			session.root:ApplyImpulse(driveDirection * speedCorrection * session.root.AssemblyMass)
		end

		-- Preserve the pitch needed for ramps while suppressing the yaw/roll energy
		-- that otherwise accumulates into a late spin on constrained vehicles.
		local flatDirection = Vector3.new(direction.X, 0, direction.Z)
		if flatDirection.Magnitude &gt; 0.001 then
			local forwardAxis = flatDirection.Unit
			local rightAxis = forwardAxis:Cross(Vector3.yAxis).Unit
			local lateralOffset = (targetCFrame.Position - session.root.Position):Dot(rightAxis)
			local desiredLateralSpeed = math.clamp(
				lateralOffset * COURSE_POSITION_GAIN,
				-MAX_COURSE_SPEED,
				MAX_COURSE_SPEED
			)
			local lateralSpeed = session.root.AssemblyLinearVelocity:Dot(rightAxis)
			local lateralSpeedError = desiredLateralSpeed - lateralSpeed
			if math.abs(lateralSpeedError) &gt; 0.01 then
				local lateralCorrection = math.clamp(
					lateralSpeedError,
					-COURSE_ASSIST_ACCELERATION * dt,
					COURSE_ASSIST_ACCELERATION * dt
				)
				session.root:ApplyImpulse(rightAxis * lateralCorrection * session.root.AssemblyMass)
			end

			-- Loose-object impacts may transfer sideways momentum. Correct only
			-- across the authored route so ramp pitch and airborne motion stay free.
			local angularVelocity = session.root.AssemblyAngularVelocity
			local pitchSpeed = math.clamp(
				angularVelocity:Dot(rightAxis),
				-MAX_PITCH_SPEED,
				MAX_PITCH_SPEED
			)
			local pitchVelocity = rightAxis * pitchSpeed
			local otherVelocity = angularVelocity - rightAxis * angularVelocity:Dot(rightAxis)
			otherVelocity *= math.exp(-OTHER_ANGULAR_DAMPING * dt)
			if otherVelocity.Magnitude &gt; MAX_OTHER_ANGULAR_SPEED then
				otherVelocity = otherVelocity.Unit * MAX_OTHER_ANGULAR_SPEED
			end
			session.root.AssemblyAngularVelocity = pitchVelocity + otherVelocity
		end
		applyUprightAssist(session)
	end

	if session.elapsed &gt;= session.duration then
		for _, item in ipairs(session.parts or {}) do
			local part = item.part
			if part and part.Parent then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.Anchored = true
			end
		end
		-- Physics Drive promises to meet the authored endpoint. The vehicle may
		-- interact freely before this point, but the final captured frame must not
		-- inherit residual lag or rotation from the last collision.
		setTargetFromRootCFrame(session.target, session.root, session.finalRootCFrame)
		local finalPathCFrame = session.pathData.samples[#session.pathData.samples].rootCFrame
		syncModelWorldPivot(session.target, finalPathCFrame)
		print(string.format(
			"[7kg2 Physics Drive] reached final key at (%.3f, %.3f, %.3f)",
			session.finalRootCFrame.Position.X,
			session.finalRootCFrame.Position.Y,
			session.finalRootCFrame.Position.Z
		))
		session.assistFinished = true
		return false, "complete"
	end
	return true, nil
end

function PhysicsDriveRuntime.Cancel(session)
	if not session or session.finished then
		return
	end
	for _, item in ipairs(session.parts or {}) do
		local part = item.part
		if part and part.Parent then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
			part.CanCollide = item.canCollide
			part.CustomPhysicalProperties = item.customPhysicalProperties
			writeCollisionFidelity(part, item.collisionFidelity)
			part.Anchored = item.anchored
		end
	end
	for _, proxy in ipairs(session.contactProxies or {}) do
		if proxy and proxy.Parent then
			proxy:Destroy()
		end
	end
	session.contactProxies = nil
	restoreTargetControllers(session)
	session.finished = true
end

return PhysicsDriveRuntime
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX23">
            <Properties>
              <string name="Name">PhysicsEventRuntime</string>
              <ProtectedString name="Source">local PhysicsEventRuntime = {}

local RagdollRuntime = require(script.Parent:WaitForChild("RagdollRuntime"))
local PhysicsRigFilter = require(script.Parent:WaitForChild("PhysicsRigFilter"))
local BreakApartSupportRuntime = require(script.Parent:WaitForChild("BreakApartSupportRuntime"))

local STRENGTHS = {
	Light = {
		speed = 55,
		radius = 16,
		upwardBias = 0.24,
		projectileRadius = 1.8,
		projectileSpeed = 42,
	},
	Medium = {
		speed = 125,
		radius = 28,
		upwardBias = 0.36,
		projectileRadius = 2.8,
		projectileSpeed = 64,
	},
	Heavy = {
		speed = 260,
		radius = 48,
		upwardBias = 0.52,
		projectileRadius = 4.2,
		projectileSpeed = 88,
	},
}

local PRESET_POWER = {
	Light = 25,
	Medium = 50,
	Heavy = 100,
}

local LOW_PROFILE = {
	speed = 24,
	radius = 8,
	upwardBias = 0.16,
	projectileRadius = 1.1,
	projectileSpeed = 28,
}

local function lerpProfile(fromProfile, toProfile, alpha)
	local profile = {}
	for name, fromValue in pairs(fromProfile) do
		profile[name] = fromValue + (toProfile[name] - fromValue) * alpha
	end
	return profile
end

local function resolvePower(strength, power)
	return math.clamp(tonumber(power) or PRESET_POWER[strength] or PRESET_POWER.Medium, 10, 100)
end

local function profileFor(strength, power)
	local resolvedPower = resolvePower(strength, power)
	if resolvedPower &lt;= PRESET_POWER.Light then
		return lerpProfile(
			LOW_PROFILE,
			STRENGTHS.Light,
			(resolvedPower - 10) / (PRESET_POWER.Light - 10)
		)
	elseif resolvedPower &lt;= PRESET_POWER.Medium then
		return lerpProfile(
			STRENGTHS.Light,
			STRENGTHS.Medium,
			(resolvedPower - PRESET_POWER.Light) / (PRESET_POWER.Medium - PRESET_POWER.Light)
		)
	end
	return lerpProfile(
		STRENGTHS.Medium,
		STRENGTHS.Heavy,
		(resolvedPower - PRESET_POWER.Medium) / (PRESET_POWER.Heavy - PRESET_POWER.Medium)
	)
end

local function breakApartProfileFor(strength, power)
	local resolvedPower = resolvePower(strength, power)
	local alpha = math.clamp((resolvedPower - 10) / 90, 0, 1)
	-- Separated body parts make small velocity/radius changes look much larger than
	-- they do on an intact assembly. A smoothstep curve keeps 10-20% genuinely
	-- gradual while preserving the existing Medium and Heavy endpoints closely.
	local easedAlpha = alpha * alpha * (3 - 2 * alpha)
	return lerpProfile(LOW_PROFILE, STRENGTHS.Heavy, easedAlpha)
end

function PhysicsEventRuntime.GetBlastRadius(strength, power, reaction)
	local profile = reaction == "BreakApart"
		and breakApartProfileFor(strength, power)
		or profileFor(strength, power)
	return profile.radius
end

local function isValidPart(part)
	return part and part.Parent and part:IsA("BasePart")
end

local function copyMarker(marker)
	local strength = STRENGTHS[marker.strength] and marker.strength
		or marker.strength == "Custom" and "Custom"
		or "Medium"
	return {
		id = marker.id,
		kind = marker.kind == "Projectile" and "Projectile" or "Explosion",
		time = math.max(0, tonumber(marker.time) or 0),
		position = typeof(marker.position) == "Vector3" and marker.position or Vector3.zero,
		startPosition = typeof(marker.startPosition) == "Vector3" and marker.startPosition or nil,
		endPosition = typeof(marker.endPosition) == "Vector3" and marker.endPosition or nil,
		strength = strength,
		power = resolvePower(strength, marker.power),
		reaction = marker.reaction == "Ragdoll" and "Ragdoll"
			or marker.reaction == "BreakApart" and "BreakApart"
			or marker.reaction == "Break" and "Break"
			or "Push",
		directionMode = marker.directionMode == "Upward" and "Upward"
			or marker.directionMode == "Forward" and "Forward"
			or "Outward",
		directionVector = typeof(marker.directionVector) == "Vector3"
			and marker.directionVector.Magnitude &gt; 0.001
			and marker.directionVector.Unit
			or Vector3.zAxis,
		slowMotion = math.clamp(tonumber(marker.slowMotion) or 1, 0.5, 10),
		playbackSpeed = math.clamp(
			tonumber(marker.playbackSpeed) or (1 / math.clamp(tonumber(marker.slowMotion) or 1, 0.5, 10)),
			0.1,
			2
		),
		sourceName = tostring(marker.sourceName or "Event Point"),
		sourceId = marker.sourceId,
		vfxSource = marker.vfxSource,
		vfxSourceDescriptor = marker.vfxSourceDescriptor,
		vfxSourceName = marker.vfxSourceName,
		vfxEmitCount = marker.vfxEmitCount,
	}
end

local function releasePart(part)
	if not isValidPart(part) then
		return
	end
	local connectedParts = { part }
	pcall(function()
		connectedParts = part:GetConnectedParts(true)
		table.insert(connectedParts, part)
	end)
	for _, connectedPart in ipairs(connectedParts) do
		if isValidPart(connectedPart) then
			connectedPart.Anchored = false
		end
	end
	pcall(function()
		local root = part.AssemblyRootPart or part
		root:SetNetworkOwner(nil)
	end)
end

local function breakPart(part)
	if not isValidPart(part) then
		return
	end
	pcall(function()
		part:BreakJoints()
	end)
	for _, descendant in ipairs(part:GetDescendants()) do
		if descendant:IsA("Constraint") or descendant:IsA("JointInstance") then
			descendant:Destroy()
		end
	end
end

local function findHumanoidRig(part)
	return PhysicsRigFilter.FindSupportedRagdollRig(part)
end

local function prepareBlastRagdoll(session, rig)
	if not (session and rig and rig.Parent) then
		return nil
	end
	if session.ragdollByRig[rig] then
		return session.ragdollByRig[rig]
	end
	local ragdollSession = RagdollRuntime.Prepare(rig)
	if not ragdollSession then
		return nil
	end
	session.ragdollByRig[rig] = ragdollSession
	table.insert(session.ragdollSessions, ragdollSession)
	return ragdollSession
end

local function prepareBlastPush(session, rig)
	if not (session and rig and rig.Parent) then
		return nil
	end
	if session.pushByRig[rig] then
		return session.pushByRig[rig]
	end
	local pushSession = RagdollRuntime.PrepareRigidPush(rig)
	if not pushSession then
		return nil
	end
	session.pushByRig[rig] = pushSession
	table.insert(session.pushSessions, pushSession)
	return pushSession
end

local function prepareBlastBreakApart(session, rig)
	if not (session and rig and rig.Parent) then
		return nil
	end
	if session.breakApartByRig[rig] then
		return session.breakApartByRig[rig]
	end
	local breakApartSession = RagdollRuntime.PrepareBreakApart(rig)
	if not breakApartSession then
		return nil
	end
	session.breakApartByRig[rig] = breakApartSession
	table.insert(session.breakApartSessions, breakApartSession)
	return breakApartSession
end

local function restoreBlastRigReactions(session)
	for index = #(session and session.breakApartSessions or {}), 1, -1 do
		RagdollRuntime.Restore(session.breakApartSessions[index])
	end
	for index = #(session and session.ragdollSessions or {}), 1, -1 do
		RagdollRuntime.Restore(session.ragdollSessions[index])
	end
	for index = #(session and session.pushSessions or {}), 1, -1 do
		RagdollRuntime.Restore(session.pushSessions[index])
	end
	if session then
		session.breakApartSessions = {}
		session.breakApartByRig = {}
		session.ragdollSessions = {}
		session.ragdollByRig = {}
		session.pushSessions = {}
		session.pushByRig = {}
	end
end

local function prepareRigidPushGroups(session)
	local partsByGroup = {}
	for _, target in ipairs(session and session.targets or {}) do
		local part = target.part
		local group = target.group
		if isValidPart(part)
			and group
			and group.Parent
			and group:IsA("Model")
			and not PhysicsRigFilter.IsSupportedRagdollRig(group) then
			partsByGroup[group] = partsByGroup[group] or {}
			table.insert(partsByGroup[group], part)
		end
	end
	for group, parts in pairs(partsByGroup) do
		if #parts &gt; 1 then
			local included = {}
			for _, part in ipairs(parts) do
				included[part] = true
			end
			local root = included[group.PrimaryPart] and group.PrimaryPart or parts[1]
			local connected = { [root] = true }
			pcall(function()
				for _, part in ipairs(root:GetConnectedParts(true)) do
					connected[part] = true
				end
			end)
			for _, part in ipairs(parts) do
				if part ~= root and not connected[part] then
					local weld = Instance.new("WeldConstraint")
					weld.Name = "MegMoPhysicsCapture_RigidPush"
					weld.Part0 = root
					weld.Part1 = part
					weld.Parent = root
					table.insert(session.rigidPushWelds, weld)
				end
			end
		end
	end
end

local function restoreRigidPushGroups(session)
	for index = #(session and session.rigidPushWelds or {}), 1, -1 do
		local weld = session.rigidPushWelds[index]
		if weld then
			weld:Destroy()
		end
	end
	if session then
		session.rigidPushWelds = {}
	end
end

local function jointParts(instance)
	if instance:IsA("JointInstance") then
		return instance.Part0, instance.Part1
	end
	if instance:IsA("Constraint") then
		local attachment0 = instance.Attachment0
		local attachment1 = instance.Attachment1
		return attachment0 and attachment0.Parent, attachment1 and attachment1.Parent
	end
	return nil, nil
end

local function findJointContainer(part)
	local current = part
	while current and current.Parent and current.Parent ~= workspace do
		current = current.Parent
	end
	return current or part
end

local function severAffectedParts(parts)
	local affected = {}
	local containers = {}
	for _, part in ipairs(parts) do
		if isValidPart(part) then
			affected[part] = true
			containers[findJointContainer(part)] = true
		end
	end
	for container in pairs(containers) do
		for _, descendant in ipairs(container:GetDescendants()) do
			if descendant:IsA("JointInstance") or descendant:IsA("Constraint") then
				local part0, part1 = jointParts(descendant)
				if affected[part0] or affected[part1] then
					descendant:Destroy()
				end
			end
		end
	end
	for part in pairs(affected) do
		pcall(function()
			part:BreakJoints()
		end)
		part.Anchored = false
		pcall(function()
			part:SetNetworkOwner(nil)
		end)
	end
end

local function applyImpulse(part, direction, speed, point, appliedAssemblies)
	if not isValidPart(part) or direction.Magnitude &lt; 0.001 then
		return false
	end
	local root = part.AssemblyRootPart or part
	if appliedAssemblies[root] then
		return false
	end
	appliedAssemblies[root] = true
	local impulse = direction.Unit * speed * math.max(root.AssemblyMass, 0.05)
	local ok = pcall(function()
		root:ApplyImpulseAtPosition(impulse, point)
	end)
	if not ok then
		pcall(function()
			root:ApplyImpulse(impulse)
		end)
	end
	return true
end

local function collectParts(session)
	local parts = {}
	for _, descriptor in ipairs(session.targets) do
		local part = descriptor.part
		if isValidPart(part) then
			table.insert(parts, part)
		end
	end
	return parts
end

local function closestPointOnPart(part, position)
	local localPosition = part.CFrame:PointToObjectSpace(position)
	local halfSize = part.Size * 0.5
	local clamped = Vector3.new(
		math.clamp(localPosition.X, -halfSize.X, halfSize.X),
		math.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),
		math.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)
	)
	return part.CFrame:PointToWorldSpace(clamped)
end

local function nearestPart(parts, position)
	local nearest = nil
	local nearestDistance = math.huge
	for _, part in ipairs(parts) do
		local distance = (closestPointOnPart(part, position) - position).Magnitude
		if distance &lt; nearestDistance then
			nearest = part
			nearestDistance = distance
		end
	end
	return nearest, nearestDistance
end

local function sourcePivot(source)
	local target = source and source.target
	if not (target and target.Parent) then
		return nil
	end
	return target:IsA("Model") and target:GetPivot() or target.CFrame
end

local function setSourcePivot(source, cframe)
	local target = source and source.target
	if not (target and target.Parent and typeof(cframe) == "CFrame") then
		return
	end
	if target:IsA("Model") then
		target:PivotTo(cframe)
	else
		target.CFrame = cframe
	end
end

local function prepareSource(source)
	if not source or source.prepared then
		return
	end
	source.prepared = true
	source.originals = {}
	for _, part in ipairs(source.parts or {}) do
		if isValidPart(part) then
			table.insert(source.originals, {
				part = part,
				anchored = part.Anchored,
				canCollide = part.CanCollide,
			})
			part.Anchored = true
			part.CanCollide = false
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function releaseProjectileShot(shot)
	if not (shot and not shot.released and shot.source) then
		return
	end
	shot.released = true
	setSourcePivot(shot.source, shot.contactPivot)
	for _, original in ipairs(shot.source.originals or {}) do
		local part = original.part
		if isValidPart(part) then
			part.CanCollide = original.canCollide
			part.Anchored = false
		end
	end
	local root = shot.source.root
	if not isValidPart(root) then
		return
	end
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	root.AssemblyLinearVelocity = shot.releaseVelocity
	local horizontalVelocity = Vector3.new(shot.releaseVelocity.X, 0, shot.releaseVelocity.Z)
	if horizontalVelocity.Magnitude &gt; 0.001 then
		local radius = math.max(0.25, math.min(root.Size.X, root.Size.Z) * 0.5)
		root.AssemblyAngularVelocity = horizontalVelocity.Unit:Cross(Vector3.yAxis)
			* (horizontalVelocity.Magnitude / radius)
	end
end

local function beginProjectileShot(shot)
	if not (shot and not shot.started and shot.source) then
		return
	end
	shot.started = true
	for _, original in ipairs(shot.source.originals or {}) do
		local part = original.part
		if isValidPart(part) then
			part.Anchored = true
			part.CanCollide = false
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function restoreSources(session)
	for _, source in ipairs(session.sources or {}) do
		for _, original in ipairs(source.originals or {}) do
			local part = original.part
			if isValidPart(part) then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.CanCollide = original.canCollide
				part.Anchored = original.anchored
			end
		end
		source.originals = nil
		source.prepared = nil
	end
end

local function prepareProjectileShot(session, marker)
	local source = marker.sourceId and session.sourceById[marker.sourceId] or nil
	if not source then
		return nil
	end
	local currentPivot = sourcePivot(source)
	if not currentPivot then
		return nil
	end
	local parts = collectParts(session)
	local startPosition = marker.startPosition or currentPivot.Position
	local startPivot = CFrame.new(startPosition - currentPivot.Position) * currentPivot
	local endPosition = marker.endPosition
	local hitPart = endPosition and nearestPart(parts, endPosition) or nearestPart(parts, startPosition)
	if not hitPart then
		return nil
	end
	endPosition = endPosition or closestPointOnPart(hitPart, startPosition)
	local fullTravel = endPosition - startPosition
	local hitPosition = endPosition
	if fullTravel.Magnitude &gt; 0.001 then
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Include
		raycastParams.FilterDescendantsInstances = parts
		raycastParams.IgnoreWater = true
		local result = workspace:Raycast(startPosition, fullTravel, raycastParams)
		if result and isValidPart(result.Instance) then
			hitPart = result.Instance
			hitPosition = result.Position
		end
	end
	local profile = profileFor(marker.strength, marker.power)
	local contactTravel = hitPosition - startPosition
	local contactDuration = math.clamp(
		contactTravel.Magnitude / math.max(profile.projectileSpeed, 0.001),
		0.12,
		0.55
	)
	local launchTime = math.max(0, marker.time - contactDuration)
	local releaseDirection = contactTravel.Magnitude &gt; 0.001
		and contactTravel.Unit
		or fullTravel.Magnitude &gt; 0.001 and fullTravel.Unit
		or currentPivot.LookVector
	prepareSource(source)
	return {
		source = source,
		startPivot = startPivot,
		contactPivot = CFrame.new(contactTravel) * startPivot,
		startPosition = startPosition,
		hitPosition = hitPosition,
		endPosition = endPosition,
		hitPart = hitPart,
		launchTime = launchTime,
		contactTime = marker.time,
		contactDuration = math.max(0.001, marker.time - launchTime),
		endTime = marker.time,
		releaseVelocity = releaseDirection * profile.projectileSpeed,
	}
end

local function updateProjectileShots(session)
	for _, marker in ipairs(session.markers) do
		local shot = marker.shot
		if marker.kind == "Projectile" and shot and not shot.released and session.elapsed &gt;= shot.launchTime then
			beginProjectileShot(shot)
			if session.elapsed &lt; shot.contactTime then
				local alpha = math.clamp(
					(session.elapsed - shot.launchTime) / shot.contactDuration,
					0,
					1
				)
				setSourcePivot(shot.source, shot.startPivot:Lerp(shot.contactPivot, alpha))
			else
				releaseProjectileShot(shot)
			end
		end
	end
end

local function projectileShotsComplete(session)
	for _, marker in ipairs(session.markers) do
		local shot = marker.shot
		if marker.kind == "Projectile" and shot and not shot.released then
			return false
		end
	end
	return true
end

local function rigBlastPosition(rig)
	local torso = rig and (rig:FindFirstChild("UpperTorso", true)
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("HumanoidRootPart", true))
	if torso and torso:IsA("BasePart") then
		return torso.Position
	end
	return rig and rig:GetPivot().Position or Vector3.zero
end

local function blastDirection(marker, targetPosition, upwardBias, isRig)
	local away = targetPosition - marker.position
	if away.Magnitude &lt; 0.05 then
		away = marker.directionVector.Magnitude &gt; 0.001
			and marker.directionVector
			or Vector3.zAxis
	end
	local radialDirection = away.Unit
	if marker.directionMode == "Upward" then
		return (Vector3.yAxis + radialDirection * (isRig and 0.18 or 0.28)).Unit
	elseif marker.directionMode == "Forward" then
		local forward = marker.directionVector.Magnitude &gt; 0.001
			and marker.directionVector.Unit
			or Vector3.zAxis
		return (forward + radialDirection * (isRig and 0.12 or 0.22)
			+ Vector3.yAxis * (isRig and 0.06 or 0.12)).Unit
	end
	-- A coherent character blast needs to travel away from the origin. The old
	-- full upward bias made intact rigs jump in place, especially when the event
	-- point was near their centre. Loose-object behaviour remains unchanged.
	local resolvedUpwardBias = isRig and (0.06 + upwardBias * 0.32) or upwardBias
	return (radialDirection + Vector3.yAxis * resolvedUpwardBias).Unit
end

local function characterReactionPowerMultiplier(marker)
	if marker.reaction ~= "Push" and marker.reaction ~= "Ragdoll" then
		return 1
	end
	local power = math.clamp(tonumber(marker.power) or 50, 10, 100)
	-- Keep the tested 10-50% range predictable, then open up a deliberately
	-- cinematic top end. The quadratic ramp reaches 2.5x at 100% without making
	-- small slider changes around Medium power unexpectedly violent.
	local highPowerAlpha = math.clamp((power - 50) / 50, 0, 1)
	return 1 + highPowerAlpha * highPowerAlpha * 1.5
end

local function ragdollExplosionSpeed(power)
	-- Make the Ragdoll slider describe the raw impulse directly. Stacking a
	-- second Ragdoll multiplier on profileFor() made 25% far weaker than its
	-- label implied while 100% remained cinematic. Keep that tested maximum,
	-- but make every lower value a proportional share of it.
	local resolvedPower = math.clamp(tonumber(power) or 50, 10, 100)
	local maximumSpeed = STRENGTHS.Heavy.speed * 2.5 * 1.15
	return maximumSpeed * (resolvedPower / 100)
end

local function fireExplosion(session, marker)
	local profile = marker.reaction == "BreakApart"
		and breakApartProfileFor(marker.strength, marker.power)
		or profileFor(marker.strength, marker.power)
	local reactionPowerMultiplier = characterReactionPowerMultiplier(marker)
	local parts = collectParts(session)
	local affected = {}
	for _, part in ipairs(parts) do
		local distance = (part.Position - marker.position).Magnitude
		if distance &lt;= profile.radius then
			table.insert(affected, {
				part = part,
				distance = distance,
			})
		end
	end
	if #affected == 0 then
		local fallback = nearestPart(parts, marker.position)
		if fallback then
			table.insert(affected, {
				part = fallback,
				distance = (fallback.Position - marker.position).Magnitude,
			})
		end
	end

	local rigReactionSessions = {}
	local rigReactionDistances = {}
	if marker.reaction == "Push" then
		for _, item in ipairs(affected) do
			local rig = findHumanoidRig(item.part)
			if rig then
				rigReactionDistances[rig] = math.min(rigReactionDistances[rig] or math.huge, item.distance)
				rigReactionSessions[rig] = prepareBlastPush(session, rig)
			end
		end
	elseif marker.reaction == "Ragdoll" then
		for _, item in ipairs(affected) do
			local rig = findHumanoidRig(item.part)
			if rig then
				rigReactionDistances[rig] = math.min(rigReactionDistances[rig] or math.huge, item.distance)
				rigReactionSessions[rig] = prepareBlastRagdoll(session, rig)
			end
		end
	elseif marker.reaction == "BreakApart" then
		local looseBreakParts = {}
		for _, item in ipairs(affected) do
			local rig = findHumanoidRig(item.part)
			if rig then
				prepareBlastBreakApart(session, rig)
			else
				table.insert(looseBreakParts, item.part)
			end
		end
		severAffectedParts(looseBreakParts)
		BreakApartSupportRuntime.ReleaseUnsupported(parts, looseBreakParts, function(part)
			return findHumanoidRig(part) == nil
		end)
	elseif marker.reaction == "Break" then
		-- Legacy saved events used one hybrid reaction: rigs ragdolled while
		-- ordinary assemblies broke. Preserve that interpretation on load.
		for _, item in ipairs(affected) do
			local rig = findHumanoidRig(item.part)
			if rig then
				prepareBlastRagdoll(session, rig)
			else
				breakPart(item.part)
			end
		end
	end

	local appliedAssemblies = {}
	local impulses = 0
	for _, item in ipairs(affected) do
		local part = item.part
		local rig = findHumanoidRig(part)
		local handledAsCharacter = (marker.reaction == "Push" or marker.reaction == "Ragdoll")
			and rig
			and rigReactionSessions[rig] ~= nil
		if not handledAsCharacter then
			releasePart(part)
			local direction = blastDirection(marker, part.Position, profile.upwardBias, false)
			local falloff = math.clamp(1 - item.distance / math.max(profile.radius, 0.001), 0.18, 1)
			local speed = profile.speed * falloff
			if marker.reaction == "Push" then
				speed *= reactionPowerMultiplier
			end
			if applyImpulse(part, direction, speed, marker.position, appliedAssemblies) then
				impulses += 1
			end
		end
	end

	for rig, reactionSession in pairs(rigReactionSessions) do
		if reactionSession then
			local position = rigBlastPosition(rig)
			local direction = blastDirection(marker, position, profile.upwardBias, true)
			local distance = rigReactionDistances[rig] or (position - marker.position).Magnitude
			local falloff = math.clamp(1 - distance / math.max(profile.radius, 0.001), 0.35, 1)
			local speed = marker.reaction == "Ragdoll"
				and ragdollExplosionSpeed(marker.power) * falloff
				or profile.speed * falloff * reactionPowerMultiplier
			if marker.reaction == "Ragdoll" then
				-- Let Roblox rebuild the newly constrained ragdoll assembly for one
				-- physics step before applying the blast. Applying it in the same
				-- PreSimulation callback as Prepare() can target the stale rigid
				-- assembly, making the first Push -&gt; Ragdoll test much weaker than
				-- an identical repeat.
				table.insert(session.pendingCharacterImpulses, {
					reactionSession = reactionSession,
					direction = direction,
					speed = speed,
					stepsRemaining = 1,
				})
				impulses += 1
			else
				local applied = RagdollRuntime.ApplyExplosionImpulse(
					reactionSession,
					direction,
					speed,
					false
				)
				if applied then
					impulses += 1
				end
			end
		end
	end
	return impulses
end

local function stepPendingCharacterImpulses(session)
	for index = #(session.pendingCharacterImpulses or {}), 1, -1 do
		local pending = session.pendingCharacterImpulses[index]
		pending.stepsRemaining = math.max(0, (pending.stepsRemaining or 1) - 1)
		if pending.stepsRemaining == 0 then
			RagdollRuntime.ApplyExplosionImpulse(
				pending.reactionSession,
				pending.direction,
				pending.speed,
				true
			)
			table.remove(session.pendingCharacterImpulses, index)
		end
	end
end

local function fireProjectile(session, marker)
	local profile = profileFor(marker.strength, marker.power)
	local parts = collectParts(session)
	local shot = marker.shot
	local sourcePosition = shot and shot.startPosition or marker.position
	local hitPart = shot and shot.hitPart or nearestPart(parts, sourcePosition)
	if not hitPart then
		return 0
	end
	local hitPosition = shot and shot.hitPosition or closestPointOnPart(hitPart, sourcePosition)
	local direction = hitPosition - sourcePosition
	if direction.Magnitude &lt; 0.001 then
		direction = hitPart.CFrame.LookVector
	end
	local hitRadius = profile.projectileRadius
	local affected = {
		{
			part = hitPart,
			distance = 0,
		},
	}
	local affectedParts = {
		[hitPart] = true,
	}
	for _, part in ipairs(parts) do
		local closest = closestPointOnPart(part, hitPosition)
		local distance = (closest - hitPosition).Magnitude
		if not affectedParts[part] then
			affectedParts[part] = true
			table.insert(affected, {
				part = part,
				distance = distance,
			})
		end
	end

	if marker.reaction == "Ragdoll" then
		for _, item in ipairs(affected) do
			local rig = findHumanoidRig(item.part)
			if rig then
				prepareBlastRagdoll(session, rig)
			end
		end
	elseif marker.reaction == "BreakApart" then
		local looseBreakParts = {}
		for _, item in ipairs(affected) do
			local rig = findHumanoidRig(item.part)
			if rig then
				prepareBlastBreakApart(session, rig)
			else
				table.insert(looseBreakParts, item.part)
			end
		end
		severAffectedParts(looseBreakParts)
	elseif marker.reaction == "Break" then
		local breakParts = {}
		for _, item in ipairs(affected) do
			table.insert(breakParts, item.part)
		end
		severAffectedParts(breakParts)
	end

	local appliedAssemblies = {}
	local impulses = 0
	for _, item in ipairs(affected) do
		local part = item.part
		if marker.reaction ~= "Break" and marker.reaction ~= "BreakApart" then
			releasePart(part)
		end
		local spread = part.Position - hitPosition
		local spreadDirection = spread.Magnitude &gt; 0.001 and spread.Unit or Vector3.zero
		local impulseDirection = (direction.Unit + spreadDirection * 0.16 + Vector3.yAxis * 0.08).Unit
		local falloff = math.clamp(1 - item.distance / math.max(hitRadius, 0.001), 0.25, 1)
		if applyImpulse(part, impulseDirection, profile.speed * falloff, hitPosition, appliedAssemblies) then
			impulses += 1
		end
	end
	return impulses
end

local function fireMarker(session, marker)
	local impulses = marker.kind == "Projectile"
		and fireProjectile(session, marker)
		or fireExplosion(session, marker)
	table.insert(session.fired, {
		id = marker.id,
		kind = marker.kind,
		time = session.elapsed,
		strength = marker.strength,
		power = marker.power,
		reaction = marker.reaction,
		impulses = impulses,
	})
	if type(session.onMarkerFired) == "function" then
		pcall(session.onMarkerFired, marker)
	end
	return impulses
end

function PhysicsEventRuntime.Start(markers, targets, sources, callbacks)
	if type(markers) ~= "table" or #markers == 0 then
		return nil, "Add at least one timed physics event before starting the simulation."
	end
	if type(targets) ~= "table" or #targets == 0 then
		return nil, "Select at least one object for the physics events to affect."
	end

	local copiedMarkers = {}
	for _, marker in ipairs(markers) do
		table.insert(copiedMarkers, copyMarker(marker))
	end
	table.sort(copiedMarkers, function(a, b)
		if a.time == b.time then
			return tostring(a.id or "") &lt; tostring(b.id or "")
		end
		return a.time &lt; b.time
	end)

	local session = {
		markers = copiedMarkers,
		targets = targets,
		sources = sources or {},
		sourceById = {},
		ragdollSessions = {},
		ragdollByRig = {},
		pushSessions = {},
		pushByRig = {},
		breakApartSessions = {},
		breakApartByRig = {},
		pendingCharacterImpulses = {},
		rigidPushWelds = {},
		elapsed = 0,
		nextIndex = 1,
		fired = {},
		complete = false,
		onMarkerFired = type(callbacks) == "table" and callbacks.onMarkerFired or nil,
	}
	for _, source in ipairs(session.sources) do
		if source.id then
			session.sourceById[source.id] = source
		end
	end
	for _, marker in ipairs(session.markers) do
		if marker.reaction == "Push" then
			prepareRigidPushGroups(session)
			break
		end
	end
	for _, marker in ipairs(session.markers) do
		if marker.kind == "Projectile" then
			marker.shot = prepareProjectileShot(session, marker)
			if not marker.shot then
				restoreRigidPushGroups(session)
				restoreSources(session)
				return nil, string.format(
					"Could not prepare projectile %s. Set its source again, then re-arm the capture.",
					tostring(marker.sourceName or "event")
				)
			end
		end
	end
	return session, string.format("Prepared %d timed physics event%s.", #copiedMarkers, #copiedMarkers == 1 and "" or "s")
end

function PhysicsEventRuntime.Step(session, deltaTime)
	if not session or session.complete then
		return 0, session and session.complete or false
	end
	session.elapsed += math.max(0, tonumber(deltaTime) or 0)
	stepPendingCharacterImpulses(session)
	updateProjectileShots(session)
	local firedCount = 0
	while session.nextIndex &lt;= #session.markers do
		local marker = session.markers[session.nextIndex]
		if marker.time &gt; session.elapsed + 0.0001 then
			break
		end
		fireMarker(session, marker)
		session.nextIndex += 1
		firedCount += 1
	end
	session.complete = session.nextIndex &gt; #session.markers
		and projectileShotsComplete(session)
		and #session.pendingCharacterImpulses == 0
	return firedCount, session.complete
end

function PhysicsEventRuntime.ExportMarkers(markers)
	local exported = {}
	for _, marker in ipairs(markers or {}) do
		table.insert(exported, copyMarker(marker))
	end
	return exported
end

function PhysicsEventRuntime.Cancel(session)
	if session then
		session.pendingCharacterImpulses = {}
		restoreBlastRigReactions(session)
		restoreRigidPushGroups(session)
		restoreSources(session)
		session.complete = true
	end
end

return PhysicsEventRuntime
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX24">
            <Properties>
              <string name="Name">PhysicsEventSourceScope</string>
              <ProtectedString name="Source">local HttpService = game:GetService("HttpService")
local ObjectCaptureSnapshot = require(script.Parent:WaitForChild("ObjectCaptureSnapshot"))

local PhysicsEventSourceScope = {}

local SOURCE_ATTRIBUTE = "MegMoPhysicsEventSourceId"

local function findSourceTarget(source)
	if not (source and source.Parent) then
		return nil
	end
	if source:IsA("BasePart") or source:IsA("Model") then
		return source
	end
	local current = source.Parent
	while current and current ~= workspace do
		if current:IsA("BasePart") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function findRoot(target)
	if target:IsA("BasePart") then
		return target
	end
	if target.PrimaryPart then
		return target.PrimaryPart
	end
	for _, name in ipairs({ "HumanoidRootPart", "Chassis", "Main" }) do
		local candidate = target:FindFirstChild(name, true)
		if candidate and candidate:IsA("BasePart") then
			return candidate
		end
	end
	return target:FindFirstChildWhichIsA("BasePart", true)
end

local function collectParts(target)
	if target:IsA("BasePart") then
		return { target }
	end
	local parts = {}
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

function PhysicsEventSourceScope.Upsert(descriptors, source)
	local target = findSourceTarget(source)
	if not target then
		return nil, "Select a Part, Model, or an Attachment inside a Part."
	end
	for _, descriptor in ipairs(descriptors or {}) do
		if descriptor.instance == target then
			descriptor.source = source
			descriptor.name = target.Name
			descriptor.path = target:GetFullName()
			if not descriptor.editSnapshots then
				descriptor.editSnapshots = ObjectCaptureSnapshot.Capture({ descriptor })
			end
			return descriptor
		end
	end
	local descriptor = {
		id = HttpService:GenerateGUID(false),
		instance = target,
		source = source,
		name = target.Name,
		path = target:GetFullName(),
	}
	descriptor.editSnapshots = ObjectCaptureSnapshot.Capture({ descriptor })
	table.insert(descriptors, descriptor)
	return descriptor
end

function PhysicsEventSourceScope.RestoreOriginals(descriptors)
	local restored = 0
	for _, descriptor in ipairs(descriptors or {}) do
		restored += ObjectCaptureSnapshot.Restore(descriptor.editSnapshots)
	end
	return restored
end

function PhysicsEventSourceScope.PrepareRuntimeIds(descriptors)
	for _, descriptor in ipairs(descriptors or {}) do
		local target = descriptor.instance
		if target and target.Parent and descriptor.id then
			target:SetAttribute(SOURCE_ATTRIBUTE, descriptor.id)
		end
	end
end

function PhysicsEventSourceScope.ClearRuntimeIds(descriptors, retainIds)
	for _, descriptor in ipairs(descriptors or {}) do
		local target = descriptor.instance
		if target and target.Parent and descriptor.id and target:GetAttribute(SOURCE_ATTRIBUTE) == descriptor.id then
			target:SetAttribute(SOURCE_ATTRIBUTE, nil)
		end
		if not retainIds then
			descriptor.id = nil
		end
	end
end

function PhysicsEventSourceScope.FindRuntimeSources(descriptors)
	local wanted = {}
	for _, descriptor in ipairs(descriptors or {}) do
		if descriptor.id then
			wanted[descriptor.id] = descriptor
		end
	end
	local found = {}
	if next(wanted) == nil then
		return found
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") or descendant:IsA("Model") then
			local id = descendant:GetAttribute(SOURCE_ATTRIBUTE)
			local editDescriptor = id and wanted[id] or nil
			if editDescriptor then
				local root = findRoot(descendant)
				if root and root:IsA("BasePart") then
					local captureDescriptor = {
						id = id,
						name = editDescriptor.name or descendant.Name,
						part = root,
					}
					if descendant:IsA("Model") then
						captureDescriptor.target = descendant
						captureDescriptor.rootName = root.Name
						captureDescriptor.rootToTargetPivot = root.CFrame:ToObjectSpace(descendant:GetPivot())
					end
					table.insert(found, {
						id = id,
						target = descendant,
						root = root,
						parts = collectParts(descendant),
						captureDescriptor = captureDescriptor,
					})
				end
			end
		end
	end
	return found
end

return PhysicsEventSourceScope
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX25">
            <Properties>
              <string name="Name">PhysicsExplosionVFXSupport</string>
              <ProtectedString name="Source">local PhysicsExplosionVFXSupport = {}

local Debris = game:GetService("Debris")
local PhysicsPlaybackSpeedSupport = require(
	script.Parent.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("PhysicsPlaybackSpeedSupport")
)

local PREVIEW_ATTRIBUTE = "MegMoPhysicsExplosionVFXPreview"
local DEFAULT_EMIT_COUNT = 16

local previewAnchors = {}

local function collectEmitters(source)
	local emitters = {}
	if not (source and source.Parent) then
		return emitters
	end
	if source:IsA("ParticleEmitter") then
		table.insert(emitters, source)
	end
	for _, descendant in ipairs(source:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			table.insert(emitters, descendant)
		end
	end
	return emitters
end

local function sourceIsAvailable(source)
	return typeof(source) == "Instance"
		and source.Parent ~= nil
		and #collectEmitters(source) &gt; 0
end

-- Studio replaces edit-time instances when a Physics Run session stops. Keep a
-- non-mutating scene path so an authored VFX source can be found again without
-- requiring the animator to reselect it after every test or capture.
function PhysicsExplosionVFXSupport.DescribeSource(source)
	if not sourceIsAvailable(source) then
		return nil
	end
	local reversed = {}
	local current = source
	while current and current ~= game do
		local parent = current.Parent
		if not parent then
			return nil
		end
		local ordinal = 0
		for _, sibling in ipairs(parent:GetChildren()) do
			if sibling.Name == current.Name and sibling.ClassName == current.ClassName then
				ordinal += 1
				if sibling == current then
					break
				end
			end
		end
		table.insert(reversed, {
			name = current.Name,
			className = current.ClassName,
			ordinal = math.max(1, ordinal),
		})
		current = parent
	end
	local path = {}
	for index = #reversed, 1, -1 do
		table.insert(path, reversed[index])
	end
	return path
end

function PhysicsExplosionVFXSupport.ResolveSource(source, path)
	if sourceIsAvailable(source) then
		return source
	end
	if type(path) ~= "table" or #path == 0 then
		return nil
	end
	local current = game
	for _, segment in ipairs(path) do
		if type(segment) ~= "table" then
			return nil
		end
		local wantedOrdinal = math.max(1, math.floor(tonumber(segment.ordinal) or 1))
		local ordinal = 0
		local match = nil
		for _, child in ipairs(current:GetChildren()) do
			if child.Name == segment.name and child.ClassName == segment.className then
				ordinal += 1
				if ordinal == wantedOrdinal then
					match = child
					break
				end
			end
		end
		if not match then
			return nil
		end
		current = match
	end
	return sourceIsAvailable(current) and current or nil
end

local function getEmitterWorldCFrame(emitter)
	local parent = emitter and emitter.Parent
	if parent and parent:IsA("Attachment") then
		return parent.WorldCFrame
	end
	if parent and parent:IsA("BasePart") then
		return parent.CFrame
	end
	return CFrame.new()
end

local function getSourceReferenceCFrame(source, emitters)
	if not source then
		return nil
	end
	if source:IsA("ParticleEmitter") then
		source = source.Parent
	end
	local orientation = CFrame.new()
	if source and source:IsA("Attachment") then
		orientation = source.WorldCFrame
	elseif source and source:IsA("BasePart") then
		orientation = source.CFrame
	elseif source and source:IsA("Model") then
		orientation = source:GetPivot()
	end
	local center = Vector3.zero
	for _, emitter in ipairs(emitters or {}) do
		center += getEmitterWorldCFrame(emitter).Position
	end
	if #(emitters or {}) &gt; 0 then
		center /= #emitters
	else
		center = orientation.Position
	end
	return CFrame.new(center) * (orientation - orientation.Position)
end

local function getEmitterPlacementCFrame(sourceReference, emitter)
	local emitterWorld = getEmitterWorldCFrame(emitter)
	return sourceReference and sourceReference:ToObjectSpace(emitterWorld) or emitterWorld - emitterWorld.Position
end

local function getEmitCount(source, emitters)
	local requested = source and (source:GetAttribute("MegMoEmitCount") or source:GetAttribute("EmitCount"))
	if type(requested) == "number" then
		return math.clamp(math.floor(requested + 0.5), 1, 500)
	end
	local highestRate = 0
	for _, emitter in ipairs(emitters or {}) do
		highestRate = math.max(highestRate, tonumber(emitter.Rate) or 0)
	end
	return math.clamp(math.floor(math.max(DEFAULT_EMIT_COUNT, highestRate * 0.35) + 0.5), 1, 100)
end

local function getPreviewLifetime(emitters, playbackSpeed)
	local lifetime = 1
	for _, emitter in ipairs(emitters or {}) do
		local timeScale = PhysicsPlaybackSpeedSupport.ParticleTimeScale(emitter.TimeScale, playbackSpeed)
		lifetime = math.max(lifetime, (tonumber(emitter.Lifetime.Max) or 0) / math.max(timeScale, 0.01))
	end
	return math.min(lifetime + 0.75, 60)
end

function PhysicsExplosionVFXSupport.FindSelectedSource(selection)
	for _, selected in ipairs(selection or {}) do
		local emitters = collectEmitters(selected)
		if #emitters &gt; 0 then
			return selected, #emitters, getEmitCount(selected, emitters)
		end
	end
	return nil, 0, nil, "Select a ParticleEmitter, Attachment, Part, Folder, or Model containing ParticleEmitters, then press Explosion VFX again."
end

function PhysicsExplosionVFXSupport.GetEmitterCount(source)
	return #collectEmitters(source)
end

function PhysicsExplosionVFXSupport.GetEmitCount(source)
	local emitters = collectEmitters(source)
	return #emitters &gt; 0 and getEmitCount(source, emitters) or nil
end

function PhysicsExplosionVFXSupport.Preview(source, position, emitCount, playbackSpeed)
	local emitters = collectEmitters(source)
	if #emitters == 0 or typeof(position) ~= "Vector3" then
		return false, "The optional Explosion VFX source is no longer available."
	end
	local sourceReference = getSourceReferenceCFrame(source, emitters)

	local anchor = Instance.new("Part")
	anchor.Name = "7kg2 Explosion VFX Preview"
	anchor.Anchored = true
	anchor.Archivable = false
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Size = Vector3.new(0.1, 0.1, 0.1)
	anchor.Transparency = 1
	-- Move the authored VFX arrangement as one unit so its reference point
	-- follows the Blast Origin without moving the user's source asset.
	anchor.CFrame = CFrame.new(position)
		* (sourceReference and (sourceReference - sourceReference.Position) or CFrame.new())
	anchor:SetAttribute(PREVIEW_ATTRIBUTE, true)
	anchor.Parent = workspace
	previewAnchors[anchor] = true

	local count = math.clamp(math.floor(tonumber(emitCount) or getEmitCount(source, emitters) or DEFAULT_EMIT_COUNT), 1, 500)
	for index, emitter in ipairs(emitters) do
		local attachment = Instance.new("Attachment")
		attachment.Name = string.format("Emitter%d", index)
		attachment.CFrame = getEmitterPlacementCFrame(sourceReference, emitter)
		attachment.Parent = anchor
		local clone = emitter:Clone()
		clone.Enabled = false
		clone.TimeScale = PhysicsPlaybackSpeedSupport.ParticleTimeScale(emitter.TimeScale, playbackSpeed)
		clone.Parent = attachment
		clone:Emit(count)
	end

	local previewLifetime = getPreviewLifetime(emitters, playbackSpeed)
	Debris:AddItem(anchor, previewLifetime)
	task.delay(previewLifetime, function()
		previewAnchors[anchor] = nil
	end)
	return true, string.format("Previewed %d Explosion VFX emitter%s.", #emitters, #emitters == 1 and "" or "s")
end

function PhysicsExplosionVFXSupport.ClearPreviews()
	for anchor in pairs(previewAnchors) do
		if anchor and anchor.Parent then
			anchor:Destroy()
		end
		previewAnchors[anchor] = nil
	end
	for _, child in ipairs(workspace:GetChildren()) do
		if child:GetAttribute(PREVIEW_ATTRIBUTE) == true then
			child:Destroy()
		end
	end
end

function PhysicsExplosionVFXSupport.BuildBakeEntries(markers)
	local entries = {}
	for _, marker in ipairs(markers or {}) do
		local source = marker and PhysicsExplosionVFXSupport.ResolveSource(
			marker.vfxSource,
			marker.vfxSourceDescriptor
		)
		if marker.kind == "Explosion"
			and source
			and source.Parent
			and typeof(marker.position) == "Vector3"
			and #collectEmitters(source) &gt; 0 then
			table.insert(entries, {
				source = source,
				sourceName = tostring(marker.vfxSourceName or source.Name),
				position = marker.position,
				time = math.max(0, tonumber(marker.time) or 0),
				playbackSpeed = PhysicsPlaybackSpeedSupport.FromMarker(marker),
				emitCount = math.clamp(
					math.floor(tonumber(marker.vfxEmitCount) or PhysicsExplosionVFXSupport.GetEmitCount(source) or DEFAULT_EMIT_COUNT),
					1,
					500
				),
			})
		end
	end
	return entries
end

return PhysicsExplosionVFXSupport
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX26">
            <Properties>
              <string name="Name">PhysicsGuidedMode</string>
              <ProtectedString name="Source">local PhysicsGuidedMode = {}
PhysicsGuidedMode.__index = PhysicsGuidedMode

local TweenService = game:GetService("TweenService")

local SETTING_PREFIX = "MegMoPhysicsGuideCompletedV1_"

local function step(target, title, body, stage, focus)
	return { target = target, title = title, body = body, stage = stage, focus = focus or target }
end

