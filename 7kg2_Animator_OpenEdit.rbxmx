		local function positionMicroRigMenu()
			if not addRig or not addRig.Parent then
				return
			end
			microRigMenu.Position = UDim2.fromOffset(
				addRig.AbsolutePosition.X,
				addRig.AbsolutePosition.Y + addRig.AbsoluteSize.Y + 4
