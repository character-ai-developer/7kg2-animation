        <Item class="ModuleScript" referent="RBX81">
          <Properties>
            <string name="Name">MicroMessagePopupSupport</string>
            <ProtectedString name="Source">local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))

local MicroMessagePopupSupport = {}

local POPUP_NAME = "MegMoMicroMessagePopup"

local function addCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

function MicroMessagePopupSupport.show(gui, title, message)
	if not (gui and gui.Parent and gui:IsA("ScreenGui")) then
		return false
	end

	local existing = gui:FindFirstChild(POPUP_NAME)
	if existing then
		existing:Destroy()
	end

	local colors = ThemeService.getCurrentTheme().colors
	local overlay = Instance.new("TextButton")
	overlay.Name = POPUP_NAME
	overlay.Active = true
	overlay.AutoButtonColor = false
	overlay.BackgroundColor3 = Color3.fromRGB(3, 5, 9)
	overlay.BackgroundTransparency = 0.22
	overlay.BorderSizePixel = 0
	overlay.Modal = true
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.Text = ""
	overlay.ZIndex = 300
	overlay.Parent = gui

	local card = Instance.new("Frame")
	card.Name = "MessageCard"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.BackgroundColor3 = colors.Panel
	card.BorderSizePixel = 0
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(390, 190)
	card.ZIndex = 301
	card.Parent = overlay
	addCorner(card, 10)

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = colors.Accent
	cardStroke.Thickness = 1
	cardStroke.Transparency = 0.15
	cardStroke.Parent = card

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamSemibold
	titleLabel.Position = UDim2.fromOffset(18, 16)
	titleLabel.Size = UDim2.new(1, -36, 0, 24)
	titleLabel.Text = tostring(title or "Notice")
	titleLabel.TextColor3 = colors.Text
	titleLabel.TextSize = 16
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.ZIndex = 302
	titleLabel.Parent = card

	local messageLabel = Instance.new("TextLabel")
	messageLabel.Name = "Message"
	messageLabel.BackgroundTransparency = 1
	messageLabel.Font = Enum.Font.Gotham
	messageLabel.Position = UDim2.fromOffset(18, 50)
	messageLabel.Size = UDim2.new(1, -36, 0, 72)
	messageLabel.Text = tostring(message or "")
	messageLabel.TextColor3 = colors.MutedText
	messageLabel.TextSize = 13
	messageLabel.TextWrapped = true
	messageLabel.TextXAlignment = Enum.TextXAlignment.Left
	messageLabel.TextYAlignment = Enum.TextYAlignment.Top
	messageLabel.ZIndex = 302
	messageLabel.Parent = card

	local okButton = Instance.new("TextButton")
	okButton.Name = "OK"
	okButton.AutoButtonColor = true
	okButton.BackgroundColor3 = colors.Accent
	okButton.BorderSizePixel = 0
	okButton.Font = Enum.Font.GothamSemibold
	okButton.Position = UDim2.new(0, 18, 1, -50)
	okButton.Size = UDim2.new(1, -36, 0, 34)
	okButton.Text = "OK"
	okButton.TextColor3 = ThemeService.getReadableTextColor(colors.Accent)
	okButton.TextSize = 13
	okButton.ZIndex = 302
	okButton.Parent = card
	addCorner(okButton, 7)

	okButton.Activated:Connect(function()
		if overlay.Parent then
			overlay:Destroy()
		end
	end)

	return true
end

return MicroMessagePopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX82">
          <Properties>
            <string name="Name">MicroMotionPopupSupport</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))
local MotionBuilderUI = require(script.Parent:WaitForChild("MotionBuilderUI"))
local WidgetController = require(script.Parent.Parent:WaitForChild("WidgetController"))

local MicroMotionPopupSupport = {}

local create = UiHelpers.create
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke

local function disconnectAll(connections)
	for _, connection in ipairs(connections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	table.clear(connections)
end

local function connect(connections, signal, handler)
	if not signal or type(handler) ~= "function" then
		return nil
	end
	local connection = signal:Connect(handler)
	table.insert(connections, connection)
	return connection
end

local function setStatus(options, message)
	if type(options.setStatus) == "function" then
		options.setStatus(message)
	end
end

local function clampMotionContentScale(value)
	return 1
end

function MicroMotionPopupSupport.mount(parent, options)
	if not parent then
		error("MicroMotionPopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local scaledRoot = create("Frame", {
		Name = "MicroMotionScaledRoot",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Parent = parent,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromScale(1, 1),
	})
	local contentScale = create("UIScale", {
		Name = "MicroMotionContentScale",
		Scale = clampMotionContentScale(type(options.getContentScale) == "function" and options.getContentScale() or options.contentScale),
		Parent = scaledRoot,
	})
	local motionPanel = nil
	local function updateContentScale()
		local scale = clampMotionContentScale(type(options.getContentScale) == "function" and options.getContentScale() or options.contentScale)
		contentScale.Scale = scale
		scaledRoot:SetAttribute("MegMoLayoutScale", scale)
		if motionPanel then
			motionPanel:SetAttribute("MegMoLayoutScale", scale)
		end
		local size = parent.AbsoluteSize
		if size.X &gt; 0 and size.Y &gt; 0 then
			scaledRoot.Size = UDim2.fromOffset(math.ceil(size.X / scale), math.ceil(size.Y / scale))
		else
			scaledRoot.Size = UDim2.fromScale(1 / scale, 1 / scale)
		end
	end
	connect(connections, parent:GetPropertyChangedSignal("AbsoluteSize"), updateContentScale)
	updateContentScale()
	local refs = MotionBuilderUI.mount(scaledRoot, {
		useOwnPanel = false,
		enableCollapsibleSections = true,
		topInset = 8,
		bottomInset = 8,
	})
	motionPanel = refs and refs._motionBuilderPanel or nil
	updateContentScale()
	local controller = {
		_callbacks = {
			onSelectMotionMarker = options.onSelectMotionMarker,
			onSetMotionSegmentMotion = options.onSetMotionSegmentMotion,
			onSetMotionSegmentClip = options.onSetMotionSegmentClip,
			onSetMotionDefaultClip = options.onSetMotionDefaultClip,
			onSetMotionSegmentPauseIdle = options.onSetMotionSegmentPauseIdle,
			onSetMotionSegmentDuration = options.onSetMotionSegmentDuration,
			onSetMotionSegmentPause = options.onSetMotionSegmentPause,
			onSetMotionSegmentBlend = options.onSetMotionSegmentBlend,
			onPreviewMotionSegment = options.onPreviewMotionSegment,
			onStopMotionPreview = options.onStopMotionPreview,
			onLoadPresetAnimations = options.onLoadPresetAnimations,
			onLoadMyAnimations = options.onLoadMyAnimations,
		},
		_openMotionDefaultMotion = nil,
		_openMotionSegmentKey = nil,
		_openMotionSegmentMenuType = nil,
		_workspaceMode = "Animate",
	}

	for key, value in pairs(refs or {}) do
		controller[key] = value
	end

	function controller:_connect(signal, handler)
		return connect(connections, signal, handler)
	end

	function controller:_closeTopMenus()
	end

	function controller:_releaseShortcutCapture()
	end

	function controller:_setShortcutHint(message)
		setStatus(options, message)
	end

	controller._focusShortcutCapture = controller._setShortcutHint
	controller._setMotionSegmentsScrollerEnabled = WidgetController._setMotionSegmentsScrollerEnabled
	controller._attachNestedMotionStripScroll = WidgetController._attachNestedMotionStripScroll
	controller._closeDropdowns = WidgetController._closeDropdowns
	controller._renderMotionMarkers = WidgetController._renderMotionMarkers
	controller._renderMotionDefaults = WidgetController._renderMotionDefaults
	controller._renderMotionSegments = WidgetController._renderMotionSegments

	function controller:_setWorkspaceMode(mode)
		self._workspaceMode = mode or "Animate"
		if mode == "Presets" then
			if type(options.onBeginMotionPresetPick) == "function" then
				options.onBeginMotionPresetPick(self._motionSegmentPickerKey, self._motionSegmentPickerLabel, self._motionDefaultPickerMotion)
			else
				self:_setShortcutHint("Custom Motion Builder clip picking is not available in Micro yet.")
			end
		end
	end

	local refresh
	local invokeAction
	local previewWatcherActive = true
	local lastPreviewSignature = nil

	local function requestAsyncRefresh()
		task.defer(function()
			if refresh and controller._motionBuilderPanel and controller._motionBuilderPanel.Parent then
				refresh()
			end
		end)
	end

	local function getPreviewSignature()
		local viewModelGetter = options.getMotionBuilderViewModel
		local viewModel = type(viewModelGetter) == "function" and (viewModelGetter() or {}) or {}
		local preview = viewModel.motionPreview or {}
		return table.concat({
			tostring(preview.isPreviewing == true),
			tostring(preview.segmentKey or ""),
			tostring(preview.label or ""),
		}, "|")
	end

	local function wrapMotionEditCallback(callback)
		if type(callback) ~= "function" then
			return nil
		end
		return function(...)
			local ok, message = callback(...)
			if type(message) == "string" and message ~= "" then
				setStatus(options, message)
			elseif type(ok) == "string" and ok ~= "" then
				setStatus(options, ok)
			end
			requestAsyncRefresh()
			return ok, message
		end
	end

	controller._callbacks.onSetMotionSegmentMotion = wrapMotionEditCallback(options.onSetMotionSegmentMotion)
	controller._callbacks.onSetMotionSegmentClip = wrapMotionEditCallback(options.onSetMotionSegmentClip)
	controller._callbacks.onSetMotionDefaultClip = wrapMotionEditCallback(options.onSetMotionDefaultClip)
	controller._callbacks.onSetMotionSegmentPauseIdle = wrapMotionEditCallback(options.onSetMotionSegmentPauseIdle)
	controller._callbacks.onSetMotionSegmentDuration = wrapMotionEditCallback(options.onSetMotionSegmentDuration)
	controller._callbacks.onSetMotionSegmentPause = wrapMotionEditCallback(options.onSetMotionSegmentPause)
	controller._callbacks.onSetMotionSegmentBlend = wrapMotionEditCallback(options.onSetMotionSegmentBlend)
	controller._callbacks.onPreviewMotionSegment = wrapMotionEditCallback(options.onPreviewMotionSegment)
	controller._callbacks.onStopMotionPreview = wrapMotionEditCallback(options.onStopMotionPreview)
	controller._callbacks.onLoadPresetAnimations = wrapMotionEditCallback(options.onLoadPresetAnimations)
	controller._callbacks.onLoadMyAnimations = wrapMotionEditCallback(options.onLoadMyAnimations)

	invokeAction = function(callback, successMessage, ...)
		if type(callback) ~= "function" then
			if successMessage then
				setStatus(options, successMessage .. " is not available right now.")
			end
			return nil
		end
		local ok, message = callback(...)
		if type(message) == "string" and message ~= "" then
			setStatus(options, message)
		elseif type(ok) == "string" and ok ~= "" then
			setStatus(options, ok)
		elseif successMessage then
			setStatus(options, successMessage)
		end
		requestAsyncRefresh()
		return ok, message
	end

	refresh = function()
		local viewModelGetter = options.getMotionBuilderViewModel
		local viewModel = type(viewModelGetter) == "function" and (viewModelGetter() or {}) or {}
		local preview = viewModel.motionPreview or {}
		lastPreviewSignature = table.concat({
			tostring(preview.isPreviewing == true),
			tostring(preview.segmentKey or ""),
			tostring(preview.label or ""),
		}, "|")
		controller._lastViewModel = viewModel
		if controller._motionBuilderPanel then
			controller._motionBuilderPanel.Visible = true
		end
		if controller._motionRigValueLabel then
			controller._motionRigValueLabel.Text = viewModel.rigName or "No rig bound"
		end
		if controller._motionSelectRigButton then
			controller._motionSelectRigButton.Text = "Use Selected Rig"
		end
		local motionPreview = viewModel.motionPreview or {}
		local isMotionPreviewing = motionPreview.isPreviewing == true
		if controller._motionPreviewPathButton then
			controller._motionPreviewPathButton.Text = isMotionPreviewing and "Stop Preview" or "Preview"
			controller._motionPreviewPathButton.BackgroundColor3 = isMotionPreviewing and Constants.THEME.Danger or Constants.THEME.PanelSoft
			controller._motionPreviewPathButton.TextColor3 = Constants.THEME.Text
		end
		if controller._motionCreateAnimationButton then
			controller._motionCreateAnimationButton.Text = isMotionPreviewing and "Preview Running" or "Build Timeline"
			controller._motionCreateAnimationButton.BackgroundColor3 = isMotionPreviewing and Constants.THEME.PanelSoft or Constants.THEME.Accent
			controller._motionCreateAnimationButton.TextColor3 = isMotionPreviewing and Constants.THEME.MutedText or Constants.THEME.Text
		end
		controller:_renderMotionMarkers(viewModel.motionMarkers or {})
		controller:_renderMotionDefaults(viewModel)
		controller:_renderMotionSegments(viewModel.motionSegments or {})
	end

	task.spawn(function()
		while previewWatcherActive do
			task.wait(0.25)
			if not controller._motionBuilderPanel or not controller._motionBuilderPanel.Parent then
				break
			end
			local signature = getPreviewSignature()
			if lastPreviewSignature ~= nil and signature ~= lastPreviewSignature then
				refresh()
			elseif lastPreviewSignature == nil then
				lastPreviewSignature = signature
			end
		end
	end)

	connect(connections, controller._motionSelectRigButton and controller._motionSelectRigButton.Activated, function()
		if type(options.onBindMotionRig) == "function" then
			invokeAction(options.onBindMotionRig, "Selected rig bound for Motion Builder.")
		elseif type(options.onBindRig) == "function" then
			invokeAction(options.onBindRig, "Selected rig bound for Motion Builder.")
		elseif type(options.onSelectRigInStudio) == "function" then
			invokeAction(options.onSelectRigInStudio, "Selected rig opened in Studio.")
		else
			setStatus(options, "Rig binding is not available right now.")
		end
	end)

	connect(connections, controller._motionAddMarkerButton and controller._motionAddMarkerButton.Activated, function()
		invokeAction(options.onAddMotionMarker, "Motion marker added.")
	end)

	connect(connections, controller._motionDeleteMarkerButton and controller._motionDeleteMarkerButton.Activated, function()
		invokeAction(options.onDeleteMotionMarker, "Selected motion marker deleted.")
	end)

	connect(connections, controller._motionClearMarkersButton and controller._motionClearMarkersButton.Activated, function()
		invokeAction(options.onClearMotionMarkers, "Motion markers reset.")
	end)

	connect(connections, controller._motionResetSegmentsButton and controller._motionResetSegmentsButton.Activated, function()
		invokeAction(options.onResetMotionSegments, "Motion segments reset.")
	end)

	connect(connections, controller._motionAddCameraButton and controller._motionAddCameraButton.Activated, function()
		if type(options.onAddTrack) ~= "function" then
			setStatus(options, "Camera track creation is not available right now.")
			return
		end
		options.onAddTrack("Camera")
		setStatus(options, "Added or selected the Camera track.")
		requestAsyncRefresh()
	end)

	connect(connections, controller._motionCameraEffectsButton and controller._motionCameraEffectsButton.Activated, function()
		if type(options.onOpenCameraEffects) == "function" then
			options.onOpenCameraEffects()
			return
		end
		setStatus(options, "Open the Effects popup and choose Camera Effects for Orbit or Follow presets.")
	end)

	connect(connections, controller._motionSaveRecipeButton and controller._motionSaveRecipeButton.Activated, function()
		invokeAction(options.onSaveMotionRecipe, "Motion recipe saved.")
	end)

	connect(connections, controller._motionOpenRecipesButton and controller._motionOpenRecipesButton.Activated, function()
		local ok, message = invokeAction(options.onOpenMotionRecipeManager, "Motion recipes refreshed.")
		if ok ~= nil then
			return
		end
		local viewModel = controller._lastViewModel or {}
		local entries = viewModel.motionRecipeEntries or {}
		if #entries &gt; 0 then
			setStatus(options, "Recipes available: " .. tostring(#entries) .. ". Use Main for rename/delete, or Save Recipe here to update the current setup.")
		else
			setStatus(options, tostring(message or "No Motion Builder recipes saved yet."))
		end
	end)

	connect(connections, controller._motionPreviewPathButton and controller._motionPreviewPathButton.Activated, function()
		local isPreviewing = controller._lastViewModel
			and controller._lastViewModel.motionPreview
			and controller._lastViewModel.motionPreview.isPreviewing == true
		if isPreviewing then
			invokeAction(options.onStopMotionPreview, "Motion preview stopped.")
		else
			invokeAction(options.onPreviewMotionPath, "Motion preview started.")
		end
	end)

	connect(connections, controller._motionCreateAnimationButton and controller._motionCreateAnimationButton.Activated, function()
		local isPreviewing = controller._lastViewModel
			and controller._lastViewModel.motionPreview
			and controller._lastViewModel.motionPreview.isPreviewing == true
		if isPreviewing then
			setStatus(options, "Stop the Motion Builder preview before building the timeline.")
			return
		end
		invokeAction(options.onCreateMotionAnimation, "Motion Builder timeline created.")
	end)

	refresh()

	return {
		refresh = refresh,
		destroy = function()
			previewWatcherActive = false
			disconnectAll(connections)
			if scaledRoot and scaledRoot.Parent then
				scaledRoot:Destroy()
			end
		end,
	}
end

return MicroMotionPopupSupport
