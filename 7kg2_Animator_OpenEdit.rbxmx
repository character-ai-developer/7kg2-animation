	createHeaderLabel("Duration", UDim2.new(0.49, 0, 0, 5), UDim2.new(0.12, 0, 0, 18))
	createHeaderLabel("Pause", UDim2.new(0.61, 0, 0, 5), UDim2.new(0.085, 0, 0, 18))
