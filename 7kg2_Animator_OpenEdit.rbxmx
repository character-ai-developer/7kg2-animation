local DEFAULT_EASING_STYLES = {
	"None",
	"Linear",
	"Sine",
	"Quad",
	"Cubic",
	"Quart",
	"Quint",
	"Sextic",
	"Back",
	"Bounce",
	"Elastic",
	"Exponential",
	"Circular",
}

local DEFAULT_EASING_DIRECTIONS = {
	"InOut",
	"In",
	"Out",
}

local DEFAULT_ANIMATION_PRIORITIES = {
	"Core",
	"Idle",
	"Movement",
	"Action",
	"Action2",
	"Action3",
	"Action4",
}

local function normalizeOptionList(options, fallback)
	local source = type(options) == "table" and #options &gt; 0 and options or fallback
	local normalized = {}
	for _, optionName in ipairs(source or {}) do
		if optionName ~= nil then
			normalized[#normalized + 1] = tostring(optionName)
		end
	end
	debugDropdown(
		"normalize",
		"sourceType=" .. tostring(type(options)),
		"sourceCount=" .. tostring(type(options) == "table" and #options or "n/a"),
		"fallbackCount=" .. tostring(type(fallback) == "table" and #fallback or "n/a"),
		"resultCount=" .. tostring(#normalized)
	)
	return normalized
end

local DROPDOWNS = {
	["Ease Style"] = {
		options = normalizeOptionList(Constants.EASING_STYLES, DEFAULT_EASING_STYLES),
		actionPrefix = "Set Ease Style: ",
		currentKey = "easingStyle",
		defaultValue = Constants.DEFAULT_EASING_STYLE or "Linear",
		visibleRows = 7,
	},
	["Ease Dir"] = {
		options = normalizeOptionList(Constants.EASING_DIRECTIONS, DEFAULT_EASING_DIRECTIONS),
		actionPrefix = "Set Ease Dir: ",
		currentKey = "easingDirection",
		defaultValue = Constants.DEFAULT_EASING_DIRECTION or "InOut",
		visibleRows = 3,
	},
	Priority = {
		options = normalizeOptionList(Constants.ANIMATION_PRIORITIES, DEFAULT_ANIMATION_PRIORITIES),
		actionPrefix = "Set Priority: ",
		defaultValue = "Action",
		visibleRows = 5,
	},
}

local function theme()
	return Constants.THEME
end

local function create(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function corner(parent, radius)
	return create("UICorner", {
		CornerRadius = UDim.new(0, radius or 10),
	}, parent)
end

local function stroke(parent, color, transparency, thickness)
	local item = create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or theme().Border,
		Thickness = thickness or 1,
		Transparency = transparency or 0.35,
	}, parent)
	return item
end

local function normalizeImageAssetId(value)
	local text = tostring(value or "")
	if text == "" then
		return nil
	end
	if text:match("^rbxassetid://") or text:match("^rbxthumb://") then
		return text
	end
	local digits = text:match("(%d+)")
	return digits and ("rbxassetid://" .. digits) or nil
end

local function readImageAssetFromInstance(instance)
	if not instance then
		return nil
	end
	local ok, value = pcall(function()
		if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
			return instance.Image
		elseif instance:IsA("Decal") or instance:IsA("Texture") then
			return instance.Texture
		elseif instance:IsA("StringValue") then
			return instance.Value
		end
		return instance:GetAttribute("Image") or instance:GetAttribute("ImageId") or instance:GetAttribute("AssetId")
	end)
	return ok and normalizeImageAssetId(value) or nil
end

local function getIconImage(iconName)
	local imagesFolder = ServerStorage:FindFirstChild("Images")
	if imagesFolder then
		local direct = readImageAssetFromInstance(imagesFolder:FindFirstChild(tostring(iconName or "")))
		if direct then
			return direct
		end
	end
	return ICON_FALLBACKS[tostring(iconName or "")] or normalizeImageAssetId(iconName)
end

local function attachTooltip(button, toolHint, text)
	if not button or not toolHint then
		return
	end
	button.MouseEnter:Connect(function()
		toolHint.Text = tostring(text or "")
		toolHint.Position = UDim2.fromOffset(
			math.floor(button.AbsolutePosition.X),
			math.floor(button.AbsolutePosition.Y + button.AbsoluteSize.Y + 6)
		)
		toolHint.Visible = true
	end)
	button.MouseLeave:Connect(function()
		toolHint.Visible = false
	end)
end

local function getSelectedKeyOption(options, key, fallback)
	local state = type(options) == "table" and type(options.getEditorState) == "function" and options.getEditorState() or nil
	local selectedKeyOptions = type(state) == "table" and type(state.selectedKeyOptions) == "table" and state.selectedKeyOptions or nil
	return tostring((selectedKeyOptions and selectedKeyOptions[key]) or fallback or "")
end

local function getPriority(options)
	local timeline = type(options) == "table" and type(options.getTimeline) == "function" and options.getTimeline() or nil
	if timeline and type(timeline.getPriority) == "function" then
		return tostring(timeline:getPriority() or "Action")
	end
	return "Action"
end

local function getDropdownCurrentValue(actionName, options)
	local spec = DROPDOWNS[actionName]
	if not spec then
		return nil
	end
	if actionName == "Priority" then
		return getPriority(options)
	end
	return getSelectedKeyOption(options, spec.currentKey, spec.defaultValue)
end

local function getDropdownOptions(spec)
	local normalized = {}
	for _, optionName in ipairs(type(spec) == "table" and type(spec.options) == "table" and spec.options or {}) do
		if optionName ~= nil then
			normalized[#normalized + 1] = tostring(optionName)
		end
	end
	debugDropdown(
		"getOptions",
		"specType=" .. tostring(type(spec)),
		"rawCount=" .. tostring(type(spec) == "table" and type(spec.options) == "table" and #spec.options or "n/a"),
		"resultCount=" .. tostring(#normalized),
		"first=" .. tostring(normalized[1])
	)
	return normalized
end

local function getButtonSubtext(item, options)
	if item.dropdown then
		return getDropdownCurrentValue(item.action, options) or "Choose"
	end
	return item.shortcut or ""
end

local function clearDropdown(controller)
	if controller.dropdownLayer then
		controller.dropdownLayer:ClearAllChildren()
		controller.dropdownLayer.Visible = false
	end
end

local function runAction(controller, actionName)
	clearDropdown(controller)
	if actionName == "Wiggle" and type(controller._showWiggleFramesOverlay) == "function" then
		local ok, message = controller:_showWiggleFramesOverlay()
		if type(controller.setStatus) == "function" then
			controller.setStatus(tostring(message or "Wiggle open: choose offsets and interval, then press OK."))
		end
		return ok
	end

	local ok, message = false, nil
	if type(controller.onAction) == "function" then
		ok, message = controller.onAction(actionName)
	end
	if type(controller.setStatus) == "function" then
		controller.setStatus(tostring(message or (ok and (tostring(actionName) .. " applied.") or "Action could not run.")))
	end
	if type(controller.onAfterAction) == "function" then
		controller.onAfterAction()
	end
	if type(controller.refresh) == "function" then
		controller.refresh()
	end
end

local function showDropdown(controller, anchorButton, item)
	local spec = DROPDOWNS[item.action]
	if not spec or not controller.dropdownLayer or not controller.root then
		debugDropdown(
			"show blocked",
			"action=" .. tostring(item and item.action),
			"hasSpec=" .. tostring(spec ~= nil),
			"hasLayer=" .. tostring(controller and controller.dropdownLayer ~= nil),
			"hasRoot=" .. tostring(controller and controller.root ~= nil)
		)
		return
	end
	clearDropdown(controller)
	controller.dropdownLayer.Visible = true

	local options = getDropdownOptions(spec)
	debugDropdown(
		"show",
		"action=" .. tostring(item.action),
		"count=" .. tostring(#options),
		"current=" .. tostring(getDropdownCurrentValue(item.action, controller.options)),
		"rootSize=" .. tostring(controller.root.AbsoluteSize),
		"anchorSize=" .. tostring(anchorButton and anchorButton.AbsoluteSize),
		"layerVisible=" .. tostring(controller.dropdownLayer.Visible)
	)
	local optionHeight = 30
	local gap = 5
	local visibleRows = math.clamp(tonumber(spec.visibleRows) or 5, 1, 8)
	local optionCount = math.max(1, #options)
	local dropdownHeight = math.min((optionCount * (optionHeight + gap)) + 10, (visibleRows * (optionHeight + gap)) + 10)
	local dropdownWidth = math.max(190, anchorButton.AbsoluteSize.X)
	local rootPosition = controller.root.AbsolutePosition
	local rootSize = controller.root.AbsoluteSize
	local x = math.clamp(anchorButton.AbsolutePosition.X - rootPosition.X, 10, math.max(10, rootSize.X - dropdownWidth - 10))
	local y = anchorButton.AbsolutePosition.Y - rootPosition.Y + anchorButton.AbsoluteSize.Y + 6
	if y + dropdownHeight &gt; rootSize.Y - 10 then
		y = math.max(10, anchorButton.AbsolutePosition.Y - rootPosition.Y - dropdownHeight - 6)
	end

	local sink = create("TextButton", {
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 146,
	}, controller.dropdownLayer)
	sink.MouseButton1Click:Connect(function()
		clearDropdown(controller)
	end)

	local menu = create("ScrollingFrame", {
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		BackgroundColor3 = theme().Panel,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(dropdownWidth, (optionCount * (optionHeight + gap)) + 10),
		ClipsDescendants = true,
		Position = UDim2.fromOffset(x, y),
		ScrollBarImageColor3 = theme().Accent,
		ScrollBarThickness = #options &gt; visibleRows and 5 or 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.fromOffset(dropdownWidth, dropdownHeight),
		ZIndex = 150,
	}, controller.dropdownLayer)
	debugDropdown(
		"menu created",
		"action=" .. tostring(item.action),
		"position=" .. tostring(menu.Position),
		"size=" .. tostring(menu.Size),
		"canvas=" .. tostring(menu.CanvasSize),
		"childrenBefore=" .. tostring(#menu:GetChildren())
	)
	menu:SetAttribute("MegMoThemeBackgroundRole", "Panel")
	corner(menu, 10)
	stroke(menu, item.color or theme().Accent, 0.12, 1.5)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 5),
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
	}, menu)
	create("UIListLayout", {
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, menu)

	local currentValue = getDropdownCurrentValue(item.action, controller.options)
	if #options == 0 then
		local emptyButton = create("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			LayoutOrder = 1,
			Size = UDim2.new(0, dropdownWidth - 12, 0, optionHeight),
			Text = "No options available",
			TextColor3 = theme().MutedText,
			TextSize = 12,
			TextTransparency = 0,
			ZIndex = 153,
		}, menu)
		emptyButton:SetAttribute("MegMoThemeTextRole", "MutedText")
		corner(emptyButton, 8)
		stroke(emptyButton, item.color or theme().Accent, 0.72, 1)
		return
	end
	for index, optionName in ipairs(options) do
		local selected = tostring(optionName) == tostring(currentValue)
		local optionButton = create("TextButton", {
			AutoButtonColor = true,
			BackgroundColor3 = selected and (item.color or theme().Accent) or theme().PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			LayoutOrder = index,
			Size = UDim2.new(0, dropdownWidth - 12, 0, optionHeight),
			Text = tostring(optionName),
			TextColor3 = selected and ThemeService.getReadableTextColor(item.color or theme().Accent) or theme().Text,
			TextSize = 12,
			TextTransparency = 0,
			ZIndex = 153,
		}, menu)
		optionButton:SetAttribute("MegMoThemeTextRole", selected and nil or "Text")
		corner(optionButton, 8)
		stroke(optionButton, selected and Color3.new(1, 1, 1) or (item.color or theme().Accent), selected and 0.25 or 0.68, 1)
		optionButton.MouseButton1Click:Connect(function()
			debugDropdown("option clicked", "action=" .. tostring(item.action), "option=" .. tostring(optionName))
			runAction(controller, tostring(spec.actionPrefix or "") .. tostring(optionName))
		end)
	end
	debugDropdown(
		"menu populated",
		"action=" .. tostring(item.action),
		"options=" .. tostring(#options),
		"childrenAfter=" .. tostring(#menu:GetChildren())
	)
end

local function createToolButton(controller, parent, item, sectionColor, layoutOrder)
	item.color = item.color or sectionColor
	local button = create("TextButton", {
		AutoButtonColor = true,
		BackgroundColor3 = item.primary and sectionColor or theme().PanelSoft,
		BorderSizePixel = 0,
		LayoutOrder = layoutOrder,
		Text = "",
		ZIndex = 82,
	}, parent)
	button:SetAttribute("MegMoThemeBackgroundRole", item.primary and nil or "PanelSoft")
	corner(button, 11)
	stroke(button, sectionColor, item.primary and 0.08 or 0.38, item.primary and 1.8 or 1)
	UiMotion.attachButtonEffect(button, {
		hoverScale = 1.018,
		clickScale = 0.965,
	})

	local image = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Image = getIconImage(item.icon),
		ImageColor3 = item.primary and ThemeService.getReadableTextColor(sectionColor) or sectionColor,
		Position = UDim2.new(0.5, 0, 0, 10),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(item.compact and 24 or 32, item.compact and 24 or 32),
		ZIndex = 83,
	}, button)
	image:SetAttribute("MegMoThemeImageRole", nil)

	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(8, item.compact and 30 or 46),
		Size = UDim2.new(1, -16, 0, 20),
		Text = item.label or item.action,
		TextColor3 = item.primary and ThemeService.getReadableTextColor(sectionColor) or theme().Text,
		TextSize = item.compact and 11 or 15,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 83,
	}, button)
	label:SetAttribute("MegMoThemeTextRole", item.primary and nil or "Text")

	local subtextValue = getButtonSubtext(item, controller.options)
	local subtext = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 8, 1, -22),
		Size = UDim2.new(1, -16, 0, 16),
		Text = subtextValue,
		TextColor3 = item.primary and ThemeService.getReadableTextColor(sectionColor) or theme().MutedText,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = subtextValue ~= "",
		ZIndex = 83,
	}, button)
	subtext:SetAttribute("MegMoThemeTextRole", item.primary and nil or "MutedText")

	if item.dropdown then
		local chevron = create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(18, 18),
			Text = "v",
			TextColor3 = theme().MutedText,
			TextSize = 16,
			ZIndex = 84,
		}, button)
		chevron:SetAttribute("MegMoThemeTextRole", "MutedText")
	end

	controller.buttons[item.action] = {
		button = button,
		subtext = subtext,
		item = item,
	}
	attachTooltip(button, controller.toolHint, ACTION_TOOLTIPS[item.action] or item.label or item.action)
	button.MouseButton1Click:Connect(function()
		if item.dropdown then
			debugDropdown("button clicked", "action=" .. tostring(item.action), "label=" .. tostring(item.label))
			showDropdown(controller, button, item)
		else
			runAction(controller, item.action)
		end
	end)
	return button
end

local function createSection(controller, parent, section, order)
	local sectionFrame = create("Frame", {
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		ZIndex = 81,
	}, parent)
	create("UIListLayout", {
		Padding = UDim.new(0, 9),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, sectionFrame)

	local title = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 24),
		Text = section.title,
		TextColor3 = section.color,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 82,
	}, sectionFrame)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
	}, title)

	local columns = math.max(1, section.columns or 2)
	local rows = math.ceil(#section.items / columns)
	local grid = create("Frame", {
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, (rows * section.cellHeight) + math.max(0, rows - 1) * 10),
		ZIndex = 81,
	}, sectionFrame)
	create("UIGridLayout", {
		CellPadding = UDim2.fromOffset(10, 10),
		CellSize = UDim2.new(1 / columns, -8, 0, section.cellHeight),
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, grid)

	for index, item in ipairs(section.items) do
		item.compact = section.cellHeight &lt;= 64
		createToolButton(controller, grid, item, section.color, index)
	end

	create("Frame", {
		BackgroundColor3 = theme().Border,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 81,
	}, sectionFrame):SetAttribute("MegMoThemeBackgroundRole", "Border")
end

function MicroAnimationToolsPopupSupport.mount(host, context)
	assert(host, "MicroAnimationToolsPopupSupport.mount requires host")
	context = context or {}
	host:ClearAllChildren()

	local controller = {
		buttons = {},
		options = context.options,
		onAction = context.onAction,
		onAfterAction = context.onAfterAction,
		setStatus = context.setStatus,
		toolHint = context.toolHint,
	}

	local root = create("Frame", {
		BackgroundColor3 = theme().Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 80,
	}, host)
	root:SetAttribute("MegMoThemeBackgroundRole", "Panel")
	controller.root = root

	local content = create("ScrollingFrame", {
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.fromOffset(18, 16),
		ScrollBarImageColor3 = theme().Accent,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, -36, 1, -96),
		ZIndex = 81,
	}, root)
	create("UIListLayout", {
		Padding = UDim.new(0, 18),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, content)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 8),
	}, content)

	for index, section in ipairs(SECTIONS) do
		createSection(controller, content, section, index)
	end

	local tip = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = theme().PanelAlt,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 1, -16),
		Size = UDim2.new(1, -36, 0, 62),
		ZIndex = 82,
	}, root)
	tip:SetAttribute("MegMoThemeBackgroundRole", "PanelAlt")
	corner(tip, 10)
	stroke(tip, theme().Border, 0.62, 1)
	create("ImageLabel", {
		BackgroundTransparency = 1,
		Image = getIconImage("Tip"),
		ImageColor3 = Color3.fromRGB(255, 174, 38),
		Position = UDim2.fromOffset(12, 21),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(20, 20),
		ZIndex = 83,
	}, tip)
	local tipText = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(42, 6),
		Size = UDim2.new(1, -54, 1, -12),
		Text = "Tip: Click the 3 dots or press 7 on a selected keyframe for track options.",
		TextColor3 = theme().MutedText,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.None,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 83,
	}, tip)
	tipText:SetAttribute("MegMoThemeTextRole", "MutedText")

	controller.dropdownLayer = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 145,
	}, root)

	function controller.refresh()
		for actionName, record in pairs(controller.buttons) do
			if record.item and record.item.dropdown and record.subtext then
				local value = getDropdownCurrentValue(actionName, controller.options)
				record.subtext.Text = tostring(value or "Choose")
				record.subtext.Visible = true
			end
		end
	end

	function controller.destroy()
		clearDropdown(controller)
		if host and host.Parent then
			host:ClearAllChildren()
		end
	end

	MicroWiggleFramesPopupSupport.mount(root, controller, {
		connect = function(signal, handler)
			if signal and type(handler) == "function" then
				return signal:Connect(handler)
			end
			return nil
		end,
		onApplyAnimationEffect = context.options and context.options.onApplyAnimationEffect,
		refresh = function()
			if type(controller.refresh) == "function" then
				controller.refresh()
			end
			if type(context.onAfterAction) == "function" then
				context.onAfterAction()
			end
		end,
		setStatus = context.setStatus,
	})

	controller.refresh()
	ThemeService.applyToGui(host)
	return controller
end

return MicroAnimationToolsPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX75">
          <Properties>
            <string name="Name">MicroCameraTrackEditorSupport</string>
            <ProtectedString name="Source">local CameraRotationUI = require(script.Parent:WaitForChild("CameraRotationUI"))
local UserInputService = game:GetService("UserInputService")

local WidgetCameraEditorSupport = require(script.Parent.Parent:WaitForChild("WidgetCameraEditorSupport"))
local WidgetCameraFollowOverlaySupport = require(script.Parent.Parent:WaitForChild("WidgetCameraFollowOverlaySupport"))
local WidgetCameraPresetSupport = require(script.Parent.Parent:WaitForChild("WidgetCameraPresetSupport"))
local WidgetControllerUtilitySupport = require(script.Parent.Parent:WaitForChild("WidgetControllerUtilitySupport"))
local WidgetMathSupport = require(script.Parent.Parent:WaitForChild("WidgetMathSupport"))

local MicroCameraTrackEditorSupport = {}

local function assignRefs(host, refs)
	for key, value in pairs(refs or {}) do
		host[key] = value
	end
end

local function connect(host, signal, callback)
	if not signal or type(callback) ~= "function" then
		return nil
	end
	if type(host._connect) == "function" then
		return host:_connect(signal, callback)
	end
	return signal:Connect(callback)
end

local function makeDraggable(host, handle, target)
	if not (handle and target) then
		return
	end
	local dragging = false
	local dragStart = nil
	local startPosition = nil
	connect(host, handle.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		dragging = true
		dragStart = input.Position
		startPosition = target.Position
	end)
	connect(host, UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	connect(host, UserInputService.InputChanged, function(input)
		if not dragging or not dragStart or not startPosition or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = input.Position - dragStart
		target.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)
end

local function setStatus(host, message)
	if type(host._setShortcutHint) == "function" then
		host:_setShortcutHint(message)
	end
end

local function getCallbacks(options)
	return type(options) == "table" and options or {}
end

local function makeOverlayPreviewFriendly(overlay)
	if not overlay then
		return
	end
	overlay.BackgroundTransparency = 1
	overlay:SetAttribute("MegMoMicroTransparentOverlay", true)
end

function MicroCameraTrackEditorSupport.mount(host, parent, options)
	if not host or not parent then
		return nil
	end

	assignRefs(host, CameraRotationUI.mount(parent, {}))

	host._cameraOrbitDirection = host._cameraOrbitDirection or "Clockwise"
	host._cameraPresetSubjectTracking = host._cameraPresetSubjectTracking ~= false
	host._cameraPresetEasingStyle = host._cameraPresetEasingStyle or "Linear"
	host._cameraPresetEasingDirection = host._cameraPresetEasingDirection or "InOut"

	makeOverlayPreviewFriendly(host._cameraTrackEditorOverlay)
	makeOverlayPreviewFriendly(host._cameraRotationOverlay)
	makeOverlayPreviewFriendly(host._cameraFollowOverlay)
	makeDraggable(host, host._cameraTrackEditorDragHandle, host._cameraTrackEditorCard)

	function host:_showCameraTrackEditor(trackPath, activeFrame)
		if not self._cameraTrackEditorOverlay then
			return false
		end
		self._activeCameraTrackPath = trackPath
		self._activeCameraKeyFrame = activeFrame
		self:_renderCameraTrackEditor()
		self._cameraTrackEditorOverlay.Visible = true
		setStatus(self, "Camera settings open: capture camera, set FOV, or add a preset move.")
		return true
	end

	function host:_hideCameraTrackEditor(preserveRotationPreview)
		if self._cameraTrackEditorOverlay then
			self._cameraTrackEditorOverlay.Visible = false
		end
		self:_hideCameraRotationEditor(preserveRotationPreview ~= true)
		self:_hideCameraFollowOverlay()
		self._activeCameraTrackPath = nil
	end

	function host:_renderCameraTrackEditor()
		return WidgetCameraEditorSupport.renderCameraTrackEditor(
			self,
			self._lastViewModel or {},
			WidgetMathSupport.formatNumber
		)
	end

	function host:_showCameraRotationEditor()
		return WidgetCameraEditorSupport.showCameraRotationEditor(self, WidgetMathSupport.formatNumber)
	end

	function host:_hideCameraRotationEditor(restorePreview)
		return WidgetCameraEditorSupport.hideCameraRotationEditor(self, restorePreview)
	end

	function host:_nudgeCameraRotationInput(input, delta)
		return WidgetCameraEditorSupport.nudgeCameraRotationInput(self, input, delta, WidgetMathSupport.formatNumber)
	end

	function host:_previewCameraRotationFromInputs()
		return WidgetCameraEditorSupport.previewCameraRotationFromInputs(self, function(camera, zDegrees)
			WidgetControllerUtilitySupport.ensureCameraCanPreviewRoll(camera, zDegrees)
		end)
	end

	function host:_getCameraPresetOptions()
		return WidgetCameraPresetSupport.getCameraPresetOptions(self)
	end

	function host:_showCameraFollowOverlay(presetId)
		if not self._cameraFollowOverlay then
			return false
		end
		local modeLabel, helpLabel = WidgetCameraPresetSupport.getCameraFollowCopy(presetId)
		self._activeCameraFollowPresetId = presetId
		WidgetCameraFollowOverlaySupport.applyFollowOverlayState(self, presetId, modeLabel, helpLabel)
		setStatus(self, "Camera setup open: preview, use Studio selection, or use bound rig.")
		return true
	end

	function host:_hideCameraFollowOverlay()
		WidgetCameraFollowOverlaySupport.hideFollowOverlay(self)
	end

	local callbacks = getCallbacks(options)
	local function getSelectedKeyRefs()
		if type(callbacks.getSelectedKeyRefs) ~= "function" then
			return {}
		end
		local success, selectedKeyRefs = pcall(callbacks.getSelectedKeyRefs)
		if success and type(selectedKeyRefs) == "table" then
			return selectedKeyRefs
		end
		return {}
	end

	local function selectActiveCameraTrack()
		if host._activeCameraTrackPath and type(callbacks.onSelectTrack) == "function" then
			if type(callbacks.getSelectedTrackPaths) == "function" then
				for _, selectedPath in ipairs(callbacks.getSelectedTrackPaths() or {}) do
					if selectedPath == host._activeCameraTrackPath then
						return
					end
				end
			end
			callbacks.onSelectTrack(host._activeCameraTrackPath, false)
		end
	end

	local function selectActiveCameraKeyIfAvailable()
		selectActiveCameraTrack()
		if not (host._activeCameraTrackPath and type(callbacks.onSelectKey) == "function") then
			return
		end
		local timeline = type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
		if not timeline then
			return
		end
		local currentFrame = host._activeCameraKeyFrame
			or (type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or nil)
		if currentFrame == nil then
			return
		end
		currentFrame = math.max(0, math.floor((tonumber(currentFrame) or 0) + 0.5))
		if type(timeline.hasTrackKeyframe) == "function" and timeline:hasTrackKeyframe(host._activeCameraTrackPath, currentFrame) then
			callbacks.onSelectKey(host._activeCameraTrackPath, currentFrame, false)
		end
	end

	host._cameraTrackEditorEasingCallbacks = {
		onSetEasingStyle = function(easingStyle)
			if #getSelectedKeyRefs() &gt; 1 and type(callbacks.onSetEasingStyle) == "function" then
				return callbacks.onSetEasingStyle(easingStyle)
			end
			local timeline = type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
			local frame = host._activeCameraKeyFrame
				or (timeline and type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or nil)
			local currentOptions = timeline
				and host._activeCameraTrackPath
				and frame ~= nil
				and type(timeline.getKeyOptions) == "function"
				and timeline:getKeyOptions(host._activeCameraTrackPath, frame)
				or {}
			if host._activeCameraTrackPath and type(callbacks.onSetTrackKeyEasing) == "function" then
				return callbacks.onSetTrackKeyEasing(host._activeCameraTrackPath, easingStyle, currentOptions.easingDirection, frame)
			end
			selectActiveCameraKeyIfAvailable()
			if type(callbacks.onSetEasingStyle) == "function" then
				return callbacks.onSetEasingStyle(easingStyle)
			end
			if type(callbacks.onEditorAction) == "function" then
				return callbacks.onEditorAction("setSelectedEasingStyle", easingStyle)
			end
			return nil
		end,
		onSetEasingDirection = function(easingDirection)
			if #getSelectedKeyRefs() &gt; 1 and type(callbacks.onSetEasingDirection) == "function" then
				return callbacks.onSetEasingDirection(easingDirection)
			end
			local timeline = type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
			local frame = host._activeCameraKeyFrame
				or (timeline and type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or nil)
			local currentOptions = timeline
				and host._activeCameraTrackPath
				and frame ~= nil
				and type(timeline.getKeyOptions) == "function"
				and timeline:getKeyOptions(host._activeCameraTrackPath, frame)
				or {}
			if host._activeCameraTrackPath and type(callbacks.onSetTrackKeyEasing) == "function" then
				return callbacks.onSetTrackKeyEasing(host._activeCameraTrackPath, currentOptions.easingStyle, easingDirection, frame)
			end
			selectActiveCameraKeyIfAvailable()
			if type(callbacks.onSetEasingDirection) == "function" then
				return callbacks.onSetEasingDirection(easingDirection)
			end
			if type(callbacks.onEditorAction) == "function" then
				return callbacks.onEditorAction("setSelectedEasingDirection", easingDirection)
			end
			return nil
		end,
	}

	connect(host, host._cameraTrackEditorCloseButton and host._cameraTrackEditorCloseButton.Activated, function()
		host:_hideCameraTrackEditor()
		setStatus(host, "Camera editor closed.")
	end)

	connect(host, host._cameraTrackEditorOkButton and host._cameraTrackEditorOkButton.Activated, function()
		host:_hideCameraTrackEditor()
		setStatus(host, "Camera editor closed.")
	end)

	connect(host, host._cameraTrackEditorCaptureButton and host._cameraTrackEditorCaptureButton.Activated, function()
		selectActiveCameraTrack()
		if type(callbacks.onCaptureCameraTrack) == "function" then
			callbacks.onCaptureCameraTrack()
		end
		setStatus(host, "Camera captured at playhead.")
	end)

	connect(host, host._cameraTrackEditorApplyFovButton and host._cameraTrackEditorApplyFovButton.Activated, function()
		selectActiveCameraTrack()
		if type(callbacks.onApplyCameraFov) == "function" then
			callbacks.onApplyCameraFov(host._cameraTrackEditorFovInput and host._cameraTrackEditorFovInput.Text or "")
		end
		setStatus(host, "Camera FOV keyed at playhead.")
	end)

	connect(host, host._cameraTrackEditorRotationButton and host._cameraTrackEditorRotationButton.Activated, function()
		host:_showCameraRotationEditor()
	end)

	connect(host, host._cameraTrackEditorAddFovButton and host._cameraTrackEditorAddFovButton.Activated, function()
		selectActiveCameraTrack()
		if type(callbacks.onEnsureCameraFovTrack) == "function" then
			callbacks.onEnsureCameraFovTrack()
		end
		setStatus(host, "Camera FOV track selected.")
	end)

	connect(host, host._cameraTrackEditorEasingButton and host._cameraTrackEditorEasingButton.Activated, function()
		local styles = { "Sine", "Quad", "Cubic", "Exponential", "Linear" }
		local current = host._cameraPresetEasingStyle or "Sine"
		local nextIndex = 1
		for index, styleName in ipairs(styles) do
			if styleName == current then
				nextIndex = (index % #styles) + 1
				break
			end
		end
		host._cameraPresetEasingStyle = styles[nextIndex]
		host._cameraPresetEasingDirection = "InOut"
		host:_renderCameraTrackEditor()
		setStatus(host, "Camera preset easing set to " .. tostring(host._cameraPresetEasingStyle) .. ".")
	end)

	connect(host, host._cameraTrackEditorSubjectTrackingButton and host._cameraTrackEditorSubjectTrackingButton.Activated, function()
		host._cameraPresetSubjectTracking = not (host._cameraPresetSubjectTracking ~= false)
		host:_renderCameraTrackEditor()
		setStatus(host, host._cameraPresetSubjectTracking ~= false and "Subject tracking on." or "Subject tracking off.")
	end)

	local subjectSetupPresets = {
		CrashZoom = true,
		DollyIn = true,
		DollyOut = true,
		FaceFocus = true,
		FollowCam = true,
		FollowRig = true,
		FollowRigCinematic = true,
		HeroReveal = true,
		Orbit = true,
		OrbitShot = true,
		OverShoulder = true,
	}

	local function bindCameraPreset(button, presetId)
		connect(host, button and button.Activated, function()
			if subjectSetupPresets[presetId] or presetId == "FirstPerson" then
				if type(host._setEffectsOverlayVisible) == "function" then
					host:_setEffectsOverlayVisible(false)
				end
				host:_showCameraFollowOverlay(presetId)
				return
			end
			if type(callbacks.onApplyCameraPreset) == "function" then
				selectActiveCameraTrack()
				local resolvedPresetId = presetId
				local presetOptions = host:_getCameraPresetOptions()
				if presetId == "FollowRig" then
					presetOptions.followStyle = "Regular"
				elseif presetId == "FollowRigCinematic" then
					presetOptions.followStyle = "Cinematic"
					resolvedPresetId = "FollowRig"
				end
				callbacks.onApplyCameraPreset(resolvedPresetId, presetOptions)
			end
			host:_hideCameraTrackEditor()
			setStatus(host, "Camera preset applied.")
		end)
	end

	bindCameraPreset(host._cameraTrackEditorShakeButton, "ExplosionShake")
	bindCameraPreset(host._cameraTrackEditorHandheldButton, "SoftHandheld")
	bindCameraPreset(host._cameraTrackEditorOrbitButton, "Orbit")
	bindCameraPreset(host._cameraTrackEditorFollowButton, "FollowRig")
	bindCameraPreset(host._cameraTrackEditorFollowCinematicButton, "FollowRigCinematic")
	bindCameraPreset(host._cameraTrackEditorAttachSelectionButton, "CameraAttachSelection")
	bindCameraPreset(host._cameraTrackEditorDetachSelectionButton, "CameraDetachSelection")
	bindCameraPreset(host._cameraTrackEditorFirstPersonButton, "FirstPerson")
	bindCameraPreset(host._cameraTrackEditorFirstPersonDetachButton, "FirstPersonDetach")
	bindCameraPreset(host._cameraTrackEditorOrbitShotButton, "OrbitShot")
	bindCameraPreset(host._cameraTrackEditorDollyInButton, "DollyIn")
	bindCameraPreset(host._cameraTrackEditorDollyOutButton, "DollyOut")
	bindCameraPreset(host._cameraTrackEditorHeroRevealButton, "HeroReveal")
	bindCameraPreset(host._cameraTrackEditorShoulderButton, "OverShoulder")
	bindCameraPreset(host._cameraTrackEditorCrashZoomButton, "CrashZoom")
	bindCameraPreset(host._cameraTrackEditorFollowCamButton, "FollowCam")

	connect(host, host._cameraFollowCloseButton and host._cameraFollowCloseButton.Activated, function()
		host:_hideCameraFollowOverlay()
		setStatus(host, "Camera follow setup closed.")
	end)

	connect(host, host._cameraFollowCancelButton and host._cameraFollowCancelButton.Activated, function()
		host:_hideCameraFollowOverlay()
		setStatus(host, "Camera follow setup closed.")
	end)

	for angleName, button in pairs(host._cameraFollowAngleButtons or {}) do
		connect(host, button and button.Activated, function()
			host._cameraFollowAngleMode = angleName
			host:_showCameraFollowOverlay(host._activeCameraFollowPresetId or "FollowRig")
		end)
	end

	connect(host, host._cameraFollowToEndButton and host._cameraFollowToEndButton.Activated, function()
		host._cameraFollowDurationToEnd = not host._cameraFollowDurationToEnd
		host:_showCameraFollowOverlay(host._activeCameraFollowPresetId or "Orbit")
	end)

	connect(host, host._cameraFollowDirectionButton and host._cameraFollowDirectionButton.Activated, function()
		host._cameraOrbitDirection = host._cameraOrbitDirection == "Counterclockwise" and "Clockwise" or "Counterclockwise"
		host:_showCameraFollowOverlay(host._activeCameraFollowPresetId or "Orbit")
	end)

	local function applyCameraFollowSelection(useBoundRig, previewOnly)
		local presetId = host._activeCameraFollowPresetId
		if not presetId or type(callbacks.onApplyCameraPreset) ~= "function" then
			return
		end
		selectActiveCameraTrack()
		local presetOptions = host:_getCameraPresetOptions()
		presetOptions.useBoundRig = useBoundRig == true
		presetOptions.previewOnly = previewOnly == true
		if useBoundRig == true and presetId == "Orbit" and presetOptions.durationToEnd ~= true then
			local durationText = host._cameraFollowDurationInput and tostring(host._cameraFollowDurationInput.Text or "") or ""
			if durationText == "" or durationText == "2.4" or durationText == "2.40" then
				presetOptions.durationSeconds = nil
			end
		end
		if presetId == "FirstPerson" then
			presetId = "FirstPersonAttach"
		elseif presetId == "FollowRigCinematic" then
			presetOptions.followStyle = "Cinematic"
			presetId = "FollowRig"
		elseif presetId == "FollowRig" then
			presetOptions.followStyle = "Regular"
		end
		callbacks.onApplyCameraPreset(presetId, presetOptions)
		if not previewOnly then
			host:_hideCameraTrackEditor()
		end
		setStatus(host, previewOnly and "Previewing camera preset." or "Camera preset applied.")
	end

	connect(host, host._cameraFollowPreviewButton and host._cameraFollowPreviewButton.Activated, function()
		applyCameraFollowSelection(false, true)
	end)

	connect(host, host._cameraFollowUseSelectionButton and host._cameraFollowUseSelectionButton.Activated, function()
		applyCameraFollowSelection(false, false)
	end)

	connect(host, host._cameraFollowUseBoundRigButton and host._cameraFollowUseBoundRigButton.Activated, function()
		applyCameraFollowSelection(true, false)
	end)

	connect(host, host._cameraRotationCloseButton and host._cameraRotationCloseButton.Activated, function()
		host:_hideCameraRotationEditor(true)
		setStatus(host, "Camera rotation editor closed.")
	end)

	connect(host, host._cameraRotationCancelButton and host._cameraRotationCancelButton.Activated, function()
		host:_hideCameraRotationEditor(true)
		setStatus(host, "Camera rotation editor closed.")
	end)

	connect(host, host._cameraRotationOkButton and host._cameraRotationOkButton.Activated, function()
		local applied = false
		selectActiveCameraTrack()
		if type(callbacks.onApplyCameraRotation) == "function" then
			applied = callbacks.onApplyCameraRotation(
				host._cameraRotationXInput and host._cameraRotationXInput.Text or "",
				host._cameraRotationYInput and host._cameraRotationYInput.Text or "",
				host._cameraRotationZInput and host._cameraRotationZInput.Text or "",
				host._activeCameraTrackPath
			) ~= false
		end
		if applied then
			host:_hideCameraRotationEditor(false)
			host:_hideCameraTrackEditor(true)
			setStatus(host, "Camera rotation keyed at playhead.")
		end
	end)

	local function bindCameraRotationInput(input)
		if not input then
			return
		end
		connect(host, input.Focused, function()
			host._editingTextInput = input
			host._shortcutFocus = false
			host._cameraRotationPreviewEnabled = true
			if type(host._releaseShortcutCapture) == "function" then
				host:_releaseShortcutCapture()
			end
		end)
		connect(host, input.FocusLost, function()
			if host._editingTextInput == input then
				host._editingTextInput = nil
			end
		end)
		connect(host, input.InputChanged, function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseWheel then
				host:_nudgeCameraRotationInput(input, inputObject.Position.Z)
			end
		end)
		connect(host, input:GetPropertyChangedSignal("Text"), function()
			host:_previewCameraRotationFromInputs()
		end)
	end

	bindCameraRotationInput(host._cameraRotationXInput)
	bindCameraRotationInput(host._cameraRotationYInput)
	bindCameraRotationInput(host._cameraRotationZInput)

	connect(host, host._cameraTrackEditorFovInput and host._cameraTrackEditorFovInput.FocusLost, function(enterPressed)
		if enterPressed and type(callbacks.onApplyCameraFov) == "function" then
			selectActiveCameraTrack()
			callbacks.onApplyCameraFov(host._cameraTrackEditorFovInput.Text)
		end
	end)

	return true
end

return MicroCameraTrackEditorSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX76">
          <Properties>
            <string name="Name">MicroCutscenePopupSupport</string>
            <ProtectedString name="Source">local ScriptUI = require(script.Parent:WaitForChild("ScriptUI"))

local MicroCutscenePopupSupport = {}

local function disconnectAll(connections)
	for _, connection in ipairs(connections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	table.clear(connections)
end

local function connect(connections, signal, handler)
	if not signal or type(handler) ~= "function" then
		return nil
	end
	local connection = signal:Connect(handler)
	table.insert(connections, connection)
	return connection
end

local function setStatus(options, message)
	if type(options.setStatus) == "function" then
		options.setStatus(message)
	end
end

function MicroCutscenePopupSupport.mount(parent, options)
	if not parent then
		error("MicroCutscenePopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local refs = ScriptUI.mount(parent, {
		embeddedPopup = true,
		hideHeader = true,
		includeValidateButton = true,
		hideStatusPanel = true,
	})
	local controller = {}

	for key, value in pairs(refs or {}) do
		controller[key] = value
	end

	local function getExportOptions()
		if type(controller._getCutsceneExportOptions) == "function" then
			return controller._getCutsceneExportOptions()
		end
		return nil
	end

	local function setCutsceneStatus(message)
		setStatus(options, message)
	end

	local function refresh()
		if controller._scriptCard then
			controller._scriptCard.Visible = true
		end
	end

	connect(connections, controller._scriptValidateButton and controller._scriptValidateButton.Activated, function()
		setCutsceneStatus("Validating cutscene package...")
		local callback = options.onValidateCutscene
		if type(callback) ~= "function" then
			setCutsceneStatus("Cutscene validation is not available right now.")
			return
		end
		local message = callback(getExportOptions())
		setCutsceneStatus(message or "Cutscene validation finished.")
	end)

	connect(connections, controller._scriptGenerateButton and controller._scriptGenerateButton.Activated, function()
		setCutsceneStatus("Generating cutscene package...")
		local callback = options.onGenerateCutscene
		if type(callback) ~= "function" then
			setCutsceneStatus("Cutscene generation is not available right now.")
			return
		end
		local message = callback(getExportOptions())
		setCutsceneStatus(message or "Generated cutscene package.")
	end)

	refresh()

	return {
		refresh = refresh,
		destroy = function()
			disconnectAll(connections)
			if controller._scriptCard and controller._scriptCard.Parent then
				controller._scriptCard:Destroy()
			end
		end,
	}
end

return MicroCutscenePopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX77">
          <Properties>
            <string name="Name">MicroEffectsPopupSupport</string>
            <ProtectedString name="Source">local EffectsUI = require(script.Parent:WaitForChild("EffectsUI"))
local EffectsActionBinder = require(script.Parent.Parent:WaitForChild("EffectsActionBinder"))
local MicroWiggleFramesPopupSupport = require(script.Parent:WaitForChild("MicroWiggleFramesPopupSupport"))
local WidgetCameraFollowOverlaySupport = require(script.Parent.Parent:WaitForChild("WidgetCameraFollowOverlaySupport"))
local WidgetCameraPresetSupport = require(script.Parent.Parent:WaitForChild("WidgetCameraPresetSupport"))

local MicroEffectsPopupSupport = {}

local ANIMATION_BUTTON_REFS = {
	StopMotionHold = "_animationStopMotionButton",
	StopMotion2 = "_animationStopMotion2Button",
	StopMotion4 = "_animationStopMotion4Button",
	StopMotion6 = "_animationStopMotion6Button",
	KeyframeStagger = "_animationStaggerButton",
	OvershootSettle = "_animationOvershootSettleButton",
	LoopPolish = "_animationLoopPolishButton",
	BoilFrames = "_animationBoilFramesButton",
	PoseHold = "_animationPoseHoldButton",
	Wiggle = "_animationWiggleButton",
	Linearize = "_animationLinearizeButton",
	Reverse = "_animationReverseButton",
	SlowMotion2 = "_animationSlowMotionButton",
	SpeedRampUp = "_animationRampUpButton",
	SpeedRampDown = "_animationRampDownButton",
	SpeedRampInOut = "_animationRampInOutButton",
	SpeedRampOutIn = "_animationRampOutInButton",
}

local function disconnectAll(connections)
	for _, connection in ipairs(connections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	table.clear(connections)
end

local function connect(connections, signal, handler)
	if not signal or type(handler) ~= "function" then
		return nil
	end
	local connection = signal:Connect(handler)
	table.insert(connections, connection)
	return connection
end

local function setStatus(options, message)
	if type(options.setStatus) == "function" then
		options.setStatus(message)
	end
end

local function renderStatuses(controller, viewModel)
	local effects = type(viewModel) == "table" and viewModel.effects or {}
	local activeCount = tonumber(effects.activeScreenEffectCount) or 0
	if controller._screenEffectsStatus then
		controller._screenEffectsStatus.Text = string.format(
			"%d viewer preview effect%s active. Use Add Track to keyframe effects on the timeline.",
			activeCount,
			activeCount == 1 and "" or "s"
		)
	end
	if controller._lightingEffectsStatus then
		controller._lightingEffectsStatus.Text = "Add lighting effects as timeline tracks, then keyframe their settings with ... or Keypad 7."
	end
end

local function findTrackInViewModel(controller, path)
	if not path then
		return nil
	end
	local viewModel = controller._lastViewModel or {}
	for _, track in ipairs(viewModel.tracks or {}) do
		if track.path == path then
			return track
		end
	end
	return nil
end

function MicroEffectsPopupSupport.mount(parent, options)
	if not parent then
		error("MicroEffectsPopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local refs = EffectsUI.mount(parent, {
		embeddedPopup = true,
		hideHeader = true,
		hideCloseButton = true,
	})
	local controller = {
		_callbacks = {},
		_uiSections = {
			EffectsUI = EffectsUI,
		},
		_lastViewModel = {},
		_cameraOrbitAngleMode = "Half",
		_cameraOrbitDirection = "Clockwise",
		_cameraPresetSubjectTracking = true,
		_cameraPresetEasingStyle = "Linear",
		_cameraPresetEasingDirection = "InOut",
		_effectsCameraPreviewPresetId = "OrbitShot",
	}

	for key, value in pairs(refs or {}) do
		controller[key] = value
	end
	for key, value in pairs((options and options.microUiHost) or (options and options._microUiHost) or {}) do
		if string.sub(tostring(key), 1, 13) == "_cameraFollow" then
			controller[key] = value
		end
	end

	function controller:_connect(signal, handler)
		return connect(connections, signal, handler)
	end

	function controller:_setShortcutHint(message)
		setStatus(options, message)
	end

	controller._focusShortcutCapture = controller._setShortcutHint

	function controller:_setEffectsOverlayVisible(isVisible)
		if self._effectsOverlay then
			self._effectsOverlay.Visible = isVisible == true
		end
		if not isVisible and type(options.onClose) == "function" then
			task.defer(function()
				if self._cameraFollowOverlay and self._cameraFollowOverlay.Visible then
					return
				end
				options.onClose()
			end)
		end
	end

	function controller:_getCameraPresetOptions()
		return WidgetCameraPresetSupport.getCameraPresetOptions(self)
	end

	function controller:_showCameraFollowOverlay(presetId)
		local modeLabel, helpLabel = WidgetCameraPresetSupport.getCameraFollowCopy(presetId)
		self._activeCameraFollowPresetId = presetId
		WidgetCameraFollowOverlaySupport.applyFollowOverlayState(self, presetId, modeLabel, helpLabel)
		setStatus(options, "Camera setup open: preview, use Studio selection, or use bound rig.")
	end

	function controller:_hideCameraFollowOverlay()
		WidgetCameraFollowOverlaySupport.hideFollowOverlay(self)
	end

	function controller:_findTrackInViewModel(path)
		return findTrackInViewModel(self, path)
	end

	function controller:_getOptionsTrackFromSelection()
		local viewModel = self._lastViewModel or {}
		for _, key in ipairs(viewModel.selectedKeys or {}) do
			local track = self:_findTrackInViewModel(key.jointPath or key.path)
			if track then
				return track
			end
		end
		local selectedTrack = self:_findTrackInViewModel(viewModel.selectedJointPath)
		if selectedTrack then
			return selectedTrack
		end
		for _, path in ipairs(viewModel.selectedTrackPaths or {}) do
			local track = self:_findTrackInViewModel(path)
			if track then
				return track
			end
		end
		return nil
	end

	function controller:_openSelectedOptionsPopup()
		if type(options.onOpenSelectedTrackOptions) == "function" then
			return options.onOpenSelectedTrackOptions()
		end

		local track = self:_getOptionsTrackFromSelection()
		if not track then
			return false, "Select an effect or property track first."
		end
		return false, "Track options are unavailable."
	end

	local function refresh()
		local overlay = controller._effectsOverlay
		if overlay then
			overlay.Visible = true
			overlay.BackgroundTransparency = 1
			overlay.BackgroundColor3 = parent.BackgroundColor3
			overlay.ZIndex = 73
		end
		local viewModelGetter = options.getEffectsViewModel
		controller._lastViewModel = type(viewModelGetter) == "function" and (viewModelGetter() or {}) or {}
		renderStatuses(controller, controller._lastViewModel)
	end

	MicroWiggleFramesPopupSupport.mount(parent, controller, {
		connect = function(signal, handler)
			return connect(connections, signal, handler)
		end,
		onApplyAnimationEffect = options.onApplyAnimationEffect,
		refresh = refresh,
		setStatus = function(message)
			setStatus(options, message)
		end,
	})

	connect(connections, controller._effectsCloseButton and controller._effectsCloseButton.Activated, function()
		if type(options.onClose) == "function" then
			options.onClose()
		end
	end)

	connect(connections, controller._cameraFollowCloseButton and controller._cameraFollowCloseButton.Activated, function()
		controller:_hideCameraFollowOverlay()
		setStatus(options, "Camera setup closed.")
	end)

	connect(connections, controller._cameraFollowCancelButton and controller._cameraFollowCancelButton.Activated, function()
		controller:_hideCameraFollowOverlay()
		setStatus(options, "Camera setup closed.")
	end)

	for angleName, button in pairs(controller._cameraFollowAngleButtons or {}) do
		connect(connections, button and button.Activated, function()
			controller._cameraFollowAngleMode = angleName
			controller:_showCameraFollowOverlay(controller._activeCameraFollowPresetId or "FollowRig")
		end)
	end

	connect(connections, controller._cameraFollowToEndButton and controller._cameraFollowToEndButton.Activated, function()
		controller._cameraFollowDurationToEnd = not controller._cameraFollowDurationToEnd
		controller:_showCameraFollowOverlay(controller._activeCameraFollowPresetId or "Orbit")
	end)

	connect(connections, controller._cameraFollowDirectionButton and controller._cameraFollowDirectionButton.Activated, function()
		controller._cameraOrbitDirection = controller._cameraOrbitDirection == "Counterclockwise" and "Clockwise" or "Counterclockwise"
		controller:_showCameraFollowOverlay(controller._activeCameraFollowPresetId or "Orbit")
	end)

	local function applyCameraFollowSelection(useBoundRig, previewOnly)
		local presetId = controller._activeCameraFollowPresetId
		if not presetId or type(options.onApplyCameraPreset) ~= "function" then
			return
		end
		local presetOptions = controller:_getCameraPresetOptions()
		presetOptions.useBoundRig = useBoundRig == true
		presetOptions.previewOnly = previewOnly == true
		if useBoundRig == true and presetId == "Orbit" and presetOptions.durationToEnd ~= true then
			local durationText = controller._cameraFollowDurationInput and tostring(controller._cameraFollowDurationInput.Text or "") or ""
			if durationText == "" or durationText == "2.4" or durationText == "2.40" then
				presetOptions.durationSeconds = nil
			end
		end
		if presetId == "FirstPerson" then
			presetId = "FirstPersonAttach"
		elseif presetId == "FollowRigCinematic" then
			presetOptions.followStyle = "Cinematic"
			presetId = "FollowRig"
		elseif presetId == "FollowRig" then
			presetOptions.followStyle = "Regular"
		end
		options.onApplyCameraPreset(presetId, presetOptions)
		if not previewOnly then
			controller:_hideCameraFollowOverlay()
		end
		setStatus(options, previewOnly and "Previewing camera preset." or "Camera preset applied.")
		refresh()
	end

	connect(connections, controller._cameraFollowPreviewButton and controller._cameraFollowPreviewButton.Activated, function()
		applyCameraFollowSelection(false, true)
	end)

	connect(connections, controller._cameraFollowUseSelectionButton and controller._cameraFollowUseSelectionButton.Activated, function()
		applyCameraFollowSelection(false, false)
	end)

	connect(connections, controller._cameraFollowUseBoundRigButton and controller._cameraFollowUseBoundRigButton.Activated, function()
		applyCameraFollowSelection(true, false)
	end)

	for effectId, button in pairs(controller._screenEffectButtons or {}) do
		connect(connections, button and button.Activated, function()
			local callback = options.onAddScreenEffectTrack
			if type(callback) ~= "function" then
				return
			end
			local trackPath = callback(effectId)
			if trackPath and type(options.onSelectTrack) == "function" then
				options.onSelectTrack(trackPath, false)
			end
			if trackPath and type(options.onOpenEffectTrackEditor) == "function" then
				options.onOpenEffectTrackEditor(trackPath)
			end
			setStatus(options, "Added screen effect track: " .. tostring(effectId))
			refresh()
		end)
	end

	for effectId, button in pairs(controller._lightingEffectButtons or {}) do
		connect(connections, button and button.Activated, function()
			local callback = options.onAddLightingEffectTrack
			if type(callback) ~= "function" then
				return
			end
			local trackPath = callback(effectId)
			if trackPath and type(options.onSelectTrack) == "function" then
				options.onSelectTrack(trackPath, false)
			end
			if trackPath and type(options.onOpenEffectTrackEditor) == "function" then
				options.onOpenEffectTrackEditor(trackPath)
			end
			setStatus(options, "Added lighting effect track: " .. tostring(effectId))
			refresh()
		end)
	end

	for effectId, refName in pairs(ANIMATION_BUTTON_REFS) do
		local button = controller[refName]
		connect(connections, button and button.Activated, function()
			local callback = options.onApplyAnimationEffect
			if type(callback) ~= "function" then
				return
			end
			local effectOptions = nil
			if effectId == "Wiggle" then
				if type(controller._showWiggleFramesOverlay) == "function" then
					controller:_showWiggleFramesOverlay()
					return
				else
					effectOptions = {
						angleX = "2",
						angleY = "2",
						angleZ = "2",
						posX = "0",
						posY = "0",
						posZ = "0",
						interval = "0:02",
						easingStyle = "Linear",
						easingDirection = "InOut",
					}
				end
			end
			callback(effectId, effectOptions)
			refresh()
		end)
	end

	EffectsActionBinder.bind(controller, {
		onAddTrack = options.onAddTrack,
		onApplyCameraPreset = options.onApplyCameraPreset,
		onCaptureCameraTrack = options.onCaptureCameraTrack,
		onEnsureCameraFovTrack = options.onEnsureCameraFovTrack,
		onToggleRigPropertyTrack = options.onToggleRigPropertyTrack,
		onTogglePropertyTrack = options.onTogglePropertyTrack,
		onSetParticleEmitterPropertyKey = options.onSetParticleEmitterPropertyKey,
	})

	refresh()

	return {
		refresh = refresh,
		destroy = function()
			if type(controller._hideCameraFollowOverlay) == "function" then
				controller:_hideCameraFollowOverlay()
			end
			disconnectAll(connections)
			if controller._effectsOverlay and controller._effectsOverlay.Parent then
				controller._effectsOverlay:Destroy()
			end
		end,
	}
end

return MicroEffectsPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX78">
          <Properties>
            <string name="Name">MicroFacesPopupSupport</string>
            <ProtectedString name="Source">local FacesView = require(script.Parent.Parent.Parent:WaitForChild("Features"):WaitForChild("Faces"):WaitForChild("FacesView"))

local MicroFacesPopupSupport = {}

local FACES_DESIGN_SIZE = Vector2.new(900, 606)
local FACES_COMPACT_WIDTH = 700
local FACES_COMPACT_COLLAPSED_HEIGHT = 430
local FACES_COMPACT_EXPANDED_HEIGHT = 606
local FACES_COMPACT_HOST_WIDTH = 680
local FACES_COMPACT_HOST_HEIGHT = 460
local FACES_MIN_SCALE = 0.58
local FACES_MAX_SCALE = 1.12
local PRESET_MODAL_SIZE = Vector2.new(620, 680)
local PRESET_MODAL_MARGIN = 24

local function disconnectAll(connections)
	for _, connection in ipairs(connections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end
	table.clear(connections)
end

local function connect(connections, signal, handler)
	if not signal or type(handler) ~= "function" then
		return nil
	end
	local connection = signal:Connect(handler)
	table.insert(connections, connection)
	return connection
end

function MicroFacesPopupSupport.mount(parent, options)
	if not parent then
		error("MicroFacesPopupSupport.mount requires parent")
	end

	options = options or {}
	local connections = {}
	local refs = FacesView.mount(parent, {
		embeddedPopup = true,
		hideHeader = true,
		hideCloseButton = true,
	})
	local controller = {
		_callbacks = {},
		_uiSections = {
			FacesUI = FacesView,
		},
	}

	for key, value in pairs(refs or {}) do
		controller[key] = value
	end

	local facesScale = Instance.new("UIScale")
	facesScale.Name = "MicroFacesResponsiveScale"
	facesScale.Parent = controller._facesOverlay
	local presetModalScale = Instance.new("UIScale")
	presetModalScale.Name = "MicroFacesPresetResponsiveScale"
	presetModalScale.Parent = controller._facesPresetModal
	local compactToolsExpanded = false

	local function setButtonText(button, text)
		if not button then
			return
		end
		button.Text = text
		local overlay = button:FindFirstChild("MegMoButtonTextOverlay")
		if overlay and overlay:IsA("TextLabel") then
			overlay.Text = text
		end
	end

	local function applyResponsivePositions(compact, toolsExpanded)
		local showTools = not compact or toolsExpanded
		local toolsButton = controller._facesCompactToolsButton
		if toolsButton then
			toolsButton.Visible = compact
			toolsButton.Position = UDim2.new(1, -112, 0, 30)
			toolsButton.Size = UDim2.new(0, 90, 0, 32)
			setButtonText(toolsButton, toolsExpanded and "Tools ^" or "Tools v")
		end

		if controller._facesAddPresetButton then
			controller._facesAddPresetButton.Position = UDim2.new(0, 22, 0, 30)
		end
		if controller._facesImportSelectionButton then
			controller._facesImportSelectionButton.Position = UDim2.new(0, 124, 0, 30)
		end
		if controller._facesSearchInput then
			controller._facesSearchInput.Position = UDim2.new(0, 226, 0, 30)
			controller._facesSearchInput.Size = compact
				and UDim2.new(1, -350, 0, 32)
				or UDim2.new(1, -520, 0, 32)
		end

		local recover = controller._facesRecoverPresetsButton
		local importButton = controller._facesImportPresetsButton
		local exportButton = controller._facesExportPresetsButton
		if recover then
			recover.Visible = showTools
			recover.Position = compact
				and UDim2.new(0, 22, 0, 72)
				or UDim2.new(1, -282, 0, 30)
		end
		if importButton then
			importButton.Visible = showTools
			importButton.Position = compact
				and UDim2.new(0, 114, 0, 72)
				or UDim2.new(1, -190, 0, 30)
		end
		if exportButton then
			exportButton.Visible = showTools
			exportButton.Position = compact
				and UDim2.new(0, 198, 0, 72)
				or UDim2.new(1, -106, 0, 30)
		end

		local folderPanel = controller._facesFolderPanel
		local transitionPanel = controller._facesTransitionPanel
		local statusLabel = controller._facesStatusLabel
		if folderPanel then
			folderPanel.Visible = showTools
			folderPanel.Position = UDim2.new(0, 22, 0, compact and 114 or 72)
		end
		if controller._facesFolderDropdownMenu then
			if not showTools then
				controller._facesFolderDropdownMenu.Visible = false
			end
			controller._facesFolderDropdownMenu.Position = UDim2.new(0, 36, 0, compact and 168 or 126)
		end
		if transitionPanel then
			transitionPanel.Visible = showTools
			transitionPanel.Position = UDim2.new(0, 22, 0, compact and 176 or 134)
		end
		if statusLabel then
			statusLabel.Visible = showTools
			statusLabel.Position = UDim2.new(0, 394, 0, compact and 176 or 134)
		end

		local savedHeader = controller._facesSavedPresetsHeader
		local presetList = controller._facesPresetList
		if compact and not toolsExpanded then
			if savedHeader then
				savedHeader.Position = UDim2.new(0, 22, 0, 76)
			end
			if presetList then
				presetList.Position = UDim2.new(0, 22, 0, 102)
				presetList.Size = UDim2.new(1, -44, 1, -124)
			end
		elseif compact then
			if savedHeader then
				savedHeader.Position = UDim2.new(0, 22, 0, 246)
			end
			if presetList then
				presetList.Position = UDim2.new(0, 22, 0, 272)
				presetList.Size = UDim2.new(1, -44, 1, -294)
			end
		else
			if savedHeader then
				savedHeader.Position = UDim2.new(0, 22, 0, 204)
			end
			if presetList then
				presetList.Position = UDim2.new(0, 22, 0, 230)
				presetList.Size = UDim2.new(1, -44, 1, -252)
			end
		end
	end

	local function refreshResponsiveLayout()
		local hostSize = parent.AbsoluteSize
		if hostSize.X &lt; 1 or hostSize.Y &lt; 1 then
			return
		end

		local compact = hostSize.X &lt;= FACES_COMPACT_HOST_WIDTH or hostSize.Y &lt;= FACES_COMPACT_HOST_HEIGHT
		if not compact then
			compactToolsExpanded = false
		end
		applyResponsivePositions(compact, compactToolsExpanded)
		local designSize = compact
			and Vector2.new(
				FACES_COMPACT_WIDTH,
				compactToolsExpanded and FACES_COMPACT_EXPANDED_HEIGHT or FACES_COMPACT_COLLAPSED_HEIGHT
			)
			or FACES_DESIGN_SIZE
		local scale = math.clamp(
			math.min(hostSize.X / designSize.X, hostSize.Y / designSize.Y),
			FACES_MIN_SCALE,
			FACES_MAX_SCALE
		)
		facesScale.Scale = scale
		controller._facesOverlay.Size = UDim2.fromOffset(
			math.max(1, math.floor(hostSize.X / scale + 0.5)),
			math.max(1, math.floor(hostSize.Y / scale + 0.5))
		)

		local logicalWidth = controller._facesOverlay.Size.X.Offset
		local logicalHeight = controller._facesOverlay.Size.Y.Offset
		presetModalScale.Scale = math.min(
			1,
			math.max(0.5, (logicalWidth - PRESET_MODAL_MARGIN) / PRESET_MODAL_SIZE.X),
			math.max(0.5, (logicalHeight - PRESET_MODAL_MARGIN) / PRESET_MODAL_SIZE.Y)
		)
	end

	connect(connections, parent:GetPropertyChangedSignal("AbsoluteSize"), refreshResponsiveLayout)
	connect(connections, controller._facesCompactToolsButton and controller._facesCompactToolsButton.Activated, function()
		compactToolsExpanded = not compactToolsExpanded
		refreshResponsiveLayout()
	end)

	local function refresh()
		refreshResponsiveLayout()
		local overlay = controller._facesOverlay
		if overlay then
			overlay.Visible = true
			overlay.BackgroundTransparency = 1
			overlay.BackgroundColor3 = parent.BackgroundColor3
			overlay.ZIndex = 73
		end
		local viewModelGetter = options.getFacesViewModel
		local viewModel = type(viewModelGetter) == "function" and (viewModelGetter() or {}) or {}
		FacesView.render(controller, viewModel)
	end

	local function runFacesAction(action, payload)
		local callback = options.onFacesAction
		if type(callback) ~= "function" then
			return false, "Faces tools are not available right now."
		end
		local success, message, result = callback(action, payload)
		if action ~= "previewPresetDraft" and action ~= "endPresetDraftPreview" then
			refresh()
		end
		return success ~= false, message, result
	end

	controller._callbacks.onFacesAction = runFacesAction
	if controller._facesPresetModalRefs then
		controller._facesPresetModalRefs._callbacks = controller._callbacks
	end

	connect(connections, controller._facesCloseButton and controller._facesCloseButton.Activated, function()
		if type(options.onClose) == "function" then
			options.onClose()
		end
	end)
	connect(connections, controller._facesAddPresetButton and controller._facesAddPresetButton.Activated, function()
		FacesView.openPresetModal(controller)
	end)
	connect(connections, controller._facesImportSelectionButton and controller._facesImportSelectionButton.Activated, function()
		local success, _, preview = runFacesAction("scanSelectionPresets")
		if not success or type(preview) ~= "table" then
			return
		end
		FacesView.openSelectionImport(controller, preview, function(groupIds, folderName)
			return runFacesAction("importSelectionPresets", {
				groupIds = groupIds,
				folderName = folderName,
			})
		end)
	end)
	connect(connections, controller._facesRecoverPresetsButton and controller._facesRecoverPresetsButton.Activated, function()
		FacesView.openDeleteConfirmation(controller, {
			title = "Recover face presets?",
			message = "Scan this project's Face keyframes and add missing visual presets to Unsorted. Existing presets will not be overwritten.",
			confirmText = "Recover Presets",
			danger = false,
			onConfirm = function()
				runFacesAction("recoverPresetsFromProject")
			end,
		})
	end)
	connect(connections, controller._facesExportPresetsButton and controller._facesExportPresetsButton.Activated, function()
		runFacesAction("exportPresets")
	end)
	connect(connections, controller._facesImportPresetsButton and controller._facesImportPresetsButton.Activated, function()
		runFacesAction("importPresets")
	end)
	connect(connections, controller._facesInstantButton and controller._facesInstantButton.Activated, function()
		runFacesAction("setTransition", "Instant")
	end)
	connect(connections, controller._facesCrossFadeButton and controller._facesCrossFadeButton.Activated, function()
		runFacesAction("setTransition", "CrossFade")
	end)
	connect(connections, controller._facesFadeDurationInput and controller._facesFadeDurationInput.FocusLost, function()
		runFacesAction("setFadeTime", controller._facesFadeDurationInput.Text)
	end)
	if controller._facesSearchInput then
		connect(connections, controller._facesSearchInput:GetPropertyChangedSignal("Text"), function()
			runFacesAction("search", controller._facesSearchInput.Text)
		end)
	end
	connect(connections, controller._facesAddFolderButton and controller._facesAddFolderButton.Activated, function()
		runFacesAction("createFolder", controller._facesFolderNameInput and controller._facesFolderNameInput.Text or "")
	end)
	connect(connections, controller._facesRenameFolderButton and controller._facesRenameFolderButton.Activated, function()
		runFacesAction("renameFolder", controller._facesFolderNameInput and controller._facesFolderNameInput.Text or "")
	end)
	connect(connections, controller._facesDeleteFolderButton and controller._facesDeleteFolderButton.Activated, function()
		FacesView.confirmDeleteSelectedFolder(controller, function()
			runFacesAction("deleteFolder")
		end)
	end)
	connect(connections, controller._facesSingleTypeButton and controller._facesSingleTypeButton.Activated, function()
		FacesView.setPresetFormType(controller, "Single")
	end)
	connect(connections, controller._facesLayeredTypeButton and controller._facesLayeredTypeButton.Activated, function()
		FacesView.setPresetFormType(controller, "Layered")
	end)
	connect(connections, controller._facesPresetPreviewButton and controller._facesPresetPreviewButton.Activated, function()
		FacesView.openLargePreview(controller)
	end)
	connect(connections, controller._facesPresetCancelButton and controller._facesPresetCancelButton.Activated, function()
		FacesView.closePresetModal(controller)
	end)
	connect(connections, controller._facesPresetSaveButton and controller._facesPresetSaveButton.Activated, function()
		local success = runFacesAction("savePreset", FacesView.collectPresetForm(controller))
		if success then
			FacesView.closePresetModal(controller)
			refresh()
		end
	end)

	refresh()

	return {
		refresh = refresh,
		destroy = function()
			runFacesAction("endPresetDraftPreview")
			disconnectAll(connections)
			if controller._facesOverlay and controller._facesOverlay.Parent then
				controller._facesOverlay:Destroy()
			end
		end,
	}
end

return MicroFacesPopupSupport
