	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	state.effectMode = "Drop"
	state.eventSourceInstance = nil
	state.eventSourcePosition = nil
	state.eventSourceDirection = Vector3.zAxis
	state.eventSourceDirectionManual = false
	state.eventSourceDescriptor = nil
	state.eventSourceTargets = {}
	state.eventProjectileStart = nil
	state.eventProjectileEnd = nil
	projectilePathUX:Clear()
	state.clearStartingPush()
	state.eventMarkers = {}
	state.eventTime = 0.5
	state.eventStrength = "Medium"
	state.eventPower = 50
	state.eventPowerDragging = false
	state.eventSlowMotion = false
	state.eventPlaybackSpeed = 1
	state.eventReaction = "Push"
	state.eventDirectionMode = "Outward"
	state.explosionVFXSupport.ClearPreviews()
	state.explosionVFXSource = nil
	state.explosionVFXSourceDescriptor = nil
	state.explosionVFXEmitCount = nil
	state.eventSession = nil
	if state.eventTestLivePreviewSession then
		TakePreviewRuntime.Stop(state.eventTestLivePreviewSession, false)
		state.eventTestLivePreviewSession = nil
	end
	state.eventTestLiveCaptureComplete = false
	state.eventTestMode = false
	state.eventSpeedPreviewMode = false
	state.eventTestCompleted = false
	state.eventTestSettledDuration = 0
	state.restoreEventTestRuntimeTargets()
	state.bounceEnabled = false
	state.advancedVisible = false
	state.captureMode = "Objects"
	state.selectedRig = nil
	state.selectedRigs = {}
	state.rigCaptureEntries = {}
	state.rigEditSnapshots = {}
	state.driverObject = nil
	state.driverId = nil
	state.driverEditSnapshots = {}
	state.driverCaptureTarget = nil
	state.riderTargets = {}
	state.riderEditSnapshots = {}
	state.riderRuntimeSession = nil
	state.movingObjectMode = "PhysicsDrive"
	state.keepUpright = false
	state.captureId = nil
	state.armed = false
	state.capturing = false
	state.autoRagdoll = false
	state.fps = 30
	state.maxDuration = 20
	state.captureScope = SceneCaptureScope.SELECTED
	state.objectTargets = {}
	state.objectEditSnapshots = {}
	state.targetsTruncated = false
	state.releaseObject = nil
	state.releaseCaptureTarget = nil
	state.releaseData = nil
	state.releaseCollisionsEnabled = true
	state.animatedPath = nil
	state.pathMode = "Handoff"
	state.pathSession = nil
	state.heldPathSession = nil
	state.adaptiveWalkSession = nil
	state.adaptiveWalkRestoreSession = nil
	state.adaptiveWalkComplete = false
	state.impactBreak = false
	state.impactSession = nil
	state.physicsDriveSession = nil
	state.runtimeTargets = nil
	state.runtimeObjectAnchors = {}
	state.physicsActive = false
