function WidgetController:_showPropertyKeyframeEditor(trackPath)
	local track = self:_getTrackViewModel(trackPath)
	if self:_isFaceKeyframeTrack(track) then
		self:_hideTrackActions()
		self:_setFacesOverlayVisible(true)
		self:_setShortcutHint("Faces panel open: choose a preset to apply a face keyframe")
		return
	end
	PropertyKeyframeEditorController.show(self, trackPath)
end

