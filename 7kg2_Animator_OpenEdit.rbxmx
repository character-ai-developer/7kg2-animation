function WidgetController:_renderImportAnimationEntries(entries, statusText)
	if not self._ownedAnimationsList then
		return
	end

	entries = entries or {}
	local importBrowserSupport = require(script.Parent:WaitForChild("WidgetImportBrowserSupport"))
	local signature = importBrowserSupport.buildImportEntriesSignature(entries, statusText)
	if signature == self._lastImportEntriesSignature then
		return
	end
	self._lastImportEntriesSignature = signature
	importBrowserSupport.renderImportAnimationEntries(self, entries, statusText, {
		create = create,
		createCorner = createCorner,
	})
end

function WidgetController:_renderPresetBrowserEntries(entries, statusText)
	if not self._presetGrid then
		return
	end

	entries = entries or {}
	local importBrowserSupport = require(script.Parent:WaitForChild("WidgetImportBrowserSupport"))
	local signature, filteredEntries, isChoosingMotionDefault = importBrowserSupport.buildPresetEntriesSignature(self, entries, statusText)
	if signature == self._lastPresetEntriesSignature then
		return
	end
	self._lastPresetEntriesSignature = signature
	importBrowserSupport.renderPresetBrowserEntries(
		self,
		filteredEntries,
		statusText,
		isChoosingMotionDefault,
		tostring(self._motionDefaultPickerMotion or ""),
		{
			create = create,
			createCorner = createCorner,
			createStroke = createStroke,
		}
	)
end

function WidgetController:_setPresetPreviewPlaying(viewport, shouldPlay)
	if not viewport then
		return
	end

	local previewState = self._presetPreviewStates and self._presetPreviewStates[viewport]
	if not previewState or not previewState.ready or not previewState.previewData then
		return
	end

	if shouldPlay then
		if previewState.connection then
			return
		end
		previewState.connection = RunService.Heartbeat:Connect(function(deltaTime)
			if not viewport.Parent then
				if previewState.connection then
					previewState.connection:Disconnect()
					previewState.connection = nil
				end
				return
			end

			local duration = math.max(previewState.duration or 0, PRESET_PREVIEW_SAMPLE_TIME + 0.01)
			previewState.resumeTime = (previewState.resumeTime or PRESET_PREVIEW_SAMPLE_TIME) + deltaTime
			if previewState.resumeTime &gt; duration then
				previewState.resumeTime = 0
			end

			local pose = PresetPreviewSupport.samplePreviewPose(previewState.previewData, previewState.resumeTime)
			PresetPreviewSupport.applyPreviewPoseAboveFloor(previewState.rigData, pose, 0.1)
		end)
		return
	end

	if previewState.connection then
		previewState.connection:Disconnect()
		previewState.connection = nil
	end
end

function WidgetController:_populatePresetPreview(viewport, fallbackThumb, entry, options)
	if not viewport or not entry then
		return
	end
	options = options or {}

	PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "loading")
	local previewToken = tostring(os.clock()) .. ":" .. tostring(entry.id or "")
	viewport:SetAttribute("PreviewToken", previewToken)

	for _, child in ipairs(viewport:GetChildren()) do
		child:Destroy()
	end

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport
	PresetPreviewSupport.setPreviewViewportCamera(viewport)

	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Anchored = true
	floor.CanCollide = false
	floor.CastShadow = false
	floor.Material = Enum.Material.SmoothPlastic
	floor.Color = Color3.fromRGB(57, 61, 72)
	floor.Size = Vector3.new(9, 0.2, 9)
	floor.CFrame = CFrame.new(0, 0, 0)
	floor.Parent = worldModel

	task.spawn(function()
		if not entry.id or not viewport.Parent then
			PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "fallback")
			return
		end

		local clip = PresetPreviewSupport.loadEntryPreviewAnimationClip(entry)
		if not clip then
			PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "fallback")
			return
		end
		if not clip:IsA("KeyframeSequence") then
			PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "fallback")
			return
		end

		local rigTypeName = PresetPreviewSupport.getRigTypeNameForPreview(entry, clip)
		local rigSuccess, rig, animator = pcall(function()
			local previewRig, previewAnimator = PresetPreviewSupport.createPresetPreviewRig(rigTypeName)
			return previewRig, previewAnimator
		end)
		if not rigSuccess or not rig then
			PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "fallback")
			return
		end
		rig.Parent = worldModel
		local rigData = PresetPreviewSupport.describePreviewRigMotors(rig)

		local previewData = PresetPreviewSupport.buildPreviewPoseDataFromKeyframeSequence(clip, rigData)
		if not previewData then
			PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "fallback")
			return
		end
		local samplePose = PresetPreviewSupport.samplePreviewPose(previewData, PRESET_PREVIEW_SAMPLE_TIME)
		PresetPreviewSupport.applyPreviewPose(rigData, samplePose)
		PresetPreviewSupport.alignPreviewRigToFloor(rig, 0.1)
		PresetPreviewSupport.rebasePreviewRootFromPose(rigData, samplePose)

		if viewport:GetAttribute("PreviewToken") ~= previewToken then
			return
		end

		PresetPreviewSupport.setPreviewLoadingState(viewport, fallbackThumb, options.loadingOverlay, "ready")
		self._presetPreviewStates[viewport] = {
			ready = true,
			previewData = previewData,
			rigData = rigData,
			duration = previewData.duration,
			resumeTime = PRESET_PREVIEW_SAMPLE_TIME,
		}
		if options.autoPlay then
			self:_setPresetPreviewPlaying(viewport, true)
		end
	end)
end

function WidgetController:_clearLaneOverlays()
	if self._marqueeBox then
		self._marqueeBox.Visible = false
	end
	for _, overlay in ipairs(self._laneOverlays) do
		overlay.Visible = false
	end
end

function WidgetController:_updateLaneOverlays()
	if not self._marqueeState then
		self:_clearLaneOverlays()
		return
	end

	local startPos = self._marqueeState.startPos
	local currentPos = self._marqueeState.currentPos
	local areaGui = self._timelineMarqueeOverlay or self._laneContainer or self._trackLaneArea
	if not areaGui then
		self:_clearLaneOverlays()
		return
	end

	local areaSize = areaGui.AbsoluteSize
	local minX
	local maxX
	local minY
	local maxY
	if self._marqueeState.startContentPos and self._marqueeState.currentContentPos and self._laneContainer then
		local canvas = self._laneContainer.CanvasPosition
		local startLocal = self._marqueeState.startContentPos - canvas
		local currentLocal = self._marqueeState.currentContentPos - canvas
		minX = math.clamp(math.min(startLocal.X, currentLocal.X), 0, areaSize.X)
		maxX = math.clamp(math.max(startLocal.X, currentLocal.X), 0, areaSize.X)
		minY = math.clamp(math.min(startLocal.Y, currentLocal.Y), 0, areaSize.Y)
		maxY = math.clamp(math.max(startLocal.Y, currentLocal.Y), 0, areaSize.Y)
	else
		local areaPosition = areaGui.AbsolutePosition
		minX = math.clamp(math.min(startPos.X, currentPos.X) - areaPosition.X, 0, areaSize.X)
		maxX = math.clamp(math.max(startPos.X, currentPos.X) - areaPosition.X, 0, areaSize.X)
		minY = math.clamp(math.min(startPos.Y, currentPos.Y) - areaPosition.Y, 0, areaSize.Y)
		maxY = math.clamp(math.max(startPos.Y, currentPos.Y) - areaPosition.Y, 0, areaSize.Y)
	end

	self._marqueeBox.Visible = true
	self._marqueeBox.Position = UDim2.fromOffset(minX, minY)
	self._marqueeBox.Size = UDim2.fromOffset(math.max(2, maxX - minX), math.max(2, maxY - minY))
end

function WidgetController:_timelineContentPointFromScreen(position)
	if not position or not self._laneContainer then
		return position
	end

	local canvasPosition = self._laneContainer.CanvasPosition
	local areaPosition = self._laneContainer.AbsolutePosition
	return Vector2.new(
		position.X - areaPosition.X + canvasPosition.X,
		position.Y - areaPosition.Y + canvasPosition.Y
	)
end

function WidgetController:_isPointInsideTimelineLanes(point)
	return point and self._laneContainer and isPointInsideGui(self._laneContainer, point)
end

function WidgetController:_isPointInsideTimelineMarqueeOverlay(point)
	return point and self._timelineMarqueeOverlay and isPointInsideGui(self._timelineMarqueeOverlay, point)
end

function WidgetController:_buildMarqueeKeyRectCache()
	local rects = {}
	if not self._laneContainer then
		return rects
	end

	local laneContainerPosition = self._laneContainer.AbsolutePosition
	local canvasPosition = self._laneContainer.CanvasPosition
	for _, markerData in ipairs(self._timelineMarkers or {}) do
		local lane = markerData.lane
		if lane and lane.Parent then
			local laneSize = lane.AbsoluteSize
			local centerX = markerData.x or 0
			local centerY = lane.AbsolutePosition.Y - laneContainerPosition.Y + canvasPosition.Y + (laneSize.Y / 2)
			local width = math.max(1, markerData.marqueeHitWidth or markerData.marqueeHitSize or 12)
			local height = math.max(1, markerData.marqueeHitHeight or markerData.marqueeHitSize or 12)
			rects[#rects + 1] = {
				x1 = centerX - (width / 2),
				x2 = centerX + (width / 2),
				y1 = centerY - (height / 2),
				y2 = centerY + (height / 2),
				keyId = markerData.keyId,
				jointPath = markerData.jointPath,
				frame = markerData.frame,
				selectKeys = markerData.selectKeys,
			}
		end
	end
	return rects
end

function WidgetController:_collectKeysInMarquee()
	if not self._marqueeState then
		return {}
	end

	local keys = {}
	local seen = {}
	local useContentRect = self._marqueeState.startContentPos and self._marqueeState.currentContentPos and self._laneContainer
	local startPos = useContentRect and self._marqueeState.startContentPos or self._marqueeState.startPos
	local currentPos = useContentRect and self._marqueeState.currentContentPos or self._marqueeState.currentPos
	local hitPadding = math.max(0, self._marqueeState.hitPadding or 0)
	local minX = math.min(startPos.X, currentPos.X) - hitPadding
	local maxX = math.max(startPos.X, currentPos.X) + hitPadding
	local minY = math.min(startPos.Y, currentPos.Y) - hitPadding
	local maxY = math.max(startPos.Y, currentPos.Y) + hitPadding

	local cachedRects = useContentRect and self._marqueeState.keyRects
	if cachedRects then
		for _, markerRect in ipairs(cachedRects) do
			if rectsOverlap(minX, minY, maxX, maxY, markerRect.x1, markerRect.y1, markerRect.x2, markerRect.y2) then
				if markerRect.selectKeys and #markerRect.selectKeys &gt; 0 then
					for _, keyRef in ipairs(markerRect.selectKeys) do
						local selectedKeyId = makeTrackKeyId(keyRef.jointPath, keyRef.frame)
						if not seen[selectedKeyId] then
							seen[selectedKeyId] = true
							table.insert(keys, {
								jointPath = keyRef.jointPath,
								frame = keyRef.frame,
							})
						end
					end
				elseif not seen[markerRect.keyId] then
					seen[markerRect.keyId] = true
					table.insert(keys, {
						jointPath = markerRect.jointPath,
						frame = markerRect.frame,
					})
				end
			end
		end
	else
		for _, markerData in ipairs(self._timelineMarkers) do
			local markerMinX, markerMinY, markerMaxX, markerMaxY = getTimelineMarkerRect(markerData)
			if markerMinX and rectsOverlap(minX, minY, maxX, maxY, markerMinX, markerMinY, markerMaxX, markerMaxY) then
				if markerData.selectKeys and #markerData.selectKeys &gt; 0 then
					for _, keyRef in ipairs(markerData.selectKeys) do
						local selectedKeyId = makeTrackKeyId(keyRef.jointPath, keyRef.frame)
						if not seen[selectedKeyId] then
							seen[selectedKeyId] = true
							table.insert(keys, {
								jointPath = keyRef.jointPath,
								frame = keyRef.frame,
							})
						end
					end
				elseif not seen[markerData.keyId] then
					seen[markerData.keyId] = true
					table.insert(keys, {
						jointPath = markerData.jointPath,
						frame = markerData.frame,
					})
				end
			end
		end
	end

	table.sort(keys, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return keys
end

function WidgetController:_refreshTimelineSelectionVisuals(selectedKeyMap)
	selectedKeyMap = selectedKeyMap or {}
	for _, markerData in ipairs(self._timelineMarkers or {}) do
		local isSelected = false
		if markerData.selectKeys and #markerData.selectKeys &gt; 0 then
			isSelected = true
			for _, keyRef in ipairs(markerData.selectKeys) do
				if not selectedKeyMap[makeTrackKeyId(keyRef.jointPath, keyRef.frame)] then
					isSelected = false
					break
				end
			end
		elseif markerData.keyId then
			isSelected = selectedKeyMap[markerData.keyId] == true
		end

		markerData.selected = isSelected
		if markerData.usesPooledImage then
			if markerData.selectionHalo then
				markerData.selectionHalo.Visible = false
			end
			if self._keyframeRenderer then
				self._keyframeRenderer:UpdateMarker(markerData)
			end
			continue
		end

		local halo = markerData.selectionHalo
		if isSelected then
			if not halo or not halo.Parent then
				halo = create("Frame", {
					Parent = markerData.lane,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Constants.THEME.Accent,
					BorderSizePixel = 0,
					ZIndex = 2,
				})
				halo.BackgroundTransparency = 0.45
				createCorner(halo, 6)
				create("UIStroke", {
					Parent = halo,
					Color = Constants.THEME.Text,
					Thickness = 1.5,
					Transparency = 0.1,
				})
				markerData.selectionHalo = halo
			end

			local baseWidth = markerData.hitWidth or markerData.hitSize or 14
			local baseHeight = markerData.hitHeight or markerData.hitSize or 14
			local width = markerData.hitWidth and math.max(20, baseWidth + 4) or math.max(18, baseWidth + 5)
			local height = markerData.hitHeight and math.max(18, baseHeight + 4) or math.max(18, baseHeight + 5)
			local yOffset = markerData.basePosition and markerData.basePosition.Y.Offset
				or (markerData.lane and math.floor(markerData.lane.AbsoluteSize.Y / 2))
				or 0
			halo.Position = UDim2.fromOffset(markerData.x or 0, yOffset)
			halo.Size = UDim2.new(0, width, 0, height)
			halo.Rotation = width &lt;= 36 and 45 or 0
			halo.Visible = true
			if markerData.button then
				markerData.button.ZIndex = 4
			end
		else
			if halo then
				halo.Visible = false
			end
			if markerData.button then
				markerData.button.ZIndex = 3
			end
		end
	end
end

function WidgetController:_findTimelineMarkerAtPoint(point)
	if not point or not self._timelineMarkers then
		return nil
	end

	for markerIndex = #self._timelineMarkers, 1, -1 do
		local markerData = self._timelineMarkers[markerIndex]
		local minX, minY, maxX, maxY = getTimelineMarkerRect(markerData)
		if minX and point.X &gt;= minX and point.X &lt;= maxX and point.Y &gt;= minY and point.Y &lt;= maxY then
			return markerData
		end
	end

	return nil
end

function WidgetController:_toggleTimelineMarkerAtPoint(point, sourceLabel)
	if not point or self._keyframeDragSession or self._timelineSession or self._marqueeSession then
		return false
	end
	if self:_isPointInsideTimelineMarqueeOverlay(point) ~= true then
		return false
	end

	local markerData = self:_findTimelineMarkerAtPoint(point)
	if not markerData then
		return false
	end

	return self:_toggleKeyframeSelection(markerData, sourceLabel or "Right-click")
end

function WidgetController:_resetDragPreview()
	local markers = self._dragPreviewMarkers or self._timelineMarkers
	for _, markerData in ipairs(markers) do
		if markerData.basePosition then
			markerData.button.Position = markerData.basePosition
			if markerData.hitbox then
				markerData.hitbox.Position = markerData.basePosition
			end
			if markerData.usesPooledImage then
				if self._keyframeRenderer then
					self._keyframeRenderer:UpdateMarker(markerData)
				end
			else
				markerData.button.BackgroundTransparency = markerData.baseTransparency or 0.05
			end
		end
	end
	self._dragPreviewMarkers = nil
end

function WidgetController:_updateDragPreview()
	if not self._dragState or not self._dragState.previewFrame then
		self:_resetDragPreview()
		self:_hideKeyframeDragRulerHighlight()
		return
	end

	local durationFrames = math.max(1, self._dragState.durationFrames or 1)
	local offset = self._dragState.previewFrame - self._dragState.sourceFrame
	local groupKeys = self._dragState.groupKeys
	local metrics = self:_getTimelineMetrics(durationFrames)
	local previewMarkers = self._dragPreviewMarkers

	if not previewMarkers then
		previewMarkers = {}
		for _, markerData in ipairs(self._timelineMarkers) do
			if markerData.keyId == self._dragState.sourceKeyId
				or (groupKeys and groupKeys[markerData.keyId]) then
				table.insert(previewMarkers, markerData)
			end
		end
		self._dragPreviewMarkers = previewMarkers
	end

	for _, markerData in ipairs(previewMarkers) do
		local targetFrame = markerData.frame
		local isDragged = markerData.keyId == self._dragState.sourceKeyId
		if groupKeys and groupKeys[markerData.keyId] then
			targetFrame = markerData.frame + offset
			isDragged = true
		elseif markerData.keyId == self._dragState.sourceKeyId then
			targetFrame = markerData.frame + offset
		end

		local x = TIMELINE_PADDING_X + (math.clamp(targetFrame or 0, 0, metrics.durationFrames) * metrics.pixelsPerFrame)
		markerData.button.Position = UDim2.fromOffset(x, markerData.basePosition.Y.Offset)
		if markerData.hitbox then
			markerData.hitbox.Position = UDim2.fromOffset(x, markerData.basePosition.Y.Offset)
		end
		if markerData.usesPooledImage then
			markerData.imageTransparency = isDragged and 0 or nil
			if self._keyframeRenderer then
				self._keyframeRenderer:UpdateMarker(markerData)
			end
		else
			markerData.button.BackgroundTransparency = isDragged and 0 or (markerData.baseTransparency or 0.05)
		end
	end
end

function WidgetController:_setTimelineScrollerEnabled(isEnabled)
	if self._laneContainer then
		self._laneContainer.ScrollingEnabled = isEnabled
	end
end

function WidgetController:_scrollTimelineVerticalByWheel(wheelDelta)
	if not self._laneContainer or wheelDelta == 0 then
		return
	end

	local windowHeight = math.max(1, self._laneContainer.AbsoluteWindowSize.Y)
	local contentHeight = math.max(windowHeight, self._laneContainer.AbsoluteCanvasSize.Y)
	local maxScrollY = math.max(0, contentHeight - windowHeight)
	if maxScrollY &lt;= 0 then
		return
	end

	local current = self._laneContainer.CanvasPosition
	local nextY = math.clamp(current.Y - (wheelDelta * 48), 0, maxScrollY)
	if math.abs(nextY - current.Y) &lt;= 0.01 then
		return
	end

	self._laneContainer.CanvasPosition = Vector2.new(current.X, nextY)
	self:_positionStickyTrackRows(nextY)
end

function WidgetController:_attachTimelineTrackWheelScroll(guiObject)
	if not guiObject then
		return
	end

	self:_connect(guiObject.InputChanged, function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end
		if self._marqueeSession or self._keyframeDragSession or self._timelineSession or self._trackReorderSession then
			return
		end

		self:_scrollTimelineVerticalByWheel(inputObject.Position.Z)
	end)
	self:_connect(guiObject.MouseEnter, function()
		self._isMouseOverTimelineTrackList = true
	end)
	self:_connect(guiObject.MouseLeave, function()
		if not self:_isPointerInsideTimelineTrackList() then
			self._isMouseOverTimelineTrackList = false
		end
	end)
end

function WidgetController:_isPointerInsideTimelineTrackList()
	if not self._trackColumnList then
		return false
	end

	local mouseLocation = UserInputService:GetMouseLocation()
	if mouseLocation and isPointInsideGui(self._trackColumnList, mouseLocation) then
		return true
	end

	local pluginMouse = nil
	pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end)
	if pluginMouse and type(pluginMouse.X) == "number" and type(pluginMouse.Y) == "number" then
		return isPointInsideGui(self._trackColumnList, Vector2.new(pluginMouse.X, pluginMouse.Y))
	end

	return false
end

function WidgetController:_setMotionSegmentsScrollerEnabled(isEnabled)
	if self._motionSegmentsList then
		self._motionSegmentsList.ScrollingEnabled = isEnabled
	end
end

function WidgetController:_attachNestedMotionStripScroll(strip)
	if not strip then
		return
	end

	local parentScroller = self._motionSegmentsList
	if not parentScroller then
		return
	end

	local function restoreParentScroll()
		if self._activeMotionOptionStrip == strip then
			self._activeMotionOptionStrip = nil
		end
		if self._activeMotionOptionStrip == nil then
			self:_setMotionSegmentsScrollerEnabled(true)
		end
	end

	self:_connect(strip.MouseEnter, function()
		self._activeMotionOptionStrip = strip
		self:_setMotionSegmentsScrollerEnabled(false)
	end)

	self:_connect(strip.MouseLeave, function()
		restoreParentScroll()
	end)

	self:_connect(strip.AncestryChanged, function(_, newParent)
		if not newParent then
			restoreParentScroll()
		end
	end)

	self:_connect(strip.InputChanged, function(inputObject)
		if self._activeMotionOptionStrip ~= strip then
			return
		end
		if inputObject.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end

		local wheelDelta = inputObject.Position.Z
		if wheelDelta == 0 then
			return
		end

		local current = strip.CanvasPosition
		local maxScrollX = math.max(0, strip.AbsoluteCanvasSize.X - strip.AbsoluteWindowSize.X)
		if maxScrollX &lt;= 0 then
			return
		end

		local step = 48
		local nextX = math.clamp(current.X - (wheelDelta * step), 0, maxScrollX)
		strip.CanvasPosition = Vector2.new(nextX, current.Y)
	end)
end

function WidgetController:_consumeTrackDoubleClick(path)
	local now = os.clock()
	local isDoubleClick = self._lastTrackClickPath == path
		and (now - (self._lastTrackClickTime or 0)) &lt;= TRACK_DOUBLE_CLICK_SECONDS

	self._lastTrackClickPath = path
	self._lastTrackClickTime = now

	if isDoubleClick then
		self._lastTrackClickPath = nil
		self._lastTrackClickTime = 0
		return true
	end

	return false
end

function WidgetController:_rememberTimelineCanvasForNextRefresh()
	local laneCanvasPosition = self._laneContainer and self._laneContainer.CanvasPosition or Vector2.new()
	self._pendingTimelineCanvasRestore = {
		laneCanvasPosition = laneCanvasPosition,
		trackCanvasY = laneCanvasPosition.Y,
		expiresAt = os.clock() + 1,
	}
end

function WidgetController:_restoreTimelineCanvasPosition(laneCanvasPosition, trackCanvasY)
	if self._suppressTimelineCanvasRestoreUntil and os.clock() &lt; self._suppressTimelineCanvasRestoreUntil then
		local restoreX = laneCanvasPosition and laneCanvasPosition.X or 0
		local restoreY = trackCanvasY or (laneCanvasPosition and laneCanvasPosition.Y) or 0
		if math.abs(restoreX) &gt; 1 or math.abs(restoreY) &gt; 1 then
			return
		end
	end

	if self._trackColumnList then
		self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
	end
	if self._laneContainer then
		local laneX = laneCanvasPosition and laneCanvasPosition.X or self._laneContainer.CanvasPosition.X
		self._laneContainer.CanvasPosition = Vector2.new(laneX, trackCanvasY or 0)
		self:_positionStickyTrackRows(trackCanvasY or 0)
	end
end

function WidgetController:_positionStickyTrackRows(scrollY)
	scrollY = tonumber(scrollY) or (self._laneContainer and self._laneContainer.CanvasPosition.Y) or 0
	for _, row in ipairs(self._trackStickyRows or {}) do
		if row.gui and row.gui.Parent then
			row.gui.Position = UDim2.fromOffset(0, math.floor((row.y or 0) - scrollY + 0.5))
		end
	end
	if self._trackReorderIndicator and self._trackReorderIndicator.Visible and self._trackReorderDropTarget then
		self._trackReorderIndicator.Position = UDim2.fromOffset(4, math.floor((self._trackReorderDropTarget.contentY or 0) - scrollY + 0.5))
	end
end

function WidgetController:_setTimelineMiddlePanBlocker(enabled)
	if enabled then
		if self._timelineMiddlePanBlocker and self._timelineMiddlePanBlocker.Parent then
			self._timelineMiddlePanBlocker.Visible = true
			return
		end
		if not self._root then
			return
		end
		local blocker = create("TextButton", {
			Parent = self._root,
			Active = true,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Name = "TimelineMiddlePanCameraBlocker",
			Size = UDim2.fromScale(1, 1),
			Text = "",
			Visible = true,
			ZIndex = 100000,
		})
		blocker.InputBegan:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1
				or inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
				self:_endTimelineMiddlePan("blockerClick")
			end
		end)
		blocker.InputChanged:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
				self:_clearStaleTimelineMiddlePan("blockerMouseMove")
			end
		end)
		blocker.InputEnded:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
				self:_endTimelineMiddlePan("blockerInputEnded")
			end
		end)
		pcall(function()
			blocker.Modal = true
		end)
		self._timelineMiddlePanBlocker = blocker
		return
	end
	if self._timelineMiddlePanBlocker then
		self._timelineMiddlePanBlocker.Visible = false
	end
end

function WidgetController:_refreshTrackSelectionVisuals(viewModel)
	viewModel = viewModel or self._lastViewModel
	if not viewModel or not self._trackWidgets then
		return
	end

	local selectedTrackMap = {}
	for _, path in ipairs(viewModel.selectedTrackPaths or {}) do
		selectedTrackMap[path] = true
	end
	local hasSelectedTracks = #(viewModel.selectedTrackPaths or {}) &gt; 0
	local selectedJointPath = viewModel.selectedJointPath

	for path, widgets in pairs(self._trackWidgets) do
		local trackLabel = widgets and widgets.trackLabel
		if trackLabel and trackLabel.Parent then
			local isSelected = selectedTrackMap[path] == true or ((not hasSelectedTracks) and path == selectedJointPath)
			local colors = WidgetVisualSupport.getTrackRowColors(
				widgets.trackData,
				isSelected,
				widgets.isTrackDisabled == true,
				widgets.folderAccentColor
			)
			trackLabel.BackgroundColor3 = colors.trackCard
			local stroke = trackLabel:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = isSelected and Constants.THEME.Accent or Constants.THEME.Border
				stroke.Thickness = isSelected and 1.5 or 1
			end
			if widgets.lane and widgets.lane.Parent then
				widgets.lane.BackgroundColor3 = colors.lane
			end
			if widgets.baseline and widgets.baseline.Parent then
				widgets.baseline.BackgroundColor3 = colors.baseline
			end
			if widgets.trackColorDot and widgets.trackColorDot.Parent then
				widgets.trackColorDot.BackgroundColor3 = colors.baseline
			end
			if widgets.trackTypeIcon and widgets.trackTypeIcon.Parent then
				widgets.trackTypeIcon.ImageColor3 = colors.baseline
				widgets.trackTypeIcon.ImageTransparency = widgets.isTrackDisabled == true and 0.45 or 0
			end
		end
	end
end

function WidgetController:_scheduleTimelineHorizontalRefresh()
	if not self._lastViewModel then
		return
	end
	if not self._timelineRulerLiveRefreshQueued then
		self._timelineRulerLiveRefreshQueued = true
		task.defer(function()
			self._timelineRulerLiveRefreshQueued = false
			if self._lastViewModel then
				self:_renderTimelineRuler(self._lastViewModel)
				self:_positionPlayhead(self._lastViewModel)
			end
		end)
	end
	if self._timelineSession and self._timelineSession.suppressRulerRefresh then
		self._pendingTimelineHorizontalRefreshAfterInteraction = true
		return
	end
	if self._keyframeDragSession or self._marqueeSession then
		self._pendingTimelineHorizontalRefreshAfterInteraction = true
		return
	end

	self._timelineHorizontalRefreshToken = (self._timelineHorizontalRefreshToken or 0) + 1
	local token = self._timelineHorizontalRefreshToken
	task.delay(0.08, function()
		if token ~= self._timelineHorizontalRefreshToken or not self._lastViewModel then
			return
		end

		local canvasX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
		self:_refreshTimelineLaneGrids(self._lastViewModel, true)
		local keyframeCount = tonumber(self._lastViewModel.keyframeCount) or 0
		local cullBucket = math.floor(canvasX / 160)
		if keyframeCount &gt; TIMELINE_RENDER_ALL_KEY_LIMIT and cullBucket ~= self._lastTimelineCullBucket then
			self._lastTimelineCullBucket = cullBucket
			self:invalidateTimelineRenderCache()
			self:update(self._lastViewModel)
		end
	end)
end

function WidgetController:_getKeyframeDragGroup(markerData)
	if markerData.groupKeys then
		local selectedCount = markerData.selectKeys and #markerData.selectKeys or 0
		local minFrame = markerData.dragMinFrame or markerData.frame
		local maxFrame = markerData.dragMaxFrame or markerData.frame
		if not markerData.dragMinFrame or not markerData.dragMaxFrame then
			for _, otherMarker in ipairs(self._timelineMarkers or {}) do
				if markerData.groupKeys[otherMarker.keyId] then
					minFrame = math.min(minFrame, otherMarker.frame or minFrame)
					maxFrame = math.max(maxFrame, otherMarker.frame or maxFrame)
				end
			end
		end
		if selectedCount == 0 then
			for _ in pairs(markerData.groupKeys) do
				selectedCount += 1
			end
		end
		return markerData.groupKeys, minFrame, maxFrame, math.max(1, selectedCount), markerData.groupId
	end

	local groupKeys = nil
	local selectedCount = 0
	local minFrame = markerData.frame
	local maxFrame = markerData.frame

	if markerData.selected then
		groupKeys = {}
		for _, otherMarker in ipairs(self._timelineMarkers or {}) do
			if otherMarker.selected then
				groupKeys[otherMarker.keyId] = true
				selectedCount += 1
				minFrame = math.min(minFrame, otherMarker.frame or minFrame)
				maxFrame = math.max(maxFrame, otherMarker.frame or maxFrame)
			end
		end
	end

	if selectedCount &lt;= 1 then
		groupKeys = nil
		minFrame = markerData.frame
		maxFrame = markerData.frame
		selectedCount = 1
	end

	return groupKeys, minFrame, maxFrame, selectedCount, markerData.groupId
end

function WidgetController:_frameFromKeyframeDragSession(session, currentPos)
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or session.startScrollX or 0
	local pixelsPerFrame = math.max(0.001, session.pixelsPerFrame or 1)
	local rawOffset = ((currentPos.X - session.startPos.X) + (scrollX - (session.startScrollX or 0))) / pixelsPerFrame
	local offsetFrames
	if rawOffset &gt;= 0 then
		offsetFrames = math.floor(rawOffset + 0.5)
	else
		offsetFrames = math.ceil(rawOffset - 0.5)
	end

	local minOffset = -(session.minFrame or session.sourceFrame or 0)
	local maxOffset = (session.durationFrames or Constants.DEFAULT_DURATION_FRAMES) - (session.maxFrame or session.sourceFrame or 0)
	offsetFrames = math.clamp(offsetFrames, minOffset, maxOffset)
	return math.clamp((session.sourceFrame or 0) + offsetFrames, 0, session.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
end

function WidgetController:_updateKeyframeDragSession(currentPos)
	local session = self._keyframeDragSession
	if not session then
		return
	end

	currentPos = positionToVector2(currentPos)
	session.currentPos = currentPos

	local pixelDelta = currentPos - session.startPos
	if not session.started then
		if pixelDelta.Magnitude &lt; KEYFRAME_DRAG_THRESHOLD then
			return
		end

		session.started = true
		self._dragState = {
			jointPath = session.jointPath,
			sourceFrame = session.sourceFrame,
			sourceKeyId = session.sourceKeyId,
			previewFrame = self:_frameFromKeyframeDragSession(session, currentPos),
			durationFrames = session.durationFrames,
			groupKeys = session.groupKeys,
			groupId = session.groupId,
			rulerReferenceFrame = session.minFrame or session.sourceFrame,
		}
	end

	self:_autoScrollTimelineForPoint(currentPos, session.durationFrames)

	if self._dragState then
		self._dragState.previewFrame = self:_frameFromKeyframeDragSession(session, currentPos)
		self:_updateDragPreview()
		self:_updateKeyframeDragRulerHighlight()
		if session.lastHintFrame ~= self._dragState.previewFrame then
			session.lastHintFrame = self._dragState.previewFrame
			self:_setShortcutHint(string.format(
				"%s to frame %d",
				(session.movingCount or 1) &gt; 1 and ("Moving " .. tostring(session.movingCount) .. " keyframes") or "Moving keyframe",
				self._dragState.previewFrame
			))
		end
	end
end

function WidgetController:_finishKeyframeDrag(reason)
	local session = self._keyframeDragSession
	if not session then
		return
	end

	self._keyframeDragSession = nil

	if session.moveConnection then
		session.moveConnection:Disconnect()
	end
	if session.releaseConnection then
		session.releaseConnection:Disconnect()
	end
	if session.focusConnection then
		session.focusConnection:Disconnect()
	end
	if session.mouseUpConnection then
		session.mouseUpConnection:Disconnect()
	end
	if session.rootReleaseConnection then
		session.rootReleaseConnection:Disconnect()
	end
	if session.laneReleaseConnection then
		session.laneReleaseConnection:Disconnect()
	end
	if session.laneMouseUpConnection then
		session.laneMouseUpConnection:Disconnect()
	end
	if session.laneMouseMoveConnection then
		session.laneMouseMoveConnection:Disconnect()
	end
	if session.rootMoveConnection then
		session.rootMoveConnection:Disconnect()
	end
	if session.autoScrollConnection then
		session.autoScrollConnection:Disconnect()
	end
	for _, connection in ipairs(session.extraReleaseConnections or {}) do
		if connection then
			connection:Disconnect()
		end
	end

	self:_setTimelineScrollerEnabled(session.scrollerWasEnabled ~= false)

	local dragState = self._dragState
	self:_resetDragPreview()
	self._dragState = nil
	self:_hideKeyframeDragRulerHighlight()

	if reason ~= "release" then
		return
	end

	if session.started and dragState and dragState.previewFrame and dragState.previewFrame ~= dragState.sourceFrame then
		local laneCanvasPosition = self._laneContainer and self._laneContainer.CanvasPosition or Vector2.new()
		self._pendingTimelineCanvasRestore = {
			laneCanvasPosition = laneCanvasPosition,
			trackCanvasY = laneCanvasPosition.Y,
			expiresAt = os.clock() + 1,
		}
		self._callbacks.onMoveKeyToFrame(dragState.jointPath, dragState.sourceFrame, dragState.previewFrame)
	else
		if session.selectKeys and #session.selectKeys &gt; 0 then
			if session.additive and self._callbacks.onToggleKeySet then
				self._callbacks.onToggleKeySet(session.selectKeys, session.preservePlayhead)
			elseif self._callbacks.onSelectKeySet then
				self._callbacks.onSelectKeySet(session.selectKeys, session.preservePlayhead)
			end
		elseif session.additive then
			self._callbacks.onToggleKeySelection(session.jointPath, session.sourceFrame)
		else
			self._callbacks.onSelectKey(session.jointPath, session.sourceFrame)
		end
	end
	self:_enterTimelineKeyboardFocus("Keyframe selected: Delete removes selected timeline keyframes")

	task.defer(function()
		if self._widget.Enabled then
			self:_focusShortcutCapture("Shortcuts ready: Delete removes selected keyframes")
		end
		if self._pendingTimelineHorizontalRefreshAfterInteraction then
			self._pendingTimelineHorizontalRefreshAfterInteraction = false
			self:_scheduleTimelineHorizontalRefresh()
		end
	end)
end

function WidgetController:_toggleKeyframeSelection(markerData, sourceLabel)
	if not markerData or not self._callbacks then
		return false
	end

	local toggleId = markerData.keyId or makeTrackKeyId(markerData.jointPath, markerData.frame)
	local now = os.clock()
	local lastToggle = self._lastAdditiveKeyToggle
	if lastToggle and lastToggle.keyId == toggleId and now - lastToggle.time &lt; 0.12 then
		return true
	end

	self._lastAdditiveKeyToggle = {
		keyId = toggleId,
		time = now,
	}
	self:_enterTimelineKeyboardFocus("Keyframe selected: Delete removes selected timeline keyframes")

	self:_clearTimelineSession("cancel")
	if markerData.selectKeys and #markerData.selectKeys &gt; 0 and self._callbacks.onToggleKeySet then
		self._callbacks.onToggleKeySet(markerData.selectKeys, markerData.preservePlayhead)
	elseif self._callbacks.onToggleKeySelection then
		self._callbacks.onToggleKeySelection(markerData.jointPath, markerData.frame)
	else
		return false
	end

	self:_setShortcutHint((sourceLabel or "Selection") .. ": keyframe toggled")
	self:_focusShortcutCapture("Shortcuts ready: Delete removes selected keyframes")
	return true
end

function WidgetController:_connectKeyframeRightClick(markerData)
	local hitbox = markerData and markerData.hitbox
	if not hitbox then
		return
	end

	local mouseButton2Down = nil
	pcall(function()
		mouseButton2Down = hitbox.MouseButton2Down
	end)
	if mouseButton2Down then
		self:_connect(mouseButton2Down, function()
			self:_toggleKeyframeSelection(markerData, "Right-click")
		end)
	end

	self:_connect(hitbox.InputBegan, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
			self:_toggleKeyframeSelection(markerData, "Right-click")
		end
	end)
end

function WidgetController:_createTimelineKeyframeMarker(options)
	options = options or {}
	local centerY = math.floor((options.trackRowHeight or 32) / 2)
	local markerData = {
		frame = options.keyframe,
		jointPath = options.trackPath,
		keyId = options.keyId,
		lane = options.lane,
		laneHitbox = options.laneHitbox,
		x = options.markerX,
		hitSize = 16,
		baseTransparency = 0.05,
		selected = options.isSelectedKey,
		durationFrames = options.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
		marqueeHitSize = 12,
		markerColor = options.markerColor,
		easingStyle = options.easingStyle,
		easingDirection = options.easingDirection,
		easingHighlightColor = EasingVisualSupport.getHighlightColor(options.easingStyle),
		easingTooltip = EasingVisualSupport.getTooltip(options.easingStyle, options.easingDirection),
	}

	if self._keyframeRenderer then
		markerData.hitSize = 18
		markerData.basePosition = UDim2.fromOffset(options.markerX or 0, (options.trackRowY or 0) + centerY)
		self._keyframeRenderer:Acquire(markerData, {
			color = options.markerColor,
			easingStyle = options.easingStyle,
			easingDirection = options.easingDirection,
			zIndex = 7,
			zIndexSelected = 9,
		})
		markerData.beginKeyframeInteraction = function(startPos)
			return self:_beginKeyframeDrag(markerData, startPos)
		end
		return markerData
	end

	local marker = create("TextButton", {
		Parent = options.lane,
		AutoButtonColor = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(options.markerX or 0, centerY),
		Size = UDim2.new(0, 10, 0, 10),
		BackgroundColor3 = options.markerColor,
		BorderSizePixel = 0,
		Rotation = 45,
		Text = "",
		ZIndex = 3,
	})
	marker.BackgroundTransparency = 0.05
	local markerStrokeColor = markerData.easingHighlightColor
		or (options.isGroupedKey and Color3.fromRGB(242, 178, 81))
		or (options.isCurrentMarker and Constants.THEME.Accent)
		or Color3.fromRGB(16, 20, 30)
	create("UIStroke", {
		Parent = marker,
		Color = markerStrokeColor,
		Thickness = 1,
		Transparency = 0.12,
	})

	local markerHitbox = create("TextButton", {
		Parent = options.lane,
		Active = true,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Accent,
		BackgroundTransparency = 0.99,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(options.markerX or 0, centerY),
		Size = UDim2.new(0, 26, 0, 26),
		Text = "",
		TextTransparency = 1,
		ZIndex = 4,
	})

	markerData.button = marker
	markerData.hitbox = markerHitbox
	markerData.basePosition = UDim2.fromOffset(options.markerX or 0, centerY)
	self:_connectKeyframeRightClick(markerData)
	markerData.beginKeyframeInteraction = function(startPos)
		return self:_beginKeyframeDrag(markerData, startPos)
	end

	local function beginKeyframeInteractionFromInput(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		self:_beginKeyframeDrag(markerData, positionToVector2(inputObject.Position))
	end
	local function beginKeyframeInteractionFromButton(x, y)
		self:_beginKeyframeDrag(markerData, Vector2.new(x, y))
	end
	self:_connect(marker.InputBegan, beginKeyframeInteractionFromInput)
	self:_connect(markerHitbox.InputBegan, beginKeyframeInteractionFromInput)
	self:_connect(marker.MouseButton1Down, beginKeyframeInteractionFromButton)
	self:_connect(markerHitbox.MouseButton1Down, beginKeyframeInteractionFromButton)
	self:_connect(markerHitbox.MouseEnter, function(x, y)
		local mouseX = tonumber(x)
		local mouseY = tonumber(y)
		self:_showTrackNameTooltip(markerHitbox, "Keyframe easing", markerData.easingTooltip, (mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil)
	end)
	self:_connect(markerHitbox.MouseMoved, function(x, y)
		local mouseX = tonumber(x)
		local mouseY = tonumber(y)
		self:_showTrackNameTooltip(markerHitbox, "Keyframe easing", markerData.easingTooltip, (mouseX and mouseY) and Vector2.new(mouseX, mouseY) or nil)
	end)
	self:_connect(markerHitbox.MouseLeave, function()
		self:_hideTrackNameTooltip()
	end)

	return markerData
end

function WidgetController:_selectTimelineMarkerData(markerData)
	if not markerData or not self._callbacks then
		return
	end
	if markerData.selectKeys and #markerData.selectKeys &gt; 0 and self._callbacks.onSelectKeySet then
		self._callbacks.onSelectKeySet(markerData.selectKeys, markerData.preservePlayhead)
	elseif self._callbacks.onSelectKey then
		self._callbacks.onSelectKey(markerData.jointPath, markerData.frame)
	end
end

function WidgetController:_consumeFaceKeyframeDoubleClick(markerData)
	if not markerData then
		return false
	end
	local track = self:_findTrackInViewModel(markerData.jointPath)
	if not self:_isFaceKeyframeTrack(track) then
		self._lastFaceKeyframeClickId = nil
		self._lastFaceKeyframeClickTime = 0
		return false
	end

	local keyId = markerData.keyId or makeTrackKeyId(markerData.jointPath, markerData.frame)
	local now = os.clock()
	local isDoubleClick = self._lastFaceKeyframeClickId == keyId
		and (now - (self._lastFaceKeyframeClickTime or 0)) &lt;= TRACK_DOUBLE_CLICK_SECONDS
	self._lastFaceKeyframeClickId = keyId
	self._lastFaceKeyframeClickTime = now
	if isDoubleClick then
		self._lastFaceKeyframeClickId = nil
		self._lastFaceKeyframeClickTime = 0
	end
	return isDoubleClick
end

function WidgetController:_beginKeyframeDrag(markerData, startPos)
	if not markerData or not self._callbacks or not markerData.lane or not markerData.lane.Parent then
		return false
	end

	if self._keyframeDragSession then
		return true
	end

	self:_clearTimelineSession("cancel")
	local additive = self:_isAdditiveSelectionActive()
	if not additive then
		self:_activateShortcutContext("Shortcuts ready: Delete removes selected keyframes")
	end

	if additive then
		return self:_toggleKeyframeSelection(markerData, "Shift selection")
	end

	if self:_consumeFaceKeyframeDoubleClick(markerData) then
		self:_selectTimelineMarkerData(markerData)
		self:_enterTimelineKeyboardFocus("Faces panel open for selected face keyframe")
		task.defer(function()
			local _, message = self:_openSelectedOptionsPopup()
			self:_setShortcutHint(message or "Faces panel open")
		end)
		return true
	end

	local durationFrames = markerData.durationFrames
		or (self._lastViewModel and self._lastViewModel.durationFrames)
		or Constants.DEFAULT_DURATION_FRAMES
	local metrics = self:_getTimelineMetrics(durationFrames)
	local groupKeys, minFrame, maxFrame, movingCount, groupId = self:_getKeyframeDragGroup(markerData)
	if not additive and not markerData.selected then
		self:_selectTimelineMarkerData(markerData)
	end
	self:_enterTimelineKeyboardFocus("Keyframe selected: Delete removes selected timeline keyframes")
	local scrollerWasEnabled = true
	if self._laneContainer then
		scrollerWasEnabled = self._laneContainer.ScrollingEnabled
	end

	local session = {
		additive = additive,
		currentPos = startPos,
		durationFrames = durationFrames,
		groupKeys = groupKeys,
		groupId = groupId,
		jointPath = markerData.jointPath,
		maxFrame = maxFrame,
		minFrame = minFrame,
		movingCount = movingCount,
		pixelsPerFrame = metrics.pixelsPerFrame,
		scrollerWasEnabled = scrollerWasEnabled,
		selectKeys = markerData.selectKeys,
		preservePlayhead = markerData.preservePlayhead,
		sourceFrame = markerData.frame,
		sourceKeyId = markerData.keyId,
		startPos = startPos,
		startScrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0,
		started = false,
		startTime = os.clock(),
		extraReleaseConnections = {},
	}
	self._keyframeDragSession = session
	self:_setTimelineScrollerEnabled(false)
	self:_setShortcutHint("Keyframe selected: drag to move, release to commit")

	local function connectExtraRelease(guiObject)
		if not guiObject then
			return
		end
		if guiObject.MouseButton1Up then
			table.insert(session.extraReleaseConnections, guiObject.MouseButton1Up:Connect(function()
				self:_finishKeyframeDrag("release")
			end))
		end
		table.insert(session.extraReleaseConnections, guiObject.InputEnded:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
				self:_finishKeyframeDrag("release")
			end
		end))
	end

	connectExtraRelease(markerData.button)
	connectExtraRelease(markerData.hitbox)
	connectExtraRelease(self._timelineMarqueeOverlay)

	session.moveConnection = UserInputService.InputChanged:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			self:_updateKeyframeDragSession(inputObject.Position)
		end
	end)

	session.rootMoveConnection = self._root.InputChanged:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			self:_updateKeyframeDragSession(inputObject.Position)
		end
	end)

	session.releaseConnection = UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_finishKeyframeDrag("release")
		end
	end)

	session.rootReleaseConnection = self._root.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_finishKeyframeDrag("release")
		end
	end)

	if markerData.laneHitbox then
		session.laneMouseMoveConnection = markerData.laneHitbox.MouseMoved:Connect(function(x, y)
			self:_updateKeyframeDragSession(Vector2.new(x, y))
		end)

		session.laneReleaseConnection = markerData.laneHitbox.InputEnded:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
				self:_finishKeyframeDrag("release")
			end
		end)

		if markerData.laneHitbox.MouseButton1Up then
			session.laneMouseUpConnection = markerData.laneHitbox.MouseButton1Up:Connect(function()
				self:_finishKeyframeDrag("release")
			end)
		end
	end

	session.focusConnection = UserInputService.WindowFocusReleased:Connect(function()
		self:_finishKeyframeDrag("cancel")
	end)

	session.autoScrollConnection = RunService.RenderStepped:Connect(function()
		if self._keyframeDragSession ~= session or not session.started or not session.currentPos then
			return
		end

		local before = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
		self:_autoScrollTimelineForPoint(session.currentPos, session.durationFrames)
		local after = self._laneContainer and self._laneContainer.CanvasPosition.X or before
		if math.abs(after - before) &gt; 0.5 and self._dragState then
			self._dragState.previewFrame = self:_frameFromKeyframeDragSession(session, session.currentPos)
			self:_updateDragPreview()
			self:_updateKeyframeDragRulerHighlight()
		end
	end)

	local pluginMouse = nil
	local hasPluginMouse = pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end)
	if hasPluginMouse and pluginMouse and pluginMouse.Button1Up then
		session.mouseUpConnection = pluginMouse.Button1Up:Connect(function()
			self:_finishKeyframeDrag("release")
		end)
	end

	return true
end

function WidgetController:_clearTimelineSession(reason)
	local session = self._timelineSession
	if not session then
		return
	end

	self._timelineSession = nil

	if session.moveConnection then
		session.moveConnection:Disconnect()
		session.moveConnection = nil
	end

	if session.widgetMoveConnection then
		session.widgetMoveConnection:Disconnect()
		session.widgetMoveConnection = nil
	end

	if session.releaseConnection then
		session.releaseConnection:Disconnect()
		session.releaseConnection = nil
	end

	if session.widgetReleaseConnection then
		session.widgetReleaseConnection:Disconnect()
		session.widgetReleaseConnection = nil
	end

	if session.focusConnection then
		session.focusConnection:Disconnect()
		session.focusConnection = nil
	end

	if session.buttonUpConnection then
		session.buttonUpConnection:Disconnect()
		session.buttonUpConnection = nil
	end

	if session.buttonReleaseConnection then
		session.buttonReleaseConnection:Disconnect()
		session.buttonReleaseConnection = nil
	end

	if session.mouseUpConnection then
		session.mouseUpConnection:Disconnect()
		session.mouseUpConnection = nil
	end

	if session.tickConnection then
		session.tickConnection:Disconnect()
		session.tickConnection = nil
	end

	local currentPos = session.currentPos or session.startPos
	if session.started then
		if session.onEnd then
			session.onEnd(currentPos, session.startPos)
		end
	elseif reason == "release" and session.onTap then
		session.onTap(currentPos, session.startPos)
	end

	if reason == "release" and self._lastViewModel and math.floor(tonumber(self._lastViewModel.currentFrame) or 0) == 0 then
		self:_queueTimelineStartRefresh()
	end
	if self._pendingTimelineHorizontalRefreshAfterInteraction then
		self._pendingTimelineHorizontalRefreshAfterInteraction = false
		task.defer(function()
			self:_scheduleTimelineHorizontalRefresh()
		end)
	end
end

function WidgetController:_clearMarqueeSession(reason)
	local session = self._marqueeSession
	if not session then
		return
	end

	self._marqueeSession = nil

	for _, connection in ipairs(session.connections) do
		if connection then
			connection:Disconnect()
		end
	end

	local currentPos = session.currentPos or session.startPos
	if session.started then
		if reason == "release" and session.onEnd then
			session.onEnd(currentPos, session.startPos)
		elseif session.onCancel then
			session.onCancel(currentPos, session.startPos)
		end
	elseif reason == "release" and session.onTap then
		session.onTap(currentPos, session.startPos)
	elseif session.onCancel then
		session.onCancel(currentPos, session.startPos)
	end
	if self._pendingTimelineHorizontalRefreshAfterInteraction then
		self._pendingTimelineHorizontalRefreshAfterInteraction = false
		task.defer(function()
			self:_scheduleTimelineHorizontalRefresh()
		end)
	end
end

function WidgetController:_startMarqueeSession(spec)
	self:_clearMarqueeSession("cancel")
	self:_clearTimelineSession("cancel")

	local pluginMouse = nil
	pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end)

	local session = {
		connections = {},
		currentPos = spec.startPos,
		onCancel = spec.onCancel,
		onChange = spec.onChange,
		onEnd = spec.onEnd,
		onLiveHitTest = spec.onLiveHitTest,
		onStart = spec.onStart,
		onTap = spec.onTap,
		onTick = spec.onTick,
		pluginMouse = pluginMouse,
		startPos = spec.startPos,
		started = false,
		threshold = spec.threshold or 0,
		lastHitTestTime = 0,
	}
	session.latestInputPosition = session.startPos
	self._marqueeSession = session

	local function connect(signal, callback)
		if signal then
			table.insert(session.connections, signal:Connect(callback))
		end
	end

	local function normalizePointerPosition(position)
		local point = positionToVector2(position)
		if spec.normalizePoint then
			local ok, normalized = pcall(spec.normalizePoint, point)
			if ok and normalized then
				return normalized
			end
		end
		return point
	end

	local function storePointerPosition(position)
		if position then
			session.latestInputPosition = normalizePointerPosition(position)
		end
	end

	local function finish(reason)
		if self._marqueeSession ~= session then
			return
		end
		self:_clearMarqueeSession(reason)
	end

	local function readPluginMousePosition()
		if session.pluginMouse then
			local x = session.pluginMouse.X
			local y = session.pluginMouse.Y
			if type(x) == "number" and type(y) == "number" then
				return Vector2.new(x, y)
			end
		end
		return nil
	end

	local function readUserInputMousePosition()
		if session.latestInputPosition then
			return session.latestInputPosition
		end
		if spec.preferWidgetInput then
			return session.currentPos or session.startPos
		end
		local mouseLocation = UserInputService:GetMouseLocation()
		if mouseLocation then
			return Vector2.new(mouseLocation.X, mouseLocation.Y)
		end
		return nil
	end

	session.rawStartPlugin = readPluginMousePosition()
	session.rawStartFallback = session.latestInputPosition or readUserInputMousePosition()
	session.mouseSource = spec.preferWidgetInput and "fallback" or (session.rawStartPlugin and "plugin" or "fallback")
	session.pluginMouseOffset = session.rawStartPlugin and (session.startPos - session.rawStartPlugin) or Vector2.zero
	session.fallbackMouseOffset = session.rawStartFallback and (session.startPos - session.rawStartFallback) or Vector2.zero

	local function getMousePosition()
		local pluginPosition = readPluginMousePosition()
		local fallbackPosition = readUserInputMousePosition()
		if session.mouseSource == "plugin" and pluginPosition and fallbackPosition and session.rawStartPlugin and session.rawStartFallback then
			local pluginDelta = pluginPosition - session.rawStartPlugin
			local fallbackDelta = fallbackPosition - session.rawStartFallback
			if thresholdPassed(fallbackDelta, 1) and not thresholdPassed(pluginDelta, 1) then
				session.mouseSource = "fallback"
			end
		end

	if session.mouseSource == "plugin" and pluginPosition then
		return pluginPosition + (session.pluginMouseOffset or Vector2.zero)
	end
		if fallbackPosition then
			return fallbackPosition + (session.fallbackMouseOffset or Vector2.zero)
		end
		if pluginPosition then
			return pluginPosition + (session.pluginMouseOffset or Vector2.zero)
		end
		return session.currentPos or session.startPos
	end

	connect(UserInputService.InputEnded, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			finish("release")
		end
	end)
	connect(UserInputService.InputChanged, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			storePointerPosition(inputObject.Position)
		end
	end)
	if spec.button then
		connect(spec.button.MouseMoved, function(x, y)
			storePointerPosition(Vector2.new(x, y))
		end)
		if spec.button.MouseButton1Up then
			connect(spec.button.MouseButton1Up, function()
				finish("release")
			end)
		end
		connect(spec.button.InputEnded, function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
				finish("release")
			end
		end)
	end

	connect(UserInputService.WindowFocusReleased, function()
		finish("cancel")
	end)

	if pluginMouse and pluginMouse.Button1Up then
		connect(pluginMouse.Button1Up, function()
			finish("release")
		end)
	end

	connect(RunService.Heartbeat, function()
		if self._marqueeSession ~= session then
			return
		end

		local currentPos = getMousePosition()
		session.currentPos = currentPos
		local delta = currentPos - session.startPos

		if not session.started then
			if not thresholdPassed(delta, session.threshold) then
				return
			end
			session.started = true
			if session.onStart then
				session.onStart(currentPos, session.startPos, delta)
			end
		end

		if session.onChange then
			session.onChange(currentPos, session.startPos, delta)
		end
		if session.onTick then
			session.onTick(currentPos, session.startPos, delta)
		end
		if session.onLiveHitTest then
			local now = os.clock()
			if now - (session.lastHitTestTime or 0) &gt;= 0.05 then
				session.lastHitTestTime = now
				session.onLiveHitTest(self:_collectKeysInMarquee())
			end
		end
	end)
end

function WidgetController:_startTimelineMarqueeSelection(startPos)
	if not self._callbacks then
		return
	end

	local durationFrames = self._lastViewModel and self._lastViewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
	local additive = self:_isAdditiveSelectionActive()
	local function shouldClearSelectionForTimelineTap(point)
		return point ~= nil
	end
	self:_startMarqueeSession({
		button = self._timelineMarqueeOverlay,
		startPos = startPos,
		preferWidgetInput = true,
		normalizePoint = function(point)
			if not self._timelineMarqueeOverlay then
				return point
			end
			if isPointInsideGui(self._timelineMarqueeOverlay, point) then
				return point
			end
			local overlaySize = self._timelineMarqueeOverlay.AbsoluteSize
			if point.X &gt;= -overlaySize.X and point.X &lt;= overlaySize.X * 2
				and point.Y &gt;= -overlaySize.Y and point.Y &lt;= overlaySize.Y * 2 then
				return self._timelineMarqueeOverlay.AbsolutePosition + point
			end
			return point
		end,
		threshold = 4,
		onStart = function(currentPos)
				self._marqueeState = {
					startPos = startPos,
					currentPos = currentPos,
					startContentPos = self:_timelineContentPointFromScreen(startPos),
					currentContentPos = self:_timelineContentPointFromScreen(currentPos),
					additive = additive,
					allowHorizontalScroll = true,
					hitPadding = 0,
					keyRects = self:_buildMarqueeKeyRectCache(),
					lastCacheRefresh = os.clock(),
				}
			self:_updateLaneOverlays()
		end,
		onChange = function(currentPos)
			if self._marqueeState then
				self._marqueeState.currentPos = currentPos
				self._marqueeState.currentContentPos = self:_timelineContentPointFromScreen(currentPos)
				self:_updateLaneOverlays()
			end
		end,
		onTick = function(currentPos)
			if self._marqueeState and self:_autoScrollTimelineSelectionForPoint(currentPos, durationFrames) then
				local now = os.clock()
				if now - (self._marqueeState.lastCacheRefresh or 0) &gt;= 0.2 then
					self._marqueeState.keyRects = self:_buildMarqueeKeyRectCache()
					self._marqueeState.lastCacheRefresh = now
				end
				self._marqueeState.currentContentPos = self:_timelineContentPointFromScreen(currentPos)
				self:_updateLaneOverlays()
			end
		end,
		onLiveHitTest = function(keys)
			local count = #(keys or {})
			if count ~= self._lastMarqueePreviewCount then
				self._lastMarqueePreviewCount = count
				self:_setShortcutHint(string.format("Box selecting %d key%s", count, count == 1 and "" or "s"))
			end
		end,
		onEnd = function()
			local marqueeState = self._marqueeState
			local selectedKeys = self:_collectKeysInMarquee()
			self._marqueeState = nil
			self._lastMarqueePreviewCount = nil
			self:_clearLaneOverlays()
			if self._callbacks.onSelectKeysInBox then
				self._callbacks.onSelectKeysInBox(selectedKeys, marqueeState and marqueeState.additive)
			end
		end,
		onCancel = function()
			self._marqueeState = nil
			self._lastMarqueePreviewCount = nil
			self:_clearLaneOverlays()
		end,
		onTap = function(currentPos)
			self._lastMarqueePreviewCount = nil
			if not additive and shouldClearSelectionForTimelineTap(currentPos) and self._callbacks.onClearKeySelection then
				self._callbacks.onClearKeySelection()
			end
			if not additive and self._callbacks.onScrubToFrame then
				self._callbacks.onScrubToFrame(self:_positionToTimelineFrame(currentPos, durationFrames))
			end
		end,
	})
end

function WidgetController:_startTimelineSession(spec)
	self:_clearTimelineSession("cancel")

	local session = {
		startPos = spec.startPos,
		currentPos = spec.startPos,
		threshold = spec.threshold,
		onStart = spec.onStart,
		onChange = spec.onChange,
		onEnd = spec.onEnd,
		onTap = spec.onTap,
		onTick = spec.onTick,
		suppressRulerRefresh = spec.suppressRulerRefresh == true,
		allowGlobalMove = spec.allowGlobalMove == true,
		followMouse = spec.followMouse == true,
		started = false,
		cumulativeDelta = Vector2.zero,
	}

	self._timelineSession = session

	local function handleMove(position, delta)
		if self._timelineSession ~= session then
			return
		end

		local currentPos
		if delta then
			session.cumulativeDelta += delta
			currentPos = session.startPos + session.cumulativeDelta
		else
			currentPos = positionToVector2(position)
			session.cumulativeDelta = currentPos - session.startPos
		end

		if currentPos == session.currentPos and session.started then
			return
		end

		session.currentPos = currentPos
		local delta = currentPos - session.startPos

		if not session.started then
			if not thresholdPassed(delta, session.threshold) then
				return
			end

			session.started = true
			if session.onStart then
				session.onStart(currentPos, session.startPos, delta)
			end
		end

		if session.onChange then
			session.onChange(currentPos, session.startPos, delta)
		end
	end

	if spec.startImmediately then
		session.started = true
		if session.onStart then
			session.onStart(session.startPos, session.startPos, Vector2.zero)
		end
		if session.onChange then
			session.onChange(session.startPos, session.startPos, Vector2.zero)
		end
	end

	if session.allowGlobalMove then
		session.moveConnection = UserInputService.InputChanged:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
				handleMove(inputObject.Position)
			end
		end)
	else
		session.widgetMoveConnection = self._root.InputChanged:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
				handleMove(inputObject.Position, deltaToVector2(inputObject.Delta))
			end
		end)
	end

	session.releaseConnection = UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_clearTimelineSession("release")
		end
	end)

	session.widgetReleaseConnection = self._root.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_clearTimelineSession("release")
		end
	end)

	session.focusConnection = UserInputService.WindowFocusReleased:Connect(function()
		self:_clearTimelineSession("cancel")
	end)

	if spec.button and spec.button.MouseButton1Up then
		session.buttonUpConnection = spec.button.MouseButton1Up:Connect(function()
			self:_clearTimelineSession("release")
		end)
	end

	if spec.button then
		session.buttonReleaseConnection = spec.button.InputEnded:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
				self:_clearTimelineSession("release")
			end
		end)
	end

	local pluginMouse = nil
	local hasPluginMouse = pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end)
	if hasPluginMouse and pluginMouse and pluginMouse.Button1Up then
		session.mouseUpConnection = pluginMouse.Button1Up:Connect(function()
			self:_clearTimelineSession("release")
		end)
	end

	if session.onTick or session.followMouse then
		session.tickConnection = RunService.RenderStepped:Connect(function()
			if self._timelineSession ~= session or not session.currentPos then
				return
			end

			if session.followMouse then
				local mousePosition = UserInputService:GetMouseLocation()
				if mousePosition then
					handleMove(mousePosition)
				end
			end

			local mouseStillDown = true
			local pressedOk, pressed = pcall(function()
				return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			end)
			if pressedOk and not pressed then
				mouseStillDown = false
			end
			if not mouseStillDown then
				self:_clearTimelineSession("release")
				return
			end

			if session.onTick then
				session.onTick(session.currentPos, session.startPos, session.currentPos - session.startPos)
			end
		end)
	end
end

function WidgetController:_build()
	local root = create("Frame", {
		Name = "Root",
		Parent = self._widget,
		Active = true,
		BackgroundColor3 = Constants.THEME.Background,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	})
	self._root = root
	self:_connect(root:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_refreshLayoutVisibility()
	end)

	create("UIPadding", {
		Parent = root,
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	})

	local header = createCard(root, UDim2.new(1, 0, 0, 92), {
		textureKind = "shell",
	})
	header.Position = UDim2.new(0, 0, 0, 0)

	local hasBrandIcon = true
	local brandIcon
	do
		local logoOk, logoModule = pcall(require, script.Parent:WaitForChild("BrandLogo"))
		if logoOk and type(logoModule) == "table" and type(logoModule.create) == "function" then
			brandIcon = logoModule.create(header, {
				name = "BrandLogo",
				size = UDim2.new(0, 28, 0, 28),
				position = UDim2.new(0, 16, 0, 10),
				zIndex = 3,
			})
		end
		if not brandIcon then
			hasBrandIcon = type(Constants.BRAND_ICON) == "string" and Constants.BRAND_ICON ~= ""
			brandIcon = create("ImageLabel", {
				Parent = header,
				BackgroundTransparency = 1,
				Image = Constants.BRAND_ICON,
				Position = UDim2.new(0, 16, 0, 10),
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.new(0, 28, 0, 28),
				Visible = hasBrandIcon,
				ZIndex = 2,
			})
		end
	end

	local brand = create("TextLabel", {
		Parent = header,
		BackgroundTransparency = 1,
		Position = hasBrandIcon and UDim2.new(0, 52, 0, 12) or UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(0, 260, 0, 22),
		Font = Enum.Font.GothamBold,
		Text = Constants.BRAND_NAME or "7kg2 Animator",
		TextColor3 = Constants.THEME.Text,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local subBrand = create("TextLabel", {
		Parent = header,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 40),
		Size = UDim2.new(0, 360, 0, 18),
		Font = Enum.Font.Gotham,
		Text = "More Creating. Less Keyframing",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local headerUiRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("HeaderUI")
		local requireOk, headerModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: HeaderUI", headerModule)
		elseif type(headerModule.mount) ~= "function" then
			warn("[7kg2 Animator] UI module missing mount: HeaderUI")
		else
			local mountOk, mountedRefs = pcall(headerModule.mount, header, {
				plugin = self._plugin,
				root = root,
			})
			if not mountOk then
				warn("[7kg2 Animator] Failed to mount UI module: HeaderUI", mountedRefs)
			else
				headerUiRefs = mountedRefs or {}
				self._uiSections.HeaderUI = headerModule
			end
		end
	end

	applySectionRefs(self, headerUiRefs)

		local statusChip = create("TextLabel", {
			Parent = header,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 57),
			Size = UDim2.new(0, 180, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Text = "Build " .. BuildInfo.BUILD_ID,
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
		})
		createCorner(statusChip, 9)
		createStroke(statusChip)

		local buildTime = create("TextLabel", {
			Parent = header,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 44),
			Size = UDim2.new(0, 220, 0, 18),
			Font = Enum.Font.Gotham,
			Text = BuildInfo.BUILD_TIME,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
		})

	self._headerCard = header
	self._brandIcon = brandIcon
	self._brandLabel = brand
	self._subBrandLabel = subBrand
	self._statusChip = statusChip
	self._buildTimeLabel = buildTime

	local content = create("Frame", {
		Parent = root,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 104),
		Size = UDim2.new(1, 0, 1, -104),
	})

	local leftColumn = create("Frame", {
		Parent = content,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(0, 320, 1, 0),
	})

	local centerColumn = create("Frame", {
		Parent = content,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 332, 0, 0),
		Size = UDim2.new(1, -654, 1, 0),
	})

	local rightColumn = create("ScrollingFrame", {
		Parent = content,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 310, 1, 0),
		ScrollBarThickness = 6,
	})

	self._contentFrame = content
	self._leftColumn = leftColumn
	self._centerColumn = centerColumn
	self._rightColumn = rightColumn

	local rigExplorerUiRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("RigExplorerUI")
		local requireOk, rigExplorerModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: RigExplorerUI", rigExplorerModule)
		elseif type(rigExplorerModule.mount) ~= "function" then
			warn("[7kg2 Animator] UI module missing mount: RigExplorerUI")
		else
			local mountOk, mountedRefs = pcall(rigExplorerModule.mount, leftColumn, {})
			if not mountOk then
				warn("[7kg2 Animator] Failed to mount UI module: RigExplorerUI", mountedRefs)
			else
				rigExplorerUiRefs = mountedRefs or {}
				self._uiSections.RigExplorerUI = rigExplorerModule
			end
		end
	end

	applySectionRefs(self, rigExplorerUiRefs)

	local sessionSummaryUiRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("MainSessionSummaryUI")
		local requireOk, sessionSummaryModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: MainSessionSummaryUI", sessionSummaryModule)
		elseif type(sessionSummaryModule.mount) ~= "function" then
			warn("[7kg2 Animator] UI module missing mount: MainSessionSummaryUI")
		else
			local mountOk, mountedRefs = pcall(sessionSummaryModule.mount, leftColumn, {
				controller = self,
				root = root,
			})
			if not mountOk then
				warn("[7kg2 Animator] Failed to mount UI module: MainSessionSummaryUI", mountedRefs)
			else
				sessionSummaryUiRefs = mountedRefs or {}
				self._uiSections.SessionSummaryUI = sessionSummaryModule
			end
		end
	end

	applySectionRefs(self, sessionSummaryUiRefs)

	local viewportToolsUiRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("ViewportToolsUI")
		local requireOk, viewportToolsModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: ViewportToolsUI", viewportToolsModule)
		elseif type(viewportToolsModule.mount) ~= "function" then
			warn("[7kg2 Animator] UI module missing mount: ViewportToolsUI")
		else
			local mountOk, mountedRefs = pcall(viewportToolsModule.mount, centerColumn, {})
			if not mountOk then
				warn("[7kg2 Animator] Failed to mount UI module: ViewportToolsUI", mountedRefs)
			else
				viewportToolsUiRefs = mountedRefs or {}
				self._uiSections.ViewportToolsUI = viewportToolsModule
			end
		end
	end

	applySectionRefs(self, viewportToolsUiRefs)

	local presetsUiRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("PresetsUI")
		local requireOk, presetsModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: PresetsUI", presetsModule)
		elseif type(presetsModule.mount) ~= "function" then
			warn("[7kg2 Animator] UI module missing mount: PresetsUI")
		else
			local mountOk, mountedRefs = pcall(presetsModule.mount, centerColumn, {
				root = root,
			})
			if not mountOk then
				warn("[7kg2 Animator] Failed to mount UI module: PresetsUI", mountedRefs)
			else
				presetsUiRefs = mountedRefs or {}
				self._uiSections.PresetsUI = presetsModule
			end
		end
	end

	local layoutUiRefs = {}
	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("LayoutUI")
		local requireOk, layoutModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: LayoutUI", layoutModule)
		elseif type(layoutModule.mount) ~= "function" then
			warn("[7kg2 Animator] UI module missing mount: LayoutUI")
		else
			local mountOk, mountedRefs = pcall(layoutModule.mount, centerColumn, {})
			if not mountOk then
				warn("[7kg2 Animator] Failed to mount UI module: LayoutUI", mountedRefs)
			else
				layoutUiRefs = mountedRefs or {}
				self._uiSections.LayoutUI = layoutModule
			end
		end
	end

	do
		local moduleScript = script.Parent:WaitForChild("UI"):WaitForChild("ScriptUI")
		local requireOk, scriptModule = pcall(require, moduleScript)
		if not requireOk then
			warn("[7kg2 Animator] Failed to require UI module: ScriptUI", scriptModule)
