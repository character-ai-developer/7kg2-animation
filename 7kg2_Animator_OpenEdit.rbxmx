local THEME_BY_ID = {}
for _, theme in ipairs(THEMES) do
	THEME_BY_ID[theme.id] = theme
end

local currentThemeId = "Cyberpunk"
local BG_ROLE_ATTRIBUTE = "MegMoThemeBackgroundRole"
local TEXT_ROLE_ATTRIBUTE = "MegMoThemeTextRole"
local IMAGE_ROLE_ATTRIBUTE = "MegMoThemeImageRole"
local SCROLL_ROLE_ATTRIBUTE = "MegMoThemeScrollRole"
local STROKE_ROLE_ATTRIBUTE = "MegMoThemeStrokeRole"

local function cloneColors(colors)
	local clone = {}
	for key, value in pairs(colors or {}) do
		clone[key] = value
	end
	return clone
end

local function colorToSetting(color)
	if typeof(color) ~= "Color3" then
		return nil
	end
	return {
		R = math.floor((color.R * 255) + 0.5),
		G = math.floor((color.G * 255) + 0.5),
		B = math.floor((color.B * 255) + 0.5),
	}
end

local function colorFromSetting(value)
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) ~= "table" then
		return nil
	end
	local r = tonumber(value.R or value.r)
	local g = tonumber(value.G or value.g)
	local b = tonumber(value.B or value.b)
	if not (r and g and b) then
		return nil
	end
	return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
end

local function deriveCustomColors(baseColors)
	local colors = cloneColors(THEME_BY_ID.NeonPurple.colors)
	for key, value in pairs(baseColors or {}) do
		if typeof(value) == "Color3" then
			colors[key] = value
		end
	end

	local background = colors.Background
	local panel = colors.Panel
	local accent = colors.Accent
	colors.PanelAlt = panel:Lerp(background, 0.2)
	colors.PanelSoft = panel:Lerp(accent, 0.16)
	colors.AccentSoft = accent:Lerp(panel, 0.48)
	colors.Border = panel:Lerp(accent, 0.28)
	local textSurface = panel:Lerp(background, 0.35)
	colors.Text = ThemeService.getReadableTextColor(textSurface)
	colors.MutedText = ThemeService.getReadableMutedTextColor(textSurface)
	colors.StageTop = accent:Lerp(background, 0.35)
	colors.StageBottom = background:Lerp(panel, 0.2)
	return colors
end

local function applyCustomColors(colors)
	local customTheme = THEME_BY_ID.Custom
	if customTheme then
		customTheme.colors = deriveCustomColors(colors)
	end
	return customTheme
end

local function isKnownThemeId(themeId)
	return THEME_BY_ID[tostring(themeId or "")] ~= nil
end

local function normalizeSavedAt(value)
	local numberValue = tonumber(value)
	if numberValue and numberValue == numberValue and numberValue &gt; 0 then
		return numberValue
	end
	return 0
end

local function getSettingsFolder(shouldCreate)
	local folder = ServerStorage:FindFirstChild(SETTINGS_FOLDER_NAME)
	if not folder and shouldCreate then
		folder = Instance.new("Folder")
		folder.Name = SETTINGS_FOLDER_NAME
		folder.Parent = ServerStorage
	end
	return folder
end

local function readPlaceThemeId()
	local folder = getSettingsFolder(false)
	local value = folder and folder:FindFirstChild(THEME_VALUE_NAME)
	if value and value:IsA("StringValue") and isKnownThemeId(value.Value) then
		return value.Value
	end
	return nil
end

local function readPlaceThemeSavedAt()
	local folder = getSettingsFolder(false)
	local value = folder and folder:FindFirstChild(THEME_SAVED_AT_VALUE_NAME)
	if value and (value:IsA("NumberValue") or value:IsA("StringValue")) then
		return normalizeSavedAt(value.Value)
	end
	return 0
end

local function writePlaceThemeId(themeId, savedAt)
	local folder = getSettingsFolder(true)
	if not folder then
		return false
	end
	local value = folder:FindFirstChild(THEME_VALUE_NAME)
	if not value then
		value = Instance.new("StringValue")
		value.Name = THEME_VALUE_NAME
		value.Parent = folder
	end
	if not value:IsA("StringValue") then
		return false
	end
	value.Value = tostring(themeId or "")
	if savedAt then
		local savedAtValue = folder:FindFirstChild(THEME_SAVED_AT_VALUE_NAME)
		if not savedAtValue then
			savedAtValue = Instance.new("NumberValue")
			savedAtValue.Name = THEME_SAVED_AT_VALUE_NAME
			savedAtValue.Parent = folder
		end
		if savedAtValue:IsA("NumberValue") then
			savedAtValue.Value = normalizeSavedAt(savedAt)
		end
	end
	return true
end

local function readPlaceThemePreference()
	local themeId = readPlaceThemeId()
	if isKnownThemeId(themeId) then
		return themeId, readPlaceThemeSavedAt()
	end
	return nil, 0
end

local function readPluginThemePreference(plugin)
	if not plugin then
		return nil, 0
	end
	local themeId = nil
	local savedAt = nil
	pcall(function()
		themeId = plugin:GetSetting(SETTING_KEY)
		savedAt = plugin:GetSetting(THEME_SAVED_AT_SETTING_KEY)
		if not isKnownThemeId(themeId) then
			themeId = plugin:GetSetting(LEGACY_SETTING_KEY)
			savedAt = plugin:GetSetting(LEGACY_THEME_SAVED_AT_SETTING_KEY)
		end
	end)
	if isKnownThemeId(themeId) then
		return themeId, normalizeSavedAt(savedAt)
	end
	return nil, normalizeSavedAt(savedAt)
end

local function writePluginThemePreference(plugin, themeId, savedAt)
	if not plugin then
		return false
	end
	local ok = pcall(function()
		plugin:SetSetting(SETTING_KEY, themeId)
		plugin:SetSetting(THEME_SAVED_AT_SETTING_KEY, normalizeSavedAt(savedAt))
		plugin:SetSetting(LEGACY_SETTING_KEY, themeId)
		plugin:SetSetting(LEGACY_THEME_SAVED_AT_SETTING_KEY, normalizeSavedAt(savedAt))
	end)
	if not ok then
		return false
	end
	local savedThemeId = nil
	pcall(function()
		savedThemeId = plugin:GetSetting(SETTING_KEY)
	end)
	return savedThemeId == themeId
end

local function readPlaceCustomThemeColors()
	local folder = getSettingsFolder(false)
	local customFolder = folder and folder:FindFirstChild(CUSTOM_THEME_FOLDER_NAME)
	if not customFolder then
		return nil
	end

	local colors = {}
	for _, key in ipairs({ "Background", "Panel", "Accent" }) do
		local valueObject = customFolder:FindFirstChild(key)
		if valueObject and valueObject:IsA("Color3Value") then
			colors[key] = valueObject.Value
		end
	end
	return next(colors) and colors or nil
end

local function writePlaceCustomThemeColors(colors)
	local folder = getSettingsFolder(true)
	if not folder then
		return false
	end
	local customFolder = folder:FindFirstChild(CUSTOM_THEME_FOLDER_NAME)
	if not customFolder then
		customFolder = Instance.new("Folder")
		customFolder.Name = CUSTOM_THEME_FOLDER_NAME
		customFolder.Parent = folder
	end
	if not customFolder:IsA("Folder") then
		return false
	end

	local wroteAny = false
	for _, key in ipairs({ "Background", "Panel", "Accent" }) do
		local color = colors and colors[key]
		if typeof(color) == "Color3" then
			local valueObject = customFolder:FindFirstChild(key)
			if not valueObject then
				valueObject = Instance.new("Color3Value")
				valueObject.Name = key
				valueObject.Parent = customFolder
			end
			if valueObject:IsA("Color3Value") then
				valueObject.Value = color
				wroteAny = true
			end
		end
	end
	return wroteAny
end
local REPAINT_KEYS = {
	Background = true,
	Panel = true,
	PanelAlt = true,
	PanelSoft = true,
	Text = true,
	MutedText = true,
	Accent = true,
	AccentSoft = true,
	Border = true,
	Success = true,
	Danger = true,
	StageTop = true,
	StageBottom = true,
}

local function colorDistance(a, b)
	local dr = a.R - b.R
	local dg = a.G - b.G
	local db = a.B - b.B
	return math.sqrt((dr * dr) + (dg * dg) + (db * db))
end

local function luminance(color)
	return (0.2126 * color.R) + (0.7152 * color.G) + (0.0722 * color.B)
end

local function contrastRatio(a, b)
	local l1 = luminance(a)
	local l2 = luminance(b)
	if l1 &lt; l2 then
		l1, l2 = l2, l1
	end
	return (l1 + 0.05) / (l2 + 0.05)
end

local function mostReadableColor(backgroundColor, lightColor, darkColor)
	if typeof(backgroundColor) ~= "Color3" then
		return lightColor
	end
	return contrastRatio(backgroundColor, lightColor) &gt;= contrastRatio(backgroundColor, darkColor)
		and lightColor
		or darkColor
end

local function nearestVisibleBackgroundColor(instance)
	local current = instance
	while current do
		if current:IsA("GuiObject")
			and current.BackgroundTransparency &lt; 0.95
			and typeof(current.BackgroundColor3) == "Color3" then
			return current.BackgroundColor3
		end
		current = current.Parent
	end
	return Constants.THEME.Background
end

function ThemeService.getReadableTextColor(backgroundColor)
	if typeof(backgroundColor) ~= "Color3" then
		return Constants.THEME.Text
	end
	return mostReadableColor(backgroundColor, Color3.fromRGB(245, 248, 255), Color3.fromRGB(20, 24, 32))
end

function ThemeService.getReadableMutedTextColor(backgroundColor)
	if typeof(backgroundColor) ~= "Color3" then
		return Constants.THEME.MutedText
	end
	return mostReadableColor(backgroundColor, Color3.fromRGB(180, 194, 218), Color3.fromRGB(60, 68, 84))
end

local function roleForColor(color)
	if typeof(color) ~= "Color3" then
		return nil
	end

	if colorDistance(color, Color3.fromRGB(20, 24, 32)) &lt; 0.004
		or colorDistance(color, Color3.fromRGB(245, 248, 255)) &lt; 0.004 then
		return "Text"
	end
	if colorDistance(color, Color3.fromRGB(70, 78, 92)) &lt; 0.004
		or colorDistance(color, Color3.fromRGB(60, 68, 84)) &lt; 0.004
		or colorDistance(color, Color3.fromRGB(170, 182, 205)) &lt; 0.004
		or colorDistance(color, Color3.fromRGB(180, 194, 218)) &lt; 0.004 then
		return "MutedText"
	end

	for _, theme in ipairs(THEMES) do
		for roleName, roleColor in pairs(theme.colors) do
			if REPAINT_KEYS[roleName] and colorDistance(color, roleColor) &lt; 0.004 then
				return roleName
			end
		end
	end

	return nil
end

local function isTextGuiObject(instance)
	return instance
		and (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
end

local function isNearWhite(color)
	return typeof(color) == "Color3"
		and color.R &gt;= 0.88
		and color.G &gt;= 0.88
		and color.B &gt;= 0.88
end

local function applyWhiteTextStrokeColor(stroke)
	local parent = stroke and stroke.Parent
	if not isTextGuiObject(parent) or stroke.ApplyStrokeMode ~= Enum.ApplyStrokeMode.Contextual then
		return false
	end
	if isNearWhite(parent.TextColor3) then
		local currentRole = stroke:GetAttribute(STROKE_ROLE_ATTRIBUTE)
		if currentRole and currentRole ~= WHITE_TEXT_STROKE_ROLE then
			stroke:SetAttribute(TEXT_STROKE_FALLBACK_ROLE_ATTRIBUTE, currentRole)
		end
		stroke.Color = BLACK_TEXT_STROKE
		stroke:SetAttribute(STROKE_ROLE_ATTRIBUTE, WHITE_TEXT_STROKE_ROLE)
		return true
	end
	if stroke:GetAttribute(STROKE_ROLE_ATTRIBUTE) == WHITE_TEXT_STROKE_ROLE then
		local fallbackRole = stroke:GetAttribute(TEXT_STROKE_FALLBACK_ROLE_ATTRIBUTE)
		if fallbackRole then
			stroke:SetAttribute(STROKE_ROLE_ATTRIBUTE, fallbackRole)
		else
			stroke:SetAttribute(STROKE_ROLE_ATTRIBUTE, nil)
		end
	end
	return false
end

local function recolorColorSequence(sequence, colors)
	local changed = false
	local keypoints = {}
	for _, keypoint in ipairs(sequence.Keypoints) do
		local roleName = roleForColor(keypoint.Value)
		local nextColor = roleName and colors[roleName] or keypoint.Value
		if nextColor ~= keypoint.Value then
			changed = true
		end
		table.insert(keypoints, ColorSequenceKeypoint.new(keypoint.Time, nextColor))
	end
	return changed and ColorSequence.new(keypoints) or sequence
end

local function applyColors(theme)
	for key, value in pairs(theme.colors) do
		Constants.THEME[key] = value
	end
	Constants.CURRENT_THEME_ID = theme.id
end

function ThemeService.getThemes()
	return THEMES
end

function ThemeService.getTheme(themeId)
	return THEME_BY_ID[tostring(themeId or "")] or THEME_BY_ID.SevenKg2Blue
end

function ThemeService.getCurrentThemeId()
	return currentThemeId
end

function ThemeService.getCurrentTheme()
	return ThemeService.getTheme(currentThemeId)
end

function ThemeService.getCustomThemeColors()
	local theme = THEME_BY_ID.Custom
	return cloneColors(theme and theme.colors or {})
end

function ThemeService.loadCustomTheme(plugin)
	local savedColors = nil
	if plugin then
		pcall(function()
			savedColors = plugin:GetSetting(CUSTOM_SETTING_KEY)
			if type(savedColors) ~= "table" then
				savedColors = plugin:GetSetting(LEGACY_CUSTOM_SETTING_KEY)
			end
		end)
	end
	if type(savedColors) ~= "table" then
		savedColors = readPlaceCustomThemeColors()
	end
	if type(savedColors) ~= "table" then
		return nil
	end

	local colors = {}
	for _, key in ipairs({ "Background", "Panel", "Accent" }) do
		local color = colorFromSetting(savedColors[key])
		if color then
			colors[key] = color
		end
	end
	if next(colors) then
		return applyCustomColors(colors)
	end
	return nil
end

function ThemeService.isThemeUnlocked(theme)
	-- Theme ownership checks can be added here when Marketplace unlock products
	-- are connected; all bundled themes remain selectable for now.
	return theme ~= nil
end

function ThemeService.applyTheme(themeId)
	local theme = ThemeService.getTheme(themeId)
	currentThemeId = theme.id
	applyColors(theme)
	return theme
end

function ThemeService.applyToGui(root)
	if not root then
		return 0
	end

	local theme = ThemeService.getCurrentTheme()
	local colors = theme.colors
	local recolored = 0
	local items = { root }
	for _, descendant in ipairs(root:GetDescendants()) do
		table.insert(items, descendant)
	end

	for _, instance in ipairs(items) do
		if instance:IsA("GuiObject") then
			if instance:GetAttribute("MegMoPreserveColor") == true then
				-- Palette swatches and other literal color chips must keep their
				-- displayed color so the preview matches the color users select.
			elseif instance.Name == "Root" then
				instance.BackgroundColor3 = colors.Background
				instance:SetAttribute(BG_ROLE_ATTRIBUTE, "Background")
				recolored += 1
			elseif instance.BackgroundTransparency &lt; 1 then
				local roleName = instance:GetAttribute(BG_ROLE_ATTRIBUTE) or roleForColor(instance.BackgroundColor3)
				if roleName and colors[roleName] then
					instance.BackgroundColor3 = colors[roleName]
					instance:SetAttribute(BG_ROLE_ATTRIBUTE, roleName)
					recolored += 1
				end
			end

			if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
				local textRoleName = instance:GetAttribute(TEXT_ROLE_ATTRIBUTE) or roleForColor(instance.TextColor3)
				if textRoleName == "__auto" then
					instance.TextColor3 = ThemeService.getReadableTextColor(nearestVisibleBackgroundColor(instance))
					recolored += 1
				elseif textRoleName and colors[textRoleName] then
					instance.TextColor3 = colors[textRoleName]
					instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, textRoleName)
					recolored += 1
				end
				if instance.BackgroundTransparency &gt;= 0.95 then
					local surfaceColor = nearestVisibleBackgroundColor(instance)
					local roleName = instance:GetAttribute(TEXT_ROLE_ATTRIBUTE) or textRoleName
					if roleName == "Text" or roleName == "__auto" then
						instance.TextColor3 = ThemeService.getReadableTextColor(surfaceColor)
						instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, roleName)
						recolored += 1
					elseif roleName == "MutedText" then
						instance.TextColor3 = ThemeService.getReadableMutedTextColor(surfaceColor)
						instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, "MutedText")
						recolored += 1
					elseif contrastRatio(instance.TextColor3, surfaceColor) &lt; 3.25 then
						instance.TextColor3 = ThemeService.getReadableTextColor(surfaceColor)
						instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, "__auto")
						recolored += 1
					end
				end
				if instance.BackgroundTransparency &lt; 0.45 and (instance:IsA("TextButton") or instance:IsA("TextBox")) then
					instance.TextColor3 = ThemeService.getReadableTextColor(instance.BackgroundColor3)
					instance:SetAttribute(TEXT_ROLE_ATTRIBUTE, "__auto")
				end
				if instance:IsA("TextBox") then
					local placeholderRoleName = instance:GetAttribute("MegMoThemePlaceholderRole")
						or roleForColor(instance.PlaceholderColor3)
					if placeholderRoleName and colors[placeholderRoleName] then
						instance.PlaceholderColor3 = colors[placeholderRoleName]
						instance:SetAttribute("MegMoThemePlaceholderRole", placeholderRoleName)
						recolored += 1
					end
					if instance.BackgroundTransparency &lt; 0.45 then
						instance.PlaceholderColor3 = ThemeService.getReadableMutedTextColor(instance.BackgroundColor3)
						instance:SetAttribute("MegMoThemePlaceholderRole", "__auto")
					end
				end
			end

			if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
				local imageRoleName = instance:GetAttribute(IMAGE_ROLE_ATTRIBUTE) or roleForColor(instance.ImageColor3)
				if imageRoleName and colors[imageRoleName] then
					instance.ImageColor3 = colors[imageRoleName]
					instance:SetAttribute(IMAGE_ROLE_ATTRIBUTE, imageRoleName)
					recolored += 1
				end
			end

			if instance:IsA("ScrollingFrame") then
				local scrollRoleName = instance:GetAttribute(SCROLL_ROLE_ATTRIBUTE) or roleForColor(instance.ScrollBarImageColor3)
				if scrollRoleName and colors[scrollRoleName] then
					instance.ScrollBarImageColor3 = colors[scrollRoleName]
					instance:SetAttribute(SCROLL_ROLE_ATTRIBUTE, scrollRoleName)
					recolored += 1
				end
			end
		elseif instance:IsA("UIStroke") then
			if instance:GetAttribute("MegMoPreserveColor") == true then
				-- Literal preview/swatch strokes should keep their authored color.
			elseif applyWhiteTextStrokeColor(instance) then
				recolored += 1
			else
				local strokeRoleName = instance:GetAttribute(STROKE_ROLE_ATTRIBUTE) or roleForColor(instance.Color)
				if strokeRoleName and colors[strokeRoleName] then
					instance.Color = colors[strokeRoleName]
					instance:SetAttribute(STROKE_ROLE_ATTRIBUTE, strokeRoleName)
					recolored += 1
				end
			end
		elseif instance:IsA("UIGradient") then
			instance.Color = recolorColorSequence(instance.Color, colors)
		end
	end

	return recolored
end

function ThemeService.loadSavedTheme(plugin)
	ThemeService.loadCustomTheme(plugin)
	local pluginThemeId, pluginSavedAt = readPluginThemePreference(plugin)
	local placeThemeId, placeSavedAt = readPlaceThemePreference()
	local savedThemeId = pluginThemeId or placeThemeId
	local theme = ThemeService.applyTheme(savedThemeId)
	if theme then
		if pluginThemeId then
			if placeThemeId ~= theme.id then
				writePlaceThemeId(theme.id, pluginSavedAt &gt; 0 and pluginSavedAt or os.time())
			end
		elseif placeThemeId then
			writePluginThemePreference(plugin, theme.id, placeSavedAt &gt; 0 and placeSavedAt or os.time())
		end
	end
	if theme and theme.id == "Custom" then
		writePlaceCustomThemeColors(theme.colors)
	end
	return theme
end

function ThemeService.saveCustomTheme(plugin, partialColors)
	local currentCustom = currentThemeId == "Custom"
		and ThemeService.getCustomThemeColors()
		or cloneColors(ThemeService.getCurrentTheme().colors)
	for key, value in pairs(partialColors or {}) do
		if REPAINT_KEYS[key] and typeof(value) == "Color3" then
			currentCustom[key] = value
		end
	end

	local theme = applyCustomColors(currentCustom)
	if not theme then
		return false, "Custom themes are unavailable in this build."
	end

	local settingColors = {}
	for _, key in ipairs({ "Background", "Panel", "Accent" }) do
		settingColors[key] = colorToSetting(theme.colors[key])
	end

	local savedAt = os.time()
	local pluginSaved = false
	if plugin then
		local ok = pcall(function()
			plugin:SetSetting(CUSTOM_SETTING_KEY, settingColors)
			plugin:SetSetting(LEGACY_CUSTOM_SETTING_KEY, settingColors)
		end)
		if ok then
			local savedColors = nil
			pcall(function()
				savedColors = plugin:GetSetting(CUSTOM_SETTING_KEY)
				if type(savedColors) ~= "table" then
					savedColors = plugin:GetSetting(LEGACY_CUSTOM_SETTING_KEY)
				end
			end)
			pluginSaved = writePluginThemePreference(plugin, theme.id, savedAt) and type(savedColors) == "table"
		end
	end
	local placeSaved = writePlaceThemeId(theme.id, savedAt)
	local placeColorsSaved = writePlaceCustomThemeColors(theme.colors)
	currentThemeId = theme.id
	applyColors(theme)
	local persistenceNote = pluginSaved and " Saved for new Studio places."
		or ((placeSaved and placeColorsSaved) and " Saved in this place only." or " Could not save preference.")
	return true, "Custom theme updated." .. persistenceNote
end

function ThemeService.saveTheme(plugin, themeId)
	local theme = ThemeService.getTheme(themeId)
	if not ThemeService.isThemeUnlocked(theme) then
		return false, string.format("%s is not unlocked for this account yet.", theme.name)
	end

	currentThemeId = theme.id
	local savedAt = os.time()
	local pluginSaved = writePluginThemePreference(plugin, theme.id, savedAt)
	local placeSaved = writePlaceThemeId(theme.id, savedAt)
	if theme.id == "Custom" then
		placeSaved = writePlaceCustomThemeColors(theme.colors) and placeSaved
	end
	applyColors(theme)
	local persistenceNote = pluginSaved and " Saved for new Studio places."
		or (placeSaved and " Saved in this place only." or " Could not save preference.")
	return true, string.format("Theme set to %s.%s", theme.name, persistenceNote)
end

return ThemeService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX240">
        <Properties>
          <string name="Name">TimelineDiamondCache</string>
          <ProtectedString name="Source">local TimelineDiamondCache = {}
TimelineDiamondCache.__index = TimelineDiamondCache

local DEFAULT_RENDER_ALL_LIMIT = 900
local DEFAULT_PADDING_X = 12

local function append(parts, value)
	parts[#parts + 1] = tostring(value)
end

local function buildSignature(viewModel, options)
	local parts = {}
	local pixelsPerFrame = tonumber(options.pixelsPerFrame) or 1
	append(parts, "duration:" .. tostring(options.durationFrames or viewModel.durationFrames or 0))
	append(parts, string.format("ppf:%.5f", pixelsPerFrame))
	append(parts, "keys:" .. tostring(viewModel.keyframeCount or 0))

	local tracks = viewModel.tracks or viewModel.joints or {}
	local keyframesByPath = viewModel.trackKeyframesByPath or {}
	for _, trackData in ipairs(tracks) do
		local path = tostring(trackData.path or "")
		append(parts, "track:" .. path)
		for _, frame in ipairs(keyframesByPath[path] or {}) do
			append(parts, frame)
		end
	end

	return table.concat(parts, "|")
end

function TimelineDiamondCache.new()
	return setmetatable({
		_entriesByTrack = {},
		_mode = "Windowed",
		_signature = nil,
	}, TimelineDiamondCache)
end

function TimelineDiamondCache:invalidate()
	self._entriesByTrack = {}
	self._signature = nil
end

function TimelineDiamondCache:prepare(viewModel, options)
	viewModel = viewModel or {}
	options = options or {}

	local keyframeCount = tonumber(viewModel.keyframeCount) or 0
	local renderAllLimit = tonumber(options.renderAllKeyLimit) or DEFAULT_RENDER_ALL_LIMIT
	local mode = (keyframeCount &gt; 0 and keyframeCount &lt;= renderAllLimit) and "Full" or "Windowed"
	local signature = buildSignature(viewModel, options)

	if signature ~= self._signature then
		local entriesByTrack = {}
		local pixelsPerFrame = tonumber(options.pixelsPerFrame) or 1
		local paddingX = tonumber(options.paddingX) or DEFAULT_PADDING_X
		local keyframesByPath = viewModel.trackKeyframesByPath or {}

		for trackPath, frames in pairs(keyframesByPath) do
			local entries = {}
			for _, frame in ipairs(frames or {}) do
				local frameNumber = tonumber(frame) or 0
				entries[#entries + 1] = {
					frame = frame,
					x = paddingX + (frameNumber * pixelsPerFrame),
				}
			end
			entriesByTrack[trackPath] = entries
		end

		self._entriesByTrack = entriesByTrack
		self._signature = signature
	end

	self._mode = mode

	local visibleWidth = tonumber(options.visibleWidth) or 0
	local scrollX = tonumber(options.scrollX) or 0
	local pixelsPerFrame = tonumber(options.pixelsPerFrame) or 1
	local cullPadding = mode == "Full" and math.huge or math.max(160, visibleWidth * 0.85, pixelsPerFrame * 24)

	return {
		cullPadding = cullPadding,
		keyframeCount = keyframeCount,
		mode = mode,
		visibleMaxX = scrollX + visibleWidth + cullPadding,
		visibleMinX = scrollX - cullPadding,
	}
end

function TimelineDiamondCache:getTrackEntries(trackPath, visibleMinX, visibleMaxX)
	local entries = self._entriesByTrack[trackPath]
	if not entries then
		return nil
	end

	if self._mode == "Full" then
		return entries
	end

	local visibleEntries = {}
	for _, entry in ipairs(entries) do
		local x = entry.x or 0
		if (x + 18) &gt;= visibleMinX and (x - 18) &lt;= visibleMaxX then
			visibleEntries[#visibleEntries + 1] = entry
		end
	end
	return visibleEntries
end

return TimelineDiamondCache
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX241">
        <Properties>
          <string name="Name">TimelineFrameActionSupport</string>
          <ProtectedString name="Source">local TimelineFrameActionSupport = {}

local function applyFrameSideEffects(context)
	local timeline = context.timeline
	local modules = context.modules
	if modules then
		pcall(function()
			require(modules:WaitForChild("AttachService")).prepareTimelineState(timeline, timeline:getCurrentFrame())
		end)
	end
	timeline:applyCurrentFrame()
	if modules then
		pcall(function()
			require(modules:WaitForChild("AttachService")).applyTimelineState(timeline, timeline:getCurrentFrame())
		end)
	end
	if context.cameraTrackService then
		context.cameraTrackService.applyActiveFirstPersonPreview(timeline, timeline:getCurrentFrame())
	end
	if type(context.updateOnionSkinPreview) == "function" then
		context.updateOnionSkinPreview(timeline:getCurrentFrame(), true)
	end
	local editorActions = context.editorActions or {}
	local trackballTool = editorActions._trackballTool
	if editorActions._persistentTrackballMode and trackballTool and type(trackballTool.SyncToFrame) == "function" then
		trackballTool:SyncToFrame(timeline:getCurrentFrame())
	end
end

function TimelineFrameActionSupport.setFrame(context, frame, message)
	local timeline = context.timeline
	frame = math.clamp(math.floor(tonumber(frame) or 0), 0, timeline:getDurationFrames())
	local changed = timeline:setCurrentFrame(frame)
	if changed then
		applyFrameSideEffects(context)
	elseif type(context.updateOnionSkinPreview) == "function" then
		context.updateOnionSkinPreview(timeline:getCurrentFrame(), true)
	end
	message = message or string.format("Current frame set to %d.", frame)
	if type(context.refreshUi) == "function" then
		context.refreshUi(message)
	end
	return true, message
end

function TimelineFrameActionSupport.stepFrame(context, offset)
	offset = math.floor(tonumber(offset) or 0)
	if offset == 0 then
		return false, "No timeline movement was requested."
	end
	local timeline = context.timeline
	local currentFrame = timeline:getCurrentFrame()
	local targetFrame = math.clamp(currentFrame + offset, 0, timeline:getDurationFrames())
	if targetFrame == currentFrame then
		local message = offset &lt; 0 and "Already at the start of the timeline." or "Already at the end of the timeline."
		if type(context.refreshUi) == "function" then
			context.refreshUi(message)
		end
		return false, message
	end
	return TimelineFrameActionSupport.setFrame(context, targetFrame, string.format("Current frame set to %d.", targetFrame))
end

return TimelineFrameActionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX242">
        <Properties>
          <string name="Name">TimelineInputController</string>
          <ProtectedString name="Source">local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local WidgetMathSupport = require(script.Parent:WaitForChild("WidgetMathSupport"))

local TimelineInputController = {}
TimelineInputController.__index = TimelineInputController

local SHIFT_ACTION_NAME = "MegMoAnimatorTimelineInputShift"
local SHIFT_PRIORITY = Enum.ContextActionPriority.High.Value + 1200
local SHIFT_GRACE_SECONDS = 0.35
local POLL_GRACE_SECONDS = 0.75

local function isShiftKey(keyCode)
	return WidgetMathSupport.isShiftKey(keyCode)
end

local function isShiftKeyString(key)
	return WidgetMathSupport.isShiftKeyString(key)
end

local function readShiftDown()
	return WidgetMathSupport.isShiftDown(UserInputService)
end

function TimelineInputController.new(options)
	options = options or {}

	return setmetatable({
		_connections = {},
		_contextActive = options.contextActive or function()
			return true
		end,
		_onShiftChanged = options.onShiftChanged,
		_plugin = options.plugin,
		_shiftGraceUntil = 0,
		_shiftHeld = false,
		_sources = {},
	}, TimelineInputController)
end

function TimelineInputController:_connect(signal, callback)
	if not signal then
		return
	end
	table.insert(self._connections, signal:Connect(callback))
end

function TimelineInputController:_hasShiftSource()
	for _, isHeld in pairs(self._sources) do
		if isHeld then
			return true
		end
	end
	return false
end

function TimelineInputController:_setSource(sourceName, isHeld, graceSeconds)
	if isHeld then
		self._sources[sourceName] = true
		self._shiftGraceUntil = os.clock() + (graceSeconds or SHIFT_GRACE_SECONDS)
	else
		self._sources[sourceName] = nil
	end

	self:_syncShiftState()
end

function TimelineInputController:_syncShiftState()
	local nextHeld = self:_hasShiftSource() or readShiftDown() or os.clock() &lt;= self._shiftGraceUntil
	if self._shiftHeld == nextHeld then
		return
	end

	self._shiftHeld = nextHeld
	if self._onShiftChanged then
		self._onShiftChanged(nextHeld)
	end
end

function TimelineInputController:observeKeyCode(keyCode, isHeld)
	if keyCode == Enum.KeyCode.Unknown or not isShiftKey(keyCode) then
		return false
	end

	self:_setSource(keyCode.Name, isHeld == true, SHIFT_GRACE_SECONDS)
	return true
end

function TimelineInputController:observePluginKey(key, isHeld)
	if not isShiftKeyString(key) then
		return false
	end

	self:_setSource("PluginMouseShift", isHeld == true, SHIFT_GRACE_SECONDS)
	return true
end

function TimelineInputController:pollShift()
	self:_setSource("PollShift", readShiftDown(), POLL_GRACE_SECONDS)
end

function TimelineInputController:isShiftHeld()
	self:_syncShiftState()
	return self._shiftHeld
end

function TimelineInputController:getDebugSummary()
	local sources = {}
	for sourceName, isHeld in pairs(self._sources) do
		if isHeld then
			table.insert(sources, tostring(sourceName))
		end
	end
	table.sort(sources)

	local rawHeld = readShiftDown()
	local graceLeft = math.max(0, (self._shiftGraceUntil or 0) - os.clock())
	return string.format(
		"held=%s raw=%s grace=%.2f sources=%s",
		tostring(self._shiftHeld),
		tostring(rawHeld),
		graceLeft,
		#sources &gt; 0 and table.concat(sources, ",") or "none"
	)
end

function TimelineInputController:clearShift()
	self._sources = {}
	self._shiftGraceUntil = 0
	self:_syncShiftState()
end

function TimelineInputController:start()
	if self._started then
		return
	end
	self._started = true

	self:_connect(UserInputService.InputBegan, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.Keyboard then
			self:observeKeyCode(inputObject.KeyCode, true)
		end
	end)

	self:_connect(UserInputService.InputEnded, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.Keyboard then
			self:observeKeyCode(inputObject.KeyCode, false)
		end
	end)

	self:_connect(UserInputService.WindowFocusReleased, function()
		self:clearShift()
	end)

	pcall(function()
		ContextActionService:UnbindAction(SHIFT_ACTION_NAME)
		ContextActionService:BindActionAtPriority(
			SHIFT_ACTION_NAME,
			function(_, inputState, inputObject)
				if inputObject.UserInputType ~= Enum.UserInputType.Keyboard or not isShiftKey(inputObject.KeyCode) then
					return Enum.ContextActionResult.Pass
				end

				if inputState == Enum.UserInputState.Begin then
					self:observeKeyCode(inputObject.KeyCode, true)
				elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
					self:observeKeyCode(inputObject.KeyCode, false)
				end

				return Enum.ContextActionResult.Pass
			end,
			false,
			SHIFT_PRIORITY,
			Enum.KeyCode.LeftShift,
			Enum.KeyCode.RightShift
		)
	end)

	local pluginMouse = nil
	local hasPluginMouse = pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end)
	if hasPluginMouse and pluginMouse then
		if pluginMouse.KeyDown then
			self:_connect(pluginMouse.KeyDown, function(key)
				self:observePluginKey(key, true)
			end)
		end
		if pluginMouse.KeyUp then
			self:_connect(pluginMouse.KeyUp, function(key)
				self:observePluginKey(key, false)
			end)
		end
	end

	self:_connect(RunService.Heartbeat, function()
		if self._contextActive() then
			self:pollShift()
		elseif not self:_hasShiftSource() and os.clock() &gt; self._shiftGraceUntil then
			self:_syncShiftState()
		end
	end)
end

function TimelineInputController:destroy()
	pcall(function()
		ContextActionService:UnbindAction(SHIFT_ACTION_NAME)
	end)
	for _, connection in ipairs(self._connections) do
		if connection then
			connection:Disconnect()
		end
	end
	self._connections = {}
	self._started = false
end

return TimelineInputController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX243">
        <Properties>
          <string name="Name">TimelineMiddlePanInputSink</string>
          <ProtectedString name="Source">local ContextActionService = game:GetService("ContextActionService")

local TimelineMiddlePanInputSink = {}

local INPUT_PRIORITY = Enum.ContextActionPriority.High.Value + 10000

local function isMiddlePanInput(inputObject)
	return inputObject
		and (
			inputObject.UserInputType == Enum.UserInputType.MouseButton3
			or inputObject.UserInputType == Enum.UserInputType.MouseMovement
		)
end

function TimelineMiddlePanInputSink.bind(actionName, shouldSink)
	if type(actionName) ~= "string" or actionName == "" or type(shouldSink) ~= "function" then
		return
	end

	pcall(function()
		ContextActionService:UnbindAction(actionName)
		ContextActionService:BindActionAtPriority(
			actionName,
			function(_, inputState, inputObject)
				if not isMiddlePanInput(inputObject) then
					return Enum.ContextActionResult.Pass
				end

				local ok, consume = pcall(shouldSink, inputState, inputObject)
				if ok and consume == true then
					return Enum.ContextActionResult.Sink
				end

				return Enum.ContextActionResult.Pass
			end,
			false,
			INPUT_PRIORITY,
			Enum.UserInputType.MouseButton3,
			Enum.UserInputType.MouseMovement
		)
	end)
end

function TimelineMiddlePanInputSink.unbind(actionName)
	if type(actionName) ~= "string" or actionName == "" then
		return
	end

	pcall(function()
		ContextActionService:UnbindAction(actionName)
	end)
end

return TimelineMiddlePanInputSink
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX244">
        <Properties>
          <string name="Name">TimelineModel</string>
          <ProtectedString name="Source">local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local RigService = require(script.Parent:WaitForChild("RigService"))
local RigTrackHierarchyService = require(script.Parent:WaitForChild("RigTrackHierarchyService"))
local ScreenEffectTrackService = require(script.Parent:WaitForChild("ScreenEffectTrackService"))
local LightingEffectTrackService = require(script.Parent:WaitForChild("LightingEffectTrackService"))
local ParticleEmitterPropertyService = require(script.Parent:WaitForChild("ParticleEmitterPropertyService"))
local ParticleEmitterGroupService = require(script.Parent:WaitForChild("ParticleEmitterGroupService"))
local PropertyKeyframeValueService = require(script.Parent:WaitForChild("PropertyKeyframeValueService"))
local SoundTimelineService = require(script.Parent:WaitForChild("SoundTimelineService"))
local EventScriptExecutionService = require(script.Parent:WaitForChild("EventScriptExecutionService"))
local FaceRigAdapter = require(script.Parent.Parent:WaitForChild("Features"):WaitForChild("Faces"):WaitForChild("FaceRigAdapter"))

local TimelineModel = {}
TimelineModel.__index = TimelineModel

local SAVE_FORMAT = "MegMoAnimatorProject"

local function isSupportedSaveFormat(data)
	if type(data) ~= "table" then
		return false
	end
	if data.format == SAVE_FORMAT then
		return true
	end
	local format = tostring(data.format or "")
	local hasProjectShape = type(data.tracks) == "table" and (data.durationFrames == nil or tonumber(data.durationFrames) ~= nil)
	return hasProjectShape and string.sub(format, -#("AnimatorProject")) == "AnimatorProject"
end

local DEFAULT_EASING_STYLE = "Linear"
local DEFAULT_EASING_DIRECTION = "InOut"
local poseIsEmpty
local isOneShotParticleEventTrack
local isOneShotSoundTrack
local attachServiceResolved = false
local cachedAttachService = nil

local function getAttachService()
	if attachServiceResolved then
		return cachedAttachService
	end
	attachServiceResolved = true

	local module = script.Parent:FindFirstChild("AttachService")
	if not module then
		return nil
	end

	local success, service = pcall(require, module)
	if success then
		cachedAttachService = service
		return service
	end
	return nil
end

local function prepareAttachmentFrame(timeline, frame)
	local service = getAttachService()
	if service and type(service.prepareTimelineState) == "function" then
		pcall(function()
			service.prepareTimelineState(timeline, frame)
		end)
	end
	return service
end

local function applyAttachmentFrame(service, timeline, frame)
	if service and type(service.applyTimelineState) == "function" then
		pcall(function()
			service.applyTimelineState(timeline, frame)
		end)
	end
end

local function cloneValue(value)
	if typeof(value) == "table" then
		local clone = {}
		for key, childValue in pairs(value) do
			clone[key] = cloneValue(childValue)
		end
		return clone
	end

	return value
end

local SCALE_EPSILON = 0.001

local function getRigScale(rig)
	if not (rig and rig.Parent and rig:IsA("Model")) then
		return 1
	end

	local success, value = pcall(function()
		return rig:GetScale()
	end)
	if success and type(value) == "number" and value &gt; 0 then
		return value
	end
	return 1
end

local function getRigScaleRatio(motorData)
	if RigService.isBoneJoint(motorData) then
		return 1
	end
	local capturedScale = tonumber(motorData and motorData.rigScale) or 1
	if capturedScale &lt;= 0 then
		capturedScale = 1
	end
	return getRigScale(motorData and motorData.rig) / capturedScale
end

local function cframeRotationOnly(cframe)
	return cframe - cframe.Position
end

local function withCFramePosition(cframe, position)
	return CFrame.new(position) * cframeRotationOnly(cframe)
end

local function normalizeRigCFrameForStorage(cframe, originalC0, scale)
	if typeof(cframe) ~= "CFrame" or typeof(originalC0) ~= "CFrame" or math.abs(scale - 1) &lt;= SCALE_EPSILON then
		return cframe
	end

	local position = cframe.Position
	local originalPosition = originalC0.Position
	local scaledOriginalPosition = originalPosition * scale
	local distanceFromUnscaled = (position - originalPosition).Magnitude
	local distanceFromScaled = (position - scaledOriginalPosition).Magnitude

	if distanceFromScaled + SCALE_EPSILON &lt; distanceFromUnscaled then
		return withCFramePosition(cframe, position / scale)
	end
	return cframe
end

local function scaleRigCFrameForApply(cframe, originalC0, scale)
	if typeof(cframe) ~= "CFrame" or typeof(originalC0) ~= "CFrame" or math.abs(scale - 1) &lt;= SCALE_EPSILON then
		return cframe
	end

	local position = cframe.Position
	local originalPosition = originalC0.Position
	local scaledOriginalPosition = originalPosition * scale
	local distanceFromUnscaled = (position - originalPosition).Magnitude
	local distanceFromScaled = (position - scaledOriginalPosition).Magnitude

	if distanceFromUnscaled &lt;= distanceFromScaled + SCALE_EPSILON then
		return withCFramePosition(cframe, position * scale)
	end
	return cframe
end

local function cloneFrames(frames)
	local clone = {}
	for frame, pose in pairs(frames) do
		clone[frame] = {}
		for path, value in pairs(pose) do
			clone[frame][path] = cloneValue(value)
		end
	end
	return clone
end

local function cloneGenericTracks(tracks)
	local clone = {}
	for _, track in ipairs(tracks or {}) do
		table.insert(clone, cloneValue(track))
	end
	return clone
end

local function cloneKeyOptions(options)
	local clone = {}
	for path, frames in pairs(options or {}) do
		clone[path] = {}
		for frame, keyOptions in pairs(frames) do
			clone[path][frame] = cloneValue(keyOptions)
		end
	end
	return clone
end

local function cloneTrackKeys(keys)
	local clone = {}
	for _, key in ipairs(keys or {}) do
		table.insert(clone, {
			jointPath = key.jointPath or key.path,
			frame = key.frame,
			value = cloneValue(key.value),
			easingStyle = key.easingStyle,
			easingDirection = key.easingDirection,
		})
	end
	return clone
end

local function makeTrackKeyId(path, frame)
	return tostring(path) .. "\n" .. tostring(frame)
end

local function normalizeFrame(frame)
	return math.max(0, math.floor(frame or 0))
end

local function scaleFrameNumber(frame, scale)
	return math.max(0, math.floor((tonumber(frame) or 0) * scale + 0.5))
end

local function serializeValue(value)
	if typeof(value) == "CFrame" then
		return {
			type = "CFrame",
			components = { value:GetComponents() },
		}
	end

	if typeof(value) == "Color3" then
		return {
			type = "Color3",
			r = value.R,
			g = value.G,
			b = value.B,
		}
	end

	if typeof(value) == "Vector3" then
		return {
			type = "Vector3",
			x = value.X,
			y = value.Y,
			z = value.Z,
		}
	end

	if typeof(value) == "Vector2" then
		return {
			type = "Vector2",
			x = value.X,
			y = value.Y,
		}
	end

	if typeof(value) == "NumberRange" then
		return {
			type = "NumberRange",
			min = value.Min,
			max = value.Max,
		}
	end

	if typeof(value) == "NumberSequence" then
		local keypoints = {}
		for _, keypoint in ipairs(value.Keypoints) do
			table.insert(keypoints, {
				time = keypoint.Time,
				value = keypoint.Value,
				envelope = keypoint.Envelope,
			})
		end
		return {
			type = "NumberSequence",
			keypoints = keypoints,
		}
	end

	if typeof(value) == "ColorSequence" then
		local keypoints = {}
		for _, keypoint in ipairs(value.Keypoints) do
			table.insert(keypoints, {
				time = keypoint.Time,
				value = serializeValue(keypoint.Value),
			})
		end
		return {
			type = "ColorSequence",
			keypoints = keypoints,
		}
	end

	if typeof(value) == "EnumItem" then
		local enumTypeName = ""
		pcall(function()
			enumTypeName = tostring(value.EnumType)
		end)
		if enumTypeName == "" then
			enumTypeName = tostring(value):match("^(Enum%.[^.]+)") or ""
		end
		return {
			type = "EnumItem",
			enumType = enumTypeName,
			name = value.Name,
		}
	end

	if typeof(value) == "table" then
		local serialized = {}
		for key, childValue in pairs(value) do
			serialized[key] = serializeValue(childValue)
		end
		return serialized
	end

	return value
end

local function deserializeValue(value)
	if typeof(value) ~= "table" then
		return value
	end

	if value.type == "CFrame" and type(value.components) == "table" then
		return CFrame.new(table.unpack(value.components))
	end

	if value.type == "Color3" then
		return Color3.new(value.r or 0, value.g or 0, value.b or 0)
	end

	if value.type == "Vector3" then
		return Vector3.new(value.x or 0, value.y or 0, value.z or 0)
	end

	if value.type == "Vector2" then
		return Vector2.new(value.x or 0, value.y or 0)
	end

	if value.type == "NumberRange" then
		return NumberRange.new(value.min or 0, value.max or value.min or 0)
	end

	if value.type == "NumberSequence" and type(value.keypoints) == "table" then
		local keypoints = {}
		for _, keypoint in ipairs(value.keypoints) do
			table.insert(keypoints, NumberSequenceKeypoint.new(
				keypoint.time or 0,
				keypoint.value or 0,
				keypoint.envelope or 0
			))
		end
		if #keypoints &gt; 0 then
			return NumberSequence.new(keypoints)
		end
		return NumberSequence.new(0)
	end

	if value.type == "ColorSequence" and type(value.keypoints) == "table" then
		local keypoints = {}
		for _, keypoint in ipairs(value.keypoints) do
			local color = deserializeValue(keypoint.value)
			if typeof(color) ~= "Color3" then
				color = Color3.new(1, 1, 1)
			end
			table.insert(keypoints, ColorSequenceKeypoint.new(keypoint.time or 0, color))
		end
		if #keypoints &gt; 0 then
			return ColorSequence.new(keypoints)
		end
		return ColorSequence.new(Color3.new(1, 1, 1))
	end

	if value.type == "EnumItem" then
		local enumTypeName = tostring(value.enumType or ""):match("^Enum%.(.+)$") or tostring(value.enumType or "")
		local enumType = enumTypeName ~= "" and Enum[enumTypeName] or nil
		if enumType and value.name then
			local success, enumItem = pcall(function()
				return enumType[value.name]
			end)
			if success and enumItem then
				return enumItem
			end
		end
		return value.name
	end

	local deserialized = {}
	for key, childValue in pairs(value) do
		deserialized[key] = deserializeValue(childValue)
	end
	return deserialized
end

local function getImportRepeatBlendFrames(options, localMaxFrame)
	localMaxFrame = math.max(0, math.floor(tonumber(localMaxFrame) or 0))
	if localMaxFrame &lt;= 4 or (options and options.disableLoopBlend == true) then
		return 0
	end

	local configured = options and tonumber(options.loopBlendFrames)
	if configured ~= nil then
		return math.clamp(math.floor(configured + 0.5), 0, localMaxFrame - 1)
	end

	return math.min(6, math.max(2, math.floor(localMaxFrame * 0.04 + 0.5)))
end

local function getImportRepeatBlendAlpha(localFrame, localMaxFrame, blendFrames)
	localFrame = math.max(0, math.floor(tonumber(localFrame) or 0))
	localMaxFrame = math.max(0, math.floor(tonumber(localMaxFrame) or 0))
	blendFrames = math.max(0, math.floor(tonumber(blendFrames) or 0))
	if blendFrames &lt;= 0 or localMaxFrame &lt;= blendFrames then
		return 0
	end

	local blendStartFrame = localMaxFrame - blendFrames
	if localFrame &lt;= blendStartFrame then
		return 0
	end

	return math.clamp((localFrame - blendStartFrame) / blendFrames, 0, 1)
end

local function getInstancePath(instance)
	if instance and instance.Parent then
		return instance:GetFullName()
	end

	return "Missing"
end

local function serializeEmitterTargets(track)
	local targets = {}
	local seen = {}
	local function addEmitter(emitter)
		if not (emitter and emitter.Parent and emitter:IsA("ParticleEmitter")) then
			return
		end
		local path = getInstancePath(emitter)
		if seen[path] then
			return
		end
		seen[path] = true
		table.insert(targets, {
			path = path,
			name = emitter.Name,
		})
	end

	if type(track.emitters) == "table" then
		for _, emitter in ipairs(track.emitters) do
			addEmitter(emitter)
		end
	end

	local instance = track.instance
	if #targets == 0 and instance and instance.Parent then
		if instance:IsA("ParticleEmitter") then
			addEmitter(instance)
		else
			for _, descendant in ipairs(instance:GetDescendants()) do
				if descendant:IsA("ParticleEmitter") then
					addEmitter(descendant)
				end
			end
		end
	end

	return #targets &gt; 0 and targets or nil
end

local function isRigCFrameTrack(track)
	return track
		and track.targetScope == "RigProperty"
		and track.propertyName == "CFrame"
end

local function getRigRootPart(instance)
	if not (instance and instance.Parent and instance:IsA("Model")) then
		return nil
	end
	local rootPart = instance:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	for _, rootName in ipairs({ "Torso", "LowerTorso", "UpperTorso" }) do
		local torsoPart = instance:FindFirstChild(rootName)
		if torsoPart and torsoPart:IsA("BasePart") then
			return torsoPart
		end
	end
	local primaryPart = instance.PrimaryPart
	if primaryPart and primaryPart.Parent and primaryPart:IsA("BasePart") then
		return primaryPart
	end
	return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getRigGroupTrackPath(rigName)
	return string.format("riggroup:%s", tostring(rigName or "Rig"))
end

local function getSavedTrackRigName(track)
	if not track then
		return nil
	end
	if track.trackType == "Rig" then
		if type(track.rigName) == "string" and track.rigName ~= "" then
			return track.rigName
		end
		if type(track.path) == "string" then
			return string.match(track.path, "^([^/]+)/")
		end
	elseif track.trackType == "Rig Group" then
		return track.rigName or track.part0
	elseif track.trackType == "Rig Property" then
		return track.rigName or track.part0
	end
	return nil
end

local function getRigRelativePath(path, rigName)
	if type(path) ~= "string" or type(rigName) ~= "string" or rigName == "" then
		return nil
	end
	local prefix = rigName .. "/"
	if string.sub(path, 1, #prefix) ~= prefix then
		return nil
	end
	return string.sub(path, #prefix + 1)
end

local function getFirstTrackableDescendant(instance)
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("Motor6D") then
		return instance.Part1
	end

	if instance:IsA("BasePart") then
		return instance
	end

	if instance:IsA("Model") then
		if instance.PrimaryPart then
			return instance.PrimaryPart
		end
		return instance:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function resolveRigPropertyInstance(track)
	if not track then
		return nil
	end

	local instance = track.instance
	if instance and instance.Parent then
		return instance
	end

	local rig = track.rig
	if rig and rig.Parent then
		return rig
	end

	local rigName = track.rigName or (track.targetScope == "RigProperty" and track.part0)
	if type(rigName) == "string" and rigName ~= "" then
		local found = workspace:FindFirstChild(rigName, true)
		if found and found.Parent and (found:IsA("Model") or found:IsA("BasePart") or found:IsA("Motor6D")) then
			return found
		end
	end

	return nil
end

local function getRigPropertyBaseParts(track)
	local instance = resolveRigPropertyInstance(track)
	if not instance or not instance.Parent then
		return {}
	end

	local parts = {}
	if instance:IsA("Motor6D") then
		local part = instance.Part1
		if part and part.Parent and part:IsA("BasePart") then
			parts[1] = part
		end
		return parts
	end
	if instance:IsA("BasePart") then
		parts[1] = instance
		return parts
	end

	if instance:IsA("Model") then
		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
				table.insert(parts, descendant)
			end
		end
	end

	return parts
end

local PART_SCALE_MIN_SIZE = 0.001
local PART_SCALE_EPSILON = 0.0001

local function getBasePartScaleTarget(track)
	local instance = track and track.instance
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("Motor6D") then
		local part = instance.Part1
		return part and part.Parent and part:IsA("BasePart") and part or nil
	end

	return instance:IsA("BasePart") and instance or nil
end

local function getBasePartScaleOriginalSize(track, part)
	if track then
		if typeof(track.originalValue) == "Vector3" then
			return track.originalValue
		end
		if typeof(track.originalSize) == "Vector3" then
			return track.originalSize
		end
	end
	return part and part.Size or nil
end

local function getBasePartScaleValue(track)
	local part = getBasePartScaleTarget(track)
	local originalSize = getBasePartScaleOriginalSize(track, part)
	if not part or typeof(originalSize) ~= "Vector3" then
		return nil
	end

	local currentSize = part.Size
	local total = 0
	local count = 0
	if math.abs(originalSize.X) &gt; PART_SCALE_EPSILON then
		total += currentSize.X / originalSize.X
		count += 1
	end
	if math.abs(originalSize.Y) &gt; PART_SCALE_EPSILON then
		total += currentSize.Y / originalSize.Y
		count += 1
	end
	if math.abs(originalSize.Z) &gt; PART_SCALE_EPSILON then
		total += currentSize.Z / originalSize.Z
		count += 1
	end

	return count &gt; 0 and (total / count) or 1
end

local function applyBasePartScaleValue(track, value)
	local part = getBasePartScaleTarget(track)
	if not part then
		return false
	end

	if typeof(value) == "Vector3" then
		local success = pcall(function()
			part.Size = Vector3.new(
				math.max(value.X, PART_SCALE_MIN_SIZE),
				math.max(value.Y, PART_SCALE_MIN_SIZE),
				math.max(value.Z, PART_SCALE_MIN_SIZE)
			)
		end)
		return success
	end

	if type(value) ~= "number" then
		return false
	end

	local originalSize = getBasePartScaleOriginalSize(track, part)
	if typeof(originalSize) ~= "Vector3" then
		return false
	end

	local scale = math.max(value, PART_SCALE_MIN_SIZE)
	local success = pcall(function()
		part.Size = Vector3.new(
			math.max(originalSize.X * scale, PART_SCALE_MIN_SIZE),
			math.max(originalSize.Y * scale, PART_SCALE_MIN_SIZE),
			math.max(originalSize.Z * scale, PART_SCALE_MIN_SIZE)
		)
	end)
	return success
end

local function isDecalLikeInstance(instance)
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("Decal") or instance:IsA("Texture"))
end

local function isLightLikeInstance(instance)
	return instance ~= nil
		and instance.Parent ~= nil
		and (instance:IsA("PointLight") or instance:IsA("SpotLight") or instance:IsA("SurfaceLight"))
end

local function isPostEffectLikeInstance(instance)
	return PropertyKeyframeValueService.isPostEffectInstance(instance)
end

local function isTextGuiLikeInstance(instance)
	return PropertyKeyframeValueService.isTextGuiInstance(instance)
end

local DISCRETE_OBJECT_PROPERTIES = {
	Enabled = true,
	Shadows = true,
	Text = true,
	Visible = true,
}

local function isDiscreteObjectPropertyTrack(track)
	return track ~= nil
		and track.targetScope == "ObjectProperty"
		and DISCRETE_OBJECT_PROPERTIES[track.propertyName or track.name] == true
		and (isLightLikeInstance(track.instance) or isPostEffectLikeInstance(track.instance) or isTextGuiLikeInstance(track.instance))
end

local function getDefaultKeyOptionsForTrack(track)
	return {
		easingStyle = isDiscreteObjectPropertyTrack(track) and "None" or DEFAULT_EASING_STYLE,
		easingDirection = DEFAULT_EASING_DIRECTION,
	}
end

local function getLightPropertyValue(instance, propertyName)
	if not isLightLikeInstance(instance) then
		return nil
	end
	local success, value = pcall(function()
		return instance[propertyName]
	end)
	if success then
		return value
	end
	return nil
end

local function applyLightPropertyValue(instance, propertyName, value)
	if not isLightLikeInstance(instance) then
		return false
	end
	local success = pcall(function()
		instance[propertyName] = value
	end)
	return success == true
end

local function getPostEffectPropertyValue(instance, propertyName)
	if not isPostEffectLikeInstance(instance) then
		return nil
	end
	local success, value = pcall(function()
		return instance[propertyName]
	end)
	if success then
		return value
	end
	return nil
end

local function applyPostEffectPropertyValue(instance, propertyName, value)
	if not isPostEffectLikeInstance(instance) then
		return false
	end
	local success = pcall(function()
		instance[propertyName] = value
	end)
	return success == true
end

local function getTextGuiPropertyValue(instance, propertyName)
	if not isTextGuiLikeInstance(instance) then
		return nil
	end
	local success, value = pcall(function()
		return instance[propertyName]
	end)
	if success then
		return value
	end
	return nil
end

local function applyTextGuiPropertyValue(instance, propertyName, value)
	if not isTextGuiLikeInstance(instance) then
		return false
	end

	local success = false
	if propertyName == "Text" and type(value) == "string" then
		success = pcall(function()
			instance.Text = value
		end)
	elseif (propertyName == "TextColor3" or propertyName == "TextStrokeColor3" or propertyName == "BackgroundColor3") and typeof(value) == "Color3" then
		success = pcall(function()
			instance[propertyName] = value
		end)
	elseif propertyName == "Visible" and type(value) == "boolean" then
		success = pcall(function()
			instance.Visible = value
		end)
	elseif propertyName == "MaxVisibleGraphemes" and type(value) == "number" then
		success = pcall(function()
			instance.MaxVisibleGraphemes = math.floor(math.clamp(value, -1, 100000) + 0.5)
		end)
	elseif propertyName == "TextSize" and type(value) == "number" then
		success = pcall(function()
			instance.TextSize = math.clamp(value, 1, 1000)
		end)
	elseif (propertyName == "TextTransparency" or propertyName == "TextStrokeTransparency" or propertyName == "BackgroundTransparency") and type(value) == "number" then
		success = pcall(function()
			instance[propertyName] = math.clamp(value, 0, 1)
		end)
	end

	return success == true
end

local function getDecalPropertyValue(instance, propertyName)
	if not isDecalLikeInstance(instance) then
		return nil
	end

	if propertyName == "Transparency" then
		return instance.Transparency
	elseif propertyName == "Color3" then
		return instance.Color3
	elseif propertyName == "Texture" then
		return instance.Texture
	elseif propertyName == "Face" then
		return instance.Face
	end

	return nil
end

local function applyDecalPropertyValue(instance, propertyName, value)
	if not isDecalLikeInstance(instance) then
		return false
	end

	local success = false
	if propertyName == "Transparency" and type(value) == "number" then
		success = pcall(function()
			instance.Transparency = math.clamp(value, 0, 1)
		end)
	elseif propertyName == "Color3" and typeof(value) == "Color3" then
		success = pcall(function()
			instance.Color3 = value
		end)
	elseif propertyName == "Texture" and type(value) == "string" then
		success = pcall(function()
			instance.Texture = value
		end)
	elseif propertyName == "Face" and typeof(value) == "EnumItem" and value.EnumType == Enum.NormalId then
		success = pcall(function()
			instance.Face = value
		end)
	end

	return success == true
end

local function getTrackTargetCFrame(track)
	if track and track.trackType == "Camera" then
		local camera = workspace.CurrentCamera
		if camera then
			return camera.CFrame
		end
	end

	local instance = track and track.instance
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("Camera") or instance:IsA("BasePart") then
		return instance.CFrame
	end

	if instance:IsA("Model") then
		if isRigCFrameTrack(track) then
			local rootPart = getRigRootPart(instance)
			if rootPart then
				return rootPart.CFrame
			end
		end
		return instance:GetPivot()
	end

	return nil
end

local function applyTrackTargetCFrame(track, cframe)
	if track and track.trackType == "Camera" then
		local camera = workspace.CurrentCamera
		if camera and typeof(cframe) == "CFrame" then
			local originalCameraType = camera.CameraType
			local _, _, zRadians = cframe:ToOrientation()
			if camera.CameraType == Enum.CameraType.Fixed and math.abs(zRadians) &gt; 0.0001 then
				camera.CameraType = Enum.CameraType.Scriptable
			end
			camera.CFrame = cframe
			if originalCameraType and camera.CameraType ~= originalCameraType then
				camera.CameraType = originalCameraType
			end
			return true
		end
	end

	local instance = track and track.instance
	if not instance or not instance.Parent or typeof(cframe) ~= "CFrame" then
		return false
	end

	if instance:IsA("Camera") then
		instance.CFrame = cframe
		return true
	end

	if instance:IsA("BasePart") then
		instance.CFrame = cframe
		return true
	end

	if instance:IsA("Model") then
		if isRigCFrameTrack(track) then
			local rootPart = getRigRootPart(instance)
			if rootPart then
				instance:PivotTo(cframe * rootPart.CFrame:Inverse() * instance:GetPivot())
				return true
			end
		end
		instance:PivotTo(cframe)
		return true
	end

	return false
end

local function getCameraTrackValue(track)
	local camera = workspace.CurrentCamera
	if not camera then
		local instance = track and track.instance
		if instance and instance.Parent and instance:IsA("Camera") then
			camera = instance
		end
	end

	if not camera then
		return nil
	end

	return {
		cframe = camera.CFrame,
		focus = camera.Focus,
		fieldOfView = camera.FieldOfView,
	}
end

local function applyCameraTrackValue(track, value)
	local camera = workspace.CurrentCamera
	if not camera then
		local instance = track and track.instance
		if instance and instance.Parent and instance:IsA("Camera") then
			camera = instance
		end
	end

	if not camera then
		return false
	end

	if typeof(value) == "CFrame" then
		local originalCameraType = camera.CameraType
		local _, _, zRadians = value:ToOrientation()
		if camera.CameraType == Enum.CameraType.Fixed and math.abs(zRadians) &gt; 0.0001 then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		camera.CFrame = value
		if originalCameraType and camera.CameraType ~= originalCameraType then
			camera.CameraType = originalCameraType
		end
		return true
	end

	if type(value) ~= "table" then
		return false
	end

	local applied = false
	local cframe = value.cframe or value.CFrame
	if typeof(cframe) == "CFrame" then
		local originalCameraType = camera.CameraType
		local _, _, zRadians = cframe:ToOrientation()
		if camera.CameraType == Enum.CameraType.Fixed and math.abs(zRadians) &gt; 0.0001 then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		camera.CFrame = cframe
		if originalCameraType and camera.CameraType ~= originalCameraType then
			camera.CameraType = originalCameraType
		end
		applied = true
	end

	local focus = value.focus or value.Focus
	if typeof(focus) == "CFrame" then
		camera.Focus = focus
		applied = true
	end

	local fieldOfView = value.fieldOfView or value.FieldOfView
	if type(fieldOfView) == "number" then
		camera.FieldOfView = math.clamp(fieldOfView, 1, 120)
		applied = true
	end

	return applied
end

local function getGenericTrackValue(track)
	if not track then
		return nil
	end

	if track.trackType == "Camera" then
		return getCameraTrackValue(track)
	end

	if track.valueType == "Event" then
		return {
			name = track.name,
			payload = "",
		}
	end

	if track.valueType == "Face" then
		local rig = track.rig
		if not (rig and rig.Parent) and track.rigName then
			local candidate = workspace:FindFirstChild(track.rigName, true)
			rig = candidate and candidate:IsA("Model") and candidate or nil
		end
		return FaceRigAdapter.CaptureFaceState(rig)
	end

	if SoundTimelineService.isSoundTrack(track) then
		return SoundTimelineService.capture(track.instance)
	end

	if ScreenEffectTrackService.isScreenEffectTrack(track) then
		return ScreenEffectTrackService.getDefaultValueForTrack(track)
	end

	if LightingEffectTrackService.isLightingEffectTrack(track) then
		return LightingEffectTrackService.getDefaultValueForTrack(track)
	end

	if track.targetScope == "CameraProperty" then
		local camera = workspace.CurrentCamera
		if not camera then
			return nil
		end
		if track.propertyName == "FieldOfView" then
			return camera.FieldOfView
		end
		return nil
	end

	if track.valueType == "Emitter" then
		local instance = track.instance
		if instance and instance.Parent then
			return {
				enabled = instance.Enabled,
				rate = instance.Rate,
			}
		end
		return nil
	end

	if track.targetScope == "ObjectProperty" and ParticleEmitterPropertyService.isParticleEmitter(track.instance) then
		return ParticleEmitterPropertyService.getProperty(track.instance, track.propertyName)
	end

	if track.targetScope == "ObjectProperty" and isDecalLikeInstance(track.instance) then
		return getDecalPropertyValue(track.instance, track.propertyName)
	end

	if track.targetScope == "ObjectProperty" and isLightLikeInstance(track.instance) then
		return getLightPropertyValue(track.instance, track.propertyName)
	end

	if track.targetScope == "ObjectProperty" and isPostEffectLikeInstance(track.instance) then
		return getPostEffectPropertyValue(track.instance, track.propertyName)
	end

	if track.targetScope == "ObjectProperty" and isTextGuiLikeInstance(track.instance) then
		return getTextGuiPropertyValue(track.instance, track.propertyName)
	end

	if track.targetScope == "EmitterGroupProperty" then
		return ParticleEmitterGroupService.getFirstProperty(track, track.propertyName)
	end

	if isOneShotParticleEventTrack(track) then
		local actionName = track.eventName or track.propertyName or track.name or "Emit"
		return {
			actionName = actionName,
			emitCount = actionName == "Emit" and 10 or nil,
		}
	end

	if track.targetScope == "RigProperty" or track.targetScope == "ObjectProperty" then
		if track.propertyName == "CFrame" then
			return getTrackTargetCFrame(track)
		elseif track.propertyName == "Scale" then
			local instance = resolveRigPropertyInstance(track)
			if instance and instance.Parent and instance:IsA("Model") then
				local success, value = pcall(function()
					return instance:GetScale()
				end)
				if success then
					return value
				end
			end
			return getBasePartScaleValue(track)
		elseif track.propertyName == "Transparency" then
			local part = getRigPropertyBaseParts(track)[1]
			return part and part.Transparency or nil
		elseif track.propertyName == "Color" then
			local part = getRigPropertyBaseParts(track)[1]
			return part and part.Color or nil
		elseif track.propertyName == "Reflectance" then
			local part = getRigPropertyBaseParts(track)[1]
			return part and part.Reflectance or nil
		end
	end

	if track.valueType == "Transparency" then
		local instance = getFirstTrackableDescendant(track.instance) or track.instance
		if instance and instance.Parent then
			local success, value = pcall(function()
				return instance.Transparency
			end)
			if success then
				return value
			end
		end
		return nil
	end

	return getTrackTargetCFrame(track)
end

local function applyGenericTrackValue(track, value)
	if not track or value == nil then
		return false
	end

	if track.trackType == "Camera" then
		return applyCameraTrackValue(track, value)
	end

	if track.valueType == "Face" then
		local rig = track.rig
		if not (rig and rig.Parent) and track.rigName then
			local candidate = workspace:FindFirstChild(track.rigName, true)
			rig = candidate and candidate:IsA("Model") and candidate or nil
		end
		return rig ~= nil and FaceRigAdapter.RestoreFaceState(rig, value) or false
	end

	if SoundTimelineService.isSoundTrack(track) then
		return SoundTimelineService.apply(track.instance, value)
	end

	if track.valueType == "Transparency"
		and track.targetScope ~= "RigProperty"
		and track.targetScope ~= "ObjectProperty"
		and track.instance
		and track.instance.Parent
	then
		local instance = getFirstTrackableDescendant(track.instance) or track.instance
		local success = pcall(function()
			instance.Transparency = math.clamp(tonumber(value) or 0, 0, 1)
		end)
		return success
	end

	if track.valueType == "Emitter" and track.instance and track.instance.Parent and type(value) == "table" then
		track.instance.Enabled = value.enabled == true
		if type(value.rate) == "number" then
			track.instance.Rate = value.rate
		end
		return true
	end

	if ScreenEffectTrackService.isScreenEffectTrack(track) then
		return true
	end

	if LightingEffectTrackService.isLightingEffectTrack(track) then
		return LightingEffectTrackService.applyTrackValue(track, value)
	end

	if track.targetScope == "CameraProperty" then
		local camera = workspace.CurrentCamera
		if not camera then
			return false
		end
		if track.propertyName == "FieldOfView" and type(value) == "number" then
			camera.FieldOfView = math.clamp(value, 1, 120)
			return true
		end
		return false
	end

	if track.targetScope == "ObjectProperty" and ParticleEmitterPropertyService.isParticleEmitter(track.instance) then
		return ParticleEmitterPropertyService.applyProperty(track.instance, track.propertyName, value)
	end

	if track.targetScope == "ObjectProperty" and isDecalLikeInstance(track.instance) then
		return applyDecalPropertyValue(track.instance, track.propertyName, value)
	end

	if track.targetScope == "ObjectProperty" and isLightLikeInstance(track.instance) then
		return applyLightPropertyValue(track.instance, track.propertyName, value)
	end

	if track.targetScope == "ObjectProperty" and isPostEffectLikeInstance(track.instance) then
		return applyPostEffectPropertyValue(track.instance, track.propertyName, value)
	end

	if track.targetScope == "ObjectProperty" and isTextGuiLikeInstance(track.instance) then
		return applyTextGuiPropertyValue(track.instance, track.propertyName, value)
	end

	if track.targetScope == "EmitterGroupProperty" then
		local success = ParticleEmitterGroupService.applyProperty(track, track.propertyName, value)
		return success
	end

	if track.targetScope == "RigProperty" or track.targetScope == "ObjectProperty" then
		if track.propertyName == "CFrame" then
			return applyTrackTargetCFrame(track, value)
		elseif track.propertyName == "Scale" then
			local instance = resolveRigPropertyInstance(track)
			if instance and instance.Parent and instance:IsA("Model") and type(value) == "number" then
				local success = pcall(function()
					instance:ScaleTo(value)
				end)
				return success
			end
			return applyBasePartScaleValue(track, value)
		elseif track.propertyName == "Transparency" then
			local changed = 0
			for _, part in ipairs(getRigPropertyBaseParts(track)) do
				local success = pcall(function()
					part.Transparency = math.clamp(tonumber(value) or 0, 0, 1)
				end)
				if success then
					changed += 1
				end
			end
			return changed &gt; 0
		elseif track.propertyName == "Color" then
			local changed = 0
			for _, part in ipairs(getRigPropertyBaseParts(track)) do
				local success = typeof(value) == "Color3" and pcall(function()
					part.Color = value
				end)
				if success then
					changed += 1
				end
			end
			return changed &gt; 0
		elseif track.propertyName == "Reflectance" then
			local changed = 0
			for _, part in ipairs(getRigPropertyBaseParts(track)) do
				local success = pcall(function()
					part.Reflectance = math.clamp(tonumber(value) or 0, 0, 1)
				end)
				if success then
					changed += 1
				end
			end
			return changed &gt; 0
		end
	end

	return applyTrackTargetCFrame(track, value)
end

local function isScalePropertyTrack(track)
	return track ~= nil
		and (track.targetScope == "RigProperty" or track.targetScope == "ObjectProperty")
		and track.propertyName == "Scale"
end

local function restoreGenericTrackOriginalValue(track)
	if not track or track.originalValue == nil then
		return false
	end

	local success, restored = pcall(function()
		return applyGenericTrackValue(track, cloneValue(track.originalValue))
	end)
	return success and restored == true
end

local function trackBelongsToRig(track, rig)
	if not rig then
		return true
	end
	return track ~= nil
		and (track.rig == rig or track.instance == rig or track.rigName == rig.Name)
end

local function restoreOriginalScaleTracks(genericTracks, rig)
	local appliedCount = 0
	for _, track in ipairs(genericTracks or {}) do
		if isScalePropertyTrack(track) and trackBelongsToRig(track, rig) and restoreGenericTrackOriginalValue(track) then
			appliedCount += 1
		end
	end
	return appliedCount
end

local function applyScaleTracksFromPose(genericTracks, pose)
	local appliedPaths = {}
	local appliedCount = 0
	for _, track in ipairs(genericTracks or {}) do
		local value = pose and pose[track.path]
		if value ~= nil and isScalePropertyTrack(track) then
			appliedPaths[track.path] = true
			if applyGenericTrackValue(track, cloneValue(value)) then
				appliedCount += 1
			end
		end
	end
	return appliedCount, appliedPaths
end

local function getTrackDisplayName(track)
	return string.lower(tostring((track and (track.part1 or track.name or track.propertyName or track.path)) or ""))
end

local function compareTracksByName(a, b)
	local aName = getTrackDisplayName(a)
	local bName = getTrackDisplayName(b)
	if aName ~= bName then
		return aName &lt; bName
	end
	return tostring(a.path) &lt; tostring(b.path)
end

local function applyTrackVisualOrder(tracks, orderMap)
	if type(tracks) ~= "table" or type(orderMap) ~= "table" then
		return
	end

	local indexed = {}
	for index, track in ipairs(tracks) do
		indexed[index] = {
			index = index,
			order = track and track.path and tonumber(orderMap[track.path]) or nil,
			track = track,
		}
	end
	table.sort(indexed, function(a, b)
		if a.order and b.order and a.order ~= b.order then
			return a.order &lt; b.order
		end
		if a.order and not b.order then
			return true
		end
		if b.order and not a.order then
			return false
		end
		return a.index &lt; b.index
	end)
	for index, entry in ipairs(indexed) do
		tracks[index] = entry.track
	end
end

local DEFAULT_GENERIC_TRACK_SORT_ORDERS = {
	["Screen Effect"] = 3,
	["Lighting Effect"] = 3,
	Camera = 5,
	CameraProperty = 6,
	["Camera Property"] = 6,
	["Rig CFrame"] = 6,
	Face = 7,
	Sound = 11,
	EmitterGroup = 8,
	["Emitter Group"] = 8,
	EmitterGroupProperty = 9,
	["Emitter Group Property"] = 9,
	ParticleEvent = 9,
	["Particle Event"] = 9,
	Folder = 2,
	Model = 10,
	Object = 12,
	Event = 30,
}

function isOneShotParticleEventTrack(track)
	return track ~= nil and (track.valueType == "ParticleEvent" or track.targetScope == "ParticleEvent")
end

function isOneShotSoundTrack(track)
	return SoundTimelineService.isSoundTrack(track)
end

function TimelineModel.new(fps, durationFrames)
	local self = setmetatable({}, TimelineModel)
	self._animationName = "Untitled Animation"
	self._fps = fps
	self._durationFrames = durationFrames
	self._currentFrame = 0
	self._looping = false
	self._priority = "Action"
	self._rig = nil
	self._rigs = {}
	self._motors = {}
	self._genericTracks = {}
	self._nextTrackId = 1
	self._originalPose = {}
	self._frames = {}
	self._keyOptions = {}
	self._disabledTrackPaths = {}
	self._suppressedApplyPaths = {}
	self._trackFolderPaths = {}
	self._trackVisualOrder = {}
	return self
end

function TimelineModel:reset(fps, durationFrames)
	self:resetOriginalState()
	self._animationName = "Untitled Animation"
	self._fps = fps or self._fps
	self._durationFrames = durationFrames or self._durationFrames
	self._currentFrame = 0
	self._looping = false
	self._priority = "Action"
	self._rig = nil
	self._rigs = {}
	self._motors = {}
	self._genericTracks = {}
	self._nextTrackId = 1
	self._originalPose = {}
	self._frames = {}
	self._keyOptions = {}
	self._disabledTrackPaths = {}
	self._suppressedApplyPaths = {}
	self._trackFolderPaths = {}
	self._trackVisualOrder = {}
	return true
end

function TimelineModel:_getNextTopTrackVisualOrder()
	local minOrder = nil
	for _, order in pairs(self._trackVisualOrder or {}) do
		local numericOrder = tonumber(order)
		if numericOrder and (not minOrder or numericOrder &lt; minOrder) then
			minOrder = numericOrder
		end
	end
	return (minOrder or 10) - 10
end

function TimelineModel:_placeTrackAtTop(path)
	if not path or path == "" then
		return nil
	end
	self._trackVisualOrder = self._trackVisualOrder or {}
	local order = self:_getNextTopTrackVisualOrder()
	self._trackVisualOrder[path] = order
	return order
end

function TimelineModel:_getNextBottomTrackVisualOrder()
	local maxOrder = nil
	for _, order in pairs(self._trackVisualOrder or {}) do
		local numericOrder = tonumber(order)
		if numericOrder and (not maxOrder or numericOrder &gt; maxOrder) then
			maxOrder = numericOrder
		end
	end
	return (maxOrder or 10) + 10
end

function TimelineModel:_placeTrackAtBottom(path)
	if not path or path == "" then
		return nil
	end
	self._trackVisualOrder = self._trackVisualOrder or {}
	local order = self:_getNextBottomTrackVisualOrder()
	self._trackVisualOrder[path] = order
	return order
end

function TimelineModel:bindRig(rig, rigData)
	self._rig = rig
	self._rigs = rig and { rig } or {}
	self._motors = cloneValue(rigData.motors or {})
	self._originalPose = cloneValue(rigData.originalPose or {})
	self._frames = {}
	self._currentFrame = 0
	if rig and rig.Name and not self:getRigPropertyTrack(rig.Name, "CFrame") then
		self:addGenericTrack("RigProperty", rig, "CFrame", {
			rig = rig,
			rigName = rig.Name,
			propertyName = "CFrame",
			targetScope = "RigProperty",
			sortOrder = 1,
		})
	end
	if rig and rig.Name then
		self:_placeTrackAtBottom(getRigGroupTrackPath(rig.Name))
	end
end

function TimelineModel:addRig(rig, rigData)
	if not rig or not rigData or type(rigData) ~= "table" then
		return false, "Select a valid rig before adding it."
	end

	for _, existingRig in ipairs(self._rigs) do
		if existingRig == rig then
			return false, string.format("Rig '%s' is already in the timeline.", rig.Name)
		end
	end

	local existingPaths = {}
	for _, motorData in ipairs(self._motors) do
		existingPaths[motorData.path] = true
	end

	local addedCount = 0
	for _, motorData in ipairs(rigData.motors or {}) do
		if existingPaths[motorData.path] then
			return false, string.format("Rig '%s' conflicts with an existing track path. Give each rig a unique name.", rig.Name)
		end
		table.insert(self._motors, cloneValue(motorData))
		existingPaths[motorData.path] = true
		addedCount += 1
	end

	for path, originalPose in pairs(rigData.originalPose or {}) do
		self._originalPose[path] = cloneValue(originalPose)
	end

	table.insert(self._rigs, rig)
	self._rig = rig
	if rig.Name and not self:getRigPropertyTrack(rig.Name, "CFrame") then
		self:addGenericTrack("RigProperty", rig, "CFrame", {
			rig = rig,
			rigName = rig.Name,
			propertyName = "CFrame",
			targetScope = "RigProperty",
			sortOrder = 1,
		})
	end
	if rig.Name then
		self:_placeTrackAtBottom(getRigGroupTrackPath(rig.Name))
	end
	return addedCount &gt; 0, string.format("Added rig '%s' with %d joints.", rig.Name, addedCount)
end

function TimelineModel:createSnapshot()
	return {
		animationName = self._animationName,
		fps = self._fps,
		durationFrames = self._durationFrames,
		currentFrame = self._currentFrame,
		looping = self._looping,
		priority = self._priority,
		rig = self._rig or false,
		rigs = cloneValue(self._rigs),
		motors = cloneValue(self._motors),
		originalPose = cloneValue(self._originalPose),
		genericTracks = cloneGenericTracks(self._genericTracks),
		nextTrackId = self._nextTrackId,
		frames = cloneFrames(self._frames),
		keyOptions = cloneKeyOptions(self._keyOptions),
		disabledTrackPaths = cloneValue(self._disabledTrackPaths),
		trackFolderPaths = cloneValue(self._trackFolderPaths),
		trackVisualOrder = cloneValue(self._trackVisualOrder),
	}
end

function TimelineModel:restoreSnapshot(snapshot)
	if not snapshot then
		return false
	end

	self._fps = snapshot.fps or self._fps
	self._animationName = snapshot.animationName or self._animationName
	self._durationFrames = snapshot.durationFrames or self._durationFrames
	self._currentFrame = snapshot.currentFrame or self._currentFrame
	self._looping = snapshot.looping == nil and self._looping or snapshot.looping
	self._priority = snapshot.priority or self._priority
	if snapshot.rig ~= nil then
		self._rig = snapshot.rig ~= false and snapshot.rig or nil
	end
	self._rigs = cloneValue(snapshot.rigs or (self._rig and { self._rig } or {}))
	self._motors = cloneValue(snapshot.motors or self._motors)
	self._originalPose = cloneValue(snapshot.originalPose or self._originalPose)
	self._genericTracks = cloneGenericTracks(snapshot.genericTracks or self._genericTracks)
	self._nextTrackId = snapshot.nextTrackId or self._nextTrackId
	self._frames = cloneFrames(snapshot.frames or {})
	self._keyOptions = cloneKeyOptions(snapshot.keyOptions or {})
	self._disabledTrackPaths = cloneValue(snapshot.disabledTrackPaths or {})
	self._trackFolderPaths = cloneValue(snapshot.trackFolderPaths or {})
	self._trackVisualOrder = cloneValue(snapshot.trackVisualOrder or {})
	return true
end

function TimelineModel:getAnimationName()
	return self._animationName
end

function TimelineModel:renameAnimation(name)
	if type(name) ~= "string" then
		return false
	end

	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	if name == "" then
		return false
	end

	self._animationName = name
	return true
end

function TimelineModel:getRig()
	if self._rig and self._rig.Parent then
		return self._rig
	end
	for _, rig in ipairs(self._rigs or {}) do
		if rig and rig.Parent then
			return rig
		end
	end
	return self._rig
end

function TimelineModel:setActiveRig(rigOrName)
	if not rigOrName then
		return false, "Select a rig before making it active."
	end

	for _, rig in ipairs(self._rigs or {}) do
		if rig == rigOrName or rig.Name == rigOrName then
			if not rig.Parent then
				return false, string.format("Rig '%s' is no longer in Workspace.", rig.Name)
			end
			self._rig = rig
			return true, string.format("Using rig '%s' for Motion Builder.", rig.Name)
		end
	end

	return false, "That rig is not in the timeline yet."
end

function TimelineModel:getRigs()
	local rigs = {}
	for _, rig in ipairs(self._rigs or {}) do
		if rig then
			table.insert(rigs, rig)
		end
	end
	return rigs
end

function TimelineModel:getMotors()
	return self._motors
end

function TimelineModel:syncRigMotorsFromWorkspace(options)
	options = options or {}
	self._motors = self._motors or {}
	self._originalPose = self._originalPose or {}

	local existingPaths = {}
	for _, motorData in ipairs(self._motors) do
		if motorData and motorData.path then
			existingPaths[motorData.path] = true
		end
	end

	local addedCount = 0
	for _, rig in ipairs(self._rigs or {}) do
		if rig and rig.Parent then
			local rigData = RigService.describeRig(rig)
			for _, motorData in ipairs(rigData.motors or {}) do
				local isAllowed = options.bonesOnly ~= true or RigService.isBoneJoint(motorData)
				if isAllowed and motorData.path and not existingPaths[motorData.path] then
					table.insert(self._motors, cloneValue(motorData))
					existingPaths[motorData.path] = true
					addedCount += 1
					if rigData.originalPose and rigData.originalPose[motorData.path] ~= nil then
						self._originalPose[motorData.path] = cloneValue(rigData.originalPose[motorData.path])
					end
				end
			end
		end
	end

	if addedCount &gt; 0 then
		table.sort(self._motors, function(a, b)
			return tostring(a and a.path or "") &lt; tostring(b and b.path or "")
		end)
	end

	return addedCount
end

function TimelineModel:getOriginalPose(path)
	return self._originalPose[path]
end

function TimelineModel:_normalizeRigTrackValueForStorage(path, value)
	if typeof(value) ~= "CFrame" then
		return value
	end

	local motorData = self:getMotorByPath(path)
	if not motorData then
		return value
	end

	return normalizeRigCFrameForStorage(value, self._originalPose[path], getRigScaleRatio(motorData))
end

function TimelineModel:_captureRigPoseForStorage()
	local pose = {}
	for _, motorData in ipairs(self._motors) do
		local value = RigService.getJointPose(motorData)
		if value then
			pose[motorData.path] = self:_normalizeRigTrackValueForStorage(motorData.path, value)
		end
	end
	return pose
end

function TimelineModel:_buildScaledRigPoseForApply(pose)
	local scaledPose = {}
	for _, motorData in ipairs(self._motors) do
		local value = pose and pose[motorData.path]
		if typeof(value) == "CFrame" then
			scaledPose[motorData.path] = scaleRigCFrameForApply(value, self._originalPose[motorData.path], getRigScaleRatio(motorData))
		end
	end
	return scaledPose
end

function TimelineModel:getTracks()
	local tracks = {}
	local rigBuckets = {}
	local rigOrder = {}
	local rigParentInfoByPath = {}

	for _, rig in ipairs(self._rigs) do
		if rig then
			local rigName = rig.Name
			rigBuckets[rigName] = rigBuckets[rigName] or {
				rig = rig,
				properties = {},
				joints = {},
			}
			table.insert(rigOrder, rigName)
		end
	end

	for _, motorData in ipairs(self._motors) do
		local rigName = motorData.rigName or (motorData.rig and motorData.rig.Name) or "Rig"
		local bucket = rigBuckets[rigName]
		if not bucket then
			bucket = {
				rig = motorData.rig,
				properties = {},
				joints = {},
			}
			rigBuckets[rigName] = bucket
			table.insert(rigOrder, rigName)
		end
		table.insert(bucket.joints, {
			path = motorData.path,
			name = motorData.name,
			part0 = motorData.part0,
			part1 = motorData.part1,
			rig = motorData.rig,
			rigName = rigName,
			instance = motorData.instance,
			trackType = "Rig",
			valueType = "CFrame",
			jointType = motorData.jointType or "Motor6D",
			isBone = motorData.isBone == true,
			parentTrackPath = motorData.parentTrackPath,
			sortOrder = 20,
			visualOrder = self._trackVisualOrder[motorData.path],
			folderPath = self._trackFolderPaths[motorData.path] or self._trackFolderPaths[getRigGroupTrackPath(rigName)],
			disabled = self._disabledTrackPaths[motorData.path] == true,
		})
		rigParentInfoByPath[motorData.path] = {
			rig = motorData.rig,
			rigName = rigName,
			partName = motorData.part1 or motorData.name,
		}
	end

	local genericTracks = {}
	local objectPropertyBuckets = {}
	local cameraProperties = {}
	for _, track in ipairs(self._genericTracks) do
		local clonedTrack = cloneValue(track)
		clonedTrack.disabled = self._disabledTrackPaths[track.path] == true
		clonedTrack.folderPath = self._trackFolderPaths[track.path] or clonedTrack.folderPath
		clonedTrack.visualOrder = self._trackVisualOrder[track.path]
		local parentRigInfo = clonedTrack.parentTrackPath and rigParentInfoByPath[clonedTrack.parentTrackPath]
		if parentRigInfo and (clonedTrack.targetScope == "ObjectProperty" or clonedTrack.targetScope == "Face") then
			clonedTrack.rig = clonedTrack.rig or parentRigInfo.rig
			clonedTrack.rigName = clonedTrack.rigName or parentRigInfo.rigName
			clonedTrack.parentTrackName = clonedTrack.parentTrackName or parentRigInfo.partName
		end
		if clonedTrack.targetScope == "RigProperty" and clonedTrack.rigName then
			local bucket = rigBuckets[clonedTrack.rigName]
			if not bucket then
				bucket = {
					rig = clonedTrack.rig,
					properties = {},
					joints = {},
				}
				rigBuckets[clonedTrack.rigName] = bucket
				table.insert(rigOrder, clonedTrack.rigName)
			end
			table.insert(bucket.properties, clonedTrack)
	elseif ((clonedTrack.targetScope == "ObjectProperty"
		or clonedTrack.targetScope == "EmitterGroupProperty"
		or clonedTrack.targetScope == "ParticleEvent"
		or clonedTrack.targetScope == "Face")
		or (clonedTrack.trackType == "Lighting Effect" and clonedTrack.parentTrackPath))
		and clonedTrack.parentTrackPath then
		objectPropertyBuckets[clonedTrack.parentTrackPath] = objectPropertyBuckets[clonedTrack.parentTrackPath] or {}
		table.insert(objectPropertyBuckets[clonedTrack.parentTrackPath], clonedTrack)
		elseif clonedTrack.targetScope == "CameraProperty" then
			table.insert(cameraProperties, clonedTrack)
		else
			table.insert(genericTracks, clonedTrack)
		end
	end

	local function appendObjectPropertyTracks(parentPath, inheritedFolderPath)
		local propertyTracks = objectPropertyBuckets[parentPath]
		if not propertyTracks then
			return
		end

		table.sort(propertyTracks, function(a, b)
			if (a.sortOrder or 100) ~= (b.sortOrder or 100) then
				return (a.sortOrder or 100) &lt; (b.sortOrder or 100)
			end
			return compareTracksByName(a, b)
		end)
		applyTrackVisualOrder(propertyTracks, self._trackVisualOrder)
		for _, propertyTrack in ipairs(propertyTracks) do
			propertyTrack.folderPath = propertyTrack.folderPath or inheritedFolderPath
			table.insert(tracks, propertyTrack)
		end
	end

	table.sort(rigOrder, function(a, b)
		local aPath = getRigGroupTrackPath(a)
		local bPath = getRigGroupTrackPath(b)
		local aOrder = self._trackVisualOrder[aPath]
		local bOrder = self._trackVisualOrder[bPath]
		if aOrder ~= nil or bOrder ~= nil then
			aOrder = tonumber(aOrder) or math.huge
			bOrder = tonumber(bOrder) or math.huge
			if aOrder ~= bOrder then
				return aOrder &lt; bOrder
			end
		end
		return tostring(a) &lt; tostring(b)
	end)

	local rigGroupTracks = {}
	for _, rigName in ipairs(rigOrder) do
		local bucket = rigBuckets[rigName]
		if bucket then
			rigGroupTracks[#rigGroupTracks + 1] = {
				path = getRigGroupTrackPath(rigName),
				name = "Rig",
				part0 = rigName,
				part1 = "Rig",
				rig = bucket.rig,
				rigName = rigName,
				trackType = "Rig Group",
				valueType = "Group",
				sortOrder = 10,
				visualOrder = self._trackVisualOrder[getRigGroupTrackPath(rigName)],
				folderPath = self._trackFolderPaths[getRigGroupTrackPath(rigName)],
			}
		end
	end

	table.sort(genericTracks, function(a, b)
		local aOrder = a.sortOrder or DEFAULT_GENERIC_TRACK_SORT_ORDERS[a.trackType] or 100
		local bOrder = b.sortOrder or DEFAULT_GENERIC_TRACK_SORT_ORDERS[b.trackType] or 100
		if aOrder ~= bOrder then
			return aOrder &lt; bOrder
		end
		if a.trackType == b.trackType then
			return compareTracksByName(a, b)
		end
		return tostring(a.trackType) &lt; tostring(b.trackType)
	end)
	applyTrackVisualOrder(genericTracks, self._trackVisualOrder)
	table.sort(cameraProperties, function(a, b)
		if (a.sortOrder or 100) ~= (b.sortOrder or 100) then
			return (a.sortOrder or 100) &lt; (b.sortOrder or 100)
		end
		return compareTracksByName(a, b)
	end)
	applyTrackVisualOrder(cameraProperties, self._trackVisualOrder)

	local topLevelTracks = {}
	for _, track in ipairs(rigGroupTracks) do
		table.insert(topLevelTracks, track)
	end
	for _, track in ipairs(genericTracks) do
		table.insert(topLevelTracks, track)
	end
	table.sort(topLevelTracks, function(a, b)
		local aOrder = a.sortOrder or DEFAULT_GENERIC_TRACK_SORT_ORDERS[a.trackType] or 100
		local bOrder = b.sortOrder or DEFAULT_GENERIC_TRACK_SORT_ORDERS[b.trackType] or 100
		if aOrder ~= bOrder then
			return aOrder &lt; bOrder
		end
		if a.trackType == b.trackType then
			return compareTracksByName(a, b)
		end
		return tostring(a.trackType) &lt; tostring(b.trackType)
	end)
	applyTrackVisualOrder(topLevelTracks, self._trackVisualOrder)

	local insertedCameraProperties = false
	for _, track in ipairs(topLevelTracks) do
		if track.trackType == "Rig Group" and track.rigName then
			local rigName = track.rigName
			local bucket = rigBuckets[rigName]
			if bucket then
				table.sort(bucket.properties, function(a, b)
					if (a.sortOrder or 100) ~= (b.sortOrder or 100) then
						return (a.sortOrder or 100) &lt; (b.sortOrder or 100)
					end
					return compareTracksByName(a, b)
				end)
				applyTrackVisualOrder(bucket.properties, self._trackVisualOrder)
				for _, propertyTrack in ipairs(bucket.properties) do
					propertyTrack.folderPath = propertyTrack.folderPath or self._trackFolderPaths[getRigGroupTrackPath(rigName)]
					table.insert(tracks, propertyTrack)
				end
				table.insert(tracks, track)
				table.sort(bucket.joints, function(a, b)
					return RigTrackHierarchyService.compareRigTracks(a, b, compareTracksByName)
				end)
				applyTrackVisualOrder(bucket.joints, self._trackVisualOrder)
				for _, jointTrack in ipairs(bucket.joints) do
					table.insert(tracks, jointTrack)
					appendObjectPropertyTracks(jointTrack.path, jointTrack.folderPath)
				end
			else
				table.insert(tracks, track)
			end
		else
			table.insert(tracks, track)
			appendObjectPropertyTracks(track.path, track.folderPath)
			if track.trackType == "Camera" and not insertedCameraProperties then
				for _, propertyTrack in ipairs(cameraProperties) do
					table.insert(tracks, propertyTrack)
				end
				insertedCameraProperties = true
			end
		end
	end
	if not insertedCameraProperties then
		for _, propertyTrack in ipairs(cameraProperties) do
			table.insert(tracks, propertyTrack)
		end
	end

	local folderTracks = {}
	local folderByPath = {}
	for _, track in ipairs(tracks) do
		if track.targetScope == "TimelineFolder" then
			folderByPath[track.path] = track
			table.insert(folderTracks, track)
		end
	end
	if #folderTracks &gt; 0 then
		local folderChildren = {}
		local unfiledTracks = {}
		for _, track in ipairs(tracks) do
			if track.targetScope ~= "TimelineFolder" then
				local folderPath = track.folderPath
				if folderPath and folderByPath[folderPath] then
					folderChildren[folderPath] = folderChildren[folderPath] or {}
					table.insert(folderChildren[folderPath], track)
				else
					table.insert(unfiledTracks, track)
				end
			end
		end

		local arranged = {}
		local insertedFolder = {}
		for _, track in ipairs(tracks) do
			if track.targetScope == "TimelineFolder" and not insertedFolder[track.path] then
				insertedFolder[track.path] = true
				table.insert(arranged, track)
				local children = folderChildren[track.path] or {}
				applyTrackVisualOrder(children, self._trackVisualOrder)
				for _, childTrack in ipairs(children) do
					table.insert(arranged, childTrack)
				end
			elseif track.targetScope ~= "TimelineFolder" and not (track.folderPath and folderByPath[track.folderPath]) then
				table.insert(arranged, track)
			end
		end
		tracks = arranged
	end

	return tracks
end

function TimelineModel:getTrackByPath(path)
	for _, rig in ipairs(self._rigs) do
		if path == getRigGroupTrackPath(rig.Name) then
			return {
				path = path,
				name = "Rig",
				part0 = rig.Name,
				part1 = "Rig",
				rig = rig,
				rigName = rig.Name,
				trackType = "Rig Group",
				valueType = "Group",
				sortOrder = 0,
				folderPath = self._trackFolderPaths[path],
				disabled = false,
			}
		end
	end

	for _, motorData in ipairs(self._motors) do
		if motorData.path == path then
			return {
				path = motorData.path,
				name = motorData.name,
				part0 = motorData.part0,
				part1 = motorData.part1,
				rig = motorData.rig,
				rigName = motorData.rigName,
				instance = motorData.instance,
				trackType = "Rig",
				valueType = "CFrame",
				jointType = motorData.jointType or "Motor6D",
				isBone = motorData.isBone == true,
				parentTrackPath = motorData.parentTrackPath,
				sortOrder = 20,
				folderPath = self._trackFolderPaths[motorData.path],
				disabled = self._disabledTrackPaths[motorData.path] == true,
			}
		end
	end

	for _, track in ipairs(self._genericTracks) do
		if track.path == path then
			return track
		end
	end

	return nil
end

function TimelineModel:setSuppressedApplyPaths(paths)
	self._suppressedApplyPaths = paths or {}
end

function TimelineModel:getRigTrackPaths(rigName)
	local paths = {}
	for _, motorData in ipairs(self._motors) do
		if motorData.rigName == rigName then
			table.insert(paths, motorData.path)
		end
	end
	table.sort(paths)
	return paths
end

function TimelineModel:getRigByName(rigName)
	for _, rig in ipairs(self._rigs) do
		if rig and rig.Name == rigName then
			return rig
		end
	end
	return nil
end

function TimelineModel:getRigPropertyTrack(rigName, propertyName)
	for _, track in ipairs(self._genericTracks) do
		if track.targetScope == "RigProperty" and track.rigName == rigName and track.propertyName == propertyName then
			return track
		end
	end
	return nil
end

function TimelineModel:getObjectPropertyTrack(parentTrackPath, propertyName)
	for _, track in ipairs(self._genericTracks) do
		if (track.targetScope == "ObjectProperty" or track.targetScope == "EmitterGroupProperty" or track.targetScope == "ParticleEvent")
			and track.parentTrackPath == parentTrackPath
			and track.propertyName == propertyName then
			return track
		end
	end
	return nil
end

function TimelineModel:getChildPropertyTrackPaths(parentTrackPath)
	local paths = {}
	for _, track in ipairs(self._genericTracks) do
		if (track.targetScope == "ObjectProperty" or track.targetScope == "EmitterGroupProperty" or track.targetScope == "ParticleEvent")
			and track.parentTrackPath == parentTrackPath then
			table.insert(paths, track.path)
		end
	end
	table.sort(paths, function(leftPath, rightPath)
		local leftTrack = self:getTrackByPath(leftPath)
		local rightTrack = self:getTrackByPath(rightPath)
		local leftOrder = leftTrack and tonumber(leftTrack.sortOrder) or 999
		local rightOrder = rightTrack and tonumber(rightTrack.sortOrder) or 999
		if leftOrder ~= rightOrder then
			return leftOrder &lt; rightOrder
		end
		return tostring(leftPath) &lt; tostring(rightPath)
	end)
	return paths
end

function TimelineModel:getRigPropertyTrackState()
	local state = {}
	for _, track in ipairs(self._genericTracks) do
		if track.targetScope == "RigProperty" and track.rigName and track.propertyName then
			state[track.rigName] = state[track.rigName] or {}
			state[track.rigName][track.propertyName] = true
		end
	end
	return state
end

function TimelineModel:getObjectPropertyTrackState()
	local state = {}
	for _, track in ipairs(self._genericTracks) do
		if (track.targetScope == "ObjectProperty" or track.targetScope == "EmitterGroupProperty" or track.targetScope == "ParticleEvent")
			and track.parentTrackPath
			and track.propertyName then
			state[track.parentTrackPath] = state[track.parentTrackPath] or {}
			state[track.parentTrackPath][track.propertyName] = true
		end
	end
	return state
end

function TimelineModel:getTimelineFolders()
	local folders = {}
	for _, track in ipairs(self._genericTracks) do
		if track.targetScope == "TimelineFolder" then
			table.insert(folders, track)
		end
	end
	return folders
end

function TimelineModel:getFirstTimelineFolder()
	for _, track in ipairs(self._genericTracks) do
		if track.targetScope == "TimelineFolder" then
			return track
		end
	end
	return nil
end

function TimelineModel:renameTimelineFolder(folderPath, newName)
	if type(newName) ~= "string" then
		return false, "Enter a valid folder name."
	end
	newName = string.gsub(newName, "^%s+", "")
	newName = string.gsub(newName, "%s+$", "")
	if newName == "" then
		return false, "Enter a valid folder name."
	end

	for _, track in ipairs(self._genericTracks) do
		if track.path == folderPath and track.targetScope == "TimelineFolder" then
			track.name = newName
			track.part1 = newName
			return true, string.format("Renamed folder to '%s'.", newName)
		end
	end
	return false, "That folder is no longer available."
end

function TimelineModel:setTimelineFolderColor(folderPath, colorId)
	colorId = tostring(colorId or "")
	if colorId == "" then
		return false, "Choose a valid folder color."
	end

	for _, track in ipairs(self._genericTracks) do
		if track.path == folderPath and track.targetScope == "TimelineFolder" then
			track.folderColorId = colorId
			return true, string.format("Set folder '%s' color to %s.", track.name or "Folder", colorId)
		end
	end
	return false, "That folder is no longer available."
end

function TimelineModel:moveTrackToFolder(trackPath, folderPath)
	local track = self:getTrackByPath(trackPath)
	if not track then
		return false, "That track is no longer available."
	end
	if track.targetScope == "TimelineFolder" then
		return false, "Folders cannot be moved inside folders yet."
	end

	local folder = nil
	if folderPath then
		folder = self:getTrackByPath(folderPath)
		if not folder or folder.targetScope ~= "TimelineFolder" then
			return false, "Add a timeline folder first."
		end
	end

	self._trackFolderPaths[trackPath] = folderPath or nil
	for _, genericTrack in ipairs(self._genericTracks) do
		if genericTrack.path == trackPath then
			genericTrack.folderPath = folderPath or nil
		end
	end

	if track.trackType == "Rig Group" and track.rigName then
		local groupPath = getRigGroupTrackPath(track.rigName)
		self._trackFolderPaths[groupPath] = folderPath or nil
		for _, motorData in ipairs(self._motors) do
			if motorData.rigName == track.rigName then
				self._trackFolderPaths[motorData.path] = folderPath or nil
			end
		end
		for _, genericTrack in ipairs(self._genericTracks) do
			if genericTrack.rigName == track.rigName then
				self._trackFolderPaths[genericTrack.path] = folderPath or nil
				genericTrack.folderPath = folderPath or nil
			end
		end
	end

	if folder then
		return true, string.format("Moved '%s' into folder '%s'.", track.name or track.part1 or trackPath, folder.name or "Folder")
	end
	return true, string.format("Removed '%s' from its folder.", track.name or track.part1 or trackPath)
end

function TimelineModel:getTrackReorderScope(track)
	if not track then
		return nil
	end
	if track.trackType == "Rig" and track.rigName then
		return "rig-joints:" .. tostring(track.rigName)
	end
	if track.trackType == "Rig Property" and track.rigName then
		return "rig-properties:" .. tostring(track.rigName)
	end
	if track.parentTrackPath then
		return "parent:" .. tostring(track.parentTrackPath)
	end
	if track.targetScope == "CameraProperty" or track.trackType == "Camera Property" then
		return "camera-properties"
	end
	if track.folderPath then
		return "folder:" .. tostring(track.folderPath)
	end
	return "top"
end

function TimelineModel:reorderTrack(trackPath, targetPath, placement)
	if not trackPath or not targetPath then
		return false, "Drag a track onto another track to reorder it."
	end
	if trackPath == targetPath then
		return false, "That track is already there."
	end

	local tracks = self:getTracks()
	local sourceTrack = nil
	local targetTrack = nil
	for _, track in ipairs(tracks) do
		if track.path == trackPath then
			sourceTrack = track
		elseif track.path == targetPath then
			targetTrack = track
		end
	end
	if not sourceTrack or not targetTrack then
		return false, "One of those tracks is no longer available."
	end

	local sourceScope = self:getTrackReorderScope(sourceTrack)
	local targetScope = self:getTrackReorderScope(targetTrack)
	if sourceScope ~= targetScope then
		return false, "Drag reorder currently works within the same rig, folder, or track section."
	end

	local sequence = {}
	for _, track in ipairs(tracks) do
		if self:getTrackReorderScope(track) == sourceScope then
			table.insert(sequence, track.path)
		end
	end

	for index = #sequence, 1, -1 do
		if sequence[index] == trackPath then
			table.remove(sequence, index)
			break
		end
	end

	local targetIndex = nil
	for index, path in ipairs(sequence) do
		if path == targetPath then
			targetIndex = index
			break
		end
	end
	if not targetIndex then
		return false, "Choose a visible track in the same section."
	end

	if placement == "After" then
		targetIndex += 1
	end
	table.insert(sequence, math.clamp(targetIndex, 1, #sequence + 1), trackPath)

	self._trackVisualOrder = self._trackVisualOrder or {}
	for index, path in ipairs(sequence) do
		self._trackVisualOrder[path] = index * 10
	end

	return true, string.format("Moved '%s' %s '%s'.", sourceTrack.name or sourceTrack.part1 or trackPath, placement == "After" and "below" or "above", targetTrack.name or targetTrack.part1 or targetPath)
end

function TimelineModel:setTrackDisabled(path, disabled)
	if not path or not self:getTrackByPath(path) then
		return false, "That track is no longer available."
	end

	self._disabledTrackPaths[path] = disabled == true or nil
	return true
end

function TimelineModel:isTrackDisabled(path)
	return self._disabledTrackPaths[path] == true
end

function TimelineModel:removeBoundRig()
	if #self._motors == 0 then
		return false, "There is no rig track to remove."
	end

	local removedPaths = {}
	for _, motorData in ipairs(self._motors) do
		removedPaths[motorData.path] = true
		self._keyOptions[motorData.path] = nil
		self._disabledTrackPaths[motorData.path] = nil
		self._trackVisualOrder[motorData.path] = nil
	end

	for frame, pose in pairs(self._frames) do
		for path in pairs(removedPaths) do
			pose[path] = nil
		end
		if poseIsEmpty(pose) then
			self._frames[frame] = nil
		end
	end

	local removedCount = #self._motors
	for _, rig in ipairs(self._rigs) do
		if rig and rig.Name then
			self._trackVisualOrder[getRigGroupTrackPath(rig.Name)] = nil
		end
	end
	self._rig = nil
	self._rigs = {}
	self._motors = {}
	self._originalPose = {}
	return true, string.format("Removed rig and %d rig track%s.", removedCount, removedCount == 1 and "" or "s")
end

function TimelineModel:removeRig(rig)
	if not rig then
		return false, "That rig is no longer available."
	end

	self:resetRigPoseForRig(rig)

	local removedPaths = {}
	local keptMotors = {}
	local removedCount = 0
	for _, motorData in ipairs(self._motors) do
		if motorData.rig == rig then
			removedPaths[motorData.path] = true
			self._keyOptions[motorData.path] = nil
			self._disabledTrackPaths[motorData.path] = nil
			self._trackFolderPaths[motorData.path] = nil
			self._trackVisualOrder[motorData.path] = nil
			self._originalPose[motorData.path] = nil
			removedCount += 1
		else
			table.insert(keptMotors, motorData)
		end
	end

	if removedCount == 0 then
		return false, "That rig is no longer part of the timeline."
	end

	self._motors = keptMotors
	self._trackVisualOrder[getRigGroupTrackPath(rig.Name)] = nil
	local keptGenericTracks = {}
	for _, track in ipairs(self._genericTracks) do
		if track.rig == rig or (track.targetScope == "RigProperty" and track.rigName == rig.Name) then
			restoreGenericTrackOriginalValue(track)
			removedPaths[track.path] = true
			self._keyOptions[track.path] = nil
			self._disabledTrackPaths[track.path] = nil
			self._trackFolderPaths[track.path] = nil
			self._trackVisualOrder[track.path] = nil
			removedCount += 1
		else
			table.insert(keptGenericTracks, track)
		end
	end
	self._genericTracks = keptGenericTracks

	local keptRigs = {}
	for _, existingRig in ipairs(self._rigs) do
		if existingRig ~= rig then
			table.insert(keptRigs, existingRig)
		end
	end
	self._rigs = keptRigs
	self._rig = self._rigs[1]

	for frame, pose in pairs(self._frames) do
		for path in pairs(removedPaths) do
			pose[path] = nil
		end
		if poseIsEmpty(pose) then
			self._frames[frame] = nil
		end
	end

	return true, string.format("Removed rig '%s' and %d track%s.", rig.Name, removedCount, removedCount == 1 and "" or "s")
end

function TimelineModel:removeTrack(path)
	if not path then
		return false, "Select a rig or object track before removing it."
	end

	for _, existingRig in ipairs(self._rigs) do
		if path == getRigGroupTrackPath(existingRig and existingRig.Name) then
			return self:removeRig(existingRig)
		end
	end

	for _, motorData in ipairs(self._motors) do
		if motorData.path == path then
			return self:removeRig(motorData.rig)
		end
	end

	local removedTrack = nil
	for index, track in ipairs(self._genericTracks) do
		if track.path == path then
			removedTrack = track
			table.remove(self._genericTracks, index)
			break
		end
	end

	if not removedTrack then
		return false, "That track is no longer available."
	end

	if removedTrack.targetScope == "TimelineFolder" then
		for _, track in ipairs(self._genericTracks) do
			if track.folderPath == path then
				track.folderPath = nil
			end
		end
		for trackPath, folderPath in pairs(self._trackFolderPaths) do
			if folderPath == path or trackPath == path then
				self._trackFolderPaths[trackPath] = nil
			end
		end
		self._keyOptions[path] = nil
		self._disabledTrackPaths[path] = nil
		self._trackVisualOrder[path] = nil
		return true, string.format("Removed folder '%s'. Its tracks stayed in the timeline.", removedTrack.name or "Folder")
	end

	local removedPaths = {
		[path] = true,
	}
	local removedTracks = {
		removedTrack,
	}
	if removedTrack.targetScope ~= "ObjectProperty" then
		local keptTracks = {}
		for _, track in ipairs(self._genericTracks) do
			if track.parentTrackPath == path then
				removedPaths[track.path] = true
				table.insert(removedTracks, track)
			else
				table.insert(keptTracks, track)
			end
		end
		self._genericTracks = keptTracks
	end

	for _, track in ipairs(removedTracks) do
		restoreGenericTrackOriginalValue(track)
	end

	for frame, pose in pairs(self._frames) do
		for removedPath in pairs(removedPaths) do
			pose[removedPath] = nil
		end
		if poseIsEmpty(pose) then
			self._frames[frame] = nil
		end
	end
	for removedPath in pairs(removedPaths) do
		self._keyOptions[removedPath] = nil
		self._disabledTrackPaths[removedPath] = nil
		self._trackFolderPaths[removedPath] = nil
		self._trackVisualOrder[removedPath] = nil
	end

	local extraCount = #removedTracks - 1
	local suffix = extraCount &gt; 0 and string.format(" and %d child track%s", extraCount, extraCount == 1 and "" or "s") or ""
	return true, string.format("Removed %s track '%s'%s.", removedTrack.trackType or "object", removedTrack.name or path, suffix)
end

function TimelineModel:addGenericTrack(trackType, instance, name, metadata)
	trackType = trackType or "Object"
	metadata = metadata or {}
	local instanceAddressSupport = require(script.Parent:WaitForChild("InstanceAddressSupport"))
	instanceAddressSupport.ensureTrackTargetId(trackType, instance)
	local trackId = self._nextTrackId
	self._nextTrackId += 1

	local displayName = name
	if not displayName or displayName == "" then
		displayName = instance and instance.Name or trackType
	end
	if instance and (trackType == "Object" or trackType == "Model") and displayName == instance.Name then
		displayName = instanceAddressSupport.getDisambiguatedName(instance) or displayName
	end

	local valueType = "CFrame"
	if trackType == "RigCFrame" then
		trackType = "Rig CFrame"
	end

	if trackType == "ScreenEffect" then
		trackType = "Screen Effect"
		valueType = metadata.effectType or "Fade"
	elseif trackType == "LightingEffect" then
		trackType = "Lighting Effect"
		valueType = metadata.effectType or "Lighting"
	elseif trackType == "Event" then
		valueType = "Event"
	elseif trackType == "Face" then
		valueType = "Face"
	elseif trackType == "Sound" then
		valueType = "Sound"
	elseif trackType == "RigProperty" then
		valueType = metadata.propertyName or "CFrame"
	elseif trackType == "ObjectProperty" then
		valueType = metadata.propertyName or "Transparency"
	elseif trackType == "EmitterGroup" then
		valueType = "EmitterGroup"
	elseif trackType == "EmitterGroupProperty" then
		valueType = metadata.propertyName or "Enabled"
	elseif trackType == "ParticleEvent" then
		valueType = "ParticleEvent"
	elseif trackType == "Folder" then
		valueType = "Folder"
	elseif trackType == "CameraProperty" then
		valueType = metadata.propertyName or "FieldOfView"
	elseif instance and (instance:IsA("Decal") or instance:IsA("Texture")) then
		valueType = "Transparency"
	elseif instance and instance:IsA("ParticleEmitter") then
		valueType = "Emitter"
	end

	local displayTrackType = trackType == "RigProperty" and "Rig Property"
		or (trackType == "ObjectProperty" and "Object Property")
		or (trackType == "EmitterGroup" and "Emitter Group")
		or (trackType == "EmitterGroupProperty" and "Emitter Group Property")
		or (trackType == "ParticleEvent" and "Particle Event")
		or (trackType == "Folder" and "Folder")
		or (trackType == "CameraProperty" and "Camera Property")
		or (trackType == "LightingEffect" and "Lighting Effect")
		or trackType

	local track = {
		path = string.format("track:%d", trackId),
		name = displayName,
		part0 = metadata.rigName or trackType,
		part1 = displayName,
		instance = instance,
		emitters = metadata.emitters,
		targetPath = getInstancePath(instance),
		trackType = displayTrackType,
		valueType = valueType,
		easingStyle = "Linear",
		easingDirection = DEFAULT_EASING_DIRECTION,
		rig = metadata.rig,
		rigName = metadata.rigName,
		propertyName = metadata.propertyName,
		eventName = metadata.eventName,
		parentTrackPath = metadata.parentTrackPath,
		parentTrackName = metadata.parentTrackName,
		gizmoTargetPath = metadata.gizmoTargetPath,
		folderPath = metadata.folderPath,
		folderColorId = metadata.folderColorId,
		defaultCollapsed = metadata.defaultCollapsed == true,
		defaultCollapseToken = metadata.defaultCollapseToken
			or (metadata.defaultCollapsed == true and HttpService:GenerateGUID(false) or nil),
		visualOrder = metadata.visualOrder,
		effectType = metadata.effectType,
		targetScope = metadata.targetScope,
		sortOrder = metadata.sortOrder or DEFAULT_GENERIC_TRACK_SORT_ORDERS[trackType],
	}
	local originalValue = metadata.originalValue
	if originalValue == nil and track.targetScope == "ObjectProperty" and track.propertyName == "Scale" then
		local scalePart = getBasePartScaleTarget(track)
		if scalePart then
			originalValue = scalePart.Size
		end
	end
	if originalValue == nil then
		if track.targetScope == "EmitterGroupProperty" then
			originalValue = ParticleEmitterGroupService.capturePropertySnapshot(track, track.propertyName)
		elseif LightingEffectTrackService.isLightingEffectTrack(track) and type(LightingEffectTrackService.captureOriginalValue) == "function" then
			originalValue = LightingEffectTrackService.captureOriginalValue(track.valueType or track.effectType)
		else
			originalValue = getGenericTrackValue(track)
		end
	end
	track.originalValue = cloneValue(originalValue)
	table.insert(self._genericTracks, track)

	local visualOrder = tonumber(metadata.visualOrder)
	if visualOrder then
		self._trackVisualOrder[track.path] = visualOrder
		track.visualOrder = visualOrder
	else
		local isRestoredTrack = metadata.originalValue ~= nil or metadata.preserveVisualOrder == true
		local isNestedTrack = metadata.rigName ~= nil
			or metadata.parentTrackPath ~= nil
			or track.targetScope == "RigProperty"
			or track.targetScope == "ObjectProperty"
			or track.targetScope == "CameraProperty"
			or track.targetScope == "EmitterGroupProperty"
			or track.targetScope == "ParticleEvent"
			or track.trackType == "Rig Property"
			or track.trackType == "Object Property"
			or track.trackType == "Camera Property"
			or track.trackType == "Emitter Group Property"
			or track.trackType == "Particle Event"
		if not isRestoredTrack and not isNestedTrack then
			track.visualOrder = self:_placeTrackAtTop(track.path)
		end
	end
	return track
end

function TimelineModel:getCurrentFrame()
	return self._currentFrame
end

function TimelineModel:getFps()
	return self._fps
end

function TimelineModel:getDurationFrames()
	return self._durationFrames
end

function TimelineModel:getLooping()
	return self._looping
end

function TimelineModel:getPriority()
	return self._priority
end

function TimelineModel:getKeyframeCount()
	local count = 0
	for _, pose in pairs(self._frames) do
		for _ in pairs(pose) do
			count += 1
		end
	end
	return count
end

function TimelineModel:getMotorByPath(path)
	for _, motorData in ipairs(self._motors) do
		if motorData.path == path then
			return motorData
		end
	end
	return nil
end

function TimelineModel:getKeyframeFrames()
	local frames = {}
	for frame, pose in pairs(self._frames) do
		if type(pose) == "table" and not poseIsEmpty(pose) then
			table.insert(frames, frame)
		else
			self._frames[frame] = nil
		end
	end
	table.sort(frames)
	return frames
end

function TimelineModel:getFirstKeyframe()
	local frames = self:getKeyframeFrames()
	return frames[1]
end

function TimelineModel:getLastKeyframe()
	local frames = self:getKeyframeFrames()
	return frames[#frames]
end

function TimelineModel:getNextAvailableImportFrame(preferredFrame, options)
	local requestedFrame = math.max(0, math.floor(tonumber(preferredFrame) or self._currentFrame or 0))
	options = options or {}
	local rigName = options.rigName
	local trackPaths = {}
	if rigName then
		for _, motorData in ipairs(self._motors) do
			if motorData.rigName == rigName then
				trackPaths[motorData.path] = true
			end
		end
	elseif type(options.trackPaths) == "table" then
		for _, path in ipairs(options.trackPaths) do
			trackPaths[path] = true
		end
	end

	local lastFrame = nil
	if next(trackPaths) ~= nil then
		for frame, pose in pairs(self._frames) do
			if type(pose) == "table" then
				for path in pairs(trackPaths) do
					if pose[path] ~= nil then
						lastFrame = math.max(lastFrame or frame, frame)
						break
					end
				end
			end
		end
	else
		lastFrame = self:getLastKeyframe()
	end

	if not lastFrame then
		return requestedFrame
	end
	return math.max(requestedFrame, lastFrame + 1)
end

function TimelineModel:hasKeyframe(frame)
	return self._frames[frame] ~= nil
end

function TimelineModel:hasTrackKeyframe(path, frame)
	local pose = self._frames[math.max(0, math.floor(frame or 0))]
	return pose ~= nil and pose[path] ~= nil
end

function TimelineModel:getTrackKeyframeFrames(path)
	local frames = {}
	for frame, pose in pairs(self._frames) do
		if pose[path] ~= nil then
			table.insert(frames, frame)
		end
	end
	table.sort(frames)
	return frames
end

function TimelineModel:getTrackKeyframesByPath()
	local keyframesByPath = {}
	for _, track in ipairs(self:getTracks()) do
		keyframesByPath[track.path] = {}
	end

	for frame, pose in pairs(self._frames) do
		for path in pairs(pose) do
			keyframesByPath[path] = keyframesByPath[path] or {}
			table.insert(keyframesByPath[path], frame)
		end
	end

	for _, frames in pairs(keyframesByPath) do
		table.sort(frames)
	end

	return keyframesByPath
end

function TimelineModel:getSoundClipDataByPath()
	local clipsByPath = {}
	for _, track in ipairs(self:getTracks()) do
		if SoundTimelineService.isSoundTrack(track) then
			local clips = {}
			for _, frame in ipairs(self:getTrackKeyframeFrames(track.path)) do
				local pose = self._frames[frame]
				local value = pose and pose[track.path]
				if type(value) == "table" then
					local durationFrames = SoundTimelineService.getClipDurationFrames(track.instance, value, self._fps, 0.5)
					table.insert(clips, {
						frame = frame,
						endFrame = frame + durationFrames,
						durationFrames = durationFrames,
						startOffsetSeconds = SoundTimelineService.getStartOffsetSeconds(value),
						endTrimSeconds = SoundTimelineService.getEndTrimSeconds(value),
						fadeInSeconds = SoundTimelineService.getFadeInSeconds(value),
						fadeOutSeconds = SoundTimelineService.getFadeOutSeconds(value),
						clipDurationSeconds = SoundTimelineService.getExplicitClipDurationSeconds(value),
						soundId = value.soundId or value.SoundId or "",
					})
				end
			end
			clipsByPath[track.path] = clips
		end
	end
	return clipsByPath
end

function TimelineModel:getSubtitleClipDataByPath()
	local clipsByPath = {}
	for _, track in ipairs(self:getTracks()) do
		if ScreenEffectTrackService.isSubtitleTrack(track) then
			clipsByPath[track.path] = ScreenEffectTrackService.getSubtitleClipDataForTrack(self, track)
		end
	end
	return clipsByPath
end

function TimelineModel:getFadeClipDataByPath()
	local clipsByPath = {}
	for _, track in ipairs(self:getTracks()) do
		if ScreenEffectTrackService.isFadeTrack(track) then
			clipsByPath[track.path] = ScreenEffectTrackService.getFadeClipDataForTrack(self, track)
		end
	end
	return clipsByPath
end

function TimelineModel:getTrackKeyOptionsByPath()
	local optionsByPath = {}
	for _, track in ipairs(self:getTracks()) do
		optionsByPath[track.path] = {}
	end

	for frame, pose in pairs(self._frames) do
		for path in pairs(pose) do
			optionsByPath[path] = optionsByPath[path] or {}
			optionsByPath[path][frame] = self:getKeyOptions(path, frame)
		end
	end

	return optionsByPath
end

function TimelineModel:getTrackKeyValues(keyList)
	local keys = {}
	local seen = {}
	for _, key in ipairs(keyList or {}) do
		local path = key.jointPath or key.path
		local frame = math.max(0, math.floor(key.frame or 0))
		local id = makeTrackKeyId(path, frame)
		local pose = self._frames[frame]
		if path and pose and pose[path] ~= nil and not seen[id] then
			seen[id] = true
				table.insert(keys, {
					jointPath = path,
					frame = frame,
					value = pose[path],
					easingStyle = self:getKeyOptions(path, frame).easingStyle,
					easingDirection = self:getKeyOptions(path, frame).easingDirection,
				})
		end
	end

	table.sort(keys, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return keys
end

function TimelineModel:getTrackValueAtFrame(path, frame)
	frame = normalizeFrame(frame)
	local pose = self._frames[frame]
	if path and pose and pose[path] ~= nil then
		return cloneValue(pose[path])
	end
	return nil
end

function TimelineModel:setCurrentFrame(frame)
	frame = math.max(0, math.floor(frame))
	if frame == self._currentFrame then
		return false
	end

	self._currentFrame = frame
	return true
end

function TimelineModel:setDurationFrames(frameCount)
	frameCount = math.max(1, math.floor(frameCount))
	if frameCount == self._durationFrames then
		return false
	end

	self._durationFrames = frameCount
	if self._currentFrame &gt; self._durationFrames then
		self._currentFrame = self._durationFrames
	end
	return true
end

function TimelineModel:_extendDurationForSoundValue(track, frame, value)
	if not SoundTimelineService.isSoundTrack(track) then
		return false
	end
	local durationFrames = SoundTimelineService.getKnownClipDurationFrames(track.instance, value, self._fps)
	if not durationFrames then
		return false
	end
	local endFrame = normalizeFrame(frame) + durationFrames
	if endFrame &gt; self._durationFrames then
		self._durationFrames = endFrame
		return true
	end
	return false
end

function TimelineModel:syncDurationToSoundClips()
	local extended = false
	for _, track in ipairs(self._genericTracks) do
		if SoundTimelineService.isSoundTrack(track) and not self:isTrackDisabled(track.path) then
			for _, frame in ipairs(self:getTrackKeyframeFrames(track.path)) do
				local pose = self._frames[frame]
				local value = pose and pose[track.path]
				if type(value) == "table" and self:_extendDurationForSoundValue(track, frame, value) then
					extended = true
				end
			end
		end
	end
	return extended
end

function TimelineModel:setFps(fps)
	fps = math.max(1, math.floor(fps))
	if fps == self._fps then
		return false
	end

	local oldFps = math.max(1, self._fps or fps)
	local scale = fps / oldFps
	local scaledFrames = {}
	local frameNumbers = {}
	for frame in pairs(self._frames) do
		table.insert(frameNumbers, frame)
	end
	table.sort(frameNumbers)

	for _, frame in ipairs(frameNumbers) do
		local targetFrame = scaleFrameNumber(frame, scale)
		local sourcePose = self._frames[frame]
		local targetPose = scaledFrames[targetFrame] or {}
		scaledFrames[targetFrame] = targetPose
		for path, value in pairs(sourcePose) do
			targetPose[path] = value
		end
	end

	local scaledOptions = {}
	for path, frames in pairs(self._keyOptions) do
		local optionFrames = {}
		for frame in pairs(frames) do
			table.insert(optionFrames, frame)
		end
		table.sort(optionFrames)
		for _, frame in ipairs(optionFrames) do
			local targetFrame = scaleFrameNumber(frame, scale)
			scaledOptions[path] = scaledOptions[path] or {}
			scaledOptions[path][targetFrame] = cloneValue(frames[frame])
		end
	end

	self._frames = scaledFrames
	self._keyOptions = scaledOptions
	self._durationFrames = math.max(1, scaleFrameNumber(self._durationFrames, scale))
	self._currentFrame = math.min(self._durationFrames, scaleFrameNumber(self._currentFrame, scale))
	self._fps = fps
	return true
end

function TimelineModel:setLooping(looping)
	looping = not not looping
	if looping == self._looping then
		return false
	end

	self._looping = looping
	return true
end

function TimelineModel:setPriority(priority)
	if type(priority) ~= "string" or priority == "" or priority == self._priority then
		return false
	end

	self._priority = priority
	return true
end

function TimelineModel:getKeyOptions(path, frame)
	frame = normalizeFrame(frame)
	local options = self._keyOptions[path] and self._keyOptions[path][frame]
	return {
		easingStyle = options and options.easingStyle or DEFAULT_EASING_STYLE,
		easingDirection = options and options.easingDirection or DEFAULT_EASING_DIRECTION,
	}
end

function TimelineModel:setTrackKeyOptions(keyList, easingStyle, easingDirection)
	if type(keyList) ~= "table" or #keyList == 0 then
		return false, "Select one or more keyframes before changing easing."
	end

	easingStyle = easingStyle or DEFAULT_EASING_STYLE
	easingDirection = easingDirection or DEFAULT_EASING_DIRECTION

	local changedCount = 0
	for _, key in ipairs(keyList) do
		local path = key.jointPath or key.path
		local frame = normalizeFrame(key.frame)
		if path and self:hasTrackKeyframe(path, frame) then
			self._keyOptions[path] = self._keyOptions[path] or {}
			self._keyOptions[path][frame] = {
				easingStyle = easingStyle,
				easingDirection = easingDirection,
			}
			changedCount += 1
		end
	end

	if changedCount == 0 then
		return false, "No selected keyframes could be updated."
	end

	return true, string.format("Updated easing on %d keyframe%s.", changedCount, changedCount == 1 and "" or "s")
end

function TimelineModel:_ensureKeyOptions(path, frame)
	frame = normalizeFrame(frame)
	self._keyOptions[path] = self._keyOptions[path] or {}
	self._keyOptions[path][frame] = self._keyOptions[path][frame] or getDefaultKeyOptionsForTrack(self:getTrackByPath(path))
end

function TimelineModel:_moveKeyOptions(path, sourceFrame, targetFrame)
	sourceFrame = normalizeFrame(sourceFrame)
	targetFrame = normalizeFrame(targetFrame)
	local trackOptions = self._keyOptions[path]
	if not trackOptions then
		return
	end

	trackOptions[targetFrame] = trackOptions[sourceFrame]
	trackOptions[sourceFrame] = nil
end

function TimelineModel:_deleteKeyOptions(path, frame)
	frame = normalizeFrame(frame)
	if self._keyOptions[path] then
		self._keyOptions[path][frame] = nil
	end
end

function TimelineModel:setTrackValueAtFrame(trackPath, frame, value, easingStyle, easingDirection)
	local track = self:getTrackByPath(trackPath)
	if not track then
		return false, "That track is no longer available."
	end
	if self:isTrackDisabled(trackPath) then
		return false, string.format("'%s' is disabled.", track.name or "Track")
	end

	frame = normalizeFrame(frame)
	local pose = self._frames[frame] or {}
	self._frames[frame] = pose
	pose[trackPath] = cloneValue(self:_normalizeRigTrackValueForStorage(trackPath, value))
	self:_extendDurationForSoundValue(track, frame, pose[trackPath])
	self:_ensureKeyOptions(trackPath, frame)
	if isDiscreteObjectPropertyTrack(track) then
		self._keyOptions[trackPath][frame] = getDefaultKeyOptionsForTrack(track)
	elseif easingStyle or easingDirection then
		self._keyOptions[trackPath][frame] = {
			easingStyle = easingStyle or DEFAULT_EASING_STYLE,
			easingDirection = easingDirection or DEFAULT_EASING_DIRECTION,
		}
	end
	return true, string.format("Set %s keyframe at frame %d.", track.name or "track", frame)
end

function TimelineModel:previewTrackValue(trackPath, value)
	local track = self:getTrackByPath(trackPath)
	if not track then
		return false, "That track is no longer available."
	end
	if self:isTrackDisabled(trackPath) then
		return false, string.format("'%s' is disabled.", track.name or "Track")
	end
	if applyGenericTrackValue(track, cloneValue(value)) then
		return true, "Preview updated."
	end
	return false, "That value could not be previewed on this track."
end

function TimelineModel:captureCurrentFrame()
	if #self._motors == 0 then
		return false, self._currentFrame
	end

	local pose = self._frames[self._currentFrame] or {}
	self._frames[self._currentFrame] = pose
	for path, value in pairs(self:_captureRigPoseForStorage()) do
		if not self:isTrackDisabled(path) then
			pose[path] = value
			self:_ensureKeyOptions(path, self._currentFrame)
		end
	end
	return true, self._currentFrame
end

function TimelineModel:captureTrackValue(trackPath)
	local track = self:getTrackByPath(trackPath)
	if not track then
		return false, nil, "Select a track before adding a keyframe."
	end
	if self:isTrackDisabled(trackPath) then
		return false, nil, string.format("'%s' is disabled.", track.name or "Track")
	end

	if track.trackType == "Rig" then
		if #self._motors == 0 then
			return false, nil, "Bind a rig before adding a rig keyframe."
		end

		local currentPose = self:_captureRigPoseForStorage()
		local value = currentPose[track.path]
		if value == nil then
			return false, nil, string.format("'%s' cannot be keyed yet.", track.name or "Track")
		end

		return true, value, nil
	end

	local value
	value = getGenericTrackValue(track)

	if value == nil then
		return false, nil, string.format("'%s' cannot be keyed yet. Try a Camera, BasePart, Model, Sound, or supported property.", track.name or "Track")
	end

	return true, value, nil
end

local function captureLinkedAttachmentObjectFrames(timeline, sourceTrack, frame, pose)
	if not (timeline and sourceTrack and sourceTrack.trackType == "Rig") then
		return 0
	end

	local ok, attachService = pcall(require, script.Parent:WaitForChild("AttachService"))
	if not ok or not attachService or type(attachService.getLinkedObjectTrackPathsForRigTrack) ~= "function" then
		return 0
	end

	local linkedPaths = attachService.getLinkedObjectTrackPathsForRigTrack(timeline, sourceTrack.path, frame)
	local linkedCount = 0
	for _, linkedPath in ipairs(linkedPaths or {}) do
		if type(linkedPath) == "string" and linkedPath ~= sourceTrack.path and timeline:getTrackByPath(linkedPath) and not timeline:isTrackDisabled(linkedPath) then
			local success, value = timeline:captureTrackValue(linkedPath)
			local linkedTrack = timeline:getTrackByPath(linkedPath)
			if success and linkedTrack then
				pose[linkedPath] = cloneValue(timeline:_normalizeRigTrackValueForStorage(linkedPath, value))
				timeline:_extendDurationForSoundValue(linkedTrack, frame, pose[linkedPath])
				timeline:_ensureKeyOptions(linkedPath, frame)
				linkedCount += 1
			end
		end
	end
	return linkedCount
end

function TimelineModel:captureTrackFrameAtFrame(trackPath, frame)
	local track = self:getTrackByPath(trackPath)
	if not track then
		return false, "Select a track before adding a keyframe."
	end

	local success, value, message = self:captureTrackValue(trackPath)
	if not success then
		return false, message
	end

	local targetFrame = normalizeFrame(frame or self._currentFrame)
	local pose = self._frames[targetFrame] or {}
	self._frames[targetFrame] = pose
	pose[track.path] = cloneValue(self:_normalizeRigTrackValueForStorage(track.path, value))
	self:_extendDurationForSoundValue(track, targetFrame, pose[track.path])
	self:_ensureKeyOptions(track.path, targetFrame)
	local linkedCount = captureLinkedAttachmentObjectFrames(self, track, targetFrame, pose)
	if linkedCount &gt; 0 then
		return true, string.format(
			"Added %s keyframe and %d attached object keyframe%s at frame %d.",
			track.name or "track",
			linkedCount,
			linkedCount == 1 and "" or "s",
			targetFrame
		)
	end
	return true, string.format("Added %s keyframe at frame %d.", track.name or "track", targetFrame)
end

function TimelineModel:captureTrackFrame(trackPath)
	return self:captureTrackFrameAtFrame(trackPath, self._currentFrame)
end

function TimelineModel:_setRigDefaultPoseKey(path, frame)
	frame = normalizeFrame(frame or self._currentFrame)
	local track = self:getTrackByPath(path)
	local defaultValue = self._originalPose[path]
	if not track or track.trackType ~= "Rig" or typeof(defaultValue) ~= "CFrame" then
		return false
	end
	if self:isTrackDisabled(path) then
		return false
	end

	local pose = self._frames[frame] or {}
	self._frames[frame] = pose
	pose[path] = defaultValue
	self:_ensureKeyOptions(path, frame)
	return true
end

function TimelineModel:_expandDefaultPoseTrackPath(path)
	local track = self:getTrackByPath(path)
	if not track then
		return {}
	end
	if track.trackType == "Rig" then
		return { track.path }
	end
	if track.trackType == "Rig Group" and track.rigName and type(self.getRigTrackPaths) == "function" then
		return self:getRigTrackPaths(track.rigName)
	end
	return {}
end

function TimelineModel:setDefaultPoseForTrackPaths(trackPaths, frame)
	if #self._motors == 0 then
		return false, "Bind a rig before adding default pose keyframes.", {}
	end

	frame = normalizeFrame(frame or self._currentFrame)
	local paths = {}
	if type(trackPaths) == "table" and #trackPaths &gt; 0 then
		for _, path in ipairs(trackPaths) do
			local expanded = self:_expandDefaultPoseTrackPath(path)
			for _, expandedPath in ipairs(expanded) do
				table.insert(paths, expandedPath)
			end
		end
	else
		for _, motorData in ipairs(self._motors) do
			table.insert(paths, motorData.path)
		end
	end

	local keyed = {}
	local seen = {}
	for _, path in ipairs(paths) do
		if not seen[path] and self:_setRigDefaultPoseKey(path, frame) then
			seen[path] = true
			table.insert(keyed, {
				jointPath = path,
				frame = frame,
			})
		end
	end

	if #keyed == 0 then
		return false, "No enabled rig tracks were available for default pose keyframes.", {}
	end

	return true, string.format("Added default pose to %d rig track%s at frame %d.", #keyed, #keyed == 1 and "" or "s", frame), keyed
end

function TimelineModel:setSelectedKeyframesToDefault(keyList)
	if #self._motors == 0 then
		return false, "Bind a rig before applying default pose keyframes.", {}
	end

	local changed = {}
	local seen = {}
	for _, key in ipairs(keyList or {}) do
		local path = key.jointPath or key.path
		local frame = normalizeFrame(key.frame)
		local id = makeTrackKeyId(path, frame)
		for _, expandedPath in ipairs(self:_expandDefaultPoseTrackPath(path)) do
			local expandedId = makeTrackKeyId(expandedPath, frame)
			if not seen[expandedId] and (self:hasTrackKeyframe(expandedPath, frame) or path ~= expandedPath) and self:_setRigDefaultPoseKey(expandedPath, frame) then
				seen[expandedId] = true
				table.insert(changed, {
					jointPath = expandedPath,
					frame = frame,
				})
			end
		end
	end

	if #changed == 0 then
		return false, "No selected rig keyframes could be set to the default pose.", {}
	end

	return true, string.format("Set %d selected rig keyframe%s to the default pose.", #changed, #changed == 1 and "" or "s"), changed
end

function TimelineModel:deleteCurrentFrame()
	if not self._frames[self._currentFrame] then
		return false, string.format("Frame %d has no keyframe to delete.", self._currentFrame)
	end

	self._frames[self._currentFrame] = nil
	for path in pairs(self._keyOptions) do
		self:_deleteKeyOptions(path, self._currentFrame)
	end
	return true, string.format("Deleted keyframe at frame %d.", self._currentFrame)
end

function TimelineModel:moveCurrentKeyframe(offset)
	offset = math.floor(offset or 0)
	if offset == 0 then
		return false, "No timeline movement was requested."
	end

	local pose = self._frames[self._currentFrame]
	if not pose then
		return false, string.format("Frame %d has no keyframe to move.", self._currentFrame)
	end

	local targetFrame = math.max(0, math.min(self._durationFrames, self._currentFrame + offset))
	if targetFrame == self._currentFrame then
		return false, "Keyframe is already at the edge of the timeline."
	end

	if self._frames[targetFrame] then
		return false, string.format("Frame %d already contains a keyframe.", targetFrame)
	end

	self._frames[self._currentFrame] = nil
	self._frames[targetFrame] = pose
	for path in pairs(pose) do
		self:_moveKeyOptions(path, self._currentFrame, targetFrame)
	end
	self._currentFrame = targetFrame

	return true, string.format("Moved keyframe to frame %d.", targetFrame)
end

function TimelineModel:moveKeyframe(sourceFrame, targetFrame)
	sourceFrame = math.max(0, math.floor(sourceFrame or 0))
	targetFrame = math.max(0, math.min(self._durationFrames, math.floor(targetFrame or 0)))

	if sourceFrame == targetFrame then
		return false, "Keyframe is already at that frame."
	end

	local pose = self._frames[sourceFrame]
	if not pose then
		return false, string.format("Frame %d has no keyframe to move.", sourceFrame)
	end

	if self._frames[targetFrame] then
		return false, string.format("Frame %d already contains a keyframe.", targetFrame)
	end

	self._frames[sourceFrame] = nil
	self._frames[targetFrame] = pose
	for path in pairs(pose) do
		self:_moveKeyOptions(path, sourceFrame, targetFrame)
	end
	return true, string.format("Moved keyframe from %d to %d.", sourceFrame, targetFrame)
end

poseIsEmpty = function(pose)
	for _ in pairs(pose) do
		return false
	end
	return true
end

local function getPoseEasingStyleName(pose)
	local styleName = DEFAULT_EASING_STYLE
	pcall(function()
		styleName = pose.EasingStyle.Name
	end)
	if styleName == "Constant" then
		return "None"
	end

	local supportedStyles = {
		None = true,
		Linear = true,
		Sine = true,
		Quad = true,
		Cubic = true,
		Quart = true,
		Quint = true,
		Sextic = true,
		Back = true,
		Bounce = true,
		Elastic = true,
		Exponential = true,
		Circular = true,
	}

	if supportedStyles[styleName] then
		return styleName
	end

	return DEFAULT_EASING_STYLE
end

local function getPoseEasingDirectionName(pose)
	local directionName = DEFAULT_EASING_DIRECTION
	pcall(function()
		directionName = pose.EasingDirection.Name
	end)

	if directionName == "In" or directionName == "Out" or directionName == "InOut" then
		return directionName
	end

	return DEFAULT_EASING_DIRECTION
end

function TimelineModel:_clearRigKeyframes()
	local rigPaths = {}
	for _, motorData in ipairs(self._motors) do
		rigPaths[motorData.path] = true
		self._keyOptions[motorData.path] = nil
	end

	for frame, pose in pairs(self._frames) do
		for path in pairs(rigPaths) do
			pose[path] = nil
		end
		if poseIsEmpty(pose) then
			self._frames[frame] = nil
		end
	end
end

function TimelineModel:_buildImportPoseLookup(rigName)
	local lookup = {}
	for _, motorData in ipairs(self._motors) do
		local motor = motorData.instance
		if motor and motor.Parent and (not rigName or motorData.rigName == rigName) then
			if motor:IsA("Motor6D") and motor.Part1 then
				lookup[motor.Part1.Name] = motorData.path
			end
			lookup[motor.Name] = lookup[motor.Name] or motorData.path
			lookup[motorData.name] = lookup[motorData.name] or motorData.path
		end
	end
	return lookup
end

local function addCurveKeyTimes(curve, timesBySecond)
	if not curve then
		return
	end

	local success, keys = pcall(function()
		return curve:GetKeys()
	end)
	if not success then
		return
	end

	for _, key in ipairs(keys or {}) do
		local time = tonumber(key.Time)
		if time then
			timesBySecond[math.floor(time * 100000 + 0.5) / 100000] = true
		end
	end
end

local function addVector3CurveKeyTimes(curve, timesBySecond)
	if not curve or not curve:IsA("Vector3Curve") then
		return
	end

	local success, xCurve, yCurve, zCurve = pcall(function()
		return curve:X(), curve:Y(), curve:Z()
	end)
	if success then
		addCurveKeyTimes(xCurve, timesBySecond)
		addCurveKeyTimes(yCurve, timesBySecond)
		addCurveKeyTimes(zCurve, timesBySecond)
	end
end

local function addEulerRotationCurveKeyTimes(curve, timesBySecond)
	if not curve or not curve:IsA("EulerRotationCurve") then
		return
	end

	local success, xCurve, yCurve, zCurve = pcall(function()
		return curve:X(), curve:Y(), curve:Z()
	end)
	if success then
		addCurveKeyTimes(xCurve, timesBySecond)
		addCurveKeyTimes(yCurve, timesBySecond)
		addCurveKeyTimes(zCurve, timesBySecond)
	end
end

local function getVector3CurveValue(curve, time)
	if not curve then
		return Vector3.zero
	end

	local success, value = pcall(function()
		return curve:GetValueAtTime(time)
	end)
	if not success or value == nil then
		return Vector3.zero
	end

	if typeof(value) == "Vector3" then
		return value
	end

	if typeof(value) == "table" then
		return Vector3.new(tonumber(value[1]) or 0, tonumber(value[2]) or 0, tonumber(value[3]) or 0)
	end

	return Vector3.zero
end

local function getRotationCurveValue(curve, time)
	if not curve then
		return CFrame.new()
	end

	if curve:IsA("RotationCurve") then
		local success, value = pcall(function()
			return curve:GetValueAtTime(time)
		end)
		if success and typeof(value) == "CFrame" then
			return value
		end
	elseif curve:IsA("EulerRotationCurve") then
		local success, value = pcall(function()
			return curve:GetRotationAtTime(time)
		end)
		if success and typeof(value) == "CFrame" then
			return value
		end
	end

	return CFrame.new()
end

local function getFolderCurve(folder, curveName)
	local child = folder:FindFirstChild(curveName)
	if child and (child:IsA("Vector3Curve") or child:IsA("RotationCurve") or child:IsA("EulerRotationCurve")) then
		return child
	end
	return nil
end

function TimelineModel:importCurveAnimation(curveAnimation, options)
	if #self._motors == 0 then
		return false, "Bind a rig before importing an animation."
	end

	if not curveAnimation or not curveAnimation:IsA("CurveAnimation") then
		return false, "Only CurveAnimation clips can be imported with this path."
	end

	options = options or {}

	local poseLookup = self:_buildImportPoseLookup(options.rigName)
	local curveFolders = {}
	local timesBySecond = {}
	for _, descendant in ipairs(curveAnimation:GetDescendants()) do
		if descendant:IsA("Folder") then
			local path = poseLookup[descendant.Name]
			if path then
				local positionCurve = getFolderCurve(descendant, "Position")
				local rotationCurve = getFolderCurve(descendant, "Rotation")
				if positionCurve or rotationCurve then
					table.insert(curveFolders, {
						path = path,
						positionCurve = positionCurve,
						rotationCurve = rotationCurve,
					})
					addVector3CurveKeyTimes(positionCurve, timesBySecond)
					if rotationCurve then
						if rotationCurve:IsA("RotationCurve") then
							addCurveKeyTimes(rotationCurve, timesBySecond)
						elseif rotationCurve:IsA("EulerRotationCurve") then
							addEulerRotationCurveKeyTimes(rotationCurve, timesBySecond)
						end
					end
				end
			end
		end
	end

	if #curveFolders == 0 then
		return false, "No curve channels in that animation matched the bound rig."
	end

	timesBySecond[0] = true
	local clipLength = tonumber(curveAnimation.Length) or 0
	if clipLength &gt; 0 then
		local sampleStep = 1 / 30
		local sampleCount = math.max(1, math.ceil(clipLength / sampleStep))
		for sampleIndex = 0, sampleCount do
			local sampleTime = math.min(clipLength, sampleIndex * sampleStep)
			timesBySecond[math.floor(sampleTime * 100000 + 0.5) / 100000] = true
		end
		timesBySecond[math.floor(clipLength * 100000 + 0.5) / 100000] = true
	end

	local times = {}
	for time in pairs(timesBySecond) do
		table.insert(times, time)
	end
	table.sort(times)

	if #times == 0 and curveAnimation.Length and curveAnimation.Length &gt; 0 then
		table.insert(times, 0)
		table.insert(times, curveAnimation.Length)
	end

	if #times == 0 then
		return false, "That CurveAnimation did not contain any usable key times."
	end

	local importedTrackKeyCount = 0
	local importedFrameSet = {}
	local maxFrame = 0
	local frameOffset = tonumber(options.frameOffset)
	if frameOffset ~= nil then
		frameOffset = math.max(0, math.floor(frameOffset + 0.5))
	else
		frameOffset = math.max(0, (self:getLastKeyframe() or -1) + 1)
	end
	local repeatUntilFrame = tonumber(options.repeatUntilFrame)
	if repeatUntilFrame ~= nil then
		repeatUntilFrame = math.max(frameOffset, math.floor(repeatUntilFrame + 0.5))
	end
	local preserveMetadata = options.preserveMetadata == true
	local localFrames = {}
	local localMaxFrame = 0
	for index, time in ipairs(times) do
		local localFrame = math.max(0, math.floor(time * self._fps + 0.5))
		localFrames[index] = localFrame
		localMaxFrame = math.max(localMaxFrame, localFrame)
	end

	local cycleOffsets = { 0 }
	if repeatUntilFrame and localMaxFrame &gt; 0 then
		local cycleOffset = localMaxFrame
		while frameOffset + cycleOffset &lt;= repeatUntilFrame do
			table.insert(cycleOffsets, cycleOffset)
			cycleOffset += localMaxFrame
		end
	end
	local loopBlendFrames = #cycleOffsets &gt; 1 and getImportRepeatBlendFrames(options, localMaxFrame) or 0
	local firstCurveTime = times[1] or 0

	for _, cycleOffset in ipairs(cycleOffsets) do
		for index, time in ipairs(times) do
			local localFrame = localFrames[index]
			if not (cycleOffset &gt; 0 and localFrame == 0) then
				local frame = frameOffset + cycleOffset + localFrame
				if not repeatUntilFrame or frame &lt;= repeatUntilFrame then
					local pose = self._frames[frame] or {}
					local loopBlendAlpha = getImportRepeatBlendAlpha(localFrame, localMaxFrame, loopBlendFrames)

					for _, curveData in ipairs(curveFolders) do
						local originalC0 = self._originalPose[curveData.path]
						if typeof(originalC0) ~= "CFrame" then
							local track = self:getTrackByPath(curveData.path)
							originalC0 = track and track.originalValue
						end
						if typeof(originalC0) == "CFrame" then
							local position = getVector3CurveValue(curveData.positionCurve, time)
							local rotation = getRotationCurveValue(curveData.rotationCurve, time)
							local poseValue = originalC0 * CFrame.new(position) * rotation
							if loopBlendAlpha &gt; 0 then
								local firstPosition = getVector3CurveValue(curveData.positionCurve, firstCurveTime)
								local firstRotation = getRotationCurveValue(curveData.rotationCurve, firstCurveTime)
								poseValue = poseValue:Lerp(originalC0 * CFrame.new(firstPosition) * firstRotation, loopBlendAlpha)
							end
							pose[curveData.path] = poseValue
							self._keyOptions[curveData.path] = self._keyOptions[curveData.path] or {}
							self._keyOptions[curveData.path][frame] = {
								easingStyle = DEFAULT_EASING_STYLE,
								easingDirection = DEFAULT_EASING_DIRECTION,
							}
							importedTrackKeyCount += 1
							importedFrameSet[frame] = true
						end
					end

					if not poseIsEmpty(pose) then
						self._frames[frame] = pose
						maxFrame = math.max(maxFrame, frame)
					end
				end
			end
		end
	end

	if importedTrackKeyCount == 0 then
		return false, "No CurveAnimation keys could be converted for this rig."
	end

	local importedFrameCount = 0
	for _ in pairs(importedFrameSet) do
		importedFrameCount += 1
	end

	self._durationFrames = math.max(self._durationFrames, maxFrame)
	if not preserveMetadata then
		self._animationName = curveAnimation.Name ~= "" and curveAnimation.Name or self._animationName
		pcall(function()
			self._looping = curveAnimation.Loop == true
		end)
		pcall(function()
			self._priority = curveAnimation.Priority.Name
		end)
	end

	return true, string.format(
		"Imported CurveAnimation '%s' as %d track keyframes across %d frames.",
		curveAnimation.Name,
		importedTrackKeyCount,
		importedFrameCount
	)
end

local function decodeImportedKeyframeMarkerValue(value)
	local text = tostring(value or "")
	if text == "" then
		return ""
	end

	local success, decoded = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	return success and decoded or text
end

local function getImportedKeyframeMarkers(keyframe)
	local markers = {}
	local success, result = pcall(function()
		return keyframe:GetMarkers()
	end)
	if success and type(result) == "table" then
		for _, marker in ipairs(result) do
			if marker and marker:IsA("KeyframeMarker") then
				table.insert(markers, marker)
			end
		end
	end

	if #markers == 0 then
		for _, child in ipairs(keyframe:GetChildren()) do
			if child:IsA("KeyframeMarker") then
				table.insert(markers, child)
			end
		end
	end
	return markers
end

local function buildImportedMarkerValue(marker)
	local markerValue = ""
	pcall(function()
		markerValue = marker.Value
	end)

	local decoded = decodeImportedKeyframeMarkerValue(markerValue)
	if type(decoded) == "table" then
		decoded.name = decoded.name or marker.Name
		if decoded.payload == nil and markerValue ~= "" then
			decoded.payload = markerValue
		end
		return decoded
	end

	return {
		name = marker.Name,
		payload = tostring(decoded or ""),
	}
end

function TimelineModel:importKeyframeSequence(keyframeSequence, options)
	if #self._motors == 0 then
		return false, "Bind a rig before importing an animation."
	end

	if not keyframeSequence or not keyframeSequence:IsA("KeyframeSequence") then
		return false, "Only KeyframeSequence animation clips can be imported right now."
	end

	options = options or {}

	local keyframes = keyframeSequence:GetKeyframes()
	if #keyframes == 0 then
		return false, "That animation does not contain any keyframes."
	end

	table.sort(keyframes, function(a, b)
		return a.Time &lt; b.Time
	end)

	local poseLookup = self:_buildImportPoseLookup(options.rigName)

	local importedTrackKeyCount = 0
	local importedFrameCount = 0
	local unmatchedPoseCount = 0
	local maxFrame = 0
	local frameOffset = tonumber(options.frameOffset)
	if frameOffset ~= nil then
		frameOffset = math.max(0, math.floor(frameOffset + 0.5))
	else
		frameOffset = math.max(0, (self:getLastKeyframe() or -1) + 1)
	end
	local repeatUntilFrame = tonumber(options.repeatUntilFrame)
	if repeatUntilFrame ~= nil then
		repeatUntilFrame = math.max(frameOffset, math.floor(repeatUntilFrame + 0.5))
	end
	local preserveMetadata = options.preserveMetadata == true
	local keyframeLocalFrames = {}
	local localMaxFrame = 0
	local importedMarkerKeyCount = 0
	local markerTracksByName = {}
	local function getMarkerImportTrack(markerName, frame)
		local baseName = tostring(markerName or "")
		baseName = string.gsub(baseName, "[%c]", " ")
		baseName = string.gsub(baseName, "^%s+", "")
		baseName = string.gsub(baseName, "%s+$", "")
		if baseName == "" then
			baseName = "Animation Event"
		end

		local name = baseName
		local track = markerTracksByName[name]
		if track and self:hasTrackKeyframe(track.path, frame) then
			local suffix = 2
			repeat
				name = string.format("%s %d", baseName, suffix)
				track = markerTracksByName[name]
				suffix += 1
			until not track or not self:hasTrackKeyframe(track.path, frame)
		end

		if not track then
			track = self:addGenericTrack("Event", nil, name, {
				sortOrder = DEFAULT_GENERIC_TRACK_SORT_ORDERS.Event,
			})
			markerTracksByName[name] = track
		end
		return track
	end
	for index, keyframe in ipairs(keyframes) do
		local localFrame = math.max(0, math.floor((keyframe.Time or 0) * self._fps + 0.5))
		keyframeLocalFrames[index] = localFrame
		localMaxFrame = math.max(localMaxFrame, localFrame)
	end

	local cycleOffsets = { 0 }
	if repeatUntilFrame and localMaxFrame &gt; 0 then
		local cycleOffset = localMaxFrame
		while frameOffset + cycleOffset &lt;= repeatUntilFrame do
			table.insert(cycleOffsets, cycleOffset)
			cycleOffset += localMaxFrame
		end
	end
	local loopBlendFrames = #cycleOffsets &gt; 1 and getImportRepeatBlendFrames(options, localMaxFrame) or 0
	local firstPoseCFrames = {}
	if loopBlendFrames &gt; 0 and keyframes[1] then
		for _, descendant in ipairs(keyframes[1]:GetDescendants()) do
			if descendant:IsA("Pose") then
				firstPoseCFrames[descendant.Name] = descendant.CFrame
			end
		end
	end

	local importedFrameSet = {}
	for _, cycleOffset in ipairs(cycleOffsets) do
		for index, keyframe in ipairs(keyframes) do
			local localFrame = keyframeLocalFrames[index]
			if not (cycleOffset &gt; 0 and localFrame == 0) then
				local frame = frameOffset + cycleOffset + localFrame
				if not repeatUntilFrame or frame &lt;= repeatUntilFrame then
					local pose = self._frames[frame] or {}
					local frameImported = false
					local loopBlendAlpha = getImportRepeatBlendAlpha(localFrame, localMaxFrame, loopBlendFrames)

					for _, descendant in ipairs(keyframe:GetDescendants()) do
						if descendant:IsA("Pose") then
							local path = poseLookup[descendant.Name]
							local originalC0 = path and self._originalPose[path]
							if path and typeof(originalC0) ~= "CFrame" then
								local track = self:getTrackByPath(path)
								originalC0 = track and track.originalValue
							end
							if path and typeof(originalC0) == "CFrame" then
								local poseValue = originalC0 * descendant.CFrame
								local firstPoseCFrame = firstPoseCFrames[descendant.Name]
								if loopBlendAlpha &gt; 0 and typeof(firstPoseCFrame) == "CFrame" then
									poseValue = poseValue:Lerp(originalC0 * firstPoseCFrame, loopBlendAlpha)
								end
								local easingStyle = getPoseEasingStyleName(descendant)
								local easingDirection = getPoseEasingDirectionName(descendant)
								if loopBlendAlpha &gt; 0 then
									easingStyle = DEFAULT_EASING_STYLE
									easingDirection = DEFAULT_EASING_DIRECTION
								end
								pose[path] = poseValue
								self._keyOptions[path] = self._keyOptions[path] or {}
								self._keyOptions[path][frame] = {
									easingStyle = easingStyle,
									easingDirection = easingDirection,
								}
								importedTrackKeyCount += 1
								frameImported = true
							elseif descendant.CFrame ~= CFrame.new() then
								unmatchedPoseCount += 1
							end
						end
					end

					for _, marker in ipairs(getImportedKeyframeMarkers(keyframe)) do
						local markerTrack = getMarkerImportTrack(marker.Name, frame)
						if markerTrack then
							pose[markerTrack.path] = buildImportedMarkerValue(marker)
							self:_ensureKeyOptions(markerTrack.path, frame)
							importedMarkerKeyCount += 1
							frameImported = true
						end
					end

					if frameImported then
						self._frames[frame] = pose
						importedFrameSet[frame] = true
						maxFrame = math.max(maxFrame, frame)
					elseif poseIsEmpty(pose) then
						self._frames[frame] = nil
					end
				end
			end
		end
	end

	if importedTrackKeyCount == 0 and importedMarkerKeyCount == 0 then
		return false, "No poses or animation event markers in that animation matched the current timeline."
	end

	for _ in pairs(importedFrameSet) do
		importedFrameCount += 1
	end

	self._durationFrames = math.max(self._durationFrames, maxFrame)
	if not preserveMetadata then
		self._animationName = keyframeSequence.Name ~= "" and keyframeSequence.Name or self._animationName
		pcall(function()
			self._looping = keyframeSequence.Loop == true
		end)
		pcall(function()
			self._priority = keyframeSequence.Priority.Name
		end)
	end

	local warning = unmatchedPoseCount &gt; 0 and string.format(" %d poses did not match this rig.", unmatchedPoseCount) or ""
	local markerSummary = importedMarkerKeyCount &gt; 0
		and string.format(" and %d event marker%s", importedMarkerKeyCount, importedMarkerKeyCount == 1 and "" or "s")
		or ""
	return true, string.format(
		"Imported %d track keyframes%s across %d frames from '%s'.%s",
		importedTrackKeyCount,
		markerSummary,
		importedFrameCount,
		keyframeSequence.Name,
		warning
	)
end

function TimelineModel:moveTrackKeyframe(path, sourceFrame, targetFrame)
	if not path then
		return false, "Select a track keyframe before moving it."
	end

	sourceFrame = math.max(0, math.floor(sourceFrame or 0))
	targetFrame = math.max(0, math.min(self._durationFrames, math.floor(targetFrame or 0)))

	if sourceFrame == targetFrame then
		return false, "Keyframe is already at that frame."
	end

	local sourcePose = self._frames[sourceFrame]
	if not sourcePose or sourcePose[path] == nil then
		return false, string.format("That track has no keyframe at frame %d.", sourceFrame)
	end

	local targetPose = self._frames[targetFrame]
	if targetPose and targetPose[path] ~= nil then
		return false, string.format("That track already has a keyframe at frame %d.", targetFrame)
	end

	targetPose = targetPose or {}
	self._frames[targetFrame] = targetPose
	targetPose[path] = sourcePose[path]
	sourcePose[path] = nil
	self:_moveKeyOptions(path, sourceFrame, targetFrame)

	if poseIsEmpty(sourcePose) then
		self._frames[sourceFrame] = nil
	end

	return true, string.format("Moved track keyframe from %d to %d.", sourceFrame, targetFrame)
end

function TimelineModel:moveTrackKeyframes(keyList, offset)
	offset = math.floor(offset or 0)
	if offset == 0 then
		return false, "No timeline movement was requested."
	end

	if type(keyList) ~= "table" or #keyList == 0 then
		return false, "No keyframes were selected."
	end

	local normalized = {}
	local sourceKeys = {}
	local targetKeys = {}
	for _, key in ipairs(keyList) do
		local path = key.jointPath or key.path
		local frame = math.max(0, math.floor(key.frame or 0))
		if path and self:hasTrackKeyframe(path, frame) then
			local targetFrame = math.max(0, math.min(self._durationFrames, frame + offset))
			if targetFrame == frame then
				return false, "Selected keyframes are already at the edge of the timeline."
			end

			local sourceId = makeTrackKeyId(path, frame)
			local targetId = makeTrackKeyId(path, targetFrame)
			if not sourceKeys[sourceId] then
				if targetKeys[targetId] then
					return false, "Selected keyframes would overlap after moving."
				end

				sourceKeys[sourceId] = true
				targetKeys[targetId] = true
				table.insert(normalized, {
					path = path,
					frame = frame,
					targetFrame = targetFrame,
				})
			end
		end
	end

	if #normalized == 0 then
		return false, "Selected keyframes are no longer available."
	end

	for _, key in ipairs(normalized) do
		local targetPose = self._frames[key.targetFrame]
		if targetPose and targetPose[key.path] ~= nil and not sourceKeys[makeTrackKeyId(key.path, key.targetFrame)] then
			return false, string.format("That track already has a keyframe at frame %d.", key.targetFrame)
		end
	end

	local moved = {}
	for _, key in ipairs(normalized) do
		local sourcePose = self._frames[key.frame]
			table.insert(moved, {
				path = key.path,
				frame = key.frame,
				targetFrame = key.targetFrame,
				value = sourcePose[key.path],
				keyOptions = cloneValue(self:getKeyOptions(key.path, key.frame)),
			})
			sourcePose[key.path] = nil
			self:_deleteKeyOptions(key.path, key.frame)
			if poseIsEmpty(sourcePose) then
				self._frames[key.frame] = nil
			end
	end

	for _, key in ipairs(moved) do
		local targetPose = self._frames[key.targetFrame] or {}
		self._frames[key.targetFrame] = targetPose
		targetPose[key.path] = key.value
		self._keyOptions[key.path] = self._keyOptions[key.path] or {}
		self._keyOptions[key.path][key.targetFrame] = key.keyOptions
	end

	return true, "Moved selected track keyframes."
end

function TimelineModel:deleteTrackKeyframes(keyList)
	local deletedCount = 0
	local seen = {}
	for _, key in ipairs(keyList or {}) do
		local path = key.jointPath or key.path
		local frame = math.max(0, math.floor(key.frame or 0))
		local id = makeTrackKeyId(path, frame)
		local pose = self._frames[frame]
		if path and pose and pose[path] ~= nil and not seen[id] then
				seen[id] = true
				pose[path] = nil
				self:_deleteKeyOptions(path, frame)
				deletedCount += 1
			if poseIsEmpty(pose) then
				self._frames[frame] = nil
			end
		end
	end

	if deletedCount == 0 then
		return false, "No selected keyframes could be deleted.", 0
	end

	return true, string.format("Deleted %d selected keyframes.", deletedCount), deletedCount
end

function TimelineModel:clearTrackKeyframesAfter(path, afterFrame)
	if not path then
		return 0
	end

	afterFrame = normalizeFrame(afterFrame)
	local deletedCount = 0
	for frame, pose in pairs(self._frames) do
		if frame &gt; afterFrame and type(pose) == "table" and pose[path] ~= nil then
			pose[path] = nil
			self:_deleteKeyOptions(path, frame)
			deletedCount += 1
			if poseIsEmpty(pose) then
				self._frames[frame] = nil
			end
		end
	end

	return deletedCount
end

function TimelineModel:pasteTrackKeyframes(clipboardKeys, targetFrame)
	local keys = cloneTrackKeys(clipboardKeys)
	if #keys == 0 then
		return false, "Copy or cut keyframes before pasting.", {}
	end

	targetFrame = math.max(0, math.floor(targetFrame or 0))
	local pastedKeys = {}
	local maxFrame = self._durationFrames
	for _, key in ipairs(keys) do
		local frame = targetFrame + math.floor(key.frame or 0)
		maxFrame = math.max(maxFrame, frame)
	end
	self._durationFrames = maxFrame

	for _, key in ipairs(keys) do
		local path = key.jointPath or key.path
		local frame = targetFrame + math.floor(key.frame or 0)
		if path and key.value ~= nil then
			local pose = self._frames[frame] or {}
				self._frames[frame] = pose
				pose[path] = key.value
				self._keyOptions[path] = self._keyOptions[path] or {}
				self._keyOptions[path][frame] = {
					easingStyle = key.easingStyle or DEFAULT_EASING_STYLE,
					easingDirection = key.easingDirection or DEFAULT_EASING_DIRECTION,
				}
				table.insert(pastedKeys, {
				jointPath = path,
				frame = frame,
			})
		end
	end

	if #pastedKeys == 0 then
		return false, "No keyframes could be pasted.", {}
	end

	return true, string.format("Pasted %d keyframes.", #pastedKeys), pastedKeys
end

function TimelineModel:moveKeyframes(frameList, offset)
	offset = math.floor(offset or 0)
	if offset == 0 then
		return false, "No timeline movement was requested."
	end

	if type(frameList) ~= "table" or #frameList == 0 then
		return false, "No keyframes were selected."
	end

	local normalized = {}
	local seen = {}
	for _, frame in ipairs(frameList) do
		frame = math.max(0, math.floor(frame))
		if self._frames[frame] and not seen[frame] then
			seen[frame] = true
			table.insert(normalized, frame)
		end
	end

	if #normalized == 0 then
		return false, "Selected keyframes are no longer available."
	end

	table.sort(normalized)

	local moved = {}
	local occupiedAfterMove = {}
	for _, frame in ipairs(normalized) do
		occupiedAfterMove[frame] = true
	end

	local targets = {}
	for _, frame in ipairs(normalized) do
		local targetFrame = math.max(0, math.min(self._durationFrames, frame + offset))
		if targetFrame == frame then
			return false, "Selected keyframes are already at the edge of the timeline."
		end
		targets[frame] = targetFrame
	end

	for sourceFrame, targetFrame in pairs(targets) do
		if not occupiedAfterMove[targetFrame] and self._frames[targetFrame] then
			return false, string.format("Frame %d already contains a keyframe.", targetFrame)
		end
	end

	for _, frame in ipairs(normalized) do
		moved[frame] = self._frames[frame]
		self._frames[frame] = nil
	end

	for _, frame in ipairs(normalized) do
		self._frames[targets[frame]] = moved[frame]
	end

	return true, "Moved selected keyframes."
end

local function lerpValue(aValue, bValue, alpha)
	if typeof(aValue) == "CFrame" and typeof(bValue) == "CFrame" then
		return aValue:Lerp(bValue, alpha)
	end

	if typeof(aValue) == "CFrame" and type(bValue) == "table" and typeof(bValue.cframe or bValue.CFrame) == "CFrame" then
		local normalizedB = cloneValue(bValue)
		normalizedB.cframe = normalizedB.cframe or normalizedB.CFrame
		normalizedB.CFrame = nil
		local normalizedA = cloneValue(normalizedB)
		normalizedA.cframe = aValue
		return lerpValue(normalizedA, normalizedB, alpha)
	end

	if type(aValue) == "table" and typeof(aValue.cframe or aValue.CFrame) == "CFrame" and typeof(bValue) == "CFrame" then
		local normalizedA = cloneValue(aValue)
		normalizedA.cframe = normalizedA.cframe or normalizedA.CFrame
		normalizedA.CFrame = nil
		local normalizedB = cloneValue(normalizedA)
		normalizedB.cframe = bValue
		return lerpValue(normalizedA, normalizedB, alpha)
	end

	if type(aValue) == "number" and type(bValue) == "number" then
		return aValue + ((bValue - aValue) * alpha)
	end

	if type(aValue) == "boolean" and type(bValue) == "boolean" then
		return alpha &gt;= 1 and bValue or aValue
	end

	if typeof(aValue) == "Color3" and typeof(bValue) == "Color3" then
		return aValue:Lerp(bValue, alpha)
	end

	if typeof(aValue) == "ColorSequence" and typeof(bValue) == "ColorSequence" then
		local left = aValue.Keypoints[1] and aValue.Keypoints[1].Value or Color3.new(1, 1, 1)
		local right = bValue.Keypoints[1] and bValue.Keypoints[1].Value or left
		return ColorSequence.new(left:Lerp(right, alpha))
	end

	if typeof(aValue) == "NumberSequence" and typeof(bValue) == "NumberSequence" then
		local left = aValue.Keypoints[1] and aValue.Keypoints[1].Value or 0
		local right = bValue.Keypoints[1] and bValue.Keypoints[1].Value or left
		return NumberSequence.new(left + ((right - left) * alpha))
	end

	if typeof(aValue) == "NumberRange" and typeof(bValue) == "NumberRange" then
		return NumberRange.new(
			aValue.Min + ((bValue.Min - aValue.Min) * alpha),
			aValue.Max + ((bValue.Max - aValue.Max) * alpha)
		)
	end

	if typeof(aValue) == "Vector2" and typeof(bValue) == "Vector2" then
		return aValue:Lerp(bValue, alpha)
	end

	if typeof(aValue) == "Vector3" and typeof(bValue) == "Vector3" then
		return aValue:Lerp(bValue, alpha)
	end

	if type(aValue) == "table" and type(bValue) == "table" then
		local value = {}
		local seen = {}
		for key, leftValue in pairs(aValue) do
			seen[key] = true
			if bValue[key] ~= nil then
				value[key] = lerpValue(leftValue, bValue[key], alpha)
			else
				value[key] = cloneValue(leftValue)
			end
		end
		for key, rightValue in pairs(bValue) do
			if not seen[key] then
				value[key] = cloneValue(rightValue)
			end
		end
		return value
	end

	if alpha &lt; 0.5 then
		return aValue
	end

	return bValue
end

local function easingEnum(enumType, name, fallback)
	local success, value = pcall(function()
		return enumType[name]
	end)
	if success and value then
		return value
	end
	return enumType[fallback]
end

local function applyEasing(alpha, options)
	alpha = math.clamp(alpha, 0, 1)
	options = options or {}
	local styleName = options.easingStyle or DEFAULT_EASING_STYLE
	if styleName == "None" then
		return alpha &gt;= 1 and 1 or 0
	end
	local direction = easingEnum(Enum.EasingDirection, options.easingDirection or DEFAULT_EASING_DIRECTION, DEFAULT_EASING_DIRECTION)
	if styleName == "Sextic" then
		if direction == Enum.EasingDirection.In then
			return alpha ^ 6
		elseif direction == Enum.EasingDirection.Out then
			return 1 - ((1 - alpha) ^ 6)
		end

		if alpha &lt; 0.5 then
			return 0.5 * ((alpha * 2) ^ 6)
		end
		return 1 - (0.5 * (((1 - alpha) * 2) ^ 6))
	end

	local style = easingEnum(Enum.EasingStyle, styleName, DEFAULT_EASING_STYLE)
	local success, eased = pcall(function()
		return TweenService:GetValue(alpha, style, direction)
	end)
	if success then
		return eased
	end
	return alpha
end

function TimelineModel:getTrackNeighborFrames(path, targetFrame)
	local previousFrame = nil
	local nextFrame = nil

	for _, frame in ipairs(self:getTrackKeyframeFrames(path)) do
		if frame &lt;= targetFrame then
			previousFrame = frame
		end
		if frame &gt;= targetFrame then
			nextFrame = frame
			break
		end
	end

	return previousFrame, nextFrame
end

function TimelineModel:getAllAnimatedPaths()
	local paths = {}
	local seen = {}
	for _, track in ipairs(self:getTracks()) do
		seen[track.path] = true
		table.insert(paths, track.path)
	end

	for _, pose in pairs(self._frames) do
		for path in pairs(pose) do
			if not seen[path] then
				seen[path] = true
				table.insert(paths, path)
			end
		end
	end

	table.sort(paths)
	return paths
end

function TimelineModel:getNeighborFrames(targetFrame)
	local previousFrame = nil
	local nextFrame = nil

	for _, frame in ipairs(self:getKeyframeFrames()) do
		if frame &lt;= targetFrame then
			previousFrame = frame
		end
		if frame &gt;= targetFrame then
			nextFrame = frame
			break
		end
	end

	return previousFrame, nextFrame
end

function TimelineModel:getPreviousKeyframe()
	local previousFrame = nil
	for _, frame in ipairs(self:getKeyframeFrames()) do
		if frame &lt; self._currentFrame then
			previousFrame = frame
		else
			break
		end
	end
	return previousFrame
end

function TimelineModel:getNextKeyframe()
	for _, frame in ipairs(self:getKeyframeFrames()) do
		if frame &gt; self._currentFrame then
			return frame
		end
	end
	return nil
end

function TimelineModel:samplePose(frame)
	frame = math.max(0, tonumber(frame) or 0)
	local result = {}
	local usedInterpolation = false

	for _, path in ipairs(self:getAllAnimatedPaths()) do
		local track = self:getTrackByPath(path)
		if track and isOneShotParticleEventTrack(track) then
			continue
		end
		if track and isOneShotSoundTrack(track) then
			local previousFrame, nextFrame = self:getTrackNeighborFrames(path, frame)
			if previousFrame ~= nil then
				result[path] = self._frames[previousFrame][path]
			elseif nextFrame ~= nil then
				result[path] = self._frames[nextFrame][path]
			end
			continue
		end
		local previousFrame, nextFrame = self:getTrackNeighborFrames(path, frame)
		if previousFrame ~= nil or nextFrame ~= nil then
			if previousFrame == nil then
				if track and isDiscreteObjectPropertyTrack(track) and track.originalValue ~= nil then
					result[path] = cloneValue(track.originalValue)
				else
					result[path] = self._frames[nextFrame][path]
				end
			elseif nextFrame == nil or previousFrame == nextFrame then
				result[path] = self._frames[previousFrame][path]
			elseif track and isDiscreteObjectPropertyTrack(track) then
				result[path] = self._frames[previousFrame][path]
			else
				local alpha = (frame - previousFrame) / (nextFrame - previousFrame)
				alpha = applyEasing(alpha, self:getKeyOptions(path, nextFrame))
				result[path] = lerpValue(self._frames[previousFrame][path], self._frames[nextFrame][path], alpha)
				usedInterpolation = true
			end
		end
	end

	if poseIsEmpty(result) then
		return nil, "empty"
	end

	local roundedFrame = normalizeFrame(frame)
	if math.abs(frame - roundedFrame) &lt; 0.001 and self._frames[roundedFrame] and not usedInterpolation then
		return result, "exact"
	end

	return result, usedInterpolation and "interpolated" or "held"
end

function TimelineModel:applyFrame(frame)
	frame = math.max(0, tonumber(frame) or 0)
	local attachService = prepareAttachmentFrame(self, frame)
	local pose, mode = self:samplePose(frame)
	if not pose then
		applyAttachmentFrame(attachService, self, frame)
		return false, string.format("Frame %.2f has no keyframe to apply.", frame)
	end

	local success, message = self:applyPoseSnapshot(pose)
	if not success then
		applyAttachmentFrame(attachService, self, frame)
		return false, message
	end
	applyAttachmentFrame(attachService, self, frame)

	if mode == "interpolated" then
		return true, string.format("Previewed interpolated frame %.2f.", frame)
	end

	return true, string.format("Applied frame %.2f.", frame)
end

function TimelineModel:applyPoseSnapshot(pose)
	if type(pose) ~= "table" then
		return false, "No baked pose data was available."
	end

	local enabledPose = {}
	local suppressedApplyPaths = self._suppressedApplyPaths or {}
	for path, value in pairs(pose) do
		if not self:isTrackDisabled(path) and not suppressedApplyPaths[path] then
			enabledPose[path] = value
		end
	end

	local genericCount, preAppliedGenericPaths = applyScaleTracksFromPose(self._genericTracks, enabledPose)
	local appliedCount = RigService.applyPose(self._motors, self:_buildScaledRigPoseForApply(enabledPose))
	for _, track in ipairs(self._genericTracks) do
		local value = enabledPose[track.path]
		if value ~= nil and not preAppliedGenericPaths[track.path] and track.targetScope ~= "CameraProperty" then
			if applyGenericTrackValue(track, value) then
				genericCount += 1
			end
		end
	end
	for _, track in ipairs(self._genericTracks) do
		local value = enabledPose[track.path]
		if value ~= nil and not preAppliedGenericPaths[track.path] and track.targetScope == "CameraProperty" then
			if applyGenericTrackValue(track, value) then
				genericCount += 1
			end
		end
	end

	if appliedCount + genericCount == 0 then
		return false, "No joints were updated while applying the frame."
	end

	return true, string.format("Applied baked pose to %d tracks.", appliedCount + genericCount)
end

function TimelineModel:applyRigCFrameTracksAtFrame(frame)
	local pose = self:samplePose(frame)
	if type(pose) ~= "table" then
		return 0
	end

	local appliedCount = 0
	for _, track in ipairs(self._genericTracks) do
		if track.targetScope == "RigProperty" and track.propertyName == "CFrame" and not self:isTrackDisabled(track.path) then
			local value = pose[track.path]
			if value ~= nil and applyGenericTrackValue(track, value) then
				appliedCount += 1
			end
		end
	end

	return appliedCount
end

function TimelineModel:applyCurrentFrame()
	return self:applyFrame(self._currentFrame)
end

function TimelineModel:triggerParticleEventsBetween(startFrame, endFrame)
	startFrame = tonumber(startFrame) or 0
	endFrame = tonumber(endFrame) or startFrame
	if endFrame &lt; startFrame then
		startFrame, endFrame = endFrame, startFrame
	end

	local triggered = 0
	for _, track in ipairs(self._genericTracks) do
		if isOneShotParticleEventTrack(track) and not self:isTrackDisabled(track.path) then
			for _, frame in ipairs(self:getTrackKeyframeFrames(track.path)) do
				if frame &gt; startFrame and frame &lt;= endFrame then
					local pose = self._frames[frame]
					local payload = pose and pose[track.path]
					if payload ~= nil then
						local actionName = (type(payload) == "table" and payload.actionName) or track.eventName or track.propertyName or track.name
						local success, count = ParticleEmitterGroupService.runAction(track, actionName, payload)
						if success then
							triggered += count
						end
					end
				end
			end
		end
	end

	return triggered
end

-- ParticleEmitters do not expose a negative TimeScale or a timeline seek API.
-- Scrubbing can still behave predictably: moving forward replays crossed
-- Emit/Clear events, while any backward movement clears active one-shot bursts.
-- Clearing on every backward move is intentional because an Emit event may live
-- at frame 0, where there is no earlier timeline frame to cross. Paused emitters
-- are resumed only when their Emit event is crossed while moving forward.
function TimelineModel:scrubParticleEventsBetween(startFrame, endFrame)
	startFrame = tonumber(startFrame) or 0
	endFrame = tonumber(endFrame) or startFrame
	if math.abs(endFrame - startFrame) &lt; 0.001 then
		return 0
	end

	if endFrame &gt; startFrame then
		for _, track in ipairs(self._genericTracks) do
			if isOneShotParticleEventTrack(track) and not self:isTrackDisabled(track.path) then
				for _, frame in ipairs(self:getTrackKeyframeFrames(track.path)) do
					if frame &gt; startFrame and frame &lt;= endFrame then
						local pose = self._frames[frame]
						local payload = pose and pose[track.path]
						local actionName = payload ~= nil
							and ((type(payload) == "table" and payload.actionName) or track.eventName or track.propertyName or track.name)
							or nil
						if tostring(actionName):lower() == "emit" then
							for _, emitter in ipairs(ParticleEmitterGroupService.getTrackEmitters(track)) do
								if emitter.TimeScale &lt;= 0 then
									emitter.TimeScale = 1
								end
							end
						end
					end
				end
			end
		end
		return self:triggerParticleEventsBetween(startFrame, endFrame)
	end

	local cleared = 0
	for _, track in ipairs(self._genericTracks) do
		if isOneShotParticleEventTrack(track) and not self:isTrackDisabled(track.path) then
			local success, count = ParticleEmitterGroupService.runAction(track, "Clear", {})
			if success then
				cleared += count
			end
		end
	end

	return cleared
end

function TimelineModel:triggerSoundEventsBetween(startFrame, endFrame)
	startFrame = tonumber(startFrame) or 0
	endFrame = tonumber(endFrame) or startFrame
	if endFrame &lt; startFrame then
		startFrame, endFrame = endFrame, startFrame
	end

	local triggered = 0
	for _, track in ipairs(self._genericTracks) do
		if SoundTimelineService.isSoundTrack(track) and not self:isTrackDisabled(track.path) then
			for _, frame in ipairs(self:getTrackKeyframeFrames(track.path)) do
				if frame &gt; startFrame and frame &lt;= endFrame then
					local pose = self._frames[frame]
					local payload = pose and pose[track.path]
					if payload ~= nil then
						if SoundTimelineService.play(track.instance, payload) then
							triggered += 1
						else
							warn(string.format("[7kg2 Animator] Sound trigger failed for track '%s' at frame %s.", tostring(track.name or track.path), tostring(frame)))
						end
					end
				end
			end
		end
	end

	return triggered
end

local function isGenericEventTrack(track)
	return track ~= nil and (track.trackType == "Event" or track.valueType == "Event")
end

local function isSavedTimelineFolderTrack(track)
	return type(track) == "table"
		and (track.trackType == "Folder" or track.valueType == "Folder" or track.targetScope == "TimelineFolder")
end

local function restoreOrphanedTimelineFolders(timeline, savedTracks, extra, pathMap)
	local restoredCount = 0
	local attemptedPaths = {}
	for _, childTrack in ipairs(savedTracks or {}) do
		local savedFolderPath = childTrack.folderPath
		if type(savedFolderPath) == "string" and not pathMap[savedFolderPath] and not attemptedPaths[savedFolderPath] then
			attemptedPaths[savedFolderPath] = true
			local savedFolder = nil
			for _, candidate in ipairs(savedTracks or {}) do
				if candidate.path == savedFolderPath and isSavedTimelineFolderTrack(candidate) then
					savedFolder = candidate
					break
				end
			end
			local folderName = savedFolder and savedFolder.name or nil
			if not folderName then
				for _, group in ipairs(type(extra and extra.groups) == "table" and extra.groups or {}) do
					if group.folderPath == savedFolderPath and group.kind == "PhysicsClip" then
						folderName = "Physics Capture"
						break
					end
				end
			end
			local restoredFolder = timeline:addGenericTrack("Folder", nil, folderName or "Restored Folder", {
				targetScope = "TimelineFolder",
				folderColorId = savedFolder and savedFolder.folderColorId or nil,
				defaultCollapsed = savedFolder and savedFolder.defaultCollapsed == true or folderName == "Physics Capture",
				defaultCollapseToken = savedFolder and savedFolder.defaultCollapseToken or nil,
				sortOrder = savedFolder and savedFolder.sortOrder or 2,
				visualOrder = savedFolder and savedFolder.visualOrder or nil,
			})
			if restoredFolder then
				pathMap[savedFolderPath] = restoredFolder.path
				timeline._trackVisualOrder[restoredFolder.path] = tonumber(savedFolder and savedFolder.visualOrder) or timeline._trackVisualOrder[restoredFolder.path]
				restoredCount += 1
			end
		end
	end
	return restoredCount
end

local function runEventCode(timeline, track, frame, payload, phase, code)
	return EventScriptExecutionService.run(code, {
		timeline = timeline,
		track = track,
		frame = frame,
		phase = phase,
		event = type(payload) == "table" and (payload.name or payload.eventName or track.eventName or track.name) or track.name,
		payload = type(payload) == "table" and payload.payload or payload,
		value = payload,
	})
end

function TimelineModel:triggerEventScriptsBetween(startFrame, endFrame)
	startFrame = tonumber(startFrame) or 0
	endFrame = tonumber(endFrame) or startFrame
	if endFrame &lt; startFrame then
		startFrame, endFrame = endFrame, startFrame
	end

	local triggered = 0
	for _, track in ipairs(self._genericTracks) do
		if isGenericEventTrack(track) and not self:isTrackDisabled(track.path) then
			for _, frame in ipairs(self:getTrackKeyframeFrames(track.path)) do
				local pose = self._frames[frame]
				local payload = pose and pose[track.path]
				if type(payload) == "table" then
					if frame &gt; startFrame and frame &lt;= endFrame and payload.codeBegin and payload.codeBegin ~= "" then
						if runEventCode(self, track, frame, payload, "Begin", payload.codeBegin) then
							triggered += 1
						end
					end
					local durationFrames = math.max(0, tonumber(payload.durationFrames) or 0)
					local endAtFrame = frame + durationFrames
					if endAtFrame &gt; startFrame and endAtFrame &lt;= endFrame and payload.codeEnd and payload.codeEnd ~= "" then
						if runEventCode(self, track, endAtFrame, payload, "End", payload.codeEnd) then
							triggered += 1
						end
					end
				end
			end
		end
	end

	return triggered
end

function TimelineModel:clearEventScriptPreviewObjects()
	return EventScriptExecutionService.clearPreviewObjects()
end

function TimelineModel:resumeSoundTracksAtFrame(frame)
	frame = tonumber(frame) or 0
	local fps = math.max(1, tonumber(self:getFps()) or 60)
	local resumed = 0
	for _, track in ipairs(self._genericTracks) do
		if SoundTimelineService.isSoundTrack(track) and not self:isTrackDisabled(track.path) then
			local resumeFrame = nil
			for _, keyframe in ipairs(self:getTrackKeyframeFrames(track.path)) do
				if keyframe &lt; frame then
					resumeFrame = keyframe
				else
					break
				end
			end
			if resumeFrame ~= nil then
				local pose = self._frames[resumeFrame]
				local payload = pose and pose[track.path]
				if payload ~= nil then
					local elapsedSeconds = math.max(0, (frame - resumeFrame) / fps)
					if SoundTimelineService.play(track.instance, payload, elapsedSeconds) then
						resumed += 1
					end
				end
			end
		end
	end
	return resumed
end

function TimelineModel:stopSoundTracks()
	local stopped = 0
	for _, track in ipairs(self._genericTracks) do
		if SoundTimelineService.isSoundTrack(track) and SoundTimelineService.stop(track.instance) then
			stopped += 1
		end
	end
	return stopped
end

function TimelineModel:resetRigPose()
	if #self._motors == 0 then
		return false
	end

	local appliedCount = restoreOriginalScaleTracks(self._genericTracks)
	appliedCount += RigService.applyPose(self._motors, self:_buildScaledRigPoseForApply(self._originalPose))
	return appliedCount &gt; 0
end

function TimelineModel:resetRigPoseForRig(rig)
	if not rig then
		return false
	end

	local rigMotors = {}
	local rigPose = {}
	for _, motorData in ipairs(self._motors) do
		if motorData.rig == rig then
			table.insert(rigMotors, motorData)
			local originalPose = self._originalPose[motorData.path]
			if originalPose then
				rigPose[motorData.path] = originalPose
			end
		end
	end

	if #rigMotors == 0 then
		return false
	end

	local appliedCount = restoreOriginalScaleTracks(self._genericTracks, rig)
	appliedCount += RigService.applyPose(rigMotors, self:_buildScaledRigPoseForApply(rigPose))
	return appliedCount &gt; 0
end

function TimelineModel:resetOriginalState()
	local appliedCount = 0
	local attachService = getAttachService()
	if attachService and type(attachService.clearRuntimeAttachments) == "function" then
		pcall(function()
			attachService.clearRuntimeAttachments()
		end)
	end

	appliedCount += restoreOriginalScaleTracks(self._genericTracks)
	if #self._motors &gt; 0 then
		appliedCount += RigService.applyPose(self._motors, self:_buildScaledRigPoseForApply(self._originalPose))
	end

	for _, track in ipairs(self._genericTracks) do
		if not isScalePropertyTrack(track) and restoreGenericTrackOriginalValue(track) then
			appliedCount += 1
		end
	end
	if attachService and type(attachService.restoreOriginalAttachmentObjects) == "function" then
		local success, restoredCount = pcall(function()
			local _, restored = attachService.restoreOriginalAttachmentObjects(self)
			return restored
		end)
		if success and type(restoredCount) == "number" then
			appliedCount += restoredCount
		end
	end

	return appliedCount &gt; 0, appliedCount
end

function TimelineModel:restoreEmptyTrackOriginalStates(keyList)
	local restoredCount = 0
	local seenPaths = {}
	for _, key in ipairs(keyList or {}) do
		local path = key.jointPath or key.path
		if path and not seenPaths[path] and #self:getTrackKeyframeFrames(path) == 0 then
			seenPaths[path] = true
			local motorData = self:getMotorByPath(path)
			if motorData then
				local originalValue = self._originalPose[path]
				if originalValue ~= nil then
					local pose = self:_buildScaledRigPoseForApply({
						[path] = cloneValue(originalValue),
					})
					if RigService.applyPose({ motorData }, pose) &gt; 0 then
						restoredCount += 1
					end
				end
			else
				local track = self:getTrackByPath(path)
				if track and restoreGenericTrackOriginalValue(track) then
					restoredCount += 1
				end
			end
		end
	end
	return restoredCount
end

function TimelineModel:getJointTransform(path)
	local motorData = self:getMotorByPath(path)
	if not motorData then
		return nil
	end

	return RigService.getMotorTransform(motorData)
end

function TimelineModel:applyJointTransform(path, transform)
	local motorData = self:getMotorByPath(path)
	if not motorData then
		return false, "The selected joint could not be found."
	end
	if self:isTrackDisabled(path) then
		return false, string.format("'%s' is disabled.", motorData.name or "Joint")
	end

	local success = RigService.setMotorTransform(motorData, transform)
	if not success then
		return false, "The selected joint is no longer available."
	end

	local value = RigService.getJointPose(motorData)
	if not value then
		return false, "The selected joint could not be captured."
	end

	local pose = self._frames[self._currentFrame] or {}
	self._frames[self._currentFrame] = pose
	-- Applying one joint from the item editor should not bake the whole rig pose.
	-- Full-pose capture is still handled by the normal capture/default-pose actions.
	pose[path] = cloneValue(self:_normalizeRigTrackValueForStorage(path, value))
	self:_ensureKeyOptions(path, self._currentFrame)
	return true, string.format("Updated joint '%s' at frame %d.", motorData.name, self._currentFrame)
end

function TimelineModel:toSaveData(extra, saveOptions)
	saveOptions = saveOptions or {}
	local instanceAddressSupport = require(script.Parent:WaitForChild("InstanceAddressSupport"))
	local yieldBudget = saveOptions.yieldBudget
	local function maybeYield()
		if type(yieldBudget) == "function" then
			yieldBudget()
		end
	end

	ScreenEffectTrackService.ensureSubtitlePreStartKeys(self)
	maybeYield()

	local frames = {}
	for frame, pose in pairs(self._frames) do
		local serializedPose = {}
		for path, value in pairs(pose) do
			serializedPose[path] = {
				value = serializeValue(value),
				easing = self:getKeyOptions(path, frame),
			}
			maybeYield()
		end
		frames[tostring(frame)] = serializedPose
		maybeYield()
	end

	local saveTracks = {}
	local seenTrackPaths = {}
	for _, track in ipairs(self:getTracks()) do
		table.insert(saveTracks, track)
		if type(track.path) == "string" then
			seenTrackPaths[track.path] = true
		end
		maybeYield()
	end
	for _, track in ipairs(self._genericTracks) do
		if track and type(track.path) == "string" and not seenTrackPaths[track.path] then
			table.insert(saveTracks, track)
			seenTrackPaths[track.path] = true
		end
		maybeYield()
	end

	local tracks = {}
	for _, track in ipairs(saveTracks) do
		table.insert(tracks, {
			path = track.path,
			name = track.name,
			part0 = track.part0,
			part1 = track.part1,
			targetPath = track.targetPath or getInstancePath(track.instance),
			targetAddress = instanceAddressSupport.captureTrackTarget(track),
			trackType = track.trackType,
			valueType = track.valueType,
			effectType = track.effectType,
			rigName = track.rigName,
			propertyName = track.propertyName,
			eventName = track.eventName,
			targetScope = track.targetScope,
			emitterTargets = serializeEmitterTargets(track),
			parentTrackPath = track.parentTrackPath,
			parentTrackName = track.parentTrackName,
			gizmoTargetPath = track.gizmoTargetPath,
			folderPath = track.folderPath,
			folderColorId = track.folderColorId,
			defaultCollapsed = track.defaultCollapsed == true,
			defaultCollapseToken = track.defaultCollapseToken,
			sortOrder = track.sortOrder,
			visualOrder = self._trackVisualOrder[track.path] or track.visualOrder,
			disabled = self._disabledTrackPaths[track.path] == true or track.disabled == true,
			easingStyle = track.easingStyle,
			easingDirection = track.easingDirection,
			originalValue = serializeValue(track.originalValue),
		})
		maybeYield()
	end

	return {
		format = SAVE_FORMAT,
		formatVersion = 1,
		name = self._animationName,
		fps = self._fps,
		durationFrames = self._durationFrames,
		looping = self._looping,
		priority = self._priority,
		tracks = tracks,
		frames = frames,
		extra = extra or {},
	}
end

function TimelineModel:loadSaveData(data, deps)
	if not isSupportedSaveFormat(data) then
		return false, "That save file is not a 7kg2 Animator project."
	end

	deps = deps or {}
	local resolveInstancePath = deps.resolveInstancePath
	local resolveRigByName = deps.resolveRigByName
	local describeRig = deps.describeRig

	if type(resolveInstancePath) ~= "function" or type(resolveRigByName) ~= "function" or type(describeRig) ~= "function" then
		return false, "Project loader dependencies were not provided."
	end

	local savedTracks = type(data.tracks) == "table" and data.tracks or {}
	local pathMap = {}
	local restoredRigNames = {}
	local restoredGenericCount = 0
	local instanceAddressSupport = require(script.Parent:WaitForChild("InstanceAddressSupport"))
	local restoredInstanceBySavedTrackPath = {}
	local usedLegacyObjectInstances = {}
	local pendingFolderPaths = {}
	local pendingParentTrackPaths = {}
	local resolvedRigBySavedName = {}
	local instanceAddressResolveContext = instanceAddressSupport.createResolveContext()

	self._animationName = type(data.name) == "string" and data.name ~= "" and data.name or self._animationName
	self._fps = tonumber(data.fps) or self._fps
	self._durationFrames = tonumber(data.durationFrames) or self._durationFrames
	self._looping = data.looping == true
	self._priority = type(data.priority) == "string" and data.priority or self._priority
	self._currentFrame = 0
	self._rig = nil
	self._rigs = {}
	self._motors = {}
	self._genericTracks = {}
	self._nextTrackId = 1
	self._originalPose = {}
	self._frames = {}
	self._keyOptions = {}
	self._disabledTrackPaths = {}
	self._suppressedApplyPaths = {}
	self._trackFolderPaths = {}
	self._trackVisualOrder = {}

	local seenRigNames = {}
	for _, track in ipairs(savedTracks) do
		local rigName = getSavedTrackRigName(track)

		if rigName and not seenRigNames[rigName] then
			seenRigNames[rigName] = true
			local rig = resolveRigByName(rigName)
			if rig then
				local rigData = describeRig(rig)
				local success = self:addRig(rig, rigData)
				if success then
					resolvedRigBySavedName[rigName] = rig
					table.insert(restoredRigNames, rig.Name)
					pathMap[getRigGroupTrackPath(rigName)] = getRigGroupTrackPath(rig.Name)
					for _, motorData in ipairs(rigData.motors or {}) do
						pathMap[motorData.path] = motorData.path
						local relativePath = getRigRelativePath(motorData.path, rig.Name)
						if relativePath then
							pathMap[rigName .. "/" .. relativePath] = motorData.path
						end
					end
				end
			end
		end
	end

	for _, track in ipairs(savedTracks) do
		local savedOriginalValue = track.originalValue ~= nil and deserializeValue(track.originalValue) or nil
		local restoredTrack = nil
		if track.trackType == "Rig Property" then
			local rigName = track.rigName or track.part0
			local propertyName = track.propertyName or track.valueType or track.name or "CFrame"
			local rig = rigName and (resolvedRigBySavedName[rigName] or resolveRigByName(rigName))
			if rig then
				local restoredRigName = rig.Name
				restoredTrack = self:getRigPropertyTrack(restoredRigName, propertyName)
				if not restoredTrack then
					restoredTrack = self:addGenericTrack("RigProperty", rig, track.name or propertyName, {
						rig = rig,
						rigName = restoredRigName,
						propertyName = propertyName,
						targetScope = "RigProperty",
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				end
			end
		elseif track.trackType == "Camera Property" then
			local propertyName = track.propertyName or track.valueType or track.name or "FieldOfView"
			restoredTrack = self:addGenericTrack("CameraProperty", workspace.CurrentCamera, track.name or propertyName, {
				propertyName = propertyName,
				targetScope = "CameraProperty",
				sortOrder = track.sortOrder,
				originalValue = savedOriginalValue,
			})
		elseif track.trackType ~= "Rig" and track.trackType ~= "Rig Group" then
			local instance = nil
			if track.trackType == "Camera" then
				instance = workspace.CurrentCamera
			elseif track.parentTrackPath and restoredInstanceBySavedTrackPath[track.parentTrackPath] then
				instance = restoredInstanceBySavedTrackPath[track.parentTrackPath]
			elseif type(track.targetAddress) == "table" then
				instance = instanceAddressSupport.resolve(track.targetAddress, instanceAddressResolveContext)
			end
			if not instance and (track.trackType == "Object" or track.trackType == "Model") and type(track.targetPath) == "string" then
				instance = instanceAddressSupport.selectBest(
					instanceAddressSupport.resolveLegacyCandidates(track.targetPath),
					savedOriginalValue,
					usedLegacyObjectInstances
				)
			elseif not instance and type(track.targetPath) == "string" then
				instance = resolveInstancePath(track.targetPath)
			end
			if instance and (track.trackType == "Object" or track.trackType == "Model") then
				usedLegacyObjectInstances[instance] = true
			end

			local addTrackType = isSavedTimelineFolderTrack(track) and "Folder" or track.trackType
			if addTrackType == "Rig CFrame" then
				addTrackType = "RigCFrame"
			end

			if addTrackType == "Folder" then
				restoredTrack = self:addGenericTrack("Folder", nil, track.name or "Folder", {
					targetScope = "TimelineFolder",
					folderColorId = track.folderColorId,
					defaultCollapsed = track.defaultCollapsed == true,
					defaultCollapseToken = track.defaultCollapseToken,
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
			elseif addTrackType == "Emitter Group" then
				if instance then
					restoredTrack = self:addGenericTrack("EmitterGroup", instance, track.name, {
						targetScope = "EmitterGroup",
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				end
			elseif addTrackType == "Emitter Group Property" then
				local propertyName = track.propertyName or track.valueType or track.name or "Enabled"
				if instance then
					restoredTrack = self:addGenericTrack("EmitterGroupProperty", instance, track.name or propertyName, {
						propertyName = propertyName,
						targetScope = "EmitterGroupProperty",
						parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
						parentTrackName = track.parentTrackName,
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				end
			elseif addTrackType == "Particle Event" then
				local eventName = track.eventName or track.propertyName or track.name or "Emit"
				if instance then
					restoredTrack = self:addGenericTrack("ParticleEvent", instance, track.name or eventName, {
						propertyName = eventName,
						eventName = eventName,
						targetScope = "ParticleEvent",
						parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
						parentTrackName = track.parentTrackName,
						emitters = ParticleEmitterGroupService.collectEmitters(instance),
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				end
			elseif addTrackType == "Object Property" then
				local propertyName = track.propertyName or track.valueType or track.name or "Transparency"
				if instance then
					restoredTrack = self:addGenericTrack("ObjectProperty", instance, track.name or propertyName, {
						propertyName = propertyName,
						targetScope = "ObjectProperty",
						parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
						parentTrackName = track.parentTrackName,
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				end
			elseif addTrackType == "Screen Effect" then
				restoredTrack = self:addGenericTrack("ScreenEffect", nil, track.name, {
					effectType = ScreenEffectTrackService.getTrackEffectType(track) or track.valueType or track.effectType or track.name or "Fade",
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
			elseif addTrackType == "Lighting Effect" then
				restoredTrack = self:addGenericTrack("LightingEffect", nil, track.name, {
					effectType = track.valueType or track.effectType or "Lighting",
					parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
					parentTrackName = track.parentTrackName,
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
			elseif addTrackType == "Event" then
				restoredTrack = self:addGenericTrack("Event", nil, track.name, {
					eventName = track.eventName or track.name,
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
			elseif addTrackType == "Face" then
				local faceRig = track.rigName and resolvedRigBySavedName[track.rigName] or nil
				restoredTrack = self:addGenericTrack("Face", nil, track.name or "Face", {
					rigName = faceRig and faceRig.Name or track.rigName,
					propertyName = track.propertyName or "Face",
					targetScope = "Face",
					parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
					parentTrackName = track.parentTrackName,
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
			elseif instance then
				restoredTrack = self:addGenericTrack(addTrackType, instance, track.name, {
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
			end
		end

		if restoredTrack then
			pathMap[track.path] = restoredTrack.path
			restoredInstanceBySavedTrackPath[track.path] = restoredTrack.instance
			restoredGenericCount += 1
			restoredTrack.gizmoTargetPath = track.gizmoTargetPath
			if track.parentTrackPath then
				pendingParentTrackPaths[restoredTrack.path] = track.parentTrackPath
			end
			if track.folderPath then
				pendingFolderPaths[restoredTrack.path] = track.folderPath
				self._trackFolderPaths[restoredTrack.path] = pathMap[track.folderPath] or track.folderPath
				restoredTrack.folderPath = self._trackFolderPaths[restoredTrack.path]
			end
			if track.disabled == true then
				self._disabledTrackPaths[restoredTrack.path] = true
			end
		elseif track.trackType == "Rig" and type(track.path) == "string" and track.disabled == true then
			self._disabledTrackPaths[pathMap[track.path] or track.path] = true
		end
		local visualOrderPath = restoredTrack and restoredTrack.path or pathMap[track.path] or track.path
		if type(visualOrderPath) == "string" and track.folderPath then
			local mappedFolderPath = pathMap[track.folderPath] or track.folderPath
			self._trackFolderPaths[visualOrderPath] = mappedFolderPath
			if restoredTrack then
				restoredTrack.folderPath = mappedFolderPath
			end
		end
		if type(visualOrderPath) == "string" and track.visualOrder ~= nil then
			self._trackVisualOrder[visualOrderPath] = tonumber(track.visualOrder)
		end
	end
	restoredGenericCount += restoreOrphanedTimelineFolders(self, savedTracks, data.extra, pathMap)
	for restoredPath, savedFolderPath in pairs(pendingFolderPaths) do
		local mappedFolderPath = pathMap[savedFolderPath]
		local restoredTrack = self:getTrackByPath(restoredPath)
		local restoredFolder = mappedFolderPath and self:getTrackByPath(mappedFolderPath) or nil
		if restoredTrack and restoredFolder and restoredFolder.targetScope == "TimelineFolder" then
			restoredTrack.folderPath = mappedFolderPath
			self._trackFolderPaths[restoredPath] = mappedFolderPath
		end
	end
	for restoredPath, savedParentPath in pairs(pendingParentTrackPaths) do
		local mappedParentPath = pathMap[savedParentPath]
		local restoredTrack = self:getTrackByPath(restoredPath)
		if restoredTrack and mappedParentPath and self:getTrackByPath(mappedParentPath) then
			restoredTrack.parentTrackPath = mappedParentPath
		end
	end

	local importedTrackKeyCount = 0
	local importedFrameSet = {}
	for frameKey, pose in pairs(type(data.frames) == "table" and data.frames or {}) do
		local frame = normalizeFrame(tonumber(frameKey))
		if type(pose) == "table" then
			local restoredPose = {}
			for savedPath, savedEntry in pairs(pose) do
				local restoredPath = pathMap[savedPath] or savedPath
				if self:getMotorByPath(restoredPath) or self:getTrackByPath(restoredPath) then
					local serializedValue = type(savedEntry) == "table" and savedEntry.value or savedEntry
					restoredPose[restoredPath] = deserializeValue(serializedValue)
					if type(savedEntry) == "table" and type(savedEntry.easing) == "table" then
						self:_ensureKeyOptions(restoredPath, frame)
						self._keyOptions[restoredPath][frame] = cloneValue(savedEntry.easing)
					end
					importedTrackKeyCount += 1
					importedFrameSet[frame] = true
				end
			end
			if next(restoredPose) then
				self._frames[frame] = restoredPose
			end
		end
	end

	ScreenEffectTrackService.ensureSubtitlePreStartKeys(self)

	if #self._rigs &gt; 0 then
		self._rig = self._rigs[1]
	end

	local importedFrameCount = 0
	for _ in pairs(importedFrameSet) do
		importedFrameCount += 1
	end

	return true, {
		pathMap = pathMap,
		extra = data.extra or {},
		restoredRigNames = restoredRigNames,
		restoredGenericCount = restoredGenericCount,
		importedTrackKeyCount = importedTrackKeyCount,
		importedFrameCount = importedFrameCount,
	}
end

function TimelineModel:mergeSaveData(data, deps, frameOffset)
	if not isSupportedSaveFormat(data) then
		return false, "That save file is not a 7kg2 Animator project."
	end

	deps = deps or {}
	local resolveInstancePath = deps.resolveInstancePath
	local resolveRigByName = deps.resolveRigByName
	local describeRig = deps.describeRig

	if type(resolveInstancePath) ~= "function" or type(resolveRigByName) ~= "function" or type(describeRig) ~= "function" then
		return false, "Project loader dependencies were not provided."
	end

	frameOffset = normalizeFrame(frameOffset or 0)
	local savedTracks = type(data.tracks) == "table" and data.tracks or {}
	local pathMap = {}
	local restoredRigNames = {}
	local restoredGenericCount = 0
	local importedTrackKeyCount = 0
	local importedFrameSet = {}
	local maxFrame = self._durationFrames
	local instanceAddressSupport = require(script.Parent:WaitForChild("InstanceAddressSupport"))
	local restoredInstanceBySavedTrackPath = {}
	local instanceAddressResolveContext = instanceAddressSupport.createResolveContext()

	local seenRigNames = {}
	for _, track in ipairs(savedTracks) do
		local rigName = nil
		if track.trackType == "Rig" and type(track.path) == "string" then
			rigName = string.match(track.path, "^([^/]+)/")
		elseif track.trackType == "Rig Group" then
			rigName = track.name
		elseif track.trackType == "Rig Property" then
			rigName = track.rigName or track.part0
		end

		if rigName and not seenRigNames[rigName] then
			seenRigNames[rigName] = true
			local existingRig = self:getRigByName(rigName)
			if existingRig then
				for _, motorData in ipairs(self._motors) do
					if motorData.rigName == rigName then
						pathMap[motorData.path] = motorData.path
					end
				end
				table.insert(restoredRigNames, rigName)
			else
				local rig = resolveRigByName(rigName)
				if rig then
					local rigData = describeRig(rig)
					local success = self:addRig(rig, rigData)
					if success then
						table.insert(restoredRigNames, rigName)
						for _, motorData in ipairs(rigData.motors or {}) do
							pathMap[motorData.path] = motorData.path
						end
					end
				end
			end
		end
	end

	local function findMatchingGenericTrack(track)
		local savedStableId = type(track.targetAddress) == "table" and track.targetAddress.stableId or nil
		for _, existing in ipairs(self._genericTracks) do
			local identityMatches = existing.targetPath == track.targetPath
			if type(savedStableId) == "string" and savedStableId ~= "" then
				identityMatches = instanceAddressSupport.getStableId(existing.instance) == savedStableId
			end
			if existing.trackType == track.trackType
				and existing.name == track.name
				and existing.valueType == track.valueType
				and identityMatches then
				return existing
			end
		end
		return nil
	end

	for _, track in ipairs(savedTracks) do
		local savedOriginalValue = track.originalValue ~= nil and deserializeValue(track.originalValue) or nil
		local restoredTrack = nil
		if track.trackType == "Rig Property" then
			local rigName = track.rigName or track.part0
			local propertyName = track.propertyName or track.valueType or track.name or "CFrame"
			local rig = rigName and self:getRigByName(rigName) or (rigName and resolveRigByName(rigName))
			if rig then
				restoredTrack = self:getRigPropertyTrack(rigName, propertyName)
				if not restoredTrack then
					restoredTrack = self:addGenericTrack("RigProperty", rig, track.name or propertyName, {
						rig = rig,
						rigName = rigName,
						propertyName = propertyName,
						targetScope = "RigProperty",
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
					restoredGenericCount += 1
				end
			end
		elseif track.trackType == "Camera Property" then
			restoredTrack = findMatchingGenericTrack(track)
			if not restoredTrack then
				local propertyName = track.propertyName or track.valueType or track.name or "FieldOfView"
				restoredTrack = self:addGenericTrack("CameraProperty", workspace.CurrentCamera, track.name or propertyName, {
					propertyName = propertyName,
					targetScope = "CameraProperty",
					sortOrder = track.sortOrder,
					originalValue = savedOriginalValue,
				})
				if restoredTrack then
					restoredGenericCount += 1
				end
			end
		elseif track.trackType ~= "Rig" and track.trackType ~= "Rig Group" then
			restoredTrack = findMatchingGenericTrack(track)
			if not restoredTrack then
				local instance = nil
				if track.trackType == "Camera" then
					instance = workspace.CurrentCamera
				elseif track.parentTrackPath and restoredInstanceBySavedTrackPath[track.parentTrackPath] then
					instance = restoredInstanceBySavedTrackPath[track.parentTrackPath]
				elseif type(track.targetAddress) == "table" then
					instance = instanceAddressSupport.resolve(track.targetAddress, instanceAddressResolveContext)
				end
				if not instance and type(track.targetPath) == "string" then
					instance = resolveInstancePath(track.targetPath)
				end

				local addTrackType = track.trackType
				if addTrackType == "Rig CFrame" then
					addTrackType = "RigCFrame"
				end

				if addTrackType == "Folder" then
					restoredTrack = self:addGenericTrack("Folder", nil, track.name or "Folder", {
						targetScope = "TimelineFolder",
						folderColorId = track.folderColorId,
						defaultCollapsed = track.defaultCollapsed == true,
						defaultCollapseToken = track.defaultCollapseToken,
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				elseif addTrackType == "Emitter Group" then
					if instance then
						restoredTrack = self:addGenericTrack("EmitterGroup", instance, track.name, {
							targetScope = "EmitterGroup",
							sortOrder = track.sortOrder,
							originalValue = savedOriginalValue,
						})
					end
				elseif addTrackType == "Emitter Group Property" then
					local propertyName = track.propertyName or track.valueType or track.name or "Enabled"
					if instance then
						restoredTrack = self:addGenericTrack("EmitterGroupProperty", instance, track.name or propertyName, {
							propertyName = propertyName,
							targetScope = "EmitterGroupProperty",
							parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
							parentTrackName = track.parentTrackName,
							sortOrder = track.sortOrder,
							originalValue = savedOriginalValue,
						})
					end
				elseif addTrackType == "Particle Event" then
					local eventName = track.eventName or track.propertyName or track.name or "Emit"
					if instance then
						restoredTrack = self:addGenericTrack("ParticleEvent", instance, track.name or eventName, {
							propertyName = eventName,
							eventName = eventName,
							targetScope = "ParticleEvent",
							parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
							parentTrackName = track.parentTrackName,
							emitters = ParticleEmitterGroupService.collectEmitters(instance),
							sortOrder = track.sortOrder,
							originalValue = savedOriginalValue,
						})
					end
				elseif addTrackType == "Object Property" then
					local propertyName = track.propertyName or track.valueType or track.name or "Transparency"
					if instance then
						restoredTrack = self:addGenericTrack("ObjectProperty", instance, track.name or propertyName, {
							propertyName = propertyName,
							targetScope = "ObjectProperty",
							parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
							parentTrackName = track.parentTrackName,
							sortOrder = track.sortOrder,
							originalValue = savedOriginalValue,
						})
					end
				elseif addTrackType == "Screen Effect" then
					restoredTrack = self:addGenericTrack("ScreenEffect", nil, track.name, {
						effectType = ScreenEffectTrackService.getTrackEffectType(track) or track.valueType or track.effectType or track.name or "Fade",
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				elseif addTrackType == "Lighting Effect" then
					restoredTrack = self:addGenericTrack("LightingEffect", nil, track.name, {
						effectType = track.valueType or track.effectType or "Lighting",
						parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
						parentTrackName = track.parentTrackName,
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				elseif addTrackType == "Event" then
					restoredTrack = self:addGenericTrack("Event", nil, track.name, {
						eventName = track.eventName or track.name,
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				elseif addTrackType == "Face" then
					restoredTrack = self:addGenericTrack("Face", nil, track.name or "Face", {
						rigName = track.rigName,
						propertyName = track.propertyName or "Face",
						targetScope = "Face",
						parentTrackPath = pathMap[track.parentTrackPath] or track.parentTrackPath,
						parentTrackName = track.parentTrackName,
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				elseif instance then
					restoredTrack = self:addGenericTrack(addTrackType, instance, track.name, {
						sortOrder = track.sortOrder,
						originalValue = savedOriginalValue,
					})
				end

				if restoredTrack then
					restoredGenericCount += 1
				end
			end
		end

		if restoredTrack then
			pathMap[track.path] = restoredTrack.path
			restoredInstanceBySavedTrackPath[track.path] = restoredTrack.instance
			restoredTrack.gizmoTargetPath = track.gizmoTargetPath
			if track.folderPath then
				self._trackFolderPaths[restoredTrack.path] = pathMap[track.folderPath] or track.folderPath
				restoredTrack.folderPath = self._trackFolderPaths[restoredTrack.path]
			end
			if track.disabled == true then
				self._disabledTrackPaths[restoredTrack.path] = true
			end
		elseif track.trackType == "Rig" and type(track.path) == "string" and track.disabled == true then
			self._disabledTrackPaths[track.path] = true
		end
		local visualOrderPath = restoredTrack and restoredTrack.path or pathMap[track.path] or track.path
		if type(visualOrderPath) == "string" and track.folderPath then
			local mappedFolderPath = pathMap[track.folderPath] or track.folderPath
			self._trackFolderPaths[visualOrderPath] = mappedFolderPath
			if restoredTrack then
				restoredTrack.folderPath = mappedFolderPath
			end
		end
		if type(visualOrderPath) == "string" and track.visualOrder ~= nil then
			self._trackVisualOrder[visualOrderPath] = tonumber(track.visualOrder)
		end
	end
	for _, track in ipairs(self._genericTracks) do
		if type(track.parentTrackPath) == "string" and pathMap[track.parentTrackPath] then
			track.parentTrackPath = pathMap[track.parentTrackPath]
		end
		if type(track.folderPath) == "string" and pathMap[track.folderPath] then
			track.folderPath = pathMap[track.folderPath]
			self._trackFolderPaths[track.path] = track.folderPath
		end
	end

	for frameKey, pose in pairs(type(data.frames) == "table" and data.frames or {}) do
		local frame = frameOffset + normalizeFrame(tonumber(frameKey))
		if type(pose) == "table" then
			local restoredPose = self._frames[frame] or {}
			local insertedAny = false
			for savedPath, savedEntry in pairs(pose) do
				local restoredPath = pathMap[savedPath] or savedPath
				if self:getMotorByPath(restoredPath) or self:getTrackByPath(restoredPath) then
					local serializedValue = type(savedEntry) == "table" and savedEntry.value or savedEntry
					restoredPose[restoredPath] = deserializeValue(serializedValue)
					self:_ensureKeyOptions(restoredPath, frame)
					if type(savedEntry) == "table" and type(savedEntry.easing) == "table" then
						self._keyOptions[restoredPath][frame] = cloneValue(savedEntry.easing)
					end
					importedTrackKeyCount += 1
					importedFrameSet[frame] = true
					insertedAny = true
				end
			end
			if insertedAny then
				self._frames[frame] = restoredPose
				maxFrame = math.max(maxFrame, frame)
			end
		end
	end

	ScreenEffectTrackService.ensureSubtitlePreStartKeys(self)

	self._durationFrames = math.max(self._durationFrames, maxFrame)

	local importedFrameCount = 0
	for _ in pairs(importedFrameSet) do
		importedFrameCount += 1
	end

	return true, {
		pathMap = pathMap,
		extra = data.extra or {},
		restoredRigNames = restoredRigNames,
		restoredGenericCount = restoredGenericCount,
		importedTrackKeyCount = importedTrackKeyCount,
		importedFrameCount = importedFrameCount,
		frameOffset = frameOffset,
	}
end

return TimelineModel
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX245">
        <Properties>
          <string name="Name">TrackballDebugService</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")

local TrackballDebugService = {}

local ENABLED_ATTRIBUTE = "MegMoTrackballDebugEnabled"
local SOURCE_ATTRIBUTE = "MegMoTrackballDebugSource"

local function valueToText(value)
	local valueType = typeof(value)
	if valueType == "Vector2" then
		return string.format("(%.1f, %.1f)", value.X, value.Y)
	elseif valueType == "Vector3" then
		return string.format("(%.2f, %.2f, %.2f)", value.X, value.Y, value.Z)
	elseif valueType == "Instance" then
		return value:GetFullName()
	elseif valueType == "table" then
		local parts = {}
		for key, item in pairs(value) do
			table.insert(parts, tostring(key) .. "=" .. valueToText(item))
		end
		table.sort(parts)
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return tostring(value)
end

function TrackballDebugService.setEnabled(enabled, source)
	pcall(function()
		CoreGui:SetAttribute(ENABLED_ATTRIBUTE, enabled == true)
		CoreGui:SetAttribute(SOURCE_ATTRIBUTE, tostring(source or ""))
	end)
end

function TrackballDebugService.isEnabled()
	local ok, enabled = pcall(function()
		return CoreGui:GetAttribute(ENABLED_ATTRIBUTE)
	end)
	return ok and enabled == true
end

function TrackballDebugService.log(source, eventName, ...)
	if not TrackballDebugService.isEnabled() then
		return
	end

	local parts = {
		"[7kg2 Trackball Debug]",
		tostring(source or "Unknown"),
		tostring(eventName or "event"),
	}
	for index = 1, select("#", ...) do
		table.insert(parts, valueToText(select(index, ...)))
	end
	warn(table.concat(parts, " | "))
end

return TrackballDebugService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX246">
        <Properties>
          <string name="Name">TrackballTool</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local TransformSession = require(script.Parent:WaitForChild("TransformSession"))
local TrackballDebugService = require(script.Parent:WaitForChild("TrackballDebugService"))

local TrackballTool = {}
TrackballTool.__index = TrackballTool

local AXIS_COLORS = {
	X = Color3.fromRGB(255, 95, 120),
	Y = Color3.fromRGB(90, 230, 130),
	Z = Color3.fromRGB(80, 175, 255),
}

local DEFAULT_COLOR = Color3.fromRGB(160, 120, 255)
local ROTATE_PIXELS_TO_RADIANS = math.rad(0.35)
local MOVE_PIXELS_TO_STUDS = 0.018
local FINE_MULTIPLIER = 0.22
local TRACKBALL_RADIUS_STUDS = 1.1
local TRACKBALL_HIT_TOLERANCE = 32
local INVERT_ROTATE_MOUSE_X = true
local CANCEL_ACTION_NAME = "MegMoTrackballCancel"
local CANCEL_ACTION_PRIORITY = 10000
local TRACKBALL_PROXY_NAME = "MegMoAnimatorTrackballProxy"

local function debugLog(eventName, ...)
	TrackballDebugService.log("TrackballTool", eventName, ...)
end

local function selectionSummary(selection)
	if type(selection) ~= "table" then
		return "selection=nil"
	end
	if type(selection.paths) == "table" then
		return "paths=" .. tostring(#selection.paths) .. " frame=" .. tostring(selection.frame)
	end
	return "path=" .. tostring(selection.path) .. " frame=" .. tostring(selection.frame)
end

local function safeSet(instance, propertyName, value)
	pcall(function()
		instance[propertyName] = value
	end)
end

local function safeConnect(signal, callback)
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	return ok and connection or nil
end

local function setViewportSelectionHighlightSuppressed(suppressed)
	pcall(function()
		local service = require(script.Parent:WaitForChild("ViewportPartSelectService"))
		if service and type(service.setSelectionHighlightSuppressed) == "function" then
			service.setSelectionHighlightSuppressed(suppressed == true)
		end
	end)
end

local function createProxyPart()
	for _, instance in ipairs(workspace:GetDescendants()) do
		if instance.Name == TRACKBALL_PROXY_NAME and instance:IsA("BasePart") then
			instance:Destroy()
		end
	end

	local part = Instance.new("Part")
	part.Name = TRACKBALL_PROXY_NAME
	part.Size = Vector3.new(0.8, 0.8, 0.8)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Locked = true
	part.Parent = workspace
	return part
end

local function createSphereAdornment(parent, adornee)
	local ok, sphere = pcall(Instance.new, "SphereHandleAdornment")
	if not ok or not sphere then
		return nil
	end

	sphere.Name = "TrackballCircle"
	safeSet(sphere, "Adornee", adornee)
	safeSet(sphere, "AlwaysOnTop", true)
	safeSet(sphere, "Color3", DEFAULT_COLOR)
	safeSet(sphere, "Radius", TRACKBALL_RADIUS_STUDS)
	safeSet(sphere, "Transparency", 0.72)
	safeSet(sphere, "ZIndex", 8)
	safeSet(sphere, "Visible", false)
	sphere.Parent = parent
	return sphere
end

local function createLabel(parent, adornee)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "TrackballLabel"
	billboard.Adornee = adornee
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Size = UDim2.fromOffset(285, 84)
	billboard.StudsOffset = Vector3.new(2.45, 2.45, 0)
	billboard.Parent = parent

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 0.18
	label.BackgroundColor3 = Color3.fromRGB(18, 22, 34)
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = Color3.fromRGB(232, 236, 248)
	label.TextSize = 11
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Size = UDim2.fromScale(1, 1)
	label.Text = ""
	label.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = label

	return billboard, label
end

local function isFineDown()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

local function isSnapDown()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
end

local function roundToIncrement(value, increment)
	if type(increment) ~= "number" or increment &lt;= 0 then
		return value
	end
	return math.floor((value / increment) + 0.5) * increment
end

local function getCameraCFrame()
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame or CFrame.new()
end

local function projectArcballPoint(mousePosition, center, radius, invertX)
	if typeof(mousePosition) ~= "Vector2" or typeof(center) ~= "Vector2" or type(radius) ~= "number" or radius &lt;= 0 then
		return nil
	end

	local x = (mousePosition.X - center.X) / radius
	if invertX then
		x = -x
	end
	local y = (center.Y - mousePosition.Y) / radius
	local lengthSquared = (x * x) + (y * y)
	if lengthSquared &gt; 1 then
		local length = math.sqrt(lengthSquared)
		return Vector3.new(x / length, y / length, 0)
	end

	return Vector3.new(x, y, math.sqrt(1 - lengthSquared))
end

local function arcballVectorToWorld(cameraCFrame, vector)
	return (cameraCFrame.RightVector * vector.X)
		+ (cameraCFrame.UpVector * vector.Y)
		+ (-cameraCFrame.LookVector * vector.Z)
end

local function axisVector(axis)
	if axis == "X" then
		return Vector3.xAxis
	elseif axis == "Y" then
		return Vector3.yAxis
	elseif axis == "Z" then
		return Vector3.zAxis
	end
	return nil
end

function TrackballTool.new(options)
	local self = setmetatable({}, TrackballTool)
	options = options or {}
	self._timeline = options.timeline
	self._beginUndo = options.beginUndo
	self._finishUndo = options.finishUndo
	self._discardUndo = options.discardUndo
	self._getMoveSnap = options.getMoveSnap
	self._getRotateSnapDegrees = options.getRotateSnapDegrees
	self._onCommit = options.onCommit
	self._onCancel = options.onCancel
	self._onStatus = options.onStatus
	self._onActiveChanged = options.onActiveChanged
	self._onSessionBegin = options.onSessionBegin
	self._onDragBegin = options.onDragBegin
	self._onPreview = options.onPreview
	self._onBeforeCommit = options.onBeforeCommit
	self._onViewportPick = options.onViewportPick
	self._shouldYieldRightMouse = options.shouldYieldRightMouse
	self._plugin = options.plugin
	self._pluginMouse = nil
	self._mode = "Rotate"
	self._axis = nil
	self._session = nil
	self._active = false
	self._sticky = false
	self._dragging = false
	self._dragDelta = Vector2.zero
	self._lastMousePosition = nil
	self._dragStartMousePosition = nil
	self._dragCurrentMousePosition = nil
	self._dragCameraCFrame = nil
	self._dragArcballCenter = nil
	self._dragArcballRadius = nil
	self._visualSuppressed = false
	self._lastPluginMouseMoveTime = 0
	self._readoutText = "0.00 deg"
	self._lastSelection = nil
	self._lastOwnershipDebug = nil
	self._connections = {}

	self._folder = Instance.new("Folder")
	self._folder.Name = "MegMoAnimatorTrackball"
	self._folder.Parent = CoreGui
	self._proxyPart = createProxyPart()
	self._sphere = createSphereAdornment(self._folder, self._proxyPart)
	self._billboard, self._label = createLabel(self._folder, self._proxyPart)
	self:_syncViewportOwnership()
	self:_bindInput()
	debugLog("new", "plugin=" .. tostring(self._plugin ~= nil))

	return self
end

function TrackballTool:_captureArcballBasis(mousePosition)
	self._dragStartMousePosition = nil
	self._dragCurrentMousePosition = nil
	self._dragCameraCFrame = nil
	self._dragArcballCenter = nil
	self._dragArcballRadius = nil

	local camera = workspace.CurrentCamera
	local pivot = self._session and self._session:GetPivotCFrame() or nil
	if not camera or not pivot or typeof(mousePosition) ~= "Vector2" then
		return
	end

	local center = camera:WorldToViewportPoint(pivot.Position)
	local edge = camera:WorldToViewportPoint(pivot.Position + camera.CFrame.RightVector * TRACKBALL_RADIUS_STUDS)
	local center2 = Vector2.new(center.X, center.Y)
	local radiusPixels = math.max(18, (Vector2.new(edge.X, edge.Y) - center2).Magnitude)

	self._dragStartMousePosition = mousePosition
	self._dragCurrentMousePosition = mousePosition
	self._dragCameraCFrame = camera.CFrame
	-- Make every drag start from the same intuitive tangent, regardless of
	-- where the cursor was released on the previous drag.
	self._dragArcballCenter = mousePosition
	self._dragArcballRadius = radiusPixels
end

function TrackballTool:_activatePluginMouse()
	if not self._plugin then
		return
	end

	pcall(function()
		self._plugin:Activate(true)
	end)

	if not self._pluginMouse then
		pcall(function()
			self._pluginMouse = self._plugin:GetMouse()
		end)
	end
end

function TrackballTool:_deactivatePluginMouse()
	if not self._plugin then
		return
	end

	pcall(function()
		self._plugin:Deactivate()
	end)
end

function TrackballTool:_beginDrag(mousePosition, forceHit)
	debugLog(
		"beginDrag",
		"forceHit=" .. tostring(forceHit == true),
		"active=" .. tostring(self._active == true),
		"dragging=" .. tostring(self._dragging == true),
		"hasSession=" .. tostring(self._session ~= nil),
		mousePosition
	)
	if self._suppressBeginUntil and os.clock() &lt; self._suppressBeginUntil then
		debugLog("beginDrag suppressed", "until=" .. tostring(self._suppressBeginUntil))
		return false
	end
	if not forceHit and not self:_isMouseOnTrackball(mousePosition) then
		if self._onViewportPick and self._onViewportPick(self._pluginMouse, mousePosition) then
			debugLog("beginDrag viewport-pick handled", mousePosition)
			self._suppressBeginUntil = os.clock() + 0.12
			return false
		end
		debugLog("beginDrag missed handle", mousePosition)
		self:_setStatus("Trackball ready. Click the purple Trackball circle to pose; missed clicks are ignored.")
		return false
	end
	if self._session and self._timeline and type(self._session.SetFrame) == "function" then
		if type(self._session.RebaseToCurrentPose) == "function" then
			self._session:RebaseToCurrentPose()
		end
		self._session:SetFrame(self._timeline:getCurrentFrame())
	end
	if typeof(mousePosition) ~= "Vector2" then
		mousePosition = self:_getBestMousePositionForTrackball()
	end
	self._dragging = true
	setViewportSelectionHighlightSuppressed(true)
	self._ignoreViewportPickerUntil = os.clock() + 0.35
	self:_syncViewportOwnership()
	self._dragDelta = Vector2.zero
	self._lastMousePosition = mousePosition
	self:_captureArcballBasis(mousePosition)
	if self._onDragBegin then
		self._onDragBegin(self._session)
	end
	debugLog("beginDrag started", mousePosition)
	self:_setStatus(self:_formatActiveHint("dragging"))
	return true
end

function TrackballTool:_getPluginMousePosition()
	if not self._pluginMouse then
		return nil
	end

	local x = tonumber(self._pluginMouse.X)
	local y = tonumber(self._pluginMouse.Y)
	if not x or not y then
		return nil
	end
	return Vector2.new(x, y)
end

function TrackballTool:_getUserInputMouseCandidates(preferredPosition)
	local candidates = {}
	if typeof(preferredPosition) == "Vector2" then
		table.insert(candidates, preferredPosition)
	elseif typeof(preferredPosition) == "Vector3" then
		table.insert(candidates, Vector2.new(preferredPosition.X, preferredPosition.Y))
	end

	local ok, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if not ok or typeof(mouseLocation) ~= "Vector2" then
		return candidates
	end

	table.insert(candidates, mouseLocation)
	local insetOk, topLeftInset = pcall(function()
		local topLeft = GuiService:GetGuiInset()
		return topLeft
	end)
	if insetOk and typeof(topLeftInset) == "Vector2" then
		table.insert(candidates, mouseLocation - topLeftInset)
	end
	return candidates
end

function TrackballTool:_getBestMousePositionForTrackball(preferredPosition)
	local pluginPosition = self:_getPluginMousePosition()
	if self:_isMouseOnTrackball(pluginPosition) then
		return pluginPosition
	end

	local candidates = self:_getUserInputMouseCandidates(preferredPosition)
	for _, candidate in ipairs(candidates) do
		if self:_isMouseOnTrackball(candidate) then
			return candidate
		end
	end

	return pluginPosition or candidates[1]
end

function TrackballTool:_getLiveDragMousePosition(preferredPosition)
	local candidates = self:_getUserInputMouseCandidates(preferredPosition)
	local pluginPosition = self:_getPluginMousePosition()
	if pluginPosition and os.clock() - (self._lastPluginMouseMoveTime or 0) &lt; 0.12 then
		table.insert(candidates, pluginPosition)
	end

	if #candidates == 0 then
		return pluginPosition
	end

	local last = self._lastMousePosition
	if typeof(last) ~= "Vector2" then
		return candidates[1]
	end

	local best = candidates[1]
	local bestDistance = (best - last).Magnitude
	for index = 2, #candidates do
		local candidate = candidates[index]
		local distance = (candidate - last).Magnitude
		if distance &lt; bestDistance then
			best = candidate
			bestDistance = distance
		end
	end
	return best
end

function TrackballTool:_applyDragPosition(mousePosition)
	if not self._active or not self._dragging or typeof(mousePosition) ~= "Vector2" then
		return false
	end

	local last = self._lastMousePosition or mousePosition
	self._lastMousePosition = mousePosition
	self._dragCurrentMousePosition = mousePosition
	local delta = mousePosition - last
	if delta.Magnitude &lt;= 0 then
		return false
	end
	return self:Update(delta)
end

function TrackballTool:_isMouseOnTrackball(mousePosition)
	if not self._active or not self._session or typeof(mousePosition) ~= "Vector2" then
		return false
	end

	local camera = workspace.CurrentCamera
	local pivot = self._session:GetPivotCFrame()
	if not camera or not pivot then
		return false
	end

	local center, onScreen = camera:WorldToViewportPoint(pivot.Position)
	if not onScreen then
		return false
	end

	local edge = camera:WorldToViewportPoint(pivot.Position + camera.CFrame.RightVector * TRACKBALL_RADIUS_STUDS)
	local center2 = Vector2.new(center.X, center.Y)
	local radiusPixels = math.max(18, (Vector2.new(edge.X, edge.Y) - center2).Magnitude)
	local distance = (mousePosition - center2).Magnitude
	return distance &lt;= (radiusPixels + TRACKBALL_HIT_TOLERANCE)
end

function TrackballTool:_bindInput()
	if self._plugin then
		pcall(function()
			self._pluginMouse = self._plugin:GetMouse()
		end)
	end

	if self._pluginMouse then
		table.insert(self._connections, safeConnect(self._pluginMouse.Button1Down, function()
			if self._active and not self._dragging then
				self:_beginDrag(self:_getBestMousePositionForTrackball())
			end
		end))

		table.insert(self._connections, safeConnect(self._pluginMouse.Move, function()
			if not self._active or not self._dragging then
				return
			end
			local position = self:_getPluginMousePosition()
			if not position then
				return
			end
			if self:_applyDragPosition(position) then
				self._lastPluginMouseMoveTime = os.clock()
			end
		end))

		table.insert(self._connections, safeConnect(self._pluginMouse.Button1Up, function()
			if self._active and self._dragging then
				self:Commit()
			end
		end))

		table.insert(self._connections, safeConnect(self._pluginMouse.Button2Down, function()
			if self._active and not self:_shouldYieldRightMouseToStudio() then
				self:Cancel()
			end
		end))
	end

	if self._sphere then
		local hasDownSignal, downSignal = pcall(function()
			return self._sphere.MouseButton1Down
		end)
		if hasDownSignal and downSignal then
			table.insert(self._connections, safeConnect(downSignal, function()
				if self._active and not self._dragging then
					self:_beginDrag(self:_getBestMousePositionForTrackball(), true)
				end
			end))
		end
		local hasUpSignal, upSignal = pcall(function()
			return self._sphere.MouseButton1Up
		end)
		if hasUpSignal and upSignal then
			table.insert(self._connections, safeConnect(upSignal, function()
				if self._active and self._dragging then
					self:Commit()
				end
			end))
		end
	end

	table.insert(self._connections, safeConnect(RunService.Heartbeat, function()
		if not self._active or not self._dragging then
			return
		end
		if self._pluginMouse and os.clock() - (self._lastPluginMouseMoveTime or 0) &lt; 0.03 then
			return
		end
		self:_applyDragPosition(self:_getLiveDragMousePosition())
	end))

	table.insert(self._connections, safeConnect(UserInputService.InputBegan, function(input)
		if not self._active then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if self._dragging then
				return
			end
			self:_beginDrag(self:_getBestMousePositionForTrackball(input.Position))
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			if not self:_shouldYieldRightMouseToStudio() then
				self:Cancel()
			end
		elseif input.KeyCode == Enum.KeyCode.Escape then
			self:Cancel()
		end
	end))

	table.insert(self._connections, safeConnect(UserInputService.InputChanged, function(input)
		if not self._active or not self._dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if self._pluginMouse and os.clock() - (self._lastPluginMouseMoveTime or 0) &lt; 0.05 then
				return
			end
			self:_applyDragPosition(self:_getLiveDragMousePosition(input.Position))
		end
	end))

	table.insert(self._connections, safeConnect(UserInputService.InputEnded, function(input)
		if not self._active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and self._dragging then
			self:Commit()
		end
	end))
end

function TrackballTool:_setStatus(message)
	if self._onStatus then
		self._onStatus(message)
	end
end

function TrackballTool:_shouldYieldRightMouseToStudio()
	if type(self._shouldYieldRightMouse) ~= "function" then
		return false
	end
	local ok, shouldYield = pcall(self._shouldYieldRightMouse)
	return ok and shouldYield == true
end

function TrackballTool:_bindCancelAction()
	pcall(function()
		ContextActionService:UnbindAction(CANCEL_ACTION_NAME)
		ContextActionService:BindActionAtPriority(
			CANCEL_ACTION_NAME,
			function(_, inputState, inputObject)
				if inputState ~= Enum.UserInputState.Begin then
					return Enum.ContextActionResult.Pass
				end
				if not self._active then
					return Enum.ContextActionResult.Pass
				end
				if inputObject and inputObject.KeyCode == Enum.KeyCode.Escape then
					self:Cancel()
					return Enum.ContextActionResult.Sink
				end
				return Enum.ContextActionResult.Pass
			end,
			false,
			CANCEL_ACTION_PRIORITY,
			Enum.KeyCode.Escape
		)
	end)
end

function TrackballTool:_unbindCancelAction()
	pcall(function()
		ContextActionService:UnbindAction(CANCEL_ACTION_NAME)
	end)
end

function TrackballTool:_syncViewportOwnership()
	if not self._folder then
		return
	end
	self._folder:SetAttribute("Active", self._active == true)
	self._folder:SetAttribute("Sticky", self._sticky == true)
	self._folder:SetAttribute("Dragging", self._dragging == true)
	self._folder:SetAttribute("OwnsViewport", self._sticky == true or self._active == true or self._dragging == true)
	self._folder:SetAttribute("IgnoreViewportPickerUntil", self._ignoreViewportPickerUntil or 0)
	local debugState = string.format(
		"active=%s sticky=%s dragging=%s owns=%s ignoreUntil=%.2f",
		tostring(self._active == true),
		tostring(self._sticky == true),
		tostring(self._dragging == true),
		tostring(self._sticky == true or self._active == true or self._dragging == true),
		tonumber(self._ignoreViewportPickerUntil) or 0
	)
	if debugState ~= self._lastOwnershipDebug then
		self._lastOwnershipDebug = debugState
		debugLog("ownership", debugState)
	end
end

function TrackballTool:_setActive(active)
	self._active = active == true
	self:_syncViewportOwnership()
	if self._onActiveChanged then
		self._onActiveChanged(self._active)
	end
end

function TrackballTool:_formatActiveHint(state)
	local axisText = self._axis and (" Axis " .. self._axis .. " locked.") or " Free camera-relative control."
	local exitText = self:_shouldYieldRightMouseToStudio()
		and " Right-click=Studio camera, Esc=cancel."
		or " Esc/right-click=cancel."
	return string.format("Trackball %s %s.%s Shift=fine, Ctrl=snap.%s", self._mode, state or "ready", axisText, exitText)
end

function TrackballTool:_formatGuideText()
	local axisText = self._axis and ("Axis: " .. self._axis) or "Axis: Free"
	local exitText = self:_shouldYieldRightMouseToStudio()
		and "Right-click Studio camera  |  Esc cancels"
		or "Esc or right-click cancels"
	return string.format(
		"Trackball %s  |  %s  |  %s\nDrag viewport to pose, release to save\nX/Y/Z lock  |  Shift fine  |  Ctrl snap\n%s",
		self._mode,
		axisText,
		self._readoutText or (self._mode == "Move" and "0.00 studs" or "0.00 deg"),
		exitText
	)
end

function TrackballTool:_getAxisVector(axis)
	local localAxis = axisVector(axis)
	if not localAxis then
		return nil
	end

	-- Motor6D rigs keep the existing world-axis behavior. Bone rigs use the
	-- same corrected bone-chain basis as the visible Micro/Main gizmo so the
	-- X/Y/Z locks match what the user sees on skinned mesh rigs.
	if self._session
		and type(self._session.UsesBoneTargets) == "function"
		and self._session:UsesBoneTargets()
		and type(self._session.GetAxisCFrame) == "function" then
		local axisCFrame = self._session:GetAxisCFrame()
		if axisCFrame then
			return axisCFrame:VectorToWorldSpace(localAxis)
		end
	end

	return localAxis
end

function TrackballTool:_updateVisual()
	local visible = self._active and self._session ~= nil and self._visualSuppressed ~= true
	local pivot = self._session and self._session:GetPivotCFrame() or nil
	if pivot then
		self._proxyPart.CFrame = pivot
	end

	if self._sphere then
		safeSet(self._sphere, "Visible", visible)
		safeSet(self._sphere, "Color3", self._axis and AXIS_COLORS[self._axis] or DEFAULT_COLOR)
	end

	if self._billboard then
		self._billboard.Enabled = visible
	end
	if self._label then
		self._label.Text = self:_formatGuideText()
		self._label.TextColor3 = self._axis and AXIS_COLORS[self._axis] or Color3.fromRGB(232, 236, 248)
	end
end

function TrackballTool:_makeRotation()
	local delta = self._dragDelta
	local rotateDelta = INVERT_ROTATE_MOUSE_X and Vector2.new(-delta.X, delta.Y) or delta
	local multiplier = isFineDown() and FINE_MULTIPLIER or 1
	local snapRadians = nil
	if isSnapDown() and self._getRotateSnapDegrees then
		local degrees = self._getRotateSnapDegrees()
		if type(degrees) == "number" and degrees &gt; 0 then
			snapRadians = math.rad(degrees)
		end
	end

	if self._axis then
		local angle = (rotateDelta.X - rotateDelta.Y) * ROTATE_PIXELS_TO_RADIANS * multiplier
		if self._axis == "Y" or self._axis == "Z" then
			angle = -angle
		end
		angle = snapRadians and roundToIncrement(angle, snapRadians) or angle
		self._readoutText = string.format("%.2f deg", math.deg(angle))
		return CFrame.fromAxisAngle(self:_getAxisVector(self._axis) or Vector3.yAxis, angle)
	end

	local cameraCFrame = getCameraCFrame()
	local xAngle = -rotateDelta.X * ROTATE_PIXELS_TO_RADIANS * multiplier
	local yAngle = rotateDelta.Y * ROTATE_PIXELS_TO_RADIANS * multiplier
	if snapRadians then
		xAngle = roundToIncrement(xAngle, snapRadians)
		yAngle = roundToIncrement(yAngle, snapRadians)
	end
	self._readoutText = string.format("Yaw %.2f deg / Pitch %.2f deg", math.deg(xAngle), math.deg(yAngle))

	return CFrame.fromAxisAngle(cameraCFrame.UpVector, xAngle)
		* CFrame.fromAxisAngle(cameraCFrame.RightVector, yAngle)
end

function TrackballTool:_makeMoveDelta()
	local delta = self._dragDelta
	local multiplier = isFineDown() and FINE_MULTIPLIER or 1
	local scale = MOVE_PIXELS_TO_STUDS * multiplier
	local snap = nil
	if isSnapDown() and self._getMoveSnap then
		local moveSnap = self._getMoveSnap()
		if type(moveSnap) == "number" and moveSnap &gt; 0 then
			snap = moveSnap
		end
	end

	if self._axis then
		local amount = (delta.X - delta.Y) * scale
		amount = snap and roundToIncrement(amount, snap) or amount
		self._readoutText = string.format("%.2f studs", amount)
		return (self:_getAxisVector(self._axis) or Vector3.xAxis) * amount
	end

	local cameraCFrame = getCameraCFrame()
	local move = (cameraCFrame.RightVector * delta.X + cameraCFrame.UpVector * -delta.Y) * scale
	if snap then
		local snapped = Vector3.new(
			roundToIncrement(move.X, snap),
			roundToIncrement(move.Y, snap),
			roundToIncrement(move.Z, snap)
		)
		self._readoutText = string.format("%.2f studs", snapped.Magnitude)
		return snapped
	end
	self._readoutText = string.format("%.2f studs", move.Magnitude)
	return move
end

function TrackballTool:Begin(selection)
	debugLog("Begin", selectionSummary(selection))
	if self._active then
		debugLog("Begin cancelling active session before re-begin")
		self:Cancel()
	end

	local session = TransformSession.new({
		timeline = self._timeline,
		beginUndo = self._beginUndo,
		finishUndo = self._finishUndo,
		discardUndo = self._discardUndo,
	})
	local success, message = session:Begin(selection)
	if not success then
		debugLog("Begin failed", tostring(message), selectionSummary(selection))
		self:_setStatus(message)
		return false, message
	end

	self._session = session
	self._dragging = false
	self._dragDelta = Vector2.zero
	self._lastMousePosition = nil
	self._readoutText = self._mode == "Move" and "0.00 studs" or "0.00 deg"
	if self._onSessionBegin then
		self._onSessionBegin(self._session)
	end
	self._lastSelection = self:_copySelection(selection)
	self:_activatePluginMouse()
	self:_setActive(true)
	self:_bindCancelAction()
	self:_updateVisual()
	self:_setStatus(message)
	debugLog("Begin success", tostring(message), selectionSummary(selection))
	return true, message
end

function TrackballTool:Retarget(selection)
	debugLog("Retarget", selectionSummary(selection), "active=" .. tostring(self._active == true))
	if not self._active then
		return self:Begin(selection)
	end
	if self._dragging then
		debugLog("Retarget rejected while dragging")
		return false, "Finish the current Trackball drag before selecting another target."
	end
	if self._session then
		self._session:Cancel()
	end

	local session = TransformSession.new({
		timeline = self._timeline,
		beginUndo = self._beginUndo,
		finishUndo = self._finishUndo,
		discardUndo = self._discardUndo,
	})
	local success, message = session:Begin(selection)
	if not success then
		debugLog("Retarget failed", tostring(message), selectionSummary(selection))
		self:_setStatus(message)
		return false, message
	end

	self._session = session
	self._dragDelta = Vector2.zero
	self._lastMousePosition = nil
	self._dragStartMousePosition = nil
	self._dragCurrentMousePosition = nil
	self._dragCameraCFrame = nil
	self._dragArcballCenter = nil
	self._dragArcballRadius = nil
	self._readoutText = self._mode == "Move" and "0.00 studs" or "0.00 deg"
	if self._onSessionBegin then
		self._onSessionBegin(self._session)
	end
	self._lastSelection = self:_copySelection(selection)
	self:_activatePluginMouse()
	self:_setActive(true)
	self:_bindCancelAction()
	self:_updateVisual()
	self:_setStatus(message)
	debugLog("Retarget success", tostring(message), selectionSummary(selection))
	return true, message
end

function TrackballTool:Update(inputDelta)
	if not self._active or not self._session or typeof(inputDelta) ~= "Vector2" then
		return false
	end

	self._dragDelta += inputDelta
	if self._dragStartMousePosition and not self._pluginMouse then
		self._dragCurrentMousePosition = self._dragStartMousePosition + self._dragDelta
	end
	local success
	if self._mode == "Move" then
		success = self._session:PreviewMove(self:_makeMoveDelta())
	else
		success = self._session:PreviewRotation(self:_makeRotation())
	end

	if success then
		if self._onPreview then
			self._onPreview(self._session)
		end
		self:_updateVisual()
	end
	return success == true
end

function TrackballTool:Commit()
	if not self._session then
		debugLog("Commit ignored", "no session")
		return false, "Trackball Pose Mode is not active."
	end

	self._ignoreViewportPickerUntil = os.clock() + 0.45
	local session = self._session
	local rearmSelection = self:_selectionFromSession(session) or self:_copySelection(self._lastSelection)
	debugLog("Commit begin", "sticky=" .. tostring(self._sticky == true), selectionSummary(rearmSelection))
	if self._onBeforeCommit then
		self._onBeforeCommit(session)
	end
	local success, message, result = session:Commit()
	debugLog("Commit result", "success=" .. tostring(success == true), tostring(message), result or "result=nil")
	self._session = nil
	self._dragging = false
	setViewportSelectionHighlightSuppressed(false)
	self._dragDelta = Vector2.zero
	self._lastMousePosition = nil
	self._dragStartMousePosition = nil
	self._dragCurrentMousePosition = nil
	self._dragCameraCFrame = nil
	self._dragArcballCenter = nil
	self._dragArcballRadius = nil
	self:_setActive(false)
	self:_unbindCancelAction()
	self:_syncViewportOwnership()
	if not self._sticky then
		self:_deactivatePluginMouse()
	end
	self:_updateVisual()

	if success then
		if self._onCommit then
			self._onCommit(result, message)
		end
		if self._sticky and not self._active then
			debugLog("Commit rearm requested", selectionSummary(rearmSelection))
			self:_rearmStickySelection(rearmSelection)
		end
	else
		local noMovement = message == "Trackball Pose Mode ended without changes."
		if self._sticky and noMovement then
			if self._onCommit then
				self._onCommit(nil, message)
			end
			if not self._active then
				debugLog("Commit no-move rearm requested", selectionSummary(rearmSelection))
				self:_rearmStickySelection(rearmSelection)
			end
		elseif self._onCancel then
			self._onCancel(message)
		end
		if not self._sticky then
			self:_deactivatePluginMouse()
		end
	end
	self:_setStatus(message)
	return success, message
end

function TrackballTool:Cancel()
	local message = "Trackball Pose Mode cancelled."
	if self._session then
		local _, cancelMessage = self._session:Cancel()
		message = cancelMessage or message
	end

	self._session = nil
	self._dragging = false
	setViewportSelectionHighlightSuppressed(false)
	self._dragDelta = Vector2.zero
	self._lastMousePosition = nil
	self._dragStartMousePosition = nil
	self._dragCurrentMousePosition = nil
	self._dragCameraCFrame = nil
	self._dragArcballCenter = nil
	self._dragArcballRadius = nil
	self:_setActive(false)
	self:_unbindCancelAction()
	self._sticky = false
	self:_syncViewportOwnership()
	self:_deactivatePluginMouse()
	self:_updateVisual()
	if self._onCancel then
		self._onCancel(message)
	end
	self:_setStatus(message)
	return true, message
end

function TrackballTool:SetAxis(axis)
	axis = axis and string.upper(tostring(axis)) or nil
	if axis ~= "X" and axis ~= "Y" and axis ~= "Z" then
		axis = nil
	end
	if self._axis == axis then
		self._axis = nil
	else
		self._axis = axis
	end
	self:_updateVisual()
	self:_setStatus(self:_formatActiveHint("ready"))
	return self._axis
end

function TrackballTool:GetAxis()
	return self._axis
end

function TrackballTool:SetMode(mode)
	mode = tostring(mode or "Rotate")
	self._mode = mode == "Move" and "Move" or "Rotate"
	self:_updateVisual()
end

function TrackballTool:SetSticky(sticky)
	self._sticky = sticky == true
	self:_syncViewportOwnership()
end

function TrackballTool:SetVisualSuppressed(suppressed)
	self._visualSuppressed = suppressed == true
	self:_updateVisual()
end

function TrackballTool:IsActive()
	return self._active == true
end

function TrackballTool:IsPointerOverHandle()
	if self._ignoreViewportPickerUntil and os.clock() &lt;= self._ignoreViewportPickerUntil then
		return true
	end
	if not self._active or not self._session then
		return false
	end
	if self:_isMouseOnTrackball(self:_getPluginMousePosition()) then
		return true
	end
	for _, candidate in ipairs(self:_getUserInputMouseCandidates()) do
		if self:_isMouseOnTrackball(candidate) then
			return true
		end
	end
	return false
end

function TrackballTool:_copySelection(selection, frameOverride)
	if type(selection) ~= "table" then
		return nil
	end

	local frame = tonumber(frameOverride or selection.frame)
	if frame == nil and self._timeline and type(self._timeline.getCurrentFrame) == "function" then
		frame = self._timeline:getCurrentFrame()
	end

	local paths = {}
	local seen = {}
	local function addPath(path)
		if type(path) ~= "string" or seen[path] then
			return
		end
		if self._timeline and type(self._timeline.getTrackByPath) == "function" and not self._timeline:getTrackByPath(path) then
			return
		end
		seen[path] = true
		table.insert(paths, path)
	end

	if type(selection.paths) == "table" then
		for _, path in ipairs(selection.paths) do
			addPath(path)
		end
	else
		addPath(selection.path)
	end

	if #paths &gt; 1 then
		return {
			paths = paths,
			frame = frame,
		}
	elseif #paths == 1 then
		return {
			path = paths[1],
			frame = frame,
		}
	end
	return nil
end

function TrackballTool:_selectionFromSession(session)
	if not (session and type(session.GetTargetPaths) == "function") then
		return nil
	end

	local paths = session:GetTargetPaths()
	if type(paths) ~= "table" or #paths == 0 then
		return nil
	end
	return self:_copySelection({
		paths = paths,
		frame = self._timeline and type(self._timeline.getCurrentFrame) == "function" and self._timeline:getCurrentFrame() or nil,
	})
end

function TrackballTool:_rearmStickySelection(selection)
	if not self._sticky then
		debugLog("rearm skipped", "sticky=false")
		return false
	end

	local frame = self._timeline and type(self._timeline.getCurrentFrame) == "function" and self._timeline:getCurrentFrame() or nil
	local nextSelection = self:_copySelection(selection or self._lastSelection, frame)
	if not nextSelection then
		debugLog("rearm failed", "no selection")
		return false
	end

	local success = self:Begin(nextSelection)
	debugLog("rearm complete", "success=" .. tostring(success == true), selectionSummary(nextSelection))
	return success == true
end

function TrackballTool:GetTargetPaths()
	if self._session and type(self._session.GetTargetPaths) == "function" then
		return self._session:GetTargetPaths()
	end
	if self._lastSelection then
		local paths = {}
		if type(self._lastSelection.paths) == "table" then
			for _, path in ipairs(self._lastSelection.paths) do
				table.insert(paths, path)
			end
		elseif type(self._lastSelection.path) == "string" then
			table.insert(paths, self._lastSelection.path)
		end
		return paths
	end
	return {}
end

function TrackballTool:GetSession()
	return self._session
end

function TrackballTool:SyncToCurrentPose()
	if self._session and type(self._session.RebaseToCurrentPose) == "function" then
		self._session:RebaseToCurrentPose()
		self._dragDelta = Vector2.zero
		self._lastMousePosition = nil
		self._dragStartMousePosition = nil
		self._dragCurrentMousePosition = nil
		self:_updateVisual()
		return true
	end

	return false
end

function TrackballTool:SyncToFrame(frame)
	if self._session and type(self._session.SetFrame) == "function" then
		self._session:SetFrame(frame)
	end
	if self._active and self._sticky then
		self:_activatePluginMouse()
		self:_syncViewportOwnership()
	end
	debugLog("SyncToFrame", "frame=" .. tostring(frame), "active=" .. tostring(self._active == true), "sticky=" .. tostring(self._sticky == true))
	return self:SyncToCurrentPose()
end

function TrackballTool:Destroy()
	self:Cancel()
	self:_unbindCancelAction()
	if self._folder then
		self._folder:SetAttribute("OwnsViewport", false)
	end
	for _, connection in ipairs(self._connections) do
		if connection then
			connection:Disconnect()
		end
	end
	self._connections = {}
	if self._folder then
		self._folder:Destroy()
	end
	if self._proxyPart then
		self._proxyPart:Destroy()
	end
end

return TrackballTool
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX247">
        <Properties>
          <string name="Name">TrackColorService</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local TrackColorService = {}

TrackColorService.CategoryColors = {
	Camera = Color3.fromRGB(170, 90, 255),
	Object = Color3.fromRGB(80, 210, 255),
	Prop = Color3.fromRGB(80, 210, 255),
	Part = Color3.fromRGB(255, 180, 70),
	Particle = Color3.fromRGB(255, 95, 180),
	Effect = Color3.fromRGB(255, 95, 180),
	Audio = Color3.fromRGB(80, 255, 140),
	Event = Color3.fromRGB(255, 225, 90),
	Marker = Color3.fromRGB(255, 225, 90),
	Constraint = Color3.fromRGB(120, 160, 255),
	Unknown = Color3.fromRGB(180, 190, 205),
}

TrackColorService.R15Colors = {
	HumanoidRootPart = Color3.fromRGB(255, 255, 255),
	LowerTorso = Color3.fromRGB(255, 165, 60),
	UpperTorso = Color3.fromRGB(255, 120, 90),
	Head = Color3.fromRGB(255, 215, 80),
	Neck = Color3.fromRGB(255, 215, 80),
	LeftUpperArm = Color3.fromRGB(85, 210, 255),
	LeftLowerArm = Color3.fromRGB(50, 175, 240),
	LeftHand = Color3.fromRGB(25, 140, 220),
	RightUpperArm = Color3.fromRGB(90, 255, 155),
	RightLowerArm = Color3.fromRGB(55, 220, 120),
	RightHand = Color3.fromRGB(25, 185, 90),
	LeftUpperLeg = Color3.fromRGB(180, 120, 255),
	LeftLowerLeg = Color3.fromRGB(145, 90, 235),
	LeftFoot = Color3.fromRGB(110, 70, 215),
	RightUpperLeg = Color3.fromRGB(255, 105, 185),
	RightLowerLeg = Color3.fromRGB(230, 70, 155),
	RightFoot = Color3.fromRGB(200, 45, 130),
}

TrackColorService.R6Colors = {
	HumanoidRootPart = Color3.fromRGB(255, 255, 255),
	Torso = Color3.fromRGB(255, 130, 80),
	Head = Color3.fromRGB(255, 215, 80),
	["Left Arm"] = Color3.fromRGB(80, 190, 255),
	["Right Arm"] = Color3.fromRGB(80, 255, 150),
	["Left Leg"] = Color3.fromRGB(160, 105, 255),
	["Right Leg"] = Color3.fromRGB(255, 95, 175),
}

local function normalizeName(name)
	return string.gsub(string.lower(tostring(name or "")), "[%s_%-]+", "")
end

local function findByNormalizedName(palette, normalizedName)
	for name, color in pairs(palette) do
		if normalizeName(name) == normalizedName then
			return color
		end
	end
	return nil
end

function TrackColorService.getRigPartColor(partName)
	local normalizedName = normalizeName(partName)
	return TrackColorService.R15Colors[partName]
		or TrackColorService.R6Colors[partName]
		or findByNormalizedName(TrackColorService.R15Colors, normalizedName)
		or findByNormalizedName(TrackColorService.R6Colors, normalizedName)
		or TrackColorService.CategoryColors.Unknown
end

function TrackColorService.getCategoryColor(category)
	return TrackColorService.CategoryColors[category] or TrackColorService.CategoryColors.Unknown
end

function TrackColorService.getEasingTint(easingStyle)
	local colors = Constants.EASING_STYLE_COLORS or {}
	return colors[easingStyle or Constants.DEFAULT_EASING_STYLE]
		or colors[Constants.DEFAULT_EASING_STYLE]
		or TrackColorService.CategoryColors.Unknown
end

function TrackColorService.getTrackColor(trackData, easingStyle)
	local trackType = trackData and trackData.trackType or "Unknown"
	local propertyName = trackData and (trackData.propertyName or trackData.valueType or trackData.name) or ""

	if trackType == "Rig" then
		local baseColor = TrackColorService.getRigPartColor(trackData.part1 or trackData.name or trackData.path)
		if easingStyle and easingStyle ~= Constants.DEFAULT_EASING_STYLE then
			return baseColor:Lerp(TrackColorService.getEasingTint(easingStyle), 0.18)
		end
		return baseColor
	end

	if trackType == "Rig Group" then
		return TrackColorService.getCategoryColor("Marker")
	end

	if trackType == "Camera" or trackType == "Camera Property" then
		return TrackColorService.getCategoryColor("Camera")
	end

	if trackType == "Screen Effect" then
		return TrackColorService.getCategoryColor("Effect")
	end

	if trackType == "Emitter Group" or trackType == "Emitter Group Property" or trackType == "Particle Event" then
		return TrackColorService.getCategoryColor("Particle")
	end

	if trackType == "Event" then
		return TrackColorService.getCategoryColor("Event")
	end

	if trackType == "Sound" then
		return TrackColorService.getCategoryColor("Audio")
	end

	if trackType == "Rig Property" then
		if propertyName == "CFrame" then
			return TrackColorService.getCategoryColor("Constraint")
		elseif propertyName == "Scale" then
			return Color3.fromRGB(170, 120, 255)
		elseif propertyName == "Transparency" then
			return TrackColorService.getCategoryColor("Effect")
		elseif propertyName == "Color" then
			return TrackColorService.getCategoryColor("Marker")
		elseif propertyName == "Reflectance" then
			return TrackColorService.getCategoryColor("Object")
		end
		return TrackColorService.getCategoryColor("Constraint")
	end

	if trackType == "ObjectProperty" or trackType == "Object Property" then
		if propertyName == "CFrame" then
			return TrackColorService.getCategoryColor("Object")
		elseif propertyName == "Transparency" or propertyName == "Color" then
			return TrackColorService.getCategoryColor("Effect")
		end
	end

	if trackType == "Rig CFrame" or trackType == "Model" or trackType == "Object" then
		return TrackColorService.getCategoryColor("Object")
	end

	return TrackColorService.getCategoryColor("Unknown")
end

return TrackColorService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX248">
        <Properties>
          <string name="Name">TrackEasingOptionsSupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))

local TrackEasingOptionsSupport = {}

local function getSelectedKeyOptions(hostOrViewModel)
	local viewModel = hostOrViewModel or {}
	if type(viewModel._lastViewModel) == "table" then
		viewModel = viewModel._lastViewModel
	end
	local options = type(viewModel.selectedKeyOptions) == "table" and viewModel.selectedKeyOptions or {}
	return tostring(options.easingStyle or Constants.DEFAULT_EASING_STYLE),
		tostring(options.easingDirection or Constants.DEFAULT_EASING_DIRECTION)
end

local function setPanelExpanded(host, prefix, expanded)
	local frame = host["_" .. prefix .. "EasingFrame"]
	if not frame then
		return
	end
	local collapsedSizeName = "_" .. prefix .. "EasingFrameCollapsedSize"
	local collapsedZIndexName = "_" .. prefix .. "EasingFrameCollapsedZIndex"
	if not host[collapsedSizeName] then
		host[collapsedSizeName] = frame.Size
	end
	if not host[collapsedZIndexName] then
		host[collapsedZIndexName] = frame.ZIndex
	end
	frame.Active = true
	frame.ClipsDescendants = false
	if expanded then
		local expandedZ = math.max(frame.ZIndex, 240)
		frame.ZIndex = expandedZ
		for _, descendant in ipairs(frame:GetDescendants()) do
			if descendant:IsA("GuiObject") then
				descendant.ZIndex = math.max(descendant.ZIndex, expandedZ + 1)
			end
		end
		frame.Size = UDim2.new(
			host[collapsedSizeName].X.Scale,
			host[collapsedSizeName].X.Offset,
			host[collapsedSizeName].Y.Scale,
			math.max(host[collapsedSizeName].Y.Offset, 206)
		)
	else
		frame.ZIndex = host[collapsedZIndexName]
		frame.Size = host[collapsedSizeName]
	end
end

local function setMenuVisible(host, prefix, menuName)
	local styleMenu = host["_" .. prefix .. "EasingStyleMenu"]
	local directionMenu = host["_" .. prefix .. "EasingDirectionMenu"]
	local styleVisible = false
	local directionVisible = false
	if styleMenu then
		styleVisible = menuName == "Style" and not styleMenu.Visible
		styleMenu.Visible = styleVisible
	end
	if directionMenu then
		directionVisible = menuName == "Direction" and not directionMenu.Visible
		directionMenu.Visible = directionVisible
	end
	setPanelExpanded(host, prefix, styleVisible or directionVisible)
end

local function hideMenus(host, prefix)
	local styleMenu = host["_" .. prefix .. "EasingStyleMenu"]
	local directionMenu = host["_" .. prefix .. "EasingDirectionMenu"]
	if styleMenu then
		styleMenu.Visible = false
	end
	if directionMenu then
		directionMenu.Visible = false
	end
	setPanelExpanded(host, prefix, false)
end

local function styleSmallButton(button)
	button.AutoButtonColor = true
	button.BackgroundColor3 = Constants.THEME.PanelSoft
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamSemibold
	button.TextColor3 = Constants.THEME.Text
	button.TextSize = 11
end

local function updateOptionButtons(buttons, selectedValue)
	for value, button in pairs(buttons or {}) do
		local isSelected = value == selectedValue
		button.BackgroundColor3 = isSelected and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		button.TextColor3 = isSelected and Constants.THEME.Text or Constants.THEME.MutedText
	end
end

local function createOptionMenu(create, createCorner, parent, values, widthScale, zIndex)
	local menu = create("ScrollingFrame", {
		Parent = parent,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(widthScale == 0 and 0 or 0.5, widthScale == 0 and 10 or 4, 0, 60),
		ScrollBarThickness = 4,
		Size = UDim2.new(0.5, -14, 0, math.min(#values * 26 + 8, 138)),
		Visible = false,
		ZIndex = zIndex + 4,
	})
	createCorner(menu, 9)
	create("UIListLayout", {
		Parent = menu,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = menu,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	local buttons = {}
	for index, value in ipairs(values) do
		local optionButton = create("TextButton", {
			Parent = menu,
			LayoutOrder = index,
			Size = UDim2.new(1, -2, 0, 22),
			Text = tostring(value),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = zIndex + 5,
		})
		styleSmallButton(optionButton)
		createCorner(optionButton, 7)
		create("UIPadding", {
			Parent = optionButton,
			PaddingLeft = UDim.new(0, 8),
		})
		buttons[value] = optionButton
	end
	return menu, buttons
end

function TrackEasingOptionsSupport.ensurePanel(host, spec)
	if not (host and spec and spec.card and spec.create and spec.createCorner) then
		return nil
	end
	local prefix = spec.prefix or "track"
	local frameName = "_" .. prefix .. "EasingFrame"
	if host[frameName] and host[frameName].Parent then
		return host[frameName]
	end

	local create = spec.create
	local createCorner = spec.createCorner
	local createStroke = spec.createStroke
	local zIndex = spec.zIndex or 130
	local frame = create("Frame", {
		Name = prefix .. "EasingFrame",
		Parent = spec.card,
		Active = true,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Position = spec.position or UDim2.new(0, 18, 0, 300),
		Size = spec.size or UDim2.new(1, -36, 0, 68),
		ZIndex = zIndex,
	})
	host["_" .. prefix .. "EasingFrameCollapsedSize"] = frame.Size
	createCorner(frame, 10)
	if createStroke then
		createStroke(frame)
	end

	create("TextLabel", {
		Parent = frame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 6),
		Size = UDim2.new(1, -20, 0, 16),
		Font = Enum.Font.GothamSemibold,
		Text = spec.title or "Selected key easing",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zIndex + 1,
	})

	local styleButton = create("TextButton", {
		Parent = frame,
		Position = UDim2.new(0, 10, 0, 28),
		Size = UDim2.new(0.5, -14, 0, 26),
		Text = "Style: Linear v",
		ZIndex = zIndex + 1,
	})
	styleSmallButton(styleButton)
	createCorner(styleButton, 8)

	local directionButton = create("TextButton", {
		Parent = frame,
		Position = UDim2.new(0.5, 4, 0, 28),
		Size = UDim2.new(0.5, -14, 0, 26),
		Text = "Dir: InOut v",
		ZIndex = zIndex + 1,
	})
	styleSmallButton(directionButton)
	createCorner(directionButton, 8)

	local styleMenu, styleButtons = createOptionMenu(create, createCorner, frame, Constants.EASING_STYLES or {}, 0, zIndex)
	local directionMenu, directionButtons = createOptionMenu(create, createCorner, frame, Constants.EASING_DIRECTIONS or {}, 0.5, zIndex)

	host[frameName] = frame
	host["_" .. prefix .. "EasingStyleButton"] = styleButton
	host["_" .. prefix .. "EasingDirectionButton"] = directionButton
	host["_" .. prefix .. "EasingStyleMenu"] = styleMenu
	host["_" .. prefix .. "EasingDirectionMenu"] = directionMenu
	host["_" .. prefix .. "EasingStyleOptionButtons"] = styleButtons
	host["_" .. prefix .. "EasingDirectionOptionButtons"] = directionButtons
	return frame
end

function TrackEasingOptionsSupport.updatePanel(host, prefix, viewModel)
	if not host then
		return
	end
	prefix = prefix or "track"
	local easingStyle, easingDirection = getSelectedKeyOptions(viewModel or host)
	local styleButton = host["_" .. prefix .. "EasingStyleButton"]
	local directionButton = host["_" .. prefix .. "EasingDirectionButton"]
	if styleButton then
		styleButton.Text = "Style: " .. easingStyle .. " v"
	end
	if directionButton then
		directionButton.Text = "Dir: " .. easingDirection .. " v"
	end
	updateOptionButtons(host["_" .. prefix .. "EasingStyleOptionButtons"], easingStyle)
	updateOptionButtons(host["_" .. prefix .. "EasingDirectionOptionButtons"], easingDirection)
end

function TrackEasingOptionsSupport.connectPanel(host, callbacks, prefix, refresh)
	if not host then
		return
	end
	prefix = prefix or "track"
	local connectedName = "_" .. prefix .. "EasingConnected"
	if host[connectedName] then
		return
	end
	local styleButton = host["_" .. prefix .. "EasingStyleButton"]
	local directionButton = host["_" .. prefix .. "EasingDirectionButton"]
	if not (styleButton and directionButton) then
		return
	end
	host[connectedName] = true

	host:_connect(styleButton.Activated, function()
		setMenuVisible(host, prefix, "Style")
	end)
	host:_connect(directionButton.Activated, function()
		setMenuVisible(host, prefix, "Direction")
	end)

	for easingStyle, optionButton in pairs(host["_" .. prefix .. "EasingStyleOptionButtons"] or {}) do
		host:_connect(optionButton.Activated, function()
			hideMenus(host, prefix)
			if callbacks and callbacks.onSetEasingStyle then
				callbacks.onSetEasingStyle(easingStyle)
			end
			if type(refresh) == "function" then
				task.defer(refresh)
			end
		end)
	end

	for easingDirection, optionButton in pairs(host["_" .. prefix .. "EasingDirectionOptionButtons"] or {}) do
		host:_connect(optionButton.Activated, function()
			hideMenus(host, prefix)
			if callbacks and callbacks.onSetEasingDirection then
				callbacks.onSetEasingDirection(easingDirection)
			end
			if type(refresh) == "function" then
				task.defer(refresh)
			end
		end)
	end
end

function TrackEasingOptionsSupport.renderListSection(controller, viewModel, list, deps)
	if not (controller and list and deps and deps.create and deps.createCorner) then
		return
	end
	local create = deps.create
	local createCorner = deps.createCorner
	local callbacks = deps.callbacks or controller._callbacks or {}
	local rerender = deps.rerender
	local zIndex = deps.zIndex or 111
	local easingStyle, easingDirection = getSelectedKeyOptions(viewModel)

	create("TextLabel", {
		Parent = list,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Keyframe Easing",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zIndex,
	})

	local function makeListButton(text, onClick)
		local button = create("TextButton", {
			Parent = list,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -8, 0, 26),
			Font = Enum.Font.Gotham,
			Text = text,
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = zIndex,
		})
		createCorner(button, 7)
		create("UIPadding", {
			Parent = button,
			PaddingLeft = UDim.new(0, 10),
		})
		controller:_connect(button.Activated, onClick)
		return button
	end

	makeListButton("Style: " .. easingStyle .. " v", function()
		controller._trackEasingListMenu = controller._trackEasingListMenu == "Style" and nil or "Style"
		if type(rerender) == "function" then
			rerender()
		elseif type(controller._renderRigPropertyEditor) == "function" then
			controller:_renderRigPropertyEditor()
		end
	end)
	if controller._trackEasingListMenu == "Style" then
		for _, styleName in ipairs(Constants.EASING_STYLES or {}) do
			makeListButton("  " .. tostring(styleName), function()
				controller._trackEasingListMenu = nil
				if callbacks.onSetEasingStyle then
					callbacks.onSetEasingStyle(styleName)
				end
				task.defer(function()
					if type(rerender) == "function" then
						rerender()
					end
					if list and list.Parent and list:IsA("ScrollingFrame") then
						list.CanvasPosition = Vector2.zero
					end
				end)
			end).TextColor3 = styleName == easingStyle and Constants.THEME.Accent or Constants.THEME.MutedText
		end
	end

	makeListButton("Direction: " .. easingDirection .. " v", function()
		controller._trackEasingListMenu = controller._trackEasingListMenu == "Direction" and nil or "Direction"
		if type(rerender) == "function" then
			rerender()
		elseif type(controller._renderRigPropertyEditor) == "function" then
			controller:_renderRigPropertyEditor()
		end
	end)
	if controller._trackEasingListMenu == "Direction" then
		for _, directionName in ipairs(Constants.EASING_DIRECTIONS or {}) do
			makeListButton("  " .. tostring(directionName), function()
				controller._trackEasingListMenu = nil
				if callbacks.onSetEasingDirection then
					callbacks.onSetEasingDirection(directionName)
				end
				task.defer(function()
					if type(rerender) == "function" then
						rerender()
					end
					if list and list.Parent and list:IsA("ScrollingFrame") then
						list.CanvasPosition = Vector2.zero
					end
				end)
			end).TextColor3 = directionName == easingDirection and Constants.THEME.Accent or Constants.THEME.MutedText
		end
	end
end

return TrackEasingOptionsSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX249">
        <Properties>
          <string name="Name">TrackEnabledAction</string>
          <ProtectedString name="Source">local TrackEnabledAction = {}

function TrackEnabledAction.create(deps)
	deps = deps or {}
	return function(path, disabled)
		local timeline = deps.timeline
		local track = timeline and timeline:getTrackByPath(path) or nil
		if not track then
			deps.refreshUi("That track is no longer available.")
			return
		end

		deps.pushUndo(disabled and "Disable Track" or "Enable Track")
		local success, message = timeline:setTrackDisabled(path, disabled)
		if not success then
			deps.refreshUi(message)
			return false, message
		end

		if type(deps.invalidateTimelineRenderCache) == "function" then
			deps.invalidateTimelineRenderCache()
		end

		local status = string.format("%s track '%s'.", disabled and "Disabled" or "Enabled", track.name or track.part1 or path)
		deps.refreshUi(status)
		return true, status
	end
end

return TrackEnabledAction
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX250">
        <Properties>
          <string name="Name">TrackIconService</string>
          <ProtectedString name="Source">local TrackIconService = {}

-- Sourced from ReplicatedStorage.ImageAssets in the Studio place. The actual
-- folder is not packaged with the plugin; only these reusable asset ids are.
TrackIconService.Images = {
	CFrame = "rbxassetid://75655673050358",
	Camera = "rbxassetid://107485288009043",
	Decal = "rbxassetid://108152055647407",
	Event = "rbxassetid://126191860470631",
	Face = "rbxassetid://103887400269107",
	Folder = "rbxassetid://77381728995598",
	Model = "rbxassetid://89987192976079",
	Object = "rbxassetid://80691049687942",
	Particles = "rbxassetid://132826876782480",
	Rig = "rbxassetid://84424290988173",
	Sound = "rbxassetid://96399009830410",
}

local PROPERTY_ICON_BY_NAME = {
	CFrame = "CFrame",
	Color = "Decal",
	Color3 = "Decal",
	Face = "Face",
	Texture = "Decal",
	Transparency = "Decal",
}

local function getInstanceIconKey(instance)
	if not instance or not instance.Parent then
		return nil
	end
	if instance:IsA("Camera") then
		return "Camera"
	end
	if instance:IsA("Sound") then
		return "Sound"
	end
	if instance:IsA("ParticleEmitter") then
		return "Particles"
	end
	if instance:IsA("Decal") or instance:IsA("Texture") then
		return "Decal"
	end
	if instance:IsA("Model") then
		return "Model"
	end
	if instance:IsA("BasePart") or instance:IsA("Attachment") then
		return "Object"
	end
	return nil
end

function TrackIconService.getIconKey(trackData)
	trackData = trackData or {}
	local trackType = trackData.trackType or "Rig"
	local propertyName = trackData.propertyName or trackData.valueType or trackData.name

	if trackType == "Rig Group" then
		return "Rig"
	end
	if trackType == "Rig" then
		return nil
	end
	if trackType == "Folder" then
		return "Folder"
	end
	if trackType == "Camera" or trackType == "Camera Property" or trackData.targetScope == "CameraProperty" then
		return "Camera"
	end
	if trackType == "Sound" or trackData.targetScope == "Sound" or trackData.valueType == "Sound" then
		return "Sound"
	end
	if trackType == "Face" or trackData.targetScope == "Face" or propertyName == "Face" then
		return "Face"
	end
	if trackType == "Event" then
		return "Event"
	end
	if trackType == "Particle Event"
		or trackType == "Emitter Group"
		or trackType == "Emitter Group Property"
		or trackData.targetScope == "ParticleEvent"
		or trackData.targetScope == "EmitterGroup" then
		return "Particles"
	end
	if trackType == "Rig Property" or trackType == "Object Property" then
		return PROPERTY_ICON_BY_NAME[propertyName] or getInstanceIconKey(trackData.instance) or "Object"
	end
	if trackType == "Rig CFrame" then
		return "CFrame"
	end
	if trackType == "Model" then
		return "Model"
	end
	if trackType == "Object" then
		return getInstanceIconKey(trackData.instance) or "Object"
	end

	return getInstanceIconKey(trackData.instance)
end

function TrackIconService.getIconImage(trackData)
	local key = TrackIconService.getIconKey(trackData)
	if not key then
		return nil
	end
	return TrackIconService.Images[key]
end

return TrackIconService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX251">
        <Properties>
          <string name="Name">TrackPropertyDefaultsService</string>
          <ProtectedString name="Source">local ParticleEmitterGroupService = require(script.Parent:WaitForChild("ParticleEmitterGroupService"))
local ParticleEmitterPropertyService = require(script.Parent:WaitForChild("ParticleEmitterPropertyService"))
local PropertyKeyframeValueService = require(script.Parent:WaitForChild("PropertyKeyframeValueService"))

local TrackPropertyDefaultsService = {}

local PROPERTY_SORT_ORDERS = {
	CFrame = 1,
	Scale = 2,
	Text = 1,
	MaxVisibleGraphemes = 2,
	TextColor3 = 3,
	TextTransparency = 3.5,
	TextSize = 4,
	TextStrokeColor3 = 4.5,
	TextStrokeTransparency = 4.6,
	BackgroundColor3 = 5,
	BackgroundTransparency = 5.1,
	Visible = 6,
	Transparency = 3,
	Color = 4,
	Reflectance = 5,
	Color3 = 4.5,
	Face = 21,
	Enabled = 1,
	Size = 2,
	Brightness = 5,
	Contrast = 5.1,
	Saturation = 5.2,
	TintColor = 5.3,
	Intensity = 5.4,
	Threshold = 5.5,
	FocusDistance = 5.6,
	InFocusRadius = 5.7,
	NearIntensity = 5.8,
	FarIntensity = 5.9,
	Spread = 6.1,
	Range = 6,
	Angle = 7,
	Shadows = 8,
	Speed = 7,
	Squash = 8,
	Shape = 9,
	ShapeInOut = 10,
	ShapeStyle = 11,
	TimeScale = 12,
	Rate = 13,
	Drag = 14,
	Lifetime = 15,
	Rotation = 16,
	RotSpeed = 17,
	LightEmission = 18,
	LightInfluence = 19,
	Texture = 20,
	EmissionDirection = 21,
	SpreadAngle = 22,
	Acceleration = 23,
	VelocityInheritance = 24,
	ZOffset = 25,
	LockedToPart = 26,
}

local DEFAULT_EMITTER_GROUP_PROPERTIES = {
	"Enabled",
	"Size",
	"Color",
	"Transparency",
}

local DEFAULT_LIGHT_PROPERTIES = {
	"Enabled",
	"Brightness",
	"Range",
	"Color",
}

local DEFAULT_OBJECT_PROPERTIES = {
	"CFrame",
}

local DEFAULT_TEXT_GUI_PROPERTIES = {
	"Text",
}

local DEFAULT_POST_EFFECT_PROPERTIES_BY_CLASS = {
	ColorCorrectionEffect = {
		"Enabled",
		"Brightness",
		"Contrast",
		"Saturation",
		"TintColor",
	},
	BloomEffect = {
		"Enabled",
		"Intensity",
		"Size",
		"Threshold",
	},
	BlurEffect = {
		"Enabled",
		"Size",
	},
	DepthOfFieldEffect = {
		"Enabled",
		"FocusDistance",
		"InFocusRadius",
		"NearIntensity",
		"FarIntensity",
	},
	SunRaysEffect = {
		"Enabled",
		"Intensity",
		"Spread",
	},
}

function TrackPropertyDefaultsService.getSortOrder(propertyName)
	return PROPERTY_SORT_ORDERS[propertyName] or 10
end

function TrackPropertyDefaultsService.addDefaultEmitterGroupPropertyTracks(timeline, groupTrack)
	if not timeline or not groupTrack or not groupTrack.instance or not groupTrack.instance.Parent then
		return 0
	end

	local emitters = ParticleEmitterGroupService.collectEmitters(groupTrack.instance)
	local addedCount = 0
	for _, propertyName in ipairs(DEFAULT_EMITTER_GROUP_PROPERTIES) do
		if ParticleEmitterPropertyService.isTrackableProperty(propertyName)
			and not timeline:getObjectPropertyTrack(groupTrack.path, propertyName) then
			timeline:addGenericTrack("EmitterGroupProperty", groupTrack.instance, propertyName, {
				propertyName = propertyName,
				targetScope = "EmitterGroupProperty",
				parentTrackPath = groupTrack.path,
				parentTrackName = groupTrack.name,
				emitters = emitters,
				sortOrder = TrackPropertyDefaultsService.getSortOrder(propertyName),
			})
			addedCount += 1
		end
	end
	return addedCount
end

function TrackPropertyDefaultsService.addDefaultLightPropertyTracks(timeline, lightTrack)
	if not timeline or not lightTrack or not lightTrack.instance or not lightTrack.instance.Parent then
		return 0
	end

	local defaultProperties = DEFAULT_LIGHT_PROPERTIES
	if PropertyKeyframeValueService.isPostEffectInstance(lightTrack.instance) then
		defaultProperties = DEFAULT_POST_EFFECT_PROPERTIES_BY_CLASS[lightTrack.instance.ClassName]
			or PropertyKeyframeValueService.getPostEffectPropertyOptions(lightTrack.instance)
			or {}
	end

	local addedCount = 0
	local firstAddedTrack = nil
	for _, propertyName in ipairs(defaultProperties) do
		if PropertyKeyframeValueService.isPropertyAllowedForTrack(lightTrack, propertyName, false)
			and not timeline:getObjectPropertyTrack(lightTrack.path, propertyName) then
			local track = timeline:addGenericTrack("ObjectProperty", lightTrack.instance, propertyName, {
				propertyName = propertyName,
				targetScope = "ObjectProperty",
				parentTrackPath = lightTrack.path,
				parentTrackName = lightTrack.name,
				sortOrder = TrackPropertyDefaultsService.getSortOrder(propertyName),
			})
			firstAddedTrack = firstAddedTrack or track
			addedCount += 1
		end
	end
	return addedCount, firstAddedTrack
end

function TrackPropertyDefaultsService.addDefaultObjectPropertyTracks(timeline, objectTrack)
	if not timeline or not objectTrack or not objectTrack.instance or not objectTrack.instance.Parent then
		return 0, nil
	end

	local defaultProperties = DEFAULT_OBJECT_PROPERTIES
	if PropertyKeyframeValueService.isTextGuiInstance(objectTrack.instance) then
		defaultProperties = DEFAULT_TEXT_GUI_PROPERTIES
	end

	local addedCount = 0
	local firstAddedTrack = nil
	for _, propertyName in ipairs(defaultProperties) do
		if PropertyKeyframeValueService.isPropertyAllowedForTrack(objectTrack, propertyName, false)
			and not timeline:getObjectPropertyTrack(objectTrack.path, propertyName) then
			local track = timeline:addGenericTrack("ObjectProperty", objectTrack.instance, propertyName, {
				propertyName = propertyName,
				targetScope = "ObjectProperty",
				parentTrackPath = objectTrack.path,
				parentTrackName = objectTrack.name,
				sortOrder = TrackPropertyDefaultsService.getSortOrder(propertyName),
			})
			firstAddedTrack = firstAddedTrack or track
			addedCount += 1
		end
	end
	return addedCount, firstAddedTrack
end

return TrackPropertyDefaultsService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX252">
        <Properties>
          <string name="Name">TrackSelectionAction</string>
          <ProtectedString name="Source">local TrackSelectionUiSupport = require(script.Parent:WaitForChild("TrackSelectionUiSupport"))

local TrackSelectionAction = {}

function TrackSelectionAction.create(deps)
	deps = deps or {}
	return function(path, additive)
		local timeline = deps.timeline
		local track = timeline and timeline:getTrackByPath(path) or nil
		local selectionAction, message = TrackSelectionUiSupport.resolveTrackSelection(
			track,
			additive,
			deps.isOnlySelectedTrack(path)
		)
		if not selectionAction then
			deps.refreshUi(message)
			return
		end

		if selectionAction == "selectJoint" then
			deps.selectJoint(path, additive)
			return
		end

		if selectionAction == "toggleSelectedTrack" then
			deps.toggleSelectedTrack(path)
		elseif selectionAction == "clearSelection" then
			deps.clearSelectedTracks()
			deps.clearSelectedKeyframes()
		else
			deps.setSingleSelectedTrack(path)
		end
		local selectedCount = #deps.getSelectedTrackPaths()
		deps.refreshUi(TrackSelectionUiSupport.buildTrackSelectionMessage(track, selectedCount))
	end
end

return TrackSelectionAction
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX253">
        <Properties>
          <string name="Name">TrackSelectionStateSupport</string>
          <ProtectedString name="Source">local TrackSelectionStateSupport = {}

function TrackSelectionStateSupport.setSingleSelectedTrack(path, timeline)
	if not path or not timeline:getTrackByPath(path) then
		return {}, nil, true
	end

	return {
		[path] = true,
	}, path, false
end

function TrackSelectionStateSupport.toggleSelectedTrack(path, timeline, selectedTrackPaths, selectedJointPath)
	if not path or not timeline:getTrackByPath(path) then
		return selectedTrackPaths, selectedJointPath, false
	end

	local nextSelectedTrackPaths = {}
	for selectedPath in pairs(selectedTrackPaths or {}) do
		nextSelectedTrackPaths[selectedPath] = true
	end

	local nextSelectedJointPath = selectedJointPath
	if nextSelectedTrackPaths[path] then
		nextSelectedTrackPaths[path] = nil
		if nextSelectedJointPath == path then
			nextSelectedJointPath = nil
			for candidatePath in pairs(nextSelectedTrackPaths) do
				nextSelectedJointPath = candidatePath
				break
			end
		end
	else
		nextSelectedTrackPaths[path] = true
		nextSelectedJointPath = path
	end

	return nextSelectedTrackPaths, nextSelectedJointPath, true
end

function TrackSelectionStateSupport.isOnlySelectedTrack(path, selectedTrackPaths)
	if not path or not selectedTrackPaths[path] then
		return false
	end

	local count = 0
	for selectedPath in pairs(selectedTrackPaths) do
		count += 1
		if selectedPath ~= path then
			return false
		end
	end

	return count == 1
end

return TrackSelectionStateSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX254">
        <Properties>
          <string name="Name">TrackSelectionUiSupport</string>
          <ProtectedString name="Source">local TrackSelectionUiSupport = {}

function TrackSelectionUiSupport.resolveTrackSelection(track, additive, isOnlySelected)
	if not track then
		return nil, "That track is no longer available."
	end

	if track.trackType == "Rig" then
		return "selectJoint"
	end

	if additive then
		return "toggleSelectedTrack"
	end
	if isOnlySelected then
		return "clearSelection"
	end
	return "setSingleSelectedTrack"
end

function TrackSelectionUiSupport.buildTrackSelectionMessage(track, selectedCount)
	if selectedCount == 0 then
		return string.format("Deselected %s track '%s'.", track.trackType, track.name)
	end
	return string.format("Selected %s track '%s'%s.", track.trackType, track.name, selectedCount &gt; 1 and (" plus " .. tostring(selectedCount - 1) .. " more") or "")
end

return TrackSelectionUiSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX255">
        <Properties>
          <string name="Name">TransformSession</string>
          <ProtectedString name="Source">local TransformSession = {}
TransformSession.__index = TransformSession

local RigService = require(script.Parent:WaitForChild("RigService"))

local function getCamera()
	return workspace.CurrentCamera
end

local function isRigCFrameTrack(track)
	return track
		and track.targetScope == "RigProperty"
		and track.propertyName == "CFrame"
end

local function getRigRootPart(instance)
	if not (instance and instance.Parent and instance:IsA("Model")) then
		return nil
	end
	local rootPart = instance:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	for _, rootName in ipairs({ "Torso", "LowerTorso", "UpperTorso" }) do
		local torsoPart = instance:FindFirstChild(rootName)
		if torsoPart and torsoPart:IsA("BasePart") then
			return torsoPart
		end
	end
	local primaryPart = instance.PrimaryPart
	if primaryPart and primaryPart.Parent and primaryPart:IsA("BasePart") then
		return primaryPart
	end
	return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getTrackTargetCFrame(track)
	if track and track.trackType == "Camera" then
		local camera = getCamera()
		return camera and camera.CFrame or nil
	end

	local instance = track and track.instance
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("Camera") or instance:IsA("BasePart") then
		return instance.CFrame
	end

	if instance:IsA("Model") then
		if isRigCFrameTrack(track) then
			local rootPart = getRigRootPart(instance)
			if rootPart then
				return rootPart.CFrame
			end
		end
		return instance:GetPivot()
	end

	return nil
end

local function applyTrackTargetCFrame(track, cframe)
	if typeof(cframe) ~= "CFrame" then
		return false
	end

	if track and track.trackType == "Camera" then
		local camera = getCamera()
		if camera then
			camera.CFrame = cframe
			return true
		end
	end

	local instance = track and track.instance
	if not instance or not instance.Parent then
		return false
	end

	if instance:IsA("Camera") or instance:IsA("BasePart") then
		instance.CFrame = cframe
		return true
	end

	if instance:IsA("Model") then
		if isRigCFrameTrack(track) then
			local rootPart = getRigRootPart(instance)
			if rootPart then
				instance:PivotTo(cframe * rootPart.CFrame:Inverse() * instance:GetPivot())
				return true
			end
		end
		instance:PivotTo(cframe)
		return true
	end

	return false
end

local function rotationOnly(cframe)
	return cframe - cframe.Position
end

local function makeMovedCFrame(cframe, delta)
	return CFrame.new(cframe.Position + delta) * rotationOnly(cframe)
end

local function makeMotorCFrame(position, rotation)
	return CFrame.new(position) * rotation
end

local function worldRotationToPart0Local(part0, worldRotation)
	local part0Rotation = part0.CFrame - part0.CFrame.Position
	return part0Rotation:Inverse() * worldRotation * part0Rotation
end

local function isR6MotorTarget(target)
	if target and target.isBone then
		return false
	end
	local rig = target and target.rig
	if not rig then
		local motor = target and target.motor
		rig = motor and motor:FindFirstAncestorOfClass("Model")
	end
	local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.RigType == Enum.HumanoidRigType.R6
end

local function getParentSpaceRotation(target)
	if target and target.isBone then
		local parentWorld = RigService.getBoneParentWorldCFrame(target.motor)
		if typeof(parentWorld) == "CFrame" then
			return parentWorld - parentWorld.Position
		end
		return nil
	end

	local motor = target and target.motor
	if motor and motor.Part0 then
		return motor.Part0.CFrame - motor.Part0.CFrame.Position
	end
	return nil
end

local function worldRotationToJointLocal(target, worldRotation)
	local parentRotation = getParentSpaceRotation(target)
	if not parentRotation then
		return nil
	end
	return parentRotation:Inverse() * worldRotation * parentRotation
end

local function worldDeltaToJointLocal(target, worldDelta)
	if target and target.isBone then
		local parentWorld = RigService.getBoneParentWorldCFrame(target.motor)
		return typeof(parentWorld) == "CFrame" and parentWorld:VectorToObjectSpace(worldDelta) or nil
	end

	local motor = target and target.motor
	return motor and motor.Part0 and motor.Part0.CFrame:VectorToObjectSpace(worldDelta) or nil
end

local function makeWorldRotatedJointCFrame(target, worldRotation)
	local original = target and target.originalWorldCFrame
	if typeof(original) ~= "CFrame" or typeof(worldRotation) ~= "CFrame" then
		return nil
	end
	return CFrame.new(original.Position) * worldRotation * rotationOnly(original)
end

local function makeCameraValue(cframe)
	local camera = getCamera()
	if not camera then
		return cframe
	end

	return {
		cframe = cframe,
		focus = camera.Focus,
		fieldOfView = camera.FieldOfView,
	}
end

local function buildMotorTarget(timeline, path)
	local motorData = timeline and timeline:getMotorByPath(path)
	if not motorData or not motorData.instance or not motorData.instance.Parent then
		return nil, "Trackball Pose Mode could not find one of the selected rig joints."
	end

	local motor = motorData.instance
	if not RigService.isBoneJoint(motorData) and not motor.Part0 then
		return nil, "Trackball Pose Mode needs each selected joint to have a Part0 pivot."
	end

	local jointPose = RigService.getJointPose(motorData)
	local worldCFrame = RigService.getJointWorldCFrame(motorData)
	if not jointPose or not worldCFrame then
		return nil, "Trackball Pose Mode could not read one of the selected rig joints."
	end

	return {
		kind = "Motor",
		path = path,
		name = motorData.name or "Joint",
		motor = motor,
		motorData = motorData,
		isBone = RigService.isBoneJoint(motorData),
		originalC0 = jointPose,
		originalWorldCFrame = worldCFrame,
		currentWorldCFrame = worldCFrame,
		rig = motorData.rig,
	}
end

local function getAverageTargetPivot(targets)
	if type(targets) ~= "table" or #targets == 0 then
		return nil
	end

	local position = Vector3.zero
	for _, target in ipairs(targets) do
		position += (target.currentWorldCFrame or target.originalWorldCFrame).Position
	end
	position /= #targets
	return CFrame.new(position)
end

local function getTargetGizmoCFrame(target)
	if not target then
		return nil
	end
	if target.kind == "Motor" and target.isBone == true then
		return RigService.getJointGizmoWorldCFrame(target.motorData)
	end
	return target.currentWorldCFrame or target.originalWorldCFrame
end

local function anyBoneTarget(target, targets)
	if target and target.kind == "Motor" and target.isBone == true then
		return true
	end
	for _, item in ipairs(targets or {}) do
		if item and item.kind == "Motor" and item.isBone == true then
			return true
		end
	end
	return false
end

function TransformSession.new(options)
	local self = setmetatable({}, TransformSession)
	options = options or {}
	self._timeline = options.timeline
	self._beginUndo = options.beginUndo
	self._finishUndo = options.finishUndo
	self._discardUndo = options.discardUndo
	self._target = nil
	self._targets = nil
	self._frame = nil
	self._dirty = false
	self._undoStarted = false
	self._skipNextCommitWrite = false
	self._skipNextCommitMessage = nil
	return self
end

function TransformSession:Begin(selection)
	if not self._timeline then
		return false, "Trackball Pose Mode could not find the timeline."
	end

	local paths = selection and selection.paths
	if type(paths) == "table" and #paths &gt; 1 then
		local targets = {}
		local seen = {}
		for _, selectedPath in ipairs(paths) do
			if type(selectedPath) == "string" and not seen[selectedPath] then
				seen[selectedPath] = true
				local target, message = buildMotorTarget(self._timeline, selectedPath)
				if not target then
					return false, message or "Multi Trackball currently supports rig joint keyframes only."
				end
				table.insert(targets, target)
			end
		end

		if #targets &lt; 2 then
			return false, "Select at least two same-frame rig keyframes before using multi Trackball."
		end

		self._targets = targets
		self._target = targets[1]
		self._frame = math.max(0, math.floor(selection.frame or self._timeline:getCurrentFrame() or 0))
		self._dirty = false
		self._undoStarted = false
		self._skipNextCommitWrite = false
		self._skipNextCommitMessage = nil
		return true, string.format("Trackball ready for %d selected joints at frame %d. Drag in the viewport; X/Y/Z lock, Esc cancels.", #targets, self._frame)
	end

	local path = selection and selection.path
	if not path then
		return false, "Select a joint, object, rig CFrame, or camera track before using Trackball Pose Mode."
	end

	local motorTarget = buildMotorTarget(self._timeline, path)
	if motorTarget then
		self._target = motorTarget
		self._targets = nil
		self._frame = math.max(0, math.floor(selection.frame or self._timeline:getCurrentFrame() or 0))
		self._dirty = false
		self._undoStarted = false
		self._skipNextCommitWrite = false
		self._skipNextCommitMessage = nil
		return true, string.format("Trackball ready for %s. Drag in the viewport; X/Y/Z lock, Esc cancels.", motorTarget.name or "joint")
	end

	local track = self._timeline:getTrackByPath(path)
	if not track or track.valueType ~= "CFrame" then
		return false, "Trackball Pose Mode currently supports rig joints and CFrame tracks."
	end

	local cframe = getTrackTargetCFrame(track)
	if not cframe then
		return false, string.format("Trackball Pose Mode could not find a CFrame target for '%s'.", track.name or "track")
	end

	self._target = {
		kind = track.trackType == "Camera" and "Camera" or "CFrameTrack",
		path = path,
		name = track.name or "Track",
		track = track,
		originalWorldCFrame = cframe,
		currentWorldCFrame = cframe,
	}
	self._targets = nil
	self._frame = math.max(0, math.floor(selection.frame or self._timeline:getCurrentFrame() or 0))
	self._dirty = false
	self._undoStarted = false
	self._skipNextCommitWrite = false
	self._skipNextCommitMessage = nil
	return true, string.format("Trackball ready for %s. Drag in the viewport; X/Y/Z lock, Esc cancels.", track.name or "track")
end

function TransformSession:_ensureUndo()
	if self._undoStarted then
		return
	end

	self._undoStarted = true
	if self._beginUndo then
		self._beginUndo("Trackball Pose")
	end
end

function TransformSession:_applyTargetWorldCFrame(target, cframe)
	if not target then
		return false
	end

	if target.kind == "Motor" then
		if not target.motor or not target.motor.Parent then
			return false
		end
		if not RigService.applyJointWorldCFrame(target.motorData, cframe) then
			return false
		end
	else
		if not applyTrackTargetCFrame(target.track, cframe) then
			return false
		end
	end

	target.currentWorldCFrame = cframe
	self._dirty = true
	return true
end

function TransformSession:_applyWorldCFrame(cframe)
	return self:_applyTargetWorldCFrame(self._target, cframe)
end

function TransformSession:PreviewRotation(worldRotation)
	if not self._target or typeof(worldRotation) ~= "CFrame" then
		return false
	end

	self:_ensureUndo()
	if self._targets then
		local applied = false
		for _, target in ipairs(self._targets) do
			local motor = target.motor
			if not motor or not motor.Parent then
				return false
			end

			if isR6MotorTarget(target) then
				local rotatedJoint = makeWorldRotatedJointCFrame(target, worldRotation)
				if not rotatedJoint then
					return false
				end
				if not RigService.applyJointWorldCFrame(target.motorData, rotatedJoint) then
					return false
				end
			else
				local localRotation = worldRotationToJointLocal(target, worldRotation)
				if not localRotation or not RigService.setJointPose(target.motorData, makeMotorCFrame(target.originalC0.Position, localRotation * rotationOnly(target.originalC0))) then
					return false
				end
			end
			target.currentWorldCFrame = RigService.getJointWorldCFrame(target.motorData)
			applied = true
		end
		self._dirty = applied
		return applied
	elseif self._target.kind == "Motor" then
		local motor = self._target.motor
		if not motor or not motor.Parent then
			return false
		end

		-- Motor6D joints are safest when the joint offset stays fixed and only
		-- the local C0 rotation changes. Rebuilding C0 from a world CFrame can
		-- pull connected limbs apart on some rigs.
		if isR6MotorTarget(self._target) then
			local rotatedJoint = makeWorldRotatedJointCFrame(self._target, worldRotation)
			if not rotatedJoint then
				return false
			end
			if not RigService.applyJointWorldCFrame(self._target.motorData, rotatedJoint) then
				return false
			end
		else
			local localRotation = worldRotationToJointLocal(self._target, worldRotation)
			if not localRotation or not RigService.setJointPose(self._target.motorData, makeMotorCFrame(self._target.originalC0.Position, localRotation * rotationOnly(self._target.originalC0))) then
				return false
			end
		end
		self._target.currentWorldCFrame = RigService.getJointWorldCFrame(self._target.motorData)
		self._dirty = true
		return true
	end

	local original = self._target.originalWorldCFrame
	local rotated = CFrame.new(original.Position) * worldRotation * rotationOnly(original)
	return self:_applyWorldCFrame(rotated)
end

function TransformSession:PreviewMove(worldDelta)
	if not self._target or typeof(worldDelta) ~= "Vector3" then
		return false
	end

	self:_ensureUndo()
	if self._targets then
		local applied = false
		for _, target in ipairs(self._targets) do
			local motor = target.motor
			if not motor or not motor.Parent then
				return false
			end

			local localDelta = worldDeltaToJointLocal(target, worldDelta)
			if not localDelta or not RigService.setJointPose(target.motorData, makeMotorCFrame(target.originalC0.Position + localDelta, rotationOnly(target.originalC0))) then
				return false
			end
			target.currentWorldCFrame = RigService.getJointWorldCFrame(target.motorData)
			applied = true
		end
		self._dirty = applied
		return applied
	elseif self._target.kind == "Motor" then
		local motor = self._target.motor
		if not motor or not motor.Parent then
			return false
		end

		local localDelta = worldDeltaToJointLocal(self._target, worldDelta)
		if not localDelta or not RigService.setJointPose(self._target.motorData, makeMotorCFrame(self._target.originalC0.Position + localDelta, rotationOnly(self._target.originalC0))) then
			return false
		end
		self._target.currentWorldCFrame = RigService.getJointWorldCFrame(self._target.motorData)
		self._dirty = true
		return true
	end

	return self:_applyWorldCFrame(makeMovedCFrame(self._target.originalWorldCFrame, worldDelta))
end

function TransformSession:GetPivotCFrame()
	if self._targets then
		local pivot = getAverageTargetPivot(self._targets)
		local axisCFrame = self:GetAxisCFrame()
		if pivot and axisCFrame then
			return CFrame.new(pivot.Position) * (axisCFrame - axisCFrame.Position)
		end
		return pivot
	end
	if not self._target then
		return nil
	end
	return getTargetGizmoCFrame(self._target)
end

function TransformSession:GetAxisCFrame()
	if self._targets then
		for _, target in ipairs(self._targets) do
			local axisCFrame = getTargetGizmoCFrame(target)
			if axisCFrame then
				return axisCFrame
			end
		end
		return nil
	end
	return getTargetGizmoCFrame(self._target)
end

function TransformSession:UsesBoneTargets()
	return anyBoneTarget(self._target, self._targets)
end

function TransformSession:CaptureCurrentValues()
	local values = {}
	local function addTarget(target)
		if not target or not target.path then
			return
		end
		local value = nil
		if target.kind == "Motor" then
			value = RigService.getJointPose(target.motorData)
		elseif target.kind == "Camera" then
			value = makeCameraValue(target.currentWorldCFrame)
		else
			value = target.currentWorldCFrame
		end
		if value ~= nil then
			table.insert(values, {
				path = target.path,
				value = value,
				name = target.name,
			})
		end
	end

	if self._targets then
		for _, target in ipairs(self._targets) do
			addTarget(target)
		end
	else
		addTarget(self._target)
	end

	return values
end

function TransformSession:IsDirty()
	return self._dirty == true
end

function TransformSession:SkipNextCommitWrite(message)
	self._skipNextCommitWrite = true
	self._skipNextCommitMessage = message
	return true
end

function TransformSession:RebaseToCurrentPose()
	local function rebaseTarget(target)
		if not target then
			return false
		end
		if target.kind == "Motor" then
			local motor = target.motor
			if not motor or not motor.Parent then
				return false
			end
			local worldCFrame = RigService.getJointWorldCFrame(target.motorData)
			local jointPose = RigService.getJointPose(target.motorData)
			if not worldCFrame or not jointPose then
				return false
			end
			target.originalC0 = jointPose
			target.originalWorldCFrame = worldCFrame
			target.currentWorldCFrame = worldCFrame
			return true
		end

		local cframe = getTrackTargetCFrame(target.track)
		if not cframe then
			return false
		end
		target.originalWorldCFrame = cframe
		target.currentWorldCFrame = cframe
		return true
	end

	local changed = false
	if self._targets then
		for _, target in ipairs(self._targets) do
			changed = rebaseTarget(target) or changed
		end
	else
		changed = rebaseTarget(self._target)
	end
	if changed then
		self._dirty = false
	end
	return changed
end

function TransformSession:SetFrame(frame)
	frame = tonumber(frame)
	if frame == nil then
		return false
	end
	self._frame = math.max(0, math.floor(frame + 0.5))
	return true
end

function TransformSession:GetTargetPaths()
	local paths = {}
	if self._targets then
		for _, target in ipairs(self._targets) do
			if target.path then
				table.insert(paths, target.path)
			end
		end
	elseif self._target and self._target.path then
		table.insert(paths, self._target.path)
	end
	return paths
end

function TransformSession:Commit()
	local target = self._target
	if not target then
		return false, "Trackball Pose Mode is not active."
	end

	if self._skipNextCommitWrite then
		local message = self._skipNextCommitMessage or "Trackball pose is being recorded."
		if self._undoStarted and self._finishUndo then
			self._finishUndo("Trackball Pose")
		end
		self._target = nil
		self._targets = nil
		self._frame = nil
		self._dirty = false
		self._undoStarted = false
		self._skipNextCommitWrite = false
		self._skipNextCommitMessage = nil
		return true, message, nil
	end

	if not self._dirty then
		self:Cancel()
		return false, "Trackball Pose Mode ended without changes."
	end

	if self._targets then
		local frame = self._frame or self._timeline:getCurrentFrame()
		local keys = {}
		for _, selectedTarget in ipairs(self._targets) do
			local value = RigService.getJointPose(selectedTarget.motorData)
			if value == nil then
				self:Cancel()
				return false, "Trackball Pose Mode could not capture one of the selected joints."
			end

			local success, message = self._timeline:setTrackValueAtFrame(selectedTarget.path, frame, value)
			if not success then
				self:Cancel()
				return false, message or "Trackball Pose Mode could not save the selected joints."
			end
			table.insert(keys, {
				jointPath = selectedTarget.path,
				frame = frame,
			})
		end

		if self._finishUndo then
			self._finishUndo("Trackball Pose")
		end
		local count = #self._targets
		self._target = nil
		self._targets = nil
		self._frame = nil
		return true, string.format("Saved Trackball pose for %d joints at frame %d.", count, frame), {
			keys = keys,
			frame = frame,
		}
	end

	local value
	if target.kind == "Motor" then
		value = RigService.getJointPose(target.motorData)
	elseif target.kind == "Camera" then
		value = makeCameraValue(target.currentWorldCFrame)
	else
		value = target.currentWorldCFrame
	end

	if value == nil then
		self:Cancel()
		return false, "Trackball Pose Mode could not capture the final transform."
	end

	local frame = self._frame or self._timeline:getCurrentFrame()
	local success, message = self._timeline:setTrackValueAtFrame(target.path, frame, value)
	if success then
		if self._finishUndo then
			self._finishUndo("Trackball Pose")
		end
		local result = {
			path = target.path,
			frame = frame,
			name = target.name,
		}
		self._target = nil
		self._frame = nil
		return true, message or string.format("Added Trackball keyframe at frame %d.", frame), result
	end

	self:Cancel()
	return false, message or "Trackball Pose Mode could not save the keyframe."
end

function TransformSession:Cancel()
	local target = self._target
	if not target then
		return false, "Trackball Pose Mode is not active."
	end

	if self._targets then
		for _, selectedTarget in ipairs(self._targets) do
			if selectedTarget.motor and selectedTarget.motor.Parent then
				RigService.setJointPose(selectedTarget.motorData, selectedTarget.originalC0)
			end
		end
	else
		if target.kind == "Motor" then
			if target.motor and target.motor.Parent then
				RigService.setJointPose(target.motorData, target.originalC0)
			end
		else
			applyTrackTargetCFrame(target.track, target.originalWorldCFrame)
		end
	end

	if self._undoStarted and self._discardUndo then
		self._discardUndo()
	end
	self._target = nil
	self._targets = nil
	self._frame = nil
	self._dirty = false
	self._undoStarted = false
	self._skipNextCommitWrite = false
	self._skipNextCommitMessage = nil
	return true, "Trackball Pose Mode cancelled."
end

return TransformSession
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX256">
        <Properties>
          <string name="Name">UiHelpers</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent:WaitForChild("ThemeService"))
local UiMotion = require(script.Parent:WaitForChild("UiMotion"))

local UiHelpers = {}

local BUTTON_GRADIENT_COLOR = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
	ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
})

local BUTTON_GRADIENT_TRANSPARENCY = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.800000011920929),
	NumberSequenceKeypoint.new(0.1014799177646637, 0.800000011920929),
	NumberSequenceKeypoint.new(0.5, 1),
	NumberSequenceKeypoint.new(0.8995771408081055, 0.8187500238418579),
	NumberSequenceKeypoint.new(1, 0.8187500238418579),
})

local BUTTON_ICON_IMAGES = {
	Export = "rbxassetid://122415497863526",
	Import = "rbxassetid://93251088688432",
	Move = "rbxassetid://102516158217764",
	New = "rbxassetid://122532009432707",
	NextKey = "rbxassetid://122595859821521",
	Pause = "rbxassetid://114209533494238",
	Play = "rbxassetid://77786383417694",
	PreviousKey = "rbxassetid://74487777821767",
	RecordMotion = "rbxassetid://128849369774347",
	Rotate = "rbxassetid://77169826287220",
	Save = "rbxassetid://86486456615145",
	Settings = "rbxassetid://91127106907163",
	Stop = "rbxassetid://80067010770321",
	TrackballMove = "rbxassetid://78875475465771",
	TrackballRotate = "rbxassetid://74535703803363",
	Copy = "rbxassetid://72638816901788",
	Paste = "rbxassetid://107691948133987",
	Undo = "rbxassetid://123073256961069",
	Redo = "rbxassetid://85235241099637",
	Cut = "rbxassetid://79488579833477",
	SelectAll = "rbxassetid://98182151363303",
	Delete = "rbxassetid://113381848677770",
	DefaultPose = "rbxassetid://139088315529090",
	Onion = "rbxassetid://103348390838451",
	Mirror = "rbxassetid://108360071049736",
	Invert = "rbxassetid://114623721058584",
	Easing = "rbxassetid://116285571487046",
	Direction = "rbxassetid://109894172735129",
	Group = "rbxassetid://77733309799407",
	Ungroup = "rbxassetid://111969787960607",
	Repeat = "rbxassetid://90427106399021",
	Attach = "rbxassetid://73977102493215",
	Detach = "rbxassetid://139984930312895",
}

local BUTTON_ICON_ALIASES = {
	["export"] = "Export",
	["import"] = "Import",
	["import..."] = "Import",
	["import id"] = "Import",
	["move"] = "Move",
	["move tool"] = "Move",
	["new"] = "New",
	["new project"] = "New",
	["next key"] = "NextKey",
	["pause"] = "Pause",
	["play"] = "Play",
	["play / pause"] = "Play",
	["previous key"] = "PreviousKey",
	["prev key"] = "PreviousKey",
	["record motion"] = "RecordMotion",
	["recording..."] = "RecordMotion",
	["record armed"] = "RecordMotion",
	["rotate"] = "Rotate",
	["rotate tool"] = "Rotate",
	["save"] = "Save",
	["save current"] = "Save",
	["settings"] = "Settings",
	["stop"] = "Stop",
	["trackball move"] = "TrackballMove",
	["trackball rotate"] = "TrackballRotate",
	["copy"] = "Copy",
	["copy keys"] = "Copy",
	["copy keyframes"] = "Copy",
	["paste"] = "Paste",
	["paste keys"] = "Paste",
	["paste keyframes"] = "Paste",
	["undo"] = "Undo",
	["redo"] = "Redo",
	["cut"] = "Cut",
	["select all"] = "SelectAll",
	["all"] = "SelectAll",
	["delete"] = "Delete",
	["default pose"] = "DefaultPose",
	["reset"] = "DefaultPose",
	["onion"] = "Onion",
	["onion skin"] = "Onion",
	["mirror"] = "Mirror",
	["invert"] = "Invert",
	["ease"] = "Easing",
	["easing"] = "Easing",
	["easing style"] = "Easing",
	["direction"] = "Direction",
	["ease dir"] = "Direction",
	["group"] = "Group",
	["ungroup"] = "Ungroup",
	["repeat"] = "Repeat",
	["attach"] = "Attach",
	["attach object"] = "Attach",
	["detach"] = "Detach",
	["detach object"] = "Detach",
}

local function isTextGui(instance)
	return instance:IsA("TextLabel") or instance:IsA("TextBox")
end

local function iconKeyFromText(text)
	local normalized = string.lower(tostring(text or ""))
	normalized = normalized:gsub("^%s+", ""):gsub("%s+$", "")
	normalized = normalized:gsub("%s+", " ")
	return BUTTON_ICON_ALIASES[normalized]
end

local function getToolIconColor()
	return Constants.THEME.Text
end

local function getOrCreateIconPadding(button)
	local padding = button:FindFirstChild("MegMoButtonIconPadding")
	if padding then
		return padding
	end
	for _, child in ipairs(button:GetChildren()) do
		if child:IsA("UIPadding") then
			child:SetAttribute("MegMoOriginalPaddingLeft", child.PaddingLeft.Offset)
			child.PaddingLeft = UDim.new(child.PaddingLeft.Scale, math.max(child.PaddingLeft.Offset, 26))
			return child
		end
	end
	padding = Instance.new("UIPadding")
	padding.Name = "MegMoButtonIconPadding"
	padding.PaddingLeft = UDim.new(0, 24)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = button
	return padding
end

local function applyStandardButtonStroke(button, color, transparency)
	local stroke = button:FindFirstChild("MegMoButtonStroke")
	if not stroke then
		stroke = Instance.new("UIStroke")
		stroke.Name = "MegMoButtonStroke"
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
	end
	stroke.Color = color or Constants.THEME.Accent
	stroke.Thickness = 1.25
	stroke.Transparency = transparency or 0.18
	stroke:SetAttribute("MegMoThemeStrokeRole", color == Constants.THEME.Border and "Border" or "Accent")
	return stroke
end

local function syncButtonGradientCorner(button, overlay)
	if not button or not overlay then
		return
	end
	local sourceCorner = nil
	for _, child in ipairs(button:GetChildren()) do
		if child:IsA("UICorner") then
			sourceCorner = child
			break
		end
	end
	local overlayCorner = overlay:FindFirstChild("MegMoButtonGradientCorner")
	if sourceCorner then
		if not overlayCorner then
			overlayCorner = Instance.new("UICorner")
			overlayCorner.Name = "MegMoButtonGradientCorner"
			overlayCorner.Parent = overlay
		end
		overlayCorner.CornerRadius = sourceCorner.CornerRadius
	elseif overlayCorner then
		overlayCorner:Destroy()
	end
end

local function syncButtonGradientBounds(button, overlay)
	if not button or not overlay then
		return
	end
	local left, right, top, bottom = 0, 0, 0, 0
	for _, child in ipairs(button:GetChildren()) do
		if child:IsA("UIPadding") then
			left = math.max(left, child.PaddingLeft.Offset)
			right = math.max(right, child.PaddingRight.Offset)
			top = math.max(top, child.PaddingTop.Offset)
			bottom = math.max(bottom, child.PaddingBottom.Offset)
		end
	end
	overlay.Position = UDim2.new(0, -left, 0, -top)
	overlay.Size = UDim2.new(1, left + right, 1, top + bottom)
end

local function applyButtonGradient(button)
	if not button or not button:IsA("GuiButton") then
		return nil
	end
	local oldDirectGradient = button:FindFirstChild("MegMoButtonGradient")
	if oldDirectGradient and oldDirectGradient:IsA("UIGradient") then
		oldDirectGradient:Destroy()
	end
	local overlay = button:FindFirstChild("MegMoButtonGradientOverlay")
	if not overlay then
		overlay = Instance.new("Frame")
		overlay.Name = "MegMoButtonGradientOverlay"
		overlay.Active = false
		overlay.BorderSizePixel = 0
		overlay.Parent = button
	end
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0
	overlay.ClipsDescendants = false
	overlay.ZIndex = button.ZIndex + 1
	local gradient = overlay:FindFirstChild("MegMoButtonGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Name = "MegMoButtonGradient"
		gradient.Parent = overlay
	end
	gradient.Color = BUTTON_GRADIENT_COLOR
	gradient.Transparency = BUTTON_GRADIENT_TRANSPARENCY
	gradient.Rotation = 90
	gradient.Offset = Vector2.new(0, 0)
	gradient.Enabled = true
	syncButtonGradientBounds(button, overlay)
	syncButtonGradientCorner(button, overlay)
	return overlay
end

local function applyButtonLabelOverlay(button)
	if not button or not button:IsA("TextButton") or button:GetAttribute("MegMoIconOnlyButton") == true then
		return nil
	end
	local function syncLabel(label)
		label.Font = button.Font
		label.Text = button.Text
		label.TextColor3 = button.TextColor3
		label.TextSize = button.TextSize
		label.TextScaled = button.TextScaled
		label.TextTransparency = 0
		label.TextWrapped = button.TextWrapped
		label.TextTruncate = button.TextTruncate
		label.TextXAlignment = button.TextXAlignment
		label.TextYAlignment = button.TextYAlignment
		label.ZIndex = button.ZIndex + 3
	end
	local label = button:FindFirstChild("MegMoButtonTextOverlay")
	if not label then
		label = Instance.new("TextLabel")
		label.Name = "MegMoButtonTextOverlay"
		label.Active = false
		label.BackgroundTransparency = 1
		label.ClipsDescendants = true
		label.Position = UDim2.fromScale(0, 0)
		label.Size = UDim2.fromScale(1, 1)
		label.Parent = button
		button:GetPropertyChangedSignal("Text"):Connect(function()
			syncLabel(label)
		end)
		button:GetPropertyChangedSignal("TextColor3"):Connect(function()
			syncLabel(label)
		end)
		button:GetPropertyChangedSignal("TextSize"):Connect(function()
			syncLabel(label)
		end)
		button:GetPropertyChangedSignal("TextScaled"):Connect(function()
			syncLabel(label)
		end)
		button:GetPropertyChangedSignal("Font"):Connect(function()
			syncLabel(label)
		end)
		button:GetPropertyChangedSignal("ZIndex"):Connect(function()
			syncLabel(label)
		end)
	end
	syncLabel(label)
	button.TextTransparency = 1
	return label
end

function UiHelpers.create(instanceType, props)
	local instance = Instance.new(instanceType)
	for key, value in pairs(props) do
		instance[key] = value
	end
	if (instanceType == "TextButton" or instanceType == "TextLabel") and props.TextWrapped == nil then
		instance.TextWrapped = false
	end
	if (instanceType == "TextButton" or instanceType == "TextLabel") and props.TextTruncate == nil then
		instance.TextTruncate = Enum.TextTruncate.AtEnd
	end
	if isTextGui(instance) then
		instance.ClipsDescendants = props.ClipsDescendants == nil and true or props.ClipsDescendants
	end
	return instance
end

function UiHelpers.getButtonIconImage(iconKey)
	return BUTTON_ICON_IMAGES[iconKey]
end

function UiHelpers.getButtonIconKey(textOrKey)
	return BUTTON_ICON_IMAGES[textOrKey] and textOrKey or iconKeyFromText(textOrKey)
end

function UiHelpers.setButtonIcon(button, iconKey, options)
	if not button or not button:IsA("GuiButton") then
		return nil
	end
	options = options or {}
	local buttonText = ""
	pcall(function()
		buttonText = button.Text
	end)
	local resolvedKey = UiHelpers.getButtonIconKey(iconKey or buttonText)
	local image = resolvedKey and BUTTON_ICON_IMAGES[resolvedKey] or nil
	local icon = button:FindFirstChild("MegMoButtonIcon")
	if not image then
		if icon then
			icon.Visible = false
		end
		return nil
	end
	if not icon then
		icon = Instance.new("ImageLabel")
		icon.Name = "MegMoButtonIcon"
		icon.Active = false
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.BackgroundTransparency = 1
		icon.ScaleType = Enum.ScaleType.Fit
		icon.Parent = button
	end
	local iconOnly = options.iconOnly == true or button:GetAttribute("MegMoIconOnlyButton") == true
	local buttonHeight = button.AbsoluteSize.Y &gt; 0 and button.AbsoluteSize.Y or button.Size.Y.Offset
	local size = options.size
		or (iconOnly and math.clamp(math.floor((buttonHeight &gt; 0 and buttonHeight or 36) * 0.58), 18, 32))
		or math.clamp(math.floor((buttonHeight &gt; 0 and buttonHeight or 36) * 0.52), 12, 18)
	icon.Image = image
	icon.ImageColor3 = options.color or button.TextColor3 or Constants.THEME.Text
	icon.ImageTransparency = options.transparency or 0
	icon.AnchorPoint = iconOnly and Vector2.new(0.5, 0.5) or Vector2.new(0, 0.5)
	icon.Position = options.position or (iconOnly and UDim2.fromScale(0.5, 0.5) or UDim2.new(0, 7, 0.5, 0))
	icon.Size = UDim2.fromOffset(size, size)
	icon.Visible = true
	icon.ZIndex = button.ZIndex + 3
	button:SetAttribute("MegMoButtonIconKey", resolvedKey)
	if iconOnly then
		pcall(function()
			button.Text = ""
		end)
	elseif options.noPadding ~= true then
		getOrCreateIconPadding(button)
	end
	return icon
end

function UiHelpers.applyButtonIcon(button, iconKey, options)
	return UiHelpers.setButtonIcon(button, iconKey, options)
end

function UiHelpers.styleIconTileButton(button, iconKey, accent, options)
	options = options or {}
	local iconOnly = options.iconOnly == true
	button:SetAttribute("MegMoIconOnlyButton", iconOnly)
	button.AutoButtonColor = true
	button.BackgroundColor3 = accent or Constants.THEME.PanelSoft
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamSemibold
	button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
	button.TextSize = iconOnly and 1 or 11
	button.TextTransparency = iconOnly and 1 or 0
	button.TextWrapped = not iconOnly
	button.TextTruncate = Enum.TextTruncate.None
	button.TextXAlignment = Enum.TextXAlignment.Center
	button.TextYAlignment = Enum.TextYAlignment.Bottom
	applyButtonGradient(button)
	UiMotion.attachButtonEffect(button, {
		hoverScale = 1.025,
		clickScale = 0.95,
	})

	local padding = button:FindFirstChild("MegMoTilePadding")
	if not padding then
		padding = Instance.new("UIPadding")
		padding.Name = "MegMoTilePadding"
		padding.Parent = button
	end
	padding.PaddingTop = UDim.new(0, iconOnly and 0 or 8)
	padding.PaddingBottom = UDim.new(0, iconOnly and 0 or 9)
	padding.PaddingLeft = UDim.new(0, iconOnly and 0 or 6)
	padding.PaddingRight = UDim.new(0, iconOnly and 0 or 6)
	applyButtonGradient(button)

	local iconSize = options.iconSize
		or math.clamp(
			math.floor((button.Size.Y.Offset &gt; 0 and button.Size.Y.Offset or 74) * (iconOnly and 0.58 or 0.34)),
			iconOnly and 28 or 20,
			iconOnly and 40 or 30
		)
	UiHelpers.setButtonIcon(button, iconKey or button.Text, {
		iconOnly = iconOnly,
		color = getToolIconColor(),
		noPadding = true,
		position = iconOnly and UDim2.fromScale(0.5, 0.5) or UDim2.new(0.5, -math.floor(iconSize / 2), 0, 12),
		size = iconSize,
	})
	applyButtonLabelOverlay(button)

	local stroke = button:FindFirstChild("MegMoTileStroke")
	if not stroke then
		stroke = Instance.new("UIStroke")
		stroke.Name = "MegMoTileStroke"
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
	end
	stroke.Color = Constants.THEME.Accent
	stroke.Thickness = 1.25
	stroke.Transparency = 0.28
	stroke:SetAttribute("MegMoThemeStrokeRole", "Accent")
end

function UiHelpers.setIconTileActive(button, isActive)
	if not button then
		return
	end
	button.BackgroundColor3 = isActive and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
	applyButtonGradient(button)
	if button:GetAttribute("MegMoIconOnlyButton") == true then
		button.Text = ""
		button.TextTransparency = 1
	end
	local icon = button:FindFirstChild("MegMoButtonIcon")
	if icon then
		icon.ImageColor3 = getToolIconColor()
	end
	local label = button:FindFirstChild("MegMoButtonTextOverlay")
	if label and label:IsA("TextLabel") then
		label.TextColor3 = button.TextColor3
	end
	local stroke = button:FindFirstChild("MegMoTileStroke")
	if not stroke then
		stroke = Instance.new("UIStroke")
		stroke.Name = "MegMoTileStroke"
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
	end
	stroke.Color = Constants.THEME.Accent
	stroke.Thickness = isActive and 2 or 1.25
	stroke.Transparency = isActive and 0 or 0.28
	stroke:SetAttribute("MegMoThemeStrokeRole", "Accent")
end

function UiHelpers.styleIconOnlyButton(button, iconKey, accent, options)
	options = options or {}
	button:SetAttribute("MegMoIconOnlyButton", true)
	button.AutoButtonColor = true
	button.BackgroundColor3 = accent or Constants.THEME.PanelSoft
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamSemibold
	button.Text = ""
	button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
	button.TextTransparency = 1
	button.TextSize = 1
	applyButtonGradient(button)
	UiMotion.attachButtonEffect(button, {
		hoverScale = 1.04,
		clickScale = 0.94,
	})
	UiHelpers.setButtonIcon(button, iconKey, {
		iconOnly = true,
		size = options.iconSize,
		color = options.color,
	})
	applyStandardButtonStroke(button, Constants.THEME.Accent, 0.2)
end

function UiHelpers.styleTextButton(button, accent)
	button.AutoButtonColor = true
	button.BackgroundColor3 = accent or Constants.THEME.Accent
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamSemibold
	button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.TextWrapped = false
	button.TextSize = 13
	applyButtonGradient(button)
	UiMotion.attachButtonEffect(button)
	UiHelpers.applyButtonIcon(button)
	applyButtonGradient(button)
	applyButtonLabelOverlay(button)
	applyStandardButtonStroke(button, Constants.THEME.Accent, 0.16)
end

function UiHelpers.styleGhostButton(button)
	button.AutoButtonColor = true
	button.BackgroundColor3 = Constants.THEME.PanelSoft
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamSemibold
	button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.TextWrapped = false
	button.TextSize = 13
	applyButtonGradient(button)
	UiMotion.attachButtonEffect(button)
	if button:GetAttribute("MegMoAutoIcon") == true then
		UiHelpers.applyButtonIcon(button)
	end
	applyButtonGradient(button)
	applyButtonLabelOverlay(button)
	applyStandardButtonStroke(button, Constants.THEME.Accent, 0.28)
end

function UiHelpers.styleInput(input)
	input.BackgroundColor3 = Constants.THEME.PanelSoft
	input.BorderSizePixel = 0
	input.Font = Enum.Font.Gotham
	input.TextColor3 = ThemeService.getReadableTextColor(input.BackgroundColor3)
	input.PlaceholderColor3 = ThemeService.getReadableMutedTextColor(input.BackgroundColor3)
	input.TextSize = 13
end

function UiHelpers.createCorner(parent, radius)
	local corner = UiHelpers.create("UICorner", {
		Parent = parent,
		CornerRadius = UDim.new(0, math.floor(((radius or 10) * 1.35) + 0.5)),
	})
	local overlay = parent and parent:FindFirstChild("MegMoButtonGradientOverlay")
	if overlay then
		syncButtonGradientCorner(parent, overlay)
	end
	local texture = parent and parent:FindFirstChild("MegMoPanelTexture")
	if texture and texture:IsA("GuiObject") then
		local textureCorner = texture:FindFirstChild("MegMoPanelTextureCorner")
		if not textureCorner then
			textureCorner = Instance.new("UICorner")
			textureCorner.Name = "MegMoPanelTextureCorner"
			textureCorner.Parent = texture
		end
		textureCorner.CornerRadius = corner.CornerRadius
	end
	return corner
end

function UiHelpers.createStroke(parent, color, thickness)
	local isTextStroke = parent
		and (parent:IsA("TextLabel") or parent:IsA("TextButton") or parent:IsA("TextBox"))
	local baseColor = color or Constants.THEME.Border
	local function usesWhiteText()
		return isTextStroke
			and parent.TextColor3.R &gt;= 0.88
			and parent.TextColor3.G &gt;= 0.88
			and parent.TextColor3.B &gt;= 0.88
	end
	local stroke = UiHelpers.create("UIStroke", {
		Parent = parent,
		Color = usesWhiteText() and Color3.new(0, 0, 0) or baseColor,
		Thickness = thickness or 1,
		Transparency = 0.42,
	})
	if isTextStroke then
		if usesWhiteText() then
			stroke:SetAttribute("MegMoThemeStrokeRole", "__white_text_stroke")
		end
		parent:GetPropertyChangedSignal("TextColor3"):Connect(function()
			if usesWhiteText() then
				stroke.Color = Color3.new(0, 0, 0)
				stroke:SetAttribute("MegMoThemeStrokeRole", "__white_text_stroke")
			else
				stroke.Color = baseColor
				stroke:SetAttribute("MegMoThemeStrokeRole", nil)
			end
		end)
	end
	return stroke
end

function UiHelpers.applyPanelSurface(parent, options)
	if not parent or not parent:IsA("GuiObject") then
		return
	end
	options = options or {}
	local baseColor = options.baseColor or parent.BackgroundColor3 or Constants.THEME.Panel
	local highColor = options.highColor or Constants.THEME.PanelSoft
	local lowColor = options.lowColor or Constants.THEME.Panel
	local textureKind = options.textureKind or "shell"
	local isSectionTexture = textureKind ~= "shell"
	local baseBrightness = (baseColor.R * 0.299) + (baseColor.G * 0.587) + (baseColor.B * 0.114)
	local sectionTextureColor = baseBrightness &lt; 0.42 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
	local sectionTextureTransparency = baseBrightness &lt; 0.42 and 0.58 or 0.84

	if not parent:FindFirstChild("MegMoPanelGradient") then
		UiHelpers.create("UIGradient", {
			Name = "MegMoPanelGradient",
			Parent = parent,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, highColor),
				ColorSequenceKeypoint.new(0.48, baseColor),
				ColorSequenceKeypoint.new(1, lowColor),
			}),
			Rotation = options.rotation or 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, options.topTransparency or 0.34),
				NumberSequenceKeypoint.new(0.5, options.midTransparency or 0.56),
				NumberSequenceKeypoint.new(1, options.bottomTransparency or 0.78),
			}),
		})
	end

	if not parent:FindFirstChild("MegMoPanelTexture") then
		local texture = UiHelpers.create("ImageLabel", {
			Name = "MegMoPanelTexture",
			Parent = parent,
			Active = false,
			BackgroundTransparency = 1,
			Image = options.textureImage or (isSectionTexture and Constants.PANEL_SECTION_TEXTURE or Constants.PANEL_TEXTURE),
			ImageColor3 = options.textureColor or (isSectionTexture and sectionTextureColor or Constants.THEME.PanelSoft),
			ImageTransparency = options.textureTransparency or (isSectionTexture and sectionTextureTransparency or 0.95),
			Position = UDim2.fromScale(0, 0),
			ScaleType = isSectionTexture and Enum.ScaleType.Tile or Enum.ScaleType.Tile,
			Size = UDim2.fromScale(1, 1),
			ZIndex = options.zIndex or parent.ZIndex,
		})
		pcall(function()
			texture.TileSize = options.tileSize or (isSectionTexture and UDim2.fromOffset(100, 100) or UDim2.fromOffset(72, 72))
		end)
		texture:SetAttribute("MegMoSurface", true)
		if isSectionTexture then
			UiHelpers.create("UIGradient", {
				Name = "MegMoPanelTextureGradient",
				Parent = texture,
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
					ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
				}),
				Offset = Vector2.new(0, 0),
				Rotation = -90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 0.1),
				}),
			})
		end
	end
end

function UiHelpers.applySectionSurface(parent, options)
	local merged = {}
	for key, value in pairs(options or {}) do
		merged[key] = value
	end
	merged.textureKind = "section"
	return UiHelpers.applyPanelSurface(parent, merged)
end

function UiHelpers.createSectionTitle(parent, text)
	return UiHelpers.create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
		Font = Enum.Font.GothamBold,
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
end

function UiHelpers.createPanelCollapseButton(parent)
	local button = UiHelpers.create("TextButton", {
		Name = "PanelCollapseButton",
		Parent = parent,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 28, 0, 24),
		Text = "-",
		ZIndex = 80,
	})
	UiHelpers.styleGhostButton(button)
	UiHelpers.createCorner(button, 7)
	return button
end

function UiHelpers.createMetaLabel(parent, text, height)
	return UiHelpers.create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 18),
		Font = Enum.Font.GothamSemibold,
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
end

function UiHelpers.createListLayout(parent, padding)
	return UiHelpers.create("UIListLayout", {
		Parent = parent,
		Padding = UDim.new(0, padding or 6),
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UiHelpers.createCard(parent, size, options)
	local frame = UiHelpers.create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Size = size,
	})
	UiHelpers.applyPanelSurface(frame, options)
	UiHelpers.createCorner(frame, 12)
	UiHelpers.createStroke(frame)
	UiHelpers.create("UIGradient", {
		Name = "SevenKg2CardDepth",
		Parent = frame,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(196, 208, 232)),
		}),
		Rotation = 90,
	})
	return frame
end

function UiHelpers.createGridPreview(parent)
	local preview = UiHelpers.create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.StageBottom,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
	})
	UiHelpers.createCorner(preview, 14)
	UiHelpers.createStroke(preview)

	UiHelpers.create("UIGradient", {
		Parent = preview,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Constants.THEME.StageTop),
			ColorSequenceKeypoint.new(0.28, Color3.fromRGB(85, 132, 192)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(90, 128, 168)),
			ColorSequenceKeypoint.new(0.46, Color3.fromRGB(112, 133, 158)),
			ColorSequenceKeypoint.new(0.47, Color3.fromRGB(63, 71, 92)),
			ColorSequenceKeypoint.new(1, Constants.THEME.StageBottom),
		}),
		Rotation = 90,
	})

	local horizon = UiHelpers.create("Frame", {
		Parent = preview,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.42, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = Color3.fromRGB(194, 214, 247),
		BorderSizePixel = 0,
	})
	horizon.BackgroundTransparency = 0.45

	local grid = UiHelpers.create("Frame", {
		Parent = preview,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0.42, 0),
		Size = UDim2.new(1, 0, 0.58, 0),
	})

	for i = 0, 10 do
		local alpha = i / 10
		local y = alpha * 0.92
		local widthPad = math.floor(alpha * 130)
		local line = UiHelpers.create("Frame", {
			Parent = grid,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, y, 0),
			Size = UDim2.new(1, -widthPad, 0, 1),
			BackgroundColor3 = Color3.fromRGB(117, 133, 172),
			BorderSizePixel = 0,
		})
		line.BackgroundTransparency = 0.78
	end

	for i = -6, 6 do
		local x = 0.5 + i * 0.07
		local line = UiHelpers.create("Frame", {
			Parent = grid,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(x, 0, 0, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = Color3.fromRGB(117, 133, 172),
			BorderSizePixel = 0,
			Rotation = i * 5,
		})
		line.BackgroundTransparency = 0.86
	end

	return preview
end

function UiHelpers.buildPropertyRow(parent, labelText)
	local row = UiHelpers.create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 38),
	})

	local label = UiHelpers.create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		Text = labelText,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local value = UiHelpers.create("TextBox", {
		Parent = row,
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		ClearTextOnFocus = false,
		Text = "",
	})
	UiHelpers.styleInput(value)
	UiHelpers.createCorner(value, 8)

	return value, label, row
end

function UiHelpers.buildReadOnlyRow(parent, labelText)
	local row = UiHelpers.create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 38),
	})

	UiHelpers.create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		Text = labelText,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local value = UiHelpers.create("TextLabel", {
		Parent = row,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		Font = Enum.Font.Gotham,
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	UiHelpers.createCorner(value, 8)
	UiHelpers.create("UIPadding", {
		Parent = value,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	return value
end

function UiHelpers.createDropdownMenu(button, options, maxVisibleOptions)
	maxVisibleOptions = maxVisibleOptions or 7
	local visibleCount = math.min(#options, maxVisibleOptions)
	local optionHeight = 28
	local menu = UiHelpers.create("ScrollingFrame", {
		Name = button.Name .. "Menu",
		Parent = button,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 0, 1, 4),
		ScrollBarThickness = #options &gt; maxVisibleOptions and 4 or 0,
		Size = UDim2.new(1, 0, 0, visibleCount * optionHeight + 8),
		Visible = false,
		ZIndex = 40,
	})
	UiHelpers.createCorner(menu, 9)
	UiHelpers.createStroke(menu)
	UiHelpers.createListLayout(menu, 2)
	UiHelpers.create("UIPadding", {
		Parent = menu,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	local optionButtons = {}
	for _, option in ipairs(options) do
		local optionButton = UiHelpers.create("TextButton", {
			Name = option .. "Option",
			Parent = menu,
			AutoButtonColor = true,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			Size = UDim2.new(1, 0, 0, optionHeight - 2),
			Text = option,
			TextColor3 = Constants.THEME.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = false,
			ZIndex = 41,
		})
		UiHelpers.createCorner(optionButton, 7)
		UiMotion.attachButtonEffect(optionButton, {
			hoverScale = 1.015,
			clickScale = 0.96,
		})
		UiHelpers.create("UIPadding", {
			Parent = optionButton,
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		})
		optionButtons[option] = optionButton
	end

	return menu, optionButtons
end

function UiHelpers.updateDropdownOptionHighlight(optionButtons, selectedOption)
	for option, optionButton in pairs(optionButtons or {}) do
		optionButton.BackgroundColor3 = option == selectedOption and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	end
end

return UiHelpers
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX257">
        <Properties>
          <string name="Name">UiMotion</string>
          <ProtectedString name="Source">local TweenService = game:GetService("TweenService")

local UiMotion = {}

local BUTTON_ATTR = "MegMoButtonMotionAttached"
local BUTTON_SCALE_NAME = "MegMoButtonMotionScale"
local POPUP_SCALE_NAME = "MegMoPopupMotionScale"
local activePopupTweens = setmetatable({}, { __mode = "k" })
local popupTokens = setmetatable({}, { __mode = "k" })
local popupBaseStates = setmetatable({}, { __mode = "k" })

local function tween(instance, tweenInfo, goals)
	if not instance then
		return nil
	end
	local ok, result = pcall(function()
		return TweenService:Create(instance, tweenInfo, goals)
	end)
	if ok and result then
		result:Play()
		return result
	end
	return nil
end

local function connect(signal, callback)
	if typeof(signal) ~= "RBXScriptSignal" then
		return nil
	end
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	return ok and connection or nil
end

local function getScale(parent, name)
	if not parent then
		return nil
	end
	local scale = parent:FindFirstChild(name)
	if scale and scale:IsA("UIScale") then
		return scale
	end
	scale = Instance.new("UIScale")
	scale.Name = name
	scale.Scale = 1
	scale.Parent = parent
	return scale
end

local function beginPopupTween(frame)
	local token = (popupTokens[frame] or 0) + 1
	popupTokens[frame] = token

	local activeTweens = activePopupTweens[frame]
	if type(activeTweens) == "table" then
		for _, activeTween in ipairs(activeTweens) do
			pcall(function()
				activeTween:Cancel()
			end)
		end
	elseif activeTweens then
		pcall(function()
			activeTweens:Cancel()
		end)
	end
	activePopupTweens[frame] = nil

	return token
end

local function isCurrentPopupTween(frame, token)
	return frame and popupTokens[frame] == token
end

local function getPopupTarget(frame, options)
	if options and options.target and options.target:IsA("GuiObject") then
		return options.target
	end

	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") and child.Name:match("Card$") then
			return child
		end
	end

	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") and child.AnchorPoint == Vector2.new(0.5, 0.5) then
			return child
		end
	end

	return frame
end

local function scaleSize(size, scaleValue)
	return UDim2.new(
		size.X.Scale * scaleValue,
		size.X.Offset * scaleValue,
		size.Y.Scale * scaleValue,
		size.Y.Offset * scaleValue
	)
end

local function getCenteredPositionForSizeScale(target, basePosition, baseAbsoluteSize, scaleValue)
	if not target or not basePosition or not baseAbsoluteSize then
		return basePosition
	end
	local anchor = target.AnchorPoint
	local offsetX = baseAbsoluteSize.X * (1 - scaleValue) * (0.5 - anchor.X)
	local offsetY = baseAbsoluteSize.Y * (1 - scaleValue) * (0.5 - anchor.Y)
	return UDim2.new(
		basePosition.X.Scale,
		basePosition.X.Offset + offsetX,
		basePosition.Y.Scale,
		basePosition.Y.Offset + offsetY
	)
end

local function getPopupBaseState(target)
	local state = popupBaseStates[target]
	if not state then
		state = {
			size = target.Size,
			position = target.Position,
			absoluteSize = target.AbsoluteSize,
			backgroundTransparency = target.BackgroundTransparency,
			clipsDescendants = target.ClipsDescendants,
		}
		popupBaseStates[target] = state
	end
	return state
end

local function playPopupTween(frame, target, info, goalScale, state)
	local tweens = {}
	local goals = {
		BackgroundTransparency = goalScale &gt;= 1 and state.backgroundTransparency or 1,
		Size = scaleSize(state.size, goalScale),
	}

	if target and target.AnchorPoint ~= Vector2.new(0.5, 0.5) then
		goals.Position = getCenteredPositionForSizeScale(target, state.position, state.absoluteSize, goalScale)
	end

	local popupTween = tween(target, info, goals)
	if popupTween then
		table.insert(tweens, popupTween)
	end
	if #tweens &gt; 0 then
		activePopupTweens[frame] = tweens
		return popupTween or tweens[1]
	end
	return nil
end

local function shouldAttachButton(button)
	if not button or not button:IsA("GuiButton") then
		return false
	end
	if button:GetAttribute(BUTTON_ATTR) or button:GetAttribute("MegMoNoMotion") == true then
		return false
	end
	if button.Name == "ResizeGrip" or button.Name == "InputSink" then
		return false
	end
	if button.Name == "KeyDiamond" or button:GetAttribute("MegMoKeyframeDiamond") == true then
		return false
	end
	return true
end

local function getRadialTargetImageTransparency(imageObject)
	local target = imageObject:GetAttribute("MegMoRadialTargetImageTransparency")
	if target == nil then
		target = imageObject.ImageTransparency
		imageObject:SetAttribute("MegMoRadialTargetImageTransparency", target)
	end
	return target
end

function UiMotion.attachButtonEffect(button, options)
	if not shouldAttachButton(button) then
		return
	end

	options = options or {}
	button:SetAttribute(BUTTON_ATTR, true)

	local scale = getScale(button, BUTTON_SCALE_NAME)
	if not scale then
		return
	end

	local hoverScale = tonumber(options.hoverScale) or 1.035
	local clickScale = tonumber(options.clickScale) or 0.94
	local hoverInfo = TweenInfo.new(tonumber(options.hoverTime) or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local clickInfo = TweenInfo.new(tonumber(options.clickTime) or 0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local resetInfo = TweenInfo.new(tonumber(options.resetTime) or 0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local hovered = false

	connect(button.MouseEnter, function()
		hovered = true
		tween(scale, hoverInfo, { Scale = hoverScale })
	end)
	connect(button.MouseLeave, function()
		hovered = false
		tween(scale, hoverInfo, { Scale = 1 })
	end)
	connect(button.MouseButton1Down, function()
		tween(scale, clickInfo, { Scale = clickScale })
	end)
	connect(button.MouseButton1Up, function()
		tween(scale, resetInfo, { Scale = hovered and hoverScale or 1 })
	end)
end

function UiMotion.popupIn(frame, options)
	if not frame or not frame:IsA("GuiObject") then
		return
	end
	options = options or {}
	local target = getPopupTarget(frame, options)
	local token = beginPopupTween(frame)
	local wasVisible = frame.Visible
	frame.Visible = true
	if target ~= frame then
		target.Visible = true
	end
	local state = getPopupBaseState(target)
	if not wasVisible then
		state.size = target.Size
		state.position = target.Position
		state.absoluteSize = target.AbsoluteSize
		state.backgroundTransparency = target.BackgroundTransparency
		state.clipsDescendants = target.ClipsDescendants
		target.ClipsDescendants = true
		target.Size = scaleSize(state.size, 0)
		target.Position = getCenteredPositionForSizeScale(target, state.position, state.absoluteSize, 0)
		target.BackgroundTransparency = 1
	end
	local info = TweenInfo.new(tonumber(options.time) or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	local tweenObject = playPopupTween(frame, target, info, 1, state)
	if tweenObject then
		connect(tweenObject.Completed, function(playbackState)
			if not isCurrentPopupTween(frame, token) then
				return
			end
			if playbackState == Enum.PlaybackState.Completed then
				activePopupTweens[frame] = nil
				target.Size = state.size
				target.Position = state.position
				target.BackgroundTransparency = state.backgroundTransparency
				target.ClipsDescendants = state.clipsDescendants
			end
		end)
	end
end

function UiMotion.popupOut(frame, options, onComplete)
	if not frame or not frame:IsA("GuiObject") then
		if type(onComplete) == "function" then
			onComplete()
		end
		return
	end

	options = options or {}
	local target = getPopupTarget(frame, options)
	local token = beginPopupTween(frame)
	local info = TweenInfo.new(tonumber(options.time) or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	local state = getPopupBaseState(target)
	state.size = target.Size
	state.position = target.Position
	state.absoluteSize = target.AbsoluteSize
	state.backgroundTransparency = target.BackgroundTransparency
	state.clipsDescendants = target.ClipsDescendants
	target.ClipsDescendants = true
	local finishCalled = false
	local function finish(playbackState)
		if finishCalled then
			return
		end
		if not isCurrentPopupTween(frame, token) then
			return
		end
		if playbackState and playbackState ~= Enum.PlaybackState.Completed then
			return
		end
		finishCalled = true
		activePopupTweens[frame] = nil
		if frame and frame.Parent then
			frame.Visible = false
			if target ~= frame then
				target.Visible = true
			end
			target.Size = state.size
			target.Position = state.position
			target.BackgroundTransparency = state.backgroundTransparency
			target.ClipsDescendants = state.clipsDescendants
		end
		if type(onComplete) == "function" then
			onComplete()
		end
	end

	local tweenObject = playPopupTween(frame, target, info, 0, state)
	if tweenObject then
		connect(tweenObject.Completed, finish)
	else
		finish()
	end
end

function UiMotion.staggerRadialIn(radialMenu, buttons, options)
	if not radialMenu or not radialMenu:IsA("GuiObject") or type(buttons) ~= "table" then
		return
	end

	options = options or {}
	local token = (radialMenu:GetAttribute("MegMoRadialMotionToken") or 0) + 1
	radialMenu:SetAttribute("MegMoRadialMotionToken", token)
	local center = options.center or UDim2.fromOffset(115 - 26, 115 - 26)
	local interval = tonumber(options.interval) or 0.1
	local itemTime = tonumber(options.itemTime) or 0.26
	local tweenInfo = TweenInfo.new(itemTime, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	for index, button in ipairs(buttons) do
		if button and button:IsA("GuiObject") then
			local targetPosition = button:GetAttribute("MegMoRadialTargetPosition") or button.Position
			local targetBackground = button:GetAttribute("MegMoRadialTargetBackgroundTransparency")
			if targetBackground == nil then
				targetBackground = button.BackgroundTransparency
				button:SetAttribute("MegMoRadialTargetBackgroundTransparency", targetBackground)
			end
			button:SetAttribute("MegMoRadialTargetPosition", targetPosition)
			button.Visible = false
			button.Position = center
			button.BackgroundTransparency = 1
			local scale = getScale(button, "MegMoRadialItemScale")
			if scale then
				scale.Scale = 0.45
			end
			for _, child in ipairs(button:GetChildren()) do
				if child:IsA("ImageLabel") or child:IsA("ImageButton") then
					getRadialTargetImageTransparency(child)
					child.ImageTransparency = 1
				end
			end
			task.delay((index - 1) * interval, function()
				if not radialMenu.Parent or not radialMenu.Visible or radialMenu:GetAttribute("MegMoRadialMotionToken") ~= token then
					return
				end
				button.Visible = true
				tween(button, tweenInfo, {
					BackgroundTransparency = targetBackground,
					Position = targetPosition,
				})
				if scale then
					tween(scale, tweenInfo, {
						Scale = 1,
					})
				end
				for _, child in ipairs(button:GetChildren()) do
					if child:IsA("ImageLabel") or child:IsA("ImageButton") then
						tween(child, TweenInfo.new(itemTime * 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							ImageTransparency = getRadialTargetImageTransparency(child) or 0,
						})
					end
				end
			end)
		end
	end
end

function UiMotion.staggerRadialOut(radialMenu, buttons, options, onComplete)
	if not radialMenu or not radialMenu:IsA("GuiObject") or type(buttons) ~= "table" then
		if type(onComplete) == "function" then
			onComplete()
		end
		return
	end

	options = options or {}
	local token = (radialMenu:GetAttribute("MegMoRadialMotionToken") or 0) + 1
	radialMenu:SetAttribute("MegMoRadialMotionToken", token)
	local center = options.center or UDim2.fromOffset(115 - 26, 115 - 26)
	local interval = tonumber(options.interval) or 0.07
	local itemTime = tonumber(options.itemTime) or 0.18
	local tweenInfo = TweenInfo.new(itemTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local lastDelay = 0

	for reverseIndex = #buttons, 1, -1 do
		local button = buttons[reverseIndex]
		local delayTime = (#buttons - reverseIndex) * interval
		lastDelay = math.max(lastDelay, delayTime)
		if button and button:IsA("GuiObject") then
			task.delay(delayTime, function()
				if not radialMenu.Parent or radialMenu:GetAttribute("MegMoRadialMotionToken") ~= token then
					return
				end
				button.Visible = true
				tween(button, tweenInfo, {
					BackgroundTransparency = 1,
					Position = center,
				})
				local scale = getScale(button, "MegMoRadialItemScale")
				if scale then
					tween(scale, tweenInfo, {
						Scale = 0.45,
					})
				end
				for _, child in ipairs(button:GetChildren()) do
					if child:IsA("ImageLabel") or child:IsA("ImageButton") then
						tween(child, TweenInfo.new(itemTime * 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
							ImageTransparency = 1,
						})
					end
				end
			end)
		end
	end

	task.delay(lastDelay + itemTime + 0.02, function()
		if not radialMenu.Parent or radialMenu:GetAttribute("MegMoRadialMotionToken") ~= token then
			return
		end
		if type(onComplete) == "function" then
			onComplete()
		end
	end)
end

function UiMotion.resetRadialItems(radialMenu, buttons)
	if radialMenu and radialMenu:IsA("GuiObject") then
		radialMenu:SetAttribute("MegMoRadialMotionToken", (radialMenu:GetAttribute("MegMoRadialMotionToken") or 0) + 1)
	end
	if type(buttons) ~= "table" then
		return
	end
	for _, button in ipairs(buttons) do
		if button and button:IsA("GuiObject") then
			local targetPosition = button:GetAttribute("MegMoRadialTargetPosition")
			if typeof(targetPosition) == "UDim2" then
				button.Position = targetPosition
			end
			local targetBackground = button:GetAttribute("MegMoRadialTargetBackgroundTransparency")
			if targetBackground ~= nil then
				button.BackgroundTransparency = targetBackground
			end
			local scale = button:FindFirstChild("MegMoRadialItemScale")
			if scale and scale:IsA("UIScale") then
				scale.Scale = 1
			end
			button.Visible = true
			for _, child in ipairs(button:GetChildren()) do
				if child:IsA("ImageLabel") or child:IsA("ImageButton") then
					local targetImageTransparency = child:GetAttribute("MegMoRadialTargetImageTransparency")
					child.ImageTransparency = targetImageTransparency ~= nil and targetImageTransparency or 0
				end
			end
		end
	end
end

return UiMotion
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX258">
        <Properties>
          <string name="Name">ViewportPartSelectService</string>
          <ProtectedString name="Source">local ViewportPartSelectService = {}

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local RigHandleOverlayService = require(script.Parent:WaitForChild("RigHandleOverlayService"))
local RigService = require(script.Parent:WaitForChild("RigService"))
local TrackballDebugService = require(script.Parent:WaitForChild("TrackballDebugService"))

local HOVER_FOLDER_NAME = "MegMoAnimatorViewportPickPreview"
local PHYSICS_PLACEMENT_OWNERSHIP_MARKER_NAME = "MegMoPhysicsStartingPushPlacementOwnership"
local RIG_HANDLE_PATH_ATTRIBUTE = "MegMoRigHandlePath"
local RIG_HANDLE_IS_BONE_ATTRIBUTE = "MegMoRigHandleIsBone"
local HOVER_COLOR = Color3.fromRGB(255, 184, 72)
local HOVER_SURFACE_TRANSPARENCY = 0.94
local SCREEN_PICK_PADDING = 14
local SCREEN_PICK_MAX_DISTANCE = 28
local HEAD_PICK_PADDING = 4
local HEAD_PICK_MAX_DISTANCE = 10
local HEAD_VISUAL_SCALE = Vector3.new(0.72, 0.92, 0.72)
local BONE_JOINT_PICK_MAX_DISTANCE = 18
local BONE_LINK_PICK_MAX_DISTANCE = 16
local R6_TORSO_ARM_OVERRIDE_CORE_INSET = 2

local hoverBox = nil
local headHoverBox = nil
local headHoverProxy = nil
local hoverPath = nil
local hoverPart = nil
local getMousePoint = nil
local isMouseInsideHeadPickRegion = nil
local distanceToRect = nil
local selectionHighlightEnabled = true
local selectionHighlightSuppressed = false

local function hideHoverVisuals()
	if hoverBox then
		hoverBox.Adornee = nil
		hoverBox.Visible = false
	end
	if headHoverBox then
		headHoverBox.Adornee = nil
		headHoverBox.Visible = false
	end
end

local function hasVisibleHoverVisual()
	return (hoverBox and hoverBox.Visible and hoverBox.Adornee ~= nil)
		or (headHoverBox and headHoverBox.Visible and headHoverBox.Adornee ~= nil)
end

local function destroyHoverFolder()
	for _, instance in ipairs(workspace:GetDescendants()) do
		if instance.Name == HOVER_FOLDER_NAME and instance:IsA("Folder") then
			instance:Destroy()
		end
	end
end

destroyHoverFolder()

local function debugLog(...)
	TrackballDebugService.log("ViewportPartSelectService", ...)
end

local function trackballOwnsViewport()
	local folder = CoreGui:FindFirstChild("MegMoAnimatorTrackball")
	if not folder or folder:GetAttribute("OwnsViewport") ~= true then
		return false
	end
	local ignoreUntil = tonumber(folder:GetAttribute("IgnoreViewportPickerUntil")) or 0
	return ignoreUntil &gt;= os.clock()
		or folder:GetAttribute("Active") == true
		or folder:GetAttribute("Sticky") == true
		or folder:GetAttribute("Dragging") == true
end

local function physicsPlacementOwnsViewport()
	local folder = CoreGui:FindFirstChild(PHYSICS_PLACEMENT_OWNERSHIP_MARKER_NAME)
	if not (folder and folder:IsA("Folder")) then
		return false
	end
	if folder:GetAttribute("OwnsViewport") == true then
		return true
	end
	local ignoreUntil = tonumber(folder:GetAttribute("IgnoreViewportPickerUntil")) or 0
	return ignoreUntil &gt;= os.clock()
end

local function isSelectableTorsoRootMotorPick(part, motorData)
	local motor = motorData and motorData.instance
	if not (part and motor and motor.Parent and motor:IsA("Motor6D")) then
		return false
	end
	if motor.Part1 ~= part or not (motor.Part0 and motor.Part0.Name == "HumanoidRootPart") then
		return false
	end
	local rig = motorData.rig or motor:FindFirstAncestorOfClass("Model")
	local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return false
	end
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return part.Name == "Torso"
	end
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return part.Name == "LowerTorso"
	end
	return false
end

local function getMotorPartForPicking(motorData)
	local motor = motorData and motorData.instance
	if not (motor and motor.Parent and motor:IsA("Motor6D")) then
		return nil
	end
	return motor.Part1 or motor.Part0
end

local function findRigHandlePathForInstance(timeline, instance)
	if not (timeline and type(timeline.getMotorByPath) == "function") then
		return nil
	end

	local cursor = instance
	while cursor and cursor ~= workspace do
		local path = cursor:GetAttribute(RIG_HANDLE_PATH_ATTRIBUTE)
		if type(path) == "string" and path ~= "" then
			local motorData = timeline:getMotorByPath(path)
			if motorData then
				return path, instance and instance:IsA("BasePart") and instance or nil, motorData
			end
		end
		cursor = cursor.Parent
	end
	return nil
end

local function shouldIgnoreMotorPart(part, motorData)
	if part and part.Name == "HumanoidRootPart" then
		return true
	end
	if isSelectableTorsoRootMotorPick(part, motorData) then
		return false
	end
	local path = tostring(motorData and motorData.path or "")
	return path:find("HumanoidRootPart/Root", 1, true) ~= nil
end

local function findR6TorsoRootMotorPath(timeline, part)
	if not (timeline and type(timeline.getMotors) == "function" and part and (part.Name == "Torso" or part.Name == "LowerTorso")) then
		return nil
	end
	for _, motorData in ipairs(timeline:getMotors()) do
		if isSelectableTorsoRootMotorPick(part, motorData) then
			return motorData.path, part
		end
	end
	return nil
end

local function getHoverFolder()
	local folder = workspace:FindFirstChild(HOVER_FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = HOVER_FOLDER_NAME
		folder.Archivable = false
		folder.Parent = workspace
	elseif folder.Parent ~= workspace then
		folder.Parent = workspace
	end
	return folder
end

local function isHeadPart(part)
	return part and part:IsA("BasePart") and part.Name == "Head"
end

local function isTorsoScreenPickPart(part)
	return part
		and part:IsA("BasePart")
		and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso")
end

local function isUpperLegPart(part)
	return part
		and part:IsA("BasePart")
		and (part.Name == "RightUpperLeg" or part.Name == "LeftUpperLeg")
end

local function isR6ArmPart(part)
	return part
		and part:IsA("BasePart")
		and (
			part.Name == "Left Arm"
			or part.Name == "Right Arm"
		)
end

local function isR6LegPart(part)
	return part
		and part:IsA("BasePart")
		and (
			part.Name == "Left Leg"
			or part.Name == "Right Leg"
		)
end

local function getHeadVisualHalfSize(part)
	local size = part.Size * HEAD_VISUAL_SCALE
	local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
	if mesh then
		local scale = mesh.Scale
		if scale.X &gt; 0 and scale.Y &gt; 0 and scale.Z &gt; 0 then
			local meshSize = Vector3.new(part.Size.X * scale.X, part.Size.Y * scale.Y, part.Size.Z * scale.Z)
			size = Vector3.new(
				math.min(meshSize.X, part.Size.X * 1.05),
				math.min(meshSize.Y, part.Size.Y * 1.05),
				math.min(meshSize.Z, part.Size.Z * 1.05)
			) * HEAD_VISUAL_SCALE
		end
	end
	return size * 0.5
end

local function setHeadHoverPart(part)
	local folder = getHoverFolder()
	if not headHoverProxy or not headHoverProxy.Parent then
		headHoverProxy = Instance.new("Part")
		headHoverProxy.Name = "ViewportHeadPickProxy"
		headHoverProxy.Archivable = false
		headHoverProxy.Anchored = true
		headHoverProxy.CanCollide = false
		headHoverProxy.CanTouch = false
		headHoverProxy.CanQuery = false
		headHoverProxy.Locked = true
		headHoverProxy.Transparency = 1
		headHoverProxy.Parent = folder
	end
	if not headHoverBox or not headHoverBox.Parent then
		headHoverBox = Instance.new("SelectionBox")
		headHoverBox.Name = "ViewportHeadPickPreview"
		headHoverBox.Archivable = false
		headHoverBox.Color3 = HOVER_COLOR
		headHoverBox.LineThickness = 0.03
		headHoverBox.SurfaceColor3 = HOVER_COLOR
		headHoverBox.SurfaceTransparency = HOVER_SURFACE_TRANSPARENCY
		headHoverBox.Parent = folder
	end
	headHoverProxy.CFrame = part.CFrame
	headHoverProxy.Size = getHeadVisualHalfSize(part) * 2
	headHoverBox.Adornee = headHoverProxy
	headHoverBox.Visible = true
end

local function setHoverPart(part)
	if not selectionHighlightEnabled or selectionHighlightSuppressed then
		hideHoverVisuals()
		return
	end

	if not (part and part.Parent and part:IsA("BasePart")) then
		hideHoverVisuals()
		return
	end

	if isHeadPart(part) then
		if hoverBox then
			hoverBox.Adornee = nil
			hoverBox.Visible = false
		end
		setHeadHoverPart(part)
		return
	end

	if headHoverBox then
		headHoverBox.Adornee = nil
		headHoverBox.Visible = false
	end
	if not hoverBox or not hoverBox.Parent then
		hoverBox = Instance.new("SelectionBox")
		hoverBox.Name = "ViewportPartPickPreview"
		hoverBox.Archivable = false
		hoverBox.Color3 = HOVER_COLOR
		hoverBox.LineThickness = 0.03
		hoverBox.SurfaceColor3 = HOVER_COLOR
		hoverBox.SurfaceTransparency = HOVER_SURFACE_TRANSPARENCY
		hoverBox.Parent = getHoverFolder()
	end

	hoverBox.Adornee = part
	hoverBox.Visible = true
end

function ViewportPartSelectService.clearHover()
	hoverPath = nil
	hoverPart = nil
	if hoverBox then
		hoverBox:Destroy()
		hoverBox = nil
	end
	if headHoverBox then
		headHoverBox:Destroy()
		headHoverBox = nil
	end
	if headHoverProxy then
		headHoverProxy:Destroy()
		headHoverProxy = nil
	end
	destroyHoverFolder()
end

function ViewportPartSelectService.isSelectionHighlightEnabled()
	return selectionHighlightEnabled == true
end

function ViewportPartSelectService.setSelectionHighlightEnabled(isEnabled)
	selectionHighlightEnabled = isEnabled == true
	if not selectionHighlightEnabled then
		hideHoverVisuals()
	end
	return selectionHighlightEnabled
end

function ViewportPartSelectService.setSelectionHighlightSuppressed(isSuppressed)
	selectionHighlightSuppressed = isSuppressed == true
	if selectionHighlightSuppressed then
		hoverPath = nil
		hoverPart = nil
		hideHoverVisuals()
	end
	return selectionHighlightSuppressed
end

function ViewportPartSelectService.isSelectionHighlightSuppressed()
	return selectionHighlightSuppressed == true
end

function ViewportPartSelectService.toggleSelectionHighlight()
	local enabled = ViewportPartSelectService.setSelectionHighlightEnabled(not selectionHighlightEnabled)
	return enabled, enabled and "Selection Highlight enabled." or "Selection Highlight disabled."
end

function ViewportPartSelectService.getHoverCandidate()
	return hoverPath, hoverPart
end

function ViewportPartSelectService.getVisibleHoverCandidate()
	if hasVisibleHoverVisual() then
		return hoverPath, hoverPart
	end
	return nil
end

function ViewportPartSelectService.isAdditiveSelectionActive()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

local function findSelectedPart(selection)
	for _, instance in ipairs(selection or {}) do
		if instance and instance:IsA("BasePart") then
			return instance
		end

		if instance and instance.Parent then
			local part = instance:FindFirstAncestorWhichIsA("BasePart")
			if part then
				return part
			end
		end
	end
	return nil
end

local function collectMotorParts(timeline)
	local parts = {}
	if not (timeline and type(timeline.getMotors) == "function") then
		return parts
	end
	for _, motorData in ipairs(timeline:getMotors()) do
		local part = getMotorPartForPicking(motorData)
		if part and part:IsA("BasePart") and not shouldIgnoreMotorPart(part, motorData) then
			table.insert(parts, part)
		end
	end
	return parts
end

local function findMousePart(timeline, mouse)
	if not mouse then
		return nil
	end

	local mousePoint = getMousePoint(mouse)
	local camera = workspace.CurrentCamera
	local target = mouse.Target
	if target and target:IsA("BasePart") then
		local path = ViewportPartSelectService.findMotorPathForPart(timeline, target)
		if path then
			if isHeadPart(target) and not isMouseInsideHeadPickRegion(camera, mousePoint, target) then
				target = nil
			elseif not isTorsoScreenPickPart(target) then
				return target
			else
				target = nil
			end
		end
	end

	if not mousePoint then
		return nil
	end

	local ok, unitRay = pcall(function()
		return mouse.UnitRay
	end)
	if not ok or typeof(unitRay) ~= "Ray" then
		return nil
	end

	local includeParts = collectMotorParts(timeline)
	if #includeParts == 0 then
		return nil
	end

	local params = RaycastParams.new()
	params.IgnoreWater = true
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = includeParts
	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 10000, params)
	if result and result.Instance and result.Instance:IsA("BasePart") then
		if isHeadPart(result.Instance) and not isMouseInsideHeadPickRegion(camera, mousePoint, result.Instance) then
			return nil
		end
		return result.Instance
	end
	return nil
end

local function getTorsoPickScoreAdjustment(part, mousePoint, minY, maxY)
	if not (part and mousePoint and minY and maxY) then
		return 0
	end
	if part.Name ~= "UpperTorso" and part.Name ~= "LowerTorso" then
		if part.Name == "Torso" then
			return -140
		end
		return 0
	end

	local height = math.max(1, maxY - minY)
	local normalizedY = (mousePoint.Y - minY) / height
	if part.Name == "UpperTorso" then
		if normalizedY &lt;= 0.62 then
			return -140
		end
		return 90
	end
	if normalizedY &gt;= 0.38 then
		return -140
	end
	return 90
end

local function getR6LegPickScoreAdjustment(part)
	if isR6LegPart(part) then
		return -90
	end
	return 0
end

getMousePoint = function(mouse)
	if not mouse then
		return nil
	end

	local x = tonumber(mouse.X)
	local y = tonumber(mouse.Y)
	if not (x and y) then
		return nil
	end
	return Vector2.new(x, y)
end

local function projectPartRect(camera, part)
	if not (camera and part and part.Parent) then
		return nil
	end

	local halfSize = part.Size * 0.5
	local minX = math.huge
	local minY = math.huge
	local maxX = -math.huge
	local maxY = -math.huge
	local nearestDepth = math.huge
	local projected = 0

	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local worldPoint = part.CFrame:PointToWorldSpace(Vector3.new(halfSize.X * sx, halfSize.Y * sy, halfSize.Z * sz))
				local screenPoint = camera:WorldToViewportPoint(worldPoint)
				if screenPoint.Z &gt; 0 then
					projected += 1
					minX = math.min(minX, screenPoint.X)
					minY = math.min(minY, screenPoint.Y)
					maxX = math.max(maxX, screenPoint.X)
					maxY = math.max(maxY, screenPoint.Y)
					nearestDepth = math.min(nearestDepth, screenPoint.Z)
				end
			end
		end
	end

	if projected == 0 then
		return nil
	end

	return minX, minY, maxX, maxY, nearestDepth
end

local function isMouseInsideProjectedPartCore(camera, mousePoint, part, inset)
	local minX, minY, maxX, maxY = projectPartRect(camera, part)
	if not minX then
		return false
	end

	inset = math.max(0, tonumber(inset) or 0)
	if inset &gt; 0 then
		if (maxX - minX) &gt; inset * 2 then
			minX += inset
			maxX -= inset
		end
		if (maxY - minY) &gt; inset * 2 then
			minY += inset
			maxY -= inset
		end
	end

	return mousePoint.X &gt;= minX
		and mousePoint.X &lt;= maxX
		and mousePoint.Y &gt;= minY
		and mousePoint.Y &lt;= maxY
end

local function getProjectedPartCenterDistance(camera, mousePoint, part)
	local minX, minY, maxX, maxY = projectPartRect(camera, part)
	if not minX then
		return nil
	end
	local center = Vector2.new((minX + maxX) * 0.5, (minY + maxY) * 0.5)
	return (mousePoint - center).Magnitude
end

local function shouldR6TorsoOverrideArm(camera, mousePoint, torsoPart, armPart)
	if not isMouseInsideProjectedPartCore(camera, mousePoint, torsoPart, R6_TORSO_ARM_OVERRIDE_CORE_INSET) then
		return false
	end

	local torsoDistance = getProjectedPartCenterDistance(camera, mousePoint, torsoPart)
	local armDistance = getProjectedPartCenterDistance(camera, mousePoint, armPart)
	if not torsoDistance then
		return false
	end
	if not armDistance then
		return true
	end

	return torsoDistance &lt;= armDistance
end

local function projectHeadRect(camera, part)
	if not (camera and part and part.Parent) then
		return nil
	end

	local halfSize = getHeadVisualHalfSize(part)
	local minX = math.huge
	local minY = math.huge
	local maxX = -math.huge
	local maxY = -math.huge
	local nearestDepth = math.huge
	local projected = 0

	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local worldPoint = part.CFrame:PointToWorldSpace(Vector3.new(halfSize.X * sx, halfSize.Y * sy, halfSize.Z * sz))
				local screenPoint = camera:WorldToViewportPoint(worldPoint)
				if screenPoint.Z &gt; 0 then
					projected += 1
					minX = math.min(minX, screenPoint.X)
					minY = math.min(minY, screenPoint.Y)
					maxX = math.max(maxX, screenPoint.X)
					maxY = math.max(maxY, screenPoint.Y)
					nearestDepth = math.min(nearestDepth, screenPoint.Z)
				end
			end
		end
	end

	if projected == 0 then
		return nil
	end

	return minX, minY, maxX, maxY, nearestDepth
end

isMouseInsideHeadPickRegion = function(camera, mousePoint, part)
	local minX, minY, maxX, maxY = projectHeadRect(camera, part)
	if not minX then
		return false
	end
	return distanceToRect(
		mousePoint,
		minX - HEAD_PICK_PADDING,
		minY - HEAD_PICK_PADDING,
		maxX + HEAD_PICK_PADDING,
		maxY + HEAD_PICK_PADDING
	) &lt;= HEAD_PICK_MAX_DISTANCE
end

distanceToRect = function(point, minX, minY, maxX, maxY)
	local dx = 0
	if point.X &lt; minX then
		dx = minX - point.X
	elseif point.X &gt; maxX then
		dx = point.X - maxX
	end

	local dy = 0
	if point.Y &lt; minY then
		dy = minY - point.Y
	elseif point.Y &gt; maxY then
		dy = point.Y - maxY
	end

	return math.sqrt((dx * dx) + (dy * dy))
end

local function distanceToSegment(point, a, b)
	local segment = b - a
	local lengthSquared = segment:Dot(segment)
	if lengthSquared &lt;= 0.0001 then
		return (point - a).Magnitude
	end
	local t = math.clamp((point - a):Dot(segment) / lengthSquared, 0, 1)
	return (point - (a + segment * t)).Magnitude
end

local function getScreenPoint(camera, worldPosition)
	local screenPoint = camera:WorldToViewportPoint(worldPosition)
	if screenPoint.Z &lt;= 0 then
		return nil
	end
	return Vector2.new(screenPoint.X, screenPoint.Y), screenPoint.Z
end

local function findScreenBoneHandlePath(timeline, mouse)
	if not (timeline and type(timeline.getMotors) == "function" and RigHandleOverlayService.isEnabled()) then
		return nil
	end

	local camera = workspace.CurrentCamera
	local mousePoint = getMousePoint(mouse)
	if not (camera and mousePoint) then
		return nil
	end

	local bestPath = nil
	local bestPart = nil
	local bestScore = math.huge
	for _, motorData in ipairs(timeline:getMotors()) do
		if RigService.isBoneJoint(motorData) then
			local bone = motorData.instance
			local okJoint, jointCFrame = pcall(function()
				return RigService.getJointWorldCFrame(motorData)
			end)
			if okJoint and typeof(jointCFrame) == "CFrame" then
				local jointPoint, depth = getScreenPoint(camera, jointCFrame.Position)
				if jointPoint then
					local distance = (mousePoint - jointPoint).Magnitude
					if distance &lt;= BONE_JOINT_PICK_MAX_DISTANCE then
						local score = distance + ((depth or 0) * 0.02)
						if score &lt; bestScore then
							bestScore = score
							bestPath = motorData.path
							bestPart = RigHandleOverlayService.getHandleForPath(motorData.path)
						end
					end
				end

				if bone and bone.Parent and bone:IsA("Bone") then
					local okParent, parentCFrame = pcall(function()
						return RigService.getBoneParentWorldCFrame(bone)
					end)
					if okParent and typeof(parentCFrame) == "CFrame" then
						local parentPoint = getScreenPoint(camera, parentCFrame.Position)
						if jointPoint and parentPoint then
							local distance = distanceToSegment(mousePoint, parentPoint, jointPoint)
							if distance &lt;= BONE_LINK_PICK_MAX_DISTANCE then
								local score = distance + ((depth or 0) * 0.02)
								if score &lt; bestScore then
									bestScore = score
									bestPath = motorData.path
									bestPart = RigHandleOverlayService.getHandleForPath(motorData.path)
								end
							end
						end
					end
				end
			end
		end
	end

	return bestPath, bestPart
end

local function findScreenMotorPath(timeline, mouse)
	if not (timeline and type(timeline.getMotors) == "function") then
		return nil
	end

	local camera = workspace.CurrentCamera
	local mousePoint = getMousePoint(mouse)
	if not (camera and mousePoint) then
		return nil
	end

	local bestPath = nil
	local bestPart = nil
	local bestScore = math.huge

	for _, motorData in ipairs(timeline:getMotors()) do
		local part = getMotorPartForPicking(motorData)
		if part and part:IsA("BasePart") and not shouldIgnoreMotorPart(part, motorData) then
			if isHeadPart(part) then
				local minX, minY, maxX, maxY, depth = projectHeadRect(camera, part)
				if minX then
					minX -= HEAD_PICK_PADDING
					minY -= HEAD_PICK_PADDING
					maxX += HEAD_PICK_PADDING
					maxY += HEAD_PICK_PADDING

					local distance = distanceToRect(mousePoint, minX, minY, maxX, maxY)
					if distance &lt;= HEAD_PICK_MAX_DISTANCE then
						local center = Vector2.new((minX + maxX) * 0.5, (minY + maxY) * 0.5)
						local centerDistance = (mousePoint - center).Magnitude
						local score = (distance * 1000) + centerDistance + ((depth or 0) * 0.02)
						if score &lt; bestScore then
							bestScore = score
							bestPath = motorData.path
							bestPart = part
						end
					end
				end
			else
				local minX, minY, maxX, maxY, depth = projectPartRect(camera, part)
				if minX then
					minX -= SCREEN_PICK_PADDING
					minY -= SCREEN_PICK_PADDING
					maxX += SCREEN_PICK_PADDING
					maxY += SCREEN_PICK_PADDING

					local distance = distanceToRect(mousePoint, minX, minY, maxX, maxY)
					if distance &lt;= SCREEN_PICK_MAX_DISTANCE then
						local center = Vector2.new((minX + maxX) * 0.5, (minY + maxY) * 0.5)
						local centerDistance = (mousePoint - center).Magnitude
						local score = (distance * 1000)
							+ centerDistance
							+ ((depth or 0) * 0.02)
							+ getTorsoPickScoreAdjustment(part, mousePoint, minY, maxY)
							+ getR6LegPickScoreAdjustment(part)
						if score &lt; bestScore then
							bestScore = score
							bestPath = motorData.path
							bestPart = part
						end
					end
				end
			end
		end
	end

	return bestPath, bestPart
end

function ViewportPartSelectService.findMotorPathForPart(timeline, part)
	if not (timeline and type(timeline.getMotors) == "function") then
		return nil
	end

	if not (part and part.Parent) then
		return nil
	end

	local handlePath, handlePart = findRigHandlePathForInstance(timeline, part)
	if handlePath then
		return handlePath, handlePart or part
	end

	local r6TorsoPath, r6TorsoPart = findR6TorsoRootMotorPath(timeline, part)
	if r6TorsoPath then
		return r6TorsoPath, r6TorsoPart
	end

	for _, motorData in ipairs(timeline:getMotors()) do
		local motor = motorData and motorData.instance
		if motor and motor.Parent and motor:IsA("Motor6D") and motor.Part1 == part and not shouldIgnoreMotorPart(part, motorData) then
			return motorData.path, part
		end
	end

	for _, motorData in ipairs(timeline:getMotors()) do
		local motor = motorData and motorData.instance
		if motor and motor.Parent and motor:IsA("Motor6D") and motor.Part0 == part and not shouldIgnoreMotorPart(part, motorData) then
			return motorData.path, part
		end
	end

	return nil
end

function ViewportPartSelectService.findMotorPathForSelection(timeline, selection)
	return ViewportPartSelectService.findMotorPathForPart(timeline, findSelectedPart(selection))
end

function ViewportPartSelectService.findMotorPathForMouse(timeline, mouse)
	local hoveredPart = findMousePart(timeline, mouse)
	local screenPath, screenPart = findScreenMotorPath(timeline, mouse)
	local camera = workspace.CurrentCamera
	local mousePoint = getMousePoint(mouse)
	if screenPath and isTorsoScreenPickPart(screenPart) then
		if hoveredPart == nil
			or hoveredPart == screenPart
			or hoveredPart.Name == "HumanoidRootPart"
			or isUpperLegPart(hoveredPart)
			or isTorsoScreenPickPart(hoveredPart)
			or (
				screenPart.Name == "Torso"
				and isR6ArmPart(hoveredPart)
				and camera
				and mousePoint
				and shouldR6TorsoOverrideArm(camera, mousePoint, screenPart, hoveredPart)
			)
		then
			return screenPath, screenPart
		end
	end

	local path, part = ViewportPartSelectService.findMotorPathForPart(timeline, hoveredPart)
	if path then
		return path, part
	end
	path, part = findScreenBoneHandlePath(timeline, mouse)
	if path then
		return path, part
	end
	if screenPath then
		return screenPath, screenPart
	end
	return findScreenMotorPath(timeline, mouse)
end

function ViewportPartSelectService.bindViewportMouse(options)
	options = options or {}
	local plugin = options.plugin
	local timeline = options.timeline
	local isEnabled = options.isEnabled or function()
		return false
	end
	local getSelectedPath = options.getSelectedPath or function()
		return nil
	end
	local selectPath = options.selectPath or function() end
	local afterSelect = options.afterSelect or function() end
	local afterMiss = options.afterMiss or function() end
	local isAdditiveSelectionActive = options.isAdditiveSelectionActive or ViewportPartSelectService.isAdditiveSelectionActive
	local shouldIgnoreClick = options.shouldIgnoreClick or function()
		return false
	end
	local canSelectRecentHoverWhenDisabled = options.canSelectRecentHoverWhenDisabled or function()
		return false
	end
	local debugEnabled = options.debugEnabled or function()
		return false
	end

	if not (plugin and timeline) then
		return nil
	end

	local ok, mouse = pcall(function()
		return plugin:GetMouse()
	end)
	if not (ok and mouse) then
		return nil
	end

	local connections = {}
	local lastHoverPath = nil
	local lastHoverAt = 0
	local lastValidHoverPath = nil
	local lastValidHoverPart = nil
	local lastValidHoverAt = 0
	local lastClickAt = 0
	local lastClickPath = nil
	local function processClick(sourceLabel)
		if physicsPlacementOwnsViewport() then
			ViewportPartSelectService.clearHover()
			if debugEnabled() then
				debugLog("click ignored: Physics contact placement owns viewport", "source=" .. tostring(sourceLabel))
			end
			return
		end
		local now = os.clock()
		local hasVisibleHover = hoverPath and hasVisibleHoverVisual()
		local hasRecentHover = hasVisibleHover
			or (hoverPath and now - lastHoverAt &lt;= 0.75)
			or (lastValidHoverPath and now - lastValidHoverAt &lt;= 0.75)
		local allowDisabledFallback = sourceLabel == "inputFallback"
			and canSelectRecentHoverWhenDisabled() == true
		if not isEnabled() and not allowDisabledFallback then
			ViewportPartSelectService.clearHover()
			if debugEnabled() then
				debugLog("click ignored: picker disabled", "source=" .. tostring(sourceLabel))
			end
			return
		end

		local path, part = nil, nil
		if hasVisibleHover then
			path = hoverPath
			part = hoverPart
		else
			path, part = ViewportPartSelectService.findMotorPathForMouse(timeline, mouse)
		end
		if not path and hoverPath and now - lastHoverAt &lt;= 0.75 then
			path = hoverPath
			part = hoverPart
		elseif lastValidHoverPath and now - lastValidHoverAt &lt;= 0.75 then
			path = lastValidHoverPath
			part = lastValidHoverPart
		end
		if not path then
			local additive = isAdditiveSelectionActive() == true
			if trackballOwnsViewport() then
				debugLog("empty click ignored: trackball owns viewport", "source=" .. tostring(sourceLabel))
				return
			end
			if shouldIgnoreClick(mouse, nil, additive) then
				debugLog("empty click ignored: active handle", "source=" .. tostring(sourceLabel))
				return
			end
			debugLog("empty click -&gt; afterMiss", "source=" .. tostring(sourceLabel), "additive=" .. tostring(additive))
			afterMiss()
			return
		end

		if lastClickPath == path and now - lastClickAt &lt;= 0.25 then
			if debugEnabled() then
				debugLog("click ignored: duplicate fallback", "source=" .. tostring(sourceLabel), "path=" .. tostring(path))
			end
			return
		end
		lastClickAt = now
		lastClickPath = path

		local additive = isAdditiveSelectionActive() == true
		local ignored = shouldIgnoreClick(mouse, path, additive)
		if ignored then
			debugLog("click ignored: active handle", "path=" .. tostring(path))
			return
		end

		setHoverPart(part)
		if debugEnabled() then
			debugLog(
				"click",
				"source=" .. tostring(sourceLabel),
				"ignored=" .. tostring(ignored),
				"additive=" .. tostring(additive),
				"path=" .. tostring(path),
				"part=" .. tostring(part and part:GetFullName()),
				"target=" .. tostring(mouse.Target and mouse.Target:GetFullName())
			)
		end

		local changed = path ~= getSelectedPath()
		if changed or additive then
			selectPath(path, additive, part)
		end
		ViewportPartSelectService.clearHover()
		if changed or additive then
			afterSelect(path, additive)
		end
	end

	table.insert(connections, mouse.Move:Connect(function()
		if not isEnabled() then
			ViewportPartSelectService.clearHover()
			lastHoverPath = nil
			lastHoverAt = 0
			return
		end
		if selectionHighlightSuppressed then
			hoverPath = nil
			hoverPart = nil
			hideHoverVisuals()
			lastHoverPath = nil
			lastHoverAt = 0
			return
		end

		local path, part = ViewportPartSelectService.findMotorPathForMouse(timeline, mouse)
		lastHoverAt = os.clock()
		if path then
			lastValidHoverPath = path
			lastValidHoverPart = part
			lastValidHoverAt = lastHoverAt
		end
		if path ~= lastHoverPath then
			lastHoverPath = path
			hoverPath = path
			hoverPart = part
			if debugEnabled() then
				debugLog(
					"hover",
					"path=" .. tostring(path),
					"part=" .. tostring(part and part:GetFullName()),
					"target=" .. tostring(mouse.Target and mouse.Target:GetFullName())
				)
			end
		end
		setHoverPart(part)
	end))

	table.insert(connections, mouse.Button1Down:Connect(function()
		processClick("pluginMouse")
	end))

	table.insert(connections, UserInputService.InputBegan:Connect(function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if not hasVisibleHoverVisual()
			and (not hoverPath or os.clock() - lastHoverAt &gt; 0.75)
			and (not lastValidHoverPath or os.clock() - lastValidHoverAt &gt; 0.75)
			and canSelectRecentHoverWhenDisabled() ~= true then
			return
		end
		processClick("inputFallback")
	end))

	return {
		Disconnect = function()
			for _, connection in ipairs(connections) do
				if connection and connection.Disconnect then
					connection:Disconnect()
				end
			end
			ViewportPartSelectService.clearHover()
		end,
	}
end

return ViewportPartSelectService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX259">
        <Properties>
          <string name="Name">ViewportRigPartPickerSupport</string>
          <ProtectedString name="Source">local ViewportRigPartPickerSupport = {}

function ViewportRigPartPickerSupport.isRigTrack(path, timeline)
	local track = path and timeline:getTrackByPath(path)
	if not track then
		return false
	end
	return timeline:getMotorByPath(path) ~= nil
		or track.trackType == "Rig"
		or track.trackType == "Rig Group"
		or track.rigName ~= nil
		or track.parentTrackType == "Rig"
end

function ViewportRigPartPickerSupport.isActive(context)
	if not context.widgetEnabled then
		return false, context.viewportPartPickerArmed
	end
	if context.viewportPartPickerSuspended == true then
		return context.persistentTrackballActive == true, false
	end
	local hasRigs = (context.rigCount or 0) &gt; 0
	if context.rigPartHighlightEnabled == true then
		return true, context.viewportPartPickerArmed
	end
	if context.persistentTrackballActive == true then
		return true, context.viewportPartPickerArmed
	end
	if context.viewportPartPickerArmed == true and hasRigs then
		return true, context.viewportPartPickerArmed
	end
	if context.microWorkspaceActive == true and hasRigs and context.studioSelectionIsActiveRig ~= true then
		return true, true
	end
	if hasRigs and context.studioSelectionIsActiveRig ~= true then
		return true, true
	end
	if ViewportRigPartPickerSupport.isRigTrack(context.selectedJointPath, context.timeline) then
		return true, true
	end
	for path in pairs(context.selectedTrackPaths or {}) do
		if ViewportRigPartPickerSupport.isRigTrack(path, context.timeline) then
			return true, true
		end
	end
	return false, context.viewportPartPickerArmed
end

return ViewportRigPartPickerSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX260">
        <Properties>
          <string name="Name">ViewportSelectionIntentSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local ViewportSelectionIntentSupport = {}

local ADDITIVE_GRACE_SECONDS = 0.35

function ViewportSelectionIntentSupport.markAdditive(widgetController, additive)
	if widgetController and additive == true then
		widgetController._viewportAdditiveSelectionUntil = os.clock() + ADDITIVE_GRACE_SECONDS
	end
end

function ViewportSelectionIntentSupport.isAdditiveActive(widgetController, editorActions)
	local additiveSelection = widgetController
		and type(widgetController._isAdditiveSelectionActive) == "function"
		and widgetController:_isAdditiveSelectionActive() == true
		or (editorActions and editorActions._microMultiSelectLocked == true)
	if not additiveSelection
		and widgetController
		and os.clock() &lt;= (tonumber(widgetController._viewportAdditiveSelectionUntil) or 0)
	then
		additiveSelection = true
	end
	if not additiveSelection then
		additiveSelection = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	end
	ViewportSelectionIntentSupport.markAdditive(widgetController, additiveSelection == true)
	return additiveSelection == true
end

function ViewportSelectionIntentSupport.selectViewportJoint(context)
	context = context or {}
	local path = context.path
	local additive = context.additive == true
	local selectedJointPath = context.selectedJointPath
	local widgetController = context.widgetController
	local editorActions = context.editorActions
	local refreshSelectedGizmo = context.refreshSelectedGizmo

	if path ~= selectedJointPath or additive == true then
		if widgetController then
			widgetController._viewportPartPickerIgnoreDeactivateUntil = os.clock() + ADDITIVE_GRACE_SECONDS
			widgetController._viewportSelectionClick = true
		end
		if editorActions and type(editorActions.selectJoint) == "function" then
			editorActions.selectJoint(path, additive)
		end
		if widgetController then
			widgetController._viewportSelectionClick = nil
		end
	elseif type(refreshSelectedGizmo) == "function" then
		refreshSelectedGizmo()
	end
end

return ViewportSelectionIntentSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX261">
        <Properties>
          <string name="Name">ViewportSelectionSyncSupport</string>
          <ProtectedString name="Source">local ViewportSelectionSyncSupport = {}

function ViewportSelectionSyncSupport.forcePartSelection(widgetController, selectionService, part)
	local function suspendStudioSelectionGuardBriefly()
		if type(selectionService.suspendStudioSelectionGuardFor) == "function" then
			pcall(function()
				selectionService.suspendStudioSelectionGuardFor(0.1)
			end)
			return
		end
		if type(selectionService.setStudioSelectionGuardSuspended) ~= "function" then
			return
		end
		local wasSuspended = type(selectionService.isStudioSelectionGuardSuspended) == "function"
			and selectionService.isStudioSelectionGuardSuspended() == true
		if wasSuspended then
			return
		end
		pcall(function()
			selectionService.setStudioSelectionGuardSuspended(true)
		end)
		task.delay(0.1, function()
			pcall(function()
				selectionService.setStudioSelectionGuardSuspended(false)
			end)
		end)
	end

	local function forceSelection()
		widgetController._suppressViewportSelectionSync = true
		suspendStudioSelectionGuardBriefly()
		pcall(function()
			selectionService.setSelection({ part }, {
				preserveWorkspaceSelection = true,
			})
		end)
		task.defer(function()
			widgetController._suppressViewportSelectionSync = false
		end)
	end

	forceSelection()
	task.defer(forceSelection)
	task.delay(0.05, forceSelection)
end

return ViewportSelectionSyncSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX262">
        <Properties>
          <string name="Name">ViewportToolCleanupService</string>
          <ProtectedString name="Source">local ViewportToolCleanupService = {}

local WORKSPACE_HELPER_NAMES = {
	MegMoAnimatorGizmoProxy = true,
	MegMoAnimatorTrackballProxy = true,
	MegMoAnimatorViewportPickPreview = true,
}

local function destroyWorkspaceHelpers()
	for _, instance in ipairs(workspace:GetDescendants()) do
		if WORKSPACE_HELPER_NAMES[instance.Name] then
			instance:Destroy()
		end
	end
end

function ViewportToolCleanupService.clear(context)
	context = context or {}

	local editorActions = context.editorActions
	if editorActions then
		editorActions._persistentTrackballMode = nil
		editorActions._requestedTrackballMode = nil
		if editorActions._trackballTool then
			pcall(function()
				if type(editorActions._trackballTool.SetSticky) == "function" then
					editorActions._trackballTool:SetSticky(false)
				end
				if type(editorActions._trackballTool.IsActive) ~= "function"
					or editorActions._trackballTool:IsActive() then
					editorActions._trackballTool:Cancel()
				end
			end)
		end
	end

	local gizmoController = context.gizmoController
	if gizmoController then
		pcall(function()
			gizmoController:clearTarget()
			gizmoController:setSuppressed(false)
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(false)
			end
			if type(gizmoController.releaseWorkspaceProxy) == "function" then
				gizmoController:releaseWorkspaceProxy()
			end
		end)
	end

	local modules = context.modules
	if modules then
		pcall(function()
			local viewportPartSelectService = modules:FindFirstChild("ViewportPartSelectService")
			if viewportPartSelectService then
				require(viewportPartSelectService).clearHover()
			end
		end)
		pcall(function()
			require(modules:WaitForChild("RigPartHighlightService")).clear()
		end)
		pcall(function()
			require(modules:WaitForChild("RigHandleOverlayService")).clear()
		end)
	end

	destroyWorkspaceHelpers()
end

return ViewportToolCleanupService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX263">
        <Properties>
          <string name="Name">WidgetBakeProgressSupport</string>
          <ProtectedString name="Source">local WidgetBakeProgressSupport = {}

function WidgetBakeProgressSupport.showBakeProgress(controller, title, detail, progress)
	if not controller._bakeProgressOverlay then
		return false
	end
	if controller._bakeProgressTitle then
		controller._bakeProgressTitle.Text = tostring(title or "Preparing Preview")
	end
	if controller._bakeProgressDetail then
		controller._bakeProgressDetail.Text = tostring(detail or "Building optimized playback data...")
	end
	if controller._bakeProgressFill then
		controller._bakeProgressFill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 1), 0, 1, 0)
	end
	controller._bakeProgressOverlay.Visible = true
	return true
end

function WidgetBakeProgressSupport.updateBakeProgress(controller, progress, detail)
	if not controller._bakeProgressOverlay then
		return false
	end
	if controller._bakeProgressDetail and detail then
		controller._bakeProgressDetail.Text = tostring(detail)
	end
	if controller._bakeProgressFill then
		controller._bakeProgressFill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 1), 0, 1, 0)
	end
	return true
end

function WidgetBakeProgressSupport.hideBakeProgress(controller)
	if controller._bakeProgressOverlay then
		controller._bakeProgressOverlay.Visible = false
	end
end

return WidgetBakeProgressSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX264">
        <Properties>
          <string name="Name">WidgetCameraEditorSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local Constants = require(script.Parent:WaitForChild("Constants"))
local TrackEasingOptionsSupport = require(script.Parent:WaitForChild("TrackEasingOptionsSupport"))
local UiHelpers = require(script.Parent:WaitForChild("UiHelpers"))

local WidgetCameraEditorSupport = {}

function WidgetCameraEditorSupport.hideCameraRotationEditor(controller, restorePreview)
	if restorePreview == true and controller._cameraRotationPreviewBase then
		local camera = workspace.CurrentCamera
		if camera then
			camera.CFrame = controller._cameraRotationPreviewBase.cframe
			camera.Focus = controller._cameraRotationPreviewBase.focus
			camera.FieldOfView = controller._cameraRotationPreviewBase.fieldOfView
			if controller._cameraRotationPreviewBase.cameraType then
				camera.CameraType = controller._cameraRotationPreviewBase.cameraType
			end
		end
	end
	if controller._cameraRotationOverlay then
		controller._cameraRotationOverlay.Visible = false
	end
	controller._cameraRotationPreviewBase = nil
	controller._cameraRotationSeeding = false
	controller._cameraRotationPreviewEnabled = false
	controller._cameraRotationSeedText = nil
end

function WidgetCameraEditorSupport.showCameraRotationEditor(controller, formatNumber)
	if not controller._cameraRotationOverlay then
		return false
	end

	controller._cameraRotationSeeding = true
	controller._cameraRotationPreviewEnabled = false
	local camera = workspace.CurrentCamera
	local xRadians, yRadians, zRadians = 0, 0, 0
	if camera then
		xRadians, yRadians, zRadians = camera.CFrame:ToOrientation()
		local focusDistance = 16
		pcall(function()
			focusDistance = math.max(0.1, (camera.Focus.Position - camera.CFrame.Position).Magnitude)
		end)
		controller._cameraRotationPreviewBase = {
			cframe = camera.CFrame,
			focus = camera.Focus,
			fieldOfView = camera.FieldOfView,
			cameraType = camera.CameraType,
			position = camera.CFrame.Position,
			focusDistance = focusDistance,
		}
	end
	local xText = formatNumber(math.deg(xRadians))
	local yText = formatNumber(math.deg(yRadians))
	local zText = formatNumber(math.deg(zRadians))
	controller._cameraRotationSeedText = {
		x = xText,
		y = yText,
		z = zText,
	}
	if controller._cameraRotationXInput then
		controller._cameraRotationXInput.Text = xText
	end
	if controller._cameraRotationYInput then
		controller._cameraRotationYInput.Text = yText
	end
	if controller._cameraRotationZInput then
		controller._cameraRotationZInput.Text = zText
	end
	controller._cameraRotationSeeding = false
	controller._cameraRotationOverlay.Visible = true
	controller:_setShortcutHint("Camera rotation editor open: type degrees, scroll an axis box to nudge, then OK")
	return true
end

function WidgetCameraEditorSupport.nudgeCameraRotationInput(controller, input, delta, formatNumber)
	if not input then
		return
	end
	controller._cameraRotationPreviewEnabled = true
	local nextValue = (tonumber(input.Text) or 0) + (tonumber(delta) or 0)
	input.Text = formatNumber(nextValue)
	input.CursorPosition = #input.Text + 1
end

function WidgetCameraEditorSupport.previewCameraRotationFromInputs(controller, ensureCameraCanPreviewRoll)
	if controller._cameraRotationSeeding == true then
		return false
	end
	if controller._cameraRotationPreviewEnabled ~= true then
		local seed = controller._cameraRotationSeedText
		local xText = controller._cameraRotationXInput and controller._cameraRotationXInput.Text or ""
		local yText = controller._cameraRotationYInput and controller._cameraRotationYInput.Text or ""
		local zText = controller._cameraRotationZInput and controller._cameraRotationZInput.Text or ""
		if seed and xText == seed.x and yText == seed.y and zText == seed.z then
			return false
		end
		controller._cameraRotationPreviewEnabled = true
	end
	if not (controller._cameraRotationOverlay and controller._cameraRotationOverlay.Visible) then
		return false
	end
	local base = controller._cameraRotationPreviewBase
	local camera = workspace.CurrentCamera
	if not (base and camera) then
		return false
	end

	local x = tonumber(controller._cameraRotationXInput and controller._cameraRotationXInput.Text)
	local y = tonumber(controller._cameraRotationYInput and controller._cameraRotationYInput.Text)
	local z = tonumber(controller._cameraRotationZInput and controller._cameraRotationZInput.Text)
	if not (x and y and z) then
		return false
	end

	local cframe = CFrame.new(base.position) * CFrame.fromOrientation(math.rad(x), math.rad(y), math.rad(z))
	ensureCameraCanPreviewRoll(camera, z)
	camera.CFrame = cframe
	camera.Focus = CFrame.new(cframe.Position + cframe.LookVector * (base.focusDistance or 16))
	return true
end

function WidgetCameraEditorSupport.renderCameraTrackEditor(controller, viewModel, formatNumber)
	if not controller._cameraTrackEditorOverlay then
		return false
	end

	viewModel = viewModel or controller._lastViewModel or {}
	local selectedTrack = nil
	if controller._activeCameraTrackPath and viewModel.tracks then
		for _, track in ipairs(viewModel.tracks) do
			if track.path == controller._activeCameraTrackPath then
				selectedTrack = track
				break
			end
		end
	end

	if controller._cameraTrackEditorItemLabel then
		controller._cameraTrackEditorItemLabel.Text = selectedTrack
			and ("Track: " .. tostring(selectedTrack.name or "Camera"))
			or "Track: Camera"
	end
	if controller._cameraTrackEditorHelpLabel then
		controller._cameraTrackEditorHelpLabel.Text = selectedTrack
			and "Capture the current Studio camera, key FOV, or type a camera rotation. Camera effects live in Effects &gt; Camera Effects."
			or "Select a camera track, then capture the camera, key FOV, or type a rotation."
	end
	if controller._cameraTrackEditorFovInput and UserInputService:GetFocusedTextBox() ~= controller._cameraTrackEditorFovInput then
		local cameraState = viewModel.selectedCameraState or {}
		local fieldOfView = tonumber(cameraState.fieldOfView)
		controller._cameraTrackEditorDefaultFovText = fieldOfView and formatNumber(fieldOfView) or ""
		controller._cameraTrackEditorFovInput.Text = controller._cameraTrackEditorDefaultFovText
	end
	if controller._cameraTrackEditorDurationInput and UserInputService:GetFocusedTextBox() ~= controller._cameraTrackEditorDurationInput then
		controller._cameraTrackEditorDurationInput.PlaceholderText = "Auto"
	end
	if controller._cameraTrackEditorAggressionInput and UserInputService:GetFocusedTextBox() ~= controller._cameraTrackEditorAggressionInput then
		if controller._cameraTrackEditorAggressionInput.Text == "" then
			controller._cameraTrackEditorAggressionInput.Text = "1.00"
		end
	end
	if controller._cameraTrackEditorSmoothnessInput and UserInputService:GetFocusedTextBox() ~= controller._cameraTrackEditorSmoothnessInput then
		if controller._cameraTrackEditorSmoothnessInput.Text == "" then
			controller._cameraTrackEditorSmoothnessInput.Text = "1.00"
		end
	end
	if controller._cameraTrackEditorEasingButton then
		controller._cameraTrackEditorEasingButton.Text = string.format("%s %s", controller._cameraPresetEasingStyle or "Linear", controller._cameraPresetEasingDirection or "InOut")
	end
	if controller._cameraTrackEditorSubjectTrackingButton then
		local trackingOn = controller._cameraPresetSubjectTracking ~= false
		controller._cameraTrackEditorSubjectTrackingButton.Text = trackingOn and "On" or "Off"
		controller._cameraTrackEditorSubjectTrackingButton.BackgroundColor3 = trackingOn and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	end
	local card = controller._cameraTrackEditorOverlay and controller._cameraTrackEditorOverlay:FindFirstChildWhichIsA("Frame")
	if card then
		card.Size = UDim2.new(0, 520, 0, 418)
		local easingFrame = TrackEasingOptionsSupport.ensurePanel(controller, {
			prefix = "cameraTrackEditorKey",
			card = card,
			create = UiHelpers.create,
			createCorner = UiHelpers.createCorner,
			createStroke = UiHelpers.createStroke,
			position = UDim2.new(0, 18, 0, 290),
			size = UDim2.new(1, -36, 0, 68),
			zIndex = 118,
		})
		if easingFrame then
			local easingTitle = easingFrame:FindFirstChildWhichIsA("TextLabel")
			if easingTitle then
				easingTitle.Font = Enum.Font.GothamBold
				easingTitle.TextColor3 = Constants.THEME.Text
				easingTitle.TextSize = 12
			end
		end
		local easingViewModel = viewModel
		local timeline = controller._callbacks and type(controller._callbacks.getTimeline) == "function" and controller._callbacks.getTimeline() or nil
		local activeFrame = controller._activeCameraKeyFrame
			or (timeline and type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or nil)
		if timeline
			and controller._activeCameraTrackPath
			and activeFrame ~= nil
			and type(timeline.getKeyOptions) == "function"
			and (type(timeline.hasTrackKeyframe) ~= "function" or timeline:hasTrackKeyframe(controller._activeCameraTrackPath, activeFrame))
		then
			local ok, keyOptions = pcall(function()
				return timeline:getKeyOptions(controller._activeCameraTrackPath, activeFrame)
			end)
			if ok and type(keyOptions) == "table" then
				easingViewModel = {}
				for key, value in pairs(viewModel or {}) do
					easingViewModel[key] = value
				end
				easingViewModel.selectedKeyOptions = keyOptions
			end
		end
		TrackEasingOptionsSupport.updatePanel(controller, "cameraTrackEditorKey", easingViewModel)
		TrackEasingOptionsSupport.connectPanel(controller, controller._cameraTrackEditorEasingCallbacks or controller._callbacks, "cameraTrackEditorKey", function()
			WidgetCameraEditorSupport.renderCameraTrackEditor(controller, controller._lastViewModel or viewModel, formatNumber)
		end)
	end

	return true
end

return WidgetCameraEditorSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX265">
        <Properties>
          <string name="Name">WidgetCameraFollowOverlaySupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local ThemeService = require(script.Parent:WaitForChild("ThemeService"))

local WidgetCameraFollowOverlaySupport = {}

function WidgetCameraFollowOverlaySupport.applyFollowOverlayState(controller, presetId, modeLabel, helpLabel)
	controller._activeCameraFollowPresetId = presetId
	controller._cameraFollowAngleMode = controller._cameraFollowAngleMode or "Auto"

	if controller._cameraFollowModeLabel then
		controller._cameraFollowModeLabel.Text = modeLabel
	end
	if controller._cameraFollowHelpLabel then
		controller._cameraFollowHelpLabel.Text = helpLabel
	end
	for angleName, button in pairs(controller._cameraFollowAngleButtons or {}) do
		local isActive = angleName == (controller._cameraFollowAngleMode or "Auto")
		button.BackgroundColor3 = isActive and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		button.TextColor3 = Constants.THEME.Text
	end
	if controller._cameraFollowUseSelectionButton then
		controller._cameraFollowUseSelectionButton.Text = presetId == "FirstPerson" and "Attach To Studio Selection" or "Use Studio Selection"
	end
	if controller._cameraFollowUseBoundRigButton then
		controller._cameraFollowUseBoundRigButton.Text = presetId == "FirstPerson" and "Attach To Bound Rig" or "Use Bound Rig"
	end
	if controller._cameraFollowDurationInput and tostring(controller._cameraFollowDurationInput.Text or "") == "" then
		controller._cameraFollowDurationInput.Text = presetId == "Orbit" and "2.4" or ""
	end
	if controller._cameraFollowRadiusInput and tostring(controller._cameraFollowRadiusInput.Text or "") == "" then
		controller._cameraFollowRadiusInput.Text = presetId == "Orbit" and "13" or ""
	end
	if controller._cameraFollowToEndButton then
		controller._cameraFollowToEndButton.Text = controller._cameraFollowDurationToEnd == true and "To End: On" or "To End: Off"
		controller._cameraFollowToEndButton.BackgroundColor3 = controller._cameraFollowDurationToEnd == true and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		controller._cameraFollowToEndButton.TextColor3 = ThemeService.getReadableTextColor(controller._cameraFollowToEndButton.BackgroundColor3)
	end
	if controller._cameraFollowDirectionButton then
		controller._cameraFollowDirectionButton.Text = controller._cameraOrbitDirection or "Clockwise"
	end
	if controller._cameraFollowOverlay then
		controller._cameraFollowOverlay.Visible = true
	end
end

function WidgetCameraFollowOverlaySupport.hideFollowOverlay(controller)
	if controller._cameraFollowOverlay then
		controller._cameraFollowOverlay.Visible = false
	end
	controller._activeCameraFollowPresetId = nil
end

return WidgetCameraFollowOverlaySupport
</ProtectedString>
