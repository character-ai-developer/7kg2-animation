		onEditSelectedGroupsAtPlayhead = deps.onEditSelectedGroupsAtPlayhead or function(...)
			return runEditorAction("editSelectedGroupsAtPlayhead", ...)
		end,
		onReverseSelectedGroups = deps.onReverseSelectedGroups or function(...)
			return runEditorAction("reverseSelectedGroups", ...)
		end,
		onSetSelectedGroupEditMode = deps.onSetSelectedGroupEditMode or function(...)
			return runEditorAction("setSelectedGroupEditMode", ...)
		end,
		onStretchGroupToFrame = deps.onStretchGroupToFrame or function(...)
			return runEditorAction("stretchGroupToFrame", ...)
		end,
		onRepeatGroupToFrame = deps.onRepeatGroupToFrame or function(...)
			return runEditorAction("repeatGroupToFrame", ...)
		end,
		onGroupKeys = function(...)
			return runEditorAction("groupSelectedKeys", ...)
		end,
		onUngroupKeys = function(...)
			return runEditorAction("ungroupSelectedKeys", ...)
		end,
		onAttachSelection = function(...)
			return runEditorAction("attachHandToSelection", ...)
		end,
		onDetachSelection = function(...)
			return runEditorAction("detachAttachedObject", ...)
		end,
		onRecordMotion = function(...)
			return runEditorAction("recordMotion", ...)
		end,
		onToggleWorkspaceGrab = function(...)
			return runEditorAction("toggleWorkspaceGrab", ...)
		end,
		onReleaseWorkspaceGrabFromPluginUi = function(...)
			return runEditorAction("releaseWorkspaceGrabFromPluginUi", ...)
		end,
		onSetGizmoMode = function(...)
			return runEditorAction("setGizmoMode", ...)
		end,
		onResumeViewportRigPartPicker = function(...)
			return runEditorAction("resumeViewportRigPartPicker", ...)
		end,
		onSuspendViewportRigPartPicker = function(...)
			return runEditorAction("suspendViewportRigPartPicker", ...)
		end,
		onBeginMicroViewportCameraNavigation = deps.onBeginMicroViewportCameraNavigation or function(...)
			return runEditorAction("beginMicroViewportCameraNavigation", ...)
		end,
		onEndMicroViewportCameraNavigation = deps.onEndMicroViewportCameraNavigation or function(...)
			return runEditorAction("endMicroViewportCameraNavigation", ...)
		end,
		onViewportRigPartPick = deps.onViewportRigPartPick or function(...)
			return runEditorAction("selectRigPartFromViewportMouse", ...)
		end,
		onIsViewportGizmoPointerOverHandle = deps.onIsViewportGizmoPointerOverHandle or function(...)
			return runEditorAction("isViewportGizmoPointerOverHandle", ...)
		end,
		onIsViewportGizmoDragActive = deps.onIsViewportGizmoDragActive or function(...)
			return runEditorAction("isViewportGizmoDragActive", ...)
		end,
		onHasViewportGizmoTarget = deps.onHasViewportGizmoTarget or function(...)
			return runEditorAction("hasViewportGizmoTarget", ...)
		end,
		onKeepViewportGizmoOwnership = deps.onKeepViewportGizmoOwnership or function(...)
			return runEditorAction("keepViewportGizmoOwnership", ...)
		end,
		onToggleGizmoMode = function(...)
			return runEditorAction("toggleGizmoMode", ...)
		end,
		onToggleRotateSpace = function(...)
			return runEditorAction("toggleRotateSpace", ...)
		end,
		onToggleHideDuringPlayback = function(...)
			return runEditorAction("toggleHideDuringPlayback", ...)
		end,
		onTogglePerformanceDebug = deps.onTogglePerformanceDebug,
		getPerformanceViewModel = deps.getPerformanceViewModel,
		onFpsChanged = deps.onFpsChanged or function(...)
			return runEditorAction("fpsChanged", ...)
		end,
		onDurationChanged = deps.onDurationChanged or function(...)
			return runEditorAction("durationChanged", ...)
		end,
		onLoopingChanged = deps.onLoopingChanged or function(...)
			return runEditorAction("loopingChanged", ...)
		end,
		onPriorityChanged = deps.onPriorityChanged or function(...)
			return runEditorAction("priorityChanged", ...)
		end,
		onMoveSnapChanged = deps.onMoveSnapChanged or function(...)
			return runEditorAction("setMoveSnap", ...)
		end,
		onRotateSnapChanged = deps.onRotateSnapChanged or function(...)
			return runEditorAction("setRotateSnap", ...)
		end,
		onGizmoSizeChanged = deps.onGizmoSizeChanged or function(...)
			return runEditorAction("setGizmoSizePercent", ...)
		end,
		onToggleRigPartHighlight = function(...)
			return runEditorAction("toggleRigPartHighlight", ...)
		end,
		onToggleSelectionHighlight = function(...)
			return runEditorAction("toggleSelectionHighlight", ...)
		end,
		onToggleRigHandles = function(...)
			return runEditorAction("toggleRigHandles", ...)
		end,
		onToggleOnionSkin = deps.onToggleOnionSkin or function(...)
			return runEditorAction("toggleOnionSkin", ...)
		end,
		onBeginTrackballMode = deps.onBeginTrackballMode or function(mode, forcedSelection, trackballOptions)
			if forcedSelection == nil then
				local trackSelection, selectedTrackCount = buildMicroTrackballSelectionFromTracks(deps)
				if trackSelection and trackSelection.paths then
					TrackballDebugService.log(
						"MicroMain",
						"beginTrackballMode",
						"mode=" .. tostring(mode),
						"selectedTracks=" .. tostring(selectedTrackCount),
						"paths=" .. tostring(#trackSelection.paths)
					)
					return runEditorAction("beginTrackballMode", mode, trackSelection, {
						sticky = true,
					})
				end

				local keySelection, selectedKeyCount = buildMicroTrackballSelectionFromKeys(deps)
				TrackballDebugService.log(
					"MicroMain",
					"beginTrackballMode",
					"mode=" .. tostring(mode),
					"selectedTracks=" .. tostring(selectedTrackCount),
					"selectedKeys=" .. tostring(selectedKeyCount),
					keySelection and ("paths=" .. tostring(#keySelection.paths)) or "paths=0"
				)
				if keySelection then
					return runEditorAction("beginTrackballMode", mode, keySelection, {
						sticky = true,
					})
				end
			end
			return runEditorAction("beginTrackballMode", mode, forcedSelection, trackballOptions)
		end,
		onSetTrackballAxis = deps.onSetTrackballAxis or function(...)
			return runEditorAction("setTrackballAxis", ...)
		end,
		onGetTrackballAxis = deps.onGetTrackballAxis or function(...)
			return runEditorAction("getTrackballAxis", ...)
		end,
		onEditorAction = function(actionName, ...)
			return runEditorAction(actionName, ...)
		end,
	}

	editorActions._microOptions = options

	local ok, controllerOrMessage = pcall(function()
		return MicroWidgetController.attach(options)
	end)
	if not ok then
		warn("[7kg2 Micro] Could not attach Micro workspace: " .. tostring(controllerOrMessage))
		return nil
	end

	return controllerOrMessage
end

function MicroMain.bindImportActions(editorActions, deps)
	editorActions = editorActions or {}
	deps = deps or {}
	local options = editorActions._microOptions
	if type(options) ~= "table" then
		return
	end

	options.onSaveAnimation = deps.saveAnimation
	options.onExportAnimation = function(...)
		return deps.exportAnimation(options._microGui, ...)
	end
	options.onImportAnimationId = deps.importAnimationId
	options.onImportSelectedAnimation = deps.importSelectedAnimation
	options.onLoadSavedProjects = deps.loadSavedProjects
	options.onLoadMyAnimations = deps.loadMyAnimations
	options.onLoadMoreMyAnimations = deps.loadMoreMyAnimations
	options.onLoadPresetAnimations = deps.loadPresetAnimations
	options.onLoadBulkKeyframeSequences = deps.loadBulkKeyframeSequences
	options.onSearchMarketplaceAnimations = deps.searchMarketplaceAnimations
	options.onSearchMyAnimations = deps.searchMyAnimations
	options.onImportBulkKeyframeSequence = deps.importBulkKeyframeSequence
	options.onOpenR15ToR6Converter = deps.openR15ToR6Converter
	options.onOpenSavedProject = deps.openSavedProject
	options.onImportSavedProjectToSelectedRig = deps.importSavedProjectOntoSelectedRig
	options.onGetImportEntries = deps.getImportEntries
	options.onGetImportBrowserStatus = deps.getImportBrowserStatus
	options.getImportEntries = deps.getImportEntries
	options.getImportBrowserStatus = deps.getImportBrowserStatus
	options.onValidateCutscene = deps.validateCutscene
	options.onGenerateCutscene = deps.generateCutscene
	options.onNewAnimation = deps.newAnimation or options.onNewAnimation
	options.onSaveAndNewAnimation = deps.saveAndNewAnimation or options.onSaveAndNewAnimation
	options.onSelectTheme = deps.selectTheme or options.onSelectTheme
	options.onTogglePerformanceDebug = deps.togglePerformanceDebug or options.onTogglePerformanceDebug
	options.getPerformanceViewModel = deps.getPerformanceViewModel or options.getPerformanceViewModel
	options.onOpenMotionRecipeManager = deps.openMotionRecipeManager or options.onOpenMotionRecipeManager
	options.onSaveMotionRecipe = deps.saveMotionRecipe or options.onSaveMotionRecipe
	options.onLoadMotionRecipe = deps.loadMotionRecipe or options.onLoadMotionRecipe
	options.onRenameMotionRecipe = deps.renameMotionRecipe or options.onRenameMotionRecipe
	options.onDeleteMotionRecipe = deps.deleteMotionRecipe or options.onDeleteMotionRecipe
end

return MicroMain
