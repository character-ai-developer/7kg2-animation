		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(1, -58, 0, 14),
		Size = UDim2.new(0, 76, 0, 32),
		Text = "Hide UI",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextStrokeTransparency = 1,
		ZIndex = 131,
	})
	UiHelpers.createCorner(hideUiButton, 9)

	local controls = create("Frame", {
