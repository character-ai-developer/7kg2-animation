        <Properties>
          <string name="Name">ResetPoseActionService</string>
          <ProtectedString name="Source">local ResetPoseActionService = {}

function ResetPoseActionService.reset(timeline, changeHistoryService, refreshUi)
	if not timeline then
		return
	end

	local tracks = timeline:getTracks()
	if #tracks == 0 then
		refreshUi("Add a rig, object, camera, or effect before resetting.")
		return
	end

	changeHistoryService:SetWaypoint("Before Reset Animation State")
	local success, appliedCount = timeline:resetOriginalState()
	changeHistoryService:SetWaypoint("After Reset Animation State")

	if success then
		refreshUi(string.format("Restored %d track%s to their original state.", appliedCount or 0, appliedCount == 1 and "" or "s"))
	else
		refreshUi("Could not restore any original track state.")
	end
end

return ResetPoseActionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX209">
        <Properties>
          <string name="Name">RigBindingActionSupport</string>
          <ProtectedString name="Source">local RigBindingActionSupport = {}

function RigBindingActionSupport.addRigModel(args)
	local rig = args.rig
	if not rig or not rig.Parent then
		return false, "That rig is no longer available."
	end
	if type(args.prepareRigForBinding) == "function" then
		args.prepareRigForBinding(rig)
	end

	local rigData = args.rigService.describeRig(rig)
	if #rigData.motors == 0 then
		return false, "That model does not contain any animatable joints or bones."
	end

	local success, addMessage = args.timeline:addRig(rig, rigData)
	if not success then
		return false, addMessage
	end
	args.rigWorkspaceLockService.lockRig(rig)
	if args.onAdded then
		args.onAdded(rig, rigData)
	end
	return true, args.message or addMessage or string.format("Added rig '%s' with %d joints.", rig.Name, #rigData.motors)
end

function RigBindingActionSupport.addSelectedRigs(args)
	local selectedRigs = args.selectionService.getSelectedRigs()
	if #selectedRigs == 0 and args.allowLastSelection == true and type(args.selectionService.getLastSelectedRigs) == "function" then
		selectedRigs = args.selectionService.getLastSelectedRigs()
	end
	if #selectedRigs == 0 then
		return false, "Select one or more rig models that contain animatable joints or bones."
	end
	if type(args.prepareRigForBinding) == "function" then
		for _, rig in ipairs(selectedRigs) do
			args.prepareRigForBinding(rig)
		end
	end

	local validRigs, existingRigInstances, duplicateNameMessage = args.validationSupport.collectValidSelectedRigs(
		args.timeline,
		args.rigService,
		selectedRigs,
		function(rig, rigs)
			return args.hasWorkspaceRigNameConflict(rig, rigs)
		end
	)
	if duplicateNameMessage then
		if args.showDuplicateNameAlert then
			args.showDuplicateNameAlert(duplicateNameMessage)
		end
		return false, duplicateNameMessage
	end

	if #validRigs == 0 then
		return false, "The selected models do not contain any animatable joints or bones."
	end

	args.pushUndo(#validRigs == 1 and "Add Selected Rig" or "Add Selected Rigs")
	args.changeHistoryService:SetWaypoint("Before Add Selected Rigs")
	local addedCount = 0
	local activeRig = nil
	local totalJoints = 0
	for _, entry in ipairs(validRigs) do
		local added = false
		if entry.alreadyBound then
			added = args.useExistingRig(entry)
		else
			added = args.addRigModel(entry.rig)
		end
		if added then
			activeRig = entry.rig
			addedCount += 1
			totalJoints += #entry.rigData.motors
		end
	end
	args.changeHistoryService:SetWaypoint("After Add Selected Rigs")

	if addedCount == 0 then
		args.discardPendingUndo()
		return false, "No selected rigs could be added."
	end

	local message
	if activeRig and existingRigInstances[activeRig] then
		message = string.format("Using rig '%s' for Motion Builder.", activeRig.Name)
	else
		message = string.format("Added %d rig%s with %d total joints.", addedCount, addedCount == 1 and "" or "s", totalJoints)
	end
	return true, message
end

return RigBindingActionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX210">
        <Properties>
          <string name="Name">RigHandleOverlayService</string>
          <ProtectedString name="Source">local RigHandleOverlayService = {}

local RunService = game:GetService("RunService")
local BoneSkeletonOverlayService = require(script.Parent:WaitForChild("BoneSkeletonOverlayService"))
local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))
local RigService = require(script.Parent:WaitForChild("RigService"))

local FOLDER_NAME = "MegMoAnimatorRigHandles"
local HANDLE_PATH_ATTRIBUTE = "MegMoRigHandlePath"
local HANDLE_IS_BONE_ATTRIBUTE = "MegMoRigHandleIsBone"
local HANDLE_COLOR = Color3.fromRGB(224, 148, 72)
local MIN_HANDLE_WIDTH = 0.22
local MAX_HANDLE_WIDTH = 0.7
local MIN_HANDLE_HEIGHT = 0.2
local MAX_HANDLE_HEIGHT = 0.55
local MIN_HANDLE_DEPTH = 0.28
local MAX_HANDLE_DEPTH = 0.58

local enabled = false
local handlesByPath = {}
local activeFolders = {}
local activeTimeline = nil
local heartbeatConnection = nil
local isRefreshing = false
local selectionCallbacks = {}

local function sanitizeName(value)
	return string.gsub(tostring(value or "Handle"), "[^%w_]+", "_")
end

local function getRigFolder(motorData)
	local rig = motorData and motorData.rig
	local parent = rig and rig.Parent and rig or workspace
	local folder = parent:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Archivable = false
		folder.Parent = parent
	end
	activeFolders[folder] = true
	return folder
end

local function getMotorPart(motorData)
	local motor = motorData and motorData.instance
	if not (motor and motor:IsA("Motor6D")) then
		return nil
	end
	local part = motor.Part1
	if part and part.Parent and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function getJointCFrame(motorData)
	local motor = motorData and motorData.instance
	if motor and motor.Parent and motor:IsA("Motor6D") and motor.Part0 then
		return motor.Part0.CFrame * motor.C0
	end

	if motor and motor.Parent and motor:IsA("Bone") then
		return RigService.getJointWorldCFrame(motorData)
	end

	local part = getMotorPart(motorData)
	if part then
		return part.CFrame
	end

	return nil
end

local function clampNumber(value, minValue, maxValue)
	return math.max(minValue, math.min(maxValue, value))
end

local function getHandleCFrame(motorData)
	local part = getMotorPart(motorData)
	if part then
		return part.CFrame
	end
	return getJointCFrame(motorData)
end

local function getHandleSize(motorData)
	local part = getMotorPart(motorData)
	if part then
		local partName = string.lower(part.Name)
		local widthScale = 0.42
		local heightScale = 0.32
		if string.find(partName, "hand") or string.find(partName, "foot") then
			widthScale = 0.5
			heightScale = 0.45
		elseif string.find(partName, "head") or string.find(partName, "torso") or string.find(partName, "root") then
			widthScale = 0.48
			heightScale = 0.28
		end

		return Vector3.new(
			clampNumber(part.Size.X * widthScale, MIN_HANDLE_WIDTH, MAX_HANDLE_WIDTH),
			clampNumber(part.Size.Y * heightScale, MIN_HANDLE_HEIGHT, MAX_HANDLE_HEIGHT),
			clampNumber(part.Size.Z * 0.38, MIN_HANDLE_DEPTH, MAX_HANDLE_DEPTH)
		)
	end
	return Vector3.new(0.36, 0.36, MIN_HANDLE_DEPTH)
end

local function addHighlight(proxy)
	local highlight = Instance.new("Highlight")
	highlight.Name = "HandleHighlight"
	highlight.Adornee = proxy
	highlight.Archivable = false
	highlight.FillColor = HANDLE_COLOR
	highlight.OutlineColor = Color3.fromRGB(255, 202, 132)
	highlight.FillTransparency = 0.34
	highlight.OutlineTransparency = 0.08
	pcall(function()
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	end)
	highlight.Parent = proxy
end

local function tagHandlePart(part, path, isBone)
	part:SetAttribute(HANDLE_PATH_ATTRIBUTE, tostring(path or ""))
	part:SetAttribute(HANDLE_IS_BONE_ATTRIBUTE, isBone == true)
end

local function clearLegacyBoneHandles()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant.Name == FOLDER_NAME and descendant:IsA("Folder") then
			for _, child in ipairs(descendant:GetChildren()) do
				if child:GetAttribute(HANDLE_IS_BONE_ATTRIBUTE) == true or string.sub(child.Name, 1, 13) == "RigBoneJoint_" then
					child:Destroy()
				end
			end
			if #descendant:GetChildren() == 0 then
				activeFolders[descendant] = nil
				descendant:Destroy()
			end
		end
	end
end

local function createHandle(path, motorData)
	local proxy = Instance.new("Part")
	proxy.Name = "RigHandle_" .. sanitizeName(path)
	proxy.Archivable = false
	proxy.Anchored = true
	proxy.CanCollide = false
	proxy.CanQuery = false
	proxy.CanTouch = false
	proxy.Color = HANDLE_COLOR
	proxy.Material = Enum.Material.SmoothPlastic
	proxy.Size = getHandleSize(motorData)
	proxy.Transparency = 0.22
	tagHandlePart(proxy, path, false)
	proxy.Parent = getRigFolder(motorData)

	addHighlight(proxy)
	handlesByPath[path] = proxy
	return proxy
end

local function updateHandles(timeline)
	if isRefreshing then
		return
	end
	isRefreshing = true

	local perfToken = PerformanceDebugService.begin("Rig Handles Refresh")
	local motorCount = 0
	local motorHandleCount = 0
	local hasBoneJoints = false
	local ok, err = pcall(function()
		if timeline and type(timeline.syncRigMotorsFromWorkspace) == "function" then
			pcall(function()
				timeline:syncRigMotorsFromWorkspace({
					bonesOnly = true,
				})
			end)
		end

		local motors = timeline and timeline.getMotors and timeline:getMotors() or {}
		motorCount = #motors
		local seen = {}
		for _, motorData in ipairs(motors) do
			local path = tostring(motorData.path or "")
			local isBone = RigService.isBoneJoint(motorData)
			if isBone then
				hasBoneJoints = true
			else
				local cframe = getHandleCFrame(motorData)
				if path ~= "" and cframe then
					local proxy = handlesByPath[path]
					if proxy and proxy:GetAttribute(HANDLE_IS_BONE_ATTRIBUTE) ~= isBone then
						proxy:Destroy()
						proxy = nil
						handlesByPath[path] = nil
					end
					proxy = proxy or createHandle(path, motorData)
					proxy.Size = getHandleSize(motorData)
					proxy.CFrame = cframe
					tagHandlePart(proxy, path, false)
					seen[path] = true
					motorHandleCount += 1
				end
			end
		end

		if hasBoneJoints then
			clearLegacyBoneHandles()
			BoneSkeletonOverlayService.refresh(timeline)
		else
			BoneSkeletonOverlayService.clear()
		end

		for path, proxy in pairs(handlesByPath) do
			if not seen[path] then
				handlesByPath[path] = nil
				if proxy and proxy.Parent then
					proxy:Destroy()
				end
			end
		end
	end)
	if not ok then
		warn("[7kg2 Rig Handles] Could not update handles:", err)
	end
	PerformanceDebugService.finish(perfToken, string.format("%d motors, %d motor handles, bones=%s", motorCount, motorHandleCount, tostring(hasBoneJoints)))

	isRefreshing = false
end

local function stopHeartbeat()
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end

local function startHeartbeat()
	if heartbeatConnection then
		return
	end
	heartbeatConnection = RunService.Heartbeat:Connect(function()
		if enabled and activeTimeline then
			updateHandles(activeTimeline)
		end
	end)
end

function RigHandleOverlayService.clear()
	activeTimeline = nil
	stopHeartbeat()
	BoneSkeletonOverlayService.clear()
	for path, proxy in pairs(handlesByPath) do
		handlesByPath[path] = nil
		if proxy and proxy.Parent then
			proxy:Destroy()
		end
	end

	for folder in pairs(activeFolders) do
		if folder and folder.Parent then
			folder:Destroy()
		end
	end
	table.clear(activeFolders)

	local workspaceFolder = workspace:FindFirstChild(FOLDER_NAME)
	if workspaceFolder then
		workspaceFolder:Destroy()
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant.Name == FOLDER_NAME and descendant:IsA("Folder") then
			descendant:Destroy()
		end
	end
end

function RigHandleOverlayService.setEnabled(isEnabled)
	enabled = isEnabled == true
	if not enabled then
		activeTimeline = nil
		stopHeartbeat()
		RigHandleOverlayService.clear()
	end
	return enabled
end

function RigHandleOverlayService.isEnabled()
	return enabled == true
end

function RigHandleOverlayService.toggle()
	return RigHandleOverlayService.setEnabled(not enabled)
end

function RigHandleOverlayService.refresh(timeline)
	if not enabled then
		activeTimeline = nil
		stopHeartbeat()
		RigHandleOverlayService.clear()
		return
	end

	activeTimeline = timeline
	startHeartbeat()
	updateHandles(timeline)
end

function RigHandleOverlayService.refreshIfEnabled(timeline)
	if enabled then
		RigHandleOverlayService.refresh(timeline)
	end
end

function RigHandleOverlayService.setSelectionCallbacks(callbacks)
	selectionCallbacks = callbacks or {}
	BoneSkeletonOverlayService.setSelectionCallbacks(selectionCallbacks)
end

function RigHandleOverlayService.getHandleForPath(path)
	local proxy = handlesByPath[tostring(path or "")]
	if proxy and proxy.Parent and proxy:IsA("BasePart") then
		return proxy
	end
	return nil
end

return RigHandleOverlayService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX211">
        <Properties>
          <string name="Name">RigInsertDependencySupport</string>
          <ProtectedString name="Source">local RigInsertDependencySupport = {}

function RigInsertDependencySupport.getRigInsertCFrame(camera)
	if camera then
		local position = camera.CFrame.Position + camera.CFrame.LookVector * 12
		return CFrame.new(Vector3.new(math.floor(position.X + 0.5), 3, math.floor(position.Z + 0.5)))
	end
	return CFrame.new(0, 3, 0)
end

function RigInsertDependencySupport.buildDeps(getRigInsertCFrame, refreshUi, selectionService)
	return {
		getRigInsertCFrame = getRigInsertCFrame,
		refreshUi = refreshUi,
		selectionService = selectionService,
	}
end

return RigInsertDependencySupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX212">
        <Properties>
          <string name="Name">RigInsertService</string>
          <ProtectedString name="Source">local ChangeHistoryService = {
	SetWaypoint = function() end,
}
local ContentProvider = game:GetService("ContentProvider")
local InsertService = game:GetService("InsertService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local RigInsertService = {}

local DEFAULT_RIG_LIMB_COLOR = Color3.fromRGB(127, 127, 127)
local DEFAULT_RIG_TORSO_COLOR = Color3.fromRGB(98, 37, 209)
local DEFAULT_FACE_TEXTURE = "rbxasset://textures/face.png"
local DEFAULT_RIG_APPEARANCE_CLASSIC = "Classic"
local DEFAULT_RIG_APPEARANCE_MODERN = "Modern"
local CLASSIC_HEAD_SIZE = Vector3.new(2, 1, 1)
local CLASSIC_HEAD_MESH_SCALE = Vector3.new(1.25, 1.25, 1.25)
local CLASSIC_HEAD_NECK_CFRAME = CFrame.new(0, -0.5, 0)
local CUSTOM_HEAD_CLASSIC_SIZE_SCALE = 0.9
local DEFAULT_R6_MATCHED_R15_HEIGHT = 5.282
local RANDOM_AVATAR_MIN_USER_ID = 1000
local RANDOM_AVATAR_MAX_USER_ID = 9000000000
local RANDOM_AVATAR_RETRY_COUNT = 30

local randomAvatarRng = Random.new()
local randomAvatarState = {
	userId = nil,
	userName = nil,
	description = nil,
	usedRigFamilies = {},
}

local function getUniqueWorkspaceName(baseName)
	baseName = tostring(baseName or "Rig")
	if not workspace:FindFirstChild(baseName) then
		return baseName
	end

	local index = 2
	while workspace:FindFirstChild(baseName .. " " .. tostring(index)) do
		index += 1
	end
	return baseName .. " " .. tostring(index)
end

local function getDefaultRigPartColor(partName)
	if partName == "Torso" or partName == "UpperTorso" or partName == "LowerTorso" then
		return DEFAULT_RIG_TORSO_COLOR
	end
	return DEFAULT_RIG_LIMB_COLOR
end

local function createDefaultRigDescription()
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = DEFAULT_RIG_LIMB_COLOR
	description.TorsoColor = DEFAULT_RIG_TORSO_COLOR
	description.LeftArmColor = DEFAULT_RIG_LIMB_COLOR
	description.RightArmColor = DEFAULT_RIG_LIMB_COLOR
	description.LeftLegColor = DEFAULT_RIG_LIMB_COLOR
	description.RightLegColor = DEFAULT_RIG_LIMB_COLOR
	description.Face = 144075659
	return description
end

local function isDefaultAppearanceObject(instance)
	local className = instance.ClassName
	return className == "FaceControls"
		or className == "SurfaceAppearance"
		or className == "WrapLayer"
		or className == "WrapTarget"
		or className == "Shirt"
		or className == "Pants"
		or className == "ShirtGraphic"
		or className == "Accessory"
		or className == "CharacterMesh"
end

local function createClassicHeadAttachments(head, forceClassicCFrames)
	local attachments = {
		FaceCenterAttachment = CFrame.new(0, 0, 0),
		FaceFrontAttachment = CFrame.new(0, 0, -0.5),
		HairAttachment = CFrame.new(0, 0.5, 0),
		HatAttachment = CFrame.new(0, 0.5, 0),
		NeckRigAttachment = CFrame.new(0, -0.5, 0),
	}

	for attachmentName, attachmentCFrame in pairs(attachments) do
		local existing = head:FindFirstChild(attachmentName)
		if existing and existing:IsA("Attachment") then
			if forceClassicCFrames then
				existing.CFrame = attachmentCFrame
			end
			continue
		end
		local attachment = Instance.new("Attachment")
		attachment.Name = attachmentName
		attachment.CFrame = attachmentCFrame
		attachment.Parent = head
	end
end

local function getDescriptionFaceTexture(description)
	if not description then
		return nil
	end

	local faceId = nil
	pcall(function()
		faceId = description.Face
	end)
	faceId = tonumber(faceId)
	if faceId and faceId &gt; 0 then
		return "rbxassetid://" .. tostring(math.floor(faceId))
	end
	return nil
end

local function getTextureLikeProperty(instance, propertyName)
	local ok, value = pcall(function()
		return instance[propertyName]
	end)
	if ok and value ~= nil then
		local text = tostring(value)
		if text ~= "" then
			return text
		end
	end
	return nil
end

local function findTextureInContainer(container)
	if not container then
		return nil
	end

	for _, descendant in ipairs(container:GetDescendants()) do
		if descendant:IsA("Decal") or descendant:IsA("Texture") then
			local texture = getTextureLikeProperty(descendant, "Texture")
				or getTextureLikeProperty(descendant, "TextureContent")
				or getTextureLikeProperty(descendant, "ColorMapContent")
			if texture then
				return texture
			end
		elseif descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
			local image = getTextureLikeProperty(descendant, "Image")
			if image then
				return image
			end
		elseif descendant:IsA("SurfaceAppearance") then
			local colorMap = getTextureLikeProperty(descendant, "ColorMap")
			if colorMap then
				return colorMap
			end
		end
	end

	return nil
end

local function resolveFaceAssetTexture(faceTexture)
	local faceId = tostring(faceTexture or ""):match("%d+")
	if not faceId then
		return faceTexture
	end

	local success, assetModel = pcall(function()
		return InsertService:LoadAsset(tonumber(faceId))
	end)
	if not success or not assetModel then
		return faceTexture
	end

	local resolvedTexture = findTextureInContainer(assetModel) or faceTexture
	assetModel:Destroy()
	return resolvedTexture
end

local function getHeadFaceTexture(head)
	if not head then
		return nil
	end

	for _, child in ipairs(head:GetChildren()) do
		if child:IsA("Decal") and child.Face == Enum.NormalId.Front and tostring(child.Texture or "") ~= "" then
			return child.Texture
		end
	end
	local face = head:FindFirstChild("face")
	if face and face:IsA("Decal") and tostring(face.Texture or "") ~= "" then
		return face.Texture
	end
	local nestedTexture = findTextureInContainer(head)
	if nestedTexture then
		return nestedTexture
	end
	return nil
end

local function getBodyColorsHeadColor(rig)
	local bodyColors = rig and rig:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		local ok, color = pcall(function()
			return bodyColors.HeadColor3
		end)
		if ok and typeof(color) == "Color3" then
			return color
		end
	end
	return nil
end

local function getDirectRigBasePart(rig, partName)
	local child = rig and rig:FindFirstChild(partName)
	if child and child:IsA("BasePart") then
		return child
	end
	return nil
end

local function getHeadSpecialMesh(head)
	if not head then
		return nil
	end
	for _, child in ipairs(head:GetChildren()) do
		if child:IsA("SpecialMesh") then
			return child
		end
	end
	return nil
end

local function getClassicHeadReplacementCFrame(oldHead)
	if not oldHead then
		return CFrame.new()
	end

	local oldNeckAttachment = oldHead:FindFirstChild("NeckRigAttachment")
	local oldNeckWorldCFrame = oldNeckAttachment and oldNeckAttachment:IsA("Attachment")
		and oldNeckAttachment.WorldCFrame
		or oldHead.CFrame * CLASSIC_HEAD_NECK_CFRAME
	return oldNeckWorldCFrame * CLASSIC_HEAD_NECK_CFRAME:Inverse()
end

local function isClassicHeadSpecialMesh(mesh)
	if not mesh then
		return true
	end
	local meshId = tostring(mesh.MeshId or "")
	return mesh.MeshType == Enum.MeshType.Head and meshId == ""
end

local function isNormalClassicHeadPart(head)
	return head
		and head:IsA("Part")
		and isClassicHeadSpecialMesh(getHeadSpecialMesh(head))
end

local function descriptionHasCustomHeadAsset(description)
	if not description then
		return false
	end

	local headAssetId = nil
	pcall(function()
		headAssetId = description.Head
	end)
	headAssetId = tonumber(headAssetId)
	return headAssetId ~= nil and headAssetId &gt; 0
end

local function getCustomClassicHeadSize(oldHead)
	if not (oldHead and oldHead:IsA("BasePart")) then
		return CLASSIC_HEAD_SIZE
	end

	local size = oldHead.Size * CUSTOM_HEAD_CLASSIC_SIZE_SCALE
	return Vector3.new(
		math.clamp(size.X, CLASSIC_HEAD_SIZE.X * 0.9, CLASSIC_HEAD_SIZE.X * 1.35),
		math.clamp(size.Y, CLASSIC_HEAD_SIZE.Y * 0.9, CLASSIC_HEAD_SIZE.Y * 1.35),
		math.clamp(size.Z, CLASSIC_HEAD_SIZE.Z * 0.9, CLASSIC_HEAD_SIZE.Z * 1.35)
	)
end

local DYNAMIC_HEAD_FACE_FALLBACKS = {
	[12954264879] = 209995366, -- Joyful Smile - Head
}

local DYNAMIC_HEAD_NAME_FACE_FALLBACKS = {
	["joyful smile"] = 209995366,
	["joyful smile - head"] = 209995366,
	["joyful smile - mood"] = 209995366,
}

local isDefaultFaceTexture

local function getClassicFaceTextureFromAvatarInfo(userId)
	userId = tonumber(userId)
	if not userId then
		return nil
	end

	local success, appearanceInfo = pcall(function()
		return Players:GetCharacterAppearanceInfoAsync(userId)
	end)
	if not success or type(appearanceInfo) ~= "table" then
		return nil
	end

	for _, asset in ipairs(appearanceInfo.assets or {}) do
		local assetType = asset.assetType
		local assetTypeName = assetType and tostring(assetType.name or "") or ""
		local assetId = tonumber(asset.id)
		if assetTypeName == "Face" and assetId and assetId &gt; 0 then
			return "rbxassetid://" .. tostring(assetId)
		end
	end

	for _, asset in ipairs(appearanceInfo.assets or {}) do
		local assetId = tonumber(asset.id)
		local mappedFaceId = assetId and DYNAMIC_HEAD_FACE_FALLBACKS[assetId] or nil
		if not mappedFaceId then
			local assetName = string.lower(tostring(asset.name or ""))
			mappedFaceId = DYNAMIC_HEAD_NAME_FACE_FALLBACKS[assetName]
		end
		if mappedFaceId then
			return "rbxassetid://" .. tostring(mappedFaceId)
		end
	end

	return nil
end

local function resolveClassicAvatarHeadAppearance(description, userId)
	local appearance = {
		faceTexture = getDescriptionFaceTexture(description) or getClassicFaceTextureFromAvatarInfo(userId),
	}
	if not description then
		return appearance
	end

	local success, r6Rig = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)
	end)
	if not success then
		success, r6Rig = pcall(function()
			return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R6)
		end)
	end
	if not success or not r6Rig then
		return appearance
	end

	local head = r6Rig:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		local mesh = getHeadSpecialMesh(head)
		local r6FaceTexture = getHeadFaceTexture(head)
		if r6FaceTexture and not isDefaultFaceTexture(r6FaceTexture) and isClassicHeadSpecialMesh(mesh) then
			appearance.faceTexture = r6FaceTexture
		end
	end
	r6Rig:Destroy()
	return appearance
end

function isDefaultFaceTexture(faceTexture)
	local text = string.lower(tostring(faceTexture or ""))
	return text == "" or text == "rbxasset://textures/face.png" or text == "rbxassetid://0"
end

local function applyNormalClassicHeadMesh(mesh, scale)
	if not mesh then
		return
	end

	mesh.MeshType = Enum.MeshType.Head
	mesh.MeshId = ""
	mesh.TextureId = ""
	mesh.Scale = scale or CLASSIC_HEAD_MESH_SCALE
	mesh.Offset = Vector3.new(0, 0, 0)
	mesh.VertexColor = Vector3.new(1, 1, 1)
end

local function removeClassicHeadBlockingAppearance(head)
	if not head then
		return
	end

	for _, child in ipairs(head:GetChildren()) do
		local className = child.ClassName
		if className == "FaceControls"
			or className == "SurfaceAppearance"
			or className == "WrapLayer"
			or className == "WrapTarget" then
			child:Destroy()
		elseif (child:IsA("Decal") or child:IsA("Texture")) and child.Name ~= "face" then
			child:Destroy()
		end
	end
end

local function ensureClassicFaceDecal(head, faceTexture)
	if not head then
		return nil
	end

	local face = head:FindFirstChild("face")
	if not (face and face:IsA("Decal")) then
		face = nil
	end

	for _, child in ipairs(head:GetChildren()) do
		if child:IsA("Decal")
			and (child.Face == Enum.NormalId.Front or child.Name == "face")
			and child ~= face then
			child:Destroy()
		end
	end

	if not face then
		face = Instance.new("Decal")
		face.Name = "face"
		face.Parent = head
	end
	face.Face = Enum.NormalId.Front
	face.Texture = faceTexture or DEFAULT_FACE_TEXTURE
	return face
end

local function getMatchingClassicHeadAttachmentPair(handle, classicHead)
	if not handle or not classicHead then
		return nil, nil
	end

	local preferredNames = {
		"HairAttachment",
		"HatAttachment",
		"FaceFrontAttachment",
		"FaceCenterAttachment",
	}
	for _, attachmentName in ipairs(preferredNames) do
		local handleAttachment = handle:FindFirstChild(attachmentName)
		local headAttachment = classicHead:FindFirstChild(attachmentName)
		if handleAttachment and handleAttachment:IsA("Attachment") and headAttachment and headAttachment:IsA("Attachment") then
			return headAttachment, handleAttachment
		end
	end

	for _, child in ipairs(handle:GetChildren()) do
		if child:IsA("Attachment") then
			local matchingAttachment = classicHead:FindFirstChild(child.Name)
			if matchingAttachment and matchingAttachment:IsA("Attachment") then
				return matchingAttachment, child
			end
		end
	end

	return nil, nil
end

local function getMatchingClassicHeadAttachmentCFrame(handle, classicHead)
	local headAttachment = getMatchingClassicHeadAttachmentPair(handle, classicHead)
	return headAttachment and headAttachment.CFrame or nil
end

local function normalizeClassicHeadJointFrames(rig, classicHead)
	if not rig or not classicHead then
		return
	end

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("JointInstance") then
			if descendant.Part0 == classicHead then
				local matchingCFrame = getMatchingClassicHeadAttachmentCFrame(descendant.Part1, classicHead)
				if matchingCFrame then
					descendant.C0 = matchingCFrame
				end
			end
			if descendant.Part1 == classicHead then
				if descendant.Name == "Neck" then
					descendant.C1 = CLASSIC_HEAD_NECK_CFRAME
				else
					local matchingCFrame = getMatchingClassicHeadAttachmentCFrame(descendant.Part0, classicHead)
					if matchingCFrame then
						descendant.C1 = matchingCFrame
					end
				end
			end
		end
	end
end

local function isDescendantOfAccessory(instance)
	local current = instance
	while current do
		if current:IsA("Accessory") then
			return true
		end
		current = current.Parent
	end
	return false
end

local function buildRigAttachmentMap(rig)
	local attachmentMap = {}
	if not rig then
		return attachmentMap
	end

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Attachment")
			and descendant.Parent
			and descendant.Parent:IsA("BasePart")
			and not isDescendantOfAccessory(descendant) then
			attachmentMap[descendant.Name] = attachmentMap[descendant.Name] or descendant
		end
	end

	return attachmentMap
end

local function configureAccessoryHandleWeld(handle, weld, part0, part1, c0, c1)
	if not handle or not part0 or not part1 then
		return nil
	end
	if not (weld and weld:IsA("Weld")) then
		weld = Instance.new("Weld")
		weld.Name = "AccessoryWeld"
		weld.Parent = handle
	end
	weld.Name = "AccessoryWeld"
	weld.Part0 = part0
	weld.Part1 = part1
	weld.C0 = c0
	weld.C1 = c1
	handle.Anchored = false
	handle.CanCollide = false
	handle.Massless = true
	return weld
end

local function rebindAvatarAccessories(rig)
	local attachmentMap = buildRigAttachmentMap(rig)
	for _, accessory in ipairs(rig:GetDescendants()) do
		if accessory:IsA("Accessory") then
			local handle = accessory:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				local matchedRigAttachment = nil
				local matchedHandleAttachment = nil
				for _, child in ipairs(handle:GetChildren()) do
					if child:IsA("Attachment") then
						local rigAttachment = attachmentMap[child.Name]
						if rigAttachment and rigAttachment.Parent and rigAttachment.Parent:IsA("BasePart") then
							matchedRigAttachment = rigAttachment
							matchedHandleAttachment = child
							break
						end
					end
				end

				if matchedRigAttachment and matchedHandleAttachment then
					local weld = handle:FindFirstChild("AccessoryWeld")
					if not (weld and weld:IsA("Weld")) then
						for _, child in ipairs(handle:GetChildren()) do
							if child:IsA("Weld") then
								weld = child
								break
							end
						end
					end
					configureAccessoryHandleWeld(
						handle,
						weld,
						matchedRigAttachment.Parent,
						handle,
						matchedRigAttachment.CFrame,
						matchedHandleAttachment.CFrame
					)
				end
			end
		end
	end
end

local function rebindClassicHeadAccessories(rig)
	local classicHead = getDirectRigBasePart(rig, "Head")
	if not classicHead or not classicHead:IsA("BasePart") then
		return
	end

	for _, accessory in ipairs(rig:GetDescendants()) do
		if accessory:IsA("Accessory") then
			local handle = accessory:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				local headAttachment, handleAttachment = getMatchingClassicHeadAttachmentPair(handle, classicHead)
				if headAttachment and handleAttachment then
					local weld = handle:FindFirstChild("AccessoryWeld")
					if not (weld and weld:IsA("Weld")) then
						for _, child in ipairs(handle:GetChildren()) do
							if child:IsA("Weld") and (child.Part0 == classicHead or child.Part1 == classicHead) then
								weld = child
								break
							end
						end
					end
					configureAccessoryHandleWeld(handle, weld, classicHead, handle, headAttachment.CFrame, handleAttachment.CFrame)
				end
			end
		end
	end
end

local function replaceGeneratedHeadWithClassicHead(rig, faceTexture)
	if not getDirectRigBasePart(rig, "UpperTorso") then
		return
	end

	local oldHead = getDirectRigBasePart(rig, "Head")
	if not oldHead or not oldHead:IsA("BasePart") or oldHead:IsA("Part") then
		return
	end
	local preservedFaceTexture = resolveFaceAssetTexture(faceTexture or getHeadFaceTexture(oldHead) or DEFAULT_FACE_TEXTURE)
	local preservedHeadColor = getBodyColorsHeadColor(rig) or oldHead.Color
	local classicHeadCFrame = getClassicHeadReplacementCFrame(oldHead)

	oldHead.Name = "GeneratedHead"

	local classicHead = Instance.new("Part")
	classicHead.Name = "Head"
	classicHead.Size = CLASSIC_HEAD_SIZE
	classicHead.CFrame = classicHeadCFrame
	classicHead.Color = preservedHeadColor
	classicHead.Material = Enum.Material.Plastic
	classicHead.TopSurface = Enum.SurfaceType.Smooth
	classicHead.BottomSurface = Enum.SurfaceType.Smooth
	classicHead.CanCollide = oldHead.CanCollide
	classicHead.CanTouch = oldHead.CanTouch
	classicHead.CanQuery = oldHead.CanQuery
	classicHead.Massless = oldHead.Massless
	classicHead.Parent = oldHead.Parent

	local headMesh = Instance.new("SpecialMesh")
	headMesh.Name = "Mesh"
	applyNormalClassicHeadMesh(headMesh)
	headMesh.Parent = classicHead

	createClassicHeadAttachments(classicHead, true)
	ensureClassicFaceDecal(classicHead, preservedFaceTexture)
	normalizeClassicHeadJointFrames(rig, classicHead)

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("JointInstance") then
			if descendant.Part0 == oldHead then
				descendant.Part0 = classicHead
				local matchingCFrame = getMatchingClassicHeadAttachmentCFrame(descendant.Part1, classicHead)
				if matchingCFrame then
					descendant.C0 = matchingCFrame
				end
			end
			if descendant.Part1 == oldHead then
				descendant.Part1 = classicHead
				if descendant.Name == "Neck" then
					descendant.C1 = CLASSIC_HEAD_NECK_CFRAME
				else
					local matchingCFrame = getMatchingClassicHeadAttachmentCFrame(descendant.Part0, classicHead)
					if matchingCFrame then
						descendant.C1 = matchingCFrame
					end
				end
			end
		end
	end

	rebindClassicHeadAccessories(rig)
	oldHead:Destroy()
end

local function replaceAvatarHeadWithClassicHead(rig, description, userId)
	local oldHead = getDirectRigBasePart(rig, "Head")
	if not oldHead or not oldHead:IsA("BasePart") then
		return false
	end

	local classicAppearance = resolveClassicAvatarHeadAppearance(description, userId)
	local oldFace = oldHead:FindFirstChild("face")
	local oldFaceTexture = oldFace and oldFace:IsA("Decal") and oldFace.Texture or nil
	local rawFaceTexture = classicAppearance.faceTexture or getDescriptionFaceTexture(description) or oldFaceTexture or DEFAULT_FACE_TEXTURE
	local preservedFaceTexture = resolveFaceAssetTexture(rawFaceTexture)
	local preservedHeadColor = getBodyColorsHeadColor(rig) or oldHead.Color
	local sourceHeadWasCustom = descriptionHasCustomHeadAsset(description) or not isNormalClassicHeadPart(oldHead)
	local replacementHeadCFrame = sourceHeadWasCustom and oldHead.CFrame or getClassicHeadReplacementCFrame(oldHead)
	local replacementHeadSize = sourceHeadWasCustom and getCustomClassicHeadSize(oldHead) or CLASSIC_HEAD_SIZE
	local oldHeadParent = oldHead.Parent

	if oldHead:IsA("Part") then
		removeClassicHeadBlockingAppearance(oldHead)
		oldHead.Color = preservedHeadColor
		oldHead.Size = replacementHeadSize
		oldHead.CFrame = replacementHeadCFrame
		createClassicHeadAttachments(oldHead, not sourceHeadWasCustom)
		local mesh = oldHead:FindFirstChildOfClass("SpecialMesh")
		if not mesh then
			mesh = Instance.new("SpecialMesh")
			mesh.Name = "Mesh"
			mesh.Parent = oldHead
		end
		applyNormalClassicHeadMesh(mesh)
		ensureClassicFaceDecal(oldHead, preservedFaceTexture)
		if not sourceHeadWasCustom then
			normalizeClassicHeadJointFrames(rig, oldHead)
		end
		rebindClassicHeadAccessories(rig)
		rebindAvatarAccessories(rig)
		return true
	end

	oldHead.Name = "GeneratedHead"

	local classicHead = Instance.new("Part")
	classicHead.Name = "Head"
	classicHead.Size = replacementHeadSize
	classicHead.CFrame = replacementHeadCFrame
	classicHead.Color = preservedHeadColor
	classicHead.Material = Enum.Material.Plastic
	classicHead.TopSurface = Enum.SurfaceType.Smooth
	classicHead.BottomSurface = Enum.SurfaceType.Smooth
	classicHead.CanCollide = oldHead.CanCollide
	classicHead.CanTouch = oldHead.CanTouch
	classicHead.CanQuery = oldHead.CanQuery
	classicHead.Massless = oldHead.Massless
	classicHead.Parent = oldHeadParent

	local headMesh = Instance.new("SpecialMesh")
	headMesh.Name = "Mesh"
	applyNormalClassicHeadMesh(headMesh)
	headMesh.Parent = classicHead

	for _, child in ipairs(oldHead:GetChildren()) do
		if child:IsA("Attachment") then
			local copiedAttachment = child:Clone()
			copiedAttachment.Parent = classicHead
		end
	end
	createClassicHeadAttachments(classicHead, not sourceHeadWasCustom)
	removeClassicHeadBlockingAppearance(classicHead)
	ensureClassicFaceDecal(classicHead, preservedFaceTexture)

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("JointInstance") then
			if descendant.Part0 == oldHead then
				descendant.Part0 = classicHead
			end
			if descendant.Part1 == oldHead then
				descendant.Part1 = classicHead
			end
		elseif descendant:IsA("WeldConstraint") then
			if descendant.Part0 == oldHead then
				descendant.Part0 = classicHead
			end
			if descendant.Part1 == oldHead then
				descendant.Part1 = classicHead
			end
		elseif descendant:IsA("AnimationConstraint") then
			local preserveConstraint = descendant:IsDescendantOf(oldHead)
			local okPart0, part0 = pcall(function()
				return descendant.Part0
			end)
			if okPart0 and part0 == oldHead then
				preserveConstraint = true
				pcall(function()
					descendant.Part0 = classicHead
				end)
			end
			local okPart1, part1 = pcall(function()
				return descendant.Part1
			end)
			if okPart1 and part1 == oldHead then
				preserveConstraint = true
				pcall(function()
					descendant.Part1 = classicHead
				end)
			end
			local attachment0 = descendant.Attachment0
			if attachment0 and attachment0.Parent == oldHead then
				local replacement = classicHead:FindFirstChild(attachment0.Name)
				if replacement and replacement:IsA("Attachment") then
					preserveConstraint = true
					descendant.Attachment0 = replacement
				end
			end
			local attachment1 = descendant.Attachment1
			if attachment1 and attachment1.Parent == oldHead then
				local replacement = classicHead:FindFirstChild(attachment1.Name)
				if replacement and replacement:IsA("Attachment") then
					preserveConstraint = true
					descendant.Attachment1 = replacement
				end
			end
			if preserveConstraint and descendant:IsDescendantOf(oldHead) then
				descendant.Parent = classicHead
			end
		end
	end

	classicHead.CFrame = replacementHeadCFrame
	if not sourceHeadWasCustom then
		normalizeClassicHeadJointFrames(rig, classicHead)
	end
	rebindClassicHeadAccessories(rig)
	rebindAvatarAccessories(rig)
	oldHead:Destroy()
	return true
end

local function applyDefaultRigColors(rig, clearMeshTextures, removeBodyColors)
	local bodyColors = rig:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		local limbBrickColor = BrickColor.new(DEFAULT_RIG_LIMB_COLOR)
		local torsoBrickColor = BrickColor.new(DEFAULT_RIG_TORSO_COLOR)
		bodyColors.HeadColor = limbBrickColor
		bodyColors.TorsoColor = torsoBrickColor
		bodyColors.LeftArmColor = limbBrickColor
		bodyColors.RightArmColor = limbBrickColor
		bodyColors.LeftLegColor = limbBrickColor
		bodyColors.RightLegColor = limbBrickColor
		if removeBodyColors then
			bodyColors:Destroy()
		end
	end

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			if descendant.Name ~= "HumanoidRootPart" then
				descendant.Color = getDefaultRigPartColor(descendant.Name)
				descendant.Material = Enum.Material.Plastic
			end
			if clearMeshTextures and descendant:IsA("MeshPart") then
				pcall(function()
					descendant.TextureID = ""
				end)
			end
		end
	end
end

local function applyClassicDefaultRigAppearance(rig)
	replaceGeneratedHeadWithClassicHead(rig)

	for _, descendant in ipairs(rig:GetDescendants()) do
		if isDefaultAppearanceObject(descendant) then
			descendant:Destroy()
		end
	end

	applyDefaultRigColors(rig, true, true)

	local head = rig:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		for _, child in ipairs(head:GetChildren()) do
			if child:IsA("Decal") and child.Face == Enum.NormalId.Front then
				child:Destroy()
			end
		end

		local face = Instance.new("Decal")
		face.Name = "face"
		face.Face = Enum.NormalId.Front
		face.Texture = DEFAULT_FACE_TEXTURE
		face.Parent = head
	end
end

local function removeDynamicHeadRuntimeObjects(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		local className = descendant.ClassName
		if className == "FaceControls" or className == "WrapLayer" or className == "WrapTarget" then
			descendant:Destroy()
		end
	end
end

local function applyDefaultRigAppearance(rig, appearanceMode)
	if appearanceMode == DEFAULT_RIG_APPEARANCE_MODERN then
		applyDefaultRigColors(rig, false, true)
	else
		applyClassicDefaultRigAppearance(rig)
	end
end

local function getRigRootPart(rig)
	if not rig then
		return nil
	end
	local root = rig:FindFirstChild("HumanoidRootPart", true)
	if root and root:IsA("BasePart") then
		return root
	end
	if rig.PrimaryPart and rig.PrimaryPart:IsA("BasePart") then
		return rig.PrimaryPart
	end
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

local function getRigHumanoidRigType(rig)
	local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.RigType or nil
end

local function rigMatchesHumanoidRigType(rig, rigType)
	local generatedRigType = getRigHumanoidRigType(rig)
	return generatedRigType == nil or generatedRigType == rigType
end

local function preloadRigAppearance(rig)
	if not rig then
		return
	end

	local preloadList = {}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("MeshPart")
			or descendant:IsA("SpecialMesh")
			or descendant:IsA("Decal")
			or descendant:IsA("Texture")
			or descendant:IsA("SurfaceAppearance") then
			preloadList[#preloadList + 1] = descendant
		end
	end
	if #preloadList == 0 then
		return
	end

	pcall(function()
		ContentProvider:PreloadAsync(preloadList)
	end)
end

local function configureInsertedRigForStudioAnimation(rig)
	local root = getRigRootPart(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = descendant == root
			descendant.Locked = false
		end
	end
	if root then
		root:SetAttribute("MegMoStudioAnimationRoot", true)
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = false
	end
	rebindAvatarAccessories(rig)
end

local function alignRigToInsertGround(rig, insertCFrame)
	if not rig or not rig.Parent then
		return
	end

	local currentBottomY = nil
	for _, child in ipairs(rig:GetChildren()) do
		if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
			local halfSize = child.Size * 0.5
			local partCFrame = child.CFrame
			local partBottomY = partCFrame.Position.Y
				- math.abs(partCFrame.RightVector.Y) * halfSize.X
				- math.abs(partCFrame.UpVector.Y) * halfSize.Y
				- math.abs(partCFrame.LookVector.Y) * halfSize.Z
			currentBottomY = currentBottomY and math.min(currentBottomY, partBottomY) or partBottomY
		end
	end

	if currentBottomY == nil then
		local boundingBoxCFrame, boundingBoxSize = rig:GetBoundingBox()
		currentBottomY = boundingBoxCFrame.Position.Y - (boundingBoxSize.Y * 0.5)
	end

	local desiredGroundY = insertCFrame.Position.Y - 3
	local deltaY = desiredGroundY - currentBottomY
	if math.abs(deltaY) &lt; 0.001 then
		return
	end

	rig:PivotTo(rig:GetPivot() + Vector3.new(0, deltaY, 0))
end

local function normalizeR6InsertedOrientation(rig)
	local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		return
	end

	local pivot = rig:GetPivot()
	local _, yaw, _ = pivot:ToOrientation()
	if math.abs(yaw) &lt; math.rad(0.01) then
		return
	end

	rig:PivotTo(CFrame.new(pivot.Position))
end

local function normalizeDefaultR6InsertedScale(rig)
	local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		return
	end

	local _, size = rig:GetBoundingBox()
	local currentHeight = size.Y
	if currentHeight &lt;= 0.001 then
		return
	end

	local scaleMultiplier = DEFAULT_R6_MATCHED_R15_HEIGHT / currentHeight
	if math.abs(scaleMultiplier - 1) &lt; 0.01 then
		return
	end

	pcall(function()
		local currentScale = rig:GetScale()
		rig:ScaleTo(currentScale * scaleMultiplier)
	end)
end

local function isInsideAccessory(instance)
	local current = instance
	while current do
		if current:IsA("Accessory") then
			return true
		end
		current = current.Parent
	end
	return false
end

local function convertAnimationConstraintsToMotors(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			local attachment0 = descendant.Attachment0
			local attachment1 = descendant.Attachment1
			if attachment0
				and attachment1
				and attachment0.Parent
				and attachment1.Parent
				and attachment0.Parent:IsA("BasePart")
				and attachment1.Parent:IsA("BasePart") then
				local part0 = attachment0.Parent
				local part1 = attachment1.Parent
				if not isInsideAccessory(part0) and not isInsideAccessory(part1) then
					local motor = Instance.new("Motor6D")
					motor.Name = descendant.Name
					motor.Part0 = part0
					motor.Part1 = part1
					motor.C0 = attachment0.CFrame
					motor.C1 = attachment1.CFrame
					motor.Parent = part0
					descendant:Destroy()
				end
			else
				descendant:Destroy()
			end
		end
	end
end

local function prepareInsertedRig(deps, rig, name, defaultAppearanceMode)
	convertAnimationConstraintsToMotors(rig)
	if defaultAppearanceMode then
		applyDefaultRigAppearance(rig, defaultAppearanceMode)
	end
	rig.Name = getUniqueWorkspaceName(name)
	rig.Parent = workspace
	local insertCFrame = deps.getRigInsertCFrame()
	pcall(function()
		rig:PivotTo(insertCFrame)
		normalizeR6InsertedOrientation(rig)
		normalizeDefaultR6InsertedScale(rig)
		alignRigToInsertGround(rig, insertCFrame)
	end)

	configureInsertedRigForStudioAnimation(rig)

	if defaultAppearanceMode then
		applyDefaultRigAppearance(rig, defaultAppearanceMode)
		task.defer(function()
			if rig and rig.Parent then
				applyDefaultRigAppearance(rig, defaultAppearanceMode)
				configureInsertedRigForStudioAnimation(rig)
			end
		end)
	end
	deps.selectionService.setSelection({ rig })
end

local function prepareInsertedAvatarRig(deps, rig, name, avatarAppearanceMode, description, userId)
	rig.Name = getUniqueWorkspaceName(name)
	rig.Parent = workspace

	-- Generated avatar assets can finish resolving after parenting in edit mode.
	-- Give Roblox one tick before replacing dynamic heads or rebinding accessories.
	task.wait()
	convertAnimationConstraintsToMotors(rig)
	preloadRigAppearance(rig)

	if avatarAppearanceMode == DEFAULT_RIG_APPEARANCE_CLASSIC then
		replaceAvatarHeadWithClassicHead(rig, description, userId)
		rebindClassicHeadAccessories(rig)
	end
	rebindAvatarAccessories(rig)

	local insertCFrame = deps.getRigInsertCFrame()
	pcall(function()
		rig:PivotTo(insertCFrame)
		normalizeR6InsertedOrientation(rig)
		alignRigToInsertGround(rig, insertCFrame)
	end)

	configureInsertedRigForStudioAnimation(rig)
	preloadRigAppearance(rig)

	task.defer(function()
		if rig and rig.Parent then
			if avatarAppearanceMode == DEFAULT_RIG_APPEARANCE_CLASSIC then
				replaceAvatarHeadWithClassicHead(rig, description, userId)
				rebindClassicHeadAccessories(rig)
			end
			rebindAvatarAccessories(rig)
			configureInsertedRigForStudioAnimation(rig)
			preloadRigAppearance(rig)
		end
	end)

	deps.selectionService.setSelection({ rig })
end

local function cloneDefaultRigTemplate(rigTypeName)
	local template = ServerStorage:FindFirstChild(rigTypeName)
	if not template or not template:IsA("Model") then
		return nil, string.format("ServerStorage.%s was not found.", rigTypeName)
	end

	local success, cloneOrError = pcall(function()
		return template:Clone()
	end)
	if not success or not cloneOrError then
		return nil, string.format("Could not clone ServerStorage.%s: %s", rigTypeName, tostring(cloneOrError))
	end

	return cloneOrError, nil
end

local function getAvatarRigFamily(rigTypeName)
	local normalized = string.gsub(tostring(rigTypeName or "R15Classic"), "%s+", "")
	return normalized == "R6" and "R6" or "R15"
end

local function clearRandomAvatarState()
	randomAvatarState.userId = nil
	randomAvatarState.userName = nil
	randomAvatarState.description = nil
	randomAvatarState.usedRigFamilies = {}
end

local function pickRandomAvatarUserId(excludedUserId)
	local minUserId = RANDOM_AVATAR_MIN_USER_ID
	local maxUserId = RANDOM_AVATAR_MAX_USER_ID
	for _ = 1, RANDOM_AVATAR_RETRY_COUNT do
		local candidate = math.floor(minUserId + (randomAvatarRng:NextNumber() * (maxUserId - minUserId + 1)))
		if candidate ~= excludedUserId then
			return candidate
		end
	end
	return math.floor(minUserId + (randomAvatarRng:NextNumber() * (maxUserId - minUserId + 1)))
end

local function resolveRandomAvatarUserId(avatarRigTypeName)
	local family = getAvatarRigFamily(avatarRigTypeName)
	if randomAvatarState.userId and randomAvatarState.usedRigFamilies[family] ~= true then
		randomAvatarState.usedRigFamilies[family] = true
		return randomAvatarState.userId, randomAvatarState.userName or tostring(randomAvatarState.userId), nil, true, randomAvatarState.description
	end

	local previousUserId = randomAvatarState.userId
	for _ = 1, RANDOM_AVATAR_RETRY_COUNT do
		local candidateUserId = pickRandomAvatarUserId(previousUserId)
		if not candidateUserId then
			break
		end

		local nameSuccess, userName = pcall(function()
			return Players:GetNameFromUserIdAsync(candidateUserId)
		end)
		local descriptionSuccess, descriptionOrError = false, nil
		if nameSuccess then
			descriptionSuccess, descriptionOrError = pcall(function()
				return Players:GetHumanoidDescriptionFromUserId(candidateUserId)
			end)
		end
		if nameSuccess and descriptionSuccess and descriptionOrError then
			randomAvatarState.userId = candidateUserId
			randomAvatarState.userName = tostring(userName or candidateUserId)
			randomAvatarState.description = descriptionOrError
			randomAvatarState.usedRigFamilies = {
				[family] = true,
			}
			return randomAvatarState.userId, randomAvatarState.userName, nil, true, randomAvatarState.description
		end
	end

	clearRandomAvatarState()
	return nil, nil, "Could not find a valid random userId after several attempts. Try again or enter a username/userId.", true
end

local function resolveAvatarUserId(query, avatarRigTypeName)
	query = tostring(query or "")
	query = string.gsub(query, "^%s+", "")
	query = string.gsub(query, "%s+$", "")
	if query == "" then
		return resolveRandomAvatarUserId(avatarRigTypeName)
	end

	local numericId = tonumber(query)
	if numericId and numericId &gt; 0 then
		clearRandomAvatarState()
		local displayName = tostring(numericId)
		pcall(function()
			displayName = Players:GetNameFromUserIdAsync(numericId)
		end)
		return math.floor(numericId), displayName, nil, false, nil
	end

	local success, userIdOrError = pcall(function()
		return Players:GetUserIdFromNameAsync(query)
	end)
	if not success then
		return nil, nil, "Could not find Roblox user '" .. query .. "'."
	end

	clearRandomAvatarState()
	return userIdOrError, query, nil, false, nil
end

local function normalizeAvatarRigType(rigTypeName)
	local normalized = string.gsub(tostring(rigTypeName or "R15Classic"), "%s+", "")
	if normalized == "R6" then
		return Enum.HumanoidRigType.R6, "R6", DEFAULT_RIG_APPEARANCE_CLASSIC
	elseif normalized == "R15Modern" or normalized == "Modern" then
		return Enum.HumanoidRigType.R15, "R15 Modern", DEFAULT_RIG_APPEARANCE_MODERN
	end
	return Enum.HumanoidRigType.R15, "R15 Classic", DEFAULT_RIG_APPEARANCE_CLASSIC
end

local function tryCreateAvatarRigFromUserId(userId, avatarRigType)
	local success, rigOrError = pcall(function()
		return Players:CreateHumanoidModelFromUserId(userId)
	end)
	if not success then
		success, rigOrError = pcall(function()
			return Players:CreateHumanoidModelFromUserIdAsync(userId)
		end)
	end
	if success and rigOrError and rigMatchesHumanoidRigType(rigOrError, avatarRigType) then
		return true, rigOrError
	end
	if success and rigOrError and rigOrError.Destroy then
		rigOrError:Destroy()
	end
	return false, rigOrError
end

local function tryCreateAvatarRigFromDescription(description, avatarRigType)
	if not description then
		return false, "Avatar description was unavailable."
	end

	local success, rigOrError = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, avatarRigType)
	end)
	if not success then
		success, rigOrError = pcall(function()
			return Players:CreateHumanoidModelFromDescriptionAsync(description, avatarRigType)
		end)
	end
	return success, rigOrError
end

local function createAvatarRig(userId, description, avatarRigType)
	if avatarRigType == Enum.HumanoidRigType.R15 then
		local userIdSuccess, userIdRig = tryCreateAvatarRigFromUserId(userId, avatarRigType)
		if userIdSuccess then
			return true, userIdRig
		end
	end

	local descriptionSuccess, descriptionRig = tryCreateAvatarRigFromDescription(description, avatarRigType)
	if descriptionSuccess then
		return true, descriptionRig
	end

	if avatarRigType ~= Enum.HumanoidRigType.R15 then
		local userIdSuccess, userIdRig = tryCreateAvatarRigFromUserId(userId, avatarRigType)
		if userIdSuccess then
			return true, userIdRig
		end
	end

	return false, descriptionRig
end

function RigInsertService.insertDefaultRig(deps, rigTypeName, appearanceMode)
	rigTypeName = rigTypeName == "R6" and "R6" or "R15"
	local rigType = rigTypeName == "R6" and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
	local defaultAppearanceMode = appearanceMode == DEFAULT_RIG_APPEARANCE_MODERN
		and DEFAULT_RIG_APPEARANCE_MODERN
		or DEFAULT_RIG_APPEARANCE_CLASSIC
	local rigName = rigTypeName .. " Rig"
	if rigTypeName == "R15" then
		rigName = defaultAppearanceMode == DEFAULT_RIG_APPEARANCE_MODERN and "R15 Modern Rig" or "R15 Classic Rig"
	end
	local description = createDefaultRigDescription()

	ChangeHistoryService:SetWaypoint("Before Insert Default Rig")
	local success, rigOrError = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, rigType)
	end)
	if not success then
		success, rigOrError = pcall(function()
			return Players:CreateHumanoidModelFromDescriptionAsync(description, rigType)
		end)
	end

	if not success or not rigOrError then
		local templateRig, templateError = cloneDefaultRigTemplate(rigTypeName)
		if templateRig then
			prepareInsertedRig(deps, templateRig, templateRig.Name, nil)
			ChangeHistoryService:SetWaypoint("After Insert Default Rig")
			deps.refreshUi(string.format("Inserted ServerStorage.%s because Roblox rig generation failed. Customize it, then click Bind Selected Rig when ready.", rigTypeName))
			return
		end

		deps.refreshUi("Could not insert default " .. rigTypeName .. " rig: " .. tostring(rigOrError or templateError))
		return
	end

	local rig = rigOrError
	prepareInsertedRig(deps, rig, rigName, defaultAppearanceMode)
	ChangeHistoryService:SetWaypoint("After Insert Default Rig")
	deps.refreshUi(string.format("Inserted generated %s %s rig. Customize it, then click Bind Selected Rig when ready.", string.lower(defaultAppearanceMode), rigTypeName))
end

function RigInsertService.rebindAvatarAccessories(rig)
	rebindAvatarAccessories(rig)
end

function RigInsertService.prepareExternalRigForBinding(rig)
	if not (rig and rig.Parent) then
		return
	end
	convertAnimationConstraintsToMotors(rig)
	rebindAvatarAccessories(rig)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = false
	end
end

function RigInsertService.insertAvatarRig(deps, query, avatarRigTypeName)
	local avatarRigType, avatarRigLabel, avatarAppearanceMode = normalizeAvatarRigType(avatarRigTypeName)
	local queryText = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
	deps.refreshUi((queryText == "" and "Picking random " or "Loading ") .. avatarRigLabel .. " avatar rig...")
	task.spawn(function()
		local userId, userName, resolveError, isRandomAvatar, resolvedDescription = resolveAvatarUserId(query, avatarRigTypeName)
		if not userId then
			deps.refreshUi(resolveError)
			return
		end

		ChangeHistoryService:SetWaypoint("Before Insert Avatar Rig")
		local descriptionSuccess = resolvedDescription ~= nil
		local descriptionOrError = resolvedDescription
		if not descriptionSuccess then
			descriptionSuccess, descriptionOrError = pcall(function()
				return Players:GetHumanoidDescriptionFromUserId(userId)
			end)
		end

		local success, rigOrError = createAvatarRig(
			userId,
			descriptionSuccess and descriptionOrError or nil,
			avatarRigType
		)

		if not success or not rigOrError then
			if isRandomAvatar then
				clearRandomAvatarState()
			end
			deps.refreshUi("Could not insert avatar for " .. tostring(userName) .. ": " .. tostring(rigOrError))
			return
		end

		local rig = rigOrError
		prepareInsertedAvatarRig(
			deps,
			rig,
			"Avatar " .. tostring(userName or userId) .. " " .. avatarRigLabel,
			avatarAppearanceMode,
			descriptionSuccess and descriptionOrError or nil,
			userId
		)
		ChangeHistoryService:SetWaypoint("After Insert Avatar Rig")
		local randomPrefix = isRandomAvatar and "random " or ""
		deps.refreshUi(string.format("Inserted %s%s avatar rig for %s. Customize it, then click Bind Selected Rig when ready.", randomPrefix, avatarRigLabel, tostring(userName or userId)))
	end)
end

return RigInsertService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX213">
        <Properties>
          <string name="Name">RigPartHighlightService</string>
          <ProtectedString name="Source">local RigPartHighlightService = {}

local RunService = game:GetService("RunService")
local RigService = require(script.Parent:WaitForChild("RigService"))

local FOLDER_NAME = "MegMoAnimatorSelectionHighlights"
local HIGHLIGHT_COLOR = Color3.fromRGB(80, 210, 255)
local HEAD_VISUAL_SCALE = Vector3.new(0.72, 0.92, 0.72)
local BONE_MARKER_SIZE = 0.18

local activeBoxes = {}
local activeBoneMarkers = {}
local heartbeatConnection = nil

local function isHeadPart(part)
	return part and part:IsA("BasePart") and part.Name == "Head"
end

local function getHeadVisualSize(part)
	local size = part.Size * HEAD_VISUAL_SCALE
	local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
	if mesh then
		local scale = mesh.Scale
		if scale.X &gt; 0 and scale.Y &gt; 0 and scale.Z &gt; 0 then
			local meshSize = Vector3.new(part.Size.X * scale.X, part.Size.Y * scale.Y, part.Size.Z * scale.Z)
			size = Vector3.new(
				math.min(meshSize.X, part.Size.X * 1.05),
				math.min(meshSize.Y, part.Size.Y * 1.05),
				math.min(meshSize.Z, part.Size.Z * 1.05)
			) * HEAD_VISUAL_SCALE
		end
	end
	return size
end

local function getFolder()
	local folder = workspace:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Archivable = false
		folder.Parent = workspace
	end
	return folder
end

local function disconnectHeartbeat()
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end

local function getBoneWorldCFrame(motorData)
	local success, cframe = pcall(function()
		return RigService.getJointWorldCFrame(motorData)
	end)
	if success and typeof(cframe) == "CFrame" then
		return cframe
	end
	return nil
end

local function getBoneParentWorldCFrame(motorData)
	local bone = motorData and motorData.instance
	if not (bone and bone.Parent and bone:IsA("Bone")) then
		return nil
	end
	local success, cframe = pcall(function()
		return RigService.getBoneParentWorldCFrame(bone)
	end)
	if success and typeof(cframe) == "CFrame" then
		return cframe
	end
	return nil
end

local function updateBoneMarker(marker)
	local jointCFrame = getBoneWorldCFrame(marker.motorData)
	if not jointCFrame or not marker.proxy or not marker.proxy.Parent then
		return false
	end

	marker.proxy.CFrame = jointCFrame
	local parentCFrame = getBoneParentWorldCFrame(marker.motorData)
	if marker.parentProxy and marker.parentProxy.Parent then
		marker.parentProxy.CFrame = parentCFrame or jointCFrame
	end
	if marker.beam then
		marker.beam.Enabled = parentCFrame ~= nil
	end
	return true
end

local function updateBoneMarkers()
	for index = #activeBoneMarkers, 1, -1 do
		if not updateBoneMarker(activeBoneMarkers[index]) then
			table.remove(activeBoneMarkers, index)
		end
	end
	if #activeBoneMarkers == 0 then
		disconnectHeartbeat()
	end
end

local function ensureHeartbeat()
	if not heartbeatConnection then
		heartbeatConnection = RunService.Heartbeat:Connect(updateBoneMarkers)
	end
end

local function createBoneProxy(folder, name, size, visible)
	local proxy = Instance.new("Part")
	proxy.Name = name
	proxy.Archivable = false
	proxy.Anchored = true
	proxy.CanCollide = false
	proxy.CanTouch = false
	proxy.CanQuery = false
	proxy.Locked = true
	proxy.Shape = Enum.PartType.Ball
	proxy.Material = Enum.Material.Neon
	proxy.Color = HIGHLIGHT_COLOR
	proxy.Size = size
	proxy.Transparency = visible and 0.08 or 1
	proxy.Parent = folder
	table.insert(activeBoxes, proxy)
	return proxy
end

local function addBoneMarker(folder, motorData)
	local jointCFrame = getBoneWorldCFrame(motorData)
	if not jointCFrame then
		return
	end

	local proxy = createBoneProxy(folder, "SelectedBoneJoint", Vector3.new(BONE_MARKER_SIZE, BONE_MARKER_SIZE, BONE_MARKER_SIZE), true)
	local parentProxy = createBoneProxy(folder, "SelectedBoneParent", Vector3.new(0.05, 0.05, 0.05), false)
	proxy.CFrame = jointCFrame
	parentProxy.CFrame = getBoneParentWorldCFrame(motorData) or jointCFrame

	local fromAttachment = Instance.new("Attachment")
	fromAttachment.Name = "BoneParentAttachment"
	fromAttachment.Parent = parentProxy
	local toAttachment = Instance.new("Attachment")
	toAttachment.Name = "BoneJointAttachment"
	toAttachment.Parent = proxy

	local beam = Instance.new("Beam")
	beam.Name = "SelectedBoneLink"
	beam.Archivable = false
	beam.Attachment0 = fromAttachment
	beam.Attachment1 = toAttachment
	beam.Color = ColorSequence.new(HIGHLIGHT_COLOR)
	beam.LightEmission = 0.8
	beam.Transparency = NumberSequence.new(0.2)
	beam.Width0 = 0.035
	beam.Width1 = 0.035
	beam.Enabled = getBoneParentWorldCFrame(motorData) ~= nil
	beam.Parent = proxy
	table.insert(activeBoxes, beam)

	local highlight = Instance.new("Highlight")
	highlight.Name = "SelectedBoneHighlight"
	highlight.Adornee = proxy
	highlight.Archivable = false
	highlight.FillColor = HIGHLIGHT_COLOR
	highlight.OutlineColor = Color3.fromRGB(220, 255, 255)
	highlight.FillTransparency = 0.35
	highlight.OutlineTransparency = 0.05
	pcall(function()
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	end)
	highlight.Parent = proxy
	table.insert(activeBoxes, highlight)

	table.insert(activeBoneMarkers, {
		motorData = motorData,
		proxy = proxy,
		parentProxy = parentProxy,
		beam = beam,
	})
	ensureHeartbeat()
end

local function getMotorPart(motorData)
	if not motorData then
		return nil
	end

	local motor = motorData.instance
	if motor and motor.Parent and motor:IsA("Motor6D") then
		local part = motor.Part1
		if part and part.Parent and part:IsA("BasePart") then
			return part
		end
	end

	local rig = motorData.rig
	local partName = motorData.part1 or motorData.name
	if rig and rig.Parent and partName then
		local part = rig:FindFirstChild(partName, true)
		if part and part.Parent and part:IsA("BasePart") then
			return part
		end
	end

	return nil
end

function RigPartHighlightService.clear()
	disconnectHeartbeat()
	for _, box in ipairs(activeBoxes) do
		if box and box.Parent then
			box:Destroy()
		end
	end
	table.clear(activeBoxes)
	table.clear(activeBoneMarkers)
end

function RigPartHighlightService.showForMotors(motors)
	RigPartHighlightService.clear()
	if type(motors) ~= "table" or #motors == 0 then
		return
	end

	local folder = getFolder()
	local seen = {}
	local seenBones = {}
	for _, motorData in ipairs(motors) do
		local part = getMotorPart(motorData)
		if part and not seen[part] then
			seen[part] = true
			if isHeadPart(part) then
				local proxy = Instance.new("Part")
				proxy.Name = "SelectedRigHeadProxy"
				proxy.Archivable = false
				proxy.Anchored = true
				proxy.CanCollide = false
				proxy.CanTouch = false
				proxy.CanQuery = false
				proxy.Locked = true
				proxy.Transparency = 1
				proxy.CFrame = part.CFrame
				proxy.Size = getHeadVisualSize(part)
				proxy.Parent = folder
				table.insert(activeBoxes, proxy)

				local box = Instance.new("SelectionBox")
				box.Name = "SelectedRigHead"
				box.Adornee = proxy
				box.Archivable = false
				box.Color3 = HIGHLIGHT_COLOR
				box.LineThickness = 0.035
				box.SurfaceColor3 = HIGHLIGHT_COLOR
				box.SurfaceTransparency = 0.88
				box.Parent = folder
				table.insert(activeBoxes, box)
			else
				local box = Instance.new("SelectionBox")
				box.Name = "SelectedRigPart"
				box.Adornee = part
				box.Archivable = false
				box.Color3 = HIGHLIGHT_COLOR
				box.LineThickness = 0.035
				box.SurfaceColor3 = HIGHLIGHT_COLOR
				box.SurfaceTransparency = 0.88
				box.Parent = folder
				table.insert(activeBoxes, box)
			end
		elseif RigService.isBoneJoint(motorData) then
			local bone = motorData.instance
			if bone and not seenBones[bone] then
				seenBones[bone] = true
				addBoneMarker(folder, motorData)
			end
		end
	end
end

function RigPartHighlightService.showForMotor(motorData)
	if motorData then
		RigPartHighlightService.showForMotors({ motorData })
	else
		RigPartHighlightService.clear()
	end
end

return RigPartHighlightService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX214">
        <Properties>
          <string name="Name">RigSelectionValidationSupport</string>
          <ProtectedString name="Source">local RigSelectionValidationSupport = {}

function RigSelectionValidationSupport.hasWorkspaceRigNameConflict(workspaceInstance, rigService, rig, selectedRigs)
	if not rig or not rig.Parent then
		return false
	end

	local selectedLookup = {}
	for _, selectedRig in ipairs(selectedRigs or {}) do
		selectedLookup[selectedRig] = true
	end

	for _, descendant in ipairs(workspaceInstance:GetDescendants()) do
		if descendant:IsA("Model") and descendant ~= rig and descendant.Name == rig.Name and not selectedLookup[descendant] then
			local rigData = rigService.describeRig(descendant)
			if #rigData.motors &gt; 0 then
				return true
			end
		end
	end

	return false
end

function RigSelectionValidationSupport.collectValidSelectedRigs(timeline, rigService, selectedRigs, hasConflictFn)
	local validRigs = {}
	local selectedNames = {}
	local existingRigNames = {}
	local existingRigInstances = {}
	for _, existingRig in ipairs(timeline:getRigs()) do
		if existingRig then
			existingRigInstances[existingRig] = true
			existingRigNames[existingRig.Name] = true
		end
	end

	for _, selectedRig in ipairs(selectedRigs) do
		local rigData = rigService.describeRig(selectedRig)
		if #rigData.motors &gt; 0 then
			if existingRigInstances[selectedRig] then
				table.insert(validRigs, {
					rig = selectedRig,
					rigData = rigData,
					alreadyBound = true,
				})
			elseif selectedNames[selectedRig.Name] or existingRigNames[selectedRig.Name] or hasConflictFn(selectedRig, selectedRigs) then
				return nil, existingRigInstances, string.format("Rig '%s' shares its name with another rig. Give each workspace rig a unique name before adding it to the timeline.", selectedRig.Name)
			else
				selectedNames[selectedRig.Name] = true
				table.insert(validRigs, {
					rig = selectedRig,
					rigData = rigData,
				})
			end
		end
	end

	return validRigs, existingRigInstances, nil
end

return RigSelectionValidationSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX215">
        <Properties>
          <string name="Name">RigService</string>
          <ProtectedString name="Source">local RigService = {}

local function buildMotorPath(motor, rig)
	local segments = {}
	local cursor = motor

	while cursor and cursor ~= rig do
		table.insert(segments, 1, cursor.Name)
		cursor = cursor.Parent
	end

	return rig.Name .. "/" .. table.concat(segments, "/")
end

local function getRigScale(rig)
	if not (rig and rig.Parent and rig:IsA("Model")) then
		return 1
	end

	local success, value = pcall(function()
		return rig:GetScale()
	end)
	if success and type(value) == "number" and value &gt; 0 then
		return value
	end
	return 1
end

local function getBoneTransform(bone)
	local success, value = pcall(function()
		return bone.Transform
	end)
	return success and typeof(value) == "CFrame" and value or CFrame.new()
end

local function setBoneTransform(bone, transform)
	if typeof(transform) ~= "CFrame" then
		return false
	end
	local success = pcall(function()
		bone.Transform = transform
	end)
	return success == true
end

local function getBoneWorldCFrame(bone)
	if not (bone and bone.Parent) then
		return nil
	end

	local success, value = pcall(function()
		return bone.TransformedWorldCFrame
	end)
	if success and typeof(value) == "CFrame" then
		return value
	end

	success, value = pcall(function()
		return bone.WorldCFrame
	end)
	if success and typeof(value) == "CFrame" then
		return value
	end

	local parentWorld = RigService.getBoneParentWorldCFrame(bone)
	if not parentWorld then
		return nil
	end
	return parentWorld * bone.CFrame * getBoneTransform(bone)
end

local function getBoneChainDirection(bone, boneWorld)
	if not (bone and bone.Parent and typeof(boneWorld) == "CFrame") then
		return nil
	end

	local bestChildDirection = nil
	local bestChildScore = -math.huge
	for _, child in ipairs(bone:GetChildren()) do
		if child:IsA("Bone") then
			local childWorld = getBoneWorldCFrame(child)
			if childWorld then
				local direction = childWorld.Position - boneWorld.Position
				if direction.Magnitude &gt; 0.0001 then
					direction = direction.Unit
					local score = math.abs(direction:Dot(boneWorld.UpVector))
					if score &gt; bestChildScore then
						bestChildScore = score
						bestChildDirection = direction
					end
				end
			end
		end
	end
	if bestChildDirection then
		return bestChildDirection
	end

	local parent = bone.Parent
	if parent and parent:IsA("Bone") then
		local parentWorld = getBoneWorldCFrame(parent)
		if parentWorld then
			local parentDirection = boneWorld.Position - parentWorld.Position
			if parentDirection.Magnitude &gt; 0.0001 then
				return parentDirection.Unit
			end
		end
	end

	return nil
end

local function makeBoneChainGizmoCFrame(bone)
	local boneWorld = getBoneWorldCFrame(bone)
	if not boneWorld then
		return nil
	end

	local chainDirection = getBoneChainDirection(bone, boneWorld)
	if not chainDirection then
		return boneWorld
	end

	local rawRight = boneWorld.RightVector
	local right = rawRight - chainDirection * rawRight:Dot(chainDirection)
	if right.Magnitude &lt;= 0.0001 then
		local fallback = math.abs(chainDirection:Dot(Vector3.yAxis)) &lt; 0.92 and Vector3.yAxis or Vector3.xAxis
		right = fallback - chainDirection * fallback:Dot(chainDirection)
	end
	if right.Magnitude &lt;= 0.0001 then
		return boneWorld
	end

	right = right.Unit
	local look = right:Cross(chainDirection)
	if look.Magnitude &lt;= 0.0001 then
		return boneWorld
	end
	look = look.Unit

	-- Bone rigs from DCC tools commonly use local Y as the visible bone-chain
	-- axis, but the roll around that axis can be arbitrary. Preserve the
	-- imported roll as much as possible while making the gizmo's green axis
	-- follow the actual parent/child bone direction.
	return CFrame.fromMatrix(boneWorld.Position, right, chainDirection, look)
end

local function addBoneTrack(motors, originalPose, bone, rig, rigScale, seenBones)
	if not (bone and bone.Parent and bone:IsA("Bone")) or seenBones[bone] then
		return
	end

	seenBones[bone] = true
	local path = buildMotorPath(bone, rig)
	local parentTrackPath = nil
	if bone.Parent and bone.Parent:IsA("Bone") then
		parentTrackPath = buildMotorPath(bone.Parent, rig)
	end

	table.insert(motors, {
		name = bone.Name,
		path = path,
		rig = rig,
		rigName = rig.Name,
		instance = bone,
		part0 = bone.Parent and bone.Parent.Name or "nil",
		part1 = bone.Name,
		jointType = "Bone",
		isBone = true,
		parentTrackPath = parentTrackPath,
		rigScale = rigScale,
	})
	originalPose[path] = getBoneTransform(bone)

	for _, child in ipairs(bone:GetChildren()) do
		if child:IsA("Bone") then
			addBoneTrack(motors, originalPose, child, rig, rigScale, seenBones)
		end
	end
end

local function addBoneTreeTracks(motors, originalPose, rig, rigScale)
	local seenBones = {}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Bone") and not (descendant.Parent and descendant.Parent:IsA("Bone")) then
			addBoneTrack(motors, originalPose, descendant, rig, rigScale, seenBones)
		end
	end
end

function RigService.describeRig(rig)
	local motors = {}
	local originalPose = {}
	local rigScale = getRigScale(rig)

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			local path = buildMotorPath(descendant, rig)
			table.insert(motors, {
				name = descendant.Name,
				path = path,
				rig = rig,
				rigName = rig.Name,
				instance = descendant,
				part0 = descendant.Part0 and descendant.Part0.Name or "nil",
				part1 = descendant.Part1 and descendant.Part1.Name or "nil",
				jointType = "Motor6D",
				rigScale = rigScale,
			})
			originalPose[path] = descendant.C0
		end
	end
	addBoneTreeTracks(motors, originalPose, rig, rigScale)

	table.sort(motors, function(a, b)
		return a.path &lt; b.path
	end)

	return {
		motors = motors,
		originalPose = originalPose,
	}
end

function RigService.isBoneJoint(jointData)
	local instance = jointData and jointData.instance
	return (jointData and (jointData.isBone == true or jointData.jointType == "Bone"))
		or (instance and instance:IsA("Bone"))
end

function RigService.getBoneParentWorldCFrame(bone)
	local parent = bone and bone.Parent
	if not parent then
		return nil
	end

	if parent:IsA("Bone") then
		return getBoneWorldCFrame(parent)
	end
	if parent:IsA("BasePart") then
		return parent.CFrame
	end
	if parent:IsA("Attachment") then
		return parent.WorldCFrame
	end
	if parent:IsA("Model") then
		return parent:GetPivot()
	end
	return nil
end

function RigService.getJointPose(jointData)
	local joint = jointData and jointData.instance
	if not joint or not joint.Parent then
		return nil
	end
	if RigService.isBoneJoint(jointData) then
		return getBoneTransform(joint)
	end
	return joint.C0
end

function RigService.setJointPose(jointData, pose)
	local joint = jointData and jointData.instance
	if not joint or not joint.Parent or typeof(pose) ~= "CFrame" then
		return false
	end
	if RigService.isBoneJoint(jointData) then
		return setBoneTransform(joint, pose)
	end
	joint.C0 = pose
	return true
end

function RigService.getJointWorldCFrame(jointData)
	local joint = jointData and jointData.instance
	if not joint or not joint.Parent then
		return nil
	end

	if RigService.isBoneJoint(jointData) then
		return getBoneWorldCFrame(joint)
	end

	if joint.Part0 then
		return joint.Part0.CFrame * joint.C0
	elseif joint.Part1 then
		return joint.Part1.CFrame
	end
	return nil
end

function RigService.getJointGizmoWorldCFrame(jointData)
	local joint = jointData and jointData.instance
	if RigService.isBoneJoint(jointData) and joint and joint.Parent then
		return makeBoneChainGizmoCFrame(joint)
	end
	return RigService.getJointWorldCFrame(jointData)
end

function RigService.applyJointWorldCFrame(jointData, jointWorldCFrame)
	local joint = jointData and jointData.instance
	if not joint or not joint.Parent or typeof(jointWorldCFrame) ~= "CFrame" then
		return false
	end

	if RigService.isBoneJoint(jointData) then
		local parentWorld = RigService.getBoneParentWorldCFrame(joint)
		if not parentWorld then
			return false
		end
		local localCFrame = parentWorld:ToObjectSpace(jointWorldCFrame)
		return setBoneTransform(joint, joint.CFrame:Inverse() * localCFrame)
	end

	if joint.Part0 then
		joint.C0 = joint.Part0.CFrame:ToObjectSpace(jointWorldCFrame)
		return true
	end
	return false
end

function RigService.capturePose(motors)
	local pose = {}
	for _, motorData in ipairs(motors) do
		local poseValue = RigService.getJointPose(motorData)
		if poseValue then
			pose[motorData.path] = poseValue
		end
	end
	return pose
end

function RigService.getMotorTransform(motorData)
	local motor = motorData and motorData.instance
	if not motor or not motor.Parent then
		return nil
	end

	local pose = RigService.getJointPose(motorData)
	if not pose then
		return nil
	end

	local x, y, z = pose.X, pose.Y, pose.Z
	local rx, ry, rz = pose:ToOrientation()

	return {
		position = {
			x = x,
			y = y,
			z = z,
		},
		rotation = {
			x = math.deg(rx),
			y = math.deg(ry),
			z = math.deg(rz),
		},
	}
end

function RigService.setMotorTransform(motorData, transform)
	local motor = motorData and motorData.instance
	if not motor or not motor.Parent then
		return false
	end

	local position = transform.position
	local rotation = transform.rotation
	return RigService.setJointPose(motorData, CFrame.new(position.x, position.y, position.z)
		* CFrame.fromOrientation(
			math.rad(rotation.x),
			math.rad(rotation.y),
			math.rad(rotation.z)
		))
end

function RigService.applyPose(motors, pose)
	local appliedCount = 0

	for _, motorData in ipairs(motors) do
		local c0 = pose[motorData.path]
		if c0 and RigService.setJointPose(motorData, c0) then
			appliedCount += 1
		end
	end

	return appliedCount
end

return RigService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX216">
        <Properties>
          <string name="Name">RigTrackHierarchyService</string>
          <ProtectedString name="Source">local RigTrackHierarchyService = {}

local R15_PARENT_BY_PART = {
	UpperTorso = "LowerTorso",
	Head = "UpperTorso",
	Neck = "UpperTorso",
	RightUpperArm = "UpperTorso",
	RightLowerArm = "RightUpperArm",
	RightHand = "RightLowerArm",
	LeftUpperArm = "UpperTorso",
	LeftLowerArm = "LeftUpperArm",
	LeftHand = "LeftLowerArm",
	RightUpperLeg = "LowerTorso",
	RightLowerLeg = "RightUpperLeg",
	RightFoot = "RightLowerLeg",
	LeftUpperLeg = "LowerTorso",
	LeftLowerLeg = "LeftUpperLeg",
	LeftFoot = "LeftLowerLeg",
}

local R15_CHILDREN_BY_PART = {}
for childName, parentName in pairs(R15_PARENT_BY_PART) do
	R15_CHILDREN_BY_PART[parentName] = R15_CHILDREN_BY_PART[parentName] or {}
	table.insert(R15_CHILDREN_BY_PART[parentName], childName)
end

local SORT_ORDER_BY_PART = {
	HumanoidRootPart = 10,
	LowerTorso = 20,
	UpperTorso = 30,
	Head = 40,
	Neck = 41,

	RightUpperArm = 50,
	RightLowerArm = 51,
	RightHand = 52,
	LeftUpperArm = 60,
	LeftLowerArm = 61,
	LeftHand = 62,

	RightUpperLeg = 70,
	RightLowerLeg = 71,
	RightFoot = 72,
	LeftUpperLeg = 80,
	LeftLowerLeg = 81,
	LeftFoot = 82,

	Torso = 20,
	["Right Arm"] = 50,
	["Left Arm"] = 60,
	["Right Leg"] = 70,
	["Left Leg"] = 80,
}

local function cleanName(name)
	return tostring(name or "")
end

local function partNameForTrack(track)
	return cleanName(track and (track.part1 or track.name or track.propertyName or track.path))
end

local function fallbackTrackName(track)
	return string.lower(partNameForTrack(track))
end

local function isPathAncestorOf(ancestorPath, descendantPath)
	ancestorPath = tostring(ancestorPath or "")
	descendantPath = tostring(descendantPath or "")
	if ancestorPath == "" or descendantPath == "" or ancestorPath == descendantPath then
		return false
	end
	return string.sub(descendantPath, 1, #ancestorPath + 1) == ancestorPath .. "/"
end

local function getSortOrder(track)
	local partName = partNameForTrack(track)
	return SORT_ORDER_BY_PART[partName] or 500
end

function RigTrackHierarchyService.compareRigTracks(a, b, fallbackCompare)
	local aPath = tostring(a and a.path or "")
	local bPath = tostring(b and b.path or "")
	if isPathAncestorOf(aPath, bPath) then
		return true
	elseif isPathAncestorOf(bPath, aPath) then
		return false
	end

	local aOrder = getSortOrder(a)
	local bOrder = getSortOrder(b)
	if aOrder ~= bOrder then
		return aOrder &lt; bOrder
	end

	if fallbackCompare then
		return fallbackCompare(a, b)
	end

	local aName = fallbackTrackName(a)
	local bName = fallbackTrackName(b)
	if aName ~= bName then
		return aName &lt; bName
	end
	return tostring(a and a.path or "") &lt; tostring(b and b.path or "")
end

local function getRigName(track)
	return track and (track.rigName or (track.rig and track.rig.Name)) or nil
end

local function ensureRigLookup(lookup, rigName)
	local key = tostring(rigName or "Rig")
	lookup[key] = lookup[key] or {}
	return lookup[key], key
end

function RigTrackHierarchyService.buildState(tracks, collapsedTracks)
	local pathByRigPart = {}
	local trackByPath = {}
	local childrenByParentPath = {}

	for _, track in ipairs(tracks or {}) do
		if (track.trackType or "Rig") == "Rig" then
			local rigLookup = ensureRigLookup(pathByRigPart, getRigName(track))
			rigLookup[partNameForTrack(track)] = track.path
			trackByPath[track.path] = track
			if track.parentTrackPath then
				childrenByParentPath[track.parentTrackPath] = true
			end
		end
	end

	local state = {
		metaByPath = {},
		hiddenByPath = {},
	}

	for _, track in ipairs(tracks or {}) do
		if (track.trackType or "Rig") ~= "Rig" then
			continue
		end

		local partName = partNameForTrack(track)
		local rigLookup = ensureRigLookup(pathByRigPart, getRigName(track))
		local depth = 0
		local hidden = false
		local parentPath = track.parentTrackPath
		local seenParentPaths = {}

		while parentPath and trackByPath[parentPath] and not seenParentPaths[parentPath] do
			seenParentPaths[parentPath] = true
			depth += 1
			if collapsedTracks and collapsedTracks[parentPath] == true then
				hidden = true
				break
			end
			parentPath = trackByPath[parentPath].parentTrackPath
		end

		local parentName = track.parentTrackPath and nil or R15_PARENT_BY_PART[partName]
		while parentName and not hidden do
			local parentPath = rigLookup[parentName]
			if parentPath then
				depth += 1
				if collapsedTracks and collapsedTracks[parentPath] == true then
					hidden = true
					break
				end
			end
			parentName = R15_PARENT_BY_PART[parentName]
		end

		local hasChildren = childrenByParentPath[track.path] == true
		for _, childName in ipairs(R15_CHILDREN_BY_PART[partName] or {}) do
			if rigLookup[childName] then
				hasChildren = true
				break
			end
		end

		state.metaByPath[track.path] = {
			depth = depth,
			hasChildren = hasChildren,
		}
		state.hiddenByPath[track.path] = hidden
	end

	return state
end

function RigTrackHierarchyService.arrangeDisplayTracksParentFirst(tracks)
	local trackByPath = {}
	for _, track in ipairs(tracks or {}) do
		if track.path then
			trackByPath[track.path] = track
		end
	end

	local rootTracks = {}
	local childrenByParentPath = {}
	for _, track in ipairs(tracks or {}) do
		local parentPath = track.parentTrackPath
		if parentPath and trackByPath[parentPath] then
			childrenByParentPath[parentPath] = childrenByParentPath[parentPath] or {}
			table.insert(childrenByParentPath[parentPath], track)
		else
			table.insert(rootTracks, track)
		end
	end

	local arranged = {}
	local emittedByPath = {}
	local function appendTrack(track)
		local path = track and track.path
		if not path or emittedByPath[path] then
			return
		end
		emittedByPath[path] = true
		table.insert(arranged, track)
		for _, childTrack in ipairs(childrenByParentPath[path] or {}) do
			appendTrack(childTrack)
		end
	end

	for _, track in ipairs(rootTracks) do
		appendTrack(track)
	end
	for _, track in ipairs(tracks or {}) do
		appendTrack(track)
	end
	return arranged
end

return RigTrackHierarchyService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX217">
        <Properties>
          <string name="Name">RigWorkspaceLockService</string>
          <ProtectedString name="Source">local RigWorkspaceLockService = {}

local LOCKED_ATTR = "MegMoWorkspaceLocked"
local ORIGINAL_LOCKED_ATTR = "MegMoOriginalLocked"

local function forEachRigPart(rig, callback)
	if not (rig and rig.Parent) then
		return 0
	end

	local count = 0
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			count += 1
			callback(descendant)
		end
	end
	return count
end

function RigWorkspaceLockService.lockRig(rig)
	return RigWorkspaceLockService.unlockRig(rig)
end

function RigWorkspaceLockService.unlockRig(rig)
	return forEachRigPart(rig, function(part)
		if part:GetAttribute(LOCKED_ATTR) == true then
			local originalLocked = part:GetAttribute(ORIGINAL_LOCKED_ATTR)
			part.Locked = type(originalLocked) == "boolean" and originalLocked or false
			part:SetAttribute(LOCKED_ATTR, nil)
			part:SetAttribute(ORIGINAL_LOCKED_ATTR, nil)
		end
	end)
end

function RigWorkspaceLockService.lockTimelineRigs(timeline)
	return RigWorkspaceLockService.unlockTimelineRigs(timeline)
end

function RigWorkspaceLockService.unlockTimelineRigs(timeline)
	if not (timeline and type(timeline.getRigs) == "function") then
		return 0
	end

	local count = 0
	for _, rig in ipairs(timeline:getRigs()) do
		count += RigWorkspaceLockService.unlockRig(rig)
	end
	return count
end

function RigWorkspaceLockService.syncFromSelection(timeline, selectedJointPath, selectedTrackPaths, selectedKeys, selectionState)
	return RigWorkspaceLockService.unlockTimelineRigs(timeline)
end

function RigWorkspaceLockService.unlockTaggedDescendants(root)
	root = root or workspace
	if not root then
		return 0
	end

	local count = 0
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant:GetAttribute(LOCKED_ATTR) == true then
			local originalLocked = descendant:GetAttribute(ORIGINAL_LOCKED_ATTR)
			descendant.Locked = type(originalLocked) == "boolean" and originalLocked or false
			descendant:SetAttribute(LOCKED_ATTR, nil)
			descendant:SetAttribute(ORIGINAL_LOCKED_ATTR, nil)
			count += 1
		end
	end
	return count
end

return RigWorkspaceLockService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX218">
        <Properties>
          <string name="Name">SaveExportService</string>
          <ProtectedString name="Source">local HttpService = game:GetService("HttpService")
local ServerStorage = game:GetService("ServerStorage")

local AnimationMarkerExportService = require(script.Parent:WaitForChild("AnimationMarkerExportService"))

local SaveExportService = {}

local MAX_SAVE_CHUNK_LENGTH = 190000
local SAVE_FOLDER_NAME = "MegMoAnimatorSaves"
local EXPORT_FOLDER_NAME = "MegMoAnimatorExports"
local MOTION_RECIPE_FOLDER_NAME = "MegMoAnimatorMotionRecipes"
local MOTION_RECIPE_ENTRY_TYPE = "MotionRecipe"
local AUTOSAVE_FOLDER_NAME = "MegMoAnimatorAutosaves"
local AUTOSAVE_ENTRY_NAME = "Autosave - Recovery"
local SAVE_BACKUP_FOLDER_NAME = "MegMoAnimatorSaveBackups"

local getSavedProjectFolders
local getRecoverableProjectFolders
local readSavedProjectPayload

local function endsWith(text, suffix)
	text = tostring(text or "")
	suffix = tostring(suffix or "")
	return suffix ~= "" and #text &gt;= #suffix and string.sub(text, #text - #suffix + 1) == suffix
end

local function appendFolderIfUnique(folders, folder)
	if not folder or not folder:IsA("Folder") then
		return
	end
	for _, existing in ipairs(folders) do
		if existing == folder then
			return
		end
	end
	table.insert(folders, folder)
end

local function appendMatchingServerStorageFolders(folders, suffixes)
	for _, child in ipairs(ServerStorage:GetChildren()) do
		if child:IsA("Folder") then
			for _, suffix in ipairs(suffixes) do
				if endsWith(child.Name, suffix) then
					appendFolderIfUnique(folders, child)
					break
				end
			end
		end
	end
end

local function makeStorageEntryId(instance)
	local folder = instance and instance.Parent
	if not folder then
		return instance and instance.Name or ""
	end
	return folder.Name .. "/" .. instance.Name
end

local function findSavedProjectByStorageId(storageId)
	storageId = tostring(storageId or "")
	local folderName, childName = string.match(storageId, "^([^/]+)/(.+)$")
	if not folderName or not childName then
		return nil
	end

	for _, folder in ipairs(getRecoverableProjectFolders()) do
		if folder.Name == folderName then
			local value = folder:FindFirstChild(childName)
			if value and (value:IsA("StringValue") or value:IsA("Folder")) then
				return value
			end
			return nil
		end
	end
	return nil
end

local function getProjectFolder(folderName)
	local root = ServerStorage:FindFirstChild(folderName)
	if not root then
		root = Instance.new("Folder")
		root.Name = folderName
		root.Parent = ServerStorage
	end
	return root
end

function getSavedProjectFolders()
	local folders = {}
	local primary = ServerStorage:FindFirstChild(SAVE_FOLDER_NAME)
	appendFolderIfUnique(folders, primary)
	local autosaves = ServerStorage:FindFirstChild(AUTOSAVE_FOLDER_NAME)
	appendFolderIfUnique(folders, autosaves)
	appendMatchingServerStorageFolders(folders, { "AnimatorSaves", "AnimatorAutosaves" })
	return folders
end

function getRecoverableProjectFolders()
	local folders = getSavedProjectFolders()
	local backups = ServerStorage:FindFirstChild(SAVE_BACKUP_FOLDER_NAME)
	appendFolderIfUnique(folders, backups)
	return folders
end

local function findSavedProjectByName(saveName)
	saveName = tostring(saveName or "")
	for _, folder in ipairs(getSavedProjectFolders()) do
		local value = folder:FindFirstChild(saveName)
		if value and (value:IsA("StringValue") or value:IsA("Folder")) then
			return value
		end
	end
	return nil
end

local function getMotionRecipeFolders()
	local folders = {}
	local primary = ServerStorage:FindFirstChild(MOTION_RECIPE_FOLDER_NAME)
	appendFolderIfUnique(folders, primary)
	appendMatchingServerStorageFolders(folders, { "AnimatorMotionRecipes" })
	return folders
end

local function findMotionRecipeByName(recipeName)
	recipeName = tostring(recipeName or "")
	for _, folder in ipairs(getMotionRecipeFolders()) do
		local value = folder:FindFirstChild(recipeName)
		if value and value:IsA("StringValue") then
			return value, folder
		end
	end
	return nil, nil
end

local function safeInstanceName(name)
	name = tostring(name or "Untitled")
	name = string.gsub(name, "[^%w%s_%-]", "")
	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	if name == "" then
		return "Untitled Animation"
	end
	return name
end

local function clearExistingSaveEntry(folder, saveName)
	local existing = folder:FindFirstChild(saveName)
	if existing then
		existing:Destroy()
	end
end

local function getIsoAttributeSortTime(instance, attributeName)
	local value = instance and instance:GetAttribute(attributeName)
	if type(value) ~= "string" or value == "" then
		return 0
	end
	local year, month, day, hour, minute, second = string.match(value, "^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):(%d+)Z$")
	if not year then
		return 0
	end
	return tonumber(year .. month .. day .. hour .. minute .. second) or 0
end

local function getSavedAtSortTime(instance)
	return getIsoAttributeSortTime(instance, "SavedAt")
end

local function isSaveEntryInstance(instance)
	return instance and (instance:IsA("StringValue") or instance:IsA("Folder"))
end

local function detachSaveEntry(instance)
	if not instance or instance.Parent == nil then
		return
	end
	local success = pcall(function()
		instance.Parent = nil
	end)
	if not success then
		pcall(function()
			instance:Destroy()
		end)
	end
end

local function pruneAutosaveFolder(folder)
	if not folder then
		return 0
	end

	local keep = folder:FindFirstChild(AUTOSAVE_ENTRY_NAME)
	if not isSaveEntryInstance(keep) then
		keep = nil
	end

	if not keep then
		local newest = nil
		local newestSortTime = -1
		for _, child in ipairs(folder:GetChildren()) do
			if isSaveEntryInstance(child) then
				local sortTime = getSavedAtSortTime(child)
				if sortTime &gt;= newestSortTime then
					newest = child
					newestSortTime = sortTime
				end
			end
		end
		if newest then
			keep = newest
			keep.Name = AUTOSAVE_ENTRY_NAME
		end
	end

	local removed = 0
	for _, child in ipairs(folder:GetChildren()) do
		if child ~= keep and isSaveEntryInstance(child) then
			detachSaveEntry(child)
			removed += 1
		end
	end
	return removed
end

local function applySaveMetadata(instance, buildInfo)
	instance:SetAttribute("SavedAt", os.date("!%Y-%m-%dT%H:%M:%SZ"))
	instance:SetAttribute("BuildId", buildInfo.BUILD_ID)
end

local function uniqueChildName(folder, baseName)
	local safeBase = safeInstanceName(baseName)
	local candidate = safeBase
	local suffix = 2
	while folder and folder:FindFirstChild(candidate) do
		candidate = string.format("%s %d", safeBase, suffix)
		suffix += 1
	end
	return candidate
end

local function getSaveTimestampSuffix()
	return os.date("!%Y%m%d-%H%M%S") .. "-" .. tostring(math.floor((os.clock() % 1) * 1000))
end

local function writeChunkedSave(folder, saveName, encoded, buildInfo)
	local saveFolder = Instance.new("Folder")
	saveFolder.Name = saveName
	saveFolder:SetAttribute("EntryType", "ChunkedProject")
	saveFolder:SetAttribute("ChunkCount", math.max(1, math.ceil(#encoded / MAX_SAVE_CHUNK_LENGTH)))
	applySaveMetadata(saveFolder, buildInfo)

	local chunkIndex = 1
	local startIndex = 1
	while startIndex &lt;= #encoded do
		local chunkValue = Instance.new("StringValue")
		chunkValue.Name = string.format("Chunk%03d", chunkIndex)
		chunkValue.Value = string.sub(encoded, startIndex, startIndex + MAX_SAVE_CHUNK_LENGTH - 1)
		chunkValue.Parent = saveFolder
		chunkIndex += 1
		startIndex += MAX_SAVE_CHUNK_LENGTH
	end
	saveFolder.Parent = folder
	return saveFolder
end

local function writeSingleSave(folder, saveName, encoded, buildInfo)
	local value = Instance.new("StringValue")
	value.Name = saveName
	value.Value = encoded
	value:SetAttribute("EntryType", "Project")
	applySaveMetadata(value, buildInfo)
	value.Parent = folder
	return value
end

local function writeSaveEntry(folder, saveName, encoded, buildInfo)
	if #encoded &gt;= 200000 then
		return writeChunkedSave(folder, saveName, encoded, buildInfo)
	end
	return writeSingleSave(folder, saveName, encoded, buildInfo)
end

local function validateWrittenSave(instance, encoded)
	if not instance then
		return false, "Roblox did not create the save entry."
	end
	local payload, payloadError = readSavedProjectPayload(instance)
	if not payload then
		return false, payloadError or "The save could not be read back after writing."
	end
	if payload ~= encoded then
		return false, "The save verification failed because the written data did not match the project."
	end
	return true
end

local function removeExistingBackupForProject(backupFolder, backupOf)
	for _, child in ipairs(backupFolder:GetChildren()) do
		if isSaveEntryInstance(child) and child:GetAttribute("BackupOf") == backupOf then
			child:Destroy()
		end
	end
end

local function moveExistingSaveToBackup(existing, saveName)
	local backupFolder = getProjectFolder(SAVE_BACKUP_FOLDER_NAME)
	removeExistingBackupForProject(backupFolder, saveName)
	local backupName = uniqueChildName(backupFolder, saveName .. " - Previous Save")
	existing.Parent = backupFolder
	existing.Name = backupName
	existing:SetAttribute("BackupOf", saveName)
	existing:SetAttribute("BackupCreatedAt", os.date("!%Y-%m-%dT%H:%M:%SZ"))
end

local function atomicWriteSaveEntry(folder, saveName, encoded, buildInfo, options)
	options = options or {}
	local tempName = uniqueChildName(folder, "__MegMoSaving " .. saveName .. " " .. getSaveTimestampSuffix())
	local tempEntry = nil
	local oldEntry = nil

	local ok, result = pcall(function()
		tempEntry = writeSaveEntry(folder, tempName, encoded, buildInfo)
		local verified, verifyMessage = validateWrittenSave(tempEntry, encoded)
		if not verified then
			error(verifyMessage or "Save verification failed.", 0)
		end

		oldEntry = folder:FindFirstChild(saveName)
		if oldEntry and oldEntry ~= tempEntry then
			if options.backupExisting then
				moveExistingSaveToBackup(oldEntry, saveName)
			else
				oldEntry.Name = uniqueChildName(folder, "__MegMoPrevious " .. saveName .. " " .. getSaveTimestampSuffix())
			end
		end

		tempEntry.Name = saveName
		if oldEntry and oldEntry.Parent == folder and not options.backupExisting then
			if options.detachExisting then
				detachSaveEntry(oldEntry)
			else
				oldEntry:Destroy()
			end
		end
		return tempEntry
	end)

	if not ok then
		if tempEntry and tempEntry.Parent then
			tempEntry:Destroy()
		end
		return nil, tostring(result)
	end

	return result
end

local function clearSaveEntryChildren(saveFolder)
	for _, child in ipairs(saveFolder:GetChildren()) do
		detachSaveEntry(child)
	end
end

local function writeChunkedSaveInPlace(saveFolder, encoded, buildInfo)
	saveFolder:SetAttribute("EntryType", "ChunkedProject")
	saveFolder:SetAttribute("ChunkCount", math.max(1, math.ceil(#encoded / MAX_SAVE_CHUNK_LENGTH)))
	applySaveMetadata(saveFolder, buildInfo)
	clearSaveEntryChildren(saveFolder)

	local chunkIndex = 1
	local startIndex = 1
	while startIndex &lt;= #encoded do
		local chunkValue = Instance.new("StringValue")
		chunkValue.Name = string.format("Chunk%03d", chunkIndex)
		chunkValue.Value = string.sub(encoded, startIndex, startIndex + MAX_SAVE_CHUNK_LENGTH - 1)
		chunkValue.Parent = saveFolder
		chunkIndex += 1
		startIndex += MAX_SAVE_CHUNK_LENGTH
	end
	return saveFolder
end

local function writeAutoSaveEntry(folder, saveName, encoded, buildInfo)
	local existing = folder:FindFirstChild(saveName)
	if existing and existing:IsA("StringValue") and #encoded &lt; 200000 then
		existing.Value = encoded
		existing:SetAttribute("EntryType", "Project")
		existing:SetAttribute("ChunkCount", nil)
		applySaveMetadata(existing, buildInfo)
		local verified, verifyMessage = validateWrittenSave(existing, encoded)
		if not verified then
			return nil, verifyMessage
		end
		return existing
	end

	if existing and existing:IsA("Folder") then
		local savedInstance = writeChunkedSaveInPlace(existing, encoded, buildInfo)
		local verified, verifyMessage = validateWrittenSave(savedInstance, encoded)
		if not verified then
			return nil, verifyMessage
		end
		return savedInstance
	end

	return atomicWriteSaveEntry(folder, saveName, encoded, buildInfo, {
		backupExisting = false,
		detachExisting = true,
	})
end

function readSavedProjectPayload(instance)
	if not instance then
		return nil, "That 7kg2 Animator save could not be found."
	end

	if instance:IsA("StringValue") then
		if instance.Value == "" then
			return nil, "That save is empty. It was likely created by an older broken build when the project exceeded Roblox's StringValue size limit."
		end
		return instance.Value
	end

	if instance:IsA("Folder") then
		local namedChunks = {}
		local namedChunkCount = 0
		local fallbackChunks = {}
		for _, child in ipairs(instance:GetChildren()) do
			if child:IsA("StringValue") then
				local chunkNumber = tonumber(string.match(child.Name, "^Chunk(%d+)$"))
				if chunkNumber then
					namedChunks[chunkNumber] = child
					namedChunkCount += 1
				else
					table.insert(fallbackChunks, child)
				end
			end
		end

		if namedChunkCount &gt; 0 then
			local expectedChunkCount = tonumber(instance:GetAttribute("ChunkCount")) or namedChunkCount
			if namedChunkCount ~= expectedChunkCount then
				return nil, string.format("That save is missing one or more data chunks (%d of %d found).", namedChunkCount, expectedChunkCount)
			end
			local parts = {}
			for index = 1, expectedChunkCount do
				local chunk = namedChunks[index]
				if not chunk then
					return nil, string.format("That save is missing data chunk %03d.", index)
				end
				table.insert(parts, chunk.Value)
			end
			return table.concat(parts)
		end

		table.sort(fallbackChunks, function(a, b)
			return a.Name &lt; b.Name
		end)
		if #fallbackChunks == 0 then
			return nil, "That 7kg2 Animator save folder is empty."
		end
		local parts = {}
		for _, chunk in ipairs(fallbackChunks) do
			table.insert(parts, chunk.Value)
		end
		return table.concat(parts)
	end

	return nil, "That 7kg2 Animator save format is not supported."
end

local function collectSavedRigNames(data)
	local rigNames = {}
	local seen = {}
	for _, track in ipairs(type(data.tracks) == "table" and data.tracks or {}) do
		local rigName = nil
		if track.trackType == "Rig" then
			rigName = track.rigName
			if not rigName and type(track.path) == "string" then
				rigName = string.match(track.path, "^([^/]+)/")
			end
		elseif track.trackType == "Rig Group" then
			rigName = track.rigName or track.part0
		elseif track.trackType == "Rig Property" then
			rigName = track.rigName or track.part0
		end
		if rigName and not seen[rigName] then
			seen[rigName] = true
			table.insert(rigNames, rigName)
		end
	end
	table.sort(rigNames)
	return rigNames
end

local function decodeSavedProjectData(instance)
	local payload, payloadError = readSavedProjectPayload(instance)
	if not payload then
		return nil, payloadError or "That save file could not be read."
	end

	local decodeSuccess, dataOrError = pcall(function()
		return HttpService:JSONDecode(payload)
	end)
	if not decodeSuccess or type(dataOrError) ~= "table" then
		return nil, "That save file could not be read."
	end
	return dataOrError
end

local function getRelativeRigTrackPath(path, rigName)
	if type(path) ~= "string" or type(rigName) ~= "string" or rigName == "" then
		return nil
	end
	local prefix = rigName .. "/"
	if string.sub(path, 1, #prefix) ~= prefix then
		return nil
	end
	return string.sub(path, #prefix + 1)
end

local function findSavedProject(saveName)
	return findSavedProjectByStorageId(saveName)
		or findSavedProjectByName(saveName)
end

function SaveExportService.inspectSavedProjectRigTarget(saveName, targetRig, deps)
	deps = deps or {}
	if not (targetRig and targetRig.Parent and targetRig:IsA("Model")) then
		return nil, "Select one workspace rig before choosing Import onto Selected Rig."
	end
	if not (deps.rigService and type(deps.rigService.describeRig) == "function") then
		return nil, "Rig compatibility could not be checked."
	end

	local instance = findSavedProject(saveName)
	if not instance or (not instance:IsA("StringValue") and not instance:IsA("Folder")) then
		return nil, "That 7kg2 Animator save could not be found."
	end

	local data, dataError = decodeSavedProjectData(instance)
	if not data then
		return nil, dataError
	end

	local savedRigNames = collectSavedRigNames(data)
	if #savedRigNames == 0 then
		return nil, "That project does not contain a saved rig."
	end
	if #savedRigNames ~= 1 then
		return nil, string.format(
			"Import onto Selected Rig currently supports single-rig projects. This save contains %d rigs.",
			#savedRigNames
		)
	end

	local sourceRigName = savedRigNames[1]
	local targetRigData = deps.rigService.describeRig(targetRig)
	local targetRelativePaths = {}
	for _, motorData in ipairs(targetRigData.motors or {}) do
		local relativePath = getRelativeRigTrackPath(motorData.path, targetRig.Name)
		if relativePath then
			targetRelativePaths[relativePath] = true
		end
	end

	local savedRelativePaths = {}
	for _, track in ipairs(type(data.tracks) == "table" and data.tracks or {}) do
		if track.trackType == "Rig" then
			local relativePath = getRelativeRigTrackPath(track.path, sourceRigName)
			if relativePath then
				savedRelativePaths[relativePath] = true
			end
		end
	end

	local savedJointCount = 0
	local matchedJointCount = 0
	local unmatchedPaths = {}
	for relativePath in pairs(savedRelativePaths) do
		savedJointCount += 1
		if targetRelativePaths[relativePath] then
			matchedJointCount += 1
		else
			table.insert(unmatchedPaths, relativePath)
		end
	end
	table.sort(unmatchedPaths)

	if savedJointCount == 0 then
		return nil, "That project does not contain any saved rig joint tracks."
	end

	return {
		instance = instance,
		saveName = instance.Name,
		sourceRigName = sourceRigName,
		targetRig = targetRig,
		targetRigName = targetRig.Name,
		savedJointCount = savedJointCount,
		matchedJointCount = matchedJointCount,
		unmatchedPaths = unmatchedPaths,
		compatible = #unmatchedPaths == 0,
	}
end

local function prepareRigForProjectLoad(rig, deps)
	if not (rig and rig.Parent) then
		return rig
	end
	if type(deps.prepareRigForBinding) == "function" then
		deps.prepareRigForBinding(rig)
		return rig
	end
	local success, rigInsertService = pcall(function()
		return require(script.Parent:WaitForChild("RigInsertService"))
	end)
	if success and rigInsertService then
		if type(rigInsertService.prepareExternalRigForBinding) == "function" then
			rigInsertService.prepareExternalRigForBinding(rig)
		elseif type(rigInsertService.rebindAvatarAccessories) == "function" then
			rigInsertService.rebindAvatarAccessories(rig)
		end
	end
	return rig
end

local function getSavedProjectBrowserEntry(instance)
	if not instance then
		return nil
	end

	local savedAt = instance:GetAttribute("SavedAt")
	local buildId = instance:GetAttribute("BuildId")
	local category = "Project"
	local source = "7kg2 Animator Save"
	local creatorName = buildId
	local priceLabel = savedAt
	local sortTime = 0
	local isAutosave = instance.Parent and instance.Parent.Name == AUTOSAVE_FOLDER_NAME
	local isBackup = instance.Parent and instance.Parent.Name == SAVE_BACKUP_FOLDER_NAME

	if type(savedAt) == "string" and savedAt ~= "" then
		local year, month, day, hour, minute, second = string.match(savedAt, "^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):(%d+)Z$")
		if year then
			sortTime = tonumber(year .. month .. day .. hour .. minute .. second) or 0
		end
	end

	if instance:IsA("Folder") then
		local chunkCount = tonumber(instance:GetAttribute("ChunkCount")) or 0
		category = "Chunked Project"
		source = string.format("7kg2 Animator Save (%d chunks)", math.max(1, chunkCount))
	elseif instance:IsA("StringValue") and instance.Value == "" then
		category = "Broken Save"
		source = "Legacy empty save"
		priceLabel = "Not recoverable"
	end
	if isAutosave then
		category = "Autosave"
		source = "7kg2 Recovery Autosave"
		priceLabel = instance:GetAttribute("ProjectName") or savedAt
	end
	if isBackup then
		category = "Backup"
		source = "7kg2 Save Backup"
		priceLabel = "Backup of " .. tostring(instance:GetAttribute("BackupOf") or "project")
		local backupSortTime = getIsoAttributeSortTime(instance, "BackupCreatedAt")
		if backupSortTime &gt; 0 then
			sortTime = backupSortTime
		end
	end

	return {
		id = makeStorageEntryId(instance),
		numericId = instance.Name,
		name = instance.Name,
		source = source,
		category = category,
		creatorName = creatorName,
		priceLabel = priceLabel,
		entryType = "SavedProject",
		sortTime = sortTime,
	}
end

local function getMotionRecipeBrowserEntry(instance)
	if not instance or not instance:IsA("StringValue") then
		return nil
	end

	local savedAt = instance:GetAttribute("SavedAt")
	local buildId = instance:GetAttribute("BuildId")
	local sortTime = 0
	if type(savedAt) == "string" and savedAt ~= "" then
		local year, month, day, hour, minute, second = string.match(savedAt, "^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):(%d+)Z$")
		if year then
			sortTime = tonumber(year .. month .. day .. hour .. minute .. second) or 0
		end
	end

	return {
		id = instance.Name,
		numericId = instance.Name,
		name = instance.Name,
		source = "Motion Builder Recipe",
		category = "Motion Recipe",
		creatorName = buildId,
		priceLabel = savedAt,
		entryType = MOTION_RECIPE_ENTRY_TYPE,
		sortTime = sortTime,
	}
end

local function decodeRecipeValue(instance)
	if not instance or not instance:IsA("StringValue") then
		return nil, "That Motion Builder recipe could not be found."
	end
	if instance.Value == "" then
		return nil, "That Motion Builder recipe is empty."
	end

	local ok, dataOrError = pcall(function()
		return HttpService:JSONDecode(instance.Value)
	end)
	if not ok or type(dataOrError) ~= "table" then
		return nil, "That Motion Builder recipe could not be read."
	end
	return dataOrError
end

local function resolveDataModelPath(pathText)
	local normalized = tostring(pathText or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if normalized == "" then
		return nil
	end

	normalized = normalized:gsub("^game%.", "")
	local segments = string.split(normalized, ".")
	if #segments == 0 then
		return nil
	end

	local roots = {
		Workspace = workspace,
		ServerStorage = ServerStorage,
	}
	local current = roots[segments[1]]
	if not current then
		return nil
	end

	for index = 2, #segments do
		local segment = segments[index]
		if current == workspace and segment == "Camera" then
			current = workspace.CurrentCamera
		else
			current = current and current:FindFirstChild(segment)
		end
		if not current then
			return nil
		end
	end

	return current
end

local function resolveWorkspaceRigByName(rigService, rigName, deps)
	if type(rigName) ~= "string" or rigName == "" then
		return nil
	end

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") and descendant.Name == rigName then
			prepareRigForProjectLoad(descendant, deps or {})
			local rigData = rigService.describeRig(descendant)
			if #rigData.motors &gt; 0 then
				return descendant
			end
		end
	end

	return nil
end

local function getEnumItem(enumType, name, fallbackName)
	local success, value = pcall(function()
		return enumType[name]
	end)
	if success and value then
		return value
	end

	return enumType[fallbackName]
end

local function getExportEasingStyle(styleName)
	local styleMap = {
		None = "Constant",
		Linear = "Linear",
		Constant = "Constant",
		Bounce = "Bounce",
		Elastic = "Elastic",
		Cubic = "Cubic",
		Sine = "Cubic",
		Quad = "Cubic",
		Quart = "Cubic",
		Quint = "Cubic",
		Sextic = "Cubic",
		Back = "Cubic",
		Exponential = "Cubic",
		Circular = "Cubic",
	}

	return getEnumItem(Enum.PoseEasingStyle, styleMap[styleName] or "Linear", "Linear")
end

local function getExportEasingDirection(directionName)
	local directionMap = {
		In = "In",
		Out = "Out",
		InOut = "InOut",
	}

	return getEnumItem(Enum.PoseEasingDirection, directionMap[directionName] or "InOut", "InOut")
end

local function collectRigExportFrames(timeline, sortFrames, motors)
	local motorPaths = {}
	for _, motorData in ipairs(motors) do
		motorPaths[motorData.path] = true
	end

	local frames = {}
	local seen = {}
	local hasRigKeys = false
	for _, frame in ipairs(timeline:getKeyframeFrames()) do
		for path in pairs(motorPaths) do
			if timeline:hasTrackKeyframe(path, frame) then
				if not seen[frame] then
					seen[frame] = true
					table.insert(frames, frame)
				end
				hasRigKeys = true
				break
			end
		end
	end

	if hasRigKeys and not seen[0] then
		seen[0] = true
		table.insert(frames, 1, 0)
	end
	if hasRigKeys then
		AnimationMarkerExportService.addMarkerFrames(timeline, frames, seen)
	end

	sortFrames(frames)
	return frames
end

local function buildMotorHierarchy(motors)
	local childrenByPart0 = {}
	local part1Lookup = {}
	for _, motorData in ipairs(motors) do
		local motor = motorData.instance
		if motor and motor.Parent and motor.Part0 and motor.Part1 then
			childrenByPart0[motor.Part0] = childrenByPart0[motor.Part0] or {}
			table.insert(childrenByPart0[motor.Part0], motorData)
			part1Lookup[motor.Part1] = true
		end
	end

	for _, children in pairs(childrenByPart0) do
		table.sort(children, function(a, b)
			return tostring(a.path) &lt; tostring(b.path)
		end)
	end

	local rootParts = {}
	local seenRootParts = {}
	for _, motorData in ipairs(motors) do
		local motor = motorData.instance
		local part0 = motor and motor.Part0
		if part0 and not part1Lookup[part0] and not seenRootParts[part0] then
			seenRootParts[part0] = true
			table.insert(rootParts, part0)
		end
	end

	table.sort(rootParts, function(a, b)
		return a.Name &lt; b.Name
	end)

	if #rootParts == 0 then
		for _, motorData in ipairs(motors) do
			local part0 = motorData.instance and motorData.instance.Part0
			if part0 then
				table.insert(rootParts, part0)
				break
			end
		end
	end

	return childrenByPart0, rootParts
end

local function getOutgoingPoseEasingOptions(timeline, path, frame)
	for _, keyFrame in ipairs(timeline:getTrackKeyframeFrames(path)) do
		if keyFrame &gt; frame then
			return timeline:getKeyOptions(path, keyFrame)
		end
	end
	return timeline:getKeyOptions(path, frame)
end

local function assignPoseEasing(timeline, pose, path, frame)
	local options = getOutgoingPoseEasingOptions(timeline, path, frame)
	pose.EasingStyle = getExportEasingStyle(options.easingStyle)
	pose.EasingDirection = getExportEasingDirection(options.easingDirection)
end

local function createPoseForMotor(timeline, motorData, framePose, frame)
	local motor = motorData.instance
	if not motor or not motor.Parent or not motor.Part1 then
		return nil
	end

	local pose = Instance.new("Pose")
	pose.Name = motor.Part1.Name
	pose.Weight = 1

	local keyedC0 = framePose and framePose[motorData.path]
	local originalC0 = timeline:getOriginalPose(motorData.path)
	if typeof(keyedC0) == "CFrame" and typeof(originalC0) == "CFrame" then
		pose.CFrame = originalC0:ToObjectSpace(keyedC0)
	else
		pose.CFrame = CFrame.new()
	end

	assignPoseEasing(timeline, pose, motorData.path, frame)
	return pose
end

local function appendMotorPoses(timeline, parentPose, part0, childrenByPart0, framePose, frame)
	for _, childMotorData in ipairs(childrenByPart0[part0] or {}) do
		local childPose = createPoseForMotor(timeline, childMotorData, framePose, frame)
		if childPose then
			childPose.Parent = parentPose
			appendMotorPoses(timeline, childPose, childMotorData.instance.Part1, childrenByPart0, framePose, frame)
		end
	end
end

local function shouldWriteMotorPoses(timeline, motors, frame)
	if frame == 0 then
		return true
	end
	for _, motorData in ipairs(motors) do
		if timeline:hasTrackKeyframe(motorData.path, frame) then
			return true
		end
	end
	return false
end

local function buildKeyframeSequence(timeline, buildInfo, motors, frames, sequenceName)
	local childrenByPart0, rootParts = buildMotorHierarchy(motors)
	local markersByFrame = AnimationMarkerExportService.collectByFrame(timeline)
	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = sequenceName or (safeInstanceName(timeline:getAnimationName()) .. "_KeyframeSequence")
	sequence:SetAttribute("BuildId", buildInfo.BUILD_ID)
	sequence:SetAttribute("ExportedAt", os.date("!%Y-%m-%dT%H:%M:%SZ"))
	sequence:SetAttribute("SourceAnimation", timeline:getAnimationName())

	pcall(function()
		sequence.Loop = timeline:getLooping()
	end)
	pcall(function()
		sequence.Priority = getEnumItem(Enum.AnimationPriority, timeline:getPriority(), "Action")
	end)

	for _, frame in ipairs(frames) do
		local framePose = timeline:samplePose(frame)
		local keyframe = Instance.new("Keyframe")
		keyframe.Name = string.format("Frame_%d", frame)
		keyframe.Time = frame / timeline:getFps()
		keyframe.Parent = sequence
		AnimationMarkerExportService.appendMarkersToKeyframe(keyframe, markersByFrame[frame])

		if shouldWriteMotorPoses(timeline, motors, frame) then
			for _, rootPart in ipairs(rootParts) do
				local rootPose = Instance.new("Pose")
				rootPose.Name = rootPart.Name
				rootPose.Weight = 0
				rootPose.CFrame = CFrame.new()
				rootPose.Parent = keyframe
				appendMotorPoses(timeline, rootPose, rootPart, childrenByPart0, framePose, frame)
			end
		end
	end

	return sequence
end

local function tryOpenRobloxSaveDialog(plugin, selectionService, sequence)
	selectionService.setSelection({ sequence })
	local success = pcall(function()
		plugin:SaveSelectedToRoblox()
	end)
	return success
end

local function collectRigExportEntries(timeline, sortFrames)
	local entries = {}
	local entryByRig = {}
	local entryByName = {}
	for _, rig in ipairs(timeline:getRigs() or {}) do
		if rig and rig.Parent then
			local entry = {
				rig = rig,
				rigName = rig.Name,
				motors = {},
			}
			entryByRig[rig] = entry
			entryByName[rig.Name] = entry
		end
	end

	for _, motorData in ipairs(timeline:getMotors() or {}) do
		local motor = motorData.instance
		if motor and motor:IsA("Motor6D") and not timeline:isTrackDisabled(motorData.path) then
			local entry = entryByRig[motorData.rig] or entryByName[motorData.rigName]
			if entry then
				table.insert(entry.motors, motorData)
			end
		end
	end

	for _, rig in ipairs(timeline:getRigs() or {}) do
		local entry = entryByRig[rig]
		if entry and #entry.motors &gt; 0 then
			entry.frames = collectRigExportFrames(timeline, sortFrames, entry.motors)
			if #entry.frames &gt; 0 then
				table.insert(entries, entry)
			end
		end
	end

	return entries
end

function SaveExportService.getRigExportSummary(timeline, sortFrames)
	local summary = {
		rigCount = 0,
		rigs = {},
	}
	if not timeline or type(sortFrames) ~= "function" then
		return summary
	end
	for _, entry in ipairs(collectRigExportEntries(timeline, sortFrames)) do
		table.insert(summary.rigs, {
			rig = entry.rig,
			name = entry.rigName,
			keyframeCount = #entry.frames,
		})
	end
	summary.rigCount = #summary.rigs
	return summary
end

function SaveExportService.isSavedProjectInstance(instance)
	if instance == nil or (not instance:IsA("StringValue") and not instance:IsA("Folder")) then
		return false
	end
	for _, savesFolder in ipairs(getRecoverableProjectFolders()) do
		if instance.Parent == savesFolder then
			return true
		end
	end
	return false
end

function SaveExportService.pruneAutoSaves()
	local folder = ServerStorage:FindFirstChild(AUTOSAVE_FOLDER_NAME)
	if not folder then
		return 0
	end
	return pruneAutosaveFolder(folder)
end

function SaveExportService.saveAnimation(timeline, buildInfo, extra)
	local saveExtra = extra
	if type(saveExtra) ~= "table" or (saveExtra.groups == nil and saveExtra.motionBuilder == nil) then
		saveExtra = {
			groups = extra or {},
		}
	end
	local dataSuccess, dataOrError = pcall(function()
		return timeline:toSaveData(saveExtra)
	end)
	if not dataSuccess or type(dataOrError) ~= "table" then
		return false, "Save failed before writing. Your previous save was not changed."
	end
	local encodeSuccess, encodedOrError = pcall(function()
		return HttpService:JSONEncode(dataOrError)
	end)
	if not encodeSuccess or type(encodedOrError) ~= "string" then
		return false, "Save failed while preparing project data. Your previous save was not changed."
	end
	local folder = getProjectFolder(SAVE_FOLDER_NAME)
	local saveName = safeInstanceName(timeline:getAnimationName())
	local savedInstance, writeMessage = atomicWriteSaveEntry(folder, saveName, encodedOrError, buildInfo, {
		backupExisting = true,
	})
	if not savedInstance then
		return false, "Save failed before replacing the previous good save: " .. tostring(writeMessage)
	end
	return true, string.format(
		"Saved '%s' to ServerStorage.MegMoAnimatorSaves. Use Import &gt; Saves or Import Selected to reopen it.",
		savedInstance.Name
	), savedInstance
end

function SaveExportService.saveAutoSave(timeline, buildInfo, extra)
	local saveExtra = extra
	if type(saveExtra) ~= "table" or (saveExtra.groups == nil and saveExtra.motionBuilder == nil) then
		saveExtra = {
			groups = extra or {},
		}
	end
	local dataSuccess, dataOrError = pcall(function()
		return timeline:toSaveData(saveExtra)
	end)
	if not dataSuccess or type(dataOrError) ~= "table" then
		return false, "Autosave failed before writing. Your previous autosave was not changed."
	end
	local encodeSuccess, encodedOrError = pcall(function()
		return HttpService:JSONEncode(dataOrError)
	end)
	if not encodeSuccess or type(encodedOrError) ~= "string" then
		return false, "Autosave failed while preparing project data. Your previous autosave was not changed."
	end
	local folder = getProjectFolder(AUTOSAVE_FOLDER_NAME)
	local projectName = safeInstanceName(timeline:getAnimationName())
	local saveName = AUTOSAVE_ENTRY_NAME
	local savedInstance, writeMessage = writeAutoSaveEntry(folder, saveName, encodedOrError, buildInfo)
	if not savedInstance then
		return false, "Autosave failed before replacing the previous recovery save: " .. tostring(writeMessage)
	end
	savedInstance:SetAttribute("AutoSave", true)
	savedInstance:SetAttribute("ProjectName", projectName)
	pruneAutosaveFolder(folder)
	return true, string.format("Autosaved recovery for '%s'.", projectName), savedInstance
end

function SaveExportService.loadSavedProjects()
	local folders = getSavedProjectFolders()
	if #folders == 0 then
		return {}, "No 7kg2 Animator saves were found in ServerStorage yet."
	end

	local entries = {}
	for _, folder in ipairs(folders) do
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("StringValue") or child:IsA("Folder") then
				local entry = getSavedProjectBrowserEntry(child)
				if entry then
					table.insert(entries, entry)
				end
			end
		end
	end

	table.sort(entries, function(a, b)
		if (a.sortTime or 0) ~= (b.sortTime or 0) then
			return (a.sortTime or 0) &gt; (b.sortTime or 0)
		end
		return tostring(a.name or a.id) &lt; tostring(b.name or b.id)
	end)

	if #entries == 0 then
		return entries, "No 7kg2 Animator saves were found in ServerStorage yet."
	end

	return entries, string.format(
		"Found %d 7kg2 Animator save%s. Click one to open it.",
		#entries,
		#entries == 1 and "" or "s"
	)
end

function SaveExportService.loadRecentSavedProjects(limit)
	local entries, status = SaveExportService.loadSavedProjects()
	if #entries == 0 then
		return entries, status
	end

	local maxItems = math.max(1, math.floor(tonumber(limit) or 5))
	local recent = {}
	for index = 1, math.min(#entries, maxItems) do
		table.insert(recent, entries[index])
	end

	return recent, string.format(
		"Showing the %d most recent 7kg2 Animator save%s.",
		#recent,
		#recent == 1 and "" or "s"
	)
end

function SaveExportService.loadSavedProjectValue(instance, deps)
	if not instance or (not instance:IsA("StringValue") and not instance:IsA("Folder")) then
		return false, "Select a 7kg2 Animator save entry first."
	end

	local dataOrError, decodeError = decodeSavedProjectData(instance)
	if not dataOrError then
		return false, decodeError
	end

	local savedRigNames = collectSavedRigNames(dataOrError)
	local selectedRigTarget = deps.singleRigTarget
	if selectedRigTarget then
		if #savedRigNames ~= 1 then
			return false, "Import onto Selected Rig requires a project containing exactly one saved rig."
		end
		if not (selectedRigTarget.Parent and selectedRigTarget:IsA("Model")) then
			return false, "The selected target rig is no longer available."
		end
	end

	deps.pushUndo("Open Saved Project")
	local boundRigs = deps.timeline:getRigs()
	local singleBoundRig = (#boundRigs == 1) and boundRigs[1] or nil

	local success, resultOrMessage = deps.timeline:loadSaveData(dataOrError, {
		resolveInstancePath = resolveDataModelPath,
		resolveRigByName = function(rigName)
			if selectedRigTarget and rigName == savedRigNames[1] then
				return prepareRigForProjectLoad(selectedRigTarget, deps)
			end
			local exact = resolveWorkspaceRigByName(deps.rigService, rigName, deps)
			if exact then
				return exact
			end
			if #savedRigNames == 1 and singleBoundRig and singleBoundRig.Parent then
				return prepareRigForProjectLoad(singleBoundRig, deps)
			end
			return nil
		end,
		describeRig = deps.rigService.describeRig,
	})
	if not success then
		deps.discardPendingUndo()
		return false, resultOrMessage or "Could not open that 7kg2 Animator project."
	end

	if type(deps.clearRuntimeAttachments) == "function" then
		deps.clearRuntimeAttachments()
	end
	deps.clearSelectedKeyframes()
	deps.clearSelectedTracks()
	deps.loadSavedGroups(resultOrMessage.extra, resultOrMessage.pathMap or {}, {
		reset = true,
		frameOffset = 0,
	})
	if type(deps.loadMotionBuilderRecipe) == "function" then
		deps.loadMotionBuilderRecipe(resultOrMessage.extra, resultOrMessage.pathMap or {}, {
			reset = true,
			frameOffset = 0,
		})
	end
	if type(deps.loadEffects) == "function" then
		deps.loadEffects(resultOrMessage.extra, resultOrMessage.pathMap or {}, {
			reset = true,
			frameOffset = 0,
		})
	end
	if type(deps.loadFaces) == "function" then
		deps.loadFaces(resultOrMessage.extra, resultOrMessage.pathMap or {}, {
			reset = true,
			frameOffset = 0,
		})
	end
	deps.timeline:setCurrentFrame(0)
	if type(deps.prepareAttachments) == "function" then
		deps.prepareAttachments(0)
	end
	deps.timeline:applyCurrentFrame()
	if type(deps.applyAttachments) == "function" then
		deps.applyAttachments(0)
	end
	if type(deps.renderEffects) == "function" then
		deps.renderEffects(0)
	end

	local importedKeyCount = tonumber(resultOrMessage.importedTrackKeyCount) or 0
	local importedFrameCount = tonumber(resultOrMessage.importedFrameCount) or 0
	if importedKeyCount == 0 then
		return true, string.format("Opened saved project '%s'. No keyframes were found in the save.", instance.Name)
	end

	return true, string.format(
		"Opened saved project '%s' with %d key%s across %d frame%s.",
		instance.Name,
		importedKeyCount,
		importedKeyCount == 1 and "" or "s",
		importedFrameCount,
		importedFrameCount == 1 and "" or "s"
	)
end

function SaveExportService.openSavedProjectByName(saveName, deps)
	local folders = getSavedProjectFolders()
	if #folders == 0 then
		return false, "No 7kg2 Animator saves folder was found in ServerStorage."
	end

	local value = findSavedProject(saveName)
	if not value or (not value:IsA("StringValue") and not value:IsA("Folder")) then
		return false, "That 7kg2 Animator save could not be found."
	end

	return SaveExportService.loadSavedProjectValue(value, deps)
end

function SaveExportService.saveMotionRecipe(recipe, buildInfo, recipeName)
	if type(recipe) ~= "table" then
		return false, "There is no Motion Builder recipe to save yet."
	end

	local folder = getProjectFolder(MOTION_RECIPE_FOLDER_NAME)
	local saveName = safeInstanceName(recipeName)
	local encoded = HttpService:JSONEncode(recipe)
	local value = Instance.new("StringValue")
	clearExistingSaveEntry(folder, saveName)
	value.Name = saveName
	value.Value = encoded
	value:SetAttribute("EntryType", MOTION_RECIPE_ENTRY_TYPE)
	applySaveMetadata(value, buildInfo)
	value.Parent = folder
	return true, string.format("Saved Motion Builder recipe '%s'.", saveName), value
end

function SaveExportService.listMotionRecipes()
	local folders = getMotionRecipeFolders()
	if #folders == 0 then
		return {}, "No Motion Builder recipes saved yet."
	end

	local entries = {}
	for _, folder in ipairs(folders) do
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("StringValue") then
				local entry = getMotionRecipeBrowserEntry(child)
				if entry then
					table.insert(entries, entry)
				end
			end
		end
	end

	table.sort(entries, function(a, b)
		if (a.sortTime or 0) ~= (b.sortTime or 0) then
			return (a.sortTime or 0) &gt; (b.sortTime or 0)
		end
		return tostring(a.name or a.id) &lt; tostring(b.name or b.id)
	end)

	if #entries == 0 then
		return entries, "No Motion Builder recipes saved yet."
	end

	return entries, string.format("Found %d Motion Builder recipe%s.", #entries, #entries == 1 and "" or "s")
end

function SaveExportService.loadMotionRecipeByName(recipeName)
	local folders = getMotionRecipeFolders()
	if #folders == 0 then
		return false, "No Motion Builder recipe folder was found in ServerStorage."
	end

	local value = findMotionRecipeByName(recipeName)
	local recipe, message = decodeRecipeValue(value)
	if not recipe then
		return false, message
	end
	return true, recipe, string.format("Loaded Motion Builder recipe '%s'.", value.Name)
end

function SaveExportService.renameMotionRecipe(oldName, newName)
	local folders = getMotionRecipeFolders()
	if #folders == 0 then
		return false, "No Motion Builder recipe folder was found in ServerStorage."
	end

	local value, folder = findMotionRecipeByName(oldName)
	if not value or not value:IsA("StringValue") then
		return false, "That Motion Builder recipe could not be found."
	end

	local safeName = safeInstanceName(newName)
	if safeName == "" then
		return false, "Enter a recipe name first."
	end
	if safeName ~= value.Name and folder:FindFirstChild(safeName) then
		return false, "A Motion Builder recipe with that name already exists."
	end

	value.Name = safeName
	return true, string.format("Renamed Motion Builder recipe to '%s'.", safeName)
end

function SaveExportService.deleteMotionRecipe(recipeName)
	local folders = getMotionRecipeFolders()
	if #folders == 0 then
		return false, "No Motion Builder recipe folder was found in ServerStorage."
	end

	local value = findMotionRecipeByName(recipeName)
	if not value or not value:IsA("StringValue") then
		return false, "That Motion Builder recipe could not be found."
	end

	value:Destroy()
	return true, string.format("Deleted Motion Builder recipe '%s'.", tostring(recipeName))
end

function SaveExportService.exportAnimation(deps)
	local rig = deps.timeline:getRig()
	if not rig or not rig.Parent then
		return false, "Bind a rig before exporting a Roblox KeyframeSequence."
	end

	local entries = collectRigExportEntries(deps.timeline, deps.sortFrames)
	if #entries == 0 then
		return false, "The bound rig has no enabled Motor6D tracks to export."
	end

	local folder = getProjectFolder(EXPORT_FOLDER_NAME)
	if deps.exportAllRigs == true then
		local exportedSequences = {}
		for _, entry in ipairs(entries) do
			local exportName = string.format(
				"%s_%s_KeyframeSequence",
				safeInstanceName(deps.timeline:getAnimationName()),
				safeInstanceName(entry.rigName)
			)
			local oldExport = folder:FindFirstChild(exportName)
			if oldExport then
				oldExport:Destroy()
			end

			local sequence = buildKeyframeSequence(
				deps.timeline,
				deps.buildInfo,
				entry.motors,
				entry.frames,
				exportName
			)
			sequence:SetAttribute("TargetRig", entry.rigName)
			sequence.Parent = folder
			table.insert(exportedSequences, sequence)
		end
		deps.selectionService.setSelection(exportedSequences)
		return true, string.format(
			"Exported %d rigs as separate KeyframeSequences in ServerStorage.MegMoAnimatorExports. Save or upload each one separately.",
			#exportedSequences
		)
	end

	local targetRig = deps.targetRig
	local targetEntry = nil
	for _, entry in ipairs(entries) do
		if (targetRig and entry.rig == targetRig) or (not targetRig and #entries == 1) then
			targetEntry = entry
			break
		end
	end
	if not targetEntry then
		return false, "This project contains several rig animations. Choose one rig or export every rig separately."
	end

	local exportName = safeInstanceName(deps.timeline:getAnimationName()) .. "_KeyframeSequence"
	local oldExport = folder:FindFirstChild(exportName)
	if oldExport then
		oldExport:Destroy()
	end

	local sequence = buildKeyframeSequence(
		deps.timeline,
		deps.buildInfo,
		targetEntry.motors,
		targetEntry.frames,
		exportName
	)
	sequence:SetAttribute("TargetRig", targetEntry.rigName)
	sequence.Parent = folder

	local openedUploadDialog = tryOpenRobloxSaveDialog(deps.plugin, deps.selectionService, sequence)
	if openedUploadDialog then
		return true, string.format("Exported '%s' as a KeyframeSequence and opened Roblox save.", exportName)
	end
	return true, string.format("Exported '%s' to ServerStorage.MegMoAnimatorExports and selected it for saving.", exportName)
end

return SaveExportService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX219">
        <Properties>
          <string name="Name">ScreenEffectKeyframeEditorController</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local ScreenEffectTrackService = require(script.Parent:WaitForChild("ScreenEffectTrackService"))
local UiMotion = require(script.Parent:WaitForChild("UiMotion"))
local LightingEffectTrackService = require(script.Parent:WaitForChild("LightingEffectTrackService"))
local TrackEasingOptionsSupport = require(script.Parent:WaitForChild("TrackEasingOptionsSupport"))
local UiHelpers = require(script.Parent:WaitForChild("UiHelpers"))
local Selection = game:GetService("Selection")

local ScreenEffectKeyframeEditorController = {}

local create = UiHelpers.create
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton

local PRESET_COLORS = {
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(0, 0, 0),
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(255, 230, 70),
	Color3.fromRGB(85, 220, 120),
	Color3.fromRGB(70, 210, 255),
	Color3.fromRGB(80, 130, 255),
	Color3.fromRGB(170, 90, 255),
	Color3.fromRGB(255, 95, 180),
}

local COLOR_FIELD_NAMES = {
	ambient = true,
	backgroundColor = true,
	color = true,
	colorShiftBottom = true,
	colorShiftTop = true,
	decay = true,
	fillColor = true,
	fogColor = true,
	outdoorAmbient = true,
	outlineColor = true,
	textColor = true,
	tintColor = true,
}

local readControls
local schedulePreview
local getPreviewPhaseForField

local function getTrack(host)
	return host:_getTrackViewModel(host._activeEffectTrackPath)
end

local function getTrackService(track)
	if LightingEffectTrackService.isLightingEffectTrack(track) then
		return LightingEffectTrackService
	end
	return ScreenEffectTrackService
end

local function isEditableEffectTrack(track)
	return ScreenEffectTrackService.isScreenEffectTrack(track) or LightingEffectTrackService.isLightingEffectTrack(track)
end

local function getExistingSelectedValue(host, track)
	if track and host._activeEffectKeyframeFrame ~= nil then
		local callbacks = host._screenEffectEditorCallbacks or {}
		local timeline = type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
		local frame = math.max(0, math.floor(tonumber(host._activeEffectKeyframeFrame) or 0))
		if timeline and type(timeline.getTrackValueAtFrame) == "function" then
			local value = timeline:getTrackValueAtFrame(track.path, frame)
			if value ~= nil then
				return value, frame
			end
		end
	end

	local viewModel = host._lastViewModel or {}
	for _, key in ipairs(viewModel.selectedKeyValues or {}) do
		if key.jointPath == track.path then
			return key.value, key.frame
		end
	end
	return nil, nil
end

local function getSelectedValue(host, track)
	local value, frame = getExistingSelectedValue(host, track)
	if value ~= nil then
		return value, frame
	end
	local viewModel = host._lastViewModel or {}
	return getTrackService(track).getDefaultValueForTrack(track), viewModel.currentFrame
end

local function effectTypeFromTrack(track)
	local service = getTrackService(track)
	if service and type(service.getTrackEffectType) == "function" then
		return service.getTrackEffectType(track)
	end
	return service.normalizeEffectType(track and (track.valueType or track.effectType or track.name))
end

local function setLegacyVisible(host, isVisible)
	local buttons = {
		host._effectFadeTransparentButton,
		host._effectFadeBlackButton,
		host._effectFadeWhiteButton,
		host._effectFadeHalfButton,
	}
	for _, button in ipairs(buttons) do
		if button then
			button.Visible = isVisible
		end
	end
	if buttons[1] and buttons[1].Parent then
		buttons[1].Parent.Visible = isVisible
	end
	if host._effectFadeTransparencyTrack and host._effectFadeTransparencyTrack.Parent then
		host._effectFadeTransparencyTrack.Parent.Visible = isVisible
	end
end

local function ensureDynamicFrame(host)
	if host._screenEffectEditorFields and host._screenEffectEditorFields.Parent then
		return host._screenEffectEditorFields
	end

	local overlay = host._effectTrackEditorOverlay
	local card = overlay and overlay:FindFirstChild("EffectTrackEditorCard")
	if not card then
		return nil
	end

	card.Size = UDim2.new(0, 620, 0, 560)

	local fields = create("ScrollingFrame", {
		Name = "ScreenEffectEditorFields",
		Parent = card,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 18, 0, 138),
		ScrollBarThickness = 6,
		Size = UDim2.new(1, -36, 1, -196),
		ZIndex = 114,
	})
	createCorner(fields, 10)
	createStroke(fields)
	create("UIPadding", {
		Parent = fields,
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	create("UIListLayout", {
		Parent = fields,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	host._screenEffectEditorFields = fields
	return fields
end

local function ensureApplyButton(host)
	if host._effectTrackEditorApplyButton and host._effectTrackEditorApplyButton.Parent then
		return host._effectTrackEditorApplyButton
	end

	local overlay = host._effectTrackEditorOverlay
	local card = overlay and overlay:FindFirstChild("EffectTrackEditorCard")
	if not card then
		return nil
	end

	local applyButton = create("TextButton", {
		Name = "EffectTrackEditorApplyButton",
		Parent = card,
		Position = UDim2.new(0, 18, 1, -50),
		Size = UDim2.new(0.5, -24, 0, 32),
		Text = "Apply Keyframe",
		ZIndex = 114,
	})
	styleTextButton(applyButton)
	createCorner(applyButton, 9)
	host._effectTrackEditorApplyButton = applyButton

	if host._effectTrackEditorOkButton then
		host._effectTrackEditorOkButton.Position = UDim2.new(0.5, 6, 1, -50)
		host._effectTrackEditorOkButton.Size = UDim2.new(0.5, -24, 0, 32)
	end

	return applyButton
end

local function clearFields(host)
	local fields = ensureDynamicFrame(host)
	if not fields then
		return nil
	end
	for _, child in ipairs(fields:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	host._screenEffectEditorControls = {}
	return fields
end

local function createFieldRow(parent, field, order)
	local row = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, field.kind == "text" and 72 or 46),
		ZIndex = 115,
	})

	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 16),
		Font = Enum.Font.Gotham,
		Text = field.label or field.key,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 116,
	})

	return row
end

local function createTextInput(parent, field, text)
	local input = create("TextBox", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 0, 0, 18),
		Size = UDim2.new(1, 0, 0, field.kind == "text" and 46 or 26),
		Text = text or "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = field.kind == "text",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = field.kind == "text" and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		ZIndex = 116,
	})
	createCorner(input, 8)
	createStroke(input)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, field.kind == "text" and 5 or 0),
	})
	return input
end

local function createHighlightAdorneeButtons(host, row, input)
	row.Size = UDim2.new(1, 0, 0, 82)
	input.Size = UDim2.new(1, 0, 0, 26)
	input.TextYAlignment = Enum.TextYAlignment.Center

	local function getAdorneePath(useBoundRig)
		if useBoundRig then
			local path = host._lastViewModel and host._lastViewModel.boundRigPath
			return path, path and "Highlight target set to the bound rig." or "No bound rig is available for Highlight."
		end

		local selected = Selection:Get()
		local target = selected and selected[1]
		return target and target:GetFullName() or nil, target and string.format("Highlight target set to %s.", target.Name) or "Select an object or rig in Studio first."
	end

	local function useAdornee(useBoundRig)
		local path, message = getAdorneePath(useBoundRig)
		if path and path ~= "" then
			input.Text = path
			if schedulePreview then
				schedulePreview(host)
			end
		end
		if host._setShortcutHint then
			host:_setShortcutHint(message or (path and "Highlight target updated." or "Could not set highlight target."))
		end
	end

	local selectedButton = create("TextButton", {
		Parent = row,
		Position = UDim2.new(0, 0, 0, 50),
		Size = UDim2.new(0.5, -5, 0, 26),
		Text = "Use Selected",
		ZIndex = 116,
	})
	styleGhostButton(selectedButton)
	createCorner(selectedButton, 8)
	selectedButton.Activated:Connect(function()
		useAdornee(false)
	end)

	local boundButton = create("TextButton", {
		Parent = row,
		Position = UDim2.new(0.5, 5, 0, 50),
		Size = UDim2.new(0.5, -5, 0, 26),
		Text = "Use Bound Rig",
		ZIndex = 116,
	})
	styleGhostButton(boundButton)
	createCorner(boundButton, 8)
	boundButton.Activated:Connect(function()
		useAdornee(true)
	end)
end

local function createChoiceButton(parent, text)
	local button = create("TextButton", {
		Parent = parent,
		Position = UDim2.new(0, 0, 0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		Text = text or "",
		ZIndex = 116,
	})
	styleGhostButton(button)
	createCorner(button, 8)
	return button
end

local function enumFont(fontName)
	local fallback = Enum.Font.GothamSemibold
	local success, font = pcall(function()
		return Enum.Font[tostring(fontName or "")]
	end)
	if success and font then
		return font
	end
	return fallback
end

local function setChoiceButtonValue(button, value)
	button.Text = tostring(value or "")
	button:SetAttribute("Value", tostring(value or ""))
end

local function createColorPresetRow(host, parent, field, input, order)
	if not COLOR_FIELD_NAMES[field.key] then
		return
	end

	local row = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		LayoutOrder = 1000 + (order or 0),
		Size = UDim2.new(1, 0, 0, 30),
		ZIndex = 115,
	})
	create("UIListLayout", {
		Parent = row,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	local label = create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = 0,
		Size = UDim2.new(0, 132, 0, 24),
		Text = tostring(field.label or field.key),
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 116,
	})
	for index, color in ipairs(PRESET_COLORS) do
		local swatch = create("TextButton", {
			Parent = row,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Size = UDim2.new(0, 28, 0, 24),
			Text = "",
			ZIndex = 116,
		})
		createCorner(swatch, 7)
		createStroke(swatch, Color3.fromRGB(255, 255, 255), 1, 0.72)
		swatch.Activated:Connect(function()
			input.Text = ScreenEffectTrackService.formatFieldValue(field, color)
			if schedulePreview then
				schedulePreview(host)
			end
		end)
	end
end

local function nextChoice(field, current)
	local choices = field.choices or {}
	if #choices == 0 then
		return tostring(current or "")
	end
	for index, choice in ipairs(choices) do
		if tostring(choice) == tostring(current) then
			return choices[(index % #choices) + 1]
		end
	end
	return choices[1]
end

local function createFontDropdown(parent, field, currentValue)
	local row = parent
	local button = createChoiceButton(row, tostring(currentValue or "GothamSemibold"))
	button.Font = enumFont(currentValue)
	setChoiceButtonValue(button, currentValue or "GothamSemibold")

	local listHeight = math.min(176, math.max(28, #(field.choices or {}) * 28))
	local list = create("ScrollingFrame", {
		Parent = row,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 0, 0, 48),
		ScrollBarThickness = 5,
		Size = UDim2.new(1, 0, 0, listHeight),
		Visible = false,
		ZIndex = 119,
	})
	createCorner(list, 8)
	createStroke(list)
	create("UIListLayout", {
		Parent = list,
		Padding = UDim.new(0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	local function setOpen(isOpen)
		list.Visible = isOpen
		row.Size = isOpen and UDim2.new(1, 0, 0, 52 + listHeight) or UDim2.new(1, 0, 0, 46)
	end

	button.Activated:Connect(function()
		setOpen(not list.Visible)
	end)

	for index, fontName in ipairs(field.choices or {}) do
		local option = create("TextButton", {
			Parent = list,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Font = enumFont(fontName),
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 25),
			Text = tostring(fontName),
			TextColor3 = Constants.THEME.Text,
			TextSize = 13,
			ZIndex = 120,
		})
		createCorner(option, 7)
		option.Activated:Connect(function()
			setChoiceButtonValue(button, fontName)
			button.Font = enumFont(fontName)
			setOpen(false)
		end)
	end

	return button
end

local function applySubtitleBoundary(host, isStart)
	local track = getTrack(host)
	if not ScreenEffectTrackService.isScreenEffectTrack(track) or effectTypeFromTrack(track) ~= "Subtitle" then
		host:_setShortcutHint("Select the Subtitle screen effect track first.")
		return
	end

	local callbacks = host._screenEffectEditorCallbacks
	if not callbacks or not callbacks.onSetScreenEffectKeyValue then
		return
	end

	local ok, valueOrMessage = ScreenEffectTrackService.parseEditorFields("Subtitle", readControls(host))
	if not ok then
		host:_setShortcutHint(valueOrMessage)
		return
	end

	valueOrMessage.enabled = isStart == true
	if not isStart then
		valueOrMessage.textEnabled = false
		valueOrMessage.backgroundEnabled = false
	end

	callbacks.onSetScreenEffectKeyValue(track.path, valueOrMessage, {
		currentFrameOnly = true,
		actionName = isStart and "Subtitle Start" or "Subtitle End",
	})
	host:_focusShortcutCapture(isStart and "Subtitle start key added" or "Subtitle end key added")
end

local function createSubtitleTimingRow(host, parent, order)
	local row = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 92),
		ZIndex = 115,
	})
	createCorner(row, 10)
	createStroke(row)
	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 7),
		Size = UDim2.new(1, -20, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Subtitle Timing",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 116,
	})
	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 27),
		Size = UDim2.new(1, -20, 0, 30),
		Font = Enum.Font.Gotham,
		Text = "Use the playhead position to add a visible start key or hidden end key.",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.None,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 116,
	})

	local startButton = create("TextButton", {
		Parent = row,
		Position = UDim2.new(0, 10, 0, 62),
		Size = UDim2.new(0.5, -15, 0, 24),
		Text = "Start Here",
		ZIndex = 116,
	})
	styleTextButton(startButton)
	createCorner(startButton, 8)
	startButton.Activated:Connect(function()
		applySubtitleBoundary(host, true)
	end)

	local endButton = create("TextButton", {
		Parent = row,
		Position = UDim2.new(0.5, 5, 0, 62),
		Size = UDim2.new(0.5, -15, 0, 24),
		Text = "End Here",
		ZIndex = 116,
	})
	styleGhostButton(endButton)
	createCorner(endButton, 8)
	endButton.Activated:Connect(function()
		applySubtitleBoundary(host, false)
	end)
end

local function renderFields(host, track, value)
	local fields = clearFields(host)
	if not fields then
		return
	end

	local service = getTrackService(track)
	local effectType = effectTypeFromTrack(track)
	local normalized = service.normalizeValue(effectType, value)
	local controls = {}
	if ScreenEffectTrackService.isScreenEffectTrack(track) and effectType == "Subtitle" then
		createSubtitleTimingRow(host, fields, 0)
	end
	for index, field in ipairs(service.getEditorFields(effectType)) do
		local row = createFieldRow(fields, field, index)
		local currentValue = normalized[field.key]
		if field.kind == "boolean" then
			local button = createChoiceButton(row, service.formatFieldValue(field, currentValue))
			button.Activated:Connect(function()
				local nextValue = button.Text ~= "On"
				button.Text = nextValue and "On" or "Off"
				schedulePreview(host, getPreviewPhaseForField(field.key))
			end)
			controls[field.key] = {
				field = field,
				button = button,
			}
		elseif field.kind == "choice" then
			local button = createChoiceButton(row, service.formatFieldValue(field, currentValue))
			setChoiceButtonValue(button, service.formatFieldValue(field, currentValue))
			button.Activated:Connect(function()
				setChoiceButtonValue(button, nextChoice(field, button:GetAttribute("Value") or button.Text))
				schedulePreview(host, getPreviewPhaseForField(field.key))
			end)
			controls[field.key] = {
				field = field,
				button = button,
			}
		elseif field.kind == "font" then
			local button = createFontDropdown(row, field, currentValue)
			button:GetAttributeChangedSignal("Value"):Connect(function()
				schedulePreview(host)
			end)
			controls[field.key] = {
				field = field,
				button = button,
			}
		else
			local input = createTextInput(row, field, service.formatFieldValue(field, currentValue))
			if LightingEffectTrackService.isLightingEffectTrack(track) and effectType == "Highlight" and field.key == "adorneePath" then
				createHighlightAdorneeButtons(host, row, input)
			end
			input:GetPropertyChangedSignal("Text"):Connect(function()
				schedulePreview(host, getPreviewPhaseForField(field.key))
			end)
			controls[field.key] = {
				field = field,
				input = input,
			}
			createColorPresetRow(host, fields, field, input, index)
		end
	end
	host._screenEffectEditorControls = controls
end

readControls = function(host)
	local rawValues = {}
	for key, control in pairs(host._screenEffectEditorControls or {}) do
		if control.input then
			rawValues[key] = control.input.Text
		elseif control.button then
			rawValues[key] = control.button:GetAttribute("Value") or control.button.Text
		end
	end
	return rawValues
end

getPreviewPhaseForField = function(fieldKey)
	if fieldKey == "enterTransition" or fieldKey == "enterDuration" then
		return "enter"
	elseif fieldKey == "exitTransition" or fieldKey == "exitDuration" then
		return "exit"
	end
	return nil
end

local function previewCurrentFields(host, phase)
	local track = getTrack(host)
	if not isEditableEffectTrack(track) then
		return false
	end
	local callbacks = host._screenEffectEditorCallbacks
	if not callbacks then
		return false
	end
	local service = getTrackService(track)
	local effectType = effectTypeFromTrack(track)
	local ok, valueOrMessage = service.parseEditorFields(effectType, readControls(host))
	if not ok then
		return false
	end
	if LightingEffectTrackService.isLightingEffectTrack(track) and callbacks.onPreviewLightingEffectKeyValue then
		callbacks.onPreviewLightingEffectKeyValue(track.path, valueOrMessage, {
			phase = phase,
		})
	elseif ScreenEffectTrackService.isScreenEffectTrack(track) and callbacks.onPreviewScreenEffectKeyValue then
		local _, frame = getExistingSelectedValue(host, track)
		callbacks.onPreviewScreenEffectKeyValue(track.path, valueOrMessage, {
			phase = phase,
			targetFrame = frame,
		})
	else
		return false
	end
	return true
end

schedulePreview = function(host, phase)
	host._screenEffectEditorPreviewToken = (host._screenEffectEditorPreviewToken or 0) + 1
	host._screenEffectEditorKeepAppliedPreview = false
	local token = host._screenEffectEditorPreviewToken
	task.delay(0.05, function()
		if host._screenEffectEditorPreviewToken ~= token then
			return
		end
		previewCurrentFields(host, phase)
	end)
end

local function cancelPreview(host)
	host._screenEffectEditorPreviewToken = (host._screenEffectEditorPreviewToken or 0) + 1
	if host._screenEffectEditorKeepAppliedPreview == true then
		host._screenEffectEditorKeepAppliedPreview = false
		return
	end
	local callbacks = host._screenEffectEditorCallbacks
	if callbacks and callbacks.onCancelScreenEffectKeyPreview then
		callbacks.onCancelScreenEffectKeyPreview()
	end
	if callbacks and callbacks.onCancelLightingEffectKeyPreview then
		callbacks.onCancelLightingEffectKeyPreview()
	end
end

function ScreenEffectKeyframeEditorController.isScreenEffectTrack(track)
	return ScreenEffectTrackService.isScreenEffectTrack(track)
end

function ScreenEffectKeyframeEditorController.isEditableEffectTrack(track)
	return isEditableEffectTrack(track)
end

function ScreenEffectKeyframeEditorController.show(host, trackPath, frame)
	if not host._effectTrackEditorOverlay then
		return
	end

	host._activeEffectTrackPath = trackPath
	host._activeEffectKeyframeFrame = frame
	setLegacyVisible(host, false)
	ensureDynamicFrame(host)
	ensureApplyButton(host)
	ScreenEffectKeyframeEditorController.render(host)
	UiMotion.popupIn(host._effectTrackEditorOverlay)
	host:_setShortcutHint("Effect editor open: adjust settings, then Apply Keyframe or OK")
end

function ScreenEffectKeyframeEditorController.hide(host)
	cancelPreview(host)
	if host._effectTrackEditorOverlay then
		UiMotion.popupOut(host._effectTrackEditorOverlay)
	end
	host._activeEffectTrackPath = nil
	host._activeEffectKeyframeFrame = nil
	host._screenEffectEditorControls = {}
end

function ScreenEffectKeyframeEditorController.render(host)
	if not host._effectTrackEditorOverlay then
		return
	end

	local track = getTrack(host)
	if not isEditableEffectTrack(track) then
		if host._effectTrackEditorItemLabel then
			host._effectTrackEditorItemLabel.Text = "Effect"
		end
		if host._effectTrackEditorHelpLabel then
			host._effectTrackEditorHelpLabel.Text = "Select an effect keyframe or track first."
		end
		return
	end

	local service = getTrackService(track)
	local effectType = effectTypeFromTrack(track)
	local definition = service.getEffectDefinition(effectType) or {}
	local value, frame = getSelectedValue(host, track)
	if host._effectTrackEditorItemLabel then
		host._effectTrackEditorItemLabel.Text = "Effect: " .. tostring(definition.name or track.name or effectType)
	end
	if host._effectTrackEditorHelpLabel then
		if effectType == ScreenEffectTrackService.FADE_EFFECT then
			host._effectTrackEditorHelpLabel.Text = string.format(
				"Editing frame %s. Fade In/Out writes a resizable clip with start and end handles.",
				tostring(frame or 0)
			)
		else
			host._effectTrackEditorHelpLabel.Text = string.format(
				"Editing frame %s. These settings write a %s keyframe onto the selected effect track.",
				tostring(frame or 0),
				tostring(definition.name or effectType)
			)
		end
	end
	if host._effectTrackEditorApplyButton then
		host._effectTrackEditorApplyButton.Text = effectType == ScreenEffectTrackService.FADE_EFFECT and "Apply Clip" or "Apply Keyframe"
	end

	renderFields(host, track, value)
	TrackEasingOptionsSupport.renderListSection(host, host._lastViewModel or {}, host._screenEffectEditorFields, {
		create = create,
		createCorner = createCorner,
		callbacks = host._screenEffectEditorCallbacks,
		rerender = function()
			ScreenEffectKeyframeEditorController.render(host)
		end,
		zIndex = 115,
	})
end

function ScreenEffectKeyframeEditorController.apply(host, callbacks)
	local track = getTrack(host)
	if not isEditableEffectTrack(track) then
		host:_setShortcutHint("Select an effect keyframe or track first.")
		return false
	end
	local service = getTrackService(track)
	local effectType = effectTypeFromTrack(track)
	local ok, valueOrMessage = service.parseEditorFields(effectType, readControls(host))
	if not ok then
		host:_setShortcutHint(valueOrMessage)
		return false
	end
	if LightingEffectTrackService.isLightingEffectTrack(track) and callbacks and callbacks.onSetLightingEffectKeyValue then
		callbacks.onSetLightingEffectKeyValue(track.path, valueOrMessage)
		return true
	end
	if ScreenEffectTrackService.isScreenEffectTrack(track) and callbacks and callbacks.onSetScreenEffectKeyValue then
		local _, frame = getExistingSelectedValue(host, track)
		callbacks.onSetScreenEffectKeyValue(track.path, valueOrMessage, {
			targetFrame = frame,
		})
		host._screenEffectEditorKeepAppliedPreview = effectType == "Subtitle"
		return true
	end
	return false
end

function ScreenEffectKeyframeEditorController.connect(host, callbacks)
	host._screenEffectEditorCallbacks = callbacks
	ensureDynamicFrame(host)
	ensureApplyButton(host)

	if host._effectTrackEditorCloseButton then
		host:_connect(host._effectTrackEditorCloseButton.Activated, function()
			ScreenEffectKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Effect editor closed")
		end)
	end
	if host._effectTrackEditorOkButton then
		host:_connect(host._effectTrackEditorOkButton.Activated, function()
			ScreenEffectKeyframeEditorController.apply(host, callbacks)
			ScreenEffectKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Effect editor closed")
		end)
	end
	if host._effectTrackEditorApplyButton then
		host:_connect(host._effectTrackEditorApplyButton.Activated, function()
			if ScreenEffectKeyframeEditorController.apply(host, callbacks) then
				host:_focusShortcutCapture("Screen effect keyframe updated")
			end
		end)
	end
end

return ScreenEffectKeyframeEditorController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX220">
        <Properties>
          <string name="Name">ScreenEffectsRenderer</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")
local TextService = game:GetService("TextService")
local ScreenEffectTrackService = require(script.Parent:WaitForChild("ScreenEffectTrackService"))

local ScreenEffectsRenderer = {}
ScreenEffectsRenderer.__index = ScreenEffectsRenderer

local VIGNETTE_IMAGE = "rbxassetid://4576475446"
local GRAIN_LIGHT_IMAGE = "rbxassetid://460107958"
local GRAIN_DARK_IMAGE = "rbxassetid://460200108"

local function create(className, properties)
	local instance = Instance.new(className)
	for property, value in pairs(properties or {}) do
		instance[property] = value
	end
	return instance
end

local function createCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 0)
	corner.Parent = parent
	return corner
end

local function createStroke(parent, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0
	stroke.Parent = parent
	return stroke
end

local function createWhiteVignetteEdge(parent, name, position, size, rotation)
	local edge = create("Frame", {
		Name = name,
		Parent = parent,
		Active = false,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.02,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		ZIndex = 50004,
	})
	create("UIGradient", {
		Parent = edge,
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	return edge
end

local function collectEnabled(screenEffects)
	local enabled = {}
	for _, effect in ipairs(screenEffects or {}) do
		if effect.enabled == true then
			enabled[tostring(effect.id or "")] = true
		end
	end
	return enabled
end

local function hasEnabledTimelineEffect(timelineEffects)
	for _, value in pairs(timelineEffects or {}) do
		if type(value) == "table" and value.enabled ~= false then
			return true
		end
	end
	return false
end

local function getEffectValue(effects, effectId)
	local timelineEffects = type(effects.timelineScreenEffects) == "table" and effects.timelineScreenEffects or {}
	local timelineValue = timelineEffects[effectId]
	if type(timelineValue) == "table" then
		local normalized = ScreenEffectTrackService.normalizeValue(effectId, timelineValue)
		normalized._transitionAlpha = timelineValue._transitionAlpha
		normalized._transitionPreset = timelineValue._transitionPreset
		return normalized, true
	end
	return nil, false
end

local function enumFont(fontName)
	local fallback = Enum.Font.GothamSemibold
	local success, font = pcall(function()
		return Enum.Font[tostring(fontName or "")]
	end)
	if success and font then
		return font
	end
	return fallback
end

local function getSubtitleViewportWidth(label)
	local parent = label and label.Parent
	if parent and parent.AbsoluteSize.X &gt; 0 then
		return parent.AbsoluteSize.X
	end
	local camera = workspace.CurrentCamera
	if camera then
		return math.max(320, camera.ViewportSize.X)
	end
	return 1280
end

local function getSubtitleHeight(label, text, font, textSize, widthScale, scale, autoFit)
	local displayTextSize = math.max(1, textSize)
	local baseHeight = math.max(34, displayTextSize + 18)
	if autoFit == false then
		return baseHeight
	end
	local viewportWidth = getSubtitleViewportWidth(label)
	local pixelWidth = math.max(120, viewportWidth * math.clamp(widthScale * scale, 0.1, 1.2))
	local bounds = nil
	local ok = pcall(function()
		bounds = TextService:GetTextSize(tostring(text or ""), displayTextSize, font, Vector2.new(math.max(24, pixelWidth - 24), math.huge))
	end)
	if not ok or typeof(bounds) ~= "Vector2" then
		return baseHeight
	end
	return math.ceil(math.max(baseHeight, bounds.Y + math.max(18, displayTextSize * 0.45)))
end

local function subtitlePosition(value)
	local preset = tostring(value.positionPreset or "Bottom")
	local x = math.clamp(tonumber(value.positionX) or 0.5, 0, 1)
	local y = math.clamp(tonumber(value.positionY) or 0.88, 0, 1)
	local anchor = Vector2.new(0.5, 1)

	if preset == "Top" then
		x = 0.5
		y = 0.14
		anchor = Vector2.new(0.5, 0)
	elseif preset == "Center" then
		x = 0.5
		y = 0.5
		anchor = Vector2.new(0.5, 0.5)
	elseif preset == "Bottom" then
		x = 0.5
		y = 0.88
		anchor = Vector2.new(0.5, 1)
	else
		anchor = y &lt; 0.34 and Vector2.new(0.5, 0) or (y &gt; 0.66 and Vector2.new(0.5, 1) or Vector2.new(0.5, 0.5))
	end

	local alpha = math.clamp(tonumber(value._transitionAlpha) or 1, 0, 1)
	local transition = tostring(value._transitionPreset or "None")
	if transition == "Slide Bottom" and alpha &lt; 1 then
		y = math.clamp(y + ((1 - alpha) * 0.2), 0, 1)
	end

	return x, y, anchor, alpha, transition
end

local function easeTransitionAlpha(alpha, transition)
	alpha = math.clamp(tonumber(alpha) or 1, 0, 1)
	if transition == "Popup" or transition == "Slide Bottom" then
		return 1 - ((1 - alpha) ^ 3)
	end
	return alpha
end

local function blendTransparency(baseTransparency, alpha)
	baseTransparency = math.clamp(tonumber(baseTransparency) or 0, 0, 1)
	alpha = math.clamp(tonumber(alpha) or 1, 0, 1)
	return math.clamp(1 - alpha + (baseTransparency * alpha), 0, 1)
end

function ScreenEffectsRenderer.new()
	return setmetatable({
		_gui = nil,
		_refs = nil,
		_depthOfField = nil,
		_lastError = nil,
	}, ScreenEffectsRenderer)
end

function ScreenEffectsRenderer:_setDepthOfFieldEnabled(enabled, value)
	if enabled then
		local effect = self._depthOfField
		if not effect or not effect.Parent then
			effect = Instance.new("DepthOfFieldEffect")
			effect.Name = "MegMoAnimatorDepthOfField"
			effect.Parent = Lighting
			self._depthOfField = effect
		end
		effect.Enabled = true
		effect.FocusDistance = math.clamp(tonumber(value.focusDistance) or 6, 0, 1000)
		effect.InFocusRadius = math.clamp(tonumber(value.inFocusRadius) or 5, 0, 1000)
		effect.NearIntensity = math.clamp(tonumber(value.nearIntensity) or 0.05, 0, 1)
		effect.FarIntensity = math.clamp(tonumber(value.farIntensity) or 0.65, 0, 1)
	elseif self._depthOfField then
		self._depthOfField.Enabled = false
	end
end

function ScreenEffectsRenderer:_build()
	if self._gui and self._gui.Parent then
		return true
	end

	local refs = {}
	local ok, err = pcall(function()
		local gui = create("ScreenGui", {
			Name = "MegMoAnimatorViewerEffects",
			DisplayOrder = 50000,
			Enabled = false,
			IgnoreGuiInset = true,
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		})

		local root = create("Frame", {
			Name = "Root",
			Parent = gui,
			Active = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 50000,
		})

		refs.fade = create("Frame", {
			Name = "Fade",
			Parent = root,
			Active = false,
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.48,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 50001,
		})

		refs.colorWash = create("Frame", {
			Name = "ColorWash",
			Parent = root,
			Active = false,
			BackgroundColor3 = Color3.fromRGB(129, 80, 255),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 50002,
		})

		refs.vignetteDark = create("ImageLabel", {
			Name = "VignetteDark",
			Parent = root,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = VIGNETTE_IMAGE,
			ImageColor3 = Color3.fromRGB(255, 255, 255),
			ImageTransparency = 0.18,
			Position = UDim2.fromScale(0.5, 0.5),
			ScaleType = Enum.ScaleType.Stretch,
			Size = UDim2.fromScale(1.08, 1.08),
			Visible = false,
			ZIndex = 50003,
		})

		refs.vignetteLight = create("ImageLabel", {
			Name = "VignetteLight",
			Parent = root,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = VIGNETTE_IMAGE,
			ImageColor3 = Color3.fromRGB(255, 255, 255),
			ImageTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			ScaleType = Enum.ScaleType.Stretch,
			Size = UDim2.fromScale(1.08, 1.08),
			Visible = false,
			ZIndex = 50003,
		})
		createCorner(refs.vignetteLight, 18)
		createStroke(refs.vignetteLight, Color3.fromRGB(255, 255, 255), 56, 0.02)
		createWhiteVignetteEdge(refs.vignetteLight, "TopGlow", UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.46), 90)
		createWhiteVignetteEdge(refs.vignetteLight, "BottomGlow", UDim2.fromScale(0, 0.54), UDim2.fromScale(1, 0.46), 270)
		createWhiteVignetteEdge(refs.vignetteLight, "LeftGlow", UDim2.fromScale(0, 0), UDim2.fromScale(0.42, 1), 0)
		createWhiteVignetteEdge(refs.vignetteLight, "RightGlow", UDim2.fromScale(0.58, 0), UDim2.fromScale(0.42, 1), 180)

		refs.grainLight = create("ImageLabel", {
			Name = "GrainLight",
			Parent = root,
			Active = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = GRAIN_LIGHT_IMAGE,
			ImageTransparency = 0.2,
			Position = UDim2.fromScale(-0.1, -0.1),
			ScaleType = Enum.ScaleType.Stretch,
			Size = UDim2.fromScale(1.2, 1.2),
			Visible = false,
			ZIndex = 50004,
		})

		refs.grainDark = create("ImageLabel", {
			Name = "GrainDark",
			Parent = root,
			Active = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = GRAIN_DARK_IMAGE,
			ImageTransparency = 0.16,
			Position = UDim2.fromScale(-0.1, -0.1),
			ScaleType = Enum.ScaleType.Stretch,
			Size = UDim2.fromScale(1.2, 1.2),
			Visible = false,
			ZIndex = 50005,
		})

		refs.flash = create("Frame", {
			Name = "CameraFlash",
			Parent = root,
			Active = false,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.58,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 50006,
		})

		refs.letterboxTop = create("Frame", {
			Name = "LetterboxTop",
			Parent = root,
			Active = false,
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0.12, 0),
			Visible = false,
			ZIndex = 50007,
		})

		refs.letterboxBottom = create("Frame", {
			Name = "LetterboxBottom",
			Parent = root,
			Active = false,
			AnchorPoint = Vector2.new(0, 1),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0.12, 0),
			Visible = false,
			ZIndex = 50007,
		})

		refs.subtitle = create("TextLabel", {
			Name = "Subtitle",
			Parent = root,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.28,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.new(0.5, 0, 1, -74),
			Size = UDim2.new(0.62, 0, 0, 34),
			Text = "Your subtitle goes here",
			TextColor3 = Color3.fromRGB(245, 248, 255),
			TextScaled = true,
			Visible = false,
			ZIndex = 50008,
		})
		createCorner(refs.subtitle, 10)

		gui.Parent = CoreGui
		self._gui = gui
		self._refs = refs
	end)

	if not ok then
		self._lastError = tostring(err)
		return false
	end

	self._lastError = nil
	return true
end

function ScreenEffectsRenderer:render(effects)
	if type(effects) ~= "table" then
		self:_setDepthOfFieldEnabled(false)
		if self._gui then
			self._gui.Enabled = false
		end
		return true
	end

	local timelineFade = type(effects.timelineFade) == "table" and effects.timelineFade or nil
	local hasTimelineFade = timelineFade ~= nil and timelineFade.enabled ~= false
	local timelineEffects = type(effects.timelineScreenEffects) == "table" and effects.timelineScreenEffects or {}
	local timelineEffectTrackIds = type(effects.timelineScreenEffectTrackIds) == "table" and effects.timelineScreenEffectTrackIds or {}
	local hasTimelineEffects = hasEnabledTimelineEffect(timelineEffects)
	local viewerEnabled = effects.viewerEnabled == true
	if not viewerEnabled and not hasTimelineFade and not hasTimelineEffects then
		self:_setDepthOfFieldEnabled(false)
		if self._gui then
			self._gui.Enabled = false
		end
		return true
	end

	if not self:_build() then
		return false, self._lastError
	end

	local refs = self._refs or {}
	local enabled = viewerEnabled and collectEnabled(effects.screenEffects) or {}
	local hasAny = next(enabled) ~= nil
	if hasTimelineFade or hasTimelineEffects then
		hasAny = true
	end
	self._gui.Enabled = hasAny

	local letterboxValue, hasLetterboxValue = getEffectValue(effects, "Letterbox")
	local vignetteValue, hasVignetteValue = getEffectValue(effects, "Vignette")
	local filmGrainValue, hasFilmGrainValue = getEffectValue(effects, "FilmGrain")
	local flashValue, hasFlashValue = getEffectValue(effects, "CameraFlash")
	local colorWashValue, hasColorWashValue = getEffectValue(effects, "ColorWash")
	local subtitleValue, hasSubtitleValue = getEffectValue(effects, "Subtitle")
	local depthOfFieldValue, hasDepthOfFieldValue = getEffectValue(effects, "DepthOfField")

	local vignetteTone = effects.vignetteTone == "Light" and "Light" or "Dark"
	if hasVignetteValue then
		vignetteTone = vignetteValue.tone == "Light" and "Light" or "Dark"
	end
	if refs.letterboxTop then
		local visible = (hasLetterboxValue and letterboxValue.enabled ~= false) or enabled.Letterbox == true
		local barSize = hasLetterboxValue and math.clamp(tonumber(letterboxValue.barSize) or 0.12, 0, 0.4) or 0.12
		refs.letterboxTop.Visible = visible
		refs.letterboxTop.Size = UDim2.new(1, 0, barSize, 0)
		refs.letterboxTop.BackgroundColor3 = hasLetterboxValue and letterboxValue.color or Color3.fromRGB(0, 0, 0)
		refs.letterboxTop.BackgroundTransparency = hasLetterboxValue and math.clamp(tonumber(letterboxValue.transparency) or 0, 0, 1) or 0
	end
	if refs.letterboxBottom then
		local visible = (hasLetterboxValue and letterboxValue.enabled ~= false) or enabled.Letterbox == true
		local barSize = hasLetterboxValue and math.clamp(tonumber(letterboxValue.barSize) or 0.12, 0, 0.4) or 0.12
		refs.letterboxBottom.Visible = visible
		refs.letterboxBottom.Size = UDim2.new(1, 0, barSize, 0)
		refs.letterboxBottom.BackgroundColor3 = hasLetterboxValue and letterboxValue.color or Color3.fromRGB(0, 0, 0)
		refs.letterboxBottom.BackgroundTransparency = hasLetterboxValue and math.clamp(tonumber(letterboxValue.transparency) or 0, 0, 1) or 0
	end
	if refs.vignetteDark then
		refs.vignetteDark.Visible = ((hasVignetteValue and vignetteValue.enabled ~= false) or enabled.Vignette == true) and vignetteTone == "Dark"
		refs.vignetteDark.ImageTransparency = hasVignetteValue and math.clamp(tonumber(vignetteValue.transparency) or 0.18, 0, 1) or 0.18
	end
	if refs.vignetteLight then
		refs.vignetteLight.Visible = ((hasVignetteValue and vignetteValue.enabled ~= false) or enabled.Vignette == true) and vignetteTone == "Light"
		refs.vignetteLight.ImageTransparency = hasVignetteValue and math.clamp(tonumber(vignetteValue.transparency) or 0.18, 0, 1) or 1
	end
	if refs.fade then
		refs.fade.Visible = enabled.Fade == true or timelineFade ~= nil
		if timelineFade then
			refs.fade.BackgroundColor3 = typeof(timelineFade.color) == "Color3" and timelineFade.color or Color3.fromRGB(0, 0, 0)
			refs.fade.BackgroundTransparency = math.clamp(tonumber(timelineFade.transparency) or 0.5, 0, 1)
		else
			refs.fade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			refs.fade.BackgroundTransparency = 0.48
		end
	end
	if refs.colorWash then
		refs.colorWash.Visible = (hasColorWashValue and colorWashValue.enabled ~= false) or enabled.ColorWash == true
		refs.colorWash.BackgroundColor3 = hasColorWashValue and colorWashValue.color or Color3.fromRGB(129, 80, 255)
		refs.colorWash.BackgroundTransparency = hasColorWashValue and math.clamp(tonumber(colorWashValue.transparency) or 0.72, 0, 1) or 0.72
	end
	if refs.flash then
		refs.flash.Visible = (hasFlashValue and flashValue.enabled ~= false) or enabled.CameraFlash == true
		refs.flash.BackgroundColor3 = hasFlashValue and flashValue.color or Color3.fromRGB(255, 255, 255)
		refs.flash.BackgroundTransparency = hasFlashValue and math.clamp(tonumber(flashValue.transparency) or 0.58, 0, 1) or 0.58
	end
	if refs.grainLight then
		refs.grainLight.Visible = (hasFilmGrainValue and filmGrainValue.enabled ~= false) or enabled.FilmGrain == true
		refs.grainLight.ImageTransparency = hasFilmGrainValue
			and math.clamp(tonumber(filmGrainValue.transparency) or (1 - (tonumber(filmGrainValue.intensity) or 0.35)), 0, 1)
			or 0.2
	end
	if refs.grainDark then
		refs.grainDark.Visible = (hasFilmGrainValue and filmGrainValue.enabled ~= false) or enabled.FilmGrain == true
		refs.grainDark.ImageTransparency = hasFilmGrainValue
			and math.clamp(tonumber(filmGrainValue.transparency) or (1 - (tonumber(filmGrainValue.intensity) or 0.35)), 0, 1)
			or 0.16
	end
	if refs.subtitle then
		local visible = hasSubtitleValue and subtitleValue.enabled ~= false
		refs.subtitle.Visible = visible
		refs.subtitle.Text = hasSubtitleValue and tostring(subtitleValue.text or "") or tostring(effects.subtitleText or "Your subtitle goes here")
		refs.subtitle.Font = hasSubtitleValue and enumFont(subtitleValue.font) or Enum.Font.GothamSemibold
		refs.subtitle.TextScaled = false
		refs.subtitle.TextWrapped = hasSubtitleValue and subtitleValue.autoFit ~= false
		local textSize = hasSubtitleValue and math.clamp(tonumber(subtitleValue.textSize) or 28, 8, 80) or 28
		local x, y, anchor, transitionAlpha, transitionPreset = 0.5, 0.88, Vector2.new(0.5, 1), 1, "None"
		if hasSubtitleValue then
			x, y, anchor, transitionAlpha, transitionPreset = subtitlePosition(subtitleValue)
		end
		local visualAlpha = easeTransitionAlpha(transitionAlpha, transitionPreset)
		local scale = transitionPreset == "Popup" and (0.72 + (0.28 * visualAlpha)) or 1
		local opacityAlpha = transitionPreset == "Popup" and 1 or visualAlpha
		local width = hasSubtitleValue and math.clamp(tonumber(subtitleValue.width) or 0.62, 0.2, 1) or 0.62
		local height = getSubtitleHeight(refs.subtitle, refs.subtitle.Text, refs.subtitle.Font, textSize, width, scale, (not hasSubtitleValue) or subtitleValue.autoFit ~= false)
		refs.subtitle.AnchorPoint = anchor
		refs.subtitle.Position = UDim2.fromScale(x, y)
		refs.subtitle.Size = UDim2.new(width * scale, 0, 0, height)
		refs.subtitle.TextSize = textSize
		refs.subtitle.TextColor3 = hasSubtitleValue and subtitleValue.textColor or Color3.fromRGB(245, 248, 255)
		refs.subtitle.BackgroundColor3 = hasSubtitleValue and subtitleValue.backgroundColor or Color3.fromRGB(0, 0, 0)
		refs.subtitle.TextTransparency = hasSubtitleValue
			and ((subtitleValue.textEnabled == false) and 1 or blendTransparency(subtitleValue.textTransparency, opacityAlpha))
			or 0
		refs.subtitle.BackgroundTransparency = hasSubtitleValue
			and ((subtitleValue.backgroundEnabled == false) and 1 or blendTransparency(subtitleValue.backgroundTransparency, opacityAlpha))
			or 0.28
	end
	self:_setDepthOfFieldEnabled(hasDepthOfFieldValue and depthOfFieldValue.enabled ~= false, depthOfFieldValue or {})

	return true
end

function ScreenEffectsRenderer:destroy()
	if self._depthOfField then
		self._depthOfField:Destroy()
	end
	if self._gui then
		self._gui:Destroy()
	end
	self._gui = nil
	self._refs = nil
	self._depthOfField = nil
end

return ScreenEffectsRenderer
</ProtectedString>
        </Properties>
