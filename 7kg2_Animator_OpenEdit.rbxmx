			},
		})
		ChangeHistoryService:SetWaypoint("After Set Custom Screen Effect Keyframe")
		refreshUi(string.format("Set custom fade keyframe at frame %d.", timeline:getCurrentFrame()))
	else
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set custom effect keyframe.")
