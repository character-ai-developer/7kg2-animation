	local function commitAnimationNameInput()
		if not self._animationNameInput or not callbacks.onRenameAnimation then
			return
		end

		local nextName = tostring(self._animationNameInput.Text or "")
		local trimmedName = nextName:gsub("^%s+", ""):gsub("%s+$", "")
		local currentName = tostring((self._lastViewModel and self._lastViewModel.animationName) or "Untitled Animation")
		if trimmedName ~= "" and trimmedName ~= currentName then
			callbacks.onRenameAnimation(trimmedName)
		end
	end

	self:_connect(self._animationNameInput.FocusLost, function(enterPressed)
		commitAnimationNameInput()
	end)

