		trackName = "Camera Flash",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			color = Color3.fromRGB(255, 255, 255),
			transparency = 0.15,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "color", label = "Flash Color", kind = "color" },
			{ key = "transparency", label = "Transparency (0 visible, 1 hidden)", kind = "number", min = 0, max = 1 },
		},
	},
	Letterbox = {
		id = "Letterbox",
		name = "Letterbox",
		description = "Adds cinematic bars to the top and bottom of the viewer.",
		trackName = "Letterbox",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			barSize = 0.12,
			color = Color3.fromRGB(0, 0, 0),
			transparency = 0,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "barSize", label = "Bar Size (0-0.4)", kind = "number", min = 0, max = 0.4 },
			{ key = "color", label = "Bar Color", kind = "color" },
			{ key = "transparency", label = "Bar Transparency", kind = "number", min = 0, max = 1 },
		},
	},
	Vignette = {
		id = "Vignette",
		name = "Vignette",
		description = "Darkens or lightens the screen edges to guide attention.",
		trackName = "Vignette",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			tone = "Dark",
			transparency = 0.18,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "tone", label = "Tone", kind = "choice", choices = { "Dark", "Light" } },
			{ key = "transparency", label = "Edge Transparency", kind = "number", min = 0, max = 1 },
		},
	},
	FilmGrain = {
		id = "FilmGrain",
		name = "Film Grain",
		description = "Adds static grain texture over the viewer for a less digital look.",
		trackName = "Film Grain",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			intensity = 0.35,
			transparency = 0.2,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "intensity", label = "Intensity (0-1)", kind = "number", min = 0, max = 1 },
			{ key = "transparency", label = "Texture Transparency", kind = "number", min = 0, max = 1 },
		},
	},
	Subtitle = {
		id = "Subtitle",
		name = "Subtitle",
		description = "Shows timed captions with editable text, colors, visibility, and transition metadata.",
		trackName = "Subtitle",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			text = "Your subtitle goes here",
			font = "GothamSemibold",
			textSize = 28,
			textColor = Color3.fromRGB(245, 248, 255),
			backgroundColor = Color3.fromRGB(0, 0, 0),
			textTransparency = 0,
			backgroundTransparency = 0.28,
			textEnabled = true,
			backgroundEnabled = true,
			enterTransition = "Fade",
			exitTransition = "Fade",
			enterDuration = 0.15,
			exitDuration = 0.15,
			positionPreset = "Bottom",
			positionX = 0.5,
			positionY = 0.88,
			width = 0.62,
			autoFit = true,
		},
		fields = {
			{ key = "enabled", label = "Subtitle Enabled", kind = "boolean" },
			{ key = "text", label = "Subtitle Text", kind = "text" },
			{ key = "font", label = "Font", kind = "font", choices = getFontChoices() },
			{ key = "textSize", label = "Text Size", kind = "number", min = 8, max = 80 },
			{ key = "textColor", label = "Text Color", kind = "color" },
			{ key = "backgroundColor", label = "Background Color", kind = "color" },
			{ key = "textTransparency", label = "Text Transparency", kind = "number", min = 0, max = 1 },
			{ key = "backgroundTransparency", label = "Background Transparency", kind = "number", min = 0, max = 1 },
			{ key = "textEnabled", label = "Text Visible", kind = "boolean" },
			{ key = "backgroundEnabled", label = "Background Visible", kind = "boolean" },
			{ key = "enterTransition", label = "Enter Preset", kind = "choice", choices = TRANSITION_CHOICES },
			{ key = "exitTransition", label = "Exit Preset", kind = "choice", choices = TRANSITION_CHOICES },
			{ key = "enterDuration", label = "Enter Duration (seconds)", kind = "number", min = 0, max = 5 },
			{ key = "exitDuration", label = "Exit Duration (seconds)", kind = "number", min = 0, max = 5 },
			{ key = "positionPreset", label = "Position Preset", kind = "choice", choices = { "Bottom", "Top", "Center", "Custom" } },
			{ key = "positionX", label = "Position X (0 left, 1 right)", kind = "number", min = 0, max = 1 },
			{ key = "positionY", label = "Position Y (0 top, 1 bottom)", kind = "number", min = 0, max = 1 },
			{ key = "width", label = "Width (0.2-1)", kind = "number", min = 0.2, max = 1 },
			{ key = "autoFit", label = "Auto Fit Text", kind = "boolean" },
		},
	},
	ColorWash = {
		id = "ColorWash",
		name = "Color Wash",
		description = "Adds a stylized color tint over the whole viewer.",
		trackName = "Color Wash",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			color = Color3.fromRGB(129, 80, 255),
			transparency = 0.72,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "color", label = "Wash Color", kind = "color" },
			{ key = "transparency", label = "Transparency", kind = "number", min = 0, max = 1 },
		},
	},
	DepthOfField = {
		id = "DepthOfField",
		name = "Depth Of Field",
		description = "Adds background blur by focusing around a chosen distance.",
		trackName = "Depth Of Field",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			focusDistance = 10,
			inFocusRadius = 1.25,
			nearIntensity = 0.15,
			farIntensity = 0.9,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "focusDistance", label = "Focus Distance", kind = "number", min = 0, max = 1000 },
			{ key = "inFocusRadius", label = "In Focus Radius", kind = "number", min = 0, max = 1000 },
			{ key = "nearIntensity", label = "Near Blur", kind = "number", min = 0, max = 1 },
			{ key = "farIntensity", label = "Far Blur", kind = "number", min = 0, max = 1 },
		},
	},
	Fade = {
		id = "Fade",
		name = "Fade",
		description = "Adds a full-screen fade overlay for scene starts, endings, and cuts.",
		trackName = "Fade",
		sortOrder = 3,
		defaultValue = {
			enabled = true,
			preset = "Fade Out",
			color = Color3.fromRGB(0, 0, 0),
			transparency = 0.5,
			duration = 1,
		},
		fields = {
			{ key = "enabled", label = "Enabled", kind = "boolean" },
			{ key = "preset", label = "Preset", kind = "choice", choices = FADE_PRESET_CHOICES },
			{ key = "color", label = "Fade Color", kind = "color" },
			{ key = "transparency", label = "Transparency", kind = "number", min = 0, max = 1 },
			{ key = "duration", label = "Duration (seconds)", kind = "number", min = 0.02, max = 60 },
		},
	},
}

local function cloneValue(value)
	if typeof(value) == "table" then
		local clone = {}
		for key, childValue in pairs(value) do
			clone[key] = cloneValue(childValue)
		end
		return clone
	end
	return value
end

local function trim(text)
	return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function normalizeEffectType(effectType)
	local raw = tostring(effectType or "")
	if raw == "Film Grain" then
		raw = "FilmGrain"
	elseif raw == "Camera Flash" then
		raw = "CameraFlash"
	elseif raw == "Color Wash" then
		raw = "ColorWash"
	elseif raw == "Depth Of Field" or raw == "Depth of Field" then
		raw = "DepthOfField"
	end
	return EFFECT_DEFINITIONS[raw] and raw or ScreenEffectTrackService.FADE_EFFECT
end

local function parseColor(text)
	if typeof(text) == "Color3" then
		return text
	end

	local raw = trim(text)
	local hex = raw:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		return Color3.fromRGB(
			tonumber(hex:sub(1, 2), 16),
			tonumber(hex:sub(3, 4), 16),
			tonumber(hex:sub(5, 6), 16)
		)
	end

	local values = {}
	for token in raw:gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value then
			table.insert(values, value)
		end
	end
	if #values &lt; 3 then
		return nil
	end

	if values[1] &lt;= 1 and values[2] &lt;= 1 and values[3] &lt;= 1 then
		return Color3.new(
			math.clamp(values[1], 0, 1),
			math.clamp(values[2], 0, 1),
			math.clamp(values[3], 0, 1)
		)
	end

	return Color3.fromRGB(
		math.clamp(math.floor(values[1] + 0.5), 0, 255),
		math.clamp(math.floor(values[2] + 0.5), 0, 255),
		math.clamp(math.floor(values[3] + 0.5), 0, 255)
	)
end

local function formatNumber(value)
	local number = tonumber(value)
	if not number then
		return ""
	end
	local text = string.format("%.3f", number)
	return text:gsub("0+$", ""):gsub("%.$", "")
end

local function formatColor(color)
	if typeof(color) ~= "Color3" then
		return ""
	end
	return string.format(
		"%d,%d,%d",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function choiceValue(value, choices, fallback)
	local text = trim(value)
	for _, choice in ipairs(choices or {}) do
		if string.lower(text) == string.lower(tostring(choice)) then
			return choice
		end
	end
	return fallback
end

local function parseBoolean(value)
	if type(value) == "boolean" then
		return value
	end
	local text = string.lower(trim(value))
	return text == "true" or text == "1" or text == "yes" or text == "on" or text == "enabled"
end

local function clampNumber(value, field, fallback)
	local number = tonumber(value)
	if not number then
		return fallback
	end
	if field.min ~= nil or field.max ~= nil then
		number = math.clamp(number, field.min or -math.huge, field.max or math.huge)
	end
	return number
end

function ScreenEffectTrackService.normalizeEffectType(effectType)
	return normalizeEffectType(effectType)
end

function ScreenEffectTrackService.getEffectDefinition(effectType)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	return definition and cloneValue(definition) or nil
end

function ScreenEffectTrackService.getEffectDefinitions()
	local definitions = {}
	for _, effectType in ipairs(EFFECT_ORDER) do
		local definition = EFFECT_DEFINITIONS[effectType]
		table.insert(definitions, {
			id = definition.id,
			name = definition.name,
			description = definition.description,
		})
	end
	return definitions
end

function ScreenEffectTrackService.getEditorFields(effectType)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	return definition and cloneValue(definition.fields) or {}
end

function ScreenEffectTrackService.defaultFadeValue()
	return ScreenEffectTrackService.getDefaultValueForEffect(ScreenEffectTrackService.FADE_EFFECT)
end

function ScreenEffectTrackService.getDefaultValueForEffect(effectType)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	return cloneValue(definition.defaultValue)
end

function ScreenEffectTrackService.normalizeValue(effectType, value)
	local definition = EFFECT_DEFINITIONS[normalizeEffectType(effectType)]
	local normalized = cloneValue(definition.defaultValue)
	if type(value) ~= "table" then
		return normalized
	end

	for _, field in ipairs(definition.fields or {}) do
		local incoming = value[field.key]
		if incoming == nil then
			continue
		end
		if field.kind == "boolean" then
			normalized[field.key] = parseBoolean(incoming)
		elseif field.kind == "number" then
			normalized[field.key] = clampNumber(incoming, field, normalized[field.key])
		elseif field.kind == "color" then
			normalized[field.key] = parseColor(incoming) or normalized[field.key]
		elseif field.kind == "choice" or field.kind == "font" then
			normalized[field.key] = choiceValue(incoming, field.choices, normalized[field.key])
		elseif field.kind == "text" then
			normalized[field.key] = string.sub(tostring(incoming or ""), 1, 240)
		end
	end

	return normalized
end

function ScreenEffectTrackService.formatFieldValue(field, value)
	if not field then
		return ""
	end
	if field.kind == "color" then
		return formatColor(value)
	elseif field.kind == "number" then
		return formatNumber(value)
	elseif field.kind == "boolean" then
		return value == true and "On" or "Off"
	end
	return tostring(value or "")
end

function ScreenEffectTrackService.parseEditorFields(effectType, fieldValues)
	local effectId = normalizeEffectType(effectType)
	local definition = EFFECT_DEFINITIONS[effectId]
	local value = cloneValue(definition.defaultValue)

	for _, field in ipairs(definition.fields or {}) do
		local rawValue = fieldValues and fieldValues[field.key]
		if rawValue == nil then
			continue
		end

		if field.kind == "boolean" then
			value[field.key] = parseBoolean(rawValue)
		elseif field.kind == "number" then
			local number = tonumber(rawValue)
			if not number then
				return false, string.format("%s needs a number.", field.label or field.key)
			end
			value[field.key] = clampNumber(number, field, value[field.key])
		elseif field.kind == "color" then
			local color = parseColor(rawValue)
			if not color then
				return false, string.format("%s needs RGB like 255,255,255 or #ffffff.", field.label or field.key)
			end
			value[field.key] = color
		elseif field.kind == "choice" or field.kind == "font" then
			value[field.key] = choiceValue(rawValue, field.choices, value[field.key])
		elseif field.kind == "text" then
			value[field.key] = string.sub(tostring(rawValue or ""), 1, 240)
		end
	end

	return true, value
end

function ScreenEffectTrackService.fadePreset(presetName)
	presetName = tostring(presetName or "")
	if presetName == "Transparent" then
		return {
			enabled = true,
			color = Color3.fromRGB(0, 0, 0),
			transparency = 1,
		}
	elseif presetName == "White" then
		return {
			enabled = true,
			color = Color3.fromRGB(255, 255, 255),
			transparency = 0,
		}
	elseif presetName == "Half" then
		return {
			enabled = true,
			color = Color3.fromRGB(0, 0, 0),
			transparency = 0.5,
		}
	end

	return {
		enabled = true,
		color = Color3.fromRGB(0, 0, 0),
		transparency = 0,
	}
end

function ScreenEffectTrackService.customFadeValue(color, transparency)
	return ScreenEffectTrackService.normalizeValue(ScreenEffectTrackService.FADE_EFFECT, {
		enabled = true,
		color = typeof(color) == "Color3" and color or Color3.fromRGB(0, 0, 0),
		transparency = math.clamp(tonumber(transparency) or 0.5, 0, 1),
	})
end

function ScreenEffectTrackService.isScreenEffectTrack(track)
	return track and track.trackType == ScreenEffectTrackService.TRACK_TYPE
end

function ScreenEffectTrackService.getTrackEffectType(track)
	if not ScreenEffectTrackService.isScreenEffectTrack(track) then
		return nil
	end
	local metadataRaw = track.valueType or track.effectType
	local metadataType = normalizeEffectType(metadataRaw)
	local nameRaw = track.name
	local nameType = normalizeEffectType(nameRaw)
	if tostring(nameRaw or "") ~= "" and nameType ~= ScreenEffectTrackService.FADE_EFFECT then
		if tostring(metadataRaw or "") == "" or metadataType == ScreenEffectTrackService.FADE_EFFECT then
			return nameType
		end
	end
	return metadataType
end

function ScreenEffectTrackService.findTrack(timeline, effectType)
	local effectId = normalizeEffectType(effectType)
	for _, track in ipairs(timeline:getTracks()) do
		if ScreenEffectTrackService.getTrackEffectType(track) == effectId then
			return track
		end
	end
	return nil
end

function ScreenEffectTrackService.addTrack(timeline, effectType)
	local effectId = normalizeEffectType(effectType)
	local definition = EFFECT_DEFINITIONS[effectId]
	local existingTrack = ScreenEffectTrackService.findTrack(timeline, effectId)
	if existingTrack then
		return existingTrack, false
	end

	return timeline:addGenericTrack("ScreenEffect", nil, definition.trackName or definition.name, {
		effectType = effectId,
		sortOrder = definition.sortOrder or 3,
	}), true
end

function ScreenEffectTrackService.addFadeTrack(timeline)
	return ScreenEffectTrackService.addTrack(timeline, ScreenEffectTrackService.FADE_EFFECT)
end

function ScreenEffectTrackService.getDefaultValueForTrack(track)
	if ScreenEffectTrackService.isScreenEffectTrack(track) then
		return ScreenEffectTrackService.getDefaultValueForEffect(ScreenEffectTrackService.getTrackEffectType(track))
	end
	return nil
end

function ScreenEffectTrackService.isSubtitleTrack(track)
	return ScreenEffectTrackService.getTrackEffectType(track) == "Subtitle"
end

function ScreenEffectTrackService.isFadeTrack(track)
	return ScreenEffectTrackService.getTrackEffectType(track) == ScreenEffectTrackService.FADE_EFFECT
end

function ScreenEffectTrackService.makeSubtitleEndValue(value)
	local endValue = ScreenEffectTrackService.normalizeValue("Subtitle", value)
	endValue.enabled = false
	endValue.textEnabled = false
	endValue.backgroundEnabled = false
	return endValue
end

function ScreenEffectTrackService.makeFadeTransparentValue(value)
	local fadeValue = ScreenEffectTrackService.normalizeValue(ScreenEffectTrackService.FADE_EFFECT, value)
	fadeValue.enabled = true
	fadeValue.transparency = 1
	return fadeValue
end

function ScreenEffectTrackService.makeFadeVisibleValue(value)
	local fadeValue = ScreenEffectTrackService.normalizeValue(ScreenEffectTrackService.FADE_EFFECT, value)
	fadeValue.enabled = true
	if fadeValue.transparency &gt;= 1 then
		fadeValue.transparency = 0
	end
	return fadeValue
end

function ScreenEffectTrackService.makeFadeClipValues(value)
	local fadeValue = ScreenEffectTrackService.normalizeValue(ScreenEffectTrackService.FADE_EFFECT, value)
	local startValue = ScreenEffectTrackService.makeFadeTransparentValue(fadeValue)
	local endValue = ScreenEffectTrackService.makeFadeVisibleValue(fadeValue)
	local preset = tostring(fadeValue.preset or "Fade Out")
	if preset == "Fade In" then
		startValue = ScreenEffectTrackService.makeFadeVisibleValue(fadeValue)
		endValue = ScreenEffectTrackService.makeFadeTransparentValue(fadeValue)
	elseif preset == "Hold" then
		startValue = ScreenEffectTrackService.makeFadeVisibleValue(fadeValue)
		endValue = ScreenEffectTrackService.makeFadeVisibleValue(fadeValue)
	end
	startValue.preset = preset
	endValue.preset = preset
	startValue.duration = fadeValue.duration
	endValue.duration = fadeValue.duration
	return startValue, endValue
end

function ScreenEffectTrackService.getFadeClipDataForTrack(timeline, track)
	local clips = {}
	if not timeline or not ScreenEffectTrackService.isFadeTrack(track) then
		return clips
	end

	local frames = timeline:getTrackKeyframeFrames(track.path)
	for index, frame in ipairs(frames) do
		local nextFrame = frames[index + 1]
		if not nextFrame or nextFrame &lt;= frame + 1 then
			continue
		end
		local startValue = ScreenEffectTrackService.normalizeValue(ScreenEffectTrackService.FADE_EFFECT, timeline:getTrackValueAtFrame(track.path, frame))
		local endValue = ScreenEffectTrackService.normalizeValue(ScreenEffectTrackService.FADE_EFFECT, timeline:getTrackValueAtFrame(track.path, nextFrame))
		if startValue.enabled == false and endValue.enabled == false then
			continue
		end
		local startTransparency = math.clamp(tonumber(startValue.transparency) or 1, 0, 1)
		local endTransparency = math.clamp(tonumber(endValue.transparency) or 1, 0, 1)
		local label = "Fade"
		if startTransparency &lt; endTransparency - 0.03 then
			label = "Fade In"
		elseif endTransparency &lt; startTransparency - 0.03 then
			label = "Fade Out"
		else
			label = "Fade Hold"
		end
		local color = typeof(endValue.color) == "Color3" and endValue.color or startValue.color
		if label == "Fade In" and typeof(startValue.color) == "Color3" then
			color = startValue.color
		end
		clips[#clips + 1] = {
			frame = frame,
			endFrame = nextFrame,
			durationFrames = math.max(1, nextFrame - frame),
			label = label,
			color = color,
			startTransparency = startTransparency,
			endTransparency = endTransparency,
			value = startValue,
			endValue = endValue,
			hasExplicitEnd = true,
		}
	end
	return clips
end

function ScreenEffectTrackService.getSubtitleClipDataForTrack(timeline, track)
	local clips = {}
	if not timeline or not ScreenEffectTrackService.isSubtitleTrack(track) then
		return clips
	end

	local frames = timeline:getTrackKeyframeFrames(track.path)
	local durationFrames = math.max(1, tonumber(timeline:getDurationFrames()) or 1)
	for index, frame in ipairs(frames) do
		local rawValue = timeline:getTrackValueAtFrame(track.path, frame)
		local value = ScreenEffectTrackService.normalizeValue("Subtitle", rawValue)
		if value.enabled ~= false then
			local nextFrame = frames[index + 1]
			local endFrame = nextFrame or durationFrames
			endFrame = math.max(frame + 1, math.min(durationFrames, math.floor(tonumber(endFrame) or durationFrames)))
			clips[#clips + 1] = {
				frame = frame,
				endFrame = endFrame,
				durationFrames = math.max(1, endFrame - frame),
				text = tostring(value.text or ""),
				value = value,
				hasExplicitEnd = nextFrame ~= nil,
			}
		end
	end
	return clips
end

function ScreenEffectTrackService.ensureSubtitlePreStartKeys(timeline)
	if not timeline or type(timeline.getTracks) ~= "function" then
		return 0
	end

	local addedCount = 0
	for _, track in ipairs(timeline:getTracks()) do
		if not ScreenEffectTrackService.isSubtitleTrack(track) then
			continue
		end

		local frames = timeline:getTrackKeyframeFrames(track.path)
		for _, frame in ipairs(frames) do
			frame = math.max(0, math.floor(tonumber(frame) or 0))
			if frame &lt;= 0 then
				continue
			end

			local value = ScreenEffectTrackService.normalizeValue("Subtitle", timeline:getTrackValueAtFrame(track.path, frame))
			if value.enabled == false then
				continue
			end

			local previousFrame = timeline:getTrackNeighborFrames(track.path, frame - 1)
			if previousFrame == nil then
				local success = timeline:setTrackValueAtFrame(track.path, frame - 1, ScreenEffectTrackService.makeSubtitleEndValue(value))
				if success then
					addedCount += 1
				end
			end
		end
	end

	return addedCount
end

local function getExactTrackValue(timeline, path, frame)
	local pose = timeline:samplePose(frame)
	if type(pose) ~= "table" then
		return nil
	end
	return pose[path]
end

local function getSubtitleTimelineValue(timeline, track, frame)
	frame = math.max(0, math.floor(tonumber(frame) or timeline:getCurrentFrame() or 0))
	local activeClip = nil
	for _, clip in ipairs(ScreenEffectTrackService.getSubtitleClipDataForTrack(timeline, track)) do
		if frame &gt;= clip.frame and frame &lt; clip.endFrame then
			activeClip = clip
			break
		end
	end
	if not activeClip then
		return nil
	end

	local previousFrame = activeClip.frame
	local nextFrame = activeClip.endFrame
	local value = ScreenEffectTrackService.normalizeValue("Subtitle", activeClip.value)
	if value.enabled == false then
		value._transitionAlpha = 0
		return value
	end

	local fps = math.max(1, tonumber(timeline:getFps()) or 60)
	local transitionAlpha = 1
	local transitionPreset = "None"
	local enterFrames = math.max(0, (tonumber(value.enterDuration) or 0) * fps)
	if enterFrames &gt; 0 and frame &lt;= previousFrame + enterFrames then
		transitionAlpha = math.min(transitionAlpha, math.clamp((frame - previousFrame) / enterFrames, 0, 1))
		transitionPreset = value.enterTransition or "Fade"
	end

	if nextFrame and nextFrame &gt; previousFrame then
		local exitFrames = math.max(0, (tonumber(value.exitDuration) or 0) * fps)
		if exitFrames &gt; 0 and frame &gt;= nextFrame - exitFrames then
			transitionAlpha = math.min(transitionAlpha, math.clamp((nextFrame - frame) / exitFrames, 0, 1))
			transitionPreset = value.exitTransition or "Fade"
		end
	end

	value._transitionAlpha = transitionAlpha
	value._transitionPreset = transitionPreset
	return value
end

function ScreenEffectTrackService.getTimelineEffectValues(timeline, frame)
	frame = frame or timeline:getCurrentFrame()
	local pose = timeline:samplePose(frame)
	local values = {}
	if type(pose) ~= "table" then
		return values
	end

	for _, track in ipairs(timeline:getTracks()) do
		if ScreenEffectTrackService.isScreenEffectTrack(track) and not timeline:isTrackDisabled(track.path) then
			local effectId = ScreenEffectTrackService.getTrackEffectType(track)
			local rawValue = effectId == "Subtitle" and getSubtitleTimelineValue(timeline, track, frame) or pose[track.path]
			if rawValue ~= nil then
				values[effectId] = ScreenEffectTrackService.normalizeValue(effectId, rawValue)
				if type(rawValue) == "table" then
					values[effectId]._transitionAlpha = rawValue._transitionAlpha
					values[effectId]._transitionPreset = rawValue._transitionPreset
				end
			end
		end
	end

	return values
end

function ScreenEffectTrackService.getTimelineEffectTrackIds(timeline)
	local ids = {}
	if not timeline or type(timeline.getTracks) ~= "function" then
		return ids
	end
	for _, track in ipairs(timeline:getTracks()) do
		if ScreenEffectTrackService.isScreenEffectTrack(track) and not timeline:isTrackDisabled(track.path) then
			ids[ScreenEffectTrackService.getTrackEffectType(track)] = true
		end
	end
	return ids
end

function ScreenEffectTrackService.getTimelineFade(timeline, frame)
	local values = ScreenEffectTrackService.getTimelineEffectValues(timeline, frame)
	local fade = values[ScreenEffectTrackService.FADE_EFFECT]
	if type(fade) ~= "table" or fade.enabled == false then
		return nil
	end
	return fade
end

function ScreenEffectTrackService.applyTimelineEffects(effectsViewModel, timeline, frame)
	local viewModel = cloneValue(effectsViewModel or {})
	viewModel.timelineScreenEffects = ScreenEffectTrackService.getTimelineEffectValues(timeline, frame)
	viewModel.timelineScreenEffectTrackIds = ScreenEffectTrackService.getTimelineEffectTrackIds(timeline)
	viewModel.timelineOwnsSubtitle = viewModel.timelineScreenEffectTrackIds.Subtitle == true
	viewModel.timelineFade = viewModel.timelineScreenEffects[ScreenEffectTrackService.FADE_EFFECT]
	return viewModel
end

return ScreenEffectTrackService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX223">
        <Properties>
          <string name="Name">SelectedGizmoSupport</string>
          <ProtectedString name="Source">local SelectedGizmoSupport = {}

function SelectedGizmoSupport.loadHighlightService(modules)
	local highlightOk, loadedHighlightService = pcall(function()
		return require(modules:WaitForChild("RigPartHighlightService"))
	end)
	if highlightOk then
		return loadedHighlightService
	end
	return nil
end

function SelectedGizmoSupport.showRigPartHighlight(highlightService, rigPartHighlightEnabled, motors)
	if not highlightService then
		return
	end
	local shouldShowMultiSelection = type(motors) == "table" and #motors &gt; 1
	local shouldShowBoneSelection = false
	for _, motorData in ipairs(motors or {}) do
		local instance = motorData and motorData.instance
		if motorData and (motorData.isBone == true or motorData.jointType == "Bone" or (instance and instance:IsA("Bone"))) then
			shouldShowBoneSelection = true
			break
		end
	end
	if rigPartHighlightEnabled == false and not shouldShowMultiSelection and not shouldShowBoneSelection then
		highlightService.clear()
		return
	end
	highlightService.showForMotors(motors or {})
end

function SelectedGizmoSupport.clearRigPartHighlight(highlightService)
	if highlightService then
		highlightService.clear()
	end
end

function SelectedGizmoSupport.getSelectedTrackMotors(timeline, selectedPaths)
	local trackMotors = {}
	for _, selectedPath in ipairs(selectedPaths or {}) do
		local motor = timeline:getMotorByPath(selectedPath)
		if motor then
			table.insert(trackMotors, motor)
		end
	end
	return trackMotors
end

return SelectedGizmoSupport
