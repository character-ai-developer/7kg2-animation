		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 122,
	})

	local amountPanel = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 88),
		Size = UDim2.new(1, -36, 0, 124),
		ZIndex = 122,
	})
	applySectionSurface(amountPanel)
	createCorner(amountPanel, 10)
	createStroke(amountPanel)
	createLabel(amountPanel, "Rotation degrees", 14, 10, 140)
	createLabel(amountPanel, "Position studs", 214, 10, 140)

	createLabel(amountPanel, "Angle X", 14, 38, 64)
	local angleXInput = createInput(amountPanel, 78, 34, 86, "2")
	createLabel(amountPanel, "Pos X", 214, 38, 56)
	local posXInput = createInput(amountPanel, 270, 34, 86, "0")

	createLabel(amountPanel, "Angle Y", 14, 68, 64)
	local angleYInput = createInput(amountPanel, 78, 64, 86, "2")
	createLabel(amountPanel, "Pos Y", 214, 68, 56)
	local posYInput = createInput(amountPanel, 270, 64, 86, "0")

	createLabel(amountPanel, "Angle Z", 14, 98, 64)
	local angleZInput = createInput(amountPanel, 78, 94, 86, "2")
	createLabel(amountPanel, "Pos Z", 214, 98, 56)
	local posZInput = createInput(amountPanel, 270, 94, 86, "0")

	local paramsPanel = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 222),
		Size = UDim2.new(1, -36, 0, 82),
		ZIndex = 122,
	})
	applySectionSurface(paramsPanel)
	createCorner(paramsPanel, 10)
	createStroke(paramsPanel)
	createLabel(paramsPanel, "Every", 14, 12, 80)
	local intervalInput = createInput(paramsPanel, 78, 8, 104, "0:02")
	intervalInput.PlaceholderText = "2, 10f, 0.5s"

	createLabel(paramsPanel, "Style", 14, 46, 58)
	local easingStyleButton = create("TextButton", {
		Name = "WiggleEasingStyleButton",
		Parent = paramsPanel,
		Position = UDim2.new(0, 78, 0, 42),
		Size = UDim2.new(0, 124, 0, 26),
		Text = "Linear v",
		ZIndex = 122,
	})
	styleGhostButton(easingStyleButton)
	easingStyleButton.TextSize = 11
	createCorner(easingStyleButton, 7)
	local easingStyleDropdown, easingStyleOptionButtons = createDropdownMenu(easingStyleButton, Constants.EASING_STYLES, 6)
	liftDropdown(easingStyleDropdown)

	createLabel(paramsPanel, "Dir", 224, 46, 36)
	local easingDirectionButton = create("TextButton", {
		Name = "WiggleEasingDirectionButton",
		Parent = paramsPanel,
		Position = UDim2.new(0, 260, 0, 42),
		Size = UDim2.new(0, 110, 0, 26),
		Text = "InOut v",
		ZIndex = 122,
	})
	styleGhostButton(easingDirectionButton)
	easingDirectionButton.TextSize = 11
	createCorner(easingDirectionButton, 7)
	local easingDirectionDropdown, easingDirectionOptionButtons = createDropdownMenu(easingDirectionButton, Constants.EASING_DIRECTIONS, 3)
	liftDropdown(easingDirectionDropdown)

	local statusLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 312),
		Size = UDim2.new(0.5, -24, 0, 34),
		Font = Enum.Font.Gotham,
		Text = "",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 122,
	})

	local cancelButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.5, 0, 1, -46),
		Size = UDim2.new(0.25, -8, 0, 30),
		Text = "Cancel",
		ZIndex = 122,
	})
	styleGhostButton(cancelButton)
	createCorner(cancelButton, 8)

	local okButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.75, 0, 1, -46),
		Size = UDim2.new(0.25, -18, 0, 30),
		Text = "OK",
		ZIndex = 122,
	})
	styleTextButton(okButton)
	createCorner(okButton, 8)

	return {
		_wiggleFramesOverlay = overlay,
		_wiggleFramesCloseButton = closeButton,
		_wiggleFramesAngleXInput = angleXInput,
		_wiggleFramesAngleYInput = angleYInput,
		_wiggleFramesAngleZInput = angleZInput,
		_wiggleFramesPosXInput = posXInput,
		_wiggleFramesPosYInput = posYInput,
		_wiggleFramesPosZInput = posZInput,
		_wiggleFramesIntervalInput = intervalInput,
		_wiggleFramesEasingStyleButton = easingStyleButton,
		_wiggleFramesEasingStyleDropdown = easingStyleDropdown,
		_wiggleFramesEasingStyleOptionButtons = easingStyleOptionButtons,
		_wiggleFramesEasingDirectionButton = easingDirectionButton,
		_wiggleFramesEasingDirectionDropdown = easingDirectionDropdown,
		_wiggleFramesEasingDirectionOptionButtons = easingDirectionOptionButtons,
		_wiggleFramesStatusLabel = statusLabel,
		_wiggleFramesCancelButton = cancelButton,
		_wiggleFramesOkButton = okButton,
	}
end

function WiggleFramesUI.update(_context)
end

