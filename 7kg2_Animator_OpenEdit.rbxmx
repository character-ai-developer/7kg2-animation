	trigger = {
		title = "Trigger",
		detail = "Choose how the cutscene starts, such as manual, part touched, proximity prompt, timed, or auto start.",
	},
	replay = {
		title = "Replay",
		detail = "Choose whether the cutscene can play once or every time the trigger happens.",
	},
	restoreCamera = {
		title = "Restore Camera",
		detail = "When on, the player's normal camera is restored after the cutscene ends.",
	},
	rigMode = {
		title = "Character",
		detail = "Use the exported dummy rig, or replace it with the triggering player's avatar at runtime.",
	},
	playerEnd = {
		title = "After",
		detail = "When using Player Avatar mode, choose whether the player returns to the start or ends at the cutscene finish.",
	},
	hidePlayer = {
		title = "Hide Player",
		detail = "When using Player Avatar mode, hide the real player while the temporary clone performs the cutscene.",
	},
	skip = {
		title = "Skip Button",
		detail = "When on, local playback shows a simple Skip button so players can end the cutscene early.",
	},
	propEndState = {
		title = "Attached Props",
		detail = "Choose what happens to props used by Attach/Detach events after the local cutscene finishes.",
	},
	afterCutscene = {
		title = "After Cutscene",
		detail = "Stay in the current place, or teleport the players who watched to a destination Place ID after playback.",
	},
	validate = {
		title = "Validate Package",
		detail = "Checks whether the current timeline can be exported as a cutscene package and reports warnings before generating.",
	},
	generate = {
		title = "Generate Package",
		detail = "Creates the cutscene package folder, data, scripts, and README output using the current options.",
	},
}

function ScriptUI.mount(parent, context)
	if not parent then
		error("ScriptUI.mount requires parent")
	end
	context = context or {}
	local embeddedPopup = context.embeddedPopup == true
	local hideHeader = context.hideHeader == true
	local includeValidateButton = context.includeValidateButton == true
	local hideStatusPanel = context.hideStatusPanel == true
	local topOffset = hideHeader and -56 or 0
	local panelDescriptionHeight = embeddedPopup and 54 or 36
	local lowerPanelSize = embeddedPopup and UDim2.new(0.32, -20, 0, 230) or UDim2.new(0.32, -20, 0, 218)
	local soundPanelSize = UDim2.new(0.34, -20, 0, 212)
	local exportPanelSize = UDim2.new(0.34, -20, 0, 230)
	local includesPanelSize = embeddedPopup and UDim2.new(0.34, -16, 0, 454) or UDim2.new(0.34, -16, 0, 442)
	local bulletHeight = embeddedPopup and 24 or 22

	local refs = {}
	local exportOptions = {
		playback = "LocalPlayer",
		trigger = "Manual",
		replay = "Once",
		delaySeconds = "0",
		triggerPartPath = "Workspace.CutsceneTrigger",
		triggerPromptPath = "Workspace.CutscenePrompt.ProximityPrompt",
		restoreCamera = true,
		rigTargetMode = "WorkspaceRig",
		playerRigName = "",
		playerEndMode = "ReturnToStart",
		hidePlayerDuringCutscene = true,
		allowSkip = true,
		attachedPropEndState = "Restore",
		fadeInSeconds = "0",
		fadeOutSeconds = "0",
		afterCutsceneAction = "StayHere",
		teleportPlaceId = "",
	}

	local scriptCard
	if embeddedPopup then
		scriptCard = create("Frame", {
			Parent = parent,
			BackgroundColor3 = Constants.THEME.Panel,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.fromScale(1, 1),
		})
		applyPanelSurface(scriptCard)
	else
		scriptCard = createCard(parent, UDim2.new(1, 0, 0, 560))
	end
	scriptCard.Name = "ScriptWorkspaceCard"
	scriptCard.Position = UDim2.new(0, 0, 0, 0)
	scriptCard.Visible = false
	scriptCard.ClipsDescendants = true

	local tooltip = create("Frame", {
		Parent = scriptCard,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(340, 96),
		Visible = false,
		ZIndex = 1000,
	})
	createCorner(tooltip, 10)
	createStroke(tooltip)
	local tooltipTitle = create("TextLabel", {
		Parent = tooltip,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 1001,
	})
	local tooltipDetail = create("TextLabel", {
		Parent = tooltip,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 1, -38),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 1001,
	})

	local function showTooltip(anchor, info)
		if not anchor or not anchor.Parent or not info then
			return
		end
		tooltipTitle.Text = tostring(anchor.Text or info.title or "Info")
		tooltipDetail.Text = info.detail or ""
		local cardAbs = scriptCard.AbsolutePosition
		local cardSize = scriptCard.AbsoluteSize
		local anchorAbs = anchor.AbsolutePosition
		local anchorSize = anchor.AbsoluteSize
		local width = tooltip.AbsoluteSize.X &gt; 0 and tooltip.AbsoluteSize.X or 340
		local height = tooltip.AbsoluteSize.Y &gt; 0 and tooltip.AbsoluteSize.Y or 96
		local x = anchorAbs.X - cardAbs.X
		local y = anchorAbs.Y - cardAbs.Y + anchorSize.Y + 8
		if y + height &gt; cardSize.Y - 8 then
			y = math.max(8, anchorAbs.Y - cardAbs.Y - height - 8)
		end
		x = math.clamp(x, 8, math.max(8, cardSize.X - width - 8))
		tooltip.Position = UDim2.fromOffset(x, y)
		tooltip.Visible = true
	end

	local function bindTooltip(button, info)
		if not button or not info then
			return
		end
		local function show()
			local tooltipInfo = info
			if type(info) == "function" then
				local ok, resolved = pcall(info)
				if not ok then
					return
				end
				tooltipInfo = resolved
			end
			showTooltip(button, tooltipInfo)
		end
		button.MouseEnter:Connect(show)
		button.MouseMoved:Connect(show)
		button.MouseLeave:Connect(function()
			tooltip.Visible = false
		end)
	end

	local titleLabel = create("TextLabel", {
		Parent = scriptCard,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 16, 0, 12 + topOffset),
		Size = UDim2.new(0, 210, 0, 22),
		Text = "Cutscene Maker",
		TextColor3 = Constants.THEME.Text,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local subtitle = createMetaLabel(
		scriptCard,
		"Choose playback options, then generate a ready-to-test cutscene package.",
		22
	)
	subtitle.Position = UDim2.new(0, 16, 0, 40 + topOffset)
	titleLabel.Visible = not hideHeader
	subtitle.Visible = not hideHeader

	local playbackPanel = makePanel(
		scriptCard,
		"1. Playback &amp; Trigger",
		"Pick who sees it, how it starts, and whether the camera returns afterward.",
		UDim2.new(0, 16, 0, 76 + topOffset),
		UDim2.new(0.32, -20, 0, 212),
		panelDescriptionHeight
	)

	local playbackButton = makeOptionButton(playbackPanel, "Plays For: Local Player", UDim2.new(0, 14, 0, 92), UDim2.new(0.5, -22, 0, 44))
	local triggerButton = makeOptionButton(playbackPanel, "Trigger: Manual", UDim2.new(0.5, 8, 0, 92), UDim2.new(0.5, -22, 0, 44))
	local replayButton = makeOptionButton(playbackPanel, "Replay: Once", UDim2.new(0, 14, 0, 144), UDim2.new(0.5, -22, 0, 44))
	local restoreButton = makeOptionButton(playbackPanel, "Restore Camera: On", UDim2.new(0.5, 8, 0, 144), UDim2.new(0.5, -22, 0, 44))
	local triggerInput = makeInput(playbackPanel, exportOptions.triggerPartPath, "Workspace.CutsceneTrigger", UDim2.new(0, 14, 0, 178), UDim2.new(0.66, -18, 0, 26))
	local delayInput = makeInput(playbackPanel, exportOptions.delaySeconds, "Delay seconds", UDim2.new(0.66, 6, 0, 178), UDim2.new(0.34, -20, 0, 26))
	triggerInput.TextSize = 11
	delayInput.TextSize = 11

	local characterPanel = makePanel(
		scriptCard,
		"2. Character",
		"Use the dummy rig from the timeline, or play the cutscene on the triggering player's avatar.",
		UDim2.new(0, 16, 0, 300 + topOffset),
		lowerPanelSize,
		panelDescriptionHeight
	)

	local rigModeButton = makeOptionButton(characterPanel, "Character: Dummy Rig", UDim2.new(0, 14, 0, 108), UDim2.new(1, -28, 0, 40))
	local playerEndButton = makeOptionButton(characterPanel, "After: Return To Start", UDim2.new(0.5, 8, 0, 104), UDim2.new(0.5, -22, 0, 34))
	local hidePlayerButton = makeOptionButton(characterPanel, "Hide Player: On", UDim2.new(0, 14, 0, 142), UDim2.new(1, -28, 0, 28))
	local playerRigInput = makeInput(characterPanel, "", "Optional dummy rig name", UDim2.new(0, 14, 0, 174), UDim2.new(1, -28, 0, 26))
	rigModeButton.TextSize = 10
	local characterNote = createMetaLabel(characterPanel, "Tip: animate a dummy, then choose Player Avatar to perform it on the toucher.", 18)
	characterNote.Position = UDim2.new(0, 14, 0, 152)
	characterNote.Size = UDim2.new(1, -28, 0, 44)
	characterNote.TextWrapped = true

	local soundPanel = makePanel(
		scriptCard,
		"3. Sound &amp; Music",
		"Sound keyframes export their SoundId values, so the package can play them without the original Workspace sound object.",
		UDim2.new(0.32, 8, 0, 76 + topOffset),
		soundPanelSize,
		panelDescriptionHeight
	)
	local soundInfo = createMetaLabel(
		soundPanel,
		"Best workflow: add a Sound track, set its Sound ID in the keyframe settings, then generate. The cutscene stores that asset ID in its data.",
		86
	)
	soundInfo.Position = UDim2.new(0, 14, 0, 80)
	soundInfo.Size = UDim2.new(1, -28, 0, 68)
	soundInfo.TextWrapped = true
	local soundNote = createMetaLabel(soundPanel, "Workspace sounds are only needed while authoring, not after export.", 18)
	soundNote.Position = UDim2.new(0, 14, 0, 152)
	soundNote.Size = UDim2.new(1, -28, 0, 34)
	soundNote.TextWrapped = true

	local exportPanel = makePanel(
		scriptCard,
		"4. Generate",
		"Create the folder, data, rig sequences, trigger examples, player scripts, and README instructions.",
		UDim2.new(0.32, 8, 0, 300 + topOffset),
		exportPanelSize,
		panelDescriptionHeight
	)

	if includeValidateButton then
		refs._scriptValidateButton = makeButton(
			exportPanel,
			"Validate Package",
			UDim2.new(0, 14, 0, 88),
			UDim2.new(0.48, -10, 0, 36),
			nil
		)
		refs._scriptGenerateButton = makeButton(
			exportPanel,
			"Generate Package",
			UDim2.new(0.52, 0, 0, 88),
			UDim2.new(0.48, -14, 0, 36),
			Constants.THEME.Accent
		)
	else
		refs._scriptGenerateButton = makeButton(
			exportPanel,
			"Generate Package",
			UDim2.new(0, 14, 0, 88),
			UDim2.new(1, -28, 0, 36),
			Constants.THEME.Accent
		)
	end
	local skipButton = makeOptionButton(exportPanel, "Skip Button: On", UDim2.new(0, 14, 0, 128), UDim2.new(0.48, -10, 0, 26))
	local propEndStateButton = makeOptionButton(exportPanel, "Props: Restore", UDim2.new(0.52, 0, 0, 128), UDim2.new(0.48, -14, 0, 26))
	create("TextLabel", {
		Parent = exportPanel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.new(0, 14, 0, 158),
		Size = UDim2.new(0.5, -22, 0, 14),
		Text = "Fade In (sec)",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	create("TextLabel", {
		Parent = exportPanel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.new(0.5, 8, 0, 158),
		Size = UDim2.new(0.5, -22, 0, 14),
		Text = "Fade Out (sec)",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local fadeInInput = makeInput(exportPanel, exportOptions.fadeInSeconds, "0", UDim2.new(0, 14, 0, 172), UDim2.new(0.5, -22, 0, 24))
	local fadeOutInput = makeInput(exportPanel, exportOptions.fadeOutSeconds, "0", UDim2.new(0.5, 8, 0, 172), UDim2.new(0.5, -22, 0, 24))

	local afterCutsceneButton = makeOptionButton(exportPanel, "After: Stay Here", UDim2.new(0, 14, 0, 200), UDim2.new(1, -28, 0, 26))
	local teleportPlaceInput = makeInput(exportPanel, "", "Destination Place ID", UDim2.new(0.52, 0, 0, 200), UDim2.new(0.48, -14, 0, 26))
	teleportPlaceInput.TextSize = 11

	local includesPanel = makePanel(
		scriptCard,
		"5. What Gets Exported",
		"The generated package includes beginner setup scripts plus editable data for advanced devs.",
		UDim2.new(0.66, 0, 0, 76 + topOffset),
		includesPanelSize,
		panelDescriptionHeight
	)

	local bullets = create("Frame", {
		Parent = includesPanel,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 96),
		Size = UDim2.new(1, -28, 1, -96),
	})
	create("UIListLayout", {
		Parent = bullets,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	makeBullet(bullets, 1, "Rig motion from generated KeyframeSequences.", bulletHeight)
	makeBullet(bullets, 2, "Camera/FOV, CFrame, and sound keyframes.", bulletHeight)
	makeBullet(bullets, 3, "Manual, part touched, proximity prompt, timed, and auto-start examples.", bulletHeight)
	makeBullet(bullets, 4, "Local-player or everyone-in-server playback.", bulletHeight)
	makeBullet(bullets, 5, "Player-avatar replacement plus skip and fade options.", bulletHeight)
	create("Frame", {
		Parent = bullets,
		BackgroundTransparency = 1,
		LayoutOrder = 55,
		Size = UDim2.new(1, 0, 0, 8),
	})
	makeBullet(bullets, 6, "README instructions and upload slots for publishing.", bulletHeight)

	local playbackOptions = {
		{ id = "LocalPlayer", label = "Plays For: Local Player", detail = "Only the player who triggers the cutscene sees the camera, player-avatar, prop, and skip-button playback locally." },
		{ id = "Everyone", label = "Plays For: Everyone", detail = "The server tells every player to play the cutscene at the same time. Good for shared story moments." },
	}
	local triggerOptions = {
		{ id = "Manual", label = "Trigger: Manual", detail = "No automatic trigger is connected. Call the generated play function from your own script when you want the cutscene to start." },
		{ id = "PartTouched", label = "Trigger: Part Touched", detail = "Starts when a player touches the configured Workspace part." },
		{ id = "ProximityPrompt", label = "Trigger: Prompt", detail = "Starts when a player activates the configured ProximityPrompt. The prompt can be hidden locally after use." },
		{ id = "Timed", label = "Trigger: Timed", detail = "Starts after the configured delay once the generated server script runs." },
		{ id = "AutoStart", label = "Trigger: Auto Start", detail = "Starts automatically after the optional delay, without needing touch or prompt input." },
	}
	local replayOptions = {
		{ id = "Once", label = "Replay: Once", detail = "The generated trigger only plays the cutscene once, then ignores later trigger attempts." },
		{ id = "EveryTime", label = "Replay: Every Time", detail = "The trigger can play the cutscene every time a player activates it." },
	}
	local rigModeOptions = {
		{ id = "WorkspaceRig", label = "Character: Dummy Rig", detail = "Uses the exported dummy rig exactly as authored in the workspace." },
		{ id = "TriggeringPlayerClone", label = "Character: Player", detail = "Uses the triggering player's avatar as the cutscene character by playing the dummy rig animation on a temporary clone." },
	}
	local playerEndOptions = {
		{ id = "ReturnToStart", label = "After: Return", detail = "After a player-avatar cutscene, the real player stays at or returns to their original gameplay position." },
		{ id = "MoveToCutsceneEnd", label = "After: End Pos", detail = "After a player-avatar cutscene, the real player is moved to the final cutscene rig position." },
	}
	local propEndStateOptions = {
		{ id = "Restore", label = "Props: Restore", detail = "After playback, attached props return locally to their original authored position and visibility." },
		{ id = "HideLocally", label = "Props: Hide Local", detail = "After playback, props used by Attach/Detach events are hidden for the player who watched the cutscene." },
		{ id = "KeepFinal", label = "Props: Keep Final", detail = "After playback, props used by Attach/Detach events stay locally at their final cutscene position." },
	}
	local afterCutsceneOptions = {
		{ id = "StayHere", label = "After: Stay Here", detail = "Playback ends normally and the player remains in the current place." },
		{ id = "Teleport", label = "After: Teleport", detail = "After playback, the generated server script teleports the players who watched to the destination Place ID." },
	}

	local function refreshOptions()
		playbackButton.Text = selectedLabel(playbackOptions, exportOptions.playback)
		triggerButton.Text = selectedLabel(triggerOptions, exportOptions.trigger)
		replayButton.Text = selectedLabel(replayOptions, exportOptions.replay)
		restoreButton.Text = exportOptions.restoreCamera and "Restore Camera: On" or "Restore Camera: Off"
		rigModeButton.Text = selectedLabel(rigModeOptions, exportOptions.rigTargetMode)
		playerEndButton.Text = selectedLabel(playerEndOptions, exportOptions.playerEndMode)
		hidePlayerButton.Text = exportOptions.hidePlayerDuringCutscene and "Hide Player: On" or "Hide Player: Off"
		skipButton.Text = exportOptions.allowSkip and "Skip Button: On" or "Skip Button: Off"
		propEndStateButton.Text = selectedLabel(propEndStateOptions, exportOptions.attachedPropEndState)
		afterCutsceneButton.Text = selectedLabel(afterCutsceneOptions, exportOptions.afterCutsceneAction)
		teleportPlaceInput.Visible = exportOptions.afterCutsceneAction == "Teleport"
		if teleportPlaceInput.Visible then
			afterCutsceneButton.Size = UDim2.new(0.48, -10, 0, 26)
		else
			afterCutsceneButton.Size = UDim2.new(1, -28, 0, 26)
		end
		triggerInput.Visible = exportOptions.trigger == "PartTouched" or exportOptions.trigger == "ProximityPrompt"
		delayInput.Visible = exportOptions.trigger == "Timed" or exportOptions.trigger == "AutoStart"
		triggerInput.Position = UDim2.new(0, 14, 0, 178)
		triggerInput.Size = UDim2.new(1, -28, 0, 26)
		delayInput.Position = UDim2.new(0, 14, 0, 178)
		delayInput.Size = UDim2.new(1, -28, 0, 26)
		if exportOptions.trigger == "ProximityPrompt" then
			triggerInput.PlaceholderText = "Workspace.CutscenePrompt.ProximityPrompt"
			if triggerInput.Text == "" or triggerInput.Text == exportOptions.triggerPartPath then
				triggerInput.Text = exportOptions.triggerPromptPath
			end
		else
			triggerInput.PlaceholderText = "Workspace.CutsceneTrigger"
			if triggerInput.Text == "" or triggerInput.Text == exportOptions.triggerPromptPath then
				triggerInput.Text = exportOptions.triggerPartPath
			end
		end
		if triggerInput.Visible or delayInput.Visible then
			playbackButton.Position = UDim2.new(0, 14, 0, 88)
			playbackButton.Size = UDim2.new(0.5, -22, 0, 38)
			triggerButton.Position = UDim2.new(0.5, 8, 0, 88)
			triggerButton.Size = UDim2.new(0.5, -22, 0, 38)
			replayButton.Position = UDim2.new(0, 14, 0, 130)
			replayButton.Size = UDim2.new(0.5, -22, 0, 38)
			restoreButton.Position = UDim2.new(0.5, 8, 0, 130)
			restoreButton.Size = UDim2.new(0.5, -22, 0, 38)
		else
			playbackButton.Position = UDim2.new(0, 14, 0, 92)
			playbackButton.Size = UDim2.new(0.5, -22, 0, 44)
			triggerButton.Position = UDim2.new(0.5, 8, 0, 92)
			triggerButton.Size = UDim2.new(0.5, -22, 0, 44)
			replayButton.Position = UDim2.new(0, 14, 0, 144)
			replayButton.Size = UDim2.new(0.5, -22, 0, 44)
			restoreButton.Position = UDim2.new(0.5, 8, 0, 144)
			restoreButton.Size = UDim2.new(0.5, -22, 0, 44)
		end
		playerEndButton.Visible = exportOptions.rigTargetMode == "TriggeringPlayerClone"
		hidePlayerButton.Visible = exportOptions.rigTargetMode == "TriggeringPlayerClone"
		playerRigInput.Visible = exportOptions.rigTargetMode == "TriggeringPlayerClone"
		if exportOptions.rigTargetMode == "TriggeringPlayerClone" then
			rigModeButton.Position = UDim2.new(0, 14, 0, 104)
			rigModeButton.Size = UDim2.new(0.5, -22, 0, 34)
			rigModeButton.TextSize = 11
			hidePlayerButton.Position = UDim2.new(0, 14, 0, 142)
			hidePlayerButton.Size = UDim2.new(1, -28, 0, 28)
			playerRigInput.Position = UDim2.new(0, 14, 0, 174)
			playerRigInput.Size = UDim2.new(1, -28, 0, 26)
			characterNote.Text = "Tip: Optional dummy rig name chooses which animated rig becomes the player. Blank uses the first rig."
			characterNote.Position = UDim2.new(0, 14, 0, 202)
			characterNote.Size = UDim2.new(1, -28, 0, 24)
		else
			rigModeButton.Position = UDim2.new(0, 14, 0, 108)
			rigModeButton.Size = UDim2.new(1, -28, 0, 40)
			rigModeButton.TextSize = 10
			characterNote.Text = "Tip: animate a dummy, then choose Player Avatar to perform it on the toucher."
			characterNote.Position = UDim2.new(0, 14, 0, 160)
			characterNote.Size = UDim2.new(1, -28, 0, 44)
		end
	end

	local function cycleOption(options, key)
		local nextIndex = (findOptionIndex(options, exportOptions[key]) % #options) + 1
		exportOptions[key] = options[nextIndex].id
		refreshOptions()
	end

	playbackButton.Activated:Connect(function()
		cycleOption(playbackOptions, "playback")
	end)
	triggerButton.Activated:Connect(function()
		cycleOption(triggerOptions, "trigger")
	end)
	replayButton.Activated:Connect(function()
		cycleOption(replayOptions, "replay")
	end)
	restoreButton.Activated:Connect(function()
		exportOptions.restoreCamera = not exportOptions.restoreCamera
		refreshOptions()
	end)
	rigModeButton.Activated:Connect(function()
		cycleOption(rigModeOptions, "rigTargetMode")
	end)
	playerEndButton.Activated:Connect(function()
		cycleOption(playerEndOptions, "playerEndMode")
	end)
	hidePlayerButton.Activated:Connect(function()
		exportOptions.hidePlayerDuringCutscene = not exportOptions.hidePlayerDuringCutscene
		refreshOptions()
	end)
	skipButton.Activated:Connect(function()
		exportOptions.allowSkip = not exportOptions.allowSkip
		refreshOptions()
	end)
	propEndStateButton.Activated:Connect(function()
		cycleOption(propEndStateOptions, "attachedPropEndState")
	end)
	afterCutsceneButton.Activated:Connect(function()
		cycleOption(afterCutsceneOptions, "afterCutsceneAction")
	end)

	bindTooltip(playbackButton, function()
		return { title = playbackButton.Text, detail = selectedDetail(playbackOptions, exportOptions.playback, CUTSCENE_BUTTON_TOOLTIPS.playback.detail) }
	end)
	bindTooltip(triggerButton, function()
		return { title = triggerButton.Text, detail = selectedDetail(triggerOptions, exportOptions.trigger, CUTSCENE_BUTTON_TOOLTIPS.trigger.detail) }
	end)
	bindTooltip(replayButton, function()
		return { title = replayButton.Text, detail = selectedDetail(replayOptions, exportOptions.replay, CUTSCENE_BUTTON_TOOLTIPS.replay.detail) }
	end)
	bindTooltip(restoreButton, function()
		return {
			title = restoreButton.Text,
			detail = exportOptions.restoreCamera
				and "After the cutscene ends, the player's normal Roblox camera is restored."
				or "After the cutscene ends, 7kg2 leaves the camera in its last cutscene state.",
		}
	end)
	bindTooltip(rigModeButton, function()
		return { title = rigModeButton.Text, detail = selectedDetail(rigModeOptions, exportOptions.rigTargetMode, CUTSCENE_BUTTON_TOOLTIPS.rigMode.detail) }
	end)
	bindTooltip(playerEndButton, function()
		return { title = playerEndButton.Text, detail = selectedDetail(playerEndOptions, exportOptions.playerEndMode, CUTSCENE_BUTTON_TOOLTIPS.playerEnd.detail) }
	end)
	bindTooltip(hidePlayerButton, function()
		return {
			title = hidePlayerButton.Text,
			detail = exportOptions.hidePlayerDuringCutscene
				and "The real player is hidden locally while the temporary cutscene clone performs the animation."
				or "The real player remains visible while the temporary cutscene clone performs the animation.",
		}
	end)
	bindTooltip(skipButton, function()
		return {
			title = skipButton.Text,
			detail = exportOptions.allowSkip
				and "Shows a Skip button during local playback so the player can end the cutscene early."
				or "No Skip button is shown during playback.",
		}
	end)
	bindTooltip(propEndStateButton, function()
		return { title = propEndStateButton.Text, detail = selectedDetail(propEndStateOptions, exportOptions.attachedPropEndState, CUTSCENE_BUTTON_TOOLTIPS.propEndState.detail) }
	end)
	bindTooltip(afterCutsceneButton, function()
		return { title = afterCutsceneButton.Text, detail = selectedDetail(afterCutsceneOptions, exportOptions.afterCutsceneAction, CUTSCENE_BUTTON_TOOLTIPS.afterCutscene.detail) }
	end)
	if refs._scriptValidateButton then
		bindTooltip(refs._scriptValidateButton, CUTSCENE_BUTTON_TOOLTIPS.validate)
	end
	if refs._scriptGenerateButton then
		bindTooltip(refs._scriptGenerateButton, CUTSCENE_BUTTON_TOOLTIPS.generate)
	end
	refreshOptions()

	refs._getCutsceneExportOptions = function()
		return {
			playback = exportOptions.playback,
			trigger = exportOptions.trigger,
			replay = exportOptions.replay,
			restoreCamera = exportOptions.restoreCamera,
			delaySeconds = delayInput.Text,
			triggerPartPath = exportOptions.trigger == "PartTouched" and triggerInput.Text or exportOptions.triggerPartPath,
			triggerPromptPath = exportOptions.trigger == "ProximityPrompt" and triggerInput.Text or exportOptions.triggerPromptPath,
			rigTargetMode = exportOptions.rigTargetMode,
			playerRigName = playerRigInput.Text,
			playerEndMode = exportOptions.playerEndMode,
			hidePlayerDuringCutscene = exportOptions.hidePlayerDuringCutscene,
			allowSkip = exportOptions.allowSkip,
			attachedPropEndState = exportOptions.attachedPropEndState,
			fadeInSeconds = fadeInInput.Text,
			fadeOutSeconds = fadeOutInput.Text,
			afterCutsceneAction = exportOptions.afterCutsceneAction,
			teleportPlaceId = teleportPlaceInput.Text,
		}
	end

	refs._scriptCard = scriptCard
	return refs
end

return ScriptUI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX106">
          <Properties>
            <string name="Name">SessionSummaryUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local SessionSummaryUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local styleInput = UiHelpers.styleInput
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createSectionTitle = UiHelpers.createSectionTitle
local createMetaLabel = UiHelpers.createMetaLabel
local createListLayout = UiHelpers.createListLayout
local createCard = UiHelpers.createCard

function SessionSummaryUI.mount(parent, _context)
	if not parent then
		error("SessionSummaryUI.mount requires parent")
	end

	local refs = {}

	local clipsCard = createCard(parent, UDim2.new(1, 0, 0.44, -6))
	clipsCard.Position = UDim2.new(0, 0, 0.56, 12)
	clipsCard.ClipsDescendants = true
	createSectionTitle(clipsCard, "Session Summary").Position = UDim2.new(0, 14, 0, 12)
	local sessionSummaryCollapseButton = UiHelpers.createPanelCollapseButton(clipsCard)

	local rigLabel = createMetaLabel(clipsCard, "Rig: No rig bound", 20)
	rigLabel.Position = UDim2.new(0, 14, 0, 40)
	rigLabel.TextColor3 = Constants.THEME.Text

	local animationNameInput = create("TextBox", {
		Name = "AnimationNameInput",
		Parent = clipsCard,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 14, 0, 66),
		Size = UDim2.new(1, -28, 0, 30),
		Font = Enum.Font.GothamSemibold,
		PlaceholderText = "Animation name",
		Text = "Untitled Animation",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	createCorner(animationNameInput, 9)
	createStroke(animationNameInput)
	create("UIPadding", {
		Parent = animationNameInput,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	local fileButtonRow = create("Frame", {
		Parent = clipsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 104),
		Size = UDim2.new(1, -28, 0, 58),
	})
	local renameButton = create("TextButton", {
		Name = "NewButton",
		Parent = fileButtonRow,
		Size = UDim2.new(0.25, -4, 1, 0),
		Text = "New",
	})
	UiHelpers.styleIconTileButton(renameButton, "New")
	createCorner(renameButton, 10)
	local saveButton = create("TextButton", {
		Name = "SaveButton",
		Parent = fileButtonRow,
		Position = UDim2.new(0.25, 4, 0, 0),
		Size = UDim2.new(0.25, -8, 1, 0),
		Text = "Save",
	})
	UiHelpers.styleIconTileButton(saveButton, "Save")
	createCorner(saveButton, 10)
	local importButton = create("TextButton", {
		Name = "ImportButton",
		Parent = fileButtonRow,
		Position = UDim2.new(0.5, 4, 0, 0),
		Size = UDim2.new(0.25, -8, 1, 0),
		Text = "Import",
	})
	UiHelpers.styleIconTileButton(importButton, "Import")
	createCorner(importButton, 10)
	local exportButton = create("TextButton", {
		Name = "ExportButton",
		Parent = fileButtonRow,
		Position = UDim2.new(0.75, 4, 0, 0),
		Size = UDim2.new(0.25, -4, 1, 0),
		Text = "Export",
	})
	UiHelpers.styleIconTileButton(exportButton, "Export")
	createCorner(exportButton, 10)

	local addTrackLabel = createMetaLabel(clipsCard, "Add Track", 18)
	addTrackLabel.Position = UDim2.new(0, 14, 0, 140)
	addTrackLabel.TextColor3 = Constants.THEME.Text
	addTrackLabel.Visible = false

	local addTrackRow = create("Frame", {
		Parent = clipsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 164),
		Size = UDim2.new(1, -28, 0, 30),
		Visible = false,
	})
	local function createTrackButton(name, text, column)
		local columns = 5
		local widthScale = 1 / columns
		local button = create("TextButton", {
			Name = name,
			Parent = addTrackRow,
			Position = UDim2.new((column - 1) * widthScale, column == 1 and 0 or 4, 0, 0),
			Size = UDim2.new(widthScale, -4, 1, 0),
			Text = text,
		})
		styleGhostButton(button)
		button.TextSize = 11
		createCorner(button, 8)
		return button
	end
	local addCameraTrackButton = createTrackButton("AddCameraTrackButton", "Camera", 1)
	local addObjectTrackButton = createTrackButton("AddObjectTrackButton", "Object", 2)
	local addModelTrackButton = createTrackButton("AddModelTrackButton", "Model", 3)
	local addRigCFrameTrackButton = createTrackButton("AddRigCFrameTrackButton", "Rig CF", 4)
	local addEventTrackButton = createTrackButton("AddEventTrackButton", "Event", 5)

	local insertRigLabel = createMetaLabel(clipsCard, "Insert Rig", 18)
	insertRigLabel.Position = UDim2.new(0, 14, 0, 176)
	insertRigLabel.TextColor3 = Constants.THEME.Text

	local insertRigRow = create("Frame", {
		Parent = clipsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 200),
		Size = UDim2.new(1, -28, 0, 40),
	})
	local function createRigPresetButton(name, text, column)
		local columns = 3
		local widthScale = 1 / columns
		local button = create("TextButton", {
			Name = name,
			Parent = insertRigRow,
			Position = UDim2.new((column - 1) * widthScale, column == 1 and 0 or 4, 0, 0),
			Size = UDim2.new(widthScale, -4, 1, 0),
			Text = text,
		})
		styleGhostButton(button)
		button.TextSize = 12
		createCorner(button, 9)
		return button
	end
	local insertR6Button = createRigPresetButton("InsertR6Button", "R6", 1)
	local insertR15Button = createRigPresetButton("InsertR15Button", "R15 Classic", 2)
	local insertR15ModernButton = createRigPresetButton("InsertR15ModernButton", "R15 Modern", 3)

	local avatarRigTypeButton = create("TextButton", {
		Name = "AvatarRigTypeButton",
		Parent = clipsCard,
		Position = UDim2.new(0, 14, 0, 246),
		Size = UDim2.new(1, -28, 0, 32),
		Text = "Avatar Type: R15 Classic",
	})
	styleGhostButton(avatarRigTypeButton)
	avatarRigTypeButton.TextSize = 12
	createCorner(avatarRigTypeButton, 9)

	local avatarInput = create("TextBox", {
		Name = "AvatarInput",
		Parent = clipsCard,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 14, 0, 284),
		Size = UDim2.new(1, -98, 0, 34),
		Font = Enum.Font.Gotham,
		PlaceholderText = "Username / ID or blank",
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	styleInput(avatarInput)
	createCorner(avatarInput, 8)
	createStroke(avatarInput)
	create("UIPadding", {
		Parent = avatarInput,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	local insertAvatarButton = create("TextButton", {
		Name = "InsertAvatarButton",
		Parent = clipsCard,
		Position = UDim2.new(1, -78, 0, 284),
		Size = UDim2.new(0, 64, 0, 34),
		Text = "Avatar",
	})
	styleTextButton(insertAvatarButton)
	insertAvatarButton.TextSize = 11
	createCorner(insertAvatarButton, 8)

	local summaryStack = create("Frame", {
		Parent = clipsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 322),
		Size = UDim2.new(1, -28, 1, -332),
	})
	local summaryLayout = createListLayout(summaryStack, 2)

	local keyframeSummary = createMetaLabel(summaryStack, "Keyframes: 0", 16)
	local durationSummary = createMetaLabel(summaryStack, "Timeline: 60 frames", 16)
	local selectedJointSummary = createMetaLabel(summaryStack, "Selected Track: none", 22)
	selectedJointSummary.TextWrapped = true
	local performanceDebugLabel = createMetaLabel(
		summaryStack,
		"Performance Debug: Off",
		78
	)
	performanceDebugLabel.TextWrapped = true
	performanceDebugLabel.Visible = false
	performanceDebugLabel.TextYAlignment = Enum.TextYAlignment.Top

	refs._animationNameInput = animationNameInput
	refs._renameButton = renameButton
	refs._newAnimationButton = renameButton
	refs._saveButton = saveButton
	refs._importButton = importButton
	refs._exportButton = exportButton
	refs._addCameraTrackButton = addCameraTrackButton
	refs._addObjectTrackButton = addObjectTrackButton
	refs._addModelTrackButton = addModelTrackButton
	refs._addRigCFrameTrackButton = addRigCFrameTrackButton
	refs._addEventTrackButton = addEventTrackButton
	refs._insertR6Button = insertR6Button
	refs._insertR15Button = insertR15Button
	refs._insertR15ModernButton = insertR15ModernButton
	refs._avatarRigTypeButton = avatarRigTypeButton
	refs._avatarInput = avatarInput
	refs._insertAvatarButton = insertAvatarButton
	refs._rigLabel = rigLabel
	refs._summaryRigLabel = rigLabel
	refs._keyframeSummary = keyframeSummary
	refs._durationSummary = durationSummary
	refs._selectedJointSummary = selectedJointSummary
	refs._performanceDebugLabel = performanceDebugLabel
	refs._summaryStack = summaryStack
	refs._summaryLayout = summaryLayout
	refs._sessionSummaryCard = clipsCard
	refs._sessionSummaryCollapseButton = sessionSummaryCollapseButton

	return refs
end

function SessionSummaryUI.update(_context)
end

function SessionSummaryUI.destroy()
end

return SessionSummaryUI
</ProtectedString>
