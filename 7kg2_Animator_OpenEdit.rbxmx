      <Item class="ModuleScript" referent="RBX266">
        <Properties>
          <string name="Name">WidgetCameraPresetSupport</string>
          <ProtectedString name="Source">local WidgetCameraPresetSupport = {}

function WidgetCameraPresetSupport.getCameraPresetOptions(controller)
	local function parseOrDefault(input, fallback)
		local value = tonumber(input and input.Text)
		if value == nil then
			return fallback
		end
		return value
	end
	local function textFrom(primaryInput, fallbackInput)
		local primaryText = primaryInput and tostring(primaryInput.Text or "") or ""
		if primaryText ~= "" then
			return primaryText
		end
		return fallbackInput and tostring(fallbackInput.Text or "") or ""
	end

	local effectsFovText = controller._effectsCameraFovInput and tostring(controller._effectsCameraFovInput.Text or "") or ""
	local fovValue = tonumber(effectsFovText ~= "" and effectsFovText or (controller._cameraTrackEditorFovInput and controller._cameraTrackEditorFovInput.Text))
	local defaultFovValue = tonumber(controller._cameraTrackEditorDefaultFovText)
	local followOverlayVisible = controller._cameraFollowOverlay and controller._cameraFollowOverlay.Visible
	local fovOverride = nil
	if fovValue and (effectsFovText ~= "" or not defaultFovValue or math.abs(fovValue - defaultFovValue) &gt; 0.01) then
		fovOverride = fovValue
	end
	local durationSeconds = followOverlayVisible
		and tonumber(textFrom(controller._cameraFollowDurationInput, controller._effectsCameraDurationInput))
		or tonumber(textFrom(controller._effectsCameraDurationInput, controller._cameraTrackEditorDurationInput))
	local intensity = parseOrDefault(controller._effectsCameraIntensityInput, parseOrDefault(controller._cameraTrackEditorAggressionInput, 1))
	local smoothness = parseOrDefault(controller._effectsCameraSmoothnessInput, parseOrDefault(controller._cameraTrackEditorSmoothnessInput, 1))
	local orbitAngleText = controller._effectsCameraOrbitAngleButton and tostring(controller._effectsCameraOrbitAngleButton.Text or "") or ""
	local orbitDirectionText = followOverlayVisible and controller._cameraFollowDirectionButton and tostring(controller._cameraFollowDirectionButton.Text or "") or ""
	if orbitDirectionText == "" then
		orbitDirectionText = controller._effectsCameraDirectionButton and tostring(controller._effectsCameraDirectionButton.Text or "") or ""
	end
	local trackingText = controller._effectsCameraTrackingButton and tostring(controller._effectsCameraTrackingButton.Text or "") or ""
	local easingText = controller._effectsCameraEasingButton and tostring(controller._effectsCameraEasingButton.Text or "") or ""
	local easingStyle, easingDirection = string.match(easingText, "^(%S+)%s+(%S+)$")
	easingStyle = easingStyle or controller._cameraPresetEasingStyle or "Linear"
	easingDirection = easingDirection or controller._cameraPresetEasingDirection or "InOut"
	local subjectTracking = controller._cameraPresetSubjectTracking ~= false
	if trackingText ~= "" then
		subjectTracking = trackingText ~= "Off"
	end

	return {
		durationScale = 1,
		durationSeconds = durationSeconds,
		explosionAggression = intensity,
		handheldSmoothness = smoothness,
		intensity = intensity,
		smoothness = smoothness,
		fovOverride = fovOverride,
		radius = followOverlayVisible and parseOrDefault(controller._cameraFollowRadiusInput, nil) or parseOrDefault(controller._effectsCameraRadiusInput, nil),
		heightOffset = parseOrDefault(controller._effectsCameraHeightInput, nil),
		orbitAngle = (string.find(orbitAngleText, "360") or string.find(orbitAngleText, "Full")) and 360 or 180,
		orbitDirection = orbitDirectionText ~= "" and orbitDirectionText or (controller._cameraOrbitDirection or "Clockwise"),
		lookAtSmoothing = parseOrDefault(controller._effectsCameraLookSmoothingInput, nil),
		startOffset = textFrom(controller._effectsCameraStartOffsetInput, controller._cameraTrackEditorStartOffsetInput),
		endOffset = textFrom(controller._effectsCameraEndOffsetInput, controller._cameraTrackEditorEndOffsetInput),
		easingStyle = easingStyle,
		easingDirection = easingDirection,
		followAngle = controller._cameraFollowAngleMode or "Auto",
		subjectTracking = subjectTracking,
		durationToEnd = followOverlayVisible and controller._cameraFollowDurationToEnd == true,
	}
end

function WidgetCameraPresetSupport.getCameraFollowCopy(presetId)
	local modeLabel = "Preset: Follow Regular"
	local helpLabel = "Select a rig, model, or part in Studio, then choose Use Studio Selection. 7kg2 will follow that subject's animated track when available, otherwise it will use the current transform."
	if presetId == "FollowRigCinematic" then
		modeLabel = "Preset: Follow Cinematic"
		helpLabel = "Select a rig, model, or part in Studio, then choose Use Studio Selection. 7kg2 will build a higher, wider cinematic follow using that subject's movement when it has timeline keys."
	elseif presetId == "Orbit" then
		modeLabel = "Preset: Slow Orbit"
		helpLabel = "Select a rig, model, or part in Studio. Set duration, To End, radius, and direction below; 7kg2 will orbit around that subject and reuse its animated movement when it has track keyframes."
	elseif presetId == "OrbitShot" then
		modeLabel = "Preset: Orbit Shot"
		helpLabel = "Select a rig, model, or part in Studio. 7kg2 will generate a smooth circular orbit that keeps the subject framed."
	elseif presetId == "DollyIn" then
		modeLabel = "Preset: Dolly Zoom"
		helpLabel = "Select a rig, model, or part to focus on. 7kg2 moves the camera toward it while widening FOV so the subject stays framed."
	elseif presetId == "DollyOut" then
		modeLabel = "Preset: Reverse Dolly Zoom"
		helpLabel = "Select a rig, model, or part to focus on. 7kg2 pulls the camera away while tightening FOV for a dramatic vertigo-style reveal."
	elseif presetId == "HeroReveal" then
		modeLabel = "Preset: Hero Reveal"
		helpLabel = "Select a subject. 7kg2 will create a low-angle rising reveal with a small orbit shift."
	elseif presetId == "OverShoulder" then
		modeLabel = "Preset: Over Shoulder"
		helpLabel = "Select a subject. Use Left or Right angle to choose the shoulder side for dialogue-style framing."
	elseif presetId == "FollowCam" then
		modeLabel = "Preset: Follow Cam"
		helpLabel = "Select a moving rig, model, or part. 7kg2 will generate a smooth trailing camera with look-ahead."
	elseif presetId == "FaceFocus" then
		modeLabel = "Preset: Face Focus"
		helpLabel = "Select a rig or its Head in Studio, then choose Use Studio Selection. 7kg2 will frame the face from the front and add Depth Of Field for background blur."
	elseif presetId == "FirstPerson" then
		modeLabel = "Preset: First-Person Mode"
		helpLabel = "Select a rig or its Head in Studio, then choose Use Studio Selection. 7kg2 will key the camera at the head now; use Detach First-Person later to bake the head-follow keys."
	end
	return modeLabel, helpLabel
end

return WidgetCameraPresetSupport
</ProtectedString>
