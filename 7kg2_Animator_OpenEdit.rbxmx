	status = "Choose a physics effect to begin.",
	statusTone = THEME.muted,
}

function state.invalidateExplosionTestCache()
	state.explosionTestCache = nil
	state.explosionTestSetupRevision = (tonumber(state.explosionTestSetupRevision) or 0) + 1
end

state.quickPhysicsSupport = require(Modules:WaitForChild("QuickPhysicsCaptureSupport"))
state.multiRigRagdollSupport = require(Modules:WaitForChild("MultiRigRagdollSupport"))
state.quickPhysics = state.quickPhysicsSupport.NewState()
state.quickPhysicsPanel = nil
state.quickPhysicsActions = {}

local function restoreAdaptiveWalkOriginal()
	local session = state.adaptiveWalkRestoreSession or state.adaptiveWalkSession
	local restored = AdaptiveWalkRuntime.RestoreOriginal(session)
	state.adaptiveWalkSession = nil
	state.adaptiveWalkRestoreSession = nil
	state.adaptiveWalkComplete = false
	return restored
end

state.applyExtraBounce = function(part)
	local properties = part.CurrentPhysicalProperties
	part.CustomPhysicalProperties = PhysicalProperties.new(
		properties.Density,
		properties.Friction,
		0.85,
		properties.FrictionWeight,
		100
	)
end

state.getObjectCaptureTargets = function()
	if state.take and state.take.releaseToPhysics and state.releaseCaptureTarget then
		return { state.releaseCaptureTarget }
	end
	local descriptors = {}
	if state.take and state.take.physicsDrive and state.driverCaptureTarget then
		table.insert(descriptors, state.driverCaptureTarget)
	end
	if state.take and state.take.physicsDrive then
		for _, descriptor in ipairs(state.riderTargets) do
			table.insert(descriptors, descriptor)
		end
	end
	for _, descriptor in ipairs(state.objectTargets) do
		table.insert(descriptors, descriptor)
	end
	if state.take and state.take.physicsEvents then
		for _, descriptor in ipairs(state.eventSourceTargets) do
			table.insert(descriptors, descriptor)
		end
	end
	return descriptors
end

local refs = {}
local connections = {}
local workflowUX = PhysicsWorkflowUX.new(CoreGui)
local projectilePathUX = PhysicsProjectilePathUX.new(
	plugin,
	CoreGui,
	function(kind, position)
		if kind == "Explosion" and state.onExplosionPointChanged then
			state.onExplosionPointChanged(position)
		elseif state.onProjectilePointChanged then
			state.onProjectilePointChanged(kind, position)
		end
	end,
	function(kind, position, target)
		if kind == "Explosion" and state.onExplosionPointPlaced then
			state.onExplosionPointPlaced(position, target)
		elseif state.onProjectilePointPlaced then
			state.onProjectilePointPlaced(kind, position)
		end
	end,
	function(direction, finished)
		if state.onExplosionDirectionChanged then
			state.onExplosionDirectionChanged(direction, finished)
		end
	end
)
state.startingPushUX = state.startingPushUXModule.new(plugin, CoreGui, function(contactPosition, originPosition)
	state.startingPushContact = contactPosition
	state.startingPushOrigin = originPosition
	state.startingPushTestedSpeed = nil
	if state.retargetStartingPushAtContact then
		state.retargetStartingPushAtContact(contactPosition)
	end
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.status = string.format(
		"Starting Push guide adjusted. Speed is %.1f studs/s; use the speed controls to change force.",
		state.startingPushSpeed
	)
	state.statusTone = THEME.green
	if state.updateUI then
		state.updateUI()
	end
end)

function state.findStartingPushDescriptor()
	if not (state.startingPushTarget and state.startingPushTarget.Parent) then
		return nil
	end
	if state.effectMode == "Character"
		and state.ragdollMode == "Knockback"
		and state.selectedRig
		and state.selectedRig.Parent
		and state.startingPushTarget:IsDescendantOf(state.selectedRig) then
		return {
			instance = state.startingPushTarget,
			part = state.startingPushTarget,
		}
	end
	for _, descriptor in ipairs(state.objectTargets) do
		if descriptor.instance == state.startingPushTarget then
			return descriptor
		end
	end
	return nil
end

function state.findStartingPushDescriptorNear(position)
	if typeof(position) ~= "Vector3" then
		return nil, math.huge
	end
	local bestDescriptor = nil
	local bestDistance = math.huge
	for _, descriptor in ipairs(state.objectTargets) do
		local part = descriptor.instance
		if part and part.Parent and part:IsA("BasePart") then
			local point = part.CFrame:PointToObjectSpace(position)
			local half = part.Size * 0.5
			local closest = part.CFrame:PointToWorldSpace(Vector3.new(
				math.clamp(point.X, -half.X, half.X),
				math.clamp(point.Y, -half.Y, half.Y),
				math.clamp(point.Z, -half.Z, half.Z)
			))
			local distance = (position - closest).Magnitude
			if distance &lt; bestDistance then
				bestDescriptor = descriptor
				bestDistance = distance
			end
		end
	end
	return bestDescriptor, bestDistance
end

function state.retargetStartingPushAtContact(position)
	if state.effectMode == "Character" then
		return
	end
	local descriptor, distance = state.findStartingPushDescriptorNear(position)
	if descriptor and distance &lt;= 1.25 and descriptor.instance ~= state.startingPushTarget then
		state.startingPushTarget = descriptor.instance
		state.startingPushTargetId = nil
		state.startingPushUX:SetAdornee(descriptor.instance)
	end
end

function state.clearStartingPush()
	state.startingPushTestMode = false
	state.fullEffectTestMode = false
	state.startingPushTestedSpeed = nil
	state.startingPushTestDuration = 4
	state.startingPushTarget = nil
	state.startingPushTargetId = nil
	state.startingPushContact = nil
	state.startingPushOrigin = nil
	state.startingPushSpeed = 12
	state.startingPushApplied = false
	state.startingPushMessage = nil
	state.startingPushMetadata = nil
	state.startingPushUX:Clear()
end

function state.getBlastGuide()
	if state.uiStage == "Setup"
		and state.setupPage == "Prepare"
		and state.effectMode == "Explosion"
		and not state.eventTestMode
		and not RunService:IsRunning()
		and state.eventSourceInstance
		and state.eventSourceInstance.Parent
		and state.eventSourcePosition then
		return {
			position = state.eventSourcePosition,
			strength = state.eventStrength,
			power = state.eventPower,
			radius = state.eventRuntime.GetBlastRadius(
				state.eventStrength,
				state.eventPower,
				state.eventReaction
			),
		}
	end
	return nil
end

function state.refreshBlastGuide()
	workflowUX:SetBlastGuide(state.eventSourceInstance, state.getBlastGuide())
end

function state.refreshWorkflowUX()
	-- Explosion tests should show only the simulated result. Clear every
	-- Physics-owned edit guide before Run mode starts, and keep them cleared if
	-- another UI refresh happens while the test is playing. FinishTest rebuilds
	-- the guides after the captured scene has been restored.
	if state.eventTestMode or state.previewSession then
		workflowUX:Clear()
		projectilePathUX:Clear()
		state.startingPushUX:SetVisible(false)
		return
	end
	workflowUX:Refresh(state.selectedRig, state.objectTargets, state.eventSourceInstance, state.getBlastGuide())
	projectilePathUX:SetPoints(
		state.eventProjectileStart,
		state.eventProjectileEnd,
		state.uiStage == "Setup"
			and state.setupPage == "Prepare"
			and state.effectMode == "Projectile"
			and state.eventSourceInstance ~= nil
	)
	projectilePathUX:SetExplosionPoint(
		state.eventSourcePosition,
		state.uiStage == "Setup"
			and state.setupPage == "Prepare"
			and state.effectMode == "Explosion"
			and not state.eventTestMode
			and not RunService:IsRunning()
			and state.eventSourceInstance ~= nil,
		state.eventSourceDirection,
		state.eventDirectionMode == "Forward"
	)
	state.startingPushUX:SetVisible(
		state.uiStage == "Setup"
			and state.setupPage == "Prepare"
			and (state.effectMode == "Scene"
				or state.effectMode == "Character" and state.ragdollMode == "Knockback")
			and (state.findStartingPushDescriptor() ~= nil
				or state.startingPushUX:IsContactPlacementActive())
	)
end

function state.clearEventTestVisualProxies()
	local folder = state.eventTestVisualProxyFolder
	state.eventTestVisualProxyFolder = nil
	state.eventTestVisualProxyDescriptors = {}
	if folder then
		folder:Destroy()
	end
end

function state.createEventTestVisualProxies(runtimeTargets)
	state.clearEventTestVisualProxies()
	if not (state.effectMode == "Explosion"
		and math.abs(state.eventPlaybackSpeed - 1) &gt; 0.001) then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "MegMoPhysicsSpeedPreviewStandIns"
	folder.Archivable = false
	local rigByPart = {}
	local descriptorsByPart = {}
	local rigModels = {}
	local seenRigs = {}
	local function findCharacterModel(part)
		local current = part and part.Parent
		while current and current ~= workspace do
			if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
				return current
			end
			current = current.Parent
		end
		return nil
	end
	local function removeInteractiveDescendants(root, removeJoints)
		for _, descendant in ipairs(root:GetDescendants()) do
			if (removeJoints and (descendant:IsA("JointInstance") or descendant:IsA("Constraint")))
				or descendant:IsA("Script")
				or descendant:IsA("LocalScript")
				or descendant:IsA("ModuleScript")
				or descendant:IsA("Sound")
				or descendant:IsA("ClickDetector")
				or descendant:IsA("ProximityPrompt") then
				descendant:Destroy()
			elseif descendant:IsA("BasePart") then
				-- These copies are a frozen visual placeholder while the authentic
				-- runtime scene calculates once out of view. Anchor accessory handles
				-- as well as body parts so hair, clothing and back accessories cannot
				-- drift or detach during that short wait.
				descendant.Anchored = true
				descendant.CanCollide = false
				descendant.CanTouch = false
				descendant.CanQuery = false
				descendant.AssemblyLinearVelocity = Vector3.zero
				descendant.AssemblyAngularVelocity = Vector3.zero
			elseif descendant:IsA("Humanoid") then
				descendant.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				descendant.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end
		end
		if root:IsA("BasePart") then
			root.Anchored = true
			root.CanCollide = false
			root.CanTouch = false
			root.CanQuery = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end
	for _, descriptor in ipairs(runtimeTargets or {}) do
		local part = descriptor and descriptor.part
		if part and part.Parent and part:IsA("BasePart") then
			descriptorsByPart[part] = descriptor
			local rig = findCharacterModel(part)
			rigByPart[part] = rig
			if rig and not seenRigs[rig] then
				seenRigs[rig] = true
				table.insert(rigModels, rig)
			end
		end
	end
	for _, rig in ipairs(rigModels) do
		local taggedParts = {}
		for part, descriptor in pairs(descriptorsByPart) do
			if rigByPart[part] == rig and descriptor.id ~= nil then
				local oldValue = part:GetAttribute("MegMoPhysicsSpeedPreviewId")
				part:SetAttribute("MegMoPhysicsSpeedPreviewId", tostring(descriptor.id))
				table.insert(taggedParts, {
					part = part,
					descriptor = descriptor,
					oldValue = oldValue,
				})
			end
		end
		local ok, proxy = pcall(function()
			return rig:Clone()
		end)
		for _, tagged in ipairs(taggedParts) do
			if tagged.part and tagged.part.Parent then
				tagged.part:SetAttribute("MegMoPhysicsSpeedPreviewId", tagged.oldValue)
			end
		end
		if ok and proxy and proxy:IsA("Model") then
			proxy.Name = "MegMoPhysicsSpeedPreviewStandIn"
			local descriptorById = {}
			for _, tagged in ipairs(taggedParts) do
				descriptorById[tostring(tagged.descriptor.id)] = tagged.descriptor
			end
			for _, descendant in ipairs(proxy:GetDescendants()) do
				if descendant:IsA("BasePart") then
					local previewId = descendant:GetAttribute("MegMoPhysicsSpeedPreviewId")
					local sourceDescriptor = previewId and descriptorById[tostring(previewId)]
					descendant:SetAttribute("MegMoPhysicsSpeedPreviewId", nil)
					if sourceDescriptor then
						table.insert(state.eventTestVisualProxyDescriptors, {
							id = sourceDescriptor.id,
							instance = descendant,
							path = descendant:GetFullName(),
						})
					end
				end
			end
			removeInteractiveDescendants(proxy, false)
			proxy.Parent = folder
		end
	end
	for _, descriptor in ipairs(runtimeTargets or {}) do
		local part = descriptor and descriptor.part
		if part and part.Parent and part:IsA("BasePart") and not rigByPart[part] then
			local ok, proxy = pcall(function()
				return part:Clone()
			end)
			if ok and proxy and proxy:IsA("BasePart") then
				proxy.Name = "MegMoPhysicsSpeedPreviewStandIn"
				removeInteractiveDescendants(proxy, true)
				proxy.Parent = folder
				if descriptor.id ~= nil then
					table.insert(state.eventTestVisualProxyDescriptors, {
						id = descriptor.id,
						instance = proxy,
						path = proxy:GetFullName(),
					})
				end
			end
		end
	end
	if #folder:GetChildren() &gt; 0 then
		state.eventTestVisualProxyFolder = folder
	else
		folder:Destroy()
	end
end

function state.hideEventTestRuntimeTargets(runtimeTargets)
	state.eventTestHiddenParts = {}
	state.eventTestHiddenHumanoids = {}
	state.eventTestHiddenVisuals = {}
	local shouldStreamSlowPlayback = not state.eventTestMode
		and state.effectMode == "Explosion"
		and state.eventPlaybackSpeed &lt; 0.999
	local shouldHideTemporaryRetimedTest = state.eventTestMode
		and state.effectMode == "Explosion"
		and math.abs(state.eventPlaybackSpeed - 1) &gt; 0.001
	if not (shouldStreamSlowPlayback or shouldHideTemporaryRetimedTest) then
		return
	end
	if shouldStreamSlowPlayback or shouldHideTemporaryRetimedTest then
		-- Normal slow Capture uses these stand-ins for its live preview. A
		-- temporary retimed Test uses them as a frozen, non-interactive picture of
		-- the original scene while the one-time real-physics result is calculated.
		state.createEventTestVisualProxies(runtimeTargets)
	end
	local seenHumanoids = {}
	local seenVisuals = {}
	local seenParts = {}
	local function hideVisual(descendant)
		if seenVisuals[descendant] then
			return
		end
		if descendant:IsA("Decal") or descendant:IsA("Texture") then
			seenVisuals[descendant] = true
			table.insert(state.eventTestHiddenVisuals, {
				instance = descendant,
				transparency = descendant.Transparency,
			})
			descendant.Transparency = 1
		elseif descendant:IsA("BillboardGui")
				or descendant:IsA("SurfaceGui")
				or descendant:IsA("ParticleEmitter")
				or descendant:IsA("Beam")
				or descendant:IsA("Trail")
				or descendant:IsA("Light") then
			seenVisuals[descendant] = true
			table.insert(state.eventTestHiddenVisuals, {
				instance = descendant,
				enabled = descendant.Enabled,
			})
			descendant.Enabled = false
		end
	end
	local function hidePart(part)
		if seenParts[part] then
			return
		end
		seenParts[part] = true
		table.insert(state.eventTestHiddenParts, {
			part = part,
			localTransparencyModifier = part.LocalTransparencyModifier,
			canQuery = part.CanQuery,
		})
		part.LocalTransparencyModifier = 1
		-- A fully transparent runtime part can still show a Studio selection box
		-- when the cursor passes over it. Disable queries until the test ends so
		-- the frozen stand-in is the only visible feedback.
		part.CanQuery = false
		for _, descendant in ipairs(part:GetDescendants()) do
			hideVisual(descendant)
		end
	end
	local function findCharacterModel(part)
		local current = part and part.Parent
		while current and current ~= workspace do
			if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
				return current
			end
			current = current.Parent
		end
		return nil
	end
	for _, descriptor in ipairs(runtimeTargets or {}) do
		local part = descriptor and descriptor.part
		if part and part.Parent and part:IsA("BasePart") then
			local character = findCharacterModel(part)
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and not seenHumanoids[humanoid] then
				seenHumanoids[humanoid] = true
				table.insert(state.eventTestHiddenHumanoids, {
					humanoid = humanoid,
					displayDistanceType = humanoid.DisplayDistanceType,
				})
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
			if character then
				for _, descendant in ipairs(character:GetDescendants()) do
					if descendant:IsA("BasePart") then
						hidePart(descendant)
					else
						hideVisual(descendant)
					end
				end
			else
				hidePart(part)
			end
		end
	end
	if shouldHideTemporaryRetimedTest
		and state.eventTestVisualProxyFolder
		and not state.eventTestVisualProxyFolder.Parent then
		-- Parent only after the real runtime targets have been hidden, avoiding a
		-- one-frame duplicate flash at the start of the calculation.
		state.eventTestVisualProxyFolder.Parent = workspace
	end
end

function state.restoreEventTestRuntimeTargets()
	for _, item in ipairs(state.eventTestHiddenParts or {}) do
		if item.part and item.part.Parent then
			item.part.LocalTransparencyModifier = item.localTransparencyModifier
			if item.canQuery ~= nil then
				item.part.CanQuery = item.canQuery
			end
		end
	end
	for _, item in ipairs(state.eventTestHiddenHumanoids or {}) do
		if item.humanoid and item.humanoid.Parent then
			item.humanoid.DisplayDistanceType = item.displayDistanceType
		end
	end
	for _, item in ipairs(state.eventTestHiddenVisuals or {}) do
		if item.instance and item.instance.Parent then
			if item.transparency ~= nil then
				item.instance.Transparency = item.transparency
			else
				item.instance.Enabled = item.enabled
			end
		end
	end
	state.eventTestHiddenParts = {}
	state.eventTestHiddenHumanoids = {}
	state.eventTestHiddenVisuals = {}
	state.clearEventTestVisualProxies()
end

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function make(className, properties, parent)
	local instance = Instance.new(className)
	for property, value in pairs(properties or {}) do
		instance[property] = value
	end
	instance.Parent = parent
	return instance
end

local function addCorner(parent, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function addStroke(parent, color)
	make("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or THEME.accent,
		Transparency = 0.35,
		Thickness = 1,
	}, parent)
end

local function updateButtonTextContrast(button)
	local color = button.BackgroundColor3
	local purpleAction = color.B &gt;= 0.55
		and color.B &gt; color.G * 1.12
		and color.R &gt; color.G * 1.02
	if purpleAction then
		button.TextColor3 = Color3.fromRGB(245, 248, 255)
		button.TextTransparency = 0
		return
	end
	local function linearChannel(channel)
		if channel &lt;= 0.04045 then
			return channel / 12.92
		end
		return ((channel + 0.055) / 1.055) ^ 2.4
	end
	local luminance = (0.2126 * linearChannel(color.R))
		+ (0.7152 * linearChannel(color.G))
		+ (0.0722 * linearChannel(color.B))
	button.TextColor3 = luminance &gt; 0.179
		and Color3.fromRGB(12, 16, 24)
		or Color3.fromRGB(245, 248, 255)
end

local function styleButton(button, color)
	button.AutoButtonColor = true
	button.BackgroundColor3 = color or THEME.button
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamMedium
	button.TextColor3 = THEME.text
	button.TextSize = 12
	addCorner(button, 6)
	addStroke(button, color or THEME.accent)
	updateButtonTextContrast(button)
end

local function setStatus(message, tone)
	state.status = tostring(message or "")
	state.statusTone = tone or THEME.muted
	if refs.status then
		local function linearChannel(channel)
			if channel &lt;= 0.04045 then
				return channel / 12.92
			end
			return ((channel + 0.055) / 1.055) ^ 2.4
		end
		local function contrastRatio(first, second)
			local firstLuminance = (0.2126 * linearChannel(first.R))
				+ (0.7152 * linearChannel(first.G))
				+ (0.0722 * linearChannel(first.B))
			local secondLuminance = (0.2126 * linearChannel(second.R))
				+ (0.7152 * linearChannel(second.G))
				+ (0.0722 * linearChannel(second.B))
			return (math.max(firstLuminance, secondLuminance) + 0.05)
				/ (math.min(firstLuminance, secondLuminance) + 0.05)
		end
		local renderedTone = state.statusTone
		if contrastRatio(renderedTone, THEME.panelAlt) &lt; 4.5 then
			for step = 1, 10 do
				local candidate = renderedTone:Lerp(THEME.text, step / 10)
				if contrastRatio(candidate, THEME.panelAlt) &gt;= 4.5 then
					renderedTone = candidate
					break
				end
			end
		end
		refs.status.Text = state.status
		refs.status.TextColor3 = renderedTone
	end
end

local function countMotorJoints(rig)
	local count = 0
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part0 and descendant.Part1 then
			count += 1
		end
	end
	return count
end

function state.getCaptureWarningDetails()
	local trackCount = #state.objectTargets
	if state.effectMode == "Character" then
		trackCount = 0
		for _, rig in ipairs(state.selectedRigs) do
			if rig and rig.Parent then
				trackCount += math.max(1, countMotorJoints(rig))
			end
		end
	elseif state.effectMode == "AdaptiveWalk" then
		trackCount += state.selectedRig and state.selectedRig.Parent
			and math.max(1, countMotorJoints(state.selectedRig))
			or 0
	elseif state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive" then
		trackCount += state.driverObject and state.driverObject.Parent and 1 or 0
		trackCount += #state.riderTargets
	end
	return {
		trackCount = trackCount,
		fps = state.fps,
		duration = state.maxDuration,
		truncated = state.targetsTruncated,
	}
end

function state.confirmLargeSelection(action, onConfirm, onCancel)
	if state.largeSelectionWarningBypass then
		state.largeSelectionWarningBypass = false
		return false
	end
	if not state.largeSelectionWarning then
		return false
	end
	local details = state.getCaptureWarningDetails()
	details.action = action
	return state.largeSelectionWarning:ConfirmIfNeeded(details, onConfirm, onCancel)
end

local function findRigFromInstance(instance)
	local current = instance
	while current and current ~= workspace do
		if current:IsA("Model")
			and (current:FindFirstChildOfClass("Humanoid") or current:FindFirstChildOfClass("AnimationController"))
			and countMotorJoints(current) &gt; 0 then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function findSelectedRig()
	for _, selected in ipairs(Selection:Get()) do
		local rig = findRigFromInstance(selected)
		if rig then
			return rig
		end
	end
	return nil
end

state.findSelectedRigs = function()
	return state.multiRigRagdollSupport.CollectSelected(Selection:Get(), findRigFromInstance)
end

local function clearCaptureAttribute()
	state.multiRigRagdollSupport.ClearCaptureAttributes(state.rigCaptureEntries, CAPTURE_ATTRIBUTE)
	if state.selectedRig and state.selectedRig.Parent and state.selectedRig:GetAttribute(CAPTURE_ATTRIBUTE) == state.captureId then
		state.selectedRig:SetAttribute(CAPTURE_ATTRIBUTE, nil)
	end
end

local function clearDriverAttribute()
	if state.driverObject and state.driverObject.Parent
		and state.driverObject:GetAttribute(DRIVER_ATTRIBUTE) == state.driverId then
		state.driverObject:SetAttribute(DRIVER_ATTRIBUTE, nil)
	end
end

local function findRuntimeDriver()
	if not state.driverId then
		return nil
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if (descendant:IsA("BasePart") or descendant:IsA("Model"))
			and descendant:GetAttribute(DRIVER_ATTRIBUTE) == state.driverId then
			return descendant
		end
	end
	return nil
end

local function findRuntimeRig()
	if #state.rigCaptureEntries &gt; 0 then
		local rigs = state.multiRigRagdollSupport.FindRuntimeRigs(state.rigCaptureEntries, CAPTURE_ATTRIBUTE)
		return rigs[1]
	end
	if not state.captureId then
		return nil
	end
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute(CAPTURE_ATTRIBUTE) == state.captureId then
			return child
		end
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") and descendant:GetAttribute(CAPTURE_ATTRIBUTE) == state.captureId then
			return descendant
		end
	end
	return nil
end

local function formatDuration(seconds)
	return string.format("%.2fs", math.max(0, tonumber(seconds) or 0))
end

local function getSelectedWalkPreset()
	return state.walkPresets[state.walkPresetIndex]
end

function state.isEventMode(effectMode)
	effectMode = effectMode or state.effectMode
	return effectMode == "Explosion" or effectMode == "Projectile"
end

local function isWorkflowReady()
	if state.effectMode == "Drop" then
		return #state.objectTargets &gt; 0
	end
	if state.effectMode == "Scene" then
		return #state.objectTargets &gt; 0
			and (state.startingPushTarget == nil or state.findStartingPushDescriptor() ~= nil)
	end
	if state.effectMode == "Release" then
		return #state.objectTargets &gt; 0
			and state.releaseObject ~= nil
			and state.releaseObject.Parent ~= nil
			and state.releaseData ~= nil
	end
	if state.isEventMode() then
		return #state.objectTargets &gt; 0 and #state.eventMarkers &gt; 0
	end
	if state.effectMode == "AdaptiveWalk" then
		return state.selectedRig ~= nil
			and state.selectedRig.Parent ~= nil
			and getSelectedWalkPreset() ~= nil
			and state.animatedPath ~= nil
	end
	if state.effectMode == "Character" then
		return #state.selectedRigs &gt; 0
			and state.selectedRig ~= nil
			and state.selectedRig.Parent ~= nil
			and (state.ragdollMode ~= "Knockback" or state.findStartingPushDescriptor() ~= nil)
	end
	return state.driverObject ~= nil
		and state.driverObject.Parent ~= nil
		and (state.movingObjectMode == "PhysicsDrive" or #state.objectTargets &gt; 0)
		and state.animatedPath ~= nil
end

local function updateUI()
	local running = RunService:IsRunning()
	local ready = isWorkflowReady()
	local rigName = state.selectedRig and state.selectedRig.Parent and state.selectedRig.Name or "No rig selected"
	local joints = state.selectedRig and state.selectedRig.Parent and countMotorJoints(state.selectedRig) or 0
	local rigCount = #state.selectedRigs
	if refs.rig then
		refs.rig.Text = state.isEventMode()
			and string.format(
				"Affected objects: %d | Events queued: %d\n%s: %s",
				#state.objectTargets,
				#state.eventMarkers,
				state.effectMode == "Projectile" and "Projectile object" or "Blast Origin",
				state.effectMode == "Explosion"
					and (state.eventSourcePosition and "Set" or "Not selected")
					or state.eventSourceInstance and state.eventSourceInstance.Parent and state.eventSourceInstance.Name or "Not selected"
			)
			or state.effectMode == "Impact"
			and string.format(
				"Moving Object: %s | Riders: %d\nPhysics objects: %d selected | %s",
				state.driverObject and state.driverObject.Parent and state.driverObject.Name or "Not selected",
				#state.riderTargets,
				#state.objectTargets,
				state.movingObjectMode == "PhysicsDrive" and "Physics Drive" or "Follow Path"
			)
			or state.effectMode == "Release"
			and string.format(
				"Release object: %s\nCaptured parts: %d | %s",
				state.releaseObject and state.releaseObject.Parent and state.releaseObject.Name or "Not selected",
				#state.objectTargets,
				state.releaseData and string.format("Release frame %d", state.releaseData.releaseFrame or 0) or "Release state not loaded"
			)
			or state.effectMode == "Scene"
			and string.format(
				"Physics objects: %d selected\nStarting Push: %s",
				#state.objectTargets,
				state.findStartingPushDescriptor()
					and string.format("%s at %.1f studs/s", state.startingPushTarget.Name, state.startingPushSpeed)
					or "Not added (optional)"
			)
			or state.effectMode == "Character"
			and string.format(
				"Characters: %s\nMode: %s%s",
				rigCount &gt; 1 and string.format("%d selected", rigCount) or rigName,
				state.ragdollMode == "Knockback" and "Knockback" or "Natural Fall",
				state.ragdollMode == "Knockback"
					and (state.findStartingPushDescriptor()
						and string.format(" at %.1f studs/s", state.startingPushSpeed)
						or " - direction not set")
					or ""
			)
			or state.captureMode == "Objects"
			and string.format("Physics objects: %d selected", #state.objectTargets)
			or string.format("Animated rig: %s\nPhysics objects: %d | Motor6D joints: %d", rigName, #state.objectTargets, joints)
	end
	if refs.effectDrop then
		local effects = {
			Drop = refs.effectDrop,
			Character = refs.effectCharacter,
			Impact = refs.effectImpact,
			Explosion = refs.effectExplosion,
			Projectile = refs.effectProjectile,
			Scene = refs.effectScene,
			Release = refs.effectRelease,
			AdaptiveWalk = refs.effectWalk,
		}
		for mode, button in pairs(effects) do
			button.BackgroundColor3 = state.effectMode == mode
				and (mode == "AdaptiveWalk" and Color3.fromRGB(38, 106, 91) or THEME.accent)
				or THEME.button
		end
	end
	if refs.captureRig then
		local captureCards = {
			Character = refs.captureRig,
			Drop = refs.captureObjects,
			Impact = refs.captureVehicles,
			Scene = refs.captureScene,
			AdaptiveWalk = refs.captureWalk,
		}
		local captureColors = {
			Character = THEME.accent,
			Drop = THEME.cyan,
			Impact = THEME.yellow,
			Scene = THEME.green,
			AdaptiveWalk = Color3.fromRGB(184, 121, 255),
		}
		for mode, button in pairs(captureCards) do
			button.BackgroundColor3 = state.effectMode == mode
				and captureColors[mode]:Lerp(Color3.fromRGB(20, 28, 44), 0.45)
				or THEME.button
			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = state.effectMode == mode and 2 or 1
				stroke.Transparency = state.effectMode == mode and 0 or 0.25
			end
		end
	end
	if refs.effectDescription then
		local descriptions = {
			Drop = "Best for balls and loose props. You will select the object, choose whether it should have extra bounce, then capture the result.",
			Character = "Best for falls and reactions. Choose Natural Fall or set a directional Knockback with adjustable force.",
			Impact = "Best for vehicles and collisions. You will choose a moving object, load its 7kg2 path, and optionally select loose objects to hit.",
			Explosion = "Best for blasts and chain reactions. Choose the affected objects, add the Blast Origin, then test its reaction and power.",
			Projectile = "Best for bullets and directed hits. Choose the projectile and affected objects, then place and adjust its Start and Impact points.",
			Scene = "Best for debris and chain reactions. You will select every loose object that should take part in the simulation.",
			Release = "Best for thrown or dropped props. Detach the animated object at the playhead, inherit its motion, then capture the natural physics.",
			AdaptiveWalk = "Best for stairs and uneven ground. You will select a character, choose a walk style, and load its CFrame route from 7kg2.",
		}
		refs.effectDescription.Text = descriptions[state.effectMode]
	end
	if refs.setupHeading then
		local titles = {
			Drop = "Prepare: Drop &amp; Bounce",
			Character = "Prepare: Ragdoll",
			Impact = "Prepare: Drive &amp; Impact",
			Explosion = "Prepare: Create Explosion",
			Projectile = "Prepare: Timed Projectile Hits",
			Scene = "Prepare: Scene Physics",
			Release = "Prepare: Release to Physics",
			AdaptiveWalk = "Prepare: Adaptive Walk",
		}
		local prompts = {
			Drop = "Select the loose object or objects that should fall, then confirm the selection below.",
			Character = "Select one or more character rigs, then choose a natural fall or a shared-direction Knockback reaction.",
			Impact = "Select the moving object first, then add riders or movable loose objects. Anchored loose objects are temporarily released during the test and restored afterward.",
			Explosion = "Select the objects that should react, then add the Blast Origin and choose its reaction, direction, and power.",
			Projectile = "Select the objects that should react, choose the projectile object, then place its Start and Impact points in the viewport.",
			Scene = "Select all loose objects that should interact. Anchored, unselected parts remain collision geometry.",
			Release = "Place 7kg2's playhead on the Detach event, then load it. The held object is detected automatically.",
			AdaptiveWalk = "Select the character, choose a compatible walk style, then load its CFrame route from 7kg2.",
		}
		refs.setupHeading.Text = titles[state.effectMode]
		refs.setupPrompt.Text = prompts[state.effectMode]
	end
	if refs.selectButton then
		refs.selectButton.Text = state.effectMode == "Impact"
			and (state.movingObjectMode == "PhysicsDrive" and "Use Selected Loose Objects (Optional)" or "Use Selected Physics Objects")
			or state.isEventMode() and "Use Selected Affected Objects"
			or state.effectMode == "Release" and "Use Selected Release Object"
			or state.captureMode == "Objects" and "Use Selected Objects"
			or state.effectMode == "Character" and "Use Selected Characters"
			or "Use Selected Character"
	end
	if refs.walkStyle then
		local preset = getSelectedWalkPreset()
		local visible = state.effectMode == "AdaptiveWalk"
		refs.walkPrevious.Visible = visible
		refs.walkStyle.Visible = visible
		refs.walkNext.Visible = visible
		refs.walkPrevious.Active = visible and #state.walkPresets &gt; 1 and not state.walkPresetLoading
		refs.walkNext.Active = visible and #state.walkPresets &gt; 1 and not state.walkPresetLoading
		refs.walkPrevious.BackgroundTransparency = refs.walkPrevious.Active and 0 or 0.45
		refs.walkNext.BackgroundTransparency = refs.walkNext.Active and 0 or 0.45
		refs.walkStyle.Text = state.walkPresetLoading
			and "Loading Walk Styles..."
			or preset and string.format("Walk Style: %s", tostring(preset.name or preset.pack or "Walk"))
			or "Select a rig to load Walk Styles"
	end
	if refs.driverButton then
		refs.driverButton.Visible = state.effectMode == "Impact"
		refs.driverButton.Text = state.driverObject and state.driverObject.Parent
			and ("Moving Object: " .. state.driverObject.Name)
			or "Set Selected as Moving Object"
		local riderVisible = state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive"
		refs.riderButton.Visible = riderVisible
		refs.riderButton.Text = #state.riderTargets &gt; 0
			and string.format("Riders: %d - Use New Selection", #state.riderTargets)
			or "Use Selected Riders (Optional)"
		refs.selectButton.Position = UDim2.fromOffset(14, riderVisible and 206 or state.effectMode == "Impact" and 164 or 122)
		refs.loadPath.Position = UDim2.fromOffset(14, state.effectMode == "Release" and 164 or state.effectMode == "AdaptiveWalk" and 206 or riderVisible and 248 or 206)
	end
	if refs.movement then
		refs.movement.Visible = state.effectMode == "Impact"
		refs.movement.Active = state.effectMode == "Impact" and not running
		refs.movement.Text = state.movingObjectMode == "PhysicsDrive"
			and "Movement: Physics Drive"
			or "Movement: Follow Path"
		refs.movement.BackgroundColor3 = state.movingObjectMode == "PhysicsDrive" and THEME.cyan or THEME.button
		refs.movement.Position = UDim2.fromOffset(14, state.movingObjectMode == "PhysicsDrive" and 290 or 248)
	end
	if refs.keepUpright then
		refs.keepUpright.Visible = state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive"
		refs.keepUpright.Active = refs.keepUpright.Visible and not running
		refs.keepUpright.Text = state.keepUpright and "Keep Upright: On" or "Keep Upright: Off"
		refs.keepUpright.BackgroundColor3 = state.keepUpright and THEME.green or THEME.button
	end
	if refs.eventSource then
		local visible = state.isEventMode()
		local sourceReady = state.eventSourceInstance
			and state.eventSourceInstance.Parent
			and (state.effectMode == "Projectile" and state.eventSourceDescriptor ~= nil or state.eventSourcePosition ~= nil)
		local projectileVisible = visible and state.effectMode == "Projectile"
		refs.eventSource.Visible = visible
		refs.eventSource.Active = visible and not running
			refs.eventSource.Text = state.effectMode == "Explosion"
				and (sourceReady and "Blast Origin: Set - Drag Gizmo or Click to Move" or "Blast Origin")
			or (sourceReady
				and ("Projectile Object: " .. state.eventSourceInstance.Name)
				or "Set Projectile Object from Selection")
		refs.projectileStart.Visible = projectileVisible
		refs.projectileEnd.Visible = projectileVisible
		refs.projectileStart.Active = projectileVisible and not running and sourceReady
		refs.projectileEnd.Active = projectileVisible and not running and sourceReady
		refs.projectileStart.BackgroundTransparency = refs.projectileStart.Active and 0 or 0.45
		refs.projectileEnd.BackgroundTransparency = refs.projectileEnd.Active and 0 or 0.45
		refs.projectileStart.Text = state.eventProjectileStart and "Start: Set" or "Place Start"
		refs.projectileEnd.Text = state.eventProjectileEnd and "Impact: Set" or "Place Impact"
		local eventOffset = projectileVisible and 42 or 0
		local directionOffset = state.effectMode == "Explosion" and 42 or 0
		refs.eventTimeDown.Position = UDim2.fromOffset(14, 206 + eventOffset)
		refs.eventTime.Position = UDim2.fromOffset(92, 206 + eventOffset)
		refs.eventTimeUp.Position = UDim2.new(1, -86, 0, 206 + eventOffset)
		refs.eventTimeHelp.Position = UDim2.fromOffset(14, 247 + eventOffset)
		refs.eventStrength.Position = UDim2.fromOffset(14, 269 + eventOffset)
		if state.effectMode == "Explosion" then
			-- Explosion always uses authentic real-time physics. Animators can add
			-- slow motion non-destructively to the baked timeline group afterwards.
			refs.eventStrength.Size = UDim2.new(1, -28, 0, 38)
		else
			refs.eventStrength.Size = UDim2.new(0.5, -17, 0, 38)
			refs.eventSlowMotion.Position = UDim2.new(0.5, 3, 0, 269 + eventOffset)
			refs.eventSlowMotion.Size = UDim2.new(0.5, -17, 0, 38)
		end
		refs.eventReaction.Position = UDim2.fromOffset(14, 311 + eventOffset)
		refs.eventReaction.Size = UDim2.new(1, -28, 0, 46)
		local reactionOffset = 50
		refs.eventDirection.Position = UDim2.fromOffset(14, 311 + eventOffset + reactionOffset)
		refs.eventPowerPanel.Position = UDim2.fromOffset(14, 311 + eventOffset + directionOffset + reactionOffset)
		refs.eventAdd.Position = UDim2.fromOffset(14, 353 + eventOffset + directionOffset + reactionOffset)
		refs.eventRemove.Position = UDim2.new(0.72, 4, 0, 353 + eventOffset + directionOffset + reactionOffset)
		refs.eventTest.Position = UDim2.fromOffset(
			14,
			(state.effectMode == "Explosion" and 353 or 395) + eventOffset + directionOffset + reactionOffset
		)
		-- Explosion tests now fire immediately. Keep the timing controls and marker
		-- field for Projectile and for reading older delayed event data, but do not
		-- expose an unnecessary delay step in the streamlined Explosion workflow.
		refs.eventTimeDown.Visible = projectileVisible
		refs.eventTime.Visible = projectileVisible
		refs.eventTimeUp.Visible = projectileVisible
		refs.eventTimeHelp.Visible = projectileVisible
		refs.eventStrength.Visible = visible
		refs.eventReaction.Visible = visible
		refs.eventSlowMotion.Visible = projectileVisible
		refs.eventDirection.Visible = visible and state.effectMode == "Explosion"
		refs.eventPowerPanel.Visible = visible
		-- Explosion uses one synchronized blast. Keep queue controls only for the
		-- Projectile workflow, where multiple timed impacts remain useful.
		refs.eventAdd.Visible = projectileVisible
		refs.eventRemove.Visible = projectileVisible
		refs.eventTest.Visible = visible and state.effectMode == "Explosion"
		refs.eventTimeDown.Active = projectileVisible and not running and state.eventTime &gt; 0
		refs.eventTimeUp.Active = projectileVisible and not running and state.eventTime &lt; state.maxDuration
		refs.eventTime.Text = string.format("Fires At: %.2fs", state.eventTime)
		refs.eventTimeHelp.Text = state.effectMode == "Projectile"
			and "The selected objects react at this time; the projectile then continues under natural physics."
			or "The explosion fires as soon as the simulation starts."
		refs.eventStrength.Text = "Preset: " .. state.eventStrength
		local ragdollAvailable = SceneCaptureScope.HasSupportedRagdollRig(state.objectTargets)
		local reactionButtons = {
			Push = refs.eventReactionPush,
			Ragdoll = refs.eventReactionRagdoll,
			BreakApart = refs.eventReactionBreakApart,
		}
		local reactionBackgrounds = {
			Push = refs.eventReactionPushBackground,
			Ragdoll = refs.eventReactionRagdollBackground,
			BreakApart = refs.eventReactionBreakApartBackground,
		}
		local reactionGradients = {
			Push = refs.eventReactionPushGradient,
			Ragdoll = refs.eventReactionRagdollGradient,
			BreakApart = refs.eventReactionBreakApartGradient,
		}
		local reactionLabels = {
			Push = refs.eventReactionPushLabel,
			Ragdoll = refs.eventReactionRagdollLabel,
			BreakApart = refs.eventReactionBreakApartLabel,
		}
		local reactionTextColors = {
			Push = Color3.fromRGB(8, 27, 43),
			Ragdoll = Color3.fromRGB(255, 255, 255),
			BreakApart = Color3.fromRGB(45, 19, 8),
		}
		for reaction, button in pairs(reactionButtons) do
			local available = reaction ~= "Ragdoll" or ragdollAvailable
			local selected = state.eventReaction == reaction
			local background = reactionBackgrounds[reaction]
			local gradient = reactionGradients[reaction]
			local label = reactionLabels[reaction]
			button.Active = visible and not running and available
			background.BackgroundTransparency = available and 0 or 0.38
			gradient.Transparency = NumberSequence.new(available and (selected and 0 or 0.12) or 0.5)
			label.TextColor3 = available and reactionTextColors[reaction] or THEME.muted
			local stroke = background:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = selected and 2 or 1
				stroke.Transparency = available and (selected and 0 or 0.18) or 0.58
			end
		end
		refs.eventSlowMotion.Text = state.eventSlowMotion and "Response: 0.5x" or "Response: Normal"
		refs.eventSlowMotion.Active = projectileVisible and not running
		refs.eventDirection.Text = state.eventDirectionMode == "Forward"
			and "Blast Direction: Forward - Rotate Cyan Rings"
			or ("Blast Direction: " .. state.eventDirectionMode)
		refs.eventDirection.Active = refs.eventDirection.Visible and not running
		refs.eventPowerText.Text = string.format("Power: %d%%", state.eventPower)
		refs.eventPowerFill.Size = UDim2.new((state.eventPower - 10) / 90, 0, 1, 0)
		refs.eventPowerKnob.Position = UDim2.new((state.eventPower - 10) / 90, -9, 0.5, -9)
		refs.eventAdd.Text = string.format("Add %s Event (%d queued)", state.effectMode, #state.eventMarkers)
		refs.eventAdd.Active = projectileVisible
			and not running
			and sourceReady
			and #state.objectTargets &gt; 0
			and (state.effectMode ~= "Projectile"
				or state.eventProjectileStart ~= nil and state.eventProjectileEnd ~= nil)
		refs.eventAdd.BackgroundTransparency = refs.eventAdd.Active and 0 or 0.45
		refs.eventRemove.Text = #state.eventMarkers &gt; 0 and "Undo Last" or "No Events"
		refs.eventRemove.Active = projectileVisible and not running and #state.eventMarkers &gt; 0
		refs.eventRemove.BackgroundTransparency = refs.eventRemove.Active and 0 or 0.45
		refs.eventTest.Active = refs.eventTest.Visible
			and (not running or state.eventTestMode)
			and sourceReady
			and #state.objectTargets &gt; 0
		refs.eventTest.BackgroundTransparency = refs.eventTest.Active and 0 or 0.45
		refs.eventTest.Text = state.eventSpeedPreviewMode and state.previewSession
			and "Stop Speed Preview"
			or state.eventTestMode
				and running
				and state.eventPlaybackSpeed &gt; 1.001
				and "Calculating Physics..."
			or state.eventTestMode and running and "Stop Test &amp; Restore"
			or "Test Explosion"
	end
	if refs.eventVFX then
		local source = state.explosionVFXSupport.ResolveSource(
			state.explosionVFXSource,
			state.explosionVFXSourceDescriptor
		)
		state.explosionVFXSource = source
		local emitterCount = source and source.Parent
			and state.explosionVFXSupport.GetEmitterCount(source)
			or 0
		if emitterCount == 0 then
			state.explosionVFXSource = nil
			source = nil
		end
		refs.eventVFX.Visible = state.effectMode == "Explosion"
		refs.eventVFX.Active = refs.eventVFX.Visible and not running
		refs.eventVFX.BackgroundTransparency = refs.eventVFX.Active and 0 or 0.45
		refs.eventVFX.Text = source
			and string.format(
				"Explosion VFX: %s (%d emitter%s)",
				source.Name,
				emitterCount,
				emitterCount == 1 and "" or "s"
			)
			or "Explosion VFX: None (Optional)"
	end
	if refs.bounce then
		refs.bounce.Visible = state.effectMode == "Drop"
		refs.bounce.Active = state.effectMode == "Drop" and not running
		refs.bounce.Text = state.bounceEnabled and "Extra Bounce: On" or "Extra Bounce: Off"
		refs.bounce.BackgroundColor3 = state.bounceEnabled and THEME.yellow or THEME.button
		refs.bounce.TextColor3 = state.bounceEnabled and Color3.new(0, 0, 0) or THEME.text
	end
	if refs.ragdollMode then
		refs.ragdollMode.Visible = state.effectMode == "Character"
		refs.ragdollMode.Active = refs.ragdollMode.Visible and not running
		refs.ragdollMode.Text = state.ragdollMode == "Knockback"
			and "Mode: Knockback"
			or "Mode: Natural Fall"
		refs.ragdollMode.BackgroundColor3 = state.ragdollMode == "Knockback"
			and Color3.fromRGB(102, 70, 202)
			or THEME.button
	end
	if refs.startingPush then
		state.startingPushConfigured = state.findStartingPushDescriptor() ~= nil
		state.startingPushUX:SetSpeed(state.startingPushSpeed)
		refs.startingPush.Visible = state.effectMode == "Scene"
			or state.effectMode == "Character" and state.ragdollMode == "Knockback"
		refs.startingPush.Active = refs.startingPush.Visible and not running
		refs.startingPush.Text = state.startingPushUX:IsContactPlacementActive()
			and "NEXT: Click target surface in viewport"
			or state.startingPushConfigured
			and (state.effectMode == "Character"
				and string.format("Knockback Direction - %.1f studs/s", state.startingPushSpeed)
				or string.format("Starting Push: %s - %.1f studs/s", state.startingPushTarget.Name, state.startingPushSpeed))
			or (state.effectMode == "Character" and "Set Knockback Direction" or "Add Starting Push (Optional)")
		refs.startingPushClear.Visible = refs.startingPush.Visible and state.startingPushConfigured
		refs.startingPushClear.Active = refs.startingPushClear.Visible and not running
		refs.startingPush.Size = state.startingPushConfigured
			and UDim2.new(0.78, -18, 0, 38)
			or UDim2.new(1, -28, 0, 38)
		refs.startingPushSpeedDown.Visible = refs.startingPushClear.Visible
		refs.startingPushSpeed.Visible = refs.startingPushClear.Visible
		refs.startingPushSpeedUp.Visible = refs.startingPushClear.Visible
		refs.startingPushSpeedDown.Active = refs.startingPushSpeedDown.Visible and not running
		refs.startingPushSpeedUp.Active = refs.startingPushSpeedUp.Visible and not running
		refs.startingPushSpeed.Text = string.format("Push Speed: %.0f studs/s", state.startingPushSpeed)
		refs.startingPushTest.Visible = refs.startingPushClear.Visible
			and state.effectMode ~= "Character"
		refs.startingPushTest.Active = refs.startingPushTest.Visible
			and (not running or state.startingPushTestMode)
		refs.startingPushTest.BackgroundTransparency = refs.startingPushTest.Active and 0 or 0.5
		refs.startingPushTest.Text = state.startingPushTestMode and running
			and "Stop Test &amp; Restore"
			or string.format(
				state.effectMode == "Character" and "Test Knockback at %.0f studs/s" or "Test Push at %.0f studs/s",
				state.startingPushSpeed
			)
	end
	if refs.eventTest then
		local testRunning = state.eventTestMode or state.startingPushTestMode
		local testReady = ready or state.effectMode == "Explosion"
			and #state.objectTargets &gt; 0
			and state.eventSourceInstance ~= nil
			and state.eventSourceInstance.Parent ~= nil
			and state.eventSourcePosition ~= nil
		refs.eventTest.Visible = state.uiStage == "Setup" and state.setupPage == "Prepare"
		refs.eventTest.Active = refs.eventTest.Visible
			and ((not running and testReady) or testRunning or state.eventSpeedPreviewMode)
		refs.eventTest.BackgroundTransparency = refs.eventTest.Active and 0 or 0.45
		refs.eventTest.Text = state.eventSpeedPreviewMode and state.previewSession
			and "Stop Speed Preview"
			or testRunning and running and "Stop Test &amp; Restore"
			or "Test " .. (state.effectTestLabels[state.effectMode] or "Effect")
	end
	if refs.captureMode then
		refs.captureMode.Text = state.effectMode == "Release"
			and "Capture Mode: Release Object"
			or state.effectMode == "AdaptiveWalk"
			and "Capture Mode: Adaptive Walk"
			or state.captureMode == "Objects" and "Capture Mode: Objects Only" or "Capture Mode: Rig + Scene"
		refs.captureMode.BackgroundColor3 = state.captureMode == "Objects" and THEME.yellow or THEME.cyan
	end
	if refs.checklist then
		refs.checklist.Text = ready
			and "READY TO SIMULATE"
			or state.isEventMode() and (#state.objectTargets == 0
				and "Select the objects that should react"
				or state.effectMode == "Projectile" and not state.eventSourceDescriptor
					and "Select the projectile object"
				or state.effectMode == "Projectile"
					and (not state.eventProjectileStart or not state.eventProjectileEnd)
					and "Place both Start and Impact points"
					or #state.eventMarkers == 0 and (state.effectMode == "Explosion"
						and "Set the Blast Origin and add the explosion"
						or "Set an event point and add at least one timed event")
				or "Finish the event setup")
			or state.effectMode == "AdaptiveWalk" and (state.selectedRig and state.selectedRig.Parent
				and (getSelectedWalkPreset() and "Load the CFrame route from 7kg2" or "Choose a compatible Walk Style")
				or "Select the character rig, then choose a Walk Style")
			or state.effectMode == "Release" and "Place the playhead on the Detach event, then load it"
			or state.effectMode == "Impact" and (state.movingObjectMode == "PhysicsDrive"
				and "Set the Moving Object, choose Physics Drive, then load its animated path"
				or "Set the Moving Object, select physics objects, then load its animated path")
			or state.effectMode == "Character" and (#state.selectedRigs &gt; 0
				and state.ragdollMode == "Knockback"
					and "Set the Knockback direction and speed"
					or "Select one or more character rigs")
			or state.captureMode == "Objects" and "Select at least one physics object" or "Select a character rig"
		refs.checklist.TextColor3 = ready and THEME.green or THEME.muted
	end
	if refs.capture then
		if state.adaptiveWalkSession then
			refs.capture.Text = "Adapting Walk to Terrain..."
			refs.capture.BackgroundColor3 = THEME.cyan
		elseif state.pathSession then
			refs.capture.Text = state.pathMode == "DrivenImpact" and "Driving Authored Path..." or "Playing Animated Path..."
			refs.capture.BackgroundColor3 = THEME.cyan
		elseif state.capturing then
			refs.capture.Text = "Recording Physics..."
			refs.capture.BackgroundColor3 = THEME.red
		elseif state.armed then
			refs.capture.Text = "Capture Armed"
			refs.capture.BackgroundColor3 = THEME.yellow
		else
			refs.capture.Text = state.isEventMode() and "Arm Event Capture"
				or state.captureMode == "Objects" and "Arm Object Capture" or "Arm Physics Capture"
			refs.capture.BackgroundColor3 = THEME.accent
		end
	end
	if refs.run then
		if running then
			refs.run.Text = "Finish &amp; Review"
		elseif state.manualRunRequired then
			refs.run.Text = "Disable Team Create to Capture"
		else
			refs.run.Text = state.effectMode == "AdaptiveWalk" and "Preview &amp; Capture Walk" or "Simulate &amp; Capture"
		end
		refs.run.Active = (running or ready) and state.previewSession == nil and not state.manualRunRequired
		refs.run.BackgroundTransparency = refs.run.Active and 0 or 0.5
	end
	if refs.ragdoll then
		local ragdollLabel = state.pathMode == "DrivenImpact" and "Ragdoll After Path" or "Auto Ragdoll"
		refs.ragdoll.Text = string.format("%s: %s", ragdollLabel, state.autoRagdoll and "On" or "Off")
		refs.ragdoll.BackgroundColor3 = state.autoRagdoll and Color3.fromRGB(38, 92, 76) or THEME.button
		refs.ragdoll.Active = state.captureMode ~= "Objects" and state.effectMode ~= "AdaptiveWalk"
		refs.ragdoll.BackgroundTransparency = refs.ragdoll.Active and 0 or 0.5
	end
	if refs.fps30 then
		refs.fps30.BackgroundColor3 = state.fps == 30 and THEME.accent or THEME.button
		refs.fps60.BackgroundColor3 = state.fps == 60 and THEME.accent or THEME.button
	end
	if refs.duration10 then
		refs.duration10.BackgroundColor3 = state.maxDuration == 10 and THEME.cyan or THEME.button
		refs.duration20.BackgroundColor3 = state.maxDuration == 20 and THEME.cyan or THEME.button
		refs.duration30.BackgroundColor3 = state.maxDuration == 30 and THEME.cyan or THEME.button
	end
	if refs.scopeRig then
		local scopeEditable = state.captureMode ~= "Objects" and state.effectMode ~= "AdaptiveWalk"
		refs.scopeRig.BackgroundColor3 = state.captureScope == SceneCaptureScope.RIG_ONLY and THEME.accent or THEME.button
		refs.scopeSelected.BackgroundColor3 = state.captureScope == SceneCaptureScope.SELECTED and THEME.accent or THEME.button
		refs.scopeScene.BackgroundColor3 = state.captureScope == SceneCaptureScope.ENTIRE_SCENE and THEME.accent or THEME.button
		refs.scopeRig.Active = scopeEditable
		refs.scopeSelected.Active = state.effectMode ~= "AdaptiveWalk"
		refs.scopeScene.Active = scopeEditable
		refs.scopeRig.BackgroundTransparency = refs.scopeRig.Active and 0 or 0.5
		refs.scopeSelected.BackgroundTransparency = refs.scopeSelected.Active and 0 or 0.5
		refs.scopeScene.BackgroundTransparency = refs.scopeScene.Active and 0 or 0.5
	end
	if refs.targets then
		local suffix = state.targetsTruncated and " (limited to 500)" or ""
		if state.captureScope == SceneCaptureScope.RIG_ONLY then
			refs.targets.Text = "Captures the bound character rig only."
		elseif state.captureScope == SceneCaptureScope.SELECTED then
			refs.targets.Text = string.format("Selected environment parts: %d%s", #state.objectTargets, suffix)
		else
			refs.targets.Text = string.format("Eligible scene parts watched: %d%s", #state.objectTargets, suffix)
		end
	end
	if refs.path then
		if state.effectMode == "Release" and state.releaseData then
			refs.path.Text = string.format(
				"Release frame %d | %.2f studs/s | %.2f rad/s",
				state.releaseData.releaseFrame or 0,
				typeof(state.releaseData.linearVelocity) == "Vector3" and state.releaseData.linearVelocity.Magnitude or 0,
				typeof(state.releaseData.angularVelocity) == "Vector3" and state.releaseData.angularVelocity.Magnitude or 0
			)
			refs.path.TextColor3 = THEME.green
		elseif state.effectMode == "Release" then
			refs.path.Text = "Place 7kg2's playhead on the Detach event, then load the exact release state."
			refs.path.TextColor3 = THEME.muted
		elseif state.captureMode == "Objects" and state.effectMode ~= "Impact" then
			refs.path.Text = "Object Only mode starts from the current Workspace position. No rig path is required."
			refs.path.TextColor3 = THEME.muted
		elseif state.animatedPath then
			if state.effectMode == "AdaptiveWalk" then
				refs.path.Text = string.format(
					"Adaptive walk %.2fs | Frames %d-%d | Terrain contacts enabled",
					state.animatedPath.duration or 0,
					state.animatedPath.startFrame or 0,
					state.animatedPath.endFrame or state.animatedPath.handoffFrame or 0
				)
			elseif state.pathMode == "DrivenImpact" then
				refs.path.Text = string.format(
					"Driven %.2fs | Frames %d-%d | Ragdoll after path",
					state.animatedPath.duration or 0,
					state.animatedPath.startFrame or 0,
					state.animatedPath.endFrame or state.animatedPath.handoffFrame or 0
				)
			else
				refs.path.Text = string.format(
					"Loaded %.2fs path | Physics starts at frame %d",
					state.animatedPath.duration or 0,
					state.animatedPath.handoffFrame or 0
				)
			end
			refs.path.TextColor3 = THEME.green
		else
			refs.path.Text = state.effectMode == "AdaptiveWalk"
				and "Add the rig CFrame route in 7kg2. Adaptive Walk uses its first and last CFrame keys automatically."
				or state.pathMode == "DrivenImpact"
				and "Playhead marks the start; the rig follows its remaining authored CFrame path."
				or "No path loaded. The playhead becomes the physics handoff frame."
			refs.path.TextColor3 = THEME.muted
		end
	end
	if refs.pathMode then
		refs.pathMode.Text = state.effectMode == "Release"
			and "Path Mode: Release Handoff"
			or state.effectMode == "AdaptiveWalk"
			and "Path Mode: Adaptive Walk"
			or state.pathMode == "DrivenImpact" and "Path Mode: Driven Impact" or "Path Mode: Physics Handoff"
		refs.pathMode.BackgroundColor3 = state.pathMode == "DrivenImpact" and Color3.fromRGB(38, 92, 76) or THEME.button
		refs.pathMode.Active = state.captureMode ~= "Objects" and state.effectMode ~= "AdaptiveWalk"
		refs.pathMode.BackgroundTransparency = refs.pathMode.Active and 0 or 0.5
	end
	if refs.loadPath then
		refs.loadPath.Text = state.pathLoading and "Loading Path from 7kg2..."
			or state.effectMode == "Release" and state.releaseData and "Release State Loaded - Click to Clear"
			or state.animatedPath and "Animated Path Loaded - Click to Clear"
			or (state.effectMode == "AdaptiveWalk" and "Load CFrame Route + Walk Style"
				or state.effectMode == "Release" and "Find Detach Event &amp; Load Release"
				or state.movingObjectMode == "PhysicsDrive" and "Load Start / End Path from 7kg2" or "Load Animated Path from 7kg2")
		refs.loadPath.Visible = state.effectMode == "Impact" or state.effectMode == "AdaptiveWalk" or state.effectMode == "Release"
		refs.loadPath.Active = (state.effectMode == "Impact" or state.effectMode == "AdaptiveWalk" or state.effectMode == "Release")
			and not state.pathLoading
			and not state.walkPresetLoading
		refs.loadPath.BackgroundTransparency = refs.loadPath.Active and 0 or 0.35
	end
	if refs.setupPanel then
		refs.setupPanel.Size = UDim2.new(
			1,
			0,
			0,
			state.effectMode == "Projectile" and 452 or state.isEventMode() and 410 or 346
		)
	end
	if refs.impact then
		refs.impact.Text = state.impactBreak and "Impact Break: On" or "Impact Break: Off"
		refs.impact.BackgroundColor3 = state.impactBreak and Color3.fromRGB(125, 74, 63) or THEME.button
		refs.impact.Active = state.captureMode ~= "Objects" and state.captureScope == SceneCaptureScope.SELECTED
		refs.impact.BackgroundTransparency = refs.impact.Active and 0 or 0.5
	end
	if refs.take then
		if state.take then
			refs.take.Text = string.format(
				"%s\n%d samples | %d FPS | %s",
				formatDuration(state.take.duration),
				#state.take.samples,
				state.take.fps,
				#state.rigTakes &gt; 1 and string.format("%d characters", #state.rigTakes)
					or string.format("%d scene parts", state.take.objectCount or 0)
			)
		else
			refs.take.Text = "No physics take captured yet."
		end
	end
	if refs.retake then
		refs.retake.Active = state.previewSession == nil and state.take ~= nil and not running and isWorkflowReady()
		refs.retake.BackgroundTransparency = refs.retake.Active and 0 or 0.5
	end
	if refs.push then
		refs.push.Active = state.physicsActive and (state.ragdollCapture ~= nil or state.ragdollSession ~= nil)
		refs.push.BackgroundTransparency = refs.push.Active and 0 or 0.5
	end
	if refs.bake then
		refs.bake.Active = state.previewSession == nil and state.take ~= nil and not running and not state.take.objectOnly
		refs.bake.BackgroundTransparency = refs.bake.Active and 0 or 0.5
	end
	if refs.import then
		refs.import.Active = state.previewSession == nil and state.take ~= nil and not running
		refs.import.BackgroundTransparency = refs.import.Active and 0 or 0.5
		refs.import.Font = Enum.Font.GothamBold
		refs.import.TextColor3 = Color3.fromRGB(255, 255, 255)
		refs.import.TextSize = 16
	end
	if refs.preview then
		refs.preview.Text = state.previewSession and "Stop Preview" or "Preview Take"
		refs.preview.Active = state.take ~= nil and not running
		refs.preview.BackgroundColor3 = state.previewSession and THEME.yellow or THEME.cyan
		refs.preview.BackgroundTransparency = refs.preview.Active and 0 or 0.5
	end
	if refs.previewSpeed then
		refs.previewSpeed.Text = string.format("Speed: %gx", state.previewSpeed)
		refs.previewSpeed.Active = state.take ~= nil and not running and state.previewSession == nil
		refs.previewSpeed.BackgroundTransparency = refs.previewSpeed.Active and 0 or 0.5
	end
	if refs.continueBake then
		refs.continueBake.Active = state.previewSession == nil and state.take ~= nil and not running
		refs.continueBake.BackgroundTransparency = refs.continueBake.Active and 0 or 0.5
	end
	if refs.advancedPanel then
		refs.advancedPanel.Size = UDim2.new(1, 0, 0, 332)
		refs.advancedToggle.Text = state.advancedVisible and "Hide Advanced Options  ^" or "Advanced Options  v"
	end
	if refs.push and refs.run then
		local showPush = state.physicsActive and (state.ragdollCapture ~= nil or state.ragdollSession ~= nil)
		refs.push.Visible = showPush
		refs.run.Size = showPush and UDim2.new(0.72, -14, 0, 58) or UDim2.new(1, -28, 0, 58)
	end
	if refs.stageSetup then
		local setupStage = state.uiStage == "Setup"
		local captureStage = state.uiStage == "Capture"
		local bakeStage = state.uiStage == "Bake"
		local choosePage = setupStage and state.setupPage == "Choose"
		local preparePage = setupStage and state.setupPage == "Prepare"
		if refs.popupSizeConstraint then
			refs.popupSizeConstraint.MaxSize = Vector2.new(
				state.microPopup and 760 or 430,
				state.microPopup and 760
					or choosePage and 590
					or preparePage and 590
					or captureStage and 560
					or 470
			)
		end
		refs.stageSetup.BackgroundColor3 = setupStage and THEME.accent or THEME.button
		refs.stageCapture.BackgroundColor3 = captureStage and THEME.accent or THEME.button
		refs.stageBake.BackgroundColor3 = bakeStage and THEME.accent
			or state.take and Color3.fromRGB(38, 92, 76)
			or THEME.button
		updateButtonTextContrast(refs.stageSetup)
		updateButtonTextContrast(refs.stageCapture)
		updateButtonTextContrast(refs.stageBake)
		refs.captureTypePanel.Visible = false
		refs.effectPanel.Visible = choosePage
		refs.setupPanel.Visible = preparePage
		refs.setupNavigationPanel.Visible = preparePage
		refs.advancedPanel.Visible = preparePage and state.advancedVisible
		refs.advancedToggle.Visible = preparePage
		refs.checklistPanel.Visible = preparePage or captureStage
		refs.simulatePanel.Visible = captureStage
		refs.takePanel.Visible = captureStage or bakeStage
		refs.continueBake.Visible = captureStage
		refs.import.Visible = bakeStage
		refs.import.Text = "Bake to Timeline"
		refs.takeHeading.Text = bakeStage and "Ready for Timeline" or "Review Capture"
		refs.takeHeading.TextColor3 = bakeStage and THEME.green or THEME.text
		refs.take.BackgroundTransparency = bakeStage and 0 or 1
		refs.take.BackgroundColor3 = THEME.panel
		refs.take.Position = bakeStage and UDim2.fromOffset(10, 38) or UDim2.fromOffset(10, 34)
		refs.take.Size = UDim2.new(1, -20, 0, 42)
		refs.import.Position = UDim2.fromOffset(10, 88)
		refs.import.Size = UDim2.new(1, -20, 0, 50)
		refs.preview.Position = bakeStage and UDim2.fromOffset(10, 146) or UDim2.fromOffset(10, 80)
		refs.preview.Size = UDim2.new(0.64, -15, 0, bakeStage and 38 or 36)
		refs.preview.Text = state.previewSession and "Stop Preview" or bakeStage and "Preview Again" or "Preview Take"
		refs.previewSpeed.Position = bakeStage and UDim2.new(0.64, 5, 0, 146) or UDim2.new(0.64, 5, 0, 80)
		refs.previewSpeed.Size = UDim2.new(0.36, -15, 0, bakeStage and 38 or 36)
		refs.continueBake.Position = UDim2.fromOffset(10, 122)
		refs.continueBake.Size = UDim2.new(1, -20, 0, 40)
		refs.retake.Position = bakeStage and UDim2.fromOffset(10, 192) or UDim2.fromOffset(10, 168)
		refs.reset.Position = bakeStage and UDim2.new(0.5, 5, 0, 192) or UDim2.new(0.5, 5, 0, 168)
		refs.retake.Size = UDim2.new(0.5, -15, 0, 36)
		refs.reset.Size = UDim2.new(0.5, -15, 0, 36)

		if choosePage then
			refs.stageContent.CanvasSize = UDim2.fromOffset(0, 502)
			refs.effectPanel.Position = UDim2.fromOffset(0, 0)
			refs.effectPanel.Size = UDim2.new(1, 0, 0, 492)
		elseif preparePage then
			refs.stageContent.CanvasSize = UDim2.fromOffset(
				0,
				state.effectMode == "Projectile"
					and (state.advancedVisible and 1000 or 654)
					or state.isEventMode()
					and (state.advancedVisible and 958 or 612)
					or (state.advancedVisible and 894 or 548)
			)
			refs.setupPanel.Position = UDim2.fromOffset(0, 0)
			refs.setupPanel.Size = UDim2.new(
				1,
				0,
				0,
				state.effectMode == "Projectile" and 452 or state.isEventMode() and 410 or 346
			)
			refs.checklistPanel.Position = UDim2.fromOffset(
				0,
				state.effectMode == "Projectile" and 464 or state.isEventMode() and 422 or 358
			)
			refs.checklistPanel.Size = UDim2.new(1, 0, 0, 62)
			refs.setupNavigationPanel.Position = UDim2.fromOffset(
				0,
				state.effectMode == "Projectile" and 538 or state.isEventMode() and 496 or 432
			)
			refs.setupNavigationPanel.Size = UDim2.new(1, 0, 0, 58)
			refs.advancedToggle.Position = UDim2.fromOffset(
				0,
				state.effectMode == "Projectile" and 608 or state.isEventMode() and 566 or 502
			)
			refs.advancedToggle.Size = UDim2.new(1, 0, 0, 38)
			refs.advancedPanel.Position = UDim2.fromOffset(
				0,
				state.effectMode == "Projectile" and 658 or state.isEventMode() and 616 or 552
			)
		elseif captureStage then
			refs.stageContent.CanvasSize = UDim2.fromOffset(0, 590)
			refs.checklistPanel.Position = UDim2.fromOffset(0, 0)
			refs.checklistPanel.Size = UDim2.new(1, 0, 0, 62)
			refs.simulatePanel.Position = UDim2.fromOffset(0, 74)
			refs.simulatePanel.Size = UDim2.new(1, 0, 0, 122)
			refs.takePanel.Position = UDim2.fromOffset(0, 208)
			refs.takePanel.Size = UDim2.new(1, 0, 0, 220)
		else
			refs.stageContent.CanvasSize = UDim2.fromOffset(0, 396)
			refs.takePanel.Position = UDim2.fromOffset(0, 8)
			refs.takePanel.Size = UDim2.new(1, 0, 0, 244)
		end
	end
	if state.quickPhysicsPanel then
		state.quickPhysicsPanel:Update(state.quickPhysicsSupport.BuildContext(
			state.quickPhysics,
			Selection:Get(),
			state.releaseData,
			state.take,
			state.fps,
			running,
			state.previewSession ~= nil,
			state.effectMode ~= "Release" or state.releaseCollisionsEnabled
		))
	end
	for _, reference in pairs(refs) do
		if typeof(reference) == "Instance" and reference:IsA("TextButton") then
			updateButtonTextContrast(reference)
		end
	end
	if refs.effectSetupPresentation then
		refs.effectSetupPresentation:Update(
			state.effectMode,
			state.movingObjectMode,
			state.uiStage,
			state.setupPage,
			state.advancedVisible,
			ready,
			state.take,
			state.maxDuration,
			state.releaseObject,
			state.releaseData,
			state.releaseCollisionsEnabled,
			state.startingPushTestedSpeed == state.startingPushSpeed,
			state.eventTestCompleted
		)
	end
	if state.guidedMode then
		state.guidedMode:Update({
			effectMode = state.effectMode,
			uiStage = state.uiStage,
			setupPage = state.setupPage,
			quickVisible = state.quickPhysics.visible,
			hasTake = state.take ~= nil,
			objectCount = #state.objectTargets,
			rigCount = #state.selectedRigs,
			hasReleaseObject = state.releaseObject ~= nil and state.releaseObject.Parent ~= nil,
			hasReleaseData = state.releaseData ~= nil,
			ragdollMode = state.ragdollMode,
			hasStartingPush = state.findStartingPushDescriptor() ~= nil,
			startingPushTested = state.startingPushTestedSpeed == state.startingPushSpeed,
			hasDriver = state.driverObject ~= nil and state.driverObject.Parent ~= nil,
			hasPath = state.animatedPath ~= nil,
			hasEventSource = state.eventSourceInstance ~= nil and state.eventSourceInstance.Parent ~= nil,
			hasProjectileStart = state.eventProjectileStart ~= nil,
			hasProjectileEnd = state.eventProjectileEnd ~= nil,
			eventCount = #state.eventMarkers,
			eventTested = state.eventTestCompleted,
		})
	end
	setStatus(state.status, state.statusTone)
end

state.updateUI = updateUI

local function refreshCaptureTargets(selection, announce)
	SceneCaptureScope.ClearRuntimeIds(state.objectTargets)
	RiderRuntime.ClearRuntimeIds(state.riderTargets)
	state.objectTargets, state.targetsTruncated = SceneCaptureScope.Collect(
		state.captureScope,
		state.selectedRig or state.driverObject,
		selection or Selection:Get()
	)
	if state.isEventMode()
		and state.eventReaction == "Ragdoll"
		and not SceneCaptureScope.HasSupportedRagdollRig(state.objectTargets) then
		state.eventReaction = "Push"
		state.eventTestCompleted = false
		if state.eventActions.SyncSingleQueuedEvent then
			state.eventActions.SyncSingleQueuedEvent()
		end
	end
	if state.effectMode == "Explosion" and not RunService:IsRunning() then
		state.invalidateExplosionTestCache()
	end
	if state.startingPushTarget and not state.findStartingPushDescriptor() then
		state.clearStartingPush()
	end
	if announce then
		if state.captureScope == SceneCaptureScope.RIG_ONLY then
			setStatus("Capture scope set to the bound rig only.", THEME.green)
		elseif #state.objectTargets == 0 then
			setStatus("No environment parts were found. Select Parts, Models, or Folders, then refresh the targets.", THEME.yellow)
		else
			local suffix = state.targetsTruncated and " The list was limited to 500 parts." or ""
			setStatus(string.format("Prepared %d environment part%s for capture.%s", #state.objectTargets, #state.objectTargets == 1 and "" or "s", suffix), THEME.green)
		end
	end
	state.refreshWorkflowUX()
	updateUI()
end

local function prepareRuntimeTargets()
	if state.captureScope == SceneCaptureScope.ENTIRE_SCENE then
		refreshCaptureTargets(nil, false)
	end
	SceneCaptureScope.PrepareRuntimeIds(state.objectTargets)
	state.startingPushTargetId = nil
	if state.effectMode == "Scene" then
		local startingPushDescriptor = state.findStartingPushDescriptor()
		state.startingPushTargetId = startingPushDescriptor and startingPushDescriptor.id or nil
	end
	if state.effectMode == "Release" and state.releaseCaptureTarget then
		state.releaseCaptureTarget.id = nil
		for _, descriptor in ipairs(state.objectTargets) do
			if descriptor.instance == state.releaseCaptureTarget.rootInstance then
				state.releaseCaptureTarget.id = descriptor.id
				state.releaseCaptureTarget.rootName = descriptor.instance.Name
				break
			end
		end
	end
	state.eventSourceScope.PrepareRuntimeIds(state.eventSourceTargets)
	RiderRuntime.PrepareRuntimeIds(state.riderTargets)
	if state.effectMode == "Impact" and state.driverObject and state.driverObject.Parent and state.driverId then
		state.driverObject:SetAttribute(DRIVER_ATTRIBUTE, state.driverId)
	end
end

local function restoreOriginalSetup()
	state.explosionVFXSupport.ClearPreviews()
	local restored = ObjectCaptureSnapshot.Restore(state.objectEditSnapshots)
	restored += ObjectCaptureSnapshot.Restore(state.driverEditSnapshots)
	restored += ObjectCaptureSnapshot.Restore(state.riderEditSnapshots)
	restored += state.eventSourceScope.RestoreOriginals(state.eventSourceTargets)
	return restored
end

function state.capturePreviewRestoreSnapshot()
	state.previewRestoreGeneration += 1
	state.previewRestoreSnapshots = ObjectCaptureSnapshot.Capture(state.getObjectCaptureTargets())
	return state.previewRestoreGeneration
end

function state.restorePreviewScene()
	local snapshots = state.previewRestoreSnapshots
	local generation = state.previewRestoreGeneration
	state.previewRestoreSnapshots = {}
	-- First restore the effect's authored setup, then finish with the exact
	-- editable pose that existed immediately before Preview was pressed.
	restoreOriginalSetup()
	ObjectCaptureSnapshot.Restore(snapshots)
	-- Humanoids and restored joints can settle for one frame after their parts
	-- are unanchored. A guarded second pass prevents multi-rig previews from
	-- keeping that settled offset (most visibly, rigs left inside the floor).
	task.delay(0.12, function()
		if state.previewSession == nil and state.previewRestoreGeneration == generation then
			restoreOriginalSetup()
			ObjectCaptureSnapshot.Restore(snapshots)
		end
	end)
end

local function restoreRagdollOriginal()
	if #state.rigEditSnapshots == 0 then
		return 0
	end
	if #state.rigCaptureEntries &gt; 0 then
		local restored, reboundRigs = state.multiRigRagdollSupport.RestoreOriginals(
			state.rigCaptureEntries,
			state.rigEditSnapshots,
			CAPTURE_ATTRIBUTE
		)
		state.selectedRigs = reboundRigs
		state.selectedRig = reboundRigs[1]
		state.captureId = state.rigCaptureEntries[1] and state.rigCaptureEntries[1].id or nil
		return restored
	end

	local currentRig = state.selectedRig and state.selectedRig.Parent and state.selectedRig or findRuntimeRig()
	if not currentRig then
		local snapshotTarget = state.rigEditSnapshots[1] and state.rigEditSnapshots[1].target
		local targetName = snapshotTarget and snapshotTarget.Name
		if targetName then
			for _, descendant in ipairs(workspace:GetDescendants()) do
				if descendant:IsA("Model") and descendant.Name == targetName then
					currentRig = descendant
					break
				end
			end
		end
	end
	local needsRebind = currentRig and state.rigEditSnapshots[1].target ~= currentRig
	if currentRig and not needsRebind then
		for _, item in ipairs(state.rigEditSnapshots[1].parts or {}) do
			if not (item.part and item.part.Parent) then
				needsRebind = true
				break
			end
		end
	end
	if currentRig and needsRebind then
		ObjectCaptureSnapshot.RebindModel(state.rigEditSnapshots, currentRig)
		state.selectedRig = currentRig
	end
	return ObjectCaptureSnapshot.Restore(state.rigEditSnapshots)
end

local function requestAdaptiveWalkPresets(rig)
	if state.walkPresetLoading or not (rig and rig.Parent) then
		return
	end
	state.walkPresetLoading = true
	updateUI()
	local started, startMessage = require(Modules:WaitForChild("MegMoPathBridgeClient")).Request({
		action = "GetAdaptiveWalkPresets",
		payload = {
			rig = rig,
			rigName = rig.Name,
		},
		onComplete = function(result)
			if state.selectedRig ~= rig then
				return
			end
			state.walkPresetLoading = false
			state.walkPresets = result.success and result.presets or {}
			state.walkRigType = result.success and result.rigType or nil
			state.walkPresetIndex = #state.walkPresets &gt; 0 and 1 or 0
			state.animatedPath = nil
			setStatus(result.message, result.success and THEME.green or THEME.red)
			updateUI()
		end,
	})
	if not started then
		state.walkPresetLoading = false
		state.walkPresets = {}
		state.walkPresetIndex = 0
		setStatus(startMessage, THEME.yellow)
		updateUI()
	end
end

local function cycleAdaptiveWalkPreset(direction)
	if state.effectMode ~= "AdaptiveWalk" or RunService:IsRunning() or #state.walkPresets &lt; 2 then
		return
	end
	state.walkPresetIndex = ((state.walkPresetIndex - 1 + direction) % #state.walkPresets) + 1
	state.animatedPath = nil
	state.take = nil
	state.takes = {}
	state.takeIndex = 0
	local preset = getSelectedWalkPreset()
	setStatus(string.format("Walk Style set to %s. Load the CFrame route when ready.", tostring(preset and preset.name or "Walk")), THEME.cyan)
	updateUI()
end

local function selectRig()
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	if RunService:IsRunning() then
		setStatus("Stop the current simulation before changing the capture selection.", THEME.yellow)
		updateUI()
		return
	end
	if state.captureMode == "Objects" then
		clearCaptureAttribute()
		state.selectedRig = nil
		state.selectedRigs = {}
		state.rigCaptureEntries = {}
		state.rigEditSnapshots = {}
		state.rigTakes = {}
		state.captureId = nil
		state.captureScope = SceneCaptureScope.SELECTED
		state.animatedPath = nil
		state.armed = false
		if state.effectMode == "Release" then
			local selected = Selection:Get()
			local target = #selected == 1 and selected[1] or nil
			if not (target and target.Parent and (target:IsA("BasePart") or target:IsA("Model"))) then
				state.releaseObject = nil
				state.releaseCaptureTarget = nil
				state.releaseData = nil
				refreshCaptureTargets({}, false)
				state.objectEditSnapshots = {}
				setStatus("Select exactly one animated Part or Model in Explorer, then try again.", THEME.yellow)
				updateUI()
				return
			end
			state.releaseObject = target
			state.releaseData = nil
			refreshCaptureTargets({ target }, false)
			local rootInstance = target:IsA("BasePart") and target
				or target.PrimaryPart
				or state.objectTargets[1] and state.objectTargets[1].instance
				or nil
			state.releaseCaptureTarget = {
				instance = target,
				name = target.Name,
				path = target:GetFullName(),
				rootInstance = rootInstance,
			}
			state.objectEditSnapshots = ObjectCaptureSnapshot.Capture(state.objectTargets)
			state.take = nil
			state.takes = {}
			state.takeIndex = 0
			setStatus(
				#state.objectTargets &gt; 0
					and string.format("Prepared %s. Put 7kg2's playhead on its Detach event, then load the release state.", target.Name)
					or "The selected release object does not contain any capturable parts.",
				#state.objectTargets &gt; 0 and THEME.green or THEME.yellow
			)
			updateUI()
			return
		end
		refreshCaptureTargets(Selection:Get(), false)
		state.objectEditSnapshots = ObjectCaptureSnapshot.Capture(state.objectTargets)
		if state.isEventMode() then
			state.eventTestCompleted = false
		end
		setStatus(
			#state.objectTargets &gt; 0
				and string.format("Prepared %d selected object%s. They will be unanchored only during the simulation.", #state.objectTargets, #state.objectTargets == 1 and "" or "s")
				or "Select the ball or other loose objects in Explorer, then refresh the selection.",
			#state.objectTargets &gt; 0 and THEME.green or THEME.yellow
		)
		updateUI()
		return
	end
	if state.effectMode == "Character" then
		local rigs = state.findSelectedRigs()
		if #rigs == 0 then
			for _, existingRig in ipairs(state.selectedRigs) do
				if existingRig and existingRig.Parent then
					table.insert(rigs, existingRig)
				end
			end
		end
		if #rigs == 0 then
			setStatus("Select one or more humanoid Motor6D rigs, or body parts inside them, in Explorer.", THEME.yellow)
			updateUI()
			return
		end
		local duplicateName = state.multiRigRagdollSupport.FindDuplicateName(rigs)
		local rigsChanged = not state.multiRigRagdollSupport.SameRigs(state.selectedRigs, rigs)
		clearCaptureAttribute()
		SceneCaptureScope.ClearRuntimeIds(state.objectTargets)
		state.selectedRigs = rigs
		state.selectedRig = rigs[1]
		if rigsChanged or #state.rigEditSnapshots ~= #rigs then
			state.rigEditSnapshots = state.multiRigRagdollSupport.CaptureSnapshots(rigs)
		end
		if rigsChanged then
			state.clearStartingPush()
		end
		state.captureScope = SceneCaptureScope.RIG_ONLY
		state.objectTargets = {}
		state.objectEditSnapshots = {}
		state.animatedPath = nil
		state.take = nil
		state.rigTakes = {}
		state.takes = {}
		state.takeIndex = 0
		state.rigCaptureEntries = state.multiRigRagdollSupport.PrepareCaptureEntries(rigs, CAPTURE_ATTRIBUTE)
		state.captureId = state.rigCaptureEntries[1] and state.rigCaptureEntries[1].id or nil
		state.armed = false
		setStatus(
			#rigs == 1
				and string.format("Prepared %s for ragdoll capture.", rigs[1].Name)
				or duplicateName
					and string.format("Prepared %d characters. Same-named rigs were assigned hidden capture IDs.", #rigs)
				or string.format("Prepared %d characters for one synchronized ragdoll capture.", #rigs),
			THEME.green
		)
		state.refreshWorkflowUX()
		updateUI()
		return
	end

	local rig = findSelectedRig() or (state.selectedRig and state.selectedRig.Parent and state.selectedRig)
	if not rig then
		setStatus("Select a humanoid Motor6D rig or one of its body parts in Explorer.", THEME.yellow)
		updateUI()
		return
	end
	local rigChanged = state.selectedRig ~= rig
	clearCaptureAttribute()
	state.selectedRigs = {}
	state.rigCaptureEntries = {}
	state.rigTakes = {}
	state.selectedRig = rig
	state.rigEditSnapshots = {}
	if rigChanged then
		state.animatedPath = nil
		state.walkPresets = {}
		state.walkPresetIndex = 0
		state.walkPresetLoading = false
		state.walkRigType = nil
		state.take = nil
		state.rigTakes = {}
		state.takes = {}
		state.takeIndex = 0
	end
	state.captureId = HttpService:GenerateGUID(false)
	rig:SetAttribute(CAPTURE_ATTRIBUTE, state.captureId)
	state.armed = false
	refreshCaptureTargets(Selection:Get(), false)
	setStatus(
		state.effectMode == "AdaptiveWalk"
			and "Rig selected. Loading its compatible Walk Styles from 7kg2..."
			or "Rig and capture targets refreshed. Arm the capture, then start Run mode.",
		THEME.green
	)
	updateUI()
	if state.effectMode == "AdaptiveWalk" and (rigChanged or #state.walkPresets == 0) then
		requestAdaptiveWalkPresets(rig)
	end
end

local function selectImpactDriver()
	if RunService:IsRunning() then
		setStatus("Stop the simulation before changing the Moving Object.", THEME.yellow)
		return
	end
	local driver = nil
	for _, selected in ipairs(Selection:Get()) do
		if selected:IsA("BasePart") or selected:IsA("Model") then
			driver = selected
			break
		end
	end
	if not driver then
		setStatus("Select the animated ball, Part, or Model in Explorer first.", THEME.yellow)
		return
	end
	clearDriverAttribute()
	RiderRuntime.ClearRuntimeIds(state.riderTargets)
	state.driverObject = driver
	state.driverId = HttpService:GenerateGUID(false)
	state.driverCaptureTarget = PhysicsDriveRuntime.MakeEditDescriptor(driver, state.driverId)
	state.driverEditSnapshots = ObjectCaptureSnapshot.Capture({ state.driverCaptureTarget })
	state.riderTargets = {}
	state.riderEditSnapshots = {}
	state.animatedPath = nil
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(
		state.movingObjectMode == "PhysicsDrive"
			and "Moving Object set. Leave ramps anchored and unselected; selecting other loose objects is optional."
			or "Moving Object set. Now select the loose bricks and confirm the physics objects.",
		THEME.green
	)
	updateUI()
end

local function selectImpactRiders()
	if RunService:IsRunning() then
		setStatus("Stop the simulation before changing riders.", THEME.yellow)
		return
	end
	if state.movingObjectMode ~= "PhysicsDrive" then
		setStatus("Riders are available with Physics Drive.", THEME.yellow)
		return
	end
	if not (state.driverObject and state.driverObject.Parent) then
		setStatus("Set the Moving Object before adding riders.", THEME.yellow)
		return
	end
	local riders = RiderRuntime.CollectSelection(Selection:Get(), state.driverObject)
	if #riders == 0 then
		if #state.riderTargets &gt; 0 and #Selection:Get() == 0 then
			RiderRuntime.ClearRuntimeIds(state.riderTargets)
			state.riderTargets = {}
			state.riderEditSnapshots = {}
			setStatus("Riders cleared.", THEME.muted)
		else
			setStatus("Select one or more character rigs in Explorer, then click Use Selected Riders.", THEME.yellow)
		end
		updateUI()
		return
	end
	RiderRuntime.ClearRuntimeIds(state.riderTargets)
	state.riderTargets = riders
	state.riderEditSnapshots = ObjectCaptureSnapshot.Capture(riders)
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(string.format(
		"Prepared %d rider%s. Their current position relative to the Moving Object will be preserved.",
		#riders,
		#riders == 1 and "" or "s"
	), THEME.green)
	updateUI()
end

local function selectImpactTargets()
	if not (state.driverObject and state.driverObject.Parent) then
		setStatus("Set the Moving Object before selecting physics objects.", THEME.yellow)
		return
	end
	state.captureScope = SceneCaptureScope.SELECTED
	refreshCaptureTargets(Selection:Get(), false)
	local anchoredCount = 0
	for _, descriptor in ipairs(state.objectTargets) do
		local part = descriptor.instance or descriptor.part
		if part and part.Parent and part:IsA("BasePart") and part.Anchored then
			anchoredCount += 1
		end
	end
	state.objectEditSnapshots = ObjectCaptureSnapshot.Capture(state.objectTargets)
	setStatus(
		#state.objectTargets &gt; 0
			and string.format(
				"Prepared %d loose physics object%s.%s Load the Moving Object's 7kg2 path next.",
				#state.objectTargets,
				#state.objectTargets == 1 and "" or "s",
				anchoredCount &gt; 0 and string.format(
					" %d anchored part%s will be temporarily released on impact and restored afterward.",
					anchoredCount,
					anchoredCount == 1 and "" or "s"
				) or ""
			)
			or (state.movingObjectMode == "PhysicsDrive"
				and "No loose objects selected. Unselected anchored ramps will remain static collision geometry."
				or "Select only the loose bricks, then click Use Selected Physics Objects."),
		(#state.objectTargets &gt; 0 or state.movingObjectMode == "PhysicsDrive") and THEME.green or THEME.yellow
	)
	updateUI()
end

function state.eventActions.SetSource()
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	if state.effectMode == "Explosion" then
		if #state.objectTargets == 0 then
			setStatus("Select the objects or characters that should react before placing the explosion.", THEME.yellow)
			updateUI()
			return
		end
		if state.eventSourcePosition
			and state.eventSourceInstance
			and state.eventSourceInstance.Parent then
			projectilePathUX:BeginPlacement("Explosion")
			setStatus("Click a visible surface to move the Blast Origin, or press Escape to keep its current position.", THEME.yellow)
			updateUI()
			return
		end

		local minimum, maximum = SceneCaptureScope.GetDescriptorsBounds(state.objectTargets)
		local center = minimum and maximum and (minimum + maximum) * 0.5 or nil
		if not center then
			setStatus("Could not find the selected objects' visible bounds. Select them again, then press Blast Origin.", THEME.yellow)
			updateUI()
			return
		end
		local sourceTarget = nil
		for _, descriptor in ipairs(state.objectTargets) do
			local part = descriptor.part or descriptor.instance
			if part and part.Parent and part:IsA("BasePart") then
				sourceTarget = part
				break
			end
		end
		state.onExplosionPointPlaced(center, sourceTarget)
		setStatus("Blast Origin placed at the centre of the affected objects. Drag its arrows to fine-tune it, or press Blast Origin again to click a new position.", THEME.green)
		updateUI()
		return
	end
	local source = nil
	local position = nil
	local direction = Vector3.zAxis
	for _, selected in ipairs(Selection:Get()) do
		if selected:IsA("Attachment") and state.effectMode ~= "Projectile" then
			source = selected
			position = selected.WorldPosition
			direction = selected.WorldCFrame.LookVector
			break
		elseif selected:IsA("BasePart") then
			source = selected
			position = selected.Position
			direction = selected.CFrame.LookVector
			break
		elseif selected:IsA("Model") then
			source = selected
			direction = selected:GetPivot().LookVector
			-- A Model's WorldPivot can be stale or intentionally offset hundreds of
			-- studs from its visible geometry.  Using it as the blast point makes the
			-- event miss every selected part and fall back to pushing only one piece.
			-- Resolve the visible bounds centre instead, matching the placement logic
			-- already used by the other Physics workflows.
			position = SceneCaptureScope.GetInstanceCenter(selected)
			break
		end
	end
	if not source then
		setStatus(
			state.effectMode == "Projectile"
				and "Select the projectile Part or Model in Explorer first."
				or "Select a Part, Model, or Attachment to use as the event point.",
			THEME.yellow
		)
		return
	end
	if state.effectMode == "Projectile" then
		local descriptor, descriptorMessage = state.eventSourceScope.Upsert(state.eventSourceTargets, source)
		if not descriptor then
			setStatus(descriptorMessage, THEME.yellow)
			return
		end
		state.eventSourceDescriptor = descriptor
		for index = #state.objectTargets, 1, -1 do
			local target = state.objectTargets[index].instance
			if target == descriptor.instance
				or (descriptor.instance:IsA("Model") and target and target:IsDescendantOf(descriptor.instance)) then
				table.remove(state.objectTargets, index)
			end
		end
	else
		state.eventSourceDescriptor = nil
	end
	state.eventSourceInstance = source
	state.eventSourcePosition = position
	state.eventSourceDirection = direction.Magnitude &gt; 0.001 and direction.Unit or Vector3.zAxis
	state.eventSourceDirectionManual = false
	state.eventTestCompleted = false
	state.eventProjectileStart = nil
	state.eventProjectileEnd = nil
	projectilePathUX:Clear()
	state.refreshWorkflowUX()
	setStatus(
		state.effectMode == "Projectile"
			and string.format("Projectile set to %s. Place its Start and Impact points next.", source.Name)
			or string.format("Blast Origin set from %s. Choose the reaction, direction, and power.", source.Name),
		THEME.green
	)
	updateUI()
end

function state.onExplosionPointPlaced(position, target)
	if state.effectMode ~= "Explosion" or typeof(position) ~= "Vector3" then
		return
	end
	-- Adorn the selected physics object rather than a large clicked floor or
	-- wall. The guide can still render at the exact world-space click position,
	-- while avoiding a distracting outline around the whole environment.
	local source = nil
	for _, descriptor in ipairs(state.objectTargets) do
		local part = descriptor.part or descriptor.instance
		if part and part.Parent and part:IsA("BasePart") then
			source = part
			break
		end
	end
	if not source then
		source = target and target.Parent and target:IsA("BasePart") and target or nil
	end
	if not source then
		setStatus("Could not place the Blast Origin there. Click a visible surface in the viewport.", THEME.yellow)
		updateUI()
		return
	end

	state.eventSourceInstance = source
	state.eventSourceDescriptor = nil
	state.eventSourcePosition = position
	local targetCenter = SceneCaptureScope.GetDescriptorsCenter(state.objectTargets)
	local direction = targetCenter and (targetCenter - position) or source.CFrame.LookVector
	state.eventSourceDirection = direction.Magnitude &gt; 0.05 and direction.Unit or source.CFrame.LookVector
	state.eventSourceDirectionManual = false
	state.invalidateExplosionTestCache()
	state.eventTestCompleted = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.eventActions.SyncSingleQueuedEvent()
	state.refreshWorkflowUX()
	setStatus("Blast Origin placed. Choose the reaction, direction, and power, then test it.", THEME.green)
	updateUI()
end

function state.onExplosionPointChanged(position)
	if RunService:IsRunning()
		or state.effectMode ~= "Explosion"
		or typeof(position) ~= "Vector3"
		or not (state.eventSourceInstance and state.eventSourceInstance.Parent) then
		return
	end
	state.eventSourcePosition = position
	if not state.eventSourceDirectionManual then
		local targetCenter = SceneCaptureScope.GetDescriptorsCenter(state.objectTargets)
		local direction = targetCenter and (targetCenter - position) or state.eventSourceDirection
		if direction.Magnitude &gt; 0.05 then
			state.eventSourceDirection = direction.Unit
		end
	end
	state.invalidateExplosionTestCache()
	state.eventTestCompleted = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.eventActions.SyncSingleQueuedEvent()
	state.refreshBlastGuide()
end

function state.onExplosionDirectionChanged(direction, finished)
	if RunService:IsRunning()
		or state.effectMode ~= "Explosion"
		or typeof(direction) ~= "Vector3"
		or direction.Magnitude &lt;= 0.001 then
		return
	end
	state.eventSourceDirection = direction.Unit
	state.eventSourceDirectionManual = true
	state.invalidateExplosionTestCache()
	state.eventTestCompleted = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.eventActions.SyncSingleQueuedEvent()
	if finished then
		setStatus("Forward blast direction updated. The cyan arrow shows the direction the blast will travel.", THEME.green)
		updateUI()
	end
end

function state.onProjectilePointChanged(kind, position)
	if kind == "Start" then
		state.eventProjectileStart = position
	else
		state.eventProjectileEnd = position
	end
	updateUI()
end

function state.onProjectilePointPlaced(kind, position)
	state.onProjectilePointChanged(kind, position)
	state.refreshWorkflowUX()
	setStatus(
		kind == "Start"
			and "Start placed. Drag its cyan handles to refine it, then place Impact."
			or "Impact placed. Drag its orange handles to refine it, then add the timed event.",
		kind == "Start" and THEME.cyan or Color3.fromRGB(255, 116, 62)
	)
end

function state.eventActions.PlaceProjectilePoint(kind)
	if RunService:IsRunning() or state.effectMode ~= "Projectile" then
		return
	end
	if not (state.eventSourceDescriptor and state.eventSourceInstance and state.eventSourceInstance.Parent) then
		setStatus("Set the Projectile Object before placing its path.", THEME.yellow)
		return
	end
	local position = kind == "Start"
		and SceneCaptureScope.GetInstanceCenter(state.eventSourceInstance)
		or SceneCaptureScope.GetDescriptorsCenter(state.objectTargets)
	if not position then
		setStatus(
			kind == "Start"
				and "The projectile has no visible parts to center the Start point on."
				or "Select the affected objects before placing the Impact point.",
			THEME.yellow
		)
		return
	end
	state.onProjectilePointPlaced(kind, position)
	state.refreshWorkflowUX()
end

function state.eventActions.ChangeTime(delta)
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	state.eventTime = math.clamp(math.round((state.eventTime + delta) * 100) / 100, 0, state.maxDuration)
	if state.effectMode == "Explosion" then
		state.invalidateExplosionTestCache()
	end
	state.eventTestCompleted = false
	updateUI()
end

function state.eventActions.CycleStrength()
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	local strengths = { "Light", "Medium", "Heavy" }
	local powers = {
		Light = 25,
		Medium = 50,
		Heavy = 100,
	}
	if state.eventStrength == "Custom" then
		if state.eventPower &lt; 25 then
			state.eventStrength = "Light"
		elseif state.eventPower &lt; 50 then
			state.eventStrength = "Medium"
		elseif state.eventPower &lt; 100 then
			state.eventStrength = "Heavy"
		else
			state.eventStrength = "Light"
		end
	else
		local index = table.find(strengths, state.eventStrength) or 1
		state.eventStrength = strengths[index % #strengths + 1]
	end
	state.eventPower = powers[state.eventStrength]
	if state.effectMode == "Explosion" then
		state.invalidateExplosionTestCache()
	end
	state.eventActions.SyncSingleQueuedEvent()
	state.eventTestCompleted = false
	state.refreshBlastGuide()
	updateUI()
end

function state.eventActions.SetPower(power)
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	local resolvedPower = math.clamp(math.round(tonumber(power) or state.eventPower), 10, 100)
	if resolvedPower == state.eventPower then
		return
	end
	state.eventPower = resolvedPower
	if state.effectMode == "Explosion" then
		state.invalidateExplosionTestCache()
	end
	state.eventTestCompleted = false
	if state.eventPower == 25 then
		state.eventStrength = "Light"
	elseif state.eventPower == 50 then
		state.eventStrength = "Medium"
	elseif state.eventPower == 100 then
		state.eventStrength = "Heavy"
	else
		state.eventStrength = "Custom"
	end
	state.eventActions.SyncSingleQueuedEvent()
	state.refreshBlastGuide()
	updateUI()
end

function state.eventActions.SetPowerFromScreenX(screenX)
	if not (refs.eventPowerTrack and refs.eventPowerTrack.AbsoluteSize.X &gt; 0) then
		return
	end
	local alpha = math.clamp(
		(screenX - refs.eventPowerTrack.AbsolutePosition.X) / refs.eventPowerTrack.AbsoluteSize.X,
		0,
		1
	)
	state.eventActions.SetPower(10 + alpha * 90)
end

function state.eventActions.BeginPowerDrag(input)
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	state.eventPowerDragging = true
	if refs.eventPowerDragCapture then
		refs.eventPowerDragCapture.Visible = true
	end
	state.eventActions.SetPowerFromScreenX(input.Position.X)
end

function state.eventActions.ContinuePowerDrag(screenX)
	if state.eventPowerDragging then
		state.eventActions.SetPowerFromScreenX(screenX)
	end
end

function state.eventActions.EndPowerDrag(input)
	if input
		and input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	state.eventPowerDragging = false
	if refs.eventPowerDragCapture then
		refs.eventPowerDragCapture.Visible = false
	end
end

function state.eventActions.SetReaction(reaction)
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	if reaction ~= "Push" and reaction ~= "Ragdoll" and reaction ~= "BreakApart" then
		return
	end
	if reaction == "Ragdoll" and not SceneCaptureScope.HasSupportedRagdollRig(state.objectTargets) then
		setStatus("Ragdoll only works when the affected selection includes an R6 or R15 rig.", THEME.yellow)
		updateUI()
		return
	end
	if state.eventReaction == reaction then
		return
	end
	state.eventReaction = reaction
	if state.effectMode == "Explosion" then
		state.invalidateExplosionTestCache()
	end
	state.eventActions.SyncSingleQueuedEvent()
	state.eventTestCompleted = false
	updateUI()
end

function state.eventActions.RefreshSourceDirection()
	if state.effectMode == "Explosion" and state.eventSourcePosition then
		return state.eventSourceDirection
	end
	local source = state.eventSourceInstance
	if not (source and source.Parent) then
		return state.eventSourceDirection
	end
	local direction = nil
	if source:IsA("Attachment") then
		direction = source.WorldCFrame.LookVector
	elseif source:IsA("BasePart") then
		direction = source.CFrame.LookVector
	elseif source:IsA("Model") then
		direction = source:GetPivot().LookVector
	end
	if direction and direction.Magnitude &gt; 0.001 then
		state.eventSourceDirection = direction.Unit
	end
	return state.eventSourceDirection
end

function state.eventActions.CycleDirection()
	if RunService:IsRunning() or state.effectMode ~= "Explosion" then
		return
	end
	if state.eventDirectionMode == "Outward" then
		state.eventDirectionMode = "Upward"
	elseif state.eventDirectionMode == "Upward" then
		state.eventDirectionMode = "Forward"
	else
		state.eventDirectionMode = "Outward"
	end
	state.invalidateExplosionTestCache()
	state.eventActions.RefreshSourceDirection()
	state.eventActions.SyncSingleQueuedEvent()
	state.eventTestCompleted = false
	setStatus(
		state.eventDirectionMode == "Forward"
			and "Forward blast selected. Drag the cyan rotation rings around the Blast Origin to aim it."
			or string.format("%s blast direction selected.", state.eventDirectionMode),
		THEME.cyan
	)
	-- Direction mode changes affect the Physics-owned viewport guide as well as
	-- the panel text. Refresh it immediately so entering Forward mode reveals
	-- the cyan aim arrow and rotation rings without requiring another UI action.
	state.refreshWorkflowUX()
	updateUI()
end

function state.eventActions.CycleSlowMotion()
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	if state.effectMode == "Explosion" then
		state.eventPlaybackSpeed = state.playbackSpeedSupport.Next(state.eventPlaybackSpeed)
	else
		state.eventSlowMotion = not state.eventSlowMotion
	end
	state.eventActions.SyncSingleQueuedEvent()
	state.eventTestCompleted = false
	if state.effectMode == "Explosion" then
		local cache = state.explosionTestCache
		local hasReusableTest = cache
			and cache.revision == state.explosionTestSetupRevision
			and cache.take
			and type(cache.take.samples) == "table"
			and #cache.take.samples &gt;= 2
		setStatus(
			hasReusableTest
				and string.format(
					"Explosion speed set to %d%%. Press Test Explosion to replay the cached physics immediately; Capture and Bake will also use this speed.",
					math.round(state.eventPlaybackSpeed * 100)
				)
				or state.eventPlaybackSpeed &gt; 1 and state.explosionVFXSource
				and string.format(
					"Explosion speed set to %d%%. Test will calculate, then replay at this speed; Capture and Bake will also use it. Roblox caps optional particle VFX at its authored 100%% speed.",
					math.round(state.eventPlaybackSpeed * 100)
				)
				or string.format(
					"Explosion speed set to %d%%. Test will calculate, then replay at this speed; Capture and Bake will also use it.",
					math.round(state.eventPlaybackSpeed * 100)
				),
			THEME.cyan
		)
	end
	updateUI()
end

function state.eventActions.SelectExplosionVFX()
	if RunService:IsRunning() or state.effectMode ~= "Explosion" then
		return
	end
	local selection = Selection:Get()
	local source, emitterCount, emitCount, message = state.explosionVFXSupport.FindSelectedSource(selection)
	if not source then
		if #selection == 0 and state.explosionVFXSource then
			state.explosionVFXSource = nil
			state.explosionVFXSourceDescriptor = nil
			state.explosionVFXEmitCount = nil
			state.invalidateExplosionTestCache()
			state.eventActions.SyncSingleQueuedEvent()
			state.eventTestCompleted = false
			state.take = nil
			state.rigTakes = {}
			state.takes = {}
			state.takeIndex = 0
			setStatus("Optional Explosion VFX cleared.", THEME.muted)
			updateUI()
			return
		end
		setStatus(message, THEME.yellow)
		updateUI()
		return
	end

	state.explosionVFXSource = source
	state.explosionVFXSourceDescriptor = state.explosionVFXSupport.DescribeSource(source)
	state.explosionVFXEmitCount = emitCount
	state.invalidateExplosionTestCache()
	state.eventActions.SyncSingleQueuedEvent()
	state.eventTestCompleted = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(string.format(
		"Explosion VFX set to %s with %d emitter%s. Test Explosion will preview it at the Blast Origin.",
		source.Name,
		emitterCount,
		emitterCount == 1 and "" or "s"
	), THEME.green)
	updateUI()
end

function state.eventActions.SyncSingleQueuedEvent()
	if #state.eventMarkers ~= 1 then
		return
	end
	if state.effectMode == "Explosion" then
		state.eventPlaybackSpeed = 1
	end
	local marker = state.eventMarkers[1]
	if marker.kind ~= state.effectMode then
		return
	end
	marker.strength = state.eventStrength
	marker.power = state.eventPower
	marker.reaction = state.eventReaction
	marker.directionMode = state.eventDirectionMode
	marker.directionVector = state.eventActions.RefreshSourceDirection()
	marker.playbackSpeed = state.effectMode == "Explosion" and 1 or nil
	marker.slowMotion = state.effectMode == "Explosion"
		and 1
		or state.eventSlowMotion and 2
		or 1
	if state.effectMode == "Explosion" and state.eventSourcePosition then
		state.explosionVFXSource = state.explosionVFXSupport.ResolveSource(
			state.explosionVFXSource,
			state.explosionVFXSourceDescriptor
		)
		marker.position = state.eventSourcePosition
		marker.sourceName = "Blast Origin"
		marker.vfxSource = state.explosionVFXSource
		marker.vfxSourceDescriptor = state.explosionVFXSourceDescriptor
		marker.vfxSourceName = state.explosionVFXSource and state.explosionVFXSource.Name or nil
		marker.vfxEmitCount = state.explosionVFXEmitCount
	end
end

function state.eventActions.Add()
	if RunService:IsRunning() or not state.isEventMode() then
		return
	end
	if state.effectMode == "Explosion" then
		state.explosionVFXSource = state.explosionVFXSupport.ResolveSource(
			state.explosionVFXSource,
			state.explosionVFXSourceDescriptor
		)
	end
	if #state.objectTargets == 0 then
		setStatus("Select the affected objects before adding an event.", THEME.yellow)
		return
	end
	if not (state.eventSourceInstance and state.eventSourceInstance.Parent and state.eventSourcePosition) then
		setStatus(
			state.effectMode == "Projectile"
				and "Set the Projectile Object from a selected Part or Model first."
				or "Set the Blast Origin first.",
			THEME.yellow
		)
		return
	end
	if state.effectMode == "Projectile"
		and (not state.eventProjectileStart or not state.eventProjectileEnd) then
		setStatus("Place both the projectile Start and Impact points first.", THEME.yellow)
		return
	end
	state.eventActions.RefreshSourceDirection()
	table.insert(state.eventMarkers, {
		id = HttpService:GenerateGUID(false),
		kind = state.effectMode,
		time = state.effectMode == "Explosion" and 0 or state.eventTime,
		position = state.effectMode == "Projectile" and state.eventProjectileStart or state.eventSourcePosition,
		startPosition = state.effectMode == "Projectile" and state.eventProjectileStart or nil,
		endPosition = state.effectMode == "Projectile" and state.eventProjectileEnd or nil,
		strength = state.eventStrength,
		power = state.eventPower,
		reaction = state.eventReaction,
		directionMode = state.eventDirectionMode,
		directionVector = state.eventSourceDirection,
		playbackSpeed = state.effectMode == "Explosion" and 1 or nil,
		slowMotion = state.effectMode == "Explosion"
			and 1
			or state.eventSlowMotion and 2
			or 1,
		sourceName = state.eventSourceInstance.Name,
		sourceId = state.eventSourceDescriptor and state.eventSourceDescriptor.id or nil,
		vfxSource = state.effectMode == "Explosion" and state.explosionVFXSource or nil,
		vfxSourceDescriptor = state.effectMode == "Explosion" and state.explosionVFXSourceDescriptor or nil,
		vfxSourceName = state.effectMode == "Explosion"
			and state.explosionVFXSource
			and state.explosionVFXSource.Name
			or nil,
		vfxEmitCount = state.effectMode == "Explosion" and state.explosionVFXEmitCount or nil,
	})
	if state.effectMode == "Explosion" then
		state.invalidateExplosionTestCache()
	end
	state.eventTestCompleted = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(
		state.effectMode == "Explosion"
			and "Explosion prepared at the start of the simulation. Test it before continuing to Capture."
			or string.format(
				"Added a projectile hit at %.2fs. Change the point or time to add another event to this take.",
				state.eventTime
			),
		THEME.green
	)
	updateUI()
end

function state.eventActions.RemoveLast()
	if RunService:IsRunning() or not state.isEventMode() or #state.eventMarkers == 0 then
		return
	end
	table.remove(state.eventMarkers)
	if state.effectMode == "Explosion" then
		state.invalidateExplosionTestCache()
	end
	state.eventTestCompleted = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	setStatus(string.format("Removed the last event. %d event%s remain.", #state.eventMarkers, #state.eventMarkers == 1 and "" or "s"), THEME.muted)
	updateUI()
end

local function chooseEffectMode(effectMode)
	if RunService:IsRunning() then
		setStatus("Finish the current simulation before choosing another effect.", THEME.yellow)
		return
	end
	if state.effectMode == effectMode then
		setStatus("Effect selected. Follow the highlighted next step.", THEME.cyan)
		updateUI()
		return
	end
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	restoreAdaptiveWalkOriginal()

	SceneCaptureScope.ClearRuntimeIds(state.objectTargets)
	state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets)
	clearCaptureAttribute()
	clearDriverAttribute()
	state.effectMode = effectMode
	state.invalidateExplosionTestCache()
	state.eventSourceInstance = nil
	state.eventSourcePosition = nil
	state.eventSourceDirection = Vector3.zAxis
	state.eventSourceDirectionManual = false
	state.eventSourceDescriptor = nil
	state.eventSourceTargets = {}
	state.eventProjectileStart = nil
	state.eventProjectileEnd = nil
	projectilePathUX:Clear()
	state.clearStartingPush()
	state.ragdollMode = "Fall"
	state.eventMarkers = {}
	state.eventTime = effectMode == "Explosion" and 0 or 0.5
	state.eventStrength = "Medium"
	state.eventPower = 50
	state.eventPowerDragging = false
	state.eventSlowMotion = false
	state.eventPlaybackSpeed = 1
	state.eventReaction = "Push"
	state.eventDirectionMode = "Outward"
	state.explosionVFXSupport.ClearPreviews()
	state.explosionVFXSource = nil
	state.explosionVFXSourceDescriptor = nil
	state.explosionVFXEmitCount = nil
	state.eventSession = nil
	if state.eventTestLivePreviewSession then
		TakePreviewRuntime.Stop(state.eventTestLivePreviewSession, false)
		state.eventTestLivePreviewSession = nil
	end
	state.eventTestLiveCaptureComplete = false
	state.eventLivePreviewPurpose = nil
	state.eventCapturedTakeRetimed = false
	state.eventTestMode = false
	state.eventSpeedPreviewMode = false
	state.eventTestCompleted = false
	state.eventTestSettledDuration = 0
	state.restoreEventTestRuntimeTargets()
	state.selectedRig = nil
	state.selectedRigs = {}
	state.rigCaptureEntries = {}
	state.rigEditSnapshots = {}
	state.driverObject = nil
	state.driverId = nil
	state.driverEditSnapshots = {}
	state.driverCaptureTarget = nil
	state.riderTargets = {}
	state.riderEditSnapshots = {}
	state.riderRuntimeSession = nil
	state.movingObjectMode = "PhysicsDrive"
	state.keepUpright = false
	state.captureId = nil
	state.objectTargets = {}
	state.objectEditSnapshots = {}
	state.releaseObject = nil
	state.releaseCaptureTarget = nil
	state.releaseData = nil
	state.releaseCollisionsEnabled = true
	state.animatedPath = nil
	state.adaptiveWalkSession = nil
	state.adaptiveWalkRestoreSession = nil
	state.adaptiveWalkComplete = false
	state.walkPresets = {}
	state.walkPresetIndex = 0
	state.walkPresetLoading = false
	state.walkRigType = nil
	state.armed = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0

	if effectMode == "Drop" or effectMode == "Scene" or effectMode == "Release" or state.isEventMode(effectMode) then
		state.captureMode = "Objects"
		state.captureScope = SceneCaptureScope.SELECTED
		state.pathMode = "Handoff"
		state.impactBreak = false
		state.autoRagdoll = false
	elseif effectMode == "Character" then
		state.captureMode = "Rig"
		state.captureScope = SceneCaptureScope.RIG_ONLY
		state.pathMode = "Handoff"
		state.impactBreak = false
		state.autoRagdoll = true
	elseif effectMode == "AdaptiveWalk" then
		state.captureMode = "Rig"
		state.captureScope = SceneCaptureScope.RIG_ONLY
		state.pathMode = "DrivenImpact"
		state.impactBreak = false
		state.autoRagdoll = false
	else
		state.captureMode = "Objects"
		state.captureScope = SceneCaptureScope.SELECTED
		state.pathMode = "DrivenImpact"
		state.impactBreak = true
		state.autoRagdoll = false
	end

	state.refreshWorkflowUX()
	setStatus("Effect selected. Follow the highlighted next step.", THEME.cyan)
	updateUI()
end

local function loadAnimatedPath(onFinished)
	if state.pathLoading then
		return
	end
	if RunService:IsRunning() then
		setStatus("Stop Run mode before loading an animated path.", THEME.yellow)
		return
	end
	if state.captureMode == "Objects" and state.effectMode ~= "Impact" and state.effectMode ~= "Release" then
		setStatus("Object-only capture uses runtime physics directly and does not need an animated rig path.", THEME.muted)
		return
	end
	if state.effectMode == "Release" and state.releaseData then
		state.releaseData = nil
		state.take = nil
		state.rigTakes = {}
		state.takes = {}
		state.takeIndex = 0
		setStatus("Release state cleared. Place the playhead on the Detach event and load it again when ready.", THEME.muted)
		updateUI()
		return
	end
	if state.animatedPath then
		state.animatedPath = nil
		setStatus(
			state.effectMode == "AdaptiveWalk"
				and "Adaptive walk path cleared. Load it again before previewing terrain adaptation."
				or "Animated path cleared. Capture will begin directly in physics mode.",
			THEME.muted
		)
		updateUI()
		return
	end
	if state.effectMode == "Impact" and not (state.driverObject and state.driverObject.Parent) then
		setStatus("Set the Moving Object before loading its 7kg2 path.", THEME.yellow)
		return
	elseif state.effectMode ~= "Impact"
		and state.effectMode ~= "Release"
		and not (state.selectedRig and state.selectedRig.Parent) then
		selectRig()
		if not state.selectedRig then
			return
		end
	end
	local walkPreset = getSelectedWalkPreset()
	if state.effectMode == "AdaptiveWalk" and not walkPreset then
		requestAdaptiveWalkPresets(state.selectedRig)
		setStatus("Choose a Walk Style after 7kg2 loads the compatible presets.", THEME.yellow)
		return
	end
	local requestedAction = state.effectMode == "Release"
		and "LoadObjectRelease"
		or state.effectMode == "Impact"
		and "LoadObjectPath"
		or state.effectMode == "AdaptiveWalk" and "LoadAdaptiveWalkPath"
		or "LoadAnimatedPath"
	state.pathLoading = true
	setStatus(
		state.effectMode == "Release"
			and "Loading the exact Detach frame and inherited motion from 7kg2..."
			or state.effectMode == "AdaptiveWalk"
			and string.format("Combining the full CFrame route with %s...", tostring(walkPreset.name or "the selected Walk Style"))
			or "Loading the animated path from 7kg2's current playhead...",
		THEME.cyan
	)
	updateUI()
	local started, startMessage = require(Modules:WaitForChild("MegMoPathBridgeClient")).Request({
		action = requestedAction,
		payload = {
			rig = state.selectedRig,
			rigName = state.selectedRig and state.selectedRig.Name or nil,
			driver = state.effectMode == "Release" and state.releaseObject or state.driverObject,
			pathMode = state.pathMode,
			presetId = walkPreset and walkPreset.id or nil,
		},
		onComplete = function(result)
			state.pathLoading = false
			if result.action == "LoadObjectRelease" then
				state.releaseData = result.success and result.releaseData or nil
				if state.releaseData and state.releaseData.target and state.releaseData.target.Parent then
					state.releaseObject = state.releaseData.target
					refreshCaptureTargets({ state.releaseObject }, false)
					state.releaseCaptureTarget = {
						instance = state.releaseObject,
						name = state.releaseObject.Name,
						path = state.releaseObject:GetFullName(),
						rootInstance = state.releaseObject:IsA("BasePart") and state.releaseObject
							or state.releaseObject.PrimaryPart
							or state.objectTargets[1] and state.objectTargets[1].instance
							or nil,
					}
					state.objectEditSnapshots = ObjectCaptureSnapshot.Capture(state.objectTargets)
				end
			else
				state.animatedPath = result.success and result.pathData or nil
			end
			state.take = nil
			state.takes = {}
			state.takeIndex = 0
			setStatus(result.message, result.success and THEME.green or THEME.red)
			updateUI()
			if type(onFinished) == "function" then
				onFinished(result.success == true, result)
			end
		end,
	})
	if not started then
		state.pathLoading = false
		setStatus(startMessage, THEME.yellow)
		updateUI()
		if type(onFinished) == "function" then
			onFinished(false, {
				success = false,
				message = startMessage,
			})
		end
	end
end

local function finishRuntimeCapture(reason)
	local completedTake = nil
	local completedRigTakes = {}
	local completedAdaptiveWalkSession = state.adaptiveWalkSession
	if state.ragdollCapture then
		completedRigTakes = state.multiRigRagdollSupport.StopRecorders(state.ragdollCapture)
		completedTake = completedRigTakes[1]
	elseif state.recorder then
		completedTake = state.recorder:Stop()
	end
	if state.pathSession then
		AnimatedPathRuntime.Cancel(state.pathSession)
	end
	if completedAdaptiveWalkSession then
		AdaptiveWalkRuntime.Cancel(completedAdaptiveWalkSession)
		state.adaptiveWalkRestoreSession = completedAdaptiveWalkSession
	end
	if state.heldPathSession then
		AnimatedPathRuntime.Cancel(state.heldPathSession)
	end
	if state.riderRuntimeSession then
		RiderRuntime.Cancel(state.riderRuntimeSession)
	end
	if state.physicsDriveSession then
		PhysicsDriveRuntime.Cancel(state.physicsDriveSession)
	end
	state.eventRuntime.Cancel(state.eventSession)
	if state.impactSession then
		ImpactBreakRuntime.Restore(state.impactSession)
	end
	if state.ragdollCapture then
		state.multiRigRagdollSupport.RestoreSessions(state.ragdollCapture)
	elseif state.ragdollSession then
		RagdollRuntime.Restore(state.ragdollSession)
	end
	restoreRagdollOriginal()
	for _, item in ipairs(state.runtimeObjectAnchors or {}) do
		if item.part and item.part.Parent then
			item.part.CustomPhysicalProperties = item.customPhysicalProperties
			item.part.Anchored = item.anchored
		end
	end
	local keepExplosionPlaybackHiddenUntilStop = state.eventTestLivePreviewSession ~= nil
		or (state.eventTestMode
			and state.effectMode == "Explosion"
			and math.abs(state.eventPlaybackSpeed - 1) &gt; 0.001)
	if not keepExplosionPlaybackHiddenUntilStop then
		state.restoreEventTestRuntimeTargets()
	end
	-- A completed capture must leave the editable scene exactly where it began,
	-- even when Studio remains in Run mode at the recorder limit. Previously the
	-- object path relied on Studio Stop to perform this reset, so a finished
	-- simulation could remain visibly displaced until the user stopped Run mode.
	restoreOriginalSetup()
	if state.startingPushTestMode or state.eventTestMode then
		ObjectCaptureSnapshot.Restore(state.previewRestoreSnapshots)
	end
	if completedTake and state.isEventMode() then
		local slowStart = nil
		local slowFactor = 1
		for _, marker in ipairs(state.eventMarkers) do
			local markerFactor = tonumber(marker.slowMotion) or 1
			if state.effectMode == "Explosion" and math.abs(markerFactor - 1) &gt; 0.001 then
				slowStart = marker.time
				slowFactor = markerFactor
			elseif state.effectMode ~= "Explosion" and markerFactor &gt; 1 then
				slowStart = slowStart and math.min(slowStart, marker.time) or marker.time
				slowFactor = math.max(slowFactor, markerFactor)
			end
		end
		if state.effectMode == "Explosion" then
			-- Temporary tests stay at their raw, real-physics timing so the same
			-- result can be replayed at any requested preview speed. Normal Capture
			-- keeps the established retiming path used by Bake.
			if not state.eventTestMode and not state.eventTestLivePreviewSession then
				PhysicsRecorder.ApplyPlaybackSpeed(completedTake, state.eventPlaybackSpeed)
			end
		elseif slowStart then
			PhysicsRecorder.ApplyObjectSlowMotion(
				completedTake,
				state.runtimeTargets,
				slowStart,
				slowFactor
			)
		end
	end
	state.capturing = false
	state.armed = false
	state.recorder = nil
	state.ragdollSession = nil
	state.ragdollCapture = nil
	state.runtimeRig = nil
	state.runtimeRigs = {}
	state.runtimeDriver = nil
	state.runtimeTargets = nil
	state.runtimeEventSources = nil
	state.runtimeObjectAnchors = {}
	state.pathSession = nil
	state.heldPathSession = nil
	state.adaptiveWalkSession = nil
	state.adaptiveWalkComplete = false
	state.impactSession = nil
	state.physicsDriveSession = nil
	state.riderRuntimeSession = nil
	state.eventSession = nil
	state.physicsActive = false
	SceneCaptureScope.ClearRuntimeIds(state.objectTargets, true)
	state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets, true)
	RiderRuntime.ClearRuntimeIds(state.riderTargets)
	clearDriverAttribute()
	if #completedRigTakes == 0 and completedTake then
		completedRigTakes = { completedTake }
	end
	local validRigTakes = {}
	for _, capturedTake in ipairs(completedRigTakes) do
		if capturedTake and #capturedTake.samples &gt;= 2 then
			capturedTake.physicsMarkers = {
				startFrame = state.effectMode == "Release" and state.releaseData and state.releaseData.releaseFrame
					or state.animatedPath and (state.animatedPath.importFrame or state.animatedPath.handoffFrame)
					or nil,
				impactTime = state.impactTime,
				ragdollTime = state.ragdollTime,
				endTime = capturedTake.duration,
				events = state.isEventMode() and state.eventRuntime.ExportMarkers(state.eventMarkers) or nil,
			}
			table.insert(validRigTakes, capturedTake)
		end
	end
	if #validRigTakes &gt; 0 then
		state.rigTakes = validRigTakes
		state.takes = { validRigTakes[1] }
		state.takeIndex = 1
		state.take = validRigTakes[1]
	else
		state.rigTakes = {}
	end
	if state.take and #state.take.samples &gt;= 2 then
		if state.effectMode == "Character" and not state.startingPushTestMode then
			state.uiStage = "Bake"
			state.advancedVisible = false
			state.refreshWorkflowUX()
		end
		setStatus(
			#state.rigTakes &gt; 1
				and string.format("Captured synchronized ragdoll takes for %d characters. Preview them together when Edit mode returns.", #state.rigTakes)
				or reason or "Physics take captured. Stop Run mode, then bake it into a KeyframeSequence.",
			THEME.green
		)
	else
		setStatus("The simulation ended before enough physics samples were recorded.", THEME.yellow)
	end
	updateUI()
end

local function beginPhysicsPhase(rig, runtimeTargets, linearVelocity, angularVelocity, existingRecorder)
	local ragdollSession = nil
	if state.autoRagdoll then
		local message = nil
		ragdollSession, message = RagdollRuntime.Prepare(rig)
		if not ragdollSession then
			setStatus(message, THEME.red)
			return false
		end
	end

	local recorder = existingRecorder
	if not recorder then
		recorder = PhysicsRecorder.new({
			fps = state.fps,
			maxDuration = state.maxDuration,
		})
		local ok, message = recorder:Start(rig, runtimeTargets)
		if not ok then
			RagdollRuntime.Restore(ragdollSession)
			setStatus(message, THEME.red)
			return false
		end
	end

	state.ragdollSession = ragdollSession
	state.recorder = recorder
	if ragdollSession and state.ragdollTime == nil then
		state.ragdollTime = tonumber(recorder.elapsed) or 0
	end
	state.physicsActive = true
	state.capturing = true
	state.armed = false
	ImpactBreakRuntime.Arm(state.impactSession)
	if typeof(linearVelocity) == "Vector3" then
		RagdollRuntime.ApplyVelocity(ragdollSession or rig, linearVelocity, angularVelocity)
	end
	if ragdollSession and state.effectMode == "Character" then
		RagdollRuntime.PrimeAirMotion(ragdollSession)
		if state.ragdollMode == "Knockback" then
			local applied, knockbackMessage = RagdollRuntime.ApplyDirectionalImpulse(
				ragdollSession,
				state.startingPushContact,
				state.startingPushOrigin,
				state.startingPushSpeed
			)
			if not applied then
				recorder:Stop()
				RagdollRuntime.Restore(ragdollSession)
				state.ragdollSession = nil
				state.recorder = nil
				state.physicsActive = false
				state.capturing = false
				setStatus(knockbackMessage, THEME.red)
				updateUI()
				return false
			end
			recorder.take.ragdollKnockback = {
				contactPosition = state.startingPushContact,
				originPosition = state.startingPushOrigin,
				direction = (state.startingPushContact - state.startingPushOrigin).Unit,
				speed = state.startingPushSpeed,
			}
		end
	end
	setStatus(string.format("Recording physics for the rig and %d scene part%s.", #runtimeTargets, #runtimeTargets == 1 and "" or "s"), THEME.red)
	updateUI()
	return true
end

local function beginRuntimeCapture()
	if state.capturing or not state.armed or not RunService:IsRunning() then
		return false
	end
	local runtimeTargets = SceneCaptureScope.FindRuntimeTargets(state.objectTargets)
	state.take = nil
	state.rigTakes = {}
	state.impactTime = nil
	state.ragdollTime = nil
	state.runtimeTargets = runtimeTargets
	if state.effectMode == "Character" then
		local runtimeRigs, missingCount = state.multiRigRagdollSupport.FindRuntimeRigs(
			state.rigCaptureEntries,
			CAPTURE_ATTRIBUTE
		)
		if missingCount &gt; 0 or #runtimeRigs ~= #state.rigCaptureEntries then
			state.armed = false
			setStatus("One or more selected characters were not found in Run mode. Return to Edit mode and select them again.", THEME.red)
			updateUI()
			return false
		end
		local capture, message = state.multiRigRagdollSupport.Start(runtimeRigs, {
			fps = state.fps,
			maxDuration = state.maxDuration,
			objectTargets = {},
			mode = state.ragdollMode,
			contactPosition = state.startingPushContact,
			originPosition = state.startingPushOrigin,
			speed = state.startingPushSpeed,
		})
		if not capture then
			state.armed = false
			setStatus(message, THEME.red)
			updateUI()
			return false
		end
		state.ragdollCapture = capture
		state.ragdollSession = capture.sessions[1]
		state.recorder = capture.recorders[1]
		state.runtimeRigs = runtimeRigs
		state.runtimeRig = runtimeRigs[1]
		state.ragdollTime = 0
		state.physicsActive = true
		state.capturing = true
		state.armed = false
		setStatus(string.format(
			"Recording synchronized ragdoll physics for %d character%s.",
			#runtimeRigs,
			#runtimeRigs == 1 and "" or "s"
		), THEME.red)
		updateUI()
		return true
	end
	if state.effectMode == "Impact" then
		local runtimeDriver = findRuntimeDriver()
		if not runtimeDriver or not state.animatedPath
			or (state.movingObjectMode ~= "PhysicsDrive" and #runtimeTargets == 0) then
			state.armed = false
			setStatus("The Moving Object, path, or physics objects were not found in Run mode.", THEME.red)
			updateUI()
			return false
		end
		if state.movingObjectMode == "PhysicsDrive" then
			local driveSession, driveMessage = PhysicsDriveRuntime.Start(runtimeDriver, state.animatedPath, state.driverId, {
				keepUpright = state.keepUpright,
			})
			if not driveSession then
				state.armed = false
				setStatus(driveMessage, THEME.red)
				updateUI()
				return false
			end
			local runtimeRiders = RiderRuntime.FindRuntimeRiders(state.riderTargets)
			if #runtimeRiders ~= #state.riderTargets then
				PhysicsDriveRuntime.Cancel(driveSession)
				state.armed = false
				setStatus("One or more selected riders were not found in Run mode. Return to Edit mode and select the riders again.", THEME.red)
				updateUI()
				return false
			end
			local riderSession, riderMessage = RiderRuntime.Start(driveSession, runtimeRiders)
			if not riderSession then
				PhysicsDriveRuntime.Cancel(driveSession)
				state.armed = false
				setStatus(riderMessage, THEME.red)
				updateUI()
				return false
			end
			local impactSession = #runtimeTargets &gt; 0 and ImpactBreakRuntime.Prepare(runtimeDriver, runtimeTargets) or nil
			local recordTargets = { driveSession.descriptor }
			for _, descriptor in ipairs(riderSession.captureDescriptors) do
				table.insert(recordTargets, descriptor)
			end
			for _, descriptor in ipairs(runtimeTargets) do
				table.insert(recordTargets, descriptor)
			end
			local recorder = PhysicsRecorder.new({
				fps = state.fps,
				maxDuration = state.maxDuration,
			})
			local ok, recorderMessage = recorder:StartObjects(recordTargets)
			if not ok then
				RiderRuntime.Cancel(riderSession)
				PhysicsDriveRuntime.Cancel(driveSession)
				ImpactBreakRuntime.Restore(impactSession)
				state.armed = false
				setStatus(recorderMessage, THEME.red)
				updateUI()
				return false
			end
			recorder.take.physicsDrive = true
			recorder.take.physicsDriverId = state.driverId
			recorder.take.physicsPathDuration = tonumber(state.animatedPath.duration)
			recorder.take.physicsDriveKeepUpright = state.keepUpright
			state.runtimeDriver = runtimeDriver
			state.physicsDriveSession = driveSession
			state.riderRuntimeSession = riderSession
			state.impactSession = impactSession
			state.pathSession = nil
			state.heldPathSession = nil
			state.recorder = recorder
			state.capturing = true
			state.armed = false
			state.physicsActive = true
			ImpactBreakRuntime.Arm(impactSession)
			local collisionNote = driveSession.vehicleCollisionProfile
				and string.format(" Smooth wheel contact is active for %d collider%s.", driveSession.vehicleWheelColliderCount, driveSession.vehicleWheelColliderCount == 1 and "" or "s")
				or ""
			setStatus(string.format(
				"Physics Drive launched using %s with %d rider%s.%s Recording ramps, jumps, impacts, and landings...",
				driveSession.root.Name,
				#riderSession.captureDescriptors,
				#riderSession.captureDescriptors == 1 and "" or "s",
				collisionNote
			), THEME.red)
			updateUI()
			return true
		end
		local impactSession = ImpactBreakRuntime.Prepare(runtimeDriver, runtimeTargets)
		local pathSession, pathMessage = AnimatedPathRuntime.Start(runtimeDriver, state.animatedPath)
		if not (impactSession and pathSession) then
			ImpactBreakRuntime.Restore(impactSession)
			state.armed = false
			setStatus(pathMessage or "Could not prepare the selected physics objects for impact.", THEME.red)
			updateUI()
			return false
		end
		local recorder = PhysicsRecorder.new({
			fps = state.fps,
			maxDuration = state.maxDuration,
		})
		local ok, recorderMessage = recorder:StartObjects(runtimeTargets)
		if not ok then
			AnimatedPathRuntime.Cancel(pathSession)
			ImpactBreakRuntime.Restore(impactSession)
			state.armed = false
			setStatus(recorderMessage, THEME.red)
			updateUI()
			return false
		end
		state.runtimeDriver = runtimeDriver
		state.impactSession = impactSession
		state.pathSession = pathSession
		state.heldPathSession = nil
		state.recorder = recorder
		state.capturing = true
		state.armed = false
		state.physicsActive = true
		ImpactBreakRuntime.Arm(impactSession)
		setStatus("Driving the animated object and recording the physics impact...", THEME.red)
		updateUI()
		return true
	end
	if state.captureMode == "Objects" then
		if #runtimeTargets == 0 then
			state.armed = false
			setStatus("The selected objects were not found in Run mode. Return to Edit mode and refresh the selection.", THEME.red)
			updateUI()
			return false
		end
		if state.effectMode == "Drop" or state.effectMode == "Scene" then
			state.selectionIsolation.FreezeUnselected(runtimeTargets)
		end
		if state.effectMode == "Release" and not state.releaseData then
			state.armed = false
			setStatus("The release state is missing. Return to Edit mode and load it from 7kg2 again.", THEME.red)
			updateUI()
			return false
		end
		state.runtimeObjectAnchors = {}
		for _, descriptor in ipairs(runtimeTargets) do
			if descriptor.part and descriptor.part.Parent then
				table.insert(state.runtimeObjectAnchors, {
					part = descriptor.part,
					anchored = descriptor.part.Anchored,
					customPhysicalProperties = descriptor.part.CustomPhysicalProperties,
				})
				if state.effectMode == "Drop" and state.bounceEnabled then
					state.applyExtraBounce(descriptor.part)
				end
				descriptor.part.Anchored = state.effectMode == "Release" or state.isEventMode()
			end
		end
		local releaseMessage = nil
		local releaseCaptureDescriptor = nil
		if state.effectMode == "Release" then
			local releaseApplied = nil
			releaseApplied, releaseMessage, releaseCaptureDescriptor = state.releaseRuntime.Apply(
				runtimeTargets,
				state.objectTargets,
				state.releaseCaptureTarget,
				state.releaseData,
				state.releaseCollisionsEnabled
			)
			if not releaseApplied then
				for _, item in ipairs(state.runtimeObjectAnchors) do
					if item.part and item.part.Parent then
						item.part.CustomPhysicalProperties = item.customPhysicalProperties
						item.part.Anchored = item.anchored
					end
				end
				state.runtimeObjectAnchors = {}
				state.armed = false
				setStatus(releaseMessage, THEME.red)
				updateUI()
				return false
			end
		end
		local eventSession = nil
		local runtimeEventSources = nil
		if state.isEventMode() then
			local eventMessage = nil
			runtimeEventSources = state.eventSourceScope.FindRuntimeSources(state.eventSourceTargets)
			eventSession, eventMessage = state.eventRuntime.Start(
				state.eventMarkers,
				runtimeTargets,
				runtimeEventSources,
				{
					onMarkerFired = function(marker)
						local vfxSource = marker.kind == "Explosion"
							and state.explosionVFXSupport.ResolveSource(
								marker.vfxSource,
								marker.vfxSourceDescriptor
							)
						if vfxSource
							and not (state.effectMode == "Explosion"
								and state.eventTestMode
								and math.abs(state.eventPlaybackSpeed - 1) &gt; 0.001)
							and not (state.effectMode == "Explosion"
								and not state.eventTestMode
								and state.eventPlaybackSpeed &lt; 0.999) then
							marker.vfxSource = vfxSource
							state.explosionVFXSupport.Preview(
								vfxSource,
								marker.position,
								marker.vfxEmitCount,
								marker.playbackSpeed
							)
						end
					end,
				}
			)
			if not eventSession then
				state.restoreEventTestRuntimeTargets()
				for _, item in ipairs(state.runtimeObjectAnchors) do
					if item.part and item.part.Parent then
						item.part.CustomPhysicalProperties = item.customPhysicalProperties
						item.part.Anchored = item.anchored
					end
				end
				state.runtimeObjectAnchors = {}
				state.armed = false
				setStatus(eventMessage, THEME.red)
				updateUI()
				return false
			end
		end
		state.hideEventTestRuntimeTargets(runtimeTargets)
		local recordTargets = {}
		if releaseCaptureDescriptor then
			table.insert(recordTargets, releaseCaptureDescriptor)
		else
			for _, descriptor in ipairs(runtimeTargets) do
				table.insert(recordTargets, descriptor)
			end
		end
		for _, source in ipairs(runtimeEventSources or {}) do
			table.insert(recordTargets, source.captureDescriptor)
		end
		local recorder = PhysicsRecorder.new({
			fps = state.fps,
			-- A high-power Ragdoll blast needs a longer settling window than a
			-- short animation project. Extend only temporary Explosion tests;
			-- normal captures still obey the user's selected maximum duration.
			maxDuration = state.eventTestMode
				and math.max(state.maxDuration, state.eventTestDuration)
				or state.maxDuration,
		})
		local ok, message = recorder:StartObjects(recordTargets)
		if not ok then
			state.restoreEventTestRuntimeTargets()
			state.eventRuntime.Cancel(eventSession)
			for _, item in ipairs(state.runtimeObjectAnchors) do
				if item.part and item.part.Parent then
					item.part.CustomPhysicalProperties = item.customPhysicalProperties
					item.part.Anchored = item.anchored
				end
			end
			state.runtimeObjectAnchors = {}
			state.armed = false
			setStatus(message, THEME.red)
			updateUI()
			return false
		end
		state.startingPushApplied = false
		state.startingPushMessage = nil
		state.startingPushMetadata = nil
		if state.effectMode == "Scene" and state.startingPushTarget then
			state.startingPushApplied, state.startingPushMessage, state.startingPushMetadata = state.startingPushRuntime.Apply(
				runtimeTargets,
				{
					targetId = state.startingPushTargetId,
					targetName = state.startingPushTarget.Name,
					contactPosition = state.startingPushContact,
					originPosition = state.startingPushOrigin,
					speed = state.startingPushSpeed,
				}
			)
			state.startingPushUX:StopPreview()
			if not state.startingPushApplied then
				recorder:Stop()
				for _, item in ipairs(state.runtimeObjectAnchors) do
					if item.part and item.part.Parent then
						item.part.CustomPhysicalProperties = item.customPhysicalProperties
						item.part.Anchored = item.anchored
					end
				end
				state.runtimeObjectAnchors = {}
				state.armed = false
				setStatus(state.startingPushMessage, THEME.red)
				updateUI()
				return false
			end
			recorder.take.startingPush = state.startingPushMetadata
		end
		if eventSession then
			recorder.take.physicsEvents = state.eventRuntime.ExportMarkers(state.eventMarkers)
		end
		if state.effectMode == "Release" then
			recorder.take.releaseToPhysics = true
			recorder.take.releaseFrame = state.releaseData.releaseFrame
		end
		state.recorder = recorder
		state.eventSession = eventSession
		state.runtimeEventSources = runtimeEventSources
		state.capturing = true
		state.armed = false
		state.physicsActive = true
		setStatus(
			state.eventTestMode
				and state.effectMode == "Explosion"
				and math.abs(state.eventPlaybackSpeed - 1) &gt; 0.001
				and string.format("Holding the original pose while 7kg2 calculates once. The %d%% test will play next; later Speed changes are instant.", math.round(state.eventPlaybackSpeed * 100))
				or state.eventTestMode
				and state.effectMode == "Explosion"
				and "Testing the Explosion at full speed. The scene will restore after the affected objects settle."
				or eventSession
				and string.format("Recording %d timed physics event%s across %d affected object%s.", #state.eventMarkers, #state.eventMarkers == 1 and "" or "s", #runtimeTargets, #runtimeTargets == 1 and "" or "s")
				or state.effectMode == "Release" and (releaseMessage .. " Recording natural physics...")
				or state.startingPushApplied and (state.startingPushMessage .. " Recording the chain reaction...")
				or string.format("Recording runtime physics for %d selected object%s.", #runtimeTargets, #runtimeTargets == 1 and "" or "s"),
			state.eventTestMode and THEME.cyan or THEME.red
		)
		updateUI()
		return true
	end

	local rig = findRuntimeRig()
	if not rig then
		return false
	end
	state.runtimeRig = rig
	state.impactSession = nil
	if state.effectMode == "AdaptiveWalk" then
		if not state.animatedPath then
			state.armed = false
			setStatus("Load the authored walk path from 7kg2 before starting Adaptive Walk.", THEME.yellow)
			updateUI()
			return false
		end
		restoreAdaptiveWalkOriginal()
		local adaptiveSession, adaptiveMessage = AdaptiveWalkRuntime.Start(rig, state.animatedPath)
		if not adaptiveSession then
			state.armed = false
			setStatus(adaptiveMessage, THEME.red)
			updateUI()
			return false
		end
		local recorder = PhysicsRecorder.new({
			fps = state.fps,
			maxDuration = state.maxDuration,
		})
		local ok, recorderMessage = recorder:Start(rig, {})
		if not ok then
			AdaptiveWalkRuntime.RestoreOriginal(adaptiveSession)
			state.armed = false
			setStatus(recorderMessage, THEME.red)
			updateUI()
			return false
		end
		recorder.take.adaptiveWalkNeutralJointCount = PhysicsRecorder.ApplyJointBasePose(
			recorder.take,
			state.animatedPath.motors,
			state.animatedPath.neutralJoints
		)
		recorder.take.adaptiveWalk = true
		recorder.take.physicsPathDuration = tonumber(state.animatedPath.duration)
		state.adaptiveWalkSession = adaptiveSession
		state.adaptiveWalkRestoreSession = adaptiveSession
		state.adaptiveWalkComplete = false
		state.recorder = recorder
		state.capturing = true
		state.armed = false
		state.physicsActive = true
		setStatus("Playing the authored walk and adapting its feet and pelvis to the terrain...", THEME.cyan)
		updateUI()
		return true
	end
	if state.impactBreak and state.captureScope == SceneCaptureScope.SELECTED then
		state.impactSession = ImpactBreakRuntime.Prepare(rig, runtimeTargets)
	end

	if state.animatedPath then
		local pathSession, message = AnimatedPathRuntime.Start(rig, state.animatedPath)
		if not pathSession then
			ImpactBreakRuntime.Restore(state.impactSession)
			state.impactSession = nil
			state.armed = false
			setStatus(message, THEME.red)
			updateUI()
			return false
		end
		state.pathSession = pathSession
		if state.pathMode == "DrivenImpact" then
			local recorder = PhysicsRecorder.new({
				fps = state.fps,
				maxDuration = state.maxDuration,
			})
			local ok, recorderMessage = recorder:Start(rig, runtimeTargets)
			if not ok then
				AnimatedPathRuntime.Cancel(pathSession)
				ImpactBreakRuntime.Restore(state.impactSession)
				state.pathSession = nil
				state.impactSession = nil
				state.armed = false
				setStatus(recorderMessage, THEME.red)
				updateUI()
				return false
			end
			state.recorder = recorder
			ImpactBreakRuntime.Arm(state.impactSession)
		end
		state.capturing = true
		state.armed = false
		if state.pathMode == "DrivenImpact" then
			setStatus(string.format(
				"Driving the authored path through frame %d while recording impact physics...",
				state.animatedPath.endFrame or state.animatedPath.handoffFrame or 0
			), THEME.cyan)
		else
			setStatus(string.format("Playing the animated path to physics frame %d...", state.animatedPath.handoffFrame or 0), THEME.cyan)
		end
		updateUI()
		return true
	end

	return beginPhysicsPhase(rig, runtimeTargets, nil, nil)
end

local function armCapture()
	if state.capturing then
		finishRuntimeCapture("Capture finished. You can stop Run mode and bake the take.")
		return
	end
	if state.isEventMode() and #state.eventMarkers == 0 then
		setStatus("Add at least one timed event before arming physics capture.", THEME.yellow)
		updateUI()
		return
	end
	if state.captureMode == "Objects" and #state.objectTargets == 0
		and not (state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive") then
		selectRig()
		if #state.objectTargets == 0 then
			return
		end
	elseif state.captureMode ~= "Objects" and not (state.selectedRig and state.selectedRig.Parent) then
		selectRig()
		if not state.selectedRig then
			return
		end
	end
	if not state.armed and state.confirmLargeSelection("capture", function()
		state.largeSelectionWarningBypass = true
		armCapture()
	end, function()
		setStatus("Large capture cancelled. Reduce the selection or settings, then try again.", THEME.muted)
		updateUI()
	end) then
		return
	end
	state.armed = not state.armed
	if state.armed then
		prepareRuntimeTargets()
	else
		SceneCaptureScope.ClearRuntimeIds(state.objectTargets, true)
		state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets, true)
	end
	setStatus(
		state.armed and (state.captureMode == "Objects"
			and (state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive"
				and "Physics Drive armed. Start Run mode; only the Moving Object and optional loose objects will become physical."
				or state.effectMode == "Release"
					and "Release armed. Start Run mode; the object will begin at the loaded Detach frame with inherited motion."
				or "Object capture armed. Start Run mode; selected objects will become physical.")
			or "Capture armed. Start Run mode; recording begins when the runtime rig appears.") or "Capture disarmed.",
		state.armed and THEME.yellow or THEME.muted
	)
	updateUI()
	if state.armed and RunService:IsRunning() then
		beginRuntimeCapture()
	end
end

local function startOrStopRun()
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	if RunService:IsRunning() then
		if state.capturing then
			if state.eventTestLivePreviewSession then
				state.finishEventTestLiveCapture("Take captured. Finishing the selected-speed Explosion playback...")
				return
			end
			finishRuntimeCapture("Take captured. Returning to Edit mode...")
		end
		local ok = pcall(function()
			RunService:Stop()
		end)
		if not ok then
			setStatus("Take captured. Use Studio Stop or Shift+F5 to return to Edit mode.", THEME.yellow)
		end
		return
	end
	if state.isEventMode() and #state.eventMarkers == 0 then
		setStatus("Add at least one timed event before starting the simulation.", THEME.yellow)
		updateUI()
		return
	end
	if state.captureMode == "Objects" and #state.objectTargets == 0
		and not (state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive") then
		selectRig()
		if #state.objectTargets == 0 then
			return
		end
	elseif state.captureMode ~= "Objects" and not (state.selectedRig and state.selectedRig.Parent) then
		selectRig()
		if not state.selectedRig then
			return
		end
	end
	if state.confirmLargeSelection(
		(state.eventTestMode or state.startingPushTestMode) and "test" or "capture",
		function()
			state.largeSelectionWarningBypass = true
			startOrStopRun()
		end,
		function()
			state.startingPushUX:StopPreview()
			state.startingPushTestMode = false
			state.fullEffectTestMode = false
			state.startingPushTestDuration = 4
			state.eventTestMode = false
			state.eventTestCompleted = false
			state.eventTestSettledDuration = 0
			setStatus("Large physics test or capture cancelled.", THEME.muted)
			updateUI()
		end
	) then
		return
	end
	if state.captureMode == "Objects" then
		restoreOriginalSetup()
	elseif state.effectMode == "Character" then
		-- The editable pose at the moment a new run begins is the source of truth.
		-- Reusing the earlier selection snapshot made a repositioned character
		-- teleport back to its first test location before Ragdoll started.
		state.rigEditSnapshots = state.multiRigRagdollSupport.CaptureSnapshots(state.selectedRigs)
	end
	state.armed = true
	state.eventCapturedTakeRetimed = false
	state.eventLivePreviewPurpose = nil
	state.eventTestLiveCaptureComplete = false
	state.manualRunRequired = false
	prepareRuntimeTargets()
	setStatus(
		state.captureMode == "Objects"
			and (state.effectMode == "Impact" and state.movingObjectMode == "PhysicsDrive"
				and "Starting Studio Run mode and launching the Moving Object with physics..."
				or "Starting Studio Run mode and enabling physics on the selected objects...")
			or "Starting Studio Run mode and waiting for the runtime rig...",
		THEME.yellow
	)
	updateUI()
	local ok = pcall(function()
		RunService:Run()
	end)
	if not ok then
		state.manualRunRequired = true
		state.armed = false
		state.eventTestMode = false
		state.eventTestCompleted = false
		SceneCaptureScope.ClearRuntimeIds(state.objectTargets)
		state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets)
		RiderRuntime.ClearRuntimeIds(state.riderTargets)
		clearCaptureAttribute()
		clearDriverAttribute()
		setStatus(
			"Physics capture is unavailable while Team Create is active. Disable Team Create or open a local copy, then try again.",
			THEME.red
		)
		updateUI()
		return
	end
	task.delay(0.4, function()
		if state.armed and not state.capturing and not RunService:IsRunning() then
			state.manualRunRequired = true
			state.armed = false
			state.eventTestMode = false
			state.eventTestCompleted = false
			SceneCaptureScope.ClearRuntimeIds(state.objectTargets)
			state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets)
			RiderRuntime.ClearRuntimeIds(state.riderTargets)
			clearCaptureAttribute()
			clearDriverAttribute()
			setStatus(
				"Team Create cannot return Physics capture data from Run mode. Disable Team Create or open a local copy, then try again.",
				THEME.red
			)
			updateUI()
		end
	end)
end

function state.startEventTestLivePreview()
	if state.eventTestLivePreviewSession
		or state.effectMode ~= "Explosion"
		or state.eventPlaybackSpeed &gt;= 1
		or not state.recorder then
		return false
	end
	local take = state.recorder:GetTake()
	if not (take and type(take.samples) == "table" and #take.samples &gt;= 2) then
		return false
	end
	if type(state.eventTestVisualProxyDescriptors) ~= "table"
		or #state.eventTestVisualProxyDescriptors == 0 then
		return false
	end
	local temporaryTest = state.eventTestMode == true
	local purpose = temporaryTest and "Test" or "Capture"
	local previewSession = nil
	local previewOptions = {
		live = true,
		-- These targets are disposable stand-ins. Restoring their cloned source
		-- pose for one frame before destruction creates a visible duplicate flash.
		restoreOnComplete = false,
		isLiveComplete = function()
			return state.eventTestLiveCaptureComplete == true
		end,
		events = take.physicsEvents,
		onEvent = function(marker)
			local vfxSource = marker and marker.kind == "Explosion"
				and state.explosionVFXSupport.ResolveSource(
					marker.vfxSource,
					marker.vfxSourceDescriptor
				)
			if vfxSource then
				marker.vfxSource = vfxSource
				state.explosionVFXSupport.Preview(
					vfxSource,
					marker.position,
					marker.vfxEmitCount,
					marker.playbackSpeed
				)
			end
		end,
	}
	local previewMessage = nil
	previewSession, previewMessage = TakePreviewRuntime.Start(
		take,
		nil,
		state.eventTestVisualProxyDescriptors,
		function()
			if state.eventTestLivePreviewSession ~= previewSession then
				return
			end
			state.eventTestLivePreviewSession = nil
			state.eventTestLiveCaptureComplete = false
			state.eventLivePreviewPurpose = nil
			if temporaryTest then
				state.eventTestMode = false
				state.eventSpeedPreviewMode = false
				state.eventTestCompleted = true
				state.eventTestSettledDuration = 0
				state.take = nil
				state.rigTakes = {}
				state.takes = {}
				state.takeIndex = 0
			elseif state.take and not state.eventCapturedTakeRetimed then
				PhysicsRecorder.ApplyPlaybackSpeed(state.take, state.eventPlaybackSpeed)
				if state.take.physicsMarkers then
					state.take.physicsMarkers.endTime = state.take.duration
				end
				state.eventCapturedTakeRetimed = true
			end
			pcall(function()
				if RunService:IsRunning() then
					RunService:Stop()
				end
			end)
			task.defer(function()
				task.wait()
				state.restoreEventTestRuntimeTargets()
				if temporaryTest then
					state.restorePreviewScene()
				else
					restoreOriginalSetup()
				end
				state.refreshWorkflowUX()
				setStatus(
					string.format(
						temporaryTest
							and "Explosion test preview finished at %d%%. The scene has been restored."
							or "Explosion capture finished at %d%%. Preview or bake the captured take.",
						math.round(state.eventPlaybackSpeed * 100)
					),
					THEME.green
				)
				updateUI()
			end)
		end,
		state.eventPlaybackSpeed,
		previewOptions
	)
	if not previewSession then
		setStatus(previewMessage or "The live slow-motion Explosion preview could not start.", THEME.red)
		updateUI()
		return false
	end
	state.eventTestLivePreviewSession = previewSession
	state.eventLivePreviewPurpose = purpose
	-- TakePreviewRuntime applies sample one synchronously. Reveal the staged
	-- stand-ins only after that pose exists, so there is never a frame showing
	-- both untouched clones and the real runtime characters.
	if state.eventTestVisualProxyFolder and not state.eventTestVisualProxyFolder.Parent then
		state.eventTestVisualProxyFolder.Parent = workspace
	end
	setStatus(string.format(
		temporaryTest
			and "Explosion test is playing at %d%% while 7kg2 calculates ahead."
			or "Explosion capture is being shown at %d%% while 7kg2 calculates ahead.",
		math.round(state.eventPlaybackSpeed * 100)
	), THEME.cyan)
	updateUI()
	return true
end

function state.finishEventTestLiveCapture(reason)
	state.eventTestLiveCaptureComplete = true
	if state.eventTestMode then
		state.eventTestCompleted = true
	end
	finishRuntimeCapture(reason or "Physics calculated. Finishing the visible slow-motion test...")
	setStatus(string.format(
		state.eventTestMode
			and "Physics calculated. Finishing the visible Explosion test at %d%%..."
			or "Physics calculated. Finishing the visible Explosion capture at %d%%...",
		math.round(state.eventPlaybackSpeed * 100)
	), THEME.cyan)
	updateUI()
end

function state.startExplosionTestReplay(take, descriptors, playbackSpeed, reusedCache)
	if not (take and type(take.samples) == "table" and #take.samples &gt;= 2) then
		return false, "No reusable Explosion test is available yet."
	end
	local resolvedSpeed = math.clamp(tonumber(playbackSpeed) or 1, 0.1, 4)
	local speedPercent = math.round(resolvedSpeed * 100)
	state.explosionVFXSupport.ClearPreviews()
	for _, marker in ipairs(take.physicsEvents or {}) do
		if marker.kind == "Explosion" then
			marker.vfxSource = state.explosionVFXSupport.ResolveSource(
				marker.vfxSource,
				marker.vfxSourceDescriptor
			)
		end
	end
	local previewSession
	local previewOptions = {
		events = take.physicsEvents,
		onEvent = function(marker)
			local vfxSource = marker and marker.kind == "Explosion"
				and state.explosionVFXSupport.ResolveSource(
					marker.vfxSource,
					marker.vfxSourceDescriptor
				)
			if vfxSource then
				marker.vfxSource = vfxSource
				state.explosionVFXSupport.Preview(
					vfxSource,
					marker.position,
					marker.vfxEmitCount,
					resolvedSpeed
				)
			end
		end,
	}
	local onPreviewComplete = function()
		if state.previewSession == previewSession then
			state.previewSession = nil
			state.eventSpeedPreviewMode = false
			state.restorePreviewScene()
			state.refreshWorkflowUX()
			setStatus(string.format(
				"Explosion test preview finished at %d%%. The scene has been restored.",
				speedPercent
			), THEME.green)
			updateUI()
		end
	end
	local previewMessage = nil
	previewSession, previewMessage = TakePreviewRuntime.Start(
		take,
		nil,
		descriptors,
		onPreviewComplete,
		resolvedSpeed,
		previewOptions
	)
	if not previewSession then
		return false, previewMessage or "The selected-speed Explosion preview could not start."
	end
	state.previewSession = previewSession
	state.eventSpeedPreviewMode = true
	state.eventTestCompleted = true
	state.refreshWorkflowUX()
	setStatus(string.format(
		reusedCache
			and "Replaying the cached Explosion physics immediately at %d%% speed..."
			or "Physics calculated. Replaying the Explosion test at %d%% speed...",
		speedPercent
	), THEME.cyan)
	updateUI()
	return true
end

function state.eventActions.FinishTest(message, completed)
	local speedPreviewTake = nil
	local speedPreviewDescriptors = nil
	local speedPreviewSpeed = state.eventPlaybackSpeed
	if state.eventTestLivePreviewSession then
		TakePreviewRuntime.Stop(state.eventTestLivePreviewSession, false)
		state.eventTestLivePreviewSession = nil
	end
	state.eventTestLiveCaptureComplete = false
	if state.capturing then
		finishRuntimeCapture("Explosion test finished.")
		if completed == true
			and state.take
			and type(state.take.samples) == "table"
			and #state.take.samples &gt;= 2 then
			local cachedDescriptors = state.getObjectCaptureTargets()
			state.explosionTestCache = {
				take = state.take,
				descriptors = cachedDescriptors,
				revision = state.explosionTestSetupRevision,
			}
			-- At 100% the animator has already seen the authentic real-time test.
			-- Other speeds replay the same raw result after Studio returns to Edit.
			if math.abs(speedPreviewSpeed - 1) &gt; 0.001 then
				speedPreviewTake = state.take
				speedPreviewDescriptors = cachedDescriptors
			end
		end
	end
	state.eventTestMode = false
	state.eventSpeedPreviewMode = false
	state.eventTestCompleted = completed == true
	state.eventTestSettledDuration = 0
	state.armed = false
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	task.defer(function()
		pcall(function()
			if RunService:IsRunning() then
				RunService:Stop()
			end
		end)
		-- RunService:Stop returns before Studio has always finished replacing the
		-- runtime scene with its edit-time instances. Yield once before replaying.
		task.wait()
		state.restoreEventTestRuntimeTargets()
		state.restorePreviewScene()
		if speedPreviewTake then
			local started, previewMessage = state.startExplosionTestReplay(
				speedPreviewTake,
				speedPreviewDescriptors,
				speedPreviewSpeed,
				false
			)
			if not started then
				state.eventSpeedPreviewMode = false
				setStatus(previewMessage, THEME.red)
				updateUI()
			end
			return
		end
		state.refreshWorkflowUX()
		setStatus(
			message or "Explosion test complete. The scene has been restored; adjust the blast or continue to Capture.",
			completed and THEME.green or THEME.yellow
		)
		updateUI()
	end)
end

function state.eventActions.Test()
	if state.eventSpeedPreviewMode and state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		state.eventSpeedPreviewMode = false
		state.restorePreviewScene()
		state.refreshWorkflowUX()
		setStatus("Selected-speed Explosion preview stopped. The scene has been restored.", THEME.muted)
		updateUI()
		return
	end
	if state.eventTestMode then
		state.eventActions.FinishTest("Explosion test stopped. The scene has been restored.", false)
		return
	end
	if RunService:IsRunning() then
		setStatus("Finish the current simulation before testing the explosion.", THEME.yellow)
		updateUI()
		return
	end
	if state.effectMode ~= "Explosion" then
		return
	end
	state.eventPlaybackSpeed = 1
	if #state.eventMarkers == 0 then
		state.eventActions.Add()
	end
	state.eventActions.SyncSingleQueuedEvent()
	if not isWorkflowReady() then
		setStatus("Select the affected objects and set the Blast Origin before testing.", THEME.yellow)
		updateUI()
		return
	end
	state.capturePreviewRestoreSnapshot()
	local cache = state.explosionTestCache
	local cacheIsReusable = cache
		and cache.revision == state.explosionTestSetupRevision
		and cache.take
		and type(cache.take.samples) == "table"
		and #cache.take.samples &gt;= 2
	if cacheIsReusable then
		restoreOriginalSetup()
		local started, replayMessage = state.startExplosionTestReplay(
			cache.take,
			cache.descriptors,
			state.eventPlaybackSpeed,
			true
		)
		if started then
			return
		end
		state.invalidateExplosionTestCache()
		setStatus(
			(replayMessage or "The cached Explosion test could not be replayed.")
				.. " 7kg2 will calculate a fresh test instead.",
			THEME.yellow
		)
		updateUI()
	end
	-- Settling is now the normal end condition. Keep a generous hard limit so a
	-- rolling object or unstable rig cannot leave Studio in Run mode forever.
	state.eventTestDuration = 30
	state.explosionVFXSupport.ClearPreviews()
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.eventTestMode = true
	state.eventSpeedPreviewMode = false
	state.eventTestLiveCaptureComplete = false
	state.eventTestLivePreviewSession = nil
	state.eventLivePreviewPurpose = nil
	state.eventCapturedTakeRetimed = false
	state.eventTestCompleted = false
	state.eventTestSettledDuration = 0
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	setStatus(
		math.abs(state.eventPlaybackSpeed - 1) &gt; 0.001
			and string.format(
				"Calculating the Explosion physics once. 7kg2 will then replay it at %d%%; later Speed changes will be instant.",
				math.round(state.eventPlaybackSpeed * 100)
			)
			or string.format("Testing the explosion. It will restore one second after the affected objects settle (%.1fs safety limit).", state.eventTestDuration),
		THEME.cyan
	)
	-- Hide the edit-time Blast Origin gizmo and radius guide before entering Run
	-- mode. Without this refresh, the existing adornments remain attached to the
	-- simulated source and appear to move with it during the test.
	state.refreshWorkflowUX()
	updateUI()
	startOrStopRun()
	if state.manualRunRequired then
		state.eventTestMode = false
		state.eventTestSettledDuration = 0
		state.refreshWorkflowUX()
		updateUI()
	end
end

local function clearStartingPushTestTake()
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
end

local function finishStartingPushTest(message, completed)
	local testedSpeed = state.startingPushSpeed
	local testedCharacterKnockback = state.effectMode == "Character" and state.ragdollMode == "Knockback"
	local testedWholeEffect = state.fullEffectTestMode
	state.startingPushUX:StopPreview()
	if state.capturing then
		finishRuntimeCapture("Starting Push test finished.")
	end
	state.startingPushTestMode = false
	state.fullEffectTestMode = false
	state.startingPushTestDuration = 4
	if completed and (not testedWholeEffect or state.findStartingPushDescriptor() ~= nil) then
		state.startingPushTestedSpeed = testedSpeed
	end
	state.armed = false
	clearStartingPushTestTake()
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	task.defer(function()
		pcall(function()
			if RunService:IsRunning() then
				RunService:Stop()
			end
		end)
		state.restorePreviewScene()
		state.refreshWorkflowUX()
		setStatus(
			message or (testedWholeEffect
				and string.format(
					"%s test complete. The scene has been restored; adjust the settings or continue to Capture.",
					state.effectTestLabels[state.effectMode] or "Physics"
				)
				or string.format(
					testedCharacterKnockback
						and "Knockback test complete at %.0f studs/s. Adjust the speed and test again, or continue when satisfied."
						or "Test complete at %.0f studs/s. Adjust the speed and test again, or continue when satisfied.",
					testedSpeed
				)),
			THEME.green
		)
		updateUI()
	end)
end

function state.startingPushActions.Test()
	if state.startingPushTestMode then
		finishStartingPushTest("Knockback test stopped. Adjust the setup or test it again when ready.", false)
		return
	end
	if RunService:IsRunning() then
		setStatus(
			state.effectMode == "Character"
				and "Finish the current simulation before testing the Knockback."
				or "Finish the current simulation before testing a Starting Push.",
			THEME.yellow
		)
		updateUI()
		return
	end
	if not (state.effectMode == "Scene" or state.effectMode == "Character" and state.ragdollMode == "Knockback")
		or not state.findStartingPushDescriptor() then
		setStatus(
			state.effectMode == "Character"
				and "Choose Knockback mode and set its direction before testing it."
				or "Add a Starting Push before testing it.",
			THEME.yellow
		)
		updateUI()
		return
	end
	if not isWorkflowReady() then
		setStatus(
			state.effectMode == "Character"
				and "Select the character and finish the Knockback setup before testing."
				or "Select the physics objects and finish the Starting Push setup before testing.",
			THEME.yellow
		)
		updateUI()
		return
	end
	state.capturePreviewRestoreSnapshot()
	clearStartingPushTestTake()
	state.startingPushTestDuration = 4
	state.startingPushTestMode = true
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	setStatus(
		string.format(
			state.effectMode == "Character"
				and "Testing Knockback at %.0f studs/s for %.0f seconds. The character will restore automatically."
				or "Testing %.0f studs/s for %.0f seconds. The scene will restore automatically.",
			state.startingPushSpeed,
			state.startingPushTestDuration
		),
		THEME.cyan
	)
	updateUI()
	state.startingPushPreviewDuration = state.startingPushUX:StartPreview(state.startingPushSpeed, function()
		if state.startingPushTestMode and not RunService:IsRunning() then
			startOrStopRun()
		end
	end) or 0
	if state.startingPushPreviewDuration &lt;= 0 then
		startOrStopRun()
	end
	task.delay(state.startingPushPreviewDuration + 0.6, function()
		if state.startingPushTestMode
			and not RunService:IsRunning()
			and not state.armed
			and not state.capturing then
			state.startingPushTestMode = false
			state.startingPushUX:StopPreview()
			updateUI()
		end
	end)
end

function state.effectActions.Test()
	if state.effectMode == "Explosion" then
		state.eventActions.Test()
		return
	end
	if state.startingPushTestMode then
		finishStartingPushTest("Physics test stopped. The scene has been restored.", false)
		return
	end
	if RunService:IsRunning() then
		setStatus("Finish the current simulation before testing this effect.", THEME.yellow)
		updateUI()
		return
	end
	if not isWorkflowReady() then
		setStatus("Finish the effect setup before testing it.", THEME.yellow)
		updateUI()
		return
	end
	state.capturePreviewRestoreSnapshot()
	clearStartingPushTestTake()
	state.fullEffectTestMode = true
	state.startingPushTestMode = true
	state.startingPushTestDuration = state.maxDuration
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	setStatus(
		string.format(
			"Testing %s for up to %.0f seconds. Stop it early whenever you are ready; the scene will restore automatically.",
			state.effectTestLabels[state.effectMode] or "this effect",
			state.startingPushTestDuration
		),
		THEME.cyan
	)
	updateUI()
	startOrStopRun()
	if state.manualRunRequired then
		state.startingPushTestMode = false
		state.fullEffectTestMode = false
		state.startingPushTestDuration = 4
		clearStartingPushTestTake()
		updateUI()
	end
end

local function toggleTakePreview()
	if RunService:IsRunning() then
		setStatus("Finish the simulation before previewing a captured take.", THEME.yellow)
		return
	end
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
		if state.quickPhysics.visible then
			state.quickPhysics.phase = "Review"
		end
		setStatus("Preview stopped. The scene has been restored.", THEME.muted)
		state.refreshWorkflowUX()
		updateUI()
		return
	end
	if not state.take then
		setStatus("Capture a take before previewing it.", THEME.yellow)
		return
	end
	if state.take.physicsDrive and not state.take.physicsDriverId then
		state.take.physicsDriverId = state.driverId
	end

	local previewSession
	local message
	state.capturePreviewRestoreSnapshot()
	-- Clear only Physics-owned adornments before the first preview sample is
	-- applied. The guarded refresh below keeps them hidden for the full preview.
	workflowUX:Clear()
	projectilePathUX:Clear()
	state.startingPushUX:SetVisible(false)
	local previewOptions = {
		suspendMegMoAttachments = state.effectMode == "Release",
		events = state.take.physicsEvents,
		onEvent = function(marker)
			local vfxSource = marker and marker.kind == "Explosion"
				and state.explosionVFXSupport.ResolveSource(
					marker.vfxSource,
					marker.vfxSourceDescriptor
				)
			if vfxSource then
				marker.vfxSource = vfxSource
				state.explosionVFXSupport.Preview(
					vfxSource,
					marker.position,
					marker.vfxEmitCount,
					(tonumber(marker.playbackSpeed) or 1) * state.previewSpeed
				)
			end
		end,
	}
	local onPreviewComplete = function()
		if state.previewSession == previewSession then
			state.previewSession = nil
			if state.effectMode == "Character" then
				restoreRagdollOriginal()
			end
			state.restorePreviewScene()
			setStatus("Preview finished. The scene has been restored.", THEME.green)
			if state.quickPhysics.visible then
				state.quickPhysics.phase = "Review"
			end
			state.refreshWorkflowUX()
			updateUI()
		end
	end
	if #state.rigTakes &gt; 1 then
		local previewItems = {}
		for index, capturedTake in ipairs(state.rigTakes) do
			local entry = state.rigCaptureEntries[index]
			table.insert(previewItems, {
				take = capturedTake,
				rig = state.selectedRigs[index] or entry and entry.rig or nil,
				rigName = capturedTake.rigName,
			})
		end
		previewSession, message = TakePreviewRuntime.StartMany(
			previewItems,
			state.getObjectCaptureTargets(),
			onPreviewComplete,
			state.previewSpeed,
			previewOptions
		)
	else
		previewSession, message = TakePreviewRuntime.Start(
			state.take,
			state.selectedRig,
			state.getObjectCaptureTargets(),
			onPreviewComplete,
			state.previewSpeed,
			previewOptions
		)
	end
	if not previewSession then
		state.previewRestoreSnapshots = {}
		setStatus(message, THEME.red)
		updateUI()
		return
	end
	state.previewSession = previewSession
	state.refreshWorkflowUX()
	if state.quickPhysics.visible then
		state.quickPhysics.phase = "Previewing"
	end
	if #state.rigTakes &gt; 1 then
		setStatus(string.format("Previewing %d synchronized ragdoll takes at %gx...", #state.rigTakes, state.previewSpeed), THEME.cyan)
	else
		setStatus(string.format("Previewing the captured physics take at %gx...", state.previewSpeed), THEME.cyan)
	end
	updateUI()
end

local function bakeTake()
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	if RunService:IsRunning() then
		setStatus("Stop Run mode before baking the captured take.", THEME.yellow)
		return
	end
	if state.take and state.take.objectOnly then
		setStatus("Object-only takes import directly into 7kg2 and do not use a KeyframeSequence fallback.", THEME.muted)
		return
	end
	if #state.rigTakes &gt; 1 then
		local sequences = {}
		local totalKeyCount = 0
		for _, capturedTake in ipairs(state.rigTakes) do
			local sequence, message, keyCount = TakeBaker.Bake(capturedTake)
			if not sequence then
				for _, createdSequence in ipairs(sequences) do
					createdSequence:Destroy()
				end
				setStatus(message, THEME.red)
				return
			end
			table.insert(sequences, sequence)
			totalKeyCount += keyCount
		end
		Selection:Set(sequences)
		setStatus(string.format(
			"Baked %d synchronized ragdoll keyframes across %d KeyframeSequences in Workspace.MegMoPhysicsCaptures.",
			totalKeyCount,
			#sequences
		), THEME.green)
		updateUI()
		return
	end
	local sequence, message, keyCount = TakeBaker.Bake(state.take)
	if not sequence then
		setStatus(message, THEME.red)
		return
	end
	Selection:Set({ sequence })
	setStatus(string.format("Baked %d keyframes to Workspace.%s.%s", keyCount, "MegMoPhysicsCaptures", sequence.Name), THEME.green)
	updateUI()
end

local closePhysicsPopup

local function importTakeTo7kg2(onFinished)
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	if RunService:IsRunning() then
		setStatus("Stop Run mode before importing the captured take.", THEME.yellow)
		if type(onFinished) == "function" then
			onFinished(false, "Stop Run mode before importing the captured take.")
		end
		return
	end
	if not state.take then
		setStatus("Capture a physics take before importing.", THEME.yellow)
		if type(onFinished) == "function" then
			onFinished(false, "Capture a physics take before importing.")
		end
		return
	end
	local requestEvent = CoreGui:FindFirstChild(IMPORT_EVENT_NAME)
	local resultEvent = CoreGui:FindFirstChild(IMPORT_RESULT_EVENT_NAME)
	if not (requestEvent and requestEvent:IsA("BindableEvent") and requestEvent:GetAttribute("MegMoBridgeReady") == true) then
		setStatus(
			state.take and state.take.objectOnly
				and "Open 7kg2 before importing the captured object tracks."
				or "Open 7kg2 and add the captured rig to its timeline before importing.",
			THEME.yellow
		)
		if type(onFinished) == "function" then
			onFinished(false, "7kg2's physics import bridge is not ready.")
		end
		return
	end
	if not (resultEvent and resultEvent:IsA("BindableEvent")) then
		setStatus("7kg2's physics import result bridge is not ready. Reopen 7kg2 and try again.", THEME.yellow)
		if type(onFinished) == "function" then
			onFinished(false, "7kg2's physics import result bridge is not ready.")
		end
		return
	end
	local objectCapture, objectKeyCount = TakeBaker.CreateObjectCapture(state.take, state.getObjectCaptureTargets())
	local explosionVFX = state.explosionVFXSupport.BuildBakeEntries(state.take and state.take.physicsEvents)
	if #state.rigTakes &gt; 1 then
		if state.multiRigRagdollSupport.FindDuplicateName(state.selectedRigs) then
			objectCapture = TakeBaker.CreateMultiRigObjectCapture(state.rigTakes, state.selectedRigs)
		end
		local importEntries = {}
		local sequences = {}
		local totalKeyCount = 0
		for index, capturedTake in ipairs(state.rigTakes) do
			local sequence, message, keyCount = TakeBaker.CreateSequence(capturedTake)
			if not sequence then
				for _, createdSequence in ipairs(sequences) do
					createdSequence:Destroy()
				end
				setStatus(message, THEME.red)
				if type(onFinished) == "function" then
					onFinished(false, message)
				end
				return
			end
			table.insert(sequences, sequence)
			local captureEntry = state.rigCaptureEntries[index]
			table.insert(importEntries, {
				rig = state.selectedRigs[index] or captureEntry and captureEntry.rig or nil,
				rigName = capturedTake.rigName,
				sequence = sequence,
				take = capturedTake,
			})
			totalKeyCount += keyCount
		end
		local requestId = HttpService:GenerateGUID(false)
		local resultConnection
		resultConnection = resultEvent.Event:Connect(function(result)
			if type(result) ~= "table" or result.source ~= "MegMoAnimator" or result.requestId ~= requestId then
				return
			end
			resultConnection:Disconnect()
			for _, sequence in ipairs(sequences) do
				sequence:Destroy()
			end
			if result.success then
				workflowUX:Clear()
			end
			setStatus(result.message, result.success and THEME.green or THEME.red)
			updateUI()
			if type(onFinished) == "function" then
				onFinished(result.success == true, result.message, result)
			end
			if result.success == true and closePhysicsPopup then
				closePhysicsPopup()
			end
		end)
		setStatus(string.format(
			"Importing %d synchronized ragdoll keys for %d characters at 7kg2's current playhead...",
			totalKeyCount,
			#importEntries
		), THEME.cyan)
		updateUI()
		requestEvent:Fire({
			action = "ImportMultiRigTake",
			source = "MegMoPhysicsCapturePrototype",
			requestId = requestId,
			rigs = importEntries,
			objects = objectCapture,
			vfx = explosionVFX,
			sourceLabel = "Ragdoll Capture",
			usesInternalRigIds = state.multiRigRagdollSupport.FindDuplicateName(state.selectedRigs) ~= nil,
		})
		return
	end
	if state.take and state.take.objectOnly then
		if #objectCapture == 0 and #explosionVFX == 0 then
			setStatus("The selected objects did not move enough to create CFrame keys.", THEME.yellow)
			if type(onFinished) == "function" then
				onFinished(false, "The selected objects did not move enough to create CFrame keys.")
			end
			return
		end
		local requestId = HttpService:GenerateGUID(false)
		local resultConnection
		resultConnection = resultEvent.Event:Connect(function(result)
			if type(result) ~= "table" or result.source ~= "MegMoAnimator" or result.requestId ~= requestId then
				return
			end
			resultConnection:Disconnect()
			if result.success then
				workflowUX:Clear()
			end
			setStatus(result.message, result.success and THEME.green or THEME.red)
			updateUI()
			if type(onFinished) == "function" then
				onFinished(result.success == true, result.message, result)
			end
			if result.success == true and closePhysicsPopup then
				closePhysicsPopup()
			end
		end)
		local importFrame = state.take.releaseToPhysics
			and state.releaseData
			and state.releaseData.releaseFrame
			or state.animatedPath
				and (state.animatedPath.importFrame or state.animatedPath.startFrame)
			or nil
		setStatus(string.format(
			"Importing %d object physics key%s%s...",
			objectKeyCount,
			objectKeyCount == 1 and "" or "s",
			importFrame and string.format(" at frame %d", importFrame) or " at 7kg2's current playhead"
		), THEME.cyan)
		updateUI()
		requestEvent:Fire({
			action = "ImportObjectTake",
			source = "MegMoPhysicsCapturePrototype",
			requestId = requestId,
			objects = objectCapture,
			vfx = explosionVFX,
			sourceLabel = state.take.releaseToPhysics and "Release to Physics" or "Physics Objects",
			importFrame = importFrame,
		})
		return
	end

	local sequence, message, keyCount = TakeBaker.CreateSequence(state.take)
	if not sequence then
		setStatus(message, THEME.red)
		if type(onFinished) == "function" then
			onFinished(false, message)
		end
		return
	end

	local requestId = HttpService:GenerateGUID(false)
	local resultConnection
	resultConnection = resultEvent.Event:Connect(function(result)
		if type(result) ~= "table" or result.source ~= "MegMoAnimator" or result.requestId ~= requestId then
			return
		end
		if resultConnection then
			resultConnection:Disconnect()
			resultConnection = nil
		end
		sequence:Destroy()
		if result.success then
			workflowUX:Clear()
		end
		setStatus(result.message, result.success and THEME.green or THEME.red)
		updateUI()
		if type(onFinished) == "function" then
			onFinished(result.success == true, result.message, result)
		end
		if result.success == true and closePhysicsPopup then
			closePhysicsPopup()
		end
	end)

	local importFrame = state.animatedPath and (state.animatedPath.importFrame or state.animatedPath.handoffFrame) or nil
	setStatus(string.format(
		"Importing %d rig keys and %d scene keys%s...",
		keyCount,
		objectKeyCount,
		importFrame and string.format(" at frame %d", importFrame) or " at 7kg2's current playhead"
	), THEME.cyan)
	updateUI()
	requestEvent:Fire({
		source = "MegMoPhysicsCapturePrototype",
		requestId = requestId,
		rig = state.selectedRig,
		rigName = state.take and state.take.rigName or (state.selectedRig and state.selectedRig.Name),
		sequence = sequence,
		objects = objectCapture,
		vfx = explosionVFX,
		take = state.take,
		importFrame = importFrame,
		sourceLabel = "Physics Capture",
	})
end

state.quickPhysicsActions.BeginPreparedCapture = function()
	if not isWorkflowReady() then
		state.quickPhysicsSupport.CancelCapture(state.quickPhysics)
		setStatus("Select the physics subject and finish its required setup before previewing.", THEME.yellow)
		updateUI()
		return
	end
	state.quickPhysicsSupport.BeginCapture(
		state.quickPhysics,
		state.releaseObject and state.releaseObject.Parent and state.releaseObject.Name
			or #Selection:Get() == 1 and Selection:Get()[1].Name
			or string.format("%d selected objects", #Selection:Get())
	)
	state.uiStage = "Capture"
	state.setupPage = "Prepare"
	setStatus("Starting the physics simulation. Kinetic will stop automatically; preview the captured take when ready.", THEME.cyan)
	updateUI()
	startOrStopRun()
end

state.quickPhysicsActions.Preview = function()
	if state.previewSession then
		toggleTakePreview()
		return
	end
	if RunService:IsRunning() then
		setStatus("The quick physics simulation is still running.", THEME.yellow)
		return
	end
	if state.take and (state.quickPhysics.phase == "Review" or state.quickPhysics.phase == "Kept") then
		state.quickPhysics.phase = "Previewing"
		updateUI()
		toggleTakePreview()
		return
	end

	chooseEffectMode(state.quickPhysics.effectMode)
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	selectRig()
	if #state.objectTargets == 0 then
		state.quickPhysics.phase = "Configure"
		updateUI()
		return
	end
	if state.quickPhysics.effectMode == "Release" then
		state.quickPhysics.phase = "Loading"
		updateUI()
		loadAnimatedPath(function(success)
			if success then
				state.quickPhysicsActions.BeginPreparedCapture()
			else
				state.quickPhysics.phase = "Configure"
				updateUI()
			end
		end)
		return
	end
	state.quickPhysicsActions.BeginPreparedCapture()
end

state.quickPhysicsActions.Keep = function()
	if not (state.take and not state.previewSession and not RunService:IsRunning()) then
		setStatus("Preview a completed physics take before keeping it.", THEME.yellow)
		return
	end
	state.quickPhysics.phase = "Importing"
	updateUI()
	importTakeTo7kg2(function(success)
		state.quickPhysics.phase = success and "Kept" or "Review"
		updateUI()
	end)
end

state.quickPhysicsActions.Retry = function()
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	if RunService:IsRunning() then
		setStatus("Finish the current simulation before retrying.", THEME.yellow)
		return
	end
	state.quickPhysics.phase = "Configure"
	state.quickPhysics.activeCapture = false
	state.quickPhysics.autoPreview = false
	updateUI()
	state.quickPhysicsActions.Preview()
end

state.quickPhysicsActions.OpenAdvanced = function(effectMode)
	state.quickPhysics.visible = false
	chooseEffectMode(effectMode or state.quickPhysics.effectMode)
	state.uiStage = "Setup"
	state.setupPage = "Prepare"
	state.advancedVisible = false
	state.refreshWorkflowUX()
	local selectionAdopted = false
	if state.effectMode == "Drop" or state.effectMode == "Scene" or state.effectMode == "Explosion" then
		if #Selection:Get() &gt; 0 then
			selectRig()
			selectionAdopted = #state.objectTargets &gt; 0
		end
	elseif state.effectMode == "Character" or state.effectMode == "AdaptiveWalk" then
		if findSelectedRig() then
			selectRig()
			selectionAdopted = state.selectedRig ~= nil
		end
	elseif state.effectMode == "Impact" then
		for _, selected in ipairs(Selection:Get()) do
			if selected:IsA("BasePart") or selected:IsA("Model") then
				selectImpactDriver()
				selectionAdopted = state.driverObject ~= nil
				break
			end
		end
	end
	if not selectionAdopted then
		setStatus("Setup is open. Follow the highlighted next step.", THEME.cyan)
	end
	updateUI()
end

