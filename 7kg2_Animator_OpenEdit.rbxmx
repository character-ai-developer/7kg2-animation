	state.ragdollSession = nil
	state.ragdollCapture = nil
	state.runtimeRig = nil
	state.runtimeRigs = {}
	state.runtimeDriver = nil
	state.take = nil
	state.rigTakes = {}
	state.takes = {}
	state.takeIndex = 0
	state.previewSession = nil
	state.impactTime = nil
	state.ragdollTime = nil
	state.quickPhysics = state.quickPhysicsSupport.NewState()
	workflowUX:Clear()
	setStatus(
		restoredObjects &gt; 0
			and string.format("Physics reset. Restored %d captured object%s to the original position.", restoredObjects, restoredObjects == 1 and "" or "s")
			or "Physics reset. Choose a physics effect to begin again.",
		THEME.green
	)
	updateUI()
end)

connect(RunService.PreSimulation, function(deltaTime)
	if state.armed and not state.capturing and state.captureMode == "Objects"
		and (state.effectMode == "Drop" or state.effectMode == "Scene") then
		beginRuntimeCapture()
	end
	if state.ragdollCapture then
		state.multiRigRagdollSupport.StepRagdolls(state.ragdollCapture, deltaTime)
	elseif state.ragdollSession then
		RagdollRuntime.Step(state.ragdollSession, deltaTime)
	end
	if state.physicsDriveSession then
		PhysicsDriveRuntime.Step(state.physicsDriveSession, deltaTime)
	end
	if state.eventSession then
		local firedCount = state.eventRuntime.Step(state.eventSession, deltaTime)
		if firedCount &gt; 0 and state.impactTime == nil then
			state.impactTime = tonumber(state.recorder and state.recorder.elapsed) or 0
		end
	end
	if state.adaptiveWalkSession then
		local _, reason = AdaptiveWalkRuntime.Step(state.adaptiveWalkSession, deltaTime)
		if reason == "complete" then
			state.adaptiveWalkComplete = true
		end
		return
	end
	if not state.pathSession then
		return
	end
	local _, reason, pathLinearVelocity, pathAngularVelocity = AnimatedPathRuntime.Step(state.pathSession, deltaTime)
	if state.pathMode == "DrivenImpact" then
		ImpactBreakRuntime.CheckDrivenCollision(state.impactSession, pathLinearVelocity)
	end
	if reason == "complete" then
		local completedSession = state.pathSession
		if state.effectMode == "Impact" then
			AnimatedPathRuntime.HoldAtEnd(completedSession)
			state.heldPathSession = completedSession
			state.pathSession = nil
			setStatus("The Moving Object reached its final key and is held in place. Debris physics is still recording; click Finish &amp; Review when ready.", THEME.cyan)
			updateUI()
			return
		end
		local linearVelocity, angularVelocity = AnimatedPathRuntime.Finish(completedSession)
		if typeof(pathLinearVelocity) == "Vector3" then
			linearVelocity = pathLinearVelocity
		end
		if typeof(pathAngularVelocity) == "Vector3" then
			angularVelocity = pathAngularVelocity
		end
		state.pathSession = nil
		local recorder = state.pathMode == "DrivenImpact" and state.recorder or nil
		if not beginPhysicsPhase(state.runtimeRig, state.runtimeTargets or {}, linearVelocity, angularVelocity, recorder) then
			finishRuntimeCapture("The animated path finished, but physics could not start.")
		end
	end
end)

connect(RunService.PostSimulation, function(deltaTime)
	if not (state.capturing and state.recorder) then
		return
	end
	if state.impactTime == nil and state.impactSession and state.impactSession.released then
		state.impactTime = tonumber(state.recorder.elapsed) or 0
	end
	local reason = nil
	if state.ragdollCapture then
		reason = state.multiRigRagdollSupport.StepRecorders(state.ragdollCapture, deltaTime)
	else
		local _
		_, reason = state.recorder:Step(deltaTime)
	end
	if state.startingPushTestMode
		and (tonumber(state.recorder.elapsed) or 0) &gt;= state.startingPushTestDuration then
		finishStartingPushTest(nil, true)
		return
	end
	if state.effectMode == "Explosion"
		and state.eventPlaybackSpeed &lt; 1
		and not state.eventTestMode then
		state.startEventTestLivePreview()
	end
	if state.eventTestMode then
		if state.eventSession
			and state.eventSession.complete
			and state.quickPhysicsSupport.TargetsAreSettled(state.recorder.objectParts or state.runtimeTargets, 0.25, 0.25) then
			state.eventTestSettledDuration += math.max(0, tonumber(deltaTime) or 0)
		else
			state.eventTestSettledDuration = 0
		end
		if state.eventTestSettledDuration &gt;= 1 then
			if state.eventTestLivePreviewSession then
				state.finishEventTestLiveCapture("Physics calculated. Finishing the visible slow-motion test...")
			else
				state.eventActions.FinishTest(
					"Explosion test complete. The affected objects stopped moving, and the scene has been restored.",
					true
				)
			end
			return
		end
		if (tonumber(state.recorder.elapsed) or 0) &gt;= state.eventTestDuration then
			if state.eventTestLivePreviewSession then
				state.finishEventTestLiveCapture("Physics reached its safety limit. Finishing the visible slow-motion test...")
			else
				state.eventActions.FinishTest(
					"Explosion test reached its safety limit. The scene has been restored.",
					true
				)
			end
			return
		end
	end
	local quickFinished, quickFinishReason = state.quickPhysicsSupport.ShouldFinish(
		state.quickPhysics,
		state.recorder,
		state.runtimeTargets,
		deltaTime
	)
	if quickFinished then
		state.quickPhysics.activeCapture = false
		state.quickPhysics.autoPreview = false
		state.quickPhysics.phase = "Review"
		local finishMessage = quickFinishReason == "settled"
			and "Physics settled. Return to Edit mode, then click Preview Take when ready."
			or "Physics capture finished. Return to Edit mode, then click Preview Take when ready."
		if state.eventTestLivePreviewSession then
			state.finishEventTestLiveCapture(finishMessage)
		else
			finishRuntimeCapture(finishMessage)
			task.defer(function()
				pcall(function()
					RunService:Stop()
				end)
			end)
		end
	elseif state.adaptiveWalkComplete then
		if state.fullEffectTestMode then
			finishStartingPushTest("Adaptive Walk test complete. The scene has been restored.", true)
		else
			finishRuntimeCapture("Adaptive Walk captured. Review the take, then import it to 7kg2 as editable keyframes.")
		end
		task.defer(function()
			pcall(function()
				RunService:Stop()
			end)
		end)
	elseif state.physicsDriveSession and state.physicsDriveSession.assistFinished then
		local driveSession = state.physicsDriveSession
		local looseTargets = state.runtimeTargets or {}
		local hasLooseTargets = #looseTargets &gt; 0
		local looseTargetsSettled = hasLooseTargets
			and state.quickPhysicsSupport.TargetsAreSettled(looseTargets, 0.25, 0.25)
		driveSession.looseSettledDuration = looseTargetsSettled
			and (tonumber(driveSession.looseSettledDuration) or 0) + math.max(0, tonumber(deltaTime) or 0)
			or 0
		if not hasLooseTargets or driveSession.looseSettledDuration &gt;= 0.5 then
			if state.fullEffectTestMode then
				finishStartingPushTest("Drive &amp; Impact test complete. The scene has been restored.", true)
			else
				finishRuntimeCapture("Physics Drive finished and the loose objects stopped moving. Review the full take, then continue to Bake.")
			end
			task.defer(function()
				pcall(function()
					RunService:Stop()
				end)
			end)
		elseif reason == "limit" then
			if state.fullEffectTestMode then
				finishStartingPushTest("Drive &amp; Impact reached the maximum take length. The scene has been restored.", true)
			else
				finishRuntimeCapture("Maximum take length reached while loose objects were still moving. Review the captured take, then continue to Bake.")
			end
			task.defer(function()
				pcall(function()
					RunService:Stop()
				end)
			end)
		else
			if not driveSession.tailCaptureAnnounced then
				driveSession.tailCaptureAnnounced = true
				setStatus("The Moving Object reached its endpoint. Loose objects are still recording until they settle; click Finish &amp; Review to stop early.", THEME.cyan)
				updateUI()
			end
			if refs.take then
				refs.take.Text = string.format(
					"Recording\n%s | %d samples | %d FPS",
					formatDuration(state.recorder.elapsed),
					#state.recorder.take.samples,
					state.fps
				)
			end
		end
	elseif reason == "limit" then
		if state.eventTestLivePreviewSession then
			state.finishEventTestLiveCapture("Maximum take length reached. Finishing the selected-speed Explosion playback...")
		elseif state.fullEffectTestMode then
			finishStartingPushTest(nil, true)
		else
			finishRuntimeCapture("Maximum take length reached. Stop Run mode and bake the take.")
		end
	elseif refs.take then
		refs.take.Text = string.format(
			"Recording\n%s | %d samples | %d FPS",
			formatDuration(state.recorder.elapsed),
			#state.recorder.take.samples,
			state.fps
		)
	end
end)

connect(RunService.Heartbeat, function()
	local themeChanged, previousMuted = PhysicsThemeSupport.ApplyIfChanged(root, THEME)
	if themeChanged then
		if state.statusTone == previousMuted then
			state.statusTone = THEME.muted
		end
		updateUI()
	end
	local running = RunService:IsRunning()
	if running and state.armed and not state.capturing then
		beginRuntimeCapture()
	elseif not running and state.capturing then
		if state.startingPushTestMode then
			finishStartingPushTest(
				state.fullEffectTestMode
					and "Physics test stopped. The scene has been restored."
					or "Starting Push test stopped. Adjust the speed and test again when ready.",
				false
			)
		elseif state.eventTestMode then
			state.eventActions.FinishTest("Explosion test stopped. The scene has been restored.", false)
		else
			finishRuntimeCapture("Simulation stopped. The captured take is ready to bake.")
		end
	end
	if not running and state.quickPhysics.activeCapture and not state.capturing and not state.armed then
		state.quickPhysics.activeCapture = false
		if state.take then
			state.quickPhysics.autoPreview = false
			state.quickPhysics.phase = "Review"
		else
			state.quickPhysicsSupport.CancelCapture(state.quickPhysics)
		end
	end
	if running ~= state.wasRunning then
		state.wasRunning = running
		updateUI()
	end
end)

connect(refs.popupGui:GetPropertyChangedSignal("Enabled"), function()
	if refs.popupGui.Enabled then
		state.refreshWorkflowUX()
	else
		workflowUX:Clear()
		projectilePathUX:Clear()
		state.startingPushUX:SetVisible(false)
	end
	if not refs.popupGui.Enabled and state.armed and not state.capturing then
		state.armed = false
		SceneCaptureScope.ClearRuntimeIds(state.objectTargets, true)
		state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets, true)
		setStatus("Capture disarmed because the Physics window was closed.", THEME.muted)
	end
end)

plugin.Unloading:Connect(function()
	if state.eventTestLivePreviewSession then
		TakePreviewRuntime.Stop(state.eventTestLivePreviewSession, false)
		state.eventTestLivePreviewSession = nil
	end
	state.eventTestLiveCaptureComplete = false
	state.restoreEventTestRuntimeTargets()
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
		if state.effectMode == "Character" then
			restoreRagdollOriginal()
		end
		state.restorePreviewScene()
	end
	SceneCaptureScope.ClearRuntimeIds(state.objectTargets)
	state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets)
	RiderRuntime.ClearRuntimeIds(state.riderTargets)
	clearDriverAttribute()
	AnimatedPathRuntime.Cancel(state.pathSession)
	AnimatedPathRuntime.Cancel(state.heldPathSession)
	restoreAdaptiveWalkOriginal()
	RiderRuntime.Cancel(state.riderRuntimeSession)
	PhysicsDriveRuntime.Cancel(state.physicsDriveSession)
	state.eventRuntime.Cancel(state.eventSession)
	ImpactBreakRuntime.Restore(state.impactSession)
	if state.ragdollCapture then
		state.multiRigRagdollSupport.StopRecorders(state.ragdollCapture)
		state.multiRigRagdollSupport.RestoreSessions(state.ragdollCapture)
	elseif state.ragdollSession then
		RagdollRuntime.Restore(state.ragdollSession)
	end
	restoreRagdollOriginal()
	for _, item in ipairs(state.runtimeObjectAnchors or {}) do
		if item.part and item.part.Parent then
			item.part.CustomPhysicalProperties = item.customPhysicalProperties
			item.part.Anchored = item.anchored
		end
	end
	clearCaptureAttribute()
	workflowUX:Destroy()
	projectilePathUX:Destroy()
	state.startingPushUX:Destroy()
	if state.quickPhysicsPanel then
		state.quickPhysicsPanel:Destroy()
		state.quickPhysicsPanel = nil
	end
	if state.popupInteraction then
		state.popupInteraction:Destroy()
		state.popupInteraction = nil
	end
	if state.guidedMode then
		state.guidedMode:Destroy()
		state.guidedMode = nil
	end
	if openPhysicsEvent and openPhysicsEvent.Parent then
		openPhysicsEvent:Destroy()
	end
	if refs.popupGui and refs.popupGui.Parent then
		refs.popupGui:Destroy()
	end
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
end)

updateUI()
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX44">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="Folder" referent="RBX45">
        <Properties>
          <string name="Name">AnimationConversion</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX46">
          <Properties>
            <string name="Name">R15ToR6Converter</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local AnimationClipProvider = game:GetService("AnimationClipProvider")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local R15ToR6Converter = {}

local TEMP_FOLDER_NAME = "MegMo_TempConversion"
local OUTPUT_FOLDER_NAME = "MegMoR15ToR6Converted"
local EMPTY_ANIMATION_MESSAGE =
	"Roblox did not provide keyframes for this Animation ID. It may be private, deleted, moderated, owned by another creator/group, or unavailable to this place. Try a local KeyframeSequence or an animation you own/can access."
local CURVE_SAMPLE_RATE = 1 / 30

local R15_SIGNATURE_POSES = {
	"UpperTorso",
	"LowerTorso",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
}

local R15_TEMPLATE_PARTS = {
	"HumanoidRootPart",
	"LowerTorso",
	"UpperTorso",
	"Head",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
}

local R6_TEMPLATE_PARTS = {
	"HumanoidRootPart",
	"Torso",
	"Head",
	"Right Arm",
	"Left Arm",
	"Right Leg",
	"Left Leg",
}

local LIMB_TARGETS = {
	["Right Arm"] = {
		endPart = "RightHand",
		fallbackPart = "RightLowerArm",
		easingPart = "RightHand",
	},
	["Left Arm"] = {
		endPart = "LeftHand",
		fallbackPart = "LeftLowerArm",
		easingPart = "LeftHand",
	},
	["Right Leg"] = {
		endPart = "RightFoot",
		fallbackPart = "RightLowerLeg",
		easingPart = "RightFoot",
	},
	["Left Leg"] = {
		endPart = "LeftFoot",
		fallbackPart = "LeftLowerLeg",
		easingPart = "LeftFoot",
	},
}

local function getOrCreateFolder(parent, name)
	local folder = parent:FindFirstChild(name)
	if folder then
		return folder
	end
	folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function getTempFolder()
	local folder = workspace:FindFirstChild(TEMP_FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = TEMP_FOLDER_NAME
		folder.Archivable = false
		folder.Parent = workspace
	end
	return folder
end

local function getKeyframeCount(sequence)
	if not (sequence and sequence:IsA("KeyframeSequence")) then
		return nil
	end
	local ok, keyframes = pcall(function()
		return sequence:GetKeyframes()
	end)
	if ok and type(keyframes) == "table" then
		return #keyframes
	end
	return nil
end

local function prepareHiddenRig(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Transparency = 1
			descendant.Locked = true
		elseif descendant:IsA("Decal") then
			descendant.Transparency = 1
		end
	end
	rig.Archivable = false
end

local function convertAnimationConstraintsToMotors(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			local attachment0 = descendant.Attachment0
			local attachment1 = descendant.Attachment1
			if attachment0
				and attachment1
				and attachment0.Parent
				and attachment1.Parent
				and attachment0.Parent:IsA("BasePart")
				and attachment1.Parent:IsA("BasePart") then
				local motor = Instance.new("Motor6D")
				motor.Name = descendant.Name
				motor.Part0 = attachment0.Parent
				motor.Part1 = attachment1.Parent
				motor.C0 = attachment0.CFrame
				motor.C1 = attachment1.CFrame
				motor.Parent = attachment0.Parent
			end
			descendant:Destroy()
		end
	end
end

local function countMotor6Ds(model)
	local count = 0
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part0 and descendant.Part1 then
			count += 1
		end
	end
	return count
end

local function hasAllParts(model, names)
	for _, name in ipairs(names) do
		local found = model:FindFirstChild(name, true)
		if not (found and found:IsA("BasePart")) then
			return false
		end
	end
	return true
end

local function isTemplateRig(model, rigType)
	if not model:IsA("Model") then
		return false
	end
	if countMotor6Ds(model) &lt;= 0 then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if rigType == "R15" and humanoid.RigType == Enum.HumanoidRigType.R15 then
			return true
		end
		if rigType == "R6" and humanoid.RigType == Enum.HumanoidRigType.R6 then
			return true
		end
	end

	return hasAllParts(model, rigType == "R15" and R15_TEMPLATE_PARTS or R6_TEMPLATE_PARTS)
end

local function findTemplateRig(rigType)
	local searchRoots = {
		workspace,
		ServerStorage,
		ReplicatedStorage,
	}
	for _, root in ipairs(searchRoots) do
		for _, descendant in ipairs(root:GetDescendants()) do
			if isTemplateRig(descendant, rigType) then
				return descendant
			end
		end
	end
	return nil
end

local function createReferenceRig(rigType)
	local description = Instance.new("HumanoidDescription")
	local humanoidRigType = rigType == "R6" and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
	local generatedRig = nil
	local generatedOk = pcall(function()
		generatedRig = Players:CreateHumanoidModelFromDescription(description, humanoidRigType)
	end)
	if generatedOk and generatedRig then
		generatedRig.Name = "MegMo_" .. rigType .. "_ReferenceRig"
		convertAnimationConstraintsToMotors(generatedRig)
		if countMotor6Ds(generatedRig) &gt; 0 then
			prepareHiddenRig(generatedRig)
			generatedRig.Parent = getTempFolder()
			pcall(function()
				generatedRig:PivotTo(CFrame.new())
			end)
			return generatedRig
		end
		generatedRig:Destroy()
	end

	local template = findTemplateRig(rigType)
	if template then
		local rig = template:Clone()
		rig.Name = "MegMo_" .. rigType .. "_ReferenceRig"
		convertAnimationConstraintsToMotors(rig)
		prepareHiddenRig(rig)
		rig.Parent = getTempFolder()
		pcall(function()
			rig:PivotTo(CFrame.new())
		end)
		return rig
	end

	error("Could not create a " .. rigType .. " reference rig with Motor6D joints. Add a neutral " .. rigType .. " rig to the place and try again.")
end

local function indexRig(rig)
	local index = {
		rig = rig,
		partsByName = {},
		motorsByPart1 = {},
		motorsByName = {},
		childrenByPart0 = {},
	}

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			index.partsByName[descendant.Name] = descendant
		elseif descendant:IsA("Motor6D") and descendant.Part0 and descendant.Part1 then
			local motorData = {
				motor = descendant,
				part0 = descendant.Part0,
				part1 = descendant.Part1,
				c0 = descendant.C0,
				c1 = descendant.C1,
			}
			index.motorsByPart1[descendant.Part1.Name] = motorData
			index.motorsByName[descendant.Name] = motorData
			index.childrenByPart0[descendant.Part0.Name] = index.childrenByPart0[descendant.Part0.Name] or {}
			table.insert(index.childrenByPart0[descendant.Part0.Name], motorData)
		end
	end

	return index
end

local function captureMotorDefaults(index)
	local defaults = {}
	for _, motorData in pairs(index.motorsByPart1) do
		defaults[motorData.motor] = motorData.c0
	end
	return defaults
end

local function resetMotors(defaults)
	for motor, c0 in pairs(defaults) do
		if motor and motor.Parent then
			motor.C0 = c0
		end
	end
end

local function applyPoseMapToRig(index, poseMap)
	resetMotors(index.defaults or {})
	for poseName, poseCFrame in pairs(poseMap) do
		local motorData = index.motorsByPart1[poseName]
		if motorData and index.defaults and index.defaults[motorData.motor] then
			motorData.motor.C0 = index.defaults[motorData.motor] * poseCFrame
		end
	end
end

local function collectPoseMap(keyframe)
	local poseMap = {}
	local poseObjects = {}
	local function visit(instance)
		for _, child in ipairs(instance:GetChildren()) do
			if child:IsA("Pose") then
				poseMap[child.Name] = child.CFrame
				poseObjects[child.Name] = child
				visit(child)
			end
		end
	end
	visit(keyframe)
	return poseMap, poseObjects
end

local function hasR15PoseNames(keyframeSequence)
	local found = {}
	for _, descendant in ipairs(keyframeSequence:GetDescendants()) do
		if descendant:IsA("Pose") then
			found[descendant.Name] = true
		end
	end
	local r15SignatureCount = 0
	for _, name in ipairs(R15_SIGNATURE_POSES) do
		if found[name] then
			r15SignatureCount += 1
		end
	end
	return r15SignatureCount &gt;= 2
end

local function computeRigWorldCFrames(index, poseMap, rootCFrame)
	local world = {}
	local root = index.partsByName.HumanoidRootPart
	if not root then
		return world
	end

	world.HumanoidRootPart = rootCFrame or CFrame.new()
	local function solveChildren(partName)
		for _, motorData in ipairs(index.childrenByPart0[partName] or {}) do
			local transform = poseMap[motorData.part1.Name] or poseMap[motorData.motor.Name] or CFrame.new()
			local part0World = world[motorData.part0.Name]
			if part0World then
				world[motorData.part1.Name] = part0World * motorData.c0 * transform * motorData.c1:Inverse()
				solveChildren(motorData.part1.Name)
			end
		end
	end

	solveChildren("HumanoidRootPart")
	return world
end

local function readActualRigWorldCFrames(index)
	local world = {}
	for name, part in pairs(index.partsByName) do
		world[name] = part.CFrame
	end
	return world
end

local function applyWorldCFramesToRig(index, world)
	for name, cf in pairs(world) do
		local part = index.partsByName[name]
		if part then
			part.CFrame = cf
		end
	end
end

local function copySequenceProperties(source, target)
	target.Name = (source.Name ~= "" and source.Name or "ConvertedAnimation") .. "_R6"
	pcall(function()
		target.Loop = source.Loop
	end)
	pcall(function()
		target.Priority = source.Priority
	end)
	pcall(function()
		target.AuthoredHipHeight = source.AuthoredHipHeight
	end)
end

local function parseAnimationId(animationId)
	local text = tostring(animationId or "")
	text = text:match("^%s*(.-)%s*$") or ""
	local id = text:match("rbxassetid://(%d+)")
		or text:match("[?&amp;]id=(%d+)")
		or text:match("/(%d+)")
		or text:match("^(%d+)$")
		or text:match("(%d+)")
	if not id then
		error("Enter a Roblox animation ID or URL.")
	end
	return "rbxassetid://" .. id, id
end

local function addTime(timesByKey, time)
	if typeof(time) ~= "number" or time ~= time or time &lt; 0 then
		return
	end
	local rounded = math.floor(time * 100000 + 0.5) / 100000
	timesByKey[string.format("%.5f", rounded)] = rounded
end

local function collectCurveKeyTimes(curveAnimation)
	local timesByKey = {}
	local length = tonumber(curveAnimation.Length) or 0
	addTime(timesByKey, 0)
	if length &gt; 0 then
		local sampleCount = math.max(1, math.ceil(length / CURVE_SAMPLE_RATE))
		for index = 0, sampleCount do
			addTime(timesByKey, math.min(length, index * CURVE_SAMPLE_RATE))
		end
		addTime(timesByKey, length)
	end
	for _, descendant in ipairs(curveAnimation:GetDescendants()) do
		if descendant:IsA("FloatCurve") or descendant:IsA("RotationCurve") then
			local ok, keys = pcall(function()
				return descendant:GetKeys()
			end)
			if ok and type(keys) == "table" then
				for _, key in ipairs(keys) do
					addTime(timesByKey, key.Time)
				end
			end
		end
	end
	local times = {}
	for _, time in pairs(timesByKey) do
		table.insert(times, time)
	end
	table.sort(times)
	return times
end

local function getFolderPath(folder, root)
	local path = {}
	local current = folder
	while current and current ~= root do
		if current:IsA("Folder") then
			table.insert(path, 1, current.Name)
		end
		current = current.Parent
	end
	return path
end

local function collectCurveRecords(curveAnimation)
	local records = {}
	for _, descendant in ipairs(curveAnimation:GetDescendants()) do
		if descendant:IsA("Folder") then
			local positionCurve = descendant:FindFirstChild("Position")
			local rotationCurve = descendant:FindFirstChild("Rotation")
			if positionCurve and not positionCurve:IsA("Vector3Curve") then
				positionCurve = nil
			end
			if rotationCurve and not (rotationCurve:IsA("EulerRotationCurve") or rotationCurve:IsA("RotationCurve")) then
				rotationCurve = nil
			end
			if positionCurve or rotationCurve then
				local path = getFolderPath(descendant, curveAnimation)
				if #path == 0 then
					continue
				end
				table.insert(records, {
					path = path,
					positionCurve = positionCurve,
					rotationCurve = rotationCurve,
				})
			end
		end
	end
	return records
end

local function readVector3CurveAtTime(curve, time)
	if not curve then
		return Vector3.zero
	end
	local ok, a, b, c = pcall(function()
		return curve:GetValueAtTime(time)
	end)
	if not ok then
		return Vector3.zero
	end
	if typeof(a) == "Vector3" then
		return a
	end
	if type(a) == "table" then
		return Vector3.new(tonumber(a[1]) or 0, tonumber(a[2]) or 0, tonumber(a[3]) or 0)
	end
	return Vector3.new(tonumber(a) or 0, tonumber(b) or 0, tonumber(c) or 0)
end

local function readRotationCurveAtTime(curve, time)
	if not curve then
		return CFrame.new()
	end
	if curve:IsA("EulerRotationCurve") then
		local ok, rotation = pcall(function()
			return curve:GetRotationAtTime(time)
		end)
		return ok and rotation or CFrame.new()
	end
	if curve:IsA("RotationCurve") then
		local ok, rotation = pcall(function()
			return curve:GetValueAtTime(time)
		end)
		return ok and rotation or CFrame.new()
	end
	return CFrame.new()
end

local function getOrCreatePose(parent, poseName)
	local pose = parent:FindFirstChild(poseName)
	if pose and pose:IsA("Pose") then
		return pose
	end
	pose = Instance.new("Pose")
	pose.Name = poseName
	pose.Parent = parent
	return pose
end

local function createPoseForPath(keyframe, path, cframe)
	local parent = keyframe
	for _, poseName in ipairs(path) do
		parent = getOrCreatePose(parent, poseName)
	end
	parent.CFrame = cframe or CFrame.new()
	return parent
end

local function curveAnimationToKeyframeSequence(curveAnimation, nameOverride)
	local records = collectCurveRecords(curveAnimation)
	if #records == 0 then
		error("This CurveAnimation did not contain any Motor6D/Bone transform curves the converter can sample.")
	end
	local times = collectCurveKeyTimes(curveAnimation)
	if #times == 0 then
		error(EMPTY_ANIMATION_MESSAGE)
	end
	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = nameOverride or curveAnimation.Name
	pcall(function()
		sequence.Loop = curveAnimation.Loop
	end)
	pcall(function()
		sequence.Priority = curveAnimation.Priority
	end)
	for _, time in ipairs(times) do
		local keyframe = Instance.new("Keyframe")
		keyframe.Name = "Keyframe"
		keyframe.Time = time
		for _, record in ipairs(records) do
			local position = readVector3CurveAtTime(record.positionCurve, time)
			local rotation = readRotationCurveAtTime(record.rotationCurve, time)
			createPoseForPath(keyframe, record.path, CFrame.new(position) * rotation)
		end
		keyframe.Parent = sequence
	end
	return sequence
end

local function copyPoseProperties(sourcePose, targetPose)
	if not sourcePose then
		return
	end
	pcall(function()
		targetPose.EasingStyle = sourcePose.EasingStyle
	end)
	pcall(function()
		targetPose.EasingDirection = sourcePose.EasingDirection
	end)
	pcall(function()
		targetPose.Weight = sourcePose.Weight
	end)
end

local function makePose(name, cframe, sourcePose)
	local pose = Instance.new("Pose")
	pose.Name = name
	pose.CFrame = cframe or CFrame.new()
	copyPoseProperties(sourcePose, pose)
	return pose
end

local function clampDot(value)
	return math.clamp(value, -1, 1)
end

local function choosePerpendicular(vector)
	local axis = math.abs(vector:Dot(Vector3.yAxis)) &gt; 0.9 and Vector3.xAxis or Vector3.yAxis
	return vector:Cross(axis).Unit
end

local function rotationBetween(fromVector, toVector)
	local fromUnit = fromVector.Magnitude &gt; 0.0001 and fromVector.Unit or Vector3.yAxis
	local toUnit = toVector.Magnitude &gt; 0.0001 and toVector.Unit or fromUnit
	local dot = clampDot(fromUnit:Dot(toUnit))
	if dot &gt; 0.9995 then
		return CFrame.new()
	end
	if dot &lt; -0.9995 then
		return CFrame.fromAxisAngle(choosePerpendicular(fromUnit), math.pi)
	end
	return CFrame.fromAxisAngle(fromUnit:Cross(toUnit).Unit, math.acos(dot))
end

local function solveMotorPose(part0WorldCFrame, motorC0, motorC1, targetPartWorldCFrame)
	local jointWorld = part0WorldCFrame * motorC0
	local relative = jointWorld:ToObjectSpace(targetPartWorldCFrame)
	return relative * motorC1
end

local function mapR15WorldToR6Space(r15WorldCFrame, r15RootWorld, r6RootWorld, offset)
	local target = r6RootWorld * r15RootWorld:ToObjectSpace(r15WorldCFrame)
	if offset then
		target += offset
	end
	return target
end

local function solveMappedPose(motorData, part0World, r15TargetWorld, r15RootWorld, r6RootWorld, offset)
	if not motorData or not part0World or not r15TargetWorld then
		return CFrame.new(), nil
	end
	local targetWorld = mapR15WorldToR6Space(r15TargetWorld, r15RootWorld, r6RootWorld, offset)
	return solveMotorPose(part0World, motorData.c0, motorData.c1, targetWorld), targetWorld
end

local function buildConvertedKeyframe(sourceKeyframe, r15Index, r6Index)
	local poseMap, sourcePoses = collectPoseMap(sourceKeyframe)
	local rootPose = poseMap.HumanoidRootPart or CFrame.new()

	local r15World = computeRigWorldCFrames(r15Index, poseMap, rootPose)
	local r6NeutralWorld = computeRigWorldCFrames(r6Index, {}, CFrame.new())
	local r6PoseMap = {}
	local r6World = {
		HumanoidRootPart = rootPose,
	}
	local r15RootWorld = r15World.HumanoidRootPart or CFrame.new()

	local rootMotor = r6Index.motorsByPart1.Torso
	local torsoTarget = r15World.UpperTorso or r15World.LowerTorso or r6NeutralWorld.Torso
	if rootMotor and torsoTarget then
		r6PoseMap.Torso = solveMappedPose(rootMotor, r6World.HumanoidRootPart, torsoTarget, r15RootWorld, r6World.HumanoidRootPart, Vector3.new(0, -0.2, 0))
		r6World.Torso = r6World.HumanoidRootPart * rootMotor.c0 * r6PoseMap.Torso * rootMotor.c1:Inverse()
	else
		r6World.Torso = r6NeutralWorld.Torso or CFrame.new()
	end

	local function solvePart(partName, sourceTargetName, offset)
		local motorData = r6Index.motorsByPart1[partName]
		if not motorData or not r6World[motorData.part0.Name] then
			r6PoseMap[partName] = CFrame.new()
			return
		end
		local targetWorld = r15World[sourceTargetName] or r6NeutralWorld[partName]
		r6PoseMap[partName] = solveMappedPose(motorData, r6World[motorData.part0.Name], targetWorld, r15RootWorld, r6World.HumanoidRootPart, offset)
		r6World[partName] = r6World[motorData.part0.Name] * motorData.c0 * r6PoseMap[partName] * motorData.c1:Inverse()
	end

	solvePart("Head", "Head")

	for r6PartName, targetInfo in pairs(LIMB_TARGETS) do
		local motorData = r6Index.motorsByPart1[r6PartName]
		if motorData and r6World[motorData.part0.Name] then
			local offset = r6PartName:find("Arm") and Vector3.new(0, 0.224, 0) or Vector3.new(0, 0.201, 0)
			local target = r15World[targetInfo.fallbackPart] or r15World[targetInfo.endPart]
			r6PoseMap[r6PartName] = solveMappedPose(motorData, r6World[motorData.part0.Name], target, r15RootWorld, r6World.HumanoidRootPart, offset)
			r6World[r6PartName] = r6World[motorData.part0.Name] * motorData.c0 * r6PoseMap[r6PartName] * motorData.c1:Inverse()
		else
			r6PoseMap[r6PartName] = CFrame.new()
		end
	end

	local keyframe = Instance.new("Keyframe")
	keyframe.Name = sourceKeyframe.Name
	keyframe.Time = sourceKeyframe.Time

	local rootPoseObject = makePose("HumanoidRootPart", rootPose, sourcePoses.HumanoidRootPart)
	rootPoseObject.Parent = keyframe

	local torsoPoseObject = makePose("Torso", r6PoseMap.Torso, sourcePoses.UpperTorso or sourcePoses.LowerTorso)
	torsoPoseObject.Parent = rootPoseObject

	makePose("Head", r6PoseMap.Head, sourcePoses.Head).Parent = torsoPoseObject
	makePose("Right Arm", r6PoseMap["Right Arm"], sourcePoses.RightHand or sourcePoses.RightLowerArm).Parent = torsoPoseObject
	makePose("Left Arm", r6PoseMap["Left Arm"], sourcePoses.LeftHand or sourcePoses.LeftLowerArm).Parent = torsoPoseObject
	makePose("Right Leg", r6PoseMap["Right Leg"], sourcePoses.RightFoot or sourcePoses.RightLowerLeg).Parent = torsoPoseObject
	makePose("Left Leg", r6PoseMap["Left Leg"], sourcePoses.LeftFoot or sourcePoses.LeftLowerLeg).Parent = torsoPoseObject

	return keyframe
end

function R15ToR6Converter.Convert(sourceKeyframeSequence)
	assert(typeof(sourceKeyframeSequence) == "Instance" and sourceKeyframeSequence:IsA("KeyframeSequence"), "Convert expects a KeyframeSequence")
	if not hasR15PoseNames(sourceKeyframeSequence) then
		error("This does not look like an R15 animation.")
	end

	local tempFolder = getTempFolder()
	local r15Rig
	local r6Rig
	local ok, result = pcall(function()
		r15Rig = createReferenceRig("R15")
		r6Rig = createReferenceRig("R6")

		local r15Index = indexRig(r15Rig)
		local r6Index = indexRig(r6Rig)
		r15Index.defaults = captureMotorDefaults(r15Index)
		r6Index.defaults = captureMotorDefaults(r6Index)
		local output = Instance.new("KeyframeSequence")
		copySequenceProperties(sourceKeyframeSequence, output)

		local keyframes = sourceKeyframeSequence:GetKeyframes()
		table.sort(keyframes, function(a, b)
			return a.Time &lt; b.Time
		end)
		for _, keyframe in ipairs(keyframes) do
			buildConvertedKeyframe(keyframe, r15Index, r6Index).Parent = output
		end
		return output
	end)

	if r15Rig then
		r15Rig:Destroy()
	end
	if r6Rig then
		r6Rig:Destroy()
	end
	if tempFolder and #tempFolder:GetChildren() == 0 then
		tempFolder:Destroy()
	end
	if not ok then
		error(tostring(result))
	end
	return result
end

function R15ToR6Converter.LoadFromAnimationId(animationId)
	local contentId, id = parseAnimationId(animationId)
	local clipOk, clip = pcall(function()
		return AnimationClipProvider:GetAnimationClipAsync(contentId)
	end)
	local keyframeSequence = nil
	local clipMessage = tostring(clip or "")
	if clipOk and clip then
		if clip:IsA("KeyframeSequence") then
			keyframeSequence = clip
		elseif clip:IsA("CurveAnimation") then
			keyframeSequence = curveAnimationToKeyframeSequence(clip, "Animation_" .. id)
		else
			error("This Animation ID loaded as " .. clip.ClassName .. ", not a KeyframeSequence or CurveAnimation that the converter can read yet.")
		end
	else
		local fallbackOk, fallbackSequence = pcall(function()
			return KeyframeSequenceProvider:GetKeyframeSequenceAsync(contentId)
		end)
		if fallbackOk and fallbackSequence then
			keyframeSequence = fallbackSequence
		else
			local fallbackMessage = tostring(fallbackSequence or "")
			if clipMessage ~= "" and fallbackMessage ~= "" and fallbackMessage ~= clipMessage then
				error(clipMessage .. " / " .. fallbackMessage)
			end
			error(clipMessage ~= "" and clipMessage or (fallbackMessage ~= "" and fallbackMessage or "Roblox could not load that animation."))
		end
	end
	if getKeyframeCount(keyframeSequence) == 0 then
		error(EMPTY_ANIMATION_MESSAGE)
	end
	keyframeSequence.Name = "Animation_" .. id
	return keyframeSequence, id
end

function R15ToR6Converter.ConvertFromAnimationId(animationId)
	local keyframeSequence = R15ToR6Converter.LoadFromAnimationId(animationId)
	return R15ToR6Converter.Convert(keyframeSequence)
end

function R15ToR6Converter.SaveConvertedSequence(sequence)
	local folder = getOrCreateFolder(ServerStorage, OUTPUT_FOLDER_NAME)
	sequence.Parent = folder
	return sequence
end

return R15ToR6Converter
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX47">
        <Properties>
          <string name="Name">Cutscene</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX48">
          <Properties>
            <string name="Name">CutsceneDataBuilder</string>
            <ProtectedString name="Source">local CutsceneDataBuilder = {}

local function isOneOf(value, allowed, fallback)
	for _, option in ipairs(allowed) do
		if value == option then
			return value
		end
	end
	return fallback
end

local function normalizeExportOptions(options)
	options = options or {}
	local delaySeconds = tonumber(options.delaySeconds) or 0
	delaySeconds = math.max(0, delaySeconds)
	local teleportPlaceId = math.floor(tonumber(options.teleportPlaceId) or 0)
	return {
		Playback = isOneOf(options.playback, { "LocalPlayer", "Everyone" }, "LocalPlayer"),
		Trigger = isOneOf(options.trigger, { "Manual", "PartTouched", "ProximityPrompt", "Timed", "AutoStart" }, "Manual"),
		Replay = isOneOf(options.replay, { "Once", "EveryTime" }, "Once"),
		DelaySeconds = delaySeconds,
		TriggerPartPath = tostring(options.triggerPartPath or "Workspace.CutsceneTrigger"),
		TriggerPromptPath = tostring(options.triggerPromptPath or "Workspace.CutscenePrompt.ProximityPrompt"),
		RestoreCamera = options.restoreCamera ~= false,
		RigTargetMode = isOneOf(options.rigTargetMode, { "WorkspaceRig", "TriggeringPlayerClone" }, "WorkspaceRig"),
		PlayerRigName = tostring(options.playerRigName or ""),
		PlayerEndMode = isOneOf(options.playerEndMode, { "ReturnToStart", "MoveToCutsceneEnd" }, "ReturnToStart"),
		HidePlayerDuringCutscene = options.hidePlayerDuringCutscene ~= false,
		AllowSkip = options.allowSkip ~= false,
		FreezeCutsceneProps = options.freezeCutsceneProps ~= false,
		HidePromptAfterTrigger = options.hidePromptAfterTrigger ~= false,
		AttachedPropEndState = isOneOf(options.attachedPropEndState, { "Restore", "HideLocally", "KeepFinal" }, "Restore"),
		FadeInSeconds = math.max(0, tonumber(options.fadeInSeconds) or 0),
		FadeOutSeconds = math.max(0, tonumber(options.fadeOutSeconds) or 0),
		AfterCutsceneAction = isOneOf(options.afterCutsceneAction, { "StayHere", "Teleport" }, "StayHere"),
		TeleportPlaceId = math.max(0, teleportPlaceId),
	}
end

local function maybeYield(yieldBudget)
	if type(yieldBudget) == "function" then
		yieldBudget()
	end
end

local function countKeysByTrack(projectData, yieldBudget)
	local counts = {}
	local total = 0
	for _, pose in pairs(projectData.frames or {}) do
		for path in pairs(pose) do
			counts[path] = (counts[path] or 0) + 1
			total += 1
			maybeYield(yieldBudget)
		end
		maybeYield(yieldBudget)
	end
	return counts, total
end

local function getTrackCategory(track)
	if not track then
		return "Other"
	end
	if track.trackType == "Camera" then
		return "Camera"
	end
	if track.targetScope == "CameraProperty" or track.trackType == "Camera Property" then
		return "Camera"
	end
	if track.trackType == "Sound" or track.targetScope == "Sound" or track.valueType == "Sound" then
		return "Sound"
	end
	if track.trackType == "Screen Effect" then
		return "ScreenEffect"
	end
	if track.trackType == "Lighting Effect" then
		return "Lighting"
	end
	if track.trackType == "Face" or track.targetScope == "Face" then
		return "Face"
	end
	if track.trackType == "Event" or track.valueType == "Event" then
		return "Event"
	end
	if track.trackType == "Particle Event"
		or track.trackType == "Emitter Group"
		or track.trackType == "Emitter Group Property"
		or track.targetScope == "ParticleEvent"
		or track.targetScope == "EmitterGroup"
		or track.targetScope == "EmitterGroupProperty"
		or track.valueType == "Emitter" then
		return "Particle"
	end
	if track.targetScope == "ObjectProperty" or track.targetScope == "RigProperty" then
		return "Property"
	end
	if track.trackType == "Rig" or track.trackType == "Rig Group" or track.rigName then
		return "Rig"
	end
	return "Object"
end

function CutsceneDataBuilder.build(timeline, buildInfo, options)
	options = options or {}
	local yieldBudget = options.yieldBudget or options._yieldBudget
	local exportOptions = normalizeExportOptions(options)
	local projectData = timeline:toSaveData({
		cutscene = {
			exportedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"),
			mode = exportOptions.Playback,
			trigger = exportOptions.Trigger,
			playback = exportOptions.Playback,
			replay = exportOptions.Replay,
			delaySeconds = exportOptions.DelaySeconds,
			triggerPartPath = exportOptions.TriggerPartPath,
			triggerPromptPath = exportOptions.TriggerPromptPath,
			restoreCamera = exportOptions.RestoreCamera,
			rigTargetMode = exportOptions.RigTargetMode,
			playerRigName = exportOptions.PlayerRigName,
			playerEndMode = exportOptions.PlayerEndMode,
			hidePlayerDuringCutscene = exportOptions.HidePlayerDuringCutscene,
			allowSkip = exportOptions.AllowSkip,
			freezeCutsceneProps = exportOptions.FreezeCutsceneProps,
			hidePromptAfterTrigger = exportOptions.HidePromptAfterTrigger,
			attachedPropEndState = exportOptions.AttachedPropEndState,
			fadeInSeconds = exportOptions.FadeInSeconds,
			fadeOutSeconds = exportOptions.FadeOutSeconds,
			afterCutsceneAction = exportOptions.AfterCutsceneAction,
			teleportPlaceId = exportOptions.TeleportPlaceId,
		},
	}, {
		yieldBudget = yieldBudget,
	})
	maybeYield(yieldBudget)

	local keyCountsByTrack, totalKeys = countKeysByTrack(projectData, yieldBudget)
	local categories = {
		Camera = 0,
		Sound = 0,
		ScreenEffect = 0,
		Lighting = 0,
		Face = 0,
		Particle = 0,
		Property = 0,
		Event = 0,
		Rig = 0,
		Object = 0,
		Other = 0,
	}
	local keyedTracks = 0
	for _, track in ipairs(projectData.tracks or {}) do
		local category = getTrackCategory(track)
		categories[category] = (categories[category] or 0) + 1
		if (keyCountsByTrack[track.path] or 0) &gt; 0 then
			keyedTracks += 1
		end
		maybeYield(yieldBudget)
	end

	return {
		Format = "MegMoCutsceneV3",
		Version = 3,
		Name = projectData.name or "Untitled Cutscene",
		CreatedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		BuildId = buildInfo and buildInfo.BUILD_ID or "unknown",
		Mode = exportOptions.Playback,
		Trigger = exportOptions.Trigger,
		ExportOptions = exportOptions,
		Summary = {
			Fps = projectData.fps,
			DurationFrames = projectData.durationFrames,
			DurationSeconds = (projectData.durationFrames or 0) / math.max(1, projectData.fps or 60),
			TrackCount = #(projectData.tracks or {}),
			KeyCount = totalKeys,
			KeyedTrackCount = keyedTracks,
			Categories = categories,
		},
		Project = projectData,
	}
end

return CutsceneDataBuilder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX49">
          <Properties>
            <string name="Name">CutsceneExportService</string>
            <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Selection = game:GetService("Selection")
local HttpService = game:GetService("HttpService")

local CutsceneDataBuilder = require(script.Parent:WaitForChild("CutsceneDataBuilder"))
local CutsceneRigAnimationExporter = require(script.Parent:WaitForChild("CutsceneRigAnimationExporter"))
local CutsceneRuntimeGenerator = require(script.Parent:WaitForChild("CutsceneRuntimeGenerator"))
local CutsceneValidationService = require(script.Parent:WaitForChild("CutsceneValidationService"))
local RigService = require(script.Parent.Parent:WaitForChild("RigService"))

local CutsceneExportService = {}

local ROOT_FOLDER_NAME = "MegMoCutscenes"
local DATA_CHUNK_SIZE = 100000
local REQUIRED_PACKAGE_CHILDREN = {
	"PlayCutscene",
	"HideCutscenePrompt",
	"CutsceneSettings",
	"CutsceneEvents",
	"CutsceneDataChunks",
	"CutsceneData",
	"MegMoCutscenePlayer",
	"PlayLocalExample",
	"PlayClientReceiver",
	"PlayServerTriggerExample",
	"READ ME",
	"README",
}

local function createYieldBudget(intervalSeconds)
	intervalSeconds = tonumber(intervalSeconds) or 0.025
	local nextYieldAt = os.clock() + intervalSeconds
	return function(force)
		local now = os.clock()
		if force or now &gt;= nextYieldAt then
			task.wait()
			nextYieldAt = os.clock() + intervalSeconds
		end
	end
end

local function maybeYield(yieldBudget, force)
	if type(yieldBudget) == "function" then
		yieldBudget(force)
	end
end

local function safeInstanceName(name)
	name = tostring(name or "Untitled Cutscene")
	name = string.gsub(name, "[^%w%s_%-]", "")
	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	if name == "" then
		return "Untitled Cutscene"
	end
	return name
end

local function safeSlotName(index, name)
	local safeName = safeInstanceName(name)
	safeName = string.gsub(safeName, "%s+", "_")
	return string.format("%02d_%s", index, safeName)
end

local function getRootFolder()
	local existing = ReplicatedStorage:FindFirstChild(ROOT_FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end

	if existing then
		local index = 1
		local backupName = ROOT_FOLDER_NAME .. "_NonFolderBackup"
		while ReplicatedStorage:FindFirstChild(backupName) do
			index += 1
			backupName = ROOT_FOLDER_NAME .. "_NonFolderBackup" .. tostring(index)
		end
		existing.Name = backupName
		warn("[7kg2 Animator] ReplicatedStorage." .. ROOT_FOLDER_NAME .. " was not a Folder, so it was renamed to " .. backupName .. ".")
	end

	local folder = Instance.new("Folder")
	folder.Name = ROOT_FOLDER_NAME
	folder:SetAttribute("MegMoCutsceneRoot", true)
	folder.Parent = ReplicatedStorage
	return folder
end

local function setSource(scriptInstance, source)
	local ok, err = pcall(function()
		scriptInstance.Source = source
	end)
	return ok, err
end

local function createModule(parent, name, source)
	local module = Instance.new("ModuleScript")
	module.Name = name
	module.Parent = parent
	local ok, err = setSource(module, source)
	if not ok then
		module:Destroy()
		return nil, err
	end
	return module
end

local function writeDataChunks(parent, data, yieldBudget)
	maybeYield(yieldBudget, true)
	local ok, encodedOrError = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok then
		return false, "Could not encode cutscene data: " .. tostring(encodedOrError)
	end
	maybeYield(yieldBudget, true)

	local encoded = encodedOrError
	local chunksFolder = Instance.new("Folder")
	chunksFolder.Name = "CutsceneDataChunks"
	chunksFolder.Parent = parent

	local chunkCount = 0
	for startIndex = 1, #encoded, DATA_CHUNK_SIZE do
		chunkCount += 1
		local chunk = Instance.new("StringValue")
		chunk.Name = string.format("Chunk%03d", chunkCount)
		chunk.Value = string.sub(encoded, startIndex, startIndex + DATA_CHUNK_SIZE - 1)
		chunk.Parent = chunksFolder
		maybeYield(yieldBudget)
	end

	if chunkCount == 0 then
		local chunk = Instance.new("StringValue")
		chunk.Name = "Chunk001"
		chunk.Value = "{}"
		chunk.Parent = chunksFolder
		chunkCount = 1
		maybeYield(yieldBudget)
	end

	return true, nil, chunkCount, #encoded
end

local function createAnimationIdSlots(parent, rigAnimations, yieldBudget)
	if #rigAnimations == 0 then
		return nil
	end

	local folder = Instance.new("Folder")
	folder.Name = "RigAnimationIds"
	folder.Parent = parent

	for index, info in ipairs(rigAnimations) do
		local slot = Instance.new("StringValue")
		slot.Name = safeSlotName(index, info.RigName or info.SequenceName or "RigAnimation")
		slot.Value = ""
		slot:SetAttribute("RigName", info.RigName or "")
		slot:SetAttribute("SequenceName", info.SequenceName or "")
		slot:SetAttribute("Instructions", "Upload the matching KeyframeSequence from RigAnimations, then paste the AnimationId here.")
		slot.Parent = folder
		info.AnimationIdSlot = slot.Name
		maybeYield(yieldBudget)
	end

	return folder
end

local function createSettingsFolder(parent, exportOptions, yieldBudget)
	exportOptions = exportOptions or {}
	local folder = Instance.new("Folder")
	folder.Name = "CutsceneSettings"
	folder.Parent = parent

	local function addString(name, value, instructions)
		local setting = Instance.new("StringValue")
		setting.Name = name
		setting.Value = tostring(value or "")
		setting:SetAttribute("Instructions", instructions or "")
		setting.Parent = folder
		return setting
	end

	local function addNumber(name, value, instructions)
		local setting = Instance.new("NumberValue")
		setting.Name = name
		setting.Value = tonumber(value) or 0
		setting:SetAttribute("Instructions", instructions or "")
		setting.Parent = folder
		return setting
	end

	local function addBool(name, value, instructions)
		local setting = Instance.new("BoolValue")
		setting.Name = name
		setting.Value = value == true
		setting:SetAttribute("Instructions", instructions or "")
		setting.Parent = folder
		return setting
	end

	addString("Trigger", exportOptions.Trigger or "Manual", "Manual, PartTouched, ProximityPrompt, Timed, or AutoStart.")
	addString("Playback", exportOptions.Playback or "LocalPlayer", "LocalPlayer plays for the toucher only. Everyone plays for all players.")
	addString("Replay", exportOptions.Replay or "Once", "Once or EveryTime.")
	addString("TriggerPartPath", exportOptions.TriggerPartPath or "Workspace.CutsceneTrigger", "For PartTouched triggers, set this to the full Workspace path of the part to touch.")
	addString("TriggerPromptPath", exportOptions.TriggerPromptPath or "Workspace.CutscenePrompt.ProximityPrompt", "For ProximityPrompt triggers, set this to the full path of the ProximityPrompt.")
	addString("RigTargetMode", exportOptions.RigTargetMode or "WorkspaceRig", "WorkspaceRig uses the exported dummy. TriggeringPlayerClone replaces the dummy with a temporary clone of the triggering player.")
	addString("PlayerRigName", exportOptions.PlayerRigName or "", "Optional. Leave blank to replace the first exported rig, or type the dummy rig name to replace.")
	addString("PlayerEndMode", exportOptions.PlayerEndMode or "ReturnToStart", "ReturnToStart leaves the player where they started. MoveToCutsceneEnd moves them to the final cutscene rig position.")
	addString("AttachedPropEndState", exportOptions.AttachedPropEndState or "Restore", "Restore, HideLocally, or KeepFinal. Controls props used by Attach/Detach events after local playback ends.")
	addString("AfterCutsceneAction", exportOptions.AfterCutsceneAction or "StayHere", "StayHere or Teleport. Teleport sends the players who watched the cutscene to TeleportPlaceId when playback ends.")
	addNumber("DelaySeconds", exportOptions.DelaySeconds or 0, "Used by Timed and AutoStart triggers.")
	addNumber("FadeInSeconds", exportOptions.FadeInSeconds or 0, "Optional local fade from black at cutscene start.")
	addNumber("FadeOutSeconds", exportOptions.FadeOutSeconds or 0, "Optional local fade to black at cutscene end.")
	addNumber("TeleportPlaceId", exportOptions.TeleportPlaceId or 0, "Destination Place ID used when AfterCutsceneAction is Teleport.")
	addBool("RestoreCamera", exportOptions.RestoreCamera ~= false, "When true, the cutscene restores the player's camera type after playback.")
	addBool("HidePlayerDuringCutscene", exportOptions.HidePlayerDuringCutscene ~= false, "When using TriggeringPlayerClone, hide the real player locally while the clone plays.")
	addBool("AllowSkip", exportOptions.AllowSkip ~= false, "When true, local playback shows a Skip button.")
	addBool("FreezeCutsceneProps", exportOptions.FreezeCutsceneProps ~= false, "When true, props used by Attach/Detach cutscene events stay frozen in their authored pose until the cutscene uses them.")
	addBool("HidePromptAfterTrigger", exportOptions.HidePromptAfterTrigger ~= false, "When true, ProximityPrompt triggers hide locally for the player who already triggered a once-only cutscene.")
	maybeYield(yieldBudget)

	return folder
end

local function createCutsceneEventsFolder(parent, data, yieldBudget)
	local folder = Instance.new("Folder")
	folder.Name = "CutsceneEvents"
	folder.Parent = parent

	local created = {}
	local function addEvent(name)
		name = tostring(name or "Event")
		if name == "" then
			name = "Event"
		end
		if created[name] then
			return
		end
		created[name] = true
		local bindable = Instance.new("BindableEvent")
		bindable.Name = name
		bindable.Parent = folder
	end

	addEvent("Event")
	local project = data and (data.Project or data) or {}
	local eventTracks = {}
	for _, track in ipairs(project.tracks or {}) do
		if track.trackType == "Event" or track.valueType == "Event" then
			eventTracks[track.path] = track
			addEvent(track.eventName or track.name)
		end
		maybeYield(yieldBudget)
	end
	for _, pose in pairs(project.frames or {}) do
		for path, entry in pairs(pose) do
			local track = eventTracks[path]
			local value = type(entry) == "table" and entry.value or entry
			if track and type(value) == "table" then
				addEvent(value.name or value.eventName or value.action or track.eventName or track.name)
			end
			maybeYield(yieldBudget)
		end
		maybeYield(yieldBudget)
	end
	return folder
end

local function createLocalExample(parent, cutsceneFolderName)
	local scriptInstance = Instance.new("LocalScript")
	scriptInstance.Name = "PlayLocalExample"
	scriptInstance.Disabled = true
	scriptInstance.Parent = parent
	local ok, err = setSource(scriptInstance, CutsceneRuntimeGenerator.localExampleSource(cutsceneFolderName))
	if not ok then
		scriptInstance:Destroy()
		return nil, err
	end
	return scriptInstance
end

local function getMissingPackageChildren(folder, expectRigAnimations)
	local missing = {}
	if not (folder and folder:IsA("Folder")) then
		return { "cutscene folder" }
	end
	for _, childName in ipairs(REQUIRED_PACKAGE_CHILDREN) do
		if not folder:FindFirstChild(childName) then
			table.insert(missing, childName)
		end
	end
	local chunksFolder = folder:FindFirstChild("CutsceneDataChunks")
	if chunksFolder and #chunksFolder:GetChildren() == 0 then
		table.insert(missing, "CutsceneDataChunks.Chunk001")
	end
	if expectRigAnimations and not folder:FindFirstChild("RigAnimations") then
		table.insert(missing, "RigAnimations")
	end
	if expectRigAnimations and not folder:FindFirstChild("RigAnimationIds") then
		table.insert(missing, "RigAnimationIds")
	end
	return missing
end

local function isCompletePackage(folder)
	return #getMissingPackageChildren(folder, false) == 0
end

local function createScript(parent, className, name, source)
	local scriptInstance = Instance.new(className)
	scriptInstance.Name = name
	scriptInstance.Disabled = true
	scriptInstance.Parent = parent
	local ok, err = setSource(scriptInstance, source)
	if not ok then
		scriptInstance:Destroy()
		return nil, err
	end
	return scriptInstance
end

local function captureTimelineRigPose(timeline, yieldBudget)
	local pose = {}
	for _, motorData in ipairs(timeline:getMotors()) do
		local value = RigService.getJointPose(motorData)
		if value then
			pose[motorData.path] = value
		end
		maybeYield(yieldBudget)
	end
	return pose
end

local function getTimelineBasePose(timeline, yieldBudget)
	local pose = {}
	for _, motorData in ipairs(timeline:getMotors()) do
		local originalC0 = timeline:getOriginalPose(motorData.path)
		if typeof(originalC0) == "CFrame" then
			pose[motorData.path] = originalC0
		end
		maybeYield(yieldBudget)
	end
	return pose
end

local function applyTimelineRigPose(timeline, pose, yieldBudget)
	for _, motorData in ipairs(timeline:getMotors()) do
		local c0 = pose[motorData.path]
		if typeof(c0) == "CFrame" then
			RigService.setJointPose(motorData, c0)
		end
		maybeYield(yieldBudget)
	end
end

local function withTimelineBasePose(timeline, callback, yieldBudget)
	local editorPose = captureTimelineRigPose(timeline, yieldBudget)
	applyTimelineRigPose(timeline, getTimelineBasePose(timeline, yieldBudget), yieldBudget)

	local results = { pcall(callback) }
	applyTimelineRigPose(timeline, editorPose, yieldBudget)

	if not results[1] then
		return false, "Cutscene generation failed while preparing the rig base pose: " .. tostring(results[2])
	end
	return table.unpack(results, 2)
end

function CutsceneExportService.buildData(timeline, buildInfo, options)
	return CutsceneDataBuilder.build(timeline, buildInfo, options)
end

function CutsceneExportService.validate(timeline, buildInfo, options)
	local data = CutsceneExportService.buildData(timeline, buildInfo, options or {})
	return CutsceneValidationService.validateData(data)
end

local function generatePackage(timeline, buildInfo, options)
	options = options or {}
	local yieldBudget = options.yieldBudget or options._yieldBudget or createYieldBudget(options.yieldIntervalSeconds)
	options._yieldBudget = yieldBudget
	maybeYield(yieldBudget, true)
	local data = CutsceneExportService.buildData(timeline, buildInfo, options)
	maybeYield(yieldBudget, true)
	local isValid, validationMessage = CutsceneValidationService.validateData(data)
	if not isValid then
		return false, validationMessage
	end
	maybeYield(yieldBudget)

	local root = getRootFolder()
	local folderName = safeInstanceName(data.Name)
	local existingBeforeGeneration = root:FindFirstChild(folderName)
	local existingWasComplete = existingBeforeGeneration and isCompletePackage(existingBeforeGeneration) or false

	local folder = Instance.new("Folder")
	folder.Name = folderName .. "_Generating"
	folder:SetAttribute("MegMoCutscene", true)
	folder:SetAttribute("BuildId", data.BuildId)
	folder:SetAttribute("CreatedAt", data.CreatedAt)
	folder:SetAttribute("Playback", data.ExportOptions and data.ExportOptions.Playback or data.Mode)
	folder:SetAttribute("Trigger", data.ExportOptions and data.ExportOptions.Trigger or data.Trigger)

	local generationOk, success, message = pcall(function()
		local remote = Instance.new("RemoteEvent")
		remote.Name = "PlayCutscene"
		remote.Parent = folder
		local promptRemote = Instance.new("RemoteEvent")
		promptRemote.Name = "HideCutscenePrompt"
		promptRemote.Parent = folder
		maybeYield(yieldBudget)
		createSettingsFolder(folder, data.ExportOptions, yieldBudget)
		createCutsceneEventsFolder(folder, data, yieldBudget)

		local rigAnimations = CutsceneRigAnimationExporter.exportToFolder(folder, timeline, buildInfo, {
			yieldBudget = yieldBudget,
		})
		createAnimationIdSlots(folder, rigAnimations, yieldBudget)
		data.RigAnimations = rigAnimations
		if data.Summary then
			data.Summary.RigAnimationCount = #rigAnimations
		end
		maybeYield(yieldBudget, true)

		local dataOk, dataErr, chunkCount, dataSize = writeDataChunks(folder, data, yieldBudget)
		if not dataOk then
			return false, dataErr
		end
		maybeYield(yieldBudget, true)

		local dataModule, dataModuleErr = createModule(folder, "CutsceneData", CutsceneRuntimeGenerator.dataLoaderSource())
		if not dataModule then
			return false, "Could not write CutsceneData loader: " .. tostring(dataModuleErr)
		end
		maybeYield(yieldBudget)

		local playerModule, playerErr = createModule(folder, "MegMoCutscenePlayer", CutsceneRuntimeGenerator.playerSource())
		if not playerModule then
			return false, "Could not write MegMoCutscenePlayer: " .. tostring(playerErr)
		end
		maybeYield(yieldBudget)

		local exampleScript, exampleErr = createLocalExample(folder, folderName)
		if not exampleScript then
			return false, "Could not write PlayLocalExample: " .. tostring(exampleErr)
		end
		maybeYield(yieldBudget)

		local receiverScript, receiverErr = createScript(folder, "LocalScript", "PlayClientReceiver", CutsceneRuntimeGenerator.clientReceiverSource(folderName))
		if not receiverScript then
			return false, "Could not write PlayClientReceiver: " .. tostring(receiverErr)
		end
		maybeYield(yieldBudget)

		local triggerScript, triggerErr = createScript(folder, "Script", "PlayServerTriggerExample", CutsceneRuntimeGenerator.serverTriggerSource(folderName))
		if not triggerScript then
			return false, "Could not write PlayServerTriggerExample: " .. tostring(triggerErr)
		end
		maybeYield(yieldBudget)

		local readMeModule, readMeModuleErr = createModule(folder, "READ ME", CutsceneRuntimeGenerator.readMeSource(folderName))
		if not readMeModule then
			return false, "Could not write READ ME instructions: " .. tostring(readMeModuleErr)
		end
		readMeModule:SetAttribute("InstructionsOnly", true)
		maybeYield(yieldBudget)

		local readme = Instance.new("StringValue")
		readme.Name = "README"
		readme.Value = table.concat({
			"7kg2 Animator V3 cutscene package.",
			"Open the READ ME ModuleScript for simple setup instructions.",
			"CutsceneData loads the full editor timeline data from CutsceneDataChunks.",
			"MegMoCutscenePlayer plays rig KeyframeSequences, camera/FOV, rig/object CFrame and property tracks, sounds, faces, particles, lighting, screen effects, and generic Event tracks.",
			"Move PlayLocalExample into StarterPlayerScripts or call MegMoCutscenePlayer.Play(data) from your own LocalScript.",
			"For PartTouched triggers: set CutsceneSettings.TriggerPartPath to the full path of the part, for example Workspace.CutsceneTrigger.",
			"For ProximityPrompt triggers: set CutsceneSettings.TriggerPromptPath to the prompt or an object containing it.",
			"For PartTouched/ProximityPrompt/Timed server triggers: move PlayServerTriggerExample into ServerScriptService and PlayClientReceiver into StarterPlayerScripts.",
			"Optional polish: CutsceneSettings.AllowSkip, FadeInSeconds, FadeOutSeconds, FreezeCutsceneProps, HidePromptAfterTrigger, AttachedPropEndState, AfterCutsceneAction, and TeleportPlaceId can be changed without editing code.",
			"For published games: upload each KeyframeSequence in RigAnimations, then paste each uploaded AnimationId into the matching RigAnimationIds StringValue.",
			"If a RigAnimationIds slot is empty, Studio can still preview with temporary registered KeyframeSequences.",
			"Screen effects, faces, particles, lighting, cutscene prop attachment events, and custom events render locally through PlayClientReceiver.",
		}, "\n")
		readme.Parent = folder
		maybeYield(yieldBudget)

		local missing = getMissingPackageChildren(folder, #rigAnimations &gt; 0)
		if #missing &gt; 0 then
			return false, "Generated package is incomplete. Missing: " .. table.concat(missing, ", ")
		end

		local summary = data.Summary or {}
		return true, string.format(
			"Generated V3 cutscene package at ReplicatedStorage.%s.%s (%d tracks, %d keys, %d rig animation%s, %d data chunks, %.1f KB). Trigger: %s, Playback: %s. Upload rig sequences and fill RigAnimationIds before publishing.",
			ROOT_FOLDER_NAME,
			folderName,
			summary.TrackCount or 0,
			summary.KeyCount or 0,
			#rigAnimations,
			#rigAnimations == 1 and "" or "s",
			chunkCount or 0,
			(dataSize or 0) / 1024,
			data.ExportOptions and data.ExportOptions.Trigger or data.Trigger or "Manual",
			data.ExportOptions and data.ExportOptions.Playback or data.Mode or "LocalPlayer"
		)
	end)

	if not generationOk then
		folder:Destroy()
		if existingBeforeGeneration and existingBeforeGeneration.Parent and not existingWasComplete then
			existingBeforeGeneration:Destroy()
		end
		return false, "Cutscene generation failed while writing package '" .. folderName .. "': " .. tostring(success)
	end
	if not success then
		folder:Destroy()
		if existingBeforeGeneration and existingBeforeGeneration.Parent and not existingWasComplete then
			existingBeforeGeneration:Destroy()
		end
		return false, tostring(message or "Cutscene generation failed while writing package '" .. folderName .. "'.")
	end

	local existing = root:FindFirstChild(folderName)
	if existing and existing ~= folder then
		existing:Destroy()
	end
	folder.Name = folderName
	folder.Parent = root
	Selection:Set({ folder })
	return true, message
end

function CutsceneExportService.generate(timeline, buildInfo, options)
	options = options or {}
	local yieldBudget = options.yieldBudget or options._yieldBudget or createYieldBudget(options.yieldIntervalSeconds)
	options._yieldBudget = yieldBudget
	return withTimelineBasePose(timeline, function()
		return generatePackage(timeline, buildInfo, options)
	end, yieldBudget)
end

return CutsceneExportService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX50">
          <Properties>
            <string name="Name">CutsceneRigAnimationExporter</string>
            <ProtectedString name="Source">local CutsceneRigAnimationExporter = {}

local AnimationMarkerExportService = require(script.Parent.Parent:WaitForChild("AnimationMarkerExportService"))
local RigService = require(script.Parent.Parent:WaitForChild("RigService"))

local function maybeYield(yieldBudget)
	if type(yieldBudget) == "function" then
		yieldBudget()
	end
end

local function safeInstanceName(name)
	name = tostring(name or "Rig")
	name = string.gsub(name, "[^%w%s_%-]", "")
	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	return name ~= "" and name or "Rig"
end

local function getInstancePath(instance)
	if not instance then
		return nil
	end
	local parts = {}
	local current = instance
	while current and current ~= game do
		table.insert(parts, 1, current.Name)
		current = current.Parent
	end
	if #parts == 0 then
		return nil
	end
	return table.concat(parts, ".")
end

local function getEnumItem(enumType, name, fallbackName)
	local ok, item = pcall(function()
		return enumType[name]
	end)
	if ok and item then
		return item
	end
	return enumType[fallbackName]
end

local function serializeCFrame(cframe)
	if typeof(cframe) ~= "CFrame" then
		return nil
	end
	return {
		type = "CFrame",
		components = { cframe:GetComponents() },
	}
end

local function getExportEasingStyle(styleName)
	local styleMap = {
		Linear = "Linear",
		Constant = "Constant",
		None = "Constant",
		Elastic = "Elastic",
		Cubic = "Cubic",
		Bounce = "Bounce",
		CubicV2 = "CubicV2",
		Sine = "Cubic",
		Quad = "Cubic",
		Quart = "Cubic",
		Quint = "Cubic",
		Sextic = "Cubic",
	}
	return getEnumItem(Enum.PoseEasingStyle, styleMap[styleName] or "Linear", "Linear")
end

local function getExportEasingDirection(directionName)
	local directionMap = {
		In = "In",
		Out = "Out",
		InOut = "InOut",
	}
	return getEnumItem(Enum.PoseEasingDirection, directionMap[directionName] or "InOut", "InOut")
end

local function collectRigFrames(timeline, motors, yieldBudget)
	local motorPaths = {}
	for _, motorData in ipairs(motors) do
		motorPaths[motorData.path] = true
		maybeYield(yieldBudget)
	end

	local frames = {}
	local seen = {}
	local hasRigKeys = false
	for _, frame in ipairs(timeline:getKeyframeFrames()) do
		for path in pairs(motorPaths) do
			if timeline:hasTrackKeyframe(path, frame) then
				if not seen[frame] then
					seen[frame] = true
					table.insert(frames, frame)
				end
				hasRigKeys = true
				break
			end
			maybeYield(yieldBudget)
		end
		maybeYield(yieldBudget)
	end

	if hasRigKeys and not seen[0] then
		seen[0] = true
		table.insert(frames, 0)
	end
	if hasRigKeys then
		AnimationMarkerExportService.addMarkerFrames(timeline, frames, seen)
	end

	table.sort(frames)
	maybeYield(yieldBudget)
	return frames
end

local function buildMotorHierarchy(motors, yieldBudget)
	local childrenByPart0 = {}
	local part1Lookup = {}
	for _, motorData in ipairs(motors) do
		local motor = motorData.instance
		if motor and motor.Parent and motor.Part0 and motor.Part1 then
			childrenByPart0[motor.Part0] = childrenByPart0[motor.Part0] or {}
			table.insert(childrenByPart0[motor.Part0], motorData)
			part1Lookup[motor.Part1] = true
		end
		maybeYield(yieldBudget)
	end

	for _, children in pairs(childrenByPart0) do
		table.sort(children, function(a, b)
			return tostring(a.path) &lt; tostring(b.path)
		end)
		maybeYield(yieldBudget)
	end

	local roots = {}
	local seenRoots = {}
	for _, motorData in ipairs(motors) do
		local motor = motorData.instance
		local part0 = motor and motor.Part0
		if part0 and not part1Lookup[part0] and not seenRoots[part0] then
			seenRoots[part0] = true
			table.insert(roots, part0)
		end
		maybeYield(yieldBudget)
	end

	table.sort(roots, function(a, b)
		return a.Name &lt; b.Name
	end)
	maybeYield(yieldBudget)

	if #roots == 0 then
		for _, motorData in ipairs(motors) do
			local part0 = motorData.instance and motorData.instance.Part0
			if part0 then
				table.insert(roots, part0)
				break
			end
		end
	end

	return childrenByPart0, roots
end

local function getOutgoingPoseEasingOptions(timeline, path, frame)
	for _, keyFrame in ipairs(timeline:getTrackKeyframeFrames(path)) do
		if keyFrame &gt; frame then
			return timeline:getKeyOptions(path, keyFrame)
		end
	end
	return timeline:getKeyOptions(path, frame)
end

local function assignPoseEasing(timeline, pose, path, frame)
	local options = getOutgoingPoseEasingOptions(timeline, path, frame)
	pose.EasingStyle = getExportEasingStyle(options.easingStyle)
	pose.EasingDirection = getExportEasingDirection(options.easingDirection)
end

local function createPoseForMotor(timeline, motorData, framePose, frame)
	local motor = motorData.instance
	if not motor or not motor.Parent or not motor.Part1 then
		return nil
	end

	local pose = Instance.new("Pose")
	pose.Name = motor.Part1.Name
	pose.Weight = 1

	local keyedC0 = framePose and framePose[motorData.path]
	local originalC0 = timeline:getOriginalPose(motorData.path)
	if typeof(keyedC0) == "CFrame" and typeof(originalC0) == "CFrame" then
		pose.CFrame = originalC0:ToObjectSpace(keyedC0)
	else
		pose.CFrame = CFrame.new()
	end

	assignPoseEasing(timeline, pose, motorData.path, frame)
	return pose
end

local function appendMotorPoses(timeline, parentPose, part0, childrenByPart0, framePose, frame, yieldBudget, poseByInstance)
	for _, childMotorData in ipairs(childrenByPart0[part0] or {}) do
		local childPose = createPoseForMotor(timeline, childMotorData, framePose, frame)
		if childPose then
			childPose.Parent = parentPose
			poseByInstance[childMotorData.instance.Part1] = childPose
			appendMotorPoses(
				timeline,
				childPose,
				childMotorData.instance.Part1,
				childrenByPart0,
				framePose,
				frame,
				yieldBudget,
				poseByInstance
			)
		end
		maybeYield(yieldBudget)
	end
end

local function shouldWriteMotorPoses(timeline, motors, frame, yieldBudget)
	if frame == 0 then
		return true
	end
	for _, motorData in ipairs(motors) do
		if timeline:hasTrackKeyframe(motorData.path, frame) then
			return true
		end
		maybeYield(yieldBudget)
	end
	return false
end

local function buildBoneHierarchy(bones, allBones, yieldBudget)
	local dataByInstance = {}
	for _, boneData in ipairs(allBones or bones) do
		local bone = boneData.instance
		if bone and bone.Parent and bone:IsA("Bone") then
			dataByInstance[bone] = boneData
		end
		maybeYield(yieldBudget)
	end

	local nodeByBone = {}
	for _, boneData in ipairs(bones) do
		local bone = boneData.instance
		if bone and bone.Parent and bone:IsA("Bone") then
			nodeByBone[bone] = {
				instance = bone,
				data = boneData,
				animated = true,
			}
			local ancestor = bone.Parent
			while ancestor and ancestor:IsA("Bone") do
				nodeByBone[ancestor] = nodeByBone[ancestor] or {
					instance = ancestor,
					data = dataByInstance[ancestor],
					animated = false,
				}
				ancestor = ancestor.Parent
				maybeYield(yieldBudget)
			end
		end
		maybeYield(yieldBudget)
	end

	local childrenByBone = {}
	local roots = {}
	for bone, node in pairs(nodeByBone) do
		local parentBone = bone.Parent
		if parentBone and parentBone:IsA("Bone") and nodeByBone[parentBone] then
			childrenByBone[parentBone] = childrenByBone[parentBone] or {}
			table.insert(childrenByBone[parentBone], node)
		else
			table.insert(roots, node)
		end
		maybeYield(yieldBudget)
	end

	local function compareNodes(a, b)
		local aPath = a.data and a.data.path or getInstancePath(a.instance) or a.instance.Name
		local bPath = b.data and b.data.path or getInstancePath(b.instance) or b.instance.Name
		return tostring(aPath) &lt; tostring(bPath)
	end
	table.sort(roots, compareNodes)
	for _, children in pairs(childrenByBone) do
		table.sort(children, compareNodes)
		maybeYield(yieldBudget)
	end

	return childrenByBone, roots
end

local function getBoneAnchorInstance(bone)
	local current = bone and bone.Parent
	while current and current:IsA("Bone") do
		current = current.Parent
	end
	while current and not current:IsA("BasePart") do
		current = current.Parent
	end
	return current
end

local function ensureAnchorPose(keyframe, instance, poseByInstance)
	if not instance then
		return keyframe
	end
	local existing = poseByInstance[instance]
	if existing then
		return existing
	end
	local pose = Instance.new("Pose")
	pose.Name = instance.Name
	pose.Weight = 0
	pose.CFrame = CFrame.new()
	pose.Parent = keyframe
	poseByInstance[instance] = pose
	return pose
end

local function createPoseForBone(timeline, node, framePose, frame)
	local bone = node.instance
	if not bone or not bone.Parent then
		return nil
	end

	local pose = Instance.new("Pose")
	pose.Name = bone.Name
	if node.animated and node.data then
		pose.Weight = 1
		local keyedTransform = framePose and framePose[node.data.path]
		local originalTransform = timeline:getOriginalPose(node.data.path)
		if typeof(keyedTransform) == "CFrame" then
			pose.CFrame = keyedTransform
		elseif typeof(originalTransform) == "CFrame" then
			pose.CFrame = originalTransform
		else
			pose.CFrame = CFrame.new()
		end
		assignPoseEasing(timeline, pose, node.data.path, frame)
	else
		pose.Weight = 0
		pose.CFrame = CFrame.new()
	end
	return pose
end

local function appendBoneChildren(timeline, parentPose, parentBone, childrenByBone, framePose, frame, yieldBudget, poseByInstance)
	for _, childNode in ipairs(childrenByBone[parentBone] or {}) do
		local childPose = createPoseForBone(timeline, childNode, framePose, frame)
		if childPose then
			childPose.Parent = parentPose
			poseByInstance[childNode.instance] = childPose
			appendBoneChildren(
				timeline,
				childPose,
				childNode.instance,
				childrenByBone,
				framePose,
				frame,
				yieldBudget,
				poseByInstance
			)
		end
		maybeYield(yieldBudget)
	end
end

local function appendBonePoses(timeline, keyframe, roots, childrenByBone, framePose, frame, yieldBudget, poseByInstance)
	for _, rootNode in ipairs(roots) do
		local parentPose = ensureAnchorPose(keyframe, getBoneAnchorInstance(rootNode.instance), poseByInstance)
		local rootPose = createPoseForBone(timeline, rootNode, framePose, frame)
		if rootPose then
			rootPose.Parent = parentPose
			poseByInstance[rootNode.instance] = rootPose
			appendBoneChildren(
				timeline,
				rootPose,
				rootNode.instance,
				childrenByBone,
				framePose,
				frame,
				yieldBudget,
				poseByInstance
			)
		end
		maybeYield(yieldBudget)
	end
end

local function shouldWriteBonePoses(timeline, bones, frame, yieldBudget)
	if frame == 0 then
		return #bones &gt; 0
	end
	for _, boneData in ipairs(bones) do
		if timeline:hasTrackKeyframe(boneData.path, frame) then
			return true
		end
		maybeYield(yieldBudget)
	end
	return false
end

local function buildSequence(timeline, buildInfo, rigName, motors, bones, allBones, frames, yieldBudget)
	local childrenByPart0, roots = buildMotorHierarchy(motors, yieldBudget)
	local childrenByBone, boneRoots = buildBoneHierarchy(bones, allBones, yieldBudget)
	local markersByFrame = AnimationMarkerExportService.collectByFrame(timeline)
	maybeYield(yieldBudget)
	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = safeInstanceName(timeline:getAnimationName()) .. "_" .. safeInstanceName(rigName) .. "_RigAnimation"
	sequence:SetAttribute("MegMoCutsceneRigAnimation", true)
	sequence:SetAttribute("RigName", rigName)
	sequence:SetAttribute("BuildId", buildInfo and buildInfo.BUILD_ID or "unknown")
	sequence:SetAttribute("ExportedAt", os.date("!%Y-%m-%dT%H:%M:%SZ"))
	sequence:SetAttribute("SourceAnimation", timeline:getAnimationName())

	pcall(function()
		sequence.Loop = timeline:getLooping()
	end)
	pcall(function()
		sequence.Priority = getEnumItem(Enum.AnimationPriority, timeline:getPriority(), "Action")
	end)

	for _, frame in ipairs(frames) do
		maybeYield(yieldBudget)
		local framePose = timeline:samplePose(frame)
		local keyframe = Instance.new("Keyframe")
		keyframe.Name = string.format("Frame_%d", frame)
		keyframe.Time = frame / math.max(1, timeline:getFps())
		keyframe.Parent = sequence
		AnimationMarkerExportService.appendMarkersToKeyframe(keyframe, markersByFrame[frame])

		local writeBonePoses = shouldWriteBonePoses(timeline, bones, frame, yieldBudget)
		local poseByInstance = {}
		if shouldWriteMotorPoses(timeline, motors, frame, yieldBudget) or writeBonePoses then
			for _, rootPart in ipairs(roots) do
				local rootPose = Instance.new("Pose")
				rootPose.Name = rootPart.Name
				rootPose.Weight = 0
				rootPose.CFrame = CFrame.new()
				rootPose.Parent = keyframe
				poseByInstance[rootPart] = rootPose
				appendMotorPoses(timeline, rootPose, rootPart, childrenByPart0, framePose, frame, yieldBudget, poseByInstance)
				maybeYield(yieldBudget)
			end
		end
		if writeBonePoses then
			appendBonePoses(timeline, keyframe, boneRoots, childrenByBone, framePose, frame, yieldBudget, poseByInstance)
		end
	end

	return sequence
end

local function buildOriginalMotorPose(timeline, motors, yieldBudget)
	local pose = {}
	for _, motorData in ipairs(motors) do
		local motor = motorData.instance
		local originalC0 = timeline:getOriginalPose(motorData.path)
		if motor and motor.Parent and typeof(originalC0) == "CFrame" then
			table.insert(pose, {
				Path = motorData.path,
				Name = motor.Name,
				Part1 = motor.Part1 and motor.Part1.Name or "",
				C0 = serializeCFrame(originalC0),
			})
		end
		maybeYield(yieldBudget)
	end
	return pose
end

local function buildOriginalBonePose(timeline, bones, yieldBudget)
	local pose = {}
	for _, boneData in ipairs(bones) do
		local bone = boneData.instance
		local originalTransform = timeline:getOriginalPose(boneData.path)
		if bone and bone.Parent and typeof(originalTransform) == "CFrame" then
			table.insert(pose, {
				Path = boneData.path,
				Name = bone.Name,
				Parent = bone.Parent.Name,
				Transform = serializeCFrame(originalTransform),
			})
		end
		maybeYield(yieldBudget)
	end
	return pose
end

function CutsceneRigAnimationExporter.exportToFolder(parent, timeline, buildInfo, options)
	options = options or {}
	local yieldBudget = options.yieldBudget or options._yieldBudget
	local rigFolder = Instance.new("Folder")
	rigFolder.Name = "RigAnimations"
	rigFolder.Parent = parent

	local jointsByRig = {}
	local allBonesByRig = {}
	for _, jointData in ipairs(timeline:getMotors()) do
		local joint = jointData.instance
		local rigName = jointData.rigName
		if rigName and joint and joint.Parent then
			local isBone = RigService.isBoneJoint(jointData) and joint:IsA("Bone")
			if isBone then
				allBonesByRig[rigName] = allBonesByRig[rigName] or {}
				table.insert(allBonesByRig[rigName], jointData)
			end
			if not timeline:isTrackDisabled(jointData.path) and (isBone or joint:IsA("Motor6D")) then
				jointsByRig[rigName] = jointsByRig[rigName] or {
					motors = {},
					bones = {},
				}
				local target = isBone and jointsByRig[rigName].bones or jointsByRig[rigName].motors
				table.insert(target, jointData)
			end
		end
		maybeYield(yieldBudget)
	end

	local exports = {}
	local rigNames = {}
	for rigName in pairs(jointsByRig) do
		table.insert(rigNames, rigName)
		maybeYield(yieldBudget)
	end
	table.sort(rigNames)
	maybeYield(yieldBudget)

	for _, rigName in ipairs(rigNames) do
		local joints = jointsByRig[rigName]
		local animatedJoints = {}
		for _, motorData in ipairs(joints.motors) do
			table.insert(animatedJoints, motorData)
		end
		for _, boneData in ipairs(joints.bones) do
			table.insert(animatedJoints, boneData)
		end
		local frames = collectRigFrames(timeline, animatedJoints, yieldBudget)
		if #frames &gt; 0 then
			local sequence = buildSequence(
				timeline,
				buildInfo,
				rigName,
				joints.motors,
				joints.bones,
				allBonesByRig[rigName],
				frames,
				yieldBudget
			)
			sequence.Parent = rigFolder
			local rig = timeline:getRigByName(rigName)
			table.insert(exports, {
				RigName = rigName,
				TargetPath = getInstancePath(rig),
				SequenceName = sequence.Name,
				FrameCount = #frames,
				Priority = timeline:getPriority(),
				Looped = timeline:getLooping() == true,
				OriginalMotorPose = buildOriginalMotorPose(timeline, joints.motors, yieldBudget),
				OriginalBonePose = buildOriginalBonePose(timeline, joints.bones, yieldBudget),
			})
		end
		maybeYield(yieldBudget)
	end

	if #exports == 0 then
		rigFolder:Destroy()
		return {}
	end

	return exports
end

return CutsceneRigAnimationExporter
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX51">
          <Properties>
            <string name="Name">CutsceneRuntimeGenerator</string>
            <ProtectedString name="Source">local CutsceneRuntimeGenerator = {}

local function isArray(value)
	if type(value) ~= "table" then
		return false
	end
	local count = 0
	for key in pairs(value) do
		if type(key) ~= "number" or key &lt; 1 or key % 1 ~= 0 then
			return false
		end
		count += 1
	end
	for index = 1, count do
		if value[index] == nil then
			return false
		end
	end
	return true
end

local function encodeKey(key)
	if type(key) == "string" and string.match(key, "^[%a_][%w_]*$") then
		return key
	end
	return "[" .. string.format("%q", tostring(key)) .. "]"
end

local function toLua(value, indent)
	indent = indent or 0
	local valueType = type(value)
	if valueType == "string" then
		return string.format("%q", value)
	end
	if valueType == "number" or valueType == "boolean" then
		return tostring(value)
	end
	if valueType ~= "table" then
		return "nil"
	end

	local nextIndent = indent + 1
	local padding = string.rep("\t", indent)
	local childPadding = string.rep("\t", nextIndent)
	local parts = { "{" }
	if isArray(value) then
		for _, child in ipairs(value) do
			table.insert(parts, "\n" .. childPadding .. toLua(child, nextIndent) .. ",")
		end
	else
		local keys = {}
		for key in pairs(value) do
			table.insert(keys, key)
		end
		table.sort(keys, function(a, b)
			return tostring(a) &lt; tostring(b)
		end)
		for _, key in ipairs(keys) do
			table.insert(parts, "\n" .. childPadding .. encodeKey(key) .. " = " .. toLua(value[key], nextIndent) .. ",")
		end
	end
	table.insert(parts, "\n" .. padding .. "}")
	return table.concat(parts)
end

function CutsceneRuntimeGenerator.dataSource(data)
	return "-- Generated by 7kg2 Animator. Edit in the plugin, then regenerate when needed.\nreturn " .. toLua(data, 0) .. "\n"
end

function CutsceneRuntimeGenerator.dataLoaderSource()
	return [=[-- Generated by 7kg2 Animator. Data is stored in CutsceneDataChunks to avoid Roblox Source size limits.
local HttpService = game:GetService("HttpService")

local chunksFolder = script.Parent:WaitForChild("CutsceneDataChunks")
local chunks = chunksFolder:GetChildren()
table.sort(chunks, function(a, b)
	return a.Name &lt; b.Name
end)

local pieces = {}
for _, chunk in ipairs(chunks) do
	if chunk:IsA("StringValue") then
		table.insert(pieces, chunk.Value)
	end
end

return HttpService:JSONDecode(table.concat(pieces))
]=]
end

function CutsceneRuntimeGenerator.playerSource()
	return [=[local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local TextService = game:GetService("TextService")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local MegMoCutscenePlayer = {}
local eventSignal = Instance.new("BindableEvent")
local namedEventCallbacks = {}
local activeCutsceneData = nil
local ATTACH_ATTRIBUTE = "MegMoAttachment"
local ATTACH_LIMB_PATH_ATTRIBUTE = "MegMoLimbPath"
local ATTACH_OBJECT_PATH_ATTRIBUTE = "MegMoAttachedObjectPath"
local ATTACH_WAS_ANCHORED_ATTRIBUTE = "MegMoPart1WasAnchored"
local ATTACH_WELD_ATTRIBUTE = "MegMoAttachmentWeld"
local ATTACH_OBJECT_VALUE_NAME = "MegMoAttachedObject"
local ATTACH_EVENT_KIND = "MegMoAttachmentEvent"
local CUTSCENE_ORIGINAL_ANCHORED_ATTRIBUTE = "MegMoCutsceneOriginalAnchored"
local CUTSCENE_ORIGINAL_CAN_COLLIDE_ATTRIBUTE = "MegMoCutsceneOriginalCanCollide"
local CUTSCENE_ORIGINAL_CAN_TOUCH_ATTRIBUTE = "MegMoCutsceneOriginalCanTouch"
local CUTSCENE_ORIGINAL_CAN_QUERY_ATTRIBUTE = "MegMoCutsceneOriginalCanQuery"
local CUTSCENE_ORIGINAL_MASSLESS_ATTRIBUTE = "MegMoCutsceneOriginalMassless"

local function ensureEventsFolder()
	local folder = script.Parent:FindFirstChild("CutsceneEvents")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "CutsceneEvents"
		folder.Parent = script.Parent
	end
	if not folder:FindFirstChild("Event") then
		local genericEvent = Instance.new("BindableEvent")
		genericEvent.Name = "Event"
		genericEvent.Parent = folder
	end
	return folder
end

function MegMoCutscenePlayer.OnEvent(callback)
	if type(callback) ~= "function" then
		return nil
	end
	return eventSignal.Event:Connect(callback)
end

function MegMoCutscenePlayer.BindEvent(eventName, callback)
	if type(callback) ~= "function" then
		return nil
	end
	local key = tostring(eventName or "Event")
	namedEventCallbacks[key] = namedEventCallbacks[key] or {}
	table.insert(namedEventCallbacks[key], callback)
	return {
		Disconnect = function()
			local callbacks = namedEventCallbacks[key]
			if not callbacks then
				return
			end
			for index = #callbacks, 1, -1 do
				if callbacks[index] == callback then
					table.remove(callbacks, index)
					break
				end
			end
		end,
	}
end

local function settingValue(name, fallback)
	local settingsFolder = script.Parent:FindFirstChild("CutsceneSettings")
	local valueObject = settingsFolder and settingsFolder:FindFirstChild(name)
	if valueObject and valueObject:IsA("ValueBase") then
		return valueObject.Value
	end
	return fallback
end

local function createPlaybackOverlay(allowSkip, skipState)
	if not RunService:IsClient() then
		return nil, nil
	end
	local localPlayer = Players.LocalPlayer
	local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return nil, nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "MegMoCutsceneOverlay"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 60000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	local fade = Instance.new("Frame")
	fade.Name = "Fade"
	fade.BackgroundColor3 = Color3.new(0, 0, 0)
	fade.BackgroundTransparency = 1
	fade.BorderSizePixel = 0
	fade.Size = UDim2.fromScale(1, 1)
	fade.ZIndex = 1
	fade.Parent = gui
	if allowSkip then
		local skip = Instance.new("TextButton")
		skip.Name = "SkipButton"
		skip.Active = true
		skip.AnchorPoint = Vector2.new(1, 0)
		skip.AutoButtonColor = true
		skip.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
		skip.BackgroundTransparency = 0.05
		skip.BorderSizePixel = 0
		skip.Font = Enum.Font.GothamSemibold
		skip.Position = UDim2.new(1, -24, 1, -72)
		skip.Size = UDim2.fromOffset(112, 38)
		skip.Text = "Skip"
		skip.TextColor3 = Color3.fromRGB(255, 255, 255)
		skip.TextSize = 18
		skip.TextTransparency = 0
		skip.Visible = true
		skip.ZIndex = 100000
		skip.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = skip
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(134, 96, 255)
		stroke.Thickness = 1
		stroke.Transparency = 0.15
		stroke.Parent = skip
		skip.Activated:Connect(function()
			skipState.requested = true
		end)
	end
	return gui, fade
end

local function runFade(frame, fromTransparency, toTransparency, seconds, skipState)
	seconds = math.max(0, tonumber(seconds) or 0)
	if not frame then
		return
	end
	if seconds &lt;= 0 then
		frame.BackgroundTransparency = toTransparency
		return
	end
	local stepEvent = RunService:IsClient() and RunService.RenderStepped or RunService.Heartbeat
	local startClock = os.clock()
	while true do
		local alpha = math.clamp((os.clock() - startClock) / seconds, 0, 1)
		frame.BackgroundTransparency = fromTransparency + (toTransparency - fromTransparency) * alpha
		if alpha &gt;= 1 or (skipState and skipState.requested) then
			break
		end
		stepEvent:Wait()
	end
end

local function decodeValue(value)
	if type(value) ~= "table" then
		return value
	end
	if value.type == "CFrame" and type(value.components) == "table" then
		return CFrame.new(table.unpack(value.components))
	end
	if value.type == "Color3" then
		return Color3.new(value.r or 1, value.g or 1, value.b or 1)
	end
	if value.type == "Vector3" then
		return Vector3.new(value.x or 0, value.y or 0, value.z or 0)
	end
	if value.type == "Vector2" then
		return Vector2.new(value.x or 0, value.y or 0)
	end
	if value.type == "NumberRange" then
		return NumberRange.new(value.min or 0, value.max or value.min or 0)
	end
	if value.type == "NumberSequence" and type(value.keypoints) == "table" then
		local keypoints = {}
		for _, keypoint in ipairs(value.keypoints) do
			table.insert(keypoints, NumberSequenceKeypoint.new(
				keypoint.time or 0,
				keypoint.value or 0,
				keypoint.envelope or 0
			))
		end
		return #keypoints &gt; 0 and NumberSequence.new(keypoints) or NumberSequence.new(0)
	end
	if value.type == "ColorSequence" and type(value.keypoints) == "table" then
		local keypoints = {}
		for _, keypoint in ipairs(value.keypoints) do
			local color = decodeValue(keypoint.value)
			if typeof(color) ~= "Color3" then
				color = Color3.new(1, 1, 1)
			end
			table.insert(keypoints, ColorSequenceKeypoint.new(keypoint.time or 0, color))
		end
		return #keypoints &gt; 0 and ColorSequence.new(keypoints) or ColorSequence.new(Color3.new(1, 1, 1))
	end
	if value.type == "EnumItem" and type(value.enumType) == "string" and type(value.name) == "string" then
		local enumName = value.enumType:match("^Enum%.(.+)$") or value.enumType
		local enum = Enum[enumName]
		if enum and enum[value.name] then
			return enum[value.name]
		end
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = decodeValue(child)
	end
	return result
end

local function resolvePath(path)
	if type(path) ~= "string" or path == "" or path == "Missing" then
		return nil
	end
	local parts = string.split(path, ".")
	local current
	local index = 1
	if parts[1] == "game" then
		current = game
		index = 2
	elseif parts[1] == "Workspace" then
		current = workspace
		index = 2
	elseif parts[1] == "ReplicatedStorage" then
		current = ReplicatedStorage
		index = 2
	elseif parts[1] == "SoundService" then
		current = SoundService
		index = 2
	elseif parts[1] == "Lighting" then
		current = Lighting
		index = 2
	elseif parts[1] == "workspace" then
		current = workspace
		index = 2
	else
		current = game
	end
	for i = index, #parts do
		current = current and current:FindFirstChild(parts[i])
	end
	return current
end

local function collectTrackKeys(project, predicate)
	local buckets = {}
	for _, track in ipairs(project.tracks or {}) do
		if predicate(track) then
			buckets[track.path] = {
				track = track,
				keys = {},
			}
		end
	end
	for frameText, pose in pairs(project.frames or {}) do
		local frame = tonumber(frameText)
		if frame then
			for path, entry in pairs(pose) do
				local bucket = buckets[path]
				if bucket then
					table.insert(bucket.keys, {
						frame = frame,
						value = decodeValue(type(entry) == "table" and entry.value or entry),
						easing = type(entry) == "table" and entry.easing or nil,
					})
				end
			end
		end
	end
	for _, bucket in pairs(buckets) do
		table.sort(bucket.keys, function(a, b)
			return a.frame &lt; b.frame
		end)
	end
	return buckets
end

local function getProjectLastKeyframe(project)
	local lastFrame = 0
	for frameText, pose in pairs(project.frames or {}) do
		if type(pose) == "table" then
			for _ in pairs(pose) do
				lastFrame = math.max(lastFrame, tonumber(frameText) or 0)
				break
			end
		end
	end
	return lastFrame
end

local function lerpValue(a, b, alpha)
	if typeof(a) == "CFrame" and typeof(b) == "CFrame" then
		return a:Lerp(b, alpha)
	end
	if typeof(a) == "Color3" and typeof(b) == "Color3" then
		return a:Lerp(b, alpha)
	end
	if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
		return a:Lerp(b, alpha)
	end
	if typeof(a) == "Vector2" and typeof(b) == "Vector2" then
		return a:Lerp(b, alpha)
	end
	if typeof(a) == "NumberRange" and typeof(b) == "NumberRange" then
		return NumberRange.new(
			a.Min + (b.Min - a.Min) * alpha,
			a.Max + (b.Max - a.Max) * alpha
		)
	end
	if type(a) == "number" and type(b) == "number" then
		return a + (b - a) * alpha
	end
	if type(a) == "table" and type(b) == "table" then
		local result = {}
		for key, value in pairs(a) do
			result[key] = value
		end
		for key, value in pairs(b) do
			result[key] = lerpValue(a[key], value, alpha)
		end
		return result
	end
	return alpha &lt; 1 and a or b
end

local function evaluate(keys, frame)
	if #keys == 0 then
		return nil
	end
	if frame &lt;= keys[1].frame then
		return keys[1].value
	end
	for index = 1, #keys - 1 do
		local current = keys[index]
		local nextKey = keys[index + 1]
		if frame &gt;= current.frame and frame &lt;= nextKey.frame then
			local span = math.max(1, nextKey.frame - current.frame)
			return lerpValue(current.value, nextKey.value, math.clamp((frame - current.frame) / span, 0, 1))
		end
	end
	return keys[#keys].value
end

local function evaluateHeld(keys, frame)
	if type(keys) ~= "table" or #keys == 0 or frame &lt; keys[1].frame then
		return nil
	end
	local value = keys[1].value
	for _, key in ipairs(keys) do
		if key.frame &lt;= frame then
			value = key.value
		else
			break
		end
	end
	return value
end

local function applyCameraValue(camera, value)
	if not camera or value == nil then
		return
	end
	if typeof(value) == "CFrame" then
		camera.CFrame = value
		return
	end
	if type(value) ~= "table" then
		return
	end
	local cframe = value.cframe or value.CFrame
	if typeof(cframe) == "CFrame" then
		camera.CFrame = cframe
	end
	local focus = value.focus or value.Focus
	if typeof(focus) == "CFrame" then
		camera.Focus = focus
	end
	local fov = value.fieldOfView or value.FieldOfView
	if type(fov) == "number" then
		camera.FieldOfView = math.clamp(fov, 1, 120)
	end
end

local CUTSCENE_SOUND_PREFIX = "MegMoCutsceneSound_"

local function playSound(track, value, context)
	if type(value) ~= "table" then
		return
	end

	local sourceSound = resolvePath(track.targetPath or "")
	if sourceSound and not sourceSound:IsA("Sound") then
		sourceSound = nil
	end

	local soundId = type(value.soundId) == "string" and value.soundId or ""
	if soundId == "" and sourceSound then
		soundId = sourceSound.SoundId
	end
	if soundId == "" then
		warn("[MegMoCutscenePlayer] Sound key has no SoundId: " .. tostring(track.name or track.path or "Sound"))
		return
	end

	local sound = Instance.new("Sound")
	sound.Name = CUTSCENE_SOUND_PREFIX .. tostring(track.name or "Sound")
	sound.SoundId = soundId
	sound.Volume = sourceSound and sourceSound.Volume or 1
	sound.PlaybackSpeed = sourceSound and sourceSound.PlaybackSpeed or 1
	sound.RollOffMinDistance = sourceSound and sourceSound.RollOffMinDistance or sound.RollOffMinDistance
	sound.RollOffMaxDistance = sourceSound and sourceSound.RollOffMaxDistance or sound.RollOffMaxDistance
	sound.RollOffMode = sourceSound and sourceSound.RollOffMode or sound.RollOffMode

	if type(value.volume) == "number" then
		sound.Volume = math.clamp(value.volume, 0, 10)
	end
	if type(value.playbackSpeed) == "number" then
		sound.PlaybackSpeed = math.clamp(value.playbackSpeed, 0.05, 20)
	end
	if type(value.rollOffMinDistance) == "number" then
		sound.RollOffMinDistance = math.max(0, value.rollOffMinDistance)
	end
	if type(value.rollOffMaxDistance) == "number" then
		sound.RollOffMaxDistance = math.max(sound.RollOffMinDistance, value.rollOffMaxDistance)
	end
	if typeof(value.rollOffMode) == "EnumItem" and value.rollOffMode.EnumType == Enum.RollOffMode then
		sound.RollOffMode = value.rollOffMode
	elseif type(value.rollOffMode) == "string" and Enum.RollOffMode[value.rollOffMode] then
		sound.RollOffMode = Enum.RollOffMode[value.rollOffMode]
	end
	if context then
		context.activeSounds = context.activeSounds or {}
		table.insert(context.activeSounds, sound)
	end

	local baseVolume = math.clamp(tonumber(sound.Volume) or 1, 0, 10)
	local startOffsetSeconds = math.max(0, tonumber(value.startOffsetSeconds or value.startOffset or value.trimStartSeconds) or 0)
	local endTrimSeconds = math.max(0, tonumber(value.endTrimSeconds or value.endTrim or value.trimEndSeconds) or 0)
	local fadeInSeconds = math.max(0, tonumber(value.fadeInSeconds or value.fadeIn or value.audioFadeInSeconds) or 0)
	local fadeOutSeconds = math.max(0, tonumber(value.fadeOutSeconds or value.fadeOut or value.audioFadeOutSeconds) or 0)
	local explicitClipDurationSeconds = math.max(0, tonumber(value.clipDurationSeconds or value.timelineClipDurationSeconds or value.stopDurationSeconds) or 0)
	local playbackSpeed = math.max(0.05, tonumber(sound.PlaybackSpeed) or 1)
	local trimStopScheduled = false
	local fadeStartClock = os.clock()
	local fadeConnection = nil
	local function stopVolumeFade()
		if fadeConnection then
			fadeConnection:Disconnect()
			fadeConnection = nil
		end
	end
	local function getClipDurationSeconds()
		if explicitClipDurationSeconds &gt; 0 then
			local duration = tonumber(sound.TimeLength) or 0
			if duration &gt; 0 then
				local sourceClipDuration = math.max(0, (duration - startOffsetSeconds - endTrimSeconds) / playbackSpeed)
				return math.min(explicitClipDurationSeconds, sourceClipDuration)
			end
			return explicitClipDurationSeconds
		end
		local duration = tonumber(sound.TimeLength) or 0
		if duration &lt;= 0 then
			return nil
		end
		return math.max(0, (duration - startOffsetSeconds - endTrimSeconds) / playbackSpeed)
	end
	local function updateVolumeFade()
		if not sound.Parent then
			stopVolumeFade()
			return
		end
		local elapsedSeconds = math.max(0, os.clock() - fadeStartClock)
		local scale = 1
		if fadeInSeconds &gt; 0 then
			scale = math.min(scale, math.clamp(elapsedSeconds / fadeInSeconds, 0, 1))
		end
		local clipDurationSeconds = getClipDurationSeconds()
		if fadeOutSeconds &gt; 0 and clipDurationSeconds and clipDurationSeconds &gt; 0 then
			scale = math.min(scale, math.clamp((clipDurationSeconds - elapsedSeconds) / fadeOutSeconds, 0, 1))
		end
		sound.Volume = baseVolume * math.clamp(scale, 0, 1)
	end
	local function startVolumeFade()
		updateVolumeFade()
		if fadeInSeconds &gt; 0 or fadeOutSeconds &gt; 0 then
			stopVolumeFade()
			fadeConnection = RunService.Heartbeat:Connect(updateVolumeFade)
		end
	end
	local function applyStartOffset()
		if startOffsetSeconds &lt;= 0 or not sound.Parent then
			return
		end
		pcall(function()
			sound.TimePosition = startOffsetSeconds
		end)
	end
	local function scheduleTrimStop()
		if trimStopScheduled or not sound.Parent then
			return
		end
		local clipDurationSeconds = getClipDurationSeconds()
		if clipDurationSeconds then
			if clipDurationSeconds &lt;= 0 then
				stopVolumeFade()
				sound:Destroy()
				return
			end
			trimStopScheduled = true
			task.delay(clipDurationSeconds, function()
				if sound.Parent then
					stopVolumeFade()
					sound:Destroy()
				end
			end)
			return
		end
		local duration = tonumber(sound.TimeLength) or 0
		if duration &lt;= 0 then
			return
		end
		local endPosition = math.max(0, duration - endTrimSeconds)
		local remainingSeconds = math.max(0, (endPosition - startOffsetSeconds) / playbackSpeed)
		if remainingSeconds &lt;= 0 then
			stopVolumeFade()
			sound:Destroy()
			return
		end
		trimStopScheduled = true
		task.delay(remainingSeconds, function()
			if sound.Parent then
				stopVolumeFade()
				sound:Destroy()
			end
		end)
	end
	pcall(function()
		sound.Loaded:Connect(function()
			applyStartOffset()
			scheduleTrimStop()
		end)
	end)

	sound.Parent = SoundService
	startVolumeFade()
	sound:Play()
	applyStartOffset()
	scheduleTrimStop()

	task.delay(0.1, function()
		if sound.Parent and not sound.IsPlaying then
			applyStartOffset()
			scheduleTrimStop()
			pcall(function()
				SoundService:PlayLocalSound(sound)
			end)
			applyStartOffset()
			scheduleTrimStop()
		end
	end)

	local endedConnection
	endedConnection = sound.Ended:Connect(function()
		if endedConnection then
			endedConnection:Disconnect()
		end
		stopVolumeFade()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	task.delay(math.max(120, (sound.TimeLength &gt; 0 and sound.TimeLength or 0) + 2), function()
		if endedConnection then
			endedConnection:Disconnect()
			endedConnection = nil
		end
		if sound.Parent then
			stopVolumeFade()
			sound:Destroy()
		end
	end)
end

local function stopActiveCutsceneSounds(context)
	for _, sound in ipairs((context and context.activeSounds) or {}) do
		if sound and sound.Parent then
			pcall(function()
				sound:Stop()
			end)
			pcall(function()
				sound:Destroy()
			end)
		end
	end
	if context then
		context.activeSounds = {}
	end
	for _, child in ipairs(SoundService:GetChildren()) do
		if child:IsA("Sound") and string.sub(child.Name, 1, #CUTSCENE_SOUND_PREFIX) == CUTSCENE_SOUND_PREFIX then
			pcall(function()
				child:Stop()
			end)
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

local SCREEN_EFFECT_TYPE = "Screen Effect"
local VIGNETTE_IMAGE = "rbxassetid://4576475446"
local GRAIN_LIGHT_IMAGE = "rbxassetid://460107958"
local GRAIN_DARK_IMAGE = "rbxassetid://460200108"

local SCREEN_EFFECT_DEFAULTS = {
	CameraFlash = {
		enabled = true,
		color = Color3.fromRGB(255, 255, 255),
		transparency = 0.15,
	},
	Letterbox = {
		enabled = true,
		barSize = 0.12,
		color = Color3.fromRGB(0, 0, 0),
		transparency = 0,
	},
	Vignette = {
		enabled = true,
		tone = "Dark",
		transparency = 0.18,
	},
	FilmGrain = {
		enabled = true,
		intensity = 0.35,
		transparency = 0.2,
	},
	Subtitle = {
		enabled = true,
		text = "Your subtitle goes here",
		font = "GothamSemibold",
		textSize = 28,
		textColor = Color3.fromRGB(245, 248, 255),
		backgroundColor = Color3.fromRGB(0, 0, 0),
		textTransparency = 0,
		backgroundTransparency = 0.28,
		textEnabled = true,
		backgroundEnabled = true,
		enterTransition = "Fade",
		exitTransition = "Fade",
		enterDuration = 0.15,
		exitDuration = 0.15,
		positionPreset = "Bottom",
		positionX = 0.5,
		positionY = 0.88,
		width = 0.62,
		autoFit = true,
	},
	ColorWash = {
		enabled = true,
		color = Color3.fromRGB(129, 80, 255),
		transparency = 0.72,
	},
	DepthOfField = {
		enabled = true,
		focusDistance = 10,
		inFocusRadius = 1.25,
		nearIntensity = 0.15,
		farIntensity = 0.9,
	},
	Fade = {
		enabled = true,
		color = Color3.fromRGB(0, 0, 0),
		transparency = 0.5,
	},
}

local function cloneTable(value)
	local clone = {}
	for key, child in pairs(value or {}) do
		if type(child) == "table" then
			clone[key] = cloneTable(child)
		else
			clone[key] = child
		end
	end
	return clone
end

local function normalizeScreenEffectType(effectType)
	local raw = tostring(effectType or "")
	if raw == "Film Grain" then
		raw = "FilmGrain"
	elseif raw == "Camera Flash" then
		raw = "CameraFlash"
	elseif raw == "Color Wash" then
		raw = "ColorWash"
	elseif raw == "Depth Of Field" or raw == "Depth of Field" then
		raw = "DepthOfField"
	end
	return SCREEN_EFFECT_DEFAULTS[raw] and raw or "Fade"
end

local function numberValue(value, fallback, minValue, maxValue)
	local number = tonumber(value)
	if not number then
		number = fallback
	end
	if minValue ~= nil or maxValue ~= nil then
		number = math.clamp(number, minValue or -math.huge, maxValue or math.huge)
	end
	return number
end

local function boolValue(value, fallback)
	if type(value) == "boolean" then
		return value
	end
	if value == nil then
		return fallback
	end
	local text = string.lower(tostring(value))
	return text == "true" or text == "1" or text == "yes" or text == "on" or text == "enabled"
end

local function colorValue(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	return fallback
end

local function normalizeScreenEffectValue(effectType, value)
	local effectId = normalizeScreenEffectType(effectType)
	local normalized = cloneTable(SCREEN_EFFECT_DEFAULTS[effectId])
	if type(value) ~= "table" then
		return normalized
	end

	normalized.enabled = boolValue(value.enabled, normalized.enabled)
	if effectId == "CameraFlash" or effectId == "ColorWash" or effectId == "Fade" then
		normalized.color = colorValue(value.color, normalized.color)
		normalized.transparency = numberValue(value.transparency, normalized.transparency, 0, 1)
	elseif effectId == "Letterbox" then
		normalized.barSize = numberValue(value.barSize, normalized.barSize, 0, 0.4)
		normalized.color = colorValue(value.color, normalized.color)
		normalized.transparency = numberValue(value.transparency, normalized.transparency, 0, 1)
	elseif effectId == "Vignette" then
		normalized.tone = tostring(value.tone or normalized.tone) == "Light" and "Light" or "Dark"
		normalized.transparency = numberValue(value.transparency, normalized.transparency, 0, 1)
	elseif effectId == "FilmGrain" then
		normalized.intensity = numberValue(value.intensity, normalized.intensity, 0, 1)
		normalized.transparency = numberValue(value.transparency, normalized.transparency, 0, 1)
	elseif effectId == "DepthOfField" then
		normalized.focusDistance = numberValue(value.focusDistance, normalized.focusDistance, 0, 1000)
		normalized.inFocusRadius = numberValue(value.inFocusRadius, normalized.inFocusRadius, 0, 1000)
		normalized.nearIntensity = numberValue(value.nearIntensity, normalized.nearIntensity, 0, 1)
		normalized.farIntensity = numberValue(value.farIntensity, normalized.farIntensity, 0, 1)
	elseif effectId == "Subtitle" then
		normalized.text = string.sub(tostring(value.text or normalized.text), 1, 240)
		normalized.font = tostring(value.font or normalized.font)
		normalized.textSize = numberValue(value.textSize, normalized.textSize, 8, 80)
		normalized.textColor = colorValue(value.textColor, normalized.textColor)
		normalized.backgroundColor = colorValue(value.backgroundColor, normalized.backgroundColor)
		normalized.textTransparency = numberValue(value.textTransparency, normalized.textTransparency, 0, 1)
		normalized.backgroundTransparency = numberValue(value.backgroundTransparency, normalized.backgroundTransparency, 0, 1)
		normalized.textEnabled = boolValue(value.textEnabled, normalized.textEnabled)
		normalized.backgroundEnabled = boolValue(value.backgroundEnabled, normalized.backgroundEnabled)
		normalized.enterTransition = tostring(value.enterTransition or normalized.enterTransition)
		normalized.exitTransition = tostring(value.exitTransition or normalized.exitTransition)
		normalized.enterDuration = numberValue(value.enterDuration, normalized.enterDuration, 0, 5)
		normalized.exitDuration = numberValue(value.exitDuration, normalized.exitDuration, 0, 5)
		normalized.positionPreset = tostring(value.positionPreset or normalized.positionPreset)
		normalized.positionX = numberValue(value.positionX, normalized.positionX, 0, 1)
		normalized.positionY = numberValue(value.positionY, normalized.positionY, 0, 1)
		normalized.width = numberValue(value.width, normalized.width, 0.2, 1)
		normalized.autoFit = boolValue(value.autoFit, normalized.autoFit)
		normalized._transitionAlpha = numberValue(value._transitionAlpha, 1, 0, 1)
		normalized._transitionPreset = tostring(value._transitionPreset or "None")
	end

	return normalized
end

local function enumFont(fontName)
	local ok, font = pcall(function()
		return Enum.Font[tostring(fontName or "GothamSemibold")]
	end)
	return ok and font or Enum.Font.GothamSemibold
end

local function getSubtitleViewportWidth(label)
	local parent = label and label.Parent
	if parent and parent.AbsoluteSize.X &gt; 0 then
		return parent.AbsoluteSize.X
	end
	local camera = workspace.CurrentCamera
	if camera then
		return math.max(320, camera.ViewportSize.X)
	end
	return 1280
end

local function getSubtitleHeight(label, text, font, textSize, widthScale, scale, autoFit)
	local displayTextSize = math.max(1, textSize)
	local baseHeight = math.max(34, displayTextSize + 18)
	if autoFit == false then
		return baseHeight
	end
	local viewportWidth = getSubtitleViewportWidth(label)
	local pixelWidth = math.max(120, viewportWidth * math.clamp(widthScale * scale, 0.1, 1.2))
	local bounds = nil
	local ok = pcall(function()
		bounds = TextService:GetTextSize(tostring(text or ""), displayTextSize, font, Vector2.new(math.max(24, pixelWidth - 24), math.huge))
	end)
	if not ok or typeof(bounds) ~= "Vector2" then
		return baseHeight
	end
	return math.ceil(math.max(baseHeight, bounds.Y + math.max(18, displayTextSize * 0.45)))
end

local function createGuiObject(className, properties)
	local instance = Instance.new(className)
	for property, value in pairs(properties or {}) do
		instance[property] = value
	end
	return instance
end

local function createCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 0)
	corner.Parent = parent
end

local function ensureScreenEffectsGui(context)
	if not RunService:IsClient() then
		return nil
	end
	if context.screenGui and context.screenGui.Parent then
		return context.screenGui
	end
	local localPlayer = Players.LocalPlayer
	local playerGui = localPlayer and (localPlayer:FindFirstChildOfClass("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 5))
	if not playerGui then
		return nil
	end

	local gui = createGuiObject("ScreenGui", {
		Name = "MegMoCutsceneScreenEffects",
		DisplayOrder = 50000,
		Enabled = true,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local root = createGuiObject("Frame", {
		Name = "Root",
		Parent = gui,
		Active = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50000,
	})
	gui.Parent = playerGui
	context.screenGui = gui
	context.screenRoot = root
	context.screenRefs = {}
	return gui
end

local function getScreenRoot(context)
	ensureScreenEffectsGui(context)
	return context.screenRoot
end

local function getFrameRef(context, name, zIndex)
	local refs = context.screenRefs or {}
	local ref = refs[name]
	if ref and ref.Parent then
		return ref
	end
	local root = getScreenRoot(context)
	if not root then
		return nil
	end
	ref = createGuiObject("Frame", {
		Name = name,
		Parent = root,
		Active = false,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = zIndex,
	})
	refs[name] = ref
	context.screenRefs = refs
	return ref
end

local function getImageRef(context, name, image, zIndex)
	local refs = context.screenRefs or {}
	local ref = refs[name]
	if ref and ref.Parent then
		return ref
	end
	local root = getScreenRoot(context)
	if not root then
		return nil
	end
	ref = createGuiObject("ImageLabel", {
		Name = name,
		Parent = root,
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = image,
		ImageTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.5),
		ScaleType = Enum.ScaleType.Stretch,
		Size = UDim2.fromScale(1.08, 1.08),
		Visible = false,
		ZIndex = zIndex,
	})
	refs[name] = ref
	context.screenRefs = refs
	return ref
end

local function setFullscreenFrame(context, name, value, zIndex)
	local frame = getFrameRef(context, name, zIndex)
	if not frame then
		return
	end
	frame.Visible = value ~= nil and value.enabled ~= false
	if frame.Visible then
		frame.BackgroundColor3 = colorValue(value.color, Color3.fromRGB(255, 255, 255))
		frame.BackgroundTransparency = numberValue(value.transparency, 1, 0, 1)
	end
end

local function subtitlePosition(value)
	local preset = tostring(value.positionPreset or "Bottom")
	local x = numberValue(value.positionX, 0.5, 0, 1)
	local y = numberValue(value.positionY, 0.88, 0, 1)
	local anchor = Vector2.new(0.5, 1)
	if preset == "Top" then
		x, y, anchor = 0.5, 0.14, Vector2.new(0.5, 0)
	elseif preset == "Center" then
		x, y, anchor = 0.5, 0.5, Vector2.new(0.5, 0.5)
	elseif preset == "Bottom" then
		x, y, anchor = 0.5, 0.88, Vector2.new(0.5, 1)
	else
		anchor = y &lt; 0.34 and Vector2.new(0.5, 0) or (y &gt; 0.66 and Vector2.new(0.5, 1) or Vector2.new(0.5, 0.5))
	end

	local alpha = numberValue(value._transitionAlpha, 1, 0, 1)
	local transition = tostring(value._transitionPreset or "None")
	if transition == "Slide Bottom" and alpha &lt; 1 then
		y = math.clamp(y + ((1 - alpha) * 0.2), 0, 1)
	end
	return x, y, anchor, alpha, transition
end

local function easeTransitionAlpha(alpha, transition)
	alpha = math.clamp(tonumber(alpha) or 1, 0, 1)
	if transition == "Popup" or transition == "Slide Bottom" then
		return 1 - ((1 - alpha) ^ 3)
	end
	return alpha
end

local function blendTransparency(baseTransparency, alpha)
	baseTransparency = math.clamp(tonumber(baseTransparency) or 0, 0, 1)
	alpha = math.clamp(tonumber(alpha) or 1, 0, 1)
	return math.clamp(1 - alpha + (baseTransparency * alpha), 0, 1)
end

local function getSubtitleRuntimeValue(bucket, frame, fps)
	local previousKey = nil
	local nextKey = nil
	for _, key in ipairs(bucket.keys or {}) do
		if key.frame &lt;= frame then
			previousKey = key
		elseif not nextKey then
			nextKey = key
			break
		end
	end
	if not previousKey then
		return nil
	end
	local value = normalizeScreenEffectValue("Subtitle", previousKey.value)
	if value.enabled == false then
		value._transitionAlpha = 0
		return value
	end
	local transitionAlpha = 1
	local transitionPreset = "None"
	local enterFrames = math.max(0, (tonumber(value.enterDuration) or 0) * fps)
	if enterFrames &gt; 0 and frame &lt;= previousKey.frame + enterFrames then
		transitionAlpha = math.min(transitionAlpha, math.clamp((frame - previousKey.frame) / enterFrames, 0, 1))
		transitionPreset = value.enterTransition or "Fade"
	end
	if nextKey and nextKey.frame &gt; previousKey.frame then
		local nextValue = normalizeScreenEffectValue("Subtitle", nextKey.value)
		local exitFrames = math.max(0, (tonumber(value.exitDuration) or 0) * fps)
		if nextValue.enabled == false and exitFrames &gt; 0 and frame &gt;= nextKey.frame - exitFrames then
			transitionAlpha = math.min(transitionAlpha, math.clamp((nextKey.frame - frame) / exitFrames, 0, 1))
			transitionPreset = value.exitTransition or "Fade"
		end
	end
	value._transitionAlpha = transitionAlpha
	value._transitionPreset = transitionPreset
	return value
end

local function evaluateScreenEffectKeys(keys, frame)
	if type(keys) ~= "table" or #keys == 0 or frame &lt; keys[1].frame then
		return nil
	end
	return evaluate(keys, frame)
end

local function applySubtitle(context, value)
	local refs = context.screenRefs or {}
	local label = refs.Subtitle
	if not label or not label.Parent then
		local root = getScreenRoot(context)
		if not root then
			return
		end
		label = createGuiObject("TextLabel", {
			Name = "Subtitle",
			Parent = root,
			Active = false,
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.28,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			TextColor3 = Color3.fromRGB(245, 248, 255),
			TextScaled = false,
			TextWrapped = true,
			Visible = false,
			ZIndex = 50008,
		})
		createCorner(label, 10)
		refs.Subtitle = label
		context.screenRefs = refs
	end
	label.Visible = value ~= nil and value.enabled ~= false
	if not label.Visible then
		return
	end
	local x, y, anchor, transitionAlpha, transitionPreset = subtitlePosition(value)
	local visualAlpha = easeTransitionAlpha(transitionAlpha, transitionPreset)
	local scale = transitionPreset == "Popup" and (0.72 + (0.28 * visualAlpha)) or 1
	local opacityAlpha = transitionPreset == "Popup" and 1 or visualAlpha
	local textSize = numberValue(value.textSize, 28, 8, 80)
	local width = numberValue(value.width, 0.62, 0.2, 1)
	local text = tostring(value.text or "")
	local font = enumFont(value.font)
	local height = getSubtitleHeight(label, text, font, textSize, width, scale, value.autoFit ~= false)
	label.AnchorPoint = anchor
	label.Position = UDim2.fromScale(x, y)
	label.Size = UDim2.new(width * scale, 0, 0, height)
	label.Text = text
	label.Font = font
	label.TextWrapped = value.autoFit ~= false
	label.TextSize = textSize
	label.TextColor3 = colorValue(value.textColor, Color3.fromRGB(245, 248, 255))
	label.BackgroundColor3 = colorValue(value.backgroundColor, Color3.fromRGB(0, 0, 0))
	label.TextTransparency = value.textEnabled == false and 1 or blendTransparency(value.textTransparency, opacityAlpha)
	label.BackgroundTransparency = value.backgroundEnabled == false and 1 or blendTransparency(value.backgroundTransparency, opacityAlpha)
end

local function applyLetterbox(context, value)
	local top = getFrameRef(context, "LetterboxTop", 50007)
	local bottom = getFrameRef(context, "LetterboxBottom", 50007)
	if not top or not bottom then
		return
	end
	local visible = value ~= nil and value.enabled ~= false
	local barSize = value and numberValue(value.barSize, 0.12, 0, 0.4) or 0.12
	top.Visible = visible
	bottom.Visible = visible
	if visible then
		top.Size = UDim2.new(1, 0, barSize, 0)
		bottom.AnchorPoint = Vector2.new(0, 1)
		bottom.Position = UDim2.fromScale(0, 1)
		bottom.Size = UDim2.new(1, 0, barSize, 0)
		top.BackgroundColor3 = colorValue(value.color, Color3.fromRGB(0, 0, 0))
		bottom.BackgroundColor3 = top.BackgroundColor3
		top.BackgroundTransparency = numberValue(value.transparency, 0, 0, 1)
		bottom.BackgroundTransparency = top.BackgroundTransparency
	end
end

local function applyVignette(context, value)
	local dark = getImageRef(context, "VignetteDark", VIGNETTE_IMAGE, 50003)
	local light = getImageRef(context, "VignetteLight", VIGNETTE_IMAGE, 50003)
	if not dark or not light then
		return
	end
	local visible = value ~= nil and value.enabled ~= false
	local tone = value and value.tone == "Light" and "Light" or "Dark"
	dark.Visible = visible and tone == "Dark"
	light.Visible = visible and tone == "Light"
	dark.ImageColor3 = Color3.fromRGB(255, 255, 255)
	light.ImageColor3 = Color3.fromRGB(255, 255, 255)
	dark.ImageTransparency = value and numberValue(value.transparency, 0.18, 0, 1) or 1
	light.ImageTransparency = value and numberValue(value.transparency, 0.18, 0, 1) or 1
end

local function applyFilmGrain(context, value)
	local light = getImageRef(context, "GrainLight", GRAIN_LIGHT_IMAGE, 50004)
	local dark = getImageRef(context, "GrainDark", GRAIN_DARK_IMAGE, 50005)
	if not light or not dark then
		return
	end
	local visible = value ~= nil and value.enabled ~= false
	light.Visible = visible
	dark.Visible = visible
	if visible then
		light.Position = UDim2.fromScale(-0.1, -0.1)
		dark.Position = UDim2.fromScale(-0.1, -0.1)
		light.AnchorPoint = Vector2.new(0, 0)
		dark.AnchorPoint = Vector2.new(0, 0)
		light.Size = UDim2.fromScale(1.2, 1.2)
		dark.Size = UDim2.fromScale(1.2, 1.2)
		local transparency = numberValue(value.transparency, 1 - numberValue(value.intensity, 0.35, 0, 1), 0, 1)
		light.ImageTransparency = transparency
		dark.ImageTransparency = math.clamp(transparency - 0.04, 0, 1)
	end
end

local function applyDepthOfField(context, value)
	if not value or value.enabled == false then
		if context.depthOfField then
			context.depthOfField.Enabled = false
		end
		return
	end
	local effect = context.depthOfField
	if not effect or not effect.Parent then
		effect = Instance.new("DepthOfFieldEffect")
		effect.Name = "MegMoCutsceneDepthOfField"
		effect.Parent = Lighting
		context.depthOfField = effect
	end
	effect.Enabled = true
	effect.FocusDistance = numberValue(value.focusDistance, 10, 0, 1000)
	effect.InFocusRadius = numberValue(value.inFocusRadius, 1.25, 0, 1000)
	effect.NearIntensity = numberValue(value.nearIntensity, 0.15, 0, 1)
	effect.FarIntensity = numberValue(value.farIntensity, 0.9, 0, 1)
end

local function renderScreenEffects(context, screenEffectTracks, frame, fps)
	local values = {}
	for _, bucket in pairs(screenEffectTracks or {}) do
		local effectId = normalizeScreenEffectType(bucket.track.valueType or bucket.track.effectType or bucket.track.name)
		local rawValue = effectId == "Subtitle" and getSubtitleRuntimeValue(bucket, frame, fps) or evaluateScreenEffectKeys(bucket.keys, frame)
		if rawValue ~= nil then
			values[effectId] = normalizeScreenEffectValue(effectId, rawValue)
		end
	end

	local hasAny = next(values) ~= nil
	if hasAny then
		ensureScreenEffectsGui(context)
	end
	if context.screenGui then
		context.screenGui.Enabled = hasAny
	end

	applyLetterbox(context, values.Letterbox)
	applyVignette(context, values.Vignette)
	setFullscreenFrame(context, "Fade", values.Fade, 50001)
	setFullscreenFrame(context, "ColorWash", values.ColorWash, 50002)
	applyFilmGrain(context, values.FilmGrain)
	setFullscreenFrame(context, "CameraFlash", values.CameraFlash, 50006)
	applySubtitle(context, values.Subtitle)
	applyDepthOfField(context, values.DepthOfField)
end

local function cleanupScreenEffects(context)
	if context.depthOfField then
		context.depthOfField:Destroy()
		context.depthOfField = nil
	end
	if context.screenGui then
		context.screenGui:Destroy()
		context.screenGui = nil
	end
	context.screenRoot = nil
	context.screenRefs = nil
end

local function getPlayerForCutscene(options)
	options = options or {}
	local userId = tonumber(options.triggeringUserId)
	if userId and userId &gt; 0 then
		local player = Players:GetPlayerByUserId(userId)
		if player then
			return player
		end
	end
	return Players.LocalPlayer
end

local function getPlayerCharacter(options)
	local player = getPlayerForCutscene(options)
	return player and player.Character or nil
end

local function shouldUsePlayerClone(infoOrRigName)
	local mode = tostring(settingValue("RigTargetMode", "WorkspaceRig"))
	if mode ~= "TriggeringPlayerClone" then
		return false
	end
	local selectedRigName = tostring(settingValue("PlayerRigName", ""))
	if selectedRigName == "" then
		local firstRig = activeCutsceneData and activeCutsceneData.RigAnimations and activeCutsceneData.RigAnimations[1]
		selectedRigName = firstRig and tostring(firstRig.RigName or "") or ""
		if selectedRigName == "" then
			return true
		end
	end
	local rigName = type(infoOrRigName) == "table" and tostring(infoOrRigName.RigName or "") or tostring(infoOrRigName or "")
	return rigName == selectedRigName
end

local function hideSourceCharacter(context, character)
	if not character or context.hiddenCharacter == character or settingValue("HidePlayerDuringCutscene", true) ~= true then
		return
	end
	context.hiddenCharacter = character
	context.hiddenParts = {}
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(context.hiddenParts, {
				part = descendant,
				transparency = descendant.LocalTransparencyModifier,
			})
			descendant.LocalTransparencyModifier = 1
		end
	end
end

local function restoreSourceCharacter(context)
	for _, item in ipairs(context.hiddenParts or {}) do
		if item.part and item.part.Parent then
			item.part.LocalTransparencyModifier = item.transparency or 0
		end
	end
	context.hiddenParts = {}
	context.hiddenCharacter = nil
end

local function removeScriptsFromClone(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end
end

local function resolveCFrameTarget(track, context)
	if context and track and track.targetScope == "RigProperty" and shouldUsePlayerClone(track.rigName or track.part0 or track.name) then
		return context.rigTargets[track.rigName or track.part0 or track.name]
	end
	local targetPath = track and tostring(track.targetPath or "") or ""
	if context and context.cutscenePropTargetsByPath and context.cutscenePropTargetsByPath[targetPath] then
		return context.cutscenePropTargetsByPath[targetPath]
	end
	return resolvePath(track.targetPath or "")
end

local function applyCFrameValue(track, value, context)
	local target = resolveCFrameTarget(track, context)
	if not target then
		return
	end
	local cframe = nil
	if typeof(value) == "CFrame" then
		cframe = value
	elseif type(value) == "table" then
		cframe = value.cframe or value.CFrame
	end
	if typeof(cframe) ~= "CFrame" then
		return
	end
	if target:IsA("Model") then
		target:PivotTo(cframe)
	elseif target:IsA("BasePart") then
		target.CFrame = cframe
	end
end

local function isCFrameLikeTrack(track)
	return track
		and (track.propertyName == "CFrame" or track.valueType == "CFrame" or track.name == "CFrame")
end

local function isDirectCFramePlaybackTrack(track)
	if not isCFrameLikeTrack(track) then
		return false
	end
	if track.trackType == "Camera" or track.targetScope == "CameraProperty" then
		return false
	end
	if track.trackType == "Rig" then
		return false
	end
	if track.trackType == "Object" or track.trackType == "Model" or track.trackType == "Rig CFrame" then
		return true
	end
	if track.targetScope == "RigProperty" or track.targetScope == "ObjectProperty" then
		return true
	end
	return not track.part0 and not track.part1
end

local FACE_LAYER_NAMES = {
	"BothEyes",
	"LeftEye",
	"RightEye",
	"Mouth",
	"LeftEyebrow",
	"RightEyebrow",
}
local FACE_LAYER_GUI_NAME = "MegMoLayeredFaceGui"
local FACE_LAYER_SHELL_ATTRIBUTE = "MegMoGeneratedFaceShell"
local FACE_LAYER_SHELL_PREFIX = "MegMoFaceShell_"
local FACE_LAYER_MOTOR_PREFIX = "MegMoFaceShellMotor_"
local FACE_LAYER_FRONT_OFFSET = 0.012
local FACE_LAYER_DEPTH_STEP = 0.003
local FACE_LAYER_OFFSET_LIMIT = 0.35
local FACE_LAYER_SCALE_MIN = 0.35
local FACE_LAYER_SCALE_MAX = 1.75
local FACE_LAYER_TRANSFORM_EPSILON = 0.001

local LIGHTING_EFFECT_MAP = {
	Lighting = {
		properties = {
			brightness = "Brightness",
			clockTime = "ClockTime",
			exposureCompensation = "ExposureCompensation",
			ambient = "Ambient",
			outdoorAmbient = "OutdoorAmbient",
			colorShiftTop = "ColorShift_Top",
			colorShiftBottom = "ColorShift_Bottom",
			fogColor = "FogColor",
			fogStart = "FogStart",
			fogEnd = "FogEnd",
			globalShadows = "GlobalShadows",
		},
	},
	Atmosphere = {
		className = "Atmosphere",
		instanceName = "MegMoAnimatorAtmosphere",
		properties = {
			density = "Density",
			offset = "Offset",
			color = "Color",
			decay = "Decay",
			glare = "Glare",
			haze = "Haze",
		},
	},
	Sky = {
		className = "Sky",
		instanceName = "MegMoAnimatorSky",
		properties = {
			skyboxBk = "SkyboxBk",
			skyboxDn = "SkyboxDn",
			skyboxFt = "SkyboxFt",
			skyboxLf = "SkyboxLf",
			skyboxRt = "SkyboxRt",
			skyboxUp = "SkyboxUp",
			sunAngularSize = "SunAngularSize",
			moonAngularSize = "MoonAngularSize",
			starCount = "StarCount",
		},
	},
	Bloom = {
		className = "BloomEffect",
		instanceName = "MegMoAnimatorBloom",
		properties = {
			enabled = "Enabled",
			intensity = "Intensity",
			size = "Size",
			threshold = "Threshold",
		},
	},
	DepthOfField = {
		className = "DepthOfFieldEffect",
		instanceName = "MegMoAnimatorLightingDepthOfField",
		properties = {
			enabled = "Enabled",
			focusDistance = "FocusDistance",
			inFocusRadius = "InFocusRadius",
			nearIntensity = "NearIntensity",
			farIntensity = "FarIntensity",
		},
	},
	SunRays = {
		className = "SunRaysEffect",
		instanceName = "MegMoAnimatorSunRays",
		properties = {
			enabled = "Enabled",
			intensity = "Intensity",
			spread = "Spread",
		},
	},
	ColorCorrection = {
		className = "ColorCorrectionEffect",
		instanceName = "MegMoAnimatorColorCorrection",
		properties = {
			enabled = "Enabled",
			brightness = "Brightness",
			contrast = "Contrast",
			saturation = "Saturation",
			tintColor = "TintColor",
		},
	},
	Blur = {
		className = "BlurEffect",
		instanceName = "MegMoAnimatorBlur",
		properties = {
			enabled = "Enabled",
			size = "Size",
		},
	},
	Highlight = {
		className = "Highlight",
		instanceName = "MegMoAnimatorHighlight",
		properties = {
			enabled = "Enabled",
			fillColor = "FillColor",
			outlineColor = "OutlineColor",
			fillTransparency = "FillTransparency",
			outlineTransparency = "OutlineTransparency",
		},
	},
}

local LIGHTING_ALIASES = {
	["Depth Of Field"] = "DepthOfField",
	["Depth of Field"] = "DepthOfField",
	DepthOfFieldEffect = "DepthOfField",
	Sunrays = "SunRays",
	SunRaysEffect = "SunRays",
	["Color Correction"] = "ColorCorrection",
	ColorCorrectionEffect = "ColorCorrection",
	BlurEffect = "Blur",
	BloomEffect = "Bloom",
}

local function safeWrite(instance, propertyName, value)
	if not instance or propertyName == nil or value == nil then
		return false
	end
	local ok = pcall(function()
		instance[propertyName] = value
	end)
	return ok == true
end

local function safeRead(instance, propertyName)
	local ok, value = pcall(function()
		return instance[propertyName]
	end)
	return ok and value or nil
end

local function normalizeLightingEffectType(effectType)
	local raw = tostring(effectType or "")
	raw = LIGHTING_ALIASES[raw] or raw:gsub("%s+", "")
	return LIGHTING_EFFECT_MAP[raw] and raw or "Lighting"
end

local function getLightingEffectInstance(effectId)
	local definition = LIGHTING_EFFECT_MAP[effectId]
	if not definition then
		return nil
	end
	if effectId == "Lighting" then
		return Lighting
	end
	if effectId == "Highlight" then
		local existing = workspace:FindFirstChild(definition.instanceName)
		if existing and existing:IsA("Highlight") then
			return existing
		end
		local highlight = Instance.new("Highlight")
		highlight.Name = definition.instanceName
		highlight.Parent = workspace
		return highlight
	end
	local existing = Lighting:FindFirstChild(definition.instanceName)
	if existing and existing.ClassName == definition.className then
		return existing
	end
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.ClassName == definition.className and (child.Name == definition.instanceName or child.Name == effectId) then
			return child
		end
	end
	local created = Instance.new(definition.className)
	created.Name = definition.instanceName
	created.Parent = Lighting
	return created
end

local function applyLightingEffectValue(track, value)
	if type(value) ~= "table" then
		return false
	end
	local effectId = normalizeLightingEffectType(track.valueType or track.effectType or track.name)
	local definition = LIGHTING_EFFECT_MAP[effectId]
	local instance = getLightingEffectInstance(effectId)
	if not definition or not instance then
		return false
	end
	local changed = false
	for key, propertyName in pairs(definition.properties or {}) do
		if value[key] ~= nil and safeWrite(instance, propertyName, value[key]) then
			changed = true
		end
	end
	if effectId == "Highlight" then
		if value.depthMode ~= nil then
			local depthMode = tostring(value.depthMode) == "Occluded" and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
			changed = safeWrite(instance, "DepthMode", depthMode) or changed
		end
		if value.adorneePath ~= nil then
			changed = safeWrite(instance, "Adornee", resolvePath(value.adorneePath)) or changed
		end
	end
	return changed
end

local function findDescendantByRelativePath(root, fullPath)
	if not root or type(fullPath) ~= "string" then
		return nil
	end
	local parts = string.split(fullPath, ".")
	local startIndex = nil
	for index, partName in ipairs(parts) do
		if partName == root.Name then
			startIndex = index + 1
			break
		end
	end
	if not startIndex then
		return nil
	end
	local current = root
	for index = startIndex, #parts do
		current = current and current:FindFirstChild(parts[index])
	end
	return current
end

local function findDescendantFromOriginalRigPath(playbackRig, originalRigName, fullPath)
	if not playbackRig or type(fullPath) ~= "string" then
		return nil
	end
	originalRigName = tostring(originalRigName or "")
	if originalRigName == "" then
		return nil
	end
	local parts = string.split(fullPath, ".")
	local startIndex = nil
	for index, partName in ipairs(parts) do
		if partName == originalRigName then
			startIndex = index + 1
			break
		end
	end
	if not startIndex then
		return nil
	end
	local current = playbackRig
	for index = startIndex, #parts do
		current = current and current:FindFirstChild(parts[index])
	end
	return current
end

local function findRigMotorFromLimbPath(playbackRig, originalRigName, limbPath)
	if not playbackRig or type(limbPath) ~= "string" then
		return nil
	end
	originalRigName = tostring(originalRigName or "")
	if originalRigName == "" then
		return nil
	end
	local parts = string.split(limbPath, "/")
	if parts[1] ~= originalRigName then
		return nil
	end
	local current = playbackRig
	for index = 2, #parts do
		current = current and current:FindFirstChild(parts[index])
	end
	return current and current:IsA("Motor6D") and current or nil
end

local function resolvePlaybackRigAttachmentPart(context, value)
	if not context or not context.rigTargets or type(value) ~= "table" then
		return nil
	end
	local limbPath = tostring(value.limbPath or "")
	local handPartPath = tostring(value.handPartPath or "")
	for rigName, playbackRig in pairs(context.rigTargets) do
		local fromPath = findDescendantFromOriginalRigPath(playbackRig, rigName, handPartPath)
		if fromPath and fromPath:IsA("BasePart") then
			return fromPath
		end
		local motor = findRigMotorFromLimbPath(playbackRig, rigName, limbPath)
		local part = motor and motor.Part1
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local function resolveRigByName(rigName, context)
	rigName = tostring(rigName or "")
	if rigName == "" then
		return nil
	end
	if context and context.rigTargets and context.rigTargets[rigName] then
		return context.rigTargets[rigName]
	end
	return workspace:FindFirstChild(rigName, true)
end

local function resolveTrackTarget(track, context)
	if not track then
		return nil
	end
	local rigName = tostring(track.rigName or "")
	if rigName ~= "" and context and shouldUsePlayerClone(rigName) then
		local rig = context.rigTargets[rigName]
		if rig then
			if track.targetScope == "RigProperty" or track.trackType == "Rig CFrame" then
				return rig
			end
			local relative = findDescendantByRelativePath(rig, track.targetPath or "")
			if relative then
				return relative
			end
			local parentName = tostring(track.parentTrackName or "")
			if parentName ~= "" then
				return rig:FindFirstChild(parentName, true)
			end
		end
	end
	local targetPath = tostring(track.targetPath or "")
	if context and context.cutscenePropTargetsByPath and context.cutscenePropTargetsByPath[targetPath] then
		return context.cutscenePropTargetsByPath[targetPath]
	end
	return resolvePath(track.targetPath or "")
end

local function collectBaseParts(target)
	local parts = {}
	if not target then
		return parts
	end
	if target:IsA("BasePart") then
		table.insert(parts, target)
	elseif target:IsA("Motor6D") then
		local part = target.Part1
		if part and part.Parent and part:IsA("BasePart") then
			table.insert(parts, part)
		end
	elseif target:IsA("Model") or target:IsA("Folder") then
		for _, descendant in ipairs(target:GetDescendants()) do
			if descendant:IsA("BasePart") then
				table.insert(parts, descendant)
			end
		end
	end
	return parts
end

local function getInstanceCFrame(instance)
	if not instance or not instance.Parent then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance.CFrame
	end
	if instance:IsA("Model") then
		return instance:GetPivot()
	end
	if instance:IsA("Attachment") then
		return instance.WorldCFrame
	end
	return nil
end

local function setInstanceCFrame(instance, cframe)
	if not instance or not instance.Parent or typeof(cframe) ~= "CFrame" then
		return false
	end
	if instance:IsA("BasePart") then
		instance.CFrame = cframe
		return true
	end
	if instance:IsA("Model") then
		instance:PivotTo(cframe)
		return true
	end
	if instance:IsA("Attachment") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			parent.CFrame = cframe * instance.CFrame:Inverse()
			return true
		end
	end
	return false
end

local function snapshotCFramePlaybackTargets(context, cframeTracks)
	if not context then
		return
	end
	context.cframeTargetSnapshots = {}
	for _, bucket in pairs(cframeTracks or {}) do
		local track = bucket and bucket.track
		local target = track and resolveCFrameTarget(track, context)
		if target and not context.cframeTargetSnapshots[target] then
			context.cframeTargetSnapshots[target] = getInstanceCFrame(target)
		end
	end
end

local function restoreCFramePlaybackTargets(context)
	for target, cframe in pairs((context and context.cframeTargetSnapshots) or {}) do
		if target and target.Parent and typeof(cframe) == "CFrame" then
			setInstanceCFrame(target, cframe)
			for _, part in ipairs(collectBaseParts(target)) do
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
	if context then
		context.cframeTargetSnapshots = {}
	end
end

local function getRelativePath(root, descendant)
	if not root or not descendant then
		return nil
	end
	if root == descendant then
		return ""
	end
	local names = {}
	local current = descendant
	while current and current ~= root do
		table.insert(names, 1, current.Name)
		current = current.Parent
	end
	if current ~= root then
		return nil
	end
	return table.concat(names, "/")
end

local function findRelativeByPath(root, relativePath)
	if not root or relativePath == nil then
		return nil
	end
	relativePath = tostring(relativePath)
	if relativePath == "" then
		return root
	end
	local current = root
	for name in string.gmatch(relativePath, "[^/]+") do
		current = current and current:FindFirstChild(name)
	end
	return current
end

local function configureCutscenePlaybackProp(target)
	for _, part in ipairs(collectBaseParts(target)) do
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.LocalTransparencyModifier = 0
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
end

local function hideCutscenePropSource(context, sourceTarget)
	if not context or not sourceTarget then
		return
	end
	context.hiddenCutscenePropParts = context.hiddenCutscenePropParts or {}
	context.hiddenCutscenePropSources = context.hiddenCutscenePropSources or {}
	if context.hiddenCutscenePropSources[sourceTarget] then
		return
	end
	context.hiddenCutscenePropSources[sourceTarget] = true
	for _, part in ipairs(collectBaseParts(sourceTarget)) do
		table.insert(context.hiddenCutscenePropParts, {
			part = part,
			transparency = part.LocalTransparencyModifier,
		})
		part.LocalTransparencyModifier = 1
	end
end

local function restoreCutscenePropSources(context)
	for _, item in ipairs((context and context.hiddenCutscenePropParts) or {}) do
		if item.part and item.part.Parent then
			item.part.LocalTransparencyModifier = item.transparency or 0
		end
	end
	if context then
		context.hiddenCutscenePropParts = {}
		context.hiddenCutscenePropSources = {}
	end
end

local function hideCutscenePropTarget(target)
	for _, part in ipairs(collectBaseParts(target)) do
		if part and part.Parent then
			part.LocalTransparencyModifier = 1
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
		end
	end
end

local function setCutscenePropTargetCFrame(state, cframe)
	if state and state.sourceTarget and typeof(cframe) == "CFrame" then
		setInstanceCFrame(state.sourceTarget, cframe)
		return true
	end
	return false
end

local function createCutscenePlaybackProp(context, sourceTarget, objectPath, attachPartPath)
	if not context or not sourceTarget then
		return nil, nil
	end
	context.cutscenePropTargetsByPath = context.cutscenePropTargetsByPath or {}
	objectPath = tostring(objectPath or "")
	attachPartPath = tostring(attachPartPath or "")
	if objectPath ~= "" and context.cutscenePropTargetsByPath[objectPath] then
		return context.cutscenePropTargetsByPath[objectPath], context.cutscenePropTargetsByPath[attachPartPath]
	end

	local oldArchivable = sourceTarget.Archivable
	sourceTarget.Archivable = true
	local ok, cloneOrError = pcall(function()
		return sourceTarget:Clone()
	end)
	sourceTarget.Archivable = oldArchivable
	local clone = ok and cloneOrError or nil
	if not clone then
		warn("[MegMoCutscenePlayer] Could not create playback prop for " .. tostring(objectPath ~= "" and objectPath or sourceTarget.Name) .. ".")
		return nil, nil
	end

	clone.Name = "MegMoCutsceneProp_" .. tostring(sourceTarget.Name)
	removeScriptsFromClone(clone)
	clone.Parent = workspace
	local sourceCFrame = getInstanceCFrame(sourceTarget)
	if sourceCFrame then
		setInstanceCFrame(clone, sourceCFrame)
	end
	configureCutscenePlaybackProp(clone)
	hideCutscenePropSource(context, sourceTarget)
	table.insert(context.clones, clone)

	local playbackAttachPart = nil
	local sourceAttachPart = attachPartPath ~= "" and resolvePath(attachPartPath) or nil
	if sourceAttachPart then
		playbackAttachPart = findRelativeByPath(clone, getRelativePath(sourceTarget, sourceAttachPart)) or clone
	end

	if objectPath ~= "" then
		context.cutscenePropTargetsByPath[objectPath] = clone
	end
	if attachPartPath ~= "" and playbackAttachPart then
		context.cutscenePropTargetsByPath[attachPartPath] = playbackAttachPart
	end
	return clone, playbackAttachPart
end

local function isAttachmentEventValue(value)
	return type(value) == "table" and value.kind == ATTACH_EVENT_KIND
end

local function collectAttachmentEvents(attachmentTracks)
	local events = {}
	for _, bucket in pairs(attachmentTracks or {}) do
		for _, key in ipairs(bucket.keys or {}) do
			if isAttachmentEventValue(key.value) then
				table.insert(events, {
					frame = key.frame,
					track = bucket.track,
					value = key.value,
				})
			end
		end
	end
	table.sort(events, function(a, b)
		return a.frame &lt; b.frame
	end)
	return events
end

local function snapshotCutsceneProp(target, fallbackCFrame)
	local state = {
		target = target,
		originalCFrame = getInstanceCFrame(target) or fallbackCFrame,
		parts = {},
		attachmentMode = "original",
	}
	for _, part in ipairs(collectBaseParts(target)) do
		local originalAnchored = part:GetAttribute(CUTSCENE_ORIGINAL_ANCHORED_ATTRIBUTE)
		local originalCanCollide = part:GetAttribute(CUTSCENE_ORIGINAL_CAN_COLLIDE_ATTRIBUTE)
		local originalCanTouch = part:GetAttribute(CUTSCENE_ORIGINAL_CAN_TOUCH_ATTRIBUTE)
		local originalCanQuery = part:GetAttribute(CUTSCENE_ORIGINAL_CAN_QUERY_ATTRIBUTE)
		local originalMassless = part:GetAttribute(CUTSCENE_ORIGINAL_MASSLESS_ATTRIBUTE)
		table.insert(state.parts, {
			part = part,
			anchored = type(originalAnchored) == "boolean" and originalAnchored or part.Anchored,
			canCollide = type(originalCanCollide) == "boolean" and originalCanCollide or part.CanCollide,
			canTouch = type(originalCanTouch) == "boolean" and originalCanTouch or part.CanTouch,
			canQuery = type(originalCanQuery) == "boolean" and originalCanQuery or part.CanQuery,
			massless = type(originalMassless) == "boolean" and originalMassless or part.Massless,
		})
	end
	return state
end

local function freezeCutsceneProp(state, cframe)
	if not state or not state.target then
		return
	end
	local anchoredDuringPlayback = state.playbackTarget ~= nil
	if typeof(cframe) == "CFrame" then
		setInstanceCFrame(state.target, cframe)
	end
	for _, item in ipairs(state.parts or {}) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = anchoredDuringPlayback
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Massless = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	state.attachmentMode = "preAttach"
end

local function setCutscenePropAttachedPhysics(state)
	if not state then
		return
	end
	local anchoredDuringPlayback = state.playbackTarget ~= nil
	for _, item in ipairs(state.parts or {}) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = anchoredDuringPlayback
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Massless = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	state.attachmentMode = "attached"
end

local function setCutscenePropDetachedPlaybackPhysics(state)
	if not state then
		return
	end
	local anchoredDuringPlayback = state.playbackTarget ~= nil
	for _, item in ipairs(state.parts or {}) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = anchoredDuringPlayback
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Massless = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	state.attachmentMode = "detached"
end

local function restoreCutscenePropPhysics(state)
	if not state then
		return
	end
	for _, item in ipairs(state.parts or {}) do
		local part = item.part
		if part and part.Parent then
			part.Anchored = item.anchored == true
			part.CanCollide = item.canCollide == true
			part.CanTouch = item.canTouch ~= false
			part.CanQuery = item.canQuery ~= false
			part.Massless = item.massless == true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	state.attachmentMode = "detached"
end

local function restoreCutsceneProps(context, endStateOverride)
	local endState = tostring(endStateOverride or settingValue("AttachedPropEndState", "Restore"))
	for objectPath, state in pairs((context and context.cutsceneProps) or {}) do
		local finalCFrame = getInstanceCFrame(state.target)
		for _, descendant in ipairs(workspace:GetDescendants()) do
			if descendant:IsA("WeldConstraint")
				and descendant:GetAttribute(ATTACH_WELD_ATTRIBUTE) == true
				and descendant:GetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE) == objectPath then
				descendant:Destroy()
			end
		end
		if endState == "HideLocally" then
			restoreCutscenePropPhysics(state)
			hideCutscenePropTarget(state.sourceTarget or state.target)
		elseif endState == "KeepFinal" then
			restoreCutscenePropPhysics(state)
			if finalCFrame then
				setCutscenePropTargetCFrame(state, finalCFrame)
			end
		else
			restoreCutscenePropPhysics(state)
			if state.target and state.target.Parent and typeof(state.originalCFrame) == "CFrame" then
				setInstanceCFrame(state.target, state.originalCFrame)
			end
		end
	end
	if context then
		context.cutsceneProps = {}
		context.cutscenePropTargetsByPath = {}
	end
	if endState == "Restore" or endState == "KeepFinal" then
		restoreCutscenePropSources(context)
	end
end

local function findRuntimeAttachmentMotor(objectPath)
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Motor6D")
			and descendant:GetAttribute(ATTACH_ATTRIBUTE) == true
			and descendant:GetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE) == objectPath then
			return descendant
		end
	end
	return nil
end

local function removeRuntimeAttachmentMotor(objectPath)
	local motor = findRuntimeAttachmentMotor(objectPath)
	if motor then
		motor:Destroy()
		return true
	end
	return false
end

local function findRuntimeAttachmentWeld(rootPart, part, objectPath)
	if not rootPart or not part then
		return nil
	end
	for _, child in ipairs(rootPart:GetChildren()) do
		if child:IsA("WeldConstraint")
			and child:GetAttribute(ATTACH_WELD_ATTRIBUTE) == true
			and child:GetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE) == objectPath
			and ((child.Part0 == rootPart and child.Part1 == part) or (child.Part1 == rootPart and child.Part0 == part)) then
			return child
		end
	end
	return nil
end

local function ensureRuntimeAttachmentAssembly(target, attachPart, objectPath)
	if not target or not attachPart or not attachPart:IsA("BasePart") then
		return
	end
	for _, part in ipairs(collectBaseParts(target)) do
		if part ~= attachPart and part.Parent and not findRuntimeAttachmentWeld(attachPart, part, objectPath) then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "MegMoCutsceneAttachWeld_" .. part.Name
			weld.Part0 = attachPart
			weld.Part1 = part
			weld:SetAttribute(ATTACH_WELD_ATTRIBUTE, true)
			weld:SetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE, objectPath)
			weld.Parent = attachPart
		end
	end
end

local function pivotAttachedTargetToPart(target, attachPart, desiredAttachCFrame)
	if not target or not attachPart or not attachPart.Parent or typeof(desiredAttachCFrame) ~= "CFrame" then
		return false
	end
	if target:IsA("Model") then
		local pivot = target:GetPivot()
		local attachRelativeToPivot = pivot:ToObjectSpace(attachPart.CFrame)
		target:PivotTo(desiredAttachCFrame * attachRelativeToPivot:Inverse())
		return true
	end
	if target:IsA("BasePart") then
		local targetRelativeToAttach = attachPart.CFrame:ToObjectSpace(target.CFrame)
		target.CFrame = desiredAttachCFrame * targetRelativeToAttach
		return true
	end
	local parts = collectBaseParts(target)
	if #parts &gt; 0 then
		local delta = desiredAttachCFrame * attachPart.CFrame:Inverse()
		for _, part in ipairs(parts) do
			if part and part.Parent then
				part.CFrame = delta * part.CFrame
			end
		end
		return true
	end
	return false
end

local function prepareCutsceneProps(context, attachmentTracks)
	context.cutsceneProps = context.cutsceneProps or {}
	context.attachmentEvents = collectAttachmentEvents(attachmentTracks)
	context.firstAttachmentByObjectPath = {}
	context.latestAttachmentByObjectPath = {}
	context.suppressedCFrameTrackPaths = {}
	local shouldFreezeProps = settingValue("FreezeCutsceneProps", true) == true
	for _, event in ipairs(context.attachmentEvents) do
		local value = event.value
		local objectPath = tostring(value.objectPath or "")
		if objectPath ~= "" and not context.firstAttachmentByObjectPath[objectPath] then
			context.firstAttachmentByObjectPath[objectPath] = event
		end
		if shouldFreezeProps and objectPath ~= "" and not context.cutsceneProps[objectPath] then
			local sourceTarget = resolvePath(objectPath) or resolvePath(value.attachPartPath or "")
			local preAttachCFrame = value.preAttachCFrame
			if sourceTarget then
				local playbackTarget, playbackAttachPart = createCutscenePlaybackProp(context, sourceTarget, objectPath, value.attachPartPath)
				local target = playbackTarget or sourceTarget
				local state = snapshotCutsceneProp(target, preAttachCFrame)
				state.sourceTarget = sourceTarget
				state.playbackTarget = playbackTarget
				state.playbackAttachPart = playbackAttachPart
				state.preAttachCFrame = preAttachCFrame or state.originalCFrame
				context.cutsceneProps[objectPath] = state
				local attachPart = playbackAttachPart or resolvePath(value.attachPartPath or "")
				if attachPart and attachPart:IsA("BasePart") then
					ensureRuntimeAttachmentAssembly(target, attachPart, objectPath)
				end
				freezeCutsceneProp(state, state.preAttachCFrame)
			end
		end
	end
end

local function indexCFrameTracksForAttachments(context, cframeTracks)
	context.cframeTrackPaths = {}
	context.attachmentObjectTrackPathsByObjectPath = {}
	for _, bucket in pairs(cframeTracks or {}) do
		local track = bucket.track
		if track then
			local trackPath = tostring(track.path or "")
			local targetPath = tostring(track.targetPath or "")
			if trackPath ~= "" then
				context.cframeTrackPaths[trackPath] = true
			end
			if targetPath ~= "" and trackPath ~= "" then
				context.attachmentObjectTrackPathsByObjectPath[targetPath] = trackPath
			end
		end
	end
end

local function getAttachmentObjectTrackPath(context, objectPath, value)
	local savedPath = tostring(value and value.objectTrackPath or "")
	if savedPath ~= "" and context and context.cframeTrackPaths and context.cframeTrackPaths[savedPath] then
		return savedPath
	end
	objectPath = tostring(objectPath or "")
	local inferredPath = context
		and context.attachmentObjectTrackPathsByObjectPath
		and context.attachmentObjectTrackPathsByObjectPath[objectPath]
	if inferredPath and inferredPath ~= "" then
		return inferredPath
	end
	return savedPath
end

local function applyAttachmentValue(context, value)
	if not isAttachmentEventValue(value) or value.action ~= "Attach" then
		return false
	end
	local objectPath = tostring(value.objectPath or "")
	local state = context and context.cutsceneProps and context.cutsceneProps[objectPath]
	local handPart = resolvePlaybackRigAttachmentPart(context, value) or resolvePath(value.handPartPath or "")
	local attachPart = (state and state.playbackAttachPart) or resolvePath(value.attachPartPath or "")
	local target = (state and state.playbackTarget) or resolvePath(objectPath) or attachPart
	if not handPart or not attachPart or not handPart:IsA("BasePart") or not attachPart:IsA("BasePart") then
		return false
	end
	removeRuntimeAttachmentMotor(objectPath)
	local offsetC0 = typeof(value.offsetC0) == "CFrame" and value.offsetC0 or handPart.CFrame:ToObjectSpace(attachPart.CFrame)
	if state then
		if state.attachmentMode ~= "attached" then
			setCutscenePropAttachedPhysics(state)
		end
	else
		for _, part in ipairs(collectBaseParts(target)) do
			part.Anchored = false
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Massless = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	pivotAttachedTargetToPart(target, attachPart, handPart.CFrame * offsetC0)
	return true
end

local function applyAttachmentFrameState(context, frame)
	context.suppressedCFrameTrackPaths = {}
	context.activeAttachedObjectPaths = {}
	for _, event in ipairs(context.attachmentEvents or {}) do
		if event.frame &lt;= frame then
			local value = event.value
			local objectPath = tostring(value and value.objectPath or "")
			if objectPath ~= "" then
				context.latestAttachmentByObjectPath[objectPath] = event
			end
		else
			break
		end
	end
	for objectPath, firstEvent in pairs(context.firstAttachmentByObjectPath or {}) do
		local latest = context.latestAttachmentByObjectPath[objectPath]
		local value = latest and latest.value
		if value and value.action == "Attach" then
			context.activeAttachedObjectPaths[objectPath] = true
			local objectTrackPath = getAttachmentObjectTrackPath(context, objectPath, value)
			if objectTrackPath ~= "" then
				context.suppressedCFrameTrackPaths[objectTrackPath] = true
			end
			applyAttachmentValue(context, value)
		elseif value and value.action == "Detach" then
			removeRuntimeAttachmentMotor(objectPath)
			local state = context.cutsceneProps and context.cutsceneProps[objectPath]
			if state and state.attachmentMode == "attached" then
				setCutscenePropDetachedPlaybackPhysics(state)
			end
		else
			removeRuntimeAttachmentMotor(objectPath)
			local state = context.cutsceneProps and context.cutsceneProps[objectPath]
			if state then
				freezeCutsceneProp(state, state.preAttachCFrame)
			end
		end
	end
end

local function isDecalLike(instance)
	return instance and (instance:IsA("Decal") or instance:IsA("Texture"))
end

local function setVisualTransparency(instance, value)
	if isDecalLike(instance) then
		return safeWrite(instance, "Transparency", math.clamp(tonumber(value) or 0, 0, 1))
	end
	if instance and (instance:IsA("ImageLabel") or instance:IsA("ImageButton")) then
		return safeWrite(instance, "ImageTransparency", math.clamp(tonumber(value) or 0, 0, 1))
	end
	return false
end

local function applyImage(instance, imageId)
	if not instance or type(imageId) ~= "string" then
		return false
	end
	if instance:IsA("Decal") or instance:IsA("Texture") then
		return safeWrite(instance, "Texture", imageId)
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		return safeWrite(instance, "Image", imageId)
	end
	return false
end

local function getHead(rig)
	local head = rig and rig:FindFirstChild("Head", true)
	return head and head:IsA("BasePart") and head or nil
end

local function normalizeFaceLayerName(name)
	return string.lower(tostring(name or "")):gsub("[%s_%-%./]", "")
end

local function getFaceLayerTransform(layerTransforms, layerName)
	local raw = type(layerTransforms) == "table" and layerTransforms[layerName] or nil
	if type(raw) ~= "table" then
		return 0, 0, 1
	end
	local x = math.clamp(tonumber(raw.X or raw.x) or 0, -FACE_LAYER_OFFSET_LIMIT, FACE_LAYER_OFFSET_LIMIT)
	local y = math.clamp(tonumber(raw.Y or raw.y) or 0, -FACE_LAYER_OFFSET_LIMIT, FACE_LAYER_OFFSET_LIMIT)
	local scale = math.clamp(tonumber(raw.Scale or raw.scale) or 1, FACE_LAYER_SCALE_MIN, FACE_LAYER_SCALE_MAX)
	return x, y, scale
end

local function hasFaceLayerTransformOverrides(layerTransforms)
	if type(layerTransforms) ~= "table" then
		return false
	end
	for _, layerName in ipairs(FACE_LAYER_NAMES) do
		local x, y, scale = getFaceLayerTransform(layerTransforms, layerName)
		if math.abs(x) &gt; FACE_LAYER_TRANSFORM_EPSILON
			or math.abs(y) &gt; FACE_LAYER_TRANSFORM_EPSILON
			or math.abs(scale - 1) &gt; FACE_LAYER_TRANSFORM_EPSILON then
			return true
		end
	end
	return false
end

local function hasFaceLayerTransformOverride(layerTransforms, layerName)
	local x, y, scale = getFaceLayerTransform(layerTransforms, layerName)
	return math.abs(x) &gt; FACE_LAYER_TRANSFORM_EPSILON
		or math.abs(y) &gt; FACE_LAYER_TRANSFORM_EPSILON
		or math.abs(scale - 1) &gt; FACE_LAYER_TRANSFORM_EPSILON
end

local function getFaceLayerIndex(layerName)
	for index, name in ipairs(FACE_LAYER_NAMES) do
		if name == layerName then
			return index
		end
	end
	return 1
end

local function getSafeFaceLayerSuffix(layerName)
	local suffix = normalizeFaceLayerName(layerName)
	suffix = suffix:gsub("[^%w]", "_")
	return suffix ~= "" and suffix or "layer"
end

local function isGeneratedFaceShell(instance)
	return instance and instance:IsA("BasePart") and instance:GetAttribute(FACE_LAYER_SHELL_ATTRIBUTE) == true
end

local function isInsideGeneratedFaceShell(instance, head)
	local current = instance and instance.Parent or nil
	while current and current ~= head do
		if isGeneratedFaceShell(current) then
			return true
		end
		current = current.Parent
	end
	return false
end

local function clearFaceShellChildren(shell)
	for _, child in ipairs(shell:GetChildren()) do
		if not child:IsA("SpecialMesh") then
			child:Destroy()
		end
	end
end

local function configureFaceShell(shell)
	shell:SetAttribute(FACE_LAYER_SHELL_ATTRIBUTE, true)
	shell:SetAttribute("MegMoGeneratedFaceLayer", true)
	pcall(function()
		shell.Transparency = 1
	end)
	pcall(function()
		shell.CanCollide = false
		shell.CanTouch = false
		shell.CanQuery = false
		shell.CastShadow = false
		shell.Massless = true
		shell.Anchored = false
	end)
end

local function ensureFaceLayerShell(head, layerName)
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local shellName = FACE_LAYER_SHELL_PREFIX .. getSafeFaceLayerSuffix(layerName)
	local existing = head:FindFirstChild(shellName)
	if existing and existing:IsA("BasePart") then
		configureFaceShell(existing)
		return existing
	end
	local wasArchivable = head.Archivable
	pcall(function()
		head.Archivable = true
	end)
	local ok, shell = pcall(function()
		return head:Clone()
	end)
	pcall(function()
		head.Archivable = wasArchivable
	end)
	if not ok or not shell or not shell:IsA("BasePart") then
		return nil
	end
	shell.Name = shellName
	clearFaceShellChildren(shell)
	configureFaceShell(shell)
	shell.Parent = head
	return shell
end

local function ensureFaceLayerShellMotor(head, shell, layerName)
	if not (head and shell) then
		return nil
	end
	local motorName = FACE_LAYER_MOTOR_PREFIX .. getSafeFaceLayerSuffix(layerName)
	local existing = head:FindFirstChild(motorName)
	if existing and existing:IsA("Motor6D") then
		existing.Part0 = head
		existing.Part1 = shell
		return existing
	end
	local motor = Instance.new("Motor6D")
	motor.Name = motorName
	motor.Part0 = head
	motor.Part1 = shell
	motor.Parent = head
	return motor
end

local function applyFaceShellTransform(layer, layerTransforms, layerName, head)
	local shell = layer and layer.Parent
	if not isGeneratedFaceShell(shell) then
		return false
	end
	head = head or shell.Parent
	if not (head and head:IsA("BasePart")) then
		return false
	end
	local x, y, scale = getFaceLayerTransform(layerTransforms, layerName)
	local baseSize = head.Size
	local shellSize = Vector3.new(
		math.max(0.05, baseSize.X * scale),
		math.max(0.05, baseSize.Y * scale),
		math.max(0.05, baseSize.Z * scale)
	)
	pcall(function()
		shell.Size = shellSize
	end)

	local layerDepth = getFaceLayerIndex(layerName) * FACE_LAYER_DEPTH_STEP
	local scaleDepth = math.max(0, shellSize.Z - baseSize.Z) * 0.5
	local offset = CFrame.new(x * baseSize.X, -y * baseSize.Y, -(FACE_LAYER_FRONT_OFFSET + layerDepth + scaleDepth))
	local motor = ensureFaceLayerShellMotor(head, shell, layerName)
	if motor then
		motor.C0 = offset
		motor.C1 = CFrame.identity
		motor.Transform = CFrame.identity
	end
	return true
end

local function applyFaceLayerTransform(layer, layerTransforms, layerName, head)
	if layer and isDecalLike(layer) then
		return applyFaceShellTransform(layer, layerTransforms, layerName, head)
	end
	if not (layer and (layer:IsA("ImageLabel") or layer:IsA("ImageButton"))) then
		return false
	end
	local x, y, scale = getFaceLayerTransform(layerTransforms, layerName)
	layer.AnchorPoint = Vector2.new(0.5, 0.5)
	layer.BackgroundTransparency = 1
	layer.Position = UDim2.fromScale(0.5 + x, 0.5 + y)
	layer.Size = UDim2.fromScale(scale, scale)
	layer.ScaleType = Enum.ScaleType.Fit
	return true
end

local function ensureFaceLayerGui(head)
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local gui = head:FindFirstChild(FACE_LAYER_GUI_NAME)
	if gui and gui:IsA("SurfaceGui") then
		return gui
	end
	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = FACE_LAYER_GUI_NAME
	surfaceGui.Face = Enum.NormalId.Front
	surfaceGui.LightInfluence = 0
	pcall(function()
		surfaceGui.CanvasSize = Vector2.new(512, 512)
	end)
	pcall(function()
		surfaceGui.PixelsPerStud = 256
	end)
	surfaceGui:SetAttribute("MegMoGeneratedFaceLayer", true)
	surfaceGui.Parent = head
	return surfaceGui
end

local function findFaceLayer(head, layerName)
	if not head then
		return nil
	end
	local wanted = normalizeFaceLayerName(layerName)
	local fallback = nil
	for _, descendant in ipairs(head:GetDescendants()) do
		if isDecalLike(descendant) or descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
			local normalized = normalizeFaceLayerName(descendant.Name)
			if normalized == wanted or normalized == wanted .. "decal" or normalized == wanted .. "image" or normalized == wanted .. "texture" then
				if not isInsideGeneratedFaceShell(descendant, head) then
					if isDecalLike(descendant) then
						return descendant
					end
					fallback = fallback or descendant
				end
			end
		end
	end
	return fallback
end

local function findCurvedFaceLayer(head, layerName)
	if not head then
		return nil
	end
	local wanted = normalizeFaceLayerName(layerName)
	for _, descendant in ipairs(head:GetDescendants()) do
		if isDecalLike(descendant) then
			local normalized = normalizeFaceLayerName(descendant.Name)
			if (normalized == wanted or normalized == wanted .. "decal" or normalized == wanted .. "texture")
				and not isInsideGeneratedFaceShell(descendant, head) then
				return descendant
			end
		end
	end
	return nil
end

local function ensureMovableFaceLayer(head, layerName)
	local shell = ensureFaceLayerShell(head, layerName)
	if not shell then
		return nil
	end
	local existing = shell:FindFirstChild(tostring(layerName or "FaceLayer"))
	if existing and isDecalLike(existing) then
		return existing
	end
	local decal = Instance.new("Decal")
	decal.Name = tostring(layerName or "FaceLayer")
	decal.Face = Enum.NormalId.Front
	decal.Transparency = 1
	decal:SetAttribute("MegMoGeneratedFaceLayer", true)
	decal.Parent = shell
	return decal
end

local function ensureFaceLayer(head, layerName)
	local layer = findCurvedFaceLayer(head, layerName)
	if layer then
		return layer
	end
	if not head then
		return nil
	end
	local decal = Instance.new("Decal")
	decal.Name = tostring(layerName or "FaceLayer")
	decal.Face = Enum.NormalId.Front
	decal.Transparency = 1
	decal:SetAttribute("MegMoGeneratedFaceLayer", true)
	decal.Parent = head
	return decal
end

local function findStandardFace(head)
	if not head then
		return nil
	end
	local named = head:FindFirstChild("face")
	if named and isDecalLike(named) then
		return named
	end
	for _, child in ipairs(head:GetChildren()) do
		if isDecalLike(child) and string.lower(child.Name) == "face" then
			return child
		end
	end
	return nil
end

local function ensureStandardFace(head)
	local face = findStandardFace(head)
	if face then
		return face
	end
	if not head then
		return nil
	end
	local decal = Instance.new("Decal")
	decal.Name = "face"
	decal.Face = Enum.NormalId.Front
	decal.Transparency = 1
	decal:SetAttribute("MegMoGeneratedStandardFace", true)
	decal.Parent = head
	return decal
end

local function hideLayeredFaces(head)
	for _, layerName in ipairs(FACE_LAYER_NAMES) do
		local wanted = normalizeFaceLayerName(layerName)
		for _, descendant in ipairs(head:GetDescendants()) do
			if isDecalLike(descendant) or descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
				local normalized = normalizeFaceLayerName(descendant.Name)
				if normalized == wanted or normalized == wanted .. "decal" or normalized == wanted .. "image" or normalized == wanted .. "texture" then
					setVisualTransparency(descendant, 1)
				end
			end
		end
	end
end

local function applyFaceValue(track, value, context)
	if type(value) ~= "table" then
		return false
	end
	local rig = resolveRigByName(value.rigName or value.character or value.Character or track.rigName, context)
	local head = getHead(rig)
	if not head then
		return false
	end
	if value.type == "FaceSnapshot" then
		local face = findStandardFace(head)
		if face and type(value.standard) == "table" then
			applyImage(face, value.standard.imageId or "")
			if type(value.standard.transparency) == "number" then
				setVisualTransparency(face, value.standard.transparency)
			end
		end
		for _, layerName in ipairs(FACE_LAYER_NAMES) do
			local layer = findFaceLayer(head, layerName)
			local saved = type(value.layers) == "table" and value.layers[layerName] or nil
			if layer and type(saved) == "table" then
				applyImage(layer, saved.imageId or "")
				if type(saved.transparency) == "number" then
					setVisualTransparency(layer, saved.transparency)
				end
			elseif layer then
				setVisualTransparency(layer, 1)
			end
		end
		return true
	end
	if value.faceType == "Layered" then
		local standard = findStandardFace(head)
		if standard then
			setVisualTransparency(standard, 1)
		end
		hideLayeredFaces(head)
		local layerTransforms = value.layerTransforms or value.LayerTransforms
		local useMovableLayers = hasFaceLayerTransformOverrides(layerTransforms)
		for _, layerName in ipairs(FACE_LAYER_NAMES) do
			local imageId = type(value.layers) == "table" and value.layers[layerName] or nil
			if type(imageId) == "string" and imageId ~= "" then
				local useMovableLayer = useMovableLayers and hasFaceLayerTransformOverride(layerTransforms, layerName)
				local layer = useMovableLayer and ensureMovableFaceLayer(head, layerName) or ensureFaceLayer(head, layerName)
				if layer then
					if useMovableLayer then
						applyFaceLayerTransform(layer, layerTransforms, layerName, head)
					end
					applyImage(layer, imageId)
					setVisualTransparency(layer, 0)
				end
			end
		end
		return true
	end
	local imageId = value.imageId or value.ImageId
	if type(imageId) == "string" and imageId ~= "" then
		hideLayeredFaces(head)
		local face = ensureStandardFace(head)
		if face then
			applyImage(face, imageId)
			setVisualTransparency(face, 0)
			return true
		end
	end
	return false
end

local function collectEmitters(target)
	local emitters = {}
	if target and target:IsA("ParticleEmitter") then
		table.insert(emitters, target)
	end
	if target then
		for _, descendant in ipairs(target:GetDescendants()) do
			if descendant:IsA("ParticleEmitter") then
				table.insert(emitters, descendant)
			end
		end
	end
	table.sort(emitters, function(a, b)
		return a:GetFullName() &lt; b:GetFullName()
	end)
	return emitters
end

local function addUniqueEmitter(emitters, seen, emitter)
	if not (emitter and emitter.Parent and emitter:IsA("ParticleEmitter")) then
		return
	end
	if seen[emitter] then
		return
	end
	seen[emitter] = true
	table.insert(emitters, emitter)
end

local function emitterMatchesEntry(emitter, entry)
	if not (emitter and entry) then
		return false
	end
	local wantedPath = tostring(entry.path or "")
	local wantedName = tostring(entry.name or "")
	if wantedName ~= "" and emitter.Name == wantedName then
		return true
	end
	if wantedPath == "" then
		return false
	end
	local currentPath = emitter:GetFullName()
	if currentPath == wantedPath then
		return true
	end
	local suffix = wantedPath:match("[^.]+%.(.+)$")
	return suffix ~= nil and currentPath:sub(-#suffix) == suffix
end

local function findEmitterFromPlaybackTargets(entry, context)
	local wantedPath = tostring(entry and entry.path or "")
	if wantedPath == "" or not context then
		return nil
	end
	for _, rig in pairs(context.rigTargets or {}) do
		local relative = findDescendantByRelativePath(rig, wantedPath)
		if relative and relative:IsA("ParticleEmitter") then
			return relative
		end
		for _, emitter in ipairs(collectEmitters(rig)) do
			if emitterMatchesEntry(emitter, entry) then
				return emitter
			end
		end
	end
	for _, target in pairs(context.cutscenePropTargetsByPath or {}) do
		if target and target.Parent then
			local relative = findDescendantByRelativePath(target, wantedPath)
			if relative and relative:IsA("ParticleEmitter") then
				return relative
			end
			for _, emitter in ipairs(collectEmitters(target)) do
				if emitterMatchesEntry(emitter, entry) then
					return emitter
				end
			end
		end
	end
	return nil
end

local function collectTrackEmitters(track, context)
	local emitters = {}
	local seen = {}
	for _, emitter in ipairs(collectEmitters(resolveTrackTarget(track, context))) do
		addUniqueEmitter(emitters, seen, emitter)
	end
	for _, entry in ipairs(type(track.emitterTargets) == "table" and track.emitterTargets or {}) do
		local emitter = resolvePath(tostring(entry.path or ""))
		if not (emitter and emitter:IsA("ParticleEmitter")) then
			emitter = findEmitterFromPlaybackTargets(entry, context)
		end
		addUniqueEmitter(emitters, seen, emitter)
	end
	table.sort(emitters, function(a, b)
		return a:GetFullName() &lt; b:GetFullName()
	end)
	return emitters
end

local function applyParticleProperty(track, value, context)
	local propertyName = tostring(track.propertyName or track.name or "")
	if propertyName == "" then
		return false
	end
	local emitters = collectTrackEmitters(track, context)
	if #emitters == 0 then
		return false
	end
	local changed = 0
	if type(value) == "table" and value.type == "EmitterGroupPropertySnapshot" and type(value.values) == "table" then
		for _, entry in ipairs(value.values) do
			local emitter = nil
			for _, candidate in ipairs(emitters) do
				if emitterMatchesEntry(candidate, entry) then
					emitter = candidate
					break
				end
			end
			if emitter and safeWrite(emitter, propertyName, entry.value) then
				changed += 1
			end
		end
	else
		for _, emitter in ipairs(emitters) do
			if safeWrite(emitter, propertyName, value) then
				changed += 1
			end
		end
	end
	return changed &gt; 0
end

local function runParticleEvent(track, value, context)
	local emitters = collectTrackEmitters(track, context)
	if #emitters == 0 then
		return false
	end
	local payload = type(value) == "table" and value or {}
	local actionName = tostring(payload.actionName or payload.eventName or track.eventName or track.propertyName or track.name or "Emit")
	local changed = 0
	if actionName == "Clear" then
		for _, emitter in ipairs(emitters) do
			if pcall(function()
				emitter:Clear()
			end) then
				changed += 1
			end
		end
	else
		local emitCount = math.max(1, math.floor(tonumber(payload.emitCount or payload.count) or 10))
		for _, emitter in ipairs(emitters) do
			local wasEnabled = emitter.Enabled == true
			if pcall(function()
				emitter:Emit(emitCount)
			end) then
				changed += 1
			end
			pcall(function()
				emitter.Enabled = wasEnabled
			end)
		end
	end
	return changed &gt; 0
end

local function setDecalProperty(instance, propertyName, value)
	if propertyName == "Transparency" then
		return safeWrite(instance, "Transparency", math.clamp(tonumber(value) or 0, 0, 1))
	elseif propertyName == "Color3" or propertyName == "Color" then
		return typeof(value) == "Color3" and safeWrite(instance, "Color3", value)
	elseif propertyName == "Texture" then
		return type(value) == "string" and safeWrite(instance, "Texture", value)
	elseif propertyName == "Face" then
		return typeof(value) == "EnumItem" and safeWrite(instance, "Face", value)
	end
	return false
end

local RUNTIME_PART_SCALE_MIN_SIZE = 0.001

local function getRuntimeScalePart(target)
	if not target then
		return nil
	end
	if target:IsA("Motor6D") then
		local part = target.Part1
		return part and part.Parent and part:IsA("BasePart") and part or nil
	end
	return target:IsA("BasePart") and target or nil
end

local function applyRuntimeScaleValue(track, target, value)
	if target:IsA("Model") and type(value) == "number" then
		return pcall(function()
			target:ScaleTo(value)
		end)
	end

	local part = getRuntimeScalePart(target)
	if not part then
		return false
	end

	if typeof(value) == "Vector3" then
		return safeWrite(part, "Size", Vector3.new(
			math.max(value.X, RUNTIME_PART_SCALE_MIN_SIZE),
			math.max(value.Y, RUNTIME_PART_SCALE_MIN_SIZE),
			math.max(value.Z, RUNTIME_PART_SCALE_MIN_SIZE)
		))
	end

	if type(value) ~= "number" then
		return false
	end

	local originalSize = decodeValue(track.originalValue)
	if typeof(originalSize) ~= "Vector3" then
		originalSize = part.Size
	end

	local scale = math.max(value, RUNTIME_PART_SCALE_MIN_SIZE)
	return safeWrite(part, "Size", Vector3.new(
		math.max(originalSize.X * scale, RUNTIME_PART_SCALE_MIN_SIZE),
		math.max(originalSize.Y * scale, RUNTIME_PART_SCALE_MIN_SIZE),
		math.max(originalSize.Z * scale, RUNTIME_PART_SCALE_MIN_SIZE)
	))
end

local function applyRuntimePropertyValue(track, value, context)
	if not track or value == nil then
		return false
	end
	if track.trackType == "Lighting Effect" then
		return applyLightingEffectValue(track, value)
	end
	if track.targetScope == "EmitterGroupProperty"
		or track.trackType == "Emitter Group Property"
		or (track.targetScope == "ObjectProperty" and track.valueType ~= "CFrame" and track.valueType ~= "Transparency" and tostring(track.propertyName or "") ~= "CFrame") then
		local target = resolveTrackTarget(track, context)
		if target and target:IsA("ParticleEmitter") then
			return safeWrite(target, tostring(track.propertyName or track.name), value)
		end
		if target and #collectEmitters(target) &gt; 0 and tostring(track.propertyName or "") ~= "Color" then
			return applyParticleProperty(track, value, context)
		end
	end
	local target = resolveTrackTarget(track, context)
	if not target then
		return false
	end
	local propertyName = tostring(track.propertyName or track.name or track.valueType or "")
	if target:IsA("ParticleEmitter") and propertyName ~= "" then
		return safeWrite(target, propertyName, value)
	end
	if propertyName == "CFrame" then
		applyCFrameValue(track, value, context)
		return true
	elseif propertyName == "Scale" then
		return applyRuntimeScaleValue(track, target, value)
	elseif isDecalLike(target) then
		return setDecalProperty(target, propertyName, value)
	elseif propertyName == "Transparency" then
		local changed = 0
		for _, part in ipairs(collectBaseParts(target)) do
			if safeWrite(part, "Transparency", math.clamp(tonumber(value) or 0, 0, 1)) then
				changed += 1
			end
		end
		return changed &gt; 0
	elseif propertyName == "Color" or propertyName == "Color3" then
		local changed = 0
		for _, part in ipairs(collectBaseParts(target)) do
			if typeof(value) == "Color3" and safeWrite(part, "Color", value) then
				changed += 1
			end
		end
		return changed &gt; 0
	elseif propertyName == "Reflectance" then
		local changed = 0
		for _, part in ipairs(collectBaseParts(target)) do
			if safeWrite(part, "Reflectance", math.clamp(tonumber(value) or 0, 0, 1)) then
				changed += 1
			end
		end
		return changed &gt; 0
	elseif track.valueType == "Emitter" and target:IsA("ParticleEmitter") and type(value) == "table" then
		local changed = safeWrite(target, "Enabled", value.enabled == true)
		if type(value.rate) == "number" then
			changed = safeWrite(target, "Rate", value.rate) or changed
		end
		return changed
	end
	if propertyName ~= "" then
		return safeWrite(target, propertyName, value)
	end
	return false
end

local function isRuntimePropertyTrack(track)
	if not track or track.disabled == true or isDirectCFramePlaybackTrack(track) then
		return false
	end
	if track.trackType == "Camera"
		or track.trackType == "Sound"
		or track.trackType == SCREEN_EFFECT_TYPE
		or track.trackType == "Lighting Effect"
		or track.trackType == "Face"
		or track.trackType == "Event"
		or track.targetScope == "CameraProperty"
		or track.targetScope == "ParticleEvent" then
		return false
	end
	return track.targetScope == "RigProperty"
		or track.targetScope == "ObjectProperty"
		or track.targetScope == "EmitterGroupProperty"
		or track.trackType == "Rig Property"
		or track.trackType == "Object Property"
		or track.trackType == "Emitter Group Property"
		or track.valueType == "Emitter"
		or track.valueType == "Transparency"
end

local function isParticleEventTrack(track)
	return track ~= nil and (track.trackType == "Particle Event" or track.valueType == "ParticleEvent" or track.targetScope == "ParticleEvent")
end

local function fireCutsceneEvent(track, value, frame)
	local eventName = tostring((type(value) == "table" and (value.name or value.eventName or value.action)) or track.eventName or track.name or "Event")
	if eventName == "" then
		eventName = "Event"
	end
	local payload = type(value) == "table" and (value.payload ~= nil and value.payload or value) or value
	local info = {
		frame = frame,
		trackPath = track.path,
		trackName = track.name,
		eventName = eventName,
	}
	eventSignal:Fire(eventName, payload, info)
	for _, callback in ipairs(namedEventCallbacks[eventName] or {}) do
		task.spawn(callback, payload, info)
	end
	local folder = ensureEventsFolder()
	local bindable = folder:FindFirstChild(eventName) or folder:FindFirstChild("Event")
	if bindable and bindable:IsA("BindableEvent") then
		bindable:Fire(payload, info)
	end
end

local function findRig(info)
	local rig = resolvePath(info.TargetPath or "")
	if rig then
		return rig
	end
	local rigName = tostring(info.RigName or "")
	if rigName ~= "" then
		return workspace:FindFirstChild(rigName, true)
	end
	return nil
end

local function createPlayerRigClone(info, options, context)
	local rigName = tostring(info.RigName or "CutsceneRig")
	if context.rigTargets[rigName] then
		return context.rigTargets[rigName]
	end
	local sourceCharacter = getPlayerCharacter(options)
	if not sourceCharacter then
		warn("[MegMoCutscenePlayer] Could not find triggering player character for " .. rigName .. ".")
		return findRig(info)
	end
	local oldArchivable = sourceCharacter.Archivable
	sourceCharacter.Archivable = true
	local clone = sourceCharacter:Clone()
	sourceCharacter.Archivable = oldArchivable
	if not clone then
		warn("[MegMoCutscenePlayer] Could not clone triggering player character for " .. rigName .. ".")
		return findRig(info)
	end
	clone.Name = "MegMoCutscene_" .. rigName
	removeScriptsFromClone(clone)
	clone.Parent = workspace
	local referenceRig = findRig(info)
	if referenceRig and referenceRig:IsA("Model") then
		clone:PivotTo(referenceRig:GetPivot())
	elseif sourceCharacter:IsA("Model") then
		clone:PivotTo(sourceCharacter:GetPivot())
	end
	hideSourceCharacter(context, sourceCharacter)
	table.insert(context.clones, clone)
	context.rigTargets[rigName] = clone
	return clone
end

local function resolveRigForPlayback(info, options, context)
	if shouldUsePlayerClone(info) then
		return createPlayerRigClone(info, options, context)
	end
	local rig = findRig(info)
	if rig and info.RigName then
		context.rigTargets[tostring(info.RigName)] = rig
	end
	return rig
end

local function getRigRootPart(rig)
	if not rig then
		return nil
	end
	local root = rig:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	if rig.PrimaryPart and rig.PrimaryPart:IsA("BasePart") then
		return rig.PrimaryPart
	end
	for _, child in ipairs(rig:GetDescendants()) do
		if child:IsA("BasePart") then
			return child
		end
	end
	return nil
end

local function stabilizeRigPhysics(rig)
	local root = getRigRootPart(rig)
	if not root then
		return nil
	end
	local state = {
		rig = rig,
		root = root,
		originalPivot = rig and rig:IsA("Model") and rig:GetPivot() or root.CFrame,
		parts = {},
		humanoid = rig:FindFirstChildOfClass("Humanoid"),
	}
	if state.humanoid then
		state.autoRotate = state.humanoid.AutoRotate
		state.platformStand = state.humanoid.PlatformStand
		state.humanoid.AutoRotate = false
		state.humanoid.PlatformStand = true
	end
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(state.parts, {
				part = descendant,
				anchored = descendant.Anchored,
				canCollide = descendant.CanCollide,
			})
			descendant.CanCollide = false
			descendant.AssemblyLinearVelocity = Vector3.zero
			descendant.AssemblyAngularVelocity = Vector3.zero
		end
	end
	root.Anchored = true
	return state
end

local function restoreRigPhysics(state)
	if not state then
		return
	end
	for _, item in ipairs(state.parts or {}) do
		if item.part and item.part.Parent then
			item.part.Anchored = item.anchored == true
			item.part.CanCollide = item.canCollide == true
		end
	end
	if state.humanoid and state.humanoid.Parent then
		state.humanoid.AutoRotate = state.autoRotate ~= false
		state.humanoid.PlatformStand = state.platformStand == true
	end
	if state.rig and state.rig.Parent and typeof(state.originalPivot) == "CFrame" then
		state.rig:PivotTo(state.originalPivot)
	elseif state.root and state.root.Parent and typeof(state.originalPivot) == "CFrame" then
		state.root.CFrame = state.originalPivot
	end
	for _, item in ipairs(state.parts or {}) do
		if item.part and item.part.Parent then
			item.part.AssemblyLinearVelocity = Vector3.zero
			item.part.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function stabilizeRigForCutscene(rig)
	return stabilizeRigPhysics(rig)
end

local function restoreRigStabilizer(state)
	restoreRigPhysics(state)
end

local function getAnimator(rig)
	if not rig then
		return nil
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		return animator
	end
	local controller = rig:FindFirstChildOfClass("AnimationController")
	if not controller then
		controller = Instance.new("AnimationController")
		controller.Parent = rig
	end
	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	return animator
end

local function buildMotorPath(motor, rig)
	local parts = {}
	local cursor = motor
	while cursor and cursor ~= rig do
		table.insert(parts, 1, cursor.Name)
		cursor = cursor.Parent
	end
	return rig.Name .. "/" .. table.concat(parts, "/")
end

local function collectRigMotors(rig)
	local byPath = {}
	local byName = {}
	local byPart1 = {}
	if not rig then
		return byPath, byName, byPart1
	end
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			byPath[buildMotorPath(descendant, rig)] = descendant
			byName[descendant.Name] = byName[descendant.Name] or descendant
			if descendant.Part1 then
				byPart1[descendant.Part1.Name] = byPart1[descendant.Part1.Name] or descendant
			end
		end
	end
	return byPath, byName, byPart1
end

local function restoreRigBasePose(rig, info)
	local originalPose = info and info.OriginalMotorPose
	if not rig then
		return
	end
	if type(originalPose) == "table" then
		local byPath, byName, byPart1 = collectRigMotors(rig)
		for _, item in ipairs(originalPose) do
			local motor = byPath[tostring(item.Path or "")]
				or byName[tostring(item.Name or "")]
				or byPart1[tostring(item.Part1 or "")]
			local c0 = decodeValue(item.C0)
			if motor and typeof(c0) == "CFrame" then
				motor.C0 = c0
			end
		end
	end

	local originalBonePose = info and info.OriginalBonePose
	if type(originalBonePose) == "table" then
		local byPath = {}
		local byName = {}
		local byParentAndName = {}
		for _, descendant in ipairs(rig:GetDescendants()) do
			if descendant:IsA("Bone") then
				byPath[buildMotorPath(descendant, rig)] = descendant
				byName[descendant.Name] = byName[descendant.Name] or descendant
				local parentName = descendant.Parent and descendant.Parent.Name or ""
				byParentAndName[parentName .. "/" .. descendant.Name] = descendant
			end
		end
		for _, item in ipairs(originalBonePose) do
			local parentAndName = tostring(item.Parent or "") .. "/" .. tostring(item.Name or "")
			local bone = byPath[tostring(item.Path or "")]
				or byParentAndName[parentAndName]
				or byName[tostring(item.Name or "")]
			local transform = decodeValue(item.Transform)
			if bone and typeof(transform) == "CFrame" then
				pcall(function()
					bone.Transform = transform
				end)
			end
		end
	end
end

local function getAnimationPriority(name)
	local ok, priority = pcall(function()
		return Enum.AnimationPriority[tostring(name or "Action")]
	end)
	return ok and priority or Enum.AnimationPriority.Action
end

local function normalizeAnimationId(value)
	value = tostring(value or "")
	local digits = string.match(value, "%d+")
	if not digits then
		return ""
	end
	return "rbxassetid://" .. digits
end

local function getMappedAnimationId(packageFolder, info)
	local directId = normalizeAnimationId(info.AnimationId or info.PermanentAnimationId)
	if directId ~= "" then
		return directId
	end

	local idFolder = packageFolder:FindFirstChild("RigAnimationIds")
	if not idFolder then
		return ""
	end

	local slot = nil
	if info.AnimationIdSlot then
		slot = idFolder:FindFirstChild(tostring(info.AnimationIdSlot))
	end
	if not slot and info.SequenceName then
		for _, child in ipairs(idFolder:GetChildren()) do
			if child:IsA("StringValue") and child:GetAttribute("SequenceName") == info.SequenceName then
				slot = child
				break
			end
		end
	end
	if not slot and info.RigName then
		for _, child in ipairs(idFolder:GetChildren()) do
			if child:IsA("StringValue") and child:GetAttribute("RigName") == info.RigName then
				slot = child
				break
			end
		end
	end

	if slot and slot:IsA("StringValue") then
		return normalizeAnimationId(slot.Value)
	end

	return ""
end

local function prepareRigAnimationTracks(cutsceneData, options, context)
	local packageFolder = script.Parent
	local sequenceFolder = packageFolder:FindFirstChild("RigAnimations")
	local prepared = {}
	if not sequenceFolder then
		return prepared
	end

	for _, info in ipairs(cutsceneData.RigAnimations or {}) do
		local rig = resolveRigForPlayback(info, options, context)
		restoreRigBasePose(rig, info)
		local animator = getAnimator(rig)
		local sequence = sequenceFolder:FindFirstChild(tostring(info.SequenceName or ""))
		if animator and sequence and sequence:IsA("KeyframeSequence") then
			local animationId = getMappedAnimationId(packageFolder, info)
			if animationId == "" then
				if RunService:IsStudio() then
					local ok, registeredId = pcall(function()
						return KeyframeSequenceProvider:RegisterKeyframeSequence(sequence)
					end)
					if ok then
						animationId = tostring(registeredId)
					else
						warn("[MegMoCutscenePlayer] Could not register rig animation for " .. tostring(info.RigName) .. ": " .. tostring(registeredId))
					end
				else
					warn("[MegMoCutscenePlayer] Missing permanent AnimationId for " .. tostring(info.RigName) .. ". Fill ReplicatedStorage.MegMoCutscenes.&lt;Cutscene&gt;.RigAnimationIds before publishing.")
				end
			end
			if animationId ~= "" then
				local animation = Instance.new("Animation")
				animation.Name = tostring(info.SequenceName or "MegMoCutsceneAnimation")
				animation.AnimationId = animationId
				local ok, trackOrError = pcall(function()
					return animator:LoadAnimation(animation)
				end)
				if ok and trackOrError then
					trackOrError.Priority = getAnimationPriority(info.Priority)
					trackOrError.Looped = info.Looped == true
					table.insert(prepared, {
						track = trackOrError,
						animation = animation,
						rig = rig,
						info = info,
						stabilizer = stabilizeRigForCutscene(rig),
					})
				else
					animation:Destroy()
					warn("[MegMoCutscenePlayer] Could not load rig animation for " .. tostring(info.RigName) .. ": " .. tostring(trackOrError))
				end
			end
		elseif info.RigName then
			warn("[MegMoCutscenePlayer] Missing rig or sequence for " .. tostring(info.RigName))
		end
	end

	return prepared
end

function MegMoCutscenePlayer.Play(cutsceneData, options)
	if MegMoCutscenePlayer._isPlaying then
		warn("[MegMoCutscenePlayer] A cutscene is already playing.")
		return false
	end
	MegMoCutscenePlayer._isPlaying = true
	options = options or {}
	activeCutsceneData = cutsceneData
	local project = cutsceneData.Project or cutsceneData
	local fps = math.max(1, tonumber(project.fps) or 60)
	local contentEndFrame = getProjectLastKeyframe(project)
	local durationFrames = contentEndFrame &gt; 0 and contentEndFrame or (tonumber(project.durationFrames) or 0)
	local durationSeconds = durationFrames / fps
	local camera = workspace.CurrentCamera
	local context = {
		activeSounds = {},
		clones = {},
		hiddenParts = {},
		rigTargets = {},
	}
	local skipState = { requested = false }
	local overlayGui, fadeFrame = createPlaybackOverlay(settingValue("AllowSkip", true) ~= false, skipState)
	local fadeInSeconds = math.max(0, tonumber(settingValue("FadeInSeconds", 0)) or 0)
	local fadeOutSeconds = math.max(0, tonumber(settingValue("FadeOutSeconds", 0)) or 0)

	local cameraTracks = collectTrackKeys(project, function(track)
		return track.trackType == "Camera"
	end)
	local fovTracks = collectTrackKeys(project, function(track)
		return track.targetScope == "CameraProperty" and (track.propertyName == "FieldOfView" or track.valueType == "FieldOfView")
	end)
	local soundTracks = collectTrackKeys(project, function(track)
		return track.disabled ~= true and (track.trackType == "Sound" or track.targetScope == "Sound" or track.valueType == "Sound")
	end)
	local screenEffectTracks = collectTrackKeys(project, function(track)
		return track.trackType == SCREEN_EFFECT_TYPE and track.disabled ~= true
	end)
	local lightingEffectTracks = collectTrackKeys(project, function(track)
		return track.trackType == "Lighting Effect" and track.disabled ~= true
	end)
	local cframeTracks = collectTrackKeys(project, function(track)
		return track.disabled ~= true and isDirectCFramePlaybackTrack(track)
	end)
	indexCFrameTracksForAttachments(context, cframeTracks)
	local runtimePropertyTracks = collectTrackKeys(project, function(track)
		return isRuntimePropertyTrack(track)
	end)
	local faceTracks = collectTrackKeys(project, function(track)
		return track.disabled ~= true and (track.trackType == "Face" or track.targetScope == "Face" or track.valueType == "Face")
	end)
	local particleEventTracks = collectTrackKeys(project, function(track)
		return track.disabled ~= true and isParticleEventTrack(track)
	end)
	local eventTracks = collectTrackKeys(project, function(track)
		return track.disabled ~= true and (track.trackType == "Event" or track.valueType == "Event")
	end)
	local attachmentTracks = collectTrackKeys(project, function(track)
		return track.disabled ~= true and (track.trackType == "Event" or track.valueType == "Event")
	end)
	prepareCutsceneProps(context, attachmentTracks)
	snapshotCFramePlaybackTargets(context, cframeTracks)

	local originalCameraType = camera and camera.CameraType
	if camera and next(cameraTracks) ~= nil then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local rigTracks = prepareRigAnimationTracks(cutsceneData, options, context)

	local function cleanup()
		stopActiveCutsceneSounds(context)
		if camera and options.restoreCamera ~= false and originalCameraType then
			camera.CameraType = originalCameraType
		end
		for _, entry in ipairs(rigTracks) do
			pcall(function()
				entry.track:Stop(0)
			end)
			pcall(function()
				entry.animation:Destroy()
			end)
			pcall(function()
				restoreRigBasePose(entry.rig, entry.info)
			end)
			restoreRigStabilizer(entry.stabilizer)
		end
		for objectPath in pairs(context.firstAttachmentByObjectPath or {}) do
			removeRuntimeAttachmentMotor(objectPath)
		end
		if skipState.requested then
			restoreCFramePlaybackTargets(context)
		end
		restoreCutsceneProps(context, skipState.requested and "Restore" or nil)
		for _, clone in ipairs(context.clones) do
			if clone and clone.Parent then
				clone:Destroy()
			end
		end
		cleanupScreenEffects(context)
		restoreSourceCharacter(context)
		if overlayGui and overlayGui.Parent then
			overlayGui:Destroy()
		end
		activeCutsceneData = nil
		MegMoCutscenePlayer._isPlaying = false
	end

	local ok, err = pcall(function()
		runFade(fadeFrame, 0, 1, fadeInSeconds, skipState)
		if skipState.requested then
			return
		end
		for _, entry in ipairs(rigTracks) do
			entry.track:Play(0, 1, 1)
			entry.track.TimePosition = 0
		end

		local stepEvent = RunService:IsClient() and RunService.RenderStepped or RunService.Heartbeat
		local lastFrame = -1
		local playedSoundKeys = {}
		local startClock = os.clock()
		while true do
			local elapsed = os.clock() - startClock
			local frame = math.min(durationFrames, elapsed * fps)
			for _, bucket in pairs(cameraTracks) do
				applyCameraValue(camera, evaluate(bucket.keys, frame))
			end
			for _, bucket in pairs(fovTracks) do
				local value = evaluate(bucket.keys, frame)
				if camera and type(value) == "number" then
					camera.FieldOfView = math.clamp(value, 1, 120)
				end
			end
			applyAttachmentFrameState(context, frame)
			for _, bucket in pairs(cframeTracks) do
				if not context.suppressedCFrameTrackPaths[tostring(bucket.track.path or "")] then
					applyCFrameValue(bucket.track, evaluate(bucket.keys, frame), context)
				end
			end
			if next(screenEffectTracks) ~= nil then
				renderScreenEffects(context, screenEffectTracks, frame, fps)
			end
			for _, bucket in pairs(lightingEffectTracks) do
				applyLightingEffectValue(bucket.track, evaluate(bucket.keys, frame))
			end
			for _, bucket in pairs(runtimePropertyTracks) do
				applyRuntimePropertyValue(bucket.track, evaluate(bucket.keys, frame), context)
			end
			for _, bucket in pairs(faceTracks) do
				for _, key in ipairs(bucket.keys) do
					local faceKeyId = tostring(bucket.track.path or bucket.track.name) .. ":" .. tostring(key.frame)
					if not playedSoundKeys[faceKeyId] and key.frame &gt; lastFrame and key.frame &lt;= frame then
						playedSoundKeys[faceKeyId] = true
						applyFaceValue(bucket.track, key.value, context)
					end
				end
			end
			for _, bucket in pairs(particleEventTracks) do
				for _, key in ipairs(bucket.keys) do
					local particleKeyId = tostring(bucket.track.path or bucket.track.name) .. ":" .. tostring(key.frame)
					if not playedSoundKeys[particleKeyId] and key.frame &gt; lastFrame and key.frame &lt;= frame then
						playedSoundKeys[particleKeyId] = true
						runParticleEvent(bucket.track, key.value, context)
					end
				end
			end
			for _, bucket in pairs(eventTracks) do
				for _, key in ipairs(bucket.keys) do
					local eventKeyId = tostring(bucket.track.path or bucket.track.name) .. ":" .. tostring(key.frame)
					if not isAttachmentEventValue(key.value) and not playedSoundKeys[eventKeyId] and key.frame &gt; lastFrame and key.frame &lt;= frame then
						playedSoundKeys[eventKeyId] = true
						fireCutsceneEvent(bucket.track, key.value, key.frame)
					end
				end
			end
			for _, bucket in pairs(soundTracks) do
				for _, key in ipairs(bucket.keys) do
					local soundKeyId = tostring(bucket.track.path or bucket.track.targetPath or bucket.track.name) .. ":" .. tostring(key.frame)
					if not playedSoundKeys[soundKeyId] and key.frame &gt; lastFrame and key.frame &lt;= frame then
						playedSoundKeys[soundKeyId] = true
						playSound(bucket.track, key.value, context)
					end
				end
			end
			if fadeFrame and fadeOutSeconds &gt; 0 and durationSeconds &gt; 0 then
				local remaining = durationSeconds - elapsed
				if remaining &lt;= fadeOutSeconds then
					fadeFrame.BackgroundTransparency = math.clamp(remaining / fadeOutSeconds, 0, 1)
				end
			end
			lastFrame = frame
			if elapsed &gt;= durationSeconds or skipState.requested then
				break
			end
			stepEvent:Wait()
		end
	end)

	cleanup()
	if not ok then
		warn("[MegMoCutscenePlayer] Playback failed: " .. tostring(err))
	end
	return ok
end

return MegMoCutscenePlayer
]=]
end

function CutsceneRuntimeGenerator.localExampleSource(cutsceneFolderName)
	return string.format([=[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CUTSCENE_NAME = %q
local root = ReplicatedStorage:WaitForChild("MegMoCutscenes", 10)
if not root then
	warn("[7kg2 Cutscene] Missing ReplicatedStorage.MegMoCutscenes. Keep the exported cutscene package in ReplicatedStorage.")
	return
end
local folder = root:WaitForChild(CUTSCENE_NAME, 10)
if not folder then
	warn("[7kg2 Cutscene] Missing cutscene folder: ReplicatedStorage.MegMoCutscenes." .. CUTSCENE_NAME)
	return
end
local data = require(folder:WaitForChild("CutsceneData"))
local player = require(folder:WaitForChild("MegMoCutscenePlayer"))
local exportOptions = data.ExportOptions or {}

-- Simple local preview only.
-- For rig cutscenes, use PlayServerTriggerExample + PlayClientReceiver instead.
if exportOptions.Trigger == "Timed" or exportOptions.Trigger == "AutoStart" then
	task.wait(tonumber(exportOptions.DelaySeconds) or 0)
end

player.Play(data, {
	restoreCamera = exportOptions.RestoreCamera ~= false,
})
]=], cutsceneFolderName)
end

function CutsceneRuntimeGenerator.clientReceiverSource(cutsceneFolderName)
	return string.format([=[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CUTSCENE_NAME = %q
local root = ReplicatedStorage:WaitForChild("MegMoCutscenes", 10)
if not root then
	warn("[7kg2 Cutscene] Missing ReplicatedStorage.MegMoCutscenes. Keep the exported cutscene package in ReplicatedStorage.")
	return
end
local folder = root:WaitForChild(CUTSCENE_NAME, 10)
if not folder then
	warn("[7kg2 Cutscene] Missing cutscene folder: ReplicatedStorage.MegMoCutscenes." .. CUTSCENE_NAME)
	return
end
local data = require(folder:WaitForChild("CutsceneData"))
local player = require(folder:WaitForChild("MegMoCutscenePlayer"))
local remote = folder:WaitForChild("PlayCutscene")
local hidePromptRemote = folder:FindFirstChild("HideCutscenePrompt")

local function resolvePath(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end
	local parts = string.split(path, ".")
	local current = game
	local startIndex = 1
	if parts[1] == "game" then
		startIndex = 2
	elseif parts[1] == "Workspace" then
		current = workspace
		startIndex = 2
	elseif parts[1] == "ReplicatedStorage" then
		current = ReplicatedStorage
		startIndex = 2
	end
	for index = startIndex, #parts do
		current = current and current:FindFirstChild(parts[index])
	end
	return current
end

if hidePromptRemote and hidePromptRemote:IsA("RemoteEvent") then
	hidePromptRemote.OnClientEvent:Connect(function(promptOrPath)
		local target = typeof(promptOrPath) == "Instance" and promptOrPath or resolvePath(tostring(promptOrPath or ""))
		local prompt = target and (target:IsA("ProximityPrompt") and target or target:FindFirstChildWhichIsA("ProximityPrompt", true))
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Enabled = false
		end
	end)
end

-- Move this LocalScript into StarterPlayerScripts and make sure it is enabled.
remote.OnClientEvent:Connect(function(triggeringUserId)
	player.Play(data, {
		restoreCamera = (data.ExportOptions or {}).RestoreCamera ~= false,
		triggeringUserId = triggeringUserId,
	})
end)
]=], cutsceneFolderName)
end

function CutsceneRuntimeGenerator.serverTriggerSource(cutsceneFolderName)
	return string.format([=[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local CUTSCENE_NAME = %q
local root = ReplicatedStorage:WaitForChild("MegMoCutscenes", 10)
if not root then
	warn("[7kg2 Cutscene] Missing ReplicatedStorage.MegMoCutscenes. Keep the exported cutscene package in ReplicatedStorage.")
	return
end
local folder = root:WaitForChild(CUTSCENE_NAME, 10)
if not folder then
	warn("[7kg2 Cutscene] Missing cutscene folder: ReplicatedStorage.MegMoCutscenes." .. CUTSCENE_NAME)
	return
end
local data = require(folder:WaitForChild("CutsceneData"))
local remote = folder:WaitForChild("PlayCutscene")
local hidePromptRemote = folder:FindFirstChild("HideCutscenePrompt")
local options = data.ExportOptions or {}
local settingsFolder = folder:FindFirstChild("CutsceneSettings")

-- Move this Script into ServerScriptService and make sure it is enabled.
-- Also move PlayClientReceiver into StarterPlayerScripts and make sure it is enabled.

local hasPlayedForEveryone = false
local playedLocalUserIds = {}
local CUTSCENE_ORIGINAL_ANCHORED_ATTRIBUTE = "MegMoCutsceneOriginalAnchored"
local CUTSCENE_ORIGINAL_CAN_COLLIDE_ATTRIBUTE = "MegMoCutsceneOriginalCanCollide"
local CUTSCENE_ORIGINAL_CAN_TOUCH_ATTRIBUTE = "MegMoCutsceneOriginalCanTouch"
local CUTSCENE_ORIGINAL_CAN_QUERY_ATTRIBUTE = "MegMoCutsceneOriginalCanQuery"
local CUTSCENE_ORIGINAL_MASSLESS_ATTRIBUTE = "MegMoCutsceneOriginalMassless"

local function settingValue(name, fallback)
	local valueObject = settingsFolder and settingsFolder:FindFirstChild(name)
	if valueObject and valueObject:IsA("ValueBase") then
		return valueObject.Value
	end
	if options[name] ~= nil then
		return options[name]
	end
	return fallback
end

local function resolvePath(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end
	local parts = string.split(path, ".")
	local current = game
	local startIndex = 1
	if parts[1] == "game" then
		startIndex = 2
	elseif parts[1] == "Workspace" then
		current = workspace
		startIndex = 2
	elseif parts[1] == "ReplicatedStorage" then
		current = ReplicatedStorage
		startIndex = 2
	end
	for index = startIndex, #parts do
		current = current and current:FindFirstChild(parts[index])
	end
	return current
end

local function decodeCFrame(value)
	if type(value) == "table" and value.type == "CFrame" and type(value.components) == "table" then
		return CFrame.new(table.unpack(value.components))
	end
	return nil
end

local function getProjectLastKeyframe()
	local project = data.Project or data
	local lastFrame = 0
	for frameText, pose in pairs(project.frames or {}) do
		if type(pose) == "table" then
			for _ in pairs(pose) do
				lastFrame = math.max(lastFrame, tonumber(frameText) or 0)
				break
			end
		end
	end
	return lastFrame
end

local function getCutsceneDurationSeconds()
	local project = data.Project or data
	local fps = math.max(1, tonumber(project.fps) or 60)
	local lastFrame = getProjectLastKeyframe()
	local durationFrames = lastFrame &gt; 0 and lastFrame or (tonumber(project.durationFrames) or 0)
	return durationFrames / fps
end

local function getCutsceneCompletionDelay()
	return getCutsceneDurationSeconds() + math.max(0, tonumber(settingValue("FadeInSeconds", 0)) or 0)
end

local function scheduleTeleportAfterCutscene(triggeringPlayer)
	if settingValue("AfterCutsceneAction", "StayHere") ~= "Teleport" then
		return
	end
	local placeId = math.floor(tonumber(settingValue("TeleportPlaceId", 0)) or 0)
	if placeId &lt;= 0 then
		warn("[7kg2 Cutscene] Teleport is enabled, but TeleportPlaceId is not valid.")
		return
	end

	local recipients = {}
	if settingValue("Playback", "LocalPlayer") == "Everyone" then
		for _, player in ipairs(Players:GetPlayers()) do
			table.insert(recipients, player)
		end
	elseif triggeringPlayer then
		table.insert(recipients, triggeringPlayer)
	end
	if #recipients == 0 then
		warn("[7kg2 Cutscene] No player was available to teleport after the cutscene.")
		return
	end

	task.delay(getCutsceneCompletionDelay(), function()
		local activeRecipients = {}
		for _, player in ipairs(recipients) do
			if player and player.Parent == Players then
				table.insert(activeRecipients, player)
			end
		end
		if #activeRecipients == 0 then
			return
		end
		if RunService:IsStudio() then
			warn("[7kg2 Cutscene] Teleports cannot run in Studio playtests. Publish the experience and test it in the Roblox app.")
			return
		end
		local success, err = pcall(function()
			TeleportService:TeleportAsync(placeId, activeRecipients)
		end)
		if not success then
			warn("[7kg2 Cutscene] Teleport failed: " .. tostring(err))
		end
	end)
end

local function getPlayerRigTemplateName()
	local configuredName = tostring(settingValue("PlayerRigName", ""))
	if configuredName ~= "" then
		return configuredName
	end
	local firstRig = data.RigAnimations and data.RigAnimations[1]
	return firstRig and tostring(firstRig.RigName or "") or ""
end

local function isRigCFrameTrack(track, rigName)
	if not track or track.targetScope ~= "RigProperty" then
		return false
	end
	if track.propertyName ~= "CFrame" and track.valueType ~= "CFrame" and track.name ~= "CFrame" then
		return false
	end
	if rigName == "" then
		return true
	end
	return track.rigName == rigName or track.part0 == rigName or track.parentTrackName == rigName
end

local function getFinalRigCFrame()
	local project = data.Project or data
	local rigName = getPlayerRigTemplateName()
	local paths = {}
	for _, track in ipairs(project.tracks or {}) do
		if isRigCFrameTrack(track, rigName) then
			paths[track.path] = true
		end
	end

	local bestFrame = -1
	local bestCFrame = nil
	for frameText, pose in pairs(project.frames or {}) do
		local frame = tonumber(frameText)
		if frame and type(pose) == "table" then
			for path in pairs(paths) do
				local entry = pose[path]
				local value = type(entry) == "table" and entry.value or entry
				local cframe = decodeCFrame(value)
				if cframe and frame &gt;= bestFrame then
					bestFrame = frame
					bestCFrame = cframe
				end
			end
		end
	end
	return bestCFrame
end

local function movePlayerToCutsceneEnd(player)
	if not player or settingValue("PlayerEndMode", "ReturnToStart") ~= "MoveToCutsceneEnd" then
		return
	end
	local targetCFrame = getFinalRigCFrame()
	local character = player.Character
	if not targetCFrame or not character or not character:IsA("Model") then
		return
	end
	character:PivotTo(targetCFrame)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.AssemblyLinearVelocity = Vector3.zero
			descendant.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function getRigRootPart(rig)
	if not rig then
		return nil
	end
	local root = rig:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	if rig.PrimaryPart and rig.PrimaryPart:IsA("BasePart") then
		return rig.PrimaryPart
	end
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

local function findRig(info)
	local rig = resolvePath(info.TargetPath or "")
	if rig then
		return rig
	end
	local rigName = tostring(info.RigName or "")
	if rigName ~= "" then
		return workspace:FindFirstChild(rigName, true)
	end
	return nil
end

local function stabilizeCutsceneRigs()
	for _, info in ipairs(data.RigAnimations or {}) do
		local rig = findRig(info)
		local rootPart = getRigRootPart(rig)
		if rig and rootPart then
			rootPart.Anchored = true
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			local humanoid = rig:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AutoRotate = false
				humanoid.PlatformStand = true
			end
			for _, descendant in ipairs(rig:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant.CanCollide = false
				end
			end
		elseif info.RigName then
			warn("[7kg2 Cutscene] Could not stabilize rig before trigger: " .. tostring(info.RigName))
		end
	end
end

stabilizeCutsceneRigs()

local function getInstanceCFrame(instance)
	if not instance or not instance.Parent then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance.CFrame
	end
	if instance:IsA("Model") then
		return instance:GetPivot()
	end
	if instance:IsA("Attachment") then
		return instance.WorldCFrame
	end
	return nil
end

local function setInstanceCFrame(instance, cframe)
	if not instance or not instance.Parent or typeof(cframe) ~= "CFrame" then
		return false
	end
	if instance:IsA("BasePart") then
		instance.CFrame = cframe
		return true
	end
	if instance:IsA("Model") then
		instance:PivotTo(cframe)
		return true
	end
	if instance:IsA("Attachment") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			parent.CFrame = cframe * instance.CFrame:Inverse()
			return true
		end
	end
	return false
end

local function collectBaseParts(target)
	local parts = {}
	if not target then
		return parts
	end
	if target:IsA("BasePart") then
		table.insert(parts, target)
	elseif target:IsA("Model") or target:IsA("Folder") then
		for _, descendant in ipairs(target:GetDescendants()) do
			if descendant:IsA("BasePart") then
				table.insert(parts, descendant)
			end
		end
	end
	return parts
end

local function stabilizeCutsceneProp(target, cframe)
	if not target or settingValue("FreezeCutsceneProps", true) ~= true then
		return
	end
	if typeof(cframe) == "CFrame" then
		setInstanceCFrame(target, cframe)
	end
	for _, part in ipairs(collectBaseParts(target)) do
		if part:GetAttribute(CUTSCENE_ORIGINAL_ANCHORED_ATTRIBUTE) == nil then
			part:SetAttribute(CUTSCENE_ORIGINAL_ANCHORED_ATTRIBUTE, part.Anchored)
		end
		if part:GetAttribute(CUTSCENE_ORIGINAL_CAN_COLLIDE_ATTRIBUTE) == nil then
			part:SetAttribute(CUTSCENE_ORIGINAL_CAN_COLLIDE_ATTRIBUTE, part.CanCollide)
		end
		if part:GetAttribute(CUTSCENE_ORIGINAL_CAN_TOUCH_ATTRIBUTE) == nil then
			part:SetAttribute(CUTSCENE_ORIGINAL_CAN_TOUCH_ATTRIBUTE, part.CanTouch)
		end
		if part:GetAttribute(CUTSCENE_ORIGINAL_CAN_QUERY_ATTRIBUTE) == nil then
			part:SetAttribute(CUTSCENE_ORIGINAL_CAN_QUERY_ATTRIBUTE, part.CanQuery)
		end
		if part:GetAttribute(CUTSCENE_ORIGINAL_MASSLESS_ATTRIBUTE) == nil then
			part:SetAttribute(CUTSCENE_ORIGINAL_MASSLESS_ATTRIBUTE, part.Massless)
		end
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
end

local function stabilizeCutsceneProps()
	-- Attachment props are now held by generated CFrame keys during playback.
	-- Do not anchor them on the server at game start, because that makes the
	-- prop permanently locked before the attach/detach timeline can take over.
end

stabilizeCutsceneProps()

local function findTriggerPart()
	local path = tostring(settingValue("TriggerPartPath", "Workspace.CutsceneTrigger"))
	return resolvePath(path) or workspace:FindFirstChild(path, true)
end

local function findTriggerPrompt()
	local path = tostring(settingValue("TriggerPromptPath", "Workspace.CutscenePrompt.ProximityPrompt"))
	local target = resolvePath(path) or workspace:FindFirstChild(path, true)
	if target and target:IsA("ProximityPrompt") then
		return target
	end
	if target then
		return target:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
	return nil
end

local function playerFromTouchedPart(hit)
	local character = hit and hit:FindFirstAncestorOfClass("Model")
	return character and Players:GetPlayerFromCharacter(character) or nil
end

local function playFor(player)
	local playbackMode = settingValue("Playback", "LocalPlayer")
	if playbackMode ~= "Everyone" and not player then
		warn("[7kg2 Cutscene] Local-player playback needs a player. Use PartTouched or call playFor(player).")
		return
	end
	if settingValue("Replay", "Once") ~= "EveryTime" then
		if playbackMode == "Everyone" then
			if hasPlayedForEveryone then
				return
			end
			hasPlayedForEveryone = true
		else
			local userId = player.UserId
			if playedLocalUserIds[userId] then
				return
			end
			playedLocalUserIds[userId] = true
		end
	end
	local triggeringUserId = player and player.UserId or 0
	if playbackMode == "Everyone" then
		remote:FireAllClients(triggeringUserId)
	else
		remote:FireClient(player, triggeringUserId)
	end
	if player
		and hidePromptRemote
		and hidePromptRemote:IsA("RemoteEvent")
		and settingValue("HidePromptAfterTrigger", true) == true
		and settingValue("Trigger", "Manual") == "ProximityPrompt"
		and settingValue("Replay", "Once") ~= "EveryTime" then
		local prompt = findTriggerPrompt()
		if prompt then
			hidePromptRemote:FireClient(player, prompt)
		end
	end
	if player
		and settingValue("RigTargetMode", "WorkspaceRig") == "TriggeringPlayerClone"
		and settingValue("AfterCutsceneAction", "StayHere") ~= "Teleport" then
		task.delay(getCutsceneCompletionDelay(), function()
			movePlayerToCutsceneEnd(player)
		end)
	end
	scheduleTeleportAfterCutscene(player)
end

local triggerType = settingValue("Trigger", "Manual")
if triggerType == "PartTouched" then
	local triggerPart = findTriggerPart()
	if triggerPart and triggerPart:IsA("BasePart") then
		triggerPart.Touched:Connect(function(hit)
			local player = playerFromTouchedPart(hit)
			if player then
				playFor(player)
			end
		end)
	else
		warn("[7kg2 Cutscene] Could not find trigger part: " .. tostring(settingValue("TriggerPartPath", "Workspace.CutsceneTrigger")))
	end
elseif triggerType == "ProximityPrompt" then
	local prompt = findTriggerPrompt()
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Triggered:Connect(function(player)
			playFor(player)
		end)
	else
		warn("[7kg2 Cutscene] Could not find proximity prompt: " .. tostring(settingValue("TriggerPromptPath", "Workspace.CutscenePrompt.ProximityPrompt")))
	end
elseif triggerType == "Timed" or triggerType == "AutoStart" then
	task.delay(tonumber(settingValue("DelaySeconds", 0)) or 0, function()
		if settingValue("Playback", "LocalPlayer") == "Everyone" then
			playFor(nil)
			return
		end
		local currentPlayers = Players:GetPlayers()
		if #currentPlayers == 0 then
			playFor(Players.PlayerAdded:Wait())
			return
		end
		for _, player in ipairs(currentPlayers) do
			playFor(player)
		end
	end)
else
	print("[7kg2 Cutscene] Manual trigger ready. Call playFor(player) from this script.")
end
]=], cutsceneFolderName)
end

function CutsceneRuntimeGenerator.readMeSource(cutsceneFolderName)
	return string.format([=[--[[
READ ME - 7kg2 Animator Cutscene Package

This ModuleScript is only here as an instruction file.
It does not run unless another script requires it.

1. Find Your Export
   - Open ReplicatedStorage &gt; MegMoCutscenes &gt; %s.
   - Keep every item in this folder together.
   - If a script warns that MegMoCutscenes is missing, the exported folder is not in ReplicatedStorage.

2. Recommended Setup
   - Move PlayServerTriggerExample into ServerScriptService and make sure it is enabled.
   - Move PlayClientReceiver into StarterPlayerScripts and make sure it is enabled.
   - Keep this cutscene folder inside ReplicatedStorage &gt; MegMoCutscenes.

3. Trigger Setup
   - Set CutsceneSettings &gt; Trigger to Manual, PartTouched, ProximityPrompt, Timed, or AutoStart.
   - If Trigger is PartTouched, set CutsceneSettings &gt; TriggerPartPath to the part that starts the cutscene.
     Example: Workspace.CutsceneTrigger
   - If Trigger is ProximityPrompt, set CutsceneSettings &gt; TriggerPromptPath to the prompt or an object containing it.
     Example: Workspace.NPC.StartCutscenePrompt
   - If the part is inside folders, use the full path.
     Example: Workspace.Map.CutsceneTriggers.IntroTrigger
   - Set CutsceneSettings &gt; Playback to LocalPlayer or Everyone.
   - LocalPlayer plays for the player who touched the trigger.
   - Everyone plays for all players in the server.
   - You can change TriggerPartPath, TriggerPromptPath, Playback, Replay, DelaySeconds, AllowSkip, FadeInSeconds, FadeOutSeconds, and RestoreCamera without editing code.
   - To teleport after playback, set AfterCutsceneAction to Teleport and set TeleportPlaceId to the destination place's numeric ID.
   - LocalPlayer playback teleports the triggering player. Everyone playback teleports the players who watched the cutscene.
   - Teleporting requires PlayServerTriggerExample to run on the server. Roblox does not run teleports during Studio playtests; publish and test in the Roblox app.

4. Use The Player Instead Of The Dummy
   - Set CutsceneSettings &gt; RigTargetMode to TriggeringPlayerClone.
   - The dummy rig is used as the animation template.
   - The cutscene creates a temporary clone of the triggering player's avatar.
   - The clone plays the cutscene, then is removed.
   - The dummy rig and player avatar should use the same rig type, for example both R15 or both R6.
   - Set CutsceneSettings &gt; PlayerEndMode to ReturnToStart or MoveToCutsceneEnd.
   - ReturnToStart keeps the real player where they started.
   - MoveToCutsceneEnd moves the real player to the final dummy rig position.

5. Simple Local Preview
   - PlayLocalExample is only a quick local preview.
   - For full rig cutscenes, use the Recommended Setup above.

6. Use It From Your Own Script
   local ReplicatedStorage = game:GetService("ReplicatedStorage")
   local folder = ReplicatedStorage:WaitForChild("MegMoCutscenes"):WaitForChild(%q)
   local data = require(folder:WaitForChild("CutsceneData"))
   local player = require(folder:WaitForChild("MegMoCutscenePlayer"))

   player.Play(data, {
       restoreCamera = true,
   })

   -- Optional: listen for 7kg2 Event tracks.
   -- The event payload is marker data; put your script action inside this callback.
   player.BindEvent("DoorOpen", function(payload, info)
       print("DoorOpen event fired at frame", info.frame, "payload:", payload)
       -- Example: open a door, emit particles, enable UI, or run your own gameplay code here.
   end)

7. Before Publishing Your Game
   - Open the RigAnimations folder.
   - Upload each KeyframeSequence as a Roblox Animation.
   - Paste each uploaded Animation ID into the matching value in RigAnimationIds.
   - Studio can preview temporary KeyframeSequences, but published games need real uploaded Animation IDs.

8. Useful Notes
   - CutsceneData loads the exported timeline from CutsceneDataChunks.
   - Do not delete CutsceneDataChunks.
   - Sound, camera, face, particle, lighting, object property, event, and screen effect playback are included in this package.
   - Screen effects, faces, particles, lighting, and custom event callbacks run locally, so PlayClientReceiver must be in StarterPlayerScripts.
   - Generic Event tracks fire through MegMoCutscenePlayer.OnEvent, MegMoCutscenePlayer.BindEvent(name, callback), and matching BindableEvents inside CutsceneEvents.
   - Event payload text is exported as data and passed to callbacks. It is not executed as Lua automatically.
   - Generated files are safe to edit after export, but exporting again will replace this cutscene folder.

9. Help And Feedback
   - Roblox Group: https://www.roblox.com/communities/453627593/MegMo-Animator#!/about
   - Tutorials: The Meg and Mo Show
   - When reporting a bug, include your 7kg2 Animator build number and any Studio Output errors.
]]

return "7kg2 Animator cutscene instructions. Open this ModuleScript and read the comments at the top."
]=], cutsceneFolderName, cutsceneFolderName)
end

return CutsceneRuntimeGenerator
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX52">
          <Properties>
            <string name="Name">CutsceneValidationService</string>
            <ProtectedString name="Source">local CutsceneValidationService = {}

local function plural(count, singular, pluralText)
	return string.format("%d %s", count, count == 1 and singular or (pluralText or singular .. "s"))
end

function CutsceneValidationService.validateData(data)
	if type(data) ~= "table"
		or (data.Format ~= "MegMoCutsceneV1" and data.Format ~= "MegMoCutsceneV2" and data.Format ~= "MegMoCutsceneV3")
	then
		return false, "Cutscene data could not be built."
	end

	local summary = data.Summary or {}
	local categories = summary.Categories or {}
	local exportOptions = data.ExportOptions or {}
	local warnings = {}
	local invalidTeleport = exportOptions.AfterCutsceneAction == "Teleport"
		and (tonumber(exportOptions.TeleportPlaceId) or 0) &lt;= 0
	if (summary.KeyCount or 0) == 0 then
		table.insert(warnings, "No keyframes found.")
	end
	if (categories.Camera or 0) == 0 then
		table.insert(warnings, "No camera track yet.")
	end
	if (categories.Rig or 0) &gt; 0 then
		table.insert(warnings, "Rig tracks export as temporary KeyframeSequences for local playback; upload animations for permanent published IDs.")
	end
	if exportOptions.Trigger == "PartTouched" and tostring(exportOptions.TriggerPartPath or "") == "" then
		table.insert(warnings, "Part Touched trigger needs a Workspace part path or name.")
	end
	if exportOptions.Trigger == "ProximityPrompt" and tostring(exportOptions.TriggerPromptPath or "") == "" then
		table.insert(warnings, "Proximity Prompt trigger needs a ProximityPrompt path or name.")
	end
	if exportOptions.RigTargetMode == "TriggeringPlayerClone"
		and tostring(exportOptions.PlayerRigName or "") == ""
		and type(data.RigAnimations) == "table"
		and #data.RigAnimations &gt; 1
	then
		table.insert(warnings, "Player Avatar mode will use the first exported rig unless Optional dummy rig name is set.")
	end
	if invalidTeleport then
		table.insert(warnings, "Teleport after the cutscene needs a valid destination Place ID.")
	end

	local parts = {
		"Cutscene check:",
		plural(summary.TrackCount or 0, "track"),
		plural(summary.KeyCount or 0, "key"),
		string.format("%.2fs", tonumber(summary.DurationSeconds) or 0),
		"Trigger: " .. tostring(exportOptions.Trigger or data.Trigger or "Manual"),
		"Playback: " .. tostring(exportOptions.Playback or data.Mode or "LocalPlayer"),
	}
	if exportOptions.AfterCutsceneAction == "Teleport" then
		table.insert(parts, "After: Teleport to " .. tostring(exportOptions.TeleportPlaceId or 0))
	end
	if (categories.Camera or 0) &gt; 0 then
		table.insert(parts, plural(categories.Camera, "camera track"))
	end
	if (categories.Sound or 0) &gt; 0 then
		table.insert(parts, plural(categories.Sound, "sound track"))
	end
	if (categories.ScreenEffect or 0) &gt; 0 then
		table.insert(parts, plural(categories.ScreenEffect, "screen effect"))
	end
	if (categories.Lighting or 0) &gt; 0 then
		table.insert(parts, plural(categories.Lighting, "lighting effect"))
	end
	if (categories.Face or 0) &gt; 0 then
		table.insert(parts, plural(categories.Face, "face track"))
	end
	if (categories.Particle or 0) &gt; 0 then
		table.insert(parts, plural(categories.Particle, "particle track"))
	end
	if (categories.Property or 0) &gt; 0 then
		table.insert(parts, plural(categories.Property, "property track"))
	end
	if (categories.Event or 0) &gt; 0 then
		table.insert(parts, plural(categories.Event, "event track"))
	end
	if #warnings &gt; 0 then
		table.insert(parts, "Warnings: " .. table.concat(warnings, " "))
	end

	return (summary.KeyCount or 0) &gt; 0 and not invalidTeleport, table.concat(parts, " | ")
end

return CutsceneValidationService
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX53">
        <Properties>
          <string name="Name">Timeline</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX54">
          <Properties>
            <string name="Name">KeyframeRenderer</string>
            <ProtectedString name="Source">local KeyframeRenderer = {}
KeyframeRenderer.__index = KeyframeRenderer

local EasingVisualSupport = require(script.Parent.Parent:WaitForChild("EasingVisualSupport"))

local DIAMOND_IMAGE = "rbxassetid://128720430032356"
local NORMAL_SIZE = 12
local HOVER_SIZE = 14
local SELECTED_SIZE = 16
local DEFAULT_ZINDEX = 7

local function brighten(color, amount)
	color = color or Color3.new(1, 1, 1)
	return color:Lerp(Color3.new(1, 1, 1), amount or 0.18)
end

local function ensureEasingHighlight(button)
	local highlight = button:FindFirstChild("EasingHighlight")
	if highlight then
		return highlight
	end

	highlight = Instance.new("ImageLabel")
	highlight.Name = "EasingHighlight"
	highlight.BackgroundTransparency = 1
	highlight.BorderSizePixel = 0
	highlight.AnchorPoint = Vector2.new(0.5, 0.5)
	highlight.Position = UDim2.fromScale(0.5, 0.5)
	highlight.Image = DIAMOND_IMAGE
	highlight.ScaleType = Enum.ScaleType.Fit
	highlight.Active = false
	highlight.Selectable = false
	highlight.Visible = false
	highlight.Parent = button
	return highlight
end

local function setButtonVisual(button, markerData)
	if not button or not markerData then
		return
	end

	local isSelected = markerData.selected == true
	local isHovered = markerData.hovered == true
	local color = markerData.markerColor or markerData.color or Color3.new(1, 1, 1)
	local size = NORMAL_SIZE
	if isSelected then
		size = SELECTED_SIZE
		color = brighten(color, 0.68)
	elseif isHovered then
		size = HOVER_SIZE
		color = brighten(color, 0.14)
	end

	button.Size = UDim2.fromOffset(size, size)
	button.ImageColor3 = color
	button.ImageTransparency = markerData.imageTransparency or 0
	button.BackgroundColor3 = markerData.markerColor or markerData.color or Color3.new(1, 1, 1)
	button.BackgroundTransparency = isSelected and 0.78 or 1
	button.ZIndex = isSelected and (markerData.zIndexSelected or DEFAULT_ZINDEX + 2)
		or (markerData.zIndex or DEFAULT_ZINDEX)

	local highlight = ensureEasingHighlight(button)
	local highlightColor = markerData.easingHighlightColor
	highlight.Visible = highlightColor ~= nil
	if highlightColor then
		local highlightSize = size + (isSelected and 8 or 6)
		highlight.ImageColor3 = highlightColor
		highlight.ImageTransparency = isSelected and 0.1 or 0.24
		highlight.Size = UDim2.fromOffset(highlightSize, highlightSize)
		highlight.ZIndex = math.max(1, button.ZIndex - 1)
	end
end

function KeyframeRenderer.new(parentFrame, callbacks)
	return setmetatable({
		_parent = parentFrame,
		_callbacks = callbacks or {},
		_pool = {},
		_buttonToKey = {},
		_connectionsByButton = {},
		_cursor = 0,
	}, KeyframeRenderer)
end

function KeyframeRenderer:SetParent(parentFrame)
	self._parent = parentFrame
end

function KeyframeRenderer:_connectButton(button)
	if self._connectionsByButton[button] then
		return
	end

	local connections = {}
	local function currentMarker()
		return self._buttonToKey[button]
	end

	table.insert(connections, button.MouseButton1Down:Connect(function(x, y)
		local markerData = currentMarker()
		if markerData and self._callbacks.onMouseDown then
			self._callbacks.onMouseDown(markerData, Vector2.new(x, y))
		end
	end))

	table.insert(connections, button.InputBegan:Connect(function(inputObject)
		local markerData = currentMarker()
		if not markerData then
			return
		end

		if inputObject.UserInputType == Enum.UserInputType.MouseButton2 and self._callbacks.onRightClick then
			self._callbacks.onRightClick(markerData)
		end
	end))

	local okMouse2, mouseButton2Down = pcall(function()
		return button.MouseButton2Down
	end)
	if okMouse2 and mouseButton2Down then
		table.insert(connections, mouseButton2Down:Connect(function()
			local markerData = currentMarker()
			if markerData and self._callbacks.onRightClick then
				self._callbacks.onRightClick(markerData)
			end
		end))
	end

	table.insert(connections, button.MouseEnter:Connect(function()
		local markerData = currentMarker()
		if markerData then
			markerData.hovered = true
			setButtonVisual(button, markerData)
			if self._callbacks.onHover then
				self._callbacks.onHover(markerData, button, true)
			end
		end
	end))

	table.insert(connections, button.MouseMoved:Connect(function(x, y)
		local markerData = currentMarker()
		if markerData and self._callbacks.onHover then
			self._callbacks.onHover(markerData, button, true, Vector2.new(x, y))
		end
	end))

	table.insert(connections, button.MouseLeave:Connect(function()
		local markerData = currentMarker()
		if markerData then
			markerData.hovered = false
			setButtonVisual(button, markerData)
			if self._callbacks.onHover then
				self._callbacks.onHover(markerData, button, false)
			end
		end
	end))

	self._connectionsByButton[button] = connections
end

function KeyframeRenderer:_createButton()
	local button = Instance.new("ImageButton")
	button.Name = "KeyDiamond"
	button.Image = DIAMOND_IMAGE
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.AutoButtonColor = false
	button.Active = true
	button.Selectable = false
	button.Size = UDim2.fromOffset(NORMAL_SIZE, NORMAL_SIZE)
	button.ZIndex = DEFAULT_ZINDEX
	self:_connectButton(button)
	return button
end

function KeyframeRenderer:Begin(parentFrame)
	if parentFrame then
		self._parent = parentFrame
	end
	self._cursor = 0
end

function KeyframeRenderer:Acquire(markerData, options)
	if not self._parent or not markerData then
		return nil
	end

	options = options or {}
	self._cursor += 1

	local button = self._pool[self._cursor]
	if not button then
		button = self:_createButton()
		self._pool[self._cursor] = button
	end

	button.Parent = self._parent
	button.Position = markerData.basePosition or UDim2.fromOffset(markerData.x or 0, markerData.y or 0)
	button.Visible = true
	button.Active = true
	button.Image = DIAMOND_IMAGE
	button.Rotation = 0

	markerData.usesPooledImage = true
	markerData.button = button
	markerData.hitbox = button
	markerData.markerColor = options.color or markerData.markerColor or markerData.color
	markerData.easingStyle = options.easingStyle or markerData.easingStyle
	markerData.easingDirection = options.easingDirection or markerData.easingDirection
	markerData.easingHighlightColor = EasingVisualSupport.getHighlightColor(markerData.easingStyle)
	markerData.easingTooltip = EasingVisualSupport.getTooltip(markerData.easingStyle, markerData.easingDirection)
	markerData.zIndex = options.zIndex or DEFAULT_ZINDEX
	markerData.zIndexSelected = options.zIndexSelected or DEFAULT_ZINDEX + 2
	markerData.hovered = false
	self._buttonToKey[button] = markerData
	setButtonVisual(button, markerData)

	return button
end

function KeyframeRenderer:End()
	for index = self._cursor + 1, #self._pool do
		local button = self._pool[index]
		if button then
			button.Visible = false
			button.Active = false
			self._buttonToKey[button] = nil
		end
	end
end

function KeyframeRenderer:UpdateMarker(markerData)
	if markerData and markerData.button then
		setButtonVisual(markerData.button, markerData)
	end
end

function KeyframeRenderer:UpdateSelection(selectedKeyIds)
	selectedKeyIds = selectedKeyIds or {}
	for button, markerData in pairs(self._buttonToKey) do
		if markerData then
			markerData.selected = markerData.keyId and selectedKeyIds[markerData.keyId] == true
			setButtonVisual(button, markerData)
		end
	end
end

function KeyframeRenderer:DebugSnapshot()
	local visible = 0
	local mapped = 0
	for button, markerData in pairs(self._buttonToKey) do
		if markerData then
			mapped += 1
			if button.Visible then
				visible += 1
			end
		end
	end

	return {
		visible = visible,
		mapped = mapped,
		pool = #self._pool,
		cursor = self._cursor,
	}
end

function KeyframeRenderer:Invalidate()
	self._cursor = 0
	for _, button in ipairs(self._pool) do
		button.Visible = false
		button.Active = false
		self._buttonToKey[button] = nil
	end
end

function KeyframeRenderer:Destroy()
	for button, connections in pairs(self._connectionsByButton) do
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		self._connectionsByButton[button] = nil
	end
	for _, button in ipairs(self._pool) do
		button:Destroy()
	end
	self._pool = {}
	self._buttonToKey = {}
end

return KeyframeRenderer
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX55">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX56">
          <Properties>
            <string name="Name">AnimationExportCameraWarningPrompt</string>
            <ProtectedString name="Source">local ModalOverlaySupport = require(script.Parent.Parent:WaitForChild("ModalOverlaySupport"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local AnimationExportCameraWarningPrompt = {}

local PROMPT_NAME = "AnimationExportCameraWarningPrompt"

local function create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

function AnimationExportCameraWarningPrompt.getCameraDataSummary(timeline)
	local summary = {
		hasData = false,
		trackCount = 0,
		keyCount = 0,
	}
	if not timeline then
		return summary
	end
	local cameraTrackService = require(script.Parent.Parent:WaitForChild("CameraTrackService"))
	for _, track in ipairs(timeline:getTracks() or {}) do
		if cameraTrackService.isCameraTrack(track) or cameraTrackService.isCameraPropertyTrack(track) then
			local keyCount = #(timeline:getTrackKeyframeFrames(track.path) or {})
			if keyCount &gt; 0 then
				summary.hasData = true
				summary.trackCount += 1
				summary.keyCount += keyCount
			end
		end
	end
	return summary
end

function AnimationExportCameraWarningPrompt.show(parent, options)
	options = options or {}
	if not parent then
		return false
	end
	local existing = parent:FindFirstChild(PROMPT_NAME)
	if existing then
		existing:Destroy()
	end

	local colors = ThemeService.getCurrentTheme().colors
	local overlay = create("Frame", {
		Name = PROMPT_NAME,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 230,
		Parent = parent,
	})
	ModalOverlaySupport.applyToOverlay(overlay)

	local card = create("Frame", {
		Name = "PromptCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = colors.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -32, 0, 270),
		ZIndex = 232,
		Parent = overlay,
	})
	UiHelpers.createCorner(card, 8)
	local stroke = UiHelpers.createStroke(card, colors.Accent, 1)
	stroke.Transparency = 0.2
	create("UISizeConstraint", {
		MaxSize = Vector2.new(500, 270),
		MinSize = Vector2.new(280, 270),
		Parent = card,
	})

	create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 28),
		Text = "Camera data cannot be exported",
		TextColor3 = colors.Text,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 233,
		Parent = card,
	})

	local summaryText = string.format(
		"This project contains %d camera track%s with %d keyframe%s.",
		math.max(1, tonumber(options.trackCount) or 1),
		tonumber(options.trackCount) == 1 and "" or "s",
		math.max(1, tonumber(options.keyCount) or 1),
		tonumber(options.keyCount) == 1 and "" or "s"
	)
	local summary = create("TextLabel", {
		Name = "CameraSummary",
		BackgroundColor3 = colors.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 52),
		Size = UDim2.new(1, -36, 0, 42),
		Text = summaryText,
		TextColor3 = colors.Accent,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.createCorner(summary, 5)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = summary,
	})

	create("TextLabel", {
		Name = "Message",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(18, 106),
		Size = UDim2.new(1, -36, 0, 82),
		Text = "Roblox Animation and KeyframeSequence files support rig joint animation only. Camera CFrame and FOV data will not be included.\n\nUse 7kg2's Cutscene Exporter when you need the camera and rig animation together.",
		TextColor3 = colors.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 233,
		Parent = card,
	})

	local statusLabel = create("TextLabel", {
		Name = "Status",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 18, 1, -72),
		Size = UDim2.new(1, -36, 0, 18),
		Text = "",
		TextColor3 = colors.Danger or Color3.fromRGB(255, 110, 125),
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = false,
		ZIndex = 233,
		Parent = card,
	})

	local cancelButton = create("TextButton", {
		Name = "Cancel",
		AutoButtonColor = true,
		Position = UDim2.new(0, 18, 1, -48),
		Size = UDim2.new(0.42, -22, 0, 36),
		Text = "Cancel",
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.styleGhostButton(cancelButton)
	UiHelpers.createCorner(cancelButton, 5)

	local exportButton = create("TextButton", {
		Name = "ExportRigOnly",
		AutoButtonColor = true,
		Position = UDim2.new(0.42, 4, 1, -48),
		Size = UDim2.new(0.58, -22, 0, 36),
		Text = "Export Rig Only",
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.styleTextButton(exportButton, colors.Accent)
	UiHelpers.createCorner(exportButton, 5)

	local busy = false
	cancelButton.Activated:Connect(function()
		if not busy and overlay.Parent then
			overlay:Destroy()
		end
	end)
	exportButton.Activated:Connect(function()
		if busy or type(options.onConfirm) ~= "function" then
			return
		end
		busy = true
		exportButton.Active = false
		exportButton.Text = "Exporting Rig..."
		local ok, success, message = pcall(options.onConfirm)
		if ok and success == true then
			if overlay.Parent then
				overlay:Destroy()
			end
			return
		end
		busy = false
		exportButton.Active = true
		exportButton.Text = "Export Rig Only"
		statusLabel.Text = tostring((ok and message) or success or "The rig animation could not be exported.")
		statusLabel.Visible = true
	end)
	return true
end

return AnimationExportCameraWarningPrompt
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX57">
          <Properties>
            <string name="Name">AnimationExportMultiRigPrompt</string>
            <ProtectedString name="Source">local ModalOverlaySupport = require(script.Parent.Parent:WaitForChild("ModalOverlaySupport"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local AnimationExportMultiRigPrompt = {}

local PROMPT_NAME = "AnimationExportMultiRigPrompt"

local function create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

function AnimationExportMultiRigPrompt.show(parent, options)
	options = options or {}
	if not parent then
		return false
	end
	local existing = parent:FindFirstChild(PROMPT_NAME)
	if existing then
		existing:Destroy()
	end

	local colors = ThemeService.getCurrentTheme().colors
	local overlay = create("Frame", {
		Name = PROMPT_NAME,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 230,
		Parent = parent,
	})
	ModalOverlaySupport.applyToOverlay(overlay)

	local card = create("Frame", {
		Name = "PromptCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = colors.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -32, 0, 300),
		ZIndex = 232,
		Parent = overlay,
	})
	UiHelpers.createCorner(card, 8)
	local stroke = UiHelpers.createStroke(card, colors.Accent, 1)
	stroke.Transparency = 0.2
	create("UISizeConstraint", {
		MaxSize = Vector2.new(540, 300),
		MinSize = Vector2.new(360, 300),
		Parent = card,
	})

	create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 28),
		Text = "Several rig animations found",
		TextColor3 = colors.Text,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 233,
		Parent = card,
	})

	local rigCount = math.max(2, tonumber(options.rigCount) or 2)
	local summary = create("TextLabel", {
		Name = "RigSummary",
		BackgroundColor3 = colors.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 52),
		Size = UDim2.new(1, -36, 0, 42),
		Text = string.format("This project contains %d animated rigs.", rigCount),
		TextColor3 = colors.Accent,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.createCorner(summary, 5)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = summary,
	})

	local cameraMessage = ""
	if options.hasCameraData == true then
		cameraMessage = "\n\nCamera data is not included. Use Cutscene Exporter for camera and rigs together."
	end
	create("TextLabel", {
		Name = "Message",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(18, 106),
		Size = UDim2.new(1, -36, 0, 100),
		Text = string.format(
			"Roblox animations support one rig per KeyframeSequence. Export One Rig uses '%s'. Export All Separately creates one file for every rig.%s",
			tostring(options.targetRigName or "the active rig"),
			cameraMessage
		),
		TextColor3 = colors.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 233,
		Parent = card,
	})

	local statusLabel = create("TextLabel", {
		Name = "Status",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 18, 1, -72),
		Size = UDim2.new(1, -36, 0, 18),
		Text = "",
		TextColor3 = colors.Danger or Color3.fromRGB(255, 110, 125),
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = false,
		ZIndex = 233,
		Parent = card,
	})

	local cancelButton = create("TextButton", {
		Name = "Cancel",
		AutoButtonColor = true,
		Position = UDim2.new(0, 18, 1, -48),
		Size = UDim2.new(0.24, -12, 0, 36),
		Text = "Cancel",
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.styleGhostButton(cancelButton)
	UiHelpers.createCorner(cancelButton, 5)

	local oneRigButton = create("TextButton", {
		Name = "ExportOneRig",
		AutoButtonColor = true,
		Position = UDim2.new(0.24, 8, 1, -48),
		Size = UDim2.new(0.34, -12, 0, 36),
		Text = "Export One Rig",
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.styleGhostButton(oneRigButton)
	UiHelpers.createCorner(oneRigButton, 5)

	local allRigsButton = create("TextButton", {
		Name = "ExportAllRigs",
		AutoButtonColor = true,
		Position = UDim2.new(0.58, 8, 1, -48),
		Size = UDim2.new(0.42, -26, 0, 36),
		Text = "Export All Separately",
		ZIndex = 233,
		Parent = card,
	})
	UiHelpers.styleTextButton(allRigsButton, colors.Accent)
	UiHelpers.createCorner(allRigsButton, 5)

	local busy = false
	local function runExport(button, busyText, callback)
		if busy or type(callback) ~= "function" then
			return
		end
		busy = true
		oneRigButton.Active = false
		allRigsButton.Active = false
		local previousText = button.Text
		button.Text = busyText
		local ok, success, message = pcall(callback)
		if ok and success == true then
			if overlay.Parent then
				overlay:Destroy()
			end
			return
		end
		busy = false
		oneRigButton.Active = true
		allRigsButton.Active = true
		button.Text = previousText
		statusLabel.Text = tostring((ok and message) or success or "The rig animation could not be exported.")
		statusLabel.Visible = true
	end

	cancelButton.Activated:Connect(function()
		if not busy and overlay.Parent then
			overlay:Destroy()
		end
	end)
	oneRigButton.Activated:Connect(function()
		runExport(oneRigButton, "Exporting...", options.onExportOne)
	end)
	allRigsButton.Activated:Connect(function()
		runExport(allRigsButton, "Exporting...", options.onExportAll)
	end)

	return true
end

return AnimationExportMultiRigPrompt
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX58">
          <Properties>
            <string name="Name">AvatarImportUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local AvatarImportUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local styleInput = UiHelpers.styleInput
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

function AvatarImportUI.mount(parent, _context)
	if not parent then
		error("AvatarImportUI.mount requires parent")
	end

	local overlay = create("Frame", {
		Name = "AvatarImportOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 118,
	})

	local card = create("Frame", {
		Name = "AvatarImportCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 420, 0, 260),
		ZIndex = 119,
	})
	applySectionSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)

	local title = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 16),
		Size = UDim2.new(1, -58, 0, 24),
		Font = Enum.Font.GothamSemibold,
		Text = "Insert Avatar",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 120,
	})

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.new(0, 30, 0, 30),
		Text = "X",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		ZIndex = 120,
	})
	createCorner(closeButton, 9)

	local help = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 48),
		Size = UDim2.new(1, -36, 0, 42),
		Font = Enum.Font.GothamSemibold,
		Text = "Enter a Roblox username or userId, or leave blank for a random avatar. Switch R15/R6 to reuse the same random user once.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 120,
	})

	local input = create("TextBox", {
		Name = "AvatarImportInput",
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		PlaceholderText = "Username or userId (blank = random)",
		Position = UDim2.new(0, 18, 0, 100),
		Size = UDim2.new(1, -36, 0, 34),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 120,
	})
	styleInput(input)
	createCorner(input, 9)
	createStroke(input)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local typeButton = create("TextButton", {
		Name = "AvatarImportRigTypeButton",
		Parent = card,
		Position = UDim2.new(0, 18, 0, 144),
		Size = UDim2.new(1, -36, 0, 34),
		Text = "Avatar Type: R15 Classic",
		ZIndex = 120,
	})
	styleGhostButton(typeButton)
	typeButton.TextSize = 12
	createCorner(typeButton, 9)

	local status = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 184),
		Size = UDim2.new(1, -36, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Tip: leave blank to pick a random avatar.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 120,
	})

	local cancelButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 18, 1, -48),
		Size = UDim2.new(0.5, -24, 0, 34),
		Text = "Cancel",
		ZIndex = 120,
	})
	styleGhostButton(cancelButton)
	createCorner(cancelButton, 9)

	local insertButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.5, 6, 1, -48),
		Size = UDim2.new(0.5, -24, 0, 34),
		Text = "Insert Avatar",
		ZIndex = 120,
	})
	styleTextButton(insertButton)
	createCorner(insertButton, 9)

	return {
		_avatarImportOverlay = overlay,
		_avatarImportInput = input,
		_avatarImportRigTypeButton = typeButton,
		_avatarImportStatusLabel = status,
		_avatarImportCloseButton = closeButton,
		_avatarImportCancelButton = cancelButton,
		_avatarImportInsertButton = insertButton,
	}
end

return AvatarImportUI
