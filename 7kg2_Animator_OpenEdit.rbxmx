				self:_showRemoveConfirmation(trackPath)
			end
		end)
	end

	if self._trackActionsFolderButton then
		self:_connect(self._trackActionsFolderButton.Activated, function()
			local trackPath = self._pendingTrackActionPath
			self:_hideTrackActions()
			if trackPath and callbacks.onMoveTrackToFolder then
				callbacks.onMoveTrackToFolder(trackPath)
			end
			self:_focusShortcutCapture("Track folder assignment updated")
		end)
	end

	if self._trackActionsEditButton then
		self:_connect(self._trackActionsEditButton.Activated, function()
			local trackPath = self._pendingTrackActionPath
			local track = self:_getTrackViewModel(trackPath)
			self:_hideTrackActions()
			if not track then
				return
			end
			if track.trackType == "Screen Effect" or track.trackType == "Lighting Effect" then
				self:_showEffectTrackEditor(trackPath)
			elseif track.trackType == "Camera" or track.trackType == "Camera Property" then
				self:_showCameraTrackEditor(trackPath)
			elseif self:_isParticlePropertyTrack(track) then
				self:_showParticleKeyframeEditor(trackPath)
			elseif track.trackType == "Event" or track.valueType == "Event" then
				self:_showRigPropertyEditor(trackPath, track.name)
			elseif self:_isEditablePropertyKeyframeTrack(track) then
				self:_showPropertyKeyframeEditor(trackPath)
			elseif track.trackType == "Rig" then
				self:_showRigPropertyEditor(trackPath, track.name)
			elseif track.trackType == "Rig Group" or track.trackType == "Rig Property" then
				self:_showRigPropertyEditor(trackPath, track.rigName or track.name)
			elseif track.trackType == "Emitter Group"
				or track.trackType == "Object"
				or track.trackType == "Model"
				or track.trackType == "Rig CFrame"
				or track.trackType == "Object Property" then
				self:_showRigPropertyEditor(trackPath, track.name)
			end
		end)
	end

