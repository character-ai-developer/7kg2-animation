local EffectsViewModelBuilder = {}

function EffectsViewModelBuilder.build(effectsService, timeline, frame)
	return ScreenEffectTrackService.applyTimelineEffects(
		effectsService:getViewModel(),
		timeline,
		frame or timeline:getCurrentFrame()
	)
end

return EffectsViewModelBuilder
