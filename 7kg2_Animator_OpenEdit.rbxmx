	local function applyCameraFollowSelection(useBoundRig, previewOnly)
		local presetId = self._activeCameraFollowPresetId
		if not presetId or not callbacks.onApplyCameraPreset then
			return
		end
		local options = self:_getCameraPresetOptions()
		options.useBoundRig = useBoundRig == true
		options.previewOnly = previewOnly == true
		if useBoundRig == true and presetId == "Orbit" and options.durationToEnd ~= true then
			local durationText = self._cameraFollowDurationInput and tostring(self._cameraFollowDurationInput.Text or "") or ""
			if durationText == "" or durationText == "2.4" or durationText == "2.40" then
				options.durationSeconds = nil
			end
		end
		if presetId == "FirstPerson" then
			presetId = "FirstPersonAttach"
		elseif presetId == "FollowRigCinematic" then
			options.followStyle = "Cinematic"
			presetId = "FollowRig"
		elseif presetId == "FollowRig" then
			options.followStyle = "Regular"
		end
		callbacks.onApplyCameraPreset(presetId, options)
		if not previewOnly then
			self:_hideCameraTrackEditor()
		end
		self:_focusShortcutCapture(previewOnly and "Previewing camera preset" or "Camera preset applied")
	end
	if self._cameraFollowPreviewButton then
		self:_connect(self._cameraFollowPreviewButton.Activated, function()
			applyCameraFollowSelection(false, true)
		end)
	end
	if self._cameraFollowUseSelectionButton then
		self:_connect(self._cameraFollowUseSelectionButton.Activated, function()
			applyCameraFollowSelection(false, false)
		end)
	end
	if self._cameraFollowUseBoundRigButton then
		self:_connect(self._cameraFollowUseBoundRigButton.Activated, function()
			applyCameraFollowSelection(true, false)
		end)
	end
