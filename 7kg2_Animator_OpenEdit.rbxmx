	end

	local overlay = create("TextButton", {
		Name = "CameraRotationOverlay",
		Parent = parent,
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextTransparency = 1,
		Visible = false,
		ZIndex = 140,
	})

	local card = create("Frame", {
		Name = "CameraRotationCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
