        <Item class="ModuleScript" referent="RBX102">
          <Properties>
            <string name="Name">RigExplorerUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local RigExplorerUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createSectionTitle = UiHelpers.createSectionTitle
local createMetaLabel = UiHelpers.createMetaLabel
local createListLayout = UiHelpers.createListLayout
local createCard = UiHelpers.createCard

function RigExplorerUI.mount(parent, _context)
	if not parent then
		error("RigExplorerUI.mount requires parent")
	end

	local refs = {}

	local explorerCard = createCard(parent, UDim2.new(1, 0, 0.56, -6))
	explorerCard.Position = UDim2.new(0, 0, 0, 0)
	explorerCard.ClipsDescendants = true
	createSectionTitle(explorerCard, "Rig Explorer").Position = UDim2.new(0, 14, 0, 12)
	local rigExplorerCollapseButton = UiHelpers.createPanelCollapseButton(explorerCard)
	local explorerDescription = createMetaLabel(explorerCard, "Select a rig, then choose the joint you want to edit.", 28)
	explorerDescription.Position = UDim2.new(0, 14, 0, 34)
	explorerDescription.Size = UDim2.new(1, -28, 0, 28)
	explorerDescription.TextWrapped = true
	explorerDescription.TextYAlignment = Enum.TextYAlignment.Top

	local bindButton = create("TextButton", {
		Name = "BindButton",
		Parent = explorerCard,
		Position = UDim2.new(0, 14, 0, 68),
		Size = UDim2.new(1, -28, 0, 30),
		Text = "Add Selected Rig",
	})
	styleTextButton(bindButton)
	createCorner(bindButton, 10)

	local jointsList = create("ScrollingFrame", {
		Name = "JointsList",
		Parent = explorerCard,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0, 108),
		Size = UDim2.new(1, -28, 1, -122),
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 6,
	})
	createCorner(jointsList, 10)
	createStroke(jointsList)
	local jointsLayout = createListLayout(jointsList, 6)

	refs._bindButton = bindButton
	refs._jointsList = jointsList
	refs._jointsLayout = jointsLayout
	refs._rigExplorerCard = explorerCard
	refs._rigExplorerCollapseButton = rigExplorerCollapseButton

	return refs
end

function RigExplorerUI.update(_context)
end

function RigExplorerUI.destroy()
end

return RigExplorerUI
