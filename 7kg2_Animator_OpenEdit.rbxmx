          <Item class="ModuleScript" referent="RBX39">
            <Properties>
              <string name="Name">RiderRuntime</string>
              <ProtectedString name="Source">local HttpService = game:GetService("HttpService")

local RiderRuntime = {}

local RIDER_ATTRIBUTE = "MegMoPhysicsRiderId"

local function findRig(instance)
	local current = instance
	while current and current ~= workspace do
		if current:IsA("Model")
			and (current:FindFirstChildOfClass("Humanoid") or current:FindFirstChildOfClass("AnimationController"))
			and current:FindFirstChildWhichIsA("Motor6D", true) then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function findRoot(rig)
	local root = rig:FindFirstChild("HumanoidRootPart", true)
		or rig.PrimaryPart
		or rig:FindFirstChild("Torso", true)
		or rig:FindFirstChild("LowerTorso", true)
		or rig:FindFirstChild("UpperTorso", true)
	return root and root:IsA("BasePart") and root or nil
end

local function collectParts(rig)
	local parts = {}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

function RiderRuntime.CollectSelection(selection, driver)
	local descriptors = {}
	local seen = {}
	for _, selected in ipairs(selection or {}) do
		local rig = findRig(selected)
		local belongsToDriver = rig and driver and (rig == driver or rig:IsDescendantOf(driver) or driver:IsDescendantOf(rig))
		if rig and not belongsToDriver and not seen[rig] then
			seen[rig] = true
			table.insert(descriptors, {
				id = HttpService:GenerateGUID(false),
				instance = rig,
				name = rig.Name,
				path = rig:GetFullName(),
			})
		end
	end
	return descriptors
end

function RiderRuntime.PrepareRuntimeIds(descriptors)
	for _, descriptor in ipairs(descriptors or {}) do
		local rider = descriptor.instance
		if rider and rider.Parent and rider:IsA("Model") and descriptor.id then
			rider:SetAttribute(RIDER_ATTRIBUTE, descriptor.id)
		end
	end
end

function RiderRuntime.ClearRuntimeIds(descriptors)
	for _, descriptor in ipairs(descriptors or {}) do
		local rider = descriptor.instance
		if rider and rider.Parent and descriptor.id and rider:GetAttribute(RIDER_ATTRIBUTE) == descriptor.id then
			rider:SetAttribute(RIDER_ATTRIBUTE, nil)
		end
	end
end

function RiderRuntime.FindRuntimeRiders(descriptors)
	local wanted = {}
	for _, descriptor in ipairs(descriptors or {}) do
		if descriptor.id then
			wanted[descriptor.id] = descriptor
		end
	end
	local found = {}
	if next(wanted) == nil then
		return found
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") then
			local id = descendant:GetAttribute(RIDER_ATTRIBUTE)
			local editDescriptor = id and wanted[id] or nil
			if editDescriptor then
				table.insert(found, {
					id = id,
					name = editDescriptor.name,
					target = descendant,
				})
			end
		end
	end
	return found
end

function RiderRuntime.Start(driveSession, runtimeRiders)
	local driverRoot = driveSession and driveSession.root
	if not (driverRoot and driverRoot.Parent) then
		return nil, "The Physics Drive root is not available for riders."
	end
	local session = { items = {}, captureDescriptors = {} }
	for _, riderDescriptor in ipairs(runtimeRiders or {}) do
		local rider = riderDescriptor.target
		local root = rider and rider.Parent and findRoot(rider) or nil
		local parts = rider and rider.Parent and collectParts(rider) or {}
		if root and #parts &gt; 0 then
			local item = {
				target = rider,
				root = root,
				parts = {},
				scripts = {},
			}
			for _, part in ipairs(parts) do
				table.insert(item.parts, {
					part = part,
					anchored = part.Anchored,
					canCollide = part.CanCollide,
					massless = part.Massless,
				})
				part.Anchored = false
				part.CanCollide = false
				part.Massless = true
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
			for _, descendant in ipairs(rider:GetDescendants()) do
				if descendant:IsA("BaseScript") and string.lower(descendant.Name) == "animate" then
					table.insert(item.scripts, { script = descendant, disabled = descendant.Disabled })
					descendant.Disabled = true
				end
			end
			local humanoid = rider:FindFirstChildOfClass("Humanoid")
			if humanoid then
				item.humanoid = humanoid
				item.autoRotate = humanoid.AutoRotate
				item.platformStand = humanoid.PlatformStand
				humanoid.AutoRotate = false
				humanoid.PlatformStand = true
			end
			local weld = Instance.new("WeldConstraint")
			weld.Name = "__MegMoPhysicsDriveRiderWeld"
			weld.Part0 = driverRoot
			weld.Part1 = root
			weld.Parent = root
			item.weld = weld
			table.insert(session.items, item)
			table.insert(session.captureDescriptors, {
				id = riderDescriptor.id,
				name = riderDescriptor.name or rider.Name,
				part = root,
				target = rider,
				rootName = root.Name,
				rootToTargetPivot = root.CFrame:ToObjectSpace(rider:GetPivot()),
			})
		end
	end
	return session, nil
end

function RiderRuntime.Cancel(session)
	if not session then
		return
	end
	for _, item in ipairs(session.items or {}) do
		if item.weld then
			item.weld:Destroy()
		end
		if item.humanoid and item.humanoid.Parent then
			item.humanoid.AutoRotate = item.autoRotate
			item.humanoid.PlatformStand = item.platformStand
		end
		for _, scriptState in ipairs(item.scripts or {}) do
			if scriptState.script and scriptState.script.Parent then
				scriptState.script.Disabled = scriptState.disabled
			end
		end
		for _, partState in ipairs(item.parts or {}) do
			local part = partState.part
			if part and part.Parent then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.CanCollide = partState.canCollide
				part.Massless = partState.massless
				part.Anchored = partState.anchored
			end
		end
	end
	session.items = {}
	session.captureDescriptors = {}
end

return RiderRuntime
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX40">
            <Properties>
              <string name="Name">SceneCaptureScope</string>
              <ProtectedString name="Source">local HttpService = game:GetService("HttpService")

local PhysicsRigFilter = require(script.Parent:WaitForChild("PhysicsRigFilter"))

local SceneCaptureScope = {}

local CAPTURE_ATTRIBUTE = "MegMoPhysicsObjectCaptureId"
local RIGID_GROUP_ATTRIBUTE = "MegMoPhysicsRigidGroupId"
local MAX_CAPTURE_PARTS = 500

SceneCaptureScope.RIG_ONLY = "Rig"
SceneCaptureScope.SELECTED = "Selected"
SceneCaptureScope.ENTIRE_SCENE = "Scene"

local function isInsideRig(part, rig)
	return rig and rig.Parent and part:IsDescendantOf(rig)
end

local function isMegMoHelper(part)
	local current = part
	while current and current ~= workspace do
		local name = tostring(current.Name or "")
		if name == "MegMoAnimatorGizmoProxy"
			or name == "MegMoIKPrototypeGizmoProxy"
			or string.sub(name, 1, 9) == "MegMo_IK_"
			or string.sub(name, 1, 17) == "MegMoAnimatorView" then
			return true
		end
		current = current.Parent
	end
	return false
end

local function canCapturePart(part, rig)
	return part
		and part.Parent
		and part:IsA("BasePart")
		and part.Archivable ~= false
		and not isInsideRig(part, rig)
		and not isMegMoHelper(part)
end

local function addPart(parts, seen, part, rig)
	if canCapturePart(part, rig) and not seen[part] then
		seen[part] = true
		table.insert(parts, part)
		return true
	end
	return false
end

local function selectedModelIsOneObject(selected)
	if not selected:IsA("Model") then
		return false
	end
	if selected.PrimaryPart then
		return true
	end
	for _, child in ipairs(selected:GetChildren()) do
		if child:IsA("BasePart") then
			return true
		end
	end
	return false
end

local function rigidGroupFor(selected, part)
	if not (selected and part and part:IsDescendantOf(selected)) then
		return nil
	end
	if selectedModelIsOneObject(selected) then
		return selected
	end
	local current = part.Parent
	local group = nil
	while current and current ~= selected do
		if current:IsA("Model") then
			group = current
		end
		current = current.Parent
	end
	return group
end

local function addSelection(parts, seen, groups, selected, rig)
	if not (selected and selected.Parent) then
		return
	end
	if selected:IsA("BasePart") then
		addPart(parts, seen, selected, rig)
		return
	end
	for _, descendant in ipairs(selected:GetDescendants()) do
		if descendant:IsA("BasePart") and addPart(parts, seen, descendant, rig) then
			groups[descendant] = rigidGroupFor(selected, descendant)
		end
	end
end

local function includeBoundsPoint(bounds, point)
	if not bounds.minimum then
		bounds.minimum = point
		bounds.maximum = point
		return
	end
	bounds.minimum = Vector3.new(
		math.min(bounds.minimum.X, point.X),
		math.min(bounds.minimum.Y, point.Y),
		math.min(bounds.minimum.Z, point.Z)
	)
	bounds.maximum = Vector3.new(
		math.max(bounds.maximum.X, point.X),
		math.max(bounds.maximum.Y, point.Y),
		math.max(bounds.maximum.Z, point.Z)
	)
end

local function includePartBounds(bounds, part)
	local halfSize = part.Size * 0.5
	for x = -1, 1, 2 do
		for y = -1, 1, 2 do
			for z = -1, 1, 2 do
				includeBoundsPoint(
					bounds,
					part.CFrame:PointToWorldSpace(Vector3.new(
						halfSize.X * x,
						halfSize.Y * y,
						halfSize.Z * z
					))
				)
			end
		end
	end
end

local function includeInstanceBounds(bounds, seen, instance)
	if not (instance and instance.Parent) then
		return
	end
	if instance:IsA("BasePart") then
		if not seen[instance] then
			seen[instance] = true
			includePartBounds(bounds, instance)
		end
		return
	end
	if instance:IsA("Model") then
		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") and not seen[descendant] then
				seen[descendant] = true
				includePartBounds(bounds, descendant)
			end
		end
	end
end

local function makeDescriptors(parts, groups)
	table.sort(parts, function(a, b)
		return a:GetFullName() &lt; b:GetFullName()
	end)
	local descriptors = {}
	local truncated = #parts &gt; MAX_CAPTURE_PARTS
	for index = 1, math.min(#parts, MAX_CAPTURE_PARTS) do
		local part = parts[index]
		table.insert(descriptors, {
			instance = part,
			name = part.Name,
			path = part:GetFullName(),
			rigidGroup = groups and groups[part] or nil,
		})
	end
	return descriptors, truncated
end

function SceneCaptureScope.Collect(scope, rig, selection)
	if scope == SceneCaptureScope.RIG_ONLY then
		return {}, false
	end

	local parts = {}
	local seen = {}
	local groups = {}
	if scope == SceneCaptureScope.ENTIRE_SCENE then
		for _, descendant in ipairs(workspace:GetDescendants()) do
			if descendant:IsA("BasePart") then
				addPart(parts, seen, descendant, rig)
			end
		end
	else
		for _, selected in ipairs(selection or {}) do
			if selected ~= rig and not (rig and selected:IsDescendantOf(rig)) then
				addSelection(parts, seen, groups, selected, rig)
			end
		end
	end

	return makeDescriptors(parts, groups)
end

function SceneCaptureScope.FilterUnanchored(descriptors)
	local filtered = {}
	local excluded = 0
	for _, descriptor in ipairs(descriptors or {}) do
		local part = descriptor.instance or descriptor.part
		if part and part.Parent and part:IsA("BasePart") and not part.Anchored then
			table.insert(filtered, descriptor)
		else
			excluded += 1
		end
	end
	return filtered, excluded
end

function SceneCaptureScope.GetInstanceCenter(instance)
	local bounds = {}
	includeInstanceBounds(bounds, {}, instance)
	if bounds.minimum and bounds.maximum then
		return (bounds.minimum + bounds.maximum) * 0.5
	end
	if instance and instance.Parent and instance:IsA("Model") then
		return instance:GetPivot().Position
	end
	return nil
end

function SceneCaptureScope.GetDescriptorsBounds(descriptors)
	local bounds = {}
	local seen = {}
	for _, descriptor in ipairs(descriptors or {}) do
		includeInstanceBounds(bounds, seen, descriptor.instance or descriptor.part)
	end
	return bounds.minimum, bounds.maximum
end

function SceneCaptureScope.GetDescriptorsCenter(descriptors)
	local minimum, maximum = SceneCaptureScope.GetDescriptorsBounds(descriptors)
	return minimum and maximum and (minimum + maximum) * 0.5 or nil
end

function SceneCaptureScope.PrepareRuntimeIds(descriptors)
	local groupIds = {}
	for _, descriptor in ipairs(descriptors or {}) do
		local instance = descriptor.instance
		if instance and instance.Parent then
			descriptor.id = HttpService:GenerateGUID(false)
			instance:SetAttribute(CAPTURE_ATTRIBUTE, descriptor.id)
		end
		local group = descriptor.rigidGroup
		if group and group.Parent and group:IsA("Model") then
			local groupId = groupIds[group]
			if not groupId then
				groupId = HttpService:GenerateGUID(false)
				groupIds[group] = groupId
				group:SetAttribute(RIGID_GROUP_ATTRIBUTE, groupId)
			end
			descriptor.rigidGroupId = groupId
		end
	end
end

function SceneCaptureScope.ClearRuntimeIds(descriptors, retainIds)
	local clearedGroups = {}
	for _, descriptor in ipairs(descriptors or {}) do
		local instance = descriptor.instance
		if instance and instance.Parent and descriptor.id and instance:GetAttribute(CAPTURE_ATTRIBUTE) == descriptor.id then
			instance:SetAttribute(CAPTURE_ATTRIBUTE, nil)
		end
		if not retainIds then
			descriptor.id = nil
		end
		local group = descriptor.rigidGroup
		local groupId = descriptor.rigidGroupId
		if group and group.Parent and groupId and not clearedGroups[group] then
			clearedGroups[group] = true
			if group:GetAttribute(RIGID_GROUP_ATTRIBUTE) == groupId then
				group:SetAttribute(RIGID_GROUP_ATTRIBUTE, nil)
			end
		end
		if not retainIds then
			descriptor.rigidGroupId = nil
		end
	end
end

function SceneCaptureScope.HasSupportedRagdollRig(descriptors)
	local checked = {}
	for _, descriptor in ipairs(descriptors or {}) do
		local current = descriptor.instance or descriptor.part
		while current and current ~= workspace do
			if current:IsA("Model") and not checked[current] then
				checked[current] = true
				if PhysicsRigFilter.IsSupportedRagdollRig(current) then
					return true
				end
			end
			current = current.Parent
		end
	end
	return false
end

function SceneCaptureScope.FindRuntimeTargets(descriptors)
	local wanted = {}
	for _, descriptor in ipairs(descriptors or {}) do
		if descriptor.id then
			wanted[descriptor.id] = descriptor
		end
	end

	local found = {}
	if next(wanted) == nil then
		return found
	end
	local runtimeGroups = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") then
			local groupId = descendant:GetAttribute(RIGID_GROUP_ATTRIBUTE)
			if groupId then
				runtimeGroups[groupId] = descendant
			end
		end
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local id = descendant:GetAttribute(CAPTURE_ATTRIBUTE)
			local descriptor = id and wanted[id] or nil
			if descriptor then
				table.insert(found, {
					id = id,
					name = descriptor.name,
					part = descendant,
					groupId = descriptor.rigidGroupId,
					group = descriptor.rigidGroupId and runtimeGroups[descriptor.rigidGroupId] or nil,
				})
			end
		end
	end
	return found
end

return SceneCaptureScope
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX41">
            <Properties>
              <string name="Name">TakeBaker</string>
              <ProtectedString name="Source">local TakeBaker = {}

local POSITION_THRESHOLD = 0.015
local ANGLE_THRESHOLD = math.rad(0.8)
local MAX_KEY_INTERVAL = 0.1
local OUTPUT_FOLDER_NAME = "MegMoPhysicsCaptures"
local CLIP_NAME_ATTRIBUTE = "MegMoPhysicsClipName"
local PhysicsRigFilter = require(script.Parent:WaitForChild("PhysicsRigFilter"))

local function getClipName(take)
	if take and take.releaseToPhysics then
		return "Release Physics Clip"
	end
	if take and take.adaptiveWalk then
		return "Adaptive Walk Clip"
	end
	if take and take.physicsDrive then
		return "Physics Drive Clip"
	end
	local markers = take and take.physicsMarkers or {}
	if markers.impactTime ~= nil then
		return "Impact Clip"
	end
	if markers.ragdollTime ~= nil then
		return "Ragdoll Clip"
	end
	return "Physics Clip"
end

local function rotationDifference(a, b)
	local relative = (a - a.Position):ToObjectSpace(b - b.Position)
	local _, angle = relative:ToAxisAngle()
	return math.abs(angle)
end

local function sampleChanged(previous, current)
	if not previous then
		return true
	end
	for name, currentCFrame in pairs(current.parts) do
		local previousCFrame = previous.parts[name]
		if not previousCFrame
			or (currentCFrame.Position - previousCFrame.Position).Magnitude &gt;= POSITION_THRESHOLD
			or rotationDifference(previousCFrame, currentCFrame) &gt;= ANGLE_THRESHOLD then
			return true
		end
	end
	return false
end

local function cframeChanged(previous, current)
	return not previous
		or not current
		or (current.Position - previous.Position).Magnitude &gt;= POSITION_THRESHOLD
		or rotationDifference(previous, current) &gt;= ANGLE_THRESHOLD
end

local function chooseObjectSamples(take, captureId)
	local raw = {}
	for _, sample in ipairs(take.samples or {}) do
		local value = sample.objects and sample.objects[captureId]
		if typeof(value) == "CFrame" then
			table.insert(raw, {
				time = sample.time,
				value = value,
			})
		end
	end
	if #raw &lt; 2 then
		return nil
	end

	local moved = false
	for index = 2, #raw do
		if cframeChanged(raw[index - 1].value, raw[index].value) then
			moved = true
			break
		end
	end
	if not moved then
		return nil
	end

	-- The Physics Drive preview uses every recorded sample. Keep the same samples
	-- for its moving object so 7kg2 playback follows ramps and impacts exactly,
	-- while excluding any stationary recording time after the authored path ends.
	if take.physicsDrive and captureId == take.physicsDriverId then
		local chosen = {}
		local pathDuration = tonumber(take.physicsPathDuration) or math.huge
		local frameTolerance = 1 / math.max(1, tonumber(take.fps) or 30)
		for _, sample in ipairs(raw) do
			if sample.time &lt;= pathDuration + frameTolerance then
				table.insert(chosen, sample)
			else
				break
			end
		end
		return #chosen &gt;= 2 and chosen or nil
	end

	local chosen = { raw[1] }
	local lastKept = raw[1]
	local wasMoving = false
	for index = 2, #raw do
		local previous = raw[index - 1]
		local current = raw[index]
		local moving = cframeChanged(previous.value, current.value)
		if moving and not wasMoving and lastKept.time ~= previous.time then
			table.insert(chosen, previous)
			lastKept = previous
		end
		if moving and (current.time - lastKept.time &gt;= MAX_KEY_INTERVAL or index == #raw) then
			table.insert(chosen, current)
			lastKept = current
		elseif wasMoving and not moving and lastKept.time ~= previous.time then
			table.insert(chosen, previous)
			lastKept = previous
		end
		wasMoving = moving
	end
	local final = raw[#raw]
	if lastKept.time ~= final.time then
		table.insert(chosen, final)
	end
	return chosen
end

local function chooseRigPartSamples(take, partName)
	local raw = {}
	for _, sample in ipairs(take.samples or {}) do
		local value = sample.parts and sample.parts[partName]
		if typeof(value) == "CFrame" then
			raw[#raw + 1] = {
				time = sample.time,
				value = value,
			}
		end
	end
	if #raw &lt; 2 then
		return nil, raw
	end

	local chosen = { raw[1] }
	local lastKept = raw[1]
	local wasMoving = false
	for index = 2, #raw do
		local previous = raw[index - 1]
		local current = raw[index]
		local moving = cframeChanged(previous.value, current.value)
		if moving and not wasMoving and lastKept.time ~= previous.time then
			chosen[#chosen + 1] = previous
			lastKept = previous
		end
		if moving and (current.time - lastKept.time &gt;= MAX_KEY_INTERVAL or index == #raw) then
			chosen[#chosen + 1] = current
			lastKept = current
		elseif wasMoving and not moving and lastKept.time ~= previous.time then
			chosen[#chosen + 1] = previous
			lastKept = previous
		end
		wasMoving = moving
	end
	local final = raw[#raw]
	if lastKept.time ~= final.time then
		chosen[#chosen + 1] = final
	end
	return chosen, raw
end

local function chooseSamples(take)
	local chosen = {}
	local lastKept = nil
	for index, sample in ipairs(take.samples or {}) do
		local isLast = index == #take.samples
		if not lastKept
			or isLast
			or sample.time - lastKept.time &gt;= MAX_KEY_INTERVAL
			or sampleChanged(lastKept, sample) then
			table.insert(chosen, sample)
			lastKept = sample
		end
	end
	return chosen
end

local function calculateTransform(joint, sample)
	local part0 = sample.parts[joint.part0]
	local part1 = sample.parts[joint.part1]
	if not (part0 and part1) then
		return CFrame.identity
	end
	return joint.c0:Inverse() * part0:Inverse() * part1 * joint.c1
end

local function createKeyframe(take, sample, initialRoot)
	local keyframe = Instance.new("Keyframe")
	keyframe.Name = string.format("Physics_%05d", math.floor(sample.time * take.fps + 0.5))
	keyframe.Time = sample.time

	local rootPose = Instance.new("Pose")
	rootPose.Name = take.rootName
	local rootCFrame = sample.parts[take.rootName]
	rootPose.CFrame = rootCFrame and initialRoot:ToObjectSpace(rootCFrame) or CFrame.identity
	rootPose.Parent = keyframe
	if rootCFrame then
		keyframe:SetAttribute("MegMoRootCFrame", rootCFrame)
	end

	local poses = {
		[take.rootName] = rootPose,
	}
	for _, joint in ipairs(take.joints or {}) do
		if not poses[joint.part1] then
			local pose = Instance.new("Pose")
			pose.Name = joint.part1
			pose.CFrame = calculateTransform(joint, sample)
			poses[joint.part1] = pose
		end
	end
	for _, joint in ipairs(take.joints or {}) do
		local pose = poses[joint.part1]
		local parentPose = poses[joint.part0] or rootPose
		if pose and pose ~= parentPose and not pose.Parent then
			pose.Parent = parentPose
		end
	end
	for _, pose in pairs(poses) do
		if pose ~= rootPose and not pose.Parent then
			pose.Parent = rootPose
		end
	end
	return keyframe
end

function TakeBaker.CreateSequence(take)
	if not (take and take.samples and #take.samples &gt;= 2) then
		return nil, "Capture at least two physics samples before baking."
	end
	local firstSample = take.samples[1]
	local initialRoot = firstSample.parts[take.rootName]
	if not initialRoot then
		return nil, "The captured take does not contain its root part."
	end

	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = string.format("%s_PhysicsTake_%s", take.rigName, os.date("%H%M%S"))
	sequence.Loop = false
	sequence.Priority = Enum.AnimationPriority.Action
	sequence:SetAttribute("MegMoPhysicsCapture", true)
	sequence:SetAttribute(CLIP_NAME_ATTRIBUTE, getClipName(take))
	sequence:SetAttribute("CaptureFPS", take.fps)
	sequence:SetAttribute("CaptureDuration", take.duration)
	local markers = take.physicsMarkers or {}
	sequence:SetAttribute("PhysicsStartFrame", markers.startFrame)
	sequence:SetAttribute("PhysicsImpactTime", markers.impactTime)
	sequence:SetAttribute("PhysicsRagdollTime", markers.ragdollTime)
	sequence:SetAttribute("PhysicsEndTime", markers.endTime)

	local chosen = chooseSamples(take)
	for _, sample in ipairs(chosen) do
		sequence:AddKeyframe(createKeyframe(take, sample, initialRoot))
	end
	return sequence, nil, #chosen
end

function TakeBaker.CreateObjectCapture(take, editTargets)
	local entries = {}
	local keyCount = 0
	for _, descriptor in ipairs(editTargets or {}) do
		local instance = descriptor.instance
		local samples = descriptor.id and chooseObjectSamples(take, descriptor.id) or nil
		if instance and instance.Parent and samples then
			local runtimeSamples = {}
			for _, sample in ipairs(take.samples or {}) do
				local value = sample.objects and sample.objects[descriptor.id]
				if typeof(value) == "CFrame" then
					runtimeSamples[#runtimeSamples + 1] = {
						time = sample.time,
						value = value,
					}
				end
			end
			table.insert(entries, {
				instance = instance,
				name = descriptor.name or instance.Name,
				path = descriptor.path,
				samples = samples,
				runtimeSamples = #runtimeSamples &gt;= 2 and runtimeSamples or nil,
				clipName = getClipName(take),
			})
			keyCount += #samples
		end
	end
	return entries, keyCount
end

function TakeBaker.CreateMultiRigObjectCapture(takes, rigs)
	local entries = {}
	for rigIndex, take in ipairs(takes or {}) do
		local rig = rigs and rigs[rigIndex]
		if rig and rig.Parent then
			local partsByName = {}
			for _, descendant in ipairs(rig:GetDescendants()) do
				if descendant:IsA("BasePart") and not PhysicsRigFilter.IsAccessoryPart(descendant, rig) then
					partsByName[descendant.Name] = partsByName[descendant.Name] or descendant
				end
			end
			for partName in pairs((take.samples and take.samples[1] and take.samples[1].parts) or {}) do
				local part = partsByName[partName]
				local samples, runtimeSamples = chooseRigPartSamples(take, partName)
				if part and samples and #samples &gt;= 2 and #runtimeSamples &gt;= 2 then
					entries[#entries + 1] = {
						instance = part,
						name = string.format("Ragdoll %d / %s", rigIndex, partName),
						path = part:GetFullName(),
						samples = samples,
						runtimeSamples = runtimeSamples,
						clipName = getClipName(take),
					}
				end
			end
		end
	end
	return entries
end

function TakeBaker.Bake(take)
	local sequence, message, keyCount = TakeBaker.CreateSequence(take)
	if not sequence then
		return nil, message
	end

	local folder = workspace:FindFirstChild(OUTPUT_FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = OUTPUT_FOLDER_NAME
		folder.Parent = workspace
	end
	sequence.Parent = folder
	return sequence, nil, keyCount
end

return TakeBaker
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX42">
            <Properties>
              <string name="Name">TakePreviewRuntime</string>
              <ProtectedString name="Source">local TakePreviewRuntime = {}

local PhysicsRigFilter = require(script.Parent:WaitForChild("PhysicsRigFilter"))

local function resolveDescriptorTarget(descriptor)
	local target = descriptor and descriptor.instance
	if target and target.Parent then
		return target
	end
	local path = descriptor and descriptor.path
	if type(path) ~= "string" or path == "" then
		return nil
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if (descendant:IsA("BasePart") or descendant:IsA("Model")) and descendant:GetFullName() == path then
			descriptor.instance = descendant
			return descendant
		end
	end
	return nil
end

local function getParts(target)
	if target:IsA("BasePart") then
		return { target }
	end
	local parts = {}
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function suspendMegMoAttachments(session)
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Motor6D")
			and descendant.Enabled
			and descendant:GetAttribute("MegMoAttachment") == true then
			local part0IsObject = session.objectParts[descendant.Part0] == true
			local part1IsObject = session.objectParts[descendant.Part1] == true
			if part0IsObject ~= part1IsObject then
				table.insert(session.suspendedAttachments, {
					motor = descendant,
					enabled = descendant.Enabled,
				})
				descendant.Enabled = false
			end
		end
	end
end

local function restoreSuspendedAttachments(session)
	for _, item in ipairs(session.suspendedAttachments or {}) do
		if item.motor and item.motor.Parent then
			item.motor.Enabled = item.enabled
		end
	end
	session.suspendedAttachments = {}
end

local function addTarget(session, key, target, rootName)
	if not (target and target.Parent and (target:IsA("BasePart") or target:IsA("Model"))) or session.seen[target] then
		return
	end
	local parts = getParts(target)
	if #parts == 0 then
		return
	end
	session.seen[target] = true
	session.targets[key] = target
	local objectRoot = nil
	if target:IsA("Model") and type(rootName) == "string" and rootName ~= "" then
		local root = target:FindFirstChild(rootName, true)
		if root and root:IsA("BasePart") then
			objectRoot = root
			session.objectRoots[key] = root
		end
	end
	table.insert(session.originals, {
		key = key,
		target = target,
		cframe = target:IsA("Model") and target:GetPivot() or target.CFrame,
		root = objectRoot,
		rootCFrame = objectRoot and objectRoot.CFrame or nil,
		parts = parts,
		anchored = table.create(#parts),
		partCFrames = table.create(#parts),
	})
	local original = session.originals[#session.originals]
	for index, part in ipairs(parts) do
		original.anchored[index] = part.Anchored
		original.partCFrames[index] = part.CFrame
		part.Anchored = true
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
end

local function setTargetCFrame(target, cframe)
	if target:IsA("Model") then
		target:PivotTo(cframe)
	else
		target.CFrame = cframe
	end
end

local function collectTargets(session, rig, descriptors)
	if rig and rig.Parent then
		for _, descendant in ipairs(rig:GetDescendants()) do
			if descendant:IsA("BasePart") and not PhysicsRigFilter.IsAccessoryPart(descendant, rig) then
				addTarget(session, "rig:" .. descendant.Name, descendant)
			end
		end
	end
	for _, descriptor in ipairs(descriptors or {}) do
		if descriptor.id then
			local target = resolveDescriptorTarget(descriptor)
			addTarget(
				session,
				"object:" .. descriptor.id,
				target,
				session.take.objectRootNames and session.take.objectRootNames[descriptor.id]
			)
			if target and target.Parent and (target:IsA("BasePart") or target:IsA("Model")) then
				for _, part in ipairs(getParts(target)) do
					session.objectParts[part] = true
				end
			end
		end
	end
end

local function syncModelWorldPivot(target, capturedTargetCFrame)
	if not (target and target:IsA("Model") and target.PrimaryPart == nil and typeof(capturedTargetCFrame) == "CFrame") then
		return
	end
	-- Physics can move every part in a model without advancing WorldPivot. Keep
	-- that metadata beside the captured assembly so 7kg2's model gizmo follows it.
	pcall(function()
		target.WorldPivot = capturedTargetCFrame
	end)
end

local function setModelFromCapturedRoot(target, root, capturedRootCFrame, capturedTargetCFrame)
	if not (target and target.Parent and root and root.Parent and typeof(capturedRootCFrame) == "CFrame") then
		return false
	end
	local worldDelta = capturedRootCFrame * root.CFrame:Inverse()
	target:PivotTo(worldDelta * target:GetPivot())
	syncModelWorldPivot(target, capturedTargetCFrame)
	return true
end

local function countMatchedCapturedTargets(session, samples)
	local matched = {}
	for _, sample in ipairs(samples) do
		for name in pairs(sample.parts or {}) do
			local key = "rig:" .. name
			if session.targets[key] then
				matched[key] = true
			end
		end
		for id in pairs(sample.objects or {}) do
			local key = "object:" .. id
			if session.targets[key] then
				matched[key] = true
			end
		end
	end
	local count = 0
	for _ in pairs(matched) do
		count += 1
	end
	return count
end

local function applySample(session, first, second, alpha)
	for name, firstCFrame in pairs(first.parts or {}) do
		local part = session.targets["rig:" .. name]
		local secondCFrame = second.parts and second.parts[name]
		if part and part.Parent and typeof(firstCFrame) == "CFrame" then
			part.CFrame = typeof(secondCFrame) == "CFrame" and firstCFrame:Lerp(secondCFrame, alpha) or firstCFrame
		end
	end
	for id, firstCFrame in pairs(first.objects or {}) do
		local key = "object:" .. id
		local part = session.targets[key]
		local secondCFrame = second.objects and second.objects[id]
		if part and part.Parent and typeof(firstCFrame) == "CFrame" then
			local capturedTargetCFrame = typeof(secondCFrame) == "CFrame"
				and firstCFrame:Lerp(secondCFrame, alpha)
				or firstCFrame
			local firstRootCFrame = first.objectRoots and first.objectRoots[id]
			local secondRootCFrame = second.objectRoots and second.objectRoots[id]
			local capturedRootCFrame = typeof(firstRootCFrame) == "CFrame"
				and (typeof(secondRootCFrame) == "CFrame" and firstRootCFrame:Lerp(secondRootCFrame, alpha) or firstRootCFrame)
				or nil
			if not setModelFromCapturedRoot(part, session.objectRoots[key], capturedRootCFrame, capturedTargetCFrame) then
				setTargetCFrame(part, capturedTargetCFrame)
			end
		end
	end
end

local function firePendingEvents(session)
	while session.nextEventIndex &lt;= #session.events do
		local event = session.events[session.nextEventIndex]
		if math.max(0, tonumber(event and event.time) or 0) &gt; session.time then
			break
		end
		session.nextEventIndex += 1
		if type(session.onEvent) == "function" then
			pcall(session.onEvent, event)
		end
	end
end

function TakePreviewRuntime.Stop(session, restore, preserveKey)
	if not session or session.stopped then
		return
	end
	session.stopped = true
	if session.multiSessions then
		for _, childSession in ipairs(session.multiSessions) do
			TakePreviewRuntime.Stop(childSession, restore, preserveKey)
		end
		return
	end
	if session.connection then
		session.connection:Disconnect()
		session.connection = nil
	end
	if restore ~= false then
		for _, original in ipairs(session.originals) do
			for _, part in ipairs(original.parts or {}) do
				if part and part.Parent then
					part.Anchored = true
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end
		for _, original in ipairs(session.originals) do
			if original.key ~= preserveKey and original.target and original.target.Parent then
				local restoredPart = false
				for index, part in ipairs(original.parts or {}) do
					local originalCFrame = original.partCFrames and original.partCFrames[index]
					if part and part.Parent and typeof(originalCFrame) == "CFrame" then
						part.CFrame = originalCFrame
						restoredPart = true
					end
				end
				if not restoredPart then
					if not setModelFromCapturedRoot(original.target, original.root, original.rootCFrame, original.cframe) then
						setTargetCFrame(original.target, original.cframe)
					end
				elseif original.target:IsA("Model") and original.target.PrimaryPart == nil then
					pcall(function()
						original.target.WorldPivot = original.cframe
					end)
				end
			end
		end
		restoreSuspendedAttachments(session)
		for _, original in ipairs(session.originals) do
			for index, part in ipairs(original.parts or {}) do
				if part and part.Parent then
					part.Anchored = original.anchored[index]
				end
			end
		end
	else
		restoreSuspendedAttachments(session)
	end
end

function TakePreviewRuntime.Start(take, rig, descriptors, onComplete, playbackSpeed, options)
	if not (take and type(take.samples) == "table" and #take.samples &gt;= 2) then
		return nil, "Capture a physics take before previewing it."
	end
	options = type(options) == "table" and options or {}
	local session = {
		take = take,
		time = 0,
		index = 1,
		targets = {},
		originals = {},
		seen = {},
		objectRoots = {},
		objectParts = {},
		suspendedAttachments = {},
		stopped = false,
		playbackSpeed = math.clamp(tonumber(playbackSpeed) or 1, 0.1, 4),
		events = type(options.events) == "table" and options.events or {},
		nextEventIndex = 1,
		onEvent = options.onEvent,
		live = options.live == true,
		isLiveComplete = options.isLiveComplete,
		restoreOnComplete = options.restoreOnComplete ~= false,
	}
	collectTargets(session, rig, descriptors)
	if #session.originals == 0 then
		return nil, "The captured objects are no longer available in the Workspace."
	end

	local samples = take.samples
	if countMatchedCapturedTargets(session, samples) == 0 then
		TakePreviewRuntime.Stop(session, true)
		return nil, "The captured take could not be matched to its original Workspace objects."
	end
	if options.suspendMegMoAttachments == true then
		suspendMegMoAttachments(session)
	end
	for key, root in pairs(session.objectRoots) do
		print(string.format("[7kg2 Physics Preview] %s aligned by root %s", key, root:GetFullName()))
	end
	applySample(session, samples[1], samples[1], 0)
	firePendingEvents(session)
	task.spawn(function()
		local previousClock = os.clock()
		while not session.stopped do
			task.wait()
			local currentClock = os.clock()
			local requestedTime = session.time
				+ math.max(0, currentClock - previousClock) * session.playbackSpeed
			previousClock = currentClock
			local availableSample = samples[#samples]
			local availableTime = math.max(0, tonumber(availableSample and availableSample.time) or 0)
			-- A live preview may consume a recorder take while new physics samples
			-- are still being appended. Never run beyond the newest sample; slower
			-- previews naturally let the real-time recorder build a safe lead.
			session.time = session.live and math.min(requestedTime, availableTime) or requestedTime
			while session.index &lt; #samples - 1 and samples[session.index + 1].time &lt;= session.time do
				session.index += 1
			end
			local first = samples[session.index]
			local second = samples[math.min(session.index + 1, #samples)]
			local span = math.max(0.0001, (second.time or 0) - (first.time or 0))
			local alpha = math.clamp((session.time - (first.time or 0)) / span, 0, 1)
			applySample(session, first, second, alpha)
			firePendingEvents(session)
			local liveComplete = not session.live
				or type(session.isLiveComplete) ~= "function"
				or session.isLiveComplete() == true
			local finalDuration = math.max(
				tonumber(take.duration) or 0,
				tonumber(samples[#samples] and samples[#samples].time) or 0
			)
			if liveComplete and session.time &gt;= finalDuration then
				-- Restore every preview target before handing the endpoint back to
				-- 7kg2. Leaving the physics driver behind made the captured assembly
				-- and the timeline gizmo compete as two different pose authorities.
				TakePreviewRuntime.Stop(session, session.restoreOnComplete)
				if onComplete then
					task.defer(onComplete)
				end
			end
		end
	end)
	return session, nil
end

function TakePreviewRuntime.StartMany(items, descriptors, onComplete, playbackSpeed, options)
	if type(items) ~= "table" or #items == 0 then
		return nil, "Capture at least one ragdoll take before previewing it."
	end
	local wrapper = {
		multiSessions = {},
		remaining = #items,
		stopped = false,
	}
	for index, item in ipairs(items) do
		local childOptions = options
		if index &gt; 1 and type(options) == "table" then
			childOptions = table.clone(options)
			childOptions.events = nil
			childOptions.onEvent = nil
		end
		local childSession, message = TakePreviewRuntime.Start(
			item.take,
			item.rig,
			index == 1 and descriptors or {},
			function()
				if wrapper.stopped then
					return
				end
				wrapper.remaining -= 1
				if wrapper.remaining &lt;= 0 then
					wrapper.stopped = true
					if onComplete then
						task.defer(onComplete)
					end
				end
			end,
			playbackSpeed,
			childOptions
		)
		if not childSession then
			TakePreviewRuntime.Stop(wrapper, true)
			return nil, string.format("Could not preview %s: %s", tostring(item.rigName or item.rig and item.rig.Name or index), tostring(message))
		end
		table.insert(wrapper.multiSessions, childSession)
	end
	return wrapper, nil
end

return TakePreviewRuntime
