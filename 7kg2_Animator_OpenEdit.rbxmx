		if microShiftSelection then
			microShiftSelection:start()
		end

		local function connectMicroUi(signal, callback)
			local connection = signal:Connect(callback)
			table.insert(microUiConnections, connection)
			return connection
		end
		connectMicroUi(panel:GetPropertyChangedSignal("Position"), function()
			if type(updateRadialDockPlacement) == "function" then
				updateRadialDockPlacement()
			end
		end)
		connectMicroUi(panel:GetPropertyChangedSignal("Size"), function()
			if type(updateRadialDockPlacement) == "function" then
				updateRadialDockPlacement()
			end
		end)
		connectMicroUi(RunService.RenderStepped, function()
			if microActive and gui and gui.Enabled and type(updateRadialDockPlacement) == "function" then
				updateRadialDockPlacement()
			end
			if microActive
				and gui
				and gui.Enabled
				and isMicroPlaybackActive(options)
				and type(microUiHost._updatePlayheadVisual) == "function" then
				local currentTimeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
				microUiHost._updatePlayheadVisual(currentTimeline, getMicroDisplayFrame(currentTimeline, options))
			end
			MicroWidgetController._pollMicroControlShortcuts(options, plugin, gui, microActive, statusLabel, refresh, options._triggerMicroSelectedOptions)
		end)
		if not microUiHost._pluginDeactivationConnection then
			pcall(function()
				local deactivationSignal = plugin.Deactivation
				if deactivationSignal and deactivationSignal.Connect then
					microUiHost._pluginDeactivationConnection = deactivationSignal:Connect(function()
						if microActive and gui and gui.Enabled and options._microShortcutArmed == true then
							if options._microViewportCameraNavigationActive == true
								or os.clock() &lt;= (tonumber(options._microViewportCameraNavigationUntil) or 0) then
								options._microViewportOutsideReleaseToken = nil
								return
							end
							if type(options.onIsViewportGizmoDragActive) == "function"
								and options.onIsViewportGizmoDragActive() == true then
								options._microViewportOutsideReleaseToken = nil
								if type(options.onKeepViewportGizmoOwnership) == "function" then
									pcall(options.onKeepViewportGizmoOwnership)
								end
								return
							end
							if type(options.onIsViewportGizmoPointerOverHandle) == "function"
								and options.onIsViewportGizmoPointerOverHandle() == true then
								options._microViewportOutsideReleaseToken = nil
								if type(options.onKeepViewportGizmoOwnership) == "function" then
									pcall(options.onKeepViewportGizmoOwnership)
								end
								return
							end
							MicroWidgetController._releaseMicroTimelineOwnership(
								options,
								statusLabel,
								"Studio viewport controls active: click Micro to resume timeline shortcuts.",
								true
							)
						end
					end)
				end
			end)
		end

		function microUiHost:_connect(signal, callback)
			return connectMicroUi(signal, callback)
		end

		function microUiHost:_setShortcutHint(text)
			if statusLabel then
				statusLabel.Text = tostring(text or "")
			end
		end

		function microUiHost:_focusShortcutCapture(message)
			if message and statusLabel then
				statusLabel.Text = tostring(message)
			end
		end

		function microUiHost:_getTrackViewModel(path)
			local viewModel = self._lastViewModel or {}
			for _, track in ipairs(viewModel.tracks or {}) do
				if track.path == path then
					return track
				end
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if timeline and type(timeline.getTrackByPath) == "function" then
				return timeline:getTrackByPath(path)
			end
			return nil
		end

		local function applyMountedRefs(target, refs)
			for key, value in pairs(refs or {}) do
				target[key] = value
			end
		end

		local function mountMicroEditorUi(moduleName)
			local moduleScript = script.Parent:FindFirstChild(moduleName)
			if not moduleScript then
				return
			end
			local requireOk, uiModule = pcall(require, moduleScript)
			if not requireOk or type(uiModule.mount) ~= "function" then
				return
			end
			local mountOk, refs = pcall(uiModule.mount, gui, {})
			if mountOk then
				applyMountedRefs(microUiHost, refs or {})
			end
		end

		mountMicroEditorUi("OverlaysUI")
		if microUiHost._rigPropertyEditorOverlay then
			require(script.Parent.Parent:WaitForChild("ModalOverlaySupport")).applyToOverlay(microUiHost._rigPropertyEditorOverlay)
		end
		mountMicroEditorUi("ParticleKeyframeEditorUI")
		mountMicroEditorUi("PropertyKeyframeEditorUI")
		mountMicroEditorUi("SoundKeyframeEditorUI")
		MicroCameraTrackEditorSupport.mount(microUiHost, gui, options)

		ParticleKeyframeEditorController.connect(microUiHost, {
			onSetParticleEmitterPropertyKey = options and options.onSetParticleEmitterPropertyKey,
			onSetEasingStyle = options and options.onSetEasingStyle,
			onSetEasingDirection = options and options.onSetEasingDirection,
		})
		PropertyKeyframeEditorController.connect(microUiHost, {
			getTimeline = options and options.getTimeline,
			onSetPropertyKeyframeValue = options and options.onSetPropertyKeyframeValue,
			onPreviewPropertyKeyframeValue = options and options.onPreviewPropertyKeyframeValue,
			onCancelPropertyKeyframePreview = options and options.onCancelPropertyKeyframePreview,
			onSetEasingStyle = options and options.onSetEasingStyle,
			onSetEasingDirection = options and options.onSetEasingDirection,
		})
		SoundKeyframeEditorController.connect(microUiHost, {
			getTimeline = options and options.getTimeline,
			onSetSoundKeyframeValue = options and options.onSetSoundKeyframeValue,
			onPreviewSoundKeyframeValue = options and options.onPreviewSoundKeyframeValue,
			onCancelSoundKeyframePreview = options and options.onCancelSoundKeyframePreview,
			onSetSoundClipEndFrame = function(...)
				return runOption(options, "onSetSoundClipEndFrame", "setSoundClipEndFrame", ...)
			end,
			onSetEasingStyle = options and options.onSetEasingStyle,
			onSetEasingDirection = options and options.onSetEasingDirection,
		})
		ScreenEffectKeyframeEditorController.connect(microUiHost, {
			getTimeline = options and options.getTimeline,
			onSetScreenEffectKeyValue = options and options.onSetScreenEffectKeyValue,
			onPreviewScreenEffectKeyValue = options and options.onPreviewScreenEffectKeyValue,
			onCancelScreenEffectKeyPreview = options and options.onCancelScreenEffectKeyPreview,
			onSetLightingEffectKeyValue = options and options.onSetLightingEffectKeyValue,
			onPreviewLightingEffectKeyValue = options and options.onPreviewLightingEffectKeyValue,
			onCancelLightingEffectKeyPreview = options and options.onCancelLightingEffectKeyPreview,
			onSetEasingStyle = options and options.onSetEasingStyle,
			onSetEasingDirection = options and options.onSetEasingDirection,
		})
		options.onOpenEffectTrackEditor = function(trackPath)
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("keyframeEditor")
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			microUiHost._lastViewModel = buildMicroEditorViewModel(timeline)
			local activeFrame = nil
			for _, key in ipairs((microUiHost._lastViewModel and microUiHost._lastViewModel.selectedKeyValues) or {}) do
				if key.jointPath == trackPath then
					activeFrame = key.frame
					break
				end
			end
			ScreenEffectKeyframeEditorController.show(microUiHost, trackPath, activeFrame)
		end

		local miniTimelineSignature = nil

		local function microHideRigPropertyEditor()
			if microUiHost._rigPropertyEditorOverlay then
				microUiHost._rigPropertyEditorOverlay.Visible = false
			end
			microUiHost._activeRigPropertyTrackPath = nil
			microUiHost._activeRigPropertyMenuRigName = nil
		end

		local function microRenderRigPropertyEditor()
			local groupOptions = require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport"))
			local rigPropertyCallbacks = setmetatable({}, {
				__index = options,
			})
			local function resolveRigPropertyGroupIds(groupIds)
				local resolvedIds = groupOptions.getSelectedGroupIdsFromViewModel(
					microUiHost._lastViewModel or {},
					type(groupIds) == "table" and groupIds or (microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds)
				)
				if #resolvedIds &gt; 0 then
					microUiHost._selectedMicroGroupIds = resolvedIds
					options._microSelectedGroupIds = resolvedIds
				end
				return resolvedIds
			end
			rigPropertyCallbacks.onGroupKeys = function()
				local success, message, groupId = runOption(options, "onGroupKeys", "groupSelectedKeys")
				if success and groupId ~= nil then
					microUiHost._selectedMicroGroupIds = { groupId }
					options._microSelectedGroupIds = { groupId }
				end
				return success, message, groupId
			end
			rigPropertyCallbacks.onUngroupKeys = function()
				microUiHost._selectedMicroGroupIds = nil
				options._microSelectedGroupIds = nil
				return runOption(options, "onUngroupKeys", "ungroupSelectedKeys")
			end
			rigPropertyCallbacks.onSetEasingStyle = function(easingStyle)
				local success, message = runOption(options, "onSetEasingStyle", "setSelectedEasingStyle", easingStyle)
				microUiHost._lastViewModel = buildMicroEditorViewModel(type(options.getTimeline) == "function" and options.getTimeline() or nil)
				miniTimelineSignature = nil
				task.defer(refresh)
				return success, message
			end
			rigPropertyCallbacks.onSetEasingDirection = function(easingDirection)
				local success, message = runOption(options, "onSetEasingDirection", "setSelectedEasingDirection", easingDirection)
				microUiHost._lastViewModel = buildMicroEditorViewModel(type(options.getTimeline) == "function" and options.getTimeline() or nil)
				miniTimelineSignature = nil
				task.defer(refresh)
				return success, message
			end
			rigPropertyCallbacks.onSetSelectedGroupEditMode = function(mode, groupIds)
				return runOption(options, "onSetSelectedGroupEditMode", "setSelectedGroupEditMode", mode, resolveRigPropertyGroupIds(groupIds))
			end
			return WidgetRigPropertyEditorSupport.renderRigPropertyEditor(microUiHost, microUiHost._lastViewModel or {}, {
				create = UiHelpers.create,
				createCorner = UiHelpers.createCorner,
				callbacks = rigPropertyCallbacks,
				rerender = microRenderRigPropertyEditor,
			})
		end

		microShowRigPropertyEditor = function(trackPath, rigName)
			if not microUiHost._rigPropertyEditorOverlay then
				return false, "Rig property editor unavailable."
			end
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("rigProperty")
			end
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			microUiHost._lastViewModel = buildMicroEditorViewModel(timeline)
			microUiHost._activeRigPropertyTrackPath = trackPath
			microUiHost._activeRigPropertyMenuRigName = rigName
			microRenderRigPropertyEditor()
			microUiHost._rigPropertyEditorOverlay.Visible = true
			return true, "Edit item open."
		end

		local function microClearTrackFolderChoices()
			if not microUiHost._trackActionsFolderList then
				return
			end
			for _, child in ipairs(microUiHost._trackActionsFolderList:GetChildren()) do
				if child:IsA("TextButton") or child:IsA("TextLabel") then
					child:Destroy()
				end
			end
		end

		local function microHideTrackActions()
			if microUiHost._trackActionsOverlay then
				microUiHost._trackActionsOverlay.Visible = false
			end
			microClearTrackFolderChoices()
			microUiHost._pendingTrackActionPath = nil
		end

		local function microCreateTrackActionChoice(labelText, backgroundColor, callback)
			local list = microUiHost._trackActionsFolderList
			if not list then
				return
			end
			local actionButton = make("TextButton", {
				Parent = list,
				AutoButtonColor = true,
				BackgroundColor3 = backgroundColor or theme().PanelSoft,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 28),
				Font = Enum.Font.Gotham,
				Text = tostring(labelText or "Action"),
				TextColor3 = ThemeService.getReadableTextColor(backgroundColor or theme().PanelSoft),
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 105,
			}, list)
			actionButton:SetAttribute("MegMoThemeBackgroundRole", backgroundColor and nil or "PanelSoft")
			actionButton:SetAttribute("MegMoThemeTextRole", "__auto")
			corner(actionButton, 7)
			make("UIPadding", {
				Parent = actionButton,
				PaddingLeft = UDim.new(0, 10),
			})
			actionButton.MouseButton1Click:Connect(function()
				if type(callback) == "function" then
					callback()
				end
			end)
		end

		local function microTrackSupportsEditor(track)
			return track
				and (isMicroFaceTrack(track)
					or track.trackType == "Screen Effect"
					or track.trackType == "Lighting Effect"
					or track.trackType == "Camera"
					or track.trackType == "Camera Property"
					or track.trackType == "Event"
					or track.valueType == "Event"
					or track.trackType == "Rig"
					or track.trackType == "Rig Group"
					or track.trackType == "Rig Property"
					or track.trackType == "Object"
					or track.trackType == "Model"
					or track.trackType == "Rig CFrame"
					or track.trackType == "Sound"
					or track.trackType == "Emitter Group"
					or track.trackType == "Emitter Group Property"
					or (track.trackType == "Object" and track.valueType == "Emitter")
					or (track.trackType == "Object Property" and track.parentTrackPath ~= nil)
					or ParticleKeyframeEditorController.isParticlePropertyTrack(track)
					or SoundKeyframeEditorController.isSoundTrack(track)
					or PropertyKeyframeEditorController.isEditablePropertyTrack(track))
		end

		local function getMicroSelectedTrackPathsForActions()
			if type(options.getSelectedTrackPaths) ~= "function" then
				return {}
			end
			local ok, paths = pcall(options.getSelectedTrackPaths)
			if not ok or type(paths) ~= "table" then
				return {}
			end
			return paths
		end

		local function setAllMicroTimelineFoldersCollapsed(collapsed)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			local folders = timeline and type(timeline.getTimelineFolders) == "function" and (timeline:getTimelineFolders() or {}) or {}
			for _, folder in ipairs(folders) do
				if folder and folder.path then
					microCollapsedTrackPaths[folder.path] = collapsed == true
				end
			end
			miniTimelineSignature = nil
			refresh()
		end

		local function microRenderTrackFolderChoices(track)
			local currentTimeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			local folders = currentTimeline and type(currentTimeline.getTimelineFolders) == "function" and (currentTimeline:getTimelineFolders() or {}) or {}
			microClearTrackFolderChoices()
			if not microUiHost._trackActionsFolderList or not track then
				return
			end

			local selectedPaths = getMicroSelectedTrackPathsForActions()
			local selectedPathSet = {}
			for _, path in ipairs(selectedPaths) do
				selectedPathSet[path] = true
			end
			local useSelectedTracks = #selectedPaths &gt; 1 and selectedPathSet[track.path] == true

			if track.targetScope == "TimelineFolder" or track.trackType == "Folder" then
				for _, option in ipairs(FOLDER_COLOR_OPTIONS) do
					local label = string.format("Color: %s", option.id)
					microCreateTrackActionChoice(label, option.color:Lerp(theme().Panel, 0.45), function()
						local trackPath = microUiHost._pendingTrackActionPath
						microHideTrackActions()
						if trackPath then
							runOption(options, "onSetTimelineFolderColor", "setTimelineFolderColor", trackPath, option.id)
							miniTimelineSignature = nil
							refresh()
						end
					end)
				end
				microCreateTrackActionChoice("Collapse All Folders", theme().PanelSoft, function()
					microHideTrackActions()
					setAllMicroTimelineFoldersCollapsed(true)
				end)
				microCreateTrackActionChoice("Expand All Folders", theme().PanelSoft, function()
					microHideTrackActions()
					setAllMicroTimelineFoldersCollapsed(false)
				end)
				return
			end

			if track.trackType == "Rig Group" and BoneSkeletonOverlayService.hasBones(track.rig) then
				microCreateTrackActionChoice(
					"Bone Display: Full Skeleton",
					BoneSkeletonOverlayService.getRigDisplayMode(track.rig) == BoneSkeletonOverlayService.DISPLAY_MODE_FULL
						and theme().AccentSoft or theme().PanelSoft,
					function()
						BoneSkeletonOverlayService.setRigDisplayMode(track.rig, BoneSkeletonOverlayService.DISPLAY_MODE_FULL)
						microHideTrackActions()
						if statusLabel then
							statusLabel.Text = "Bone display set to Full Skeleton."
						end
					end
				)
				microCreateTrackActionChoice(
					"Bone Display: Joints Only",
					BoneSkeletonOverlayService.getRigDisplayMode(track.rig) == BoneSkeletonOverlayService.DISPLAY_MODE_JOINTS_ONLY
						and theme().AccentSoft or theme().PanelSoft,
					function()
						BoneSkeletonOverlayService.setRigDisplayMode(track.rig, BoneSkeletonOverlayService.DISPLAY_MODE_JOINTS_ONLY)
						microHideTrackActions()
						if statusLabel then
							statusLabel.Text = "Bone display set to Joints Only."
						end
					end
				)
			end

			if LightingEffectTrackService.isLightingEffectTrack(track)
				and LightingEffectTrackService.getTrackEffectType(track) == "Lighting" then
				local childByEffectId = {}
				local trackList = currentTimeline and type(currentTimeline.getTracks) == "function" and (currentTimeline:getTracks() or {})
					or ((microUiHost._lastViewModel and microUiHost._lastViewModel.tracks) or {})
				for _, candidate in ipairs(trackList) do
					if LightingEffectTrackService.isLightingEffectTrack(candidate)
						and candidate.parentTrackPath == track.path then
						childByEffectId[LightingEffectTrackService.getTrackEffectType(candidate)] = candidate
					end
				end
				microCreateTrackActionChoice("Lighting Properties", theme().AccentSoft, function()
					microHideTrackActions()
					openMicroTrackOptionsForTrack(track)
				end)
				for _, effectId in ipairs(LIGHTING_OPTIONAL_EFFECTS) do
					local definition = LightingEffectTrackService.getEffectDefinition(effectId)
					if definition then
						local normalizedEffectId = LightingEffectTrackService.normalizeEffectType(effectId)
						local existingTrack = childByEffectId[normalizedEffectId]
						local label = string.format("%s %s", existingTrack and "Open" or "Add", definition.name or effectId)
						microCreateTrackActionChoice(label, existingTrack and theme().PanelSoft or theme().AccentSoft, function()
							microHideTrackActions()
							if existingTrack then
								openMicroTrackOptionsForTrack(existingTrack)
								return
							end
							local ok, trackPathOrMessage = runOption(options, "onAddLightingEffectTrack", "addLightingEffectTrack", effectId, {
								parentTrackPath = track.path,
								parentTrackName = track.name or "Lighting",
							})
							miniTimelineSignature = nil
							refresh()
							if ok and type(trackPathOrMessage) == "string" then
								local addedTrack = microUiHost:_getTrackViewModel(trackPathOrMessage)
								if addedTrack then
									openMicroTrackOptionsForTrack(addedTrack)
								end
							elseif statusLabel then
								statusLabel.Text = tostring(trackPathOrMessage or "Lighting effect added.")
							end
						end)
					end
				end
			end

			if track.targetScope ~= "TimelineFolder" and track.trackType ~= "Folder" then
				if track.folderPath then
					microCreateTrackActionChoice(useSelectedTracks and "Remove Selected From Folder" or "Remove From Folder", theme().PanelSoft, function()
						local trackPath = microUiHost._pendingTrackActionPath
						microHideTrackActions()
						if useSelectedTracks then
							runOption(options, "onMoveSelectedTracksToFolder", "moveSelectedTracksToFolder", nil)
							miniTimelineSignature = nil
							refresh()
						elseif trackPath then
							runOption(options, "onMoveTrackToFolder", "moveTrackToFolder", trackPath, nil)
							miniTimelineSignature = nil
							refresh()
						end
					end)
				end

				microCreateTrackActionChoice(useSelectedTracks and "New Folder + Move Selected" or "New Folder + Move", theme().AccentSoft, function()
					local trackPath = microUiHost._pendingTrackActionPath
					microHideTrackActions()
					if useSelectedTracks then
						runOption(options, "onMoveSelectedTracksToFolder", "moveSelectedTracksToFolder", "__new__")
						miniTimelineSignature = nil
						refresh()
					elseif trackPath then
						runOption(options, "onMoveTrackToFolder", "moveTrackToFolder", trackPath, "__new__")
						miniTimelineSignature = nil
						refresh()
					end
				end)
			end

			for _, folder in ipairs(folders) do
				local isCurrent = folder.path == track.folderPath
				local folderPath = folder.path
				local actionLabel = useSelectedTracks and "Move Selected To: " or "Move To: "
				local label = string.format("%s%s", isCurrent and "Current: " or actionLabel, tostring(folder.name or "Folder"))
				microCreateTrackActionChoice(label, isCurrent and Color3.fromRGB(55, 72, 94) or theme().PanelSoft, function()
					local trackPath = microUiHost._pendingTrackActionPath
					microHideTrackActions()
					if useSelectedTracks then
						runOption(options, "onMoveSelectedTracksToFolder", "moveSelectedTracksToFolder", folderPath)
						miniTimelineSignature = nil
						refresh()
					elseif trackPath then
						runOption(options, "onMoveTrackToFolder", "moveTrackToFolder", trackPath, folderPath)
						miniTimelineSignature = nil
						refresh()
					end
				end)
			end
		end

		local function microShowTrackActions(path, virtualTrack)
			if not microUiHost._trackActionsOverlay or not path then
				return
			end
			local selectedGroupIds = require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).getSelectedGroupIdsFromViewModel(
				microUiHost._lastViewModel,
				microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
			)
			if #selectedGroupIds &gt; 0 then
				microUiHost._selectedMicroGroupIds = selectedGroupIds
				options._microSelectedGroupIds = selectedGroupIds
			end
			if type(microUiHost.closePopupSurfaces) == "function" then
				microUiHost.closePopupSurfaces("trackActions")
			end
			local track = virtualTrack or microUiHost:_getTrackViewModel(path)
			if not track then
				if statusLabel then
					statusLabel.Text = "That track is no longer available."
				end
				return
			end
			if track.isMicroVirtualTrack and track.virtualKind == "RigHeader" then
				microUiHost._pendingTrackActionPath = nil
				microClearTrackFolderChoices()
				local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
				local eventTrack = MicroWidgetController._findMicroRigEventTrack(timeline, track.rigName)
				if microUiHost._trackActionsTitle then
					microUiHost._trackActionsTitle.Text = string.format("%s rig", tostring(track.rigName or track.name or "Rig"))
				end
				if microUiHost._trackActionsMessage then
					microUiHost._trackActionsMessage.Text =
						"Optional rig-level tracks. Add Events only when developers need named timeline markers."
				end
				if microUiHost._trackActionsEditButton then
					microUiHost._trackActionsEditButton.Visible = false
				end
				if microUiHost._trackActionsDeleteButton then
					microUiHost._trackActionsDeleteButton.Visible = false
				end
				if microUiHost._trackActionsFolderButton then
					microUiHost._trackActionsFolderButton.Visible = false
				end
				microCreateTrackActionChoice(eventTrack and "Open Events Track" or "Add Events Track", theme().AccentSoft, function()
					local realTrack, message = MicroWidgetController._ensureMicroRigEventTrack(options, track.rigName)
					microHideTrackActions()
					if realTrack and realTrack.path then
						selectedMicroTrackPath = realTrack.path
						options._microLastSelectionScope = "track"
						runOption(options, "onSelectTrack", "selectTrack", realTrack.path, false)
						miniTimelineSignature = nil
						refresh()
						microShowRigPropertyEditor(realTrack.path, realTrack.name)
					end
					if statusLabel then
						statusLabel.Text = tostring(message or "Events track ready.")
					end
				end)
				microUiHost._trackActionsOverlay.Visible = true
				if statusLabel then
					statusLabel.Text = "Rig actions open."
				end
				return
			end
			if #selectedGroupIds == 0 and PropertyKeyframeEditorController.isEditablePropertyTrack(track) then
				microUiHost._pendingTrackActionPath = nil
				openMicroTrackOptionsForTrack(track)
				return
			end

			microUiHost._pendingTrackActionPath = path
			if microUiHost._trackActionsTitle then
				microUiHost._trackActionsTitle.Text = string.format("%s track", tostring(track.name or track.trackType or "Timeline"))
			end
			if microUiHost._trackActionsMessage then
				local message = string.format(
					"Choose what to do with '%s'. Open options or move it into a folder.",
					tostring(track.name or track.trackType or "track")
				)
				if track.targetScope == "TimelineFolder" then
					message = "Folder actions. Removing the folder keeps the tracks in the timeline."
				end
				microUiHost._trackActionsMessage.Text = message
			end
			if microUiHost._trackActionsEditButton then
				microUiHost._trackActionsEditButton.Visible = microTrackSupportsEditor(track)
			end
			if microUiHost._trackActionsDeleteButton then
				microUiHost._trackActionsDeleteButton.Visible = false
			end
			if microUiHost._trackActionsFolderButton then
				microUiHost._trackActionsFolderButton.Visible = false
			end
			if (track.trackType == "Camera" or track.trackType == "Camera Property") and microUiHost._trackActionsFolderList then
				microCreateTrackActionChoice("Camera Settings", theme().AccentSoft, function()
					microHideTrackActions()
					openMicroTrackOptionsForTrack(track)
				end)
			end
			if isMicroFaceTrack(track) and microUiHost._trackActionsFolderList then
				microCreateTrackActionChoice("Face Visibility Track", theme().AccentSoft, function()
					microHideTrackActions()
					microShowRigPropertyEditor(track.path, track.name)
				end)
			end
			microRenderTrackFolderChoices(track)
			if #selectedGroupIds &gt; 0 and microUiHost._trackActionsFolderList then
				if require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).hasSelectedGroupKind(
					microUiHost._lastViewModel.groups,
					selectedGroupIds,
					"PhysicsClip"
				) then
					microCreateTrackActionChoice("Copy Exact Physics Clip", theme().Accent, function()
						microHideTrackActions()
						local _, message = safeCall(options.onCopyKeys)
						if statusLabel and message then
							statusLabel.Text = message
						end
					end)
					microCreateTrackActionChoice("Paste Physics at Playhead", theme().AccentSoft, function()
						microHideTrackActions()
						local _, message = safeCall(options.onPasteKeys)
						miniTimelineSignature = nil
						refresh()
						if statusLabel and message then
							statusLabel.Text = message
						end
					end)
					microCreateTrackActionChoice("Paste to Selected Rigs (New Track)", theme().Accent, function()
						microHideTrackActions()
						local _, message = safeCall(options.onPastePhysicsClipToSelectedRigs)
						miniTimelineSignature = nil
						refresh()
						if statusLabel and message then
							statusLabel.Text = message
						end
					end)
				end
				microCreateTrackActionChoice("Trim Before Playhead", theme().AccentSoft, function()
					microHideTrackActions()
					safeCall(options.onEditSelectedGroupsAtPlayhead, "Before", selectedGroupIds)
					miniTimelineSignature = nil
					refresh()
				end)
				microCreateTrackActionChoice("Trim After Playhead", theme().AccentSoft, function()
					microHideTrackActions()
					safeCall(options.onEditSelectedGroupsAtPlayhead, "After", selectedGroupIds)
					miniTimelineSignature = nil
					refresh()
				end)
				microCreateTrackActionChoice("Split at Playhead", theme().Accent, function()
					microHideTrackActions()
					safeCall(options.onEditSelectedGroupsAtPlayhead, "Split", selectedGroupIds)
					miniTimelineSignature = nil
					refresh()
				end)
				local isCFrameTrack = track.name == "CFrame"
					or track.trackType == "Rig CFrame"
					or track.valueType == "CFrame"
					or track.propertyName == "CFrame"
					or track.property == "CFrame"
				if isCFrameTrack and type(options.onReverseSelectedGroups) == "function" then
					microCreateTrackActionChoice("Reverse Group Block", theme().Accent, function()
						microHideTrackActions()
						local _, message = safeCall(options.onReverseSelectedGroups, selectedGroupIds)
						miniTimelineSignature = nil
						refresh()
						if statusLabel and message then
							statusLabel.Text = message
						end
					end)
				end
				microCreateTrackActionChoice("Stretch Group Block", theme().AccentSoft, function()
					microHideTrackActions()
					safeCall(options.onSetSelectedGroupEditMode, "Stretch", selectedGroupIds)
					miniTimelineSignature = nil
					refresh()
				end)
				microCreateTrackActionChoice("Repeat Group Block", theme().AccentSoft, function()
					microHideTrackActions()
					safeCall(options.onSetSelectedGroupEditMode, "Repeat", selectedGroupIds)
					miniTimelineSignature = nil
					refresh()
				end)
			end
			microUiHost._trackActionsOverlay.Visible = true
			if statusLabel then
				statusLabel.Text = "Track actions open."
			end
		end

		openMicroSelectedOptions = function()
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			microUiHost._lastViewModel = buildMicroEditorViewModel(timeline)
			local selectedGroupIds = require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).getSelectedGroupIdsFromViewModel(
				microUiHost._lastViewModel,
				microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
			)
			local track = getMicroOptionsTrack(timeline)
			if #selectedGroupIds &gt; 0 and track then
				microUiHost._selectedMicroGroupIds = selectedGroupIds
				options._microSelectedGroupIds = selectedGroupIds
				microShowTrackActions(track.path)
				return true, "Clip options open."
			end
			return openMicroTrackOptionsForTrack(track)
		end
		options.onOpenSelectedTrackOptions = openMicroSelectedOptions

		if microUiHost._trackActionsCancelButton then
			connectMicroUi(microUiHost._trackActionsCancelButton.Activated, function()
				microHideTrackActions()
				if statusLabel then
					statusLabel.Text = "Track actions closed."
				end
			end)
		end

		if microUiHost._trackActionsEditButton then
			connectMicroUi(microUiHost._trackActionsEditButton.Activated, function()
				local trackPath = microUiHost._pendingTrackActionPath
				local track = microUiHost:_getTrackViewModel(trackPath)
				microHideTrackActions()
				if not track then
					return
				end
				openMicroTrackOptionsForTrack(track)
			end)
		end

		if microUiHost._rigPropertyEditorCloseButton then
			connectMicroUi(microUiHost._rigPropertyEditorCloseButton.Activated, function()
				microHideRigPropertyEditor()
				if statusLabel then
					statusLabel.Text = "Edit item closed."
				end
			end)
		end

		if microUiHost._rigPropertyOkButton then
			connectMicroUi(microUiHost._rigPropertyOkButton.Activated, function()
				microHideRigPropertyEditor()
				if statusLabel then
					statusLabel.Text = "Edit item closed."
				end
			end)
		end

		if microUiHost._rigPropertyDeleteButton then
			connectMicroUi(microUiHost._rigPropertyDeleteButton.Activated, function()
				local trackPath = microUiHost._activeRigPropertyTrackPath
				microHideRigPropertyEditor()
				if trackPath then
					runOption(options, "onSelectTrack", "selectTrack", trackPath, false)
					runOption(options, "onRemoveSelectedTrack", "removeSelectedTrack")
					miniTimelineSignature = nil
					refresh()
				end
			end)
		end

		local sideRail = make("Frame", {
			Name = "SideRail",
			BackgroundColor3 = theme().PanelAlt,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 34),
			Size = UDim2.new(0, getRailWidth(), 1, -34),
			ZIndex = 2,
		}, panel)
		setBackgroundRole(sideRail, "PanelAlt")
		UiHelpers.applySectionSurface(sideRail)
		blockClickThrough(sideRail)
		sideRail.ClipsDescendants = true

		local railToggle = make("TextButton", {
			Name = "RailToggle",
			AutoButtonColor = true,
			BackgroundColor3 = theme().PanelSoft,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(5, 5),
			Size = UDim2.fromOffset(getRailWidth() - 10, 20),
			Text = railExpanded and "&lt;&lt; Tools" or "&gt;&gt;",
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 10,
			TextWrapped = false,
			ZIndex = 24,
		}, sideRail)
		railToggle:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
		railToggle:SetAttribute("MegMoThemeTextRole", "__auto")
		corner(railToggle, 5)
		stroke(railToggle, theme().Border, 0.36, 1, "Border")

		local body = make("Frame", {
			Name = "Body",
			BackgroundColor3 = theme().Background,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Position = UDim2.fromOffset(getRailWidth(), 64),
			Size = UDim2.new(1, -getRailWidth(), 1, -64),
			ZIndex = 2,
		}, panel)
		setBackgroundRole(body, "Background")
		blockClickThrough(body)
		padding(body, 8)

		local railHint = text(gui, {
			Name = "RailHint",
			BackgroundTransparency = 0,
			BackgroundColor3 = theme().PanelSoft,
			Text = "",
			TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Center,
