function editorActions.previewScreenEffectKeyValue(trackPath, value, options)
	local track = timeline:getTrackByPath(trackPath)
	if not ScreenEffectTrackService.isScreenEffectTrack(track) then
		return
	end

	local effectType = ScreenEffectTrackService.getTrackEffectType(track) or ScreenEffectTrackService.normalizeEffectType(track.valueType or track.effectType or track.name)
	local parsedValue = ScreenEffectTrackService.normalizeValue(effectType, value)
	options = type(options) == "table" and options or {}
	widgetController._screenEffectPreviewToken = (widgetController._screenEffectPreviewToken or 0) + 1
	local previewToken = widgetController._screenEffectPreviewToken
	local currentFrame = timeline:getCurrentFrame()
	local targetFrame = options.targetFrame ~= nil and math.max(0, math.floor((tonumber(options.targetFrame) or currentFrame) + 0.5)) or nil

	if effectType == "Subtitle" and targetFrame ~= nil and targetFrame ~= currentFrame then
		local canPreviewAtCurrentFrame = false
		for _, clip in ipairs(ScreenEffectTrackService.getSubtitleClipDataForTrack(timeline, track)) do
			if clip.frame == targetFrame and currentFrame &gt;= clip.frame and currentFrame &lt; clip.endFrame then
				canPreviewAtCurrentFrame = true
				break
			end
		end
		if not canPreviewAtCurrentFrame then
			renderScreenEffects(currentFrame)
			return
		end
	end

	local function renderPreviewValue()
		local effectsViewModel = buildEffectsViewModel(currentFrame)
		effectsViewModel.timelineScreenEffects = effectsViewModel.timelineScreenEffects or {}
		effectsViewModel.timelineScreenEffects[effectType] = parsedValue
		screenEffectsRenderer:render(effectsViewModel)
	end

	local phase = tostring(options.phase or "")
	if effectType == "Subtitle" and (phase == "enter" or phase == "exit") then
		local preset = phase == "exit" and parsedValue.exitTransition or parsedValue.enterTransition
		local duration = phase == "exit" and parsedValue.exitDuration or parsedValue.enterDuration
		local steps = 12
		local previewDuration = math.clamp(tonumber(duration) or 0.45, 0.25, 1.2)
		task.spawn(function()
			for step = 0, steps do
				if widgetController._screenEffectPreviewToken ~= previewToken then
					return
				end
				local alpha = step / steps
				parsedValue._transitionAlpha = phase == "exit" and (1 - alpha) or alpha
				parsedValue._transitionPreset = preset
				renderPreviewValue()
				task.wait(previewDuration / steps)
			end
		end)
		return
	end

	renderPreviewValue()
end

function editorActions.cancelScreenEffectKeyPreview()
	widgetController._screenEffectPreviewToken = (widgetController._screenEffectPreviewToken or 0) + 1
	renderScreenEffects(timeline:getCurrentFrame())
end

function editorActions.setScreenEffectKeyValue(trackPath, value, options)
	local track = timeline:getTrackByPath(trackPath)
	if not ScreenEffectTrackService.isScreenEffectTrack(track) then
		refreshUi("Select a screen effect keyframe before editing effect settings.")
		return
	end

	options = type(options) == "table" and options or {}
	local effectType = ScreenEffectTrackService.getTrackEffectType(track) or ScreenEffectTrackService.normalizeEffectType(track.valueType or track.effectType or track.name)
	local parsedValue = ScreenEffectTrackService.normalizeValue(effectType, value)
	local targetFramesByKey = {}
	local explicitTargetFrame = tonumber(options.targetFrame)
	if explicitTargetFrame ~= nil then
		targetFramesByKey[math.max(0, math.floor(explicitTargetFrame + 0.5))] = true
	elseif options.currentFrameOnly then
		targetFramesByKey[timeline:getCurrentFrame()] = true
	else
		for _, key in pairs(selectedKeys) do
			if key.jointPath == track.path then
				targetFramesByKey[key.frame] = true
			end
		end
		if next(targetFramesByKey) == nil then
			targetFramesByKey[timeline:getCurrentFrame()] = true
		end
	end

	local targetFrames = {}
	for frame in pairs(targetFramesByKey) do
		table.insert(targetFrames, frame)
	end
	SelectionState.sortFrames(targetFrames)

	local actionName = tostring(options.actionName or "Screen Effect Keyframe")
	pushUndo("Set " .. actionName)
	ChangeHistoryService:SetWaypoint("Before Set " .. actionName)
	local keyRefs = {}
	for _, frame in ipairs(targetFrames) do
		if effectType == ScreenEffectTrackService.FADE_EFFECT then
			local startValue, endValue = ScreenEffectTrackService.makeFadeClipValues(parsedValue)
			local fps = math.max(1, tonumber(timeline:getFps()) or Constants.DEFAULT_FPS)
			local clip = editorActions.getFadeClipForFrame(track, frame)
			local durationFrames = math.max(1, math.floor(((tonumber(parsedValue.duration) or 1) * fps) + 0.5))
			local endFrame = clip and math.floor(tonumber(clip.endFrame) or (frame + durationFrames)) or (frame + durationFrames)
			endFrame = math.max(frame + 1, endFrame)
			if endFrame &gt; timeline:getDurationFrames() then
				timeline:setDurationFrames(endFrame)
			end
			if frame &gt; 0 and math.clamp(tonumber(startValue.transparency) or 1, 0, 1) &lt; 0.999 then
				local previousFrame = timeline:getTrackNeighborFrames(track.path, frame - 1)
				if previousFrame == nil then
					local preStartFrame = math.max(0, frame - 1)
					local preSuccess, preMessage = timeline:setTrackValueAtFrame(track.path, preStartFrame, ScreenEffectTrackService.makeFadeTransparentValue(startValue))
					if not preSuccess then
						historyService:discardPendingUndo()
						refreshUi(preMessage or "Could not set fade pre-start keyframe.")
						return
					end
				end
			end
			local startSuccess, startMessage = timeline:setTrackValueAtFrame(track.path, frame, startValue)
			if not startSuccess then
				historyService:discardPendingUndo()
				refreshUi(startMessage or "Could not set fade start keyframe.")
				return
			end
			local endSuccess, endMessage = timeline:setTrackValueAtFrame(track.path, endFrame, endValue)
			if not endSuccess then
				historyService:discardPendingUndo()
				refreshUi(endMessage or "Could not set fade end keyframe.")
				return
			end
			table.insert(keyRefs, {
				jointPath = track.path,
				frame = frame,
			})
			continue
		end
		if effectType == "Subtitle" and parsedValue.enabled ~= false and frame &gt; 0 then
			local previousFrame = timeline:getTrackNeighborFrames(track.path, frame - 1)
			if previousFrame == nil then
				local hideFrame = math.max(0, frame - 1)
				local hideSuccess, hideMessage = timeline:setTrackValueAtFrame(track.path, hideFrame, ScreenEffectTrackService.makeSubtitleEndValue(parsedValue))
				if not hideSuccess then
					historyService:discardPendingUndo()
					refreshUi(hideMessage or "Could not set subtitle pre-start keyframe.")
					return
				end
			end
		end
		local success, message = timeline:setTrackValueAtFrame(track.path, frame, parsedValue)
		if not success then
			historyService:discardPendingUndo()
			refreshUi(message or "Could not set screen effect keyframe.")
			return
		end
		table.insert(keyRefs, {
			jointPath = track.path,
			frame = frame,
		})
	end

	local lastFrame = targetFrames[#targetFrames] or timeline:getCurrentFrame()
	timeline:setCurrentFrame(lastFrame)
	setSingleSelectedTrack(track.path)
	selectKeys(keyRefs)
	if effectType == "Subtitle" then
		local previewValue = ScreenEffectTrackService.normalizeValue("Subtitle", parsedValue)
		previewValue._transitionAlpha = 1
		previewValue._transitionPreset = "None"
		local effectsViewModel = buildEffectsViewModel(lastFrame)
		effectsViewModel.timelineScreenEffects = effectsViewModel.timelineScreenEffects or {}
		effectsViewModel.timelineScreenEffects.Subtitle = previewValue
		effectsViewModel.timelineScreenEffectTrackIds = effectsViewModel.timelineScreenEffectTrackIds or {}
		effectsViewModel.timelineScreenEffectTrackIds.Subtitle = true
		effectsViewModel.timelineOwnsSubtitle = true
		screenEffectsRenderer:render(effectsViewModel)
	else
		renderScreenEffects(lastFrame)
	end
	ChangeHistoryService:SetWaypoint("After Set " .. actionName)
	refreshUi(string.format("Set %s on %d keyframe%s.", tostring(track.name or "Screen Effect"), #keyRefs, #keyRefs == 1 and "" or "s"))
end

function editorActions.setSubtitleClipEndFrame(trackPath, sourceFrame, endFrame)
	local track = timeline:getTrackByPath(trackPath)
	if not ScreenEffectTrackService.isSubtitleTrack(track) then
		refreshUi("Select a Subtitle clip before setting its end position.")
		return false, "Select a Subtitle clip before setting its end position."
	end

	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	endFrame = math.max(sourceFrame + 1, math.floor((tonumber(endFrame) or sourceFrame + 1) + 0.5))
	local sourceValue = timeline:getTrackValueAtFrame(track.path, sourceFrame)
	if type(sourceValue) ~= "table" then
		refreshUi("That subtitle start keyframe is no longer available.")
		return false, "That subtitle start keyframe is no longer available."
	end

	local _, nextFrame = timeline:getTrackNeighborFrames(track.path, sourceFrame + 1)
	if nextFrame and nextFrame &gt; sourceFrame and nextFrame &lt; endFrame then
		local nextValue = timeline:getTrackValueAtFrame(track.path, nextFrame)
		if type(nextValue) == "table" and ScreenEffectTrackService.normalizeValue("Subtitle", nextValue).enabled ~= false then
			refreshUi("Subtitle end cannot pass the next subtitle start.")
			return false, "Subtitle end cannot pass the next subtitle start."
		end
	end

	local existingAtEnd = timeline:getTrackValueAtFrame(track.path, endFrame)
	if type(existingAtEnd) == "table" then
		local parsedExisting = ScreenEffectTrackService.normalizeValue("Subtitle", existingAtEnd)
		if parsedExisting.enabled ~= false then
			refreshUi("Subtitle end cannot overlap another subtitle start.")
			return false, "Subtitle end cannot overlap another subtitle start."
		end
	end

	pushUndo("Set Subtitle End")
	ChangeHistoryService:SetWaypoint("Before Set Subtitle End")
	if nextFrame and nextFrame ~= endFrame then
		local nextValue = timeline:getTrackValueAtFrame(track.path, nextFrame)
		if type(nextValue) == "table" and ScreenEffectTrackService.normalizeValue("Subtitle", nextValue).enabled == false then
			timeline:deleteTrackKeyframes({
				{
					jointPath = track.path,
					frame = nextFrame,
				},
			})
		end
	end

	local success, message = timeline:setTrackValueAtFrame(track.path, endFrame, ScreenEffectTrackService.makeSubtitleEndValue(sourceValue))
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set subtitle end.")
		return false, message
	end

	setSingleSelectedKey(track.path, sourceFrame)
	renderScreenEffects(timeline:getCurrentFrame())
	ChangeHistoryService:SetWaypoint("After Set Subtitle End")
	local resultMessage = string.format("Subtitle ends at frame %d.", endFrame)
	refreshUi(resultMessage)
	return true, resultMessage
end

function editorActions.setFadeClipStartFrame(trackPath, sourceFrame, startFrame)
	local track = timeline:getTrackByPath(trackPath)
	if not ScreenEffectTrackService.isFadeTrack(track) then
		refreshUi("Select a Fade clip before setting its start position.")
		return false, "Select a Fade clip before setting its start position."
	end

	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	startFrame = math.max(0, math.floor((tonumber(startFrame) or sourceFrame) + 0.5))
	local clip = editorActions.getFadeClipForFrame(track, sourceFrame)
	if not clip then
		refreshUi("That fade clip is no longer available.")
		return false, "That fade clip is no longer available."
	end

	local endFrame = math.floor(tonumber(clip.endFrame) or sourceFrame + 1)
	startFrame = math.clamp(startFrame, 0, math.max(0, endFrame - 1))
	if startFrame == sourceFrame then
		return true, string.format("Fade already starts at frame %d.", startFrame)
	end

	pushUndo("Set Fade Start")
	ChangeHistoryService:SetWaypoint("Before Set Fade Start")
	local success, message = timeline:moveTrackKeyframe(track.path, sourceFrame, startFrame)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set fade start.")
		return false, message
	end

	setSingleSelectedKey(track.path, startFrame)
	renderScreenEffects(timeline:getCurrentFrame())
	ChangeHistoryService:SetWaypoint("After Set Fade Start")
	local resultMessage = string.format("Fade starts at frame %d.", startFrame)
	refreshUi(resultMessage)
	return true, resultMessage
end

function editorActions.setFadeClipEndFrame(trackPath, sourceFrame, endFrame)
	local track = timeline:getTrackByPath(trackPath)
	if not ScreenEffectTrackService.isFadeTrack(track) then
		refreshUi("Select a Fade clip before setting its end position.")
		return false, "Select a Fade clip before setting its end position."
	end

	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	endFrame = math.max(sourceFrame + 1, math.floor((tonumber(endFrame) or sourceFrame + 1) + 0.5))
	local clip = editorActions.getFadeClipForFrame(track, sourceFrame)
	if not clip or clip.hasExplicitEnd ~= true then
		refreshUi("That fade clip end is no longer available.")
		return false, "That fade clip end is no longer available."
	end

	local oldEndFrame = math.floor(tonumber(clip.endFrame) or (sourceFrame + 1))
	if endFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(endFrame)
	end
	if endFrame == oldEndFrame then
		return true, string.format("Fade already ends at frame %d.", endFrame)
	end

	pushUndo("Set Fade End")
	ChangeHistoryService:SetWaypoint("Before Set Fade End")
	local success, message = timeline:moveTrackKeyframe(track.path, oldEndFrame, endFrame)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set fade end.")
		return false, message
	end

	setSingleSelectedKey(track.path, sourceFrame)
	renderScreenEffects(timeline:getCurrentFrame())
	ChangeHistoryService:SetWaypoint("After Set Fade End")
	local resultMessage = string.format("Fade ends at frame %d.", endFrame)
	refreshUi(resultMessage)
	return true, resultMessage
end

function editorActions.toggleRigPropertyTrack(rigName, propertyName, enabled)
	local rig = timeline:getRigByName(rigName)
	if not rig or not rig.Parent then
		refreshUi("That rig is no longer available.")
		return
	end
	if not PropertyKeyframeValueService.isPropertyAllowedForTrack({
		instance = rig,
		trackType = "Rig Group",
	}, propertyName, true) then
		refreshUi(string.format("%s is not available for an entire rig. Select a specific part track instead.", tostring(propertyName)))
		return
	end

	local existingTrack = timeline:getRigPropertyTrack(rigName, propertyName)
	if enabled and existingTrack then
		refreshUi(string.format("%s already has a %s track.", rigName, propertyName))
		return
	end
	if (not enabled) and not existingTrack then
		refreshUi(string.format("%s does not have a %s track yet.", rigName, propertyName))
		return
	end

	pushUndo(enabled and "Add Rig Property Track" or "Remove Rig Property Track")
	if enabled then
		local track = timeline:addGenericTrack("RigProperty", rig, propertyName, {
			rig = rig,
			rigName = rigName,
			propertyName = propertyName,
			targetScope = "RigProperty",
			sortOrder = require(Modules:WaitForChild("TrackPropertyDefaultsService")).getSortOrder(propertyName),
		})
		setSingleSelectedTrack(track.path)
		refreshUi(string.format("Added %s property track to %s.", propertyName, rigName))
		return
	end

	local success, message = timeline:removeTrack(existingTrack.path)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message)
		return
	end
	if selectedJointPath == existingTrack.path then
		clearSelectedTracks()
	end
	removeDeletedKeysFromGroups()
	refreshUi(message)
end

function editorActions.togglePropertyTrack(parentTrackPath, propertyName, enabled)
	local baseTrack = timeline:getTrackByPath(parentTrackPath)
	if not baseTrack then
		refreshUi("That object track is no longer available.")
		return
	end

	if baseTrack.trackType == "Rig Group" then
		editorActions.toggleRigPropertyTrack(baseTrack.rigName, propertyName, enabled)
		return
	end

	local existingTrack = timeline:getObjectPropertyTrack(parentTrackPath, propertyName)
	if enabled and existingTrack then
		refreshUi(string.format("%s already has a %s track.", baseTrack.name or "This track", propertyName))
		return
	end
	if (not enabled) and not existingTrack then
		refreshUi(string.format("%s does not have a %s track yet.", baseTrack.name or "This track", propertyName))
		return
	end

	local isFaceTrack = baseTrack.trackType == "Face"
		or baseTrack.targetScope == "Face"
		or baseTrack.valueType == "Face"
		or baseTrack.propertyName == "Face"
	local faceTargetInstance = nil
	if isFaceTrack then
		if propertyName ~= "Transparency" then
			refreshUi("Only Transparency is available for face visibility tracks right now.")
			return
		end
		if enabled then
			local rig = baseTrack.rig
			if not (rig and rig.Parent) and baseTrack.rigName then
				local foundRig = workspace:FindFirstChild(baseTrack.rigName, true)
				if foundRig and foundRig:IsA("Model") then
					rig = foundRig
				end
			end
			local faceAdapter = require(script.Parent:WaitForChild("Features"):WaitForChild("Faces"):WaitForChild("FaceRigAdapter"))
			local head = faceAdapter.GetHead(rig)
			faceTargetInstance = head and faceAdapter.FindStandardFace(head) or nil
			if not faceTargetInstance then
				refreshUi("No classic Head.face decal was found for that face track.")
				return
			end
		end
	elseif not baseTrack.instance or not baseTrack.instance.Parent then
		refreshUi("That object is no longer available.")
		return
	end
	local isEmitterGroup = (not isFaceTrack) and (baseTrack.trackType == "Emitter Group" or baseTrack.targetScope == "EmitterGroup")
	local isParticleTrack = isEmitterGroup or ((not isFaceTrack) and ParticleEmitterPropertyService.isParticleEmitter(baseTrack.instance))
	if not isParticleTrack and not PropertyKeyframeValueService.isPropertyAllowedForTrack(baseTrack, propertyName, false) then
		refreshUi(string.format("%s is not available for %s.", tostring(propertyName), tostring(baseTrack.name or "that track")))
		return
	end

	pushUndo(enabled and "Add Object Property Track" or "Remove Object Property Track")
	if enabled then
		local isParticleAction = (not isFaceTrack) and ParticleEmitterPropertyService.isOneShotAction(propertyName)
		local trackType = isParticleAction and "ParticleEvent" or (isEmitterGroup and "EmitterGroupProperty" or "ObjectProperty")
		local targetScope = isParticleAction and "ParticleEvent" or (isEmitterGroup and "EmitterGroupProperty" or "ObjectProperty")
		local targetInstance = faceTargetInstance or PropertyKeyframeValueService.getTargetInstance(baseTrack) or baseTrack.instance
		if not targetInstance then
			historyService:discardPendingUndo()
			refreshUi("That property target is no longer available.")
			return
		end
		local isRigPartProperty = (not isFaceTrack) and baseTrack.trackType == "Rig" and baseTrack.rigName ~= nil
		local parentTrackName = isFaceTrack and "Face" or (isRigPartProperty and (baseTrack.part1 or baseTrack.name) or baseTrack.name)
		local track = timeline:addGenericTrack(trackType, targetInstance, propertyName, {
			propertyName = propertyName,
			eventName = isParticleAction and propertyName or nil,
			targetScope = targetScope,
			parentTrackPath = parentTrackPath,
			parentTrackName = parentTrackName,
			rig = isRigPartProperty and baseTrack.rig or nil,
			rigName = isRigPartProperty and baseTrack.rigName or nil,
			emitters = (isEmitterGroup or isParticleAction) and ParticleEmitterGroupService.collectEmitters(baseTrack.instance) or nil,
			sortOrder = require(Modules:WaitForChild("TrackPropertyDefaultsService")).getSortOrder(propertyName),
		})
		setSingleSelectedTrack(track.path)
		refreshUi(string.format("Added %s %s track to %s.", propertyName, isParticleAction and "event" or "property", baseTrack.name or "object"))
		return
	end

	local success, message = timeline:removeTrack(existingTrack.path)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message)
		return
	end
	if selectedJointPath == existingTrack.path then
		clearSelectedTracks()
	end
	removeDeletedKeysFromGroups()
	refreshUi(message)
end

function editorActions.moveTrackToFolder(trackPath, folderPath)
	local track = timeline:getTrackByPath(trackPath)
	if not track then
		refreshUi("Select a track before moving it into a folder.")
		return
	end
	if track.targetScope == "TimelineFolder" then
		refreshUi("Select a regular track. Folders cannot be moved into folders yet.")
		return
	end

	local movingIntoFolder = folderPath ~= nil
	if folderPath == "__new__" then
		movingIntoFolder = true
	elseif folderPath == "" then
		folderPath = nil
		movingIntoFolder = false
	elseif folderPath == nil and not track.folderPath then
		folderPath = "__new__"
		movingIntoFolder = true
	end
	pushUndo(movingIntoFolder and "Move Track To Folder" or "Remove Track From Folder")

	local targetFolderPath = nil
	local createdFolderName = nil
	if movingIntoFolder then
		local folder = nil
		if folderPath and folderPath ~= "__new__" then
			folder = timeline:getTrackByPath(folderPath)
			if not folder or folder.targetScope ~= "TimelineFolder" then
				historyService:discardPendingUndo()
				refreshUi("That folder is no longer available.")
				return
			end
		end
		if not folder then
			local folderCount = #timeline:getTimelineFolders() + 1
			folder = timeline:addGenericTrack("Folder", nil, string.format("Folder %d", folderCount), {
				targetScope = "TimelineFolder",
				sortOrder = 2,
			})
			createdFolderName = folder.name
		end
		targetFolderPath = folder.path
	end

	local success, message = timeline:moveTrackToFolder(trackPath, targetFolderPath)
	if not success then
		historyService:discardPendingUndo()
	end
	if success and createdFolderName then
		message = string.format("Created '%s' and moved the track into it.", createdFolderName)
	end
	refreshUi(message)
end

function editorActions.moveSelectedTracksToFolder(folderPath)
	local selectedPaths = getSelectedTrackPaths()
	if #selectedPaths == 0 then
		refreshUi("Select tracks before moving them into a folder.")
		return
	end

	local movingIntoFolder = folderPath ~= nil and folderPath ~= ""
	if folderPath == "__new__" then
		movingIntoFolder = true
	end
	pushUndo(movingIntoFolder and "Move Selected Tracks To Folder" or "Remove Selected Tracks From Folder")

	local targetFolderPath = nil
	local createdFolderName = nil
	if movingIntoFolder then
		local folder = nil
		if folderPath and folderPath ~= "__new__" then
			folder = timeline:getTrackByPath(folderPath)
			if not folder or folder.targetScope ~= "TimelineFolder" then
				historyService:discardPendingUndo()
				refreshUi("That folder is no longer available.")
				return
			end
		end
		if not folder then
			local folderCount = #timeline:getTimelineFolders() + 1
			folder = timeline:addGenericTrack("Folder", nil, string.format("Folder %d", folderCount), {
				targetScope = "TimelineFolder",
				sortOrder = 2,
			})
			createdFolderName = folder.name
		end
		targetFolderPath = folder.path
	end

	local changedCount = 0
	for _, path in ipairs(selectedPaths) do
		local selectedTrack = timeline:getTrackByPath(path)
		if selectedTrack and selectedTrack.targetScope ~= "TimelineFolder" then
			local success = timeline:moveTrackToFolder(path, targetFolderPath)
			if success then
				changedCount += 1
			end
		end
	end

	if changedCount == 0 then
		historyService:discardPendingUndo()
		refreshUi("No movable tracks were selected.")
		return
	end

	if createdFolderName then
		refreshUi(string.format("Created '%s' and moved %d selected tracks into it.", createdFolderName, changedCount))
	elseif targetFolderPath then
		local folder = timeline:getTrackByPath(targetFolderPath)
		refreshUi(string.format("Moved %d selected tracks into folder '%s'.", changedCount, folder and folder.name or "Folder"))
	else
		refreshUi(string.format("Removed %d selected tracks from folders.", changedCount))
	end
end

function editorActions.renameTimelineFolder(folderPath, newName)
	pushUndo("Rename Folder")
	local success, message = timeline:renameTimelineFolder(folderPath, newName)
	if not success then
		historyService:discardPendingUndo()
	end
	refreshUi(message)
end

function editorActions.setTimelineFolderColor(folderPath, colorId)
	pushUndo("Set Folder Color")
	local success, message = timeline:setTimelineFolderColor(folderPath, colorId)
	if not success then
		historyService:discardPendingUndo()
	end
	refreshUi(message)
end

function editorActions.reorderTrack(trackPath, targetPath, placement)
	pushUndo("Reorder Track")
	local success, message = timeline:reorderTrack(trackPath, targetPath, placement)
	if not success then
		historyService:discardPendingUndo()
	end
	refreshUi(message)
end

function editorActions.setParticleEmitterPropertyKey(trackPath, rawText, booleanValue)
	local track = timeline:getTrackByPath(trackPath)
	local isSingleEmitter = track
		and track.targetScope == "ObjectProperty"
		and ParticleEmitterPropertyService.isParticleEmitter(track.instance)
	local isEmitterGroup = track and track.targetScope == "EmitterGroupProperty"
	local isParticleEvent = track and track.targetScope == "ParticleEvent"
	if not isSingleEmitter and not isEmitterGroup and not isParticleEvent then
		refreshUi("Select a ParticleEmitter property keyframe before editing particle settings.")
		return
	end

	local propertyName = track.propertyName or track.name
	if isParticleEvent then
		local actionName = track.eventName or propertyName or "Emit"
		local emitCount = math.max(1, math.floor(tonumber(rawText) or 10))
		local value = {
			actionName = actionName,
			emitCount = actionName == "Emit" and emitCount or nil,
		}
		local targetFrame = selectedKeyframeFrame or timeline:getCurrentFrame()
		pushUndo("Set Particle Event Keyframe")
		ChangeHistoryService:SetWaypoint("Before Set Particle Event Keyframe")
		local success, message = timeline:setTrackValueAtFrame(track.path, targetFrame, value)
		if not success then
			historyService:discardPendingUndo()
			refreshUi(message or "Could not set particle event keyframe.")
			return
		end

		timeline:setCurrentFrame(targetFrame)
		setSingleSelectedTrack(track.path)
		selectKeys({
			{
				jointPath = track.path,
				frame = targetFrame,
			},
		})
		local previewed = 0
		local previewOk, previewCount = ParticleEmitterGroupService.runAction(track, actionName, value)
		if previewOk then
			previewed = previewCount or 0
		end
		ChangeHistoryService:SetWaypoint("After Set Particle Event Keyframe")
		refreshUi(string.format("Set %s event at frame %d%s.", tostring(actionName), targetFrame, previewed &gt; 0 and string.format(" and previewed it on %d emitter%s", previewed, previewed == 1 and "" or "s") or ""))
		return
	end

	local referenceValue = isEmitterGroup
		and ParticleEmitterGroupService.getFirstProperty(track, propertyName)
		or ParticleEmitterPropertyService.getProperty(track.instance, propertyName)
	local parseOk, valueOrMessage = ParticleEmitterPropertyService.parseInput(propertyName, rawText, referenceValue, booleanValue)
	if not parseOk then
		refreshUi(valueOrMessage or "That particle value could not be read.")
		return
	end

	local targetFrame = selectedKeyframeFrame or timeline:getCurrentFrame()
	pushUndo("Set Particle Property Keyframe")
	ChangeHistoryService:SetWaypoint("Before Set Particle Property Keyframe")
	local success, message = timeline:setTrackValueAtFrame(track.path, targetFrame, valueOrMessage)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set particle keyframe.")
		return
	end

	timeline:setCurrentFrame(targetFrame)
	timeline:applyCurrentFrame()
	setSingleSelectedTrack(track.path)
	selectKeys({
		{
			jointPath = track.path,
			frame = targetFrame,
		},
	})
	ChangeHistoryService:SetWaypoint("After Set Particle Property Keyframe")
	refreshUi(string.format("Set %s keyframe at frame %d.", tostring(propertyName or "Particle"), targetFrame))
end

function editorActions.setPropertyKeyframeValue(trackPath, rawText)
	local track = timeline:getTrackByPath(trackPath)
	local propertyName = track and (track.propertyName or track.name)
	if not PropertyKeyframeValueService.isEditableValueTrack(track) then
		refreshUi("Select an editable property keyframe before changing property settings.")
		return
	end

	local parseOk, valueOrMessage = PropertyKeyframeValueService.parseValue(propertyName, rawText)
	if not parseOk then
		refreshUi(valueOrMessage)
		return
	end

	local targetFramesByKey = {}
	for _, key in pairs(selectedKeys) do
		if key.jointPath == track.path then
			targetFramesByKey[key.frame] = true
		end
	end
	if next(targetFramesByKey) == nil then
		targetFramesByKey[timeline:getCurrentFrame()] = true
	end

	local targetFrames = {}
	for frame in pairs(targetFramesByKey) do
		table.insert(targetFrames, frame)
	end
	SelectionState.sortFrames(targetFrames)

	pushUndo("Set Property Keyframe")
	ChangeHistoryService:SetWaypoint("Before Set Property Keyframe")
	local keyRefs = {}
	for _, frame in ipairs(targetFrames) do
		local success, message = timeline:setTrackValueAtFrame(track.path, frame, valueOrMessage)
		if not success then
			historyService:discardPendingUndo()
			refreshUi(message or "Could not set property keyframe.")
			return
		end
		table.insert(keyRefs, {
			jointPath = track.path,
			frame = frame,
		})
	end

	local lastFrame = targetFrames[#targetFrames] or timeline:getCurrentFrame()
	timeline:setCurrentFrame(lastFrame)
	timeline:applyCurrentFrame()
	setSingleSelectedTrack(track.path)
	selectKeys(keyRefs)
	ChangeHistoryService:SetWaypoint("After Set Property Keyframe")
	refreshUi(string.format(
		"Set %s on %d keyframe%s.",
		tostring(propertyName),
		#keyRefs,
		#keyRefs == 1 and "" or "s"
	))
end

function editorActions.setEventKeyframeValue(trackPath, eventName, payload, options)
	return require(Modules:WaitForChild("EventKeyframeActionService")).setValue({
		timeline = timeline,
		refreshUi = refreshUi,
		pushUndo = pushUndo,
		changeHistoryService = ChangeHistoryService,
		historyService = historyService,
		selectKeys = selectKeys,
		getSelectedKeys = function()
			return selectedKeys
		end,
	}, trackPath, eventName, payload, options)
end

function editorActions.previewPropertyKeyframeValue(trackPath, rawText)
	local track = timeline:getTrackByPath(trackPath)
	local propertyName = track and (track.propertyName or track.name)
	if not PropertyKeyframeValueService.isEditableValueTrack(track) then
		return
	end

	local parseOk, valueOrMessage = PropertyKeyframeValueService.parseValue(propertyName, rawText)
	if parseOk then
		timeline:previewTrackValue(track.path, valueOrMessage)
	end
end

function editorActions.cancelPropertyKeyframePreview()
	timeline:applyCurrentFrame()
end

function editorActions.setSoundKeyframeValue(trackPath, value, targetFrame)
	local track = timeline:getTrackByPath(trackPath)
	if not track or track.trackType ~= "Sound" then
		refreshUi("Select a Sound keyframe before editing sound settings.")
		return
	end
	if type(value) ~= "table" then
		refreshUi("Sound settings were not valid.")
		return
	end

	local targetFramesByKey = {}
	local explicitFrame = tonumber(targetFrame)
	if explicitFrame ~= nil then
		targetFramesByKey[math.max(0, math.floor(explicitFrame + 0.5))] = true
	else
		for _, key in pairs(selectedKeys) do
			if key.jointPath == track.path then
				targetFramesByKey[key.frame] = true
			end
		end
	end
	if next(targetFramesByKey) == nil then
		targetFramesByKey[timeline:getCurrentFrame()] = true
	end

	local targetFrames = {}
	for frame in pairs(targetFramesByKey) do
		table.insert(targetFrames, frame)
	end
	SelectionState.sortFrames(targetFrames)

	pushUndo("Set Sound Keyframe")
	ChangeHistoryService:SetWaypoint("Before Set Sound Keyframe")
	local keyRefs = {}
	for _, frame in ipairs(targetFrames) do
		local success, message = timeline:setTrackValueAtFrame(track.path, frame, value)
		if not success then
			historyService:discardPendingUndo()
			refreshUi(message or "Could not set sound keyframe.")
			return
		end
		table.insert(keyRefs, {
			jointPath = track.path,
			frame = frame,
		})
	end

	local lastFrame = targetFrames[#targetFrames] or timeline:getCurrentFrame()
	timeline:setCurrentFrame(lastFrame)
	timeline:applyCurrentFrame()
	setSingleSelectedTrack(track.path)
	selectKeys(keyRefs)
	ChangeHistoryService:SetWaypoint("After Set Sound Keyframe")
	refreshUi(string.format("Set %s sound keyframe%s.", tostring(track.name or "Sound"), #keyRefs == 1 and "" or "s"))
end

function editorActions.setSoundClipEndFrame(trackPath, sourceFrame, endFrame)
	local track = timeline:getTrackByPath(trackPath)
	if not track or track.trackType ~= "Sound" then
		refreshUi("Select a Sound clip before setting its stop position.")
		return false, "Select a Sound clip before setting its stop position."
	end

	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	endFrame = math.max(sourceFrame + 1, math.floor((tonumber(endFrame) or sourceFrame + 1) + 0.5))
	local value = timeline:getTrackValueAtFrame(track.path, sourceFrame)
	local ok, nextValue, message = SoundTimelineService.withStopFrame(track.instance, value, sourceFrame, endFrame, timeline:getFps())
	if not ok then
		refreshUi(message)
		return false, message
	end

	pushUndo("Set Audio Stop")
	ChangeHistoryService:SetWaypoint("Before Set Audio Stop")
	local success, setMessage = timeline:setTrackValueAtFrame(track.path, sourceFrame, nextValue)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(setMessage or "Could not set audio stop.")
		return false, setMessage
	end

	setSingleSelectedKey(track.path, sourceFrame)
	timeline:applyCurrentFrame()
	ChangeHistoryService:SetWaypoint("After Set Audio Stop")
	refreshUi(message)
	return true, message
end

function editorActions.previewSoundKeyframeValue(trackPath, value)
	local track = timeline:getTrackByPath(trackPath)
	if not track or track.trackType ~= "Sound" or type(value) ~= "table" then
		refreshUi("Sound preview failed: select a Sound track/keyframe first.")
		return
	end
	timeline:previewTrackValue(track.path, value)
	if track.instance and track.instance.Parent and track.instance:IsA("Sound") then
		local ok = SoundTimelineService.play(track.instance, value)
		refreshUi(ok and ("Playing sound preview: " .. tostring(track.name or "Sound")) or "Sound preview failed: check SoundId and track instance.")
	else
		refreshUi("Sound preview failed: Sound instance is missing from the track.")
	end
end

function editorActions.cancelSoundKeyframePreview(trackPath)
	local track = timeline:getTrackByPath(trackPath)
	if track and track.instance and track.instance.Parent and track.instance:IsA("Sound") then
		SoundTimelineService.stop(track.instance)
	end
	timeline:applyCurrentFrame()
end

function editorActions.undoLastEdit()
	local success, message = historyService:performUndo(createEditorSnapshot, restoreEditorSnapshot)
	if success then
		markProjectDirty()
	end
	refreshUi(message)
end

function editorActions.redoLastEdit()
	local success, message = historyService:performRedo(createEditorSnapshot, restoreEditorSnapshot)
	if success then
		markProjectDirty()
	end
	refreshUi(message)
end

function editorActions.setGizmoMode(mode)
	editorActions._persistentTrackballMode = nil
	editorActions._requestedTrackballMode = nil
	editorActions.resumeViewportRigPartPicker()
	clearStudioSelectionForViewportTool()
	if editorActions._trackballTool and type(editorActions._trackballTool.SetSticky) == "function" then
		editorActions._trackballTool:SetSticky(false)
	end
	if editorActions._trackballTool and type(editorActions._trackballTool.IsActive) == "function" and editorActions._trackballTool:IsActive() then
		editorActions._trackballTool:Cancel()
	end
	gizmoController:setSuppressed(false)
	gizmoController:setMode(mode)
	refreshUi(string.format("%s gizmo enabled.", mode))
end

function editorActions.toggleRotateSpace()
	local nextSpace = gizmoController:getRotateSpace() == "World" and "Local" or "World"
	gizmoController:setRotateSpace(nextSpace)
	refreshUi(nextSpace == "World" and "World Move/Rotate enabled. Transform readout turns orange." or "Local Move/Rotate enabled.")
end

function editorActions.toggleGizmoMode()
	local nextMode = gizmoController:getMode() == "Rotate" and "Move" or "Rotate"
	editorActions.setGizmoMode(nextMode)
end

function editorActions.isWorkspaceGrabActive()
	return editorActions._workspaceGrabController ~= nil
		and type(editorActions._workspaceGrabController.IsActive) == "function"
		and editorActions._workspaceGrabController:IsActive()
end

function editorActions.captureWorkspaceGrabKeyframe(target)
	return require(Modules:WaitForChild("WorkspaceGrabKeyframeSupport")).capture({
		timeline = timeline,
		target = target,
		pushUndo = pushUndo,
		discardPendingUndo = function()
			historyService:discardPendingUndo()
		end,
		changeHistoryService = ChangeHistoryService,
	})
end

function editorActions._ensureWorkspaceGrabController()
	if editorActions._workspaceGrabController then
		return editorActions._workspaceGrabController
	end
	editorActions._workspaceGrabController = require(Modules:WaitForChild("WorkspaceGrabController")).new(plugin, function(state)
		state = type(state) == "table" and state or {}
		if state.reason == "DragCompleted" then
			local _, keyframeMessage = editorActions.captureWorkspaceGrabKeyframe(state.target)
			state.message = keyframeMessage or state.message
		end
		if state.active == true then
			gizmoController:setSuppressed(true)
			if type(gizmoController.setHandleVisualsHidden) == "function" then
				gizmoController:setHandleVisualsHidden(true)
			end
			pcall(function()
				require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
			end)
			pcall(function()
				require(Modules:WaitForChild("RigPartHighlightService")).clear()
			end)
		end
		if state.reason == "ExternalDeactivation" then
			if type(widgetController._setWorkspaceGrabButtonActive) == "function" then
				widgetController:_setWorkspaceGrabButtonActive(false)
			end
			if type(widgetController._setShortcutHint) == "function" then
				widgetController:_setShortcutHint(state.message)
			end
			editorActions._refreshMicroWorkspace()
			return
		end
		refreshUi(state.message)
		editorActions._refreshMicroWorkspace()
	end)
	return editorActions._workspaceGrabController
end

function editorActions.releaseWorkspaceGrab(message, reason)
	local controller = editorActions._workspaceGrabController
	if not controller
		or type(controller.IsActive) ~= "function"
		or not controller:IsActive() then
		return false, message or "Free Grab is already off."
	end
	return controller:Release(message, reason)
end

function editorActions.releaseWorkspaceGrabFromPluginUi(message, reason)
	if os.clock() &lt;= (editorActions._workspaceGrabPluginUiGraceUntil or 0) then
		return false, nil
	end
	return editorActions.releaseWorkspaceGrab(
		message or "Free Grab turned off because you returned to 7kg2.",
		reason or "PluginUiFocused"
	)
end

function editorActions.toggleWorkspaceGrab()
	local controller = editorActions._ensureWorkspaceGrabController()
	if controller:IsActive() then
		return controller:Release()
	end

	local recorder = editorActions._motionRecorder
	if recorder and (recorder:IsArmed() or recorder:IsRecording()) then
		local message = "Stop or cancel Record Motion before arming Free Grab."
		refreshUi(message)
		editorActions._refreshMicroWorkspace()
		return false, message
	end

	editorActions._persistentTrackballMode = nil
	editorActions._requestedTrackballMode = nil
	if editorActions._trackballTool and type(editorActions._trackballTool.SetSticky) == "function" then
		editorActions._trackballTool:SetSticky(false)
	end
	if editorActions._trackballTool
		and type(editorActions._trackballTool.IsActive) == "function"
		and editorActions._trackballTool:IsActive()
		and type(editorActions._trackballTool.Cancel) == "function" then
		editorActions._trackballTool:Cancel()
	end
	gizmoController:setSuppressed(true)
	if type(gizmoController.setHandleVisualsHidden) == "function" then
		gizmoController:setHandleVisualsHidden(true)
	end
	pcall(function()
		require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
	end)
	pcall(function()
		require(Modules:WaitForChild("RigPartHighlightService")).clear()
	end)
	local armed, message = controller:Arm()
	if armed then
		editorActions._workspaceGrabPluginUiGraceUntil = os.clock() + 0.35
	end
	return armed, message
end

function editorActions.isViewportGizmoPointerOverHandle(point)
	local dragActive = editorActions._viewportGizmoDragActive == true
	if dragActive then
		return true
	end
	if point ~= nil then
		return gizmoController
			and type(gizmoController.IsPointerOverHandle) == "function"
			and gizmoController:IsPointerOverHandle(point) == true
	end
	local keepAlive = os.clock() &lt;= (editorActions._viewportGizmoKeepAliveUntil or 0)
	if keepAlive then
		return true
	end
	local over = gizmoController
		and type(gizmoController.IsPointerOverHandle) == "function"
		and gizmoController:IsPointerOverHandle(point) == true
	return over
end

function editorActions.isViewportGizmoDragActive()
	return editorActions._viewportGizmoDragActive == true
end

function editorActions.hasViewportGizmoTarget()
	if not gizmoController then
		return false
	end
	if type(gizmoController.hasViewportTarget) == "function" and gizmoController:hasViewportTarget() == true then
		return true
	end
	return type(gizmoController.hasTrackViewportTarget) == "function"
		and gizmoController:hasTrackViewportTarget() == true
end

function editorActions.keepViewportGizmoOwnership()
	editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
	pcall(function()
		plugin:Activate(true)
	end)
	return true, "7kg2 viewport gizmo active."
end

function editorActions._ensureMotionRecorder()
	if editorActions._motionRecorder then
		return editorActions._motionRecorder
	end
	local loaded, serviceModule = pcall(function()
		return require(Modules:WaitForChild("MotionRecorderService"))
	end)
	if not loaded then
		refreshUi("Motion Recorder failed to load: " .. tostring(serviceModule))
		return nil
	end
	editorActions._motionRecorder = serviceModule.new({
		timeline = timeline,
	})
	return editorActions._motionRecorder
end

function editorActions._recordMotionSessionBegin(session)
	editorActions._motionRecorderActiveSession = session
end

function editorActions._startMotionRecorderSession(session, recorder)
	recorder = recorder or editorActions._motionRecorder
	editorActions._debugRecordMotion("start-session-enter", {
		hasRecorder = recorder ~= nil,
		armed = recorder and recorder:IsArmed() or false,
		recording = recorder and recorder:IsRecording() or false,
		hasSession = session ~= nil,
	})
	if not recorder or not recorder:IsArmed() then
		return false
	end
	if not recorder:BeginSession(session) then
		editorActions._debugRecordMotion("start-session-failed")
		return false
	end
	editorActions._motionRecorderArmedClock = nil
	editorActions._debugRecordMotion("start-session-recording")
	refreshUi("Motion Recorder is recording. Release Trackball to save, or keep moving for up to 10 seconds.")
	editorActions._refreshMicroWorkspace()

	local token = {}
	editorActions._motionRecorderToken = token
	editorActions._motionRecorderActiveSession = session
	task.spawn(function()
		while editorActions._motionRecorderToken == token
			and editorActions._motionRecorder == recorder
			and recorder:IsRecording() do
			recorder:Sample(session)
			task.wait(1 / 24)
		end
	end)
	task.delay(recorder:GetMaxDuration(), function()
		if editorActions._motionRecorderToken == token
			and editorActions._motionRecorder == recorder
			and recorder:IsRecording()
			and editorActions._trackballTool
			and editorActions._trackballTool:IsActive() then
			editorActions._trackballTool:Commit()
		end
	end)
	return true
end

function editorActions._recordMotionDragBegin(session)
	editorActions._debugRecordMotion("drag-begin", {
		hasSession = session ~= nil,
	})
	editorActions._startMotionRecorderSession(session)
end

function editorActions._recordMotionPreview(session)
	if editorActions._motionRecorder then
		editorActions._motionRecorder:Sample(session)
	end
end

function editorActions._recordMotionBeforeCommit(session)
	local recorder = editorActions._motionRecorder
	if recorder then
		editorActions._debugRecordMotion("before-commit", {
			armed = recorder:IsArmed(),
			recording = recorder:IsRecording(),
			hasSession = session ~= nil,
		})
		if recorder:IsArmed() then
			local armedClock = tonumber(editorActions._motionRecorderArmedClock) or 0
			if armedClock &gt; 0 and os.clock() - armedClock &lt; 0.6 then
				editorActions._debugRecordMotion("before-commit-skip-startup-grace", {
					age = os.clock() - armedClock,
				})
				return
			end
			editorActions._startMotionRecorderSession(session, recorder)
		end
		recorder:Sample(session, true)
		if recorder:IsRecording() and session and type(session.SkipNextCommitWrite) == "function" then
			session:SkipNextCommitWrite("Motion Recorder is saving sampled Trackball keys.")
		end
	end
end

function editorActions._getRecordableMotionMotor(path)
	local motor = path and timeline:getMotorByPath(path) or nil
	if not motor then
		return nil
	end
	local name = tostring(motor.name or (motor.instance and motor.instance.Name) or "")
	if name == "Root" or name == "RootJoint" or name == "HumanoidRootPart" then
		return nil
	end
	return motor
end

function editorActions._getRecordableMotionPaths(paths)
	local recordPaths = {}
	local seen = {}
	local function addRecordPath(path)
		if type(path) == "string" and not seen[path] and editorActions._getRecordableMotionMotor(path) then
			seen[path] = true
			table.insert(recordPaths, path)
		end
	end
	for _, path in ipairs(type(paths) == "table" and paths or {}) do
		local track = type(path) == "string" and timeline:getTrackByPath(path) or nil
		if track and track.trackType == "Rig Group" and track.rigName and type(timeline.getRigTrackPaths) == "function" then
			for _, rigPath in ipairs(timeline:getRigTrackPaths(track.rigName) or {}) do
				addRecordPath(rigPath)
			end
		else
			addRecordPath(path)
		end
	end
	return recordPaths
end

function editorActions._sameMotionRecordPaths(left, right)
	if type(left) ~= "table" or type(right) ~= "table" or #left ~= #right then
		return false
	end
	local seen = {}
	for _, path in ipairs(left) do
		seen[path] = true
	end
	for _, path in ipairs(right) do
		if not seen[path] then
			return false
		end
	end
	return true
end

function editorActions._getActiveTrackballRecordPaths()
	local tool = editorActions._trackballTool
	if not (tool and tool:IsActive() and type(tool.GetTargetPaths) == "function") then
		return nil
	end
	local paths = tool:GetTargetPaths()
	local recordPaths = editorActions._getRecordableMotionPaths(paths)
	if #recordPaths &gt; 0 then
		return recordPaths
	end
	return nil
end

function editorActions._getSelectedMotionRecordKeyFrame()
	local selectedKeyRefs = getSelectedKeyRefs()
	local sharedFrame = nil
	local count = 0
	for _, keyRef in ipairs(selectedKeyRefs) do
		if editorActions._getRecordableMotionMotor(keyRef.jointPath) then
			local frame = math.max(0, math.floor(keyRef.frame or 0))
			if sharedFrame == nil then
				sharedFrame = frame
			elseif sharedFrame ~= frame then
				return nil
			end
			count += 1
		end
	end
	return count &gt; 0 and sharedFrame or nil
end

function editorActions._getSelectedMotionRecordPaths()
	local selectedKeyRefs = getSelectedKeyRefs()
	if #selectedKeyRefs &gt; 0 then
		local recordPaths = {}
		local seen = {}
		local sharedFrame = nil
		for _, keyRef in ipairs(selectedKeyRefs) do
			local path = keyRef.jointPath
			if editorActions._getRecordableMotionMotor(path) then
				local frame = math.max(0, math.floor(keyRef.frame or 0))
				if sharedFrame == nil then
					sharedFrame = frame
				elseif sharedFrame ~= frame then
					return {}
				end
				if not seen[path] then
					seen[path] = true
					table.insert(recordPaths, path)
				end
			end
		end
		if #recordPaths &gt; 0 then
			return recordPaths
		end
	end

	local selectedPaths = editorActions._getRecordableMotionPaths(getSelectedTrackPaths())
	if #selectedPaths &gt; 0 then
		return selectedPaths
	end
	if selectedJointPath then
		return editorActions._getRecordableMotionPaths({ selectedJointPath })
	end
	return {}
end

function editorActions.recordMotion()
	local activeRecordPaths = editorActions._getActiveTrackballRecordPaths()
	local recordPaths = activeRecordPaths or editorActions._getSelectedMotionRecordPaths()
	local existingRecorder = editorActions._motionRecorder
	local now = os.clock()
	editorActions._debugRecordMotion("recordMotion-enter", {
		activeRecordPaths = activeRecordPaths and #activeRecordPaths or "nil",
		recordPaths = #recordPaths,
		selectedJointPath = selectedJointPath,
		existingArmed = existingRecorder and existingRecorder:IsArmed() or false,
		existingRecording = existingRecorder and existingRecorder:IsRecording() or false,
		trackballActive = editorActions._trackballTool and editorActions._trackballTool:IsActive() or false,
		micro = widget:GetAttribute("MegMoHiddenForMicro") == true,
	})
	if existingRecorder and (existingRecorder:IsArmed() or existingRecorder:IsRecording()) then
		local lastToggle = tonumber(editorActions._motionRecorderLastToggleClock) or 0
		if now - lastToggle &lt; 0.4 then
			editorActions._debugRecordMotion("recordMotion-duplicate-sink", {
				age = now - lastToggle,
			})
			refreshUi(existingRecorder:IsRecording()
				and "Motion Recorder is recording. Release Trackball to save."
				or "Motion Recorder armed. Drag the Trackball to start recording.")
			editorActions._refreshMicroWorkspace()
			return
		end
		editorActions._motionRecorderLastToggleClock = now
		editorActions._debugRecordMotion("recordMotion-toggle-cancel")
		existingRecorder:Cancel()
		editorActions._motionRecorderCountdownActive = false
		editorActions._motionRecorderToken = nil
		editorActions._motionRecorderActiveSession = nil
		editorActions._motionRecorderArmedClock = nil
		refreshUi("Motion Recorder cancelled.")
		editorActions._refreshMicroWorkspace()
		return
	end
	editorActions._motionRecorderLastToggleClock = now

	if #recordPaths == 0 then
		editorActions._debugRecordMotion("recordMotion-no-record-paths")
		refreshUi("Motion Recorder records body-part tracks only. Select one or more same-frame body-part keyframes or tracks first.")
		return
	end
	local recordPath = recordPaths[1]
	local recordFrame = activeRecordPaths and timeline:getCurrentFrame() or (editorActions._getSelectedMotionRecordKeyFrame() or timeline:getCurrentFrame())
	local useActiveTrackball = activeRecordPaths and editorActions._sameMotionRecordPaths(activeRecordPaths, recordPaths)
	if editorActions._trackballTool and editorActions._trackballTool:IsActive() and not useActiveTrackball then
		editorActions._debugRecordMotion("recordMotion-cancel-other-trackball")
		editorActions._trackballTool:Cancel()
	end
	local recorder = editorActions._ensureMotionRecorder()
	if not recorder then
		editorActions._debugRecordMotion("recordMotion-no-recorder")
		return
	end

	for _, path in ipairs(recordPaths) do
		if not timeline:getMotorByPath(path) then
			editorActions._debugRecordMotion("recordMotion-missing-motor", {
				path = path,
			})
			refreshUi("One of the Motion Recorder targets was removed before recording started.")
			return
		end
	end

	if not activeRecordPaths and recordFrame ~= timeline:getCurrentFrame() then
		editorActions._debugRecordMotion("recordMotion-set-frame", {
			frame = recordFrame,
			currentFrame = timeline:getCurrentFrame(),
		})
		timeline:setCurrentFrame(recordFrame)
		timeline:applyCurrentFrame()
	end

	selectedJointPath = recordPath
	selectedTrackPaths = {}
	for _, path in ipairs(recordPaths) do
		selectedTrackPaths[path] = true
	end
	local ok, message = recorder:Arm({
		startFrame = recordFrame,
		fps = timeline:getFps(),
		durationSeconds = 10,
		sampleRate = 24,
		targetPaths = recordPaths,
	})
	if not ok then
		editorActions._debugRecordMotion("recordMotion-arm-failed", {
			message = message,
		})
		refreshUi(message)
		return
	end
	editorActions._motionRecorderArmedClock = os.clock()
	editorActions._debugRecordMotion("recordMotion-armed", {
		frame = recordFrame,
		paths = #recordPaths,
	})
	editorActions._refreshMicroWorkspace()

	local mode = editorActions._lastTrackballMode or editorActions._persistentTrackballMode or "Rotate"
	local recordSelection = #recordPaths &gt; 1
		and { paths = recordPaths, frame = recordFrame }
		or { path = recordPath, frame = recordFrame }
	if editorActions._trackballTool and editorActions._trackballTool:IsActive() then
		local paths = type(editorActions._trackballTool.GetTargetPaths) == "function" and editorActions._trackballTool:GetTargetPaths() or {}
		editorActions._debugRecordMotion("recordMotion-existing-trackball", {
			paths = #paths,
		})
		if not editorActions._sameMotionRecordPaths(editorActions._getRecordableMotionPaths(paths), recordPaths) then
			recorder:Cancel()
			editorActions._motionRecorderArmedClock = nil
			editorActions._debugRecordMotion("recordMotion-existing-trackball-target-mismatch")
			refreshUi("Motion Recorder target changed. Select the body part tracks and try again.")
			return
		end
		refreshUi(string.format("Motion Recorder armed for %d track%s. Drag the active Trackball to start recording.", #recordPaths, #recordPaths == 1 and "" or "s"))
		editorActions._refreshMicroWorkspace()
		return
	end

	editorActions._motionRecorderStartingTrackball = true
	editorActions._debugRecordMotion("recordMotion-start-trackball", {
		mode = mode,
		paths = #recordPaths,
	})
	local trackballStarted, trackballError = pcall(function()
		editorActions.beginTrackballMode(mode, recordSelection, {
			sticky = true,
		})
	end)
	editorActions._motionRecorderStartingTrackball = nil
	editorActions._debugRecordMotion("recordMotion-start-trackball-result", {
		ok = trackballStarted,
		active = editorActions._trackballTool and editorActions._trackballTool:IsActive() or false,
		error = trackballError,
	})
	if not trackballStarted then
		recorder:Cancel()
		editorActions._motionRecorderArmedClock = nil
		refreshUi("Motion Recorder could not start the Trackball tool: " .. tostring(trackballError))
		editorActions._refreshMicroWorkspace()
		return
	end
	if not (editorActions._trackballTool and editorActions._trackballTool:IsActive()) then
		recorder:Cancel()
		editorActions._motionRecorderArmedClock = nil
		editorActions._debugRecordMotion("recordMotion-trackball-not-active")
		refreshUi("Motion Recorder could not start the Trackball tool.")
		return
	end
	if not editorActions._persistentTrackballMode then
		editorActions._persistentTrackballMode = mode
	end

	refreshUi(string.format("Motion Recorder armed for %d track%s. Move the Trackball to start recording; release to save early.", #recordPaths, #recordPaths == 1 and "" or "s"))
	editorActions._debugRecordMotion("recordMotion-ready", {
		armed = recorder:IsArmed(),
		recording = recorder:IsRecording(),
	})
	editorActions._refreshMicroWorkspace()
end

function editorActions._rearmPersistentTrackball(preferredSelection)
	local mode = editorActions._persistentTrackballMode
	if not mode then
		return
	end
	if editorActions._trackballTool and editorActions._trackballTool:IsActive() then
		return
	end
	local rearmSupport = require(Modules:WaitForChild("PersistentTrackballRearmSupport"))
	local rearmSelection = rearmSupport.copySelection(timeline, preferredSelection)
		or rearmSupport.copySelection(timeline, editorActions._lastTrackballSelection)
	if not rearmSelection then
		if selectedJointPath and timeline:getTrackByPath(selectedJointPath) then
			rearmSelection = {
				path = selectedJointPath,
				frame = timeline:getCurrentFrame(),
			}
		end
	end
	if not rearmSelection then
		editorActions._persistentTrackballMode = nil
		editorActions._requestedTrackballMode = nil
		editorActions._lastTrackballSelection = nil
		gizmoController:setSuppressed(false)
		refreshSelectedGizmo()
		return
	end
	editorActions._lastTrackballSelection = rearmSupport.copySelection(timeline, rearmSelection)
	editorActions.beginTrackballMode(mode, rearmSelection, {
		sticky = true,
		rearm = true,
	})
end

function editorActions.setTrackballAxis(axis)
	if not editorActions._trackballTool
		or type(editorActions._trackballTool.IsActive) ~= "function"
		or not editorActions._trackballTool:IsActive() then
		return false
	end
	if type(editorActions._trackballTool.SetAxis) ~= "function" then
		return false
	end
	return true, editorActions._trackballTool:SetAxis(axis)
end

function editorActions.getTrackballAxis()
	if not editorActions._trackballTool
		or type(editorActions._trackballTool.IsActive) ~= "function"
		or not editorActions._trackballTool:IsActive()
		or type(editorActions._trackballTool.GetAxis) ~= "function" then
		return nil
	end
	return editorActions._trackballTool:GetAxis()
end

function editorActions.beginTrackballMode(mode, forcedSelection, options)
	editorActions._lastTrackballMode = mode or editorActions._lastTrackballMode or "Rotate"
	editorActions._requestedTrackballMode = editorActions._lastTrackballMode
	options = options or {}
	editorActions.resumeViewportRigPartPicker()
	clearStudioSelectionForViewportTool()
	local shouldPersist = options.sticky == true or (options.sticky ~= false and forcedSelection == nil)
	local trackballSelection = nil
	if type(forcedSelection) == "table" and (forcedSelection.path or forcedSelection.paths) then
		trackballSelection = forcedSelection
	end
	if trackballSelection and trackballSelection.path and not trackballSelection.paths then
		trackballSelection = require(Modules:WaitForChild("PersistentTrackballSelectionSupport")).buildSelection(trackballSelection.path, timeline, getSelectedTrackPaths())
	end
	local selectedKeyRefs = trackballSelection and {} or getSelectedKeyRefs()
	if not trackballSelection and #selectedKeyRefs == 1 then
		local keyRef = selectedKeyRefs[1]
		if keyRef and keyRef.jointPath then
			trackballSelection = {
				path = keyRef.jointPath,
				frame = math.max(0, math.floor(keyRef.frame or timeline:getCurrentFrame())),
			}
		end
	elseif not trackballSelection and #selectedKeyRefs &gt; 1 then
		local sharedFrame = math.max(0, math.floor(selectedKeyRefs[1].frame or 0))
		local selectedPaths = {}
		local seenPaths = {}
		for _, keyRef in ipairs(selectedKeyRefs) do
			local frame = math.max(0, math.floor(keyRef.frame or 0))
			if frame ~= sharedFrame then
				refreshUi("Multi Trackball works only when selected rig keyframes are on the same frame.")
				return
			end
			if not timeline:getMotorByPath(keyRef.jointPath) then
				refreshUi("Multi Trackball currently supports rig joint keyframes only.")
				return
			end
			if not seenPaths[keyRef.jointPath] then
				seenPaths[keyRef.jointPath] = true
				table.insert(selectedPaths, keyRef.jointPath)
			end
		end

		if #selectedPaths &gt; 1 then
			timeline:setCurrentFrame(sharedFrame)
			timeline:applyCurrentFrame()
			trackballSelection = {
				paths = selectedPaths,
				frame = sharedFrame,
			}
		end
	end
	if not trackballSelection then
		local selectedPaths = getSelectedTrackPaths()
		if #selectedPaths == 1 then
			local selectedTrack = timeline:getTrackByPath(selectedPaths[1])
			if selectedTrack and selectedTrack.trackType == "Rig Group" then
				local rigPaths = timeline:getRigTrackPaths(selectedTrack.rigName)
				if #rigPaths &gt; 1 then
					trackballSelection = {
						paths = rigPaths,
						frame = timeline:getCurrentFrame(),
					}
				elseif #rigPaths == 1 then
					trackballSelection = {
						path = rigPaths[1],
						frame = timeline:getCurrentFrame(),
					}
				end
			elseif selectedTrack then
				trackballSelection = {
					path = selectedPaths[1],
					frame = timeline:getCurrentFrame(),
				}
			end
		elseif #selectedPaths &gt; 1 then
			local rigPaths = {}
			for _, selectedPath in ipairs(selectedPaths) do
				if timeline:getMotorByPath(selectedPath) then
					table.insert(rigPaths, selectedPath)
				end
			end
			if #rigPaths &gt; 1 then
				trackballSelection = {
					paths = rigPaths,
					frame = timeline:getCurrentFrame(),
				}
			end
		end
	end

	if not trackballSelection and widgetController._viewportMultiTrackPaths then
		local rigPaths = {}
		for path, enabled in pairs(widgetController._viewportMultiTrackPaths) do
			if enabled and timeline:getMotorByPath(path) then
				table.insert(rigPaths, path)
			end
		end
		if #rigPaths &gt; 1 then
			trackballSelection = {
				paths = rigPaths,
				frame = timeline:getCurrentFrame(),
			}
		end
	end

	if not trackballSelection then
		trackballSelection = require(Modules:WaitForChild("PersistentTrackballRearmSupport")).copySelection(timeline, editorActions._lastTrackballSelection)
	end

	if not trackballSelection then
		if not selectedJointPath or not timeline:getTrackByPath(selectedJointPath) then
			refreshUi("Select a rig joint, object CFrame, rig CFrame, or camera track before using Trackball Pose Mode.")
			return
		end
		local selectedTrack = timeline:getTrackByPath(selectedJointPath)
		if selectedTrack and selectedTrack.trackType == "Rig Group" then
			local rigPaths = timeline:getRigTrackPaths(selectedTrack.rigName)
			if #rigPaths &gt; 1 then
				trackballSelection = {
					paths = rigPaths,
					frame = timeline:getCurrentFrame(),
				}
			elseif #rigPaths == 1 then
				trackballSelection = {
					path = rigPaths[1],
					frame = timeline:getCurrentFrame(),
				}
			end
		end
	end

	if not trackballSelection then
		trackballSelection = {
			path = selectedJointPath,
			frame = timeline:getCurrentFrame(),
		}
	end
	local persistentTrackballSelection = require(Modules:WaitForChild("PersistentTrackballRearmSupport")).copySelection(timeline, trackballSelection)

	if not editorActions._trackballTool then
		local loaded, toolModule = pcall(function()
			return require(Modules:WaitForChild("TrackballTool"))
		end)
		if not loaded then
			refreshUi("Trackball Pose Mode failed to load: " .. tostring(toolModule))
			return
		end

		editorActions._trackballTool = toolModule.new({
			plugin = plugin,
			timeline = timeline,
			beginUndo = function(label)
				pushUndo(label or "Trackball Pose")
				ChangeHistoryService:SetWaypoint("Before Trackball Pose")
			end,
			finishUndo = function()
				ChangeHistoryService:SetWaypoint("After Trackball Pose")
			end,
			discardUndo = function()
				historyService:discardPendingUndo()
			end,
			getMoveSnap = function()
				return gizmoController:getMoveSnap()
			end,
			getRotateSnapDegrees = function()
				return gizmoController:getRotateSnapDegrees()
			end,
			onActiveChanged = function(active)
				gizmoController:setSuppressed(active or editorActions._persistentTrackballMode ~= nil)
			end,
			onSessionBegin = editorActions._recordMotionSessionBegin,
			onDragBegin = editorActions._recordMotionDragBegin,
			onPreview = editorActions._recordMotionPreview,
			onBeforeCommit = editorActions._recordMotionBeforeCommit,
			shouldYieldRightMouse = function()
				local recorder = editorActions._motionRecorder
				return recorder ~= nil and (recorder:IsArmed() or recorder:IsRecording())
			end,
			onViewportPick = function(mouse, mousePosition, onlyDifferent)
				return editorActions.selectRigPartFromViewportMouse(mouse, mousePosition, onlyDifferent)
			end,
			onCommit = function(result, message)
				local recorder = editorActions._motionRecorder
				editorActions._debugRecordMotion("trackball-onCommit", {
					message = message,
					hasResult = result ~= nil,
					recorderArmed = recorder and recorder:IsArmed() or false,
					recorderRecording = recorder and recorder:IsRecording() or false,
				})
				if recorder and recorder:IsRecording() then
					if editorActions._motionRecorderActiveSession then
						recorder:Sample(editorActions._motionRecorderActiveSession, true)
					end
					local recorded, recorderMessage, recorderKeys = recorder:Finish()
					editorActions._motionRecorderToken = nil
					editorActions._motionRecorderActiveSession = nil
					editorActions._motionRecorderArmedClock = nil
					if recorded and recorderKeys and #recorderKeys &gt; 0 then
						result = {
							keys = recorderKeys,
							frame = recorderKeys[#recorderKeys].frame,
						}
						message = recorderMessage
					else
						local summary = type(recorder.GetDebugSummary) == "function" and recorder:GetDebugSummary() or "no recorder details"
						message = (recorderMessage or message) .. " (" .. summary .. ")"
						timeline:applyCurrentFrame()
					end
				elseif recorder and recorder:IsArmed() then
					local armedClock = tonumber(editorActions._motionRecorderArmedClock) or 0
					if armedClock &gt; 0 and os.clock() - armedClock &lt; 0.6 then
						editorActions._debugRecordMotion("trackball-onCommit-preserve-armed", {
							age = os.clock() - armedClock,
						})
						message = "Motion Recorder armed. Drag the Trackball to start recording."
					else
						editorActions._debugRecordMotion("trackball-onCommit-cancel-armed", {
							age = armedClock &gt; 0 and os.clock() - armedClock or "nil",
						})
						recorder:Cancel()
						editorActions._motionRecorderToken = nil
						editorActions._motionRecorderActiveSession = nil
						editorActions._motionRecorderArmedClock = nil
						message = "Motion Recorder was armed but did not receive Trackball movement before release."
					end
				end
				if result and result.keys and #result.keys &gt; 0 then
					selectKeys(result.keys)
					selectedJointPath = result.keys[1].jointPath
					timeline:setCurrentFrame(result.frame or result.keys[1].frame)
					timeline:applyCurrentFrame()
				elseif result and result.path and result.frame then
					setSingleSelectedKey(result.path, result.frame)
					selectedJointPath = result.path
					selectedTrackPaths = {
						[result.path] = true,
					}
					timeline:setCurrentFrame(result.frame)
					timeline:applyCurrentFrame()
				end
				local rearmSelection = require(Modules:WaitForChild("PersistentTrackballRearmSupport")).fromResult(timeline, result)
				if rearmSelection then
					editorActions._lastTrackballSelection = rearmSelection
				end
				if editorActions._persistentTrackballMode then
					editorActions._rearmPersistentTrackball(rearmSelection)
					local expectedMode = editorActions._persistentTrackballMode
					task.defer(function()
						if expectedMode
							and editorActions._persistentTrackballMode == expectedMode
							and not editorActions.isPersistentTrackballActive() then
							editorActions._rearmPersistentTrackball(rearmSelection)
						end
					end)
				end
				refreshSelectedGizmo()
				refreshUi(message or "Trackball Pose keyframe saved.")
				editorActions._refreshMicroWorkspace()
			end,
			onCancel = function(message)
				local preserveRecorder = editorActions._motionRecorderStartingTrackball == true
				editorActions._debugRecordMotion("trackball-onCancel", {
					message = message,
					preserveRecorder = preserveRecorder,
					recorderArmed = editorActions._motionRecorder and editorActions._motionRecorder:IsArmed() or false,
					recorderRecording = editorActions._motionRecorder and editorActions._motionRecorder:IsRecording() or false,
				})
				if not preserveRecorder and editorActions._motionRecorder and (editorActions._motionRecorder:IsArmed() or editorActions._motionRecorder:IsRecording()) then
					editorActions._motionRecorder:Cancel()
				end
				if not preserveRecorder then
					editorActions._motionRecorderToken = nil
					editorActions._motionRecorderActiveSession = nil
					editorActions._motionRecorderArmedClock = nil
					editorActions._persistentTrackballMode = nil
					editorActions._requestedTrackballMode = nil
					if editorActions._trackballTool and type(editorActions._trackballTool.SetSticky) == "function" then
						editorActions._trackballTool:SetSticky(false)
					end
					gizmoController:setSuppressed(false)
				end
				refreshSelectedGizmo()
				refreshUi(message or "Trackball Pose Mode cancelled.")
				editorActions._refreshMicroWorkspace()
			end,
			onStatus = function(message)
				if message then
					refreshUi(message)
				end
			end,
		})
	end

	editorActions._trackballTool:SetMode(mode)
	if type(editorActions._trackballTool.SetSticky) == "function" then
		editorActions._trackballTool:SetSticky(shouldPersist)
	end
	local success, message = editorActions._trackballTool:Begin(trackballSelection)
	if success and shouldPersist then
		editorActions._persistentTrackballMode = mode
		editorActions._lastTrackballSelection = persistentTrackballSelection
		gizmoController:setSuppressed(true)
	end
	if not success then
		if type(editorActions._trackballTool.SetSticky) == "function" then
			editorActions._trackballTool:SetSticky(false)
		end
		if shouldPersist then
			editorActions._persistentTrackballMode = nil
			gizmoController:setSuppressed(false)
		end
		refreshUi(message)
	elseif not options.rearm then
		refreshUi(message or (mode .. " Trackball enabled."))
	end
end

function editorActions.selectRigInStudio()
	StudioSelectionActions.selectRigInStudio({
		timeline = timeline,
		selectedJointPath = selectedJointPath,
		selectionService = SelectionService,
		refreshUi = refreshUi,
	})
end

function editorActions.selectJointPartInStudio()
	StudioSelectionActions.selectJointPartInStudio({
		timeline = timeline,
		selectedJointPath = selectedJointPath,
		selectionService = SelectionService,
		refreshUi = refreshUi,
	})
end

function editorActions.setMoveSnap(studs)
	gizmoController:setMoveSnap(studs)
	refreshUi(string.format("Move snap set to %.3f studs.", gizmoController:getMoveSnap()))
end

function editorActions.setGizmoSizePercent(percent)
	local normalized = PluginSettings.saveGizmoSizePercent(plugin, percent)
	if not normalized then
		refreshUi("Enter a gizmo size between 60 and 140 percent.")
		return false, "Enter a gizmo size between 60 and 140 percent."
	end
	gizmoController:setSizePercent(normalized)
	refreshUi(string.format("Gizmo size set to %d%%.", gizmoController:getSizePercent()))
	return true, string.format("Gizmo size set to %d%%.", gizmoController:getSizePercent())
end

function editorActions.captureCameraTrackAtPlayhead()
	local selectedTrack = selectedJointPath and timeline:getTrackByPath(selectedJointPath) or nil
	local track = CameraTrackService.getPrimaryCameraTrack(timeline, selectedTrack)
	if not CameraTrackService.isCameraTrack(track) then
		refreshUi("Select a camera track before capturing the Studio camera.")
		return
	end

	local value = CameraTrackService.captureStudioCameraValue(track)
	if not value then
		refreshUi("Studio does not have an active camera to capture right now.")
		return
	end

	pushUndo("Capture Camera Keyframe")
	ChangeHistoryService:SetWaypoint("Before Capture Camera Keyframe")
	local success, message = timeline:setTrackValueAtFrame(track.path, timeline:getCurrentFrame(), value)
	if success then
		ChangeHistoryService:SetWaypoint("After Capture Camera Keyframe")
		setSingleSelectedTrack(track.path)
		timeline:applyCurrentFrame()
		refreshUi(string.format("Captured camera keyframe at frame %d.", timeline:getCurrentFrame()))
	else
		historyService:discardPendingUndo()
		refreshUi(message or "Could not capture the Studio camera.")
	end
end

function editorActions.toggleCameraTrackEnabled()
	local selectedTrack = selectedJointPath and timeline:getTrackByPath(selectedJointPath) or nil
	local track = CameraTrackService.getPrimaryCameraTrack(timeline, selectedTrack)
	if not CameraTrackService.isCameraTrack(track) then
		refreshUi("Add or select a Camera track before toggling camera playback.")
		return false, "Add or select a Camera track before toggling camera playback."
	end

	local disabled = not timeline:isTrackDisabled(track.path)
	local success, message = editorActions.toggleTrackEnabled(track.path, disabled)
	if not success then
		return false, message or "Could not toggle the Camera track."
	end
	return true, disabled and "Camera disabled." or "Camera enabled."
end

function editorActions.ensureCameraFovTrack()
	local selectedTrack = selectedJointPath and timeline:getTrackByPath(selectedJointPath) or nil
	local cameraTrack = CameraTrackService.getPrimaryCameraTrack(timeline, selectedTrack)
	if not CameraTrackService.isCameraTrack(cameraTrack) then
		refreshUi("Select a camera track before adding an FOV track.")
		return
	end

	pushUndo("Add Camera FOV Track")
	local fovTrack, wasAdded, message = CameraTrackService.ensureFovTrack(timeline)
	if not fovTrack then
		historyService:discardPendingUndo()
		refreshUi(message or "Could not create the Camera FOV track.")
		return
	end

	if not wasAdded then
		historyService:discardPendingUndo()
	end
	setSingleSelectedTrack(fovTrack.path)
	refreshUi(message or "Selected the Camera FOV track.")
end

function editorActions.applySelectedCameraFov(input)
	local selectedTrack = selectedJointPath and timeline:getTrackByPath(selectedJointPath) or nil
	local cameraTrack = CameraTrackService.getPrimaryCameraTrack(timeline, selectedTrack)
	if not CameraTrackService.isCameraTrack(cameraTrack) then
		refreshUi("Select a camera track before setting FOV.")
		return
	end

	local fov = tonumber(input)
	if not fov then
		refreshUi("Enter a valid camera FOV first.")
		return
	end

	local fovTrack = CameraTrackService.isCameraPropertyTrack(selectedTrack) and selectedTrack or nil
	if not fovTrack then
		fovTrack = CameraTrackService.ensureFovTrack(timeline)
	end
	if type(fovTrack) ~= "table" then
		refreshUi("Could not create the Camera FOV track.")
		return
	end
	local value = math.clamp(fov, 1, 120)

	pushUndo("Set Camera FOV")
	ChangeHistoryService:SetWaypoint("Before Set Camera FOV")
	local success, message = timeline:setTrackValueAtFrame(fovTrack.path, timeline:getCurrentFrame(), value)
	if success then
		ChangeHistoryService:SetWaypoint("After Set Camera FOV")
		setSingleSelectedTrack(fovTrack.path)
		timeline:applyCurrentFrame()
		refreshUi(string.format("Set camera FOV to %.2f at frame %d.", value, timeline:getCurrentFrame()))
	else
		historyService:discardPendingUndo()
		refreshUi(message or "Could not set the camera FOV.")
	end
end

function editorActions.applyCameraRotation(xInput, yInput, zInput, preferredTrackPath)
	local selectedTrack = preferredTrackPath and timeline:getTrackByPath(preferredTrackPath) or nil
	if not selectedTrack then
		selectedTrack = selectedJointPath and timeline:getTrackByPath(selectedJointPath) or nil
	end
	local track = CameraTrackService.getPrimaryCameraTrack(timeline, selectedTrack)
	if not CameraTrackService.isCameraTrack(track) then
		refreshUi("Select a camera track before setting camera rotation.")
		return false
	end

	local x = tonumber(xInput)
	local y = tonumber(yInput)
	local z = tonumber(zInput)
	if not (x and y and z) then
		refreshUi("Enter valid X, Y, and Z camera rotation values.")
		return false
	end

	local currentValue = CameraTrackService.captureStudioCameraValue(track)
	if not currentValue or typeof(currentValue.cframe) ~= "CFrame" then
		refreshUi("Studio does not have an active camera to rotate.")
		return false
	end

	local focusDistance = 16
	if typeof(currentValue.focus) == "CFrame" then
		focusDistance = math.max(0.1, (currentValue.focus.Position - currentValue.cframe.Position).Magnitude)
	end
	local cframe = CFrame.new(currentValue.cframe.Position) * CFrame.fromOrientation(math.rad(x), math.rad(y), math.rad(z))
	local value = {
		cframe = cframe,
		focus = CFrame.new(cframe.Position + cframe.LookVector * focusDistance),
		fieldOfView = currentValue.fieldOfView,
	}
	local camera = CameraTrackService.getCameraForTrack(track)
	if camera and camera.CameraType == Enum.CameraType.Fixed and math.abs(z) &gt; 0.001 then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	pushUndo("Set Camera Rotation")
	ChangeHistoryService:SetWaypoint("Before Set Camera Rotation")
	local frame = timeline:getCurrentFrame()
	local success, message = timeline:setTrackValueAtFrame(track.path, frame, value, "Linear", "InOut")
	if success then
		ChangeHistoryService:SetWaypoint("After Set Camera Rotation")
		setSingleSelectedTrack(track.path)
		timeline:applyCurrentFrame()
		if camera then
			if camera.CameraType == Enum.CameraType.Fixed and math.abs(z) &gt; 0.001 then
				camera.CameraType = Enum.CameraType.Scriptable
			end
			camera.CFrame = value.cframe
			camera.Focus = value.focus
			if value.fieldOfView then
				camera.FieldOfView = value.fieldOfView
			end
		end
		refreshUi(string.format("Set camera rotation to X %.2f, Y %.2f, Z %.2f at frame %d.", x, y, z, frame))
		return true
	end

	historyService:discardPendingUndo()
	refreshUi(message or "Could not set camera rotation.")
	return false
end

function editorActions.applyCameraPreset(presetId, options)
	local selectedTrack = selectedJointPath and timeline:getTrackByPath(selectedJointPath) or nil
	local track = CameraTrackService.getPrimaryCameraTrack(timeline, selectedTrack)
	local needsCameraTrack = not CameraTrackService.isCameraTrack(track)
	if needsCameraTrack then
		local sessionPreset = presetId == "FirstPersonAttach"
			or presetId == "FirstPersonDetach"
			or presetId == "CameraAttachSelection"
			or presetId == "CameraDetachSelection"
		if sessionPreset then
			refreshUi("Add or select a Camera track before using attached camera modes.")
			return false
		end

		local camera = workspace.CurrentCamera
		if not camera then
			refreshUi("Studio does not have an active camera yet.")
			return false
		end
		track = {
			trackType = "Camera",
			instance = camera,
			path = "__MegMoCameraPresetPreview",
		}
	end
	if not CameraTrackService.isCameraTrack(track) then
		refreshUi("Select a camera track first.")
		return false
	end

	local entries, message = CameraTrackService.buildPresetEntries({
		timeline = timeline,
		track = track,
		selectionService = SelectionService,
		options = options,
	}, presetId)
	if not entries then
		refreshUi(message)
		return false
	end
	if options and options.previewOnly == true then
		CameraTrackService.previewPresetEntries(entries, {
			durationSeconds = tonumber(options.durationSeconds),
			fps = timeline:getFps(),
		})
		refreshUi(message or "Previewing camera preset.")
		return true
	end

	pushUndo("Apply Camera Preset")
	ChangeHistoryService:SetWaypoint("Before Apply Camera Preset")
	if needsCameraTrack then
		local camera = workspace.CurrentCamera
		track = camera and timeline:addGenericTrack("Camera", camera, "Camera") or nil
		if not CameraTrackService.isCameraTrack(track) then
			historyService:discardPendingUndo()
			refreshUi("Could not create a Camera track for that preset.")
			return false
		end
	end
	local writtenCount = 0
	local firstFrame = nil
	local lastFrame = nil
	for _, entry in ipairs(entries) do
		local frame = math.max(0, math.floor((entry.frame or timeline:getCurrentFrame()) + 0.5))
		local success = timeline:setTrackValueAtFrame(
			track.path,
			frame,
			entry.value,
			entry.easingStyle or Constants.DEFAULT_EASING_STYLE,
			entry.easingDirection or Constants.DEFAULT_EASING_DIRECTION
		)
		if success then
			writtenCount += 1
			firstFrame = firstFrame or frame
			lastFrame = math.max(lastFrame or frame, frame)
		end
	end

	if writtenCount == 0 then
		historyService:discardPendingUndo()
		refreshUi("Could not write camera keyframes for that preset.")
		return false
	end

	if presetId == "FollowRig" and options and tostring(options.followStyle or "") == "Cinematic" then
		local letterboxTrack = ScreenEffectTrackService.addTrack(timeline, "Letterbox")
		local letterboxValue = ScreenEffectTrackService.getDefaultValueForEffect("Letterbox")
		if letterboxTrack and firstFrame then
			timeline:setTrackValueAtFrame(letterboxTrack.path, firstFrame, letterboxValue, "Linear", "InOut")
			if lastFrame and lastFrame ~= firstFrame then
				timeline:setTrackValueAtFrame(letterboxTrack.path, lastFrame, letterboxValue, "Linear", "InOut")
			end
			message = (message or string.format("Added %d camera keyframes.", writtenCount)) .. " Added Letterbox for cinematic framing."
		end
	end
	if presetId == "FaceFocus" then
		local dofTrack = ScreenEffectTrackService.addTrack(timeline, "DepthOfField")
		local dofValue = ScreenEffectTrackService.getDefaultValueForEffect("DepthOfField")
		dofValue.focusDistance = math.clamp(tonumber(options and options.radius) or 4.5, 0, 1000)
		if dofTrack and firstFrame then
			timeline:setTrackValueAtFrame(dofTrack.path, firstFrame, dofValue, "Linear", "InOut")
			if lastFrame and lastFrame ~= firstFrame then
				timeline:setTrackValueAtFrame(dofTrack.path, lastFrame, dofValue, "Linear", "InOut")
			end
			message = (message or string.format("Added %d camera keyframes.", writtenCount)) .. " Added Depth Of Field for background blur."
		end
	end
	ChangeHistoryService:SetWaypoint("After Apply Camera Preset")
	setSingleSelectedTrack(track.path)
	if firstFrame ~= nil then
		local targetFrame = presetId == "CameraDetachSelection" and (lastFrame or firstFrame) or firstFrame
		timeline:setCurrentFrame(targetFrame)
		timeline:applyCurrentFrame()
		CameraTrackService.applyActiveFirstPersonPreview(timeline, timeline:getCurrentFrame())
	end
	refreshUi(message or string.format("Added %d camera keyframes.", writtenCount))
	return true
end

function editorActions.setRotateSnap(degrees)
	gizmoController:setRotateSnap(degrees)
	refreshUi(string.format("Rotate snap set to %.3f degrees.", gizmoController:getRotateSnapDegrees()))
end

function editorActions.setSelectedKeyEasing(easingStyle, easingDirection)
	local selectedKeyRefs = getSelectedKeyRefs()
	if #selectedKeyRefs == 0 then
		refreshUi("Select one or more keyframes before changing easing.")
		return false, "Select one or more keyframes before changing easing."
	end

	pushUndo("Change Key Easing")
	local success, message = timeline:setTrackKeyOptions(selectedKeyRefs, easingStyle, easingDirection)
	if not success then
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

editorActions.cycleSelectedEasingStyle = function()
	local options = getSelectedKeyOptions()
	local nextStyle = require(Modules:WaitForChild("EasingSelectionSupport")).getCycledStyle(Constants.EASING_STYLES, options.easingStyle)
	return editorActions.setSelectedKeyEasing(nextStyle, options.easingDirection)
end

editorActions.cycleSelectedEasingDirection = function()
	local options = getSelectedKeyOptions()
	local nextDirection = require(Modules:WaitForChild("EasingSelectionSupport")).getCycledDirection(Constants.EASING_DIRECTIONS, options.easingDirection)
	return editorActions.setSelectedKeyEasing(options.easingStyle, nextDirection)
end

editorActions.setSelectedEasingStyle = function(easingStyle)
	local options = getSelectedKeyOptions()
	return editorActions.setSelectedKeyEasing(easingStyle, options.easingDirection)
end

editorActions.setSelectedEasingDirection = function(easingDirection)
	local options = getSelectedKeyOptions()
	return editorActions.setSelectedKeyEasing(options.easingStyle, easingDirection)
end

function editorActions.setTrackKeyEasing(trackPath, easingStyle, easingDirection, frameOverride)
	if type(trackPath) ~= "string" or trackPath == "" then
		refreshUi("Select a camera keyframe before changing easing.")
		return false
	end
	local frame = math.max(0, math.floor((tonumber(frameOverride) or tonumber(timeline:getCurrentFrame()) or 0) + 0.5))
	if not timeline:hasTrackKeyframe(trackPath, frame) then
		refreshUi("Move the playhead onto a camera keyframe before changing easing.")
		return false
	end

	local currentOptions = timeline:getKeyOptions(trackPath, frame)
	pushUndo("Change Key Easing")
	local success, message = timeline:setTrackKeyOptions({
		{
			jointPath = trackPath,
			frame = frame,
		},
	}, easingStyle or currentOptions.easingStyle, easingDirection or currentOptions.easingDirection)
	if not success then
		historyService:discardPendingUndo()
	end
	selectedKeys, selectedKeyframeFrame, selectedJointPath = require(Modules:WaitForChild("SelectedKeyMutationSupport")).setSingleSelectedKey(trackPath, frame)
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	refreshUi(message)
	return success, message
end

function editorActions.selectJoint(path, additive)
	local motorData = timeline:getMotorByPath(path)
	if not motorData then
		refreshUi("That joint is no longer available.")
		return
	end

	if additive and widgetController._viewportSelectionClick == true then
		local jointSelectionSupport = require(Modules:WaitForChild("JointSelectionSupport"))
		if not jointSelectionSupport.isSelectableViewportMultiJoint(path, motorData) then
			refreshUi("HumanoidRootPart is ignored for viewport multi-select.")
			return
		end
		widgetController._viewportMultiTrackPaths, selectedTrackPaths, selectedJointPath =
			jointSelectionSupport.applyViewportMultiSelection(path, timeline, widgetController._viewportMultiTrackPaths or selectedTrackPaths or {}, selectedJointPath)
		clearSelectedKeyframes()
	elseif additive then
		widgetController._viewportMultiTrackPaths = nil
		toggleSelectedTrack(path)
	elseif isOnlySelectedTrack(path) then
		widgetController._viewportMultiTrackPaths = nil
		clearSelectedTracks()
		clearSelectedKeyframes()
	else
		widgetController._viewportMultiTrackPaths = nil
		setSingleSelectedTrack(path)
	end
	local trackballPath = selectedTrackPaths[path] and path or selectedJointPath
	if editorActions._persistentTrackballMode and trackballPath then
		editorActions.retargetPersistentTrackball(trackballPath)
	end
	local selectedCount = #getSelectedTrackPaths()
	refreshUi(require(Modules:WaitForChild("JointSelectionSupport")).buildSelectionMessage(motorData.name, selectedCount))
end

function editorActions.selectRigPartFromViewportMouse(mouse, mousePosition, onlyDifferent)
	if require(Modules:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
		return false
	end
	if gizmoController
		and type(gizmoController.IsPointerOverHandle) == "function"
		and gizmoController:IsPointerOverHandle(mousePosition) == true then
		editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
		return false
	end
	local ok, path, part, additive = pcall(function()
		local service = require(Modules:WaitForChild("ViewportPartSelectService"))
			local additiveSelection = require(Modules:WaitForChild("ViewportSelectionIntentSupport")).isAdditiveActive(widgetController, editorActions)
			if onlyDifferent == true and type(service.getHoverCandidate) == "function" then
				local hoveredPath, hoveredPart = service.getHoverCandidate()
				if hoveredPath and hoveredPath ~= selectedJointPath then
					return hoveredPath, hoveredPart, additiveSelection
			end
		end
		local foundPath, foundPart = service.findMotorPathForMouse(timeline, mouse)
		if not foundPath and typeof(mousePosition) == "Vector2" then
			local screenMouse = {
				X = mousePosition.X,
				Y = mousePosition.Y,
			}
			foundPath, foundPart = service.findMotorPathForMouse(timeline, screenMouse)
		end
		return foundPath, foundPart, additiveSelection
	end)
	if not ok or not path then
		return false
	end
	if onlyDifferent == true and path == selectedJointPath then
		return false
	end

	widgetController._viewportPartPickerIgnoreDeactivateUntil = os.clock() + 0.35
	if part and part.Parent then
		require(Modules:WaitForChild("ViewportSelectionSyncSupport")).forcePartSelection(widgetController, SelectionService, part)
	end

	widgetController._lastViewportPickPath = path
	widgetController._lastViewportPickPart = part
	widgetController._lastViewportPickUntil = os.clock() + 0.25
	require(Modules:WaitForChild("ViewportSelectionIntentSupport")).selectViewportJoint({
		path = path,
		additive = additive == true,
		selectedJointPath = selectedJointPath,
		widgetController = widgetController,
		editorActions = editorActions,
		refreshSelectedGizmo = refreshSelectedGizmo,
	})
	return true
end

editorActions.selectTrack = require(Modules:WaitForChild("TrackSelectionAction")).create({
	timeline = timeline,
	refreshUi = refreshUi,
	selectJoint = editorActions.selectJoint,
	isOnlySelectedTrack = isOnlySelectedTrack,
	toggleSelectedTrack = toggleSelectedTrack,
	clearSelectedTracks = clearSelectedTracks,
	clearSelectedKeyframes = clearSelectedKeyframes,
	setSingleSelectedTrack = setSingleSelectedTrack,
	getSelectedTrackPaths = getSelectedTrackPaths,
})

function editorActions.removeTrackByPath(path)
	if not path then
		refreshUi("Select a rig or object track before removing it.")
		return
	end

	local track = timeline:getTrackByPath(path)
	if not track then
		refreshUi("That track is no longer available.")
		return
	end

	local removeRig = track.trackType == "Rig Group" or track.trackType == "Rig" or timeline:getMotorByPath(path) ~= nil
	local success, message
	pushUndo(removeRig and "Remove Rig" or "Remove Track")
	if removeRig then
		local rig = track.rig or timeline:getRigByName(track.rigName)
		if rig then
			timeline:resetRigPoseForRig(rig)
			RigWorkspaceLockService.unlockRig(rig)
		end
		success, message = timeline:removeRig(rig)
	else
		success, message = timeline:removeTrack(path)
	end
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message)
		return
	end

	clearSelectedTracks()
	clearSelectedKeyframes()
	removeDeletedKeysFromGroups()
	local restoredEmptyTimeline, restoredCount = restoreOriginalStateIfTimelineEmpty("Remove Track")
	if restoredEmptyTimeline then
		message = tostring(message or "Removed track.") .. string.format(" Restored %d track%s to the original pose because the timeline has no keyframes.", restoredCount, restoredCount == 1 and "" or "s")
	end
	refreshUi(message)
	task.defer(function()
		refreshUi(message)
	end)
end

function editorActions.removeSelectedTrack()
	local path = selectedJointPath
	if not path then
		for selectedPath in pairs(selectedTrackPaths) do
			path = selectedPath
			break
		end
	end

	editorActions.removeTrackByPath(path)
end

function editorActions.applyJointPose(transform)
	if #timeline:getMotors() == 0 then
		refreshUi("Bind a rig before editing joint poses.")
		return
	end

	if not selectedJointPath then
		refreshUi("Select a joint before editing its pose.")
		return
	end

	pushUndo("Apply Joint Pose")
	ChangeHistoryService:SetWaypoint("Before Apply Joint Pose")
	local success, message = timeline:applyJointTransform(selectedJointPath, transform)
	ChangeHistoryService:SetWaypoint("After Apply Joint Pose")
	if not success then
		historyService:discardPendingUndo()
	end
	refreshUi(message)

	if not success then
		return
	end
end

