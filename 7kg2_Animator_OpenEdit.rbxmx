	return row
end

local function makeRowButton(parent, text, color, order)
	local button = create("TextButton", {
		Parent = parent,
		AutoButtonColor = true,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = order,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextStrokeTransparency = 1,
		ZIndex = 132,
	})
	stylePrimary(button, color)
	return button
end

local function makePreviewPanel(parent, title, order)
	local panel = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(0.5, -5, 1, 0),
		ZIndex = 131,
	})
	UiHelpers.createCorner(panel, 12)
	UiHelpers.createStroke(panel, Constants.THEME.Border, 1)

	local label = create("TextLabel", {
		Parent = panel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 10, 0, 8),
		Size = UDim2.new(1, -20, 0, 18),
		Text = title,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 132,
	})

	local viewport = create("ViewportFrame", {
		Parent = panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 0, 32),
		Size = UDim2.new(1, -20, 1, -42),
		ZIndex = 132,
	})
	UiHelpers.createCorner(viewport, 10)
	return panel, label, prepareViewport(viewport)
end

function R15ToR6ConverterPopup.open(parent, options)
	if not parent then
		return nil
	end
	options = options or {}
	if activePopup and type(activePopup.destroy) == "function" then
		activePopup.destroy()
	end

	local state = {
		sourceSequence = nil,
		sourceLabel = nil,
		convertedSequence = nil,
		previewTime = 0,
		loop = true,
		viewportPreview = false,
		viewportR15 = nil,
		viewportR6 = nil,
		connections = {},
		uiHidden = false,
		hiddenHostUiStates = nil,
	}
	local hideUiRoot = findHideUiRoot(parent)

	local overlay = create("Frame", {
		Name = "R15ToR6ConverterOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 129,
	})
	require(script.Parent.Parent:WaitForChild("ModalOverlaySupport")).applyToOverlay(overlay)
	local card = create("Frame", {
		Name = "R15ToR6ConverterCard",
