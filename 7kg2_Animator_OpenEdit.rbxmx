function WidgetController:_connect(signal, callback)
	table.insert(self._connections, signal:Connect(callback))
end

function WidgetController:_getTimelineMetrics(durationFrames)
	durationFrames = math.max(1, durationFrames or Constants.DEFAULT_DURATION_FRAMES)
	local visibleWidth = 1
	if self._laneContainer then
		visibleWidth = math.max(visibleWidth, self._laneContainer.AbsoluteSize.X)
	end
	if self._timelineScrubHitbox then
		visibleWidth = math.max(visibleWidth, self._timelineScrubHitbox.AbsoluteSize.X)
	end
	if self._timelineRuler then
		visibleWidth = math.max(visibleWidth, self._timelineRuler.AbsoluteSize.X)
	end
	if self._trackLaneArea then
		visibleWidth = math.max(visibleWidth, self._trackLaneArea.AbsoluteSize.X)
	end
	if visibleWidth &lt;= 1 then
		visibleWidth = TIMELINE_FALLBACK_VISIBLE_WIDTH
	end

	local drawableWidth = math.max(1, visibleWidth - (TIMELINE_PADDING_X * 2))
	local basePixelsPerFrame = drawableWidth / TIMELINE_BASE_PIXELS_PER_FRAME
	local pixelsPerFrame = math.max(0.05, basePixelsPerFrame * math.clamp(self._timelineZoom or 1, TIMELINE_MIN_ZOOM, TIMELINE_MAX_ZOOM))
	local contentWidth = math.max(visibleWidth, (durationFrames * pixelsPerFrame) + (TIMELINE_PADDING_X * 2))
	return {
		durationFrames = durationFrames,
		visibleWidth = visibleWidth,
		pixelsPerFrame = pixelsPerFrame,
		contentWidth = contentWidth,
	}
end

function WidgetController:_frameToTimelineX(frame, durationFrames)
	local metrics = self:_getTimelineMetrics(durationFrames)
	return TIMELINE_PADDING_X + (math.clamp(frame or 0, 0, metrics.durationFrames) * metrics.pixelsPerFrame)
end

function WidgetController:_positionToTimelineFrame(position, durationFrames)
	local metrics = self:_getTimelineMetrics(durationFrames)
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
	local relativeX = position.X - self._timelineScrubHitbox.AbsolutePosition.X + scrollX - TIMELINE_PADDING_X
	return math.clamp(math.floor((relativeX / metrics.pixelsPerFrame) + 0.5), 0, metrics.durationFrames)
end

function WidgetController:_autoScrollTimelineForPoint(position, durationFrames)
	if not self._laneContainer or not self._timelineScrubHitbox then
		return
	end

	local metrics = self:_getTimelineMetrics(durationFrames)
	local maxScrollX = math.max(0, metrics.contentWidth - metrics.visibleWidth)
	if maxScrollX &lt;= 0 then
		return
	end

	local edgeSize = math.min(90, math.max(36, metrics.visibleWidth * 0.14))
	local localX = position.X - self._timelineScrubHitbox.AbsolutePosition.X
	local scrollDelta = 0
	if localX &gt; metrics.visibleWidth - edgeSize then
		scrollDelta = 10 + ((localX - (metrics.visibleWidth - edgeSize)) / edgeSize) * 34
	elseif localX &lt; edgeSize then
		scrollDelta = -10 - (((edgeSize - localX) / edgeSize) * 34)
	end

	if scrollDelta == 0 then
		return
	end

	local current = self._laneContainer.CanvasPosition
	local nextX = math.clamp(current.X + scrollDelta, 0, maxScrollX)
	if math.abs(nextX - current.X) &lt; 0.5 then
		return
	end

	self._laneContainer.CanvasPosition = Vector2.new(nextX, current.Y)
	if self._lastViewModel then
		self:_positionPlayhead(self._lastViewModel)
	end
end

function WidgetController:_autoScrollTimelineSelectionForPoint(position, durationFrames)
	if not position then
		return false
	end

	local didScroll = false
	if self._laneContainer and self._timelineScrubHitbox and self._marqueeState and self._marqueeState.allowHorizontalScroll then
		local timelineWidth = math.max(1, self._timelineScrubHitbox.AbsoluteSize.X)
		local localX = position.X - self._timelineScrubHitbox.AbsolutePosition.X
		local horizontalEdgeSize = math.min(72, math.max(32, timelineWidth * 0.1))
		if localX &lt; horizontalEdgeSize or localX &gt; timelineWidth - horizontalEdgeSize then
			local beforeX = self._laneContainer.CanvasPosition.X
			self:_autoScrollTimelineForPoint(position, durationFrames)
			local afterX = self._laneContainer.CanvasPosition.X
			if math.abs(afterX - beforeX) &gt; 0.5 then
				didScroll = true
			end
		end
	end

	if not self._laneContainer or not self._trackLaneArea then
		return didScroll
	end

	local scrollWindowHeight = math.max(1, self._laneContainer.AbsoluteWindowSize.Y)
	local contentHeight = math.max(scrollWindowHeight, self._laneContainer.AbsoluteCanvasSize.Y)
	local maxScrollY = math.max(0, contentHeight - scrollWindowHeight)
	if maxScrollY &lt;= 0 then
		return didScroll
	end

	local hoverArea = self._timelineMarqueeOverlay or self._laneContainer
	local visibleHeight = math.max(1, hoverArea.AbsoluteSize.Y)
	local edgeSize = math.min(72, math.max(28, visibleHeight * 0.16))
	local localY = position.Y - hoverArea.AbsolutePosition.Y
	local scrollDeltaY = 0
	if localY &gt; visibleHeight - edgeSize then
		scrollDeltaY = 8 + ((localY - (visibleHeight - edgeSize)) / edgeSize) * 26
	elseif localY &lt; edgeSize then
		scrollDeltaY = -8 - (((edgeSize - localY) / edgeSize) * 26)
	end

	if scrollDeltaY == 0 then
		return didScroll
	end

	local current = self._laneContainer.CanvasPosition
	local nextY = math.clamp(current.Y + scrollDeltaY, 0, maxScrollY)
	if math.abs(nextY - current.Y) &lt; 0.5 then
		return didScroll
	end

	self._laneContainer.CanvasPosition = Vector2.new(self._laneContainer.CanvasPosition.X, nextY)
	if self._trackColumnList then
		self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
	end
	self:_positionStickyTrackRows(nextY)
	return true
end

function WidgetController:_beginTimelineMiddlePan(position)
	if not self._laneContainer then
		return false
	end
	if self._timelineMiddlePanSession then
		return true
	end
	self:_clearTimelineSession("cancel")
	self._timelineMiddlePanSession = {
		startPos = positionToVector2(position),
		startCanvas = self._laneContainer.CanvasPosition,
		durationFrames = self._lastViewModel and self._lastViewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES,
		startedAt = os.clock(),
	}
	self:_setTimelineMiddlePanBlocker(true)
	self:_acquireMainTimelineShortcuts("timeline-middle-pan")
	return true
end

function WidgetController:_updateTimelineMiddlePan(position)
	local session = self._timelineMiddlePanSession
	if not session or not self._laneContainer then
		return false
	end
	if getMiddleMousePressed() == false and (os.clock() - (session.startedAt or 0)) &gt; 0.08 then
		self:_endTimelineMiddlePan("middleMouseReleasedBeforeInputEnded")
		return false
	end

	local delta = positionToVector2(position) - session.startPos
	local metrics = self:_getTimelineMetrics(session.durationFrames)
	local maxScrollX = math.max(0, metrics.contentWidth - metrics.visibleWidth)
	local maxScrollY = math.max(0, self._laneContainer.AbsoluteCanvasSize.Y - self._laneContainer.AbsoluteWindowSize.Y)
	local nextX = math.clamp(session.startCanvas.X - delta.X, 0, maxScrollX)
	local nextY = math.clamp(session.startCanvas.Y - delta.Y, 0, maxScrollY)
	self._laneContainer.CanvasPosition = Vector2.new(nextX, nextY)
	if self._trackColumnList then
		self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
	end
	self:_positionStickyTrackRows(nextY)
	if self._lastViewModel then
		self:_positionPlayhead(self._lastViewModel)
	end
	return true
end

function WidgetController:_endTimelineMiddlePan(reason)
	if not self._timelineMiddlePanSession then
		return false
	end
	self._timelineMiddlePanSession = nil
	self:_setTimelineMiddlePanBlocker(false)
	if reason then
		self:_setShortcutHint("Middle-drag pan finished: " .. tostring(reason))
	else
		self:_setShortcutHint("Middle-drag pan finished")
	end
	return true
end

function WidgetController:_clearStaleTimelineMiddlePan(reason)
	local session = self._timelineMiddlePanSession
	if not session then
		return false
	end
	local pressed = getMiddleMousePressed()
	if pressed == false and (os.clock() - (session.startedAt or 0)) &gt; 0.12 then
		return self:_endTimelineMiddlePan(reason or "middleMouseReleased")
	end
	return false
end

function WidgetController:_setTimelineZoom(zoom)
	local nextZoom = math.clamp(zoom or 1, TIMELINE_MIN_ZOOM, TIMELINE_MAX_ZOOM)
	if math.abs(nextZoom - (self._timelineZoom or 1)) &lt; 0.001 then
		return
	end

	local currentFrame = self._lastViewModel and self._lastViewModel.currentFrame or 0
	self._timelineZoom = nextZoom
	self:invalidateTimelineRenderCache()
	if self._laneContainer and self._lastViewModel then
		local durationFrames = self._lastViewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
		local metrics = self:_getTimelineMetrics(durationFrames)
		local targetX = self:_frameToTimelineX(currentFrame, durationFrames) - (metrics.visibleWidth * 0.5)
		local maxScrollX = math.max(0, metrics.contentWidth - metrics.visibleWidth)
		self._laneContainer.CanvasPosition = Vector2.new(math.clamp(targetX, 0, maxScrollX), self._laneContainer.CanvasPosition.Y)
	end
	if self._lastViewModel then
		self:update(self._lastViewModel)
	end
end

function WidgetController:_changeTimelineZoom(multiplier)
	self:_setTimelineZoom((self._timelineZoom or 1) * multiplier)
end

function WidgetController:_getTimeUnitMode()
	return self._timeUnitMode == "Seconds" and "Seconds" or "Frames"
end

function WidgetController:_formatFrameValue(frame, fps)
	frame = math.max(0, tonumber(frame) or 0)
	if self:_getTimeUnitMode() == "Seconds" then
		return formatNumber(frame / safeFps(fps))
	end

	return tostring(math.floor(frame + 0.5))
end

function WidgetController:_valueToFrame(value, fps)
	value = tonumber(value)
	if not value then
		return nil
	end

	if self:_getTimeUnitMode() == "Seconds" then
		return math.max(0, math.floor((value * safeFps(fps)) + 0.5))
	end

	return math.max(0, math.floor(value + 0.5))
end

function WidgetController:_formatTimelineSummary(durationFrames, fps)
	durationFrames = math.max(1, math.floor(tonumber(durationFrames) or Constants.DEFAULT_DURATION_FRAMES))
	if self:_getTimeUnitMode() == "Seconds" then
		return string.format("Timeline: %s seconds (%d frames)", formatNumber(durationFrames / safeFps(fps)), durationFrames)
	end

	return string.format("Timeline: %d frames", durationFrames)
end

function WidgetController:_clearTimelineLaneGrid(lane)
	for _, child in ipairs(lane:GetChildren()) do
		if child:IsA("GuiObject") and child.Name:sub(1, 12) == "TimelineGrid" then
			child:Destroy()
		end
	end
end

function WidgetController:_getTimelineGridStep(pixelsPerFrame)
	local candidates = {2, 4, 10, 20, 30, 60, 120, 240, 480, 960}
	for _, candidate in ipairs(candidates) do
		if (pixelsPerFrame * candidate) &gt;= TIMELINE_GRID_MIN_SPACING then
			return candidate
		end
	end

	return candidates[#candidates]
end

function WidgetController:_renderTimelineLaneGrid(lane, durationFrames, trackRowHeight)
	if not lane or not lane.Parent then
		return
	end

	self:_clearTimelineLaneGrid(lane)
	durationFrames = math.max(1, math.floor(tonumber(durationFrames) or Constants.DEFAULT_DURATION_FRAMES))
	local metrics = self:_getTimelineMetrics(durationFrames)
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
	local endX = TIMELINE_PADDING_X + (durationFrames * metrics.pixelsPerFrame)
	local shadeWidth = math.max(0, (self._timelinePixelWidth or endX) - endX)
	if shadeWidth &gt; 0 then
		local shade = create("Frame", {
			Name = "TimelineGridShade",
			Parent = lane,
			BackgroundColor3 = Color3.fromRGB(7, 9, 14),
			BackgroundTransparency = 0.34,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(endX, 0),
			Size = UDim2.new(0, shadeWidth, 1, 0),
			ZIndex = 1,
		})
		shade.Active = false
	end

	local step = self:_getTimelineGridStep(metrics.pixelsPerFrame)
	local startFrame = math.max(2, math.floor(((scrollX - TIMELINE_PADDING_X) / metrics.pixelsPerFrame) / step) * step)
	local endFrame = math.min(durationFrames, math.ceil(((scrollX + metrics.visibleWidth - TIMELINE_PADDING_X) / metrics.pixelsPerFrame) / step) * step)
	local lineCount = math.max(0, math.floor((endFrame - startFrame) / step) + 1)
	if lineCount &gt; TIMELINE_GRID_MAX_LINES_PER_LANE then
		step *= math.ceil(lineCount / TIMELINE_GRID_MAX_LINES_PER_LANE)
		if step % 2 ~= 0 then
			step += 1
		end
		startFrame = math.max(2, math.floor(((scrollX - TIMELINE_PADDING_X) / metrics.pixelsPerFrame) / step) * step)
		endFrame = math.min(durationFrames, math.ceil(((scrollX + metrics.visibleWidth - TIMELINE_PADDING_X) / metrics.pixelsPerFrame) / step) * step)
	end

	for frame = startFrame, endFrame, step do
		local line = create("Frame", {
			Name = "TimelineGridLine",
			Parent = lane,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Constants.THEME.Text,
			BackgroundTransparency = 0.93,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(TIMELINE_PADDING_X + (frame * metrics.pixelsPerFrame), 0),
			Size = UDim2.new(0, 1, 1, 0),
			ZIndex = 1,
		})
		line.Active = false
	end

	local boundary = create("Frame", {
		Name = "TimelineGridBoundary",
		Parent = lane,
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Constants.THEME.MutedText,
		BackgroundTransparency = 0.68,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(endX, 0),
		Size = UDim2.new(0, 1, 0, trackRowHeight),
		ZIndex = 2,
	})
	boundary.Active = false
end

function WidgetController:_addTimelineLaneGrid(lane, durationFrames, trackRowHeight)
	self._visibleGridLanes = self._visibleGridLanes or {}
	table.insert(self._visibleGridLanes, {
		lane = lane,
		trackRowHeight = trackRowHeight,
	})
	self:_renderTimelineLaneGrid(lane, durationFrames, trackRowHeight)
end

function WidgetController:_refreshTimelineLaneGrids(viewModel, force)
	if not viewModel or not self._visibleGridLanes then
		return
	end

	local durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
	local zoom = self._timelineZoom or 1
	if not force
		and math.abs(scrollX - (self._lastGridScrollX or -1000000)) &lt; 1
		and math.abs(zoom - (self._lastGridZoom or -1)) &lt; 0.001
		and durationFrames == self._lastGridDuration then
		return
	end

	self._lastGridScrollX = scrollX
	self._lastGridZoom = zoom
	self._lastGridDuration = durationFrames
	for _, gridLane in ipairs(self._visibleGridLanes) do
		self:_renderTimelineLaneGrid(gridLane.lane, durationFrames, gridLane.trackRowHeight)
	end
end

function WidgetController:_setTimeUnitMode(mode)
	local nextMode = mode == "Seconds" and "Seconds" or "Frames"
	if self._timeUnitMode == nextMode then
		return
	end

	self._timeUnitMode = nextMode
	if self._lastViewModel then
		self:update(self._lastViewModel)
	end
	self:_setShortcutHint("Timeline display: " .. nextMode)
end

function WidgetController:_syncTimelineCanvas(durationFrames)
	local metrics = self:_getTimelineMetrics(durationFrames)
	self._timelinePixelWidth = metrics.contentWidth
	if self._laneContainer then
		local currentHeight = self._laneContainer.CanvasSize.Y.Offset
		self._laneContainer.CanvasSize = UDim2.new(0, metrics.contentWidth, 0, currentHeight)
	end
	return metrics
end

function WidgetController:_formatDragRulerFrame(frame, fps)
	frame = math.max(0, math.floor((tonumber(frame) or 0) + 0.5))
	if self:_getTimeUnitMode() == "Seconds" then
		return formatNumber(frame / safeFps(fps)) .. "s"
	end
	return tostring(frame) .. "f"
end

function WidgetController:_hideKeyframeDragRulerHighlight()
	local highlight = self._keyframeDragRulerHighlight
	if highlight and highlight.root and highlight.root.Parent then
		highlight.root.Visible = false
	end
end

function WidgetController:_setKeyframeDragRulerHighlightFrame(frame)
	if not self._timelineRuler or frame == nil then
		self:_hideKeyframeDragRulerHighlight()
		return
	end

	local viewModel = self._lastViewModel
	local durationFrames = viewModel and viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
	local fps = viewModel and viewModel.fps or Constants.DEFAULT_FPS
	local metrics = self:_getTimelineMetrics(durationFrames)
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
	frame = math.clamp(math.floor((tonumber(frame) or 0) + 0.5), 0, metrics.durationFrames)
	local visibleX = self:_frameToTimelineX(frame, durationFrames) - scrollX

	if visibleX &lt; -10 or visibleX &gt; metrics.visibleWidth + 10 then
		self:_hideKeyframeDragRulerHighlight()
		return
	end

	local highlight = self._keyframeDragRulerHighlight
	if not highlight or not highlight.root or highlight.root.Parent ~= self._timelineRuler then
		local root = create("Frame", {
			Parent = self._timelineRuler,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(0, 1, 1, 0),
			ZIndex = 40,
		})
		local pill = create("Frame", {
			Parent = root,
			Active = false,
			BackgroundColor3 = Constants.THEME.Accent,
			BackgroundTransparency = 0.02,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(-28, 0),
			Size = UDim2.fromOffset(56, 18),
			ZIndex = 41,
		})
		createCorner(pill, 8)
		createStroke(pill, Constants.THEME.Text, 0.16, 1)
		local label = create("TextLabel", {
			Parent = pill,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			TextColor3 = ThemeService.getReadableTextColor(Constants.THEME.Accent),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 42,
		})
		local line = create("Frame", {
			Parent = root,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Constants.THEME.Accent,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 16),
			Size = UDim2.new(0, 3, 1, -14),
			ZIndex = 40,
		})
		createCorner(line, 2)
		highlight = {
			root = root,
			label = label,
			line = line,
		}
		self._keyframeDragRulerHighlight = highlight
	end

	highlight.root.Position = UDim2.fromOffset(math.floor(visibleX + 0.5), 0)
	highlight.label.Text = self:_formatDragRulerFrame(frame, fps)
	highlight.root.Visible = true
end

function WidgetController:_updateKeyframeDragRulerHighlight()
	local dragState = self._dragState
	if not dragState or dragState.previewFrame == nil then
		self:_hideKeyframeDragRulerHighlight()
		return
	end
	local offset = (dragState.previewFrame or 0) - (dragState.sourceFrame or 0)
	local referenceFrame = dragState.rulerReferenceFrame or dragState.sourceFrame or 0
	self:_setKeyframeDragRulerHighlightFrame(referenceFrame + offset)
end

function WidgetController:_renderTimelineRuler(viewModel)
	if not self._timelineRuler then
		return
	end
	local perfToken = PerformanceDebugService.begin("Timeline Ruler")

	for _, child in ipairs(self._timelineRuler:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local durationFrames = viewModel and viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
	local fps = viewModel and viewModel.fps or Constants.DEFAULT_FPS
	local metrics = self:_getTimelineMetrics(durationFrames)
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
	self._lastTimelineRulerScrollX = scrollX
	local visibleDurationEndX = self:_frameToTimelineX(durationFrames, durationFrames) - scrollX
	local shadeStartX = math.clamp(visibleDurationEndX, 0, metrics.visibleWidth)
	if shadeStartX &lt; metrics.visibleWidth then
		local rulerShade = create("Frame", {
			Parent = self._timelineRuler,
			BackgroundColor3 = Color3.fromRGB(7, 9, 14),
			BackgroundTransparency = 0.36,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(shadeStartX, 0),
			Size = UDim2.new(0, metrics.visibleWidth - shadeStartX, 1, 0),
			ZIndex = 1,
		})
		rulerShade.Active = false
	end
	if visibleDurationEndX &gt;= 0 and visibleDurationEndX &lt;= metrics.visibleWidth then
		create("Frame", {
			Parent = self._timelineRuler,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Constants.THEME.MutedText,
			BackgroundTransparency = 0.54,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(visibleDurationEndX, 0),
			Size = UDim2.new(0, 1, 1, 0),
			ZIndex = 1,
		})
	end
	local targetSpacing = 70
	local targetFrames = math.max(1, targetSpacing / metrics.pixelsPerFrame)
	local step
	if self:_getTimeUnitMode() == "Seconds" then
		local secondsCandidates = {0.5, 1, 2, 4, 10, 20, 30, 60, 120, 240}
		step = secondsCandidates[#secondsCandidates] * safeFps(fps)
		for _, seconds in ipairs(secondsCandidates) do
			local candidate = seconds * safeFps(fps)
			if candidate &gt;= targetFrames then
				step = candidate
				break
			end
		end
	else
		local candidates = {2, 4, 10, 20, 30, 60, 120, 240, 480, 960}
		step = candidates[#candidates]
		for _, candidate in ipairs(candidates) do
			if candidate &gt;= targetFrames then
				step = candidate
				break
			end
		end
	end

	local startFrame = math.max(0, math.floor(((scrollX - TIMELINE_PADDING_X) / metrics.pixelsPerFrame) / step) * step)
	local endFrame = math.min(metrics.durationFrames, math.ceil(((scrollX + metrics.visibleWidth) / metrics.pixelsPerFrame) / step) * step)
	for frame = startFrame, endFrame, step do
		local visibleX = self:_frameToTimelineX(frame, durationFrames) - scrollX
		if visibleX &gt;= -40 and visibleX &lt;= metrics.visibleWidth + 40 then
			local line = create("Frame", {
				Parent = self._timelineRuler,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromOffset(visibleX, 18),
				Size = UDim2.new(0, 1, 0, 10),
				BackgroundColor3 = Constants.THEME.Border,
				BorderSizePixel = 0,
			})
			line.BackgroundTransparency = 0.2
			local labelText = tostring(frame)
			if self:_getTimeUnitMode() == "Seconds" then
				local seconds = frame / math.max(1, fps)
				if seconds &gt;= 60 then
					labelText = string.format("%d:%02d", math.floor(seconds / 60), math.floor(seconds % 60))
				elseif math.abs(seconds - math.floor(seconds + 0.5)) &lt; 0.01 then
					labelText = string.format("%ds", math.floor(seconds + 0.5))
				else
					labelText = string.format("%.1fs", seconds)
				end
			end
			create("TextLabel", {
				Parent = self._timelineRuler,
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromOffset(visibleX, 0),
				Size = UDim2.new(0, 54, 0, 16),
				Font = Enum.Font.Code,
				Text = labelText,
				TextColor3 = Constants.THEME.MutedText,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
	end
	self:_updateKeyframeDragRulerHighlight()
	PerformanceDebugService.finish(perfToken, string.format("%d-%d step %d", startFrame, endFrame, step))
end

function WidgetController:_positionPlayhead(viewModel)
	if not viewModel or not self._timelinePlayheadLine or not self._timelinePlayheadHandle then
		return
	end

	local durationFrames = viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
	local x = self:_frameToTimelineX(viewModel.currentFrame or 0, durationFrames)
	local scrollX = self._laneContainer and self._laneContainer.CanvasPosition.X or 0
	local visibleX = x - scrollX
	local metrics = self:_getTimelineMetrics(durationFrames)
	local isVisible = visibleX &gt;= 0 and visibleX &lt;= metrics.visibleWidth
	for _, laneLine in ipairs(self._timelineCurrentFrameLaneLines or {}) do
		if laneLine and laneLine.Parent then
			laneLine.Position = UDim2.fromOffset(x, 0)
		end
	end
	self._timelinePlayheadLine.Visible = isVisible
	self._timelinePlayheadHandle.Visible = isVisible
	self._lastPlayheadVisualX = isVisible and visibleX or nil
	self._timelinePlayheadLine.Position = UDim2.fromOffset(visibleX, 32)
	self._timelinePlayheadHandle.Position = UDim2.fromOffset(visibleX, 6)
end

function WidgetController:_refreshTimelineForLayout()
	if not self._lastViewModel then
		return
	end
	if self:_isTimelineRenderMissing() and not self._healingTimelineRender then
		self._healingTimelineRender = true
		local laneCanvasPosition = self._laneContainer and self._laneContainer.CanvasPosition or nil
		self:invalidateTimelineRenderCache()
		self._suppressTimelineUpdateDefers = true
		self:update(self._lastViewModel)
		self._suppressTimelineUpdateDefers = false
		if laneCanvasPosition and self._laneContainer then
			self._laneContainer.CanvasPosition = laneCanvasPosition
			self:_positionStickyTrackRows(laneCanvasPosition.Y)
		end
		self._healingTimelineRender = false
		return
	end
	local laneCanvasPosition = self._laneContainer and self._laneContainer.CanvasPosition or nil
	self:_syncTimelineCanvas(self._lastViewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES)
	if self._laneContainer and laneCanvasPosition then
		self._laneContainer.CanvasPosition = laneCanvasPosition
	end
	if self._trackColumnList then
		self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
	end
	self:_positionStickyTrackRows(laneCanvasPosition and laneCanvasPosition.Y or 0)
	self:_renderTimelineRuler(self._lastViewModel)
	self:_positionPlayhead(self._lastViewModel)
end

function WidgetController:_isTimelineRenderMissing()
	local viewModel = self._lastViewModel
	if not viewModel or not viewModel.tracks or #viewModel.tracks == 0 then
		return false
	end
	if not self._laneContainer or not self._trackColumnList then
		return false
	end

	return #self._laneContainer:GetChildren() &lt;= 3 or #self._trackColumnList:GetChildren() &lt;= 1
end

function WidgetController:_forceTimelineScrollRepaint()
	local scroller = self._laneContainer
	if not scroller then
		return
	end

	local original = scroller.CanvasPosition
	local maxX = math.max(0, scroller.AbsoluteCanvasSize.X - scroller.AbsoluteWindowSize.X)
	local maxY = math.max(0, scroller.AbsoluteCanvasSize.Y - scroller.AbsoluteWindowSize.Y)
	local nudged = original
	if maxX &gt; 1 then
		local direction = original.X &lt; maxX and 1 or -1
		nudged = Vector2.new(math.clamp(original.X + direction, 0, maxX), original.Y)
	elseif maxY &gt; 1 then
		local direction = original.Y &lt; maxY and 1 or -1
		nudged = Vector2.new(original.X, math.clamp(original.Y + direction, 0, maxY))
	end

	if nudged == original then
		return
	end

	scroller.CanvasPosition = nudged
	task.defer(function()
		if not scroller.Parent then
			return
		end

		scroller.CanvasPosition = original
		self:_positionStickyTrackRows(original.Y)
		if self._lastViewModel then
			self:_renderTimelineRuler(self._lastViewModel)
			self:_positionPlayhead(self._lastViewModel)
		end
	end)
end

function WidgetController:invalidateTimelineRenderCache()
	self._lastTimelineRenderSignature = nil
	self._visibleGridLanes = {}
	self._lastGridScrollX = nil
	self._lastGridZoom = nil
	self._lastGridDuration = nil
	self._lastTimelineCullBucket = nil
	if self._timelineDiamondCache then
		self._timelineDiamondCache:invalidate()
	end
	if self._keyframeRenderer then
		self._keyframeRenderer:Invalidate()
	end
end

function WidgetController:stabilizeTimelineAfterImport()
	if not self._lastViewModel then
		return
	end

	self._postImportTimelineRefreshToken = (self._postImportTimelineRefreshToken or 0) + 1
	local token = self._postImportTimelineRefreshToken
	local laneCanvasPosition = self._laneContainer and self._laneContainer.CanvasPosition or Vector2.new()

	local function restoreTimelineViewport()
		if self._laneContainer then
			self._laneContainer.CanvasPosition = laneCanvasPosition
		end
		self:_positionStickyTrackRows(laneCanvasPosition.Y)
	end

	local function repaintTimeline(shouldRebuild)
		if token ~= self._postImportTimelineRefreshToken or not self._lastViewModel then
			return
		end

		if shouldRebuild then
			self:invalidateTimelineRenderCache()
			self:update(self._lastViewModel)
		else
			self:_refreshTimelineForLayout()
			self:_refreshTimelineLaneGrids(self._lastViewModel, true)
		end
		restoreTimelineViewport()
	end

	self:invalidateTimelineRenderCache()
	task.defer(function()
		repaintTimeline(true)

		task.delay(0.12, function()
			repaintTimeline(false)
		end)

		task.delay(0.28, function()
			repaintTimeline(false)
		end)
	end)
end

function WidgetController:stabilizeTimelineAfterProjectLoad()
	self._pendingTimelineCanvasRestore = nil
	self._suppressTimelineCanvasRestoreUntil = os.clock() + 1.1
	self._projectLoadTimelineRefreshToken = (self._projectLoadTimelineRefreshToken or 0) + 1
	local token = self._projectLoadTimelineRefreshToken

	local function resetTimelineViewport()
		if self._laneContainer then
			self._laneContainer.CanvasPosition = Vector2.new(0, 0)
		end
		if self._trackColumnList then
			self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
		end
		self:_positionStickyTrackRows(0)
	end

	local function runStabilizePass(shouldRebuild)
		if token ~= self._projectLoadTimelineRefreshToken or not self._lastViewModel then
			return
		end

		resetTimelineViewport()
		if shouldRebuild then
			self:invalidateTimelineRenderCache()
			self:update(self._lastViewModel)
		else
			self:_refreshTimelineForLayout()
			self:_refreshTimelineLaneGrids(self._lastViewModel, true)
		end
		self:_forceTimelineScrollRepaint()
	end

	resetTimelineViewport()
	self:invalidateTimelineRenderCache()

	task.defer(function()
		runStabilizePass(true)

		task.delay(0.18, function()
			runStabilizePass(true)
		end)

		task.delay(0.46, function()
			runStabilizePass(false)
		end)

		task.delay(0.9, function()
			runStabilizePass(false)
			if token == self._projectLoadTimelineRefreshToken then
				self._suppressTimelineCanvasRestoreUntil = nil
			end
		end)
	end)
end

function WidgetController:_buildTimelineRenderSignature(viewModel)
	viewModel = viewModel or {}
	local parts = {
		tostring(viewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES),
		string.format("zoom:%.4f", tonumber(self._timelineZoom or 1)),
	}
	local groupIds = {}
	for groupId in pairs(viewModel.groups or {}) do
		groupIds[#groupIds + 1] = groupId
	end
	table.sort(groupIds, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)
	for _, groupId in ipairs(groupIds) do
		local group = (viewModel.groups or {})[groupId]
		appendSignatureValue(parts, "g:" .. tostring(groupId))
		appendSignatureValue(parts, "gm:" .. tostring(group and group.mode or ""))
		appendSignatureValue(parts, "gs:" .. tostring(group and (group.sourceSpanFrames or group.repeatSourceSpanFrames) or ""))
		appendSignatureValue(parts, "gn:" .. tostring(group and group.name or ""))
		appendSignatureValue(parts, "gkind:" .. tostring(group and group.kind or ""))
		appendSignatureValue(parts, "gfolder:" .. tostring(group and group.folderPath or ""))
		local groupKeyIds = {}
		for keyId in pairs((group and group.keys) or {}) do
			groupKeyIds[#groupKeyIds + 1] = tostring(keyId)
		end
		table.sort(groupKeyIds)
		for _, keyId in ipairs(groupKeyIds) do
			appendSignatureValue(parts, "gk:" .. tostring(keyId))
		end
	end
	for _, trackData in ipairs(viewModel.tracks or viewModel.joints or {}) do
		appendSignatureValue(parts, trackData.path or "")
		appendSignatureValue(parts, trackData.trackType or "Rig")
		appendSignatureValue(parts, trackData.name or trackData.part1 or "")
		appendSignatureValue(parts, trackData.folderPath or "")
		appendSignatureValue(parts, trackData.folderColorId or "")
		appendSignatureValue(parts, trackData.visualOrder or "")
		appendSignatureValue(parts, trackData.disabled == true)
		appendSignatureValue(parts, self._hiddenTracks[trackData.path] == true)
		appendSignatureValue(parts, self._collapsedTracks[trackData.path] == true)
		appendSignatureValue(parts, trackData.rigName or "")
		for _, frame in ipairs((viewModel.trackKeyframesByPath or {})[trackData.path] or {}) do
			appendSignatureValue(parts, "kf:" .. tostring(frame))
			local keyOptions = ((viewModel.trackKeyOptionsByPath or {})[trackData.path] or {})[frame] or {}
			appendSignatureValue(parts, "kes:" .. tostring(keyOptions.easingStyle or Constants.DEFAULT_EASING_STYLE))
			appendSignatureValue(parts, "ked:" .. tostring(keyOptions.easingDirection or Constants.DEFAULT_EASING_DIRECTION))
		end
		for _, clip in ipairs((viewModel.trackSoundClipsByPath or {})[trackData.path] or {}) do
			appendSignatureValue(parts, "sound:" .. tostring(clip.frame) .. ":" .. tostring(clip.endFrame))
			appendSignatureValue(parts, tostring(clip.startOffsetSeconds or 0))
			appendSignatureValue(parts, tostring(clip.endTrimSeconds or 0))
			appendSignatureValue(parts, tostring(clip.fadeInSeconds or 0))
			appendSignatureValue(parts, tostring(clip.fadeOutSeconds or 0))
			appendSignatureValue(parts, tostring(clip.clipDurationSeconds or 0))
		end
		for _, clip in ipairs((viewModel.trackSubtitleClipsByPath or {})[trackData.path] or {}) do
			appendSignatureValue(parts, "subtitle:" .. tostring(clip.frame) .. ":" .. tostring(clip.endFrame))
			appendSignatureValue(parts, tostring(clip.text or ""))
		end
		for _, clip in ipairs((viewModel.trackFadeClipsByPath or {})[trackData.path] or {}) do
			appendSignatureValue(parts, "fade:" .. tostring(clip.frame) .. ":" .. tostring(clip.endFrame))
			appendSignatureValue(parts, tostring(clip.label or ""))
			appendSignatureValue(parts, tostring(clip.startTransparency or ""))
			appendSignatureValue(parts, tostring(clip.endTransparency or ""))
		end
	end
	local collapsedKeys = {}
	for collapsedKey in pairs(self._collapsedTracks or {}) do
		collapsedKeys[#collapsedKeys + 1] = tostring(collapsedKey)
	end
	table.sort(collapsedKeys)
	for _, collapsedKey in ipairs(collapsedKeys) do
		local isCollapsed = (self._collapsedTracks or {})[collapsedKey]
		appendSignatureValue(parts, "rc:" .. tostring(collapsedKey) .. ":" .. tostring(isCollapsed))
	end
	return table.concat(parts, "|")
end

function WidgetController:_ensureRigHierarchyDefaultExpanded(tracks)
	self._rigHierarchyDefaultExpanded = self._rigHierarchyDefaultExpanded or {}
	self._collapsedTracks = self._collapsedTracks or {}

	local activeRigNamesByGroupPath = {}
	for _, trackData in ipairs(tracks or {}) do
		local rigName = trackData and trackData.rigName
		if rigName then
			activeRigNamesByGroupPath[makeRigGroupTrackPath(rigName)] = rigName
		end
	end

	for groupPath in pairs(self._rigHierarchyDefaultExpanded) do
		if not activeRigNamesByGroupPath[groupPath] then
			self._rigHierarchyDefaultExpanded[groupPath] = nil
		end
	end

	for groupPath, rigName in pairs(activeRigNamesByGroupPath) do
		if not self._rigHierarchyDefaultExpanded[groupPath] then
			self._rigHierarchyDefaultExpanded[groupPath] = true
			self._collapsedTracks[makeRigGroupCollapseKey(rigName)] = nil
			self._collapsedTracks[groupPath] = nil

			for _, trackData in ipairs(tracks or {}) do
				if trackData and trackData.rigName == rigName and (trackData.trackType or "Rig") == "Rig" then
					self._collapsedTracks[trackData.path] = nil
				end
			end
		end
	end
end

function WidgetController:_ensureTimelineFolderDefaultCollapsed(tracks)
	self._collapsedTracks = self._collapsedTracks or {}
	self._defaultCollapsedFolderTokens = self._defaultCollapsedFolderTokens or {}
	for _, trackData in ipairs(tracks or {}) do
		if trackData.targetScope == "TimelineFolder" and trackData.defaultCollapsed == true then
			local token = tostring(trackData.defaultCollapseToken or trackData.path)
			if not self._defaultCollapsedFolderTokens[token] then
				self._defaultCollapsedFolderTokens[token] = true
				self._collapsedTracks[trackData.path] = true
			end
		end
	end
end

function WidgetController:updatePlaybackFrame(frame, status)
	if not self._lastViewModel then
		return
	end

	self._lastViewModel.currentFrame = frame
	self._lastViewModel.isPlaying = true
	local fps = self._lastViewModel.fps or Constants.DEFAULT_FPS
	local unitMode = self:_getTimeUnitMode()
	local frameText = self:_formatFrameValue(frame, fps)
	if self._status and status then
		self._status.Text = status
	end
	if self._frameInput and UserInputService:GetFocusedTextBox() ~= self._frameInput then
		self._frameInput.Text = frameText
	end
	if self._playPauseButton then
		self._playPauseButton.Text = "Pause"
		UiHelpers.setButtonIcon(self._playPauseButton, "Pause")
	end
	if self._previewStatus then
		self._previewStatus.Text = string.format(
			"Viewport active    Target: %s    Playhead: %s    Gizmo: %s",
			self._lastViewModel.selectedJointPath or "none",
			frameText .. (unitMode == "Seconds" and "s" or "f"),
			self._lastViewModel.gizmoMode or "Move"
		)
	end
	self:_positionPlayhead(self._lastViewModel)
end

function WidgetController:_queueTimelineStartRefresh(retryCount)
	if self._timelineStartRefreshQueued then
		return
	end

	retryCount = tonumber(retryCount) or 0
	self._timelineStartRefreshQueued = true
	task.delay(0.08, function()
		self._timelineStartRefreshQueued = false
		if not self._lastViewModel then
			return
		end
		if math.floor(tonumber(self._lastViewModel.currentFrame) or 0) ~= 0 then
			return
		end
		if self._timelineSession then
			if retryCount &lt; 10 then
				self:_queueTimelineStartRefresh(retryCount + 1)
			end
			return
		end
		self:invalidateTimelineRenderCache()
		self:update(self._lastViewModel)
	end)
end

function WidgetController:updateScrubFrame(frame, status)
	if not self._lastViewModel then
		return
	end

	local previousFrame = math.floor(tonumber(self._lastViewModel.currentFrame) or 0)
	self._lastViewModel.currentFrame = frame
	self._lastViewModel.isPlaying = false
	local scrubFrame = math.floor(tonumber(frame) or 0)
	local fps = self._lastViewModel.fps or Constants.DEFAULT_FPS
	local unitMode = self:_getTimeUnitMode()
	local frameText = self:_formatFrameValue(frame, fps)
	if self._status and status then
		self._status.Text = status
	end
	if self._frameInput and UserInputService:GetFocusedTextBox() ~= self._frameInput then
		self._frameInput.Text = frameText
	end
	if self._playPauseButton then
		self._playPauseButton.Text = "Play"
		UiHelpers.setButtonIcon(self._playPauseButton, "Play")
	end
	if self._previewStatus then
		self._previewStatus.Text = string.format(
			"Viewport active    Target: %s    Playhead: %s    Gizmo: %s",
			self._lastViewModel.selectedJointPath or "none",
			frameText .. (unitMode == "Seconds" and "s" or "f"),
			self._lastViewModel.gizmoMode or "Move"
		)
	end
	if scrubFrame == 0 and previousFrame &gt; 0 then
		self:_queueTimelineStartRefresh()
	end
	self:_positionPlayhead(self._lastViewModel)
end

function WidgetController:_isShortcutCaptureFocused()
	local captureInput = self._mainShortcutCaptureInput or self._shortcutCaptureInput
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	return (captureInput and focusedTextBox == captureInput)
		or (self._mainDockShortcutCaptureInput and focusedTextBox == self._mainDockShortcutCaptureInput)
end

function WidgetController:_isMainShortcutCaptureInput(input)
	return input ~= nil
		and (input == self._mainShortcutCaptureInput
			or input == self._shortcutCaptureInput
			or input == self._mainDockShortcutCaptureInput)
end

function WidgetController:_ensureDockShortcutCaptureInput()
	if self._mainDockShortcutCaptureInput and self._mainDockShortcutCaptureInput.Parent then
		return self._mainDockShortcutCaptureInput
	end
	if not self._root then
		return nil
	end

	local input = create("TextBox", {
		Name = "MainDockShortcutCaptureInput",
		Parent = self._root,
		Active = true,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		Position = UDim2.fromOffset(2, 2),
		Selectable = true,
		Size = UDim2.fromOffset(1, 1),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 1,
		TextTransparency = 1,
		ZIndex = 10000,
	})
	input:SetAttribute("MegMoShortcutCapture", true)
	self._mainDockShortcutCaptureInput = input
	return input
end

function WidgetController:_ensureShortcutCaptureInput()
	if self._mainShortcutCaptureInput and self._mainShortcutCaptureInput.Parent then
		self._shortcutCaptureInput = self._mainShortcutCaptureInput
		return self._mainShortcutCaptureInput
	end

	local gui = self._mainShortcutCaptureGui
	if not gui or not gui.Parent then
		gui = CoreGui:FindFirstChild(MAIN_SHORTCUT_CAPTURE_GUI_NAME)
		if not gui then
			gui = create("ScreenGui", {
				Name = MAIN_SHORTCUT_CAPTURE_GUI_NAME,
				DisplayOrder = 99998,
				Enabled = true,
				IgnoreGuiInset = true,
				ResetOnSpawn = false,
				ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
				Parent = CoreGui,
			})
		end
		self._mainShortcutCaptureGui = gui
	end

	if not gui then
		return self._shortcutCaptureInput
	end

	for _, child in ipairs(gui:GetChildren()) do
		if child.Name == "MainShortcutCaptureInput" then
			child:Destroy()
		end
	end

	local input = create("TextBox", {
		Name = "MainShortcutCaptureInput",
		Parent = gui,
		Active = true,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		Position = UDim2.fromOffset(-32, -32),
		Size = UDim2.fromOffset(1, 1),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 1,
		TextTransparency = 1,
		ZIndex = 10000,
	})
	input:SetAttribute("MegMoShortcutCapture", true)
	self._mainShortcutCaptureInput = input
	self._shortcutCaptureInput = input
	return input
end

function WidgetController:_mainShortcutDebug(eventName, ...)
	if not MAIN_SHORTCUT_DEBUG_ENABLED then
		return
	end

	local parts = { tostring(eventName or "event") }
	local viewModel = self._lastViewModel or {}
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local stateParts = {
		"enabled=" .. tostring(self._widget and self._widget.Enabled),
		"armed=" .. tostring(self._timelineShortcutArmed),
		"scope=" .. tostring(self._timelineShortcutScope),
		"shortcutControlMode=" .. tostring(self._mainShortcutControlMode),
		"mainDockWindowFocused=" .. tostring(self._mainDockWindowFocused),
		"mainShortcutOwner=" .. tostring(self._mainShortcutOwner),
		"mainTimelineShortcutOwned=" .. tostring(self._mainTimelineShortcutOwned),
		"shortcutFocus=" .. tostring(self._shortcutFocus),
		"timelineFocus=" .. tostring(self._timelineKeyboardFocus),
		"keySelection=" .. tostring(self._timelineKeySelectionActive),
		"mouseInside=" .. tostring(self._mouseInsideWidget),
		"captureFocused=" .. tostring(self:_isShortcutCaptureFocused()),
		"ctrlDown=" .. tostring(isControlDown()),
		"selectedKeys=" .. tostring(type(viewModel.selectedKeys) == "table" and #viewModel.selectedKeys or 0),
		"selectedTracks=" .. tostring(type(viewModel.selectedTrackPaths) == "table" and #viewModel.selectedTrackPaths or 0),
		"focusedTextBox=" .. tostring(focusedTextBox and focusedTextBox.Name or "nil"),
	}
	for _, value in ipairs(stateParts) do
		table.insert(parts, value)
	end
	local extras = table.pack(...)
	local hasSource = false
	local hasResult = false
	local hasReason = false
	for index = 1, extras.n do
		local value = tostring(extras[index])
		hasSource = hasSource or string.sub(value, 1, 7) == "source="
		hasResult = hasResult or string.sub(value, 1, 7) == "result="
		hasReason = hasReason or string.sub(value, 1, 7) == "reason="
	end
	local eventText = string.lower(tostring(eventName or "event"))
	if not hasSource then
		table.insert(parts, "source=MainShortcutSystem")
	end
	if not hasResult then
		local inferredResult = "Info"
		if string.find(eventText, "sink", 1, true) then
			inferredResult = "Sink"
		elseif string.find(eventText, "ignored", 1, true) or string.find(eventText, "blocked", 1, true) then
			inferredResult = "Ignored"
		elseif string.find(eventText, "pass", 1, true) then
			inferredResult = "Pass"
		end
		table.insert(parts, "result=" .. inferredResult)
	end
	if not hasReason and (string.find(eventText, "pass", 1, true) or string.find(eventText, "ignored", 1, true)) then
		table.insert(parts, "reason=unspecified")
	end
	for index = 1, select("#", ...) do
		table.insert(parts, tostring(select(index, ...)))
	end
	print("[7kg2 Main Shortcut Debug] | " .. table.concat(parts, " | "))
end

function WidgetController:_getEditableInputs()
	local inputs = {
		self._animationNameInput,
		self._frameInput,
		self._durationInput,
		self._fpsInput,
		self._moveSnapInput,
		self._rotateSnapInput,
		self._gizmoSizeInput,
		self._cameraFovInput,
		self._cameraTrackEditorFovInput,
		self._cameraTrackEditorDurationInput,
		self._cameraTrackEditorAggressionInput,
		self._cameraTrackEditorSmoothnessInput,
		self._cameraRotationXInput,
		self._cameraRotationYInput,
		self._cameraRotationZInput,
		self._effectsCameraDurationInput,
		self._effectsCameraRadiusInput,
		self._effectsCameraHeightInput,
		self._effectsCameraFovInput,
		self._effectsCameraLookSmoothingInput,
		self._effectsCameraIntensityInput,
		self._effectsCameraSmoothnessInput,
		self._effectsCameraStartOffsetInput,
		self._effectsCameraEndOffsetInput,
		self._durationInspectorInput,
		self._importIdInput,
		self._avatarInput,
		self._presetSearchInput,
		self._motionRecipeNameInput,
	}

	for _, input in ipairs(self._motionSegmentInputs or {}) do
		table.insert(inputs, input)
	end

	return inputs
end

function WidgetController:_isTextEditingActive()
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	local captureInput = self._mainShortcutCaptureInput or self._shortcutCaptureInput
	if focusedTextBox and focusedTextBox ~= captureInput and not self:_isMainShortcutCaptureInput(focusedTextBox) then
		return true
	end

	return self._editingTextInput ~= nil and self._editingTextInput.Parent ~= nil
end

function WidgetController:_isRealTextBoxFocused()
	local focusedTextBox = UserInputService:GetFocusedTextBox()
	if focusedTextBox and not self:_isMainShortcutCaptureInput(focusedTextBox) then
		return true
	end
	return self._editingTextInput ~= nil and self._editingTextInput.Parent ~= nil
end

function WidgetController:_mainShortcutControlAllows7kg2()
	return self._mainShortcutControlMode == "megmo"
end

function WidgetController:_ownsMainTimelineShortcuts()
	return self:_mainShortcutControlAllows7kg2()
		and self._mainShortcutOwner == "mainTimeline"
		and self._mainTimelineShortcutOwned == true
		and self._mainDockWindowFocused == true
		and self._widget
		and self._widget.Enabled == true
		and self._widget:GetAttribute("MegMoHiddenForMicro") ~= true
		and self._timelineShortcutScope == "timeline"
		and not self:_isRealTextBoxFocused()
end

function WidgetController:_getMainShortcutCaptureInput()
	return self._mainShortcutCaptureInput or self._mainDockShortcutCaptureInput or self._shortcutCaptureInput
end

function WidgetController:_setShiftHeld(isHeld)
	if self._shortcutShiftHeld == isHeld then
		return
	end

	self._shortcutShiftHeld = isHeld
	if not self._root or not self:_isShortcutContextActive() then
		return
	end

	if isHeld then
		self:_setShortcutHint("Shift selection active: click tracks or keyframes to add/remove")
	else
		self:_setShortcutHint("Shortcuts ready: + add keyframe, G reset limb, [/] prev/next frame, Space play/pause, N multi, P hide, M smooth, Y local/world, T trackball, R gizmo")
	end
end

function WidgetController:_isShiftHeldFromInputState()
	if self._timelineInput and self._timelineInput:isShiftHeld() then
		return true
	end

	return (self._keysDown and (self._keysDown.LeftShift or self._keysDown.RightShift))
		or isShiftDown()
		or (self._shiftGraceUntil and os.clock() &lt;= self._shiftGraceUntil)
end

function WidgetController:_setKeyHeld(keyCode, isHeld)
	if keyCode == Enum.KeyCode.Unknown then
		return
	end
	if isMainShortcutDebugKey(keyCode) then
		self:_mainShortcutDebug("setKeyHeld", "key=" .. tostring(keyCode.Name), "held=" .. tostring(isHeld))
	end

	pcall(function()
		local state = require(script.Parent:WaitForChild("ShortcutInputState"))
		if state and type(state.observeKeyCode) == "function" then
			state.observeKeyCode(keyCode, isHeld)
		end
	end)

	if isHeld
		and (keyCode == Enum.KeyCode.LeftControl or keyCode == Enum.KeyCode.RightControl)
		and self._widget
		and self._widget.Enabled
		and not self:_isTextEditingActive()
		and self:_shouldCaptureTimelineControlShortcuts("ctrlDown") then
		self._shortcutFocus = true
		self:_clearStudioSelectionForTimelineKeys()
		self:_activatePluginForShortcutKeyboard("ctrlDown:" .. tostring(keyCode.Name))
		local captureInput = self:_ensureDockShortcutCaptureInput()
		if captureInput and not self:_isShortcutCaptureFocused() then
			self._ctrlShortcutCaptureActive = true
			captureInput.Text = ""
			pcall(function()
				captureInput:CaptureFocus()
			end)
			self:_mainShortcutDebug("ctrlCaptureFocus", "key=" .. tostring(keyCode.Name), "target=" .. tostring(captureInput.Name))
		end
		self:_setShortcutHint("Timeline shortcuts ready: Ctrl+C/V/A/D/Z/Y")
	elseif not isHeld
		and (keyCode == Enum.KeyCode.LeftControl or keyCode == Enum.KeyCode.RightControl)
		and self._ctrlShortcutCaptureActive then
		self._ctrlShortcutCaptureActive = false
		self:_releaseShortcutCapture()
		self:_mainShortcutDebug("ctrlCaptureReleased", "key=" .. tostring(keyCode.Name))
	end

	if self._timelineInput and self._timelineInput:observeKeyCode(keyCode, isHeld) then
		return
	end

	self._keysDown = self._keysDown or {}
	if isHeld then
		self._keysDown[keyCode.Name] = true
	else
		if isShiftKey(keyCode) and self._shortcutShiftHeld then
			self._shiftGraceUntil = os.clock() + 0.35
			task.delay(0.35, function()
				if self._shiftGraceUntil and os.clock() &gt;= self._shiftGraceUntil and not self._multiSelectLocked and not isShiftDown() then
					self:_setShiftHeld(false)
				end
			end)
		end
		self._keysDown[keyCode.Name] = nil
	end

	if isShiftKey(keyCode) then
		self:_setShiftHeld(self:_isShiftHeldFromInputState())
	end
end

function WidgetController:_setShiftFromPoll(isHeld)
	if self._timelineInput then
		if isHeld then
			self._timelineInput:pollShift()
		elseif not self._multiSelectLocked then
			self._timelineInput:clearShift()
		end
		return
	end

	if isHeld then
		self._keysDown.LeftShift = true
		self:_setShiftHeld(true)
	elseif not self._multiSelectLocked and os.clock() &gt; (self._shiftGraceUntil or 0) then
		self._keysDown.LeftShift = nil
		self._keysDown.RightShift = nil
		self:_setShiftHeld(false)
	end
end

function WidgetController:_isAdditiveSelectionActive()
	return self._multiSelectLocked or self:_isShiftHeldFromInputState()
end

function WidgetController:_setMultiSelectLocked(isLocked)
	self._multiSelectLocked = isLocked == true
	self._viewportMultiTrackPaths = nil
	if not self._multiSelectLocked then
		self._shiftGraceUntil = 0
		self._keysDown.LeftShift = nil
		self._keysDown.RightShift = nil
		if self._timelineInput then
			self._timelineInput:clearShift()
		end
		self:_setShiftHeld(false)
	end
	if self._multiSelectButton then
		self._multiSelectButton.Text = self._multiSelectLocked and "Multi Select: On" or "Multi Select: Off"
		self._multiSelectButton.BackgroundColor3 = self._multiSelectLocked and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	end
	self:_setShortcutHint(self._multiSelectLocked
		and "Multi Select locked: click tracks, rig parts, or keyframes to add/remove"
		or "Multi Select off: hold Shift to add/remove selections")
end

function WidgetController:_isPointInsideEditableInput(point)
	for _, input in ipairs(self:_getEditableInputs()) do
		if input and isPointInsideGui(input, point) then
			return true
		end
	end

	return false
end

function WidgetController:_focusShortcutCapture(message, forceAttempt)
	if not self:_ownsMainTimelineShortcuts() then
		self:_setShortcutHint(message or "Timeline shortcuts paused: click the timeline to arm shortcuts")
		self:_mainShortcutDebug("focusShortcutCapture:ignored", "result=Ignored", "reason=noTimelineOwner")
		return
	end

	local now = os.clock()
	if not forceAttempt and self._lastShortcutCaptureAttemptAt and now - self._lastShortcutCaptureAttemptAt &lt; 0.5 then
		self:_setShortcutHint(message or "Shortcut capture active: Shift+A/C/D/V/X/Z/Y, R, T, Space")
		return
	end
	self._lastShortcutCaptureAttemptAt = now

	if self:_isTextEditingActive() then
		self:_mainShortcutDebug("focusShortcutCapture:blockedTextEditing")
		return
	end

	local focusedTextBox = UserInputService:GetFocusedTextBox()
	if focusedTextBox and not self:_isMainShortcutCaptureInput(focusedTextBox) then
		self:_mainShortcutDebug("focusShortcutCapture:blockedOtherTextBox", "focused=" .. tostring(focusedTextBox.Name))
		return
	end

	self._shortcutFocus = true
	self:_activatePluginForShortcutKeyboard("focusShortcutCapture")
	self:_releaseShortcutCapture()
	self:_mainShortcutDebug("focusShortcutCapture:pluginMouseOnly", "result=Info", "reason=shiftShortcuts")
	self:_setShortcutHint(message or "Shortcut capture: + add keyframe, G reset limb, [/] prev/next frame, Space play/pause, M smooth, Y local/world, Shift+A/C/D/V/X/Z/Y, R, T, B, H, Keypad 7.")
	return
end

function WidgetController:_releaseShortcutCapture()
	local captureInput = self._mainShortcutCaptureInput or self._shortcutCaptureInput
	if captureInput and self:_isShortcutCaptureFocused() then
		captureInput:ReleaseFocus()
	end
	if self._mainDockShortcutCaptureInput and UserInputService:GetFocusedTextBox() == self._mainDockShortcutCaptureInput then
		self._mainDockShortcutCaptureInput:ReleaseFocus()
	end
end

function WidgetController:_activatePluginForShortcutKeyboard(reason)
	if not self:_mainShortcutControlAllows7kg2() then
		self:_mainShortcutDebug("shortcutKeyboardPluginActivateSkipped", "source=" .. tostring(reason), "result=Pass", "reason=shortcutControlStudio")
		return false
	end
	if not self._widget or self._widget.Enabled ~= true or self._widget:GetAttribute("MegMoHiddenForMicro") == true then
		self:_mainShortcutDebug("shortcutKeyboardPluginActivateSkipped", "source=" .. tostring(reason), "result=Ignored", "reason=widgetUnavailable")
		return false
	end
	if self._mainDockWindowFocused ~= true then
		self:_mainShortcutDebug("shortcutKeyboardPluginActivateSkipped", "source=" .. tostring(reason), "result=Pass", "reason=windowNotFocused")
		return false
	end
	if not self._plugin or type(self._plugin.Activate) ~= "function" then
		self:_mainShortcutDebug("shortcutKeyboardPluginActivateSkipped", "source=" .. tostring(reason), "result=Ignored", "reason=pluginActivateUnavailable")
		return false
	end

	local ok, err = pcall(function()
		self._plugin:Activate(false)
	end)
	if ok then
		self._shortcutKeyboardPluginActive = true
		self:_mainShortcutDebug("shortcutKeyboardPluginActivate", "source=" .. tostring(reason), "result=Activated", "reason=exclusiveMouseFalse")
		return true
	end

	self:_mainShortcutDebug("shortcutKeyboardPluginActivateFailed", "source=" .. tostring(reason), "result=Ignored", "reason=" .. tostring(err))
	return false
end

function WidgetController:_acquireMainTimelineShortcuts(reason)
	if not self:_mainShortcutControlAllows7kg2() then
		self:_releaseMainTimelineShortcuts("shortcut-control-studio")
		self:_mainShortcutDebug("mainTimelineAcquireIgnored", "source=" .. tostring(reason), "result=Pass", "reason=shortcutControlStudio")
		self:_setShortcutHint("Timeline shortcuts paused")
		return false
	end
	if self:_isRealTextBoxFocused() then
		self:_mainShortcutDebug("mainTimelineAcquireIgnored", "source=" .. tostring(reason), "result=Ignored", "reason=realTextBoxFocused")
		return false
	end
	self._mainDockWindowFocused = true
	self._mainShortcutOwner = "mainTimeline"
	self._mainTimelineShortcutOwned = true
	self._timelineShortcutArmed = true
	self._timelineShortcutScope = "timeline"
	self._timelineKeyboardFocus = true
	self._timelineKeySelectionActive = true
	self._shortcutFocus = true
	self._mainShortcutOwnershipAcquiredAt = os.clock()
	self._mainShortcutSyntheticDockFocus = false
	if self._callbacks and type(self._callbacks.onResumeViewportRigPartPicker) == "function" then
		self._callbacks.onResumeViewportRigPartPicker()
	end
	self:_clearStudioSelectionForTimelineKeys()
	self:_bindMainShortcutSink(self._callbacks, "owner:" .. tostring(reason))
	self:_activatePluginForShortcutKeyboard(reason)
	self._mainShortcutActivationToken += 1
	self:_mainShortcutDebug("mainTimelineAcquire", "source=" .. tostring(reason), "result=Owned")
	self:_focusShortcutCapture("Timeline shortcuts ready: Shift+A/C/D/V/X/Z/Y", true)
	return true
end

function WidgetController:_releaseMainTimelineShortcuts(reason)
	local hadOwner = self._mainTimelineShortcutOwned == true or self._mainShortcutOwner ~= nil
	self._mainShortcutOwner = nil
	self._mainTimelineShortcutOwned = false
	self._timelineShortcutArmed = false
	self._timelineShortcutScope = nil
	self._timelineKeyboardFocus = false
	self._timelineKeySelectionActive = false
	self._shortcutFocus = false
	self._mainShortcutOwnershipAcquiredAt = 0
	self._mainShortcutSyntheticDockFocus = false
	self._ctrlShortcutCaptureActive = false
	if self._rootKeyboardShortcutHandledKeys then
		table.clear(self._rootKeyboardShortcutHandledKeys)
	end
	if self._mainControlShortcutPollState then
		table.clear(self._mainControlShortcutPollState)
	end
	self:_releaseShortcutCapture()
	if self._shortcutKeyboardPluginActive and self._plugin and type(self._plugin.Deactivate) == "function" then
		if not require(script.Parent:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
			pcall(function()
				self._plugin:Deactivate()
			end)
		end
		self._shortcutKeyboardPluginActive = false
	end
	if hadOwner then
		self:_mainShortcutDebug("mainTimelineRelease", "source=" .. tostring(reason), "result=Released")
	end
end

function WidgetController:_markTimelineShortcutScope(scope)
	if scope == "timeline" then
		self:_acquireMainTimelineShortcuts("mark:" .. tostring(scope))
	else
		self:_releaseMainTimelineShortcuts("mark:" .. tostring(scope or "plugin"))
		self._timelineShortcutScope = scope or "plugin"
		self:_mainShortcutDebug("armed", "newScope=" .. tostring(self._timelineShortcutScope), "result=Pass", "reason=nonTimelineScope")
	end
end

function WidgetController:_disarmTimelineShortcuts(message)
	self:_releaseMainTimelineShortcuts(message or "disarm")
	self:_mainShortcutDebug("disarmed", "message=" .. tostring(message))
	if message then
		self:_setShortcutHint(message)
	end
end

function WidgetController:_activateShortcutContext(message)
	self:_acquireMainTimelineShortcuts(message or "activateShortcutContext")
end

function WidgetController:_isShortcutContextActive()
	if not self._widget.Enabled then
		return false
	end

	if self:_isRealTextBoxFocused() then
		return false
	end

	return self:_ownsMainTimelineShortcuts() or self:_isShortcutCaptureFocused()
end

function WidgetController:_hasSelectedKeyframes()
	return self._lastViewModel
		and type(self._lastViewModel.selectedKeys) == "table"
		and #self._lastViewModel.selectedKeys &gt; 0
end

function WidgetController:_hasSelectedTimelineItems()
	return self:_hasSelectedKeyframes()
		or (self._lastViewModel
			and type(self._lastViewModel.selectedTrackPaths) == "table"
			and #self._lastViewModel.selectedTrackPaths &gt; 0)
end

function WidgetController:_shouldCaptureMainToolToggleShortcut(keyCode)
	local isViewportToggle = keyCode == Enum.KeyCode.H or keyCode == Enum.KeyCode.B
	if keyCode ~= Enum.KeyCode.R and keyCode ~= Enum.KeyCode.T and not isViewportToggle then
		return false
	end
	if not self:_mainShortcutControlAllows7kg2() then
		return false
	end
	if not self._widget
		or self._widget.Enabled ~= true
		or self._widget:GetAttribute("MegMoHiddenForMicro") == true then
		return false
	end
	if self:_isRealTextBoxFocused() then
		return false
	end

	local viewModel = self._lastViewModel
	if type(viewModel) ~= "table" then
		return false
	end
	if isViewportToggle then
		return true
	end
	if viewModel.selectedTrackType == "Camera" then
		return false
	end
	if viewModel.selectedJointPath ~= nil then
		return true
	end
	if type(viewModel.selectedKeys) == "table" and #viewModel.selectedKeys &gt; 0 then
		return true
	end
	return type(viewModel.selectedTrackPaths) == "table" and #viewModel.selectedTrackPaths &gt; 0
end

function WidgetController:_hasTimelineKeyboardFocus()
	return self._timelineKeyboardFocus == true
end

function WidgetController:_shouldCaptureTimelineControlShortcuts(debugReason)
	local result = self:_ownsMainTimelineShortcuts()

	if debugReason then
		self:_mainShortcutDebug("shouldCapture", "reason=" .. tostring(debugReason), "result=" .. tostring(result))
	end

	return result
end

function WidgetController:_getStudioSelectionCount()
	local ok, selected = pcall(function()
		return Selection:Get()
	end)
	if not ok or type(selected) ~= "table" then
		return 0
	end
	return #selected
end

function WidgetController:_clearStudioSelectionForTimelineKeys()
	pcall(function()
		if #Selection:Get() &gt; 0 then
			Selection:Set({})
		end
	end)
end

function WidgetController:_enterTimelineKeyboardFocus(message)
	if self:_isRealTextBoxFocused() then
		return
	end

	self:_acquireMainTimelineShortcuts(message or "enterTimelineKeyboardFocus")
	if message then
		self:_setShortcutHint(message)
	end
end

function WidgetController:_exitTimelineKeyboardFocus(message)
	self._timelineKeyboardFocus = false
	if not self:_hasSelectedKeyframes() then
		self._timelineKeySelectionActive = false
	end
	if message then
		self:_setShortcutHint(message)
	end
end

function WidgetController:_deleteSelectedTimelineItems(callbacks, message)
	if not callbacks or not callbacks.onDeleteKeys then
		return false
	end

	callbacks.onDeleteKeys()
	self._timelineKeyboardFocus = false
	self._timelineKeySelectionActive = false
	self:_setShortcutHint(message or "Deleted selected keyframes")
	return true
end

function WidgetController:_deleteSelectedTimelineKeyframes(callbacks, message)
	return self:_deleteSelectedTimelineItems(callbacks, message)
end

function WidgetController:_prepareTimelineControlShortcut(keyCode)
	if keyCode == Enum.KeyCode.A
		or keyCode == Enum.KeyCode.C
		or keyCode == Enum.KeyCode.D
		or keyCode == Enum.KeyCode.V
		or keyCode == Enum.KeyCode.Z
		or keyCode == Enum.KeyCode.Y then
		self:_acquireMainTimelineShortcuts("controlShortcut:" .. tostring(keyCode.Name))
	end
end

function WidgetController:_setShortcutHint(text)
	if self._shortcutHint then
		self._shortcutHint.Text = tostring(text or "")
	end
end

function WidgetController:_setCutsceneStatus(text)
	if self._scriptStatusLabel then
		self._scriptStatusLabel.Text = tostring(text or "Cutscene Maker is ready.")
	end
end

function WidgetController:_hidePreviewFilmGrainFrames()
	for _, frame in ipairs(self._screenPreviewFilmGrainFrames or {}) do
		frame.Visible = false
	end
end

function WidgetController:_showStaticPreviewFilmGrain()
	local frames = self._screenPreviewFilmGrainFrames or {}
	if #frames == 0 then
		return
	end

	for index, frame in ipairs(frames) do
		frame.Visible = index == 1 or index == 7
	end
end

function WidgetController:_setPreviewFilmGrainEnabled(isEnabled)
	isEnabled = isEnabled == true
	if self._screenPreviewFilmGrain then
		self._screenPreviewFilmGrain.Visible = isEnabled
	end

	if isEnabled then
		self:_showStaticPreviewFilmGrain()
	else
		if self._screenFilmGrainPreviewConnection then
			self._screenFilmGrainPreviewConnection:Disconnect()
			self._screenFilmGrainPreviewConnection = nil
		end
		self:_hidePreviewFilmGrainFrames()
	end
end

function WidgetController:_renderScreenEffects(viewModel)
	local effects = viewModel and viewModel.effects or {}
	local enabledById = {}
	local activeCount = tonumber(effects.activeScreenEffectCount) or 0
	local vignetteTone = effects.vignetteTone == "Light" and "Light" or "Dark"

	for _, effect in ipairs(effects.screenEffects or {}) do
		local effectId = tostring(effect.id or "")
		local isEnabled = effect.enabled == true
		enabledById[effectId] = isEnabled

		local button = self._screenEffectButtons and self._screenEffectButtons[effectId]
		if button then
			button.Text = "Add Track"
			button.BackgroundColor3 = Constants.THEME.PanelSoft
		end
	end

	if self._screenEffectsStatus then
		self._screenEffectsStatus.Text = string.format(
			"%d viewer preview effect%s active. Use Add Track to keyframe effects on the timeline.",
			activeCount,
			activeCount == 1 and "" or "s"
		)
	end
	if self._screenPreviewLetterboxTop then
		self._screenPreviewLetterboxTop.Visible = enabledById.Letterbox == true
	end
	if self._screenPreviewLetterboxBottom then
		self._screenPreviewLetterboxBottom.Visible = enabledById.Letterbox == true
	end
	if self._screenPreviewVignette then
		self._screenPreviewVignette.Visible = enabledById.Vignette == true and vignetteTone == "Dark"
	end
	if self._screenPreviewVignetteLight then
		self._screenPreviewVignetteLight.Visible = enabledById.Vignette == true and vignetteTone == "Light"
	end
	if self._screenPreviewFade then
		self._screenPreviewFade.Visible = enabledById.Fade == true
	end
	self:_setPreviewFilmGrainEnabled(
		enabledById.FilmGrain == true and self._effectsOverlay and self._effectsOverlay.Visible == true
	)
	if self._screenPreviewCameraFlash then
		self._screenPreviewCameraFlash.Visible = enabledById.CameraFlash == true
	end
	if self._screenPreviewColorWash then
		self._screenPreviewColorWash.Visible = enabledById.ColorWash == true
	end

	local subtitleText = tostring(effects.subtitleText or "Your subtitle goes here")
	if self._screenPreviewSubtitle then
		self._screenPreviewSubtitle.Visible = enabledById.Subtitle == true
		self._screenPreviewSubtitle.Text = subtitleText
	end
end

function WidgetController:_setEffectsOverlayVisible(isVisible)
	if self._effectsOverlay then
		self._effectsOverlay.Visible = isVisible == true
	end
	if self._effectsTab then
		self._effectsTab.BackgroundColor3 = isVisible == true and Constants.THEME.Accent or Constants.THEME.PanelSoft
		self._effectsTab.TextColor3 = ThemeService.getReadableTextColor(self._effectsTab.BackgroundColor3)
	end
	if isVisible == true then
		self:_renderScreenEffects(self._lastViewModel)
	else
		self:_setPreviewFilmGrainEnabled(false)
	end
	self:_setShortcutHint(isVisible == true
		and "Effects panel open: choose a category, or close to return to editing"
		or "Effects panel closed")
end

function WidgetController:_setFacesOverlayVisible(isVisible)
	if self._facesOverlay then
		self._facesOverlay.Visible = isVisible == true
	end
	if self._facesTab then
		self._facesTab.BackgroundColor3 = isVisible == true and Constants.THEME.Accent or Constants.THEME.PanelSoft
		self._facesTab.TextColor3 = ThemeService.getReadableTextColor(self._facesTab.BackgroundColor3)
	end
	if isVisible == true and self._uiSections.FacesUI and type(self._uiSections.FacesUI.render) == "function" then
		pcall(self._uiSections.FacesUI.render, self, (self._lastViewModel and self._lastViewModel.faces) or {})
	end
	self:_setShortcutHint(isVisible == true and "Faces panel open: click a preset to key the selected rig" or "Faces panel closed")
end

function WidgetController:_setHelpOverlayVisible(isVisible, guideKey)
	if self._helpOverlay then
		self._helpOverlay.Visible = isVisible == true
	end
	if isVisible == true and self._helpOpenGuide then
		self._helpOpenGuide(guideKey or "HelpGettingStarted")
	end
	self:_setShortcutHint(isVisible == true and "Help guide open" or "Help guide closed")
end

function WidgetController:_setEnhanceOverlayVisible(isVisible)
	if self._enhanceOverlay then
		self._enhanceOverlay.Visible = isVisible == true
	end
	if isVisible == true and self._enhanceStatus then
		self._enhanceStatus.Text = "Tip: these tools only run when you click them, then bake normal keyframes."
	end
	self:_setShortcutHint(isVisible == true and "Enhance Animation panel open" or "Enhance Animation panel closed")
end

function WidgetController:_findTrackInViewModel(path)
	if not path then
		return nil
	end

	local viewModel = self._lastViewModel or {}
	for _, track in ipairs(viewModel.tracks or {}) do
		if track.path == path then
			return track
		end
	end

	return nil
end

function WidgetController:_getOptionsTrackFromSelection()
	local viewModel = self._lastViewModel or {}
	for _, key in ipairs(viewModel.selectedKeys or {}) do
		local track = self:_findTrackInViewModel(key.jointPath or key.path)
		if track then
			return track
		end
	end

	local selectedTrack = self:_findTrackInViewModel(viewModel.selectedJointPath)
	if selectedTrack then
		return selectedTrack
	end

	for _, path in ipairs(viewModel.selectedTrackPaths or {}) do
		local track = self:_findTrackInViewModel(path)
		if track then
			return track
		end
	end

	return nil
end

function WidgetController:_openSelectedOptionsPopup()
	if #((self._lastViewModel and self._lastViewModel.selectedGroupIds) or {}) &gt; 0 then
		return self:_showSelectedGroupOptions()
	end
	local track = self:_getOptionsTrackFromSelection()
	if not track then
		return false, "Keypad 7: select an effect or property keyframe first"
	end

	local trackType = track.trackType or "Rig"
	if trackType == "Screen Effect" or trackType == "Lighting Effect" then
		self:_showEffectTrackEditor(track.path)
		return true, "Effect settings open: choose a preset to write a keyframe"
	end

	if trackType == "Camera" or trackType == "Camera Property" then
		self:_showCameraTrackEditor(track.path)
		return true, "Camera settings open: capture camera, set FOV, or add a preset move"
	end

	if self:_isParticlePropertyTrack(track) then
		self:_showParticleKeyframeEditor(track.path)
		return true, "Particle keyframe settings open"
	end

	if self:_isSoundKeyframeTrack(track) then
		self:_showSoundKeyframeEditor(track.path)
		return true, "Sound keyframe settings open"
	end

	if self:_isFaceKeyframeTrack(track) then
		self:_setFacesOverlayVisible(true)
		return true, "Faces panel open: choose or edit a face preset"
	end

	if trackType == "Event" or track.valueType == "Event" then
		self:_showRigPropertyEditor(track.path, track.name)
		return true, "Event options open: name the event and marker payload"
	end

	if self:_isEditablePropertyKeyframeTrack(track) then
		self:_showPropertyKeyframeEditor(track.path)
		return true, "Property keyframe settings open"
	end

	if (trackType == "Rig Group" or trackType == "Rig Property") and track.rigName then
		local editorTrackPath = ((trackType == "Rig Group") and makeRigGroupTrackPath(track.rigName))
			or track.path
		self:_showRigPropertyEditor(editorTrackPath, track.rigName)
		return true, "Rig property options open: toggle properties or confirm"
	end

	if trackType == "Rig" then
		self:_showRigPropertyEditor(track.path, track.name)
		return true, "Rig part property options open: toggle part properties or confirm"
	end

	if (trackType == "Object"
		or trackType == "Part"
		or trackType == "BasePart"
		or trackType == "Model"
		or trackType == "Rig CFrame"
		or trackType == "Object Property"
		or trackType == "Emitter Group") then
		self:_showRigPropertyEditor(track.path, track.name)
		return true, "Object property options open: toggle properties or confirm"
	end

	return false, "Keypad 7: this selected keyframe does not have extra options yet"
end

function WidgetController:_activatePluginForToolShortcut()
	if self._plugin and type(self._plugin.Activate) == "function" then
		pcall(function()
			self._plugin:Activate(true)
		end)
	end
end

function WidgetController:_activateMainGizmoMode(callbacks, mode)
	if not callbacks or not callbacks.onSetGizmoMode then
		return false
	end
	self:_activatePluginForToolShortcut()
	callbacks.onSetGizmoMode(mode)
	return true
end

function WidgetController:_activateMainTrackballMode(callbacks, mode)
	if not callbacks or not callbacks.onBeginTrackballMode then
		return false
	end
	self:_activatePluginForToolShortcut()
	callbacks.onBeginTrackballMode(mode)
	return true
end

function WidgetController:_shouldYieldShiftCameraNavigationShortcut(keyCode)
	if keyCode ~= Enum.KeyCode.A and keyCode ~= Enum.KeyCode.D then
		return false
	end
	if isControlDown()
		or not (self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift) then
		return false
	end
	if not self._root or isPointInsideGui(self._root, getCurrentMousePoint()) then
		return false
	end

	local rightMouseDown = false
	local middleMouseDown = false
	pcall(function()
		rightMouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		middleMouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
	end)
	return rightMouseDown or middleMouseDown
end

function WidgetController:_runShortcutAction(callbacks, keyCode)
	if isMainShortcutDebugKey(keyCode) then
		self:_mainShortcutDebug("runShortcutAction:start", "key=" .. tostring(keyCode.Name))
	end
	if self:_shouldYieldShiftCameraNavigationShortcut(keyCode) then
		self:_mainShortcutDebug(
			"runShortcutAction:passCameraNavigation",
			"key=" .. tostring(keyCode.Name),
			"result=Pass",
			"reason=studioViewportCameraNavigation"
		)
		return false
	end
	local now = os.clock()
	local signature = keyCode.Name
	if keyCode == Enum.KeyCode.B or keyCode == Enum.KeyCode.H or keyCode == Enum.KeyCode.R then
		signature = signature .. ":shift=" .. tostring(self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift)
	end
	if self._lastShortcutSignature == signature
		and now - self._lastShortcutTime &lt; ((keyCode == Enum.KeyCode.B or keyCode == Enum.KeyCode.H or keyCode == Enum.KeyCode.R) and 0.25 or 0.08) then
		if isMainShortcutDebugKey(keyCode) then
			self:_mainShortcutDebug("runShortcutAction:duplicate", "key=" .. tostring(keyCode.Name))
		end
		return true
	end
	self._lastShortcutSignature = signature
	self._lastShortcutTime = now

	local hint
	if keyCode == Enum.KeyCode.C then
		if self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift or isControlDown() then
			if isControlDown() then
				self:_prepareTimelineControlShortcut(keyCode)
			end
			callbacks.onCopyKeys()
			hint = isControlDown() and "Last shortcut: Ctrl+C -&gt; Copy" or "Last shortcut: Shift+C -&gt; Copy"
		else
			local _, label = CameraGuideService.cycle()
			hint = "Last shortcut: C -&gt; Camera Guide " .. tostring(label)
		end
	elseif keyCode == Enum.KeyCode.X then
		callbacks.onCutKeys()
		hint = "Last shortcut: Shift+X -&gt; Cut"
	elseif keyCode == Enum.KeyCode.V then
		if isControlDown() then
			self:_prepareTimelineControlShortcut(keyCode)
		end
		callbacks.onPasteKeys()
		hint = isControlDown() and "Last shortcut: Ctrl+V -&gt; Paste" or "Last shortcut: Shift+V -&gt; Paste"
	elseif keyCode == Enum.KeyCode.A and callbacks.onSelectAllKeys then
		local shiftShortcut = self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift
		local controlShortcut = isControlDown()
		if not (controlShortcut or shiftShortcut) then
			return false
		end
		if controlShortcut then
			self:_prepareTimelineControlShortcut(keyCode)
		end
		local viewModel = self._lastViewModel or {}
		local hasSelectedTracks = type(viewModel.selectedTrackPaths) == "table" and #viewModel.selectedTrackPaths &gt; 0
		local hasSelectedKeys = type(viewModel.selectedKeys) == "table" and #viewModel.selectedKeys &gt; 0
		local scopeMode = (hasSelectedTracks and not hasSelectedKeys) and "track" or "timeline"
		callbacks.onSelectAllKeys(scopeMode)
		task.defer(function()
			self:_clearStudioSelectionForTimelineKeys()
		end)
		task.delay(0.05, function()
			self:_clearStudioSelectionForTimelineKeys()
		end)
		local shortcutLabel = controlShortcut and "Ctrl+A" or "Shift+A"
		hint = scopeMode == "track" and ("Last shortcut: " .. shortcutLabel .. " -&gt; Select All Track Keys") or ("Last shortcut: " .. shortcutLabel .. " -&gt; Select All Timeline Keys")
	elseif keyCode == Enum.KeyCode.Z then
		if isControlDown() then
			self:_prepareTimelineControlShortcut(keyCode)
		end
		callbacks.onUndo()
		hint = isControlDown() and "Last shortcut: Ctrl+Z -&gt; Undo" or "Last shortcut: Shift+Z -&gt; Undo"
	elseif keyCode == Enum.KeyCode.Y then
		if (self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift or isControlDown()) and callbacks.onRedo then
			if isControlDown() then
				self:_prepareTimelineControlShortcut(keyCode)
			end
			callbacks.onRedo()
			hint = isControlDown() and "Last shortcut: Ctrl+Y -&gt; Redo" or "Last shortcut: Shift+Y -&gt; Redo"
		elseif callbacks.onToggleRotateSpace then
			callbacks.onToggleRotateSpace()
			hint = "Last shortcut: Y -&gt; Toggle Local/World Move-Rotate"
		else
			return false
		end
	elseif keyCode == Enum.KeyCode.M then
		if (self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift) and callbacks.onMirrorKeys then
			callbacks.onMirrorKeys()
			hint = "Last shortcut: Shift+M -&gt; Mirror"
		elseif callbacks.onSmoothMotion then
			callbacks.onSmoothMotion("Light")
			hint = "Last shortcut: M -&gt; Smooth Motion"
		else
			return false
		end
	elseif keyCode == Enum.KeyCode.I and callbacks.onInvertKeys then
		callbacks.onInvertKeys()
		hint = "Last shortcut: Shift+I -&gt; Invert"
	elseif (keyCode == Enum.KeyCode.Delete or keyCode == Enum.KeyCode.Backspace) and callbacks.onDeleteKeys then
		local shortcutLabel = keyCode == Enum.KeyCode.Backspace and "Backspace" or "Delete"
		self:_deleteSelectedTimelineKeyframes(callbacks, "Last shortcut: " .. shortcutLabel .. " -&gt; Delete")
		hint = "Last shortcut: " .. shortcutLabel .. " -&gt; Delete"
	elseif keyCode == Enum.KeyCode.D and callbacks.onDeleteKeys then
		local shiftShortcut = self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift
		local controlShortcut = isControlDown()
		if not (controlShortcut or shiftShortcut) then
			return false
		end
		if controlShortcut then
			self:_prepareTimelineControlShortcut(keyCode)
		end
		local shortcutLabel = controlShortcut and "Ctrl+D" or "Shift+D"
		self:_deleteSelectedTimelineKeyframes(callbacks, "Last shortcut: " .. shortcutLabel .. " -&gt; Delete")
		hint = "Last shortcut: " .. shortcutLabel .. " -&gt; Delete"
	elseif keyCode == Enum.KeyCode.R then
		if (self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift) and callbacks.onRecordMotion then
			callbacks.onRecordMotion()
			hint = "Last shortcut: Shift+R -&gt; Record Motion"
		elseif callbacks.onToggleGizmoMode then
			local _, message = callbacks.onToggleGizmoMode()
			hint = "Last shortcut: R -&gt; " .. tostring(message or "Toggle Move/Rotate")
		else
			local mode = (self._lastViewModel and self._lastViewModel.gizmoMode == "Rotate") and "Move" or "Rotate"
			if not self:_activateMainGizmoMode(callbacks, mode) then
				return false
			end
			hint = mode == "Move" and "Last shortcut: R -&gt; Move Tool" or "Last shortcut: R -&gt; Rotate Tool"
		end
	elseif keyCode == Enum.KeyCode.T then
		if self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift then
			if not self:_activateMainTrackballMode(callbacks, "Move") then
				return false
			end
			hint = "Last shortcut: Shift+T -&gt; Trackball Move"
		else
			if not self:_activateMainTrackballMode(callbacks, "Rotate") then
				return false
			end
			hint = "Last shortcut: T -&gt; Trackball Rotate"
		end
	elseif keyCode == Enum.KeyCode.G and callbacks.onDefaultPoseKeyframes then
		callbacks.onDefaultPoseKeyframes(true)
		hint = "Last shortcut: G -&gt; Reset selected limb"
	elseif keyCode == Enum.KeyCode.B then
		if (self._shortcutShiftHeld or isShiftDown() or self._shortcutTextImpliesShift) and callbacks.onToggleRigHandles then
			local _, message = callbacks.onToggleRigHandles()
			hint = "Last shortcut: Shift+B -&gt; " .. (message or "Toggle Rig/Bone Handles")
		elseif callbacks.onToggleOnionSkin then
			callbacks.onToggleOnionSkin()
			hint = "Last shortcut: B -&gt; Toggle Onion Skin"
		else
			return false
		end
	elseif keyCode == Enum.KeyCode.H and callbacks.onToggleRigPartHighlight then
		callbacks.onToggleRigPartHighlight()
		hint = "Last shortcut: H -&gt; Toggle Viewport Part Picker"
	elseif keyCode == Enum.KeyCode.K then
		self:_setEffectsOverlayVisible(false)
		self:_showWiggleFramesOverlay()
		hint = "Last shortcut: K -&gt; Wiggle / Fill Frames"
	elseif keyCode == Enum.KeyCode.N then
		self:_setMultiSelectLocked(not self._multiSelectLocked)
		hint = self._multiSelectLocked and "Last shortcut: N -&gt; Multi Select On" or "Last shortcut: N -&gt; Multi Select Off"
	elseif keyCode == Enum.KeyCode.P and callbacks.onToggleHideDuringPlayback then
		local _, message = callbacks.onToggleHideDuringPlayback()
		hint = "Last shortcut: P -&gt; " .. (message or "Toggle Hide During Playback")
	elseif (keyCode == Enum.KeyCode.Plus or keyCode == Enum.KeyCode.KeypadPlus or keyCode == Enum.KeyCode.Equals) and callbacks.onCaptureFrame then
		self:_rememberTimelineCanvasForNextRefresh()
		callbacks.onCaptureFrame()
		hint = "Last shortcut: + -&gt; Add Keyframe"
	elseif keyCode == Enum.KeyCode.LeftBracket and (callbacks.onStepTimelineFrame or callbacks.onPreviousKeyframe) then
		if callbacks.onStepTimelineFrame then
			callbacks.onStepTimelineFrame(-1)
			hint = "Last shortcut: [ -&gt; Previous frame"
		else
			callbacks.onPreviousKeyframe()
			hint = "Last shortcut: [ -&gt; Previous keyframe"
		end
	elseif keyCode == Enum.KeyCode.RightBracket and (callbacks.onStepTimelineFrame or callbacks.onNextKeyframe) then
		if callbacks.onStepTimelineFrame then
			callbacks.onStepTimelineFrame(1)
			hint = "Last shortcut: ] -&gt; Next frame"
		else
			callbacks.onNextKeyframe()
			hint = "Last shortcut: ] -&gt; Next keyframe"
		end
	elseif keyCode == Enum.KeyCode.KeypadSeven or keyCode == Enum.KeyCode.Seven then
		local _, message = self:_openSelectedOptionsPopup()
		hint = message
	elseif keyCode == Enum.KeyCode.Space and isControlDown() and callbacks.onToggleCameraTrackEnabled then
		callbacks.onToggleCameraTrackEnabled()
		hint = "Last shortcut: Ctrl+Space -&gt; Toggle Camera"
	elseif keyCode == Enum.KeyCode.Space and callbacks.onPlayPause then
		callbacks.onPlayPause()
		hint = "Last shortcut: Space -&gt; Play/Pause"
	else
		if isMainShortcutDebugKey(keyCode) then
			self:_mainShortcutDebug("runShortcutAction:notHandled", "key=" .. tostring(keyCode.Name))
		end
		return false
	end

	self:_setShortcutHint(hint)
	if isMainShortcutDebugKey(keyCode) then
		self:_mainShortcutDebug("runShortcutAction:handled", "key=" .. tostring(keyCode.Name), "hint=" .. tostring(hint))
	end
	task.defer(function()
		if self._widget.Enabled then
			self:_focusShortcutCapture(hint)
		end
	end)

	return true
end

function WidgetController:_runTrackballAxisShortcut(callbacks, keyCode)
	local axis = nil
	if keyCode == Enum.KeyCode.X then
		axis = "X"
	elseif keyCode == Enum.KeyCode.Y then
		axis = "Y"
	elseif keyCode == Enum.KeyCode.Z then
		axis = "Z"
	end

	if not axis or not callbacks.onSetTrackballAxis then
		return false
	end

	self._trackballAxisKeysDown = self._trackballAxisKeysDown or {}
	self._trackballAxisKeyTimes = self._trackballAxisKeyTimes or {}
	if self._trackballAxisKeysDown[keyCode.Name] then
		local lastPressTime = self._trackballAxisKeyTimes[keyCode.Name] or 0
		if os.clock() - lastPressTime &lt; 0.2 then
			return true
		end
	end
	self._trackballAxisKeysDown[keyCode.Name] = true
	self._trackballAxisKeyTimes[keyCode.Name] = os.clock()

	local handled = callbacks.onSetTrackballAxis(axis)
	if not handled then
		self._trackballAxisKeysDown[keyCode.Name] = nil
		return false
	end

	local currentAxis = nil
	if callbacks.onGetTrackballAxis then
		currentAxis = callbacks.onGetTrackballAxis()
	end
	if currentAxis then
		self:_setShortcutHint("Trackball axis lock: " .. tostring(currentAxis) .. " (press again to unlock)")
	else
		self:_setShortcutHint("Trackball axis lock off: free Trackball rotation")
	end
	return true
end

function WidgetController:_releaseTrackballAxisShortcut(keyCode)
	if not keyCode or not self._trackballAxisKeysDown then
		return
	end
	self._trackballAxisKeysDown[keyCode.Name] = nil
	if self._trackballAxisKeyTimes then
		self._trackballAxisKeyTimes[keyCode.Name] = nil
	end
end

function WidgetController:_handleShortcutInput(callbacks, inputObject)
	local shortcutDown = self._shortcutShiftHeld or isShiftDown()
	local controlDown = isControlDown()
	if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
		self:_mainShortcutDebug(
			"handleShortcutInput",
			"key=" .. tostring(inputObject.KeyCode.Name),
			"shift=" .. tostring(shortcutDown),
			"control=" .. tostring(controlDown)
		)
	end

	if controlDown and (
		inputObject.KeyCode == Enum.KeyCode.A
		or inputObject.KeyCode == Enum.KeyCode.C
		or inputObject.KeyCode == Enum.KeyCode.D
		or inputObject.KeyCode == Enum.KeyCode.V
		or inputObject.KeyCode == Enum.KeyCode.Z
		or inputObject.KeyCode == Enum.KeyCode.Y
	) then
		if not self:_shouldCaptureTimelineControlShortcuts("handleControlShortcut") then
			self:_mainShortcutDebug("handleShortcutInput:blockedControl", "key=" .. tostring(inputObject.KeyCode.Name))
			return false
		end
		return self:_runShortcutAction(callbacks, inputObject.KeyCode)
	end

	if not shortcutDown and self:_runTrackballAxisShortcut(callbacks, inputObject.KeyCode) then
		return true
	end

	if inputObject.KeyCode == Enum.KeyCode.R
		or inputObject.KeyCode == Enum.KeyCode.T
		or inputObject.KeyCode == Enum.KeyCode.G
		or inputObject.KeyCode == Enum.KeyCode.B
		or inputObject.KeyCode == Enum.KeyCode.H
		or inputObject.KeyCode == Enum.KeyCode.K
		or inputObject.KeyCode == Enum.KeyCode.N
		or inputObject.KeyCode == Enum.KeyCode.P
		or inputObject.KeyCode == Enum.KeyCode.M
		or inputObject.KeyCode == Enum.KeyCode.Y
		or inputObject.KeyCode == Enum.KeyCode.C
		or inputObject.KeyCode == Enum.KeyCode.Space
		or inputObject.KeyCode == Enum.KeyCode.Plus
		or inputObject.KeyCode == Enum.KeyCode.KeypadPlus
		or inputObject.KeyCode == Enum.KeyCode.Equals
		or inputObject.KeyCode == Enum.KeyCode.LeftBracket
		or inputObject.KeyCode == Enum.KeyCode.RightBracket
		or inputObject.KeyCode == Enum.KeyCode.KeypadSeven
		or inputObject.KeyCode == Enum.KeyCode.Seven
		or inputObject.KeyCode == Enum.KeyCode.Delete
		or inputObject.KeyCode == Enum.KeyCode.Backspace
	then
		return self:_runShortcutAction(callbacks, inputObject.KeyCode)
	end

	if not shortcutDown then
		return false
	end

	return self:_runShortcutAction(callbacks, inputObject.KeyCode)
end

function WidgetController:_handlePluginMouseShortcutKey(callbacks, keyName)
	local rawKeyName = tostring(keyName or "")
	local normalized = string.lower(rawKeyName)
	local firstByte = string.byte(rawKeyName, 1)
	local keyCode = nil
	local controlImplied = false
	local shiftImplied = string.len(rawKeyName) == 1
		and string.match(rawKeyName, "%a") ~= nil
		and rawKeyName == string.upper(rawKeyName)
		and rawKeyName ~= normalized
	if normalized == "a" then
		keyCode = Enum.KeyCode.A
	elseif normalized == "c" then
		keyCode = Enum.KeyCode.C
	elseif normalized == "d" then
		keyCode = Enum.KeyCode.D
	elseif normalized == "x" then
		keyCode = Enum.KeyCode.X
	elseif normalized == "v" then
		keyCode = Enum.KeyCode.V
	elseif normalized == "z" then
		keyCode = Enum.KeyCode.Z
	elseif normalized == "y" then
		keyCode = Enum.KeyCode.Y
	elseif firstByte == 1 then
		keyCode = Enum.KeyCode.A
		controlImplied = true
	elseif firstByte == 3 then
		keyCode = Enum.KeyCode.C
		controlImplied = true
	elseif firstByte == 4 then
		keyCode = Enum.KeyCode.D
		controlImplied = true
	elseif firstByte == 24 then
		keyCode = Enum.KeyCode.X
		controlImplied = true
	elseif firstByte == 22 then
		keyCode = Enum.KeyCode.V
		controlImplied = true
	elseif firstByte == 25 then
		keyCode = Enum.KeyCode.Y
		controlImplied = true
	elseif firstByte == 26 then
		keyCode = Enum.KeyCode.Z
		controlImplied = true
	end

	if not keyCode then
		if self:_ownsMainTimelineShortcuts() then
			self:_mainShortcutDebug("pluginMouseKeyDown:unmapped", "key=" .. tostring(normalized), "byte=" .. tostring(firstByte), "result=Ignored", "reason=unmapped")
		end
		return false
	end

	self:_mainShortcutDebug("pluginMouseKeyDown", "key=" .. tostring(rawKeyName), "byte=" .. tostring(firstByte), "mapped=" .. tostring(keyCode.Name), "controlImplied=" .. tostring(controlImplied), "shiftImplied=" .. tostring(shiftImplied))
	if self:_isTextEditingActive() then
		self:_mainShortcutDebug("pluginMouseKeyDown:blockedTextEditing", "key=" .. tostring(keyCode.Name), "result=Ignored", "reason=textEditing")
		return false
	end
	local controlDown = isControlDown()
	local shiftDown = isShiftDown()
	if not controlImplied and not controlDown and not shiftImplied and not shiftDown then
		self:_mainShortcutDebug("pluginMouseKeyDown:passNoModifier", "key=" .. tostring(keyCode.Name), "result=Pass", "reason=noShiftOrControl")
		return false
	end
	if not self:_shouldCaptureTimelineControlShortcuts("pluginMouseShortcut") then
		self:_mainShortcutDebug("pluginMouseKeyDown:passNoTimelineOwner", "key=" .. tostring(keyCode.Name), "result=Pass", "reason=noTimelineOwner")
		return false
	end

	local previousTextImpliesShift = self._shortcutTextImpliesShift
	if shiftImplied and not controlImplied and not controlDown then
		self._shortcutTextImpliesShift = true
	end
	local handled = self:_runShortcutAction(callbacks, keyCode)
	self._shortcutTextImpliesShift = previousTextImpliesShift
	if not handled then
		self:_mainShortcutDebug("pluginMouseKeyDown:ignored", "key=" .. tostring(keyCode.Name), "result=Ignored", "source=PluginMouse", "reason=actionUnavailable")
		return false
	end
	self:_mainShortcutDebug("pluginMouseKeyDown:handled", "key=" .. tostring(keyCode.Name), "result=Sink", "source=PluginMouse")
	return true
end

function WidgetController:_pollMainControlShortcuts(callbacks)
	if not self._widget or not self._widget.Enabled or self:_isTextEditingActive() then
		if self._mainControlShortcutPollState then
			table.clear(self._mainControlShortcutPollState)
		end
		return
	end

	local pressedKeys = {}
	pcall(function()
		for _, inputObject in ipairs(UserInputService:GetKeysPressed()) do
			if inputObject and inputObject.KeyCode and inputObject.KeyCode ~= Enum.KeyCode.Unknown then
				pressedKeys[inputObject.KeyCode.Name] = true
			end
		end
	end)
	local controlDown = isControlDown()
		or pressedKeys.LeftControl == true
		or pressedKeys.RightControl == true
	if not controlDown or not self:_shouldCaptureTimelineControlShortcuts() then
		if self._mainControlShortcutPollState then
			table.clear(self._mainControlShortcutPollState)
		end
		return
	end

	local pollState = self._mainControlShortcutPollState
	if type(pollState) ~= "table" then
		pollState = {}
		self._mainControlShortcutPollState = pollState
	end

	local shortcutKeys = {
		Enum.KeyCode.A,
		Enum.KeyCode.C,
		Enum.KeyCode.D,
		Enum.KeyCode.V,
		Enum.KeyCode.Z,
		Enum.KeyCode.Y,
	}
	for _, keyCode in ipairs(shortcutKeys) do
		local keyName = keyCode.Name
		local isDown = UserInputService:IsKeyDown(keyCode) or pressedKeys[keyName] == true
		if isDown and not pollState[keyName] then
			pollState[keyName] = true
			self:_mainShortcutDebug(
				"pollControlShortcut:fire",
				"key=" .. tostring(keyName),
				"rawControl=" .. tostring(pressedKeys.LeftControl == true or pressedKeys.RightControl == true),
				"rawKey=" .. tostring(pressedKeys[keyName] == true)
			)
			self:_runShortcutAction(callbacks, keyCode)
		elseif not isDown and pollState[keyName] then
			pollState[keyName] = nil
		end
	end
end

function WidgetController:_bindMainShortcutSink(callbacks, reason)
	callbacks = callbacks or self._callbacks
	if not callbacks then
		self:_mainShortcutDebug("shortcutSink:missingCallbacks", "reason=" .. tostring(reason))
		return false
	end

	local now = os.clock()
	local reasonText = tostring(reason or "unknown")
	local forceRebind = string.find(reasonText, "timeline", 1, true) ~= nil
		and self._lastMainShortcutSinkReason ~= reasonText
	if self._mainShortcutSinkBound
		and self._mainShortcutSinkCallbacks == callbacks
		and now - (self._lastMainShortcutSinkBindAt or 0) &lt; 0.25
		and not forceRebind then
		return true
	end
	self._lastMainShortcutSinkBindAt = now
	self._mainShortcutSinkCallbacks = callbacks
	self._lastMainShortcutSinkReason = reasonText

	local ok, err = pcall(function()
		ContextActionService:UnbindAction(SHORTCUT_ACTION_NAME)
		ContextActionService:BindActionAtPriority(
			SHORTCUT_ACTION_NAME,
			function(_, inputState, inputObject)
				if inputState ~= Enum.UserInputState.Begin then
					return Enum.ContextActionResult.Pass
				end
				local keyCode = inputObject and inputObject.KeyCode or Enum.KeyCode.Unknown
				if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
					self:_mainShortcutDebug("CAS:begin", "key=" .. tostring(inputObject.KeyCode.Name))
				end

				if self:_isTextEditingActive() then
					if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
						self:_mainShortcutDebug("CAS:passTextEditing", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=textEditing")
					end
					return Enum.ContextActionResult.Pass
				end

				if keyCode == Enum.KeyCode.LeftControl
					or keyCode == Enum.KeyCode.RightControl then
					self:_setKeyHeld(keyCode, true)
					self:_mainShortcutDebug("CAS:passControl", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=modifierOnly")
					return Enum.ContextActionResult.Pass
				end

				local isTimelineControlShortcut = keyCode == Enum.KeyCode.A
					or keyCode == Enum.KeyCode.C
					or keyCode == Enum.KeyCode.D
					or keyCode == Enum.KeyCode.V
					or keyCode == Enum.KeyCode.Z
					or keyCode == Enum.KeyCode.Y
				local controlDown = isControlDown()
				if controlDown then
					if not isTimelineControlShortcut then
						if inputObject and isMainShortcutDebugKey(keyCode) then
							self:_mainShortcutDebug("CAS:passNonTimelineCtrl", "key=" .. tostring(keyCode.Name), "result=Pass", "reason=notTimelineControlShortcut")
						end
						return Enum.ContextActionResult.Pass
					end
					if not self:_mainShortcutControlAllows7kg2() then
						self:_mainShortcutDebug("CAS:passStudioMode", "key=" .. tostring(keyCode.Name), "result=Pass", "reason=shortcutControlStudio")
						return Enum.ContextActionResult.Pass
					end
					if not self:_shouldCaptureTimelineControlShortcuts("casControlShortcut") then
						self:_mainShortcutDebug("CAS:passNoTimelineOwner", "key=" .. tostring(keyCode.Name), "result=Pass", "reason=noTimelineOwner")
						return Enum.ContextActionResult.Pass
					end
					self:_runShortcutAction(callbacks, keyCode)
					self:_mainShortcutDebug("CAS:sinkTimelineCtrl", "key=" .. tostring(keyCode.Name), "source=CAS", "result=Sink")
					return Enum.ContextActionResult.Sink
				end

				if keyCode == Enum.KeyCode.B
					and self._mainDockWindowFocused == true
					and self._widget
					and self._widget.Enabled == true
					and self._widget:GetAttribute("MegMoHiddenForMicro") ~= true then
					if self:_runShortcutAction(callbacks, keyCode) then
						self:_mainShortcutDebug("CAS:sinkFocusedDockShortcut", "key=" .. tostring(keyCode.Name), "source=CAS", "result=Sink")
						return Enum.ContextActionResult.Sink
					end
				end

				if not controlDown
					and self._widget
					and self._widget.Enabled == true
					and self._widget:GetAttribute("MegMoHiddenForMicro") ~= true
					and (keyCode == Enum.KeyCode.X or keyCode == Enum.KeyCode.Y or keyCode == Enum.KeyCode.Z)
					and self:_runTrackballAxisShortcut(callbacks, keyCode) then
					if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
						self:_mainShortcutDebug("CAS:sinkTrackballAxisShortcut", "key=" .. tostring(inputObject.KeyCode.Name), "source=CAS", "result=Sink")
					end
					return Enum.ContextActionResult.Sink
				end

				if self:_shouldCaptureMainToolToggleShortcut(keyCode) then
					self:_runShortcutAction(callbacks, keyCode)
					if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
						self:_mainShortcutDebug("CAS:sinkToolToggleShortcut", "key=" .. tostring(inputObject.KeyCode.Name), "source=CAS", "result=Sink")
					end
					return Enum.ContextActionResult.Sink
				end

				if not self:_ownsMainTimelineShortcuts() then
					if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
						self:_mainShortcutDebug("CAS:passNoTimelineOwner", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=noTimelineOwner")
					end
					return Enum.ContextActionResult.Pass
				end

				if self:_handleShortcutInput(callbacks, inputObject) then
					if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
						self:_mainShortcutDebug("CAS:sinkShortcutInput", "key=" .. tostring(inputObject.KeyCode.Name), "source=CAS", "result=Sink")
					end
					return Enum.ContextActionResult.Sink
				end

				if inputObject and isMainShortcutDebugKey(inputObject.KeyCode) then
					self:_mainShortcutDebug("CAS:passUnhandled", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=unhandled")
				end
				return Enum.ContextActionResult.Pass
			end,
			false,
			SHORTCUT_PRIORITY,
			Enum.KeyCode.A,
			Enum.KeyCode.LeftControl,
			Enum.KeyCode.RightControl,
			Enum.KeyCode.C,
			Enum.KeyCode.X,
			Enum.KeyCode.V,
			Enum.KeyCode.Z,
			Enum.KeyCode.Y,
			Enum.KeyCode.D,
			Enum.KeyCode.M,
			Enum.KeyCode.R,
			Enum.KeyCode.T,
			Enum.KeyCode.G,
			Enum.KeyCode.B,
			Enum.KeyCode.H,
			Enum.KeyCode.K,
			Enum.KeyCode.N,
			Enum.KeyCode.P,
			Enum.KeyCode.Plus,
			Enum.KeyCode.KeypadPlus,
			Enum.KeyCode.Equals,
			Enum.KeyCode.LeftBracket,
			Enum.KeyCode.RightBracket,
			Enum.KeyCode.Seven,
			Enum.KeyCode.KeypadSeven,
			Enum.KeyCode.Space,
			Enum.KeyCode.Delete,
			Enum.KeyCode.Backspace
		)
	end)

	self._mainShortcutSinkBound = ok
	if ok then
		self:_mainShortcutDebug("shortcutSink:bound", "reason=" .. reasonText, "result=Info")
	else
		self:_mainShortcutDebug("shortcutSink:bindFailed", "reason=" .. reasonText, "error=" .. tostring(err))
	end
	return ok
end

function WidgetController:_bindPluginMouseShortcutFallback(callbacks)
	pcall(function()
		local mouse = self._plugin and self._plugin:GetMouse()
		if not mouse then
			return
		end
		self:_connect(mouse.KeyDown, function(keyName)
			self:_handlePluginMouseShortcutKey(callbacks, keyName)
		end)
	end)
end

function WidgetController:_handleShortcutCaptureText(callbacks)
	if not self._shortcutCaptureInput then
		return
	end

	local text = self._shortcutCaptureInput.Text
	if text == "" then
		return
	end

	self._shortcutCaptureInput.Text = ""
	if string.match(text, "^%s+$") then
		if self:_isShortcutContextActive() then
			self:_runShortcutAction(callbacks, Enum.KeyCode.Space)
		end
		return
	end
	if not self:_isShortcutContextActive() then
		return
	end
	if text == "+" then
		self:_runShortcutAction(callbacks, Enum.KeyCode.Plus)
		return
	end

	local rawCharacter = string.sub(text, -1)
	local character = string.upper(rawCharacter)
	local keyMap = {
		C = Enum.KeyCode.C,
		A = Enum.KeyCode.A,
		X = Enum.KeyCode.X,
		V = Enum.KeyCode.V,
		Z = Enum.KeyCode.Z,
		Y = Enum.KeyCode.Y,
		D = Enum.KeyCode.D,
		M = Enum.KeyCode.M,
		I = Enum.KeyCode.I,
		R = Enum.KeyCode.R,
		T = Enum.KeyCode.T,
		G = Enum.KeyCode.G,
		B = Enum.KeyCode.B,
		H = Enum.KeyCode.H,
		K = Enum.KeyCode.K,
		N = Enum.KeyCode.N,
		P = Enum.KeyCode.P,
		["["] = Enum.KeyCode.LeftBracket,
		["]"] = Enum.KeyCode.RightBracket,
		["7"] = Enum.KeyCode.KeypadSeven,
	}

	local keyCode = keyMap[character]
	if keyCode then
		local shortcutDown = self._shortcutShiftHeld or isShiftDown()
		local shiftRequired = keyCode == Enum.KeyCode.C
			or keyCode == Enum.KeyCode.A
			or keyCode == Enum.KeyCode.X
			or keyCode == Enum.KeyCode.V
			or keyCode == Enum.KeyCode.Z
			or keyCode == Enum.KeyCode.D
			or keyCode == Enum.KeyCode.I
		local textImpliesShift = (shiftRequired
				or keyCode == Enum.KeyCode.Y
				or keyCode == Enum.KeyCode.M
				or keyCode == Enum.KeyCode.B
				or keyCode == Enum.KeyCode.T)
			and string.match(rawCharacter, "%a") ~= nil
			and rawCharacter == character

		if not shortcutDown and not textImpliesShift and self:_runTrackballAxisShortcut(callbacks, keyCode) then
			return
		end
		if keyCode == Enum.KeyCode.C and not (shortcutDown or textImpliesShift) then
			self:_runShortcutAction(callbacks, keyCode)
			return
		end
		if shiftRequired and not (shortcutDown or textImpliesShift) then
			return
		end
		self._shortcutTextImpliesShift = textImpliesShift == true
		self:_runShortcutAction(callbacks, keyCode)
		self._shortcutTextImpliesShift = nil
	else
		self:_setShortcutHint("Shortcut capture: " .. character .. " is not mapped")
	end
end

function WidgetController:_isLayoutPanelVisible(panelKey)
	local visibility = self._layoutPanelVisibility or {}
	return visibility[panelKey] ~= false
end

function WidgetController:_isLayoutToggleEnabled(panelKey)
	if panelKey == "CompactHeader" then
		return self._compactHeaderEnabled == true
	end
	if panelKey == "SingleScreenMode" then
		return self._singleScreenModeEnabled == true
	end
	return self:_isLayoutPanelVisible(panelKey)
end

function WidgetController:_isPanelCollapsed(panelKey)
	return (self._collapsedPanels or {})[panelKey] == true
end

function WidgetController:_setPanelCollapsed(panelKey, collapsed)
	self._collapsedPanels = self._collapsedPanels or {}
	self._collapsedPanels[panelKey] = collapsed and true or nil
	self:_refreshLayoutVisibility()
end

function WidgetController:_togglePanelCollapsed(panelKey)
	self:_setPanelCollapsed(panelKey, not self:_isPanelCollapsed(panelKey))
end

function WidgetController:_refreshPanelCollapseButtons()
	for panelKey, button in pairs({
		RigExplorer = self._rigExplorerCollapseButton,
		SessionSummary = self._sessionSummaryCollapseButton,
		Presets = self._presetsCollapseButton,
		Layout = self._layoutCollapseButton,
		Timeline = self._timelineCollapseButton,
		Inspector = self._inspectorCollapseButton,
		KeyframeTools = self._keyframeToolsCollapseButton,
	}) do
		if button then
			button.Text = self:_isPanelCollapsed(panelKey) and "+" or "-"
		end
	end
end

function WidgetController:_renderLayoutControls()
	if self._layoutStatusLabel then
		local visibleCount = 0
		local totalCount = 0
		for _, panelKey in ipairs({ "SessionSummary", "MotionBuilder", "Inspector", "KeyframeTools" }) do
			totalCount += 1
			if self:_isLayoutPanelVisible(panelKey) then
				visibleCount += 1
			end
		end
		self._layoutStatusLabel.Text = string.format(
			"%s: %d of %d panels visible. These layout changes only affect this editing session.",
			self._layoutPreset or "Custom",
			visibleCount,
			totalCount
		)
		if self._compactHeaderEnabled then
			self._layoutStatusLabel.Text = self._layoutStatusLabel.Text .. " Compact header is on."
		end
		if self._singleScreenModeEnabled then
			self._layoutStatusLabel.Text = self._layoutStatusLabel.Text .. " Single Screen Mode compacts the timeline rows."
		end
		if self:_isNarrowDockViewport() then
			self._layoutStatusLabel.Text = self._layoutStatusLabel.Text
				.. " Narrow dock mode is active, so side panels are temporarily hidden."
		end
	end

	for presetName, button in pairs(self._layoutPresetButtons or {}) do
		button.BackgroundColor3 = presetName == self._layoutPreset and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
	end

	for panelKey, button in pairs(self._layoutToggleButtons or {}) do
		local isEnabled = self:_isLayoutToggleEnabled(panelKey)
		button.BackgroundColor3 = isEnabled and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		button.TextColor3 = ThemeService.getReadableTextColor(button.BackgroundColor3)
		button.Text = (isEnabled and "On: " or "Off: ")
			.. button.Text:gsub("^On:%s*", ""):gsub("^Off:%s*", ""):gsub("^Show:%s*", ""):gsub("^Hide:%s*", "")
	end

	local themeViewModel = (self._lastViewModel and self._lastViewModel.theme) or {}
	local currentThemeId = themeViewModel.currentThemeId or "NeonPurple"
	for themeId, button in pairs(self._themeButtons or {}) do
		local meta = self._themeButtonMeta and self._themeButtonMeta[themeId]
		local isSelected = themeId == currentThemeId
		local isLocked = not ThemeService.isThemeUnlocked(meta)
		local backgroundColor = isSelected and Constants.THEME.AccentSoft
			or (isLocked and Constants.THEME.PanelAlt or Constants.THEME.PanelSoft)
		button.BackgroundColor3 = backgroundColor
		button.TextColor3 = isLocked and Constants.THEME.MutedText or ThemeService.getReadableTextColor(backgroundColor)
	end
end

function WidgetController:_getRootViewportSize()
	local root = self._root
	if root then
		local size = root.AbsoluteSize
		if size.X &gt; 0 and size.Y &gt; 0 then
			return size
		end
	end

	local widget = self._widget
	if widget then
		local ok, size = pcall(function()
			return widget.AbsoluteSize
		end)
		if ok and size and size.X &gt; 0 and size.Y &gt; 0 then
			return size
		end
	end

	return Constants.WIDGET_SIZE or Vector2.new(1280, 860)
end

function WidgetController:_isNarrowDockViewport()
	local size = self:_getRootViewportSize()
	return size.X &gt; 0 and size.X &lt; 820
end

function WidgetController:_shouldUseResponsiveCompactHeader()
	local size = self:_getRootViewportSize()
	return self._compactHeaderEnabled == true
		or self._singleScreenModeEnabled == true
		or (size.X &gt; 0 and size.X &lt; 980)
		or (size.Y &gt; 0 and size.Y &lt; 700)
end

function WidgetController:_shouldUseCompactTimelineRows()
	return self._singleScreenModeEnabled == true or self:_isNarrowDockViewport()
end

function WidgetController:_shouldAutoCollapseWorkspacePanel()
	local size = self:_getRootViewportSize()
	return size.X &gt; 0 and size.X &lt; 620
end

function WidgetController:_applyMountedTheme()
	if not self._root then
		return
	end
	ThemeService.applyToGui(self._root)
	FontPreviewService.apply(self._root, FontPreviewService.getCurrentFontName())
	self:_setWorkspaceMode(self._workspaceMode)
	self:_renderLayoutControls()
end

function WidgetController:_setCustomThemeOverlayVisible(isVisible)
	if not self._customThemeOverlay then
		return
	end
	self._customThemeOverlay.Visible = isVisible == true
	if isVisible == true then
		self._pendingCustomThemeColors = {}
		if self._customThemeStatusLabel then
			self._customThemeStatusLabel.Text = "Choose one or more colors, then click Save Custom Theme."
		end
		self:_focusShortcutCapture("Custom Theme picker open")
	else
		self._pendingCustomThemeColors = nil
		self:_focusShortcutCapture("Custom Theme picker closed")
	end
end

function WidgetController:_setFontPreviewOverlayVisible(isVisible)
	if not self._fontPreviewOverlay then
		return
	end
	self._fontPreviewOverlay.Visible = isVisible == true
	if isVisible == true then
		local currentFontName = FontPreviewService.getCurrentFontName()
		if self._fontPreviewSelectedButton then
			self._fontPreviewSelectedButton.Text = tostring(currentFontName)
		end
		for name, button in pairs(self._fontPreviewOptionButtons or {}) do
			if button then
				button.BackgroundColor3 = name == currentFontName and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
			end
		end
	end
	self:_focusShortcutCapture(isVisible == true and "Font preview open" or "Font preview closed")
end

function WidgetController:_applyFontPreview(fontName)
	FontPreviewService.saveFont(self._plugin, fontName)
	local success, message = FontPreviewService.apply(self._root, fontName)
	if self._fontPreviewSelectedButton then
		self._fontPreviewSelectedButton.Text = tostring(FontPreviewService.getCurrentFontName())
	end
	if self._fontPreviewStatusLabel then
		self._fontPreviewStatusLabel.Text = message or "Font saved."
	end
	for name, button in pairs(self._fontPreviewOptionButtons or {}) do
		if button then
			button.BackgroundColor3 = name == FontPreviewService.getCurrentFontName() and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		end
	end
	self:_setShortcutHint(message or (success and "Font saved." or "Font update failed."))
	return success, message
end

function WidgetController:_previewCustomThemeChoice(role, color)
	if typeof(color) ~= "Color3" then
		return
	end
	if role == "Background" and self._customThemePreview then
		self._customThemePreview.BackgroundColor3 = color
	elseif role == "Panel" and self._customThemePreviewPanel then
		self._customThemePreviewPanel.BackgroundColor3 = color
	elseif role == "Accent" and self._customThemePreviewAccent then
		self._customThemePreviewAccent.BackgroundColor3 = color
	end
	if self._customThemePreviewText and self._customThemePreviewPanel then
		self._customThemePreviewText.TextColor3 =
			ThemeService.getReadableTextColor(self._customThemePreviewPanel.BackgroundColor3)
	end
end

function WidgetController:_refreshTopMenuButtonLayout(compact)
	local buttons = self._topMenuButtons
	if not buttons then
		return
	end

	local x = 0
	local gap = compact and 8 or 12
	for _, menuKey in ipairs({ "File", "Edit", "Rig", "Track", "Time", "View", "Theme", "Tools", "Help" }) do
		local button = buttons[menuKey]
		if button then
			local width = button.Size.X.Offset
			button.Position = UDim2.new(0, x, 0, 0)
			button.TextSize = compact and 11 or 12
			x += width + gap
		end
		local menu = self._topMenuFrames and self._topMenuFrames[menuKey]
		if menu then
			menu.Position = UDim2.new(0, x - ((button and button.Size.X.Offset or 0) + gap), 0, 25)
		end
	end
end

function WidgetController:_refreshHeaderLayout()
	local compact = self:_shouldUseResponsiveCompactHeader()
	local narrow = self:_isNarrowDockViewport()
	local viewportSize = self:_getRootViewportSize()
	local centeredTabsWidth = 638
	local inlineMenuStartX = 170
	local estimatedMenuWidth = 438
	local centeredTabsLeft = (viewportSize.X - centeredTabsWidth) * 0.5
	local inlineMenus = compact and not narrow and (centeredTabsLeft - inlineMenuStartX) &gt;= estimatedMenuWidth
	local headerHeight = compact and (inlineMenus and 54 or 82) or 92
	local contentY = headerHeight + 12

	if self._headerCard then
		self._headerCard.Size = UDim2.new(1, 0, 0, headerHeight)
	end
	if self._brandLabel then
		local hasBrandIcon = self._brandIcon and self._brandIcon.Visible
		self._brandLabel.Visible = not narrow
		self._brandLabel.Position = compact
			and (hasBrandIcon and UDim2.new(0, 44, 0, 9) or UDim2.new(0, 16, 0, 9))
			or (hasBrandIcon and UDim2.new(0, 52, 0, 12) or UDim2.new(0, 16, 0, 12))
		self._brandLabel.Size = compact and UDim2.new(0, 140, 0, 20) or UDim2.new(0, 260, 0, 22)
		self._brandLabel.TextSize = compact and 18 or 24
		self._brandLabel.Text = compact and (Constants.BRAND_NAME_COMPACT or "7kg2") or (Constants.BRAND_NAME or "7kg2 Animator")
	end
	if self._brandIcon then
		self._brandIcon.Position = compact and UDim2.new(0, 16, 0, 9) or UDim2.new(0, 16, 0, 10)
		self._brandIcon.Size = compact and UDim2.new(0, 24, 0, 24) or UDim2.new(0, 28, 0, 28)
	end
	if self._subBrandLabel then
		self._subBrandLabel.Visible = false
	end
	if self._topActions then
		self._topActions.Visible = true
		if inlineMenus then
			self._topActions.Position = UDim2.new(0, inlineMenuStartX, 0, 17)
			self._topActions.Size = UDim2.new(0, math.max(0, centeredTabsLeft - inlineMenuStartX - 10), 0, 22)
		else
			self._topActions.Position = compact and UDim2.new(0, 16, 0, 52) or UDim2.new(0, 16, 0, 60)
			self._topActions.Size = UDim2.new(1, -32, 0, 22)
		end
	end
	self:_refreshTopMenuButtonLayout(compact)
	if self._statusChip then
		self._statusChip.Visible = not compact
		self._statusChip.Position = UDim2.new(1, -16, 0, 57)
		self._statusChip.Size = UDim2.new(0, 180, 0, 24)
	end
	if self._buildTimeLabel then
		self._buildTimeLabel.Visible = false
	end
	if self._autoSaveIndicator then
		self._autoSaveIndicator.Visible = not compact
		self._autoSaveIndicator.Position = UDim2.new(1, -212, 0, 58)
	end
	if self._closePluginButton then
		self._closePluginButton.Position = UDim2.new(1, -16, 0, 12)
	end
	if self._modeTabs then
		self._modeTabs.AnchorPoint = narrow and Vector2.new(0, 0) or Vector2.new(0.5, 0)
		self._modeTabs.Position = narrow and UDim2.new(0, 48, 0, 12) or UDim2.new(0.5, 0, 0, 12)
		self._modeTabs.Size = narrow and UDim2.new(1, -124, 0, 30) or UDim2.new(0, centeredTabsWidth, 0, 30)
	end
	if self._modeLayout then
		self._modeLayout.Padding = UDim.new(0, narrow and 2 or 3)
	end
	if self._animateTab then
		self._animateTab.Size = narrow and UDim2.new(0, 70, 1, 0) or UDim2.new(0, 94, 1, 0)
		self._animateTab.Text = narrow and "ANIM" or "ANIMATE"
	end
	if self._layoutTab then
		self._layoutTab.Size = narrow and UDim2.new(0, 62, 1, 0) or UDim2.new(0, 86, 1, 0)
		self._layoutTab.Text = "LAYOUT"
	end
	if self._scriptTab then
		self._scriptTab.Size = narrow and UDim2.new(0, 54, 1, 0) or UDim2.new(0, 74, 1, 0)
		self._scriptTab.Text = narrow and "CUT" or "CUTSCENE"
	end
	if self._presetsTab then
		self._presetsTab.Size = narrow and UDim2.new(0, 66, 1, 0) or UDim2.new(0, 84, 1, 0)
		self._presetsTab.Text = narrow and "PRESET" or "PRESETS"
	end
	if self._effectsTab then
		self._effectsTab.Size = narrow and UDim2.new(0, 52, 1, 0) or UDim2.new(0, 82, 1, 0)
		self._effectsTab.Text = narrow and "FX" or "EFFECTS"
	end
	if self._physicsTab then
		self._physicsTab.Size = narrow and UDim2.new(0, 56, 1, 0) or UDim2.new(0, 86, 1, 0)
		self._physicsTab.Text = narrow and "PHYS" or "PHYSICS"
	end
	if self._facesTab then
		self._facesTab.Size = narrow and UDim2.new(0, 54, 1, 0) or UDim2.new(0, 76, 1, 0)
		self._facesTab.Text = narrow and "FACE" or "FACES"
	end
	if self._contentFrame then
		self._contentFrame.Position = UDim2.new(0, 0, 0, contentY)
		self._contentFrame.Size = UDim2.new(1, 0, 1, -contentY)
	end
end

function WidgetController:_refreshLayoutVisibility()
	self:_refreshHeaderLayout()

	local showRigExplorer = self:_isLayoutPanelVisible("RigExplorer")
	local showSessionSummary = self:_isLayoutPanelVisible("SessionSummary")
	local showInspector = self:_isLayoutPanelVisible("Inspector")
	local showKeyframeTools = self:_isLayoutPanelVisible("KeyframeTools")
	local narrow = self:_isNarrowDockViewport()
	if narrow then
		showRigExplorer = false
		showSessionSummary = false
		showInspector = false
		showKeyframeTools = false
	end
	if self._keyframeToolsEmbedded and showKeyframeTools then
		showInspector = true
	end
	local showLeft = showRigExplorer or showSessionSummary
	local showRight = showInspector or (not self._keyframeToolsEmbedded and showKeyframeTools)
	local viewportSize = self:_getRootViewportSize()
	local leftColumnWidth = showLeft and math.clamp(math.floor(viewportSize.X * 0.22), 300, 330) or 0
	local leftColumnOffset = leftColumnWidth &gt; 0 and leftColumnWidth + 12 or 0
	local rightColumnWidth = showRight and math.clamp(math.floor(viewportSize.X * 0.18), 260, 310) or 0
	local rightHeight = self._contentFrame and self._contentFrame.AbsoluteSize.Y or 0
	if rightHeight &lt;= 0 then
		rightHeight = math.max(620, viewportSize.Y - 104)
	end
	local rigExplorerCollapsed = self:_isPanelCollapsed("RigExplorer")
	local sessionSummaryCollapsed = self:_isPanelCollapsed("SessionSummary")
	local inspectorCollapsed = self:_isPanelCollapsed("Inspector")
	local keyframeToolsCollapsed = self:_isPanelCollapsed("KeyframeTools")
	local sessionSummaryHeight = (self._singleScreenModeEnabled == true or narrow) and 300 or 400
	self._timelineLeftOverlap = (showSessionSummary and not showRigExplorer) and leftColumnOffset or 0
	self._timelineLeftOverlapMinY = sessionSummaryCollapsed and 56 or sessionSummaryHeight

	if self._rigExplorerCard then
		self._rigExplorerCard.Visible = showRigExplorer
		if rigExplorerCollapsed then
			self._rigExplorerCard.Position = UDim2.new(0, 0, 0, 0)
			self._rigExplorerCard.Size = UDim2.new(1, 0, 0, 44)
		elseif showRigExplorer and showSessionSummary then
			self._rigExplorerCard.Position = UDim2.new(0, 0, 0, 0)
			self._rigExplorerCard.Size = UDim2.new(1, 0, 0.56, -6)
		elseif showRigExplorer then
			self._rigExplorerCard.Position = UDim2.new(0, 0, 0, 0)
			self._rigExplorerCard.Size = UDim2.new(1, 0, 1, 0)
		end
	end
	if self._sessionSummaryCard then
		self._sessionSummaryCard.Visible = showSessionSummary
		if sessionSummaryCollapsed then
			local yOffset = showRigExplorer and (rigExplorerCollapsed and 56 or math.floor(rightHeight * 0.56) + 12) or 0
			self._sessionSummaryCard.Position = UDim2.new(0, 0, 0, yOffset)
			self._sessionSummaryCard.Size = UDim2.new(1, 0, 0, 44)
		elseif showRigExplorer and showSessionSummary then
			self._sessionSummaryCard.Position = UDim2.new(0, 0, 0.56, 12)
			self._sessionSummaryCard.Size = UDim2.new(1, 0, 0.44, -6)
		elseif showSessionSummary then
			self._sessionSummaryCard.Position = UDim2.new(0, 0, 0, 0)
			self._sessionSummaryCard.Size = UDim2.new(1, 0, 0, sessionSummaryHeight)
		end
	end
	if self._summaryStack then
		self._summaryStack.Visible = showSessionSummary and not sessionSummaryCollapsed
	end

	if self._inspectorCard then
		self._inspectorCard.Visible = showInspector
		local inspectorHeight = inspectorCollapsed and 44
			or ((showKeyframeTools and not self._keyframeToolsEmbedded) and math.clamp(math.floor(rightHeight * 0.53), 300, 676) or rightHeight)
		self._inspectorCard.Position = inspectorCollapsed and UDim2.new(0, 6, 0, 0) or UDim2.new(0, 6, 0, 6)
		self._inspectorCard.Size = UDim2.new(1, -14, 0, inspectorCollapsed and inspectorHeight or math.max(0, inspectorHeight - 12))
	end
	if self._keyframeToolsHost then
		self._keyframeToolsHost.Visible = showInspector and showKeyframeTools and not inspectorCollapsed
	end
	if self._keyframeToolsCard then
		self._keyframeToolsCard.Visible = showKeyframeTools
		local inspectorHeight = 0
		if showInspector then
			inspectorHeight = inspectorCollapsed and 44 or math.clamp(math.floor(rightHeight * 0.53), 300, 676)
		end
		local topOffset = showInspector and (inspectorHeight + 12) or 0
		local toolsHeight = keyframeToolsCollapsed and 44 or math.max(260, rightHeight - topOffset)
		self._keyframeToolsCard.Position = UDim2.new(0, 0, 0, topOffset)
		self._keyframeToolsCard.Size = UDim2.new(1, -8, 0, toolsHeight)
	end

	if self._leftColumn then
		self._leftColumn.Visible = showLeft
		self._leftColumn.Size = UDim2.new(0, leftColumnWidth, 1, 0)
	end
	if self._rightColumn then
		self._rightColumn.Visible = showRight
		self._rightColumn.Size = UDim2.new(0, rightColumnWidth, 1, 0)
	end
	if self._centerColumn then
		local leftWidth = leftColumnOffset
		local rightWidth = showRight and (rightColumnWidth + 12) or 0
		self._centerColumn.Position = UDim2.new(0, leftWidth, 0, 0)
		self._centerColumn.Size = UDim2.new(1, -(leftWidth + rightWidth), 1, 0)
	end

	self:_renderLayoutControls()
	self:_refreshPanelCollapseButtons()
	self:_refreshCenterColumnLayout()
end

function WidgetController:_applyLayoutPreset(presetName)
	local visibility = self._layoutPanelVisibility
	if presetName == "Compact" then
		self._singleScreenModeEnabled = false
		self._compactHeaderEnabled = true
		visibility.RigExplorer = false
		visibility.SessionSummary = false
		visibility.MotionBuilder = true
		visibility.Inspector = true
		visibility.KeyframeTools = true
	elseif presetName == "Timeline Focus" then
		self._singleScreenModeEnabled = false
		self._compactHeaderEnabled = true
		visibility.RigExplorer = false
		visibility.SessionSummary = false
		visibility.MotionBuilder = false
		visibility.Inspector = false
		visibility.KeyframeTools = true
	elseif presetName == "Single Screen Mode" then
		if self._singleScreenModeEnabled ~= true then
			self._singleScreenPreviousLayoutPreset = self._layoutPreset
			self._singleScreenPreviousCompactHeader = self._compactHeaderEnabled
			self._singleScreenPreviousVisibility = table.clone(visibility)
		end
		self._singleScreenModeEnabled = true
		self._compactHeaderEnabled = true
		visibility.RigExplorer = false
		visibility.SessionSummary = false
		visibility.MotionBuilder = false
		visibility.Inspector = false
		visibility.KeyframeTools = true
	else
		presetName = "Full Workspace"
		self._singleScreenModeEnabled = false
		self._compactHeaderEnabled = false
		visibility.RigExplorer = false
		visibility.SessionSummary = true
		visibility.MotionBuilder = true
		visibility.Inspector = true
		visibility.KeyframeTools = true
	end

	self._layoutPreset = presetName
	self:_refreshLayoutVisibility()
	self:_setShortcutHint("Layout preset applied: " .. presetName)
end

function WidgetController:_toggleLayoutPanel(panelKey)
	if panelKey == "CompactHeader" then
		self._compactHeaderEnabled = not self._compactHeaderEnabled
		self._layoutPreset = "Custom"
		self:_refreshLayoutVisibility()
		self:_setShortcutHint("Compact header " .. (self._compactHeaderEnabled and "enabled." or "disabled."))
		return
	end
	if panelKey == "SingleScreenMode" then
		self._singleScreenModeEnabled = not self._singleScreenModeEnabled
		if self._singleScreenModeEnabled then
			self._singleScreenPreviousLayoutPreset = self._layoutPreset
			self._singleScreenPreviousCompactHeader = self._compactHeaderEnabled
			self._singleScreenPreviousVisibility = table.clone(self._layoutPanelVisibility)
			self._compactHeaderEnabled = true
			self._layoutPanelVisibility.RigExplorer = false
			self._layoutPanelVisibility.SessionSummary = false
			self._layoutPanelVisibility.MotionBuilder = false
			self._layoutPanelVisibility.Inspector = false
			self._layoutPanelVisibility.KeyframeTools = true
			self._layoutPreset = "Single Screen Mode"
		else
			if self._singleScreenPreviousVisibility then
				for key, value in pairs(self._singleScreenPreviousVisibility) do
					self._layoutPanelVisibility[key] = value
				end
			end
			self._compactHeaderEnabled = self._singleScreenPreviousCompactHeader == true
			self._layoutPreset = self._singleScreenPreviousLayoutPreset or "Custom"
			self._singleScreenPreviousLayoutPreset = nil
			self._singleScreenPreviousCompactHeader = nil
			self._singleScreenPreviousVisibility = nil
		end
		self:_refreshLayoutVisibility()
		self:_setShortcutHint("Single Screen Mode " .. (self._singleScreenModeEnabled and "enabled." or "disabled."))
		return
	end

	local visibility = self._layoutPanelVisibility
	visibility[panelKey] = not self:_isLayoutPanelVisible(panelKey)
	self._layoutPreset = "Custom"
	self:_refreshLayoutVisibility()
	self:_setShortcutHint("Layout panel toggled: " .. tostring(panelKey))
end

function WidgetController:_refreshCenterColumnLayout()
	local mode = self._workspaceMode or "Animate"
	local motionBuilderEnabled = self:_isLayoutPanelVisible("MotionBuilder")
	local autoCollapseWorkspace = self:_shouldAutoCollapseWorkspacePanel() and mode == "Animate" and motionBuilderEnabled
	local viewportCollapsed = (self._isViewportCardCollapsed == true or autoCollapseWorkspace)
		and mode == "Animate"
		and motionBuilderEnabled
	local presetsCollapsed = self:_isPanelCollapsed("Presets")
	local layoutCollapsed = self:_isPanelCollapsed("Layout")
	local timelineCollapsed = self:_isPanelCollapsed("Timeline")
	local activeTopCollapsed = (mode == "Presets" and presetsCollapsed) or (mode == "Layout" and layoutCollapsed)
	if self._viewportCard then
		self._viewportCard.Visible = mode == "Animate" and motionBuilderEnabled and not viewportCollapsed
	end
	if self._presetsCard then
		self._presetsCard.Visible = mode == "Presets"
	end
	if self._layoutCard then
		self._layoutCard.Visible = mode == "Layout"
	end
	if self._scriptCard then
		self._scriptCard.Visible = mode == "Script"
	end
	if self._viewportCollapsedBar then
		self._viewportCollapsedBar.Visible = viewportCollapsed
	end

	local topExpanded = mode == "Presets" or mode == "Layout" or mode == "Script" or (mode == "Animate" and motionBuilderEnabled and not viewportCollapsed)
	local topHeight = topExpanded and (activeTopCollapsed and 44 or (mode == "Script" and 560 or 400)) or (viewportCollapsed and 44 or 0)
	if topExpanded and not activeTopCollapsed then
		local availableHeight = self._centerColumn and self._centerColumn.AbsoluteSize.Y or 0
		if availableHeight &lt;= 0 and self._contentFrame then
			availableHeight = self._contentFrame.AbsoluteSize.Y
		end
		if availableHeight &gt; 0 then
			local heightRatio
			local minHeight
			local maxHeight
			if mode == "Script" then
				heightRatio = self:_isNarrowDockViewport() and 0.62 or 0.66
				minHeight = 360
				maxHeight = 560
			else
				heightRatio = self:_isNarrowDockViewport() and 0.42 or 0.44
				minHeight = 220
				maxHeight = 400
			end
			topHeight = math.clamp(math.floor(availableHeight * heightRatio), minHeight, maxHeight)
		end
	end
	local timelineY = topHeight &gt; 0 and topHeight + 12 or 0
	local timelineHeight = -timelineY

	if self._viewportCard and mode == "Animate" then
		self._viewportCard.Size = UDim2.new(1, 0, 0, topHeight)
	end
	if self._presetsCard and mode == "Presets" then
		self._presetsCard.Size = UDim2.new(1, 0, 0, topHeight)
	end
	if self._layoutCard and mode == "Layout" then
		self._layoutCard.Size = UDim2.new(1, 0, 0, topHeight)
	end
	if self._scriptCard and mode == "Script" then
		self._scriptCard.Size = UDim2.new(1, 0, 0, topHeight)
	end
	if self._viewportCollapsedBar then
		self._viewportCollapsedBar.Size = UDim2.new(1, 0, 0, viewportCollapsed and topHeight or 44)
	end

	if self._transportCard then
		self._transportCard.Visible = false
	end
	if self._transportCollapsedBar then
		self._transportCollapsedBar.Visible = false
	end
	if self._timelineCard then
		local leftOverlap = 0
		if (self._timelineLeftOverlap or 0) &gt; 0 and timelineY &gt;= (self._timelineLeftOverlapMinY or 0) then
			leftOverlap = self._timelineLeftOverlap
		end
		self._timelineCard.Position = UDim2.new(0, -leftOverlap, 0, timelineY)
		if timelineCollapsed then
			self._timelineCard.Size = UDim2.new(1, leftOverlap, 0, 44)
			if self._timelineAddTrackMenu then
				self._timelineAddTrackMenu.Visible = false
			end
		else
			self._timelineCard.Size = UDim2.new(1, leftOverlap, 1, timelineHeight)
		end
	end
	if self._timelineToolbar then
		self._timelineToolbar.Visible = not timelineCollapsed
	end
	if self._timelineBody then
		self._timelineBody.Visible = not timelineCollapsed
	end
	self:_refreshPanelCollapseButtons()
end

function WidgetController:_setWorkspaceMode(mode)
	if mode ~= "Presets" and mode ~= "Layout" and mode ~= "Script" then
		mode = "Animate"
	end
	if mode ~= "Presets" then
		self._motionDefaultPickerMotion = nil
	end
	self._workspaceMode = mode
	if self._effectsOverlay then
		self._effectsOverlay.Visible = false
	end
	if self._facesOverlay then
		self._facesOverlay.Visible = false
	end

	if self._animateTab then
		self._animateTab.BackgroundColor3 = mode == "Animate" and Constants.THEME.Accent or Constants.THEME.PanelSoft
		self._animateTab.TextColor3 = ThemeService.getReadableTextColor(self._animateTab.BackgroundColor3)
	end
	if self._presetsTab then
		self._presetsTab.BackgroundColor3 = mode == "Presets" and Constants.THEME.Accent or Constants.THEME.PanelSoft
		self._presetsTab.TextColor3 = ThemeService.getReadableTextColor(self._presetsTab.BackgroundColor3)
	end
	if self._layoutTab then
		self._layoutTab.BackgroundColor3 = mode == "Layout" and Constants.THEME.Accent or Constants.THEME.PanelSoft
		self._layoutTab.TextColor3 = ThemeService.getReadableTextColor(self._layoutTab.BackgroundColor3)
	end
	if self._scriptTab then
		self._scriptTab.BackgroundColor3 = mode == "Script" and Constants.THEME.Accent or Constants.THEME.PanelSoft
		self._scriptTab.TextColor3 = ThemeService.getReadableTextColor(self._scriptTab.BackgroundColor3)
	end
	if self._effectsTab then
		self._effectsTab.BackgroundColor3 = Constants.THEME.PanelSoft
		self._effectsTab.TextColor3 = ThemeService.getReadableTextColor(self._effectsTab.BackgroundColor3)
	end
	if self._facesTab then
		self._facesTab.BackgroundColor3 = Constants.THEME.PanelSoft
		self._facesTab.TextColor3 = ThemeService.getReadableTextColor(self._facesTab.BackgroundColor3)
	end
	self:_refreshCenterColumnLayout()
end

function WidgetController:bind(callbacks)
	self._callbacks = callbacks
	if self._facesPresetModalRefs then
		self._facesPresetModalRefs._callbacks = callbacks
	end
	self:_ensureDockShortcutCaptureInput()
	self:_ensureShortcutCaptureInput()
	self:_bindPluginMouseShortcutFallback(callbacks)
	self:_bindMainShortcutSink(callbacks, "bind")
	local syncingTrackScroll = false
	self:_setWorkspaceMode(self._workspaceMode)
	if self._timelineInput then
		self._timelineInput:start()
	end

	self:_connect(RunService.Heartbeat, function()
		self:_pollMainControlShortcuts(callbacks)
		self:_clearStaleTimelineMiddlePan("middleMouseReleased")
	end)

	pcall(function()
		if self._widget.WindowFocused then
			self:_connect(self._widget.WindowFocused, function()
				self._mainDockWindowFocused = true
				self._mainShortcutSyntheticDockFocus = false
				if callbacks.onIsWorkspaceGrabActive
					and callbacks.onIsWorkspaceGrabActive() == true then
					task.defer(function()
						if callbacks.onReleaseWorkspaceGrabFromPluginUi then
							local _, message = callbacks.onReleaseWorkspaceGrabFromPluginUi(
								"Free Grab turned off because you returned to 7kg2.",
								"PluginUiFocused"
							)
							if message then
								self._workspaceGrabUiReleaseUntil = os.clock() + 0.5
								self:_setShortcutHint(message)
							end
						end
					end)
				end
				self:_mainShortcutDebug("widgetWindowFocused", "result=Focused")
			end)
		end
	end)
	pcall(function()
		if self._widget.WindowFocusReleased then
			self:_connect(self._widget.WindowFocusReleased, function()
				local activationFocusRelease = self._mainTimelineShortcutOwned == true
					and self._mouseInsideWidget == true
				if activationFocusRelease then
					self._mainDockWindowFocused = true
					self._mainShortcutSyntheticDockFocus = true
					self:_mainShortcutDebug(
						"widgetWindowFocusReleasedIgnored",
						"result=Owned",
						"reason=pluginActivationInsideMain"
					)
					return
				end
				self._mainDockWindowFocused = false
				self:_endTimelineMiddlePan("DockWidget.WindowFocusReleased")
				self:_releaseMainTimelineShortcuts("DockWidget.WindowFocusReleased")
				if not require(script.Parent:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
					pcall(function()
						if self._plugin then
							self._plugin:Deactivate()
						end
					end)
				end
				self:_mainShortcutDebug("widgetWindowFocusReleased", "result=Released")
			end)
		end
	end)

	if self._animateTab then
		self:_connect(self._animateTab.Activated, function()
			self:_setWorkspaceMode("Animate")
		end)
	end
	if self._presetsTab then
		self:_connect(self._presetsTab.Activated, function()
			self:_setWorkspaceMode("Presets")
			if callbacks.onLoadPresetAnimations then
				callbacks.onLoadPresetAnimations()
			end
		end)
	end
	if self._layoutTab then
		self:_connect(self._layoutTab.Activated, function()
			self:_setWorkspaceMode("Layout")
			self:_setShortcutHint("Choose a workspace layout or toggle panels.")
		end)
	end
	for presetName, button in pairs(self._layoutPresetButtons or {}) do
		self:_connect(button.Activated, function()
			self:_applyLayoutPreset(presetName)
		end)
	end
	for panelKey, button in pairs(self._layoutToggleButtons or {}) do
		self:_connect(button.Activated, function()
			self:_toggleLayoutPanel(panelKey)
		end)
	end
	for themeId, button in pairs(self._themeButtons or {}) do
		self:_connect(button.Activated, function()
			local success = nil
			if callbacks.onSelectTheme then
				success = callbacks.onSelectTheme(themeId)
			else
				self:_setShortcutHint("Theme selection is unavailable in this build.")
			end
			if success then
				self:_applyMountedTheme()
			end
		end)
	end
	for _, swatch in ipairs(self._customThemeSwatches or {}) do
		local button = swatch.button
		local role = swatch.role
		local color = swatch.color
		if button and role and typeof(color) == "Color3" then
			self:_connect(button.Activated, function()
				self._pendingCustomThemeColors = self._pendingCustomThemeColors or {}
				self._pendingCustomThemeColors[role] = color
				self:_previewCustomThemeChoice(role, color)
				local message = string.format("%s color selected. Click Save Custom Theme to keep it.", tostring(role))
				if self._customThemeStatusLabel then
					self._customThemeStatusLabel.Text = message
				end
				self:_setShortcutHint(message or "Custom theme updated.")
			end)
		end
	end
	if self._customThemeCloseButton then
		self:_connect(self._customThemeCloseButton.Activated, function()
			self:_setCustomThemeOverlayVisible(false)
		end)
	end
	if self._customThemeCancelButton then
		self:_connect(self._customThemeCancelButton.Activated, function()
			self:_setCustomThemeOverlayVisible(false)
		end)
	end
	if self._customThemeSaveButton then
		self:_connect(self._customThemeSaveButton.Activated, function()
			if not self._pendingCustomThemeColors or next(self._pendingCustomThemeColors) == nil then
				local message = "Choose at least one custom color before saving."
				if self._customThemeStatusLabel then
					self._customThemeStatusLabel.Text = message
				end
				self:_setShortcutHint(message)
				return
			end
			local success, message = ThemeService.saveCustomTheme(self._plugin, self._pendingCustomThemeColors)
			if success then
				self:_applyMountedTheme()
				self:_setCustomThemeOverlayVisible(false)
			end
			self:_setShortcutHint(message or "Custom theme saved.")
		end)
	end
	if self._fontPreviewCloseButton then
		self:_connect(self._fontPreviewCloseButton.Activated, function()
			self:_setFontPreviewOverlayVisible(false)
		end)
	end
	if self._fontPreviewSelectedButton then
		self:_connect(self._fontPreviewSelectedButton.Activated, function()
			if self._fontPreviewList then
				self._fontPreviewList.Visible = not self._fontPreviewList.Visible
			end
		end)
	end
	for fontName, button in pairs(self._fontPreviewOptionButtons or {}) do
		self:_connect(button.Activated, function()
			self:_applyFontPreview(fontName)
		end)
	end
	if self._scriptTab then
		self:_connect(self._scriptTab.Activated, function()
			self:_setWorkspaceMode("Script")
			self:_setShortcutHint("Cutscene Maker workspace.")
		end)
	end
	if self._scriptValidateButton then
		self:_connect(self._scriptValidateButton.Activated, function()
			local options = self._getCutsceneExportOptions and self._getCutsceneExportOptions() or nil
			local message = callbacks.onValidateCutscene and callbacks.onValidateCutscene(options)
			self:_setCutsceneStatus(message or "Cutscene validation finished.")
		end)
	end
	if self._scriptGenerateButton then
		self:_connect(self._scriptGenerateButton.Activated, function()
			self:_setCutsceneStatus("Generating cutscene package...")
			local options = self._getCutsceneExportOptions and self._getCutsceneExportOptions() or nil
			local message = callbacks.onGenerateCutscene and callbacks.onGenerateCutscene(options)
			self:_setCutsceneStatus(message or "Generated cutscene package.")
		end)
	end
	if self._effectsTab then
		self:_connect(self._effectsTab.Activated, function()
			self:_setEffectsOverlayVisible(true)
		end)
	end
	if self._facesTab then
		self:_connect(self._facesTab.Activated, function()
			self:_setFacesOverlayVisible(true)
		end)
	end
	for menuKey, button in pairs(self._topMenuButtons or {}) do
		self:_connect(button.Activated, function()
			self:_toggleTopMenu(menuKey)
		end)
	end
	for _, optionButtons in pairs(self._topMenuOptionButtons or {}) do
		for actionId, optionButton in pairs(optionButtons) do
			self:_connect(optionButton.Activated, function()
				self:_runTopMenuAction(actionId, callbacks)
			end)
		end
	end
	if self._effectsCloseButton then
		self:_connect(self._effectsCloseButton.Activated, function()
			self:_setEffectsOverlayVisible(false)
			self:_focusShortcutCapture("Effects panel closed")
		end)
	end
	if self._facesCloseButton then
		self:_connect(self._facesCloseButton.Activated, function()
			self:_setFacesOverlayVisible(false)
			self:_focusShortcutCapture("Faces panel closed")
		end)
	end
	if self._facesAddPresetButton then
		self:_connect(self._facesAddPresetButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.openPresetModal) == "function" then
				facesUi.openPresetModal(self)
			end
		end)
	end
	require(script.Parent:WaitForChild("UI"):WaitForChild("FacesSelectionImportBinding")).bind(self, callbacks)
	if self._facesRecoverPresetsButton then
		self:_connect(self._facesRecoverPresetsButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.openDeleteConfirmation) == "function" then
				facesUi.openDeleteConfirmation(self, {
					title = "Recover face presets?",
					message = "Scan this project's Face keyframes and add missing visual presets to Unsorted. Existing presets will not be overwritten.",
					confirmText = "Recover Presets",
					danger = false,
					onConfirm = function()
						if callbacks.onFacesAction then
							callbacks.onFacesAction("recoverPresetsFromProject")
						end
						self:_focusShortcutCapture("Face presets recovered from project")
					end,
				})
			end
		end)
	end
	if self._facesExportPresetsButton then
		self:_connect(self._facesExportPresetsButton.Activated, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("exportPresets")
			end
			self:_focusShortcutCapture("Face presets exported")
		end)
	end
	if self._facesImportPresetsButton then
		self:_connect(self._facesImportPresetsButton.Activated, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("importPresets")
			end
			self:_focusShortcutCapture("Face presets imported")
		end)
	end
	if self._facesInstantButton then
		self:_connect(self._facesInstantButton.Activated, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("setTransition", "Instant")
			end
			self:_focusShortcutCapture("Face transition: Instant")
		end)
	end
	if self._facesCrossFadeButton then
		self:_connect(self._facesCrossFadeButton.Activated, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("setTransition", "CrossFade")
			end
			self:_focusShortcutCapture("Face transition: CrossFade")
		end)
	end
	if self._facesFadeDurationInput then
		self:_connect(self._facesFadeDurationInput.FocusLost, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("setFadeTime", self._facesFadeDurationInput.Text)
			end
			self:_focusShortcutCapture("Face fade duration updated")
		end)
	end
	if self._facesSearchInput then
		self:_connect(self._facesSearchInput:GetPropertyChangedSignal("Text"), function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("search", self._facesSearchInput.Text)
			end
		end)
	end
	if self._facesAddFolderButton then
		self:_connect(self._facesAddFolderButton.Activated, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("createFolder", self._facesFolderNameInput and self._facesFolderNameInput.Text or "")
			end
		end)
	end
	if self._facesRenameFolderButton then
		self:_connect(self._facesRenameFolderButton.Activated, function()
			if callbacks.onFacesAction then
				callbacks.onFacesAction("renameFolder", self._facesFolderNameInput and self._facesFolderNameInput.Text or "")
			end
		end)
	end
	if self._facesDeleteFolderButton then
		self:_connect(self._facesDeleteFolderButton.Activated, function()
			local function deleteFolder()
				if callbacks.onFacesAction then
					callbacks.onFacesAction("deleteFolder")
				end
			end
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.confirmDeleteSelectedFolder) == "function" then
				facesUi.confirmDeleteSelectedFolder(self, deleteFolder)
			else
				deleteFolder()
			end
		end)
	end
	if self._facesSingleTypeButton then
		self:_connect(self._facesSingleTypeButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.setPresetFormType) == "function" then
				facesUi.setPresetFormType(self, "Single")
			end
		end)
	end
	if self._facesLayeredTypeButton then
		self:_connect(self._facesLayeredTypeButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.setPresetFormType) == "function" then
				facesUi.setPresetFormType(self, "Layered")
			end
		end)
	end
	if self._facesPresetPreviewButton then
		self:_connect(self._facesPresetPreviewButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.openLargePreview) == "function" then
				facesUi.openLargePreview(self)
			elseif facesUi and type(facesUi.renderModalPreview) == "function" then
				facesUi.renderModalPreview(self)
			end
		end)
	end
	if self._facesPresetCancelButton then
		self:_connect(self._facesPresetCancelButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.closePresetModal) == "function" then
				facesUi.closePresetModal(self)
			end
		end)
	end
	if self._facesPresetSaveButton then
		self:_connect(self._facesPresetSaveButton.Activated, function()
			local facesUi = self._uiSections.FacesUI
			if facesUi and type(facesUi.collectPresetForm) == "function" and callbacks.onFacesAction then
				local success = callbacks.onFacesAction("savePreset", facesUi.collectPresetForm(self))
				if success and type(facesUi.closePresetModal) == "function" then
					facesUi.closePresetModal(self)
				end
			end
		end)
	end
	if self._enhanceCloseButton then
		self:_connect(self._enhanceCloseButton.Activated, function()
			self:_setEnhanceOverlayVisible(false)
			self:_focusShortcutCapture("Enhance panel closed")
		end)
	end
	if self._attachHandButton then
		self:_connect(self._attachHandButton.Activated, function()
			if callbacks.onAttachHand then
				callbacks.onAttachHand()
			end
			self:_focusShortcutCapture("Shortcut capture: active after Attach Object")
		end)
	end
	if self._detachObjectButton then
		self:_connect(self._detachObjectButton.Activated, function()
			if callbacks.onDetachObject then
				callbacks.onDetachObject()
			end
			self:_focusShortcutCapture("Shortcut capture: active after Detach Object")
		end)
	end
	if self._smoothMotionButton then
		self:_connect(self._smoothMotionButton.Activated, function()
			if callbacks.onSmoothMotion then
				callbacks.onSmoothMotion("Light")
			end
			self:_focusShortcutCapture("Shortcut capture: active after Smooth Motion")
		end)
	end
	if self._anticipationButton then
		self:_connect(self._anticipationButton.Activated, function()
			if callbacks.onEnhanceFutureAction then
				callbacks.onEnhanceFutureAction("Add Anticipation")
			end
		end)
	end
	if self._makeFasterButton then
		self:_connect(self._makeFasterButton.Activated, function()
			if callbacks.onEnhanceFutureAction then
				callbacks.onEnhanceFutureAction("Make Faster")
			end
		end)
	end
	if self._effectsAddFadeTrackButton then
		self:_connect(self._effectsAddFadeTrackButton.Activated, function()
			if callbacks.onAddScreenEffectTrack then
				callbacks.onAddScreenEffectTrack("Fade")
			end
		end)
	end
	for effectId, button in pairs(self._screenEffectButtons or {}) do
		self:_connect(button.Activated, function()
			if callbacks.onAddScreenEffectTrack then
				local trackPath = callbacks.onAddScreenEffectTrack(effectId)
				if trackPath then
					self:_setEffectsOverlayVisible(false)
					self:_showEffectTrackEditor(trackPath)
				end
			end
		end)
	end
	for effectId, button in pairs(self._lightingEffectButtons or {}) do
		self:_connect(button.Activated, function()
			if callbacks.onAddLightingEffectTrack then
				local trackPath = callbacks.onAddLightingEffectTrack(effectId)
				if trackPath then
					self:_setEffectsOverlayVisible(false)
					self:_showEffectTrackEditor(trackPath)
				end
			end
		end)
	end
	for effectId, button in pairs({
		StopMotionHold = self._animationStopMotionButton,
		StopMotion2 = self._animationStopMotion2Button,
		StopMotion4 = self._animationStopMotion4Button,
		StopMotion6 = self._animationStopMotion6Button,
		KeyframeStagger = self._animationStaggerButton,
		OvershootSettle = self._animationOvershootSettleButton,
		LoopPolish = self._animationLoopPolishButton,
		BoilFrames = self._animationBoilFramesButton,
		PoseHold = self._animationPoseHoldButton,
		Wiggle = self._animationWiggleButton,
		Linearize = self._animationLinearizeButton,
		Reverse = self._animationReverseButton,
		SlowMotion2 = self._animationSlowMotionButton,
		SpeedRampUp = self._animationRampUpButton,
		SpeedRampDown = self._animationRampDownButton,
		SpeedRampInOut = self._animationRampInOutButton,
		SpeedRampOutIn = self._animationRampOutInButton,
	}) do
		if button then
			local selectedEffectId = effectId
			self:_connect(button.Activated, function()
				if selectedEffectId == "Wiggle" then
					self:_setEffectsOverlayVisible(false)
					self:_showWiggleFramesOverlay()
					self:_focusShortcutCapture("Wiggle settings open")
				elseif callbacks.onApplyAnimationEffect then
					callbacks.onApplyAnimationEffect(selectedEffectId)
					self:_focusShortcutCapture("Animation effect applied: " .. tostring(selectedEffectId))
				end
			end)
		end
	end
	if not pcall(function()
		require(script.Parent:WaitForChild("EffectsActionBinder")).bind(self, callbacks)
	end) then
		warn("[7kg2 Animator] Failed to bind Effects category actions.")
	end
	if self._viewportCollapseButton then
		self:_connect(self._viewportCollapseButton.Activated, function()
			self._isViewportCardCollapsed = true
			self:_refreshCenterColumnLayout()
		end)
	end
	if self._viewportExpandButton then
		self:_connect(self._viewportExpandButton.Activated, function()
			self._isViewportCardCollapsed = false
			self:_refreshCenterColumnLayout()
		end)
	end
	for panelKey, button in pairs({
		RigExplorer = self._rigExplorerCollapseButton,
		SessionSummary = self._sessionSummaryCollapseButton,
		Presets = self._presetsCollapseButton,
		Layout = self._layoutCollapseButton,
		Timeline = self._timelineCollapseButton,
		Inspector = self._inspectorCollapseButton,
		KeyframeTools = self._keyframeToolsCollapseButton,
	}) do
		if button then
			local collapseKey = panelKey
			self:_connect(button.Activated, function()
				self:_togglePanelCollapsed(collapseKey)
				self:_setShortcutHint(
					string.format(
						"%s %s panel.",
						self:_isPanelCollapsed(collapseKey) and "Collapsed" or "Expanded",
						collapseKey
					)
				)
			end)
		end
	end
	if self._transportCollapseButton then
		self:_connect(self._transportCollapseButton.Activated, function()
			self._isTransportCardCollapsed = true
			self:_refreshCenterColumnLayout()
		end)
	end
	if self._transportExpandButton then
		self:_connect(self._transportExpandButton.Activated, function()
			self._isTransportCardCollapsed = false
			self:_refreshCenterColumnLayout()
		end)
	end

	if self._presetFreeButton then
		self:_connect(self._presetFreeButton.Activated, function()
			self:_setWorkspaceMode("Presets")
			self:_setPresetSource("RobloxStarter")
			if self._presetStatusLabel then
				self._presetStatusLabel.Text = "Loading Roblox Starter packs..."
			end
			if callbacks.onLoadPresetAnimations then
				callbacks.onLoadPresetAnimations()
			end
		end)
	end
	if self._presetOwnedButton then
		self:_connect(self._presetOwnedButton.Activated, function()
			self:_setWorkspaceMode("Presets")
			self:_setPresetSource("MyAnimations")
			if self._presetStatusLabel then
				self._presetStatusLabel.Text = "Loading your Roblox animations..."
			end
			if callbacks.onLoadMyAnimations then
				callbacks.onLoadMyAnimations()
			end
		end)
	end
	if self._presetMarketplaceButton then
		self:_connect(self._presetMarketplaceButton.Activated, function()
			self:_setWorkspaceMode("Presets")
			self:_setPresetSource("RobloxStarter")
			if self._presetStatusLabel then
				self._presetStatusLabel.Text = "Searching Roblox Starter animations..."
			end
			if callbacks.onSearchMarketplaceAnimations then
				callbacks.onSearchMarketplaceAnimations(self._presetSearchInput and self._presetSearchInput.Text or "")
			end
		end)
	end
	if self._presetRigFilterButton then
		self:_connect(self._presetRigFilterButton.Activated, function()
			self:_cyclePresetRigFilter()
		end)
	end
	if self._presetImportIdButton then
		self:_connect(self._presetImportIdButton.Activated, function()
			self:_setWorkspaceMode("Presets")
			self:_importPresetIdInput(callbacks)
		end)
	end
	if self._presetR15ToR6Button then
		self:_connect(self._presetR15ToR6Button.Activated, function()
			self:_setWorkspaceMode("Presets")
			if callbacks.onOpenR15ToR6Converter then
				callbacks.onOpenR15ToR6Converter()
			else
				self:_setShortcutHint("R15 -&gt; R6 Converter is not connected yet.")
			end
		end)
	end
	if self._presetImportIdInput then
		self:_connect(self._presetImportIdInput.FocusLost, function(enterPressed)
			if enterPressed then
				self:_setWorkspaceMode("Presets")
				self:_importPresetIdInput(callbacks)
			end
		end)
	end
	if self._presetSearchInput then
		self:_connect(self._presetSearchInput.FocusLost, function(enterPressed)
			if not enterPressed then
				return
			end
			self:_setWorkspaceMode("Presets")
			if self._presetSource == "MyAnimations" and callbacks.onSearchMyAnimations then
				callbacks.onSearchMyAnimations(self._presetSearchInput.Text)
			elseif callbacks.onSearchMarketplaceAnimations then
				callbacks.onSearchMarketplaceAnimations(self._presetSearchInput.Text)
			end
		end)
	end

	self:_connect(self._trackColumnList:GetPropertyChangedSignal("CanvasPosition"), function()
		if syncingTrackScroll then
			return
		end

		syncingTrackScroll = true
		self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
		syncingTrackScroll = false
	end)

	self:_attachTimelineTrackWheelScroll(self._trackColumnList)
	self:_connect(UserInputService.InputChanged, function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end
		if not self._isMouseOverTimelineTrackList and not self:_isPointerInsideTimelineTrackList() then
			return
		end
		if self._marqueeSession or self._keyframeDragSession or self._timelineSession or self._trackReorderSession then
			return
		end

		self:_scrollTimelineVerticalByWheel(inputObject.Position.Z)
	end)

	TimelineMiddlePanInputSink.bind(MIDDLE_PAN_ACTION_NAME, function(inputState, inputObject)
		if not self._widget.Enabled then
			self:_endTimelineMiddlePan("widgetDisabled")
			return false
		end
		if self._timelineMiddlePanSession then
			if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
				self:_endTimelineMiddlePan("ContextActionEnded")
			elseif inputObject.UserInputType == Enum.UserInputType.MouseMovement then
				self:_updateTimelineMiddlePan(inputObject.Position)
			end
			return true
		end
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton3 then
			return false
		end

		local point = getCurrentMousePoint()
		local shouldPan = (
			self:_isPointInsideTimelineMarqueeOverlay(point)
			or isPointInsideGui(self._timelineScrubHitbox, point)
			or isPointInsideGui(self._laneContainer, point)
		)
		if shouldPan and inputState == Enum.UserInputState.Begin then
			self:_beginTimelineMiddlePan(point)
		end
		return shouldPan
	end)

	self:_connect(self._laneContainer:GetPropertyChangedSignal("CanvasPosition"), function()
		if syncingTrackScroll then
			return
		end

		local canvasPosition = self._laneContainer.CanvasPosition
		syncingTrackScroll = true
		self._trackColumnList.CanvasPosition = Vector2.new(0, 0)
		syncingTrackScroll = false
		self:_positionStickyTrackRows(canvasPosition.Y)
		if self._lastViewModel then
			local horizontalChanged = math.abs(canvasPosition.X - (self._lastTimelineScrollX or -1000000)) &gt; 0.5
			self._lastTimelineScrollX = canvasPosition.X
			if horizontalChanged then
				self:_scheduleTimelineHorizontalRefresh()
			end
			self:_positionPlayhead(self._lastViewModel)
		end
	end)

	if self._timelineRuler then
		self:_connect(self._timelineRuler:GetPropertyChangedSignal("AbsoluteSize"), function()
			self:_refreshTimelineForLayout()
		end)
	end

	if self._trackLaneArea then
		self:_connect(self._trackLaneArea:GetPropertyChangedSignal("AbsoluteSize"), function()
			self:_refreshTimelineForLayout()
		end)
	end

	if self._laneContainer then
		self:_connect(self._laneContainer:GetPropertyChangedSignal("AbsoluteSize"), function()
			self:_refreshTimelineForLayout()
		end)
	end

	self:_connect(self._zoomOutButton.Activated, function()
		self:_changeTimelineZoom(1 / 1.25)
	end)

	self:_connect(self._zoomInButton.Activated, function()
		self:_changeTimelineZoom(1.25)
	end)

	local function setZoomFromPoint(point)
		local width = math.max(1, self._zoomSlider.AbsoluteSize.X)
		local alpha = math.clamp((point.X - self._zoomSlider.AbsolutePosition.X) / width, 0, 1)
		local zoom = TIMELINE_MIN_ZOOM * ((TIMELINE_MAX_ZOOM / TIMELINE_MIN_ZOOM) ^ alpha)
		self:_setTimelineZoom(zoom)
	end

	self:_connect(self._zoomSlider.InputBegan, function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local startPos = positionToVector2(inputObject.Position)
		self:_startTimelineSession({
			button = self._zoomSlider,
			startPos = startPos,
			startImmediately = true,
			onChange = function(currentPos)
				setZoomFromPoint(currentPos)
			end,
			onTap = function(currentPos)
				setZoomFromPoint(currentPos)
			end,
		})
	end)

	self:_connect(self._root.MouseEnter, function()
		self._mouseInsideWidget = true
		self:_setShortcutHint("Click the timeline or a keyframe to arm 7kg2 shortcuts.")
	end)

	self:_connect(self._root.MouseLeave, function()
		self._mouseInsideWidget = false
		self:_closeDropdowns()
		self:_clearStaleTimelineMiddlePan("MouseLeave")
		if not self._mainDockWindowFocused then
			self:_releaseMainTimelineShortcuts("MouseLeaveWithoutWindowFocus")
		end
		self:_setShortcutHint("Shortcuts stay armed only while the 7kg2 window owns timeline focus.")
	end)

	self:_connect(self._root.InputBegan, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.Keyboard then
			if isMainShortcutDebugKey(inputObject.KeyCode) or isShiftKey(inputObject.KeyCode) then
				self:_mainShortcutDebug("rootKeyboardInput:begin", "key=" .. tostring(inputObject.KeyCode.Name), "result=Info")
			end
			self:_setKeyHeld(inputObject.KeyCode, true)
			if isShiftKey(inputObject.KeyCode)
				or inputObject.KeyCode == Enum.KeyCode.LeftControl
				or inputObject.KeyCode == Enum.KeyCode.RightControl then
				return
			end
			if self:_isTextEditingActive() then
				self:_mainShortcutDebug("rootKeyboardInput:blockedTextEditing", "key=" .. tostring(inputObject.KeyCode.Name), "result=Ignored", "reason=textEditing")
				return
			end
			if self:_shouldCaptureMainToolToggleShortcut(inputObject.KeyCode) then
				if self:_runShortcutAction(callbacks, inputObject.KeyCode) then
					self._rootKeyboardShortcutHandledKeys = self._rootKeyboardShortcutHandledKeys or {}
					self._rootKeyboardShortcutHandledKeys[inputObject.KeyCode.Name] = true
				end
				return
			end
			if not self:_ownsMainTimelineShortcuts() then
				if isMainShortcutDebugKey(inputObject.KeyCode) or isShiftKey(inputObject.KeyCode) then
					self:_mainShortcutDebug("rootKeyboardInput:passNoTimelineOwner", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=noTimelineOwner")
				end
				return
			end
			local handledShortcut = self:_handleShortcutInput(callbacks, inputObject)
			if handledShortcut then
				self._rootKeyboardShortcutHandledKeys = self._rootKeyboardShortcutHandledKeys or {}
				self._rootKeyboardShortcutHandledKeys[inputObject.KeyCode.Name] = true
			elseif self._shortcutShiftHeld then
				self:_setShortcutHint("Shift shortcut not mapped: " .. inputObject.KeyCode.Name)
			end
			return
		end

		local point = positionToVector2(inputObject.Position)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
			if self:_toggleTimelineMarkerAtPoint(point, "Right-click") then
				return
			end
		elseif inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
			point = getCurrentMousePoint()
			if self:_isPointInsideTimelineMarqueeOverlay(point)
				or isPointInsideGui(self._timelineScrubHitbox, point)
				or isPointInsideGui(self._laneContainer, point) then
				self:_beginTimelineMiddlePan(point)
				return
			end
	elseif inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			if callbacks.onIsWorkspaceGrabActive
				and callbacks.onIsWorkspaceGrabActive() == true then
				local message = nil
				if callbacks.onReleaseWorkspaceGrabFromPluginUi then
					local _, releaseMessage = callbacks.onReleaseWorkspaceGrabFromPluginUi(
						"Free Grab turned off because you returned to 7kg2.",
						"PluginUiClicked"
					)
					message = releaseMessage
				end
				if callbacks.onIsWorkspaceGrabActive() ~= true then
					self._workspaceGrabUiReleaseUntil = os.clock() + 0.5
					if message then
						self:_setShortcutHint(message)
					end
				end
				return
			end
			self._shortcutFocus = true
			if callbacks.onResumeViewportRigPartPicker then
				callbacks.onResumeViewportRigPartPicker()
			end
			if self:_isPointInsideTimelineMarqueeOverlay(point)
				or isPointInsideGui(self._timelineScrubHitbox, point)
				or isPointInsideGui(self._laneContainer, point) then
				self:_acquireMainTimelineShortcuts("timeline-click")
			else
				self:_releaseMainTimelineShortcuts("plugin-click")
			end
			if self:_isPointInsideEditableInput(point) then
				self:_exitTimelineKeyboardFocus("text-input")
				self:_releaseShortcutCapture()
				self._shortcutFocus = false
				self:_setShortcutHint("Text editing active: shortcuts paused")
				return
			end

			if self:_isPointInsideTimelineMarqueeOverlay(point)
				and not self:_findTimelineMarkerAtPoint(point)
				and not self._keyframeDragSession
				and not self._timelineSession
				and not self._marqueeSession then
				if self:_isAdditiveSelectionActive() then
					self:_setShortcutHint("Shift selection: drag a box to add/remove keyframes")
				else
					self:_acquireMainTimelineShortcuts("timeline-marquee")
				end
				self:_startTimelineMarqueeSelection(point)
				return
			end

			if self:_isAdditiveSelectionActive() then
				self:_setShortcutHint("Shift selection: click tracks or keyframes to add/remove")
				return
			end
		end
	end)

	self:_connect(self._root.InputEnded, function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if isMainShortcutDebugKey(inputObject.KeyCode) or isShiftKey(inputObject.KeyCode) then
			self:_mainShortcutDebug("rootKeyboardInput:end", "key=" .. tostring(inputObject.KeyCode.Name), "result=Info")
		end
		local keyName = inputObject.KeyCode.Name
		local handledOnBegin = self._rootKeyboardShortcutHandledKeys and self._rootKeyboardShortcutHandledKeys[keyName] == true
		if self._rootKeyboardShortcutHandledKeys then
			self._rootKeyboardShortcutHandledKeys[keyName] = nil
		end
		if not handledOnBegin
			and not isShiftKey(inputObject.KeyCode)
			and inputObject.KeyCode ~= Enum.KeyCode.LeftControl
			and inputObject.KeyCode ~= Enum.KeyCode.RightControl
			and not self:_isTextEditingActive()
			and self:_ownsMainTimelineShortcuts()
			and (self._shortcutShiftHeld or isShiftDown())
		then
			self:_mainShortcutDebug("rootKeyboardInput:endFallback", "key=" .. tostring(inputObject.KeyCode.Name), "result=Info", "reason=missingBegin")
			self:_handleShortcutInput(callbacks, inputObject)
		end
		self:_releaseTrackballAxisShortcut(inputObject.KeyCode)
		self:_setKeyHeld(inputObject.KeyCode, false)
		if isShiftKey(inputObject.KeyCode) then
			task.defer(function()
				self:_setShiftHeld(self:_isShiftHeldFromInputState())
			end)
		end
	end)

	self:_connect(UserInputService.InputBegan, function(inputObject, gameProcessedEvent)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1
			or inputObject.UserInputType == Enum.UserInputType.MouseButton2
			or inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
			if self._timelineMiddlePanSession and inputObject.UserInputType ~= Enum.UserInputType.MouseButton3 then
				self:_endTimelineMiddlePan("mouseButtonChanged")
			end
			local clickedOutsideSyntheticFocus = self._mainShortcutSyntheticDockFocus == true
				and self._root ~= nil
				and not isPointInsideGui(self._root, positionToVector2(inputObject.Position))
			if self._mainDockWindowFocused ~= true or clickedOutsideSyntheticFocus then
				self:_mainShortcutDebug("mouseOutsideMain", "button=" .. tostring(inputObject.UserInputType.Name), "processed=" .. tostring(gameProcessedEvent), "result=Ignored", "reason=windowNotFocused")
				self:_endTimelineMiddlePan("windowNotFocused")
				self:_disarmTimelineShortcuts("Studio shortcuts active: click 7kg2 to resume timeline shortcuts")
				return
			end
		end

		if gameProcessedEvent then
			return
		end

		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			return
		elseif inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
			self:_toggleTimelineMarkerAtPoint(positionToVector2(inputObject.Position), "Right-click")
		elseif inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
			local point = getCurrentMousePoint()
			if self:_isPointInsideTimelineMarqueeOverlay(point)
				or isPointInsideGui(self._timelineScrubHitbox, point)
				or isPointInsideGui(self._laneContainer, point) then
				self:_beginTimelineMiddlePan(point)
			end
		end
	end)

	self:_connect(UserInputService.InputChanged, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			if not self:_clearStaleTimelineMiddlePan("middleMouseReleasedDuringMove") then
				self:_updateTimelineMiddlePan(inputObject.Position)
			end
		end
	end)

	self:_connect(self._root.InputChanged, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			self._mouseInsideWidget = true
		end
	end)

	if self._shortcutCaptureInput then
		self:_connect(self._shortcutCaptureInput.Focused, function()
			self._shortcutFocus = true
			self:_setShortcutHint("Shortcut capture: + add keyframe, G reset limb, [/] prev/next frame, Space play/pause, M smooth, Y local/world, Shift+A/C/D/V/X/Z/Y, R, T, B, H, Keypad 7")
		end)

		self:_connect(self._shortcutCaptureInput.FocusLost, function()
			self._shortcutCaptureInput.Text = ""
			if self._mouseInsideWidget then
				self:_setShortcutHint("Shortcuts ready: click plugin, then + add keyframe, G reset limb, [/] prev/next frame, Space play/pause, N multi, P hide, M smooth, Y local/world, T trackball, R, B, H")
			else
				self:_setShortcutHint("Shortcuts paused: move over or click the plugin")
			end
		end)

		self:_connect(self._shortcutCaptureInput:GetPropertyChangedSignal("Text"), function()
			self:_handleShortcutCaptureText(callbacks)
		end)
	end

	for _, input in ipairs(self:_getEditableInputs()) do
		if input then
			self:_connect(input.Focused, function()
				self._editingTextInput = input
				self._shortcutFocus = false
				self:_exitTimelineKeyboardFocus("text-input")
				self:_releaseShortcutCapture()
				self:_setShortcutHint("Text editing active: shortcuts paused")
			end)

			self:_connect(input.FocusLost, function()
				if self._editingTextInput == input then
					self._editingTextInput = nil
				end
				self:_setShortcutHint(self._mouseInsideWidget
				and "Shortcuts ready: click plugin, then + add keyframe, G reset limb, [/] prev/next frame, Space play/pause, N multi, P hide, M smooth, Y local/world, T/Shift+T trackball"
					or "Shortcuts paused: move over or click the plugin")
			end)
		end
	end

	if self._shortcutCaptureInput then
		self:_connect(self._shortcutCaptureInput.InputBegan, function(inputObject)
			if inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if isMainShortcutDebugKey(inputObject.KeyCode) then
				self:_mainShortcutDebug("captureInput:begin", "key=" .. tostring(inputObject.KeyCode.Name))
			end
			if not self:_ownsMainTimelineShortcuts() then
				self:_mainShortcutDebug("captureInput:passNoTimelineOwner", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=noTimelineOwner")
				self:_releaseShortcutCapture()
				return
			end

			self:_setKeyHeld(inputObject.KeyCode, true)
			if inputObject.KeyCode == Enum.KeyCode.Space then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif inputObject.KeyCode == Enum.KeyCode.Delete
				or inputObject.KeyCode == Enum.KeyCode.Backspace then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif (inputObject.KeyCode == Enum.KeyCode.A
				or inputObject.KeyCode == Enum.KeyCode.C
				or inputObject.KeyCode == Enum.KeyCode.D
				or inputObject.KeyCode == Enum.KeyCode.V
				or inputObject.KeyCode == Enum.KeyCode.Z
				or inputObject.KeyCode == Enum.KeyCode.Y)
				and isControlDown()
				and self:_shouldCaptureTimelineControlShortcuts() then
				self:_mainShortcutDebug("captureInput:controlShortcut", "key=" .. tostring(inputObject.KeyCode.Name))
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif inputObject.KeyCode == Enum.KeyCode.KeypadSeven
				or inputObject.KeyCode == Enum.KeyCode.Plus
				or inputObject.KeyCode == Enum.KeyCode.KeypadPlus
				or inputObject.KeyCode == Enum.KeyCode.Equals
				or inputObject.KeyCode == Enum.KeyCode.LeftBracket
				or inputObject.KeyCode == Enum.KeyCode.RightBracket
				or inputObject.KeyCode == Enum.KeyCode.R
				or inputObject.KeyCode == Enum.KeyCode.T
				or inputObject.KeyCode == Enum.KeyCode.G
				or inputObject.KeyCode == Enum.KeyCode.B
				or inputObject.KeyCode == Enum.KeyCode.H
				or inputObject.KeyCode == Enum.KeyCode.K
				or inputObject.KeyCode == Enum.KeyCode.N
				or inputObject.KeyCode == Enum.KeyCode.P
				or inputObject.KeyCode == Enum.KeyCode.M
				or inputObject.KeyCode == Enum.KeyCode.Y
			then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			end
		end)

		self:_connect(self._shortcutCaptureInput.InputEnded, function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.Keyboard then
				self:_setKeyHeld(inputObject.KeyCode, false)
				self:_releaseTrackballAxisShortcut(inputObject.KeyCode)
			end
		end)
	end

	local dockCaptureInput = self._mainDockShortcutCaptureInput
	if dockCaptureInput and dockCaptureInput ~= self._shortcutCaptureInput then
		self:_connect(dockCaptureInput.Focused, function()
			self._shortcutFocus = true
			self:_setShortcutHint("Main shortcuts active: Shift+A/C/D/V/X/Z/Y, R, T, Space")
		end)

		self:_connect(dockCaptureInput.FocusLost, function()
			dockCaptureInput.Text = ""
		end)

		self:_connect(dockCaptureInput.InputBegan, function(inputObject)
			if inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if isMainShortcutDebugKey(inputObject.KeyCode) then
				self:_mainShortcutDebug("dockCaptureInput:begin", "key=" .. tostring(inputObject.KeyCode.Name))
			end
			if not self:_ownsMainTimelineShortcuts() then
				self:_mainShortcutDebug("dockCaptureInput:passNoTimelineOwner", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=noTimelineOwner")
				self:_releaseShortcutCapture()
				return
			end

			self:_setKeyHeld(inputObject.KeyCode, true)
			if (inputObject.KeyCode == Enum.KeyCode.A
				or inputObject.KeyCode == Enum.KeyCode.C
				or inputObject.KeyCode == Enum.KeyCode.D
				or inputObject.KeyCode == Enum.KeyCode.V
				or inputObject.KeyCode == Enum.KeyCode.Z
				or inputObject.KeyCode == Enum.KeyCode.Y)
				and isControlDown()
				and self:_shouldCaptureTimelineControlShortcuts() then
				self:_mainShortcutDebug("dockCaptureInput:controlShortcut", "key=" .. tostring(inputObject.KeyCode.Name))
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				dockCaptureInput.Text = ""
			elseif inputObject.KeyCode == Enum.KeyCode.Space
				or inputObject.KeyCode == Enum.KeyCode.Delete
				or inputObject.KeyCode == Enum.KeyCode.Backspace
				or inputObject.KeyCode == Enum.KeyCode.KeypadSeven
				or inputObject.KeyCode == Enum.KeyCode.Plus
				or inputObject.KeyCode == Enum.KeyCode.KeypadPlus
				or inputObject.KeyCode == Enum.KeyCode.Equals
				or inputObject.KeyCode == Enum.KeyCode.LeftBracket
				or inputObject.KeyCode == Enum.KeyCode.RightBracket
				or inputObject.KeyCode == Enum.KeyCode.R
				or inputObject.KeyCode == Enum.KeyCode.T
				or inputObject.KeyCode == Enum.KeyCode.G
				or inputObject.KeyCode == Enum.KeyCode.B
				or inputObject.KeyCode == Enum.KeyCode.H
				or inputObject.KeyCode == Enum.KeyCode.K
				or inputObject.KeyCode == Enum.KeyCode.N
				or inputObject.KeyCode == Enum.KeyCode.P
				or inputObject.KeyCode == Enum.KeyCode.M
				or inputObject.KeyCode == Enum.KeyCode.Y
			then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				dockCaptureInput.Text = ""
			end
		end)

		self:_connect(dockCaptureInput.InputEnded, function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.Keyboard then
				self:_setKeyHeld(inputObject.KeyCode, false)
				self:_releaseTrackballAxisShortcut(inputObject.KeyCode)
			end
		end)
	end

	self:_connect(UserInputService.InputBegan, function(inputObject, gameProcessedEvent)
		if inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if isMainShortcutDebugKey(inputObject.KeyCode) then
			self:_mainShortcutDebug(
				"UIS:begin",
				"key=" .. tostring(inputObject.KeyCode.Name),
				"processed=" .. tostring(gameProcessedEvent)
			)
		end

		if inputObject.KeyCode == Enum.KeyCode.LeftControl
			or inputObject.KeyCode == Enum.KeyCode.RightControl then
			self:_setKeyHeld(inputObject.KeyCode, true)
			if gameProcessedEvent then
				return
			end
		end

		if gameProcessedEvent then
			if self:_shouldCaptureMainToolToggleShortcut(inputObject.KeyCode) then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
			elseif (inputObject.KeyCode == Enum.KeyCode.C
				or inputObject.KeyCode == Enum.KeyCode.A
				or inputObject.KeyCode == Enum.KeyCode.V
				or inputObject.KeyCode == Enum.KeyCode.D
				or inputObject.KeyCode == Enum.KeyCode.Z
				or inputObject.KeyCode == Enum.KeyCode.Y)
				and isControlDown()
				and not self:_isTextEditingActive()
				and self._widget.Enabled
				and self:_shouldCaptureTimelineControlShortcuts("uisProcessedControlShortcut") then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
			elseif isMainShortcutDebugKey(inputObject.KeyCode) then
				self:_mainShortcutDebug("UIS:processedIgnored", "key=" .. tostring(inputObject.KeyCode.Name))
			end
			return
		end

		if self:_isTextEditingActive() then
			if isMainShortcutDebugKey(inputObject.KeyCode) then
				self:_mainShortcutDebug("UIS:blockedTextEditing", "key=" .. tostring(inputObject.KeyCode.Name))
			end
			return
		end

		self:_setKeyHeld(inputObject.KeyCode, true)
		if isShiftKey(inputObject.KeyCode) then
			return
		end

		if self:_isShortcutCaptureFocused() then
			if not self:_ownsMainTimelineShortcuts() then
				if self:_shouldCaptureMainToolToggleShortcut(inputObject.KeyCode) then
					self:_runShortcutAction(callbacks, inputObject.KeyCode)
					self._shortcutCaptureInput.Text = ""
					return
				end
				if isMainShortcutDebugKey(inputObject.KeyCode) then
					self:_mainShortcutDebug("UIS:captureFocusedPassNoTimelineOwner", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=noTimelineOwner")
				end
				self:_releaseShortcutCapture()
				return
			end
			if inputObject.KeyCode == Enum.KeyCode.Space then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif inputObject.KeyCode == Enum.KeyCode.KeypadSeven then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif (inputObject.KeyCode == Enum.KeyCode.A
				or inputObject.KeyCode == Enum.KeyCode.C
				or inputObject.KeyCode == Enum.KeyCode.D
				or inputObject.KeyCode == Enum.KeyCode.V
				or inputObject.KeyCode == Enum.KeyCode.Z
				or inputObject.KeyCode == Enum.KeyCode.Y)
				and isControlDown()
				and self:_shouldCaptureTimelineControlShortcuts() then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif inputObject.KeyCode == Enum.KeyCode.LeftBracket
				or inputObject.KeyCode == Enum.KeyCode.RightBracket
			then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			elseif (inputObject.KeyCode == Enum.KeyCode.X or inputObject.KeyCode == Enum.KeyCode.Y or inputObject.KeyCode == Enum.KeyCode.Z)
				and not (self._shortcutShiftHeld or isShiftDown())
				and self:_runTrackballAxisShortcut(callbacks, inputObject.KeyCode) then
				self._shortcutCaptureInput.Text = ""
			elseif inputObject.KeyCode == Enum.KeyCode.R or inputObject.KeyCode == Enum.KeyCode.T or inputObject.KeyCode == Enum.KeyCode.G or inputObject.KeyCode == Enum.KeyCode.B or inputObject.KeyCode == Enum.KeyCode.H or inputObject.KeyCode == Enum.KeyCode.K or inputObject.KeyCode == Enum.KeyCode.M or inputObject.KeyCode == Enum.KeyCode.Y or inputObject.KeyCode == Enum.KeyCode.P or inputObject.KeyCode == Enum.KeyCode.C then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				self._shortcutCaptureInput.Text = ""
			end
			return
		end

		if inputObject.KeyCode == Enum.KeyCode.P
			and callbacks.onToggleHideDuringPlayback
			and self:_ownsMainTimelineShortcuts()
			and ((self._lastViewModel and self._lastViewModel.isPlaying) or self:_isShortcutContextActive())
		then
			self:_runShortcutAction(callbacks, inputObject.KeyCode)
			return
		end

		if not self:_ownsMainTimelineShortcuts() then
			if self:_shouldCaptureMainToolToggleShortcut(inputObject.KeyCode) then
				self:_runShortcutAction(callbacks, inputObject.KeyCode)
				return
			end
			if isMainShortcutDebugKey(inputObject.KeyCode) then
				self:_mainShortcutDebug("UIS:passNoTimelineOwner", "key=" .. tostring(inputObject.KeyCode.Name), "result=Pass", "reason=noTimelineOwner")
			end
			return
		end

		if not self:_handleShortcutInput(callbacks, inputObject) and self._shortcutShiftHeld then
			self:_setShortcutHint("Shift shortcut not mapped: " .. inputObject.KeyCode.Name)
		end
	end)

	self:_connect(UserInputService.InputEnded, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.Keyboard then
			self:_releaseTrackballAxisShortcut(inputObject.KeyCode)
			self:_setKeyHeld(inputObject.KeyCode, false)
		elseif inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
			self:_endTimelineMiddlePan("InputEnded")
		end

		if isShiftKey(inputObject.KeyCode) then
			task.defer(function()
				self:_setShiftHeld(self:_isShiftHeldFromInputState())
			end)
		end
	end)

	self:_connect(UserInputService.WindowFocusReleased, function()
		self._keysDown = {}
		self._rootKeyboardShortcutHandledKeys = {}
		self._trackballAxisKeysDown = {}
		self._trackballAxisKeyTimes = {}
		self:_setShiftHeld(false)
		self:_endTimelineMiddlePan("WindowFocusReleased")
	end)

	self:_connect(self._timelineScrubHitbox.InputBegan, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
			self:_beginTimelineMiddlePan(getCurrentMousePoint())
			return
		end
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local startPos = positionToVector2(inputObject.Position)
		if self:_isPointInsideTimelineLanes(startPos) then
			return
		end

		if self._lastViewModel and self._lastViewModel.isPlaying and callbacks.onPausePlaybackAtCurrent then
			callbacks.onPausePlaybackAtCurrent("Paused playback for timeline scrub.")
		end
		self:_acquireMainTimelineShortcuts("timeline-scrubber")
		self:_focusShortcutCapture("Shortcut capture: active after timeline click")
		local durationFrames = self._lastViewModel and self._lastViewModel.durationFrames or Constants.DEFAULT_DURATION_FRAMES
		self:_startTimelineSession({
			button = self._timelineScrubHitbox,
			startPos = startPos,
			startImmediately = true,
			suppressRulerRefresh = true,
			onChange = function(currentPos)
				self:_autoScrollTimelineForPoint(currentPos, durationFrames)
				local frame = self:_positionToTimelineFrame(currentPos, durationFrames)
				if callbacks.onPreviewScrubToFrame then
					callbacks.onPreviewScrubToFrame(frame)
				else
					callbacks.onScrubToFrame(frame)
				end
			end,
			onEnd = function(currentPos)
				callbacks.onScrubToFrame(self:_positionToTimelineFrame(currentPos, durationFrames))
			end,
		onTap = function(currentPos)
			callbacks.onScrubToFrame(self:_positionToTimelineFrame(currentPos, durationFrames))
		end,
	})
end)

	if self._timelineMarqueeOverlay then
		local function normalizeTimelineOverlayPoint(point)
			point = positionToVector2(point)
			if isPointInsideGui(self._timelineMarqueeOverlay, point) then
				return point
			end
			local overlaySize = self._timelineMarqueeOverlay.AbsoluteSize
			if point.X &gt;= -overlaySize.X and point.X &lt;= overlaySize.X * 2
				and point.Y &gt;= -overlaySize.Y and point.Y &lt;= overlaySize.Y * 2 then
				return self._timelineMarqueeOverlay.AbsolutePosition + point
			end
			return point
		end

		local function beginTimelineOverlayInteraction(startPos)
			startPos = normalizeTimelineOverlayPoint(startPos)
			if self._keyframeDragSession or self._timelineSession or self._marqueeSession then
				return
			end

			local markerData = self:_findTimelineMarkerAtPoint(startPos)
			if markerData and self:_beginKeyframeDrag(markerData, startPos) then
				if self._lastViewModel and self._lastViewModel.isPlaying and callbacks.onPausePlaybackAtCurrent then
					callbacks.onPausePlaybackAtCurrent("Paused playback for keyframe edit.")
				end
				return
			end

			if self._lastViewModel and self._lastViewModel.isPlaying and callbacks.onPausePlaybackAtCurrent then
				callbacks.onPausePlaybackAtCurrent("Paused playback for timeline selection.")
			end
			if self:_isAdditiveSelectionActive() then
				self:_setShortcutHint("Shift selection: drag a box to add/remove keyframes")
			else
				self:_acquireMainTimelineShortcuts("timeline-overlay")
				self:_focusShortcutCapture("Shortcut capture: active after timeline click")
			end
			self:_startTimelineMarqueeSelection(startPos)
		end

		self:_connect(self._timelineMarqueeOverlay.MouseButton1Down, function(x, y)
			beginTimelineOverlayInteraction(Vector2.new(x, y))
		end)

		self:_connect(self._timelineMarqueeOverlay.InputBegan, function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
				self:_toggleTimelineMarkerAtPoint(positionToVector2(inputObject.Position), "Right-click")
				return
			end
			if inputObject.UserInputType == Enum.UserInputType.MouseButton3 then
				self:_beginTimelineMiddlePan(getCurrentMousePoint())
				return
			end
			if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			beginTimelineOverlayInteraction(positionToVector2(inputObject.Position))
		end)

		self:_connect(self._timelineMarqueeOverlay.InputChanged, function(inputObject)
			if inputObject.UserInputType ~= Enum.UserInputType.MouseWheel or self._marqueeSession then
				return
			end
			if not self._laneContainer then
				return
			end
			local wheelDelta = inputObject.Position.Z
			local current = self._laneContainer.CanvasPosition
			local maxScrollY = math.max(0, self._laneContainer.AbsoluteCanvasSize.Y - self._laneContainer.AbsoluteWindowSize.Y)
			local nextY = math.clamp(current.Y - (wheelDelta * 48), 0, maxScrollY)
			self._laneContainer.CanvasPosition = Vector2.new(current.X, nextY)
		end)
	end

