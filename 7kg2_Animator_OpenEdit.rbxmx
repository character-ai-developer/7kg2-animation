editorActions.nextKeyframe = jumpToNextKeyframe

local function selectKeyframe(frame, additive)
	if not timeline:hasKeyframe(frame) then
		if not additive then
			clearSelectedKeyframes()
		end
		refreshUi(string.format("Frame %d does not contain a keyframe.", frame))
		return
	end

	if not additive then
		clearSelectedKeyframes()
	end
	clearSelectedTracks()

	local selectedCount
	selectedKeys, selectedCount, frame = require(Modules:WaitForChild("FrameKeySelectionSupport")).selectFrameKeys(timeline, selectedKeys, frame, true)
	selectedKeyframeFrame = frame
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	enableMoveGizmoForKeySelection()

	timeline:setCurrentFrame(frame)
	timeline:applyCurrentFrame()
	refreshUi(string.format("Selected %d track keys at frame %d.", selectedCount, frame))
end

local function setPlayhead(frame)
	preserveTrackSelectionWhenScrubbingAway(frame)
	local previousFrame = timeline:getCurrentFrame()
	timeline:setCurrentFrame(frame)
	pcall(function()
		require(Modules:WaitForChild("AttachService")).prepareTimelineState(timeline, timeline:getCurrentFrame())
	end)
	playbackService:applyScrubFrame(timeline:getCurrentFrame(), true)
	pcall(function()
		require(Modules:WaitForChild("AttachService")).applyTimelineState(timeline, timeline:getCurrentFrame())
	end)
	CameraTrackService.applyActiveFirstPersonPreview(timeline, timeline:getCurrentFrame())
	renderScreenEffects(timeline:getCurrentFrame())
	if timeline.scrubParticleEventsBetween then
		timeline:scrubParticleEventsBetween(previousFrame, timeline:getCurrentFrame())
	end
	updateOnionSkinPreview(timeline:getCurrentFrame(), true)
	if editorActions._persistentTrackballMode and editorActions._trackballTool and type(editorActions._trackballTool.SyncToFrame) == "function" then
		editorActions._trackballTool:SyncToFrame(timeline:getCurrentFrame())
	end
	refreshUi(string.format("Moved playhead to frame %d.", frame))
end

local function previewPlayhead(frame)
	preserveTrackSelectionWhenScrubbingAway(frame)
	local previousFrame = timeline:getCurrentFrame()
	local changed = timeline:setCurrentFrame(frame)
	if changed then
		pcall(function()
			require(Modules:WaitForChild("AttachService")).prepareTimelineState(timeline, timeline:getCurrentFrame())
		end)
		playbackService:applyScrubFrame(timeline:getCurrentFrame(), false)
		pcall(function()
			require(Modules:WaitForChild("AttachService")).applyTimelineState(timeline, timeline:getCurrentFrame())
		end)
		CameraTrackService.applyActiveFirstPersonPreview(timeline, timeline:getCurrentFrame())
		renderScreenEffects(timeline:getCurrentFrame())
		if timeline.scrubParticleEventsBetween then
			timeline:scrubParticleEventsBetween(previousFrame, timeline:getCurrentFrame())
		end
		if editorActions._persistentTrackballMode and editorActions._trackballTool and type(editorActions._trackballTool.SyncToFrame) == "function" then
			editorActions._trackballTool:SyncToFrame(timeline:getCurrentFrame())
		end
	end
	updateOnionSkinPreview(timeline:getCurrentFrame(), true)
	widgetController:updateScrubFrame(timeline:getCurrentFrame(), "Scrubbing timeline...")
end

editorActions._setPlayhead = setPlayhead
editorActions._previewPlayhead = previewPlayhead

local function selectKeyframeRange(startFrame, endFrame, additive)
	if not additive then
		clearSelectedKeyframes()
	end

	local selectedCount
	selectedKeys, selectedCount, startFrame, endFrame = require(Modules:WaitForChild("FrameKeySelectionSupport")).selectKeyframeRange(
		timeline,
		selectedKeys,
		startFrame,
		endFrame
	)

	local selectedFrames = getSelectedKeyframeFrames()
	selectedKeyframeFrame = selectedFrames[#selectedFrames]
	if selectedKeyframeFrame then
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
		syncPlayheadToSelectedKeyframe()
		enableMoveGizmoForKeySelection()
	else
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	end

	refreshUi(string.format("Selected %d track keys in range %d-%d.", selectedCount, startFrame, endFrame))
end

local function toggleFrameSelection(frame)
	local didToggleOff
	selectedKeys, didToggleOff = require(Modules:WaitForChild("FrameKeySelectionSupport")).toggleFrameSelection(selectedKeys, frame)
	if not didToggleOff then
		selectKeyframe(frame, true)
		return
	end

	local selectedFrames = getSelectedKeyframeFrames()
	selectedKeyframeFrame = selectedFrames[#selectedFrames]
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	syncPlayheadToSelectedKeyframe()
	refreshUi(string.format("Toggled frame %d selection.", frame))
end

local function selectKey(jointPath, frame, additive)
	if not timeline:hasTrackKeyframe(jointPath, frame) then
		if not additive then
			clearSelectedKeyframes()
		end
		refreshUi(string.format("That track has no keyframe at frame %d.", frame))
		return
	end

	local keyId = SelectionState.makeTrackKeyId(jointPath, frame)
	local groupMembership = keyframeEditService:getGroupMembership()
	local groupId = groupMembership[keyId]
	if groupId and not additive then
		local groupKeys = getKeyRefsForGroup(groupId)
		local group = keyframeEditService:getGroups()[groupId]
		selectKeys(groupKeys, true)
		selectedJointPath = jointPath
		refreshUi(string.format("Selected group '%s' (%d keyframes).", group and group.name or ("Group " .. tostring(groupId)), #groupKeys))
		task.defer(refreshSelectedGizmo)
		return
	end

	clearSelectedTracks()
	if not additive then
		clearSelectedKeyframes()
	end

	selectedKeys = require(Modules:WaitForChild("FrameKeySelectionSupport")).selectSingleKey(selectedKeys, jointPath, frame)
	selectedKeyframeFrame = frame
	selectedJointPath = jointPath
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	syncPlayheadToSelectedKeyframe()
	enableMoveGizmoForKeySelection()
	editorActions.resumeMicroViewportToolsForTimelineSelection()
	refreshUi(string.format("Selected track key at frame %d.", frame))
	task.defer(refreshSelectedGizmo)
end

editorActions.selectKey = selectKey

local function toggleKeySelection(jointPath, frame)
	local keyId = SelectionState.makeTrackKeyId(jointPath, frame)
	clearSelectedTracks()
	local groupMembership = keyframeEditService:getGroupMembership()
	local groupId = groupMembership[keyId]
	if groupId then
		local groupKeys = getKeyRefsForGroup(groupId)
		local group = keyframeEditService:getGroups()[groupId]
		selectedKeys, shouldDeselect, selectedKeyframeFrame, selectedJointPath =
			require(Modules:WaitForChild("GroupedKeySelectionSupport")).toggleGroupedSelection(selectedKeys, groupKeys, jointPath, frame)
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
		if not shouldDeselect then
			enableMoveGizmoForKeySelection()
		end
		refreshUi(string.format("%s group '%s'.", shouldDeselect and "Deselected" or "Selected", group and group.name or ("Group " .. tostring(groupId))))
		return
	end

	selectedKeys, didSelect = require(Modules:WaitForChild("GroupedKeySelectionSupport")).toggleSingleKey(selectedKeys, jointPath, frame)
	if didSelect then
		selectedKeyframeFrame = frame
		selectedJointPath = jointPath
		syncPlayheadToSelectedKeyframe()
		enableMoveGizmoForKeySelection()
		editorActions.resumeMicroViewportToolsForTimelineSelection()
	end
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)

	refreshUi(string.format("Toggled track key at frame %d.", frame))
end

editorActions.toggleKeySelection = toggleKeySelection

local function selectKeysInBox(keyList, additive, preservePlayhead)
	if not additive then
		clearSelectedKeyframes()
	end
	clearSelectedTracks()
	selectedKeys, selectedKeyframeFrame, selectedJointPath, selectedCount =
		require(Modules:WaitForChild("SelectedKeySetSupport")).selectKeysInBox(keyList, timeline, selectedKeys)
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	if selectedKeyframeFrame then
		if not preservePlayhead then
			syncPlayheadToSelectedKeyframe()
		end
		enableMoveGizmoForKeySelection()
		editorActions.resumeMicroViewportToolsForTimelineSelection()
	end

	refreshUi(string.format("Selected %d track keys with box select.", selectedCount))
	task.defer(refreshSelectedGizmo)
end

editorActions.selectKeysInBox = selectKeysInBox

function editorActions.moveSubtitleClipToFrame(track, sourceFrame, targetFrame)
	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	targetFrame = math.max(0, math.floor(tonumber(targetFrame) or 0))

	local clipToMove = nil
	for _, clip in ipairs(ScreenEffectTrackService.getSubtitleClipDataForTrack(timeline, track)) do
		if math.floor(tonumber(clip.frame) or -1) == sourceFrame then
			clipToMove = clip
			break
		end
	end
	if not clipToMove then
		local success, message = timeline:moveTrackKeyframe(track.path, sourceFrame, targetFrame)
		return success, message, targetFrame
	end

	local keyRefs = {
		{
			jointPath = track.path,
			frame = sourceFrame,
		},
	}
	local endFrame = math.floor(tonumber(clipToMove.endFrame) or sourceFrame)
	if clipToMove.hasExplicitEnd == true and timeline:hasTrackKeyframe(track.path, endFrame) then
		local duration = math.max(1, endFrame - sourceFrame)
		targetFrame = math.clamp(targetFrame, 0, math.max(0, timeline:getDurationFrames() - duration))
		keyRefs[#keyRefs + 1] = {
			jointPath = track.path,
			frame = endFrame,
		}
	else
		targetFrame = math.clamp(targetFrame, 0, timeline:getDurationFrames())
	end

	local offset = targetFrame - sourceFrame
	local success, message = timeline:moveTrackKeyframes(keyRefs, offset)
	return success, message, targetFrame
end

function editorActions.getFadeClipForFrame(track, sourceFrame)
	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	if not ScreenEffectTrackService.isFadeTrack(track) then
		return nil
	end
	for _, clip in ipairs(ScreenEffectTrackService.getFadeClipDataForTrack(timeline, track)) do
		if math.floor(tonumber(clip.frame) or -1) == sourceFrame then
			return clip
		end
	end
	return nil
end

function editorActions.moveFadeClipToFrame(track, sourceFrame, targetFrame)
	sourceFrame = math.max(0, math.floor(tonumber(sourceFrame) or 0))
	targetFrame = math.max(0, math.floor(tonumber(targetFrame) or 0))

	local clipToMove = editorActions.getFadeClipForFrame(track, sourceFrame)
	if not clipToMove then
		local success, message = timeline:moveTrackKeyframe(track.path, sourceFrame, targetFrame)
		return success, message, targetFrame
	end

	local keyRefs = {
		{
			jointPath = track.path,
			frame = sourceFrame,
		},
	}
	local endFrame = math.floor(tonumber(clipToMove.endFrame) or sourceFrame)
	if clipToMove.hasExplicitEnd == true and timeline:hasTrackKeyframe(track.path, endFrame) then
		local duration = math.max(1, endFrame - sourceFrame)
		targetFrame = math.clamp(targetFrame, 0, math.max(0, timeline:getDurationFrames() - duration))
		keyRefs[#keyRefs + 1] = {
			jointPath = track.path,
			frame = endFrame,
		}
	else
		targetFrame = math.clamp(targetFrame, 0, timeline:getDurationFrames())
	end

	local offset = targetFrame - sourceFrame
	local success, message = timeline:moveTrackKeyframes(keyRefs, offset)
	return success, message, targetFrame
end

local function moveKeyToFrame(jointPath, sourceFrame, targetFrame)
	local selectedKeyRefs = getSelectedKeyRefs()
	local success, message
	if #selectedKeyRefs &gt; 1 and selectedKeys[SelectionState.makeTrackKeyId(jointPath, sourceFrame)] then
		local offset = math.floor(targetFrame) - math.floor(sourceFrame)
		pushUndo("Move Keyframes")
			success, message = timeline:moveTrackKeyframes(selectedKeyRefs, offset)
			if success then
				local newSelected, movedKeys = require(Modules:WaitForChild("KeyframeSelectionRebuildSupport")).buildMovedSelection(
					selectedKeyRefs,
					offset,
					timeline:getDurationFrames()
				)
				remapGroupsAfterMove(selectedKeyRefs, movedKeys)
				selectedKeys = newSelected
				selectedKeyframeFrame = math.max(0, math.min(timeline:getDurationFrames(), math.floor(targetFrame)))
				selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
			end
	else
		local track = timeline:getTrackByPath(jointPath)
		local isSubtitleTrack = ScreenEffectTrackService.isSubtitleTrack(track)
		local isFadeTrack = ScreenEffectTrackService.isFadeTrack(track)
		pushUndo(isSubtitleTrack and "Move Subtitle Clip" or (isFadeTrack and "Move Fade Clip" or "Move Keyframe"))
		if isSubtitleTrack then
			success, message, targetFrame = editorActions.moveSubtitleClipToFrame(track, sourceFrame, targetFrame)
		elseif isFadeTrack then
			success, message, targetFrame = editorActions.moveFadeClipToFrame(track, sourceFrame, targetFrame)
		else
			success, message = timeline:moveTrackKeyframe(jointPath, sourceFrame, targetFrame)
		end
		if success then
			setSingleSelectedKey(jointPath, math.max(0, math.min(timeline:getDurationFrames(), math.floor(targetFrame))))
		end
	end
	if not success then
		historyService:discardPendingUndo()
	end
	if success then
		timeline:setCurrentFrame(selectedKeyframeFrame)
		timeline:applyCurrentFrame()
	end
	refreshUi(message)
end

editorActions.moveKeyToFrame = moveKeyToFrame

local function moveSelectedKeysByOffset(offset)
	offset = math.floor(tonumber(offset) or 0)
	local selectedKeyRefs = getSelectedKeyRefs()
	if #selectedKeyRefs == 0 then
		refreshUi("Select keyframes first.")
		return false, "Select keyframes first."
	end
	if offset == 0 then
		return true, "Keyframes unchanged."
	end

	pushUndo("Move Keyframes")
	local success, message = timeline:moveTrackKeyframes(selectedKeyRefs, offset)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message)
		return false, message
	end

	local newSelected, movedKeys = require(Modules:WaitForChild("KeyframeSelectionRebuildSupport")).buildMovedSelection(
		selectedKeyRefs,
		offset,
		timeline:getDurationFrames()
	)
	remapGroupsAfterMove(selectedKeyRefs, movedKeys)
	selectedKeys = newSelected
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	local selectedFrames = getSelectedKeyframeFrames()
	selectedKeyframeFrame = selectedFrames[#selectedFrames]
	if selectedKeyframeFrame then
		timeline:setCurrentFrame(selectedKeyframeFrame)
		timeline:applyCurrentFrame()
	end
	refreshUi(message)
	return true, message
end

editorActions.moveSelectedKeysByOffset = moveSelectedKeysByOffset

local function moveKeyRefsByOffset(keyRefs, offset)
	if type(keyRefs) ~= "table" or #keyRefs == 0 then
		refreshUi("Select keyframes first.")
		return false, "Select keyframes first."
	end
	offset = math.floor(tonumber(offset) or 0)
	if offset == 0 then
		return true, "Keyframes unchanged."
	end

	pushUndo("Move Keyframes")
	local success, message = timeline:moveTrackKeyframes(keyRefs, offset)
	if not success then
		historyService:discardPendingUndo()
		refreshUi(message)
		return false, message
	end

	local newSelected, movedKeys = require(Modules:WaitForChild("KeyframeSelectionRebuildSupport")).buildMovedSelection(
		keyRefs,
		offset,
		timeline:getDurationFrames()
	)
	remapGroupsAfterMove(keyRefs, movedKeys)
	selectedKeys = newSelected
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	local selectedFrames = getSelectedKeyframeFrames()
	selectedKeyframeFrame = selectedFrames[#selectedFrames]
	if selectedKeyframeFrame then
		timeline:setCurrentFrame(selectedKeyframeFrame)
		timeline:applyCurrentFrame()
	end
	refreshUi(message)
	return true, message
end

editorActions.moveKeyRefsByOffset = moveKeyRefsByOffset

function editorActions.includeSubtitleClipEndKeys(keyRefs)
	local expanded = {}
	local seen = {}
	local function addKey(path, frame)
		local id = SelectionState.makeTrackKeyId(path, frame)
		if not seen[id] then
			seen[id] = true
			expanded[#expanded + 1] = {
				jointPath = path,
				frame = frame,
			}
		end
	end
	for _, key in ipairs(keyRefs or {}) do
		local path = key.jointPath or key.path
		local frame = math.max(0, math.floor(tonumber(key.frame) or 0))
		if path then
			addKey(path, frame)
			local track = timeline:getTrackByPath(path)
			if ScreenEffectTrackService.isSubtitleTrack(track) then
				for _, clip in ipairs(ScreenEffectTrackService.getSubtitleClipDataForTrack(timeline, track)) do
					if clip.hasExplicitEnd == true and math.floor(tonumber(clip.frame) or -1) == frame then
						addKey(path, math.floor(tonumber(clip.endFrame) or frame))
						break
					end
				end
			elseif ScreenEffectTrackService.isFadeTrack(track) then
				for _, clip in ipairs(ScreenEffectTrackService.getFadeClipDataForTrack(timeline, track)) do
					if clip.hasExplicitEnd == true and math.floor(tonumber(clip.frame) or -1) == frame then
						addKey(path, math.floor(tonumber(clip.endFrame) or frame))
						break
					end
				end
			end
		end
	end
	return expanded
end

local function copySelectedKeys()
	local selectedKeyRefs = editorActions.includeSubtitleClipEndKeys(getSelectedKeyRefs())
	local success, message = keyframeEditService:copySelectedKeys(timeline, selectedKeyRefs)
	refreshUi(message)
	return success, message
end

local function cutSelectedKeys()
	local selectedKeyRefs = getSelectedKeyRefs()
	if #selectedKeyRefs == 0 then
		refreshUi("Select keyframes before cutting.")
		return
	end

	pushUndo("Cut Keyframes")
	local success, message = keyframeEditService:cutSelectedKeys(timeline, selectedKeyRefs)
	if success then
		clearSelectedKeyframes()
		local restoredEmptyTimeline, restoredCount = restoreOriginalStateIfTimelineEmpty("Cut Keyframes")
		if restoredEmptyTimeline then
			message = tostring(message or "Cut keyframes.") .. string.format(" Restored %d track%s to the original pose because the timeline has no keyframes.", restoredCount, restoredCount == 1 and "" or "s")
		else
			timeline:applyCurrentFrame()
			local restoredTrackCount = timeline:restoreEmptyTrackOriginalStates(selectedKeyRefs)
			if restoredTrackCount &gt; 0 then
				message = tostring(message or "Cut keyframes.") .. string.format(
					" Restored %d empty track%s to the starting pose.",
					restoredTrackCount,
					restoredTrackCount == 1 and "" or "s"
				)
			end
		end
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

local function pasteKeysAtPlayhead()
	pushUndo("Paste Keyframes")
	local targetFrame = timeline:getCurrentFrame()
	local success, message, pastedKeys = keyframeEditService:pasteKeysAtPlayhead(timeline, getSelectedTrackPaths())
	if success then
		clearSelectedKeyframes()
		selectedKeys = require(Modules:WaitForChild("KeyframeSelectionRebuildSupport")).buildPastedSelection(pastedKeys)
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
		local selectedFrames = getSelectedKeyframeFrames()
		selectedKeyframeFrame = selectedFrames[#selectedFrames]
		timeline:setCurrentFrame(targetFrame)
		timeline:applyCurrentFrame()
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

local function selectAllKeys(scopeMode)
	clearSelectedKeyframes()
	local selectedCount, scopedToTracks
	local selectedScope = nil
	local selectedPathCount = 0
	if scopeMode ~= "timeline" then
		local selectedPaths = getSelectedTrackPaths()
		selectedPathCount = #selectedPaths
		selectedScope = require(Modules:WaitForChild("KeyframeSelectionRebuildSupport")).buildSelectedScope(selectedPaths)
	end
	selectedKeys, selectedCount, scopedToTracks = keyframeEditService:buildSelectAllKeys(timeline, selectedScope)
	selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
	local selectedFrames = getSelectedKeyframeFrames()
	selectedKeyframeFrame = selectedFrames[#selectedFrames]
	if scopedToTracks then
		refreshUi(string.format("Selected %d keyframes on selected track(s).", selectedCount))
	else
		refreshUi(string.format("Selected all %d keyframes.", selectedCount))
	end
end

local function groupSelectedKeys()
	local selectedKeyRefs = getSelectedKeyRefs()
	pushUndo("Group Keyframes")
	local success, message, groupId = keyframeEditService:groupSelectedKeys(selectedKeyRefs)
	if success then
		removeDeletedKeysFromGroups()
		rebuildGroupMembership()
		widgetController:invalidateTimelineRenderCache()
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message, groupId
end

local function ungroupSelectedKeys()
	pushUndo("Ungroup Keyframes")
	local success, message = keyframeEditService:ungroupSelectedKeys(selectedKeys)
	if success then
		rebuildGroupMembership()
		widgetController:invalidateTimelineRenderCache()
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

local function setSelectedGroupEditMode(mode, explicitGroupIds)
	local groupIds = type(explicitGroupIds) == "table" and #explicitGroupIds &gt; 0 and explicitGroupIds or getSelectedGroupIds()
	pushUndo("Set Group Timing Mode")
	local success, message = require(Modules:WaitForChild("KeyframeGroupTimingService")).setGroupMode(keyframeEditService, groupIds, mode)
	if success then
		widgetController:invalidateTimelineRenderCache()
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

local function applyGroupTimingEdit(groupId, targetEndFrame, mode)
	local service = require(Modules:WaitForChild("KeyframeGroupTimingService"))
	pushUndo(mode == "Repeat" and "Repeat Keyframe Group" or "Stretch Keyframe Group")
	ChangeHistoryService:SetWaypoint("Before Group Timing Edit")
	local action = mode == "Repeat" and service.repeatGroupToFrame or service.stretchGroupToFrame
	local success, message, changedRefs = action(timeline, keyframeEditService, groupId, targetEndFrame)
	if success then
		widgetController:invalidateTimelineRenderCache()
		if type(changedRefs) == "table" and #changedRefs &gt; 0 then
			selectKeys(changedRefs)
		end
		timeline:applyCurrentFrame()
		ChangeHistoryService:SetWaypoint("After Group Timing Edit")
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

local function stretchGroupToFrame(groupId, targetEndFrame)
	return applyGroupTimingEdit(groupId, targetEndFrame, "Stretch")
end

local function repeatGroupToFrame(groupId, targetEndFrame)
	return applyGroupTimingEdit(groupId, targetEndFrame, "Repeat")
end

function editorActions.editSelectedGroupsAtPlayhead(actionName, groupIdsOverride)
	local groupIds = type(groupIdsOverride) == "table" and groupIdsOverride or getSelectedGroupIds()
	local service = require(Modules:WaitForChild("KeyframeGroupTimingService"))
	local undoLabel = actionName == "Split" and "Split Physics Clip" or "Trim Physics Clip"
	pushUndo(undoLabel)
	ChangeHistoryService:SetWaypoint("Before " .. undoLabel)
	local success, message, changedRefs
	if actionName == "Split" then
		success, message, changedRefs = service.splitGroupAtPlayhead(
			timeline,
			keyframeEditService,
			groupIds,
			timeline:getCurrentFrame()
		)
	else
		success, message, changedRefs = service.trimGroupsAtPlayhead(
			timeline,
			keyframeEditService,
			groupIds,
			timeline:getCurrentFrame(),
			actionName
		)
	end
	if success then
		widgetController:invalidateTimelineRenderCache()
		if type(changedRefs) == "table" and #changedRefs &gt; 0 then
			selectKeys(changedRefs)
		end
		timeline:applyCurrentFrame()
		ChangeHistoryService:SetWaypoint("After " .. undoLabel)
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

function editorActions.reverseSelectedGroups(groupIdsOverride)
	local groupIds = type(groupIdsOverride) == "table" and #groupIdsOverride &gt; 0
		and groupIdsOverride
		or getSelectedGroupIds()
	local keyRefs = {}
	local keyRefsByGroupId = {}
	local seen = {}
	local reverseMinFrame = math.huge
	local reverseMaxFrame = -math.huge
	for _, requestedGroupId in ipairs(groupIds) do
		local groupId = tonumber(requestedGroupId) or requestedGroupId
		local groupKeyRefs = getKeyRefsForGroup(groupId)
		if #groupKeyRefs &gt; 0 then
			keyRefsByGroupId[groupId] = groupKeyRefs
		end
		for _, key in ipairs(groupKeyRefs) do
			reverseMinFrame = math.min(reverseMinFrame, key.frame)
			reverseMaxFrame = math.max(reverseMaxFrame, key.frame)
			local keyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame)
			if not seen[keyId] then
				seen[keyId] = true
				table.insert(keyRefs, key)
			end
		end
	end
	if #keyRefs &lt; 2 then
		local message = "Reverse needs a selected CFrame group with keys on at least two frames."
		refreshUi(message)
		return false, message
	end

	pushUndo("Reverse CFrame Group")
	ChangeHistoryService:SetWaypoint("Before Reverse CFrame Group")
	local success, message, changedKeys = AnimationEffectsService.apply(timeline, keyRefs, "Reverse")
	if success then
		-- Reverse mirrors keyframe times. Keep every group's saved membership in
		-- step with those new times so a later Stretch edits the whole block.
		-- Without this remap, only keys whose mirrored frame already existed stay
		-- grouped after reload, producing a normal-speed start and a slow tail.
		local groups = keyframeEditService:getGroups()
		for groupId, originalRefs in pairs(keyRefsByGroupId) do
			local group = groups[groupId]
			if group then
				local remappedKeys = {}
				for _, key in ipairs(originalRefs) do
					local targetFrame = reverseMinFrame + reverseMaxFrame - key.frame
					remappedKeys[SelectionState.makeTrackKeyId(key.jointPath, targetFrame)] = true
				end
				group.keys = remappedKeys
				if group.mode == "Repeat" then
					group.mode = "Stretch"
					group.repeatSourceKeys = nil
					group.repeatSourceSpanFrames = nil
					group.sourceSpanFrames = math.max(1, reverseMaxFrame - reverseMinFrame)
				end
			end
		end
		keyframeEditService:rebuildGroupMembership()

		-- Physics Clips can use their exact captured runtime samples instead of
		-- their editable timeline keys. Once Reverse changes those key values, the
		-- original capture must no longer override them during scrub or playback.
		for _, requestedGroupId in ipairs(groupIds) do
			local group = groups[tonumber(requestedGroupId) or requestedGroupId]
			if group and group.kind == "PhysicsClip" then
				group.runtimeCapture = nil
				group.runtimeKeyCount = nil
				group.runtimeKeySignature = nil
				group.runtimeCaptureValid = nil
			end
		end
		selectKeys(changedKeys)
		timeline:applyCurrentFrame()
		widgetController:invalidateTimelineRenderCache()
		ChangeHistoryService:SetWaypoint("After Reverse CFrame Group")
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end

editorActions.copySelectedKeys = copySelectedKeys
editorActions.cutSelectedKeys = cutSelectedKeys
editorActions.pasteKeysAtPlayhead = pasteKeysAtPlayhead
function editorActions.pastePhysicsClipToSelectedRigs()
	pushUndo("Paste Physics Clip To Selected Rigs")
	ChangeHistoryService:SetWaypoint("Before Paste Physics Clip To Selected Rigs")
	local success, message, pastedKeys = keyframeEditService:pastePhysicsClipToSelectedRigs(
		timeline,
		SelectionService.getSelection()
	)
	if success then
		clearSelectedKeyframes()
		selectedKeys = require(Modules:WaitForChild("KeyframeSelectionRebuildSupport")).buildPastedSelection(pastedKeys)
		selectedTrackPaths, selectedJointPath = require(Modules:WaitForChild("SelectedKeyTrackSyncSupport")).sync(timeline, selectedKeys, selectedJointPath)
		local selectedFrames = getSelectedKeyframeFrames()
		selectedKeyframeFrame = selectedFrames[#selectedFrames]
		timeline:applyCurrentFrame()
		widgetController:invalidateTimelineRenderCache()
		ChangeHistoryService:SetWaypoint("After Paste Physics Clip To Selected Rigs")
	else
		historyService:discardPendingUndo()
	end
	refreshUi(message)
	return success, message
end
editorActions.selectAllKeys = selectAllKeys
editorActions.groupSelectedKeys = groupSelectedKeys
editorActions.ungroupSelectedKeys = ungroupSelectedKeys
editorActions.setSelectedGroupEditMode = setSelectedGroupEditMode
editorActions.stretchGroupToFrame = stretchGroupToFrame
editorActions.repeatGroupToFrame = repeatGroupToFrame
editorActions.deleteCurrentFrame = deleteCurrentFrame

function getGroupSaveData()
	return keyframeEditService:getGroupSaveData(timeline)
end

function getMotionBuilderSaveData()
	return motionBuilderState:captureRecipe({
		rigType = getBoundRigTypeName() or "R15",
	})
end

function getEffectsSaveData()
	local effects = effectsService:getSaveData()
	for _, track in ipairs(timeline:getTracks()) do
		if ScreenEffectTrackService.isSubtitleTrack(track) then
			if type(effects.screen) == "table" and type(effects.screen.enabled) == "table" then
				effects.screen.enabled.Subtitle = nil
				effects.screen.subtitleText = ""
			end
			break
		end
	end
	return effects
end

local function saveAnimation()
	local success, message = SaveExportService.saveAnimation(timeline, BuildInfo, buildSaveExtra())
	if success then
		autoSaveState.savedToken = autoSaveState.changeToken
		autoSaveState.nextSaveClock = os.clock() + autoSaveState.intervalSeconds
		autoSaveState.lastSavedText = os.date("%H:%M")
		autoSaveState.lastErrorText = nil
	end
	refreshUi(message)
	return success, message
end

local function newAnimationFile()
	stopPlayback("Starting new animation.", 0)
	require(Modules:WaitForChild("ViewportToolCleanupService")).clear({
		editorActions = editorActions,
		gizmoController = gizmoController,
		modules = Modules,
	})
	pushUndo("New Animation")
	ChangeHistoryService:SetWaypoint("Before New Animation")
	pcall(function()
		local service = require(Modules:WaitForChild("AttachService"))
		if service and type(service.clearRuntimeAttachments) == "function" then
			service.clearRuntimeAttachments()
		end
	end)
	timeline:resetOriginalState()
	RigWorkspaceLockService.unlockTimelineRigs(timeline)
	clearMotionMarkers()
	effectsService:restoreSaveData({
		screen = {
			enabled = {},
			subtitleText = "",
			viewerEnabled = false,
		},
	})
	widgetController._facesController:clearTimelineData()
	selectedMotionRecipeName = nil
	timeline:reset(PluginSettings.getPreferredFps(plugin), Constants.DEFAULT_DURATION_FRAMES)
	clearSelectedKeyframes()
	clearSelectedTracks()
	keyframeEditService:resetGroups()
	importActionStatus = "Ready to import."
	timeline:applyCurrentFrame()
	renderScreenEffects(0)
	ChangeHistoryService:SetWaypoint("After New Animation")
	refreshUi("Started a new blank animation. Save first next time if you want to keep the previous timeline.")
end
editorActions.clearProjectForMicroClose = newAnimationFile

local function saveAndNewAnimationFile()
	local success = saveAnimation()
	if success then
		newAnimationFile()
	end
end

local function selectTheme(themeId)
	local success, message = ThemeService.saveTheme(plugin, themeId)
	refreshUi(message)
	return success, message
end

local function autoSaveAnimation()
	local success, message = SaveExportService.saveAutoSave(timeline, BuildInfo, buildSaveExtra())
	if success then
		autoSaveState.savedToken = autoSaveState.changeToken
		autoSaveState.nextSaveClock = os.clock() + autoSaveState.intervalSeconds
		autoSaveState.lastSavedText = os.date("%H:%M")
		autoSaveState.lastErrorText = nil
		refreshUi()
	else
		autoSaveState.lastErrorText = tostring(message or "Autosave failed.")
		warn("[7kg2 Animator] " .. autoSaveState.lastErrorText)
		refreshUi()
	end
	return success, message
end

local function loadSavedGroups(extra, pathMap, options)
	keyframeEditService:loadSavedGroups(extra, pathMap, options, timeline)
	local restoredPhysicsClipCount = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).ensurePhysicsClips(
		timeline,
		keyframeEditService
	)
	if restoredPhysicsClipCount &gt; 0 then
		widgetController:invalidateTimelineRenderCache()
	end
end

local function loadSavedMotionBuilder(extra, _, options)
	local recipe = type(extra) == "table" and extra.motionBuilder or nil
	if type(recipe) ~= "table" then
		if type(options) == "table" and options.reset == true then
			motionBuilderState:resetSegments()
			clearMotionMarkersSilently()
			selectedMotionRecipeName = nil
		end
		return
	end

	motionBuilderState:restoreRecipe(motionServiceDeps(), recipe)
	selectedMotionRecipeName = nil
end

local function loadSavedEffects(extra, _, options)
	local effects = type(extra) == "table" and extra.effects or nil
	if type(effects) ~= "table" then
		if type(options) == "table" and options.reset == true then
			effectsService:restoreSaveData({
				screen = {
					enabled = {},
					subtitleText = "",
					viewerEnabled = false,
				},
			})
		end
		return
	end

	local effectsToRestore = effects
	local hasTimelineSubtitle = false
	for _, track in ipairs(timeline:getTracks()) do
		if ScreenEffectTrackService.isSubtitleTrack(track) then
			hasTimelineSubtitle = true
			break
		end
	end
	if hasTimelineSubtitle and type(effects.screen) == "table" and type(effects.screen.enabled) == "table" then
		effectsToRestore = {}
		for key, value in pairs(effects) do
			effectsToRestore[key] = value
		end
		effectsToRestore.screen = {}
		for key, value in pairs(effects.screen) do
			effectsToRestore.screen[key] = value
		end
		effectsToRestore.screen.enabled = {}
		for key, value in pairs(effects.screen.enabled) do
			if key ~= "Subtitle" then
				effectsToRestore.screen.enabled[key] = value
			end
		end
		effectsToRestore.screen.subtitleText = ""
	end

	effectsService:restoreSaveData(effectsToRestore)
end

widgetController._loadSavedFaces = function(extra, _, options)
	local faces = type(extra) == "table" and extra.faces or nil
	if type(faces) ~= "table" then
		if type(options) == "table" and options.reset == true then
			widgetController._facesController:clearTimelineData()
		end
		return
	end

	widgetController._facesController:restoreSaveData(faces)
end

editorActions._makeSavedProjectLoadDependencies = function(singleRigTarget)
	return {
		timeline = timeline,
		rigService = RigService,
		singleRigTarget = singleRigTarget,
		pushUndo = pushUndo,
		discardPendingUndo = function()
			historyService:discardPendingUndo()
		end,
		clearSelectedKeyframes = clearSelectedKeyframes,
		clearSelectedTracks = clearSelectedTracks,
		selectTrack = function(path)
			selectedJointPath = path
			selectedTrackPaths[path] = true
		end,
		loadSavedGroups = loadSavedGroups,
		loadMotionBuilderRecipe = loadSavedMotionBuilder,
		loadEffects = loadSavedEffects,
		loadFaces = widgetController._loadSavedFaces,
		clearRuntimeAttachments = function()
			local ok, service = pcall(require, Modules:WaitForChild("AttachService"))
			if ok and service then
				if type(service.restoreOriginalAttachmentObjects) == "function" then
					service.restoreOriginalAttachmentObjects(timeline)
				elseif type(service.clearRuntimeAttachments) == "function" then
					service.clearRuntimeAttachments()
				end
			end
		end,
		prepareAttachments = function(frame)
			local ok, service = pcall(require, Modules:WaitForChild("AttachService"))
			if ok and service and type(service.prepareTimelineState) == "function" then
				service.prepareTimelineState(timeline, frame or timeline:getCurrentFrame())
			end
		end,
		applyAttachments = function(frame)
			local ok, service = pcall(require, Modules:WaitForChild("AttachService"))
			if ok and service and type(service.applyTimelineState) == "function" then
				service.applyTimelineState(timeline, frame or timeline:getCurrentFrame())
			end
		end,
		renderEffects = renderScreenEffects,
	}
end

editorActions._runSavedProjectLoad = function(loader, singleRigTarget)
	RigWorkspaceLockService.unlockTimelineRigs(timeline)
	restoreOriginalWorkspaceState("Before Open Saved Project")
	local handled, message = loader(editorActions._makeSavedProjectLoadDependencies(singleRigTarget))
	RigWorkspaceLockService.syncFromSelection(timeline, selectedJointPath, selectedTrackPaths, selectedKeys, SelectionState)
	refreshUi(message)
	if handled and type(widgetController.stabilizeTimelineAfterProjectLoad) == "function" then
		widgetController:stabilizeTimelineAfterProjectLoad()
	end
	return handled, message
end

local function loadSavedProjectValue(value)
	local handled = editorActions._runSavedProjectLoad(function(deps)
		return SaveExportService.loadSavedProjectValue(value, deps)
	end)
	return handled
end

local function openSavedProjectByName(saveName)
	local handled = editorActions._runSavedProjectLoad(function(deps)
		return SaveExportService.openSavedProjectByName(saveName, deps)
	end)
	return handled
end

editorActions._showSavedProjectRigImportNotice = function(parent, title, message)
	local prompt = require(Modules:WaitForChild("UI"):WaitForChild("SavedProjectRigImportPrompt"))
	return prompt.show(parent or widgetController._root, {
		title = title,
		message = message,
	})
end

editorActions._getSelectedTimelineRigs = function()
	local rigs = {}
	local seen = {}
	local function addTrackRig(path)
		if type(path) ~= "string" or path == "" then
			return
		end
		local track = timeline:getTrackByPath(path)
		local rig = track and track.rig or nil
		if not rig and track and type(track.rigName) == "string" then
			rig = timeline:getRigByName(track.rigName)
		end
		if rig and rig.Parent and not seen[rig] then
			seen[rig] = true
			table.insert(rigs, rig)
		end
	end
	for path, isSelected in pairs(selectedTrackPaths) do
		if isSelected then
			addTrackRig(path)
		end
	end
	addTrackRig(selectedJointPath)
	return rigs
end

editorActions.importSavedProjectOntoSelectedRig = function(saveName, promptParent, onImported)
	local selectedRigs = SelectionService.getSelectedRigs()
	if #selectedRigs == 0 then
		selectedRigs = editorActions._getSelectedTimelineRigs()
	end
	if #selectedRigs == 0 then
		editorActions._showSavedProjectRigImportNotice(
			promptParent,
			"Select a rig first",
			"Select one rig in the Studio viewport or Explorer, or select its Rig track in 7kg2, then choose Import onto Selected Rig again."
		)
		return false, "Select one workspace rig first."
	end
	if #selectedRigs &gt; 1 then
		editorActions._showSavedProjectRigImportNotice(
			promptParent,
			"Select one rig",
			"More than one rig is selected. Select only the rig that should receive this saved animation, then try again."
		)
		return false, "Select only one workspace rig."
	end

	local targetRig = selectedRigs[1]
	local inspection, inspectionMessage = SaveExportService.inspectSavedProjectRigTarget(saveName, targetRig, {
		rigService = RigService,
	})
	if not inspection then
		editorActions._showSavedProjectRigImportNotice(promptParent, "Cannot map this project", inspectionMessage)
		return false, inspectionMessage
	end
	if not inspection.compatible then
		local firstMissing = inspection.unmatchedPaths[1]
		local details = firstMissing and (" First missing joint: " .. firstMissing .. ".") or ""
		local message = string.format(
			"'%s' matches %d of %d saved joints. Choose a rig with the same structure.%s",
			inspection.targetRigName,
			inspection.matchedJointCount,
			inspection.savedJointCount,
			details
		)
		editorActions._showSavedProjectRigImportNotice(promptParent, "Rig structure does not match", message)
		return false, message
	end

	local prompt = require(Modules:WaitForChild("UI"):WaitForChild("SavedProjectRigImportPrompt"))
	return prompt.show(promptParent or widgetController._root, {
		title = "Import onto selected rig",
		sourceRigName = inspection.sourceRigName,
		targetRigName = inspection.targetRigName,
		compatibilityText = string.format(
			"Compatible: %d of %d saved joints matched",
			inspection.matchedJointCount,
			inspection.savedJointCount
		),
		message = "This opens the saved project and replaces the current timeline, just like Open Project. The rig animation will be mapped onto the selected workspace rig.",
		confirmText = "Open on Selected Rig",
		onConfirm = function()
			local handled, message = editorActions._runSavedProjectLoad(function(deps)
				return SaveExportService.openSavedProjectByName(saveName, deps)
			end, targetRig)
			if handled and type(onImported) == "function" then
				pcall(onImported)
			end
			return handled, message
		end,
	})
end

local function exportAnimation(promptParent)
	local function performExport(options)
		options = options or {}
		local success, message = SaveExportService.exportAnimation({
			timeline = timeline,
			buildInfo = BuildInfo,
			plugin = plugin,
			selectionService = SelectionService,
			sortFrames = SelectionState.sortFrames,
			targetRig = options.targetRig,
			exportAllRigs = options.exportAllRigs,
		})
		refreshUi(message)
		return success, message
	end
	local warningPrompt = require(Modules:WaitForChild("UI"):WaitForChild("AnimationExportCameraWarningPrompt"))
	local cameraData = warningPrompt.getCameraDataSummary(timeline)
	local rigSummary = SaveExportService.getRigExportSummary(timeline, SelectionState.sortFrames)
	if rigSummary.rigCount &gt; 1 then
		local targetRig = nil
		local selectedRigs = SelectionService.getSelectedRigs()
		if #selectedRigs ~= 1 then
			selectedRigs = editorActions._getSelectedTimelineRigs()
		end
		if #selectedRigs == 1 then
			for _, rigData in ipairs(rigSummary.rigs) do
				if rigData.rig == selectedRigs[1] then
					targetRig = rigData.rig
					break
				end
			end
		end
		if not targetRig then
			local activeRig = timeline:getRig()
			for _, rigData in ipairs(rigSummary.rigs) do
				if rigData.rig == activeRig then
					targetRig = rigData.rig
					break
				end
			end
		end
		targetRig = targetRig or rigSummary.rigs[1].rig

		local multiRigPrompt = require(Modules:WaitForChild("UI"):WaitForChild("AnimationExportMultiRigPrompt"))
		local shown = multiRigPrompt.show(promptParent or widgetController._root, {
			rigCount = rigSummary.rigCount,
			targetRigName = targetRig.Name,
			hasCameraData = cameraData.hasData,
			onExportOne = function()
				return performExport({ targetRig = targetRig })
			end,
			onExportAll = function()
				return performExport({ exportAllRigs = true })
			end,
		})
		if shown then
			local message = "Multi-rig export choices opened. Export one rig or export each rig separately."
			refreshUi(message)
			return true, message
		end
	end
	if cameraData.hasData then
		local shown = warningPrompt.show(promptParent or widgetController._root, {
			trackCount = cameraData.trackCount,
			keyCount = cameraData.keyCount,
			onConfirm = function()
				return performExport({
					targetRig = rigSummary.rigs[1] and rigSummary.rigs[1].rig or nil,
				})
			end,
		})
		if shown then
			local message = "Camera export warning opened. Choose Export Rig Only or use Cutscene Exporter."
			refreshUi(message)
			return true, message
		end
	end
	return performExport({
		targetRig = rigSummary.rigs[1] and rigSummary.rigs[1].rig or nil,
	})
end

local function importKeyframeSequence(keyframeSequence, sourceLabel, targetRigNameOverride, physicsObjectsOverride, importFrameOverride, physicsVFXOverride, physicsRuntimeCaptureOverride)
	if keyframeSequence == nil and (type(physicsObjectsOverride) == "table" or type(physicsVFXOverride) == "table") then
		pushUndo("Import Physics Objects")
		ChangeHistoryService:SetWaypoint("Before Import Physics Objects")
		local importFrame = math.max(0, math.floor(tonumber(importFrameOverride) or tonumber(timeline:getCurrentFrame()) or 0))
		local success, message, physicsClip = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).importObjectCapture(
			timeline,
			physicsObjectsOverride,
			{
				frameOffset = importFrame,
				physicsVFX = physicsVFXOverride,
			}
		)
		if not success then
			ChangeHistoryService:SetWaypoint("After Import Physics Objects")
			importActionStatus = message
			refreshUi(message)
			return false, message
		end
		local clipCreated, clipMessage = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).createPhysicsClip(
			keyframeEditService,
			physicsClip,
			timeline
		)
		if not clipCreated then
			local restoredCount, restoredMessage = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).ensurePhysicsClips(
				timeline,
				keyframeEditService
			)
			clipCreated = restoredCount &gt; 0
			clipMessage = restoredMessage
		end
		if clipCreated then
			message = string.format("%s %s", message or "Imported physics objects.", clipMessage)
			widgetController:invalidateTimelineRenderCache()
		end
		ChangeHistoryService:SetWaypoint("After Import Physics Objects")
		clearSelectedKeyframes()
		clearSelectedTracks()
		selectedJointPath = nil
		selectedTrackPaths = {}
		importActionStatus = message or string.format("Imported physics objects from %s at frame %d.", sourceLabel or "capture", importFrame)
		refreshUi(importActionStatus)
		return true, importActionStatus
	end
	if not timeline:getRig() then
		importActionStatus = "Bind the rig you want to import onto, then try again."
		refreshUi(importActionStatus)
		return false, importActionStatus
	end

	if not keyframeSequence or not keyframeSequence:IsA("KeyframeSequence") then
		importActionStatus = "This importer currently supports KeyframeSequence animations. CurveAnimation support can come next."
		refreshUi(importActionStatus)
		return false, importActionStatus
	end

	pushUndo("Import Animation")
	ChangeHistoryService:SetWaypoint("Before Import Animation")
	local targetRigName = targetRigNameOverride or editorActions.getImportTargetRigName()
	local importFrame = math.max(0, math.floor(tonumber(importFrameOverride) or tonumber(timeline:getCurrentFrame()) or 0))
	local success, message, physicsClip = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).importKeyframeSequence(timeline, keyframeSequence, {
		frameOffset = importFrame,
		physicsObjects = physicsObjectsOverride,
		physicsVFX = physicsVFXOverride,
		runtimeCapture = physicsRuntimeCaptureOverride,
		rigName = targetRigName,
	})
	ChangeHistoryService:SetWaypoint("After Import Animation")
	if not success then
		importActionStatus = require(Modules:WaitForChild("ImportFinalizeSupport")).handleImportFailure(
			historyService,
			message,
			"Import"
		)
		refreshUi(message)
		return false, message
	end

	clearSelectedKeyframes()
	clearSelectedTracks()
	selectedJointPath, selectedTrackPaths = require(Modules:WaitForChild("ImportFinalizeSupport")).finalizeImport(
		timeline,
		targetRigName,
		keyframeEditService,
		rebuildGroupMembership,
		widgetController
	)
	local clipCreated, clipMessage = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).createPhysicsClip(
		keyframeEditService,
		physicsClip,
		timeline
	)
	if not clipCreated then
		local restoredCount, restoredMessage = require(Modules:WaitForChild("PhysicsCaptureImportSupport")).ensurePhysicsClips(
			timeline,
			keyframeEditService
		)
		clipCreated = restoredCount &gt; 0
		clipMessage = restoredMessage
	end
	if clipCreated then
		message = string.format("%s %s", message or "Imported physics take.", clipMessage)
		widgetController:invalidateTimelineRenderCache()
	end
	importActionStatus = message or string.format("Imported animation from %s at frame %d.", sourceLabel or "selection", importFrame)
	refreshUi(message or string.format("Imported animation from %s at frame %d.", sourceLabel or "selection", importFrame))
	return true, importActionStatus
end

require(Modules:WaitForChild("PhysicsCaptureBridgeService")).attach({
	eventParent = game:GetService("CoreGui"),
	ensureRigsOnTimeline = function(rigs)
		return addSelectedRigs(false, rigs)
	end,
	importKeyframeSequence = importKeyframeSequence,
	timeline = timeline,
	refreshSelectedGizmo = refreshSelectedGizmo,
	refreshUi = refreshUi,
	refreshMicroWorkspace = editorActions._refreshMicroWorkspace,
})

function MegMo_ImportCurveAnimation(curveAnimation, sourceLabel, targetRigNameOverride)
	if not timeline:getRig() then
		importActionStatus = "Bind the rig you want to import onto, then try again."
		refreshUi(importActionStatus)
		return false, importActionStatus
	end

	if not curveAnimation or not curveAnimation:IsA("CurveAnimation") then
		importActionStatus = "This importer expected a CurveAnimation clip."
		refreshUi(importActionStatus)
		return false, importActionStatus
	end

	pushUndo("Import Curve Animation")
	ChangeHistoryService:SetWaypoint("Before Import Curve Animation")
	local targetRigName = targetRigNameOverride or editorActions.getImportTargetRigName()
	local importFrame = math.max(0, math.floor(tonumber(timeline:getCurrentFrame()) or 0))
	local success, message = timeline:importCurveAnimation(curveAnimation, {
		frameOffset = importFrame,
		rigName = targetRigName,
	})
	ChangeHistoryService:SetWaypoint("After Import Curve Animation")
	if not success then
		importActionStatus = require(Modules:WaitForChild("ImportFinalizeSupport")).handleImportFailure(
			historyService,
			message,
			"Curve import"
		)
		refreshUi(message)
		return false, message
	end

	clearSelectedKeyframes()
	clearSelectedTracks()
	selectedJointPath, selectedTrackPaths = require(Modules:WaitForChild("ImportFinalizeSupport")).finalizeImport(
		timeline,
		targetRigName,
		keyframeEditService,
		rebuildGroupMembership,
		widgetController
	)
	importActionStatus = message or string.format("Imported CurveAnimation from %s at frame %d.", sourceLabel or "selection", importFrame)
	refreshUi(importActionStatus)
	return true, importActionStatus
end

function MegMo_ImportClipOverMotionPath(clip, sourceLabel, motionContext)
	if not clip or not motionContext then
		return false, "No locomotion clip was available to layer onto the motion path."
	end

	local importOptions = {
		frameOffset = motionContext.startFrame,
		repeatUntilFrame = motionContext.endFrame,
		preserveMetadata = true,
		rigName = motionContext.rig and motionContext.rig.Name or nil,
	}

	if clip:IsA("KeyframeSequence") then
		local success, message = timeline:importKeyframeSequence(clip, importOptions)
		if success then
			timeline:applyCurrentFrame()
		end
		return success, message
	end
	if clip:IsA("CurveAnimation") then
		local success, message = timeline:importCurveAnimation(clip, importOptions)
		if success then
			timeline:applyCurrentFrame()
		end
		return success, message
	end

	return false, string.format("'%s' could not be layered because %s is not supported.", sourceLabel or clip.Name, clip.ClassName)
end

function MegMo_RunMotionImportAfterGenerate(motionContext, clip, input, locomotionProfile)
	local moveRanges = motionContext.movementRanges or {}
	local holdRanges = motionContext.holdRanges or {}
	local turnRanges = motionContext.turnRanges or {}
	local targetRigName = motionContext.rig and motionContext.rig.Name or nil
	local importedMovementSegments = 0

	for _, moveRange in ipairs(moveRanges) do
		local layeredSuccess, layeredMessage = require(Modules:WaitForChild("MotionImportClipSupport")).importClipInFrameRange(timeline, clip, moveRange.startFrame, moveRange.endFrame, targetRigName)
		if not layeredSuccess then
			return false, layeredMessage
		end
		importedMovementSegments += 1
	end

	for _, holdRange in ipairs(holdRanges) do
		local freezeSuccess, freezeMessage = require(Modules:WaitForChild("MotionFreezePoseSupport")).freezeRigPoseAcrossHold(timeline, holdRange, targetRigName)
		if not freezeSuccess then
			return false, freezeMessage
		end
	end

	for _, turnRange in ipairs(turnRanges) do
		local freezeSuccess, freezeMessage = require(Modules:WaitForChild("MotionFreezePoseSupport")).freezeRigPoseAcrossHold(timeline, turnRange, targetRigName)
		if not freezeSuccess then
			return false, freezeMessage
		end
	end

	timeline:applyCurrentFrame()

	local clipName = clip.Name ~= "" and clip.Name or tostring(input)
	local movementSummary = ""
	if importedMovementSegments &gt; 1 then
		movementSummary = string.format(" across %d movement segments", importedMovementSegments)
	end
	local idleSummary = ""
	if #holdRanges &gt; 0 then
		idleSummary = string.format(" Added %d hold%s on the path.", #holdRanges, #holdRanges == 1 and "" or "s")
	end
	local turnSummary = ""
	if #turnRanges &gt; 0 then
		turnSummary = string.format(" Added %d corner turn%s.", #turnRanges, #turnRanges == 1 and "" or "s")
	end
	if locomotionProfile then
		return true, string.format(
			"Layered '%s'%s using %s speed %.1f studs/s.%s%s",
			clipName,
			movementSummary,
			locomotionProfile.action,
			locomotionProfile.speedStudsPerSecond,
			idleSummary,
			turnSummary
		)
	end

	return true, string.format("Layered '%s'%s.%s%s", clipName, movementSummary, idleSummary, turnSummary)
end

function MegMo_BuildMotionImportOptions(input, clip)
	local entry = ImportService.findImportEntryById(importAnimationEntries, input)
	local locomotionProfile = ImportService.getLocomotionProfile(entry, clip)
	local options = {
		afterGenerate = function(motionContext)
			return MegMo_RunMotionImportAfterGenerate(motionContext, clip, input, locomotionProfile)
		end,
	}

	if locomotionProfile then
		options.speedStudsPerSecond = locomotionProfile.speedStudsPerSecond
	end

	return options
end

createMotionAnimationFromMarkers = function()
	if MotionService.getMotionPreviewState().isPreviewing then
		refreshUi("Stop the Motion Builder preview before building the timeline.")
		return false, "Stop the Motion Builder preview before building the timeline."
	end

	do
		local targetRigName = editorActions.getImportTargetRigName()
		local selectedRig = SelectionService.getSelectedRig and SelectionService.getSelectedRig() or nil
		if selectedRig and selectedRig.Parent and timeline:getRigByName(selectedRig.Name) then
			timeline:setActiveRig(selectedRig.Name)
		elseif selectedRig and selectedRig.Parent and not timeline:getRigByName(selectedRig.Name) then
			local bindSuccess, bindMessage = addSelectedRigs(true)
			if not bindSuccess then
				refreshUi(bindMessage)
				return false, bindMessage
			end
		elseif targetRigName and timeline:getRigByName(targetRigName) then
			timeline:setActiveRig(targetRigName)
		end

		local activeRig = timeline:getRig()
		if not activeRig or not activeRig.Parent then
			local message = "Select or add the rig you want Motion Builder to animate before building."
			refreshUi(message)
			return false, message
		end
	end

	local rigType = getBoundRigTypeName() or "R15"
	local motionOptions = motionBuilderState:getOptions({
		rigType = rigType,
	})
	local motionEntriesBySegment = {}
	local idleEntriesBySegment = {}
	local hasRequestedClip = false
	for _, segment in ipairs(MotionService.listMotionSegments(motionOptions)) do
		local motionEntry, motionMessage = MotionClipService.getSegmentMotionPresetEntry(ImportService, segment, rigType, importAnimationEntries)
		if motionMessage then
			refreshUi(motionMessage)
			return false, motionMessage
		end
		if motionEntry then
			motionEntriesBySegment[tostring(segment.segmentKey)] = motionEntry
			hasRequestedClip = true
		end

		local idleEntry, idleMessage = MotionClipService.getSegmentPauseIdlePresetEntry(ImportService, segment, rigType, importAnimationEntries)
		if idleMessage then
			refreshUi(idleMessage)
			return false, idleMessage
		end
		if idleEntry and (tonumber(segment.pauseAfterSeconds) or 0) &gt; 0 then
			idleEntriesBySegment[tostring(segment.segmentKey)] = idleEntry
			hasRequestedClip = true
		end
	end

	if not hasRequestedClip then
		return MotionService.generateMotionPathFromWorkspaceMarkers(motionServiceDeps(), motionOptions)
	end

	importActionStatus = "Loading selected Motion Builder clips..."
	refreshUi(importActionStatus)

	task.spawn(function()
		local loadedById = {}
		local clipsBySegment = {}
		local idleClipsBySegment = {}

		local function loadEntry(entry, label)
			local key = tostring(entry.id or entry.numericId or label)
			if not loadedById[key] then
				local success, clipDataOrMessage = MotionClipService.loadPresetClip(ImportService, entry, rigType, label)
				if not success then
					return nil, clipDataOrMessage
				end
				loadedById[key] = clipDataOrMessage
			end
			return loadedById[key], nil
		end

		for key, entry in pairs(motionEntriesBySegment) do
			local clipData, loadMessage = loadEntry(entry, tostring(entry.name or "selected motion"))
			if loadMessage then
				importActionStatus = loadMessage
				refreshUi(loadMessage)
				return
			end
			clipsBySegment[key] = clipData
		end
		for key, entry in pairs(idleEntriesBySegment) do
			local clipData, loadMessage = loadEntry(entry, tostring(entry.name or "pause idle"))
			if loadMessage then
				importActionStatus = loadMessage
				refreshUi(loadMessage)
				return
			end
			idleClipsBySegment[key] = clipData
		end

		local options = motionBuilderState:getOptions({
			rigType = rigType,
			afterGenerate = function(motionContext)
				local targetRigName = motionContext.rig and motionContext.rig.Name or nil
				local importedSegments = 0
				local importedIdleHolds = 0
				local usedClips = {}

				for _, moveRange in ipairs(motionContext.movementRanges or {}) do
					local clipData = clipsBySegment[tostring(moveRange.segmentKey or "")]
					if clipData then
						local imported, importMessage = require(Modules:WaitForChild("MotionImportClipSupport")).importClipInFrameRange(timeline, clipData.clip, moveRange.startFrame, moveRange.endFrame, targetRigName)
						if not imported then
							return false, importMessage
						end
						importedSegments += 1
						usedClips[tostring(clipData.name or moveRange.motionName or "Motion")] = true
					end
				end

				for _, holdRange in ipairs(motionContext.holdRanges or {}) do
					local idleClipData = idleClipsBySegment[tostring(holdRange.segmentKey or "")]
					if idleClipData then
						local imported, importMessage = require(Modules:WaitForChild("MotionImportClipSupport")).importClipInFrameRange(timeline, idleClipData.clip, holdRange.startFrame, holdRange.endFrame, targetRigName)
						if not imported then
							return false, importMessage
						end
						importedIdleHolds += 1
						usedClips[tostring(idleClipData.name or "Pause Idle")] = true
					else
						local freezeSuccess, freezeMessage = require(Modules:WaitForChild("MotionFreezePoseSupport")).freezeRigPoseAcrossHold(timeline, holdRange, targetRigName)
						if not freezeSuccess then
							return false, freezeMessage
						end
					end
				end

				for _, turnRange in ipairs(motionContext.turnRanges or {}) do
					local freezeSuccess, freezeMessage = require(Modules:WaitForChild("MotionFreezePoseSupport")).freezeRigPoseAcrossHold(timeline, turnRange, targetRigName)
					if not freezeSuccess then
						return false, freezeMessage
					end
				end

				timeline:applyCurrentFrame()

				local usedList = {}
				for clipName in pairs(usedClips) do
					table.insert(usedList, clipName)
				end
				table.sort(usedList)
				local usedSummary = #usedList &gt; 0 and table.concat(usedList, ", ") or "selected"
				local idleSummary = importedIdleHolds &gt; 0 and string.format(" Added idle on %d pause%s.", importedIdleHolds, importedIdleHolds == 1 and "" or "s") or ""
				return true, string.format("Layered %s on %d segment%s.%s", usedSummary, importedSegments, importedSegments == 1 and "" or "s", idleSummary)
			end,
		})

		local success, message = MotionService.generateMotionPathFromWorkspaceMarkers(motionServiceDeps(), options)
		importActionStatus = message
		refreshUi(message)
	end)

	return false, importActionStatus
end

function MegMo_ImportAnimationId(input, sourceLabel, importEntry)
	if type(sourceLabel) == "table" and importEntry == nil then
		importEntry = sourceLabel
		sourceLabel = importEntry.name
	end
	local shouldConvertToR6 = type(importEntry) == "table" and importEntry.convertToR6 == true

	local motionSpec = parseMotionCommand(input)
	if motionSpec then
		local success, message = generateMotionPath(motionSpec)
		importActionStatus = message
		refreshUi(message)
		return success, message
	end

	local contentId, numericId = ImportService.normalizeAnimationContentId(input)
	if not contentId then
		importActionStatus = "Enter an Animation ID, Roblox URL, 'markers:create', or motion: duration=5; start=Workspace.Marker1; end=Workspace.Marker2"
		refreshUi(importActionStatus)
		return false, importActionStatus
	end

	importRequestId += 1
	local requestId = importRequestId
	local requestedTargetRigName = editorActions.getImportTargetRigName()
	importActionStatus = "Importing animation " .. numericId .. " from Roblox..."
	refreshUi(importActionStatus)
	task.spawn(function()
		local success, clipOrMessage = ImportService.loadAnimationClipFromContentId(contentId)
		if requestId ~= importRequestId then
			return
		end

		if not success then
			importActionStatus = "Could not import animation " .. numericId .. ": " .. tostring(clipOrMessage)
			warn("[7kg2 Animator] " .. importActionStatus)
			refreshUi(importActionStatus)
			return
		end

		local clip = clipOrMessage
		if shouldConvertToR6 then
			importActionStatus = "Converting " .. tostring(sourceLabel or ("animation " .. numericId)) .. " to R6..."
			refreshUi(importActionStatus)
			local convertOk, convertedOrMessage = pcall(function()
				local converter = require(Modules:WaitForChild("AnimationConversion"):WaitForChild("R15ToR6Converter"))
				local sourceSequence = clip
				if not sourceSequence:IsA("KeyframeSequence") then
					sourceSequence = converter.LoadFromAnimationId(contentId)
				end
				return converter.Convert(sourceSequence)
			end)
			if not convertOk or not convertedOrMessage then
				importActionStatus = "Could not convert " .. tostring(sourceLabel or ("animation " .. numericId)) .. " to R6: " .. tostring(convertedOrMessage)
				warn("[7kg2 Animator] " .. importActionStatus)
				refreshUi(importActionStatus)
				return
			end
			clip = convertedOrMessage
			sourceLabel = sourceLabel or clip.Name
		end

		local keyframeCount = ImportService.getKeyframeSequenceKeyframeCount(clip)
		if keyframeCount == 0 then
			importActionStatus = string.format(
				"Roblox loaded %s, but it contains 0 keyframes. Select a different Animation/KeyframeSequence or check that the asset was published with keyframes and is available to this place.",
				sourceLabel or ("animation " .. numericId)
			)
			warn("[7kg2 Animator] " .. importActionStatus)
			refreshUi(importActionStatus)
			return
		end

		local clipRigType = ImportService.detectRigTypeFromAnimationClip(clip)
		local boundRigType = getImportTargetRigTypeName(requestedTargetRigName)
		if clipRigType and boundRigType and clipRigType ~= boundRigType then
			importActionStatus = string.format(
				"This animation looks like %s, but the selected rig is %s. Select a matching rig track before importing.",
				clipRigType,
				boundRigType
			)
			refreshUi(importActionStatus)
			return
		end

		local motionHandled, motionMessage = MotionService.generateMotionPathFromSelection(
			motionServiceDeps(),
			MegMo_BuildMotionImportOptions(input, clip)
		)
		if motionHandled then
			importActionStatus = motionMessage
			refreshUi(importActionStatus)
			return
		end

		if clip:IsA("KeyframeSequence") then
			importKeyframeSequence(clip, contentId, requestedTargetRigName)
		elseif clip:IsA("CurveAnimation") then
			MegMo_ImportCurveAnimation(clip, contentId, requestedTargetRigName)
		else
			importActionStatus = string.format(
				"Loaded '%s', but it is a %s. KeyframeSequence and CurveAnimation import are supported.",
				clip.Name,
				clip.ClassName
			)
			warn("[7kg2 Animator] " .. importActionStatus)
			refreshUi(importActionStatus)
		end
	end)
	return false, importActionStatus
end

function MegMo_ImportSelectedAnimation()
	local selection = SelectionService.getSelection()
	if #selection == 0 then
		selection = SelectionService.getLastWorkspaceSelection()
	end

	for _, selected in ipairs(selection) do
		if SaveExportService.isSavedProjectInstance(selected) then
			loadSavedProjectValue(selected)
			return true, importActionStatus
		end
	end

	for _, selected in ipairs(selection) do
		local sourceType, source, sourceInstance = ImportService.findAnimationImportSource(selected)
		local sourceLabel = ImportService.describeImportSource(sourceInstance, selected and selected.Name)
		if sourceType == "AnimationId" then
			MegMo_ImportAnimationId(source, sourceLabel)
			return true, importActionStatus
		elseif sourceType == "KeyframeSequence" then
			return importKeyframeSequence(source, sourceLabel)
		elseif sourceType == "CurveAnimation" then
			return MegMo_ImportCurveAnimation(source, sourceLabel)
		end
	end

	local handled, motionMessage = MotionService.generateMotionPathFromSelection(motionServiceDeps())
	if handled then
		importActionStatus = motionMessage
		refreshUi(motionMessage)
		return true, motionMessage
	end

	importActionStatus = motionMessage or "Select an Animation, KeyframeSequence, CurveAnimation, a ServerStorage.MegMoAnimatorSaves save, or two workspace markers, then click Import Selected."
	refreshUi(importActionStatus)
	return false, importActionStatus
end

function MegMo_OpenR15ToR6Converter(parentOverride)
	local popupModule = Modules:WaitForChild("UI"):WaitForChild("R15ToR6ConverterPopup")
	local popupParent = parentOverride or widget
	return require(popupModule).open(popupParent, {
		onImportKeyframeSequence = function(keyframeSequence, sourceLabel)
			return importKeyframeSequence(keyframeSequence, sourceLabel)
		end,
	})
end

