        <Properties>
          <string name="Name">ImportTargetRigSupport</string>
          <ProtectedString name="Source">local ImportTargetRigSupport = {}

function ImportTargetRigSupport.getImportTargetRigName(timeline, selectedJointPath, selectedTrackPaths, selectionService)
	local function rigNameFromTrackPath(path)
		local track = path and timeline:getTrackByPath(path)
		if not track then
			return nil
		end
		return track.rigName or (track.trackType == "Rig Group" and (track.part0 or track.name)) or nil
	end

	local function validRigNameFromPath(path)
		local rigName = rigNameFromTrackPath(path)
		if rigName and timeline:getRigByName(rigName) then
			return rigName
		end
		return nil
	end

	for path in pairs(selectedTrackPaths or {}) do
		local rigName = validRigNameFromPath(path)
		if rigName then
			return rigName
		end
	end

	local rigName = validRigNameFromPath(selectedJointPath)
	if rigName then
		return rigName
	end

	local selectedRig = selectionService.getSelectedRig()
	if selectedRig and timeline:getRigByName(selectedRig.Name) then
		return selectedRig.Name
	end

	local activeRig = timeline:getRig()
	return activeRig and activeRig.Name or nil
end

return ImportTargetRigSupport
