			BorderSizePixel = 0,
			Position = UDim2.new(index / 12, index == 0 and 12 or index == 12 and -13 or 0, 0, 48),
			Size = UDim2.fromOffset(1, index % 3 == 0 and 10 or 6),
		}, timeline)
		table.insert(ticks, tick)
	end
	local diamonds = {}
	for index = 1, 8 do
		local diamond = make("Frame", {
			Name = "Key" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = theme.text,
