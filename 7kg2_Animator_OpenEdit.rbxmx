local MicroAnimationToolsPopupSupport = {}
local DEBUG_DROPDOWNS = false

local function debugDropdown(...)
	if not DEBUG_DROPDOWNS then
		return
	end
	local parts = { "[7kg2 Micro Animation Tools Dropdown Debug]" }
	for index = 1, select("#", ...) do
		parts[#parts + 1] = tostring(select(index, ...))
	end
	print(table.concat(parts, " | "))
end

