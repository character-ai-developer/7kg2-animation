      <Item class="ModuleScript" referent="RBX179">
        <Properties>
          <string name="Name">MultiGizmoSelectionService</string>
          <ProtectedString name="Source">local MultiGizmoSelectionService = {}

local function normalizeFrame(frame)
	return math.max(0, math.floor(tonumber(frame) or 0))
end

function MultiGizmoSelectionService.getSameFrameRigKeyPaths(timeline, selectedKeys, selectionState)
	if not timeline or type(selectedKeys) ~= "table" or not selectionState then
		return nil
	end

	local getSelectedKeyRefs = selectionState.getSelectedKeyRefs
	if type(getSelectedKeyRefs) ~= "function" then
		return nil
	end

	local selectedKeyRefs = getSelectedKeyRefs(selectedKeys)
	if #selectedKeyRefs &lt;= 1 then
		return nil
	end

	local frame = normalizeFrame(selectedKeyRefs[1].frame)
	if frame ~= normalizeFrame(timeline:getCurrentFrame()) then
		return nil
	end

	local paths = {}
	local seen = {}
	for _, keyRef in ipairs(selectedKeyRefs) do
		local path = keyRef.jointPath
		if normalizeFrame(keyRef.frame) ~= frame then
			return nil
		end
		if type(path) ~= "string" or seen[path] or not timeline:getMotorByPath(path) then
			return nil
		end
		if type(timeline.hasTrackKeyframe) == "function" and not timeline:hasTrackKeyframe(path, frame) then
			return nil
		end
		seen[path] = true
		table.insert(paths, path)
	end

	return #paths &gt; 1 and paths or nil
end

function MultiGizmoSelectionService.getSameFrameRigMotors(timeline, selectedKeys, selectionState)
	local paths = MultiGizmoSelectionService.getSameFrameRigKeyPaths(timeline, selectedKeys, selectionState)
	if not paths then
		return nil
	end

	local motors = {}
	for _, path in ipairs(paths) do
		local motorData = timeline:getMotorByPath(path)
		if motorData then
			table.insert(motors, motorData)
		end
	end

	return #motors &gt; 1 and motors or nil
end

function MultiGizmoSelectionService.captureSameFrameRigKeys(timeline, selectedKeys, selectionState)
	local paths = MultiGizmoSelectionService.getSameFrameRigKeyPaths(timeline, selectedKeys, selectionState)
	if not paths then
		return nil
	end

	local frame = timeline:getCurrentFrame()
	local capturedKeys = {}
	for _, path in ipairs(paths) do
		if timeline:captureTrackFrame(path) then
			table.insert(capturedKeys, {
				jointPath = path,
				frame = frame,
			})
		end
	end

	return #capturedKeys &gt; 0 and capturedKeys or nil
end

return MultiGizmoSelectionService
