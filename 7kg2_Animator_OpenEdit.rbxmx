		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.new(0, 236, 0, 48),
		Size = UDim2.new(0, 320, 0, 54),
		Visible = false,
		ZIndex = 120,
	})
	createCorner(trackNameTooltip, 10)
	createStroke(trackNameTooltip, Constants.THEME.Border, 1)

	local trackNameTooltipTitle = create("TextLabel", {
		Parent = trackNameTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Track",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 121,
	})

	local trackNameTooltipDetail = create("TextLabel", {
		Parent = trackNameTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.Gotham,
		Text = "Details",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 121,
	})

	refs._frameInput = frameInput
	refs._durationInput = durationInput
	refs._addSelectedRigButton = addSelectedRigButton
	refs._removeSelectedTrackToolbarButton = removeSelectedTrackButton
	refs._captureButton = captureButton
	refs._multiSelectButton = multiSelectButton
