local createDropdownMenu = UiHelpers.createDropdownMenu
local updateDropdownOptionHighlight = UiHelpers.updateDropdownOptionHighlight
local formatNumber = WidgetMathSupport.formatNumber
local safeFps = WidgetMathSupport.safeFps
local positionToVector2 = WidgetMathSupport.positionToVector2
local deltaToVector2 = WidgetMathSupport.deltaToVector2

local function getCurrentMousePoint()
	local mouseLocation = UserInputService:GetMouseLocation()
	return Vector2.new(mouseLocation.X, mouseLocation.Y)
end

local function getMiddleMousePressed()
	local ok, pressed = pcall(function()
		return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
	end)
	if not ok then
		return nil
	end
	return pressed == true
end

local function ensureCameraCanPreviewRoll(camera, zDegrees)
