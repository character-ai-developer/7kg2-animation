		local lastMicroKeyDragReleaseClock = 0
		local lastMicroSoundClipClickKey = nil
		local lastMicroSoundClipClickClock = 0
		local lastMicroFaceKeyClickId = nil
		local lastMicroFaceKeyClickClock = 0
		local lastMicroTrackClickPath = nil
		local lastMicroTrackClickTime = 0
