      <Item class="ModuleScript" referent="RBX221">
        <Properties>
          <string name="Name">ScreenEffectsRenderSupport</string>
          <ProtectedString name="Source">local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))
local LightingEffectActionService = require(script.Parent:WaitForChild("LightingEffectActionService"))
local LightingEffectTrackService = require(script.Parent:WaitForChild("LightingEffectTrackService"))
local ScreenEffectTrackService = require(script.Parent:WaitForChild("ScreenEffectTrackService"))

local ScreenEffectsRenderSupport = {}

function ScreenEffectsRenderSupport.render(options)
	local timeline = options.timeline
	local frame = options.frame or timeline:getCurrentFrame()
	local hasScreenEffects = false
	local hasLightingEffects = false
	local hasFaceTracks = false
	for _, track in ipairs(timeline:getTracks()) do
		if ScreenEffectTrackService.isScreenEffectTrack(track) then
			hasScreenEffects = true
		elseif LightingEffectTrackService.isLightingEffectTrack(track) then
			hasLightingEffects = true
		elseif track.trackType == "Face" or track.targetScope == "Face" or track.valueType == "Face" then
			hasFaceTracks = true
		end
	end

	local perfToken = PerformanceDebugService.begin("Screen Effects")
	local effectsViewModel = options.effectsViewModel
	if hasScreenEffects and type(options.buildEffectsViewModel) == "function" then
		effectsViewModel = options.buildEffectsViewModel(frame)
	end
	local ok, renderMessage = options.screenEffectsRenderer:render(effectsViewModel)

	if hasLightingEffects and type(LightingEffectActionService.applyTimeline) == "function" then
		LightingEffectActionService.applyTimeline({
			timeline = timeline,
		}, frame)
	end

	PerformanceDebugService.finish(perfToken)

	if not ok then
		warn("[7kg2 Animator] Could not render viewer screen effects:", renderMessage)
	end

	if hasFaceTracks and options.facesController then
		options.facesController:applyAtFrame(frame)
	end
end

return ScreenEffectsRenderSupport
</ProtectedString>
        </Properties>
      </Item>
