			ZIndex = 10,
		}, frameScrollTrack)
		frameScrollHandle:SetAttribute("MegMoThemeBackgroundRole", "Accent")
		corner(frameScrollHandle, 3)
		blockClickThrough(frameScrollHandle)

		local function layoutMiniTimelineColumns()
			local width = math.max(1, timelineView.AbsoluteSize.X)
			local nextWidth = math.clamp(math.floor(width * 0.35), 144, 210)
			if nextWidth == trackColumnWidth then
				return
			end
			trackColumnWidth = nextWidth
			tracks.Size = UDim2.new(0, trackColumnWidth, 1, 0)
			lanes.Position = UDim2.fromOffset(trackColumnWidth + 8, 0)
			lanes.Size = UDim2.new(1, -(trackColumnWidth + 8), 1, -(MICRO_FRAME_SCROLL_MARGIN + 4))
			frameScrollTrack.Position = UDim2.new(0, trackColumnWidth + 8, 1, -MICRO_FRAME_SCROLL_MARGIN)
			frameScrollTrack.Size = UDim2.new(1, -(trackColumnWidth + 8), 0, MICRO_FRAME_SCROLL_HEIGHT)
		end

		local scrubSurface = make("TextButton", {
			Name = "ScrubSurface",
			Active = true,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromScale(1, 1),
			Text = "",
			ZIndex = 6,
		}, lanes)
		blockClickThrough(scrubSurface)

		local microScrubbing = false
		local microScrubStartPoint = nil
		local microScrubMoved = false
		local microLastScrubInput = nil
		local microTrackOffset = 0
		local microTrackHeight = MICRO_TIMELINE_ROW_HEIGHT
		local microFrameStart = math.max(0, math.floor(getSettingNumber(plugin, FRAME_START_SETTING, 0)))
		local microVisibleFrames = snapMicroVisibleFrames(getSettingNumber(plugin, VISIBLE_FRAMES_SETTING, MICRO_DEFAULT_VISIBLE_FRAMES))
		local microZoomDragging = false
		local microFrameDragging = false
		local microFrameDragMode = nil
		local microFrameDragStartX = 0
		local microFrameDragStartFrame = 0
		local microTrackDragging = false
		local microMiddlePanState = nil
		local lastMicroEdgeFramePanClock = 0
		local lastMicroEdgeTrackPanClock = 0
