local CAMERA_SETTING_TOOLTIPS = {
	Duration = {
		title = "Duration",
		detail = "Shot length in seconds. Range: about 0.1 to 30. Higher means the generated camera move lasts longer.",
	},
	Radius = {
		title = "Radius",
		detail = "Distance from the subject for orbit-style shots. Range: about 2 to 60 studs. Higher keeps the camera farther away.",
	},
	Height = {
		title = "Height Offset",
		detail = "Vertical camera offset in studs. Range: about -20 to 20. Higher raises the camera above the subject.",
	},
	FOV = {
		title = "FOV Override",
		detail = "Camera field of view in degrees. Range: 1 to 120. Lower is more zoomed-in/cinematic; higher is wider.",
	},
	LookSmooth = {
		title = "Look Smooth",
		detail = "How softly the camera aims at the subject. Range: 0 to 0.95. Higher smooths look-at changes more, but can lag behind fast action.",
	},
	Intensity = {
		title = "Intensity",
		detail = "Strength multiplier for the preset. Range: 0.1 to 5. Higher makes movement, shake, or framing changes more dramatic.",
	},
	Smoothness = {
		title = "Smoothness",
		detail = "How many generated camera keys are used. Range: about 0.1 to 5. Higher creates more keys and smoother paths; lower creates fewer keys.",
	},
	StartOffset = {
		title = "Start Offset",
		detail = "Extra X,Y,Z offset at the start, relative to the subject. Example: 2,1,0. Useful for custom framing.",
	},
	EndOffset = {
		title = "End Offset",
		detail = "Extra X,Y,Z offset at the end, relative to the subject. The offset blends from Start Offset to this value.",
	},
	OrbitAngle = {
		title = "Orbit Angle",
		detail = "Half 180 creates an arc. Full 360 circles the subject. Applies mainly to Orbit Shot.",
	},
	Direction = {
		title = "Direction",
		detail = "Clockwise or counterclockwise orbit direction. Applies mainly to Orbit Shot.",
	},
	Tracking = {
		title = "Subject Tracking",
		detail = "On follows the subject's timeline movement when possible. Off uses the subject's current Studio position only.",
	},
	Easing = {
		title = "Easing",
		detail = "Timing style for generated camera keys. Sine InOut is smooth by default; Linear keeps constant speed.",
	},
}

