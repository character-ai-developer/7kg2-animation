      <Item class="ModuleScript" referent="RBX113">
        <Properties>
          <string name="Name">AnimationMarkerExportService</string>
          <ProtectedString name="Source">local HttpService = game:GetService("HttpService")

local AnimationMarkerExportService = {}

local MAX_MARKER_NAME_LENGTH = 120

local function cleanText(value, fallback)
	local text = tostring(value or "")
	text = string.gsub(text, "[%c]", " ")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	if text == "" then
		text = fallback or "Event"
	end
	if #text &gt; MAX_MARKER_NAME_LENGTH then
		text = string.sub(text, 1, MAX_MARKER_NAME_LENGTH)
	end
	return text
end

local function isSoundTrack(track)
	return track ~= nil and (track.trackType == "Sound" or track.valueType == "Sound" or track.targetScope == "Sound")
end

local function isParticleEventTrack(track)
	return track ~= nil and (track.trackType == "Particle Event" or track.valueType == "ParticleEvent" or track.targetScope == "ParticleEvent")
end

function AnimationMarkerExportService.isExportMarkerTrack(track)
	return track ~= nil and (
		track.trackType == "Event"
			or track.valueType == "Event"
			or isParticleEventTrack(track)
			or isSoundTrack(track)
	)
end

local function compactValue(value, depth, seen)
	if depth &gt; 5 then
		return tostring(value)
	end

	local valueType = typeof(value)
	if valueType == "CFrame" then
		return {
			type = "CFrame",
			components = { value:GetComponents() },
		}
	elseif valueType == "Vector3" then
		return {
			type = "Vector3",
			x = value.X,
			y = value.Y,
			z = value.Z,
		}
	elseif valueType == "Vector2" then
		return {
			type = "Vector2",
			x = value.X,
			y = value.Y,
		}
	elseif valueType == "Color3" then
		return {
			type = "Color3",
			r = value.R,
			g = value.G,
			b = value.B,
		}
	elseif valueType == "EnumItem" then
		return {
			type = "EnumItem",
			name = value.Name,
			value = tostring(value),
		}
	elseif valueType == "Instance" then
		return value:GetFullName()
	elseif valueType ~= "table" then
		return value
	end

	if seen[value] then
		return tostring(value)
	end
	seen[value] = true

	local compact = {}
	for key, childValue in pairs(value) do
		compact[tostring(key)] = compactValue(childValue, depth + 1, seen)
	end
	seen[value] = nil
	return compact
end

local function encodeMarkerValue(track, value)
	if value == nil then
		return ""
	end

	if track and (track.valueType == "Event" or track.trackType == "Event") then
		if type(value) == "table" then
			return tostring(value.payload or "")
		end
		return tostring(value)
	end

	if type(value) ~= "table" then
		return tostring(value)
	end

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(compactValue(value, 0, {}))
	end)
	return ok and encoded or ""
end

local function markerNameForTrack(track, value)
	if type(value) == "table" then
		if track and isSoundTrack(track) then
			return cleanText(value.name or track.name, "Sound")
		end
		if track and isParticleEventTrack(track) then
			return cleanText(value.actionName or value.eventName or track.eventName or track.propertyName or track.name, "ParticleEvent")
		end
		return cleanText(value.name or value.action or value.eventName or (track and track.eventName) or (track and track.name), "Event")
	end

	if track and isSoundTrack(track) then
		return cleanText(track.name, "Sound")
	end
	if track and isParticleEventTrack(track) then
		return cleanText(track.eventName or track.propertyName or track.name, "ParticleEvent")
	end
	return cleanText(track and (track.eventName or track.name), "Event")
end

local function getTrackKeyValue(timeline, trackPath, frame)
	if timeline and type(timeline.getTrackValueAtFrame) == "function" then
		return timeline:getTrackValueAtFrame(trackPath, frame)
	end

	if timeline and type(timeline.getTrackKeyValues) == "function" then
		local values = timeline:getTrackKeyValues({
			{
				jointPath = trackPath,
				frame = frame,
			},
		})
		return values[1] and values[1].value
	end
	return nil
end

function AnimationMarkerExportService.collectByFrame(timeline)
	local markersByFrame = {}
	if not timeline or type(timeline.getTracks) ~= "function" then
		return markersByFrame
	end

	for _, track in ipairs(timeline:getTracks()) do
		if AnimationMarkerExportService.isExportMarkerTrack(track) then
			local disabled = type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(track.path)
			if not disabled and type(timeline.getTrackKeyframeFrames) == "function" then
				for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
					local value = getTrackKeyValue(timeline, track.path, frame)
					markersByFrame[frame] = markersByFrame[frame] or {}
					table.insert(markersByFrame[frame], {
						name = markerNameForTrack(track, value),
						value = encodeMarkerValue(track, value),
					})
				end
			end
		end
	end

	return markersByFrame
end

function AnimationMarkerExportService.addMarkerFrames(timeline, frames, seenFrames)
	local markersByFrame = AnimationMarkerExportService.collectByFrame(timeline)
	for frame in pairs(markersByFrame) do
		if not seenFrames[frame] then
			seenFrames[frame] = true
			table.insert(frames, frame)
		end
	end
	return markersByFrame
end

function AnimationMarkerExportService.appendMarkersToKeyframe(keyframe, markers)
	for _, markerData in ipairs(markers or {}) do
		local marker = Instance.new("KeyframeMarker")
		marker.Name = cleanText(markerData.name, "Event")
		pcall(function()
			marker.Value = tostring(markerData.value or "")
		end)
		marker.Parent = keyframe
	end
end

return AnimationMarkerExportService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX114">
        <Properties>
          <string name="Name">AttachService</string>
          <ProtectedString name="Source">local AttachService = {}

local ATTACH_ATTRIBUTE = "MegMoAttachment"
local ATTACH_LIMB_PATH_ATTRIBUTE = "MegMoLimbPath"
local ATTACH_OBJECT_PATH_ATTRIBUTE = "MegMoAttachedObjectPath"
local ATTACH_WAS_ANCHORED_ATTRIBUTE = "MegMoPart1WasAnchored"
local ATTACH_WELD_ATTRIBUTE = "MegMoAttachmentWeld"
local ATTACH_WELD_PART_WAS_ANCHORED_ATTRIBUTE = "MegMoWeldPartWasAnchored"
local ATTACH_OBJECT_VALUE_NAME = "MegMoAttachedObject"
local EVENT_KIND = "MegMoAttachmentEvent"
local EVENT_TRACK_PREFIX = "Attach: "
local DEFAULT_EASING_STYLE = "Linear"
local DEFAULT_EASING_DIRECTION = "InOut"

local runtimeAttachmentMotorsMayExist = false

local function getFullName(instance)
	return instance and instance.Parent and instance:GetFullName() or nil
end

local function resolveInstance(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end

	local segments = string.split(path, ".")
	local current = nil
	if segments[1] == "game" then
		current = game
		table.remove(segments, 1)
	elseif segments[1] == "Workspace" or segments[1] == "workspace" then
		current = workspace
		table.remove(segments, 1)
	elseif segments[1] == "ServerStorage" then
		current = game:GetService("ServerStorage")
		table.remove(segments, 1)
	elseif segments[1] == "ReplicatedStorage" then
		current = game:GetService("ReplicatedStorage")
		table.remove(segments, 1)
	end

	for _, name in ipairs(segments) do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end

	return current
end

local function getInstanceCFrame(instance)
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("Attachment") then
		return instance.WorldCFrame
	end
	if instance:IsA("BasePart") then
		return instance.CFrame
	end
	if instance:IsA("Model") then
		return instance:GetPivot()
	end
	if instance:IsA("Camera") then
		return instance.CFrame
	end

	return nil
end

local function setInstanceCFrame(instance, cframe)
	if not instance or not instance.Parent or typeof(cframe) ~= "CFrame" then
		return false
	end

	if instance:IsA("BasePart") then
		instance.CFrame = cframe
		return true
	end
	if instance:IsA("Model") then
		instance:PivotTo(cframe)
		return true
	end
	if instance:IsA("Attachment") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			parent.CFrame = cframe * instance.CFrame:Inverse()
			return true
		end
	end

	return false
end

local function cframesClose(a, b)
	if typeof(a) ~= "CFrame" or typeof(b) ~= "CFrame" then
		return false
	end
	local positionDelta = (a.Position - b.Position).Magnitude
	local ax, ay, az = a:ToOrientation()
	local bx, by, bz = b:ToOrientation()
	local rotationDelta = math.abs(ax - bx) + math.abs(ay - by) + math.abs(az - bz)
	return positionDelta &lt; 0.0005 and rotationDelta &lt; 0.0005
end

local function setPartCFrameByProperties(part, cframe)
	if not (part and part.Parent and part:IsA("BasePart") and typeof(cframe) == "CFrame") then
		return false
	end
	local x, y, z = cframe:ToOrientation()
	part.Position = cframe.Position
	part.Orientation = Vector3.new(math.deg(x), math.deg(y), math.deg(z))
	return true
end

local function setModelPivotByProperties(model, cframe)
	if not (model and model.Parent and model:IsA("Model") and typeof(cframe) == "CFrame") then
		return false
	end
	local currentPivot = model:GetPivot()
	local delta = cframe * currentPivot:Inverse()
	local partTargets = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			partTargets[#partTargets + 1] = {
				part = descendant,
				cframe = delta * descendant.CFrame,
			}
		end
	end
	for _, item in ipairs(partTargets) do
		setPartCFrameByProperties(item.part, item.cframe)
	end
	return #partTargets &gt; 0
end

local function setAttachedObjectCFrameSafely(target, attachPart, cframe)
	if typeof(cframe) ~= "CFrame" then
		return false
	end
	if target and target.Parent and target:IsA("Model") then
		return setModelPivotByProperties(target, cframe)
	end
	return setPartCFrameByProperties(attachPart, cframe)
end

local function containsToken(name, token)
	return string.find(string.lower(tostring(name or "")), string.lower(token), 1, true) ~= nil
end

local function isEndpointPart(name)
	local normalized = string.gsub(string.lower(tostring(name or "")), "%s+", "")
	return containsToken(name, "Hand")
		or containsToken(name, "Foot")
		or normalized == "rightarm"
		or normalized == "leftarm"
		or normalized == "rightleg"
		or normalized == "leftleg"
end

local function sanitizeName(text)
	return string.gsub(tostring(text or "Object"), "[^%w_]", "_")
end

local function collectBaseParts(instance)
	local parts = {}
	if not instance or not instance.Parent then
		return parts
	end
	if instance:IsA("BasePart") then
		table.insert(parts, instance)
		return parts
	end
	if instance:IsA("Model") or instance:IsA("Folder") then
		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") then
				table.insert(parts, descendant)
			end
		end
	end
	return parts
end

local function countBaseParts(instance)
	local count = 0
	for _, part in ipairs(collectBaseParts(instance)) do
		if part and part.Parent then
			count += 1
		end
	end
	return count
end

local function getAttachableModelForPart(part, rig)
	if not part or not part.Parent then
		return nil
	end

	local model = part:FindFirstAncestorOfClass("Model")
	if not model or model == rig or (rig and model:IsDescendantOf(rig)) then
		return nil
	end
	if countBaseParts(model) &lt;= 1 then
		return nil
	end

	return model
end

local function findTarget(selection, rig)
	for _, instance in ipairs(selection or {}) do
		if instance and instance.Parent and not (rig and (instance == rig or instance:IsDescendantOf(rig))) then
			if instance:IsA("BasePart") then
				local modelTarget = getAttachableModelForPart(instance, rig)
				if modelTarget then
					return modelTarget, instance
				end
				return instance, instance
			end
			if instance:IsA("Model") then
				return instance, nil
			end
			local model = instance:FindFirstAncestorOfClass("Model")
			if model and not (rig and (model == rig or model:IsDescendantOf(rig))) then
				return model, nil
			end
		end
	end

	return nil
end

local function getAttachPart(instance, preferredPart)
	if not instance or not instance.Parent then
		return nil
	end

	if instance:IsA("BasePart") then
		return instance
	end
	if instance:IsA("Model") then
		if preferredPart and preferredPart.Parent and preferredPart:IsA("BasePart") and preferredPart:IsDescendantOf(instance) then
			return preferredPart
		end
		if instance.PrimaryPart then
			return instance.PrimaryPart
		end
		return instance:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function buildChildrenByPart0(motors)
	local childrenByPart0 = {}
	for _, motorData in ipairs(motors or {}) do
		local motor = motorData.instance
		if motor and motor.Parent and motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
			childrenByPart0[motor.Part0] = childrenByPart0[motor.Part0] or {}
			table.insert(childrenByPart0[motor.Part0], motorData)
		end
	end
	return childrenByPart0
end

local function findEndpointFromMotor(motorData, childrenByPart0)
	local motor = motorData and motorData.instance
	if not motor or not motor:IsA("Motor6D") or not motor.Part1 then
		return nil
	end

	if isEndpointPart(motor.Part1.Name) then
		return motorData
	end

	for _, child in ipairs(childrenByPart0[motor.Part1] or {}) do
		local childMotor = child.instance
		if childMotor and childMotor.Part1 and isEndpointPart(childMotor.Part1.Name) then
			return child
		end
		for _, grandChild in ipairs(childrenByPart0[childMotor and childMotor.Part1] or {}) do
			local grandMotor = grandChild.instance
			if grandMotor and grandMotor.Part1 and isEndpointPart(grandMotor.Part1.Name) then
				return grandChild
			end
		end
	end

	return nil
end

local function getSelectedAttachMotor(timeline, selectedPath)
	local selectedMotor = selectedPath and timeline:getMotorByPath(selectedPath)
	local motor = selectedMotor and selectedMotor.instance
	if motor and motor.Parent and motor:IsA("Motor6D") and motor.Part1 and motor.Part1:IsA("BasePart") then
		return selectedMotor
	end

	if selectedMotor then
		return findEndpointFromMotor(selectedMotor, buildChildrenByPart0(timeline:getMotors()))
	end

	return nil
end

local function getAttachedObject(motor)
	local objectValue = motor and motor:FindFirstChild(ATTACH_OBJECT_VALUE_NAME)
	if objectValue and objectValue:IsA("ObjectValue") and objectValue.Value and objectValue.Value.Parent then
		return objectValue.Value
	end
	return motor and motor.Part1 or nil
end

local function getMotorObjectPath(motor)
	local storedPath = motor and motor:GetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE)
	if type(storedPath) == "string" and storedPath ~= "" then
		return storedPath
	end
	local attachedObject = getAttachedObject(motor)
	return getFullName(attachedObject) or getFullName(motor and motor.Part1)
end

local function findExistingAttachment(handPart, attachPart)
	if not handPart then
		return nil
	end

	for _, child in ipairs(handPart:GetChildren()) do
		if child:IsA("Motor6D") and child:GetAttribute(ATTACH_ATTRIBUTE) == true then
			if not attachPart or child.Part1 == attachPart then
				return child
			end
		end
	end

	return nil
end

local function findAttachmentByTarget(selection, rig)
	local target, preferredAttachPart = findTarget(selection, rig)
	local attachPart = getAttachPart(target, preferredAttachPart)
	if not attachPart then
		return nil, target
	end

	local targetPath = getFullName(target)
	for _, motor in ipairs(workspace:GetDescendants()) do
		if motor:IsA("Motor6D") and motor:GetAttribute(ATTACH_ATTRIBUTE) == true then
			local motorTargetPath = getMotorObjectPath(motor)
			local motorPart = motor.Part1
			if motorPart == attachPart
				or (targetPath and motorTargetPath == targetPath)
				or (target and target:IsA("Model") and motorPart and motorPart:IsDescendantOf(target)) then
				return motor, target
			end
		end
	end

	return nil, target
end

local function findExistingAttachmentByObjectPath(objectPath)
	for _, motor in ipairs(workspace:GetDescendants()) do
		if motor:IsA("Motor6D") and motor:GetAttribute(ATTACH_ATTRIBUTE) == true then
			if getMotorObjectPath(motor) == objectPath then
				return motor
			end
		end
	end

	return nil
end

local function findAttachmentWeld(rootPart, part, objectPath)
	if not rootPart or not part then
		return nil
	end
	objectPath = tostring(objectPath or "")
	for _, child in ipairs(rootPart:GetChildren()) do
		if child:IsA("WeldConstraint") and child:GetAttribute(ATTACH_WELD_ATTRIBUTE) == true then
			local childObjectPath = tostring(child:GetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE) or "")
			if child.Part1 == part and (objectPath == "" or childObjectPath == objectPath) then
				return child
			end
		end
	end
	return nil
end

local function ensureAttachmentAssembly(target, attachPart, objectPath)
	if not target or not attachPart or not attachPart:IsA("BasePart") then
		return 0
	end

	local createdCount = 0
	for _, part in ipairs(collectBaseParts(target)) do
		if part ~= attachPart and part.Parent then
			if not findAttachmentWeld(attachPart, part, objectPath) then
				local weld = Instance.new("WeldConstraint")
				weld.Name = "MegMoAttachWeld_" .. sanitizeName(part.Name)
				weld.Part0 = attachPart
				weld.Part1 = part
				weld:SetAttribute(ATTACH_WELD_ATTRIBUTE, true)
				weld:SetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE, tostring(objectPath or ""))
				weld:SetAttribute(ATTACH_WELD_PART_WAS_ANCHORED_ATTRIBUTE, part.Anchored == true)
				weld.Parent = attachPart
				createdCount += 1
			end
			part.Anchored = false
		end
	end
	return createdCount
end

local function removeAttachmentWelds(attachPart, objectPath, target)
	if not attachPart and not target then
		return 0
	end

	objectPath = tostring(objectPath or "")
	local removedCount = 0
	local seen = {}

	local function shouldRemoveWeld(weld)
		if not weld or not weld.Parent or seen[weld] then
			return false
		end
		if not weld:IsA("WeldConstraint") or weld:GetAttribute(ATTACH_WELD_ATTRIBUTE) ~= true then
			return false
		end

		local childObjectPath = tostring(weld:GetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE) or "")
		if objectPath ~= "" and childObjectPath == objectPath then
			return true
		end
		if attachPart and (weld.Part0 == attachPart or weld.Part1 == attachPart) then
			return true
		end
		if target and target.Parent then
			local part0InTarget = weld.Part0 and weld.Part0:IsDescendantOf(target)
			local part1InTarget = weld.Part1 and weld.Part1:IsDescendantOf(target)
			if part0InTarget or part1InTarget then
				return true
			end
		end
		return false
	end

	local function removeWeld(weld)
		if not shouldRemoveWeld(weld) then
			return
		end

		seen[weld] = true
		local part = weld.Part1 ~= attachPart and weld.Part1 or weld.Part0
		local wasAnchored = weld:GetAttribute(ATTACH_WELD_PART_WAS_ANCHORED_ATTRIBUTE) == true
		weld:Destroy()
		if part and part.Parent then
			part.Anchored = wasAnchored
		end
		removedCount += 1
	end

	if attachPart then
		for _, child in ipairs(attachPart:GetChildren()) do
			removeWeld(child)
		end
	end
	if target and target.Parent then
		for _, descendant in ipairs(target:GetDescendants()) do
			removeWeld(descendant)
		end
	end
	if objectPath ~= "" then
		for _, descendant in ipairs(workspace:GetDescendants()) do
			removeWeld(descendant)
		end
	end
	return removedCount
end

local function findAttachmentByLimb(timeline, selectedPath)
	local attachMotor = getSelectedAttachMotor(timeline, selectedPath)
	local bodyPart = attachMotor and attachMotor.instance and attachMotor.instance.Part1
	return findExistingAttachment(bodyPart), attachMotor
end

local function findObjectTrack(timeline, target)
	if not target then
		return nil
	end
	for _, track in ipairs(timeline:getTracks()) do
		if track.instance == target then
			return track
		end
	end

	return nil
end

local function getAttachmentObjectTrack(timeline, objectPath, value)
	if value and type(value.objectTrackPath) == "string" and value.objectTrackPath ~= "" then
		local track = timeline:getTrackByPath(value.objectTrackPath)
		if track then
			if type(value.attachPartPath) == "string" and value.attachPartPath ~= "" then
				track.gizmoTargetPath = value.attachPartPath
			end
			return track
		end
	end

	local target = resolveInstance(objectPath)
	local track = target and findObjectTrack(timeline, target) or nil
	if track and value and type(value.attachPartPath) == "string" and value.attachPartPath ~= "" then
		track.gizmoTargetPath = value.attachPartPath
	end
	return track
end

local function ensureObjectTrack(timeline, target)
	local track = findObjectTrack(timeline, target)
	if track then
		return track, false
	end

	return timeline:addGenericTrack(target:IsA("Model") and "Model" or "Object", target, target.Name), true
end

local function isAttachmentEventValue(value)
	return type(value) == "table" and value.kind == EVENT_KIND
end

local function findAttachmentEventTrack(timeline, target)
	local targetPath = getFullName(target)
	local fallbackName = EVENT_TRACK_PREFIX .. tostring(target and target.Name or "Object")

	for _, track in ipairs(timeline:getTracks()) do
		if track.valueType == "Event" then
			local frames = timeline:getTrackKeyframeFrames(track.path)
			for _, frame in ipairs(frames) do
				local values = timeline:getTrackKeyValues({
					{
						jointPath = track.path,
						frame = frame,
					},
				})
				local value = values[1] and values[1].value
				if isAttachmentEventValue(value) and value.objectPath == targetPath then
					return track
				end
			end
			if track.name == fallbackName then
				return track
			end
		end
	end

	return nil
end

local function ensureAttachmentEventTrack(timeline, target)
	local track = findAttachmentEventTrack(timeline, target)
	if track then
		return track, false
	end

	return timeline:addGenericTrack("Event", nil, EVENT_TRACK_PREFIX .. tostring(target and target.Name or "Object"), {
		sortOrder = 28,
	}), true
end

local function writeEventKey(timeline, track, frame, value)
	return timeline:setTrackValueAtFrame(track.path, frame, value, DEFAULT_EASING_STYLE, DEFAULT_EASING_DIRECTION)
end

local function setObjectBoundaryKey(timeline, target, frame, cframe, gizmoTarget)
	if not target or not target.Parent or typeof(cframe) ~= "CFrame" then
		return nil, false
	end

	local track = ensureObjectTrack(timeline, target)
	if track and gizmoTarget and gizmoTarget.Parent then
		track.gizmoTargetPath = getFullName(gizmoTarget)
	end
	local ok = timeline:setTrackValueAtFrame(track.path, frame, cframe, DEFAULT_EASING_STYLE, DEFAULT_EASING_DIRECTION)
	return track, ok == true
end

local function setObjectPreAttachHoldKeys(timeline, target, attachFrame, cframe, gizmoTarget)
	if not target or not target.Parent or typeof(cframe) ~= "CFrame" then
		return nil, 0
	end

	attachFrame = math.max(0, math.floor(attachFrame or 0))
	local track = ensureObjectTrack(timeline, target)
	if not track then
		return nil, 0
	end
	if gizmoTarget and gizmoTarget.Parent then
		track.gizmoTargetPath = getFullName(gizmoTarget)
	end

	local frames = { 0 }
	local holdEndFrame = math.max(0, attachFrame - 1)
	if holdEndFrame ~= 0 then
		table.insert(frames, holdEndFrame)
	end
	if attachFrame ~= 0 and attachFrame ~= holdEndFrame then
		table.insert(frames, attachFrame)
	end

	local written = 0
	for _, keyFrame in ipairs(frames) do
		local ok = timeline:setTrackValueAtFrame(track.path, keyFrame, cframe, DEFAULT_EASING_STYLE, DEFAULT_EASING_DIRECTION)
		if ok == true then
			written += 1
		end
	end
	return track, written
end

local function createAttachmentValue(action, frame, target, attachPart, endpointMotor, offsetC0, wasAnchored, preAttachCFrame)
	local endpoint = endpointMotor and endpointMotor.instance
	return {
		kind = EVENT_KIND,
		action = action,
		frame = frame,
		objectName = target and target.Name or "Object",
		objectPath = getFullName(target),
		attachPartPath = getFullName(attachPart),
		handPartPath = getFullName(endpoint and endpoint.Part1),
		limbPath = endpointMotor and endpointMotor.path,
		offsetC0 = offsetC0,
		preAttachCFrame = preAttachCFrame,
		wasAnchored = wasAnchored == true,
	}
end

local function getDynamicAttachmentCFrame(timeline, objectTrack, value, frame)
	if not (timeline and objectTrack and type(objectTrack.path) == "string") then
		return nil
	end
	if type(timeline.isTrackDisabled) == "function" and timeline:isTrackDisabled(objectTrack.path) then
		return nil
	end
	if type(timeline.samplePose) ~= "function" then
		return nil
	end
	local pose = timeline:samplePose(frame)
	local cframe = type(pose) == "table" and pose[objectTrack.path] or nil
	if typeof(cframe) ~= "CFrame" then
		return nil
	end
	if typeof(value and value.preAttachCFrame) == "CFrame" and cframesClose(cframe, value.preAttachCFrame) then
		return nil
	end
	return cframe
end

local function applyAttachmentValue(value, dynamicCFrame)
	if not isAttachmentEventValue(value) or value.action ~= "Attach" then
		return false
	end

	local handPart = resolveInstance(value.handPartPath)
	local attachPart = resolveInstance(value.attachPartPath)
	local target = resolveInstance(value.objectPath) or attachPart
	if not handPart or not attachPart or not handPart:IsA("BasePart") or not attachPart:IsA("BasePart") then
		return false
	end

	local existing = findExistingAttachmentByObjectPath(value.objectPath) or findExistingAttachment(handPart, attachPart)
	if not existing then
		existing = Instance.new("Motor6D")
		existing.Name = "MegMoAttach_" .. sanitizeName(handPart.Name) .. "_" .. sanitizeName(value.objectName)
		existing.Part0 = handPart
		existing.Part1 = attachPart
		existing.C1 = CFrame.new()
		existing:SetAttribute(ATTACH_ATTRIBUTE, true)
		existing:SetAttribute(ATTACH_LIMB_PATH_ATTRIBUTE, tostring(value.limbPath or ""))
		existing:SetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE, tostring(value.objectPath or ""))
		existing:SetAttribute(ATTACH_WAS_ANCHORED_ATTRIBUTE, value.wasAnchored == true)

		local objectValue = Instance.new("ObjectValue")
		objectValue.Name = ATTACH_OBJECT_VALUE_NAME
		objectValue.Value = target
		objectValue.Parent = existing

		existing.Parent = handPart
		runtimeAttachmentMotorsMayExist = true
	else
		local objectValue = existing:FindFirstChild(ATTACH_OBJECT_VALUE_NAME)
		if objectValue and objectValue:IsA("ObjectValue") then
			objectValue.Value = target
		end
		runtimeAttachmentMotorsMayExist = true
	end

	existing.Part0 = handPart
	existing.Part1 = attachPart
	existing:SetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE, tostring(value.objectPath or ""))
	-- Keep the external attachment out of Roblox's joint solve while 7kg2
	-- aligns it. Otherwise changing an animated limb motor can hold Part1 in
	-- place and move the rig side of the chain instead.
	existing.Enabled = false
	existing.C0 = typeof(value.offsetC0) == "CFrame" and value.offsetC0 or handPart.CFrame:ToObjectSpace(attachPart.CFrame)
	existing.C1 = CFrame.new()
	attachPart.Anchored = false
	ensureAttachmentAssembly(target, attachPart, value.objectPath)
	if not (typeof(dynamicCFrame) == "CFrame" and setAttachedObjectCFrameSafely(target, attachPart, dynamicCFrame)) then
		attachPart.CFrame = handPart.CFrame * existing.C0 * existing.C1:Inverse()
	end
	existing.Enabled = true
	return true
end

local function removeAttachmentMotor(motor)
	if not motor or not motor.Parent then
		return false
	end
	local attachPart = motor.Part1
	local attachedObject = getAttachedObject(motor)
	local objectPath = getMotorObjectPath(motor)
	local wasAnchored = motor:GetAttribute(ATTACH_WAS_ANCHORED_ATTRIBUTE) == true
	motor:Destroy()
	removeAttachmentWelds(attachPart, objectPath, attachedObject)
	if attachPart and attachPart.Parent then
		attachPart.Anchored = wasAnchored
	end
	return true
end

function AttachService.clearRuntimeAttachments()
	local removedCount = 0
	for _, motor in ipairs(workspace:GetDescendants()) do
		if motor:IsA("Motor6D") and motor:GetAttribute(ATTACH_ATTRIBUTE) == true then
			if removeAttachmentMotor(motor) then
				removedCount += 1
			end
		end
	end
	runtimeAttachmentMotorsMayExist = false
	return removedCount
end

local function collectAttachmentEvents(timeline)
	local events = {}

	for _, track in ipairs(timeline:getTracks()) do
		if track.valueType == "Event" then
			local keyRefs = {}
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(track.path)) do
				table.insert(keyRefs, {
					jointPath = track.path,
					frame = frame,
				})
			end
			for _, key in ipairs(timeline:getTrackKeyValues(keyRefs)) do
				if isAttachmentEventValue(key.value) and key.value.objectPath then
					table.insert(events, {
						frame = key.frame,
						value = key.value,
					})
				end
			end
		end
	end

	table.sort(events, function(a, b)
		return a.frame &lt; b.frame
	end)
	return events
end

local function getAttachmentFrameState(timeline, frame)
	local latestByObjectPath = {}
	local knownObjectPaths = {}
	local preAttachValuesByObjectPath = {}

	for _, event in ipairs(collectAttachmentEvents(timeline)) do
		local value = event.value
		local objectPath = value and value.objectPath
		if objectPath then
			knownObjectPaths[objectPath] = knownObjectPaths[objectPath] or value
			if value.action == "Attach" and not preAttachValuesByObjectPath[objectPath] then
				preAttachValuesByObjectPath[objectPath] = value
			end
			if event.frame &lt;= frame then
				local current = latestByObjectPath[objectPath]
				if not current or event.frame &gt;= current.frame then
					latestByObjectPath[objectPath] = event
				end
			end
		end
	end

	return latestByObjectPath, knownObjectPaths, preAttachValuesByObjectPath
end

local function setAutomaticPreDetachHoldKey(timeline, objectTrack, attachEvent, detachFrame)
	if not (timeline and objectTrack and type(objectTrack.path) == "string" and attachEvent) then
		return false
	end

	local attachValue = attachEvent.value
	local preAttachCFrame = attachValue and attachValue.preAttachCFrame
	local attachFrame = math.max(0, math.floor(tonumber(attachEvent.frame or (attachValue and attachValue.frame)) or 0))
	detachFrame = math.max(0, math.floor(detachFrame or 0))
	local holdFrame = detachFrame - 1
	if typeof(preAttachCFrame) ~= "CFrame" or holdFrame &lt;= attachFrame then
		return false
	end

	for _, keyFrame in ipairs(timeline:getTrackKeyframeFrames(objectTrack.path)) do
		if keyFrame &gt; attachFrame and keyFrame &lt; detachFrame then
			return false
		end
	end

	local ok = timeline:setTrackValueAtFrame(
		objectTrack.path,
		holdFrame,
		preAttachCFrame,
		DEFAULT_EASING_STYLE,
		DEFAULT_EASING_DIRECTION
	)
	return ok == true
end

local function shouldSuppressFutureOnlyObjectTrack(timeline, objectTrack, frame)
	if not objectTrack or type(timeline.getTrackNeighborFrames) ~= "function" then
		return false
	end

	local previousFrame, nextFrame = timeline:getTrackNeighborFrames(objectTrack.path, frame)
	return previousFrame == nil and nextFrame ~= nil and nextFrame &gt; frame
end

local function getPreAttachCFrame(timeline, objectTrack, event)
	local value = event and event.value
	if value and typeof(value.preAttachCFrame) == "CFrame" then
		return value.preAttachCFrame
	end
	if timeline and objectTrack and event and event.frame ~= nil and type(timeline.getTrackValueAtFrame) == "function" then
		local trackValue = timeline:getTrackValueAtFrame(objectTrack.path, event.frame)
		if typeof(trackValue) == "CFrame" then
			return trackValue
		end
	end
	return nil
end

local function restorePreAttachCFrame(timeline, objectPath, value, objectTrack)
	value = value and value.value and value or {
		value = value,
		frame = value and value.frame,
	}
	local target = resolveInstance(objectPath)
	if not target and value.value then
		target = resolveInstance(value.value.attachPartPath)
	end
	local cframe = getPreAttachCFrame(timeline, objectTrack, value)
	if target and cframe then
		return setInstanceCFrame(target, cframe)
	end
	return false
end

local function queuePreAttachRestore(pendingRestores, timeline, objectPath, value, objectTrack, frame)
	if not shouldSuppressFutureOnlyObjectTrack(timeline, objectTrack, frame) then
		return false
	end

	table.insert(pendingRestores, {
		objectPath = objectPath,
		value = value,
		objectTrack = objectTrack,
	})
	return true
end

local function restoreQueuedPreAttachCFrames(timeline, pendingRestores)
	for _, item in ipairs(pendingRestores) do
		restorePreAttachCFrame(timeline, item.objectPath, item.value, item.objectTrack)
	end
end

function AttachService.restoreOriginalAttachmentObjects(timeline)
	if not timeline then
		return false, 0, AttachService.clearRuntimeAttachments()
	end

	local _, knownObjectPaths, preAttachValuesByObjectPath = getAttachmentFrameState(timeline, math.huge)
	local removedCount = AttachService.clearRuntimeAttachments()
	local restoredCount = 0

	for objectPath, value in pairs(knownObjectPaths) do
		local restoreValue = preAttachValuesByObjectPath[objectPath] or value
		local objectTrack = getAttachmentObjectTrack(timeline, objectPath, restoreValue)
		if restorePreAttachCFrame(timeline, objectPath, restoreValue, objectTrack) then
			restoredCount += 1
		end
	end

	if type(timeline.setSuppressedApplyPaths) == "function" then
		timeline:setSuppressedApplyPaths({})
	end

	return restoredCount &gt; 0 or removedCount &gt; 0, restoredCount, removedCount
end

local function removeInactiveMotors(knownObjectPaths, activeObjectPaths)
	if not next(knownObjectPaths) and not runtimeAttachmentMotorsMayExist then
		return 0
	end

	local foundRemaining = false
	local removedCount = 0
	local hasKnownObjects = next(knownObjectPaths) ~= nil
	for _, motor in ipairs(workspace:GetDescendants()) do
		if motor:IsA("Motor6D") and motor:GetAttribute(ATTACH_ATTRIBUTE) == true then
			local objectPath = getMotorObjectPath(motor)
			if not hasKnownObjects or not objectPath or not activeObjectPaths[objectPath] then
				if removeAttachmentMotor(motor) then
					removedCount += 1
				end
			else
				foundRemaining = true
			end
		end
	end
	runtimeAttachmentMotorsMayExist = foundRemaining
	return removedCount
end

local function getActiveAttachmentObjectPathsAtFrame(timeline, frame)
	local latestByObjectPath = getAttachmentFrameState(timeline, frame)
	local activeObjectPaths = {}
	for objectPath, event in pairs(latestByObjectPath) do
		local value = event and event.value
		if value and value.action == "Attach" then
			activeObjectPaths[objectPath] = true
		end
	end
	return activeObjectPaths
end

local function getMotorPart1(timeline, path)
	local motorData = timeline and type(timeline.getMotorByPath) == "function" and timeline:getMotorByPath(path) or nil
	local motor = motorData and motorData.instance
	if motor and motor:IsA("Motor6D") and motor.Part1 then
		return motor.Part1
	end
	return nil
end

local function getParentMotorForPart(timeline, part)
	if not (timeline and part) or type(timeline.getMotors) ~= "function" then
		return nil
	end
	for _, motorData in ipairs(timeline:getMotors() or {}) do
		local motor = motorData and motorData.instance
		if motor and motor:IsA("Motor6D") and motor.Part1 == part then
			return motor
		end
	end
	return nil
end

local function rigTrackCanAffectAttachmentLimb(timeline, rigTrackPath, limbPath)
	if type(rigTrackPath) ~= "string" or type(limbPath) ~= "string" then
		return false
	end
	if rigTrackPath == limbPath then
		return true
	end

	local selectedPart = getMotorPart1(timeline, rigTrackPath)
	local currentPart = getMotorPart1(timeline, limbPath)
	while selectedPart and currentPart do
		if currentPart == selectedPart then
			return true
		end
		local parentMotor = getParentMotorForPart(timeline, currentPart)
		if not parentMotor then
			break
		end
		currentPart = parentMotor.Part0
	end
	return false
end

function AttachService.getLinkedObjectTrackPathsForRigTrack(timeline, rigTrackPath, frame)
	if not (timeline and type(rigTrackPath) == "string") then
		return {}
	end

	frame = math.max(0, math.floor(frame or timeline:getCurrentFrame() or 0))
	local latestByObjectPath = getAttachmentFrameState(timeline, frame)
	local linkedPaths = {}
	local seen = {}

	for objectPath, event in pairs(latestByObjectPath) do
		local value = event and event.value
		if value
			and value.action == "Attach"
			and rigTrackCanAffectAttachmentLimb(timeline, rigTrackPath, value.limbPath) then
			local objectTrack = getAttachmentObjectTrack(timeline, objectPath, value)
			if not objectTrack then
				local target = resolveInstance(objectPath)
				if target then
					objectTrack = ensureObjectTrack(timeline, target)
					if objectTrack then
						value.objectTrackPath = objectTrack.path
					end
				end
			end
			local path = objectTrack and objectTrack.path
			if type(path) == "string" and path ~= rigTrackPath and not seen[path] then
				seen[path] = true
				table.insert(linkedPaths, path)
			end
		end
	end

	return linkedPaths
end

local function removeStaleMotorsForHand(timeline, handPart, frame, keepObjectPath, keepAttachPart)
	if not handPart then
		return 0
	end

	local activeObjectPaths = getActiveAttachmentObjectPathsAtFrame(timeline, frame)
	local removedCount = 0
	for _, child in ipairs(handPart:GetChildren()) do
		if child:IsA("Motor6D") and child:GetAttribute(ATTACH_ATTRIBUTE) == true then
			local objectPath = getMotorObjectPath(child)
			local isCurrentTarget = (keepObjectPath and objectPath == keepObjectPath) or (keepAttachPart and child.Part1 == keepAttachPart)
			local isActiveAtFrame = objectPath and activeObjectPaths[objectPath] == true
			if not isCurrentTarget and not isActiveAtFrame then
				if removeAttachmentMotor(child) then
					removedCount += 1
				end
			end
		end
	end

	if removedCount &gt; 0 then
		runtimeAttachmentMotorsMayExist = true
	end
	return removedCount
end

function AttachService.attachObject(options)
	options = options or {}
	local timeline = options.timeline
	if not timeline then
		return false, "Attach Object could not access the timeline.", {}
	end

	local attachMotor = getSelectedAttachMotor(timeline, options.selectedPath)
	if not attachMotor then
		return false, "Select a rig body-part track first.", {}
	end

	local attachJoint = attachMotor.instance
	local bodyPart = attachJoint and attachJoint.Part1
	if not attachJoint or not bodyPart then
		return false, "Attach Object needs a rig body part.", {}
	end

	local target, preferredAttachPart = findTarget(options.selection, attachMotor.rig)
	local attachPart = getAttachPart(target, preferredAttachPart)
	if not target or not attachPart then
		return false, "Select the prop/model you want to attach to the selected body part.", {}
	end
	if attachPart == bodyPart then
		return false, "Select a separate prop/object, not the body part itself.", {}
	end

	local frame = math.max(0, math.floor(options.frame or timeline:getCurrentFrame() or 0))
	local originalCFrame = getInstanceCFrame(target) or getInstanceCFrame(attachPart)
	local wasAnchored = attachPart.Anchored == true
	local targetPath = getFullName(target) or ""
	removeStaleMotorsForHand(timeline, bodyPart, frame, targetPath, attachPart)
	local motor = findExistingAttachment(bodyPart, attachPart)
	local wasAlreadyAttached = motor ~= nil
	if not motor then
		motor = Instance.new("Motor6D")
		motor.Name = "MegMoAttach_" .. sanitizeName(bodyPart.Name) .. "_" .. sanitizeName(target.Name)
		motor.Part0 = bodyPart
		motor.Part1 = attachPart
		motor.C0 = bodyPart.CFrame:ToObjectSpace(attachPart.CFrame)
		motor.C1 = CFrame.new()
		motor:SetAttribute(ATTACH_ATTRIBUTE, true)
		motor:SetAttribute(ATTACH_LIMB_PATH_ATTRIBUTE, tostring(attachMotor.path or ""))
		motor:SetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE, targetPath)
		motor:SetAttribute(ATTACH_WAS_ANCHORED_ATTRIBUTE, wasAnchored)

		local objectValue = Instance.new("ObjectValue")
		objectValue.Name = ATTACH_OBJECT_VALUE_NAME
		objectValue.Value = target
		objectValue.Parent = motor

		motor.Parent = bodyPart
	end
	motor:SetAttribute(ATTACH_OBJECT_PATH_ATTRIBUTE, targetPath)
	local objectValue = motor:FindFirstChild(ATTACH_OBJECT_VALUE_NAME)
	if not objectValue then
		objectValue = Instance.new("ObjectValue")
		objectValue.Name = ATTACH_OBJECT_VALUE_NAME
		objectValue.Parent = motor
	end
	if objectValue:IsA("ObjectValue") then
		objectValue.Value = target
	end
	runtimeAttachmentMotorsMayExist = true

	attachPart.Anchored = false
	ensureAttachmentAssembly(target, attachPart, targetPath)

	local objectTrack, holdKeyCount = setObjectPreAttachHoldKeys(timeline, target, frame, originalCFrame, attachPart)
	local eventTrack = ensureAttachmentEventTrack(timeline, target)
	local attachValue = createAttachmentValue(
		"Attach",
		frame,
		target,
		attachPart,
		attachMotor,
		motor.C0,
		wasAnchored,
		originalCFrame
	)
	attachValue.objectTrackPath = objectTrack and objectTrack.path or nil
	writeEventKey(timeline, eventTrack, frame, attachValue)

	local keyRefs = {}
	if objectTrack then
		table.insert(keyRefs, {
			jointPath = objectTrack.path,
			frame = frame,
		})
	end
	if eventTrack then
		table.insert(keyRefs, {
			jointPath = eventTrack.path,
			frame = frame,
		})
	end

	local holdText = holdKeyCount &gt; 0 and string.format(" Added %d hold key%s so it stays in place before attach.", holdKeyCount, holdKeyCount == 1 and "" or "s") or ""
	local message = wasAlreadyAttached
		and string.format("Added attach event for %s at frame %d.%s", target.Name, frame, holdText)
		or string.format("Attached %s to %s at frame %d.%s Add a detach event when you want to throw/release it.", target.Name, bodyPart.Name, frame, holdText)

	return true, message, {
		targetInstance = target,
		attachPart = attachPart,
		motor = motor,
		limbPath = attachMotor.path,
		objectTrack = objectTrack,
		eventTrack = eventTrack,
		keyRefs = keyRefs,
	}
end

function AttachService.detachObject(options)
	options = options or {}
	local timeline = options.timeline
	if not timeline then
		return false, "Detach Object could not access the timeline.", {}
	end

	local motor, target = findAttachmentByTarget(options.selection, timeline:getRig())
	if not motor and options.fallbackSelection then
		motor, target = findAttachmentByTarget(options.fallbackSelection, timeline:getRig())
	end
	if not motor then
		motor = findAttachmentByLimb(timeline, options.selectedPath)
	end
	if not motor or not motor.Parent then
		return false, "Select an attached prop or the attached body-part track first.", {}
	end

	target = target or getAttachedObject(motor)
	local attachPart = motor.Part1
	local targetCFrame = getInstanceCFrame(target) or getInstanceCFrame(attachPart)
	local wasAnchored = motor:GetAttribute(ATTACH_WAS_ANCHORED_ATTRIBUTE) == true
	local targetName = target and target.Name or (attachPart and attachPart.Name) or "object"
	local frame = math.max(0, math.floor(options.frame or timeline:getCurrentFrame() or 0))
	local objectTrack = target and setObjectBoundaryKey(timeline, target, frame, targetCFrame, attachPart) or nil
	if objectTrack and frame &gt; 0 then
		local objectPath = getFullName(target)
		local latestByObjectPath = getAttachmentFrameState(timeline, frame - 1)
		local attachEvent = objectPath and latestByObjectPath[objectPath] or nil
		if attachEvent and attachEvent.value and attachEvent.value.action == "Attach" then
			setAutomaticPreDetachHoldKey(timeline, objectTrack, attachEvent, frame)
		end
	end
	local eventTrack = target and ensureAttachmentEventTrack(timeline, target) or nil
	if eventTrack then
		writeEventKey(timeline, eventTrack, frame, {
			kind = EVENT_KIND,
			action = "Detach",
			frame = frame,
			objectName = targetName,
			objectPath = getFullName(target),
			attachPartPath = getFullName(attachPart),
			handPartPath = getFullName(motor.Part0),
			limbPath = motor:GetAttribute(ATTACH_LIMB_PATH_ATTRIBUTE),
			objectTrackPath = objectTrack and objectTrack.path or nil,
			wasAnchored = wasAnchored,
		})
	end

	local keyRefs = {}
	if objectTrack then
		table.insert(keyRefs, {
			jointPath = objectTrack.path,
			frame = frame,
		})
	end
	if eventTrack then
		table.insert(keyRefs, {
			jointPath = eventTrack.path,
			frame = frame,
		})
	end

	removeAttachmentMotor(motor)

	return true, string.format("Detached %s at frame %d and baked its world position.", targetName, frame), {
		targetInstance = target,
		attachPart = attachPart,
		targetCFrame = targetCFrame,
		objectTrack = objectTrack,
		eventTrack = eventTrack,
		keyRefs = keyRefs,
	}
end

function AttachService.prepareTimelineState(timeline, frame)
	if not timeline then
		return false, "Attachment events could not access the timeline."
	end

	frame = math.max(0, math.floor(frame or timeline:getCurrentFrame() or 0))
	local latestByObjectPath, knownObjectPaths, preAttachValuesByObjectPath = getAttachmentFrameState(timeline, frame)
	if not next(knownObjectPaths) and not runtimeAttachmentMotorsMayExist then
		if type(timeline.setSuppressedApplyPaths) == "function" then
			timeline:setSuppressedApplyPaths({})
		end
		return true
	end

	local activeObjectPaths = {}
	local suppressedApplyPaths = {}
	local pendingPreAttachRestores = {}

	for objectPath, event in pairs(latestByObjectPath) do
		local value = event.value
		if value and value.action == "Attach" then
			activeObjectPaths[objectPath] = true
			local objectTrack = getAttachmentObjectTrack(timeline, objectPath, value)
			if objectTrack then
				suppressedApplyPaths[objectTrack.path] = true
			end
			local motor = findExistingAttachmentByObjectPath(objectPath)
			if motor then
				-- Rig joints must be evaluated without the external attachment
				-- participating in the assembly solve. applyTimelineState
				-- realigns and re-enables it immediately after the pose.
				motor.Enabled = false
			end
		else
			local motor = findExistingAttachmentByObjectPath(objectPath)
			if motor then
				removeAttachmentMotor(motor)
			end
		end
	end
	for objectPath in pairs(knownObjectPaths) do
		if not activeObjectPaths[objectPath] then
			local restoreValue = preAttachValuesByObjectPath[objectPath] or knownObjectPaths[objectPath]
			local objectTrack = getAttachmentObjectTrack(timeline, objectPath, restoreValue)
			if queuePreAttachRestore(pendingPreAttachRestores, timeline, objectPath, restoreValue, objectTrack, frame) then
				suppressedApplyPaths[objectTrack.path] = true
			end
		end
	end

	removeInactiveMotors(knownObjectPaths, activeObjectPaths)
	restoreQueuedPreAttachCFrames(timeline, pendingPreAttachRestores)
	if type(timeline.setSuppressedApplyPaths) == "function" then
		timeline:setSuppressedApplyPaths(suppressedApplyPaths)
	end
	return true
end

function AttachService.applyTimelineState(timeline, frame)
	if not timeline then
		return false, "Attachment events could not access the timeline."
	end

	frame = math.max(0, math.floor(frame or timeline:getCurrentFrame() or 0))
	local latestByObjectPath, knownObjectPaths, preAttachValuesByObjectPath = getAttachmentFrameState(timeline, frame)
	if not next(knownObjectPaths) and not runtimeAttachmentMotorsMayExist then
		return true
	end

	local activeObjectPaths = {}
	local pendingPreAttachRestores = {}
	for objectPath, event in pairs(latestByObjectPath) do
		local value = event.value
		if value and value.action == "Attach" then
			activeObjectPaths[objectPath] = true
			-- The object's world-space CFrame track stays suppressed while attached.
			-- Applying captured world keys here rewrites the Motor6D C1 and makes
			-- the prop slide relative to the hand. Detach resumes the object track.
			applyAttachmentValue(value, nil)
		else
			local motor = findExistingAttachmentByObjectPath(objectPath)
			if motor then
				removeAttachmentMotor(motor)
			end
		end
	end
	for objectPath in pairs(knownObjectPaths) do
		if not activeObjectPaths[objectPath] then
			local value = preAttachValuesByObjectPath[objectPath] or knownObjectPaths[objectPath]
			local objectTrack = getAttachmentObjectTrack(timeline, objectPath, value)
			queuePreAttachRestore(pendingPreAttachRestores, timeline, objectPath, value, objectTrack, frame)
		end
	end

	removeInactiveMotors(knownObjectPaths, activeObjectPaths)
	restoreQueuedPreAttachCFrames(timeline, pendingPreAttachRestores)

	return true
end

AttachService.bakeCurrentFrame = AttachService.attachObject

return AttachService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX115">
        <Properties>
          <string name="Name">AudioClipVisualSupport</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local AudioClipVisualSupport = {}

local FADE_REGION_COLOR = Color3.fromRGB(5, 18, 26)
local FADE_MARKER_COLOR = Color3.fromRGB(255, 244, 170)
local STOP_HANDLE_COLOR = Color3.fromRGB(255, 248, 204)

local function safeNumber(value)
	return math.max(0, tonumber(value) or 0)
end

local function getFadeInSeconds(clip)
	if type(clip) ~= "table" then
		return 0
	end
	return safeNumber(clip.fadeInSeconds or clip.fadeIn or clip.audioFadeInSeconds)
end

local function getFadeOutSeconds(clip)
	if type(clip) ~= "table" then
		return 0
	end
	return safeNumber(clip.fadeOutSeconds or clip.fadeOut or clip.audioFadeOutSeconds)
end

local function formatSeconds(value)
	value = safeNumber(value)
	if value &lt;= 0 then
		return nil
	end
	if value &gt;= 10 or math.abs(value - math.floor(value + 0.5)) &lt; 0.01 then
		return string.format("%ds", math.floor(value + 0.5))
	end
	return string.format("%.1fs", value)
end

function AudioClipVisualSupport.buildTooltip(label, clip)
	local fadeInLabel = formatSeconds(getFadeInSeconds(clip))
	local fadeOutLabel = formatSeconds(getFadeOutSeconds(clip))
	if not fadeInLabel and not fadeOutLabel then
		return label
	end

	local lines = { label }
	if fadeInLabel then
		lines[#lines + 1] = "Fade in: " .. fadeInLabel
	end
	if fadeOutLabel then
		lines[#lines + 1] = "Fade out: " .. fadeOutLabel
	end
	return table.concat(lines, "\n")
end

function AudioClipVisualSupport.drawFadeIndicators(makeInstance, parent, clip, clipWidth, clipHeight, durationFrames, fps, zIndex)
	if type(makeInstance) ~= "function" or not parent then
		return
	end

	clipWidth = math.max(0, tonumber(clipWidth) or 0)
	clipHeight = math.max(0, tonumber(clipHeight) or 0)
	durationFrames = math.max(1, tonumber(durationFrames) or 1)
	fps = math.max(1, tonumber(fps) or 60)
	zIndex = tonumber(zIndex) or 10
	if clipWidth &lt; 14 or clipHeight &lt; 8 then
		return
	end

	local fadeInSeconds = getFadeInSeconds(clip)
	local fadeOutSeconds = getFadeOutSeconds(clip)
	if fadeInSeconds &lt;= 0 and fadeOutSeconds &lt;= 0 then
		return
	end

	local pixelsPerFrame = clipWidth / durationFrames
	local maxFadeWidth = math.max(0, (clipWidth - 8) * 0.5)
	local fadeInWidth = math.min(maxFadeWidth, fadeInSeconds * fps * pixelsPerFrame)
	local fadeOutWidth = math.min(maxFadeWidth, fadeOutSeconds * fps * pixelsPerFrame)

	local function addRegion(name, x, width)
		width = math.floor(math.max(0, width) + 0.5)
		if width &lt; 2 then
			return
		end
		makeInstance("Frame", {
			Name = name,
			Active = false,
			BackgroundColor3 = FADE_REGION_COLOR,
			BackgroundTransparency = 0.64,
			BorderSizePixel = 0,
			Parent = parent,
			Position = UDim2.fromOffset(math.floor(math.max(0, x) + 0.5), 0),
			Size = UDim2.fromOffset(width, clipHeight),
			ZIndex = zIndex,
		}, parent)
	end

	local function addMarker(name, x, transparency)
		x = math.clamp(math.floor(x + 0.5), 0, math.max(0, math.floor(clipWidth) - 2))
		makeInstance("Frame", {
			Name = name,
			Active = false,
			BackgroundColor3 = FADE_MARKER_COLOR,
			BackgroundTransparency = transparency or 0.08,
			BorderSizePixel = 0,
			Parent = parent,
			Position = UDim2.fromOffset(x, 2),
			Size = UDim2.fromOffset(2, math.max(6, clipHeight - 4)),
			ZIndex = zIndex + 1,
		}, parent)
	end

	if fadeInWidth &gt;= 2 then
		addRegion("FadeInRegion", 0, fadeInWidth)
		addMarker("FadeInStartMarker", 0, 0.5)
		addMarker("FadeInEndMarker", fadeInWidth, 0.08)
	end
	if fadeOutWidth &gt;= 2 then
		addRegion("FadeOutRegion", clipWidth - fadeOutWidth, fadeOutWidth)
		addMarker("FadeOutStartMarker", clipWidth - fadeOutWidth, 0.08)
		addMarker("FadeOutEndMarker", clipWidth - 2, 0.5)
	end
end

function AudioClipVisualSupport.attachStopHandle(config)
	config = config or {}
	local makeInstance = config.makeInstance
	local parent = config.parent
	local onSetStopFrame = config.onSetStopFrame
	if type(makeInstance) ~= "function" or not parent then
		return nil
	end

	local clipWidth = math.max(24, tonumber(config.clipWidth) or 24)
	local clipHeight = math.max(12, tonumber(config.clipHeight) or 18)
	local startFrame = math.max(0, math.floor(tonumber(config.startFrame) or 0))
	local visibleStartFrame = tonumber(config.visibleStartFrame) or 0
	local visibleFrameRange = math.max(1, tonumber(config.visibleFrameRange) or 1)
	local timelinePixelWidth = math.max(1, tonumber(config.timelinePixelWidth) or 1)
	local durationFrames = math.max(startFrame + 1, tonumber(config.durationFrames) or (startFrame + 1))
	local timelineLayer = config.timelineLayer
	local gutter = tonumber(config.gutter) or 0
	local targetFrame = math.max(startFrame + 1, math.floor(tonumber(config.endFrame) or (startFrame + 1)))
	local statusLabel = config.statusLabel
	local refresh = config.refresh
	local handleName = tostring(config.handleName or "SoundStopHandle")
	local statusPrefix = tostring(config.statusPrefix or "Audio stop")
	local missingCallbackMessage = tostring(config.missingCallbackMessage or "Audio stop handle is not connected yet. Restart Studio to load the latest 7kg2 build.")
	local attributePrefix = tostring(config.attributePrefix or "MegMoSoundStop")
	local draggingAttribute = attributePrefix .. "Dragging"
	local suppressClickAttribute = attributePrefix .. "SuppressClick"

	local handle = makeInstance("TextButton", {
		Name = handleName,
		Active = true,
		AutoButtonColor = true,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = STOP_HANDLE_COLOR,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Parent = parent,
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(math.min(14, math.max(9, math.floor(clipWidth * 0.22))), clipHeight),
		Font = Enum.Font.GothamBold,
		Text = "||",
		TextColor3 = Color3.fromRGB(5, 18, 26),
		TextSize = 10,
		TextTransparency = 0.08,
		ZIndex = (tonumber(config.zIndex) or 12) + 8,
	}, parent)
	makeInstance("Frame", {
		Name = "StopHandleLine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(5, 18, 26),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Parent = handle,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(2, math.max(8, clipHeight - 6)),
		ZIndex = handle.ZIndex + 1,
	}, handle)
	makeInstance("Frame", {
		Name = "StopHandleLeftEdge",
		BackgroundColor3 = Color3.fromRGB(5, 18, 26),
		BackgroundTransparency = 0.38,
		BorderSizePixel = 0,
		Parent = handle,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(1, clipHeight),
		ZIndex = handle.ZIndex + 1,
	}, handle)

	local dragging = false
	local inputChangedConnection
	local inputEndedConnection
	local destroyConnection

	local function disconnect()
		if inputChangedConnection then
			inputChangedConnection:Disconnect()
			inputChangedConnection = nil
		end
		if inputEndedConnection then
			inputEndedConnection:Disconnect()
			inputEndedConnection = nil
		end
		if destroyConnection then
			destroyConnection:Disconnect()
			destroyConnection = nil
		end
	end

	local function frameFromInput(input)
		local absoluteX = input and input.Position and input.Position.X or 0
		if type(config.frameFromScreenX) == "function" then
			return math.clamp(math.floor((tonumber(config.frameFromScreenX(absoluteX)) or startFrame + 1) + 0.5), startFrame + 1, durationFrames)
		end
		local layerX = timelineLayer and timelineLayer.AbsolutePosition.X or 0
		local alpha = (absoluteX - layerX - gutter) / timelinePixelWidth
		return math.clamp(math.floor(visibleStartFrame + (alpha * visibleFrameRange) + 0.5), startFrame + 1, durationFrames)
	end

	local function previewFrame(frame)
		targetFrame = math.clamp(math.floor(tonumber(frame) or targetFrame), startFrame + 1, durationFrames)
		local nextWidth = math.max(24, ((targetFrame - startFrame) / visibleFrameRange) * timelinePixelWidth)
		if type(config.onPreviewStopFrame) == "function" then
			config.onPreviewStopFrame(targetFrame, nextWidth, clipHeight)
		elseif parent and parent.Parent then
			parent.Size = UDim2.fromOffset(nextWidth, clipHeight)
		end
		if statusLabel then
			statusLabel.Text = string.format("%s: frame %d.", statusPrefix, targetFrame)
		end
	end

	local function finishDrag()
		if not dragging then
			return
		end
		dragging = false
		if parent and parent.Parent then
			parent:SetAttribute(draggingAttribute, false)
			parent:SetAttribute(suppressClickAttribute, true)
		end
		if type(onSetStopFrame) ~= "function" then
			if statusLabel then
				statusLabel.Text = missingCallbackMessage
			end
			task.delay(0.16, function()
				if parent and parent.Parent then
					parent:SetAttribute(suppressClickAttribute, false)
				end
			end)
			return
		end
		local ok, message = onSetStopFrame(config.trackPath, startFrame, targetFrame)
		if statusLabel and message then
			statusLabel.Text = tostring(message)
		end
		-- The drag preview changes the block before the edit is committed. Always
		-- redraw from the timeline so a rejected edit cannot look successful.
		if type(refresh) == "function" then
			task.defer(refresh)
		end
		task.delay(0.16, function()
			if parent and parent.Parent then
				parent:SetAttribute(suppressClickAttribute, false)
			end
		end)
	end

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if parent and parent.Parent then
			parent:SetAttribute(draggingAttribute, true)
			parent:SetAttribute(suppressClickAttribute, true)
		end
		dragging = true
		previewFrame(frameFromInput(input))
	end)
	handle.MouseButton1Down:Connect(function()
		if parent and parent.Parent then
			parent:SetAttribute(draggingAttribute, true)
			parent:SetAttribute(suppressClickAttribute, true)
		end
	end)

	inputChangedConnection = UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			previewFrame(frameFromInput(input))
		end
	end)
	inputEndedConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finishDrag()
		end
	end)
	destroyConnection = parent.Destroying:Connect(disconnect)
	return handle
end

return AudioClipVisualSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX116">
        <Properties>
          <string name="Name">AutoSaveStatusViewModel</string>
          <ProtectedString name="Source">local AutoSaveStatusViewModel = {}

function AutoSaveStatusViewModel.build(autoSaveState)
	local isPending = autoSaveState.changeToken &gt; autoSaveState.savedToken
	local label = "Ready"
	local state = "saved"
	if autoSaveState.lastErrorText then
		label = "Save failed"
		state = "error"
	elseif isPending then
		label = "Saving soon"
		state = "pending"
	elseif autoSaveState.lastSavedText then
		label = "Last " .. autoSaveState.lastSavedText
	end

	return {
		enabled = true,
		label = label,
		state = state,
		isPending = isPending,
	}
end

return AutoSaveStatusViewModel
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX117">
        <Properties>
          <string name="Name">BoneSkeletonOverlayService</string>
          <ProtectedString name="Source">local BoneSkeletonOverlayService = {}

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local BuildInfo = require(script.Parent:WaitForChild("BuildInfo"))
local PerformanceDebugService = require(script.Parent:WaitForChild("PerformanceDebugService"))
local RigService = require(script.Parent:WaitForChild("RigService"))

local FOLDER_NAME = "MegMoAnimatorBoneSkeletonOverlay"
local MESH_FOLDER_NAME = "MegMoAnimatorBoneSkeletonMeshes"
local BONE_MESH_TEMPLATE_NAME = "BoneMesh"
local BONE_MESH_ID = "rbxassetid://1320500139"
local NORMAL_BONE_COLOR = Color3.fromRGB(218, 128, 24)
local HOVER_BONE_COLOR = Color3.fromRGB(255, 174, 58)
local SELECTED_BONE_COLOR = Color3.fromRGB(80, 210, 255)
local MULTI_SELECTED_BONE_COLOR = Color3.fromRGB(255, 220, 90)

local MIN_JOINT_RADIUS = 0.035
local MAX_JOINT_RADIUS = 0.16
local MIN_BONE_RADIUS = 0.035
local MAX_BONE_RADIUS = 0.28
local MIN_SEGMENT_LENGTH = 0.001
local SHOULDER_FROM_JOINT_RATIO = 0.18
local HIT_JOINT_PIXELS = 16
local HIT_FINGER_JOINT_PIXELS = 20
local HIT_LINK_PIXELS = 12
local HIT_FINGER_LINK_PIXELS = 16
local MAX_HIT_JOINT_RADIUS = 0.38
local MAX_HIT_LINK_RADIUS = 0.34
local SCREEN_PICK_JOINT_PIXELS = 24
local SCREEN_PICK_LINK_PIXELS = 18

local BONE_HANDLE_STYLE = "MegMoBoneChain"
local BONE_DISPLAY_ATTRIBUTE = "MegMoBoneDisplayMode"
local BONE_DISPLAY_FULL = "Full"
local BONE_DISPLAY_JOINTS_ONLY = "JointsOnly"
local BoneHandleStyle = BONE_HANDLE_STYLE
local overlayFolder = nil
local meshFolder = nil
local visualsByPath = {}
local selectionCallbacks = {}
local hoveredPath = nil

local function buildBonePath(bone, rig)
	local segments = {}
	local cursor = bone

	while cursor and cursor ~= rig do
		table.insert(segments, 1, cursor.Name)
		cursor = cursor.Parent
	end

	return rig.Name .. "/" .. table.concat(segments, "/")
end

local function getRigScale(rig)
	if not (rig and rig.Parent and rig:IsA("Model")) then
		return 1
	end

	local ok, scale = pcall(function()
		return rig:GetScale()
	end)
	return ok and type(scale) == "number" and scale &gt; 0 and scale or 1
end

local function buildBoneMotorData(bone, rig, rigScale)
	local path = buildBonePath(bone, rig)
	local parentTrackPath = nil
	if bone.Parent and bone.Parent:IsA("Bone") then
		parentTrackPath = buildBonePath(bone.Parent, rig)
	end

	return {
		name = bone.Name,
		path = path,
		rig = rig,
		rigName = rig.Name,
		instance = bone,
		part0 = bone.Parent and bone.Parent.Name or "nil",
		part1 = bone.Name,
		jointType = "Bone",
		isBone = true,
		parentTrackPath = parentTrackPath,
		rigScale = rigScale,
	}
end

local function collectBoneMotorData(timeline)
	if timeline and type(timeline.syncRigMotorsFromWorkspace) == "function" then
		pcall(function()
			timeline:syncRigMotorsFromWorkspace({
				bonesOnly = true,
			})
		end)
	end

	local motors = {}
	local seenPaths = {}
	local sourceMotors = timeline and type(timeline.getMotors) == "function" and timeline:getMotors() or {}
	for _, motorData in ipairs(sourceMotors) do
		if RigService.isBoneJoint(motorData) and motorData.path then
			table.insert(motors, motorData)
			seenPaths[tostring(motorData.path)] = true
		end
	end

	local rigs = timeline and type(timeline.getRigs) == "function" and timeline:getRigs() or {}
	local seenRigs = {}
	for _, rig in ipairs(rigs) do
		if rig then
			seenRigs[rig] = true
		end
	end
	for _, motorData in ipairs(sourceMotors) do
		local rig = motorData and motorData.rig
		if rig and not seenRigs[rig] then
			table.insert(rigs, rig)
			seenRigs[rig] = true
		end
	end

	for _, rig in ipairs(rigs) do
		if rig and rig.Parent then
			local rigScale = getRigScale(rig)
			for _, descendant in ipairs(rig:GetDescendants()) do
				if descendant:IsA("Bone") then
					local path = buildBonePath(descendant, rig)
					if not seenPaths[path] then
						table.insert(motors, buildBoneMotorData(descendant, rig, rigScale))
						seenPaths[path] = true
					end
				end
			end
		end
	end

	return motors
end

local function getOverlayFolder()
	if overlayFolder and overlayFolder.Parent then
		return overlayFolder
	end

	local existing = CoreGui:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		overlayFolder = existing
	else
		overlayFolder = Instance.new("Folder")
		overlayFolder.Name = FOLDER_NAME
		overlayFolder.Archivable = false
		overlayFolder.Parent = CoreGui
	end
	overlayFolder:SetAttribute("MegMoBuildId", BuildInfo.BUILD_ID)
	overlayFolder:SetAttribute("BoneHandleStyle", BoneHandleStyle)
	return overlayFolder
end

local function getMeshFolder()
	if meshFolder and meshFolder.Parent then
		return meshFolder
	end

	local existing = workspace:FindFirstChild(MESH_FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		meshFolder = existing
	else
		meshFolder = Instance.new("Folder")
		meshFolder.Name = MESH_FOLDER_NAME
		meshFolder.Archivable = false
		meshFolder.Parent = workspace
	end
	meshFolder:SetAttribute("MegMoBuildId", BuildInfo.BUILD_ID)
	meshFolder:SetAttribute("BoneHandleStyle", BoneHandleStyle)
	return meshFolder
end

local function findBoneMeshTemplate()
	local template = workspace:FindFirstChild(BONE_MESH_TEMPLATE_NAME, true)
	if template and template:IsA("MeshPart") then
		return template
	end
	return nil
end

local function configureVisibleMeshPart(part)
	part.Archivable = false
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Locked = true
	part.CastShadow = false
	part.Color = NORMAL_BONE_COLOR
	part.Material = Enum.Material.SmoothPlastic
	part.Transparency = 0.22
	part.Parent = getMeshFolder()
	return part
end

local function createVisibleBoneMesh(name)
	local template = findBoneMeshTemplate()
	if template then
		local part = template:Clone()
		part.Name = name
		return configureVisibleMeshPart(part)
	end

	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "BoneMeshFile"
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = BONE_MESH_ID
	mesh.Parent = part
	return configureVisibleMeshPart(part)
end

local function pixelsToStuds(worldPos, pixels)
	local camera = workspace.CurrentCamera
	if not camera then
		return 0.08
	end

	local viewportY = math.max(1, camera.ViewportSize.Y)
	local distance = (camera.CFrame.Position - worldPos).Magnitude
	local worldHeight = 2 * distance * math.tan(math.rad(camera.FieldOfView) * 0.5)
	return (worldHeight / viewportY) * pixels
end

local function safeClamp(value, minValue, maxValue)
	if maxValue &lt; minValue then
		return minValue
	end
	return math.clamp(value, minValue, maxValue)
end

local function makeSegmentCFrame(fromPos, toPos)
	local delta = toPos - fromPos
	local length = delta.Magnitude
	if length &lt; MIN_SEGMENT_LENGTH then
		return CFrame.new(fromPos), 0
	end

	local dir = delta.Unit
	local up = math.abs(dir:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.xAxis or Vector3.yAxis
	local right = up:Cross(dir).Unit
	local correctedUp = dir:Cross(right).Unit
	local mid = fromPos:Lerp(toPos, 0.5)

	return CFrame.fromMatrix(mid, right, correctedUp, dir), length
end

local function makeLookCFrame(position, lookDirection)
	local look = lookDirection.Magnitude &gt; MIN_SEGMENT_LENGTH and lookDirection.Unit or Vector3.zAxis
	local back = -look
	local up = math.abs(back:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.xAxis or Vector3.yAxis
	local right = up:Cross(back).Unit
	local correctedUp = back:Cross(right).Unit
	return CFrame.fromMatrix(position, right, correctedUp, back)
end

local function makeYAxisCFrame(position, yDirection)
	local up = yDirection.Magnitude &gt; MIN_SEGMENT_LENGTH and yDirection.Unit or Vector3.yAxis
	local fallback = math.abs(up:Dot(Vector3.yAxis)) &gt; 0.94 and Vector3.xAxis or Vector3.yAxis
	local right = fallback:Cross(up).Unit
	local back = right:Cross(up).Unit
	return CFrame.fromMatrix(position, right, up, back)
end

local function isFingerBone(motorData)
	local name = string.lower(tostring((motorData and (motorData.name or motorData.path)) or ""))
	return string.find(name, "finger", 1, true) ~= nil
		or string.find(name, "thumb", 1, true) ~= nil
		or string.find(name, "index", 1, true) ~= nil
		or string.find(name, "middle", 1, true) ~= nil
		or string.find(name, "ring", 1, true) ~= nil
		or string.find(name, "pinky", 1, true) ~= nil
		or string.find(name, "little", 1, true) ~= nil
end

local function isPathSelected(path)
	if type(selectionCallbacks.isPathSelected) == "function" then
		local ok, selected = pcall(selectionCallbacks.isPathSelected, path)
		return ok and selected == true
	end

	if type(selectionCallbacks.getSelectedPath) == "function" then
		local ok, selectedPath = pcall(selectionCallbacks.getSelectedPath)
		if ok and selectedPath == path then
			return true
		end
	end

	return false
end

local function getSelectedCount()
	if type(selectionCallbacks.getSelectedCount) == "function" then
		local ok, count = pcall(selectionCallbacks.getSelectedCount)
		if ok and tonumber(count) then
			return tonumber(count)
		end
	end
	return 0
end

local function getBoneColor(path)
	if isPathSelected(path) then
		if getSelectedCount() &gt; 1 then
			return MULTI_SELECTED_BONE_COLOR
		end
		return SELECTED_BONE_COLOR
	end

	if hoveredPath == path then
		return HOVER_BONE_COLOR
	end

	return NORMAL_BONE_COLOR
end

local function getBoneTransparency(path, fingerBone)
	if isPathSelected(path) or hoveredPath == path then
		return 0.06
	end
	return fingerBone and 0.28 or 0.18
end

local function makeProxy(name)
	local proxy = Instance.new("Part")
	proxy.Name = name
	proxy.Archivable = false
	proxy.Anchored = true
	proxy.CanCollide = false
	proxy.CanTouch = false
	proxy.CanQuery = false
	proxy.Locked = true
	proxy.Transparency = 1
	proxy.Size = Vector3.new(0.05, 0.05, 0.05)
	proxy.Parent = getOverlayFolder()
	return proxy
end

local function configureBaseAdornment(adornment, adornee, color, transparency, zIndex)
	adornment.Adornee = adornee
	adornment.AlwaysOnTop = true
	adornment.Color3 = color
	adornment.Transparency = transparency
	adornment.ZIndex = zIndex
	adornment.Parent = getOverlayFolder()
	return adornment
end

local function updateVisualColors(visual)
	if not visual then
		return
	end

	local color = getBoneColor(visual.path)
	local fingerBone = visual.fingerBone == true
	local visibleTransparency = getBoneTransparency(visual.path, fingerBone)
	local selected = isPathSelected(visual.path)
	local hovered = hoveredPath == visual.path

	if visual.jointSphere then
		visual.jointSphere.Color3 = color
		visual.jointSphere.Transparency = (selected or hovered) and 0.04 or visibleTransparency
	end
	if visual.linkCone then
		visual.linkCone.Color3 = color
		visual.linkCone.Transparency = (selected or hovered) and 0.12 or (fingerBone and 0.58 or 0.52)
	end
	if visual.upperCone then
		visual.upperCone.Color3 = color
		visual.upperCone.Transparency = (selected or hovered) and 0.08 or (fingerBone and 0.3 or 0.22)
	end
	if visual.boneMesh then
		visual.boneMesh.Color = color
		visual.boneMesh.Transparency = (selected or hovered) and 0.08 or math.min(0.42, visibleTransparency + 0.08)
	end
end

local function setHoverPath(path)
	if hoveredPath == path then
		return
	end

	local previous = hoveredPath
	hoveredPath = path
	if previous and visualsByPath[previous] then
		updateVisualColors(visualsByPath[previous])
	end
	if path and visualsByPath[path] then
		updateVisualColors(visualsByPath[path])
	end
end

local function runSelection(path)
	local targetPath = path
	local camera = workspace.CurrentCamera
	if camera then
		local mouse = UserInputService:GetMouseLocation()
		local mousePoint = Vector2.new(mouse.X, mouse.Y)
		local bestPath = nil
		local bestScore = math.huge

		local function getScreenPoint(worldPosition)
			if typeof(worldPosition) ~= "Vector3" then
				return nil
			end
			local screenPosition = camera:WorldToViewportPoint(worldPosition)
			if screenPosition.Z &lt;= 0 then
				return nil
			end
			return Vector2.new(screenPosition.X, screenPosition.Y)
		end

		local function distanceToSegment(point, startPoint, endPoint)
			local segment = endPoint - startPoint
			local lengthSquared = segment:Dot(segment)
			if lengthSquared &lt;= 0.0001 then
				return (point - startPoint).Magnitude
			end
			local t = math.clamp((point - startPoint):Dot(segment) / lengthSquared, 0, 1)
			return (point - (startPoint + segment * t)).Magnitude
		end

		for candidatePath, visual in pairs(visualsByPath) do
			local fingerBonus = visual.fingerBone and 1.2 or 1
			local jointScreen = getScreenPoint(visual.jointWorldPosition)
			if jointScreen then
				local jointThreshold = SCREEN_PICK_JOINT_PIXELS * fingerBonus
				local distance = (mousePoint - jointScreen).Magnitude
				if distance &lt;= jointThreshold then
					local score = distance / jointThreshold
					if score &lt; bestScore then
						bestScore = score
						bestPath = candidatePath
					end
				end
			end

			local linkStart = getScreenPoint(visual.linkStartWorldPosition)
			local linkEnd = getScreenPoint(visual.linkEndWorldPosition)
			if linkStart and linkEnd then
				local linkThreshold = SCREEN_PICK_LINK_PIXELS * fingerBonus
				local distance = distanceToSegment(mousePoint, linkStart, linkEnd)
				if distance &lt;= linkThreshold then
					local score = (distance / linkThreshold) + 0.08
					if score &lt; bestScore then
						bestScore = score
						bestPath = candidatePath
					end
				end
			end
		end

		targetPath = bestPath or targetPath
	end

	if type(selectionCallbacks.shouldIgnoreClick) == "function" then
		local ok, ignored = pcall(selectionCallbacks.shouldIgnoreClick, targetPath)
		if ok and ignored == true then
			return
		end
	end

	local additive = false
	if type(selectionCallbacks.isAdditiveSelectionActive) == "function" then
		local ok, result = pcall(selectionCallbacks.isAdditiveSelectionActive)
		additive = ok and result == true
	end

	if type(selectionCallbacks.selectPath) == "function" then
		pcall(selectionCallbacks.selectPath, targetPath, additive)
	end
	if type(selectionCallbacks.afterSelect) == "function" then
		pcall(selectionCallbacks.afterSelect, targetPath, additive)
	end
end

local function connectHitVisual(visual, adornment)
	if not (visual and adornment) then
		return
	end

	table.insert(visual.connections, adornment.MouseEnter:Connect(function()
		setHoverPath(visual.path)
	end))
	table.insert(visual.connections, adornment.MouseLeave:Connect(function()
		if hoveredPath == visual.path then
			setHoverPath(nil)
		end
	end))
	table.insert(visual.connections, adornment.MouseButton1Down:Connect(function()
		runSelection(visual.path)
	end))
end

local function createVisual(path, motorData)
	local jointProxy = makeProxy("BoneJointProxy_" .. string.gsub(path, "[^%w_]+", "_"))
	local linkProxy = makeProxy("BoneLinkProxy_" .. string.gsub(path, "[^%w_]+", "_"))
	local upperProxy = makeProxy("BoneUpperProxy_" .. string.gsub(path, "[^%w_]+", "_"))
	local visual = {
		jointProxy = jointProxy,
		linkProxy = linkProxy,
		upperProxy = upperProxy,
		boneMesh = nil,
		jointSphere = nil,
		linkCone = nil,
		upperCone = nil,
		hitJointSphere = nil,
		hitLinkCylinder = nil,
		hitLinkSphere = nil,
		path = path,
		motorData = motorData,
		connections = {},
		fingerBone = isFingerBone(motorData),
	}

	visual.jointSphere = configureBaseAdornment(Instance.new("SphereHandleAdornment"), jointProxy, NORMAL_BONE_COLOR, 0.18, 5)
	visual.linkCone = configureBaseAdornment(Instance.new("ConeHandleAdornment"), linkProxy, NORMAL_BONE_COLOR, 0.28, 3)
	visual.upperCone = configureBaseAdornment(Instance.new("ConeHandleAdornment"), upperProxy, NORMAL_BONE_COLOR, 0.28, 4)
	visual.hitJointSphere = configureBaseAdornment(Instance.new("SphereHandleAdornment"), jointProxy, NORMAL_BONE_COLOR, 0.99, 10)
	visual.hitLinkCylinder = configureBaseAdornment(Instance.new("CylinderHandleAdornment"), linkProxy, NORMAL_BONE_COLOR, 0.99, 9)
	visual.hitLinkSphere = configureBaseAdornment(Instance.new("SphereHandleAdornment"), linkProxy, NORMAL_BONE_COLOR, 0.99, 10)

	visual.jointSphere.Name = "BoneJoint"
	visual.linkCone.Name = "BoneLink"
	visual.upperCone.Name = "BoneUpperLink"
	visual.hitJointSphere.Name = "BoneJointHit"
	visual.hitLinkCylinder.Name = "BoneLinkHit"
	visual.hitLinkSphere.Name = "BoneLinkMidHit"

	connectHitVisual(visual, visual.hitJointSphere)
	connectHitVisual(visual, visual.hitLinkCylinder)
	connectHitVisual(visual, visual.hitLinkSphere)

	visualsByPath[path] = visual
	return visual
end

local function destroyVisual(visual)
	if not visual then
		return
	end

	for _, connection in ipairs(visual.connections or {}) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end

	for _, field in ipairs({
		"jointSphere",
		"linkCone",
		"upperCone",
		"hitJointSphere",
		"hitLinkCylinder",
		"hitLinkSphere",
		"boneMesh",
		"jointProxy",
		"linkProxy",
		"upperProxy",
	}) do
		local instance = visual[field]
		if instance and instance.Parent then
			instance:Destroy()
		end
	end
end

local function getJointCFrame(motorData)
	local ok, cframe = pcall(function()
		return RigService.getJointWorldCFrame(motorData)
	end)
	return ok and typeof(cframe) == "CFrame" and cframe or nil
end

local function getParentBoneCFrame(motorData)
	local bone = motorData and motorData.instance
	if not (bone and bone.Parent and bone:IsA("Bone") and bone.Parent:IsA("Bone")) then
		return nil
	end

	return getJointCFrame({
		name = bone.Parent.Name,
		instance = bone.Parent,
		jointType = "Bone",
		isBone = true,
	})
end

local function getBestChildCFrame(motorData, jointCFrame)
	local bone = motorData and motorData.instance
	if not (bone and bone.Parent and bone:IsA("Bone")) then
		return nil
	end

	local bestCFrame = nil
	local bestScore = -math.huge
	local jointPosition = jointCFrame.Position
	for _, child in ipairs(bone:GetChildren()) do
		if child:IsA("Bone") then
			local childCFrame = getJointCFrame({
				name = child.Name,
				instance = child,
				jointType = "Bone",
				isBone = true,
			})
			if childCFrame then
				local delta = childCFrame.Position - jointPosition
				local distance = delta.Magnitude
				if distance &gt; MIN_SEGMENT_LENGTH then
					local directionScore = math.abs(delta.Unit:Dot(jointCFrame.UpVector))
					local score = directionScore + (distance * 0.01)
					if score &gt; bestScore then
						bestScore = score
						bestCFrame = childCFrame
					end
				end
			end
		end
	end

	return bestCFrame
end

local function updateVisual(visual, motorData)
	local jointCFrame = getJointCFrame(motorData)
	if not jointCFrame then
		return false
	end

	visual.motorData = motorData
	visual.fingerBone = isFingerBone(motorData)

	local jointPosition = jointCFrame.Position
	local jointRadius = math.clamp(pixelsToStuds(jointPosition, 6), MIN_JOINT_RADIUS, MAX_JOINT_RADIUS)
	if visual.fingerBone then
		jointRadius = math.max(MIN_JOINT_RADIUS, jointRadius * 0.72)
	end
	local jointHitPixels = visual.fingerBone and HIT_FINGER_JOINT_PIXELS or HIT_JOINT_PIXELS
	local hitJointRadius = safeClamp(
		math.max(jointRadius * 2.45, pixelsToStuds(jointPosition, jointHitPixels)),
		jointRadius * 2.25,
		MAX_HIT_JOINT_RADIUS
	)

	visual.jointWorldPosition = jointPosition
	visual.linkStartWorldPosition = nil
	visual.linkEndWorldPosition = nil
	visual.jointProxy.CFrame = jointCFrame
	visual.jointProxy.Size = Vector3.new(jointRadius * 2, jointRadius * 2, jointRadius * 2)
	visual.jointSphere.Radius = jointRadius
	visual.jointSphere.Visible = true
	visual.hitJointSphere.Radius = hitJointRadius
	visual.hitJointSphere.Visible = true

	local parentCFrame = getParentBoneCFrame(motorData)
	local jointsOnly = motorData.rig
		and motorData.rig:GetAttribute(BONE_DISPLAY_ATTRIBUTE) == BONE_DISPLAY_JOINTS_ONLY
	if parentCFrame and not jointsOnly then
		local startPosition = parentCFrame.Position
		local endPosition = jointPosition
		local segmentCFrame, length = makeSegmentCFrame(startPosition, endPosition)
		local mid = startPosition:Lerp(endPosition, 0.5)
		if length &lt;= MIN_SEGMENT_LENGTH then
			visual.linkProxy.CFrame = jointCFrame
			visual.upperProxy.CFrame = jointCFrame
			visual.linkCone.Visible = false
			visual.upperCone.Visible = false
			visual.hitLinkCylinder.Visible = false
			visual.hitLinkSphere.Visible = false
			if visual.boneMesh then
				visual.boneMesh.Parent = nil
			end
			updateVisualColors(visual)
			return true
		end

		local maxBoneRadius = math.max(MIN_BONE_RADIUS, math.min(MAX_BONE_RADIUS, length * 0.26))
		local boneRadius = math.clamp(pixelsToStuds(mid, 9), MIN_BONE_RADIUS, maxBoneRadius)
		if visual.fingerBone then
			local fingerMinRadius = MIN_BONE_RADIUS * 0.55
			local fingerMaxRadius = math.max(fingerMinRadius, math.min(maxBoneRadius, length * 0.18))
			boneRadius = math.clamp(boneRadius * 0.58, fingerMinRadius, fingerMaxRadius)
		end
		local linkHitPixels = visual.fingerBone and HIT_FINGER_LINK_PIXELS or HIT_LINK_PIXELS
		local hitLinkMinRadius = boneRadius * (visual.fingerBone and 3.2 or 2.8)
		local hitLinkMaxRadius = math.max(hitLinkMinRadius, math.min(MAX_HIT_LINK_RADIUS, length * (visual.fingerBone and 0.95 or 0.75)))
		local hitLinkRadius = safeClamp(
			math.max(hitLinkMinRadius, pixelsToStuds(mid, linkHitPixels)),
			hitLinkMinRadius,
			hitLinkMaxRadius
		)

		local linkVisible = length &gt;= math.max(0.015, pixelsToStuds(mid, 2.5))
		local coneTipLength = math.clamp(length * 0.1, math.min(0.01, length), length)
		local coneShaftLength = math.max(0.01, length - coneTipLength)
		local carrierCFrame = CFrame.new(mid, endPosition)
		local carrierSize = Vector3.new(
			math.max(0.01, boneRadius * 2),
			math.max(0.01, boneRadius * 2),
			math.max(0.01, length)
		)
		visual.linkStartWorldPosition = startPosition
		visual.linkEndWorldPosition = endPosition

		visual.linkProxy.CFrame = carrierCFrame
		visual.linkProxy.Size = carrierSize
		visual.linkCone.Height = coneShaftLength
		visual.linkCone.Radius = boneRadius
		visual.linkCone.CFrame = CFrame.new()
		visual.linkCone.SizeRelativeOffset = Vector3.new(0, 0, 0.8)
		visual.linkCone.Visible = linkVisible

		visual.upperProxy.CFrame = carrierCFrame
		visual.upperProxy.Size = carrierSize
		visual.upperCone.Height = coneTipLength
		visual.upperCone.Radius = boneRadius
		visual.upperCone.CFrame = CFrame.Angles(0, math.pi, 0)
		visual.upperCone.SizeRelativeOffset = Vector3.new(0, 0, 0.8)
		visual.upperCone.Visible = linkVisible

		if visual.boneMesh then
			visual.boneMesh.Parent = nil
		end

		visual.hitLinkCylinder.Adornee = visual.linkProxy
		visual.hitLinkCylinder.CFrame = visual.linkProxy.CFrame:ToObjectSpace(segmentCFrame)
		visual.hitLinkCylinder.Height = math.max(0.01, length)
		visual.hitLinkCylinder.Radius = hitLinkRadius
		visual.hitLinkCylinder.Visible = linkVisible
		visual.hitLinkSphere.Adornee = visual.linkProxy
		visual.hitLinkSphere.CFrame = visual.linkProxy.CFrame:ToObjectSpace(CFrame.new(mid))
		visual.hitLinkSphere.Radius = math.max(hitLinkRadius, hitJointRadius * 0.68)
		visual.hitLinkSphere.Visible = linkVisible
	else
		visual.linkProxy.CFrame = jointCFrame
		visual.upperProxy.CFrame = jointCFrame
		visual.linkCone.Visible = false
		visual.upperCone.Visible = false
		visual.hitLinkCylinder.Visible = false
		visual.hitLinkSphere.Visible = false
		if visual.boneMesh then
			visual.boneMesh.Parent = nil
		end
	end

	updateVisualColors(visual)
	return true
end

function BoneSkeletonOverlayService.setSelectionCallbacks(callbacks)
	selectionCallbacks = callbacks or {}
end

function BoneSkeletonOverlayService.setStyle(style)
	if style == BONE_HANDLE_STYLE then
		BoneHandleStyle = style
	end
	return BoneHandleStyle
end

function BoneSkeletonOverlayService.getStyle()
	return BoneHandleStyle
end

function BoneSkeletonOverlayService.hasBones(rig)
	return rig ~= nil
		and rig.Parent ~= nil
		and rig:IsA("Model")
		and rig:FindFirstChildWhichIsA("Bone", true) ~= nil
end

function BoneSkeletonOverlayService.getRigDisplayMode(rig)
	if not BoneSkeletonOverlayService.hasBones(rig) then
		return nil
	end
	if rig:GetAttribute(BONE_DISPLAY_ATTRIBUTE) == BONE_DISPLAY_JOINTS_ONLY then
		return BONE_DISPLAY_JOINTS_ONLY
	end
	return BONE_DISPLAY_FULL
end

function BoneSkeletonOverlayService.setRigDisplayMode(rig, mode)
	if not BoneSkeletonOverlayService.hasBones(rig) then
		return false
	end
	rig:SetAttribute(
		BONE_DISPLAY_ATTRIBUTE,
		mode == BONE_DISPLAY_JOINTS_ONLY and BONE_DISPLAY_JOINTS_ONLY or BONE_DISPLAY_FULL
	)
	return true
end

BoneSkeletonOverlayService.DISPLAY_MODE_FULL = BONE_DISPLAY_FULL
BoneSkeletonOverlayService.DISPLAY_MODE_JOINTS_ONLY = BONE_DISPLAY_JOINTS_ONLY

function BoneSkeletonOverlayService.refresh(timeline)
	if BoneHandleStyle ~= BONE_HANDLE_STYLE then
		return
	end

	local perfToken = PerformanceDebugService.begin("Bone Overlay Refresh")
	local motors = collectBoneMotorData(timeline)
	local folder = getOverlayFolder()
	folder:SetAttribute("DiscoveredBoneMotors", #motors)
	local seen = {}
	local updatedCount = 0

	for _, motorData in ipairs(motors) do
		if RigService.isBoneJoint(motorData) then
			local path = tostring(motorData.path or "")
			if path ~= "" then
				local visual = visualsByPath[path] or createVisual(path, motorData)
				local okUpdate, updated = pcall(updateVisual, visual, motorData)
				if okUpdate and updated then
					seen[path] = true
					updatedCount += 1
				elseif not okUpdate then
					local folder = getOverlayFolder()
					folder:SetAttribute("LastBoneOverlayErrorPath", path)
					folder:SetAttribute("LastBoneOverlayError", tostring(updated))
				end
			end
		end
	end

	for path, visual in pairs(visualsByPath) do
		if not seen[path] then
			visualsByPath[path] = nil
			if hoveredPath == path then
				hoveredPath = nil
			end
			destroyVisual(visual)
		end
	end
	PerformanceDebugService.finish(perfToken, string.format("%d discovered, %d updated", #motors, updatedCount))
end

function BoneSkeletonOverlayService.clear()
	for path, visual in pairs(visualsByPath) do
		visualsByPath[path] = nil
		destroyVisual(visual)
	end
	hoveredPath = nil

	if overlayFolder and overlayFolder.Parent then
		overlayFolder:Destroy()
	end
	overlayFolder = nil
	if meshFolder and meshFolder.Parent then
		meshFolder:Destroy()
	end
	meshFolder = nil

	local existing = CoreGui:FindFirstChild(FOLDER_NAME)
	if existing then
		existing:Destroy()
	end
	local existingMeshFolder = workspace:FindFirstChild(MESH_FOLDER_NAME)
	if existingMeshFolder then
		existingMeshFolder:Destroy()
	end
end

return BoneSkeletonOverlayService
</ProtectedString>
        </Properties>
