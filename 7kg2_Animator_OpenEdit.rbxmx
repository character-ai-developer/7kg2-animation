      </Item>
      <Item class="ModuleScript" referent="RBX143">
        <Properties>
          <string name="Name">ImportFinalizeSupport</string>
          <ProtectedString name="Source">local ImportFinalizeSupport = {}

function ImportFinalizeSupport.handleImportFailure(historyService, message, importTypeLabel)
	historyService:discardPendingUndo()
	warn(string.format("[7kg2 Animator] %s failed: %s", importTypeLabel, tostring(message)))
	return message
end

function ImportFinalizeSupport.finalizeImport(timeline, targetRigName, keyframeEditService, rebuildGroupMembership, widgetController)
	local ImportSelectionSupport = require(script.Parent:WaitForChild("ImportSelectionSupport"))
	local selectedJointPath, selectedTrackPaths = ImportSelectionSupport.applyImportedRigSelection(timeline, targetRigName)
	keyframeEditService:resetGroups()
	rebuildGroupMembership()
	timeline:applyCurrentFrame()
	if type(widgetController.stabilizeTimelineAfterImport) == "function" then
		widgetController:stabilizeTimelineAfterImport()
	end
	return selectedJointPath, selectedTrackPaths
end

return ImportFinalizeSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX144">
        <Properties>
          <string name="Name">ImportSelectionSupport</string>
          <ProtectedString name="Source">local ImportSelectionSupport = {}

function ImportSelectionSupport.applyImportedRigSelection(timeline, targetRigName)
	local selectedJointPath = nil
	local selectedTrackPaths = {}
	local firstMotor = nil
	for _, motorData in ipairs(timeline:getMotors()) do
		if not targetRigName or motorData.rigName == targetRigName then
			firstMotor = motorData
			break
		end
	end
	if firstMotor then
		selectedJointPath = firstMotor.path
		selectedTrackPaths[firstMotor.path] = true
	end
	return selectedJointPath, selectedTrackPaths
end

return ImportSelectionSupport
