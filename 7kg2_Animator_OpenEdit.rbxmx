				self:_hideCameraTrackEditor(true)
				self:_focusShortcutCapture("Camera rotation keyed at playhead")
			end
		end)
	end
	local function bindCameraRotationInput(input)
		if not input then
			return
		end
		self:_connect(input.Focused, function()
			self._editingTextInput = input
			self._shortcutFocus = false
			self._cameraRotationPreviewEnabled = true
			self:_releaseShortcutCapture()
		end)
		self:_connect(input.FocusLost, function()
			if self._editingTextInput == input then
				self._editingTextInput = nil
			end
		end)
		self:_connect(input.InputChanged, function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseWheel then
				self:_nudgeCameraRotationInput(input, inputObject.Position.Z)
			end
		end)
		self:_connect(input:GetPropertyChangedSignal("Text"), function()
			self:_previewCameraRotationFromInputs()
		end)
	end
	bindCameraRotationInput(self._cameraRotationXInput)
	bindCameraRotationInput(self._cameraRotationYInput)
	bindCameraRotationInput(self._cameraRotationZInput)

