		local function jumpToNeighborKey(direction)
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if not timeline then
				return
			end
			local frame = nil
			if direction &lt; 0 and type(timeline.getPreviousKeyframe) == "function" then
				frame = timeline:getPreviousKeyframe()
			elseif direction &gt; 0 and type(timeline.getNextKeyframe) == "function" then
				frame = timeline:getNextKeyframe()
			end
			if frame == nil then
				return
			end
			local ok = runOption(options, "onScrubToFrame", nil, frame)
			if not ok then
				if type(timeline.setCurrentFrame) == "function" then
					timeline:setCurrentFrame(frame)
				end
				if type(timeline.applyCurrentFrame) == "function" then
					timeline:applyCurrentFrame()
				end
			end
			refresh()
		end

		local multiSelect
		local microMultiSelect = false
		local function setMicroMultiSelect(value)
			microMultiSelect = value == true
			if multiSelect then
				multiSelect.BackgroundColor3 = microMultiSelect and theme().Accent or theme().PanelSoft
				multiSelect.TextColor3 = ThemeService.getReadableTextColor(multiSelect.BackgroundColor3)
				multiSelect:SetAttribute("MegMoThemeBackgroundRole", microMultiSelect and "Accent" or "PanelSoft")
			end
			runOption(options, "onSetMicroMultiSelectLocked", nil, microMultiSelect)
		end
		local function toggleMicroMultiSelect()
			setMicroMultiSelect(not microMultiSelect)
			refresh()
			return microMultiSelect and "Multi Select On" or "Multi Select Off"
		end
		options.onToggleMicroMultiSelect = toggleMicroMultiSelect
		local function isMicroAdditiveSelection()
			return microMultiSelect or (microShiftSelection and microShiftSelection:isHeld())
		end

