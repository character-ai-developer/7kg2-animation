gizmoController:bindCallbacks({
	onDragStart = function()
		editorActions._viewportGizmoDragActive = true
		editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
		pushUndo("Viewport Gizmo Edit")
		ChangeHistoryService:SetWaypoint("Before Gizmo Transform")
	end,
	onDragStep = function()
		editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
		refreshSelectedGizmo()
	end,
	onDragEnd = function()
		editorActions._viewportGizmoDragActive = false
		editorActions._viewportGizmoKeepAliveUntil = os.clock() + 0.75
		capturePoseFromViewport()
		ChangeHistoryService:SetWaypoint("After Gizmo Transform")
		if type(editorActions.resumeViewportRigPartPicker) == "function" then
			editorActions.resumeViewportRigPartPicker()
		end
		refreshUi("Added/updated keyframe from viewport gizmo edit.")
	end,
})

toggleButton.Click:Connect(function()
	setWidgetEnabled(not widget.Enabled)
end)

game:GetService("UserInputService").InputBegan:Connect(function(inputObject, gameProcessedEvent)
	if not inputObject or inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local userInputService = game:GetService("UserInputService")
	local focusedTextBox = userInputService:GetFocusedTextBox()
	local internalShortcutCaptureFocused = focusedTextBox
		and string.find(tostring(focusedTextBox.Name), "ShortcutCapture", 1, true) ~= nil
	if focusedTextBox and not internalShortcutCaptureFocused then
		return
	end
	if gameProcessedEvent and not internalShortcutCaptureFocused then
		return
	end
	local keyCode = inputObject.KeyCode
	local isScreenshotShortcut = keyCode == Enum.KeyCode.Asterisk or keyCode == Enum.KeyCode.KeypadMultiply
	if not isScreenshotShortcut and keyCode == Enum.KeyCode.Eight then
		isScreenshotShortcut = userInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or userInputService:IsKeyDown(Enum.KeyCode.RightShift)
	end
	if isScreenshotShortcut then
		editorActions.toggleScreenshotUiHidden()
	end
end)

widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	local hiddenForPlayback = widget:GetAttribute("MegMoHiddenForPlayback") == true
	local hiddenForMicro = widget:GetAttribute("MegMoHiddenForMicro") == true
	local hiddenForScreenshot = widget:GetAttribute("MegMoHiddenForScreenshot") == true
	toggleButton:SetActive(widget.Enabled)
	if not widget.Enabled and (hiddenForMicro or hiddenForScreenshot) then
		return
	end
	if not widget.Enabled then
		require(Modules:WaitForChild("ViewportToolCleanupService")).clear({
			editorActions = editorActions,
			gizmoController = gizmoController,
			modules = Modules,
		})
	end
	if not widget.Enabled and playbackService:getIsPlaying() and not hiddenForPlayback then
		stopPlayback("Stopped playback because the widget was hidden.")
	end
	if not widget.Enabled and MotionService.getMotionPreviewState().isPreviewing and not hiddenForPlayback then
		MotionService.stopMotionPreview(motionServiceDeps(), "Stopped Motion Builder preview because the widget was hidden.")
	end
	if not widget.Enabled and not hiddenForPlayback then
		clearMotionMarkersSilently()
		pcall(function()
			local service = require(Modules:WaitForChild("AttachService"))
			if service and type(service.clearRuntimeAttachments) == "function" then
				service.clearRuntimeAttachments()
			end
		end)
		timeline:resetOriginalState()
		RigWorkspaceLockService.unlockTimelineRigs(timeline)
		pcall(function()
			local service = require(Modules:WaitForChild("AttachService"))
			if service and type(service.clearRuntimeAttachments) == "function" then
				service.clearRuntimeAttachments()
			end
		end)
		screenEffectsRenderer:render({ viewerEnabled = false })
		if widgetController._onionSkinService then
			widgetController._onionSkinService:clear()
		end
		effectsService:restoreSaveData({
			screen = {
				enabled = {},
				subtitleText = "",
				viewerEnabled = false,
			},
		})
		widgetController._facesController:clearTimelineData()
		selectedMotionRecipeName = nil
		timeline:reset(PluginSettings.getPreferredFps(plugin), Constants.DEFAULT_DURATION_FRAMES)
		clearSelectedKeyframes()
		clearSelectedTracks()
		keyframeEditService:resetGroups()
		importActionStatus = "Ready to import."
		autoSaveState.savedToken = autoSaveState.changeToken
	else
		RigWorkspaceLockService.syncFromSelection(timeline, selectedJointPath, selectedTrackPaths, selectedKeys, SelectionState)
		refreshUi()
		if type(widgetController.stabilizeTimelineAfterImport) == "function" then
			widgetController:stabilizeTimelineAfterImport()
		end
	end
end)

SelectionService.bindSelectionChanged(function()
	if widgetController._suppressViewportSelectionSync == true then
		return
	end
	if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
		return
	end

	if editorActions.isViewportRigPartPickerActive and editorActions.isViewportRigPartPickerActive() then
		if gizmoController
			and type(gizmoController.IsPointerOverHandle) == "function"
			and gizmoController:IsPointerOverHandle() == true then
			return
		end
		if editorActions._trackballTool
			and type(editorActions._trackballTool.IsPointerOverHandle) == "function"
			and editorActions._trackballTool:IsPointerOverHandle() == true then
			return
		end
		local ok, path, part, additive = pcall(function()
			local service = require(Modules:WaitForChild("ViewportPartSelectService"))
			local additiveSelection = require(Modules:WaitForChild("ViewportSelectionIntentSupport")).isAdditiveActive(widgetController, editorActions)
			if type(service.getVisibleHoverCandidate) == "function" then
				local hoveredPath, hoveredPart = service.getVisibleHoverCandidate()
				if hoveredPath then
					return hoveredPath, hoveredPart, additiveSelection
				end
			end
			local selectedPath, selectedPart = service.findMotorPathForSelection(timeline, SelectionService.getSelection())
			if selectedPath then
				return selectedPath, selectedPart, additiveSelection
			end
			local mouseOk, mouse = pcall(function()
				return plugin:GetMouse()
			end)
			if mouseOk and mouse then
				local foundPath, foundPart = service.findMotorPathForMouse(timeline, mouse)
				return foundPath, foundPart, additiveSelection
			end
			return nil, nil, additiveSelection
		end)
		if ok and path then
			local lastPickUntil = tonumber(widgetController._lastViewportPickUntil) or 0
			if lastPickUntil &gt; 0
				and os.clock() &lt;= lastPickUntil
				and widgetController._lastViewportPickPath
				and widgetController._lastViewportPickPath ~= path
			then
				local lastPickPart = widgetController._lastViewportPickPart
				if lastPickPart and lastPickPart.Parent then
					require(Modules:WaitForChild("ViewportSelectionSyncSupport")).forcePartSelection(widgetController, SelectionService, lastPickPart)
				end
				return
			end
			if widgetController._lastViewportPickPath == path
				and widgetController._lastViewportPickUntil
				and os.clock() &lt;= widgetController._lastViewportPickUntil then
				return
			end
			if part and part.Parent then
				widgetController._suppressViewportSelectionSync = true
				pcall(function()
					SelectionService.setSelection({ part }, {
						preserveWorkspaceSelection = true,
					})
				end)
				task.defer(function()
					widgetController._suppressViewportSelectionSync = false
				end)
			end
			require(Modules:WaitForChild("ViewportSelectionIntentSupport")).selectViewportJoint({
				path = path,
				additive = additive == true,
				selectedJointPath = selectedJointPath,
				widgetController = widgetController,
				editorActions = editorActions,
				refreshSelectedGizmo = refreshSelectedGizmo,
			})
			return
		end
	end

	local selectedRig = SelectionService.getSelectedRig()
	for _, rig in ipairs(timeline:getRigs()) do
		if selectedRig and selectedRig == rig then
			local _, activeRigMessage = timeline:setActiveRig(rig)
			local hasMegMoViewportSelection = selectedJointPath ~= nil
				or next(selectedTrackPaths) ~= nil
				or next(selectedKeys) ~= nil
			if hasMegMoViewportSelection then
				refreshSelectedGizmo()
			elseif editorActions.syncViewportRigPartPicker then
				editorActions.syncViewportRigPartPicker()
			end
			refreshUi(activeRigMessage or string.format("Rig '%s' is active in 7kg2. Studio Move/Rotate tools can still move the whole rig.", selectedRig.Name))
			return
		end
	end
end)

pcall(function()
	require(Modules:WaitForChild("ViewportPartSelectService")).bindViewportMouse({
		plugin = plugin,
		timeline = timeline,
		isEnabled = function()
			return editorActions.isViewportRigPartPickerActive()
		end,
		getSelectedPath = function()
			return selectedJointPath
		end,
		selectPath = function(path, additive, part)
			widgetController._lastViewportPickPath = path
			widgetController._lastViewportPickPart = part
			widgetController._lastViewportPickUntil = os.clock() + 0.25
			if path ~= selectedJointPath or additive == true then
				if timeline and type(timeline.syncRigMotorsFromWorkspace) == "function" then
					pcall(function()
						timeline:syncRigMotorsFromWorkspace({
							bonesOnly = true,
						})
					end)
				end
			end
			require(Modules:WaitForChild("ViewportSelectionIntentSupport")).selectViewportJoint({
				path = path,
				additive = additive == true,
				selectedJointPath = selectedJointPath,
				widgetController = widgetController,
				editorActions = editorActions,
				refreshSelectedGizmo = refreshSelectedGizmo,
			})
			if part and part.Parent then
				require(Modules:WaitForChild("ViewportSelectionSyncSupport")).forcePartSelection(widgetController, SelectionService, part)
			end
		end,
		isAdditiveSelectionActive = function()
			return require(Modules:WaitForChild("ViewportSelectionIntentSupport")).isAdditiveActive(widgetController, editorActions)
		end,
		shouldIgnoreClick = function(_, path)
			if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
				return true
			end
			if path
				and widgetController._lastViewportPickPath == path
				and widgetController._lastViewportPickUntil
				and os.clock() &lt;= widgetController._lastViewportPickUntil then
				return true
			end
			if gizmoController
				and type(gizmoController.IsPointerOverHandle) == "function"
				and gizmoController:IsPointerOverHandle() then
				return true
			end
			return editorActions._trackballTool
				and type(editorActions._trackballTool.IsPointerOverHandle) == "function"
				and editorActions._trackballTool:IsPointerOverHandle()
		end,
		canSelectRecentHoverWhenDisabled = function()
			if require(Modules:WaitForChild("WorkspaceGrabOwnershipSupport")).isActive() then
				return false
			end
			if not (widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true and widgetController) then
				return false
			end
			if widgetController._motionBuilderSuspendedViewportPicker == true then
				return false
			end
			-- Let a viewport click finish if Studio briefly deactivated the plugin
			-- before PluginMouse.Button1Down could run.
			return os.clock() &lt;= (widgetController._viewportPartPickerClickGraceUntil or 0)
		end,
		debugEnabled = function()
			return false
		end,
		afterSelect = function()
			if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
				return
			end
			pcall(function()
				if editorActions.isPersistentTrackballActive() then
					editorActions.retargetPersistentTrackball(selectedJointPath)
				end
				if widgetController._motionBuilderSuspendedViewportPicker == true then
					editorActions.syncViewportRigPartPicker()
				else
					editorActions.resumeViewportRigPartPicker()
				end
			end)
			refreshSelectedGizmo()
		end,
		afterMiss = function()
			if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
				return
			end
			if selectedJointPath or next(selectedTrackPaths) ~= nil or next(selectedKeys) ~= nil then
				if editorActions._persistentTrackballMode and editorActions._trackballTool then
					editorActions._persistentTrackballMode = nil
					if type(editorActions._trackballTool.SetSticky) == "function" then
						editorActions._trackballTool:SetSticky(false)
					end
					if type(editorActions._trackballTool.IsActive) == "function" and editorActions._trackballTool:IsActive() then
						editorActions._trackballTool:Cancel()
					end
				end
				widgetController._viewportMultiTrackPaths = nil
				clearSelectedTracks()
				clearSelectedKeyframes()
				refreshSelectedGizmo()
				refreshUi("Selection cleared.")
			end
		end,
	})
end)

pcall(function()
	require(Modules:WaitForChild("RigHandleOverlayService")).setSelectionCallbacks({
		getSelectedPath = function()
			return selectedJointPath
		end,
		isPathSelected = function(path)
			path = tostring(path or "")
			return selectedTrackPaths[path] == true or selectedJointPath == path
		end,
		getSelectedCount = function()
			return #getSelectedTrackPaths()
		end,
		isAdditiveSelectionActive = function()
			return require(Modules:WaitForChild("ViewportSelectionIntentSupport")).isAdditiveActive(widgetController, editorActions)
		end,
		shouldIgnoreClick = function(path)
			if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
				return true
			end
			if path
				and widgetController._lastViewportPickPath == path
				and widgetController._lastViewportPickUntil
				and os.clock() &lt;= widgetController._lastViewportPickUntil then
				return true
			end
			if gizmoController
				and type(gizmoController.IsPointerOverHandle) == "function"
				and gizmoController:IsPointerOverHandle() then
				return true
			end
			return editorActions._trackballTool
				and type(editorActions._trackballTool.IsPointerOverHandle) == "function"
				and editorActions._trackballTool:IsPointerOverHandle()
		end,
		selectPath = function(path, additive)
			widgetController._lastViewportPickPath = path
			widgetController._lastViewportPickUntil = os.clock() + 0.25
			require(Modules:WaitForChild("ViewportSelectionIntentSupport")).selectViewportJoint({
				path = path,
				additive = additive == true,
				selectedJointPath = selectedJointPath,
				widgetController = widgetController,
				editorActions = editorActions,
				refreshSelectedGizmo = refreshSelectedGizmo,
			})
		end,
		afterSelect = function()
			if not widget.Enabled and widget:GetAttribute("MegMoHiddenForMicro") ~= true then
				return
			end
			pcall(function()
				if editorActions.isPersistentTrackballActive() then
					editorActions.retargetPersistentTrackball(selectedJointPath)
				end
				if widgetController._motionBuilderSuspendedViewportPicker == true then
					editorActions.syncViewportRigPartPicker()
				else
					editorActions.resumeViewportRigPartPicker()
				end
			end)
			refreshSelectedGizmo()
		end,
	})
end)

widget.AncestryChanged:Connect(function(_, parent)
	if parent == nil and playbackService:getIsPlaying() then
		stopPlayback()
	end
	if parent == nil and MotionService.getMotionPreviewState().isPreviewing then
		MotionService.stopMotionPreview(motionServiceDeps())
	end
	if parent == nil then
		restoreOriginalWorkspaceState("Widget removed")
		clearMotionMarkersSilently()
		RigWorkspaceLockService.unlockTimelineRigs(timeline)
		screenEffectsRenderer:destroy()
		if widgetController._onionSkinService then
			widgetController._onionSkinService:clear()
		end
	end
end)

pcall(function()
	plugin.Unloading:Connect(function()
		if autoSaveState.changeToken &gt; autoSaveState.savedToken then
			local success, message = autoSaveAnimation()
			if not success then
				warn("[7kg2 Animator] Final recovery autosave failed on unload: " .. tostring(message))
			end
		end
		restoreOriginalWorkspaceState("Plugin unloading")
		clearMotionMarkersSilently()
		RigWorkspaceLockService.unlockTimelineRigs(timeline)
		if widgetController._onionSkinService then
			widgetController._onionSkinService:clear()
		end
		if editorActions._workspaceGrabController
			and type(editorActions._workspaceGrabController.Destroy) == "function" then
			editorActions._workspaceGrabController:Destroy()
			editorActions._workspaceGrabController = nil
		end
	end)
end)

task.spawn(function()
	while widget.Parent do
		task.wait(15)
		if autoSaveState.changeToken &gt; autoSaveState.savedToken and os.clock() &gt;= autoSaveState.nextSaveClock then
			autoSaveAnimation()
		end
	end
end)

toggleButton:SetActive(widget.Enabled)
refreshMotionRecipes()
refreshUi(string.format("Loaded %s. Select a rig model, then click 'Bind Selected Rig'.", BuildInfo.LABEL))
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
</roblox>