	local myAnimationsBackdrop = create("TextButton", {
		Parent = card,
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = Constants.THEME.Panel,
		BackgroundTransparency = 0.999,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextTransparency = 1,
		Visible = false,
		ZIndex = 240,
	})
	local myAnimationsPanel = create("Frame", {
		Parent = card,
		Active = true,
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -24, 0.5, 0),
		Size = UDim2.new(1, -300, 1, -96),
		Visible = false,
		ZIndex = 250,
	})
	create("UISizeConstraint", {
		Parent = myAnimationsPanel,
		MaxSize = Vector2.new(500, 420),
		MinSize = Vector2.new(320, 300),
	})
	UiHelpers.createCorner(myAnimationsPanel, 14)
	UiHelpers.createStroke(myAnimationsPanel, Constants.THEME.Accent, 1)
	create("TextLabel", {
		Parent = myAnimationsPanel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(1, -64, 0, 24),
		Text = "My Animations",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 251,
	})
	local myAnimationsCloseButton = create("TextButton", {
		Parent = myAnimationsPanel,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 32, 0, 32),
		Text = "X",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextStrokeTransparency = 1,
		ZIndex = 251,
	})
	UiHelpers.createCorner(myAnimationsCloseButton, 9)
	local myAnimationsStatus = create("TextLabel", {
		Parent = myAnimationsPanel,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 16, 0, 42),
		Size = UDim2.new(1, -32, 0, 34),
		Text = "Load one of your uploaded Roblox animations into the converter.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 251,
	})
	local myAnimationsList = create("ScrollingFrame", {
		Parent = myAnimationsPanel,
		Active = true,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 16, 0, 84),
		ScrollBarThickness = 6,
		Size = UDim2.new(1, -32, 1, -100),
		ZIndex = 251,
	})
	UiHelpers.createCorner(myAnimationsList, 10)
	local myAnimationsListLayout = create("UIListLayout", {
		Parent = myAnimationsList,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = myAnimationsList,
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	table.insert(state.connections, myAnimationsListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		myAnimationsList.CanvasSize = UDim2.new(0, 0, 0, myAnimationsListLayout.AbsoluteContentSize.Y + 18)
	end))

	local function setStatus(message)
		status.Text = tostring(message or "")
	end

	local function setMyAnimationsPickerVisible(isVisible)
		isVisible = isVisible == true
		tooltip.Visible = false
		myAnimationsBackdrop.Visible = isVisible
		myAnimationsPanel.Visible = isVisible
	end

	local function setUiHidden(isHidden)
		state.uiHidden = isHidden == true
		tooltip.Visible = false
		setMyAnimationsPickerVisible(false)
		setHostUiHidden(state, hideUiRoot, state.uiHidden)
		card.Visible = not state.uiHidden
		overlay.Visible = not state.uiHidden
		overlay.BackgroundTransparency = state.uiHidden and 1 or 0.2
		overlay.Active = not state.uiHidden
	end

	local function resetPreviewClock()
		state.previewTime = 0
		updatePreview(sourcePreview, 0)
		updatePreview(convertedPreview, 0)
	end

	local function restoreViewportEntry(entry)
		if not (entry and entry.rigData) then
			return
		end
		if entry.workspacePreview and PresetPreviewSupport.restorePreviewWorkspaceRig then
			PresetPreviewSupport.restorePreviewWorkspaceRig(entry.rigData)
		else
			PresetPreviewSupport.applyPreviewPose(entry.rigData, entry.rigData.originalPose)
		end
	end

	local function restoreViewportRigs()
		restoreViewportEntry(state.viewportR15)
		restoreViewportEntry(state.viewportR6)
	end

	local function findSelectedRigModel()
		for _, selected in ipairs(Selection:Get()) do
			local model = selected:IsA("Model") and selected or selected:FindFirstAncestorOfClass("Model")
			while model do
				if model:FindFirstChildOfClass("Humanoid") then
					return model
				end
				model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
			end
		end
		return nil
	end

	local function getRigTypeName(model)
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		return humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 and "R6" or "R15"
	end

	local function setEntrySequence(entry, sequence, rigTypeName)
		if not entry then
			return false
		end
		entry.previewData = nil
		entry.duration = 0
		if not sequence then
			restoreViewportEntry(entry)
			return false
		end
		local previewData = PresetPreviewSupport.buildPreviewPoseDataFromKeyframeSequence(sequence, entry.rigData)
		if not previewData then
			return false
		end
		entry.previewData = previewData
		entry.duration = tonumber(previewData.duration) or 0
		return true
	end

	local function setViewportPreviewActive(active)
		state.viewportPreview = active == true
		viewportPreviewButton.Text = state.viewportPreview and "Viewport Preview: On" or "Viewport Preview: Off"
		viewportPreviewButton.BackgroundColor3 = state.viewportPreview and Color3.fromRGB(91, 224, 165) or Constants.THEME.PanelSoft
		viewportPreviewButton.TextColor3 = state.viewportPreview and Color3.fromRGB(10, 28, 22) or Constants.THEME.Text
	end

	local function refreshViewportPreviewData()
		local hasPreviewData = false
		if state.viewportR15 then
			hasPreviewData = setEntrySequence(state.viewportR15, state.sourceSequence, "R15") or hasPreviewData
		end
		if state.viewportR6 then
			hasPreviewData = setEntrySequence(state.viewportR6, state.convertedSequence, "R6") or hasPreviewData
		end
		if hasPreviewData then
			setViewportPreviewActive(true)
		end
	end

	local function setViewportRig(rigTypeName)
		local rig = findSelectedRigModel()
		if not rig then
			setStatus("Select a rig model or one of its parts in Explorer/viewport first.")
			return false
		end
		local selectedRigType = getRigTypeName(rig)
		if selectedRigType ~= rigTypeName then
			setStatus(string.format("Selected rig is %s. Please select a %s rig.", selectedRigType, rigTypeName))
			return false
		end

		local entryKey = rigTypeName == "R6" and "viewportR6" or "viewportR15"
		restoreViewportEntry(state[entryKey])
		state[entryKey] = {
			rig = rig,
			rigData = PresetPreviewSupport.describePreviewRigMotors(rig),
			previewData = nil,
			duration = 0,
			workspacePreview = true,
		}
		local hasPreviewData = setEntrySequence(state[entryKey], rigTypeName == "R6" and state.convertedSequence or state.sourceSequence, rigTypeName)
		resetPreviewClock()
		if hasPreviewData then
			setViewportPreviewActive(true)
			setStatus(string.format("Previewing %s animation on %s in the Studio viewport.", rigTypeName, rig.Name))
		else
			setStatus(string.format("Set %s viewport rig to %s. Load or convert an animation to preview it.", rigTypeName, rig.Name))
		end
		return true
	end

	local function updateViewportPreviewButton()
		setViewportPreviewActive(state.viewportPreview)
	end

	local function applyViewportEntry(entry, timePosition)
		if not (entry and entry.previewData and entry.rigData) then
			return
		end
		local pose = PresetPreviewSupport.samplePreviewPose(entry.previewData, math.min(timePosition or 0, entry.duration or 0))
		if entry.workspacePreview and PresetPreviewSupport.applyPreviewPoseWorld then
			PresetPreviewSupport.applyPreviewPoseWorld(entry.rigData, pose)
		else
			PresetPreviewSupport.applyPreviewPose(entry.rigData, pose)
		end
	end

	local function loadSourceSequence(sequence, label)
		if not sequence or not sequence:IsA("KeyframeSequence") then
			setStatus("That source did not load as a KeyframeSequence.")
			return false
		end
		state.sourceSequence = sequence
		state.sourceLabel = label or sequence.Name
		state.convertedSequence = nil
		sourceTitle.Text = "R15 Source Preview - " .. tostring(sequence.Name)
		convertedTitle.Text = "R6 Converted Preview"
		clearPreview(convertedPreview)
		local ok, message = loadPreview(sourcePreview, "R15", sequence)
		refreshViewportPreviewData()
		resetPreviewClock()
		if not ok then
			setStatus(message)
			return false
		end
		setStatus(string.format("Loaded %s (%d keyframes). Click Convert -&gt; R6.", tostring(state.sourceLabel), getKeyframeCount(sequence)))
		return true
	end

	local function clearMyAnimationsList()
		for _, child in ipairs(myAnimationsList:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	local function loadMyAnimationEntry(entry)
		if type(entry) ~= "table" then
			return
		end
		if entry.entryType == "LoadMoreMyAnimations" then
			myAnimationsStatus.Text = "Loading more animations..."
			task.spawn(function()
				local success, entriesOrMessage = ImportService.loadMoreMyAnimations()
				if not success then
					myAnimationsStatus.Text = tostring(entriesOrMessage)
					return
				end
				ImportService.resolveAnimationEntryNames(entriesOrMessage)
				clearMyAnimationsList()
				for index, nextEntry in ipairs(entriesOrMessage) do
					local name = tostring(nextEntry.name or nextEntry.numericId or "Animation")
					local detail = tostring(nextEntry.source or "My Animations")
					if nextEntry.entryType ~= "LoadMoreMyAnimations" then
						detail ..= "  |  #" .. tostring(nextEntry.numericId or nextEntry.id or "")
					end
					local row = makeButton(myAnimationsList, name .. "\n" .. detail, Constants.THEME.PanelSoft, index)
					row.BackgroundColor3 = Color3.fromRGB(34, 42, 58)
					row.TextColor3 = Color3.fromRGB(236, 242, 255)
					row.Size = UDim2.new(1, -4, 0, 52)
					row.TextScaled = false
					row.TextXAlignment = Enum.TextXAlignment.Left
					row.TextSize = 11
					row.ZIndex = 252
					row.Activated:Connect(function()
						loadMyAnimationEntry(nextEntry)
					end)
				end
				myAnimationsStatus.Text = string.format("Showing %d animations. Choose one to load it into the converter.", ImportService.countImportableAnimationEntries(entriesOrMessage))
			end)
			return
		end

		setMyAnimationsPickerVisible(false)
		idBox.Text = tostring(entry.id or "")
		setStatus("Loading " .. tostring(entry.name or entry.id or "My Animation") .. "...")
		local ok, sequenceOrMessage = pcall(function()
			return Converter.LoadFromAnimationId(entry.id)
		end)
		if not ok then
			setStatus("Could not load My Animation: " .. tostring(sequenceOrMessage))
			return
		end
		loadSourceSequence(sequenceOrMessage, tostring(entry.name or entry.id or "My Animation"))
	end

	local function renderMyAnimations(entries)
		clearMyAnimationsList()
		if #entries == 0 then
			local empty = create("TextLabel", {
				Parent = myAnimationsList,
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamSemibold,
				LayoutOrder = 1,
				Size = UDim2.new(1, -8, 0, 58),
				Text = "No uploaded animations were found yet. You can still paste an Animation ID directly.",
				TextColor3 = Constants.THEME.Text,
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 252,
			})
			return empty
		end

		for index, entry in ipairs(entries) do
			local name = tostring(entry.name or entry.numericId or "Animation")
			local detail = tostring(entry.source or "My Animations")
			if entry.entryType ~= "LoadMoreMyAnimations" then
				detail ..= "  |  #" .. tostring(entry.numericId or entry.id or "")
			end
			local row = makeButton(myAnimationsList, name .. "\n" .. detail, Constants.THEME.PanelSoft, index)
			row.BackgroundColor3 = Color3.fromRGB(34, 42, 58)
			row.TextColor3 = Color3.fromRGB(236, 242, 255)
			row.Size = UDim2.new(1, -4, 0, 52)
			row.TextScaled = false
			row.TextXAlignment = Enum.TextXAlignment.Left
			row.TextSize = 11
			row.ZIndex = 252
			row.Activated:Connect(function()
				loadMyAnimationEntry(entry)
			end)
		end
		return nil
	end

	local function showMyAnimationsPicker()
		setMyAnimationsPickerVisible(true)
		myAnimationsStatus.Text = "Loading and sorting your newest Roblox animations..."
		clearMyAnimationsList()
		task.spawn(function()
			local success, entriesOrMessage = ImportService.loadMyAnimations({
				forceRefresh = true,
				readAll = true,
				pageSize = 20,
			})
			if not success then
				myAnimationsStatus.Text = tostring(entriesOrMessage)
				renderMyAnimations({})
				return
			end
			ImportService.resolveAnimationEntryNames(entriesOrMessage)
			renderMyAnimations(entriesOrMessage)
			myAnimationsStatus.Text = string.format("Showing %d newest animations. Choose one to load it into the converter.", ImportService.countImportableAnimationEntries(entriesOrMessage))
		end)
	end

	local function loadId()
		local input = tostring(idBox.Text or "")
		if input:gsub("%s+", "") == "" then
			setStatus("Paste an R15 Animation ID or URL first.")
			return false
		end
		setStatus("Loading Animation ID...")
		local ok, sequenceOrMessage = pcall(function()
			return Converter.LoadFromAnimationId(input)
		end)
		if not ok then
			setStatus("Could not load ID: " .. tostring(sequenceOrMessage))
			return false
		end
		return loadSourceSequence(sequenceOrMessage, "Animation ID " .. tostring(input:match("%d+") or input))
	end

	local function loadSelection()
		setStatus("Reading Explorer selection...")
		local ok, sequenceOrMessage, label = loadSequenceFromSelection()
		if not ok then
			setStatus(sequenceOrMessage)
			return false
		end
		return loadSourceSequence(sequenceOrMessage, label)
	end

	local function convertLoaded()
		if not state.sourceSequence then
			if tostring(idBox.Text or "") ~= "" and not loadId() then
				return false
			elseif not state.sourceSequence then
				setStatus("Load an R15 source first.")
				return false
			end
		end
		setStatus("Converting with hidden R15/R6 reference rigs...")
		local ok, sequenceOrMessage = pcall(function()
			return Converter.Convert(state.sourceSequence)
		end)
		if not ok then
			setStatus("Conversion failed: " .. tostring(sequenceOrMessage))
			return false
		end
		state.convertedSequence = sequenceOrMessage
		convertedTitle.Text = "R6 Converted Preview - " .. tostring(state.convertedSequence.Name)
		local previewOk, previewMessage = loadPreview(convertedPreview, "R6", state.convertedSequence)
		refreshViewportPreviewData()
		resetPreviewClock()
		setStatus(previewOk and ("Converted to " .. state.convertedSequence.Name .. ". Save or import it if the preview looks good.") or previewMessage)
		return previewOk
	end

	local function saveConverted()
		if not state.convertedSequence then
			setStatus("Nothing converted yet. Click Convert -&gt; R6 first.")
			return false
		end
		local ok, result = pcall(function()
			return Converter.SaveConvertedSequence(state.convertedSequence)
		end)
		if not ok then
			setStatus("Save failed: " .. tostring(result))
			return false
		end
		setStatus("Saved to ServerStorage.MegMoR15ToR6Converted." .. tostring(result and (" Output: " .. result.Name) or ""))
		return true
	end

	local function importConverted()
		if not state.convertedSequence then
			setStatus("Nothing converted yet. Click Convert -&gt; R6 first.")
			return false
		end
		if type(options.onImportKeyframeSequence) ~= "function" then
			setStatus("Timeline import is not connected here. Use Save Output, then import the saved KeyframeSequence.")
			return false
		end
		local ok, success, message = pcall(options.onImportKeyframeSequence, state.convertedSequence, state.convertedSequence.Name)
		if not ok then
			setStatus("Timeline import failed: " .. tostring(success))
			return false
		end
		setStatus(tostring(message or (success and "Imported converted R6 animation." or "Import did not complete.")))
		return success
	end

	local function destroy()
		setHostUiHidden(state, hideUiRoot, false)
		restoreViewportRigs()
		for _, connection in ipairs(state.connections) do
			if connection and connection.Disconnect then
				connection:Disconnect()
			end
		end
		table.clear(state.connections)
		if overlay and overlay.Parent then
			overlay:Destroy()
		end
		if activePopup and activePopup.overlay == overlay then
			activePopup = nil
		end
	end

	local function connect(signal, handler)
		if signal and type(handler) == "function" then
			table.insert(state.connections, signal:Connect(handler))
		end
	end

	attachTooltip(state, overlay, tooltip, idBox, "Paste an R15 animation ID, rbxassetid, or Roblox animation URL here, then click Load ID Preview.")
	attachTooltip(state, overlay, tooltip, loadIdButton, "Loads the pasted R15 animation and previews the original source on the left.")
	attachTooltip(state, overlay, tooltip, myAnimationsButton, "Opens your uploaded Roblox animations so you can pick one to convert to R6.")
	attachTooltip(state, overlay, tooltip, useSelectionButton, "Uses the Animation, KeyframeSequence, or animation object currently selected in Explorer.")
	attachTooltip(state, overlay, tooltip, convertButton, "Creates a simplified R6 copy from the loaded R15 animation. The original is not changed.")
	attachTooltip(state, overlay, tooltip, saveButton, "Saves the converted R6 KeyframeSequence into ServerStorage so you can reuse or import it later.")
	attachTooltip(state, overlay, tooltip, importButton, "Imports the converted R6 animation directly onto the selected R6 rig track in 7kg2.")
	attachTooltip(state, overlay, tooltip, loopButton, "Choose whether the side-by-side previews repeat continuously or play once.")
	attachTooltip(state, overlay, tooltip, setR15Button, "Select an R15 rig in Studio, then click this to preview the source animation on that rig.")
	attachTooltip(state, overlay, tooltip, setR6Button, "Select an R6 rig in Studio, then click this to preview the converted animation on that rig.")
	attachTooltip(state, overlay, tooltip, viewportPreviewButton, "Turns live Studio viewport preview on or off for the selected R15 and R6 rigs.")
	attachTooltip(state, overlay, tooltip, hideUiButton, "Hides the full 7kg2 UI while the viewport preview keeps running. Press Escape to show the UI again.")
	attachTooltip(state, overlay, tooltip, closeButton, "Closes the converter and restores any viewport preview rigs to their original pose.")

	connect(closeButton.Activated, destroy)
	connect(myAnimationsBackdrop.Activated, function()
		setMyAnimationsPickerVisible(false)
	end)
	connect(myAnimationsCloseButton.Activated, function()
		setMyAnimationsPickerVisible(false)
	end)
	connect(hideUiButton.Activated, function()
		setUiHidden(true)
	end)
	connect(UserInputService.InputBegan, function(input)
		if state.uiHidden and input.KeyCode == Enum.KeyCode.Escape then
			setUiHidden(false)
			setStatus("7kg2 UI restored. Hide UI keeps the viewport preview running; press Escape to bring controls back.")
		end
	end)
	connect(loadIdButton.Activated, loadId)
	connect(myAnimationsButton.Activated, showMyAnimationsPicker)
	connect(useSelectionButton.Activated, loadSelection)
	connect(convertButton.Activated, convertLoaded)
	connect(saveButton.Activated, saveConverted)
	connect(importButton.Activated, importConverted)
	connect(setR15Button.Activated, function()
		setViewportRig("R15")
	end)
	connect(setR6Button.Activated, function()
		setViewportRig("R6")
	end)
	connect(viewportPreviewButton.Activated, function()
		setViewportPreviewActive(not state.viewportPreview)
		if not state.viewportPreview then
			restoreViewportRigs()
			setStatus("Viewport preview stopped. Selected rigs restored to their original poses.")
		else
			refreshViewportPreviewData()
			resetPreviewClock()
			setStatus("Viewport preview enabled. Set an R15 rig and R6 rig to preview both in Studio.")
		end
	end)
	connect(loopButton.Activated, function()
		state.loop = not state.loop
		loopButton.Text = state.loop and "Loop: On" or "Loop: Once"
		loopButton.BackgroundColor3 = state.loop and Color3.fromRGB(132, 80, 255) or Constants.THEME.PanelSoft
		resetPreviewClock()
	end)
	connect(RunService.Heartbeat, function(deltaTime)
		local duration = math.max(sourcePreview.duration or 0, convertedPreview.duration or 0)
		if duration &lt;= 0 then
			return
		end
		state.previewTime += math.min(0.1, deltaTime)
		if state.loop then
			state.previewTime %= duration
		else
			state.previewTime = math.min(state.previewTime, duration)
		end
		updatePreview(sourcePreview, math.min(state.previewTime, sourcePreview.duration or 0))
		updatePreview(convertedPreview, math.min(state.previewTime, convertedPreview.duration or 0))
		if state.viewportPreview then
			applyViewportEntry(state.viewportR15, state.previewTime)
			applyViewportEntry(state.viewportR6, state.previewTime)
		end
	end)
	updateViewportPreviewButton()

	activePopup = {
		overlay = overlay,
		destroy = destroy,
	}
	return activePopup
end

return R15ToR6ConverterPopup
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX101">
          <Properties>
            <string name="Name">RepeatFramesUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local RepeatFramesUI = {}

local create = UiHelpers.create
local styleGhostButton = UiHelpers.styleGhostButton
local styleTextButton = UiHelpers.styleTextButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local function createLabel(parent, text, y)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, y),
		Size = UDim2.new(0, 118, 0, 22),
		Font = Enum.Font.Gotham,
		Text = text,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 122,
	})
end

local function createInput(parent, y, placeholder)
	local input = create("TextBox", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 148, 0, y),
		Size = UDim2.new(1, -166, 0, 28),
		Font = Enum.Font.Gotham,
		PlaceholderText = placeholder or "",
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 122,
	})
	createCorner(input, 8)
	createStroke(input)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	return input
end

function RepeatFramesUI.mount(parent, _context)
	if not parent then
		error("RepeatFramesUI.mount requires parent")
	end

	local overlay = create("Frame", {
		Name = "RepeatFramesOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 120,
	})
	local card = create("Frame", {
		Name = "RepeatFramesCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 380, 0, 278),
		ZIndex = 121,
	})
	applySectionSurface(card)
	createCorner(card, 14)
	createStroke(card, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 16),
		Size = UDim2.new(1, -54, 0, 22),
		Font = Enum.Font.GothamSemibold,
		Text = "Repeat Frames",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 122,
	})
	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 28, 0, 28),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "X",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		ZIndex = 122,
	})
	createCorner(closeButton, 8)

	local helpLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 44),
		Size = UDim2.new(1, -36, 0, 34),
		Font = Enum.Font.GothamSemibold,
		Text = "Repeat the selected keyframes. Length and End Time accept frames, seconds like 1.25s, or timecode like 0:37.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 122,
	})

	createLabel(card, "Loop Count", 92)
	local loopCountInput = createInput(card, 90, "1")
	createLabel(card, "Length", 128)
	local lengthInput = createInput(card, 126, "0:30")
	createLabel(card, "End Time", 164)
	local endTimeInput = createInput(card, 162, "1:00")

	local toEndButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 148, 0, 198),
		Size = UDim2.new(0, 110, 0, 30),
		Text = "To End",
		ZIndex = 122,
	})
	styleGhostButton(toEndButton)
	createCorner(toEndButton, 8)

	local statusLabel = create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 232),
		Size = UDim2.new(0.55, -24, 0, 30),
		Font = Enum.Font.Gotham,
		Text = "",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 122,
	})

	local cancelButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.55, 0, 1, -46),
		Size = UDim2.new(0.225, -8, 0, 30),
		Text = "Cancel",
		ZIndex = 122,
	})
	styleGhostButton(cancelButton)
	createCorner(cancelButton, 8)

	local okButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.775, 0, 1, -46),
		Size = UDim2.new(0.225, -18, 0, 30),
		Text = "OK",
		ZIndex = 122,
	})
	styleTextButton(okButton)
	createCorner(okButton, 8)

	return {
		_repeatFramesOverlay = overlay,
		_repeatFramesCloseButton = closeButton,
		_repeatFramesLoopCountInput = loopCountInput,
		_repeatFramesLengthInput = lengthInput,
		_repeatFramesEndTimeInput = endTimeInput,
		_repeatFramesToEndButton = toEndButton,
		_repeatFramesStatusLabel = statusLabel,
		_repeatFramesCancelButton = cancelButton,
		_repeatFramesOkButton = okButton,
	}
end

function RepeatFramesUI.update(_context)
end

function RepeatFramesUI.destroy()
end

return RepeatFramesUI
