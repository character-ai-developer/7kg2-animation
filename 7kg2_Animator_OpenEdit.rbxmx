      <Item class="ModuleScript" referent="RBX171">
        <Properties>
          <string name="Name">MotionRecipeActionSupport</string>
          <ProtectedString name="Source">local MotionRecipeActionSupport = {}

function MotionRecipeActionSupport.saveRecipe(args)
	local recipe = args.motionBuilderState:captureRecipe({
		rigType = args.rigType,
	})
	local fallbackName = args.recipeName
	if not fallbackName or tostring(fallbackName):gsub("%s+", "") == "" then
		fallbackName = args.timeline:getAnimationName()
	end
	local _, message, savedValue = args.saveExportService.saveMotionRecipe(recipe, args.buildInfo, fallbackName)
	local nextSelectedMotionRecipeName = args.selectedMotionRecipeName
	if savedValue then
		nextSelectedMotionRecipeName = savedValue.Name
	end
	return nextSelectedMotionRecipeName, message
end

function MotionRecipeActionSupport.loadRecipe(args)
	local success, recipeOrMessage, loadedMessage = args.saveExportService.loadMotionRecipeByName(args.recipeName)
	if not success then
		return false, args.selectedMotionRecipeName, recipeOrMessage, false
	end

	local restored, restoreMessage = args.motionBuilderState:restoreRecipe(args.motionServiceDeps(), recipeOrMessage)
	return true, args.recipeName, restored and (loadedMessage or restoreMessage) or restoreMessage, restored
end

function MotionRecipeActionSupport.renameRecipe(args)
	local success, message = args.saveExportService.renameMotionRecipe(args.oldName, args.newName)
	local nextSelectedMotionRecipeName = args.selectedMotionRecipeName
	if success then
		nextSelectedMotionRecipeName = tostring(args.newName or "")
	end
	return nextSelectedMotionRecipeName, message
end

function MotionRecipeActionSupport.deleteRecipe(args)
	local success, message = args.saveExportService.deleteMotionRecipe(args.recipeName)
	local nextSelectedMotionRecipeName = args.selectedMotionRecipeName
	if success and tostring(nextSelectedMotionRecipeName or "") == tostring(args.recipeName or "") then
		nextSelectedMotionRecipeName = nil
	end
	return nextSelectedMotionRecipeName, message
end

return MotionRecipeActionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX172">
        <Properties>
          <string name="Name">MotionRecipeRefreshSupport</string>
          <ProtectedString name="Source">local MotionRecipeRefreshSupport = {}

function MotionRecipeRefreshSupport.refresh(listMotionRecipes, selectedMotionRecipeName)
	local motionRecipeEntries, motionRecipeStatus = listMotionRecipes()
	local nextSelectedMotionRecipeName = selectedMotionRecipeName

	if nextSelectedMotionRecipeName then
		local stillExists = false
		for _, entry in ipairs(motionRecipeEntries) do
			if tostring(entry.name or entry.id) == tostring(nextSelectedMotionRecipeName) then
				stillExists = true
				break
			end
		end
		if not stillExists then
			nextSelectedMotionRecipeName = nil
		end
	end

	return motionRecipeEntries, motionRecipeStatus, nextSelectedMotionRecipeName
end

return MotionRecipeRefreshSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX173">
        <Properties>
          <string name="Name">MotionRecorderService</string>
          <ProtectedString name="Source">local MotionRecorderService = {}
MotionRecorderService.__index = MotionRecorderService

local DEFAULT_DURATION_SECONDS = 10
local DEFAULT_SAMPLE_RATE = 24
local MIN_CHANGE_THRESHOLD = 0.002
local ROTATION_THRESHOLD_RADIANS = math.rad(0.5)

local function debugLog(message)
end

local function defaultClock()
	if os and type(os.clock) == "function" then
		local ok, value = pcall(os.clock)
		if ok and type(value) == "number" then
			return value
		end
	end
	if type(time) == "function" then
		local ok, value = pcall(time)
		if ok and type(value) == "number" then
			return value
		end
	end
	return 0
end

local function cloneValue(value)
	if typeof(value) == "table" then
		local clone = {}
		for key, child in pairs(value) do
			clone[key] = cloneValue(child)
		end
		return clone
	end
	return value
end

local function cframeChanged(a, b)
	if typeof(a) ~= "CFrame" or typeof(b) ~= "CFrame" then
		return true
	end

	if (a.Position - b.Position).Magnitude &gt;= MIN_CHANGE_THRESHOLD then
		return true
	end

	local delta = a:ToObjectSpace(b)
	local _, angle = delta:ToAxisAngle()
	return math.abs(angle) &gt;= ROTATION_THRESHOLD_RADIANS
end

local function valueChanged(a, b)
	if typeof(a) == "CFrame" and typeof(b) == "CFrame" then
		return cframeChanged(a, b)
	end

	if type(a) == "table" and type(b) == "table" then
		local aCFrame = a.cframe or a.CFrame
		local bCFrame = b.cframe or b.CFrame
		if typeof(aCFrame) == "CFrame" and typeof(bCFrame) == "CFrame" then
			return cframeChanged(aCFrame, bCFrame)
		end
	end

	return tostring(a) ~= tostring(b)
end

local function sampleChanged(previousSample, values)
	if not previousSample then
		return true
	end

	local previousByPath = {}
	for _, item in ipairs(previousSample.values or {}) do
		previousByPath[item.path] = item.value
	end

	for _, item in ipairs(values or {}) do
		if valueChanged(previousByPath[item.path], item.value) then
			return true
		end
	end

	return false
end

function MotionRecorderService.new(options)
	options = options or {}
	return setmetatable({
		_timeline = options.timeline,
		_clock = options.clock or defaultClock,
		_armed = false,
		_recording = false,
		_startFrame = 0,
		_fps = 30,
		_durationSeconds = DEFAULT_DURATION_SECONDS,
		_sampleRate = DEFAULT_SAMPLE_RATE,
		_recordStartClock = 0,
		_lastSampleClock = -math.huge,
		_targetPathMap = nil,
		_samples = {},
		_lastFinishDebug = nil,
		_debugSampleCount = 0,
		_changedSampleCount = 0,
	}, MotionRecorderService)
end

function MotionRecorderService:Arm(options)
	options = options or {}
	debugLog(string.format("Arm requested | recording=%s armed=%s startFrame=%s fps=%s duration=%s sampleRate=%s",
		tostring(self._recording),
		tostring(self._armed),
		tostring(options.startFrame),
		tostring(options.fps),
		tostring(options.durationSeconds),
		tostring(options.sampleRate)
	))
	if not self._timeline then
		debugLog("Arm failed: no timeline")
		return false, "Motion Recorder could not find the timeline."
	end
	if self._recording or self._armed then
		debugLog("Arm failed: already armed or recording")
		return false, "Motion Recorder is already armed."
	end

	self._startFrame = math.max(0, math.floor(tonumber(options.startFrame) or self._timeline:getCurrentFrame() or 0))
	self._fps = math.max(1, tonumber(options.fps) or self._timeline:getFps() or 60)
	self._durationSeconds = math.clamp(tonumber(options.durationSeconds) or DEFAULT_DURATION_SECONDS, 0.25, 10)
	self._sampleRate = math.clamp(tonumber(options.sampleRate) or DEFAULT_SAMPLE_RATE, 4, 60)
	self._targetPathMap = nil
	if type(options.targetPaths) == "table" then
		self._targetPathMap = {}
		for _, path in ipairs(options.targetPaths) do
			if type(path) == "string" then
				self._targetPathMap[path] = true
			end
		end
	end
	self._samples = {}
	self._lastFinishDebug = nil
	self._debugSampleCount = 0
	self._changedSampleCount = 0
	self._recordStartClock = 0
	self._lastSampleClock = -math.huge
	self._armed = true
	self._recording = false
	debugLog(string.format("Armed | startFrame=%d fps=%d duration=%.2f targets=%s",
		self._startFrame,
		self._fps,
		self._durationSeconds,
		self._targetPathMap and "locked" or "any"
	))
	return true, "Motion Recorder armed."
end

function MotionRecorderService:BeginSession(session)
	debugLog(string.format("BeginSession requested | armed=%s recording=%s session=%s capture=%s",
		tostring(self._armed),
		tostring(self._recording),
		tostring(session ~= nil),
		tostring(session and type(session.CaptureCurrentValues) == "function")
	))
	if not self._armed or not session or type(session.CaptureCurrentValues) ~= "function" then
		debugLog("BeginSession failed precheck")
		return false
	end

	self._recordStartClock = self._clock()
	self._lastSampleClock = -math.huge
	self._samples = {}
	self._debugSampleCount = 0
	self._changedSampleCount = 0
	self._recording = true
	self._armed = false
	self:Sample(session, true)
	debugLog("BeginSession started recording")
	return true
end

function MotionRecorderService:Sample(session, force)
	if not self._recording or not session or type(session.CaptureCurrentValues) ~= "function" then
		if force then
			debugLog(string.format("Force sample ignored | recording=%s session=%s capture=%s",
				tostring(self._recording),
				tostring(session ~= nil),
				tostring(session and type(session.CaptureCurrentValues) == "function")
			))
		end
		return false
	end

	local now = self._clock()
	local elapsed = math.clamp(now - self._recordStartClock, 0, self._durationSeconds)
	local sampleInterval = 1 / self._sampleRate
	if not force and (now - self._lastSampleClock) &lt; sampleInterval then
		return false
	end

	local values = session:CaptureCurrentValues()
	if type(values) ~= "table" or #values == 0 then
		if force then
			debugLog("Force sample had no captured values")
		end
		return false
	end
	if self._targetPathMap then
		local filtered = {}
		for _, item in ipairs(values) do
			if item.path and self._targetPathMap[item.path] then
				table.insert(filtered, item)
			end
		end
		values = filtered
		if #values == 0 then
			if force then
				debugLog("Force sample filtered out all values")
			end
			return false
		end
	end

	local sample = {
		time = elapsed,
		values = cloneValue(values),
	}
	local previousSample = self._samples[#self._samples]
	local changed = sampleChanged(previousSample, sample.values)
	if force or changed then
		table.insert(self._samples, sample)
		self._debugSampleCount += 1
		if previousSample and changed then
			self._changedSampleCount += 1
		end
		self._lastSampleClock = now
		if force or self._debugSampleCount &lt;= 5 or self._debugSampleCount % 12 == 0 then
			debugLog(string.format("Sample accepted | count=%d elapsed=%.3f values=%d force=%s",
				self._debugSampleCount,
				elapsed,
				#values,
				tostring(force == true)
			))
		end
		return true
	end

	self._lastSampleClock = now
	return false
end

function MotionRecorderService:Finish()
	debugLog(string.format("Finish requested | recording=%s armed=%s samples=%d",
		tostring(self._recording),
		tostring(self._armed),
		type(self._samples) == "table" and #self._samples or 0
	))
	if not self._recording then
		self:Cancel()
		debugLog("Finish failed: not recording")
		return false, "Motion Recorder was not recording.", {}
	end

	local timeline = self._timeline
	local samples = self._samples
	self._recording = false
	self._armed = false
	self._targetPathMap = nil
	self._samples = {}
	self._lastFinishDebug = {
		samples = type(samples) == "table" and #samples or 0,
		changed = self._changedSampleCount or 0,
		written = 0,
		failures = {},
	}

	if type(samples) ~= "table" or #samples &lt; 2 then
		debugLog(string.format("Finish failed: sample count %d", self._lastFinishDebug.samples))
		return false, string.format("Motion Recorder ended with %d sample%s. Move the Trackball further while recording.", self._lastFinishDebug.samples, self._lastFinishDebug.samples == 1 and "" or "s"), {}
	end
	if (self._changedSampleCount or 0) &lt; 1 then
		debugLog(string.format("Finish failed: changed sample count %d", self._changedSampleCount or 0))
		return false, "Motion Recorder did not detect enough Trackball movement. Drag the Trackball further while recording.", {}
	end

	local keyed = {}
	local keyedFrames = {}
	for _, sample in ipairs(samples) do
		local frame = self._startFrame + math.max(0, math.floor((sample.time * self._fps) + 0.5))
		for _, item in ipairs(sample.values or {}) do
			if item.path and item.value ~= nil then
				local keyId = tostring(item.path) .. ":" .. tostring(frame)
				if not keyedFrames[keyId] then
					local success, message = timeline:setTrackValueAtFrame(item.path, frame, cloneValue(item.value), "Linear", "InOut")
					if success then
						keyedFrames[keyId] = true
						self._lastFinishDebug.written += 1
						table.insert(keyed, {
							jointPath = item.path,
							frame = frame,
						})
					else
						table.insert(self._lastFinishDebug.failures, message or ("Failed to write " .. tostring(item.path)))
					end
				end
			end
		end
	end

	if #keyed == 0 then
		local firstFailure = self._lastFinishDebug.failures[1]
		debugLog(string.format("Finish failed: wrote no keys | failures=%d first=%s",
			#self._lastFinishDebug.failures,
			tostring(firstFailure)
		))
		return false, firstFailure and ("Motion Recorder could not write keyframes: " .. tostring(firstFailure)) or "Motion Recorder could not write any keyframes.", {}
	end

	table.sort(keyed, function(a, b)
		if a.frame ~= b.frame then
			return a.frame &lt; b.frame
		end
		return tostring(a.jointPath) &lt; tostring(b.jointPath)
	end)

	debugLog(string.format("Finish success | samples=%d keys=%d failures=%d",
		self._lastFinishDebug.samples,
		#keyed,
		#self._lastFinishDebug.failures
	))
	return true, string.format("Recorded motion into %d keyframes.", #keyed), keyed
end

function MotionRecorderService:GetDebugSummary()
	local debugInfo = self._lastFinishDebug
	if not debugInfo then
		return "no finish debug"
	end
	return string.format("samples=%d changed=%d written=%d failures=%d", tonumber(debugInfo.samples) or 0, tonumber(debugInfo.changed) or 0, tonumber(debugInfo.written) or 0, type(debugInfo.failures) == "table" and #debugInfo.failures or 0)
end

function MotionRecorderService:Cancel()
	debugLog(string.format("Cancel | armed=%s recording=%s samples=%d",
		tostring(self._armed),
		tostring(self._recording),
		type(self._samples) == "table" and #self._samples or 0
	))
	self._armed = false
	self._recording = false
	self._targetPathMap = nil
	self._samples = {}
	self._changedSampleCount = 0
	return true
end

function MotionRecorderService:IsArmed()
	return self._armed == true
end

function MotionRecorderService:IsRecording()
	return self._recording == true
end

function MotionRecorderService:GetMaxDuration()
	return self._durationSeconds
end

return MotionRecorderService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX174">
        <Properties>
          <string name="Name">MotionSegmentEditSupport</string>
          <ProtectedString name="Source">local MotionSegmentEditSupport = {}

function MotionSegmentEditSupport.setSegmentMotion(motionBuilderState, segmentKey, motionName)
	return motionBuilderState:setSegmentMotion(segmentKey, motionName)
end

function MotionSegmentEditSupport.setSegmentClip(motionBuilderState, segmentKey, clipId)
	return motionBuilderState:setSegmentClip(segmentKey, clipId)
end

function MotionSegmentEditSupport.setDefaultClip(motionBuilderState, motionName, clipId, rigType)
	return motionBuilderState:setDefaultClip(motionName, clipId, rigType)
end

function MotionSegmentEditSupport.setSegmentPauseIdle(motionBuilderState, segmentKey, clipId)
	return motionBuilderState:setSegmentPauseIdle(segmentKey, clipId)
end

function MotionSegmentEditSupport.setSegmentDuration(motionBuilderState, segmentKey, input)
	return motionBuilderState:setSegmentDuration(segmentKey, input)
end

function MotionSegmentEditSupport.setSegmentPause(motionBuilderState, segmentKey, input)
	return motionBuilderState:setSegmentPause(segmentKey, input)
end

function MotionSegmentEditSupport.setSegmentBlend(motionBuilderState, segmentKey, input)
	return motionBuilderState:setSegmentBlend(segmentKey, input)
end

function MotionSegmentEditSupport.resetSegments(motionBuilderState)
	return motionBuilderState:resetSegments()
end

return MotionSegmentEditSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX175">
        <Properties>
          <string name="Name">MotionService</string>
          <ProtectedString name="Source">local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local MotionService = {}

local BEAM_TEMPLATE_NAME = "BeamAttachment"
local MOTION_BEAM_ATTACHMENT_NAME = "MegMoMotionBeamAttachment"
local MOTION_BEAM_NAME = "MegMoMotionPathBeam"
local SEGMENT_MOTION_ATTR = "MegMoSegmentMotion"
local SEGMENT_DURATION_ATTR = "MegMoSegmentDurationSeconds"
local SEGMENT_PAUSE_ATTR = "MegMoSegmentPauseSeconds"
local SEGMENT_BLEND_ATTR = "MegMoSegmentBlendSeconds"
local SEGMENT_CLIP_ATTR = "MegMoSegmentClipId"
local SEGMENT_PAUSE_IDLE_ATTR = "MegMoSegmentPauseIdleClipId"
local MOTION_RECIPE_FORMAT = "MegMoMotionBuilderRecipe"
local MOTION_BEAM_ATTR = "MegMoMotionBeam"
local MOTION_MARKER_ATTR = "MegMoMotionMarker"
local PAUSE_SECONDS_ATTR = "MegMoPauseSeconds"
local MARKER_PREVIOUS_TRANSPARENCY_ATTR = "MegMoMotionMarkerPreviousTransparency"
local MARKER_HIDDEN_FOR_PREVIEW_ATTR = "MegMoMotionMarkerHiddenForPreview"
local DEFAULT_CORNER_TURN_SECONDS = 0
local SEGMENT_MOTION_SPEEDS = {
	Run = 14,
	Walk = 8,
	Jump = 10,
	Climb = 6,
	Action = 8,
}

local MOTION_DEFAULT_KEYS = { "Walk", "Run", "Jump", "Climb", "Idle", "Action" }

local motionBeamSignature = nil
local activePreviewState = nil
local getMotionMarkersInWorkspace

local function getWorkspaceRelativePath(instance)
	if not instance then
		return nil
	end
	if instance == workspace then
		return "Workspace"
	end
	if not instance:IsDescendantOf(workspace) then
		return nil
	end

	local segments = {}
	local current = instance
	while current and current ~= workspace do
		table.insert(segments, 1, current.Name)
		current = current.Parent
	end
	table.insert(segments, 1, "Workspace")
	return table.concat(segments, ".")
end

local function getMarkerNumber(name)
	return tonumber(string.match(tostring(name or ""), "^Marker(%d+)$"))
end

local function getMotionBeamTemplate()
	local attachmentTemplate = ServerStorage:FindFirstChild(BEAM_TEMPLATE_NAME)
	if not attachmentTemplate or not attachmentTemplate:IsA("Attachment") then
		return nil, nil
	end

	local beamTemplate = attachmentTemplate:FindFirstChildWhichIsA("Beam", true)
	return attachmentTemplate, beamTemplate
end

local function resolveWorkspacePath(pathText)
	local normalized = tostring(pathText or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if normalized == "" then
		return nil, "Choose a Workspace marker first."
	end
	normalized = normalized:gsub("^game%.", "")
	local segments = string.split(normalized, ".")
	if #segments == 0 then
		return nil, "Enter a valid Workspace path."
	end
	if string.lower(segments[1]) ~= "workspace" then
		table.insert(segments, 1, "Workspace")
	end

	local current = workspace
	for index = 2, #segments do
		current = current and current:FindFirstChild(segments[index])
		if not current then
			return nil, string.format("Could not find '%s' in Workspace.", normalized)
		end
	end
	return current
end

local function getMarkerAnchorPosition(instance)
	if not instance then
		return nil
	end
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	if instance:IsA("BasePart") then
		return instance.Position - instance.CFrame.UpVector * (instance.Size.Y * 0.5)
	end
	if instance:IsA("Model") then
		local boxCFrame, boxSize = instance:GetBoundingBox()
		return boxCFrame.Position - boxCFrame.UpVector * (boxSize.Y * 0.5)
	end

	local current = instance
	while current and current ~= game do
		if current:IsA("Attachment") then
			return current.WorldPosition
		end
		if current:IsA("BasePart") then
			return current.Position - current.CFrame.UpVector * (current.Size.Y * 0.5)
		end
		if current:IsA("Model") then
			local boxCFrame, boxSize = current:GetBoundingBox()
			return boxCFrame.Position - boxCFrame.UpVector * (boxSize.Y * 0.5)
		end
		current = current.Parent
	end
	return nil
end

local function getRigRootPart(rig)
	if not (rig and rig.Parent and rig:IsA("Model")) then
		return nil
	end
	local rootPart = rig:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	for _, rootName in ipairs({ "Torso", "LowerTorso", "UpperTorso" }) do
		local part = rig:FindFirstChild(rootName)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	local primaryPart = rig.PrimaryPart
	if primaryPart and primaryPart.Parent and primaryPart:IsA("BasePart") then
		return primaryPart
	end
	return rig:FindFirstChildWhichIsA("BasePart", true)
end

local function getRigRootTargetForPivot(rig, pivotCFrame, referencePivot, referenceRootCFrame)
	if typeof(pivotCFrame) ~= "CFrame" then
		return pivotCFrame
	end
	if typeof(referencePivot) ~= "CFrame" then
		referencePivot = rig and rig.Parent and rig:IsA("Model") and rig:GetPivot() or nil
	end
	if typeof(referenceRootCFrame) ~= "CFrame" then
		local rootPart = getRigRootPart(rig)
		referenceRootCFrame = rootPart and rootPart.CFrame or nil
	end
	if typeof(referencePivot) == "CFrame" and typeof(referenceRootCFrame) == "CFrame" then
		return pivotCFrame * referencePivot:Inverse() * referenceRootCFrame
	end
	return pivotCFrame
end

local function getSpatialMarkerInstance(instance)
	local current = instance
	while current and current ~= game do
		if current:IsA("Attachment") or current:IsA("BasePart") or current:IsA("Model") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function getMarkerBeamHost(marker)
	if marker and marker:IsA("BasePart") then
		return marker
	end
	return nil
end

local function clearGeneratedBeamAttachments(marker)
	local host = getMarkerBeamHost(marker)
	if not host then
		return
	end

	for _, child in ipairs(host:GetChildren()) do
		if child.Name == MOTION_BEAM_ATTACHMENT_NAME
			or child:GetAttribute(MOTION_BEAM_ATTR) == true then
			child:Destroy()
		end
	end
end

local function createBeamAttachment(marker)
	local host = getMarkerBeamHost(marker)
	if not host then
		return nil
	end

	local attachmentTemplate = getMotionBeamTemplate()
	local attachment
	if attachmentTemplate then
		attachment = attachmentTemplate:Clone()
		for _, descendant in ipairs(attachment:GetDescendants()) do
			if descendant:IsA("Beam") then
				descendant:Destroy()
			end
		end
	else
		attachment = Instance.new("Attachment")
		attachment.Position = Vector3.new(0, host.Size.Y * 0.5 + 0.15, 0)
	end

	attachment.Name = MOTION_BEAM_ATTACHMENT_NAME
	attachment:SetAttribute(MOTION_BEAM_ATTR, true)
	attachment.Parent = host
	return attachment
end

local function createMotionBeam(attachment0, attachment1, index)
	local _, beamTemplate = getMotionBeamTemplate()
	local beam = beamTemplate and beamTemplate:Clone() or Instance.new("Beam")
	beam.Name = string.format("%s%d", MOTION_BEAM_NAME, index)
	beam:SetAttribute(MOTION_BEAM_ATTR, true)
	beam.Attachment0 = attachment0
	beam.Attachment1 = attachment1
	if beam.TextureSpeed &lt; 0 then
		beam.TextureSpeed = math.abs(beam.TextureSpeed)
	end
	if not beamTemplate then
		beam.FaceCamera = true
		beam.Width0 = 0.14
		beam.Width1 = 0.14
		beam.Color = ColorSequence.new(Color3.fromRGB(132, 95, 255), Color3.fromRGB(76, 202, 255))
		beam.Transparency = NumberSequence.new(0.08)
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = 1.2
	end
	beam.Parent = attachment0
	return beam
end

local function getMarkerSignature(markers)
	local parts = {}
	for index, marker in ipairs(markers or {}) do
		parts[index] = getWorkspaceRelativePath(marker) or marker.Name
	end
	return table.concat(parts, "|")
end

local function getMotionSegmentKey(fromPath, toPath, index)
	return table.concat({
		tostring(index or 0),
		tostring(fromPath or ""),
		tostring(toPath or ""),
	}, "|")
end

local function parseMotionSegmentKey(segmentKey)
	local parts = string.split(tostring(segmentKey or ""), "|")
	return tonumber(parts[1]), parts[2], parts[3]
end

local function normalizeSegmentMotionName(motionName)
	motionName = tostring(motionName or "Path Only")
	if motionName == "Run" or motionName == "Walk" or motionName == "Jump" or motionName == "Climb" or motionName == "Idle" or motionName == "Action" then
		return motionName
	end
	return "Path Only"
end

local function inferSegmentMotionName(fromAnchor, toAnchor)
	if typeof(fromAnchor) ~= "Vector3" or typeof(toAnchor) ~= "Vector3" then
		return "Path Only"
	end

	local delta = toAnchor - fromAnchor
	local upwardStuds = delta.Y
	if upwardStuds &lt; 3 then
		return "Path Only"
	end

	local horizontalDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local totalDistance = delta.Magnitude
	if totalDistance &lt; 4 then
		return "Path Only"
	end

	local verticalShare = upwardStuds / math.max(totalDistance, 0.001)
	if upwardStuds &gt; horizontalDistance * 1.15 and verticalShare &gt;= 0.55 then
		return "Climb"
	end

	return "Path Only"
end

local function getMotionNameForSegment(segmentMotions, segmentKey, index, fromMarker, fromAnchor, toAnchor)
	if type(segmentMotions) ~= "table" then
		if fromMarker then
			local markerMotion = normalizeSegmentMotionName(fromMarker:GetAttribute(SEGMENT_MOTION_ATTR))
			if markerMotion ~= "Path Only" then
				return markerMotion
			end
		end
		return inferSegmentMotionName(fromAnchor, toAnchor)
	end

	local motionName = segmentMotions[segmentKey]
	if motionName == nil then
		motionName = segmentMotions[tostring(index)] or segmentMotions[index]
	end
	if motionName ~= nil then
		return normalizeSegmentMotionName(motionName)
	end
	if fromMarker then
		local markerMotion = normalizeSegmentMotionName(fromMarker:GetAttribute(SEGMENT_MOTION_ATTR))
		if markerMotion ~= "Path Only" then
			return markerMotion
		end
	end
	return inferSegmentMotionName(fromAnchor, toAnchor)
end

local function getSegmentNumberOverride(overrides, segmentKey, index, allowZero)
	if type(overrides) ~= "table" then
		return nil
	end

	local value = overrides[segmentKey]
	if value == nil then
		value = overrides[tostring(index)] or overrides[index]
	end

	local numeric = tonumber(value)
	if numeric and (numeric &gt; 0 or allowZero) then
		return numeric
	end
	return nil
end

local function getSegmentStringOverride(overrides, segmentKey, index)
	if type(overrides) ~= "table" then
		return nil
	end

	local value = overrides[segmentKey]
	if value == nil then
		value = overrides[tostring(index)] or overrides[index]
	end

	value = tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if value ~= "" then
		return value
	end
	return nil
end

local function getTrimmedString(value)
	value = tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
	return value ~= "" and value or nil
end

local function copyStringMap(source, allowedKeys)
	local copy = {}
	if type(source) ~= "table" then
		return copy
	end

	if type(allowedKeys) == "table" then
		for _, key in ipairs(allowedKeys) do
			local value = getTrimmedString(source[key])
			if value then
				copy[key] = value
			end
		end
		return copy
	end

	for key, value in pairs(source) do
		local trimmed = getTrimmedString(value)
		if trimmed then
			copy[tostring(key)] = trimmed
		end
	end
	return copy
end

local function copyDefaultClipsByRigType(source)
	local copy = {}
	if type(source) ~= "table" then
		return copy
	end

	for rigType, defaults in pairs(source) do
		local normalizedRigType = tostring(rigType or "") == "R6" and "R6" or "R15"
		local defaultClips = copyStringMap(defaults, MOTION_DEFAULT_KEYS)
		if next(defaultClips) ~= nil then
			copy[normalizedRigType] = defaultClips
		end
	end
	return copy
end

local function copyNumberMap(source)
	local copy = {}
	if type(source) ~= "table" then
		return copy
	end

	for key, value in pairs(source) do
		local numeric = tonumber(value)
		if numeric then
			copy[tostring(key)] = numeric
		end
	end
	return copy
end

local function vectorToData(vector)
	if typeof(vector) ~= "Vector3" then
		return nil
	end
	return {
		x = vector.X,
		y = vector.Y,
		z = vector.Z,
	}
end

local function vectorFromData(data)
	if type(data) ~= "table" then
		return nil
	end
	local x = tonumber(data.x)
	local y = tonumber(data.y)
	local z = tonumber(data.z)
	if not x or not y or not z then
		return nil
	end
	return Vector3.new(x, y, z)
end

local function getMarkerNumberAttribute(marker, attributeName, allowZero)
	if not marker then
		return nil
	end

	local numeric = tonumber(marker:GetAttribute(attributeName))
	if numeric and (numeric &gt; 0 or allowZero) then
		return numeric
	end
	return nil
end

local function getSegmentSpeed(motionName, fallbackSpeed)
	local speed = SEGMENT_MOTION_SPEEDS[motionName]
	if speed then
		return speed
	end
	return fallbackSpeed
end

local function syncMotionMarkerBeams(markers, force)
	markers = markers or {}
	local signature = getMarkerSignature(markers)
	if not force and signature == motionBeamSignature then
		return
	end

	for _, marker in ipairs(markers) do
		clearGeneratedBeamAttachments(marker)
	end

	local attachments = {}
	for index, marker in ipairs(markers) do
		attachments[index] = createBeamAttachment(marker)
	end

	for index = 1, #attachments - 1 do
		if attachments[index] and attachments[index + 1] then
			createMotionBeam(attachments[index], attachments[index + 1], index)
		end
	end

	motionBeamSignature = signature
end

local function syncWorkspaceMotionMarkerBeams(force)
	local markers = getMotionMarkersInWorkspace()
	syncMotionMarkerBeams(markers, force)
	return markers
end

local function getRigGroundOffset(rig)
	if not rig or not rig.Parent then
		return 0
	end
	local pivot = rig:GetPivot()
	local boxCFrame, boxSize = rig:GetBoundingBox()
	local bottomY = boxCFrame.Position.Y - (boxSize.Y * 0.5)
	return math.max(0, pivot.Position.Y - bottomY)
end

local function getRigGroundPosition(rig)
	if not rig or not rig.Parent then
		return nil
	end

	local pivot = rig:GetPivot()
	local boxCFrame, boxSize = rig:GetBoundingBox()
	return Vector3.new(pivot.Position.X, boxCFrame.Position.Y - (boxSize.Y * 0.5), pivot.Position.Z)
end

local function getRotationOnly(cf)
	return cf - cf.Position
end

local DEFAULT_MARKER_LOOK = Vector3.new(0, 0, -1)

local function getMarkerCFrame(instance)
	if not instance then
		return nil
	end
	if instance:IsA("Attachment") then
		return instance.WorldCFrame
	end
	if instance:IsA("BasePart") then
		return instance.CFrame
	end
	if instance:IsA("Model") then
		return instance:GetPivot()
	end
	return nil
end

local function getExplicitMarkerLookVector(instance)
	local markerCFrame = getMarkerCFrame(getSpatialMarkerInstance(instance))
	if not markerCFrame then
		return nil
	end
	local look = markerCFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude &lt;= 0.001 then
		return nil
	end
	flatLook = flatLook.Unit
	if flatLook:Dot(DEFAULT_MARKER_LOOK) &gt; 0.999 then
		return nil
	end
	return flatLook
end

local function getExplicitMarkerRotation(instance)
	local flatLook = getExplicitMarkerLookVector(instance)
	if not flatLook then
		return nil
	end
	return getRotationOnly(CFrame.lookAt(Vector3.zero, flatLook))
end

local function applyExplicitMarkerLook(marker, flatLook)
	if not marker or typeof(flatLook) ~= "Vector3" or flatLook.Magnitude &lt;= 0.001 then
		return
	end
	flatLook = Vector3.new(flatLook.X, 0, flatLook.Z)
	if flatLook.Magnitude &lt;= 0.001 then
		return
	end
	flatLook = flatLook.Unit
	if marker:IsA("BasePart") then
		marker.CFrame = CFrame.lookAt(marker.Position, marker.Position + flatLook)
	end
end

local function getMarkerPauseSeconds(instance)
	if not instance then
		return 0
	end

	local candidates = {
		instance:GetAttribute(PAUSE_SECONDS_ATTR),
		instance:GetAttribute("PauseSeconds"),
	}

	for _, value in ipairs(candidates) do
		local numeric = tonumber(value)
		if numeric and numeric &gt; 0 then
			return numeric
		end
	end

	local child = instance:FindFirstChild(PAUSE_SECONDS_ATTR)
		or instance:FindFirstChild("PauseSeconds")
	if child and child:IsA("NumberValue") then
		local numeric = tonumber(child.Value)
		if numeric and numeric &gt; 0 then
			return numeric
		end
	end

	return 0
end

local function estimateDurationSeconds(distance, speedStudsPerSecond)
	local speed = tonumber(speedStudsPerSecond) or 8
	if speed &lt;= 0 then
		speed = 8
	end
	local estimatedDuration = distance / speed
	return math.max(0.5, math.min(60, math.floor((estimatedDuration * 4) + 0.5) / 4))
end

local function ensureRigMotionTrack(timeline, rig)
	local existingTrack = timeline:getRigPropertyTrack(rig.Name, "CFrame")
	if existingTrack then
		existingTrack.instance = rig
		existingTrack.rig = rig
		existingTrack.rigName = rig.Name
		existingTrack.propertyName = "CFrame"
		existingTrack.targetScope = "RigProperty"
		existingTrack.valueType = "CFrame"
		timeline:setTrackDisabled(existingTrack.path, false)
		return existingTrack, false
	end

	local track = timeline:addGenericTrack("RigProperty", rig, "CFrame", {
		rig = rig,
		rigName = rig.Name,
		propertyName = "CFrame",
		targetScope = "RigProperty",
		sortOrder = 1,
	})
	return track, true
end

local function clearTrackKeyframes(timeline, trackPath)
	if not timeline or not trackPath then
		return
	end

	local frames = timeline:getTrackKeyframeFrames(trackPath)
	if type(frames) ~= "table" or #frames == 0 then
		return
	end

	local keys = {}
	for _, frame in ipairs(frames) do
		table.insert(keys, {
			path = trackPath,
			frame = frame,
		})
	end

	timeline:deleteTrackKeyframes(keys)
end

local function createOrUpdateMotionMarker(name, position)
	local marker = workspace:FindFirstChild(name)
	if marker and not marker:IsA("BasePart") then
		marker:Destroy()
		marker = nil
	end
	if not marker then
		marker = Instance.new("Part")
		marker.Name = name
		marker.Size = Vector3.new(4, 1, 4)
		marker.Anchored = true
		marker.CanCollide = false
		marker.CanQuery = true
		marker.CanTouch = false
		marker.Material = Enum.Material.ForceField
		marker.Color = Color3.fromRGB(120, 84, 255)
		marker.Transparency = 0.35
		marker.TopSurface = Enum.SurfaceType.Smooth
		marker.BottomSurface = Enum.SurfaceType.Smooth
		marker.Parent = workspace
	end
	marker:SetAttribute(MOTION_MARKER_ATTR, true)
	marker.CFrame = CFrame.new(position.X, position.Y + marker.Size.Y * 0.5, position.Z)
	return marker
end

function getMotionMarkersInWorkspace()
	local markers = {}
	for _, child in ipairs(workspace:GetChildren()) do
		if child:GetAttribute(MOTION_MARKER_ATTR) == true then
			table.insert(markers, child)
		elseif child:IsA("BasePart") and string.match(child.Name, "^Marker%d+$") then
			table.insert(markers, child)
		end
	end
	table.sort(markers, function(a, b)
		local aNumber = getMarkerNumber(a.Name)
		local bNumber = getMarkerNumber(b.Name)
		if aNumber and bNumber and aNumber ~= bNumber then
			return aNumber &lt; bNumber
		end
		if aNumber ~= nil then
			return true
		end
		if bNumber ~= nil then
			return false
		end
		return a.Name &lt; b.Name
	end)
	return markers
end

local function getNextMarkerName(markers)
	local used = {}
	for _, marker in ipairs(markers or {}) do
		used[marker.Name] = true
	end

	local index = 1
	while used[string.format("Marker%d", index)] do
		index += 1
	end
	return string.format("Marker%d", index)
end

local function getPlacementForward(rig, markers, fallbackCFrame)
	if #markers &gt;= 2 then
		local previousAnchor = getMarkerAnchorPosition(markers[#markers - 1])
		local lastAnchor = getMarkerAnchorPosition(markers[#markers])
		if previousAnchor and lastAnchor then
			local direction = Vector3.new(lastAnchor.X - previousAnchor.X, 0, lastAnchor.Z - previousAnchor.Z)
			if direction.Magnitude &gt; 0.001 then
				return direction.Unit
			end
		end
	end

	if rig and rig.Parent then
		local pivot = rig:GetPivot()
		local direction = Vector3.new(pivot.LookVector.X, 0, pivot.LookVector.Z)
		if direction.Magnitude &gt; 0.001 then
			return direction.Unit
		end
	end

	if fallbackCFrame then
		local direction = Vector3.new(fallbackCFrame.LookVector.X, 0, fallbackCFrame.LookVector.Z)
		if direction.Magnitude &gt; 0.001 then
			return direction.Unit
		end
	end

	return Vector3.new(0, 0, -1)
end

function MotionService.createMotionMarkers(deps)
	local timeline = deps.timeline
	local selectionService = deps.selectionService
	local getRigInsertCFrame = deps.getRigInsertCFrame
	local refreshUi = deps.refreshUi

	local rig = timeline:getRig() or selectionService.getSelectedRig()
	local basePosition
	local forward
	if rig and rig.Parent then
		local pivot = rig:GetPivot()
		local boxCFrame, boxSize = rig:GetBoundingBox()
		basePosition = Vector3.new(pivot.Position.X, boxCFrame.Position.Y - (boxSize.Y * 0.5), pivot.Position.Z)
		forward = Vector3.new(pivot.LookVector.X, 0, pivot.LookVector.Z)
	else
		local insertCFrame = getRigInsertCFrame()
		basePosition = insertCFrame.Position
		forward = Vector3.new(insertCFrame.LookVector.X, 0, insertCFrame.LookVector.Z)
	end
	if forward.Magnitude &lt; 0.001 then
		forward = Vector3.new(0, 0, -1)
	else
		forward = forward.Unit
	end

	local marker1 = createOrUpdateMotionMarker("Marker1", basePosition)
	local marker2 = createOrUpdateMotionMarker("Marker2", basePosition + forward * 12)
	syncWorkspaceMotionMarkerBeams(true)
	selectionService.setSelection({ marker1, marker2 })
	local status = "Created/updated Workspace.Marker1 and Workspace.Marker2 with a path guide. Move them, then click Build Timeline."
	refreshUi(status)
	return true, status
end

function MotionService.addMotionMarker(deps)
	local timeline = deps.timeline
	local selectionService = deps.selectionService
	local getRigInsertCFrame = deps.getRigInsertCFrame
	local refreshUi = deps.refreshUi

	local markers = getMotionMarkersInWorkspace()
	local markerName = getNextMarkerName(markers)
	local markerPosition
	local rig = timeline:getRig() or selectionService.getSelectedRig()
	local insertCFrame = nil
	if #markers &gt; 0 then
		local lastMarker = markers[#markers]
		local lastAnchor = getMarkerAnchorPosition(lastMarker) or lastMarker.Position
		local forward = getPlacementForward(rig, markers, nil)
		markerPosition = lastAnchor + forward * 12
	else
		if rig and rig.Parent then
			markerPosition = getRigGroundPosition(rig)
		else
			insertCFrame = getRigInsertCFrame()
			markerPosition = Vector3.new(insertCFrame.Position.X, 0, insertCFrame.Position.Z)
		end
	end

	local marker = createOrUpdateMotionMarker(markerName, markerPosition)
	syncWorkspaceMotionMarkerBeams(true)
	selectionService.setSelection({ marker })
	local status = string.format("Added %s and updated the path guide. Move it in Workspace, then add the next marker.", marker.Name)
	refreshUi(status)
	return true, status
end

function MotionService.selectMotionMarker(deps, markerPath)
	local refreshUi = deps.refreshUi
	local selectionService = deps.selectionService
	local marker, message = resolveWorkspacePath(markerPath)
	if not marker then
		refreshUi(message)
		return false, message
	end

	selectionService.setSelection({ marker })
	local status = string.format("Selected %s in Workspace.", marker.Name)
	refreshUi(status)
	return true, status
end

function MotionService.clearMotionMarkers(deps)
	local refreshUi = deps.refreshUi
	local markers = getMotionMarkersInWorkspace()
	for _, marker in ipairs(markers) do
		marker:Destroy()
	end
	motionBeamSignature = nil
	local status = #markers &gt; 0
		and string.format("Cleared %d motion marker%s.", #markers, #markers == 1 and "" or "s")
		or "There were no motion markers to clear."
	refreshUi(status)
	return true, status
end

function MotionService.clearGeneratedMotionMarkers()
	local clearedCount = 0
	for _, child in ipairs(workspace:GetChildren()) do
		if child:GetAttribute(MOTION_MARKER_ATTR) == true then
			clearGeneratedBeamAttachments(child)
			child:Destroy()
			clearedCount += 1
		elseif child:IsA("BasePart") then
			clearGeneratedBeamAttachments(child)
		end
	end
	motionBeamSignature = nil
	return clearedCount
end

function MotionService.deleteSelectedMotionMarker(deps)
	local refreshUi = deps.refreshUi
	local selectionService = deps.selectionService
	local selected = selectionService.getSelection and selectionService.getSelection() or {}
	local markers = getMotionMarkersInWorkspace()
	local markerSet = {}
	for _, marker in ipairs(markers) do
		markerSet[marker] = true
	end

	local markerToDelete = nil
	for _, instance in ipairs(selected) do
		local marker = getSpatialMarkerInstance(instance)
		if marker and markerSet[marker] then
			markerToDelete = marker
			break
		end
	end

	if not markerToDelete then
		markerToDelete = markers[#markers]
	end
	if not markerToDelete then
		local status = "There are no motion markers to delete."
		refreshUi(status)
		return false, status
	end

	local deletedName = markerToDelete.Name
	markerToDelete:Destroy()
	motionBeamSignature = nil
	syncWorkspaceMotionMarkerBeams(true)
	selectionService.setSelection({})
	local status = string.format("Deleted %s. Segment settings were reset for the updated path.", deletedName)
	refreshUi(status)
	return true, status
end

function MotionService.listMotionMarkers()
	local markers = {}
	for _, marker in ipairs(syncWorkspaceMotionMarkerBeams(false)) do
		table.insert(markers, {
			name = marker.Name,
			path = getWorkspaceRelativePath(marker),
			pauseSeconds = getMarkerPauseSeconds(marker),
		})
	end
	return markers
end

function MotionService.listMotionSegments(options)
	options = options or {}
	local speedStudsPerSecond = tonumber(options.speedStudsPerSecond)
	local defaultTurnSeconds = math.max(0, tonumber(options.turnSeconds) or DEFAULT_CORNER_TURN_SECONDS)
	local segmentMotions = options.segmentMotions or {}
	local segmentDurations = options.segmentDurations or options.segmentDurationOverrides or {}
	local segmentPauses = options.segmentPauses or options.segmentPauseOverrides or {}
	local segmentBlends = options.segmentBlends or options.segmentBlendOverrides or {}
	local segmentClips = options.segmentClips or {}
	local segmentPauseIdles = options.segmentPauseIdles or {}
	local defaultClips = options.defaultClips or options.motionDefaultClips or {}
	local markers = syncWorkspaceMotionMarkerBeams(false)
	local segments = {}
	for index = 1, #markers - 1 do
		local fromMarker = markers[index]
		local toMarker = markers[index + 1]
		local fromPath = getWorkspaceRelativePath(fromMarker)
		local toPath = getWorkspaceRelativePath(toMarker)
		local segmentKey = getMotionSegmentKey(fromPath, toPath, index)
		local fromAnchor = getMarkerAnchorPosition(fromMarker)
		local toAnchor = getMarkerAnchorPosition(toMarker)
		local motionName = getMotionNameForSegment(segmentMotions, segmentKey, index, fromMarker, fromAnchor, toAnchor)
		local distance = 0
		local durationSeconds = 0
		if fromAnchor and toAnchor then
			distance = (toAnchor - fromAnchor).Magnitude
			durationSeconds = estimateDurationSeconds(distance, getSegmentSpeed(motionName, speedStudsPerSecond))
		end
		local autoDurationSeconds = durationSeconds
		local durationOverrideSeconds = getSegmentNumberOverride(segmentDurations, segmentKey, index, false)
			or getMarkerNumberAttribute(fromMarker, SEGMENT_DURATION_ATTR, false)
		if durationOverrideSeconds then
			durationSeconds = durationOverrideSeconds
		end
		local markerPauseSeconds = getMarkerPauseSeconds(toMarker)
		local pauseOverrideSeconds = getSegmentNumberOverride(segmentPauses, segmentKey, index, true)
			or getMarkerNumberAttribute(fromMarker, SEGMENT_PAUSE_ATTR, true)
		local pauseAfterSeconds = pauseOverrideSeconds
		if pauseAfterSeconds == nil then
			pauseAfterSeconds = markerPauseSeconds
		end
		local blendOverrideSeconds = getSegmentNumberOverride(segmentBlends, segmentKey, index, true)
			or getMarkerNumberAttribute(fromMarker, SEGMENT_BLEND_ATTR, true)
		local hasNextSegment = index &lt; (#markers - 1)
		local blendSeconds = hasNextSegment and defaultTurnSeconds or 0
		if blendOverrideSeconds ~= nil then
			blendSeconds = hasNextSegment and blendOverrideSeconds or 0
		end
		local clipId = getSegmentStringOverride(segmentClips, segmentKey, index)
			or tostring(fromMarker:GetAttribute(SEGMENT_CLIP_ATTR) or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if clipId == "" then
			clipId = nil
		end
		local defaultClipId = getTrimmedString(defaultClips[motionName])
		local usesDefaultClip = false
		if not clipId and motionName ~= "Path Only" and defaultClipId then
			clipId = defaultClipId
			usesDefaultClip = true
		end
		local pauseIdleClipId = getSegmentStringOverride(segmentPauseIdles, segmentKey, index)
			or tostring(fromMarker:GetAttribute(SEGMENT_PAUSE_IDLE_ATTR) or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if pauseIdleClipId == "" then
			pauseIdleClipId = nil
		end
		local defaultPauseIdleClipId = getTrimmedString(defaultClips.Idle)
		local usesDefaultPauseIdle = false
		if not pauseIdleClipId and pauseAfterSeconds and pauseAfterSeconds &gt; 0 and defaultPauseIdleClipId then
			pauseIdleClipId = defaultPauseIdleClipId
			usesDefaultPauseIdle = true
		end
		table.insert(segments, {
			index = index,
			segmentKey = segmentKey,
			fromName = fromMarker.Name,
			toName = toMarker.Name,
			fromPath = fromPath,
			toPath = toPath,
			distanceStuds = distance,
			durationSeconds = durationSeconds,
			autoDurationSeconds = autoDurationSeconds,
			durationOverrideSeconds = durationOverrideSeconds,
			pauseAfterSeconds = pauseAfterSeconds,
			markerPauseSeconds = markerPauseSeconds,
			pauseOverrideSeconds = pauseOverrideSeconds,
			blendSeconds = blendSeconds,
			autoBlendSeconds = hasNextSegment and defaultTurnSeconds or 0,
			blendOverrideSeconds = blendOverrideSeconds,
			hasNextSegment = hasNextSegment,
			motionName = motionName,
			clipId = clipId,
			usesDefaultClip = usesDefaultClip,
			pauseIdleClipId = pauseIdleClipId,
			usesDefaultPauseIdle = usesDefaultPauseIdle,
		})
	end
	return segments
end

function MotionService.captureMotionRecipe(options)
	options = options or {}
	local markers = {}
	for _, marker in ipairs(getMotionMarkersInWorkspace()) do
		table.insert(markers, {
			name = marker.Name,
			path = getWorkspaceRelativePath(marker),
			position = vectorToData(getMarkerAnchorPosition(marker)),
			facing = vectorToData(getExplicitMarkerLookVector(marker)),
			pauseSeconds = getMarkerPauseSeconds(marker),
		})
	end

	local segments = {}
	for _, segment in ipairs(MotionService.listMotionSegments(options)) do
		table.insert(segments, {
			index = segment.index,
			fromName = segment.fromName,
			toName = segment.toName,
			motionName = segment.motionName,
			durationOverrideSeconds = segment.durationOverrideSeconds,
			pauseOverrideSeconds = segment.pauseOverrideSeconds,
			blendOverrideSeconds = segment.blendOverrideSeconds,
			clipId = segment.usesDefaultClip and nil or segment.clipId,
			pauseIdleClipId = segment.usesDefaultPauseIdle and nil or segment.pauseIdleClipId,
		})
	end

	return {
		format = MOTION_RECIPE_FORMAT,
		formatVersion = 1,
		defaultClips = copyStringMap(options.defaultClips or options.motionDefaultClips, MOTION_DEFAULT_KEYS),
		defaultClipsByRigType = copyDefaultClipsByRigType(options.defaultClipsByRigType),
		segmentMotions = copyStringMap(options.segmentMotions),
		segmentDurations = copyNumberMap(options.segmentDurations or options.segmentDurationOverrides),
		segmentPauses = copyNumberMap(options.segmentPauses or options.segmentPauseOverrides),
		segmentBlends = copyNumberMap(options.segmentBlends or options.segmentBlendOverrides),
		segmentClips = copyStringMap(options.segmentClips),
		segmentPauseIdles = copyStringMap(options.segmentPauseIdles),
		markers = markers,
		segments = segments,
	}
end

function MotionService.restoreMotionRecipe(deps, recipe)
	if type(recipe) ~= "table" or recipe.format ~= MOTION_RECIPE_FORMAT then
		return false, "No Motion Builder recipe was saved with this project."
	end

	local selectionService = deps.selectionService
	local restoredMarkers = {}
	for _, markerData in ipairs(type(recipe.markers) == "table" and recipe.markers or {}) do
		local markerName = tostring(markerData.name or "")
		local markerPosition = vectorFromData(markerData.position)
		if markerName ~= "" and markerPosition then
			local marker = createOrUpdateMotionMarker(markerName, markerPosition)
			applyExplicitMarkerLook(marker, vectorFromData(markerData.facing))
			local pauseSeconds = tonumber(markerData.pauseSeconds) or 0
			marker:SetAttribute(PAUSE_SECONDS_ATTR, pauseSeconds &gt; 0 and pauseSeconds or nil)
			table.insert(restoredMarkers, marker)
		end
	end
	syncWorkspaceMotionMarkerBeams(true)

	local restoredState = {
		defaultClips = copyStringMap(recipe.defaultClips, MOTION_DEFAULT_KEYS),
		defaultClipsByRigType = copyDefaultClipsByRigType(recipe.defaultClipsByRigType),
		segmentMotions = {},
		segmentDurations = {},
		segmentPauses = {},
		segmentBlends = {},
		segmentClips = {},
		segmentPauseIdles = {},
	}

	local currentSegments = MotionService.listMotionSegments({
		defaultClips = restoredState.defaultClips,
	})
	for index, savedSegment in ipairs(type(recipe.segments) == "table" and recipe.segments or {}) do
		local currentSegment = currentSegments[index]
		local segmentKey = currentSegment and currentSegment.segmentKey
		if segmentKey then
			local motionName = normalizeSegmentMotionName(savedSegment.motionName)
			if motionName ~= "Path Only" then
				restoredState.segmentMotions[segmentKey] = motionName
				MotionService.setMotionSegmentSetting(segmentKey, "motion", motionName)
			end

			local durationSeconds = tonumber(savedSegment.durationOverrideSeconds)
			if durationSeconds and durationSeconds &gt; 0 then
				restoredState.segmentDurations[segmentKey] = durationSeconds
				MotionService.setMotionSegmentSetting(segmentKey, "duration", durationSeconds)
			end

			local pauseSeconds = tonumber(savedSegment.pauseOverrideSeconds)
			if pauseSeconds then
				restoredState.segmentPauses[segmentKey] = pauseSeconds
				MotionService.setMotionSegmentSetting(segmentKey, "pause", pauseSeconds)
			end

			local blendSeconds = tonumber(savedSegment.blendOverrideSeconds)
			if blendSeconds then
				restoredState.segmentBlends[segmentKey] = blendSeconds
				MotionService.setMotionSegmentSetting(segmentKey, "blend", blendSeconds)
			end

			local clipId = getTrimmedString(savedSegment.clipId)
			if clipId then
				restoredState.segmentClips[segmentKey] = clipId
				MotionService.setMotionSegmentSetting(segmentKey, "clip", clipId)
			end

			local pauseIdleClipId = getTrimmedString(savedSegment.pauseIdleClipId)
			if pauseIdleClipId then
				restoredState.segmentPauseIdles[segmentKey] = pauseIdleClipId
				MotionService.setMotionSegmentSetting(segmentKey, "pauseIdle", pauseIdleClipId)
			end
		end
	end

	if selectionService and #restoredMarkers &gt; 0 then
		selectionService.setSelection(restoredMarkers)
	end

	local status = string.format("Restored Motion Builder recipe with %d marker%s.", #restoredMarkers, #restoredMarkers == 1 and "" or "s")
	if deps.refreshUi then
		deps.refreshUi(status)
	end
	return true, status, restoredState
end

function MotionService.setMotionSegmentSetting(segmentKey, settingName, value)
	local _, fromPath = parseMotionSegmentKey(segmentKey)
	local marker, message = resolveWorkspacePath(fromPath)
	if not marker then
		return false, message
	end

	if settingName == "motion" then
		local motionName = normalizeSegmentMotionName(value)
		marker:SetAttribute(SEGMENT_MOTION_ATTR, motionName == "Path Only" and nil or motionName)
		return true
	end
	if settingName == "duration" then
		marker:SetAttribute(SEGMENT_DURATION_ATTR, value)
		return true
	end
	if settingName == "pause" then
		marker:SetAttribute(SEGMENT_PAUSE_ATTR, value)
		return true
	end
	if settingName == "blend" then
		marker:SetAttribute(SEGMENT_BLEND_ATTR, value)
		return true
	end
	if settingName == "clip" then
		local clipId = tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
		marker:SetAttribute(SEGMENT_CLIP_ATTR, clipId ~= "" and clipId or nil)
		return true
	end
	if settingName == "pauseIdle" then
		local clipId = tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
		marker:SetAttribute(SEGMENT_PAUSE_IDLE_ATTR, clipId ~= "" and clipId or nil)
		return true
	end

	return false, "Unknown motion segment setting."
end

function MotionService.clearMotionSegmentSettings()
	local clearedCount = 0
	for _, marker in ipairs(getMotionMarkersInWorkspace()) do
		if marker:GetAttribute(SEGMENT_MOTION_ATTR) ~= nil
			or marker:GetAttribute(SEGMENT_DURATION_ATTR) ~= nil
			or marker:GetAttribute(SEGMENT_PAUSE_ATTR) ~= nil
			or marker:GetAttribute(SEGMENT_BLEND_ATTR) ~= nil
			or marker:GetAttribute(SEGMENT_CLIP_ATTR) ~= nil
			or marker:GetAttribute(SEGMENT_PAUSE_IDLE_ATTR) ~= nil then
			clearedCount += 1
		end
		marker:SetAttribute(SEGMENT_MOTION_ATTR, nil)
		marker:SetAttribute(SEGMENT_DURATION_ATTR, nil)
		marker:SetAttribute(SEGMENT_PAUSE_ATTR, nil)
		marker:SetAttribute(SEGMENT_BLEND_ATTR, nil)
		marker:SetAttribute(SEGMENT_CLIP_ATTR, nil)
		marker:SetAttribute(SEGMENT_PAUSE_IDLE_ATTR, nil)
	end
	return clearedCount
end

local stopActivePreview

function MotionService.getMotionPreviewState()
	if not activePreviewState then
		return {
			isPreviewing = false,
		}
	end

	return {
		isPreviewing = true,
		segmentKey = activePreviewState.previewKey,
		label = activePreviewState.previewLabel,
	}
end

function MotionService.stopMotionPreview(deps, message)
	if not activePreviewState then
		local status = "No Motion Builder preview is currently running."
		if deps and deps.refreshUi then
			deps.refreshUi(status)
		end
		return false, status
	end

	stopActivePreview(true)
	local status = message or "Stopped Motion Builder preview."
	if deps and deps.refreshUi then
		deps.refreshUi(status)
	end
	return true, status
end

local function restorePreviewVisuals(state)
	if not state or state.visualsRestored then
		return
	end
	state.visualsRestored = true

	for _, markerState in ipairs(state.markerStates or {}) do
		if markerState.marker and markerState.marker.Parent then
			markerState.marker.Color = markerState.color
			markerState.marker.Transparency = markerState.transparency
			markerState.marker.Material = markerState.material
		end
	end
	for _, beamState in ipairs(state.beamStates or {}) do
		if beamState.beam and beamState.beam.Parent then
			beamState.beam.Enabled = beamState.enabled
			beamState.beam.Color = beamState.color
			beamState.beam.Transparency = beamState.transparency
			beamState.beam.Width0 = beamState.width0
			beamState.beam.Width1 = beamState.width1
		end
	end
end

local restorePreviewMotorPose

local function restorePreviewRigState(state, restoreRig)
	restorePreviewVisuals(state)
	if restorePreviewMotorPose then
		restorePreviewMotorPose(state, true)
	end

	local rig = state and state.rig
	local targetPivot = state and (state.returnPivot or state.originalPivot)
	if restoreRig ~= false and rig and rig.Parent and targetPivot then
		rig:PivotTo(targetPivot)
		task.defer(function()
			RunService.Heartbeat:Wait()
			if activePreviewState and activePreviewState ~= state then
				return
			end
			if rig and rig.Parent then
				if restorePreviewMotorPose then
					restorePreviewMotorPose(state, true)
				end
				rig:PivotTo(targetPivot)
			end
		end)
	end

	if state and state.gizmoController then
		state.gizmoController:setSuppressed(false)
	end
end

stopActivePreview = function(restoreRig)
	local state = activePreviewState
	if not state then
		return
	end

	state.cancelled = true
	restorePreviewRigState(state, restoreRig)
	activePreviewState = nil
end

local function createPreviewState(rig, markers, gizmoController, timeline)
	local state = {
		rig = rig,
		originalPivot = rig:GetPivot(),
		originalMotorPose = {},
		defaultMotorPose = {},
		markerStates = {},
		beamStates = {},
		gizmoController = gizmoController,
		cancelled = false,
		visualsRestored = false,
	}

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			state.originalMotorPose[descendant] = descendant.C0
		end
	end

	if timeline then
		for _, motorData in ipairs(timeline:getMotors()) do
			if motorData.rig == rig and motorData.instance and motorData.instance.Parent then
				local defaultC0 = timeline:getOriginalPose(motorData.path)
				if typeof(defaultC0) == "CFrame" then
					state.defaultMotorPose[motorData.instance] = defaultC0
				end
			end
		end
	end

	for _, marker in ipairs(markers or {}) do
		if marker:IsA("BasePart") then
			table.insert(state.markerStates, {
				marker = marker,
				color = marker.Color,
				transparency = marker.Transparency,
				material = marker.Material,
			})
		end
		for _, descendant in ipairs(marker:GetDescendants()) do
			if descendant:IsA("Beam")
				and descendant:GetAttribute(MOTION_BEAM_ATTR) == true then
				table.insert(state.beamStates, {
					beam = descendant,
					enabled = descendant.Enabled,
					color = descendant.Color,
					transparency = descendant.Transparency,
					width0 = descendant.Width0,
					width1 = descendant.Width1,
				})
			end
		end
	end

	return state
end

restorePreviewMotorPose = function(state, useDefaultPose)
	if not state then
		return
	end

	local sourcePose = useDefaultPose and state.defaultMotorPose or state.originalMotorPose
	if not sourcePose or next(sourcePose) == nil then
		sourcePose = state.originalMotorPose
	end
	for motor, c0 in pairs(sourcePose or {}) do
		if motor and motor.Parent and typeof(c0) == "CFrame" then
			motor.C0 = c0
		end
	end
end

local function describePreviewRigMotors(rig, basePose)
	local motors = {}
	local lookup = {}
	local originalPose = {}

	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			local path = descendant.Name
			if descendant.Part1 then
				path = descendant.Part1.Name
				lookup[descendant.Part1.Name] = path
			end
			lookup[descendant.Name] = path
			motors[path] = descendant
			originalPose[path] = basePose and basePose[descendant] or descendant.C0
		end
	end

	return {
		motors = motors,
		lookup = lookup,
		originalPose = originalPose,
	}
end

local function buildPreviewPoseDataFromKeyframeSequence(keyframeSequence, rigData)
	if not keyframeSequence or not rigData or not keyframeSequence:IsA("KeyframeSequence") then
		return nil
	end

	local keyframes = keyframeSequence:GetKeyframes()
	if #keyframes == 0 then
		return nil
	end

	local frames = {}
	local duration = 0
	for _, keyframe in ipairs(keyframes) do
		local time = tonumber(keyframe.Time) or 0
		local pose = {}
		local hasPose = false
		for _, descendant in ipairs(keyframe:GetDescendants()) do
			if descendant:IsA("Pose") then
				local path = rigData.lookup[descendant.Name]
				local originalC0 = path and rigData.originalPose[path]
				if path and typeof(originalC0) == "CFrame" then
					pose[path] = originalC0 * descendant.CFrame
					hasPose = true
				end
			end
		end

		if hasPose then
			table.insert(frames, {
				time = time,
				pose = pose,
			})
			duration = math.max(duration, time)
		end
	end

	if #frames == 0 then
		return nil
	end

	table.sort(frames, function(a, b)
		return a.time &lt; b.time
	end)

	return {
		frames = frames,
		duration = duration &gt; 0 and duration or frames[#frames].time or 0,
	}
end

local function getVector3CurveValue(curve, time)
	if not curve then
		return Vector3.zero
	end

	local success, value = pcall(function()
		return curve:GetValueAtTime(time)
	end)
	if not success then
		return Vector3.zero
	end

	if typeof(value) == "Vector3" then
		return value
	end
	if typeof(value) == "table" then
		return Vector3.new(tonumber(value[1]) or 0, tonumber(value[2]) or 0, tonumber(value[3]) or 0)
	end

	return Vector3.zero
end

local function getRotationCurveValue(curve, time)
	if not curve then
		return CFrame.new()
	end

	if curve:IsA("RotationCurve") then
		local success, value = pcall(function()
			return curve:GetValueAtTime(time)
		end)
		if success and typeof(value) == "CFrame" then
			return value
		end
	elseif curve:IsA("EulerRotationCurve") then
		local success, value = pcall(function()
			return curve:GetRotationAtTime(time)
		end)
		if success and typeof(value) == "CFrame" then
			return value
		end
	end

	return CFrame.new()
end

local function getFolderCurve(folder, curveName)
	local child = folder:FindFirstChild(curveName)
	if child and (child:IsA("Vector3Curve") or child:IsA("RotationCurve") or child:IsA("EulerRotationCurve")) then
		return child
	end
	return nil
end

local function buildPreviewPoseDataFromCurveAnimation(curveAnimation, rigData)
	if not curveAnimation or not rigData or not curveAnimation:IsA("CurveAnimation") then
		return nil
	end

	local curveFolders = {}
	for _, descendant in ipairs(curveAnimation:GetDescendants()) do
		if descendant:IsA("Folder") then
			local path = rigData.lookup[descendant.Name]
			if path then
				local positionCurve = getFolderCurve(descendant, "Position")
				local rotationCurve = getFolderCurve(descendant, "Rotation")
				if positionCurve or rotationCurve then
					table.insert(curveFolders, {
						path = path,
						positionCurve = positionCurve,
						rotationCurve = rotationCurve,
					})
				end
			end
		end
	end

	if #curveFolders == 0 then
		return nil
	end

	local duration = 0
	pcall(function()
		duration = tonumber(curveAnimation.Length) or 0
	end)

	return {
		kind = "curve",
		curveFolders = curveFolders,
		originalPose = rigData.originalPose,
		duration = duration &gt; 0 and duration or 1,
	}
end

local function samplePreviewPose(previewData, sampleTime)
	if not previewData then
		return nil
	end

	local duration = tonumber(previewData.duration) or 0
	if duration &gt; 0 then
		sampleTime = sampleTime % duration
	end

	if previewData.kind == "curve" then
		local pose = {}
		for _, curveData in ipairs(previewData.curveFolders or {}) do
			local originalC0 = previewData.originalPose and previewData.originalPose[curveData.path]
			if typeof(originalC0) == "CFrame" then
				local position = getVector3CurveValue(curveData.positionCurve, sampleTime)
				local rotation = getRotationCurveValue(curveData.rotationCurve, sampleTime)
				pose[curveData.path] = originalC0 * CFrame.new(position) * rotation
			end
		end
		return next(pose) and pose or nil
	end

	if not previewData.frames or #previewData.frames == 0 then
		return nil
	end

	local frames = previewData.frames
	if sampleTime &lt;= frames[1].time then
		return frames[1].pose
	end

	for index = 1, #frames - 1 do
		local currentFrame = frames[index]
		local nextFrame = frames[index + 1]
		if sampleTime &lt;= nextFrame.time then
			local alphaDenominator = math.max(0.0001, nextFrame.time - currentFrame.time)
			local alpha = math.clamp((sampleTime - currentFrame.time) / alphaDenominator, 0, 1)
			local pose = {}
			local seen = {}

			for path, value in pairs(currentFrame.pose) do
				seen[path] = true
				local nextValue = nextFrame.pose[path]
				if typeof(value) == "CFrame" and typeof(nextValue) == "CFrame" then
					pose[path] = value:Lerp(nextValue, alpha)
				else
					pose[path] = nextValue or value
				end
			end

			for path, value in pairs(nextFrame.pose) do
				if not seen[path] then
					pose[path] = value
				end
			end

			return pose
		end
	end

	return frames[#frames].pose
end

local function applyPreviewPose(rigData, pose)
	if not rigData or not pose then
		return
	end

	for path, motor in pairs(rigData.motors or {}) do
		if motor and motor.Parent then
			local value = pose[path] or rigData.originalPose[path]
			if typeof(value) == "CFrame" then
				motor.C0 = value
			end
		end
	end
end

local function buildPreviewPoseDataFromClipData(clipData, rigData)
	local clip = type(clipData) == "table" and clipData.clip or clipData
	if clip and clip:IsA("KeyframeSequence") then
		return buildPreviewPoseDataFromKeyframeSequence(clip, rigData) or false
	end
	if clip and clip:IsA("CurveAnimation") then
		return buildPreviewPoseDataFromCurveAnimation(clip, rigData) or false
	end
	return false
end

function MotionService.createClipPoseSampler(rig, clipData, basePose)
	if not (rig and rig.Parent) then
		return nil, "The animation rig is no longer available."
	end

	local rigData = describePreviewRigMotors(rig, basePose)
	local previewData = buildPreviewPoseDataFromClipData(clipData, rigData)
	if not previewData then
		return nil, "The selected preset did not contain compatible rig poses."
	end

	return {
		duration = math.max(0, tonumber(previewData.duration) or 0),
		sample = function(sampleTime)
			local sampledPose = samplePreviewPose(previewData, math.max(0, tonumber(sampleTime) or 0)) or {}
			local resolvedPose = {}
			for path in pairs(rigData.motors or {}) do
				local value = sampledPose[path] or rigData.originalPose[path]
				if typeof(value) == "CFrame" then
					resolvedPose[path] = value
				end
			end
			return resolvedPose
		end,
	}, nil
end

local function beamConnectsMarkers(beam, fromMarker, toMarker)
	local attachment0 = beam.Attachment0
	local attachment1 = beam.Attachment1
	return attachment0
		and attachment1
		and fromMarker
		and toMarker
		and attachment0:IsDescendantOf(fromMarker)
		and attachment1:IsDescendantOf(toMarker)
end

local function setPreviewSegmentVisuals(state, fromMarker, toMarker)
	if not state then
		return
	end

	for _, markerState in ipairs(state.markerStates or {}) do
		local marker = markerState.marker
		if marker and marker.Parent then
			if marker == fromMarker then
				marker.Color = Color3.fromRGB(92, 202, 255)
				marker.Transparency = 0.15
				marker.Material = Enum.Material.Neon
			elseif marker == toMarker then
				marker.Color = Color3.fromRGB(255, 198, 75)
				marker.Transparency = 0.15
				marker.Material = Enum.Material.Neon
			else
				marker.Color = markerState.color
				marker.Transparency = math.max(markerState.transparency, 0.55)
				marker.Material = markerState.material
			end
		end
	end

	for _, beamState in ipairs(state.beamStates or {}) do
		local beam = beamState.beam
		if beam and beam.Parent then
			beam.Enabled = true
			if beamConnectsMarkers(beam, fromMarker, toMarker) then
				beam.Color = ColorSequence.new(Color3.fromRGB(92, 202, 255), Color3.fromRGB(255, 198, 75))
				beam.Transparency = NumberSequence.new(0.03)
				beam.Width0 = math.max(beamState.width0, 0.28)
				beam.Width1 = math.max(beamState.width1, 0.28)
			else
				beam.Color = beamState.color
				beam.Transparency = NumberSequence.new(0.65)
				beam.Width0 = beamState.width0
				beam.Width1 = beamState.width1
			end
		end
	end
end

local function animatePreviewCFrame(state, fromCFrame, toCFrame, durationSeconds, rigData, previewData, sampleOffset)
	if state.cancelled or not state.rig or not state.rig.Parent then
		return false
	end

	sampleOffset = tonumber(sampleOffset) or 0
	durationSeconds = math.max(0, tonumber(durationSeconds) or 0)
	if durationSeconds &lt;= 0 then
		state.rig:PivotTo(toCFrame)
		applyPreviewPose(rigData, samplePreviewPose(previewData, sampleOffset))
		return true
	end

	local elapsed = 0
	while elapsed &lt; durationSeconds do
		if state.cancelled or not state.rig or not state.rig.Parent then
			return false
		end
		elapsed += RunService.Heartbeat:Wait()
		if state.cancelled or not state.rig or not state.rig.Parent then
			return false
		end
		local alpha = math.clamp(elapsed / durationSeconds, 0, 1)
		state.rig:PivotTo(fromCFrame:Lerp(toCFrame, alpha))
		applyPreviewPose(rigData, samplePreviewPose(previewData, sampleOffset + elapsed))
	end
	if state.cancelled or not state.rig or not state.rig.Parent then
		return false
	end
	state.rig:PivotTo(toCFrame)
	applyPreviewPose(rigData, samplePreviewPose(previewData, sampleOffset + durationSeconds))
	return true
end

local function waitPreviewSeconds(state, durationSeconds)
	durationSeconds = math.max(0, tonumber(durationSeconds) or 0)
	local elapsed = 0
	while elapsed &lt; durationSeconds do
		if state.cancelled or not state.rig or not state.rig.Parent then
			return false
		end
		elapsed += RunService.Heartbeat:Wait()
		if state.cancelled or not state.rig or not state.rig.Parent then
			return false
		end
	end
	return true
end

local function animatePreviewHold(state, holdCFrame, durationSeconds, rigData, previewData, sampleOffset)
	if not previewData then
		return waitPreviewSeconds(state, durationSeconds)
	end

	sampleOffset = tonumber(sampleOffset) or 0
	durationSeconds = math.max(0, tonumber(durationSeconds) or 0)
	local elapsed = 0
	while elapsed &lt; durationSeconds do
		if state.cancelled or not state.rig or not state.rig.Parent then
			return false
		end
		elapsed += RunService.Heartbeat:Wait()
		if state.cancelled or not state.rig or not state.rig.Parent then
			return false
		end
		state.rig:PivotTo(holdCFrame)
		applyPreviewPose(rigData, samplePreviewPose(previewData, sampleOffset + elapsed))
	end
	return true
end

local function getFacingRotation(position, nextPosition, fallbackRotation)
	local direction = nextPosition and Vector3.new(nextPosition.X - position.X, 0, nextPosition.Z - position.Z) or Vector3.zero
	if direction.Magnitude &gt; 0.001 then
		return getRotationOnly(CFrame.lookAt(Vector3.zero, direction.Unit))
	end
	return fallbackRotation
end

local function shouldUseMarkerOrientationForMotion(motionName)
	motionName = tostring(motionName or "")
	return motionName == "Idle" or motionName == "Action"
end

function MotionService.setMotionMarkersVisible(visible)
	visible = visible ~= false
	for _, marker in ipairs(syncWorkspaceMotionMarkerBeams(false)) do
		if marker:IsA("BasePart") then
			if visible then
				local originalTransparency = marker:GetAttribute(MARKER_PREVIOUS_TRANSPARENCY_ATTR)
				if typeof(originalTransparency) == "number" then
					marker.Transparency = originalTransparency
				end
				marker:SetAttribute(MARKER_PREVIOUS_TRANSPARENCY_ATTR, nil)
				marker:SetAttribute(MARKER_HIDDEN_FOR_PREVIEW_ATTR, nil)
			else
				if marker:GetAttribute(MARKER_HIDDEN_FOR_PREVIEW_ATTR) ~= true then
					marker:SetAttribute(MARKER_PREVIOUS_TRANSPARENCY_ATTR, marker.Transparency)
				end
				marker.Transparency = 1
				marker:SetAttribute(MARKER_HIDDEN_FOR_PREVIEW_ATTR, true)
			end
		end

		for _, descendant in ipairs(marker:GetDescendants()) do
			if descendant:IsA("Beam")
				and descendant:GetAttribute(MOTION_BEAM_ATTR) == true then
				descendant.Enabled = visible
			end
		end
	end
end

function MotionService.generateMotionPathFromWorkspaceMarkers(deps, options)
	local selectionService = deps.selectionService
	local originalSelection = selectionService.getSelection and selectionService.getSelection() or {}
	local markerInstances = syncWorkspaceMotionMarkerBeams(false)
	if #markerInstances &lt; 2 then
		local message = "Add at least two motion markers before creating an animation."
		deps.refreshUi(message)
		return false, message
	end

	selectionService.setSelection(markerInstances)
	local handled, message = MotionService.generateMotionPathFromSelection(deps, options)
	selectionService.setSelection(originalSelection)
	return handled, message
end

function MotionService.previewMotionPathFromWorkspaceMarkers(deps, options)
	options = options or {}
	local timeline = deps.timeline
	local refreshUi = deps.refreshUi
	local rig = timeline:getRig()
	if not rig or not rig.Parent then
		local message = "Add or bind the rig you want to preview."
		refreshUi(message)
		return false, message
	end

	local markers = syncWorkspaceMotionMarkerBeams(false)
	local segments = MotionService.listMotionSegments(options)
	if #segments == 0 or #markers &lt; 2 then
		local message = "Add at least two motion markers before previewing."
		refreshUi(message)
		return false, message
	end

	local startSegmentIndex = 1
	local endSegmentIndex = #segments
	local segmentKey = tostring(options.segmentKey or "")
	if segmentKey ~= "" then
		local foundSegment = nil
		for index, segment in ipairs(segments) do
			if tostring(segment.segmentKey) == segmentKey then
				foundSegment = index
				break
			end
		end
		if not foundSegment then
			local message = "That marker segment is no longer available."
			refreshUi(message)
			return false, message
		end
		startSegmentIndex = foundSegment
		endSegmentIndex = foundSegment
	end

	if deps.stopPlayback then
		deps.stopPlayback()
	end
	stopActivePreview(true)

	local groundOffset = getRigGroundOffset(rig)
	local positions = {}
	for _, marker in ipairs(markers) do
		local anchor = getMarkerAnchorPosition(marker)
		if not anchor then
			local message = "Motion markers must be parts, models, or attachments."
			refreshUi(message)
			return false, message
		end
		table.insert(positions, anchor + Vector3.new(0, groundOffset, 0))
	end

	local state = createPreviewState(rig, markers, deps.gizmoController, timeline)
	local startPosition = positions[startSegmentIndex]
	local nextPosition = positions[startSegmentIndex + 1]
	local startMotionName = tostring((segments[startSegmentIndex] and segments[startSegmentIndex].motionName) or "Path Only")
	local explicitStartRotation = getExplicitMarkerRotation(markers[startSegmentIndex])
	local startRotation = (explicitStartRotation and shouldUseMarkerOrientationForMotion(startMotionName))
		and explicitStartRotation
		or getFacingRotation(startPosition, nextPosition, getRotationOnly(rig:GetPivot()))
	state.returnPivot = CFrame.new(startPosition) * startRotation
	activePreviewState = state
	if deps.gizmoController then
		deps.gizmoController:setSuppressed(true)
	end
	local poseBase = next(state.defaultMotorPose) and state.defaultMotorPose or state.originalMotorPose
	local rigData = describePreviewRigMotors(rig, poseBase)
	local previewClipsByMotion = options.previewClipsByMotion or {}
	local previewClipsBySegment = options.previewClipsBySegment or {}
	local previewIdleClipsBySegment = options.previewIdleClipsBySegment or {}
	local previewPoseDataByMotion = {}
	local previewPoseDataBySegment = {}
	local previewIdlePoseDataBySegment = {}
	local unsupportedMotionNames = {}
	for _, segment in ipairs(segments) do
		local motionName = tostring(segment.motionName or "Path Only")
		local segmentKeyForClip = tostring(segment.segmentKey or "")
		local segmentClipData = previewClipsBySegment[segmentKeyForClip]
		if segmentClipData then
			previewPoseDataBySegment[segmentKeyForClip] = buildPreviewPoseDataFromClipData(segmentClipData, rigData)
			if previewPoseDataBySegment[segmentKeyForClip] == false then
				unsupportedMotionNames[tostring(segment.fromName or "Segment") .. " motion"] = true
			end
		elseif motionName ~= "Path Only" and previewPoseDataByMotion[motionName] == nil then
			local clipData = previewClipsByMotion[motionName]
			previewPoseDataByMotion[motionName] = buildPreviewPoseDataFromClipData(clipData, rigData)
			if previewPoseDataByMotion[motionName] == false then
				unsupportedMotionNames[motionName] = true
			end
		end
		local idleClipData = previewIdleClipsBySegment[segmentKeyForClip]
		if idleClipData then
			previewIdlePoseDataBySegment[segmentKeyForClip] = buildPreviewPoseDataFromClipData(idleClipData, rigData)
			if previewIdlePoseDataBySegment[segmentKeyForClip] == false then
				unsupportedMotionNames[tostring(segment.fromName or "Segment") .. " idle"] = true
			end
		end
	end

	local previewDuration = 0
	for index = startSegmentIndex, endSegmentIndex do
		local segment = segments[index]
		previewDuration += tonumber(segment.durationSeconds) or 0
		previewDuration += tonumber(segment.pauseAfterSeconds) or 0
		if index &lt; endSegmentIndex then
			previewDuration += tonumber(segment.blendSeconds) or 0
		end
	end
	local previewLabel = segmentKey ~= "" and string.format("%s to %s", segments[startSegmentIndex].fromName, segments[startSegmentIndex].toName) or "full marker path"
	state.previewKey = segmentKey ~= "" and segmentKey or "__full"
	state.previewLabel = previewLabel
	refreshUi(string.format("Previewing %s. Timeline keyframes are unchanged.", previewLabel))

	task.spawn(function()
		local ok = true
		local currentRotation = getRotationOnly(rig:GetPivot())
		local currentCFrame = nil
		local clipSampleOffset = 0

		for segmentIndex = startSegmentIndex, endSegmentIndex do
			if state.cancelled then
				return
			end

			local fromMarker = markers[segmentIndex]
			local toMarker = markers[segmentIndex + 1]
			local fromPosition = positions[segmentIndex]
			local toPosition = positions[segmentIndex + 1]
			local segment = segments[segmentIndex]
			local motionName = tostring(segment.motionName or "Path Only")
			local currentSegmentKey = tostring(segment.segmentKey or "")
			local previewData = previewPoseDataBySegment[currentSegmentKey] or previewPoseDataByMotion[motionName]
			if previewData == false then
				previewData = nil
			end
			local pauseSeconds = tonumber(segment.pauseAfterSeconds) or 0
			local segmentRotation = getFacingRotation(fromPosition, toPosition, currentRotation)
			local fromMarkerRotation = getExplicitMarkerRotation(fromMarker)
			local toMarkerRotation = getExplicitMarkerRotation(toMarker)
			local useFromMarkerRotation = fromMarkerRotation and shouldUseMarkerOrientationForMotion(motionName)
			local useToMarkerRotation = toMarkerRotation and shouldUseMarkerOrientationForMotion(motionName)
			local fromCFrame = CFrame.new(fromPosition) * (useFromMarkerRotation and fromMarkerRotation or segmentRotation)
			local toCFrame = CFrame.new(toPosition) * (useToMarkerRotation and toMarkerRotation or segmentRotation)
			local segmentEndRotation = (useToMarkerRotation and toMarkerRotation) or segmentRotation

			setPreviewSegmentVisuals(state, fromMarker, toMarker)
			if not currentCFrame then
				rig:PivotTo(fromCFrame)
				currentCFrame = fromCFrame
			end

			ok = animatePreviewCFrame(state, currentCFrame, toCFrame, tonumber(segment.durationSeconds) or 0, rigData, previewData, clipSampleOffset)
			if not ok then
				return
			end
			clipSampleOffset += tonumber(segment.durationSeconds) or 0
			currentCFrame = toCFrame
			currentRotation = segmentEndRotation

			if pauseSeconds &gt; 0 then
				local idlePreviewData = previewIdlePoseDataBySegment[currentSegmentKey]
				if idlePreviewData == false then
					idlePreviewData = nil
				end
				ok = animatePreviewHold(state, currentCFrame, pauseSeconds, rigData, idlePreviewData, clipSampleOffset)
				if not ok then
					return
				end
				clipSampleOffset += pauseSeconds
			end

			if segmentIndex &lt; endSegmentIndex then
				local nextPosition = positions[segmentIndex + 2]
				local nextMotionName = tostring((segments[segmentIndex + 1] and segments[segmentIndex + 1].motionName) or "Path Only")
				local nextMarkerRotation = getExplicitMarkerRotation(toMarker)
				local nextRotation = (nextMarkerRotation and shouldUseMarkerOrientationForMotion(nextMotionName))
					and nextMarkerRotation
					or getFacingRotation(toPosition, nextPosition, currentRotation)
				local turnCFrame = CFrame.new(toPosition) * nextRotation
				local turnSeconds = math.max(0, tonumber(segment.blendSeconds) or 0)
				if turnSeconds &gt; 0 then
					ok = animatePreviewCFrame(state, currentCFrame, turnCFrame, turnSeconds, rigData, nil, clipSampleOffset)
					if not ok then
						return
					end
				else
					rig:PivotTo(turnCFrame)
				end
				currentCFrame = turnCFrame
				currentRotation = nextRotation
			end
		end

		if activePreviewState == state then
			state.cancelled = true
			restorePreviewRigState(state, true)
			activePreviewState = nil
			local unsupportedList = {}
			for motionName in pairs(unsupportedMotionNames) do
				table.insert(unsupportedList, motionName)
			end
			table.sort(unsupportedList)
			local unsupportedSummary = #unsupportedList &gt; 0 and (" Body preview was unavailable for: " .. table.concat(unsupportedList, ", ") .. ".") or ""
			refreshUi(string.format("Preview complete for %s over %.2fs. Timeline keyframes were unchanged.%s", previewLabel, previewDuration, unsupportedSummary))
		end
	end)

	return true, string.format("Previewing %s.", previewLabel)
end

function MotionService.parseMotionCommand(input, deps)
	local text = tostring(input or "")
	if string.match(text:lower(), "^%s*markers%s*:%s*create%s*$") or string.match(text:lower(), "^%s*createmarkers%s*$") then
		return {
			createMarkers = true,
		}
	end
	local prefix, payload = text:match("^%s*(motion)%s*:%s*(.-)%s*$")
	if not prefix then
		return nil
	end

	local spec = {
		facePath = true,
	}
	for segment in string.gmatch(payload .. ";", "(.-);") do
		local trimmed = tostring(segment):gsub("^%s+", ""):gsub("%s+$", "")
		if trimmed ~= "" then
			local key, value = trimmed:match("^([^=]+)=(.+)$")
			if key and value then
				key = tostring(key):lower():gsub("%s+", "")
				value = tostring(value):gsub("^%s+", ""):gsub("%s+$", "")
				if key == "rig" then
					spec.rigName = value
				elseif key == "start" then
					spec.startMarkerPath = value
				elseif key == "end" then
					spec.endMarkerPath = value
				elseif key == "duration" or key == "time" or key == "seconds" then
					spec.durationSeconds = tonumber(value)
				elseif key == "face" or key == "facepath" then
					local normalized = value:lower()
					spec.facePath = not (normalized == "false" or normalized == "off" or normalized == "0" or normalized == "no")
				end
			elseif tonumber(trimmed) then
				spec.durationSeconds = tonumber(trimmed)
			end
		end
	end

	local timeline = deps.timeline
	if not spec.rigName or spec.rigName == "" then
		local boundRig = timeline:getRig()
		if boundRig and boundRig.Parent then
			spec.rigName = boundRig.Name
		end
	end

	if (not spec.startMarkerPath or spec.startMarkerPath == "") or (not spec.endMarkerPath or spec.endMarkerPath == "") then
		local selected = game:GetService("Selection"):Get()
		local workspaceSelections = {}
		for _, instance in ipairs(selected) do
			local path = getWorkspaceRelativePath(instance)
			if path then
				table.insert(workspaceSelections, path)
			end
		end
		if not spec.startMarkerPath or spec.startMarkerPath == "" then
			spec.startMarkerPath = workspaceSelections[1]
		end
		if not spec.endMarkerPath or spec.endMarkerPath == "" then
			spec.endMarkerPath = workspaceSelections[2]
		end
	end

	return spec
end

function MotionService.generateMotionPath(spec, deps)
	spec = spec or {}
	if spec.createMarkers then
		return MotionService.createMotionMarkers(deps)
	end

	local timeline = deps.timeline
	local pushUndo = deps.pushUndo
	local popUndo = deps.popUndo
	local setSingleSelectedTrack = deps.setSingleSelectedTrack
	local refreshUi = deps.refreshUi

	local rigName = tostring(spec.rigName or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if rigName == "" then
		return false, "Motion command needs a rig. Add a rig to the timeline or use rig=RigName."
	end

	local rig = timeline:getRigByName(rigName)
	if not rig or not rig.Parent then
		return false, string.format("Rig '%s' is not available in the timeline.", rigName)
	end

	local startMarker, startError = resolveWorkspacePath(spec.startMarkerPath)
	if not startMarker then
		return false, startError
	end
	local endMarker, endError = resolveWorkspacePath(spec.endMarkerPath)
	if not endMarker then
		return false, endError
	end

	local startAnchor = getMarkerAnchorPosition(startMarker)
	local endAnchor = getMarkerAnchorPosition(endMarker)
	if not startAnchor or not endAnchor then
		return false, "Markers must be parts, models, attachments, or descendants of them."
	end

	local durationSeconds = tonumber(spec.durationSeconds)
	if not durationSeconds or durationSeconds &lt;= 0 then
		return false, "Motion command needs duration=5 or another value greater than 0."
	end

	local groundOffset = getRigGroundOffset(rig)
	local startPosition = startAnchor + Vector3.new(0, groundOffset, 0)
	local endPosition = endAnchor + Vector3.new(0, groundOffset, 0)
	local startCFrame
	local endCFrame
	local facePath = spec.facePath ~= false
	if facePath then
		local direction = Vector3.new(endPosition.X - startPosition.X, 0, endPosition.Z - startPosition.Z)
		if direction.Magnitude &gt; 0.001 then
			local lookVector = direction.Unit
			startCFrame = CFrame.lookAt(startPosition, startPosition + lookVector)
			endCFrame = CFrame.lookAt(endPosition, endPosition + lookVector)
		else
			local rotation = getRotationOnly(rig:GetPivot())
			startCFrame = CFrame.new(startPosition) * rotation
			endCFrame = CFrame.new(endPosition) * rotation
		end
	else
		local rotation = getRotationOnly(rig:GetPivot())
		startCFrame = CFrame.new(startPosition) * rotation
		endCFrame = CFrame.new(endPosition) * rotation
	end

	pushUndo("Generate Motion Path")
	local track, createdTrack = ensureRigMotionTrack(timeline, rig)
	local referencePivot = rig:GetPivot()
	local referenceRootPart = getRigRootPart(rig)
	local referenceRootCFrame = referenceRootPart and referenceRootPart.CFrame or nil
	local startFrame = timeline:getCurrentFrame()
	local durationFrames = math.max(1, math.floor(durationSeconds * timeline:getFps() + 0.5))
	local endFrame = startFrame + durationFrames
	if endFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(endFrame)
	end

	local success, message = timeline:setTrackValueAtFrame(
		track.path,
		startFrame,
		getRigRootTargetForPivot(rig, startCFrame, referencePivot, referenceRootCFrame),
		"Linear",
		"InOut"
	)
	if not success then
		popUndo()
		return false, message
	end
	success, message = timeline:setTrackValueAtFrame(
		track.path,
		endFrame,
		getRigRootTargetForPivot(rig, endCFrame, referencePivot, referenceRootCFrame),
		"Linear",
		"InOut"
	)
	if not success then
		popUndo()
		return false, message
	end

	setSingleSelectedTrack(track.path)
	timeline:setCurrentFrame(startFrame)
	timeline:applyCurrentFrame()
	local action = createdTrack and "Created a rig CFrame track and generated" or "Generated"
	local status = string.format(
		"%s motion path for '%s' from %s to %s over %.2fs.",
		action,
		rig.Name,
		startMarker.Name,
		endMarker.Name,
		durationSeconds
	)
	refreshUi(status)
	return true, status
end

function MotionService.generateMotionPathFromSelection(deps, options)
	options = options or {}
	local timeline = deps.timeline
	local selectionService = deps.selectionService
	local pushUndo = deps.pushUndo
	local popUndo = deps.popUndo
	local setSingleSelectedTrack = deps.setSingleSelectedTrack
	local refreshUi = deps.refreshUi

	local rig = timeline:getRig()
	if not rig or not rig.Parent then
		return false, "Add or bind the rig you want to move, then select two workspace markers and click Import Selected."
	end

	local selected = selectionService.getSelection and selectionService.getSelection() or {}
	local markerPaths = {}
	local seenMarkerPaths = {}
	for _, instance in ipairs(selected) do
		if instance ~= rig and not instance:IsDescendantOf(rig) then
			local markerInstance = getSpatialMarkerInstance(instance)
			local path = getWorkspaceRelativePath(markerInstance)
			if path and not seenMarkerPaths[path] then
				seenMarkerPaths[path] = true
				table.insert(markerPaths, path)
			end
		end
	end

	if #markerPaths &lt; 2 then
		return false, "Select two workspace markers, parts, models, or attachments, then click Import Selected."
	end

	local markers = {}
	for _, markerPath in ipairs(markerPaths) do
		local instance, resolveError = resolveWorkspacePath(markerPath)
		if not instance then
			return false, resolveError
		end

		local anchor = getMarkerAnchorPosition(instance)
		if not anchor then
			return false, "Selected markers must be parts, models, attachments, or descendants of them."
		end

		table.insert(markers, {
			path = markerPath,
			instance = instance,
			anchor = anchor,
		})
	end

	local groundOffset = getRigGroundOffset(rig)
	local positions = {}
	for _, marker in ipairs(markers) do
		table.insert(positions, marker.anchor + Vector3.new(0, groundOffset, 0))
	end

	local segmentDurations = {}
	local segmentMotions = options.segmentMotions or {}
	local segmentDurationOverrides = options.segmentDurations or options.segmentDurationOverrides or {}
	local segmentPauseOverrides = options.segmentPauses or options.segmentPauseOverrides or {}
	local segmentBlendOverrides = options.segmentBlends or options.segmentBlendOverrides or {}
	local segmentClipOverrides = options.segmentClips or {}
	local segmentPauseIdleOverrides = options.segmentPauseIdles or {}
	local segmentMotionNames = {}
	local segmentKeys = {}
	local segmentPauses = {}
	local segmentBlends = {}
	local segmentClipIds = {}
	local segmentPauseIdleClipIds = {}
	local totalDistance = 0
	local totalDurationSeconds = 0
	local speedStudsPerSecond = tonumber(options.speedStudsPerSecond)
	for index = 1, #positions - 1 do
		local segmentKey = getMotionSegmentKey(markers[index].path, markers[index + 1].path, index)
		local fromPosition = positions[index]
		local toPosition = positions[index + 1]
		local motionName = getMotionNameForSegment(segmentMotions, segmentKey, index, markers[index].instance, fromPosition, toPosition)
		local distance = (toPosition - fromPosition).Magnitude
		totalDistance += distance
		local durationSeconds = estimateDurationSeconds(distance, getSegmentSpeed(motionName, speedStudsPerSecond))
		local durationOverrideSeconds = getSegmentNumberOverride(segmentDurationOverrides, segmentKey, index, false)
			or getMarkerNumberAttribute(markers[index].instance, SEGMENT_DURATION_ATTR, false)
		if durationOverrideSeconds then
			durationSeconds = durationOverrideSeconds
		end
		local pauseOverrideSeconds = getSegmentNumberOverride(segmentPauseOverrides, segmentKey, index, true)
			or getMarkerNumberAttribute(markers[index].instance, SEGMENT_PAUSE_ATTR, true)
		local pauseAfterSeconds = pauseOverrideSeconds
		if pauseAfterSeconds == nil then
			pauseAfterSeconds = getMarkerPauseSeconds(markers[index + 1].instance)
		end
		local blendOverrideSeconds = getSegmentNumberOverride(segmentBlendOverrides, segmentKey, index, true)
			or getMarkerNumberAttribute(markers[index].instance, SEGMENT_BLEND_ATTR, true)
		local blendSeconds = 0
		if index &lt; (#positions - 1) then
			blendSeconds = math.max(0, blendOverrideSeconds ~= nil and blendOverrideSeconds or (tonumber(options.turnSeconds) or DEFAULT_CORNER_TURN_SECONDS))
		end
		local clipId = getSegmentStringOverride(segmentClipOverrides, segmentKey, index)
			or tostring(markers[index].instance:GetAttribute(SEGMENT_CLIP_ATTR) or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if clipId == "" then
			clipId = nil
		end
		local pauseIdleClipId = getSegmentStringOverride(segmentPauseIdleOverrides, segmentKey, index)
			or tostring(markers[index].instance:GetAttribute(SEGMENT_PAUSE_IDLE_ATTR) or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if pauseIdleClipId == "" then
			pauseIdleClipId = nil
		end
		totalDurationSeconds += durationSeconds
		table.insert(segmentDurations, durationSeconds)
		table.insert(segmentMotionNames, motionName)
		table.insert(segmentKeys, segmentKey)
		table.insert(segmentPauses, pauseAfterSeconds)
		table.insert(segmentBlends, blendSeconds)
		table.insert(segmentClipIds, clipId)
		table.insert(segmentPauseIdleClipIds, pauseIdleClipId)
	end

	pushUndo(#positions &gt; 2 and "Generate Motion Path Chain" or "Generate Motion Path")
	local track, createdTrack = ensureRigMotionTrack(timeline, rig)
	local referencePivot = rig:GetPivot()
	local referenceRootPart = getRigRootPart(rig)
	local referenceRootCFrame = referenceRootPart and referenceRootPart.CFrame or nil
	clearTrackKeyframes(timeline, track.path)
	local startFrame = timeline:getCurrentFrame()
	local currentFrame = startFrame
	local currentRotation = getRotationOnly(rig:GetPivot())
	local holdRanges = {}
	local movementRanges = {}
	local turnRanges = {}
	local motionPathKeyframes = {}
	local function setMotionPathKeyframe(frame, pivotCFrame)
		local rootCFrame = getRigRootTargetForPivot(rig, pivotCFrame, referencePivot, referenceRootCFrame)
		local success, message = timeline:setTrackValueAtFrame(track.path, frame, rootCFrame, "Linear", "InOut")
		if success then
			table.insert(motionPathKeyframes, {
				frame = frame,
				value = rootCFrame,
			})
		end
		return success, message
	end
	local function getFacingRotation(position, nextPosition, fallbackRotation)
		local direction = nextPosition and Vector3.new(nextPosition.X - position.X, 0, nextPosition.Z - position.Z) or Vector3.zero
		if direction.Magnitude &gt; 0.001 then
			local lookVector = direction.Unit
			return getRotationOnly(CFrame.lookAt(Vector3.zero, lookVector))
		end
		return fallbackRotation
	end

	local function shouldUseMarkerFacing(motionName)
		motionName = tostring(motionName or "")
		return motionName == "Idle" or motionName == "Action"
	end

	local function shouldAddCornerTurn(previousPosition, position, nextPosition)
		if not previousPosition or not nextPosition then
			return false
		end
		local incoming = Vector3.new(position.X - previousPosition.X, 0, position.Z - previousPosition.Z)
		local outgoing = Vector3.new(nextPosition.X - position.X, 0, nextPosition.Z - position.Z)
		if incoming.Magnitude &lt;= 0.001 or outgoing.Magnitude &lt;= 0.001 then
			return false
		end
		return incoming.Unit:Dot(outgoing.Unit) &lt; 0.999
	end

	local function rotationsDiffer(rotationA, rotationB)
		if typeof(rotationA) ~= "CFrame" or typeof(rotationB) ~= "CFrame" then
			return false
		end
		local lookA = Vector3.new(rotationA.LookVector.X, 0, rotationA.LookVector.Z)
		local lookB = Vector3.new(rotationB.LookVector.X, 0, rotationB.LookVector.Z)
		if lookA.Magnitude &lt;= 0.001 or lookB.Magnitude &lt;= 0.001 then
			return false
		end
		return lookA.Unit:Dot(lookB.Unit) &lt; 0.999
	end

	local success, message
	for index, position in ipairs(positions) do
		local marker = markers[index]
		local nextPosition = positions[index + 1]
		local hasPreviousPosition = positions[index - 1] ~= nil
		local holdSeconds = index &gt; 1 and segmentPauses[index - 1] or getMarkerPauseSeconds(marker.instance)
		local markerRotation = getExplicitMarkerRotation(marker and marker.instance)
		local markerMotionName = tostring(segmentMotionNames[index] or "")
		local incomingMotionName = tostring(segmentMotionNames[index - 1] or "")
		local useMarkerRotation = markerRotation
			and (
				shouldUseMarkerFacing(markerMotionName)
				or ((holdSeconds &gt; 0 or not nextPosition) and shouldUseMarkerFacing(incomingMotionName))
			)
		local departureRotation = nextPosition and getFacingRotation(position, nextPosition, currentRotation) or currentRotation
		local arrivalRotation = useMarkerRotation and markerRotation or ((hasPreviousPosition or not nextPosition) and currentRotation or departureRotation)
		local holdFrames = 0
		local arrivalCFrame = CFrame.new(position) * arrivalRotation

		success, message = setMotionPathKeyframe(currentFrame, arrivalCFrame)
		if not success then
			popUndo()
			return false, message
		end

		if holdSeconds &gt; 0 then
			local holdSegmentKey = index &gt; 1 and segmentKeys[index - 1] or nil
			holdFrames = math.max(1, math.floor(holdSeconds * timeline:getFps() + 0.5))
			local holdEndFrame = currentFrame + holdFrames
			success, message = setMotionPathKeyframe(holdEndFrame, arrivalCFrame)
			if not success then
				popUndo()
				return false, message
			end
			table.insert(holdRanges, {
				markerIndex = index,
				markerName = marker.instance.Name,
				startFrame = currentFrame,
				endFrame = holdEndFrame,
				durationSeconds = holdSeconds,
				segmentKey = holdSegmentKey,
				pauseIdleClipId = index &gt; 1 and segmentPauseIdleClipIds[index - 1] or nil,
			})
			currentFrame = holdEndFrame
		end

		local turnSeconds = index &gt; 1 and (segmentBlends[index - 1] or 0) or 0
		local shouldTurnBeforeDeparture = hasPreviousPosition
			and nextPosition ~= nil
			and (
				shouldAddCornerTurn(positions[index - 1], position, nextPosition)
				or rotationsDiffer(currentRotation, departureRotation)
			)
		if shouldTurnBeforeDeparture then
			local turnFrames = 1
			if turnSeconds &gt; 0 then
				turnFrames = math.max(1, math.floor(turnSeconds * timeline:getFps() + 0.5))
			end
			local turnEndFrame = currentFrame + turnFrames
			local departureCFrame = CFrame.new(position) * departureRotation
			success, message = setMotionPathKeyframe(turnEndFrame, departureCFrame)
			if not success then
				popUndo()
				return false, message
			end
			table.insert(turnRanges, {
				markerIndex = index,
				markerName = marker.instance.Name,
				startFrame = currentFrame,
				endFrame = turnEndFrame,
				durationSeconds = turnFrames / timeline:getFps(),
				segmentKey = index &gt; 1 and segmentKeys[index - 1] or nil,
			})
			currentFrame = turnEndFrame
		end
		currentRotation = departureRotation

		if nextPosition then
			local durationFrames = math.max(1, math.floor(segmentDurations[index] * timeline:getFps() + 0.5))
			local departureFrame = currentFrame
			currentFrame += durationFrames
			table.insert(movementRanges, {
				segmentIndex = index,
				fromMarkerName = marker.instance.Name,
				toMarkerName = markers[index + 1].instance.Name,
				startFrame = departureFrame,
				endFrame = currentFrame,
				durationSeconds = segmentDurations[index],
				motionName = segmentMotionNames[index],
				segmentKey = segmentKeys[index],
				blendSeconds = segmentBlends[index] or 0,
				clipId = segmentClipIds[index],
			})
		end
	end

	if currentFrame &gt; timeline:getDurationFrames() then
		timeline:setDurationFrames(currentFrame)
	end
	local generatedDurationSeconds = math.max(0, (currentFrame - startFrame) / timeline:getFps())

	setSingleSelectedTrack(track.path)
	timeline:setCurrentFrame(startFrame)
	timeline:applyCurrentFrame()

	local action = createdTrack and "Created a rig CFrame track and generated" or "Generated"
	local status = string.format(
		"%s motion path for '%s' through %d markers over %.2fs. Auto distance: %.1f studs.",
		action,
		rig.Name,
		#markers,
		generatedDurationSeconds,
		totalDistance
	)
	if speedStudsPerSecond and speedStudsPerSecond &gt; 0 then
		status = string.format("%s Speed matched at %.1f studs/s.", status, speedStudsPerSecond)
	end
	if options.afterGenerate then
		local callbackSuccess, callbackMessage = options.afterGenerate({
			rig = rig,
			track = track,
			startFrame = startFrame,
			endFrame = currentFrame,
			totalDurationSeconds = generatedDurationSeconds,
			movementDurationSeconds = totalDurationSeconds,
			totalDistance = totalDistance,
			markerCount = #markers,
			markers = markers,
			positions = positions,
			holdRanges = holdRanges,
			movementRanges = movementRanges,
			turnRanges = turnRanges,
		})
		if callbackSuccess == false and callbackMessage then
			status = string.format("%s %s", status, callbackMessage)
		elseif type(callbackMessage) == "string" and callbackMessage ~= "" then
			status = string.format("%s %s", status, callbackMessage)
		end
	end
	clearTrackKeyframes(timeline, track.path)
	for _, keyframe in ipairs(motionPathKeyframes) do
		local success, message = timeline:setTrackValueAtFrame(track.path, keyframe.frame, keyframe.value, "Linear", "InOut")
		if not success then
			popUndo()
			return false, message
		end
	end
	refreshUi(status)
	return true, status
end

return MotionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX176">
        <Properties>
          <string name="Name">MotionServiceDependencySupport</string>
          <ProtectedString name="Source">local MotionServiceDependencySupport = {}

function MotionServiceDependencySupport.buildDeps(args)
	return {
		timeline = args.timeline,
		selectionService = args.selectionService,
		getRigInsertCFrame = args.getRigInsertCFrame,
		pushUndo = args.pushUndo,
		popUndo = args.popUndo,
		setSingleSelectedTrack = args.setSingleSelectedTrack,
		refreshUi = args.refreshUi,
		gizmoController = args.gizmoController,
		stopPlayback = args.stopPlayback,
		ensureMotionBuilderRig = args.ensureMotionBuilderRig,
	}
end

return MotionServiceDependencySupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX177">
        <Properties>
          <string name="Name">MotionSmoothingService</string>
          <ProtectedString name="Source">local MotionSmoothingService = {}

local MODES = {
	Light = {
		strength = 0.35,
		preserveExtremes = false,
		targetSpacing = 3,
	},
	Strong = {
		strength = 0.65,
		preserveExtremes = false,
		targetSpacing = 2,
	},
	PreserveExtremes = {
		strength = 0.35,
		preserveExtremes = true,
		targetSpacing = 4,
	},
}

local MAX_INSERTS_PER_GAP = 24
local MAX_TOTAL_INSERTS = 1200

local function cloneValue(value)
	if typeof(value) == "table" then
		local clone = {}
		for key, child in pairs(value) do
			clone[key] = cloneValue(child)
		end
		return clone
	end
	return value
end

local function vectorIsExtreme(previous, current, nextValue)
	local intoCurrent = current - previous
	local outOfCurrent = nextValue - current
	if intoCurrent.Magnitude &lt; 0.001 or outOfCurrent.Magnitude &lt; 0.001 then
		return false
	end
	return intoCurrent.Unit:Dot(outOfCurrent.Unit) &lt; -0.15
end

local function numberIsExtreme(previous, current, nextValue)
	return (current &gt;= previous and current &gt;= nextValue) or (current &lt;= previous and current &lt;= nextValue)
end

local function smoothValue(previous, current, nextValue, mode)
	local config = MODES[mode] or MODES.Light
	local strength = config.strength

	if typeof(previous) == "CFrame" and typeof(current) == "CFrame" and typeof(nextValue) == "CFrame" then
		if config.preserveExtremes and vectorIsExtreme(previous.Position, current.Position, nextValue.Position) then
			return nil
		end
		local neighborMidpoint = previous:Lerp(nextValue, 0.5)
		return current:Lerp(neighborMidpoint, strength)
	end

	if typeof(previous) == "Vector3" and typeof(current) == "Vector3" and typeof(nextValue) == "Vector3" then
		if config.preserveExtremes and vectorIsExtreme(previous, current, nextValue) then
			return nil
		end
		return current:Lerp((previous + nextValue) / 2, strength)
	end

	if type(previous) == "number" and type(current) == "number" and type(nextValue) == "number" then
		if config.preserveExtremes and numberIsExtreme(previous, current, nextValue) then
			return nil
		end
		local midpoint = (previous + nextValue) / 2
		return current + ((midpoint - current) * strength)
	end

	if type(previous) == "table" and type(current) == "table" and type(nextValue) == "table" then
		local changed = false
		local smoothed = cloneValue(current)
		for key, currentChild in pairs(current) do
			local child = smoothValue(previous[key], currentChild, nextValue[key], mode)
			if child ~= nil then
				smoothed[key] = child
				changed = true
			end
		end
		return changed and smoothed or nil
	end

	return nil
end

local function interpolateValue(leftValue, rightValue, alpha)
	alpha = math.clamp(alpha or 0, 0, 1)

	if typeof(leftValue) == "CFrame" and typeof(rightValue) == "CFrame" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if typeof(leftValue) == "Vector3" and typeof(rightValue) == "Vector3" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if typeof(leftValue) == "Vector2" and typeof(rightValue) == "Vector2" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if typeof(leftValue) == "Color3" and typeof(rightValue) == "Color3" then
		return leftValue:Lerp(rightValue, alpha)
	end

	if type(leftValue) == "number" and type(rightValue) == "number" then
		return leftValue + ((rightValue - leftValue) * alpha)
	end

	if typeof(leftValue) == "NumberRange" and typeof(rightValue) == "NumberRange" then
		return NumberRange.new(
			leftValue.Min + ((rightValue.Min - leftValue.Min) * alpha),
			leftValue.Max + ((rightValue.Max - leftValue.Max) * alpha)
		)
	end

	if typeof(leftValue) == "NumberSequence" and typeof(rightValue) == "NumberSequence" then
		local left = leftValue.Keypoints[1] and leftValue.Keypoints[1].Value or 0
		local right = rightValue.Keypoints[1] and rightValue.Keypoints[1].Value or left
		return NumberSequence.new(left + ((right - left) * alpha))
	end

	if typeof(leftValue) == "ColorSequence" and typeof(rightValue) == "ColorSequence" then
		local left = leftValue.Keypoints[1] and leftValue.Keypoints[1].Value or Color3.new(1, 1, 1)
		local right = rightValue.Keypoints[1] and rightValue.Keypoints[1].Value or left
		return ColorSequence.new(left:Lerp(right, alpha))
	end

	if type(leftValue) == "table" and type(rightValue) == "table" then
		local value = {}
		local seen = {}
		for key, child in pairs(leftValue) do
			seen[key] = true
			if rightValue[key] ~= nil then
				value[key] = interpolateValue(child, rightValue[key], alpha)
			else
				value[key] = cloneValue(child)
			end
		end
		for key, child in pairs(rightValue) do
			if not seen[key] then
				value[key] = cloneValue(child)
			end
		end
		return value
	end

	return alpha &lt; 0.5 and cloneValue(leftValue) or cloneValue(rightValue)
end

local function findNeighborFrames(frames, targetFrame)
	local previousFrame = nil
	local nextFrame = nil

	for _, frame in ipairs(frames) do
		if frame &lt; targetFrame then
			previousFrame = frame
		elseif frame &gt; targetFrame then
			nextFrame = frame
			break
		end
	end

	return previousFrame, nextFrame
end

local function groupSelectedKeysByPath(selectedKeyRefs)
	local grouped = {}
	for _, key in ipairs(selectedKeyRefs or {}) do
		local path = key.jointPath or key.path
		local frame = math.max(0, math.floor(key.frame or 0))
		if path then
			grouped[path] = grouped[path] or {}
			table.insert(grouped[path], frame)
		end
	end
	return grouped
end

local function buildTrackValueLookup(timeline, path)
	local lookup = {}
	local refs = {}
	for _, frame in ipairs(timeline:getTrackKeyframeFrames(path)) do
		table.insert(refs, {
			jointPath = path,
			frame = frame,
		})
	end
	for _, key in ipairs(timeline:getTrackKeyValues(refs)) do
		lookup[key.frame] = key
	end
	return lookup
end

local function sortUniqueFrames(frames)
	local unique = {}
	local seen = {}
	for _, frame in ipairs(frames or {}) do
		frame = math.max(0, math.floor(frame or 0))
		if not seen[frame] then
			seen[frame] = true
			table.insert(unique, frame)
		end
	end
	table.sort(unique)
	return unique
end

local function buildInbetweenUpdates(timeline, selectedKeyRefs, mode)
	local config = MODES[mode] or MODES.Light
	local targetSpacing = math.max(1, math.floor(config.targetSpacing or 3))
	local updates = {}

	for path, selectedFrames in pairs(groupSelectedKeysByPath(selectedKeyRefs)) do
		local frames = sortUniqueFrames(selectedFrames)
		if #frames &gt;= 2 then
			local valuesByFrame = buildTrackValueLookup(timeline, path)
			for index = 1, #frames - 1 do
				local startFrame = frames[index]
				local endFrame = frames[index + 1]
				local gap = endFrame - startFrame
				local leftKey = valuesByFrame[startFrame]
				local rightKey = valuesByFrame[endFrame]
				if gap &gt; 1 and leftKey and rightKey then
					local insertCount = gap &gt; targetSpacing
						and math.min(MAX_INSERTS_PER_GAP, math.floor((gap - 1) / targetSpacing))
						or 1
					for insertIndex = 1, insertCount do
						local targetFrame = gap &gt; targetSpacing
							and (startFrame + (insertIndex * targetSpacing))
							or (startFrame + math.floor(gap / 2))
						if targetFrame &gt;= endFrame then
							break
						end
						if not timeline:hasTrackKeyframe(path, targetFrame) then
							table.insert(updates, {
								jointPath = path,
								frame = targetFrame,
								value = interpolateValue(leftKey.value, rightKey.value, (targetFrame - startFrame) / gap),
								easingStyle = "Linear",
								easingDirection = "InOut",
							})
							if #updates &gt;= MAX_TOTAL_INSERTS then
								return updates, true
							end
						end
					end
				end
			end
		end
	end

	return updates, false
end

local function buildSelectionForAffectedSpans(timeline, selectedKeyRefs)
	local selected = {}
	local seen = {}

	for path, selectedFrames in pairs(groupSelectedKeysByPath(selectedKeyRefs)) do
		local frames = sortUniqueFrames(selectedFrames)
		if #frames &gt; 0 then
			local startFrame = frames[1]
			local endFrame = frames[#frames]
			for _, frame in ipairs(timeline:getTrackKeyframeFrames(path)) do
				if frame &gt;= startFrame and frame &lt;= endFrame then
					local id = tostring(path) .. "::" .. tostring(frame)
					if not seen[id] then
						seen[id] = true
						table.insert(selected, {
							jointPath = path,
							frame = frame,
						})
					end
				end
			end
		end
	end

	table.sort(selected, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return selected
end

function MotionSmoothingService.smoothSelectedKeys(timeline, selectedKeyRefs, mode)
	if not timeline then
		return false, "Smooth Motion could not access the timeline.", {}
	end
	if type(selectedKeyRefs) ~= "table" or #selectedKeyRefs == 0 then
		return false, "Select two or more keyframes before smoothing.", {}
	end

	local updates, capped = buildInbetweenUpdates(timeline, selectedKeyRefs, mode)
	for path, selectedFrames in pairs(groupSelectedKeysByPath(selectedKeyRefs)) do
		local allFrames = timeline:getTrackKeyframeFrames(path)
		if #allFrames &gt;= 3 then
			local valuesByFrame = buildTrackValueLookup(timeline, path)
			for _, frame in ipairs(selectedFrames) do
				local previousFrame, nextFrame = findNeighborFrames(allFrames, frame)
				local previousKey = previousFrame and valuesByFrame[previousFrame]
				local currentKey = valuesByFrame[frame]
				local nextKey = nextFrame and valuesByFrame[nextFrame]
				if previousKey and currentKey and nextKey then
					local value = smoothValue(previousKey.value, currentKey.value, nextKey.value, mode)
					if value ~= nil then
						table.insert(updates, {
							jointPath = path,
							frame = frame,
							value = value,
							easingStyle = currentKey.easingStyle or "Cubic",
							easingDirection = currentKey.easingDirection or "InOut",
						})
					end
				end
			end
		end
	end

	if #updates == 0 then
		return false, "Smooth Motion needs selected keyframes with empty gaps between them.", {}
	end

	local changedKeys = {}
	for _, update in ipairs(updates) do
		local ok = timeline:setTrackValueAtFrame(
			update.jointPath,
			update.frame,
			update.value,
			update.easingStyle,
			update.easingDirection
		)
		if ok then
			table.insert(changedKeys, {
				jointPath = update.jointPath,
				frame = update.frame,
			})
		end
	end

	if #changedKeys == 0 then
		return false, "Smooth Motion did not change any keyframes.", {}
	end

	local selectedAfterSmooth = buildSelectionForAffectedSpans(timeline, selectedKeyRefs)
	if #selectedAfterSmooth == 0 then
		selectedAfterSmooth = changedKeys
	end

	local cappedSuffix = capped and " Reached the safety limit, so select a smaller section for more in-betweens." or ""
	return true, string.format("Smoothed motion by adding/updating %d in-between keyframe%s.%s", #changedKeys, #changedKeys == 1 and "" or "s", cappedSuffix), selectedAfterSmooth
end

return MotionSmoothingService
</ProtectedString>
