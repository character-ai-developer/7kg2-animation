          <string name="Name">SelectionClearSupport</string>
          <ProtectedString name="Source">local SelectionClearSupport = {}

function SelectionClearSupport.clearSelectedKeyframes()
	return {}, nil
end

function SelectionClearSupport.clearSelectedTracks()
	return {}, nil
end

return SelectionClearSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX232">
        <Properties>
          <string name="Name">SelectionService</string>
          <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local Selection = game:GetService("Selection")
local TrackballDebugService = require(script.Parent:WaitForChild("TrackballDebugService"))

local SelectionService = {}
local lastWorkspaceSelection = {}
local lastRigSelection = {}
local preserveNextSelectionChange = false
local suppressSelectionGuard = false
local studioSelectionGuardSuspended = false
local studioSelectionGuardExplicitSuspended = false
local studioSelectionGuardTemporaryUntil = 0

local function debugLog(eventName, ...)
	TrackballDebugService.log("SelectionService", eventName, ...)
end

local function cloneSelection(selection)
	local clone = {}
	for _, instance in ipairs(selection or {}) do
		if instance and instance.Parent then
			table.insert(clone, instance)
		end
	end
	return clone
end

local function findHumanoid(model, recursive)
	if not (model and model:IsA("Model")) then
		return nil
	end
	if recursive then
		local success, humanoid = pcall(function()
			return model:FindFirstChildWhichIsA("Humanoid", true)
		end)
		return success and humanoid or nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

local function countAnimatableDescendants(model)
	local count = 0
	for _, descendant in ipairs(model:GetDescendants()) do
		local className = descendant.ClassName
		if className == "Motor6D" or className == "Bone" or className == "AnimationConstraint" then
			count += 1
			if count &gt;= 80 then
				return count
			end
		end
	end
	return count
end

local function scoreRigCandidate(model, selectedInstance)
	if not (model and model.Parent and model:IsA("Model")) then
		return nil
	end

	local animatableCount = countAnimatableDescendants(model)
	local directHumanoid = findHumanoid(model, false)
	local descendantHumanoid = directHumanoid or findHumanoid(model, true)
	if animatableCount == 0 and not descendantHumanoid then
		return nil
	end

	local score = 0
	if directHumanoid then
		score += 10000
	elseif descendantHumanoid then
		score += 1000
	end
	if model:FindFirstChild("HumanoidRootPart") then
		score += 500
	elseif model:FindFirstChild("HumanoidRootPart", true) then
		score += 150
	end
	score += math.min(animatableCount, 80) * 20
	if selectedInstance == model then
		score += 50
	elseif selectedInstance and selectedInstance:IsDescendantOf(model) then
		score += 25
	end

	return score
end

local function resolveRigModel(instance)
	if not (instance and instance.Parent) then
		return nil
	end

	local bestModel = nil
	local bestScore = nil
	local seen = {}

	local function consider(model)
		if seen[model] then
			return
		end
		seen[model] = true
		local score = scoreRigCandidate(model, instance)
		if score and (not bestScore or score &gt; bestScore) then
			bestScore = score
			bestModel = model
		end
	end

	local current = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
	while current do
		consider(current)
		current = current.Parent and current.Parent:FindFirstAncestorOfClass("Model") or nil
	end

	if instance:IsA("Model") then
		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("Model") then
				consider(descendant)
			end
		end
	end

	return bestModel
end

local function collectRigs(selection)
	local rigs = {}
	local seen = {}
	for _, instance in ipairs(selection or {}) do
		local model = resolveRigModel(instance)

		if model and not seen[model] then
			seen[model] = true
			table.insert(rigs, model)
		end
	end

	return rigs
end

local function syncStudioSelectionGuardSuspension()
	if studioSelectionGuardTemporaryUntil &gt; 0 and os.clock() &gt; studioSelectionGuardTemporaryUntil then
		studioSelectionGuardTemporaryUntil = 0
	end
	studioSelectionGuardSuspended = studioSelectionGuardExplicitSuspended == true
		or (studioSelectionGuardTemporaryUntil &gt; 0 and os.clock() &lt;= studioSelectionGuardTemporaryUntil)
	if studioSelectionGuardSuspended then
		preserveNextSelectionChange = false
	end
	return studioSelectionGuardSuspended
end

local function trackballOwnsViewport()
	syncStudioSelectionGuardSuspension()
	if studioSelectionGuardSuspended then
		return false
	end
	local folder = CoreGui:FindFirstChild("MegMoAnimatorTrackball")
	return folder ~= nil
		and folder:GetAttribute("OwnsViewport") == true
		and (
			folder:GetAttribute("Active") == true
			or folder:GetAttribute("Sticky") == true
			or folder:GetAttribute("Dragging") == true
			or (tonumber(folder:GetAttribute("IgnoreViewportPickerUntil")) or 0) &gt;= os.clock()
		)
end

local function clearExternalStudioSelection()
	if suppressSelectionGuard then
		return
	end
	debugLog("clearExternalStudioSelection")
	suppressSelectionGuard = true
	preserveNextSelectionChange = true
	pcall(function()
		Selection:Set({})
	end)
	preserveNextSelectionChange = false
	task.defer(function()
		suppressSelectionGuard = false
	end)
end

local function rememberSelection()
	if suppressSelectionGuard then
		return
	end
	if preserveNextSelectionChange then
		preserveNextSelectionChange = false
		return
	end
	if trackballOwnsViewport() then
		debugLog("rememberSelection blocked", "trackball owns viewport")
		clearExternalStudioSelection()
		return
	end
	lastWorkspaceSelection = cloneSelection(Selection:Get())
	local rigs = collectRigs(lastWorkspaceSelection)
	if #rigs &gt; 0 then
		lastRigSelection = rigs
	end
end

rememberSelection()
Selection.SelectionChanged:Connect(rememberSelection)

function SelectionService.getSelection()
	return Selection:Get()
end

function SelectionService.getLastWorkspaceSelection()
	return cloneSelection(lastWorkspaceSelection)
end

function SelectionService.getLastSelectedRigs()
	return collectRigs(lastRigSelection)
end

function SelectionService.getFirstSelected()
	local selected = Selection:Get()
	return selected[1]
end

function SelectionService.getSelectedRig()
	local rigs = SelectionService.getSelectedRigs()
	return rigs[1]
end

function SelectionService.getSelectedRigs()
	return collectRigs(Selection:Get())
end

function SelectionService.bindSelectionChanged(callback)
	return Selection.SelectionChanged:Connect(function(...)
		if trackballOwnsViewport() then
			debugLog("SelectionChanged blocked", "trackball owns viewport")
			clearExternalStudioSelection()
			return
		end
		callback(...)
	end)
end

function SelectionService.setSelection(instances, options)
	if typeof(instances) ~= "table" then
		return
	end
	options = options or {}
	local previousSelection = lastWorkspaceSelection
	if options.preserveWorkspaceSelection == true then
		preserveNextSelectionChange = true
	end
	Selection:Set(instances)
	if options.preserveWorkspaceSelection == true then
		lastWorkspaceSelection = previousSelection
	end
end

function SelectionService.setStudioSelectionGuardSuspended(suspended)
	studioSelectionGuardExplicitSuspended = suspended == true
	syncStudioSelectionGuardSuspension()
end

function SelectionService.suspendStudioSelectionGuardFor(durationSeconds)
	local duration = tonumber(durationSeconds) or 0
	if duration &lt;= 0 then
		return
	end
	studioSelectionGuardTemporaryUntil = math.max(studioSelectionGuardTemporaryUntil, os.clock() + duration)
	syncStudioSelectionGuardSuspension()
	task.delay(duration, syncStudioSelectionGuardSuspension)
end

function SelectionService.isStudioSelectionGuardSuspended()
	return syncStudioSelectionGuardSuspension() == true
end

return SelectionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX233">
        <Properties>
          <string name="Name">SelectionState</string>
          <ProtectedString name="Source">local SelectionState = {}

function SelectionState.sortFrames(frames)
	table.sort(frames, function(a, b)
		return a &lt; b
	end)
	return frames
end

function SelectionState.makeTrackKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(math.max(0, math.floor(frame or 0)))
end

function SelectionState.getGroupIdsForKeys(keys, groupMembership)
	local groupIds = {}
	local seen = {}
	for _, key in pairs(keys or {}) do
		local keyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame)
		local groupId = groupMembership and groupMembership[keyId]
		if groupId and not seen[groupId] then
			seen[groupId] = true
			table.insert(groupIds, groupId)
		end
	end
	table.sort(groupIds)
	return groupIds
end

function SelectionState.getKeyRefsForGroup(groupId, keyGroups, timeline)
	local group = keyGroups and keyGroups[groupId]
	local keys = {}
	if not group then
		return keys
	end

	for keyId in pairs(group.keys or {}) do
		local divider = string.find(keyId, "\n", 1, true)
		if divider then
			local jointPath = string.sub(keyId, 1, divider - 1)
			local frame = tonumber(string.sub(keyId, divider + 1))
			if jointPath and frame and timeline:hasTrackKeyframe(jointPath, frame) then
				table.insert(keys, {
					jointPath = jointPath,
					frame = frame,
				})
			end
		end
	end

	table.sort(keys, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return keys
end

function SelectionState.getSelectedKeyRefs(selectedKeys)
	local keys = {}
	for _, key in pairs(selectedKeys or {}) do
		table.insert(keys, {
			jointPath = key.jointPath,
			frame = key.frame,
		})
	end
	table.sort(keys, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return keys
end

function SelectionState.getSelectedKeyframeFrames(selectedKeys)
	local frames = {}
	local seen = {}
	for _, key in ipairs(SelectionState.getSelectedKeyRefs(selectedKeys)) do
		if not seen[key.frame] then
			seen[key.frame] = true
			table.insert(frames, key.frame)
		end
	end
	return SelectionState.sortFrames(frames)
end

function SelectionState.cloneSelectedKeys(keys)
	local clone = {}
	for keyId, key in pairs(keys or {}) do
		clone[keyId] = {
			jointPath = key.jointPath,
			frame = key.frame,
		}
	end
	return clone
end

function SelectionState.cloneSelectedTracks(tracks)
	local clone = {}
	for path, selected in pairs(tracks or {}) do
		if selected then
			clone[path] = true
		end
	end
	return clone
end

function SelectionState.cloneGroupState(groups)
	local clone = {}
	for groupId, group in pairs(groups or {}) do
		clone[groupId] = {
			id = group.id,
			mode = group.mode,
			name = group.name,
			kind = group.kind,
			folderPath = group.folderPath,
			sourceSpanFrames = group.sourceSpanFrames,
			runtimeCapture = group.runtimeCapture,
			runtimeKeyCount = group.runtimeKeyCount,
			runtimeKeySignature = group.runtimeKeySignature,
			runtimeCaptureValid = group.runtimeCaptureValid,
			repeatSourceSpanFrames = group.repeatSourceSpanFrames,
			keys = {},
			repeatSourceKeys = type(group.repeatSourceKeys) == "table" and {} or nil,
		}
		for keyId in pairs(group.keys or {}) do
			clone[groupId].keys[keyId] = true
		end
		for keyId in pairs(group.repeatSourceKeys or {}) do
			clone[groupId].repeatSourceKeys[keyId] = true
		end
	end
	return clone
end

function SelectionState.rebuildGroupMembership(keyGroups)
	local groupMembership = {}
	for groupId, group in pairs(keyGroups or {}) do
		for keyId in pairs(group.keys or {}) do
			groupMembership[keyId] = groupId
		end
	end
	return groupMembership
end

function SelectionState.remapGroupsAfterMove(oldKeys, newKeys, keyGroups, groupMembership)
	local oldRefs = {}
	for _, key in ipairs(oldKeys or {}) do
		table.insert(oldRefs, SelectionState.makeTrackKeyId(key.jointPath, key.frame))
	end

	local groupMoves = {}
	for index, key in ipairs(newKeys or {}) do
		local oldKeyId = oldRefs[index]
		local groupId = oldKeyId and groupMembership and groupMembership[oldKeyId]
		local group = groupId and keyGroups and keyGroups[groupId]
		if group then
			table.insert(groupMoves, {
				group = group,
				oldKeyId = oldKeyId,
				newKeyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame),
			})
		end
	end

	-- Remove every source membership before adding any destinations. Dense moves
	-- can overlap their original frame range, so interleaving remove/add would
	-- delete destinations that happen to be processed later as source keys.
	for _, move in ipairs(groupMoves) do
		move.group.keys[move.oldKeyId] = nil
	end
	for _, move in ipairs(groupMoves) do
		move.group.keys[move.newKeyId] = true
	end

	return SelectionState.rebuildGroupMembership(keyGroups)
end

function SelectionState.removeDeletedKeysFromGroups(keyGroups, timeline)
	for groupId, group in pairs(keyGroups or {}) do
		local remaining = 0
		for keyId in pairs(group.keys or {}) do
			local divider = string.find(keyId, "\n", 1, true)
			local jointPath = divider and string.sub(keyId, 1, divider - 1) or nil
			local frame = divider and tonumber(string.sub(keyId, divider + 1)) or nil
			if not jointPath or not frame or not timeline:hasTrackKeyframe(jointPath, frame) then
				group.keys[keyId] = nil
			else
				remaining += 1
			end
		end

		if remaining &lt; 2 then
			keyGroups[groupId] = nil
		end
	end

	return SelectionState.rebuildGroupMembership(keyGroups)
end

return SelectionState
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX234">
        <Properties>
          <string name="Name">ShortcutInputState</string>
          <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")

local ShortcutInputState = {}

local keysDown = {}
local connected = false

local function observeKeyCode(keyCode, isDown)
	if typeof(keyCode) ~= "EnumItem" or keyCode.EnumType ~= Enum.KeyCode then
		return
	end
	if keyCode == Enum.KeyCode.Unknown then
		return
	end
	if isDown then
		keysDown[keyCode.Name] = true
	else
		keysDown[keyCode.Name] = nil
	end
end

local function ensureConnected()
	if connected then
		return
	end
	connected = true

	UserInputService.InputBegan:Connect(function(input)
		if input and input.UserInputType == Enum.UserInputType.Keyboard then
			observeKeyCode(input.KeyCode, true)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input and input.UserInputType == Enum.UserInputType.Keyboard then
			observeKeyCode(input.KeyCode, false)
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		table.clear(keysDown)
	end)
end

function ShortcutInputState.observeKeyCode(keyCode, isDown)
	ensureConnected()
	observeKeyCode(keyCode, isDown == true)
end

function ShortcutInputState.isControlDown()
	ensureConnected()
	return keysDown.LeftControl == true
		or keysDown.RightControl == true
		or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
end

function ShortcutInputState.isShiftDown()
	ensureConnected()
	return keysDown.LeftShift == true
		or keysDown.RightShift == true
		or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

function ShortcutInputState.clear()
	table.clear(keysDown)
end

ensureConnected()

return ShortcutInputState
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX235">
        <Properties>
          <string name="Name">SoundKeyframeEditorController</string>
          <ProtectedString name="Source">local SoundTimelineService = require(script.Parent:WaitForChild("SoundTimelineService"))
local TrackEasingOptionsSupport = require(script.Parent:WaitForChild("TrackEasingOptionsSupport"))
local UiHelpers = require(script.Parent:WaitForChild("UiHelpers"))
local UiMotion = require(script.Parent:WaitForChild("UiMotion"))

local SoundKeyframeEditorController = {}

local FIELD_KEYS = {
	"soundId",
	"volume",
	"playbackSpeed",
	"startOffsetSeconds",
	"endTrimSeconds",
	"fadeInSeconds",
	"fadeOutSeconds",
	"rollOffMinDistance",
	"rollOffMaxDistance",
	"rollOffMode",
}

local FIELD_DEFAULTS = {
	soundId = "",
	volume = "0.5",
	playbackSpeed = "1",
	startOffsetSeconds = "0",
	endTrimSeconds = "0",
	fadeInSeconds = "0",
	fadeOutSeconds = "0",
	rollOffMinDistance = "10",
	rollOffMaxDistance = "10000",
	rollOffMode = "Inverse",
}

local function formatNumber(value)
	local number = tonumber(value)
	if not number then
		return ""
	end
	local text = string.format("%.3f", number)
	return text:gsub("0+$", ""):gsub("%.$", "")
end

local function getCurrentTrack(host)
	return host:_getTrackViewModel(host._activeSoundKeyframeTrackPath)
end

local function getExistingSoundKeyValue(host, track)
	if track and host._activeSoundKeyframeFrame ~= nil then
		local callbacks = host._callbacks or host._soundKeyframeEditorCallbacks or {}
		local timeline = type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
		local frame = math.max(0, math.floor(tonumber(host._activeSoundKeyframeFrame) or 0))
		if timeline and type(timeline.getTrackValueAtFrame) == "function" then
			local value = timeline:getTrackValueAtFrame(track.path, frame)
			if value ~= nil then
				return value, frame
			end
		end
	end

	local viewModel = host._lastViewModel or {}
	for _, key in ipairs(viewModel.selectedKeyValues or {}) do
		if key.jointPath == track.path then
			return key.value, key.frame
		end
	end
	return nil, nil
end

local function getSelectedSoundKeyValue(host, track)
	local value, frame = getExistingSoundKeyValue(host, track)
	if value ~= nil then
		return value, frame
	end
	local viewModel = host._lastViewModel or {}
	return SoundTimelineService.capture(track.instance), viewModel.currentFrame
end

local function mergeSoundValue(baseValue, edits)
	local merged = {}
	if type(baseValue) == "table" then
		for key, value in pairs(baseValue) do
			merged[key] = value
		end
	end
	for key, value in pairs(edits or {}) do
		merged[key] = value
	end
	return merged
end

local function snapshotToText(value)
	value = type(value) == "table" and value or {}
	return {
		soundId = tostring(value.soundId or value.SoundId or ""),
		volume = formatNumber(value.volume),
		playbackSpeed = formatNumber(value.playbackSpeed),
		startOffsetSeconds = formatNumber(value.startOffsetSeconds or value.startOffset or value.trimStartSeconds),
		endTrimSeconds = formatNumber(value.endTrimSeconds or value.endTrim or value.trimEndSeconds),
		fadeInSeconds = formatNumber(value.fadeInSeconds or value.fadeIn or value.audioFadeInSeconds),
		fadeOutSeconds = formatNumber(value.fadeOutSeconds or value.fadeOut or value.audioFadeOutSeconds),
		rollOffMinDistance = formatNumber(value.rollOffMinDistance),
		rollOffMaxDistance = formatNumber(value.rollOffMaxDistance),
		rollOffMode = tostring(value.rollOffMode or value.RollOffMode or FIELD_DEFAULTS.rollOffMode),
	}
end

local function readFields(host)
	local fields = {}
	local inputs = host._soundKeyframeEditorInputs or {}
	for _, key in ipairs(FIELD_KEYS) do
		fields[key] = inputs[key] and inputs[key].Text or FIELD_DEFAULTS[key]
	end
	return SoundTimelineService.parseEditorFields(fields)
end

local function applyEditorValue(host, callbacks)
	if not callbacks.onSetSoundKeyframeValue then
		return
	end
	local ok, valueOrMessage = readFields(host)
	if not ok then
		host:_setShortcutHint(valueOrMessage)
		return
	end
	local track = getCurrentTrack(host)
	local existingValue, frame = getExistingSoundKeyValue(host, track)
	if host._activeSoundKeyframeFrame ~= nil and existingValue == nil then
		host:_setShortcutHint("That audio clip no longer exists on the timeline.")
		return
	end
	if type(existingValue) == "table" then
		valueOrMessage = mergeSoundValue(existingValue, valueOrMessage)
	end
	callbacks.onSetSoundKeyframeValue(host._activeSoundKeyframeTrackPath, valueOrMessage, frame)
end

local function refreshEasingPanel(host)
	local overlay = host._soundKeyframeEditorOverlay
	local card = overlay and overlay:FindFirstChild("SoundKeyframeEditorCard")
	if not card then
		return
	end
	card.Size = UDim2.new(0, 530, 0, 660)
	if host._soundKeyframeEditorNoteLabel then
		host._soundKeyframeEditorNoteLabel.Position = UDim2.new(0, 18, 0, 528)
	end
	TrackEasingOptionsSupport.ensurePanel(host, {
		prefix = "soundKeyframeEditor",
		card = card,
		create = UiHelpers.create,
		createCorner = UiHelpers.createCorner,
		createStroke = UiHelpers.createStroke,
		position = UDim2.new(0, 18, 0, 454),
		size = UDim2.new(1, -36, 0, 68),
		zIndex = 132,
	})
	TrackEasingOptionsSupport.updatePanel(host, "soundKeyframeEditor")
	if host._soundKeyframeEditorCallbacks then
		TrackEasingOptionsSupport.connectPanel(host, host._soundKeyframeEditorCallbacks, "soundKeyframeEditor", function()
			SoundKeyframeEditorController.render(host)
		end)
	end
end

function SoundKeyframeEditorController.isSoundTrack(track)
	return SoundTimelineService.isSoundTrack(track)
end

function SoundKeyframeEditorController.show(host, trackPath, frame)
	if not host._soundKeyframeEditorOverlay then
		return
	end
	host._activeSoundKeyframeTrackPath = trackPath
	host._activeSoundKeyframeFrame = frame
	SoundKeyframeEditorController.render(host)
	UiMotion.popupIn(host._soundKeyframeEditorOverlay)
	host:_setShortcutHint("Sound editor open: edit settings, Test Play, then Apply Keyframe")
end

function SoundKeyframeEditorController.hide(host)
	if host._soundKeyframeEditorOverlay then
		UiMotion.popupOut(host._soundKeyframeEditorOverlay)
	end
	host._activeSoundKeyframeTrackPath = nil
	host._activeSoundKeyframeFrame = nil
end

function SoundKeyframeEditorController.render(host)
	if not host._soundKeyframeEditorOverlay then
		return
	end

	local track = getCurrentTrack(host)
	if not SoundKeyframeEditorController.isSoundTrack(track) then
		if host._soundKeyframeEditorItemLabel then
			host._soundKeyframeEditorItemLabel.Text = "Track: Sound"
		end
		return
	end

	local value, frame = getSelectedSoundKeyValue(host, track)
	local textValues = snapshotToText(value)
	local inputs = host._soundKeyframeEditorInputs or {}
	for _, key in ipairs(FIELD_KEYS) do
		if inputs[key] and not inputs[key]:IsFocused() then
			inputs[key].Text = textValues[key] ~= "" and textValues[key] or FIELD_DEFAULTS[key]
		end
	end

	if host._soundKeyframeEditorItemLabel then
		host._soundKeyframeEditorItemLabel.Text = string.format("%s sound at frame %s", tostring(track.name or "Sound"), tostring(frame or 0))
	end
	refreshEasingPanel(host)
end

function SoundKeyframeEditorController.connect(host, callbacks)
	host._soundKeyframeEditorCallbacks = callbacks
	if host._soundKeyframeEditorCloseButton then
		host:_connect(host._soundKeyframeEditorCloseButton.Activated, function()
			if callbacks.onCancelSoundKeyframePreview then
				callbacks.onCancelSoundKeyframePreview(host._activeSoundKeyframeTrackPath)
			end
			SoundKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Sound editor closed")
		end)
	end
	if host._soundKeyframeEditorOkButton then
		host:_connect(host._soundKeyframeEditorOkButton.Activated, function()
			applyEditorValue(host, callbacks)
			if callbacks.onCancelSoundKeyframePreview then
				callbacks.onCancelSoundKeyframePreview(host._activeSoundKeyframeTrackPath)
			end
			SoundKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Sound keyframe updated")
		end)
	end
	if host._soundKeyframeEditorApplyButton then
		host:_connect(host._soundKeyframeEditorApplyButton.Activated, function()
			applyEditorValue(host, callbacks)
			host:_focusShortcutCapture("Sound keyframe updated")
		end)
	end
	if host._soundKeyframeEditorStopButton then
		host:_connect(host._soundKeyframeEditorStopButton.Activated, function()
			local track = getCurrentTrack(host)
			if not track or not callbacks.onSetSoundClipEndFrame then
				host:_setShortcutHint("Select a Sound clip before setting its stop.")
				return
			end
			local _, frame = getExistingSoundKeyValue(host, track)
			if frame == nil then
				host:_setShortcutHint("Double-click or select an existing audio clip first.")
				return
			end
			local timeline = type(callbacks.getTimeline) == "function" and callbacks.getTimeline() or nil
			local liveFrame = timeline and type(timeline.getCurrentFrame) == "function" and timeline:getCurrentFrame() or nil
			local viewModel = host._lastViewModel or {}
			local endFrame = math.floor(tonumber(liveFrame or viewModel.currentFrame) or 0)
			if endFrame &lt;= (tonumber(frame) or 0) then
				host:_setShortcutHint("Move the playhead after the sound start, then set stop.")
				return
			end
			callbacks.onSetSoundClipEndFrame(track.path, frame, endFrame)
			SoundKeyframeEditorController.render(host)
			host:_focusShortcutCapture("Sound stop updated")
		end)
	end
	if host._soundKeyframeEditorTestButton then
		host:_connect(host._soundKeyframeEditorTestButton.Activated, function()
			local ok, valueOrMessage = readFields(host)
			if not ok then
				host:_setShortcutHint(valueOrMessage)
				return
			end
			if callbacks.onPreviewSoundKeyframeValue then
				callbacks.onPreviewSoundKeyframeValue(host._activeSoundKeyframeTrackPath, valueOrMessage)
			end
			host:_focusShortcutCapture("Sound preview played")
		end)
	end
end

return SoundKeyframeEditorController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX236">
        <Properties>
          <string name="Name">SoundTimelineService</string>
          <ProtectedString name="Source">local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local SoundTimelineService = {}

local DEFAULT_ROLLOFF_MODE = "Inverse"
local activePreviewSounds = {}
local previewParent = SoundService

local function trim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function clampNumber(value, fallback, minValue, maxValue)
	local number = tonumber(value)
	if not number then
		number = fallback
	end
	return math.clamp(number, minValue, maxValue)
end

local function cloneSoundValue(value)
	local clone = {}
	for key, childValue in pairs(value or {}) do
		clone[key] = childValue
	end
	return clone
end

function SoundTimelineService.findSound(instance)
	if not instance or not instance.Parent then
		return nil
	end
	if instance:IsA("Sound") then
		return instance
	end
	return instance:FindFirstChildWhichIsA("Sound", true)
end

function SoundTimelineService.isSoundTrack(track)
	return track ~= nil and (track.trackType == "Sound" or track.valueType == "Sound" or track.targetScope == "Sound")
end

function SoundTimelineService.normalizeSoundId(text)
	local raw = trim(text)
	if raw == "" then
		return ""
	end

	local assetId = raw:match("^%d+$")
		or raw:match("^rbxassetid://(%d+)$")
		or raw:match("[?&amp;]id=(%d+)")
	if assetId then
		return "rbxassetid://" .. assetId
	end

	if raw:match("^rbxasset://") or raw:match("^https?://") then
		return raw
	end

	return raw
end

function SoundTimelineService.capture(sound)
	if not sound or not sound.Parent or not sound:IsA("Sound") then
		return nil
	end

	local timeLength = 0
	pcall(function()
		timeLength = sound.TimeLength
	end)

	return {
		soundId = sound.SoundId or "",
		volume = sound.Volume,
		playbackSpeed = sound.PlaybackSpeed,
		rollOffMinDistance = sound.RollOffMinDistance,
		rollOffMaxDistance = sound.RollOffMaxDistance,
		rollOffMode = sound.RollOffMode and sound.RollOffMode.Name or DEFAULT_ROLLOFF_MODE,
		startOffsetSeconds = 0,
		endTrimSeconds = 0,
		fadeInSeconds = 0,
		fadeOutSeconds = 0,
		durationSeconds = type(timeLength) == "number" and timeLength &gt; 0 and timeLength or nil,
	}
end

function SoundTimelineService.parseEditorFields(fields)
	fields = fields or {}
	local rollOffMode = trim(fields.rollOffMode)
	if rollOffMode == "" then
		rollOffMode = DEFAULT_ROLLOFF_MODE
	end

	local ok, enumValue = pcall(function()
		return Enum.RollOffMode[rollOffMode]
	end)
	if not ok or not enumValue then
		return false, "RollOffMode must be Inverse, Linear, LinearSquare, or InverseTapered."
	end

	return true, {
		soundId = SoundTimelineService.normalizeSoundId(fields.soundId),
		volume = clampNumber(fields.volume, 0.5, 0, 10),
		playbackSpeed = clampNumber(fields.playbackSpeed, 1, 0.05, 20),
		startOffsetSeconds = clampNumber(fields.startOffsetSeconds, 0, 0, 100000),
		endTrimSeconds = clampNumber(fields.endTrimSeconds, 0, 0, 100000),
		fadeInSeconds = clampNumber(fields.fadeInSeconds, 0, 0, 100000),
		fadeOutSeconds = clampNumber(fields.fadeOutSeconds, 0, 0, 100000),
		rollOffMinDistance = clampNumber(fields.rollOffMinDistance, 10, 0, 100000),
		rollOffMaxDistance = clampNumber(fields.rollOffMaxDistance, 10000, 0, 100000),
		rollOffMode = enumValue.Name,
	}
end

function SoundTimelineService.apply(sound, value)
	if not sound or not sound.Parent or not sound:IsA("Sound") or type(value) ~= "table" then
		return false
	end

	local success = pcall(function()
		local soundId = value.soundId or value.SoundId
		if type(soundId) == "string" and soundId ~= "" then
			sound.SoundId = soundId
		end
		if type(value.volume) == "number" then
			sound.Volume = math.clamp(value.volume, 0, 10)
		end
		if type(value.playbackSpeed) == "number" then
			sound.PlaybackSpeed = math.clamp(value.playbackSpeed, 0.05, 20)
		end
		if type(value.rollOffMinDistance) == "number" then
			sound.RollOffMinDistance = math.max(0, value.rollOffMinDistance)
		end
		if type(value.rollOffMaxDistance) == "number" then
			sound.RollOffMaxDistance = math.max(0, value.rollOffMaxDistance)
		end
		local rollOffMode = value.rollOffMode or value.RollOffMode
		if typeof(rollOffMode) == "EnumItem" and rollOffMode.EnumType == Enum.RollOffMode then
			sound.RollOffMode = rollOffMode
		elseif type(rollOffMode) == "string" and Enum.RollOffMode[rollOffMode] then
			sound.RollOffMode = Enum.RollOffMode[rollOffMode]
		end
	end)

	return success == true
end

function SoundTimelineService.getStartOffsetSeconds(value)
	if type(value) ~= "table" then
		return 0
	end
	return math.max(0, tonumber(value.startOffsetSeconds or value.startOffset or value.trimStartSeconds) or 0)
end

function SoundTimelineService.getEndTrimSeconds(value)
	if type(value) ~= "table" then
		return 0
	end
	return math.max(0, tonumber(value.endTrimSeconds or value.endTrim or value.trimEndSeconds) or 0)
end

function SoundTimelineService.getFadeInSeconds(value)
	if type(value) ~= "table" then
		return 0
	end
	return math.max(0, tonumber(value.fadeInSeconds or value.fadeIn or value.audioFadeInSeconds) or 0)
end

function SoundTimelineService.getFadeOutSeconds(value)
	if type(value) ~= "table" then
		return 0
	end
	return math.max(0, tonumber(value.fadeOutSeconds or value.fadeOut or value.audioFadeOutSeconds) or 0)
end

function SoundTimelineService.getExplicitClipDurationSeconds(value)
	if type(value) ~= "table" then
		return nil
	end
	local duration = tonumber(value.clipDurationSeconds or value.timelineClipDurationSeconds or value.stopDurationSeconds)
	if duration and duration &gt; 0 then
		return duration
	end
	return nil
end

local function getValuePlaybackSpeed(value, fallback)
	local speed = type(value) == "table" and tonumber(value.playbackSpeed) or nil
	speed = speed or tonumber(fallback) or 1
	return math.max(0.05, speed)
end

function SoundTimelineService.getSourceDurationSeconds(sound, value)
	local duration = type(value) == "table" and tonumber(value.durationSeconds) or nil
	if duration and duration &gt; 0 then
		return duration
	end
	if sound then
		local ok, timeLength = pcall(function()
			return sound.TimeLength
		end)
		if ok and type(timeLength) == "number" and timeLength &gt; 0 then
			return timeLength
		end
	end
	return nil
end

local function getSourceClipDurationSeconds(sound, value)
	local sourceDuration = SoundTimelineService.getSourceDurationSeconds(sound, value)
	local speed = getValuePlaybackSpeed(value, sound and sound.PlaybackSpeed)
	if sourceDuration then
		local trimmed = sourceDuration - SoundTimelineService.getStartOffsetSeconds(value) - SoundTimelineService.getEndTrimSeconds(value)
		return math.max(0, trimmed) / speed
	end
	return nil
end

function SoundTimelineService.getClipDurationSeconds(sound, value, fallbackSeconds)
	local explicitDuration = SoundTimelineService.getExplicitClipDurationSeconds(value)
	local sourceDuration = getSourceClipDurationSeconds(sound, value)
	if explicitDuration then
		return sourceDuration and math.min(explicitDuration, sourceDuration) or explicitDuration
	end
	return sourceDuration or math.max(0, tonumber(fallbackSeconds) or 0.5)
end

function SoundTimelineService.getKnownClipDurationSeconds(sound, value)
	local explicitDuration = SoundTimelineService.getExplicitClipDurationSeconds(value)
	local sourceDuration = getSourceClipDurationSeconds(sound, value)
	if explicitDuration then
		return sourceDuration and math.min(explicitDuration, sourceDuration) or explicitDuration
	end
	return sourceDuration
end

function SoundTimelineService.getClipDurationFrames(sound, value, fps, fallbackSeconds)
	local seconds = SoundTimelineService.getClipDurationSeconds(sound, value, fallbackSeconds)
	return math.max(1, math.ceil(seconds * math.max(1, tonumber(fps) or 60)))
end

function SoundTimelineService.getKnownClipDurationFrames(sound, value, fps)
	local seconds = SoundTimelineService.getKnownClipDurationSeconds(sound, value)
	if not seconds then
		return nil
	end
	return math.max(1, math.ceil(seconds * math.max(1, tonumber(fps) or 60)))
end

function SoundTimelineService.withStopFrame(sound, value, startFrame, stopFrame, fps)
	if type(value) ~= "table" then
		return false, nil, "Sound keyframe data is missing."
	end

	local sourceDuration = SoundTimelineService.getSourceDurationSeconds(sound, value)
	if not sourceDuration or sourceDuration &lt;= 0 then
		return false, nil, "Sound duration is still loading. Try again after the audio appears on the timeline."
	end

	fps = math.max(1, tonumber(fps) or 60)
	startFrame = math.max(0, math.floor(tonumber(startFrame) or 0))
	stopFrame = math.max(startFrame + 1, math.floor((tonumber(stopFrame) or startFrame + 1) + 0.5))

	local playbackSpeed = getValuePlaybackSpeed(value, sound and sound.PlaybackSpeed)
	local clipSeconds = (stopFrame - startFrame) / fps
	local startOffsetSeconds = SoundTimelineService.getStartOffsetSeconds(value)
	local sourceStopSeconds = math.clamp(startOffsetSeconds + (clipSeconds * playbackSpeed), startOffsetSeconds, sourceDuration)
	local nextValue = cloneSoundValue(value)
	nextValue.durationSeconds = sourceDuration
	nextValue.endTrimSeconds = math.max(0, sourceDuration - sourceStopSeconds)

	local actualClipSeconds = math.max(0, (sourceStopSeconds - startOffsetSeconds) / playbackSpeed)
	nextValue.clipDurationSeconds = actualClipSeconds
	return true, nextValue, string.format("Audio stop set at %.2fs.", actualClipSeconds)
end

local function forgetPreviewSound(sourceSound, previewSound)
	local previews = activePreviewSounds[sourceSound]
	if not previews then
		return
	end
	for index = #previews, 1, -1 do
		if previews[index] == previewSound then
			table.remove(previews, index)
		end
	end
	if #previews == 0 then
		activePreviewSounds[sourceSound] = nil
	end
end

local function destroyPreviewSound(sourceSound, previewSound)
	if not previewSound then
		return
	end
	forgetPreviewSound(sourceSound, previewSound)
	pcall(function()
		previewSound:Stop()
	end)
	if previewSound.Parent then
		previewSound:Destroy()
	end
end

local function stopPreviewSounds(sourceSound)
	local previews = activePreviewSounds[sourceSound]
	activePreviewSounds[sourceSound] = nil
	for _, previewSound in ipairs(previews or {}) do
		if previewSound and previewSound.Parent then
			pcall(function()
				previewSound:Stop()
			end)
			previewSound:Destroy()
		end
	end
end

local function createPreviewSound(sourceSound)
	local previewSound = Instance.new("Sound")
	previewSound.Name = "MegMoPreview_" .. tostring(sourceSound.Name)
	previewSound.SoundId = sourceSound.SoundId
	previewSound.Volume = sourceSound.Volume
	previewSound.PlaybackSpeed = sourceSound.PlaybackSpeed
	previewSound.RollOffMinDistance = sourceSound.RollOffMinDistance
	previewSound.RollOffMaxDistance = sourceSound.RollOffMaxDistance
	previewSound.RollOffMode = sourceSound.RollOffMode
	previewSound.Looped = false
	previewSound.TimePosition = 0
	return previewSound
end

local function getPlaybackDurationSeconds(sound)
	if not sound then
		return nil
	end
	local ok, timeLength = pcall(function()
		return sound.TimeLength
	end)
	if not ok or type(timeLength) ~= "number" or timeLength &lt;= 0 then
		return nil
	end
	local speed = tonumber(sound.PlaybackSpeed) or 1
	speed = math.max(0.05, speed)
	return timeLength / speed
end

local function getTrimmedEndPosition(sound, value)
	local duration = SoundTimelineService.getSourceDurationSeconds(sound, value)
	if not duration then
		return nil
	end
	return math.max(0, duration - SoundTimelineService.getEndTrimSeconds(value))
end

local function getFadeVolumeScale(value, elapsedSeconds, clipDurationSeconds)
	local scale = 1
	local fadeInSeconds = SoundTimelineService.getFadeInSeconds(value)
	if fadeInSeconds &gt; 0 then
		scale = math.min(scale, math.clamp(elapsedSeconds / fadeInSeconds, 0, 1))
	end

	local fadeOutSeconds = SoundTimelineService.getFadeOutSeconds(value)
	if fadeOutSeconds &gt; 0 and clipDurationSeconds and clipDurationSeconds &gt; 0 then
		local remainingSeconds = clipDurationSeconds - elapsedSeconds
		scale = math.min(scale, math.clamp(remainingSeconds / fadeOutSeconds, 0, 1))
	end

	return math.clamp(scale, 0, 1)
end

local function startVolumeFade(previewSound, value, clipDurationSeconds, timelineOffsetSeconds)
	local fadeInSeconds = SoundTimelineService.getFadeInSeconds(value)
	local fadeOutSeconds = SoundTimelineService.getFadeOutSeconds(value)
	local baseVolume = math.clamp(tonumber(previewSound.Volume) or 1, 0, 10)
	local startClock = os.clock()
	local connection = nil
	local ancestryConnection = nil

	local function disconnect()
		if connection then
			connection:Disconnect()
			connection = nil
		end
		if ancestryConnection then
			ancestryConnection:Disconnect()
			ancestryConnection = nil
		end
	end

	local function update()
		if not previewSound.Parent then
			disconnect()
			return
		end
		local elapsedSeconds = math.max(0, (tonumber(timelineOffsetSeconds) or 0) + (os.clock() - startClock))
		local knownClipDuration = clipDurationSeconds or SoundTimelineService.getKnownClipDurationSeconds(previewSound, value)
		previewSound.Volume = baseVolume * getFadeVolumeScale(value, elapsedSeconds, knownClipDuration)
	end

	update()
	if fadeInSeconds &lt;= 0 and fadeOutSeconds &lt;= 0 then
		return
	end

	connection = RunService.Heartbeat:Connect(update)
	ancestryConnection = previewSound.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			disconnect()
		end
	end)
end

function SoundTimelineService.setPreviewParent(parent)
	if parent and parent.Parent then
		previewParent = parent
	else
		previewParent = SoundService
	end
end

local function getIsPlaying(sound)
	local isPlaying = false
	pcall(function()
		isPlaying = sound.IsPlaying or sound.Playing
	end)
	return isPlaying == true
end

local function getSoundPath(sound)
	if not sound then
		return "nil"
	end
	local ok, path = pcall(function()
		return sound:GetFullName()
	end)
	return ok and path or tostring(sound.Name)
end

local function rememberPreviewSound(sourceSound, previewSound)
	activePreviewSounds[sourceSound] = activePreviewSounds[sourceSound] or {}
	table.insert(activePreviewSounds[sourceSound], previewSound)
	local endedConnection
	endedConnection = previewSound.Ended:Connect(function()
		if endedConnection then
			endedConnection:Disconnect()
		end
		destroyPreviewSound(sourceSound, previewSound)
	end)
	local cleanupDelay = 120
	local ok, timeLength = pcall(function()
		return previewSound.TimeLength
	end)
	local speed = tonumber(previewSound.PlaybackSpeed) or 1
	speed = math.max(0.05, speed)
	if ok and type(timeLength) == "number" and timeLength &gt; 0 then
		cleanupDelay = math.max(2, (timeLength / speed) + 2)
	end
	task.delay(cleanupDelay, function()
		if endedConnection then
			endedConnection:Disconnect()
		end
		destroyPreviewSound(sourceSound, previewSound)
	end)
end

function SoundTimelineService.play(sound, value, timelineOffsetSeconds)
	if not SoundTimelineService.apply(sound, value) then
		return false
	end
	if (sound.SoundId or "") == "" then
		return false
	end

	timelineOffsetSeconds = math.max(0, tonumber(timelineOffsetSeconds) or 0)
	local success = pcall(function()
		stopPreviewSounds(sound)
		sound:Stop()
		local previewSound = createPreviewSound(sound)
		local playbackSpeed = math.max(0.05, tonumber(previewSound.PlaybackSpeed) or 1)
		local clipDurationSeconds = SoundTimelineService.getKnownClipDurationSeconds(previewSound, value)
		if clipDurationSeconds and timelineOffsetSeconds &gt;= clipDurationSeconds then
			previewSound:Destroy()
			return
		end
		local targetTimePosition = SoundTimelineService.getStartOffsetSeconds(value) + (timelineOffsetSeconds * playbackSpeed)
		local function applyStartOffset()
			if targetTimePosition &lt;= 0 or not previewSound.Parent then
				return
			end
			pcall(function()
				previewSound.TimePosition = targetTimePosition
			end)
		end
		local function scheduleTrimStop()
			local knownClipDuration = SoundTimelineService.getKnownClipDurationSeconds(previewSound, value)
			if knownClipDuration then
				local remainingSeconds = math.max(0, knownClipDuration - timelineOffsetSeconds)
				if remainingSeconds &lt;= 0 then
					destroyPreviewSound(sound, previewSound)
					return
				end
				task.delay(remainingSeconds, function()
					destroyPreviewSound(sound, previewSound)
				end)
				return
			end
			local endPosition = getTrimmedEndPosition(previewSound, value)
			if not endPosition then
				return
			end
			local remainingSeconds = math.max(0, (endPosition - targetTimePosition) / playbackSpeed)
			if remainingSeconds &lt;= 0 then
				destroyPreviewSound(sound, previewSound)
				return
			end
			task.delay(remainingSeconds, function()
				destroyPreviewSound(sound, previewSound)
			end)
		end
		if targetTimePosition &gt; 0 then
			pcall(function()
				previewSound.Loaded:Connect(function()
					applyStartOffset()
					scheduleTrimStop()
				end)
			end)
			applyStartOffset()
		end
		previewSound.Parent = previewParent or SoundService
		rememberPreviewSound(sound, previewSound)
		startVolumeFade(previewSound, value, clipDurationSeconds, timelineOffsetSeconds)
		previewSound:Play()
		applyStartOffset()
		scheduleTrimStop()
		task.delay(0.1, function()
			if not previewSound.Parent then
				return
			end
			local clonePlaying = getIsPlaying(previewSound)
			applyStartOffset()
			scheduleTrimStop()
			if not clonePlaying then
				pcall(function()
					SoundService:PlayLocalSound(previewSound)
				end)
				pcall(function()
					previewSound:Play()
				end)
				applyStartOffset()
				scheduleTrimStop()
			end
		end)
	end)
	return success == true
end

function SoundTimelineService.stop(sound)
	if not sound or not sound.Parent or not sound:IsA("Sound") then
		return false
	end

	local success = pcall(function()
		sound:Stop()
		stopPreviewSounds(sound)
	end)
	return success == true
end

return SoundTimelineService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX237">
        <Properties>
          <string name="Name">StudioSelectionActions</string>
          <ProtectedString name="Source">local StudioSelectionActions = {}

function StudioSelectionActions.selectRigInStudio(context)
	local timeline = context.timeline
	local selectedJointPath = context.selectedJointPath
	local selectionService = context.selectionService
	local refreshUi = context.refreshUi

	local selectedMotor = selectedJointPath and timeline:getMotorByPath(selectedJointPath) or nil
	local rig = selectedMotor and selectedMotor.rig or timeline:getRig()
	if not rig or not rig.Parent then
		refreshUi("Bind a rig before selecting it in Studio.")
		return
	end

	selectionService.setSelection({ rig })
	refreshUi(string.format("Selected rig '%s' in Studio.", rig.Name))
end

function StudioSelectionActions.selectJointPartInStudio(context)
	local timeline = context.timeline
	local selectedJointPath = context.selectedJointPath
	local selectionService = context.selectionService
	local refreshUi = context.refreshUi

	local selectedTrack = timeline:getTrackByPath(selectedJointPath)
	if selectedTrack and selectedTrack.trackType ~= "Rig" then
		if selectedTrack.instance and selectedTrack.instance.Parent then
			selectionService.setSelection({ selectedTrack.instance })
			refreshUi(string.format("Selected '%s' in Studio.", selectedTrack.instance.Name))
		else
			refreshUi("That track target is no longer available.")
		end
		return
	end

	local motorData = timeline:getMotorByPath(selectedJointPath)
	if not motorData or not motorData.instance or not motorData.instance.Parent then
		refreshUi("Select a joint before focusing it in Studio.")
		return
	end

	local joint = motorData.instance
	local targetPart = nil
	if joint:IsA("Motor6D") then
		targetPart = joint.Part1 or joint.Part0
	elseif joint:IsA("Bone") then
		targetPart = joint
	end
	if not targetPart then
		refreshUi("That joint does not have a visible part to select.")
		return
	end

	selectionService.setSelection({ targetPart })
	refreshUi(string.format("Selected '%s' in Studio.", targetPart.Name))
end

return StudioSelectionActions
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX238">
        <Properties>
          <string name="Name">SubtitleClipVisualSupport</string>
          <ProtectedString name="Source">local AudioClipVisualSupport = require(script.Parent:WaitForChild("AudioClipVisualSupport"))

local SubtitleClipVisualSupport = {}

local SUBTITLE_COLOR = Color3.fromRGB(255, 178, 80)
local SUBTITLE_SELECTED_COLOR = Color3.fromRGB(132, 84, 255)
local SUBTITLE_TEXT_COLOR = Color3.fromRGB(28, 16, 6)

local lastClickKey = nil
local lastClickClock = 0

function SubtitleClipVisualSupport.buildTooltip(label, clip)
	local lines = { label }
	if type(clip) == "table" then
		lines[#lines + 1] = string.format("Frames %d-%d", math.floor(tonumber(clip.frame) or 0), math.floor(tonumber(clip.endFrame) or 0))
	end
	return table.concat(lines, "\n")
end

function SubtitleClipVisualSupport.renderMicroClips(config)
	config = config or {}
	local make = config.make
	local keyLayer = config.keyLayer
	local track = config.track
	if type(make) ~= "function" or not keyLayer or type(track) ~= "table" then
		return
	end

	local visibleStartFrame = tonumber(config.visibleStartFrame) or 0
	local visibleEndFrame = tonumber(config.visibleEndFrame) or visibleStartFrame
	local visibleFrameRange = math.max(1, tonumber(config.visibleFrameRange) or 1)
	local timelinePixelWidth = math.max(1, tonumber(config.timelinePixelWidth) or 1)
	local gutter = tonumber(config.gutter) or 0
	local trackHeight = math.max(12, tonumber(config.trackHeight) or 22)
	local y = math.floor(tonumber(config.y) or 0)
	local durationFrames = math.max(1, tonumber(config.durationFrames) or 1)
	local selectedKeyMap = type(config.selectedKeyMap) == "table" and config.selectedKeyMap or {}
	local selectedKeyId = type(config.selectedKeyId) == "function" and config.selectedKeyId or function(path, frame)
		return tostring(path) .. "@" .. tostring(frame)
	end
	local clips = type(config.clips) == "table" and config.clips or {}

	for clipIndex, clip in ipairs(clips) do
		local frame = math.max(0, math.floor(tonumber(clip.frame) or 0))
		local endFrame = math.max(frame + 1, math.floor(tonumber(clip.endFrame) or (frame + 1)))
		if endFrame &lt; visibleStartFrame or frame &gt; visibleEndFrame then
			continue
		end

		local startX = gutter + (((frame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		local endX = gutter + (((endFrame - visibleStartFrame) / visibleFrameRange) * timelinePixelWidth)
		local clipWidth = math.max(28, endX - startX)
		local clipX = startX + (clipWidth * 0.5)
		local clipHeight = math.max(18, trackHeight - 2)
		local clipY = y + math.floor((trackHeight - clipHeight) * 0.5)
		local keyId = selectedKeyId(track.path, frame)
		local keySelected = selectedKeyMap[keyId] == true
		local label = tostring(clip.text or "")
		if label == "" then
			label = "Subtitle"
		end

		local key = make("TextButton", {
			Name = string.format("SubtitleClip%d_%d", tonumber(config.trackIndex) or 0, clipIndex),
			Active = true,
			AutoButtonColor = true,
			BackgroundColor3 = keySelected and SUBTITLE_SELECTED_COLOR or SUBTITLE_COLOR,
			BackgroundTransparency = keySelected and 0.03 or 0.12,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(clipX - math.floor(clipWidth * 0.5), clipY),
			Size = UDim2.fromOffset(clipWidth, clipHeight),
			Text = "",
			TextColor3 = SUBTITLE_TEXT_COLOR,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = tonumber(config.zIndex) or 9,
		}, keyLayer)

		if type(config.corner) == "function" then
			config.corner(key, 6)
		end

		make("TextLabel", {
			Name = "SubtitleClipLabel",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(5, 0),
			Size = UDim2.new(1, -12, 1, 0),
			Text = clipWidth &gt; 42 and label or "",
			TextColor3 = SUBTITLE_TEXT_COLOR,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = key.ZIndex + 2,
		}, key)

		AudioClipVisualSupport.attachStopHandle({
			makeInstance = make,
			parent = key,
			trackPath = track.path,
			startFrame = frame,
			endFrame = endFrame,
			clipWidth = clipWidth,
			clipHeight = clipHeight,
			visibleStartFrame = visibleStartFrame,
			visibleFrameRange = visibleFrameRange,
			timelinePixelWidth = timelinePixelWidth,
			timelineLayer = keyLayer,
			gutter = gutter,
			durationFrames = durationFrames,
			statusLabel = config.statusLabel,
			refresh = config.refresh,
			onSetStopFrame = config.onSetEndFrame or function(...)
				if type(config.runOption) == "function" then
					return config.runOption(config.options, "onSetSubtitleClipEndFrame", "setSubtitleClipEndFrame", ...)
				end
				return false, "Subtitle end handle is not connected yet. Restart Studio to load the latest 7kg2 build."
			end,
			handleName = "SubtitleEndHandle",
			statusPrefix = "Subtitle end",
			missingCallbackMessage = "Subtitle end handle is not connected yet. Restart Studio to load the latest 7kg2 build.",
			attributePrefix = "MegMoSubtitleEnd",
			zIndex = key.ZIndex + 4,
		})

		if type(config.visibleKeyRects) == "table" then
			config.visibleKeyRects[#config.visibleKeyRects + 1] = {
				path = track.path,
				frame = frame,
				centerX = clipX,
				centerY = y + math.floor(trackHeight * 0.5),
			}
		end
		if type(config.visibleKeyButtons) == "table" then
			config.visibleKeyButtons[keyId] = {
				button = key,
				path = track.path,
				frame = frame,
				centerFrame = frame + ((endFrame - frame) * 0.5),
				x = clipX,
				y = clipY,
				size = math.max(clipWidth, clipHeight),
			}
		end

		key.MouseEnter:Connect(function()
			if type(config.positionTooltip) == "function" then
				config.positionTooltip(key, config.toolHint, SubtitleClipVisualSupport.buildTooltip(label, clip), 4)
			end
		end)
		key.MouseMoved:Connect(function()
			if type(config.positionTooltip) == "function" then
				config.positionTooltip(key, config.toolHint, SubtitleClipVisualSupport.buildTooltip(label, clip), 4)
			end
		end)
		key.MouseLeave:Connect(function()
			if config.toolHint then
				config.toolHint.Visible = false
			end
		end)
		key.MouseButton1Click:Connect(function()
			if type(config.isRecentKeyDragRelease) == "function" and config.isRecentKeyDragRelease() then
				return
			end
			if key:GetAttribute("MegMoSubtitleEndDragging") == true or key:GetAttribute("MegMoSubtitleEndSuppressClick") == true then
				return
			end
			local clickKey = tostring(track.path) .. ":" .. tostring(frame)
			local now = os.clock()
			local isDoubleClick = lastClickKey == clickKey and (now - lastClickClock) &lt;= 0.34
			lastClickKey = clickKey
			lastClickClock = now
			if isDoubleClick then
				lastClickKey = nil
				lastClickClock = 0
				if config.editorController and type(config.editorController.show) == "function" then
					config.editorController.show(config.host, track.path, frame)
				end
				if config.statusLabel then
					config.statusLabel.Text = "Editing subtitle clip."
				end
				return
			end
			task.delay(0.36, function()
				if lastClickKey ~= clickKey or lastClickClock ~= now then
					return
				end
				lastClickKey = nil
				lastClickClock = 0
				if type(config.runOption) == "function" then
					if type(config.options) == "table" then
						config.options._microLastSelectionScope = "track"
					end
					config.runOption(config.options, "onSelectKey", "selectKey", track.path, frame, false)
				end
				if type(config.refresh) == "function" then
					config.refresh()
				end
			end)
		end)
		local function beginSubtitleClipDrag()
			if key:GetAttribute("MegMoSubtitleEndDragging") == true or key:GetAttribute("MegMoSubtitleEndSuppressClick") == true then
				return
			end
			if type(config.onBeginClipDrag) == "function" then
				config.onBeginClipDrag(key, clip, keyId, frame, clipX, clipY, clipWidth, clipHeight)
			end
		end
		key.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				beginSubtitleClipDrag()
			end
		end)
		key.MouseButton1Down:Connect(function()
			beginSubtitleClipDrag()
		end)
	end
end

return SubtitleClipVisualSupport
</ProtectedString>
