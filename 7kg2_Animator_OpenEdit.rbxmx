		title = title,
		startLabel = startLabel,
		endLabel = endLabel,
		diamonds = diamonds,
		playhead = playhead,
		ticks = ticks,
		trackLine = trackLine,
	}
end

local function trackLabel(effectMode)
	if effectMode == "Release" then
		return "Released object - CFrame"
	end
	if effectMode == "Character" or effectMode == "AdaptiveWalk" then
		return "Character motion"
	end
	if effectMode == "Explosion" or effectMode == "Projectile" then
		return "Physics event motion"
	end
	return "Captured objects - CFrame"
end

local function trackCountText(effectMode, take)
	local objectCount = take and tonumber(take.objectCount) or 0
	if objectCount &gt; 0 then
		return string.format("%d object%s", objectCount, objectCount == 1 and "" or "s")
	end
	if effectMode == "Character" or effectMode == "AdaptiveWalk" then
		return "1 character"
	end
	return "1 motion track"
end

function EffectSetupPresentation.new(refs, theme, callbacks)
	theme = theme or {
		border = BORDER,
		panel = PANEL,
		panelAlt = STATUS,
		button = STATUS,
		text = WHITE,
		muted = SUBTEXT,
	}
	local self = setmetatable({
		refs = refs,
		theme = theme,
		callbacks = callbacks or {},
		stageUnderlines = {},
	}, EffectSetupPresentation)

	local headerTitle = refs.header and refs.header:FindFirstChild("Title")
	local headerSubtitle = refs.header and refs.header:FindFirstChild("Subtitle")
	local headerIcon = refs.header and refs.header:FindFirstChild("Icon")
	self.headerTitle = headerTitle
	self.headerSubtitle = headerSubtitle
	self.headerIcon = headerIcon
	if headerTitle then
		headerTitle.RichText = false
	end
	if headerIcon then
		headerIcon.BackgroundColor3 = theme.panelAlt
	end

	for _, child in ipairs(refs.stageNavigation:GetChildren()) do
		if child:IsA("TextLabel") and child.Text == "&gt;" then
			child.Visible = false
		end
	end
	for _, entry in ipairs({
		{ refs.stageSetup, "Setup" },
		{ refs.stageCapture, "Capture" },
		{ refs.stageBake, "Bake" },
	}) do
		local button = entry[1]
		button.Text = entry[2]
		button.BackgroundTransparency = 1
		button.Font = Enum.Font.GothamSemibold
		button.TextSize = 11
		local buttonStroke = button:FindFirstChildOfClass("UIStroke")
		if buttonStroke then
			buttonStroke.Transparency = 1
		end
		local underline = make("Frame", {
			Name = "ActiveUnderline",
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = theme.text,
			BorderSizePixel = 0,
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.new(1, -24, 0, 2),
			Visible = false,
		}, button)
		table.insert(self.stageUnderlines, {
			button = button,
			underline = underline,
		})
	end
