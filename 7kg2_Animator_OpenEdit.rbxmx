	state.invalidateExplosionTestCache()
	if state.previewSession then
		TakePreviewRuntime.Stop(state.previewSession, true)
		state.previewSession = nil
	end
	if RunService:IsRunning() then
		pcall(function()
			RunService:Stop()
		end)
	end
	if state.ragdollCapture then
		state.multiRigRagdollSupport.StopRecorders(state.ragdollCapture)
	elseif state.recorder then
		state.recorder:Stop()
	end
	AnimatedPathRuntime.Cancel(state.pathSession)
	AnimatedPathRuntime.Cancel(state.heldPathSession)
	restoreAdaptiveWalkOriginal()
	RiderRuntime.Cancel(state.riderRuntimeSession)
	PhysicsDriveRuntime.Cancel(state.physicsDriveSession)
	state.eventRuntime.Cancel(state.eventSession)
	ImpactBreakRuntime.Restore(state.impactSession)
	if state.ragdollCapture then
		state.multiRigRagdollSupport.RestoreSessions(state.ragdollCapture)
	else
		RagdollRuntime.Restore(state.ragdollSession)
	end
	restoreRagdollOriginal()
	for _, item in ipairs(state.runtimeObjectAnchors or {}) do
		if item.part and item.part.Parent then
			item.part.CustomPhysicalProperties = item.customPhysicalProperties
			item.part.Anchored = item.anchored
		end
	end
	local restoredObjects = restoreOriginalSetup()
	SceneCaptureScope.ClearRuntimeIds(state.objectTargets, true)
	state.eventSourceScope.ClearRuntimeIds(state.eventSourceTargets, true)
	RiderRuntime.ClearRuntimeIds(state.riderTargets)
	clearCaptureAttribute()
