			Text = row[1],
			TextColor3 = theme.text,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, summary)
		values[row[2]] = make("TextLabel", {
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.new(0.55, 0, 0, y),
			Size = UDim2.new(0.45, -12, 0, 26),
			Text = "-",
			TextColor3 = theme.text,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, summary)
		if index &lt; 4 then
			dividers[index] = make("Frame", {
				BackgroundColor3 = theme.border,
				BackgroundTransparency = 0.58,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(10, y + 25),
				Size = UDim2.new(1, -20, 0, 1),
			}, summary)
		end
	end
	return {
		frame = summary,
		values = values,
		labels = labels,
		dividers = dividers,
		icons = icons,
	}
end

