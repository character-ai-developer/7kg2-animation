		Text = "+",
	})
	styleGhostButton(transportExpandButton)
	createCorner(transportExpandButton, 7)

	local playbackButtons = {
		{"Prev Key", 16, "PreviousKey"},
		{"Play", 100, "Play"},
		{"Stop", 184, "Stop"},
		{"Bake", 268, nil},
		{"Next Key", 352, "NextKey"},
	}
	local buttonRefs = {}
	for _, data in ipairs(playbackButtons) do
		local button = create("TextButton", {
			Parent = transportCard,
			Position = UDim2.new(0, data[2], 0, 18),
			Size = UDim2.new(0, 74, 0, 36),
			Text = data[1],
		})
		if data[3] then
			UiHelpers.styleIconOnlyButton(button, data[3], Constants.THEME.PanelSoft, {
				iconSize = 22,
			})
		else
			styleGhostButton(button)
		end
		createCorner(button, 10)
		buttonRefs[data[1]] = button
	end

	local frameInput = create("TextBox", {
		Name = "FrameInput",
		Parent = transportCard,
		Position = UDim2.new(0, 368, 0, 18),
		Size = UDim2.new(0, 76, 0, 36),
		ClearTextOnFocus = false,
		Text = "0",
		PlaceholderText = "Frame",
	})
	styleInput(frameInput)
	createCorner(frameInput, 10)

	local durationInput = create("TextBox", {
		Name = "DurationInput",
		Parent = transportCard,
		Position = UDim2.new(0, 452, 0, 18),
		Size = UDim2.new(0, 96, 0, 36),
		ClearTextOnFocus = false,
		Text = tostring(Constants.DEFAULT_DURATION_FRAMES / Constants.DEFAULT_FPS),
		PlaceholderText = "Seconds",
	})
	styleInput(durationInput)
	createCorner(durationInput, 10)

	local moveLeftButton = create("TextButton", {
		Name = "MoveLeftButton",
		Parent = transportCard,
		Position = UDim2.new(0, 560, 0, 18),
		Size = UDim2.new(0, 44, 0, 36),
		Text = "&lt;",
	})
	styleGhostButton(moveLeftButton)
	createCorner(moveLeftButton, 10)

	local moveRightButton = create("TextButton", {
		Name = "MoveRightButton",
		Parent = transportCard,
		Position = UDim2.new(0, 610, 0, 18),
		Size = UDim2.new(0, 44, 0, 36),
		Text = "&gt;",
	})
	styleGhostButton(moveRightButton)
	createCorner(moveRightButton, 10)

	local captureButton = create("TextButton", {
		Name = "CaptureButton",
		Parent = transportCard,
		Position = UDim2.new(1, -300, 0, 18),
		Size = UDim2.new(0, 120, 0, 36),
		Text = "Add Keyframe",
	})
	styleTextButton(captureButton)
	createCorner(captureButton, 10)

	local multiSelectButton = create("TextButton", {
		Name = "MultiSelectButton",
		Parent = transportCard,
		Position = UDim2.new(1, -172, 0, 18),
		Size = UDim2.new(0, 120, 0, 36),
		Text = "Multi Select: Off",
	})
	styleGhostButton(multiSelectButton)
	createCorner(multiSelectButton, 10)

	local timelineCard = createCard(parent, UDim2.new(1, 0, 1, -488))
	timelineCard.Position = UDim2.new(0, 0, 0, 488)
	timelineCard.ClipsDescendants = true

	createSectionTitle(timelineCard, "Timeline").Position = UDim2.new(0, 16, 0, 12)
	local timelineCollapseButton = UiHelpers.createPanelCollapseButton(timelineCard)
	local timelineToolbar = create("Frame", {
		Parent = timelineCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 104, 0, 10),
		Size = UDim2.new(1, -120, 0, 34),
	})
	local addSelectedRigButton = create("TextButton", {
		Name = "AddSelectedRigButton",
		Parent = timelineToolbar,
		Position = UDim2.new(0, 0, 0, 2),
		Size = UDim2.new(0, 74, 0, 30),
		Text = "Add Rig",
	})
	styleTextButton(addSelectedRigButton)
	addSelectedRigButton.TextSize = 10
	createCorner(addSelectedRigButton, 9)

	local removeSelectedTrackButton = create("TextButton", {
		Name = "RemoveSelectedTrackButton",
		Parent = timelineToolbar,
		Position = UDim2.new(0, 82, 0, 2),
		Size = UDim2.new(0, 78, 0, 30),
		Text = "Remove",
	})
	styleGhostButton(removeSelectedTrackButton)
	removeSelectedTrackButton.BackgroundColor3 = Color3.fromRGB(91, 43, 56)
	removeSelectedTrackButton.TextSize = 10
	createCorner(removeSelectedTrackButton, 9)

	local compactPlayback = {
		{ buttonRefs["Prev Key"], 168, 70 },
		{ buttonRefs["Play"], 244, 58 },
		{ buttonRefs["Stop"], 308, 58 },
		{ buttonRefs["Bake"], 372, 58 },
		{ buttonRefs["Next Key"], 436, 70 },
	}
	for _, data in ipairs(compactPlayback) do
		local button = data[1]
		button.Parent = timelineToolbar
		button.Position = UDim2.new(0, data[2], 0, 2)
		button.Size = UDim2.new(0, data[3], 0, 30)
	end
	frameInput.Parent = timelineToolbar
	frameInput.Position = UDim2.new(0, 456, 0, 2)
	frameInput.Size = UDim2.new(0, 70, 0, 30)
	durationInput.Parent = timelineToolbar
	durationInput.Position = UDim2.new(0, 534, 0, 2)
	durationInput.Size = UDim2.new(0, 88, 0, 30)
	moveLeftButton.Parent = timelineToolbar
	moveLeftButton.Position = UDim2.new(0, 630, 0, 2)
	moveLeftButton.Size = UDim2.new(0, 38, 0, 30)
	moveRightButton.Parent = timelineToolbar
	moveRightButton.Position = UDim2.new(0, 674, 0, 2)
	moveRightButton.Size = UDim2.new(0, 38, 0, 30)
	captureButton.Parent = timelineToolbar
	captureButton.AnchorPoint = Vector2.new(1, 0)
	captureButton.Position = UDim2.new(1, -134, 0, 2)
	captureButton.Size = UDim2.new(0, 118, 0, 30)
	multiSelectButton.Parent = timelineToolbar
	multiSelectButton.AnchorPoint = Vector2.new(1, 0)
	multiSelectButton.Position = UDim2.new(1, -6, 0, 2)
	multiSelectButton.Size = UDim2.new(0, 120, 0, 30)

	local bakeTooltip = create("Frame", {
		Name = "BakePreviewTooltip",
		Parent = timelineCard,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.new(0, 360, 0, 48),
		Size = UDim2.new(0, 292, 0, 90),
		Visible = false,
		ZIndex = 170,
	})
	createCorner(bakeTooltip, 10)
	createStroke(bakeTooltip, Constants.THEME.Border, 1)
	create("TextLabel", {
		Parent = bakeTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Bake Preview",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 171,
	})
	create("TextLabel", {
		Parent = bakeTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 46),
		Font = Enum.Font.GothamSemibold,
		Text = "Prepares a fast playback cache so large animations preview more smoothly before you press Play.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.None,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 171,
	})

	local function showBakeTooltip()
		if not buttonRefs["Bake"] or not bakeTooltip.Parent then
			return
		end
		local cardAbs = timelineCard.AbsolutePosition
		local cardSize = timelineCard.AbsoluteSize
		local buttonAbs = buttonRefs["Bake"].AbsolutePosition
		local buttonSize = buttonRefs["Bake"].AbsoluteSize
		local width = bakeTooltip.AbsoluteSize.X &gt; 0 and bakeTooltip.AbsoluteSize.X or 292
		local height = bakeTooltip.AbsoluteSize.Y &gt; 0 and bakeTooltip.AbsoluteSize.Y or 74
		local x = buttonAbs.X - cardAbs.X
		local y = buttonAbs.Y - cardAbs.Y + buttonSize.Y + 8
		if y + height &gt; cardSize.Y - 8 then
			y = math.max(8, buttonAbs.Y - cardAbs.Y - height - 8)
		end
		x = math.clamp(x, 8, math.max(8, cardSize.X - width - 8))
		bakeTooltip.Position = UDim2.fromOffset(x, y)
		bakeTooltip.Visible = true
	end

	buttonRefs["Bake"].MouseEnter:Connect(showBakeTooltip)
	buttonRefs["Bake"].MouseMoved:Connect(showBakeTooltip)
	buttonRefs["Bake"].MouseLeave:Connect(function()
		bakeTooltip.Visible = false
	end)

	local bakeProgressOverlay = create("Frame", {
		Name = "BakeProgressOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 180,
	})
	local bakeProgressCard = create("Frame", {
		Parent = bakeProgressOverlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 430, 0, 142),
		ZIndex = 181,
	})
	applySectionSurface(bakeProgressCard)
	createCorner(bakeProgressCard, 14)
	createStroke(bakeProgressCard, Constants.THEME.Border, 1)
	local bakeProgressTitle = create("TextLabel", {
		Parent = bakeProgressCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 18),
		Size = UDim2.new(1, -36, 0, 22),
		Font = Enum.Font.GothamSemibold,
		Text = "Preparing Preview",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 182,
	})
	local bakeProgressDetail = create("TextLabel", {
		Parent = bakeProgressCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 46),
		Size = UDim2.new(1, -36, 0, 34),
		Font = Enum.Font.Gotham,
		Text = "Building optimized playback data...",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 182,
	})
	local bakeProgressTrack = create("Frame", {
		Parent = bakeProgressCard,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 1, -42),
		Size = UDim2.new(1, -36, 0, 12),
		ZIndex = 182,
	})
	createCorner(bakeProgressTrack, 6)
	local bakeProgressFill = create("Frame", {
		Parent = bakeProgressTrack,
		BackgroundColor3 = Constants.THEME.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 183,
	})
	createCorner(bakeProgressFill, 6)

	local timelineBody = nil
	local zoomOutButton = nil
	local zoomSlider = nil
	local zoomInButton = nil

	local function setToolbarButton(button, x, width, y, text, textSize)
		if not button then
			return
		end
		button.AnchorPoint = Vector2.new(0, 0)
		button.Position = UDim2.new(0, x, 0, y or 2)
		button.Size = UDim2.new(0, width, 0, 30)
		if button:GetAttribute("MegMoIconOnlyButton") == true then
			button.Text = ""
			UiHelpers.setButtonIcon(button, button:GetAttribute("MegMoButtonIconKey"), {
				iconOnly = true,
				size = math.clamp(math.floor((button.Size.Y.Offset &gt; 0 and button.Size.Y.Offset or 30) * 0.58), 18, 28),
			})
		elseif text then
			button.Text = text
		end
		button.TextSize = textSize or 10
	end

	local function setToolbarRightButton(button, rightOffset, width, y, text, textSize)
		if not button then
			return
		end
		button.AnchorPoint = Vector2.new(1, 0)
		button.Position = UDim2.new(1, -rightOffset, 0, y or 2)
		button.Size = UDim2.new(0, width, 0, 30)
		if button:GetAttribute("MegMoIconOnlyButton") == true then
			button.Text = ""
			UiHelpers.setButtonIcon(button, button:GetAttribute("MegMoButtonIconKey"), {
				iconOnly = true,
				size = math.clamp(math.floor((button.Size.Y.Offset &gt; 0 and button.Size.Y.Offset or 30) * 0.58), 18, 28),
			})
		elseif text then
			button.Text = text
		end
		button.TextSize = textSize or 10
	end

	local function applyToolbarResponsiveLayout()
		if not timelineBody then
			return
		end
		local cardWidth = timelineCard.AbsoluteSize.X
		if cardWidth &lt;= 0 then
			return
		end

		local compactCandidate = cardWidth &lt; 1120
		local tight = cardWidth &lt; 820
		local micro = cardWidth &lt; 660
		local toolbarLeft = compactCandidate and 16 or 104
		local toolbarRightInset = compactCandidate and 32 or 120
		local width = math.max(1, cardWidth - toolbarRightInset)

		local gap = tight and 5 or 8
		local textSize = tight and 9 or 10
		local rowOneY = 2
		local rowTwoY = 38
		local addRigWidth = micro and 54 or (tight and 62 or 74)
		local removeWidth = micro and 30 or (tight and 58 or 78)
		local prevWidth = micro and 34 or (tight and 50 or 70)
		local playWidth = micro and 42 or (tight and 48 or 58)
		local stopWidth = micro and 42 or (tight and 48 or 58)
		local bakeWidth = micro and 42 or (tight and 48 or 58)
		local nextWidth = micro and 34 or (tight and 50 or 70)
		local frameWidth = micro and 48 or (tight and 56 or 70)
		local durationWidth = micro and 56 or (tight and 68 or 88)
		local moveWidth = micro and 30 or 38
		local multiWidth = micro and 46 or (tight and 80 or 120)
		local keyWidth = micro and 74 or (tight and 98 or 118)
		local normalZoomWidth = 22 + 132 + 22 + 104
		local leftOneRowWidth = addRigWidth + removeWidth + prevWidth + playWidth + stopWidth + bakeWidth + nextWidth
			+ frameWidth + durationWidth + (moveWidth * 2) + (gap * 10)
		local rightOneRowWidth = keyWidth + multiWidth + normalZoomWidth + 8
		local twoRows = compactCandidate or (leftOneRowWidth + rightOneRowWidth &gt; width)
		local stackedActionRow = twoRows and cardWidth &lt; 920
		local compact = twoRows
		toolbarLeft = compact and 16 or 104
		toolbarRightInset = compact and 32 or 120
		width = math.max(1, cardWidth - toolbarRightInset)

		local x = 0
		local toolbarHeight = stackedActionRow and 104 or (twoRows and 68 or 34)
		local bodyTop = stackedActionRow and 148 or (twoRows and 112 or 54)
		timelineToolbar.Position = UDim2.new(0, toolbarLeft, 0, compact and 40 or 10)
		timelineToolbar.Size = UDim2.new(1, -toolbarRightInset, 0, toolbarHeight)
		timelineBody.Position = UDim2.new(0, 16, 0, bodyTop)
		timelineBody.Size = UDim2.new(1, -32, 1, -(bodyTop + 16))

		setToolbarButton(addSelectedRigButton, x, addRigWidth, rowOneY, micro and "+Rig" or "Add Rig", textSize)
		x += addRigWidth + gap
		setToolbarButton(removeSelectedTrackButton, x, removeWidth, rowOneY, micro and "-" or (tight and "Select" or "Remove"), textSize)
		x += removeWidth + gap

		setToolbarButton(buttonRefs["Prev Key"], x, prevWidth, rowOneY, micro and "|&lt;" or (tight and "Prev" or "Prev Key"), textSize)
		x += prevWidth + gap
		setToolbarButton(buttonRefs["Play"], x, playWidth, rowOneY, "Play", textSize)
		x += playWidth + gap
		setToolbarButton(buttonRefs["Stop"], x, stopWidth, rowOneY, "Stop", textSize)
		x += stopWidth + gap
		setToolbarButton(buttonRefs["Bake"], x, bakeWidth, rowOneY, "Bake", textSize)
		x += bakeWidth + gap
		setToolbarButton(buttonRefs["Next Key"], x, nextWidth, rowOneY, micro and "&gt;|" or (tight and "Next" or "Next Key"), textSize)
		x += nextWidth + gap

		local actionY = stackedActionRow and 74 or (twoRows and rowTwoY or rowOneY)
		local secondaryX = twoRows and 0 or x
		local actionRightOffset = compact and 42 or 30

		if not twoRows then
			setToolbarButton(frameInput, secondaryX, frameWidth, rowOneY, nil, textSize)
			secondaryX += frameWidth + gap
			setToolbarButton(durationInput, secondaryX, durationWidth, rowOneY, nil, textSize)
			secondaryX += durationWidth + gap
			setToolbarButton(moveLeftButton, secondaryX, micro and 30 or 38, rowOneY, "&lt;", textSize)
			secondaryX += (micro and 30 or 38) + gap
			setToolbarButton(moveRightButton, secondaryX, micro and 30 or 38, rowOneY, "&gt;", textSize)
		end

		setToolbarRightButton(multiSelectButton, actionRightOffset, multiWidth, actionY, micro and "Multi" or (tight and "Multi: Off" or "Multi Select: Off"), textSize)
		setToolbarRightButton(captureButton, actionRightOffset + multiWidth + 8, keyWidth, actionY, micro and "Key +" or "Add Keyframe", textSize)

		zoomOutButton.Visible = true
		zoomSlider.Visible = true
		zoomInButton.Visible = true
		if twoRows then
			local moveWidth = micro and 30 or 38
			local zoomSliderWidth = math.clamp(width - (multiWidth + keyWidth + frameWidth + durationWidth + (moveWidth * 2) + 250), 54, micro and 76 or 112)
			local zoomY = rowTwoY + 5
			zoomOutButton.AnchorPoint = Vector2.new(0, 0)
			zoomOutButton.Position = UDim2.new(0, secondaryX, 0, zoomY)
			zoomOutButton.Size = UDim2.new(0, 22, 0, 20)
			zoomSlider.AnchorPoint = Vector2.new(0, 0)
			zoomSlider.Position = UDim2.new(0, secondaryX + 28, 0, zoomY + 6)
			zoomSlider.Size = UDim2.new(0, zoomSliderWidth, 0, 8)
			zoomInButton.AnchorPoint = Vector2.new(0, 0)
			zoomInButton.Position = UDim2.new(0, secondaryX + 28 + zoomSliderWidth + 8, 0, zoomY)
			zoomInButton.Size = UDim2.new(0, 22, 0, 20)
			secondaryX += zoomSliderWidth + 62 + gap
			setToolbarButton(frameInput, secondaryX, frameWidth, rowTwoY, nil, textSize)
			secondaryX += frameWidth + gap
			setToolbarButton(durationInput, secondaryX, durationWidth, rowTwoY, nil, textSize)
			secondaryX += durationWidth + gap
			setToolbarButton(moveLeftButton, secondaryX, moveWidth, rowTwoY, "&lt;", textSize)
			secondaryX += moveWidth + gap
			setToolbarButton(moveRightButton, secondaryX, moveWidth, rowTwoY, "&gt;", textSize)
		else
			local zoomSliderWidth = 132
			local zoomY = 7
			local zoomRight = actionRightOffset + multiWidth + keyWidth + 58
			zoomInButton.AnchorPoint = Vector2.new(1, 0)
			zoomInButton.Position = UDim2.new(1, -zoomRight, 0, zoomY)
			zoomInButton.Size = UDim2.new(0, 22, 0, 20)
			zoomSlider.AnchorPoint = Vector2.new(1, 0)
			zoomSlider.Position = UDim2.new(1, -(zoomRight + 28), 0, zoomY + 6)
			zoomSlider.Size = UDim2.new(0, zoomSliderWidth, 0, 8)
			zoomOutButton.AnchorPoint = Vector2.new(1, 0)
			zoomOutButton.Position = UDim2.new(1, -(zoomRight + zoomSliderWidth + 56), 0, zoomY)
			zoomOutButton.Size = UDim2.new(0, 22, 0, 20)
		end
	end

	timelineBody = create("Frame", {
		Parent = timelineCard,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 16, 0, 54),
		Size = UDim2.new(1, -32, 1, -70),
	})
	applySectionSurface(timelineBody)
	createCorner(timelineBody, 12)
	createStroke(timelineBody)

	zoomOutButton = create("TextButton", {
		Parent = timelineBody,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 1, -32),
