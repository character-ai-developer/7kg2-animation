	Release = {
		name = "Release to Physics",
		accent = Color3.fromRGB(72, 214, 255),
		steps = {
			step("loadPath", "Put the playhead on Detach", "Move the playhead to the moment the object leaves the hand. Then press Load Detach event from 7kg2."),
			step("selectButton", "Check the held object", "7kg2 normally finds the held object for you. If it finds the wrong one, select the correct prop and use the object button."),
			step("setupContinue", "Review the release", "Leave Collisions ON if the prop should hit floors, walls or other objects. Then continue to Capture."),
			step("run", "Capture the fall", "Press Simulate &amp; Capture. 7kg2 will release the prop and record where it moves.", "Capture"),
			step("continueBake", "Preview it", "Press Preview Take and watch the result. If it looks right, continue to Bake.", "Capture", { "preview", "continueBake" }),
			step("import", "Bake to the timeline", "Press Bake to Timeline. The prop movement becomes editable 7kg2 keyframes.", "Bake", { "preview", "import" }),
		},
	},
	Drop = {
		name = "Drop or bounce",
