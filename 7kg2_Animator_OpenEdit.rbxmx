		local function positionMicroTrackToolsMenu(anchorGui)
			if not anchorGui or not anchorGui.Parent then
				return
			end
			microTrackToolsMenu.Position = UDim2.fromOffset(
				anchorGui.AbsolutePosition.X,
				anchorGui.AbsolutePosition.Y + anchorGui.AbsoluteSize.Y + 4
			)
