        <Item class="ModuleScript" referent="RBX60">
          <Properties>
            <string name="Name">ColorPickerPopup</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local ColorPickerPopup = {}

local UserInputService = game:GetService("UserInputService")

local create = UiHelpers.create
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton

local DEFAULT_Z_INDEX = 180

local function trim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function colorLuminance(color)
	return (color.R * 0.299) + (color.G * 0.587) + (color.B * 0.114)
end

local function colorToHex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function colorToRgbText(color)
	return string.format(
		"%d,%d,%d",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function parseColorText(text, fallback)
	local raw = trim(text)
	local hex = raw:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		return Color3.fromRGB(
			tonumber(hex:sub(1, 2), 16),
			tonumber(hex:sub(3, 4), 16),
			tonumber(hex:sub(5, 6), 16)
		)
	end

	local values = {}
	for token in raw:gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value then
			table.insert(values, value)
		end
	end

	if #values &gt;= 3 then
		if values[1] &lt;= 1 and values[2] &lt;= 1 and values[3] &lt;= 1 then
			return Color3.new(
				math.clamp(values[1], 0, 1),
				math.clamp(values[2], 0, 1),
				math.clamp(values[3], 0, 1)
			)
		end

		return Color3.fromRGB(
			math.clamp(math.floor(values[1] + 0.5), 0, 255),
			math.clamp(math.floor(values[2] + 0.5), 0, 255),
			math.clamp(math.floor(values[3] + 0.5), 0, 255)
		)
	end

	return fallback or Color3.fromRGB(255, 255, 255)
end

local function setGuiTreeZIndex(root, zIndex)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex = math.max(descendant.ZIndex, zIndex)
		end
	end
end

local function makePreviewCard(parent, labelText, color, transparency, orderNumber, zIndex)
	local container = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		LayoutOrder = orderNumber,
		Size = UDim2.new(1, 0, 0, 82),
		ZIndex = zIndex,
	})
	createCorner(container, 9)

	create("TextLabel", {
		Parent = container,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 0, 16),
		Text = labelText,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zIndex + 1,
	})

	local preview = create("Frame", {
		Parent = container,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 26),
		Size = UDim2.new(1, -16, 0, 46),
		ZIndex = zIndex + 1,
	})
	createCorner(preview, 7)
	createStroke(preview, Constants.THEME.Border, 1)

	local colorFrame = create("Frame", {
		Parent = preview,
		BackgroundColor3 = color,
		BackgroundTransparency = transparency or 0,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = zIndex + 2,
	})
	createCorner(colorFrame, 7)

	return colorFrame
end

local function makeSwatch(parent, color, order, zIndex, chooseColor)
	local swatch = create("TextButton", {
		Parent = parent,
		AutoButtonColor = true,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Text = "",
		ZIndex = zIndex,
	})
	createCorner(swatch, 5)
	createStroke(swatch, Constants.THEME.Text, colorLuminance(color) &gt; 0.48 and 0.55 or 0.76)
	swatch.Activated:Connect(function()
		chooseColor(color)
	end)
	return swatch
end

function ColorPickerPopup.formatColor(color)
	if typeof(color) ~= "Color3" then
		return ""
	end
	return colorToRgbText(color)
end

function ColorPickerPopup.parseColor(text, fallback)
	return parseColorText(text, fallback)
end

function ColorPickerPopup.open(parent, options)
	options = options or {}
	if not parent then
		return nil
	end

	local zIndex = tonumber(options.zIndex) or DEFAULT_Z_INDEX
	local showTransparency = options.showTransparency == true
	local selectedColor = typeof(options.initialColor) == "Color3" and options.initialColor or Color3.fromRGB(255, 255, 255)
	local selectedTransparency = math.clamp(tonumber(options.initialTransparency) or 0, 0, 1)

	local overlay = create("TextButton", {
		Name = "ColorPickerOverlay",
		Parent = parent,
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = options.backdropTransparency ~= nil and options.backdropTransparency or 1,
		BorderSizePixel = 0,
		Text = "",
		TextTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = zIndex,
	})
	require(script.Parent.Parent:WaitForChild("ModalOverlaySupport")).applyToOverlay(overlay)

	local panelHeight = showTransparency and 430 or 374
	local panel = create("Frame", {
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, panelHeight),
		ZIndex = zIndex + 1,
	})
	createCorner(panel, 12)
	createStroke(panel, Constants.THEME.Accent, 1)
	create("UIPadding", {
		Parent = panel,
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	})
	create("UIListLayout", {
		Parent = panel,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	create("TextLabel", {
		Parent = panel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 22),
		Text = options.title or "Select Color",
		TextColor3 = Constants.THEME.Text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zIndex + 2,
	})

	create("TextLabel", {
		Parent = panel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 28),
		Text = options.description or "Pick a color, or type RGB like 255,0,0 / hex like #ff0000.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zIndex + 2,
	})

	local inputBox, newPreview, transparencyFill, transparencyKnob, transparencyText
	local function runPreview()
		if type(options.onPreview) == "function" then
			options.onPreview(selectedColor, selectedTransparency)
		end
	end
	local function updatePreview(shouldRunPreview)
		if newPreview then
			newPreview.BackgroundColor3 = selectedColor
			newPreview.BackgroundTransparency = selectedTransparency
		end
		if inputBox and inputBox:IsFocused() == false then
			inputBox.Text = colorToHex(selectedColor)
		end
		if transparencyFill then
			transparencyFill.Size = UDim2.fromScale(selectedTransparency, 1)
		end
		if transparencyKnob then
			transparencyKnob.Position = UDim2.fromScale(selectedTransparency, 0.5)
		end
		if transparencyText then
			transparencyText.Text = tostring(math.floor(selectedTransparency * 100 + 0.5)) .. "%"
		end
		if shouldRunPreview then
			runPreview()
		end
	end

	local body = create("Frame", {
		Parent = panel,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 220),
		ZIndex = zIndex + 2,
	})
	create("UIListLayout", {
		Parent = body,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local pickerColumn = create("Frame", {
		Parent = body,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Size = UDim2.new(1, -132, 1, 0),
		ZIndex = zIndex + 2,
	})
	createCorner(pickerColumn, 10)
	create("UIPadding", {
		Parent = pickerColumn,
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	create("UIListLayout", {
		Parent = pickerColumn,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local function chooseColor(color)
		selectedColor = color
		updatePreview(true)
	end

	local colorGrid = create("Frame", {
		Parent = pickerColumn,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 132),
		ZIndex = zIndex + 2,
	})
	create("UIGridLayout", {
		Parent = colorGrid,
		CellPadding = UDim2.fromOffset(4, 4),
		CellSize = UDim2.fromOffset(22, 18),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local order = 0
	for valueIndex = 0, 5 do
		local value = 1 - (valueIndex * 0.1)
		local saturation = math.clamp(1 - (valueIndex * 0.05), 0.35, 1)
		for hueIndex = 0, 11 do
			order += 1
			makeSwatch(colorGrid, Color3.fromHSV(hueIndex / 12, saturation, value), order, zIndex + 3, chooseColor)
		end
	end

	local greyGrid = create("Frame", {
		Parent = pickerColumn,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 24),
		ZIndex = zIndex + 2,
	})
	create("UIGridLayout", {
		Parent = greyGrid,
		CellPadding = UDim2.fromOffset(4, 4),
		CellSize = UDim2.fromOffset(22, 18),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	for greyIndex = 0, 11 do
		local level = math.floor((greyIndex / 11) * 255 + 0.5)
		makeSwatch(greyGrid, Color3.fromRGB(level, level, level), greyIndex + 1, zIndex + 3, chooseColor)
	end

	inputBox = create("TextBox", {
		Parent = pickerColumn,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = 3,
		PlaceholderText = "#ffffff or 255,255,255",
		Size = UDim2.new(1, 0, 0, 30),
		Text = colorToHex(selectedColor),
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zIndex + 3,
	})
	createCorner(inputBox, 8)
	createStroke(inputBox, Constants.THEME.Border, 1)
	create("UIPadding", {
		Parent = inputBox,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	inputBox.FocusLost:Connect(function()
		selectedColor = parseColorText(inputBox.Text, selectedColor)
		updatePreview(true)
	end)

	local previewColumn = create("Frame", {
		Parent = body,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Size = UDim2.fromOffset(118, 220),
		ZIndex = zIndex + 2,
	})
	create("UIListLayout", {
		Parent = previewColumn,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	makePreviewCard(previewColumn, "Current", selectedColor, selectedTransparency, 1, zIndex + 2)
	newPreview = makePreviewCard(previewColumn, "New", selectedColor, selectedTransparency, 2, zIndex + 2)

	if showTransparency then
		local transparencyRow = create("Frame", {
			Parent = panel,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			LayoutOrder = 4,
			Size = UDim2.new(1, 0, 0, 46),
			ZIndex = zIndex + 2,
		})
		createCorner(transparencyRow, 9)
		create("TextLabel", {
			Parent = transparencyRow,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.fromOffset(120, 16),
			Text = "Transparency",
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = zIndex + 3,
		})
		transparencyText = create("TextLabel", {
			Parent = transparencyRow,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.new(1, -54, 0, 6),
			Size = UDim2.fromOffset(44, 16),
			Text = "0%",
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = zIndex + 3,
		})

		local transparencyHotspot = create("TextButton", {
			Parent = transparencyRow,
			Active = true,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(10, 26),
			Size = UDim2.new(1, -20, 0, 18),
			Text = "",
			ZIndex = zIndex + 3,
		})
		local transparencyTrack = create("Frame", {
			Parent = transparencyHotspot,
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.fromRGB(48, 55, 74),
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, 5),
			ZIndex = zIndex + 3,
		})
		createCorner(transparencyTrack, 4)
		transparencyFill = create("Frame", {
			Parent = transparencyTrack,
			BackgroundColor3 = Constants.THEME.Accent,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(selectedTransparency, 1),
			ZIndex = zIndex + 4,
		})
		createCorner(transparencyFill, 4)
		transparencyKnob = create("Frame", {
			Parent = transparencyHotspot,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Constants.THEME.Accent,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(selectedTransparency, 0.5),
			Size = UDim2.fromOffset(13, 13),
			ZIndex = zIndex + 5,
		})
		createCorner(transparencyKnob, 13)

		local draggingTransparency = false
		local function setTransparencyFromX(x)
			local width = math.max(1, transparencyHotspot.AbsoluteSize.X)
			selectedTransparency = math.clamp((x - transparencyHotspot.AbsolutePosition.X) / width, 0, 1)
			updatePreview(true)
		end
		transparencyHotspot.MouseButton1Down:Connect(function(x)
			draggingTransparency = true
			setTransparencyFromX(tonumber(x) or UserInputService:GetMouseLocation().X)
		end)
		transparencyHotspot.MouseButton1Up:Connect(function()
			draggingTransparency = false
		end)
		transparencyHotspot.MouseMoved:Connect(function(x)
			if draggingTransparency then
				setTransparencyFromX(x)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if draggingTransparency and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				setTransparencyFromX(input.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				draggingTransparency = false
			end
		end)
	end

	local buttonRow = create("Frame", {
		Parent = panel,
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Size = UDim2.new(1, 0, 0, 34),
		ZIndex = zIndex + 2,
	})
	create("UIListLayout", {
		Parent = buttonRow,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local okButton = create("TextButton", {
		Parent = buttonRow,
		LayoutOrder = 1,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = options.applyText or "Use Color",
		ZIndex = zIndex + 2,
	})
	styleTextButton(okButton, Constants.THEME.Accent)
	createCorner(okButton, 9)

	local cancelButton = create("TextButton", {
		Parent = buttonRow,
		LayoutOrder = 2,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Cancel",
		ZIndex = zIndex + 2,
	})
	styleGhostButton(cancelButton)
	createCorner(cancelButton, 9)

	okButton.Activated:Connect(function()
		selectedColor = parseColorText(inputBox.Text, selectedColor)
		if type(options.onApply) == "function" then
			options.onApply(selectedColor, selectedTransparency)
		end
		overlay:Destroy()
	end)
	cancelButton.Activated:Connect(function()
		if type(options.onCancel) == "function" then
			options.onCancel()
		end
		overlay:Destroy()
	end)

	setGuiTreeZIndex(overlay, zIndex)
	updatePreview(false)
	return overlay
end

return ColorPickerPopup
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX61">
          <Properties>
            <string name="Name">CustomThemeUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local CustomThemeUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local CUSTOM_THEME_ROLES = {
	{ key = "Background", text = "Background", hint = "Main editor surface" },
	{ key = "Panel", text = "Panels", hint = "Cards and tool panels" },
	{ key = "Accent", text = "Accent", hint = "Buttons and highlights" },
}

local CUSTOM_THEME_PALETTES = {
	Background = {
		Color3.fromRGB(6, 10, 18),
		Color3.fromRGB(12, 15, 22),
		Color3.fromRGB(18, 24, 36),
		Color3.fromRGB(9, 24, 32),
		Color3.fromRGB(13, 31, 26),
		Color3.fromRGB(24, 15, 24),
		Color3.fromRGB(29, 20, 14),
		Color3.fromRGB(34, 36, 42),
		Color3.fromRGB(62, 68, 78),
		Color3.fromRGB(196, 201, 210),
		Color3.fromRGB(224, 227, 233),
		Color3.fromRGB(238, 235, 226),
	},
	Panel = {
		Color3.fromRGB(16, 21, 31),
		Color3.fromRGB(23, 28, 39),
		Color3.fromRGB(28, 37, 52),
		Color3.fromRGB(19, 42, 54),
		Color3.fromRGB(22, 49, 40),
		Color3.fromRGB(43, 31, 53),
		Color3.fromRGB(51, 34, 24),
		Color3.fromRGB(45, 49, 58),
		Color3.fromRGB(84, 92, 106),
		Color3.fromRGB(211, 216, 225),
		Color3.fromRGB(235, 238, 244),
		Color3.fromRGB(232, 224, 214),
	},
	Accent = {
		Color3.fromRGB(124, 92, 210),
		Color3.fromRGB(150, 105, 220),
		Color3.fromRGB(68, 150, 210),
		Color3.fromRGB(64, 176, 204),
		Color3.fromRGB(62, 170, 150),
		Color3.fromRGB(82, 175, 116),
		Color3.fromRGB(210, 170, 75),
		Color3.fromRGB(206, 130, 66),
		Color3.fromRGB(210, 98, 92),
		Color3.fromRGB(205, 92, 130),
		Color3.fromRGB(185, 85, 165),
		Color3.fromRGB(120, 140, 170),
	},
}

local function makeLabel(parent, text, y, size, color)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 20, 0, y),
		Size = size or UDim2.new(1, -40, 0, 18),
		Text = text,
		TextColor3 = color or Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		ZIndex = 172,
	})
end

function CustomThemeUI.mount(parent, _context)
	if not parent then
		error("CustomThemeUI.mount requires parent")
	end

	local refs = {
		_customThemeSwatches = {},
	}

	local overlay = create("Frame", {
		Name = "CustomThemeOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.24,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 168,
	})

	local card = create("Frame", {
		Name = "CustomThemeCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 680, 0, 360),
		ZIndex = 169,
	})
	applySectionSurface(card)
	createCorner(card, 16)
	createStroke(card)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 20, 0, 18),
		Size = UDim2.new(1, -78, 0, 24),
		Text = "Custom Theme",
		TextColor3 = Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 170,
	})

	makeLabel(
		card,
		"Choose calmer colors for the editor, then save them as your custom theme.",
		46,
		UDim2.new(1, -40, 0, 18)
	)

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.new(0, 34, 0, 30),
		Text = "x",
		ZIndex = 171,
	})
	styleGhostButton(closeButton)
	createCorner(closeButton, 9)

	local preview = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.Background,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 20, 0, 76),
		Size = UDim2.new(0, 178, 0, 178),
		ZIndex = 170,
	})
	applySectionSurface(preview)
	createCorner(preview, 14)
	createStroke(preview)
	local previewPanel = create("Frame", {
		Parent = preview,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 18, 0, 20),
		Size = UDim2.new(1, -36, 0, 96),
		ZIndex = 171,
	})
	applySectionSurface(previewPanel)
	createCorner(previewPanel, 12)
	createStroke(previewPanel)
	local previewAccent = create("Frame", {
		Parent = previewPanel,
		BackgroundColor3 = Constants.THEME.Accent,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0, 16),
		Size = UDim2.new(0, 62, 0, 20),
		ZIndex = 172,
	})
	createCorner(previewAccent, 7)
	local previewText = create("TextLabel", {
		Parent = previewPanel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 14, 0, 50),
		Size = UDim2.new(1, -28, 0, 18),
		Text = "Preview",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 172,
	})
	makeLabel(preview, "Saved custom colors are restored next time Studio opens.", 128, UDim2.new(1, -28, 0, 38))

	local palettePanel = create("Frame", {
		Parent = card,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 220, 0, 76),
		Size = UDim2.new(1, -240, 0, 178),
		ZIndex = 170,
	})

	for roleIndex, role in ipairs(CUSTOM_THEME_ROLES) do
		local rowY = (roleIndex - 1) * 58
		create("TextLabel", {
			Parent = palettePanel,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.new(0, 0, 0, rowY),
			Size = UDim2.new(0, 112, 0, 18),
			Text = role.text,
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 171,
		})
		create("TextLabel", {
			Parent = palettePanel,
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Position = UDim2.new(0, 112, 0, rowY),
			Size = UDim2.new(1, -112, 0, 18),
			Text = role.hint,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 171,
		})
		local paletteRow = create("Frame", {
			Parent = palettePanel,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 0, 0, rowY + 24),
			Size = UDim2.new(1, 0, 0, 28),
			ZIndex = 171,
		})
		create("UIListLayout", {
			Parent = paletteRow,
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		for colorIndex, color in ipairs(CUSTOM_THEME_PALETTES[role.key]) do
			local swatch = create("TextButton", {
				Parent = paletteRow,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				LayoutOrder = colorIndex,
				Size = UDim2.new(0, 24, 0, 24),
				Text = "",
				ZIndex = 172,
			})
			swatch:SetAttribute("MegMoPreserveColor", true)
			createCorner(swatch, 7)
			createStroke(swatch, Constants.THEME.Border, 1)
			table.insert(refs._customThemeSwatches, {
				button = swatch,
				role = role.key,
				color = color,
			})
		end
	end

	local statusLabel = makeLabel(card, "Choose one or more colors, then click Save Custom Theme.", 272, UDim2.new(1, -40, 0, 32))

	local cancelButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0, 20, 1, -54),
		Size = UDim2.new(0.5, -30, 0, 36),
		Text = "Cancel",
		ZIndex = 171,
	})
	styleGhostButton(cancelButton)
	createCorner(cancelButton, 10)
	local saveButton = create("TextButton", {
		Parent = card,
		Position = UDim2.new(0.5, 10, 1, -54),
		Size = UDim2.new(0.5, -30, 0, 36),
		Text = "Save Custom Theme",
		ZIndex = 171,
	})
	styleTextButton(saveButton, Constants.THEME.Accent)
	createCorner(saveButton, 10)

	refs._customThemeOverlay = overlay
	refs._customThemeCard = card
	refs._customThemeCloseButton = closeButton
	refs._customThemeCancelButton = cancelButton
	refs._customThemeSaveButton = saveButton
	refs._customThemeStatusLabel = statusLabel
	refs._customThemePreview = preview
	refs._customThemePreviewPanel = previewPanel
	refs._customThemePreviewAccent = previewAccent
	refs._customThemePreviewText = previewText

	return refs
end

function CustomThemeUI.update(_context)
end

function CustomThemeUI.destroy()
end

return CustomThemeUI
