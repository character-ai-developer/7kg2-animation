	self:_connect(self._confirmRemoveButton.Activated, function()
		local confirmMode = self._confirmMode
		local trackPath = self._pendingRemoveTrackPath
		self:_hideRemoveConfirmation()
		if confirmMode == "RigPartHighlight" then
			if callbacks.onToggleRigPartHighlight then
				callbacks.onToggleRigPartHighlight()
			end
			self:_focusShortcutCapture("Shortcut capture: active after highlight toggle")
			return
		end
		if callbacks.onRemoveTrackPath and trackPath then
			callbacks.onRemoveTrackPath(trackPath)
		elseif callbacks.onRemoveSelectedTrack then
			callbacks.onRemoveSelectedTrack()
		end
		self:_focusShortcutCapture("Shortcut capture: active after removing track")
	end)

