	refs._soundKeyframeEditorStopButton = testButton
	refs._soundKeyframeEditorTestButton = previewButton
	refs._soundKeyframeEditorItemLabel = itemLabel
	refs._soundKeyframeEditorHelpLabel = helpLabel
	refs._soundKeyframeEditorInputs = inputs
	refs._soundKeyframeEditorNoteLabel = noteLabel

	return refs
end

