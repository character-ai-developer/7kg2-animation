		local microAddTrackOptions = {
			{ id = "Rig", label = "Add Selected Rig" },
			{ id = "Camera", label = "Camera" },
			{ id = "Object", label = "Object" },
			{ id = "Model", label = "Model" },
			{ id = "Sound", label = "Sound" },
			{ id = "EmitterGroup", label = "Emitter Group" },
			{ id = "Lighting", label = "Lighting", lightingEffectType = "Lighting" },
			{ id = "Folder", label = "Folder" },
			{ id = "RigCFrame", label = "Rig CFrame" },
			{ id = "Event", label = "Event" },
			{ id = "__remove__", label = "Remove Selected" },
		}

		local function rebuildMicroAddTrackMenu()
			for _, child in ipairs(microAddTrackMenu:GetChildren()) do
				if child:IsA("TextButton") or child:IsA("TextLabel") then
					child:Destroy()
				end
			end
			local y = 6
			for _, option in ipairs(microAddTrackOptions) do
				local optionButton = make("TextButton", {
					Name = tostring(option.id) .. "Option",
					AutoButtonColor = true,
					BackgroundColor3 = theme().PanelSoft,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamSemibold,
					Position = UDim2.fromOffset(6, y),
					Size = UDim2.new(1, -14, 0, 20),
					Text = option.label,
					TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
					TextSize = 11,
					TextTruncate = Enum.TextTruncate.None,
					TextWrapped = false,
					ZIndex = 41,
				}, microAddTrackMenu)
				setBackgroundRole(optionButton, "PanelSoft")
				setTextRole(optionButton, "Text")
				corner(optionButton, 5)
				stroke(optionButton, theme().Accent, 0.28, 1, "Accent")
				optionButton.MouseButton1Click:Connect(function()
					closeMicroAddTrackMenu()
					MicroWidgetController._armMicroTimelineOwnership(options, plugin, statusLabel, "Micro timeline shortcuts active.")
					if option.id == "Rig" then
						MicroWidgetController._runBindRig(options)
					elseif option.id == "__remove__" then
						runOption(options, "onRemoveSelectedTrack", "removeSelectedTrack")
					elseif option.lightingEffectType then
						local didRun = runOption(options, "onAddLightingEffectTrack", "addLightingEffectTrack", option.lightingEffectType)
						if not didRun then
							runOption(options, "onAddTrack", "addTrack", option.lightingEffectType)
						end
					else
						runOption(options, "onAddTrack", "addTrack", option.id)
					end
					miniTimelineSignature = nil
					refresh()
				end)
				y += 24
			end
			microAddTrackMenu.CanvasSize = UDim2.fromOffset(0, y + 6)
		end

		rebuildMicroAddTrackMenu()

		local microRigOptions = {
			{ id = "BindSelected", label = "Add Selected Rig" },
			{ id = "InsertR6", label = "Insert R6" },
			{ id = "InsertR15Classic", label = "Insert R15 Classic" },
			{ id = "InsertR15Modern", label = "Insert R15 Modern" },
			{ id = "InsertAvatar", label = "Insert Avatar..." },
		}

		local function rebuildMicroRigMenu()
			for _, child in ipairs(microRigMenu:GetChildren()) do
				if child:IsA("TextButton") or child:IsA("TextLabel") then
					child:Destroy()
				end
			end
			local y = 8
			for _, option in ipairs(microRigOptions) do
				local optionButton = make("TextButton", {
					Name = tostring(option.id) .. "Option",
					AutoButtonColor = true,
					BackgroundColor3 = theme().PanelSoft,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamSemibold,
					Position = UDim2.fromOffset(8, y),
					Size = UDim2.new(1, -16, 0, 20),
					Text = option.label,
					TextColor3 = ThemeService.getReadableTextColor(theme().PanelSoft),
					TextSize = 11,
					TextTruncate = Enum.TextTruncate.None,
					TextWrapped = false,
					ZIndex = 61,
				}, microRigMenu)
				setBackgroundRole(optionButton, "PanelSoft")
				setTextRole(optionButton, "Text")
				corner(optionButton, 5)
				stroke(optionButton, theme().Accent, 0.28, 1, "Accent")
				optionButton.MouseButton1Click:Connect(function()
					closeMicroRigMenu()
					if option.id == "BindSelected" then
						local success, message = MicroWidgetController._runBindRig(options)
						if statusLabel then
							statusLabel.Text = tostring(message or (success and "Added selected rig." or "Select a rig in Workspace first."))
						end
					elseif option.id == "InsertR6" then
						local _, message = safeCall(options.onInsertDefaultRig, "R6")
						if statusLabel then
							statusLabel.Text = tostring(message or "Inserted R6 rig.")
						end
					elseif option.id == "InsertR15Classic" then
						local _, message = safeCall(options.onInsertDefaultRig, "R15", "Classic")
						if statusLabel then
							statusLabel.Text = tostring(message or "Inserted R15 Classic rig.")
						end
					elseif option.id == "InsertR15Modern" then
						local _, message = safeCall(options.onInsertDefaultRig, "R15", "Modern")
						if statusLabel then
							statusLabel.Text = tostring(message or "Inserted R15 Modern rig.")
						end
					elseif option.id == "InsertAvatar" then
						showMicroAvatarImportDialog()
					end
					miniTimelineSignature = nil
					refresh()
				end)
				y += 24
			end
			microRigMenu.Size = UDim2.fromOffset(180, y + 8)
		end

		rebuildMicroRigMenu()

		local function renderMicroTrackToolsMenu(anchorGui, titleText, buildRows)
			clearGuiChildren(microTrackToolsMenu)
			local y = 6
			local function addMenuButton(label, callback, color)
				local optionButton = make("TextButton", {
					Name = tostring(label):gsub("%W+", "") .. "Option",
					AutoButtonColor = true,
					BackgroundColor3 = color or theme().PanelSoft,
					BorderSizePixel = 0,
					Font = Enum.Font.GothamMedium,
					Position = UDim2.fromOffset(6, y),
					Size = UDim2.new(1, -12, 0, 22),
					Text = tostring(label),
					TextColor3 = ThemeService.getReadableTextColor(color or theme().PanelSoft),
					TextSize = 11,
					ZIndex = 71,
				}, microTrackToolsMenu)
				optionButton:SetAttribute("MegMoThemeBackgroundRole", color and nil or "PanelSoft")
				corner(optionButton, 6)
				optionButton.MouseButton1Click:Connect(function()
					closeMicroTrackToolsMenu()
					callback()
				end)
				y += 26
			end
			local function addSpacer(height)
				y += height or 4
			end
			if titleText then
				text(microTrackToolsMenu, {
					Name = "Title",
					Text = tostring(titleText),
					TextColor3 = theme().MutedText,
					TextSize = 10,
					Font = Enum.Font.GothamMedium,
					Position = UDim2.fromOffset(8, y),
					Size = UDim2.new(1, -16, 0, 14),
					ZIndex = 71,
				})
				y += 18
			end
			buildRows(addMenuButton, addSpacer)
			microTrackToolsMenu.CanvasSize = UDim2.fromOffset(0, y + 6)
			microTrackToolsMenu.Size = UDim2.fromOffset(220, math.clamp(y + 6, 64, 260))
			positionMicroTrackToolsMenu(anchorGui)
			microTrackToolsMenu.Visible = true
		end

		addTrackMicroButton.MouseButton1Click:Connect(function()
			if not microAddTrackMenu:FindFirstChild("RigOption") then
				rebuildMicroAddTrackMenu()
			end
			closeMicroRigMenu()
			closeMicroTrackToolsMenu()
			positionMicroAddTrackMenu()
			microAddTrackMenu.Visible = not microAddTrackMenu.Visible
		end)
		loopMicroButton.MouseButton1Click:Connect(function()
			closeMicroAddTrackMenu()
			closeMicroRigMenu()
			closeMicroTrackToolsMenu()
			local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
			if timeline and type(timeline.setLooping) == "function" and type(timeline.getLooping) == "function" then
				local nextLooping = not timeline:getLooping()
				local ok = runOption(options, "onLoopingChanged", "loopingChanged", nextLooping)
				if not ok then
					timeline:setLooping(nextLooping)
				end
				miniTimelineSignature = nil
				refresh()
			end
		end)
		settingsMicroButton.MouseButton1Click:Connect(function()
			closeMicroAddTrackMenu()
			closeMicroRigMenu()
			renderMicroTrackToolsMenu(settingsMicroButton, "Timeline Tools", function(addMenuButton, addSpacer)
				local selectedPaths = type(options.getSelectedTrackPaths) == "function" and (options.getSelectedTrackPaths() or {}) or {}
				addMenuButton("Group Selected Keys", function()
					local success, _, groupId = safeCall(options.onGroupKeys)
					if success and groupId ~= nil then
						microUiHost._selectedMicroGroupIds = { groupId }
						options._microSelectedGroupIds = { groupId }
					end
					miniTimelineSignature = nil
					refresh()
				end)
				addMenuButton("Ungroup Selected Keys", function()
					microUiHost._selectedMicroGroupIds = nil
					options._microSelectedGroupIds = nil
					safeCall(options.onUngroupKeys)
					miniTimelineSignature = nil
					refresh()
				end)
				addMenuButton("Stretch Group Block", function()
					safeCall(options.onSetSelectedGroupEditMode, "Stretch", require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).getSelectedGroupIdsFromViewModel(
						microUiHost._lastViewModel or buildMicroEditorViewModel(type(options.getTimeline) == "function" and options.getTimeline() or nil),
						microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
					))
					miniTimelineSignature = nil
					refresh()
				end)
				addMenuButton("Repeat Group Block", function()
					safeCall(options.onSetSelectedGroupEditMode, "Repeat", require(script.Parent.Parent:WaitForChild("MicroGroupOptionsSupport")).getSelectedGroupIdsFromViewModel(
						microUiHost._lastViewModel or buildMicroEditorViewModel(type(options.getTimeline) == "function" and options.getTimeline() or nil),
						microUiHost._selectedMicroGroupIds or options._microSelectedGroupIds
					))
					miniTimelineSignature = nil
					refresh()
				end)
				addMenuButton("Smooth Selected Keys", function()
					safeCall(options.onSmoothMotion, "Light")
					miniTimelineSignature = nil
					refresh()
				end)
				if type(options.onBakePreview) == "function" then
					addMenuButton("Bake Preview", function()
						safeCall(options.onBakePreview)
						miniTimelineSignature = nil
						refresh()
					end, theme().AccentSoft)
				end
				addSpacer(2)
				addMenuButton("Add Folder Track", function()
					runOption(options, "onAddTrack", "addTrack", "Folder")
					miniTimelineSignature = nil
					refresh()
				end)
				if #selectedPaths &gt; 0 then
					addMenuButton("New Folder + Move Selected", function()
						runOption(options, "onMoveSelectedTracksToFolder", "moveSelectedTracksToFolder", "__new__")
						miniTimelineSignature = nil
						refresh()
					end)
				end
				addMenuButton("Open Settings", function()
					if type(setMicroTab) == "function" then
						setMicroTab("Settings")
					else
						activeTab = "Settings"
					end
				end)
			end)
		end)

		local lanes = make("Frame", {
