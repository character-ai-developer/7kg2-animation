function WidgetController:_getMotionRecipeInputText()
	if not self._motionRecipeNameInput then
		return ""
	end

	return tostring(self._motionRecipeNameInput.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

function WidgetController:_showMotionRecipeOverlay(defaultName, captureFocus)
	require(script.Parent:WaitForChild("WidgetDialogStateSupport")).showMotionRecipeOverlay(self, defaultName, captureFocus)
end

function WidgetController:_hideMotionRecipeOverlay()
	require(script.Parent:WaitForChild("WidgetDialogStateSupport")).hideMotionRecipeOverlay(self)
end

function WidgetController:_renderMotionRecipeEntries(viewModel)
	require(script.Parent:WaitForChild("WidgetMotionRecipeSupport")).renderMotionRecipeEntries(self, viewModel, {
		create = create,
		createCorner = createCorner,
		createStroke = createStroke,
	})
end

function WidgetController:_usePresetEntryForCurrentPurpose(entry)
	if not entry then
		return false
	end

	local pickerMotion = tostring(self._motionDefaultPickerMotion or "")
	if pickerMotion ~= "" then
		self._motionDefaultPickerMotion = nil
		self._motionSegmentPickerKey = nil
		self._motionSegmentPickerLabel = nil
		self._lastPresetEntriesSignature = nil
		if self._callbacks and self._callbacks.onSetMotionDefaultClip then
			self._callbacks.onSetMotionDefaultClip(pickerMotion, tostring(entry.id or entry.numericId or ""))
		else
			self:_setShortcutHint("Default style picker is not connected yet.")
		end
		self:_setWorkspaceMode("Animate")
		self:_setShortcutHint("Set custom " .. pickerMotion .. " recipe default.")
		return true
	end

	local segmentPickerKey = tostring(self._motionSegmentPickerKey or "")
	if segmentPickerKey ~= "" then
		local segmentLabel = tostring(self._motionSegmentPickerLabel or "segment")
		local pauseIdlePrefix = "__pause_idle__:"
		local pauseIdleKey = segmentPickerKey:sub(1, #pauseIdlePrefix) == pauseIdlePrefix
			and segmentPickerKey:sub(#pauseIdlePrefix + 1)
			or nil
		self._motionSegmentPickerKey = nil
		self._motionSegmentPickerLabel = nil
		self._lastPresetEntriesSignature = nil
		if pauseIdleKey and self._callbacks and self._callbacks.onSetMotionSegmentPauseIdle then
			self._callbacks.onSetMotionSegmentPauseIdle(pauseIdleKey, tostring(entry.id or entry.numericId or ""))
		elseif self._callbacks and self._callbacks.onSetMotionSegmentClip then
			self._callbacks.onSetMotionSegmentClip(segmentPickerKey, tostring(entry.id or entry.numericId or ""))
		else
			self:_setShortcutHint("Segment style picker is not connected yet.")
		end
		self:_setWorkspaceMode("Animate")
		self:_setShortcutHint("Set custom " .. segmentLabel .. " style for this marker segment.")
		return true
	end

	if self._presetStatusLabel then
		self._presetStatusLabel.Text = "Importing " .. tostring(entry.name or entry.id) .. "..."
	end
	if self._callbacks and self._callbacks.onImportAnimationId then
		self._callbacks.onImportAnimationId(entry.id, entry.name, entry)
	end
	return true
end

function WidgetController:_showRigPropertyEditor(trackPath, rigName)
	if not self._rigPropertyEditorOverlay then
		return
	end

	self._activeRigPropertyTrackPath = trackPath
	self._activeRigPropertyMenuRigName = rigName
	self:_renderRigPropertyEditor()
	self._rigPropertyEditorOverlay.Visible = true
	self:_setShortcutHint("Edit item open: toggle rig properties, delete, or confirm")
end

function WidgetController:_hideRigPropertyEditor()
	if self._rigPropertyEditorOverlay then
		self._rigPropertyEditorOverlay.Visible = false
	end
	self._activeRigPropertyTrackPath = nil
	self._activeRigPropertyMenuRigName = nil
end

function WidgetController:_showEffectTrackEditor(trackPath)
	local activeFrame = nil
	for _, key in ipairs((self._lastViewModel and self._lastViewModel.selectedKeyValues) or {}) do
		if key.jointPath == trackPath then
			activeFrame = key.frame
			break
		end
	end
	ScreenEffectKeyframeEditorController.show(self, trackPath, activeFrame)
end

function WidgetController:_showCameraTrackEditor(trackPath)
	if not self._cameraTrackEditorOverlay then
		return
	end

	self._activeCameraTrackPath = trackPath
	self:_renderCameraTrackEditor()
