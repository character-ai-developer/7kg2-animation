refs.effectSetupPresentation = require(Modules:WaitForChild("EffectSetupPresentation")).new(refs, THEME, {
	onReleaseCollisionsChanged = function(enabled)
		if RunService:IsRunning() then
			setStatus("Stop the simulation before changing Release collisions.", THEME.yellow)
			return false
		end
		state.releaseCollisionsEnabled = enabled == true
		setStatus(
			state.releaseCollisionsEnabled
				and "Release collisions are on. The object will collide with the scene."
				or "Release collisions are off. The object will pass through scene geometry.",
			state.releaseCollisionsEnabled and THEME.green or THEME.yellow
		)
		updateUI()
		return true
	end,
	onDurationChanged = function(value)
		if RunService:IsRunning() then
			setStatus("Stop the simulation before changing the maximum duration.", THEME.yellow)
			return false
		end
		value = tonumber(value)
		if not value or value &lt; 0.1 or value &gt; 120 then
			setStatus("Maximum duration must be between 0.1 and 120 seconds.", THEME.yellow)
			return false
		end
		state.maxDuration = math.floor(value * 100 + 0.5) / 100
		setStatus(string.format("Maximum duration set to %.2f seconds.", state.maxDuration), THEME.green)
		updateUI()
		return true
	end,
	onValidationMessage = function(message)
		setStatus(message, THEME.yellow)
		updateUI()
	end,
})

