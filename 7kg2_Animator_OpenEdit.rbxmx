      <Item class="ModuleScript" referent="RBX140">
        <Properties>
          <string name="Name">GroupedKeySelectionSupport</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local GroupedKeySelectionSupport = {}

function GroupedKeySelectionSupport.toggleGroupedSelection(selectedKeys, groupKeys, jointPath, frame)
	local nextSelectedKeys = {}
	for keyId, value in pairs(selectedKeys or {}) do
		nextSelectedKeys[keyId] = {
			jointPath = value.jointPath,
			frame = value.frame,
		}
	end

	local shouldDeselect = true
	for _, key in ipairs(groupKeys or {}) do
		if not nextSelectedKeys[SelectionState.makeTrackKeyId(key.jointPath, key.frame)] then
			shouldDeselect = false
			break
		end
	end

	for _, key in ipairs(groupKeys or {}) do
		local groupedKeyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame)
		if shouldDeselect then
			nextSelectedKeys[groupedKeyId] = nil
		else
			nextSelectedKeys[groupedKeyId] = {
				jointPath = key.jointPath,
				frame = key.frame,
			}
		end
	end

	return nextSelectedKeys, shouldDeselect, frame, jointPath
end

function GroupedKeySelectionSupport.toggleSingleKey(selectedKeys, jointPath, frame)
	local nextSelectedKeys = {}
	for keyId, value in pairs(selectedKeys or {}) do
		nextSelectedKeys[keyId] = {
			jointPath = value.jointPath,
			frame = value.frame,
		}
	end

	local keyId = SelectionState.makeTrackKeyId(jointPath, frame)
	if nextSelectedKeys[keyId] then
		nextSelectedKeys[keyId] = nil
		return nextSelectedKeys, false
	end

	nextSelectedKeys[keyId] = {
		jointPath = jointPath,
		frame = math.max(0, math.floor(frame or 0)),
	}
	return nextSelectedKeys, true
end

return GroupedKeySelectionSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX141">
        <Properties>
          <string name="Name">IKPrototypeBridgeService</string>
          <ProtectedString name="Source">local IKPrototypeBridgeService = {}

local BRIDGE_EVENT_NAME = "MegMoIKPrototypeApplyPose"

local function getBridgeEvent(parent)
	if not parent then
		return nil
	end
	local event = parent:FindFirstChild(BRIDGE_EVENT_NAME)
	if event and event:IsA("BindableEvent") then
		event.Archivable = false
		return event
	end
	if event then
		event:Destroy()
	end
	event = Instance.new("BindableEvent")
	event.Name = BRIDGE_EVENT_NAME
	event.Archivable = false
	event.Parent = parent
	return event
end

local function matchesPayloadRig(track, payload)
	local rig = payload.rig
	if rig and track.rig then
		return track.rig == rig
	end
	local rigName = payload.rigName
	if rigName and track.rigName then
		return track.rigName == rigName
	end
	return true
end

function IKPrototypeBridgeService.attach(args)
	args = args or {}
	local timeline = args.timeline
	local refreshUi = args.refreshUi
	if not timeline then
		return nil
	end

	if IKPrototypeBridgeService._connection then
		IKPrototypeBridgeService._connection:Disconnect()
		IKPrototypeBridgeService._connection = nil
	end

	local event = getBridgeEvent(args.eventParent)
	if not event then
		if refreshUi then
			refreshUi("IK bridge could not start.")
		end
		return nil
	end
	event:SetAttribute("MegMoBridgeReady", true)

	IKPrototypeBridgeService._connection = event.Event:Connect(function(payload)
		if type(payload) ~= "table" or payload.source ~= "MegMoIKPrototype" then
			return
		end

		local entries = payload.entries
		if type(entries) ~= "table" or #entries == 0 then
			if refreshUi then
				refreshUi("IK prototype did not send any pose data.")
			end
			return
		end

		local frame = timeline:getCurrentFrame()
		local pending = {}
		for _, entry in ipairs(entries) do
			local path = entry and entry.path
			local value = entry and entry.value
			local track = path and timeline:getTrackByPath(path) or nil
			if track and track.trackType == "Rig" and typeof(value) == "CFrame" and matchesPayloadRig(track, payload) then
				table.insert(pending, {
					path = path,
					value = value,
				})
			end
		end

		if #pending == 0 then
			if refreshUi then
				refreshUi("No matching 7kg2 rig tracks were found. Add the IK rig to the 7kg2 timeline first.")
			end
			return
		end

		if args.pushUndo then
			args.pushUndo("Apply IK Prototype Pose")
		end
		if args.changeHistoryService then
			args.changeHistoryService:SetWaypoint("Before Apply IK Prototype Pose")
		end

		local changedKeys = {}
		local changedCount = 0
		for _, item in ipairs(pending) do
			local success = timeline:setTrackValueAtFrame(item.path, frame, item.value)
			if success then
				changedCount += 1
				table.insert(changedKeys, {
					jointPath = item.path,
					frame = frame,
				})
			end
		end

		if args.changeHistoryService then
			args.changeHistoryService:SetWaypoint("After Apply IK Prototype Pose")
		end

		if changedCount == 0 then
			if refreshUi then
				refreshUi("IK prototype pose could not be written to the timeline.")
			end
			return
		end

		if args.selectKeys then
			args.selectKeys(changedKeys)
		end
		if args.clearSelectedTracks then
			args.clearSelectedTracks()
		end
		if type(timeline.applyCurrentFrame) == "function" then
			timeline:applyCurrentFrame()
		end
		if refreshUi then
			refreshUi(string.format("Applied IK prototype pose to %d keyframe%s at frame %d.", changedCount, changedCount == 1 and "" or "s", frame))
		end
	end)

	return event
end

return IKPrototypeBridgeService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX142">
        <Properties>
          <string name="Name">ImportActions</string>
          <ProtectedString name="Source">local ImportActions = {}

function ImportActions.new(deps)
	deps = deps or {}

	local performanceDebugService = deps.performanceDebugService
	local function beginPerf(label)
		return performanceDebugService
			and type(performanceDebugService.begin) == "function"
			and performanceDebugService.begin(label)
			or nil
	end

	local function finishPerf(token, extra)
		if performanceDebugService and type(performanceDebugService.finish) == "function" then
			performanceDebugService.finish(token, extra)
		end
	end

	local function setBrowser(entries, browserStatus, actionStatus, source)
		if deps.setEntries then
			deps.setEntries(entries or {})
		end
		if deps.setBrowserStatus then
			deps.setBrowserStatus(browserStatus or "")
		end
		if deps.setActionStatus then
			deps.setActionStatus(actionStatus or browserStatus or "")
		end
		if source and deps.setSource then
			deps.setSource(source)
		end
	end

	local function refresh(message)
		if deps.refreshUi then
			deps.refreshUi(message)
		end
	end

	local function countAnimations(entries)
		if deps.ImportService and deps.ImportService.countImportableAnimationEntries then
			return deps.ImportService.countImportableAnimationEntries(entries)
		end

		local count = 0
		for _, entry in ipairs(entries or {}) do
			if entry and entry.entryType ~= "LoadMoreMyAnimations" then
				count += 1
			end
		end
		return count
	end

	return {
		loadSavedProjects = function()
			local perfToken = beginPerf("Load Saved Projects")
			local entries, status = deps.SaveExportService.loadSavedProjects()
			finishPerf(perfToken, string.format("%d entries", #(entries or {})))
			setBrowser(entries, status, status, "Saves")
			refresh()
		end,

		loadMyAnimations = function()
			local cachePerfToken = beginPerf("My Animations Cache")
			local hasCache = deps.ImportService.hasCachedMyAnimations and deps.ImportService.hasCachedMyAnimations()
			local cachedEntries = nil
			if hasCache then
				local success, entriesOrMessage = deps.ImportService.loadMyAnimations({ readAll = false, maxAdded = 0 })
				if success then
					cachedEntries = entriesOrMessage
				end
			end
			finishPerf(cachePerfToken, string.format("hasCache=%s, cached=%d", tostring(hasCache), #(cachedEntries or {})))

			local startStatus = hasCache and "Refreshing My Animations from Roblox..." or "Loading animations from your Roblox account..."
			setBrowser(cachedEntries or {}, startStatus, startStatus, "MyAnimations")
			refresh()

			task.spawn(function()
				local fetchPerfToken = beginPerf("My Animations Fetch")
				local success, entriesOrMessage, usedCache = deps.ImportService.loadMyAnimations({
					forceRefresh = true,
					readAll = true,
				})
				if not success then
					finishPerf(fetchPerfToken, tostring(entriesOrMessage))
					local status = tostring(entriesOrMessage)
					setBrowser({}, status, status, "MyAnimations")
					warn("[7kg2 Animator] " .. status)
					refresh()
					return
				end

				local entries = entriesOrMessage
				local animationCount = countAnimations(entries)
				finishPerf(fetchPerfToken, string.format("%d animations, usedCache=%s", animationCount, tostring(usedCache)))
				if animationCount &gt; 0 then
					local status = usedCache
						and string.format("Showing %d cached animations newest-first.", animationCount)
						or string.format("Found %d newest animations. Loading names and dates...", animationCount)
					setBrowser(entries, status, status, "MyAnimations")
					refresh()

					if not usedCache then
						local namesPerfToken = beginPerf("My Animations Resolve Names")
						deps.ImportService.resolveAnimationEntryNames(entries, function(index, total)
							local progress = string.format("Named %d of %d visible animations...", index, total)
							setBrowser(entries, progress, progress, "MyAnimations")
							refresh()
						end)
						finishPerf(namesPerfToken, string.format("%d visible entries", #entries))
					end

					status = deps.ImportService.hasMoreMyAnimations and deps.ImportService.hasMoreMyAnimations()
						and string.format("Loaded %d animations newest-first. Click Load More to browse the next batch.", animationCount)
						or string.format("Loaded all %d animations newest-first. Click one to import it onto the bound rig.", animationCount)
					setBrowser(entries, status, status, "MyAnimations")
				else
					local status = "No animations were found for this Studio account yet. Newly saved Roblox animations can take a short time to appear here; try My Animations again in a moment, or paste its Animation ID."
					setBrowser(entries, status, status, "MyAnimations")
				end
				refresh()
			end)
		end,

		loadMoreMyAnimations = function()
			local currentCount = countAnimations(deps.getEntries and deps.getEntries() or {})
			local loadingStatus = string.format("Loading older animations after the first %d...", currentCount)
			if deps.setBrowserStatus then
				deps.setBrowserStatus(loadingStatus)
			end
			if deps.setActionStatus then
				deps.setActionStatus(loadingStatus)
			end
			if deps.setSource then
				deps.setSource("MyAnimations")
			end
			refresh(loadingStatus)

			task.spawn(function()
				local perfToken = beginPerf("My Animations Load More")
				local success, entriesOrMessage = deps.ImportService.loadMoreMyAnimations()
				if not success then
					finishPerf(perfToken, tostring(entriesOrMessage))
					local status = tostring(entriesOrMessage)
					if deps.setActionStatus then
						deps.setActionStatus(status)
					end
					if deps.setBrowserStatus then
						deps.setBrowserStatus(status)
					end
					refresh(status)
					return
				end

				local entries = entriesOrMessage
				local animationCount = countAnimations(entries)
				finishPerf(perfToken, string.format("%d animations", animationCount))
				local status = deps.ImportService.hasMoreMyAnimations and deps.ImportService.hasMoreMyAnimations()
					and string.format("Loaded %d animations newest-first. Click Load More to continue browsing the next batch.", animationCount)
					or string.format("Loaded all %d animations newest-first.", animationCount)

				deps.ImportService.resolveAnimationEntryNames(entries, function(index, total)
					local progress = string.format("Named %d of %d browser entries...", index, total)
					setBrowser(entries, progress, progress, "MyAnimations")
					refresh()
				end)

				setBrowser(entries, status, status, "MyAnimations")
				refresh(status)
			end)
		end,

		loadPresetAnimations = function()
			local perfToken = beginPerf("Load Preset Animations")
			local entries, packCount = deps.ImportService.loadPresetEntries()
			finishPerf(perfToken, string.format("%d entries, %d packs", #entries, packCount or 0))
			local status = string.format(
				"Loaded %d Roblox Starter animation presets across %d packs. Click one to import it onto the bound rig.",
				#entries,
				packCount
			)
			setBrowser(entries, status, status, "RobloxStarter")
			refresh()
		end,

		searchStarterAnimations = function(query)
			local entries, normalizedOrMessage = deps.ImportService.searchCatalogEntries(query)
			if not entries then
				if deps.setActionStatus then
					deps.setActionStatus(normalizedOrMessage)
				end
				if deps.setSource then
					deps.setSource("RobloxStarter")
				end
				refresh(normalizedOrMessage)
				return
			end

			local status
			if #entries == 0 then
				status = "No Roblox Starter animations matched '" .. normalizedOrMessage .. "'. Try pack names like pirate, robot, or ninja, or actions like walk, run, jump, climb, or idle."
			else
				status = string.format("Found %d Roblox Starter animations for '%s'. Click one to import it.", #entries, normalizedOrMessage)
			end
			setBrowser(entries, status, status, "RobloxStarter")
			refresh()
		end,

		searchMyAnimations = function(query)
			local perfToken = beginPerf("Search My Animations")
			local entries, normalizedOrMessage = deps.ImportService.searchMyAnimations(query)
			if not entries then
				finishPerf(perfToken, tostring(normalizedOrMessage))
				local status = tostring(normalizedOrMessage)
				if deps.setActionStatus then
					deps.setActionStatus(status)
				end
				if deps.setBrowserStatus then
					deps.setBrowserStatus(status)
				end
				if deps.setSource then
					deps.setSource("MyAnimations")
				end
				refresh(status)
				return
			end

			local animationCount = countAnimations(entries)
			finishPerf(perfToken, string.format("%d matches", animationCount))
			local status
			if tostring(normalizedOrMessage or "") == "" then
				status = deps.ImportService.hasMoreMyAnimations and deps.ImportService.hasMoreMyAnimations()
					and string.format("Showing %d loaded My Animations newest-first. Click Load More to include older uploads.", animationCount)
					or string.format("Showing all %d loaded My Animations newest-first.", animationCount)
			elseif animationCount == 0 then
				status = "No loaded My Animations matched '" .. tostring(normalizedOrMessage) .. "'. Click Load More if the animation may be older."
			else
				status = string.format("Found %d loaded My Animations for '%s'.", animationCount, tostring(normalizedOrMessage))
			end
			setBrowser(entries, status, status, "MyAnimations")
			refresh(status)
		end,

		loadBulkKeyframeSequences = function()
			local entries, status = deps.ImportService.findBulkKeyframeSequences(deps.SelectionService.getSelection())
			setBrowser(entries, status, status, "Bulk")
			refresh(status)
		end,

		importBulkKeyframeSequence = function(entryId)
			for _, entry in ipairs(deps.getEntries and deps.getEntries() or {}) do
				if tostring(entry.id or "") == tostring(entryId or "") and entry.entryType == "BulkKeyframeSequence" then
					if not entry.sequence or not entry.sequence.Parent then
						local status = "That KeyframeSequence is no longer available. Click Bulk again to refresh the list."
						if deps.setActionStatus then
							deps.setActionStatus(status)
						end
						refresh(status)
						return false
					end

					local clipRigType = deps.ImportService.detectRigTypeFromAnimationClip(entry.sequence)
					local boundRigType = deps.getBoundRigTypeName and deps.getBoundRigTypeName()
					if clipRigType and boundRigType and clipRigType ~= boundRigType then
						local status = string.format(
							"That KeyframeSequence looks like %s, but the bound rig is %s. Bind a matching rig before importing.",
							clipRigType,
							boundRigType
						)
						if deps.setActionStatus then
							deps.setActionStatus(status)
						end
						refresh(status)
						return false
					end

					deps.importKeyframeSequence(entry.sequence, entry.name or entry.instancePath or "bulk selection")
					return true
				end
			end

			local status = "Click Bulk again, then choose a KeyframeSequence from the refreshed list."
			if deps.setActionStatus then
				deps.setActionStatus(status)
			end
			refresh(status)
			return false
		end,
	}
end

return ImportActions
</ProtectedString>
