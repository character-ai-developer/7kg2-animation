		local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
		if not timeline then
			return false, "No timeline is available."
		end
		if actionName == "30 FPS" or actionName == "60 FPS" then
			local fps = actionName == "30 FPS" and 30 or 60
			if type(timeline.setFps) == "function" then
				local ok = runOption(options, "onFpsChanged", "fpsChanged", fps)
				if not ok then
					timeline:setFps(fps)
				end
				return true, string.format("Micro timeline FPS set to %d.", fps)
			end
		elseif actionName == "15 sec" or actionName == "30 sec" or actionName == "60 sec" then
			local seconds = actionName == "15 sec" and 15 or (actionName == "30 sec" and 30 or 60)
			local fps = type(timeline.getFps) == "function" and math.max(1, tonumber(timeline:getFps()) or 60) or 60
			if type(timeline.setDurationFrames) == "function" then
				local frameCount = math.max(1, math.floor(seconds * fps + 0.5))
				local ok = runOption(options, "onDurationChanged", "durationChanged", frameCount)
				if not ok then
					timeline:setDurationFrames(frameCount)
				end
				return true, string.format("Micro timeline length set to %d seconds.", seconds)
			end
		elseif actionName == "Move .01" or actionName == "Move .1" then
			local studs = actionName == "Move .01" and 0.01 or 0.1
			return runOption(options, "onMoveSnapChanged", "setMoveSnap", studs)
		elseif actionName == "Rot .01" or actionName == "Rot 1" then
			local degrees = actionName == "Rot .01" and 0.01 or 1
			return runOption(options, "onRotateSnapChanged", "setRotateSnap", degrees)
		elseif actionName == "Gizmo 80" or actionName == "Gizmo 100" or actionName == "Gizmo 120" then
			local percent = tonumber(actionName:match("Gizmo%s+(%d+)")) or 100
			local ok, message = runOption(options, "onGizmoSizeChanged", "setGizmoSizePercent", percent)
			if ok then
				return true, message or string.format("Gizmo size set to %d%%.", percent)
			end
			return false, message or "Could not change gizmo size."
		elseif actionName == "Loop" then
			if type(timeline.getLooping) == "function" and type(timeline.setLooping) == "function" then
				local looping = not timeline:getLooping()
				local ok = runOption(options, "onLoopingChanged", "loopingChanged", looping)
				if not ok then
					timeline:setLooping(looping)
				end
				return true, looping and "Looping enabled." or "Looping disabled."
			end
		elseif actionName == "Priority" then
			if type(timeline.getPriority) == "function" and type(timeline.setPriority) == "function" then
				local priorities = { "Idle", "Movement", "Action", "Action2" }
				local current = tostring(timeline:getPriority() or "Action")
				local nextIndex = 1
				for index, priority in ipairs(priorities) do
					if priority == current then
						nextIndex = (index % #priorities) + 1
						break
					end
				end
				local nextPriority = priorities[nextIndex]
				local ok = runOption(options, "onPriorityChanged", "priorityChanged", nextPriority)
				if not ok then
					timeline:setPriority(nextPriority)
				end
				return true, "Animation priority set to " .. nextPriority .. "."
			end
		elseif actionName == "Pick" then
			return runOption(options, "onToggleRigPartHighlight", "toggleRigPartHighlight")
		elseif actionName == "Handles" then
			return runOption(options, "onToggleRigHandles", "toggleRigHandles")
