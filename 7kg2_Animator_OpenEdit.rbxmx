			local applied = false
			if callbacks.onApplyCameraRotation then
				applied = callbacks.onApplyCameraRotation(
					self._cameraRotationXInput and self._cameraRotationXInput.Text or "",
					self._cameraRotationYInput and self._cameraRotationYInput.Text or "",
					self._cameraRotationZInput and self._cameraRotationZInput.Text or ""
