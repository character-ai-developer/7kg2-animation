					return
				end
				if callbacks.onIsWorkspaceGrabActive
					and callbacks.onIsWorkspaceGrabActive() == true then
					local _, message = callbacks.onToggleWorkspaceGrab()
					if message then
						self:_setShortcutHint(message)
					end
					return
				end
				self:_releaseMainTimelineShortcuts("WorkspaceGrabButton")
				task.defer(function()
					local _, message = callbacks.onToggleWorkspaceGrab()
					if message then
						self:_setShortcutHint(message)
					end
				end)
			end
		end)
