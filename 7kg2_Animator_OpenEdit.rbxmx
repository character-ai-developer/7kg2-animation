          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Selection = game:GetService("Selection")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local Modules = script.Parent:WaitForChild("Modules")
local AdaptiveWalkRuntime = require(Modules:WaitForChild("AdaptiveWalkRuntime"))
local BuildInfo = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("BuildInfo"))
local AnimatedPathRuntime = require(Modules:WaitForChild("AnimatedPathRuntime"))
local ImpactBreakRuntime = require(Modules:WaitForChild("ImpactBreakRuntime"))
local ObjectCaptureSnapshot = require(Modules:WaitForChild("ObjectCaptureSnapshot"))
local PhysicsRecorder = require(Modules:WaitForChild("PhysicsRecorder"))
local PhysicsDriveRuntime = require(Modules:WaitForChild("PhysicsDriveRuntime"))
local PhysicsThemeSupport = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("PhysicsThemeSupport"))
local PhysicsProjectilePathUX = require(Modules:WaitForChild("PhysicsProjectilePathUX"))
local PhysicsWorkflowUX = require(Modules:WaitForChild("PhysicsWorkflowUX"))
local RagdollRuntime = require(Modules:WaitForChild("RagdollRuntime"))
local RiderRuntime = require(Modules:WaitForChild("RiderRuntime"))
local SceneCaptureScope = require(Modules:WaitForChild("SceneCaptureScope"))
local TakeBaker = require(Modules:WaitForChild("TakeBaker"))
local TakePreviewRuntime = require(Modules:WaitForChild("TakePreviewRuntime"))

local CAPTURE_ATTRIBUTE = "MegMoPhysicsCaptureId"
local DRIVER_ATTRIBUTE = "MegMoPhysicsDriverId"
local IMPORT_EVENT_NAME = "MegMoPhysicsCaptureImportTake"
local IMPORT_RESULT_EVENT_NAME = "MegMoPhysicsCaptureImportResult"

local THEME = {
	background = Color3.fromRGB(10, 14, 22),
	panel = Color3.fromRGB(20, 27, 42),
	button = Color3.fromRGB(37, 47, 70),
	accent = Color3.fromRGB(126, 86, 255),
	cyan = Color3.fromRGB(72, 214, 255),
	green = Color3.fromRGB(91, 224, 165),
	red = Color3.fromRGB(244, 88, 112),
	yellow = Color3.fromRGB(255, 201, 92),
	text = Color3.fromRGB(240, 244, 255),
	muted = Color3.fromRGB(218, 225, 240),
}
PhysicsThemeSupport.SyncPalette(THEME)

local state = {
	uiStage = "Setup",
	setupPage = "Prepare",
	effectMode = "Drop",
	bounceEnabled = false,
	eventSourceInstance = nil,
	eventSourcePosition = nil,
	eventSourceDirection = Vector3.zAxis,
	eventSourceDirectionManual = false,
	eventSourceDescriptor = nil,
	eventSourceTargets = {},
	eventProjectileStart = nil,
	eventProjectileEnd = nil,
	eventSourceScope = require(Modules:WaitForChild("PhysicsEventSourceScope")),
	eventMarkers = {},
	eventTime = 0.5,
	eventStrength = "Medium",
	eventPower = 50,
	eventPowerDragging = false,
	eventSlowMotion = false,
	eventPlaybackSpeed = 1,
	playbackSpeedSupport = require(script.Parent.Parent.Parent:WaitForChild("Modules"):WaitForChild("PhysicsPlaybackSpeedSupport")),
	eventReaction = "Push",
	eventDirectionMode = "Outward",
	explosionVFXSource = nil,
	explosionVFXSourceDescriptor = nil,
	explosionVFXEmitCount = nil,
	explosionVFXSupport = require(Modules:WaitForChild("PhysicsExplosionVFXSupport")),
	eventSession = nil,
	eventTestMode = false,
	eventSpeedPreviewMode = false,
	eventTestCompleted = false,
	eventTestDuration = 4,
	eventTestSettledDuration = 0,
	eventTestHiddenParts = {},
	eventTestHiddenHumanoids = {},
	eventTestHiddenVisuals = {},
	eventTestVisualProxyFolder = nil,
	eventTestVisualProxyDescriptors = {},
	eventTestLivePreviewSession = nil,
	eventTestLiveCaptureComplete = false,
	eventLivePreviewPurpose = nil,
	eventCapturedTakeRetimed = false,
	explosionTestCache = nil,
	explosionTestSetupRevision = 0,
	previewRestoreSnapshots = {},
	previewRestoreGeneration = 0,
	runtimeEventSources = nil,
	eventRuntime = require(Modules:WaitForChild("PhysicsEventRuntime")),
	selectionIsolation = require(Modules:WaitForChild("PhysicsSelectionIsolation")),
	startingPushRuntime = require(Modules:WaitForChild("PhysicsStartingPushRuntime")),
	startingPushUXModule = require(Modules:WaitForChild("PhysicsStartingPushUX")),
	startingPushTarget = nil,
	startingPushTargetId = nil,
	startingPushContact = nil,
	startingPushOrigin = nil,
	startingPushSpeed = 12,
	startingPushTestMode = false,
	fullEffectTestMode = false,
	startingPushTestedSpeed = nil,
	startingPushTestDuration = 4,
	startingPushPreviewDuration = 0,
	startingPushActions = {},
	eventActions = {},
	effectActions = {},
	effectTestLabels = {
		Release = "Release",
		Drop = "Drop",
		Character = "Ragdoll",
		Impact = "Drive &amp; Impact",
		Projectile = "Projectile",
		Explosion = "Explosion",
		Scene = "Scene Physics",
		AdaptiveWalk = "Adaptive Walk",
	},
	largeSelectionWarning = nil,
	largeSelectionWarningBypass = false,
	inputService = game:GetService("UserInputService"),
	advancedVisible = false,
	captureMode = "Objects",
	selectedRig = nil,
	selectedRigs = {},
	rigCaptureEntries = {},
	rigEditSnapshots = {},
	driverObject = nil,
	driverId = nil,
	driverEditSnapshots = {},
	driverCaptureTarget = nil,
	riderTargets = {},
	riderEditSnapshots = {},
	riderRuntimeSession = nil,
	movingObjectMode = "PhysicsDrive",
	keepUpright = false,
	captureId = nil,
	armed = false,
	capturing = false,
	manualRunRequired = false,
	autoRagdoll = false,
	ragdollMode = "Fall",
	fps = 30,
	maxDuration = 20,
	captureScope = SceneCaptureScope.SELECTED,
	objectTargets = {},
	objectEditSnapshots = {},
	targetsTruncated = false,
	releaseObject = nil,
	releaseCaptureTarget = nil,
	releaseData = nil,
	releaseCollisionsEnabled = true,
	releaseRuntime = require(Modules:WaitForChild("PhysicsObjectReleaseRuntime")),
	animatedPath = nil,
	pathLoading = false,
	pathMode = "Handoff",
	pathSession = nil,
	heldPathSession = nil,
	adaptiveWalkSession = nil,
	adaptiveWalkRestoreSession = nil,
	adaptiveWalkComplete = false,
	walkPresets = {},
	walkPresetIndex = 0,
	walkPresetLoading = false,
	walkRigType = nil,
	impactBreak = false,
	impactSession = nil,
	physicsDriveSession = nil,
	runtimeTargets = nil,
	runtimeObjectAnchors = {},
	physicsActive = false,
	recorder = nil,
	ragdollSession = nil,
	ragdollCapture = nil,
	runtimeRig = nil,
	runtimeRigs = {},
	runtimeDriver = nil,
	take = nil,
	rigTakes = {},
	takes = {},
	takeIndex = 0,
	previewSession = nil,
	previewSpeed = 1,
	microPopup = false,
	impactTime = nil,
	ragdollTime = nil,
