local function startMotionPreview(segmentKey)
	local previewPerfToken = PerformanceDebugService.begin(segmentKey and "Motion Segment Preview" or "Motion Path Preview")
	do
		local rigSuccess, rigMessage = ensureMotionBuilderRigBound()
		if not rigSuccess then
			PerformanceDebugService.finish(previewPerfToken, rigMessage)
			return false, rigMessage
		end
	end

	local rigType = getPreviewRigTypeName()
	local options = {
		segmentKey = segmentKey,
		rigType = rigType,
	}
	options = motionBuilderState:getOptions(options)
	local motionEntriesBySegment = {}
	local idleEntriesBySegment = {}
	for _, segment in ipairs(MotionService.listMotionSegments(options)) do
		if not segmentKey or tostring(segment.segmentKey) == tostring(segmentKey) then
			local motionEntry, motionMessage = MotionClipService.getSegmentMotionPresetEntry(ImportService, segment, rigType, importAnimationEntries)
			if motionMessage then
				PerformanceDebugService.finish(previewPerfToken, motionMessage)
				refreshUi(motionMessage)
				return false, motionMessage
			end
			if motionEntry then
				motionEntriesBySegment[tostring(segment.segmentKey)] = motionEntry
			end
			local idleEntry, idleMessage = MotionClipService.getSegmentPauseIdlePresetEntry(ImportService, segment, rigType, importAnimationEntries)
			if idleMessage then
				PerformanceDebugService.finish(previewPerfToken, idleMessage)
				refreshUi(idleMessage)
				return false, idleMessage
			end
			if idleEntry and (tonumber(segment.pauseAfterSeconds) or 0) &gt; 0 then
				idleEntriesBySegment[tostring(segment.segmentKey)] = idleEntry
			end
		end
	end

	local hasRequestedClip = false
	for _ in pairs(motionEntriesBySegment) do
		hasRequestedClip = true
		break
	end
	if not hasRequestedClip then
		for _ in pairs(idleEntriesBySegment) do
			hasRequestedClip = true
			break
		end
	end
	if not hasRequestedClip then
		local success, message = MotionService.previewMotionPathFromWorkspaceMarkers(motionServiceDeps(), options)
		PerformanceDebugService.finish(previewPerfToken, message)
		return success, message
	end

	importActionStatus = "Loading Motion Builder preview clips..."
	refreshUi(importActionStatus)
	task.spawn(function()
		local loadedById = {}
		local previewClipsBySegment = {}
		local previewIdleClipsBySegment = {}

		local function loadEntry(entry, label)
			local key = tostring(entry.id or entry.numericId or label)
			if not loadedById[key] then
				local success, clipDataOrMessage = MotionClipService.loadPresetClip(ImportService, entry, rigType, label)
				if not success then
					PerformanceDebugService.finish(previewPerfToken, clipDataOrMessage)
					return nil, clipDataOrMessage
				end
				loadedById[key] = clipDataOrMessage
			end
			return loadedById[key], nil
		end

		for key, entry in pairs(motionEntriesBySegment) do
			local clipData, loadMessage = loadEntry(entry, tostring(entry.name or "selected motion"))
			if loadMessage then
				PerformanceDebugService.finish(previewPerfToken, loadMessage)
				importActionStatus = loadMessage
				refreshUi(loadMessage)
				return
			end
			previewClipsBySegment[key] = clipData
		end
		for key, entry in pairs(idleEntriesBySegment) do
			local clipData, loadMessage = loadEntry(entry, tostring(entry.name or "pause idle"))
			if loadMessage then
				PerformanceDebugService.finish(previewPerfToken, loadMessage)
				importActionStatus = loadMessage
				refreshUi(loadMessage)
				return
			end
			previewIdleClipsBySegment[key] = clipData
		end

		options.previewClipsBySegment = previewClipsBySegment
		options.previewIdleClipsBySegment = previewIdleClipsBySegment
		local _, message = MotionService.previewMotionPathFromWorkspaceMarkers(motionServiceDeps(), options)
		PerformanceDebugService.finish(previewPerfToken, message)
		importActionStatus = message
	end)

	return true, importActionStatus
end

