	onToggleHideDuringPlayback = function()
		widgetController._hideDuringPlaybackEnabled = not widgetController._hideDuringPlaybackEnabled
		local message = widgetController._hideDuringPlaybackEnabled and "Hide During Playback enabled." or "Hide During Playback disabled."
		if widgetController._hideDuringPlaybackEnabled == true and playbackService:getIsPlaying() then
			widget:SetAttribute("MegMoHiddenForPlayback", true)
			setWidgetEnabled(false)
			message = "Hide During Playback enabled. Plugin hidden while playback continues."
		elseif widget:GetAttribute("MegMoHiddenForPlayback") == true then
			restoreUiHiddenForPlayback()
		end
		refreshUi(message)
		return widgetController._hideDuringPlaybackEnabled, message
	end,
	onToggleRigPartHighlight = function()
		if widgetController._motionBuilderSuspendedViewportPicker == true then
			widgetController._rigPartHighlightEnabled = false
			widgetController._viewportPartPickerSuspended = true
			widgetController._viewportPartPickerArmed = false
			pcall(function()
				toggleButton:SetActive(false)
				plugin:Deactivate()
				require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
				gizmoController:setHandleVisualsHidden(false)
			end)
			refreshUi("Motion Builder is using Studio tools. Return to the timeline to re-enable 7kg2 picking.")
			return
		end
		if widget:GetAttribute("MegMoHiddenForMicro") == true then
			if widgetController._rigPartHighlightEnabled ~= false then
				editorActions.suspendViewportRigPartPicker("Part picker disabled. Studio viewport controls active.")
				refreshSelectedGizmo()
				refreshUi("Part picker disabled. Studio viewport controls active.")
				return false, "Part picker disabled. Studio viewport controls active."
			end
			widgetController._rigPartHighlightEnabled = true
			widgetController._viewportPartPickerSuspended = false
			widgetController._viewportPartPickerArmed = true
			editorActions.resumeViewportRigPartPicker()
			refreshSelectedGizmo()
			refreshUi("Part picker enabled. Click a rig part in the viewport.")
			return true, "Part picker enabled."
		end
		widgetController._rigPartHighlightEnabled = not (widgetController._rigPartHighlightEnabled ~= false)
		widgetController._viewportPartPickerSuspended = false
		pcall(function()
			if widgetController._rigPartHighlightEnabled then
				plugin:Activate(true)
				gizmoController:setHandleVisualsHidden(true)
			else
				require(Modules:WaitForChild("ViewportPartSelectService")).clearHover()
				editorActions.syncViewportRigPartPicker()
			end
		end)
		refreshSelectedGizmo()
		refreshUi(widgetController._rigPartHighlightEnabled and "Part picker enabled. Click a rig part in the viewport." or "Part picker disabled.")
	end,
	onToggleSelectionHighlight = editorActions.toggleSelectionHighlight,
	onToggleRigHandles = function()
		local enabled, message = false, "Rig handles unavailable."
		pcall(function()
			local service = require(Modules:WaitForChild("RigHandleOverlayService"))
			enabled = service.toggle()
			if enabled then
				service.refresh(timeline)
			end
			message = enabled and "Rig handles visible." or "Rig handles hidden."
		end)
		refreshUi(message)
		return enabled, message
	end,
	onSetTrackballAxis = editorActions.setTrackballAxis,
