		local microKeyDragPath = nil
		local microKeyDragSourceFrame = nil
		local microKeyDragTargetFrame = nil
		local microKeyDragCursorFrameOffset = 0
		local microKeyDragMoved = false
		local microKeyDragSelected = nil
		local microKeyDragSelectedCount = 0
		local microKeyDragSelectedRefs = nil
		local microKeyDragPreviewKeys = nil
