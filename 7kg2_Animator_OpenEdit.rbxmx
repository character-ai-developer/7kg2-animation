local function restoreOriginalWorkspaceState(reason)
	if timeline and type(timeline.stopSoundTracks) == "function" then
		pcall(function()
			timeline:stopSoundTracks()
		end)
	end

	local success, appliedCount = timeline:resetOriginalState()
	if screenEffectsRenderer then
		pcall(function()
			screenEffectsRenderer:render({ viewerEnabled = false })
		end)
	end
	if widgetController._onionSkinService then
		pcall(function()
			widgetController._onionSkinService:clear()
		end)
	end
	return success, appliedCount or 0, reason
end

local function restoreOriginalStateIfTimelineEmpty(reason)
	if not timeline or type(timeline.getKeyframeCount) ~= "function" or timeline:getKeyframeCount() &gt; 0 then
		return false, 0
	end
	return restoreOriginalWorkspaceState(reason)
end

