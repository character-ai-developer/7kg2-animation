local PRESET_ANIMATION_LIBRARY = {}
local r15StarterEntriesForR6Conversion = {}
for _, pack in ipairs(CURATED_ANIMATION_PACKS) do
	for _, item in ipairs(pack.items or {}) do
		local entry = {
			id = item.id,
			name = string.format("%s %s", pack.name, item.action),
			source = "Roblox Starter",
			creatorName = "Roblox",
			category = item.action,
			pack = pack.name,
			rigType = pack.rigType or "R15",
			priceLabel = "Free",
		}
		table.insert(PRESET_ANIMATION_LIBRARY, entry)
		if tostring(entry.rigType or "R15") == "R15" then
			table.insert(r15StarterEntriesForR6Conversion, entry)
		end
	end
end

for _, entry in ipairs(r15StarterEntriesForR6Conversion) do
	table.insert(PRESET_ANIMATION_LIBRARY, {
		id = entry.id,
		name = tostring(entry.name or "Starter Animation") .. " (R6)",
		source = "Roblox Starter",
		creatorName = entry.creatorName,
		category = entry.category,
		pack = entry.pack,
		rigType = "R6",
		sourceRigType = "R15",
		convertToR6 = true,
		priceLabel = "Free",
	})
end

local function makeImportEntry(id, name, metadata)
	metadata = metadata or {}
	return {
		id = tostring(id),
		numericId = tonumber(id) or id,
		name = name,
		source = metadata.source,
		creatorName = metadata.creatorName,
		category = metadata.category,
		pack = metadata.pack,
		rigType = metadata.rigType,
		sourceRigType = metadata.sourceRigType,
		convertToR6 = metadata.convertToR6 == true,
		priceLabel = metadata.priceLabel,
	}
end

local LOCOMOTION_SPEEDS = {
	Run = 14,
	Sprint = 16,
	Walk = 8,
	Climb = 6,
	Swim = 7,
	Crawl = 4,
	Sneak = 5,
}

local function findActionFromText(text)
	local lowered = string.lower(tostring(text or ""))
	if lowered == "" then
		return nil
	end

	local orderedActions = {
		"swim idle",
		"sprint",
		"climb",
		"crawl",
		"sneak",
		"idle",
		"jump",
		"fall",
		"walk",
		"run",
		"swim",
	}
	local actionKeywords = {
		"action",
		"emote",
		"punch",
		"kick",
		"attack",
		"slash",
		"swing",
		"hit",
		"combat",
		"dance",
		"wave",
		"point",
		"cheer",
		"laugh",
		"salute",
		"shrug",
		"tilt",
		"stadium",
		"hello",
	}

	for _, action in ipairs(orderedActions) do
		if string.find(lowered, action, 1, true) then
			local normalized = string.gsub(action, "^%l", string.upper)
			if normalized == "Swim idle" then
				normalized = "Swim Idle"
			end
			return normalized
		end
	end

	for _, action in ipairs(actionKeywords) do
		if string.find(lowered, action, 1, true) then
			return "Action"
		end
	end

	return nil
end

local MOTION_BUILDER_CATEGORY_MAP = {
	Walk = "Walk",
	Run = "Run",
	Sprint = "Run",
	Jump = "Jump",
	Climb = "Climb",
	Idle = "Idle",
	Action = "Action",
	Emote = "Action",
	Punch = "Action",
	Kick = "Action",
	Attack = "Action",
	Combat = "Action",
	Dance = "Action",
	Wave = "Action",
}

local ACTION_CATEGORY_KEYWORDS = {
	"action",
	"emote",
	"punch",
	"kick",
	"attack",
	"slash",
	"swing",
	"hit",
	"combat",
	"dance",
	"wave",
	"point",
	"cheer",
	"laugh",
	"salute",
	"shrug",
	"tilt",
	"stadium",
	"hello",
}

local function readTimestamp(value)
	if value == nil then
		return nil
	end

	local valueType = typeof(value)
	if valueType == "DateTime" then
		local okMillis, millis = pcall(function()
			return value.UnixTimestampMillis
		end)
		if okMillis and tonumber(millis) then
			return tonumber(millis)
		end

		local okSeconds, seconds = pcall(function()
			return value.UnixTimestamp
		end)
		if okSeconds and tonumber(seconds) then
			return tonumber(seconds) * 1000
		end
	end

	if type(value) == "number" then
		return value &gt; 100000000000 and value or value * 1000
	end

	if type(value) == "string" and value ~= "" then
		local numeric = tonumber(value)
		if numeric then
			return numeric &gt; 100000000000 and numeric or numeric * 1000
		end

		local okDate, date = pcall(function()
			return DateTime.fromIsoDate(value)
		end)
		if okDate and date then
			local okMillis, millis = pcall(function()
				return date.UnixTimestampMillis
			end)
			if okMillis and tonumber(millis) then
				return tonumber(millis)
			end
		end

		local year, month, day, hour, minute, second = string.match(
			value,
			"^(%d%d%d%d)%-(%d%d)%-(%d%d)T(%d%d):(%d%d):(%d%d)"
		)
		if year then
			local okUniversal, dateTime = pcall(function()
				return DateTime.fromUniversalTime(
					tonumber(year),
					tonumber(month),
					tonumber(day),
					tonumber(hour),
					tonumber(minute),
					tonumber(second)
				)
			end)
			if okUniversal and dateTime then
				return dateTime.UnixTimestampMillis
			end
		end
	end

	return nil
end

local function sortEntriesNewestFirst(entries)
	table.sort(entries, function(a, b)
		local aIsLoadMore = a and a.entryType == "LoadMoreMyAnimations"
		local bIsLoadMore = b and b.entryType == "LoadMoreMyAnimations"
		if aIsLoadMore ~= bIsLoadMore then
			return not aIsLoadMore
		end
		if aIsLoadMore and bIsLoadMore then
			return false
		end

		local aIsMyAnimation = a and tostring(a.source or "") == "My Animations"
		local bIsMyAnimation = b and tostring(b.source or "") == "My Animations"
		if aIsMyAnimation and bIsMyAnimation then
			local aOrder = tonumber(a and a.pageOrder)
			local bOrder = tonumber(b and b.pageOrder)
			if aOrder and bOrder and aOrder ~= bOrder then
				return aOrder &gt; bOrder
			end

			local aTime = math.max(
				tonumber(a and a.sortTimestamp) or 0,
				tonumber(a and a.createdTimestamp) or 0,
				tonumber(a and a.updatedTimestamp) or 0
			)
			local bTime = math.max(
				tonumber(b and b.sortTimestamp) or 0,
				tonumber(b and b.createdTimestamp) or 0,
				tonumber(b and b.updatedTimestamp) or 0
			)
			if aTime ~= bTime then
				return aTime &gt; bTime
			end

			local aId = tonumber(a and a.numericId)
			local bId = tonumber(b and b.numericId)
			if aId and bId and aId ~= bId then
				return aId &gt; bId
			end
		end

		local aTime = math.max(
			tonumber(a and a.sortTimestamp) or 0,
			tonumber(a and a.createdTimestamp) or 0,
			tonumber(a and a.updatedTimestamp) or 0
		)
		local bTime = math.max(
			tonumber(b and b.sortTimestamp) or 0,
			tonumber(b and b.createdTimestamp) or 0,
			tonumber(b and b.updatedTimestamp) or 0
		)
		if aTime and bTime and aTime ~= bTime then
			return aTime &gt; bTime
		end
		if aTime and not bTime then
			return true
		end
		if bTime and not aTime then
			return false
		end

		local aId = tonumber(a and a.numericId)
		local bId = tonumber(b and b.numericId)
		if aId and bId and aId ~= bId then
			return aId &gt; bId
		end

		return tonumber(a and a.pageOrder or 0) &lt; tonumber(b and b.pageOrder or 0)
	end)
end

local function countImportableAnimationEntries(entries)
	local count = 0
	for _, entry in ipairs(entries or {}) do
		if entry and entry.entryType ~= "LoadMoreMyAnimations" then
			count += 1
		end
	end
	return count
end

local function makeLoadMoreMyAnimationsEntry(loadedCount)
	return {
		id = LOAD_MORE_MY_ANIMATIONS_ENTRY_ID,
		entryType = "LoadMoreMyAnimations",
		name = "Load More Animations",
		source = "My Animations",
		category = string.format("%d shown so far", tonumber(loadedCount) or 0),
	}
end

local function normalizeMotionBuilderCategory(category)
	local text = tostring(category or "")
	if text == "" then
		return nil
	end
	if MOTION_BUILDER_CATEGORY_MAP[text] then
		return MOTION_BUILDER_CATEGORY_MAP[text]
	end

	local lowered = string.lower(text)
	if lowered == "walk" then
		return "Walk"
	elseif lowered == "run" or lowered == "sprint" or lowered == "jog" then
		return "Run"
	elseif lowered == "jump" then
		return "Jump"
	elseif lowered == "climb" then
		return "Climb"
	elseif lowered == "idle" or lowered == "swim idle" then
		return "Idle"
	end

	for _, keyword in ipairs(ACTION_CATEGORY_KEYWORDS) do
		if string.find(lowered, keyword, 1, true) then
			return "Action"
		end
	end

	return nil
end

function ImportService.normalizeAnimationContentId(input)
	local text = tostring(input or "")
	local numericId = text:match("rbxassetid://(%d+)")
		or text:match("assetId=(%d+)")
		or text:match("/catalog/(%d+)")
		or text:match("/library/(%d+)")
		or text:match("(%d+)")
	if not numericId then
		return nil
	end

	numericId = tostring(math.floor(tonumber(numericId)))
	return "rbxassetid://" .. numericId, numericId
end

function ImportService.getInventoryAnimationEntry(item)
	local id = nil
	local name = nil
	local createdTime = nil
	local updatedTime = nil
	if type(item) == "number" then
		id = tostring(item)
	elseif type(item) == "string" then
		local _, parsedId = ImportService.normalizeAnimationContentId(item)
		id = parsedId
	elseif type(item) == "table" then
		id = item.AssetId or item.Id or item.AnimationId or item.TargetId or item.assetId or item.id
		name = item.Name or item.AssetName or item.AnimationName or item.Title or item.name
		createdTime = readTimestamp(item.Created or item.CreatedAt or item.CreationTime or item.created or item.createdAt)
		updatedTime = readTimestamp(item.Updated or item.UpdatedAt or item.Modified or item.UpdatedTime or item.updated or item.updatedAt)
	else
		return nil
	end

	if not id then
		return nil
	end

	name = name or ("Animation " .. tostring(id))
	local contentId, numericId = ImportService.normalizeAnimationContentId(id)
	if not contentId then
		return nil
	end

	return {
		id = contentId,
		numericId = numericId,
		name = name,
		source = "My Animations",
		createdTimestamp = createdTime,
		updatedTimestamp = updatedTime,
		sortTimestamp = math.max(updatedTime or 0, createdTime or 0),
	}
end

function ImportService.detectRigTypeFromAnimationClip(clip)
	if not clip then
		return nil
	end

	local sawR15 = false
	local sawR6 = false
	for _, descendant in ipairs(clip:GetDescendants()) do
		local subjectName = nil
		if descendant:IsA("Pose") or descendant:IsA("Folder") then
			subjectName = descendant.Name
		end

		if subjectName then
			if R15_PREVIEW_TRACK_NAMES[subjectName] then
				sawR15 = true
			elseif R6_PREVIEW_TRACK_NAMES[subjectName] then
				sawR6 = true
			end
		end
	end

	if sawR15 and not sawR6 then
		return "R15"
	end
	if sawR6 and not sawR15 then
		return "R6"
	end
	return nil
end

local function isGenericInventoryAnimationName(name, numericId)
	local text = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local idText = tostring(numericId or "")
	if text == "" then
		return true
	end
	if text == "Animation" then
		return true
	end
	if idText ~= "" and (text == ("Animation " .. idText) or text == ("Animation" .. idText)) then
		return true
	end
	return false
end

local function resolveAnimationAssetInfo(entry)
	local assetId = entry and tonumber(entry.numericId)
	if not assetId then
		return nil
	end

	if assetInfoCache[assetId] then
		return assetInfoCache[assetId]
	end

	local success, info = pcall(function()
		return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
	end)
	if success and type(info) == "table" then
		local resolved = {
			name = type(info.Name) == "string" and info.Name ~= "" and info.Name or nil,
			createdTimestamp = readTimestamp(info.Created),
			updatedTimestamp = readTimestamp(info.Updated),
		}
		resolved.sortTimestamp = math.max(resolved.updatedTimestamp or 0, resolved.createdTimestamp or 0)
		assetInfoCache[assetId] = resolved
		return resolved
	end

	return nil
end

local function getKeyframeCount(sequence)
	if not (sequence and sequence:IsA("KeyframeSequence")) then
		return nil
	end
	local ok, keyframes = pcall(function()
		return sequence:GetKeyframes()
	end)
	if ok and type(keyframes) == "table" then
		return #keyframes
	end
	return nil
end

function ImportService.resolveAnimationAssetName(entry)
	local info = resolveAnimationAssetInfo(entry)
	return info and info.name or nil
end

function ImportService.loadAnimationClipFromContentId(contentId)
	local success, clip = pcall(function()
		return AnimationClipProvider:GetAnimationClipAsync(contentId)
	end)
	if success and clip then
		return true, clip
	end

	local clipMessage = tostring(clip or "")
	local fallbackSuccess, fallbackClip = pcall(function()
		return KeyframeSequenceProvider:GetKeyframeSequenceAsync(contentId)
	end)
	if fallbackSuccess and fallbackClip then
		if getKeyframeCount(fallbackClip) == 0 and clipMessage ~= "" then
			return false, "Roblox did not provide keyframes for this Animation asset. It may be private, deleted, moderated, owned by another creator/group, or unavailable to this place. Select a local KeyframeSequence or an animation you own/can access."
		end
		return true, fallbackClip
	end

	local fallbackMessage = tostring(fallbackClip or "")
	if clipMessage ~= "" and fallbackMessage ~= "" and fallbackMessage ~= clipMessage then
		return false, clipMessage .. " / " .. fallbackMessage
	end
	return false, clipMessage ~= "" and clipMessage or (fallbackMessage ~= "" and fallbackMessage or "Roblox could not load that animation.")
end

function ImportService.findAnimationImportSource(instance)
	if not instance then
		return nil, nil
	end

	if instance:IsA("Animation") then
		return "AnimationId", instance.AnimationId, instance
	end

	if instance:IsA("KeyframeSequence") then
		return "KeyframeSequence", instance, instance
	end

	if instance:IsA("CurveAnimation") then
		return "CurveAnimation", instance, instance
	end

	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("Animation") then
			return "AnimationId", descendant.AnimationId, descendant
		end
		if descendant:IsA("KeyframeSequence") then
			return "KeyframeSequence", descendant, descendant
		end
		if descendant:IsA("CurveAnimation") then
			return "CurveAnimation", descendant, descendant
		end
	end

	return nil, nil
end

local function getInstancePath(instance)
	if not instance then
		return ""
	end

	local ok, path = pcall(function()
		return instance:GetFullName()
	end)
	if ok and path then
		return tostring(path)
	end

	return tostring(instance.Name or "")
end

function ImportService.describeImportSource(instance, fallback)
	if instance and instance.Parent then
		local ok, fullName = pcall(function()
			return instance:GetFullName()
		end)
		if ok and fullName then
			return tostring(fullName)
		end
	end
	return tostring(fallback or "selection")
end

function ImportService.getKeyframeSequenceKeyframeCount(sequence)
	return getKeyframeCount(sequence)
end

function ImportService.findBulkKeyframeSequences(selection)
	local selected = type(selection) == "table" and selection or {}
	if #selected == 0 then
		return {}, "Select a rig, folder, or multiple KeyframeSequences in Explorer, then click Bulk Selected."
	end

	local entries = {}
	local seen = {}
	local maxEntries = 200

	local function addSequence(sequence)
		if not sequence or not sequence:IsA("KeyframeSequence") or seen[sequence] then
			return
		end

		seen[sequence] = true
		local keyframes = {}
		local ok = pcall(function()
			keyframes = sequence:GetKeyframes()
		end)
		if not ok then
			keyframes = {}
		end

		local index = #entries + 1
		table.insert(entries, {
			id = "bulk-kfs:" .. tostring(index),
			entryType = "BulkKeyframeSequence",
			name = sequence.Name ~= "" and sequence.Name or ("KeyframeSequence " .. tostring(index)),
			source = "Selected KeyframeSequences",
			category = "Bulk Import",
			rigType = ImportService.detectRigTypeFromAnimationClip(sequence),
			keyframeCount = #keyframes,
			instancePath = getInstancePath(sequence),
			sequence = sequence,
		})
	end

	for _, instance in ipairs(selected) do
		if #entries &gt;= maxEntries then
			break
		end

		if instance and instance:IsA("KeyframeSequence") then
			addSequence(instance)
		end

		if instance then
			for _, descendant in ipairs(instance:GetDescendants()) do
				if #entries &gt;= maxEntries then
					break
				end
				if descendant:IsA("KeyframeSequence") then
					addSequence(descendant)
				end
			end
		end
	end

	table.sort(entries, function(a, b)
		local aPath = tostring(a.instancePath or a.name or "")
		local bPath = tostring(b.instancePath or b.name or "")
		return aPath &lt; bPath
	end)

	for index, entry in ipairs(entries) do
		entry.id = "bulk-kfs:" .. tostring(index)
	end

	if #entries == 0 then
		return entries, "No KeyframeSequences were found inside the current Explorer selection."
	end

	local capped = #entries &gt;= maxEntries and " Showing the first 200." or ""
	return entries, string.format("Found %d KeyframeSequence%s in the current selection.%s Click one to import it at the playhead.", #entries, #entries == 1 and "" or "s", capped)
end

local function makeMyAnimationsDisplayEntries(session)
	local entries = {}
	for _, entry in ipairs(session and session.entries or {}) do
		table.insert(entries, entry)
	end

	sortEntriesNewestFirst(entries)

	local displayLimit = tonumber(session and session.displayLimit) or MY_ANIMATIONS_PAGE_SIZE
	local totalCount = countImportableAnimationEntries(entries)
	if #entries &gt; displayLimit then
		local limitedEntries = {}
		for index = 1, math.min(displayLimit, #entries) do
			table.insert(limitedEntries, entries[index])
		end
		entries = limitedEntries
	end

	if session and (session.hasMorePages or totalCount &gt; countImportableAnimationEntries(entries)) then
		table.insert(entries, makeLoadMoreMyAnimationsEntry(countImportableAnimationEntries(entries)))
	end

	return entries
end

local function getCachedMyAnimationsDisplayEntries()
	if not myAnimationsSession then
		return nil
	end
	return makeMyAnimationsDisplayEntries(myAnimationsSession)
end

local function readMyAnimationsPages(session, options)
	if not session or not session.pages then
		return false, "My Animations is not loaded yet. Click My Animations first."
	end

	options = options or {}
	local maxAdded = tonumber(options.maxAdded)
	local readAll = options.readAll == true
	local pageReadSuccess, pageReadError = pcall(function()
		local added = 0
		while true do
			local pageItems = session.pages:GetCurrentPage()
			for _, item in ipairs(pageItems) do
				local entry = ImportService.getInventoryAnimationEntry(item)
				if entry and not session.seen[entry.id] then
					session.seen[entry.id] = true
					session.order += 1
					entry.pageOrder = session.order
					table.insert(session.entries, entry)
					added += 1
					if not readAll and maxAdded and added &gt;= maxAdded then
						break
					end
				end
			end

			if session.pages.IsFinished then
				session.scannedAllPages = true
				break
			end
			if not readAll and maxAdded and added &gt;= maxAdded then
				break
			end
			session.pages:AdvanceToNextPageAsync()
		end

		session.hasMorePages = not session.pages.IsFinished
	end)

	if not pageReadSuccess then
		return false, "Could not read your animations: " .. tostring(pageReadError)
	end

	session.hasMore = session.hasMorePages
		or countImportableAnimationEntries(session.entries) &gt; (tonumber(session.displayLimit) or session.pageSize)
	sortEntriesNewestFirst(session.entries)
	return true, makeMyAnimationsDisplayEntries(session)
end

function ImportService.loadMyAnimations(options)
	options = options or {}
	local userId = 0
	local userSuccess, userResult = pcall(function()
		return StudioService:GetUserId()
	end)
	if userSuccess then
		userId = tonumber(userResult) or 0
	end
	if userId &lt;= 0 then
		return false, "Studio is not logged into a Roblox account, so your animations cannot be listed."
	end

	if not options.forceRefresh
		and myAnimationsSession
		and myAnimationsSession.userId == userId
		and #myAnimationsSession.entries &gt; 0
	then
		return true, getCachedMyAnimationsDisplayEntries(), true
	end

	local pagesSuccess, pagesOrError = pcall(function()
		return AnimationClipProvider:GetAnimationsAsync(userId)
	end)
	if not pagesSuccess or not pagesOrError then
		return false, "Could not load your animations: " .. tostring(pagesOrError)
	end

	myAnimationsSession = {
		displayLimit = tonumber(options.pageSize) or MY_ANIMATIONS_PAGE_SIZE,
		entries = {},
		hasMore = false,
		hasMorePages = false,
		order = 0,
		pageSize = tonumber(options.pageSize) or MY_ANIMATIONS_PAGE_SIZE,
		pages = pagesOrError,
		scannedAllPages = false,
		seen = {},
		userId = userId,
	}

	local initialScanLimit = tonumber(options.scanSize)
		or tonumber(options.maxAdded)
		or MY_ANIMATIONS_INITIAL_SCAN_SIZE
	local maxAdded = initialScanLimit
	if options.readAll == true then
		maxAdded = tonumber(options.maxAdded)
	end

	return readMyAnimationsPages(myAnimationsSession, {
		readAll = options.readAll == true,
		maxAdded = maxAdded,
	})
end

function ImportService.loadMoreMyAnimations()
	if not myAnimationsSession then
		return false, "My Animations is not loaded yet. Click My Animations first."
	end

	myAnimationsSession.displayLimit = (tonumber(myAnimationsSession.displayLimit) or myAnimationsSession.pageSize) + myAnimationsSession.pageSize
	if myAnimationsSession.hasMorePages then
		local success, entriesOrMessage = readMyAnimationsPages(myAnimationsSession, {
			readAll = false,
			maxAdded = myAnimationsSession.pageSize,
		})
		if not success then
			return false, entriesOrMessage
		end
	end
	myAnimationsSession.hasMore = myAnimationsSession.hasMorePages
		or countImportableAnimationEntries(myAnimationsSession.entries) &gt; myAnimationsSession.displayLimit
	return true, makeMyAnimationsDisplayEntries(myAnimationsSession)
end

function ImportService.hasMoreMyAnimations()
	return myAnimationsSession
		and (myAnimationsSession.hasMorePages
			or countImportableAnimationEntries(myAnimationsSession.entries) &gt; (tonumber(myAnimationsSession.displayLimit) or MY_ANIMATIONS_PAGE_SIZE))
end

function ImportService.hasCachedMyAnimations()
	return myAnimationsSession and #myAnimationsSession.entries &gt; 0
end

function ImportService.countImportableAnimationEntries(entries)
	return countImportableAnimationEntries(entries)
end

function ImportService.searchMyAnimations(query)
	query = tostring(query or "")
	query = string.gsub(query, "^%s+", "")
	query = string.gsub(query, "%s+$", "")

	if not myAnimationsSession or #myAnimationsSession.entries == 0 then
		local success, entriesOrMessage = ImportService.loadMyAnimations()
		if not success then
			return nil, entriesOrMessage
		end
	end

	if query == "" then
		return makeMyAnimationsDisplayEntries(myAnimationsSession), ""
	end

	local loweredQuery = string.lower(query)
	local entries = {}
	for _, entry in ipairs(myAnimationsSession.entries or {}) do
		local haystack = table.concat({
			string.lower(tostring(entry.name or "")),
			string.lower(tostring(entry.numericId or "")),
			string.lower(tostring(entry.id or "")),
			string.lower(tostring(entry.category or "")),
			string.lower(tostring(entry.source or "")),
		}, "\n")
		if string.find(haystack, loweredQuery, 1, true) then
			table.insert(entries, entry)
		end
	end

	sortEntriesNewestFirst(entries)
	if myAnimationsSession.hasMore then
		table.insert(entries, makeLoadMoreMyAnimationsEntry(countImportableAnimationEntries(myAnimationsSession.entries)))
	end

	return entries, query
end

function ImportService.resolveAnimationEntryNames(entries, onProgress)
	for index, entry in ipairs(entries or {}) do
		if entry.entryType ~= "LoadMoreMyAnimations" then
			local shouldResolve = entry._resolvedAssetInfo ~= true
				or isGenericInventoryAnimationName(entry.name, entry.numericId)
				or not entry.sortTimestamp
			if shouldResolve then
				local info = resolveAnimationAssetInfo(entry)
				if info then
					entry.name = info.name or entry.name
					entry.createdTimestamp = info.createdTimestamp or entry.createdTimestamp
					entry.updatedTimestamp = info.updatedTimestamp or entry.updatedTimestamp
					entry.sortTimestamp = info.sortTimestamp or entry.sortTimestamp
				end
				entry._resolvedAssetInfo = true
			end
		end
		if onProgress and index % 10 == 0 then
			onProgress(index, #entries)
		end
	end

	sortEntriesNewestFirst(entries)
	if myAnimationsSession and type(myAnimationsSession.entries) == "table" then
		sortEntriesNewestFirst(myAnimationsSession.entries)
	end
end

function ImportService.loadPresetEntries()
	local entries = {}
	for _, entry in ipairs(PRESET_ANIMATION_LIBRARY) do
		table.insert(entries, makeImportEntry(entry.id, entry.name, entry))
	end
	return entries, #CURATED_ANIMATION_PACKS
end

function ImportService.findImportEntryById(entries, input)
	local _, numericId = ImportService.normalizeAnimationContentId(input)
	if not numericId then
		return nil
	end

	for _, entry in ipairs(entries or {}) do
		if tostring(entry.numericId or "") == tostring(numericId) then
			return entry
		end
	end

	return nil
end

function ImportService.getMotionBuilderCategory(entry)
	if type(entry) ~= "table" then
		return nil
	end

	local category = normalizeMotionBuilderCategory(entry.category)
	if category then
		return category
	end

	return normalizeMotionBuilderCategory(findActionFromText(entry.name))
end

function ImportService.getCustomEntriesForCategory(entries, category, rigType)
	category = normalizeMotionBuilderCategory(category)
	rigType = tostring(rigType or "")
	local results = {}
	local seen = {}
	if not category then
		return results
	end

	for _, entry in ipairs(entries or {}) do
		local _, numericId = ImportService.normalizeAnimationContentId(entry and (entry.id or entry.numericId))
		local entryCategory = ImportService.getMotionBuilderCategory(entry)
		local entryRigType = tostring(entry and entry.rigType or "")
		local isSavedProject = entry and entry.entryType == "SavedProject"
		if numericId
			and (entryCategory == category or entryCategory == nil)
			and not isSavedProject
			and not seen[numericId]
			and (entryRigType == "" or rigType == "" or entryRigType == rigType)
		then
			seen[numericId] = true
			table.insert(results, makeImportEntry(numericId, tostring(entry.name or ("Animation " .. numericId)), {
				source = entry.source or "My Animations",
				creatorName = entry.creatorName,
				category = category,
				pack = entry.pack,
				rigType = entry.rigType,
				priceLabel = entry.priceLabel,
			}))
		end
	end

	table.sort(results, function(a, b)
		local aSource = tostring(a.source or "")
		local bSource = tostring(b.source or "")
		if aSource ~= bSource then
			return aSource &lt; bSource
		end
		return tostring(a.name or "") &lt; tostring(b.name or "")
	end)
	return results
end

function ImportService.findCustomEntryById(entries, input, expectedCategory, expectedRigType)
	local _, numericId = ImportService.normalizeAnimationContentId(input)
	if not numericId then
		return nil
	end

	local entry = ImportService.findImportEntryById(entries, numericId)
	if not entry or entry.entryType == "SavedProject" then
		return nil
	end

	local category = ImportService.getMotionBuilderCategory(entry)
	expectedCategory = normalizeMotionBuilderCategory(expectedCategory)
	expectedRigType = tostring(expectedRigType or "")
	local entryRigType = tostring(entry.rigType or "")
	if expectedCategory and category and category ~= expectedCategory then
		return nil
	end
	if expectedRigType ~= "" and entryRigType ~= "" and entryRigType ~= expectedRigType then
		return nil
	end

	return makeImportEntry(numericId, tostring(entry.name or ("Animation " .. numericId)), {
		source = entry.source or "My Animations",
		creatorName = entry.creatorName,
		category = expectedCategory or category,
		pack = entry.pack,
		rigType = entry.rigType,
		priceLabel = entry.priceLabel,
	})
end

function ImportService.findPresetCompanionEntry(entry, targetCategory)
	if type(entry) ~= "table" or type(targetCategory) ~= "string" then
		return nil
	end

	local targetPack = tostring(entry.pack or "")
	local targetRigType = tostring(entry.rigType or "")
	if targetPack == "" then
		return nil
	end

	for _, candidate in ipairs(PRESET_ANIMATION_LIBRARY) do
		if tostring(candidate.pack or "") == targetPack
			and tostring(candidate.rigType or "") == targetRigType
			and tostring(candidate.category or "") == targetCategory
		then
			return makeImportEntry(candidate.id, candidate.name, candidate)
		end
	end

	return nil
end

function ImportService.findDefaultPresetEntry(category, rigType)
	category = normalizeMotionBuilderCategory(category) or tostring(category or "")
	rigType = tostring(rigType or "")
	if category == "" then
		return nil
	end
	if category == "Action" then
		return nil
	end

	for _, candidate in ipairs(PRESET_ANIMATION_LIBRARY) do
		if normalizeMotionBuilderCategory(candidate.category) == category
			and (rigType == "" or tostring(candidate.rigType or "") == rigType)
		then
			return makeImportEntry(candidate.id, candidate.name, candidate)
		end
	end

	return nil
end

function ImportService.getPresetEntriesForCategory(category, rigType)
	category = normalizeMotionBuilderCategory(category) or tostring(category or "")
	rigType = tostring(rigType or "")
	local entries = {}
	if category == "" then
		return entries
	end

	for _, candidate in ipairs(PRESET_ANIMATION_LIBRARY) do
		local candidateCategory = normalizeMotionBuilderCategory(candidate.category) or normalizeMotionBuilderCategory(findActionFromText(candidate.name))
		if candidateCategory == category
			and (rigType == "" or tostring(candidate.rigType or "") == rigType)
		then
			table.insert(entries, makeImportEntry(candidate.id, candidate.name, candidate))
		end
	end

	table.sort(entries, function(a, b)
		local aPack = tostring(a.pack or "")
		local bPack = tostring(b.pack or "")
		if aPack ~= bPack then
			return aPack &lt; bPack
		end
		return tostring(a.name or "") &lt; tostring(b.name or "")
	end)
	return entries
end

function ImportService.findPresetEntryById(input, expectedCategory, expectedRigType)
	local _, numericId = ImportService.normalizeAnimationContentId(input)
	if not numericId then
		return nil
	end

	expectedCategory = normalizeMotionBuilderCategory(expectedCategory) or tostring(expectedCategory or "")
	expectedRigType = tostring(expectedRigType or "")
	for _, candidate in ipairs(PRESET_ANIMATION_LIBRARY) do
		local candidateCategory = normalizeMotionBuilderCategory(candidate.category) or normalizeMotionBuilderCategory(findActionFromText(candidate.name))
		if tostring(candidate.id or "") == tostring(numericId)
			and (expectedCategory == "" or candidateCategory == expectedCategory)
			and (expectedRigType == "" or tostring(candidate.rigType or "") == expectedRigType)
		then
			return makeImportEntry(candidate.id, candidate.name, candidate)
		end
	end

	return nil
end

function ImportService.getLocomotionSpeed(action)
	return LOCOMOTION_SPEEDS[action]
end

function ImportService.getLocomotionProfile(entry, clip)
	local action = nil
	if type(entry) == "table" then
		action = entry.category or findActionFromText(entry.name)
	end
	if not action and clip then
		action = findActionFromText(clip.Name)
	end
	action = action or nil

	if action == "Swim Idle" or action == "Idle" or action == "Jump" or action == "Fall" then
		return nil
	end

	local speedStudsPerSecond = LOCOMOTION_SPEEDS[action]
	if not speedStudsPerSecond then
		return nil
	end

	return {
		action = action,
		speedStudsPerSecond = speedStudsPerSecond,
	}
end

function ImportService.searchCatalogEntries(query)
	query = tostring(query or "")
	query = string.gsub(query, "^%s+", "")
	query = string.gsub(query, "%s+$", "")
	if query == "" then
		local entries, _ = ImportService.loadPresetEntries()
		return entries, ""
	end

	local loweredQuery = string.lower(query)
	local entries = {}
	for _, entry in ipairs(PRESET_ANIMATION_LIBRARY) do
		local haystack = table.concat({
			string.lower(tostring(entry.name or "")),
			string.lower(tostring(entry.pack or "")),
			string.lower(tostring(entry.category or "")),
			string.lower(tostring(entry.creatorName or "")),
			string.lower(tostring(entry.source or "")),
		}, "\n")
		if string.find(haystack, loweredQuery, 1, true) then
			table.insert(entries, makeImportEntry(entry.id, entry.name, entry))
		end
	end

	table.sort(entries, function(a, b)
		local aPack = tostring(a.pack or "")
		local bPack = tostring(b.pack or "")
		if aPack ~= bPack then
			return aPack &lt; bPack
		end
		local aCategory = tostring(a.category or "")
		local bCategory = tostring(b.category or "")
		if aCategory ~= bCategory then
			return aCategory &lt; bCategory
		end
		return tostring(a.name or "") &lt; tostring(b.name or "")
	end)

	return entries, query
end

return ImportService
