		timeline = timeline,
		modules = Modules,
		refreshUi = refreshUi,
		updateOnionSkinPreview = updateOnionSkinPreview,
		editorActions = editorActions,
		cameraTrackService = CameraTrackService,
	}, offset)
end

local function jumpToPreviousKeyframe()
	local previousFrame, message = require(Modules:WaitForChild("KeyframeNavigationSupport")).getPreviousKeyframeResult(timeline)
	if previousFrame == nil then
		refreshUi(message)
		return
	end

	timeline:setCurrentFrame(previousFrame)
	setSingleSelectedKeyframe(previousFrame)
	timeline:applyCurrentFrame()
	refreshUi(message)
end

editorActions.previousKeyframe = jumpToPreviousKeyframe

local function jumpToNextKeyframe()
	local nextFrame, message = require(Modules:WaitForChild("KeyframeNavigationSupport")).getNextKeyframeResult(timeline)
	if nextFrame == nil then
		refreshUi(message)
		return
	end

	timeline:setCurrentFrame(nextFrame)
	setSingleSelectedKeyframe(nextFrame)
	timeline:applyCurrentFrame()
	refreshUi(message)
