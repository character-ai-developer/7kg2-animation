</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX10">
          <Properties>
            <string name="Name">FaceTimelineAdapter</string>
            <ProtectedString name="Source">local ContentProvider = game:GetService("ContentProvider")

local FaceTimelineAdapter = {}
FaceTimelineAdapter.__index = FaceTimelineAdapter

local LAYER_ORDER = {
	"BothEyes",
	"LeftEye",
	"RightEye",
	"Mouth",
	"LeftEyebrow",
	"RightEyebrow",
}
local TRANSFORM_KEYS = { "X", "Y", "Scale" }

local function collectImageIds(keyframes)
	local imageIds = {}
	local seen = {}
	local function addImageId(imageId)
		if type(imageId) == "string" and imageId ~= "" and not seen[imageId] then
			seen[imageId] = true
			table.insert(imageIds, imageId)
		end
	end

	for _, keyframe in ipairs(keyframes or {}) do
		addImageId(keyframe.ImageId)
		for _, layerName in ipairs(LAYER_ORDER) do
			addImageId(keyframe.Layers and keyframe.Layers[layerName])
		end
	end
	return imageIds
end

local function cloneTable(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = cloneTable(child)
	end
	return result
end

local function getFps(timeline)
	if timeline and type(timeline.getFps) == "function" then
		return math.max(1, tonumber(timeline:getFps()) or 30)
	end
	return 30
end

local function frameToTime(timeline, frame)
	return (tonumber(frame) or 0) / getFps(timeline)
end

local function timeToFrame(timeline, time)
	return math.max(0, math.floor(((tonumber(time) or 0) * getFps(timeline)) + 0.5))
end

local function hasPresetImages(preset)
	if type(preset) ~= "table" then
		return false
	end
	if preset.Type == "Single" then
		return type(preset.ImageId) == "string" and preset.ImageId ~= ""
	end
	if preset.Type == "Layered" and type(preset.Layers) == "table" then
		for _, layerName in ipairs(LAYER_ORDER) do
			if type(preset.Layers[layerName]) == "string" and preset.Layers[layerName] ~= "" then
				return true
			end
		end
	end
	return false
end

local function snapshotPreset(preset)
	local snapshot = {
		PresetName = preset.Name,
		PresetId = preset.Id,
		Type = preset.Type,
	}
	if preset.Type == "Layered" then
		snapshot.Layers = {}
		for _, layerName in ipairs(LAYER_ORDER) do
			local imageId = preset.Layers and preset.Layers[layerName]
			if type(imageId) == "string" and imageId ~= "" then
				snapshot.Layers[layerName] = imageId
			end
		end
		if type(preset.LayerTransforms) == "table" then
			snapshot.LayerTransforms = cloneTable(preset.LayerTransforms)
		end
	else
		snapshot.ImageId = preset.ImageId
	end
	return snapshot
end

local function copyLayerTransforms(rawTransforms, layers)
	if type(rawTransforms) ~= "table" then
		return nil
	end
	local transforms = {}
	local hasTransforms = false
	for _, layerName in ipairs(LAYER_ORDER) do
		if type(layers) ~= "table" or layers[layerName] ~= nil then
			local raw = rawTransforms[layerName]
			if type(raw) == "table" then
				local transform = {}
				local hasValue = false
				for _, key in ipairs(TRANSFORM_KEYS) do
					local value = tonumber(raw[key] or raw[string.lower(key)])
					if value ~= nil then
						transform[key] = value
						hasValue = true
					end
				end
				if hasValue then
					transforms[layerName] = transform
					hasTransforms = true
				end
			end
		end
	end
	return hasTransforms and transforms or nil
end

local function makeKeyframeFromTrackValue(timeline, track, frame, value)
	if type(value) ~= "table" then
		return nil
	end
	if value.type ~= "Face" and value.faceType == nil and value.imageId == nil and value.layers == nil then
		return nil
	end

	local faceType = value.faceType == "Layered" and "Layered" or "Single"
	local keyframe = {
		Frame = math.max(0, math.floor(tonumber(frame) or 0)),
		Character = tostring(value.character or value.Character or track.rigName or ""),
		PresetName = tostring(value.presetName or value.PresetName or track.name or "Face"),
		PresetId = tostring(value.presetId or value.PresetId or ""),
		Type = faceType,
		Transition = value.transition == "CrossFade" and "CrossFade" or "Instant",
		FadeTime = math.max(0, tonumber(value.fadeTime or value.FadeTime) or 0),
	}
	keyframe.Time = frameToTime(timeline, keyframe.Frame)

	if faceType == "Layered" then
		keyframe.Layers = {}
		for _, layerName in ipairs(LAYER_ORDER) do
			local imageId = type(value.layers) == "table" and value.layers[layerName] or nil
			if type(imageId) == "string" and imageId ~= "" then
				keyframe.Layers[layerName] = imageId
			end
		end
		if not hasPresetImages(keyframe) then
			return nil
		end
		keyframe.LayerTransforms = copyLayerTransforms(value.layerTransforms or value.LayerTransforms, keyframe.Layers)
	else
		keyframe.ImageId = value.imageId or value.ImageId
		if not hasPresetImages(keyframe) then
			return nil
		end
	end

	return keyframe
end

local function normalizeKeyframe(rawKeyframe, timeline)
	if type(rawKeyframe) ~= "table" then
		return nil
	end

	local frame = tonumber(rawKeyframe.Frame)
	if frame == nil then
		frame = timeToFrame(timeline, rawKeyframe.Time)
	end
	frame = math.max(0, math.floor(frame + 0.5))

	local normalized = {
		Frame = frame,
		Time = tonumber(rawKeyframe.Time) or frameToTime(timeline, frame),
		Character = tostring(rawKeyframe.Character or rawKeyframe.RigName or ""),
		PresetName = tostring(rawKeyframe.PresetName or "Face"),
		PresetId = tostring(rawKeyframe.PresetId or ""),
		Type = rawKeyframe.Type == "Layered" and "Layered" or "Single",
		Transition = rawKeyframe.Transition == "CrossFade" and "CrossFade" or "Instant",
		FadeTime = math.max(0, tonumber(rawKeyframe.FadeTime) or 0),
	}

	if normalized.Type == "Layered" then
		normalized.Layers = {}
		for _, layerName in ipairs(LAYER_ORDER) do
			local imageId = type(rawKeyframe.Layers) == "table" and rawKeyframe.Layers[layerName] or nil
			if type(imageId) == "string" and imageId ~= "" then
				normalized.Layers[layerName] = imageId
			end
		end
		if not hasPresetImages(normalized) then
			return nil
		end
		normalized.LayerTransforms = copyLayerTransforms(rawKeyframe.LayerTransforms or rawKeyframe.layerTransforms, normalized.Layers)
	else
		normalized.ImageId = rawKeyframe.ImageId
		if not hasPresetImages(normalized) then
			return nil
		end
	end

	return normalized
end

local function makeSignature(keyframe)
	if not keyframe then
		return ""
	end
	local parts = {
		tostring(keyframe.Character or ""),
		tostring(keyframe.Frame or 0),
		tostring(keyframe.Type or ""),
		tostring(keyframe.Transition or ""),
		tostring(keyframe.FadeTime or 0),
		tostring(keyframe.ImageId or ""),
	}
	if type(keyframe.Layers) == "table" then
		for _, layerName in ipairs(LAYER_ORDER) do
			table.insert(parts, layerName .. "=" .. tostring(keyframe.Layers[layerName] or ""))
			local transform = type(keyframe.LayerTransforms) == "table" and keyframe.LayerTransforms[layerName] or nil
			if type(transform) == "table" then
				table.insert(parts, layerName .. ".x=" .. tostring(transform.X or ""))
				table.insert(parts, layerName .. ".y=" .. tostring(transform.Y or ""))
				table.insert(parts, layerName .. ".scale=" .. tostring(transform.Scale or ""))
			end
		end
	end
	return table.concat(parts, "|")
end

local function findFaceTrackByRig(timeline, rigName)
	if not timeline or type(timeline.getTracks) ~= "function" then
		return nil
	end
	for _, track in ipairs(timeline:getTracks() or {}) do
		if (track.trackType == "Face" or track.valueType == "Face") and track.rigName == rigName then
			return track
		end
	end
	return nil
end

function FaceTimelineAdapter.new()
	return setmetatable({
		_keyframes = {},
		_lastAppliedByCharacter = {},
		_syncedTimelineSignature = "",
		_preloadedImageIds = {},
		_preloadingImageIds = {},
		_preloadGeneration = 0,
	}, FaceTimelineAdapter)
end

function FaceTimelineAdapter:_preloadTimelineImages(keyframes)
	local pendingIds = {}
	for _, imageId in ipairs(collectImageIds(keyframes)) do
		if not self._preloadedImageIds[imageId] and not self._preloadingImageIds[imageId] then
			self._preloadingImageIds[imageId] = true
			table.insert(pendingIds, imageId)
		end
	end
	if #pendingIds == 0 then
		return
	end

	local generation = self._preloadGeneration
	task.spawn(function()
		local preloadTargets = {}
		for _, imageId in ipairs(pendingIds) do
			local image = Instance.new("ImageLabel")
			image.Image = imageId
			table.insert(preloadTargets, image)
		end

		local loaded = pcall(function()
			ContentProvider:PreloadAsync(preloadTargets)
		end)
		for _, image in ipairs(preloadTargets) do
			image:Destroy()
		end

		if generation ~= self._preloadGeneration then
			return
		end
		for _, imageId in ipairs(pendingIds) do
			self._preloadingImageIds[imageId] = nil
			if loaded then
				self._preloadedImageIds[imageId] = true
			end
		end
	end)
end

function FaceTimelineAdapter:getCurrentTime(timeline)
	if not timeline or type(timeline.getCurrentFrame) ~= "function" then
		return 0
	end
	return frameToTime(timeline, timeline:getCurrentFrame())
end

function FaceTimelineAdapter:addFaceKeyframe(timeline, rig, preset, transition, fadeTime)
	if not hasPresetImages(preset) then
		return false, "This preset has no valid image IDs."
	end

	local frame = timeline and timeline:getCurrentFrame() or 0
	local keyframe = snapshotPreset(preset)
	keyframe.Frame = math.max(0, math.floor((tonumber(frame) or 0) + 0.5))
	keyframe.Time = frameToTime(timeline, keyframe.Frame)
	keyframe.Character = rig and rig.Name or ""
	keyframe.Transition = transition == "CrossFade" and "CrossFade" or "Instant"
	keyframe.FadeTime = keyframe.Transition == "CrossFade" and math.max(0, tonumber(fadeTime) or 0.15) or 0

	for index, existing in ipairs(self._keyframes) do
		if existing.Character == keyframe.Character and existing.Frame == keyframe.Frame then
			self._keyframes[index] = keyframe
			self:_preloadTimelineImages({ keyframe })
			return true, keyframe
		end
	end

	table.insert(self._keyframes, keyframe)
	table.sort(self._keyframes, function(a, b)
		if (a.Frame or 0) ~= (b.Frame or 0) then
			return (a.Frame or 0) &lt; (b.Frame or 0)
		end
		return tostring(a.Character or "") &lt; tostring(b.Character or "")
	end)

	self:_preloadTimelineImages({ keyframe })
	return true, keyframe
end

function FaceTimelineAdapter:getFaceKeyframes()
	return cloneTable(self._keyframes)
end

function FaceTimelineAdapter:syncFromTimeline(timeline)
	if not timeline or type(timeline.getTracks) ~= "function" then
		return false
	end

	local keyframes = {}
	local signatureParts = {}
	for _, track in ipairs(timeline:getTracks()) do
		if track.trackType == "Face" or track.valueType == "Face" then
			local frames = timeline.getTrackKeyframeFrames and timeline:getTrackKeyframeFrames(track.path) or {}
			local refs = {}
			for _, frame in ipairs(frames) do
				table.insert(refs, {
					jointPath = track.path,
					frame = frame,
				})
			end

			local values = timeline.getTrackKeyValues and timeline:getTrackKeyValues(refs) or {}
			for _, key in ipairs(values) do
				local keyframe = makeKeyframeFromTrackValue(timeline, track, key.frame, key.value)
				if keyframe then
					table.insert(keyframes, keyframe)
					table.insert(signatureParts, makeSignature(keyframe))
				end
			end
		end
	end

	table.sort(keyframes, function(a, b)
		if (a.Frame or 0) ~= (b.Frame or 0) then
			return (a.Frame or 0) &lt; (b.Frame or 0)
		end
		return tostring(a.Character or "") &lt; tostring(b.Character or "")
	end)
	table.sort(signatureParts)

	local signature = table.concat(signatureParts, "\n")
	if signature == self._syncedTimelineSignature then
		return true
	end
	self._keyframes = keyframes
	self._lastAppliedByCharacter = {}
	self._syncedTimelineSignature = signature
	self:_preloadTimelineImages(keyframes)
	return true
end

function FaceTimelineAdapter:clear()
	self._preloadGeneration += 1
	self._keyframes = {}
	self._lastAppliedByCharacter = {}
	self._syncedTimelineSignature = ""
	self._preloadedImageIds = {}
	self._preloadingImageIds = {}
end

function FaceTimelineAdapter:removeFaceKeyframe(character, frame)
	frame = math.max(0, math.floor(tonumber(frame) or 0))
	for index = #self._keyframes, 1, -1 do
		local keyframe = self._keyframes[index]
		if keyframe.Character == character and keyframe.Frame == frame then
			table.remove(self._keyframes, index)
			self._lastAppliedByCharacter[character] = nil
			return true
		end
	end
	return false
end

function FaceTimelineAdapter:updateFaceKeyframe(character, frame, updates)
	frame = math.max(0, math.floor(tonumber(frame) or 0))
	for _, keyframe in ipairs(self._keyframes) do
		if keyframe.Character == character and keyframe.Frame == frame then
			for key, value in pairs(updates or {}) do
				keyframe[key] = cloneTable(value)
			end
			self._lastAppliedByCharacter[character] = nil
			return true
		end
	end
	return false
end

function FaceTimelineAdapter:getSaveData()
	return {
		version = 1,
		keyframes = cloneTable(self._keyframes),
	}
end

function FaceTimelineAdapter:restoreSaveData(data, timeline)
	self:clear()
	local rawKeyframes = nil
	if type(data) == "table" then
		rawKeyframes = data.keyframes or data.Keyframes or data.Faces or data
	end
	if type(rawKeyframes) ~= "table" then
		return
	end

	for _, rawKeyframe in ipairs(rawKeyframes) do
		local keyframe = normalizeKeyframe(rawKeyframe, timeline)
		if keyframe then
			table.insert(self._keyframes, keyframe)
		end
	end

	table.sort(self._keyframes, function(a, b)
		return (a.Frame or 0) &lt; (b.Frame or 0)
	end)
end

function FaceTimelineAdapter:findFaceForRigAtFrame(rigName, frame)
	local best = nil
	for _, keyframe in ipairs(self._keyframes) do
		if keyframe.Character == rigName and (keyframe.Frame or 0) &lt;= frame then
			best = keyframe
		elseif (keyframe.Frame or 0) &gt; frame then
			break
		end
	end
	return best
end

function FaceTimelineAdapter:applyFaceAtTime(timeline, rigAdapter, frame)
	if not rigAdapter then
		return
	end

	local targetFrame = math.max(0, math.floor((tonumber(frame) or (timeline and timeline:getCurrentFrame()) or 0) + 0.5))
	local rigs = timeline and timeline.getRigs and timeline:getRigs() or {}
	for _, rig in ipairs(rigs) do
		if rig and rig.Parent then
			local keyframe = self:findFaceForRigAtFrame(rig.Name, targetFrame)
			local signature = makeSignature(keyframe)
			if keyframe and self._lastAppliedByCharacter[rig.Name] ~= signature then
				if keyframe.Type == "Layered" then
					rigAdapter.ApplyLayeredFace(rig, keyframe.Layers, keyframe.Transition, keyframe.FadeTime, keyframe.LayerTransforms)
				else
					rigAdapter.ApplySingleFace(rig, keyframe.ImageId, keyframe.Transition, keyframe.FadeTime)
				end
				self._lastAppliedByCharacter[rig.Name] = signature
			elseif not keyframe then
				local faceTrack = findFaceTrackByRig(timeline, rig.Name)
				local originalValue = faceTrack and faceTrack.originalValue or nil
				local originalSignature = "default|" .. tostring(originalValue)
				if originalValue and self._lastAppliedByCharacter[rig.Name] ~= originalSignature then
					if rigAdapter.RestoreFaceState(rig, originalValue) then
						self._lastAppliedByCharacter[rig.Name] = originalSignature
					end
				end
			end
		end
	end
end

function FaceTimelineAdapter:restoreDefaultFaces(timeline, rigAdapter)
	if not timeline or not rigAdapter or type(timeline.getRigs) ~= "function" then
		return false
	end

	local restored = false
	for _, rig in ipairs(timeline:getRigs() or {}) do
		if rig and rig.Parent then
			local faceTrack = findFaceTrackByRig(timeline, rig.Name)
			if faceTrack and faceTrack.originalValue then
				restored = rigAdapter.RestoreFaceState(rig, faceTrack.originalValue) or restored
				self._lastAppliedByCharacter[rig.Name] = nil
			end
		end
	end
	return restored
end

return FaceTimelineAdapter
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX11">
        <Properties>
          <string name="Name">Physics</string>
        </Properties>
        <Item class="Folder" referent="RBX12">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX13">
            <Properties>
              <string name="Name">AdaptiveWalkRuntime</string>
              <ProtectedString name="Source">local AnimatedPathRuntime = require(script.Parent:WaitForChild("AnimatedPathRuntime"))

local AdaptiveWalkRuntime = {}

local function captureRigPose(rig)
	local pose = {
		parts = {},
		motors = {},
	}
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(pose.parts, {
				part = descendant,
				cframe = descendant.CFrame,
				anchored = descendant.Anchored,
			})
		elseif descendant:IsA("Motor6D") then
			table.insert(pose.motors, {
				motor = descendant,
				c0 = descendant.C0,
				c1 = descendant.C1,
				transform = descendant.Transform,
			})
		end
	end
	return pose
end

local function restoreRigPose(pose, root, targetRootCFrame)
	if not pose then
		return
	end
	local worldDelta = CFrame.identity
	if root and typeof(targetRootCFrame) == "CFrame" then
		for _, item in ipairs(pose.parts or {}) do
			if item.part == root and typeof(item.cframe) == "CFrame" then
				worldDelta = targetRootCFrame * item.cframe:Inverse()
				break
			end
		end
	end
	for _, item in ipairs(pose.parts or {}) do
		if item.part and item.part.Parent then
			item.part.Anchored = true
			item.part.AssemblyLinearVelocity = Vector3.zero
			item.part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	for _, item in ipairs(pose.motors or {}) do
		if item.motor and item.motor.Parent then
			item.motor.C0 = item.c0
			item.motor.C1 = item.c1
			item.motor.Transform = item.transform
		end
	end
	for _, item in ipairs(pose.parts or {}) do
		if item.part and item.part.Parent then
			item.part.CFrame = worldDelta * item.cframe
		end
	end
	for _, item in ipairs(pose.parts or {}) do
		if item.part and item.part.Parent then
			item.part.Anchored = item.anchored
		end
	end
end

local function restoreCompletedNeutralPose(session, targetRootCFrame)
	local pose = session and session.originalPose
	local pathSession = session and session.pathSession
	local neutralJoints = pathSession and pathSession.pathData and pathSession.pathData.neutralJoints
	if not (pose and session.root and session.root.Parent and typeof(targetRootCFrame) == "CFrame") then
		return false
	end

	local neutralByMotor = {}
	if type(neutralJoints) == "table" then
		for index, motor in ipairs(pathSession.motors or {}) do
			local value = neutralJoints[index]
			if motor and motor.Parent and typeof(value) == "CFrame" then
				neutralByMotor[motor] = value
			end
		end
	end

	local partState = {}
	for _, item in ipairs(pose.parts or {}) do
		if item.part and item.part.Parent then
			partState[item.part] = item
			item.part.Anchored = true
			item.part.AssemblyLinearVelocity = Vector3.zero
			item.part.AssemblyAngularVelocity = Vector3.zero
		end
	end

	for _, item in ipairs(pose.motors or {}) do
		if item.motor and item.motor.Parent then
			item.motor.C0 = neutralByMotor[item.motor] or item.c0
			item.motor.C1 = item.c1
			item.motor.Transform = CFrame.identity
		end
	end

	session.root.CFrame = targetRootCFrame
	local positioned = {
		[session.root] = true,
	}
	for _ = 1, #(pose.motors or {}) do
		local changed = false
		for _, item in ipairs(pose.motors or {}) do
			local motor = item.motor
			local part0 = motor and motor.Part0
			local part1 = motor and motor.Part1
			if motor and motor.Parent and part0 and part1 then
				if positioned[part0] and not positioned[part1] then
					part1.CFrame = part0.CFrame * motor.C0 * motor.Transform * motor.C1:Inverse()
					positioned[part1] = true
					changed = true
				elseif positioned[part1] and not positioned[part0] then
					part0.CFrame = part1.CFrame * motor.C1 * (motor.C0 * motor.Transform):Inverse()
					positioned[part0] = true
					changed = true
				end
			end
		end
		if not changed then
			break
		end
	end

	local originalRootCFrame = partState[session.root] and partState[session.root].cframe
	local fallbackDelta = typeof(originalRootCFrame) == "CFrame"
		and targetRootCFrame * originalRootCFrame:Inverse()
		or CFrame.identity
	for part, item in pairs(partState) do
		if not positioned[part] then
			part.CFrame = fallbackDelta * item.cframe
		end
	end
	for part, item in pairs(partState) do
		part.Anchored = item.anchored
	end
	return true
end

local function safeUnit(value, fallback)
	if typeof(value) == "Vector3" and value.Magnitude &gt; 0.0001 then
		return value.Unit
	end
	return fallback or Vector3.yAxis
end

local function findMotorToPart(rig, part)
	if not (rig and part) then
		return nil
	end
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part1 == part then
			return descendant
		end
	end
	return nil
end

local function resolveR15Chain(rig, endPart)
	local endMotor = findMotorToPart(rig, endPart)
	local midPart = endMotor and endMotor.Part0
	local lowerMotor = midPart and findMotorToPart(rig, midPart)
	local upperPart = lowerMotor and lowerMotor.Part0
	local upperMotor = upperPart and findMotorToPart(rig, upperPart)
	if not (endMotor and lowerMotor and upperMotor and upperMotor.Part0) then
		return nil
	end
	return {
		rootPart = upperMotor.Part0,
		upperPart = upperPart,
		midPart = midPart,
		endPart = endPart,
		upperMotor = upperMotor,
		lowerMotor = lowerMotor,
		endMotor = endMotor,
	}
end

local function getRigType(rig)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
		return "R6"
	end
	if rig:FindFirstChild("Torso", true)
		and rig:FindFirstChild("Left Leg", true)
		and rig:FindFirstChild("Right Leg", true) then
		return "R6"
	end
	return "R15"
end

local function makeRaycastParameters(rig)
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { rig }
	parameters.IgnoreWater = false
	return parameters
end

local function raycastGround(position, parameters, height)
	local rise = math.max(6, tonumber(height) or 8)
	local origin = position + Vector3.new(0, rise, 0)
	return workspace:Raycast(origin, Vector3.new(0, -(rise + 28), 0), parameters)
end

local R6_FOOTPRINT_SCALES = { -1, -0.5, 0, 0.5, 1 }

local function getR6DistalFaceLocalPoint(part, distalLocal, firstScale, secondScale)
	local halfSize = part.Size * 0.5
	local x, y, z = math.abs(distalLocal.X), math.abs(distalLocal.Y), math.abs(distalLocal.Z)
	if x &gt;= y and x &gt;= z then
		return Vector3.new(distalLocal.X, halfSize.Y * firstScale, halfSize.Z * secondScale)
	elseif z &gt;= x and z &gt;= y then
		return Vector3.new(halfSize.X * firstScale, halfSize.Y * secondScale, distalLocal.Z)
	end
	return Vector3.new(halfSize.X * firstScale, distalLocal.Y, halfSize.Z * secondScale)
end

local function getR6AuthoredPartCFrames(leg)
	local motor = leg.motor
	local parentCFrame = motor.Part0.CFrame
	local parentMotor = leg.parentMotor
	if parentMotor and parentMotor.Parent and parentMotor.Part0 then
		parentCFrame = parentMotor.Part0.CFrame
			* parentMotor.C0
			* parentMotor.Transform
			* parentMotor.C1:Inverse()
	end
	local authoredTransform = leg.authoredTransform or CFrame.identity
	local partCFrame = parentCFrame
		* motor.C0
		* authoredTransform
		* motor.C1:Inverse()
	return parentCFrame, partCFrame, authoredTransform
end

local function probeR6Footprint(leg, distalWorld, partCFrame)
	local part = leg.part
	partCFrame = partCFrame or part.CFrame
	local bestResult = nil
	local centerResult = nil
	for _, firstScale in ipairs(R6_FOOTPRINT_SCALES) do
		for _, secondScale in ipairs(R6_FOOTPRINT_SCALES) do
			local localPoint = getR6DistalFaceLocalPoint(part, leg.distalLocal, firstScale, secondScale)
			local worldPoint = partCFrame:PointToWorldSpace(localPoint)
			local samplePosition = Vector3.new(worldPoint.X, distalWorld.Y, worldPoint.Z)
			local result = raycastGround(samplePosition, leg.parameters, 5)
			if result and result.Normal.Y &gt; 0.15 then
				if firstScale == 0 and secondScale == 0 then
					centerResult = result
				end
				if not bestResult or result.Position.Y &gt; bestResult.Position.Y then
					bestResult = result
				end
			end
		end
	end
	return bestResult, centerResult
end

local function probeR15Footprint(leg)
	local foot = leg.chain.endPart
	local halfSize = foot.Size * 0.5
	local bestResult = nil
	for _, xScale in ipairs(R6_FOOTPRINT_SCALES) do
		for _, zScale in ipairs(R6_FOOTPRINT_SCALES) do
			local localPoint = Vector3.new(halfSize.X * xScale, -halfSize.Y, halfSize.Z * zScale)
			local worldPoint = foot.CFrame:PointToWorldSpace(localPoint)
			local result = raycastGround(worldPoint, leg.parameters, 5)
			if result and result.Normal.Y &gt; 0.15
				and (not bestResult or result.Position.Y &gt; bestResult.Position.Y) then
				bestResult = result
			end
		end
	end
	return bestResult
end

local function getLegGroundResult(leg, rigType)
	if rigType == "R6" then
		local _, authoredPartCFrame = getR6AuthoredPartCFrames(leg)
		local distalWorld = authoredPartCFrame:PointToWorldSpace(leg.distalLocal)
		local highestResult = probeR6Footprint(leg, distalWorld, authoredPartCFrame)
		return highestResult
	end

	return probeR15Footprint(leg)
end

local function sampleBodySupportGroundY(rootPosition, legs, rigType, parameters)
	local rootResult = raycastGround(rootPosition, parameters, 8)
	local rootGroundY = rootResult and rootResult.Normal.Y &gt; 0.15 and rootResult.Position.Y or nil
	local highestFootGroundY = nil

	for _, leg in ipairs(legs) do
		local result = getLegGroundResult(leg, rigType)
		if result then
			highestFootGroundY = highestFootGroundY
				and math.max(highestFootGroundY, result.Position.Y)
				or result.Position.Y
		end
	end

	if rootGroundY and highestFootGroundY then
		return math.max(rootGroundY, highestFootGroundY)
	end
	return rootGroundY or highestFootGroundY
end

local function getR6DistalFaceMinimumY(part, distalLocal, desiredCFrame)
	local minimumY = math.huge
	for _, firstScale in ipairs({ -1, 1 }) do
		for _, secondScale in ipairs({ -1, 1 }) do
			local localPoint = getR6DistalFaceLocalPoint(part, distalLocal, firstScale, secondScale)
			minimumY = math.min(minimumY, desiredCFrame:PointToWorldSpace(localPoint).Y)
		end
	end
	return minimumY
end

local function supportExtent(cframe, size, normal)
	return math.abs(cframe.RightVector:Dot(normal)) * size.X * 0.5
		+ math.abs(cframe.UpVector:Dot(normal)) * size.Y * 0.5
		+ math.abs(cframe.LookVector:Dot(normal)) * size.Z * 0.5
end

local function groundedPartCFrame(part, result)
	local normal = safeUnit(result.Normal, Vector3.yAxis)
	local forward = part.CFrame.LookVector - normal * part.CFrame.LookVector:Dot(normal)
	forward = safeUnit(forward, part.CFrame.RightVector:Cross(normal))
	local orientation = CFrame.lookAt(Vector3.zero, forward, normal)
	local extent = supportExtent(orientation, part.Size, normal)
	local centerDistance = (part.Position - result.Position):Dot(normal)
	local projectedCenter = part.Position - normal * centerDistance
	return CFrame.new(projectedCenter + normal * (extent + 0.025)) * (orientation - orientation.Position)
end

local function segmentCFrame(a, b, originalCFrame, localA, localB, fallbackRight)
	local originalA = originalCFrame:PointToWorldSpace(localA)
	local originalB = originalCFrame:PointToWorldSpace(localB)
	local originalDelta = originalB - originalA
	local solvedDelta = b - a
	if originalDelta.Magnitude &lt; 0.0001 or solvedDelta.Magnitude &lt; 0.0001 then
		return originalCFrame
	end

	local fromDirection = originalDelta.Unit
	local toDirection = solvedDelta.Unit
	local dot = math.clamp(fromDirection:Dot(toDirection), -1, 1)
	local rotation = CFrame.identity
	if dot &lt; 0.9999 then
		local axis = fromDirection:Cross(toDirection)
		if axis.Magnitude &gt; 0.0001 then
			rotation = CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
		elseif dot &lt; -0.9999 then
			rotation = CFrame.fromAxisAngle(fallbackRight or originalCFrame.RightVector, math.pi)
		end
	end
	local solvedRotation = rotation * (originalCFrame - originalCFrame.Position)
	return CFrame.new(a - solvedRotation:VectorToWorldSpace(localA)) * solvedRotation
end

local function solveTwoBone(chain, targetPartCFrame)
	local rootPosition = (chain.upperMotor.Part0.CFrame * chain.upperMotor.C0).Position
	local currentMid = (chain.upperPart.CFrame * chain.lowerMotor.C0).Position
	local currentEnd = (chain.midPart.CFrame * chain.endMotor.C0).Position
	local targetPosition = targetPartCFrame:PointToWorldSpace(chain.endMotor.C1.Position)

	local upperLength = math.max(0.001, (currentMid - rootPosition).Magnitude)
	local lowerLength = math.max(0.001, (currentEnd - currentMid).Magnitude)
	local targetVector = targetPosition - rootPosition
	local rawDistance = targetVector.Magnitude
	local direction = safeUnit(targetVector, safeUnit(currentEnd - rootPosition, -chain.rootPart.CFrame.UpVector))
	local minReach = math.max(0.001, math.abs(upperLength - lowerLength) + 0.001)
	local maxReach = math.max(minReach, upperLength + lowerLength - 0.001)
	local distance = math.clamp(rawDistance, minReach, maxReach)

	local forward = chain.rootPart.CFrame.LookVector
	local bend = (currentMid - rootPosition) - direction * (currentMid - rootPosition):Dot(direction)
	local projectedForward = forward - direction * forward:Dot(direction)
	if bend.Magnitude &lt; 0.0001 or (projectedForward.Magnitude &gt; 0.0001 and bend.Unit:Dot(projectedForward.Unit) &lt; 0.05) then
		bend = projectedForward
	end
	if bend.Magnitude &lt; 0.0001 then
		bend = direction:Cross(chain.rootPart.CFrame.RightVector)
	end
	local bendDirection = safeUnit(bend, forward)

	local along = ((distance * distance) + (upperLength * upperLength) - (lowerLength * lowerLength)) / (2 * distance)
	along = math.clamp(along, 0, upperLength)
	local height = math.sqrt(math.max(0, upperLength * upperLength - along * along))
	local solvedMid = rootPosition + direction * along + bendDirection * height
	local solvedEnd = rootPosition + direction * distance

	local desiredUpper = segmentCFrame(
		rootPosition,
		solvedMid,
		chain.upperPart.CFrame,
		chain.upperMotor.C1.Position,
		chain.lowerMotor.C0.Position,
		chain.rootPart.CFrame.RightVector
	)
	local desiredMid = segmentCFrame(
		solvedMid,
		solvedEnd,
		chain.midPart.CFrame,
		chain.lowerMotor.C1.Position,
		chain.endMotor.C0.Position,
		chain.rootPart.CFrame.RightVector
	)
	local endRotation = targetPartCFrame - targetPartCFrame.Position
	local desiredEnd = CFrame.new(solvedEnd - endRotation:VectorToWorldSpace(chain.endMotor.C1.Position)) * endRotation

	chain.upperMotor.Transform = CFrame.identity
	chain.lowerMotor.Transform = CFrame.identity
	chain.endMotor.Transform = CFrame.identity
	chain.upperMotor.C0 = chain.upperMotor.Part0.CFrame:ToObjectSpace(desiredUpper * chain.upperMotor.C1)
	chain.lowerMotor.C0 = desiredUpper:ToObjectSpace(desiredMid * chain.lowerMotor.C1)
	chain.endMotor.C0 = desiredMid:ToObjectSpace(desiredEnd * chain.endMotor.C1)
	return math.abs(rawDistance - distance) &lt;= 0.08
end

local function getR6DistalLocalPosition(part, motor)
	local joint = motor.C1.Position
	local halfSize = part.Size * 0.5
	local x, y, z = math.abs(joint.X), math.abs(joint.Y), math.abs(joint.Z)
	if x &gt;= y and x &gt;= z then
		return Vector3.new(joint.X &gt;= 0 and -halfSize.X or halfSize.X, 0, 0)
	elseif z &gt;= x and z &gt;= y then
		return Vector3.new(0, 0, joint.Z &gt;= 0 and -halfSize.Z or halfSize.Z)
	end
	return Vector3.new(0, joint.Y &gt;= 0 and -halfSize.Y or halfSize.Y, 0)
end

local function restoreR6LegTransform(leg)
	local motor = leg and leg.motor
	if motor and motor.Parent then
		motor.Transform = leg.authoredTransform or CFrame.identity
	end
end

local function solveR6Leg(leg)
	local part = leg.part
	local motor = leg.motor
	local distalLocal = leg.distalLocal
	local parentCFrame, authoredPartCFrame, authoredTransform = getR6AuthoredPartCFrames(leg)
	local distalWorld = authoredPartCFrame:PointToWorldSpace(distalLocal)
	local highestResult, centerResult = probeR6Footprint(leg, distalWorld, authoredPartCFrame)
	local result = centerResult or highestResult
	if not result then
		return false
	end
	local gap = distalWorld.Y - result.Position.Y
	if gap &gt; leg.contactThreshold then
		return false
	end

	local jointPosition = (parentCFrame * motor.C0 * authoredTransform).Position
	local minimumSurfaceY = result.Position.Y + leg.surfaceClearance
	local targetPosition = Vector3.new(distalWorld.X, minimumSurfaceY, distalWorld.Z)
	local reach = math.max(0.001, (distalLocal - motor.C1.Position).Magnitude)
	local desired = authoredPartCFrame
	for _ = 1, 3 do
		local targetOffset = targetPosition - jointPosition
		if targetOffset.Magnitude &gt; reach then
			targetPosition = jointPosition + targetOffset.Unit * reach
		end
		desired = segmentCFrame(
			jointPosition,
			targetPosition,
			authoredPartCFrame,
			motor.C1.Position,
			distalLocal,
			parentCFrame.RightVector
		)
		local penetration = minimumSurfaceY - getR6DistalFaceMinimumY(part, distalLocal, desired)
		if penetration &lt;= 0.001 then
			break
		end
		targetPosition += Vector3.new(0, penetration, 0)
	end
	motor.Transform = motor.C0:Inverse()
		* parentCFrame:ToObjectSpace(desired * motor.C1)
	return true
end

local function solveR15Leg(leg)
	local foot = leg.chain.endPart
	local result = probeR15Footprint(leg)
	if not result then
		return false
	end
	local normal = safeUnit(result.Normal, Vector3.yAxis)
	local extent = supportExtent(foot.CFrame, foot.Size, normal)
	local gap = (foot.Position - result.Position):Dot(normal) - extent
	if gap &gt; leg.contactThreshold then
		return false
	end
	return solveTwoBone(leg.chain, groundedPartCFrame(foot, result))
end

local function buildLegs(rig, rigType, parameters)
	if rigType == "R6" then
		local legs = {}
		for _, name in ipairs({ "Left Leg", "Right Leg" }) do
			local part = rig:FindFirstChild(name, true)
			local motor = part and findMotorToPart(rig, part)
			if not (part and part:IsA("BasePart") and motor and motor.Part0) then
				return nil, "Adaptive Walk could not resolve both R6 hip joints."
			end
			table.insert(legs, {
				part = part,
				motor = motor,
				parentMotor = findMotorToPart(rig, motor.Part0),
				authoredTransform = motor.Transform,
				distalLocal = getR6DistalLocalPosition(part, motor),
				parameters = parameters,
				contactThreshold = math.clamp(part.Size.Y * 0.22, 0.18, 0.5),
				surfaceClearance = math.clamp(math.min(part.Size.X, part.Size.Z) * 0.08, 0.06, 0.18),
			})
		end
		return legs, nil
	end

	local legs = {}
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = rig:FindFirstChild(name, true)
		local chain = foot and foot:IsA("BasePart") and resolveR15Chain(rig, foot) or nil
		if not chain then
			return nil, "Adaptive Walk could not resolve both R15 leg chains."
		end
		table.insert(legs, {
			chain = chain,
			parameters = parameters,
			contactThreshold = math.clamp(foot.Size.Y * 0.3, 0.18, 0.48),
		})
	end
	return legs, nil
end

function AdaptiveWalkRuntime.Start(rig, pathData)
	local originalPose = captureRigPose(rig)
	local pathSession, message = AnimatedPathRuntime.Start(rig, pathData)
	if not pathSession then
		return nil, message
	end
	local rigType = getRigType(rig)
	local parameters = makeRaycastParameters(rig)
	local legs, legMessage = buildLegs(rig, rigType, parameters)
	if not legs then
		AnimatedPathRuntime.Cancel(pathSession)
		restoreRigPose(originalPose)
		return nil, legMessage
	end
	local baseSupportGroundY = sampleBodySupportGroundY(pathSession.root.Position, legs, rigType, parameters)
	if not baseSupportGroundY then
		AnimatedPathRuntime.Cancel(pathSession)
		restoreRigPose(originalPose)
		return nil, "Adaptive Walk could not find walkable ground beneath the rig."
	end
	return {
		rig = rig,
		rigType = rigType,
		pathSession = pathSession,
		root = pathSession.root,
		parameters = parameters,
		legs = legs,
		originalPose = originalPose,
		baseSupportGroundY = baseSupportGroundY,
		pelvisOffset = 0,
		adjustedFeet = 0,
		completed = false,
		finished = false,
	}, nil
end

function AdaptiveWalkRuntime.Step(session, deltaTime)
	if not (session and not session.finished and session.root and session.root.Parent) then
		return false, "stopped"
	end
	if session.rigType == "R6" then
		for _, leg in ipairs(session.legs) do
			restoreR6LegTransform(leg)
		end
	end
	local active, reason = AnimatedPathRuntime.Step(session.pathSession, deltaTime)
	local pathRootCFrame = session.root.CFrame
	local supportGroundY = sampleBodySupportGroundY(
		pathRootCFrame.Position,
		session.legs,
		session.rigType,
		session.parameters
	)
	if supportGroundY then
		local targetOffset = math.clamp(supportGroundY - session.baseSupportGroundY, -6, 32)
		local deltaSeconds = math.max(0, tonumber(deltaTime) or 0)
		local risingToSupport = targetOffset &gt; session.pelvisOffset
		local responseRate = risingToSupport and 36 or 14
		local alpha = 1 - math.exp(-deltaSeconds * responseRate)
		session.pelvisOffset += (targetOffset - session.pelvisOffset) * alpha
		if risingToSupport then
			session.pelvisOffset = math.max(session.pelvisOffset, targetOffset - 0.05)
		end
		session.root.CFrame = pathRootCFrame + Vector3.new(0, session.pelvisOffset, 0)
	end

	local adjustedFeet = 0
	for _, leg in ipairs(session.legs) do
		local adjusted
		if session.rigType == "R6" then
			adjusted = solveR6Leg(leg)
		else
			adjusted = solveR15Leg(leg)
		end
		if adjusted then
			adjustedFeet += 1
		end
	end
	session.adjustedFeet = adjustedFeet
	if not active and reason == "complete" then
		session.completed = true
		session.finished = true
		return false, "complete"
	end
	return true, nil
end

function AdaptiveWalkRuntime.Cancel(session)
	if not session then
		return
	end
	if session.rigType == "R6" then
		for _, leg in ipairs(session.legs or {}) do
			restoreR6LegTransform(leg)
		end
	end
	local targetRootCFrame = nil
	local samples = session.pathSession and session.pathSession.pathData and session.pathSession.pathData.samples
	local finalSample = samples and samples[#samples]
	if session.completed and finalSample and typeof(finalSample.rootCFrame) == "CFrame" then
		targetRootCFrame = finalSample.rootCFrame
	end
	AnimatedPathRuntime.Cancel(session.pathSession)
	local restoredNeutral = targetRootCFrame
		and restoreCompletedNeutralPose(session, targetRootCFrame)
		or false
	if not restoredNeutral then
		restoreRigPose(session.originalPose, session.root, targetRootCFrame)
	end
	session.finished = true
end

function AdaptiveWalkRuntime.RestoreOriginal(session)
	if not session then
		return false
	end
	AnimatedPathRuntime.Cancel(session.pathSession)
	restoreRigPose(session.originalPose)
	session.completed = false
	session.finished = true
	return true
end

return AdaptiveWalkRuntime
