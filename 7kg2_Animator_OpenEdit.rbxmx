        <Item class="ModuleScript" referent="RBX103">
          <Properties>
            <string name="Name">SavedProjectRigImportPrompt</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local ModalOverlaySupport = require(script.Parent.Parent:WaitForChild("ModalOverlaySupport"))
local ThemeService = require(script.Parent.Parent:WaitForChild("ThemeService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local SavedProjectRigImportPrompt = {}

local PROMPT_NAME = "SavedProjectRigImportPrompt"

local function create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

local function removeExisting(parent)
	local existing = parent and parent:FindFirstChild(PROMPT_NAME)
	if existing then
		existing:Destroy()
	end
end

local function flattenButtonSurface(button)
	local gradientOverlay = button and button:FindFirstChild("MegMoButtonGradientOverlay")
	if gradientOverlay and gradientOverlay:IsA("GuiObject") then
		gradientOverlay.Visible = false
	end
end

local function escapeRichText(value)
	return tostring(value or "Unknown")
		:gsub("&amp;", "&amp;amp;")
		:gsub("&lt;", "&amp;lt;")
		:gsub("&gt;", "&amp;gt;")
		:gsub('"', "&amp;quot;")
		:gsub("'", "&amp;apos;")
end

function SavedProjectRigImportPrompt.show(parent, options)
	options = options or {}
	if not parent then
		return false
	end

	removeExisting(parent)
	local colors = ThemeService.getCurrentTheme().colors
	local canConfirm = type(options.onConfirm) == "function"
	local compatibilityText = tostring(options.compatibilityText or "")
	local bodyText = tostring(options.message or "")

	local overlay = create("Frame", {
		Name = PROMPT_NAME,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 220,
		Parent = parent,
	})
	ModalOverlaySupport.applyToOverlay(overlay)

	local card = create("Frame", {
		Name = "PromptCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = colors.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -32, 0, canConfirm and 300 or 210),
		ZIndex = 222,
		Parent = overlay,
	})
	UiHelpers.createCorner(card, 7)
	local cardStroke = UiHelpers.createStroke(card, canConfirm and colors.Accent or colors.Border, 1)
	cardStroke.Transparency = canConfirm and 0.22 or 0.4
	create("UISizeConstraint", {
		MaxSize = Vector2.new(500, canConfirm and 300 or 210),
		MinSize = Vector2.new(270, canConfirm and 300 or 210),
		Parent = card,
	})

	create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 28),
		Text = tostring(options.title or "Import onto selected rig"),
		TextColor3 = colors.Text,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 223,
		Parent = card,
	})

	if canConfirm then
		create("TextLabel", {
			Name = "Mapping",
			BackgroundColor3 = colors.PanelSoft,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.fromOffset(18, 52),
			Size = UDim2.new(1, -36, 0, 80),
			RichText = true,
			Text = string.format(
				"Saved project rig:  &lt;b&gt;%s&lt;/b&gt;\nSelected workspace rig:  &lt;b&gt;%s&lt;/b&gt;",
				escapeRichText(options.sourceRigName),
				escapeRichText(options.targetRigName)
			),
			TextColor3 = colors.Text,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 223,
			Parent = card,
		})
		local mapping = card:FindFirstChild("Mapping")
		UiHelpers.createCorner(mapping, 5)
		local mappingStroke = UiHelpers.createStroke(mapping, colors.Border, 1)
		mappingStroke.Transparency = 0.5
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
			Parent = mapping,
		})

		create("TextLabel", {
			Name = "Compatibility",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(18, 140),
			Size = UDim2.new(1, -36, 0, 20),
			Text = compatibilityText,
			TextColor3 = colors.Success or colors.Accent,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 223,
			Parent = card,
		})
	end

	local messageTop = canConfirm and 168 or 54
	local messageHeight = canConfirm and 56 or 88
	local messageLabel = create("TextLabel", {
		Name = "Message",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.fromOffset(18, messageTop),
		Size = UDim2.new(1, -36, 0, messageHeight),
		Text = bodyText,
		TextColor3 = colors.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 223,
		Parent = card,
	})

	local statusLabel = create("TextLabel", {
		Name = "Status",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 18, 1, -70),
		Size = UDim2.new(1, -36, 0, 18),
		Text = "",
		TextColor3 = colors.Danger or Color3.fromRGB(255, 110, 125),
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 223,
		Parent = card,
	})
	statusLabel.Visible = false

	local cancelButton = create("TextButton", {
		Name = canConfirm and "Cancel" or "OK",
		AutoButtonColor = true,
		Position = UDim2.new(0, 18, 1, -48),
		Size = canConfirm and UDim2.new(0.42, -22, 0, 36) or UDim2.new(1, -36, 0, 36),
		Text = canConfirm and "Cancel" or "OK",
		ZIndex = 223,
		Parent = card,
	})
	UiHelpers.styleGhostButton(cancelButton)
	UiHelpers.createCorner(cancelButton, 5)
	flattenButtonSurface(cancelButton)

	local confirmButton = nil
	if canConfirm then
		confirmButton = create("TextButton", {
			Name = "Confirm",
			AutoButtonColor = true,
			Position = UDim2.new(0.42, 4, 1, -48),
			Size = UDim2.new(0.58, -22, 0, 36),
			Text = tostring(options.confirmText or "Open on Selected Rig"),
			ZIndex = 223,
			Parent = card,
		})
		UiHelpers.styleTextButton(confirmButton, colors.Accent)
		UiHelpers.createCorner(confirmButton, 5)
	end

	local busy = false
	local function close()
		if not busy and overlay.Parent then
			overlay:Destroy()
		end
	end
	cancelButton.Activated:Connect(close)

	if confirmButton then
		confirmButton.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			confirmButton.Text = "Opening..."
			confirmButton.Active = false
			local ok, handled, message = pcall(options.onConfirm)
			if ok and handled == true then
				if overlay.Parent then
					overlay:Destroy()
				end
				return
			end
			busy = false
			confirmButton.Text = tostring(options.confirmText or "Open on Selected Rig")
			confirmButton.Active = true
			statusLabel.Text = tostring((ok and message) or handled or "That project could not be opened.")
			statusLabel.Visible = true
			messageLabel.Size = UDim2.new(1, -36, 0, math.max(34, messageHeight - 18))
		end)
	end

	return true
end

return SavedProjectRigImportPrompt
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX104">
          <Properties>
            <string name="Name">SavedProjectsBrowserUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local SavedProjectsBrowserUI = {}

local function flattenButtonSurface(button)
	local overlay = button and button:FindFirstChild("MegMoButtonGradientOverlay")
	if overlay and overlay:IsA("GuiObject") then
		overlay.Visible = false
	end
end

function SavedProjectsBrowserUI.mount(parent, generalImportCard)
	local create = UiHelpers.create

	local card = create("Frame", {
		Name = "SavedProjectsCard",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.82, 0, 0.72, 0),
		Visible = true,
		ZIndex = 121,
	})
	create("UISizeConstraint", {
		Parent = card,
		MinSize = Vector2.new(720, 520),
		MaxSize = Vector2.new(900, 600),
	})
	UiHelpers.createCorner(card, 7)
	local cardStroke = UiHelpers.createStroke(card, Constants.THEME.Border, 1)
	cardStroke.Transparency = 0.36

	create("TextLabel", {
		Name = "Title",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(24, 18),
		Size = UDim2.new(1, -190, 0, 28),
		Text = "Import Project",
		TextColor3 = Constants.THEME.Text,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 122,
	})

	local otherImportsButton = create("TextButton", {
		Name = "OtherImports",
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -62, 0, 16),
		Size = UDim2.fromOffset(116, 32),
		Text = "Other Imports",
		ZIndex = 123,
	})
	UiHelpers.styleGhostButton(otherImportsButton)
	UiHelpers.createCorner(otherImportsButton, 5)
	flattenButtonSurface(otherImportsButton)

	local closeButton = create("TextButton", {
		Name = "Close",
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 16),
		Size = UDim2.fromOffset(32, 32),
		Text = "X",
		ZIndex = 123,
	})
	UiHelpers.styleGhostButton(closeButton)
	UiHelpers.createCorner(closeButton, 5)
	flattenButtonSurface(closeButton)

	local searchInput = create("TextBox", {
		Name = "SavedProjectsSearch",
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		PlaceholderText = "Search saved projects",
		Position = UDim2.fromOffset(24, 64),
		Size = UDim2.new(1, -48, 0, 38),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 122,
	})
	UiHelpers.createCorner(searchInput, 5)
	local searchStroke = UiHelpers.createStroke(searchInput, Constants.THEME.Border, 1)
	searchStroke.Transparency = 0.45
	create("UIPadding", {
		Parent = searchInput,
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
	})

	create("TextLabel", {
		Name = "SectionTitle",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(24, 120),
		Size = UDim2.new(1, -48, 0, 22),
		Text = "Saved Projects",
		TextColor3 = Constants.THEME.Text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 122,
	})

	local columnHeader = create("Frame", {
		Name = "ColumnHeader",
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 152),
		Size = UDim2.new(1, -48, 0, 22),
		ZIndex = 122,
	})
	for _, definition in ipairs({
		{ text = "Project Name", x = 0, width = 0.22 },
		{ text = "Project Type", x = 0.22, width = 0.16 },
		{ text = "Saved", x = 0.38, width = 0.22 },
	}) do
		create("TextLabel", {
			Parent = columnHeader,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Position = UDim2.new(definition.x, 12, 0, 0),
			Size = UDim2.new(definition.width, -12, 1, 0),
			Text = definition.text,
			TextColor3 = Constants.THEME.MutedText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 123,
		})
	end

	local rows = create("Frame", {
		Name = "SavedProjectRows",
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 180),
		Size = UDim2.new(1, -48, 1, -240),
		ZIndex = 122,
	})
	create("UIListLayout", {
		Parent = rows,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local footer = create("Frame", {
		Name = "Footer",
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 24, 1, -48),
		Size = UDim2.new(1, -48, 0, 32),
		ZIndex = 122,
	})
	local countLabel = create("TextLabel", {
		Name = "ProjectCount",
		Parent = footer,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Size = UDim2.new(0.5, 0, 1, 0),
		Text = "Loading saved projects...",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 123,
	})
	local pagination = create("Frame", {
		Name = "Pagination",
		Parent = footer,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		ZIndex = 123,
	})

	otherImportsButton.Activated:Connect(function()
		card.Visible = false
		if generalImportCard then
			generalImportCard.Visible = true
		end
	end)

	return {
		_savedProjectsCard = card,
		_savedProjectsCloseButton = closeButton,
		_savedProjectsSearchInput = searchInput,
		_savedProjectsRows = rows,
		_savedProjectsCountLabel = countLabel,
		_savedProjectsPagination = pagination,
	}
end

return SavedProjectsBrowserUI
</ProtectedString>
