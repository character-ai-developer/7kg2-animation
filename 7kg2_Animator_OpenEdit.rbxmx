local function normalizeSearchText(value)
	return string.lower(tostring(value or ""))
end

local function guideContainsQuery(guide, query)
	local haystack = normalizeSearchText((guide.title or "") .. " " .. (guide.subtitle or ""))
	for _, section in ipairs(guide.sections or {}) do
		haystack = haystack .. " " .. normalizeSearchText((section.heading or "") .. " " .. (section.body or ""))
	end
	return string.find(haystack, query, 1, true) ~= nil
end

local function makeGuideButton(parent, text, order)
	local button = create("TextButton", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 34),
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextScaled = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = false,
		ZIndex = 155,
	})
	createCorner(button, 9)
	create("UITextSizeConstraint", {
		Parent = button,
		MaxTextSize = 12,
		MinTextSize = 9,
	})
	create("UIPadding", {
		Parent = button,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	return button
end

local function makeContentLabel(parent, text, size, color, font)
	local label = create("TextLabel", {
		Parent = parent,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = font or Enum.Font.Gotham,
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0),
		Text = text,
		TextColor3 = color,
		TextSize = size,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 155,
	})
	return label
end

local function clearGeneratedContent(content)
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function HelpUI.mount(parent, _context)
	if not parent then
		error("HelpUI.mount requires parent")
	end

	local refs = {}

	local overlay = create("Frame", {
		Name = "HelpOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 150,
	})

	local inputBlocker = create("TextButton", {
		Name = "HelpInputBlocker",
		Parent = overlay,
		Active = true,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Modal = true,
		Selectable = false,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 151,
	})
	inputBlocker.Activated:Connect(function()
		-- Intentionally swallow clicks outside the card so the timeline cannot receive them.
	end)

	local card = create("Frame", {
		Name = "HelpCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.72, 0, 0.72, 0),
		ZIndex = 152,
	})
	createCorner(card, 16)
	createStroke(card, Constants.THEME.Border, 1)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 18),
		Size = UDim2.new(1, -86, 0, 26),
		Font = Enum.Font.GothamBold,
		Text = "Help Guides",
		TextColor3 = Constants.THEME.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 152,
	})

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 48),
		Size = UDim2.new(1, -86, 0, 34),
		Font = Enum.Font.GothamSemibold,
		Text = "Step-by-step references for common 7kg2 Animator workflows.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 152,
	})

	local searchInput = create("TextBox", {
		Name = "HelpSearchInput",
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		PlaceholderColor3 = Constants.THEME.MutedText,
		PlaceholderText = "Search help, e.g. markers, import, keyframes, shortcuts",
		Position = UDim2.new(0, 22, 0, 82),
		Size = UDim2.new(1, -86, 0, 30),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 152,
	})
	styleInput(searchInput)
	createCorner(searchInput, 9)
	create("UIPadding", {
		Parent = searchInput,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -18, 0, 18),
		Size = UDim2.new(0, 34, 0, 34),
		Text = "X",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		ZIndex = 152,
	})
	createCorner(closeButton, 10)

	local nav = create("Frame", {
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 22, 0, 124),
		Size = UDim2.new(0, 190, 1, -146),
		ZIndex = 152,
	})
	applySectionSurface(nav)
	createCorner(nav, 12)
	createStroke(nav)

	local navList = create("Frame", {
		Parent = nav,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 12),
		Size = UDim2.new(1, -24, 1, -24),
		ZIndex = 153,
	})
	createListLayout(navList, 8)

	local content = create("ScrollingFrame", {
		Name = "HelpContent",
		Parent = card,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 224, 0, 124),
		ScrollBarThickness = 6,
		Size = UDim2.new(1, -246, 1, -146),
		ZIndex = 152,
	})
	createCorner(content, 12)
	createStroke(content)
	createListLayout(content, 10)
	create("UIPadding", {
		Parent = content,
		PaddingTop = UDim.new(0, 16),
		PaddingBottom = UDim.new(0, 18),
		PaddingLeft = UDim.new(0, 16),
		PaddingRight = UDim.new(0, 16),
	})

	local guideButtons = {}
	local currentGuideKey = "HelpQuickAnswers"
	local renderGuide

	local function renderSearch(query)
		clearGeneratedContent(content)
		makeContentLabel(content, "Search Results", 20, Constants.THEME.Text, Enum.Font.GothamBold).LayoutOrder = 1
		makeContentLabel(content, "Showing guides that match: " .. tostring(query), 12, Constants.THEME.MutedText, Enum.Font.Gotham).LayoutOrder = 2

		local resultCount = 0
		for index, guideKey in ipairs(GUIDE_ORDER) do
			local guide = GUIDES[guideKey]
			if guide and guideContainsQuery(guide, normalizeSearchText(query)) then
				resultCount += 1
				local resultButton = create("TextButton", {
					Parent = content,
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = Constants.THEME.PanelSoft,
					BorderSizePixel = 0,
					Font = Enum.Font.Gotham,
					LayoutOrder = 10 + index,
					Size = UDim2.new(1, 0, 0, 0),
					Text = "",
					ZIndex = 153,
				})
				createCorner(resultButton, 10)
				createStroke(resultButton, Constants.THEME.Border, 1)
				createListLayout(resultButton, 4)
				create("UIPadding", {
					Parent = resultButton,
					PaddingTop = UDim.new(0, 10),
					PaddingBottom = UDim.new(0, 10),
					PaddingLeft = UDim.new(0, 12),
					PaddingRight = UDim.new(0, 12),
				})
				makeContentLabel(resultButton, guide.title, 13, Constants.THEME.Text, Enum.Font.GothamSemibold)
				makeContentLabel(resultButton, guide.subtitle, 12, Constants.THEME.MutedText, Enum.Font.Gotham)
				resultButton.Activated:Connect(function()
					currentGuideKey = guideKey
					searchInput.Text = ""
					renderGuide(guideKey)
				end)
			end
		end

		if resultCount == 0 then
			makeContentLabel(content, "No matching guides yet. Try a simpler word like rig, marker, physics, import, timeline, effect, or shortcut.", 12, Constants.THEME.MutedText, Enum.Font.Gotham).LayoutOrder = 10
		end
		for _, button in pairs(guideButtons) do
			button.BackgroundColor3 = Constants.THEME.PanelSoft
		end
		content.CanvasPosition = Vector2.new(0, 0)
	end

	renderGuide = function(guideKey)
		local resolvedGuideKey = guideKey or currentGuideKey or "HelpQuickAnswers"
		currentGuideKey = resolvedGuideKey
		local guide = GUIDES[resolvedGuideKey] or GUIDES.HelpQuickAnswers
		clearGeneratedContent(content)

		local title = makeContentLabel(content, guide.title, 20, Constants.THEME.Text, Enum.Font.GothamBold)
		title.LayoutOrder = 1
		local subtitle = makeContentLabel(content, guide.subtitle, 12, Constants.THEME.MutedText, Enum.Font.Gotham)
		subtitle.LayoutOrder = 2

		for index, section in ipairs(guide.sections or {}) do
			local sectionFrame = create("Frame", {
				Parent = content,
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				LayoutOrder = 10 + index,
				Size = UDim2.new(1, 0, 0, 0),
				ZIndex = 153,
			})
			createCorner(sectionFrame, 10)
			createStroke(sectionFrame, Constants.THEME.Border, 1)
			createListLayout(sectionFrame, 4)
			create("UIPadding", {
				Parent = sectionFrame,
				PaddingTop = UDim.new(0, 10),
				PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
			})
			makeContentLabel(sectionFrame, section.heading, 13, Constants.THEME.Text, Enum.Font.GothamSemibold)
			makeContentLabel(sectionFrame, section.body, 12, Constants.THEME.MutedText, Enum.Font.Gotham)
		end

		for key, button in pairs(guideButtons) do
			button.BackgroundColor3 = key == resolvedGuideKey and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		end
		content.CanvasPosition = Vector2.new(0, 0)
	end

	for index, guideKey in ipairs(GUIDE_ORDER) do
		local guide = GUIDES[guideKey]
		local button = makeGuideButton(navList, guide.title, index)
		guideButtons[guideKey] = button
		button.Activated:Connect(function()
			searchInput.Text = ""
			renderGuide(guideKey)
		end)
	end

	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.gsub(searchInput.Text or "", "^%s*(.-)%s*$", "%1")
		if query == "" then
			renderGuide(currentGuideKey)
		else
			renderSearch(query)
		end
	end)

	closeButton.Activated:Connect(function()
		overlay.Visible = false
	end)

	renderGuide("HelpQuickAnswers")

	refs._helpOverlay = overlay
	refs._helpOpenGuide = function(guideKey)
		searchInput.Text = ""
		renderGuide(guideKey or "HelpQuickAnswers")
	end

	return refs
end

function HelpUI.update(_context)
end

function HelpUI.destroy()
end

function HelpUI.getGuide(guideKey)
	return GUIDES[guideKey]
end

function HelpUI.getGuideOrder()
	return GUIDE_ORDER
end

return HelpUI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX68">
          <Properties>
            <string name="Name">InspectorUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local InspectorUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createSectionTitle = UiHelpers.createSectionTitle
local createMetaLabel = UiHelpers.createMetaLabel
local createListLayout = UiHelpers.createListLayout
local createCard = UiHelpers.createCard
local buildPropertyRow = UiHelpers.buildPropertyRow
local createDropdownMenu = UiHelpers.createDropdownMenu
local applySectionSurface = UiHelpers.applySectionSurface

function InspectorUI.mount(parent, _context)
	if not parent then
		error("InspectorUI.mount requires parent")
	end

	local refs = {}

	local inspectorCard = createCard(parent, UDim2.new(1, -14, 0, 670))
	inspectorCard.Position = UDim2.new(0, 6, 0, 6)
	inspectorCard.ClipsDescendants = true

	local inspectorScroll = create("ScrollingFrame", {
		Name = "AnimationSettingsScroll",
		Parent = inspectorCard,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 0, 0, 0),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, 0, 1, 0),
	})
	local inspectorContent = create("Frame", {
		Name = "AnimationSettingsContent",
		Parent = inspectorScroll,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 1028),
	})
	local inspectorCollapseButton = UiHelpers.createPanelCollapseButton(inspectorCard)

	local settingsTitle = createSectionTitle(inspectorContent, "Animation Settings")
	settingsTitle.Position = UDim2.new(0, 14, 0, 12)
	settingsTitle.Size = UDim2.new(1, -68, 0, 20)
	local settingsDescription = createMetaLabel(inspectorContent, "Pose tools. Gear includes timing, snap, and saved gizmo size.", 30)
	settingsDescription.Position = UDim2.new(0, 14, 0, 34)
	settingsDescription.Size = UDim2.new(1, -28, 0, 30)
	settingsDescription.TextWrapped = true
	settingsDescription.TextYAlignment = Enum.TextYAlignment.Top

	local settingsModeButton = create("ImageButton", {
		Name = "AnimationSettingsModeButton",
		Parent = inspectorContent,
		AnchorPoint = Vector2.new(1, 0),
		AutoButtonColor = true,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Image = UiHelpers.getButtonIconImage("Settings"),
		ImageColor3 = Constants.THEME.Text,
		Position = UDim2.new(1, -54, 0, 12),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(24, 24),
		ZIndex = 90,
	})
	createCorner(settingsModeButton, 99)
	create("UIStroke", {
		Parent = settingsModeButton,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Border,
		Thickness = 1,
		Transparency = 0.22,
	})

	local animationProps = create("Frame", {
		Name = "AnimationToolPanel",
		Parent = inspectorContent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 62),
		Size = UDim2.new(1, -28, 0, 224),
	})

	local settingsProps = create("Frame", {
		Name = "AnimationAdvancedSettingsPanel",
		Parent = inspectorContent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 62),
		Size = UDim2.new(1, -28, 0, 390),
		Visible = false,
	})
	createListLayout(settingsProps, 6)

	local function createToolTile(name, text, iconKey, position, size, accent)
		local button = create("TextButton", {
			Name = name,
			Parent = animationProps,
			Position = position,
			Size = size,
			Text = text,
		})
		UiHelpers.styleIconTileButton(button, iconKey, accent, {
			iconOnly = true,
			iconSize = 34,
		})
		applySectionSurface(button)
		createCorner(button, 10)
		return button
	end

	local halfWidth = UDim2.new(0.5, -5, 0, 54)
	local moveModeInspectorButton = createToolTile(
		"MoveModeButton",
		"Move",
		"Move",
		UDim2.new(0, 0, 0, 0),
		halfWidth,
		Constants.THEME.AccentSoft
	)
	local rotateModeInspectorButton = createToolTile(
		"RotateModeButton",
		"Rotate",
		"Rotate",
		UDim2.new(0.5, 5, 0, 0),
		halfWidth
	)
	local trackballRotateInspectorButton = createToolTile(
		"TrackballRotateButton",
		"Trackball\nRotate",
		"TrackballRotate",
		UDim2.new(0, 0, 0, 62),
		halfWidth
	)
	local trackballMoveInspectorButton = createToolTile(
		"TrackballMoveButton",
		"Trackball\nMove",
		"TrackballMove",
		UDim2.new(0.5, 5, 0, 62),
		halfWidth
	)

	local motionRecorderButton = createToolTile(
		"MotionRecorderButton",
		"Record\nMotion",
		"RecordMotion",
		UDim2.new(0, 0, 0, 124),
		halfWidth
	)
	local workspaceGrabButton = create("ImageButton", {
		Name = "WorkspaceGrabButton",
		Parent = animationProps,
		AutoButtonColor = true,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Image = Constants.WORKSPACE_GRAB_ICON,
		ImageTransparency = 1,
		Position = UDim2.new(0.5, 5, 0, 124),
		ScaleType = Enum.ScaleType.Fit,
		Size = halfWidth,
	})
	workspaceGrabButton:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	applySectionSurface(workspaceGrabButton)
	createCorner(workspaceGrabButton, 10)
	local workspaceGrabIcon = create("ImageLabel", {
		Name = "MegMoWorkspaceGrabIcon",
		Parent = workspaceGrabButton,
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Image = Constants.WORKSPACE_GRAB_ICON,
		ImageColor3 = Constants.THEME.Text,
		Position = UDim2.fromScale(0.5, 0.5),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(34, 34),
		ZIndex = workspaceGrabButton.ZIndex + 3,
	})
	workspaceGrabIcon:SetAttribute("MegMoThemeImageRole", "Text")
	create("UIStroke", {
		Name = "MegMoWorkspaceGrabStroke",
		Parent = workspaceGrabButton,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Accent,
		Thickness = 1.25,
		Transparency = 0.28,
	})

	local loopingButton = create("TextButton", {
		Name = "LoopingButton",
		Parent = animationProps,
		Position = UDim2.new(0, 0, 0, 188),
		Size = UDim2.new(1, 0, 0, 34),
		Text = "Looping: On",
	})
	styleGhostButton(loopingButton)
	applySectionSurface(loopingButton)
	createCorner(loopingButton, 9)

	local compactGizmoSizeInput, compactGizmoSizeLabel, compactGizmoSizeRow = buildPropertyRow(animationProps, "Gizmo Size (saved %)")
	compactGizmoSizeRow.Name = "CompactGizmoSizeRow"
	compactGizmoSizeRow.Position = UDim2.new(0, 0, 0, 232)
	compactGizmoSizeRow.Size = UDim2.new(1, 0, 0, 38)
	compactGizmoSizeInput.PlaceholderText = "100"
	compactGizmoSizeLabel.Text = "Gizmo Size (60-140%)"
	compactGizmoSizeLabel.Font = Enum.Font.GothamBold
	compactGizmoSizeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)

	local keyframeToolsHost = create("Frame", {
		Name = "EmbeddedKeyframeToolsHost",
		Parent = inspectorContent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 348),
		Size = UDim2.new(1, 0, 0, 660),
	})

	local settingsHint = createMetaLabel(settingsProps, "Timing and playback settings", 18)
	settingsHint.TextColor3 = Constants.THEME.Text

	local fpsInput = buildPropertyRow(settingsProps, "FPS")
	local durationInspectorInput, durationInspectorLabel, durationInspectorRow = buildPropertyRow(settingsProps, "Animation Length (Seconds)")
	durationInspectorLabel.Size = UDim2.new(1, -82, 0, 14)
	local timeUnitToggle = create("TextButton", {
		Name = "TimeUnitToggle",
		Parent = durationInspectorRow,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -1),
		Size = UDim2.new(0, 74, 0, 18),
		Text = "Seconds",
	})
	styleGhostButton(timeUnitToggle)
	timeUnitToggle.TextSize = 11
	createCorner(timeUnitToggle, 7)

	local moveSnapInput = buildPropertyRow(settingsProps, "Move Snap (Studs)")
	local rotateSnapInput = buildPropertyRow(settingsProps, "Rotate Snap (Degrees)")
	local gizmoSizeInput, gizmoSizeLabel = buildPropertyRow(settingsProps, "Gizmo Size (60-140%)")
	gizmoSizeInput.PlaceholderText = "100"
	gizmoSizeLabel.Text = "Gizmo Size (saved %)"

	local rotateSpaceButton = create("TextButton", {
		Name = "RotateSpaceButton",
		Parent = settingsProps,
		Size = UDim2.new(1, 0, 0, 28),
		Text = "Space: Local",
	})
	styleGhostButton(rotateSpaceButton)
	createCorner(rotateSpaceButton, 9)

	local priorityRow = create("Frame", {
		Parent = settingsProps,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 38),
	})
	create("TextLabel", {
		Parent = priorityRow,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		Text = "Priority",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local priorityButton = create("TextButton", {
		Name = "PriorityButton",
		Parent = priorityRow,
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Action v",
	})
	styleGhostButton(priorityButton)
	priorityButton.TextXAlignment = Enum.TextXAlignment.Left
	priorityButton.TextSize = 12
	createCorner(priorityButton, 8)
	create("UIPadding", {
		Parent = priorityButton,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	local priorityDropdown, priorityOptionButtons = createDropdownMenu(priorityButton, Constants.ANIMATION_PRIORITIES, 7)

	local function setAdvancedSettingsVisible(showSettings)
		settingsProps.Visible = showSettings
		animationProps.Visible = not showSettings
		keyframeToolsHost.Position = showSettings and UDim2.new(0, 0, 0, 404) or UDim2.new(0, 0, 0, 348)
		keyframeToolsHost.Size = showSettings and UDim2.new(1, 0, 0, 660) or UDim2.new(1, 0, 0, 660)
		inspectorContent.Size = showSettings and UDim2.new(1, -8, 0, 1084) or UDim2.new(1, -8, 0, 1028)
		settingsModeButton.BackgroundColor3 = showSettings and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
		settingsModeButton.ImageColor3 = showSettings and Constants.THEME.Text or Constants.THEME.MutedText
	end
	settingsModeButton.Activated:Connect(function()
		setAdvancedSettingsVisible(not settingsProps.Visible)
	end)

	local cameraToolsCard = create("Frame", {
		Name = "CameraToolsCard",
		Parent = inspectorContent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0, 464),
		Size = UDim2.new(1, -28, 0, 186),
		Visible = false,
	})
	applySectionSurface(cameraToolsCard)
	createCorner(cameraToolsCard, 10)
	local cameraToolsStroke = create("UIStroke", {
		Parent = cameraToolsCard,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Border,
		Thickness = 1,
		Transparency = 0.2,
	})
	local cameraTitle = createMetaLabel(cameraToolsCard, "Camera Track", 10)
	cameraTitle.Position = UDim2.new(0, 10, 0, 8)
	cameraTitle.Size = UDim2.new(1, -20, 0, 18)
	cameraTitle.TextColor3 = Constants.THEME.Text
	cameraTitle.Font = Enum.Font.GothamSemibold
	cameraTitle.TextSize = 13
	local cameraMeta = createMetaLabel(cameraToolsCard, "FOV keyframes and cinematic preset moves for the selected camera track.", 28)
	cameraMeta.Position = UDim2.new(0, 10, 0, 28)
	cameraMeta.Size = UDim2.new(1, -20, 0, 26)
	cameraMeta.TextWrapped = true
	cameraMeta.TextYAlignment = Enum.TextYAlignment.Top

	local cameraFovInput = buildPropertyRow(cameraToolsCard, "Field Of View")
	local cameraFovRow = cameraFovInput.Parent
	cameraFovRow.Position = UDim2.new(0, 0, 0, 58)
	cameraFovRow.Size = UDim2.new(1, 0, 0, 42)

	local cameraButtonsRow = create("Frame", {
		Parent = cameraToolsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 104),
		Size = UDim2.new(1, 0, 0, 22),
	})
	local cameraApplyFovButton = create("TextButton", {
		Parent = cameraButtonsRow,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Apply FOV Key",
	})
	styleTextButton(cameraApplyFovButton, Constants.THEME.AccentSoft)
	createCorner(cameraApplyFovButton, 8)
	local cameraCaptureButton = create("TextButton", {
		Parent = cameraButtonsRow,
		Position = UDim2.new(0.5, 4, 0, 0),
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Capture Camera",
	})
	styleGhostButton(cameraCaptureButton)
	createCorner(cameraCaptureButton, 8)

	local cameraPresetRowOne = create("Frame", {
		Parent = cameraToolsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 132),
		Size = UDim2.new(1, 0, 0, 22),
	})
	local cameraPresetShakeButton = create("TextButton", {
		Parent = cameraPresetRowOne,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Explosion Shake",
	})
	styleGhostButton(cameraPresetShakeButton)
	createCorner(cameraPresetShakeButton, 8)
	local cameraPresetHandheldButton = create("TextButton", {
		Parent = cameraPresetRowOne,
		Position = UDim2.new(0.5, 4, 0, 0),
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Soft Handheld",
	})
	styleGhostButton(cameraPresetHandheldButton)
	createCorner(cameraPresetHandheldButton, 8)

	local cameraPresetRowTwo = create("Frame", {
		Parent = cameraToolsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 158),
		Size = UDim2.new(1, 0, 0, 22),
	})
	local cameraPresetOrbitButton = create("TextButton", {
		Parent = cameraPresetRowTwo,
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Orbit",
	})
	styleGhostButton(cameraPresetOrbitButton)
	createCorner(cameraPresetOrbitButton, 8)
	local cameraPresetFollowButton = create("TextButton", {
		Parent = cameraPresetRowTwo,
		Position = UDim2.new(0.5, 4, 0, 0),
		Size = UDim2.new(0.5, -4, 1, 0),
		Text = "Follow Rig",
	})
	styleGhostButton(cameraPresetFollowButton)
	createCorner(cameraPresetFollowButton, 8)

	local inspectorTooltip = create("Frame", {
		Name = "AnimationSettingsTooltip",
		Parent = inspectorContent,
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.new(0, 18, 0, 128),
		Size = UDim2.new(1, -36, 0, 96),
		Visible = false,
		ZIndex = 140,
	})
	createCorner(inspectorTooltip, 10)
	create("UIStroke", {
		Parent = inspectorTooltip,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Border,
		Thickness = 1,
		Transparency = 0.15,
	})
	local inspectorTooltipTitle = create("TextLabel", {
		Parent = inspectorTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Font = Enum.Font.GothamSemibold,
		Text = "Tool",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 141,
	})
	local inspectorTooltipDetail = create("TextLabel", {
		Parent = inspectorTooltip,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 27),
		Size = UDim2.new(1, -24, 0, 56),
		Font = Enum.Font.GothamSemibold,
		Text = "Details",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.None,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 141,
	})

	refs._moveModeButton = moveModeInspectorButton
	refs._rotateModeButton = rotateModeInspectorButton
	refs._moveModeInspectorButton = moveModeInspectorButton
	refs._rotateModeInspectorButton = rotateModeInspectorButton
	refs._trackballRotateInspectorButton = trackballRotateInspectorButton
	refs._trackballMoveInspectorButton = trackballMoveInspectorButton
	refs._motionRecorderButton = motionRecorderButton
	refs._workspaceGrabButton = workspaceGrabButton
	refs._fpsInput = fpsInput
	refs._durationInspectorInput = durationInspectorInput
	refs._durationInspectorLabel = durationInspectorLabel
	refs._timeUnitToggle = timeUnitToggle
	refs._showAnimationTimingSettings = function()
		setAdvancedSettingsVisible(true)
		inspectorScroll.CanvasPosition = Vector2.zero
	end
	refs._moveSnapInput = moveSnapInput
	refs._rotateSnapInput = rotateSnapInput
	refs._gizmoSizeInput = gizmoSizeInput
	refs._compactGizmoSizeInput = compactGizmoSizeInput
	refs._rotateSpaceButton = rotateSpaceButton
	refs._loopingButton = loopingButton
	refs._priorityLabel = priorityButton
	refs._priorityButton = priorityButton
	refs._priorityDropdown = priorityDropdown
	refs._priorityOptionButtons = priorityOptionButtons
	refs._cameraToolsCard = cameraToolsCard
	refs._cameraToolsStroke = cameraToolsStroke
	refs._cameraFovInput = cameraFovInput
	refs._cameraApplyFovButton = cameraApplyFovButton
	refs._cameraCaptureButton = cameraCaptureButton
	refs._cameraPresetShakeButton = cameraPresetShakeButton
	refs._cameraPresetHandheldButton = cameraPresetHandheldButton
	refs._cameraPresetOrbitButton = cameraPresetOrbitButton
	refs._cameraPresetFollowButton = cameraPresetFollowButton
	refs._inspectorCard = inspectorCard
	refs._inspectorCollapseButton = inspectorCollapseButton
	refs._keyframeToolsHost = keyframeToolsHost
	refs._inspectorTooltip = inspectorTooltip
	refs._inspectorTooltipTitle = inspectorTooltipTitle
	refs._inspectorTooltipDetail = inspectorTooltipDetail

	return refs
end

function InspectorUI.update(_context)
end

