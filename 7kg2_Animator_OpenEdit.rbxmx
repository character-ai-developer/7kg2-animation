        <Item class="ModuleScript" referent="RBX64">
          <Properties>
            <string name="Name">FacesSelectionImportBinding</string>
            <ProtectedString name="Source">local FacesSelectionImportBinding = {}

function FacesSelectionImportBinding.bind(controller, callbacks)
	local button = controller and controller._facesImportSelectionButton
	if not button or type(controller._connect) ~= "function" then
		return
	end
	controller:_connect(button.Activated, function()
		if not callbacks or type(callbacks.onFacesAction) ~= "function" then
			return
		end
		local success, _, preview = callbacks.onFacesAction("scanSelectionPresets")
		if not success or type(preview) ~= "table" then
			return
		end
		local facesUi = controller._uiSections and controller._uiSections.FacesUI
		if not facesUi or type(facesUi.openSelectionImport) ~= "function" then
			return
		end
		facesUi.openSelectionImport(controller, preview, function(groupIds, folderName)
			return callbacks.onFacesAction("importSelectionPresets", {
				groupIds = groupIds,
				folderName = folderName,
			})
		end)
	end)
end

return FacesSelectionImportBinding
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX65">
          <Properties>
            <string name="Name">FontPreviewUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local FontPreviewService = require(script.Parent.Parent:WaitForChild("FontPreviewService"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local FontPreviewUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local applySectionSurface = UiHelpers.applySectionSurface

local function fontFromName(fontName)
	local ok, font = pcall(function()
		return Enum.Font[tostring(fontName or "Gotham")]
	end)
	return ok and font or Enum.Font.Gotham
end

function FontPreviewUI.mount(parent, _context)
	if not parent then
		error("FontPreviewUI.mount requires parent")
	end

	local refs = {
		_fontPreviewOptionButtons = {},
	}

	local overlay = create("Frame", {
		Name = "FontPreviewOverlay",
		Parent = parent,
		Active = true,
		BackgroundColor3 = Color3.fromRGB(3, 5, 9),
		BackgroundTransparency = 0.26,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 168,
	})

	local card = create("Frame", {
		Name = "FontPreviewCard",
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Constants.THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 520, 0, 438),
		ZIndex = 169,
	})
	applySectionSurface(card)
	createCorner(card, 16)
	createStroke(card)

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 20, 0, 18),
		Size = UDim2.new(1, -78, 0, 24),
		Text = "Preview UI Font",
		TextColor3 = Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 170,
	})

	create("TextLabel", {
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 20, 0, 48),
		Size = UDim2.new(1, -40, 0, 38),
		Text = "Choose a font to save it across 7kg2 Animator. Default restores the bundled 7kg2 font mix.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 170,
	})

	local closeButton = create("TextButton", {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.new(0, 34, 0, 30),
		Text = "x",
		ZIndex = 171,
	})
	styleGhostButton(closeButton)
	createCorner(closeButton, 9)

	local selectedButton = create("TextButton", {
		Name = "FontPreviewDropdownButton",
		Parent = card,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 20, 0, 96),
		Size = UDim2.new(1, -40, 0, 34),
		Text = "Default",
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 171,
	})
	styleGhostButton(selectedButton)
	createCorner(selectedButton, 10)
	create("UIPadding", {
		Parent = selectedButton,
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	})

	local list = create("ScrollingFrame", {
		Name = "FontPreviewList",
		Parent = card,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 20, 0, 138),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 5,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, -40, 0, 238),
		Visible = true,
		ZIndex = 171,
	})
	list:SetAttribute(FontPreviewService.PRESERVE_FONT_ATTRIBUTE, true)
	createCorner(list, 12)
	createStroke(list)
	create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	create("UIListLayout", {
		Parent = list,
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	for index, fontName in ipairs(FontPreviewService.getFontNames()) do
		local button = create("TextButton", {
			Name = "Font" .. tostring(fontName) .. "Option",
			Parent = list,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Font = fontName == "Default" and Enum.Font.GothamSemibold or fontFromName(fontName),
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 28),
			Text = fontName == "Default" and "Default - current 7kg2 fonts" or fontName,
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 172,
		})
		styleGhostButton(button)
		button.Font = fontName == "Default" and Enum.Font.GothamSemibold or fontFromName(fontName)
		button:SetAttribute(FontPreviewService.PRESERVE_FONT_ATTRIBUTE, true)
		createCorner(button, 8)
		create("UIPadding", {
			Parent = button,
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		})
		refs._fontPreviewOptionButtons[fontName] = button
	end

	local statusLabel = create("TextLabel", {
		Name = "FontPreviewStatus",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.new(0, 20, 1, -46),
		Size = UDim2.new(1, -40, 0, 22),
		Text = "Choose a font to save it across the plugin.",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 170,
	})

	refs._fontPreviewOverlay = overlay
	refs._fontPreviewCard = card
	refs._fontPreviewCloseButton = closeButton
	refs._fontPreviewSelectedButton = selectedButton
	refs._fontPreviewList = list
	refs._fontPreviewStatusLabel = statusLabel

	return refs
end

function FontPreviewUI.update(_context)
end

function FontPreviewUI.destroy()
end

return FontPreviewUI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX66">
          <Properties>
            <string name="Name">HeaderUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local HeaderUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke

local function styleModeTab(button, isActive)
	button.AutoButtonColor = true
	button.BackgroundColor3 = isActive and Constants.THEME.Accent or Constants.THEME.PanelSoft
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamSemibold
	button.TextColor3 = Constants.THEME.Text
	button.TextSize = 11
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.TextWrapped = false

	local stroke = create("UIStroke", {
		Name = "ModeTabStroke",
		Parent = button,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Border,
		Thickness = 1,
		Transparency = 0.55,
	})
	stroke:SetAttribute("MegMoThemeStrokeRole", "Border")
	createCorner(button, 4)
end

local MENU_SPECS = {
	{
		key = "File",
		buttonWidth = 36,
		menuWidth = 176,
		options = {
			{ id = "NewProject", text = "New" },
			{ id = "Save", text = "Save" },
			{ id = "Import", text = "Import..." },
			{ id = "Export", text = "Export" },
			{ id = "ClosePlugin", text = "Close Plugin" },
		},
	},
	{
		key = "Edit",
		buttonWidth = 36,
		menuWidth = 172,
		options = {
			{ id = "Undo", text = "Undo" },
			{ id = "Redo", text = "Redo" },
			{ id = "SelectAll", text = "Select All" },
			{ id = "Copy", text = "Copy" },
			{ id = "Cut", text = "Cut" },
			{ id = "Paste", text = "Paste" },
