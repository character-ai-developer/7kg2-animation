        <Item class="ModuleScript" referent="RBX69">
          <Properties>
            <string name="Name">KeyframeToolsUI</string>
            <ProtectedString name="Source">local ServerStorage = game:GetService("ServerStorage")

local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local KeyframeToolsUI = {}

local create = UiHelpers.create
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createSectionTitle = UiHelpers.createSectionTitle
local createListLayout = UiHelpers.createListLayout
local createCard = UiHelpers.createCard
local createDropdownMenu = UiHelpers.createDropdownMenu

local function normalizeImageAssetId(value)
	if type(value) ~= "string" then
		return nil
	end
	local text = value:gsub("^%s+", ""):gsub("%s+$", "")
	if text == "" then
		return nil
	end
	if string.match(text, "^%d+$") then
		return "rbxassetid://" .. text
	end
	return text
end

local function readImageAssetFromInstance(instance)
	if not instance then
		return nil
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		return normalizeImageAssetId(instance.Image)
	end
	if instance:IsA("StringValue") then
		return normalizeImageAssetId(instance.Value)
	end
	if instance:IsA("Decal") or instance:IsA("Texture") then
		return normalizeImageAssetId(instance.Texture)
	end
	local attr = instance:GetAttribute("Image")
		or instance:GetAttribute("ImageId")
		or instance:GetAttribute("AssetId")
	return normalizeImageAssetId(attr)
end

local function getServerStorageImage(iconName)
	local imagesFolder = ServerStorage:FindFirstChild("Images")
	if not imagesFolder then
		return nil
	end
	local names = {
		tostring(iconName or ""),
		string.gsub(tostring(iconName or ""), "%s+", ""),
		string.gsub(tostring(iconName or ""), "([A-Z])", " %1"):gsub("^%s+", ""),
	}
	for _, name in ipairs(names) do
		local image = readImageAssetFromInstance(imagesFolder:FindFirstChild(name))
		if image then
			return image
		end
	end
	return nil
end

local KEYFRAME_TOOL_ICONS = {
	Undo = "Undo",
	Redo = "Redo",
	["Select All"] = "SelectAll",
	Reset = "DefaultPose",
	Copy = "Copy",
	Cut = "Cut",
	Paste = "Paste",
	Delete = "Delete",
	Group = "Group",
	Ungroup = "Ungroup",
	Onion = "Onion",
	Mirror = "Mirror",
	Invert = "Invert",
	["Default Pose"] = "DefaultPose",
	Repeat = "Repeat",
	Easing = "Easing",
	Direction = "Direction",
	Attach = "Attach",
	Detach = "Detach",
}

local KEYFRAME_TOOL_SECTIONS = {
	{
		title = "EDIT",
		color = Color3.fromRGB(145, 82, 255),
		columns = 4,
		cellHeight = 60,
		items = {
			{ key = "copy", name = "CopyButton", label = "Copy", shortcut = "Shift+C", icon = "Copy" },
			{ key = "paste", name = "PasteButton", label = "Paste", shortcut = "Shift+V", icon = "Paste" },
			{ key = "undo", name = "UndoButton", label = "Undo", shortcut = "Shift+Z", icon = "Undo" },
			{ key = "redo", name = "RedoButton", label = "Redo", shortcut = "Shift+Y", icon = "Redo" },
			{ key = "cut", name = "CutButton", label = "Cut", shortcut = "Shift+X", icon = "Cut" },
			{ key = "selectAll", name = "SelectAllButton", label = "Select All", shortcut = "Ctrl+A", icon = "Select All" },
			{ key = "attachObject", name = "AttachObjectButton", label = "Attach", shortcut = "", icon = "Attach" },
			{ key = "detachObject", name = "DetachObjectButton", label = "Detach", shortcut = "", icon = "Detach" },
		},
	},
	{
		title = "MANAGE",
		color = Color3.fromRGB(255, 84, 126),
		columns = 2,
		cellHeight = 60,
		items = {
			{ key = "delete", name = "DeleteButton", label = "Delete", shortcut = "Shift+D", icon = "Delete" },
			{ key = "reset", name = "ResetButton", label = "Reset Pose", shortcut = "G", icon = "Reset" },
		},
	},
	{
		title = "VIEW",
		color = Color3.fromRGB(106, 238, 124),
		columns = 3,
		cellHeight = 60,
		items = {
			{ key = "onionSkin", name = "OnionSkinToggleButton", label = "Onion Skin", shortcut = "B", icon = "Onion" },
			{ key = "mirror", name = "MirrorButton", label = "Mirror", shortcut = "Shift+M", icon = "Mirror" },
			{ key = "invert", name = "InvertButton", label = "Invert", shortcut = "Shift+I", icon = "Invert" },
		},
	},
	{
		title = "MOTION",
		color = Color3.fromRGB(255, 174, 38),
		columns = 3,
		cellHeight = 60,
		items = {
			{ key = "easingStyle", name = "EasingStyleButton", label = "Easing Style", shortcut = "Linear", icon = "Easing", dropdown = true, hideDropdownChevron = true },
			{ key = "easingDirection", name = "EasingDirectionButton", label = "Direction", shortcut = "InOut", icon = "Direction", dropdown = true, hideDropdownChevron = true },
			{ key = "repeat", name = "RepeatButton", label = "Repeat", shortcut = "", icon = "Repeat" },
		},
	},
	{
		title = "GROUPING",
		color = Color3.fromRGB(91, 185, 255),
		columns = 4,
		cellHeight = 60,
		items = {
			{ key = "group", name = "GroupButton", label = "Group", shortcut = "", icon = "Group" },
			{ key = "ungroup", name = "UngroupButton", label = "Ungroup", shortcut = "", icon = "Ungroup" },
		},
	},
}

local function applyEditButtonImage(button, iconName)
	local resolvedIconName = KEYFRAME_TOOL_ICONS[tostring(iconName or "")] or iconName
	local image = UiHelpers.getButtonIconImage(resolvedIconName)
		or getServerStorageImage(iconName)
		or UiHelpers.getButtonIconImage(iconName)
	if not (button and image) then
		return
	end
	local oldVector = button:FindFirstChild("MegMoVectorIcon")
	if oldVector then
		oldVector:Destroy()
	end
	button.Text = ""
	button:SetAttribute("MegMoIconOnlyButton", true)
	button:SetAttribute("MegMoAccessibleLabel", tostring(iconName or "Action"))
	button.TextTransparency = 1
	button.TextSize = 1
	button.TextScaled = false
	local icon = button:FindFirstChild("MegMoButtonIcon")
	if not icon then
		icon = create("ImageLabel", {
			Name = "MegMoButtonIcon",
			Parent = button,
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
		})
	end
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Image = image
	icon.ImageColor3 = Constants.THEME.Text
	icon.ImageTransparency = 0
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.new(0.62, 0, 0.62, 0)
	icon.Visible = true
	icon.ZIndex = button.ZIndex + 2
	icon:SetAttribute("MegMoThemeImageRole", "Text")
	for _, child in ipairs(button:GetChildren()) do
		if child ~= icon and (child.Name == "MegMoButtonIcon" or child.Name == "MegMoVectorIcon") and child:IsA("GuiObject") then
			child.Visible = false
		end
	end
end

local function createVectorIconFrame(button)
	local oldImage = button:FindFirstChild("MegMoButtonIcon")
	if oldImage then
		oldImage:Destroy()
	end
	local oldVector = button:FindFirstChild("MegMoVectorIcon")
	if oldVector then
		oldVector:Destroy()
	end
	return create("Frame", {
		Name = "MegMoVectorIcon",
		Parent = button,
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0, 5),
		Size = UDim2.fromOffset(30, 22),
		ZIndex = button.ZIndex + 2,
	})
end

local function addIconLine(parent, x, y, width, rotation, color)
	return create("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Rotation = rotation or 0,
		Size = UDim2.fromOffset(width, 2),
		ZIndex = parent.ZIndex + 1,
	})
end

local function addIconDot(parent, x, y, color, size)
	local dot = create("Frame", {
		Parent = parent,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size or 4, size or 4),
		ZIndex = parent.ZIndex + 2,
	})
	createCorner(dot, 99)
	return dot
end

local function addIconCircle(parent, x, y, color)
	local circle = create("Frame", {
		Parent = parent,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.72,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(13, 13),
		ZIndex = parent.ZIndex + 2,
	})
	createCorner(circle, 99)
	create("UIStroke", {
		Parent = circle,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color,
		Thickness = 2,
		Transparency = 0,
	})
	return circle
end

local function addIconRect(parent, x, y, width, height, color)
	addIconLine(parent, x + width * 0.5, y, width, 0, color)
	addIconLine(parent, x + width * 0.5, y + height, width, 0, color)
	addIconLine(parent, x, y + height * 0.5, height, 90, color)
	addIconLine(parent, x + width, y + height * 0.5, height, 90, color)
end

local function applyCleanToolIcon(button, iconName, color)
	local icon = createVectorIconFrame(button)
	if iconName == "Onion" then
		addIconCircle(icon, 3, 4, color)
		addIconCircle(icon, 14, 4, color)
	elseif iconName == "Easing" then
		addIconDot(icon, 3, 15, color, 4)
		addIconLine(icon, 8, 14, 9, -15, color)
		addIconDot(icon, 10, 13, color, 4)
		addIconLine(icon, 15, 10, 11, -34, color)
		addIconDot(icon, 18, 7, color, 4)
		addIconLine(icon, 23, 6, 9, -8, color)
		addIconDot(icon, 26, 5, color, 4)
	elseif iconName == "Direction" then
		addIconRect(icon, 4, 5, 16, 12, color)
		addIconLine(icon, 15, 11, 14, 0, color)
		addIconLine(icon, 23, 8, 8, 45, color)
		addIconLine(icon, 23, 14, 8, -45, color)
	else
		local fallback = create("TextLabel", {
			Parent = icon,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			Position = UDim2.fromScale(0, 0),
			Size = UDim2.fromScale(1, 1),
			Text = tostring(iconName or ""),
			TextColor3 = color,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = icon.ZIndex + 1,
		})
		fallback:SetAttribute("MegMoThemeTextRole", nil)
	end
end

function KeyframeToolsUI.mount(parent, _context)
	if not parent then
		error("KeyframeToolsUI.mount requires parent")
	end

	local refs = {}
	local embedded = _context and _context.embedded == true
	if embedded then
		local previousMount = parent:FindFirstChild("EmbeddedKeyframeTools")
		if previousMount then
			previousMount:Destroy()
		end
	end

	local rightBottomCard
	if embedded then
		rightBottomCard = create("Frame", {
			Name = "EmbeddedKeyframeTools",
			Parent = parent,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
		})
	else
		rightBottomCard = createCard(parent, UDim2.new(1, -8, 0, 390))
		rightBottomCard.Position = UDim2.new(0, 0, 0, 494)
	end
	rightBottomCard.ClipsDescendants = true

	local toolsScroll = create("ScrollingFrame", {
		Name = "KeyframeToolsScroll",
		Parent = rightBottomCard,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.new(0, 0, 0, 0),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, 0, 1, 0),
	})
	local toolsContent = create("Frame", {
		Name = "KeyframeToolsContent",
		Parent = toolsScroll,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 442),
	})
	local keyframeToolsCollapseButton = nil
	if not embedded then
		keyframeToolsCollapseButton = UiHelpers.createPanelCollapseButton(rightBottomCard)
	end

	toolsContent.AutomaticSize = Enum.AutomaticSize.Y
	toolsContent.Size = UDim2.new(1, -8, 0, 0)
	create("UIPadding", {
		Parent = toolsContent,
		PaddingTop = UDim.new(0, embedded and 2 or 12),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	create("UIListLayout", {
		Parent = toolsContent,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local title = createSectionTitle(toolsContent, "Keyframe Tools")
	title.LayoutOrder = 1
	local status = create("TextLabel", {
		Name = "Status",
		Parent = toolsContent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		LayoutOrder = 49,
		Size = UDim2.new(1, 0, 0, 58),
		Font = Enum.Font.Gotham,
		Text = "Loading...",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	createCorner(status, 10)
	createStroke(status)
	create("UIPadding", {
		Parent = status,
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	local toolButtons = {}
	local function createEditButton(parent, item, sectionColor, layoutOrder)
		local button = create("TextButton", {
			Name = item.name,
			Parent = parent,
			LayoutOrder = layoutOrder,
			BackgroundColor3 = item.primary and sectionColor or Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			TextColor3 = Constants.THEME.Text,
			TextSize = 1,
			TextTransparency = 1,
			TextWrapped = false,
			ZIndex = 21,
		})
		button:SetAttribute("MegMoThemeBackgroundRole", item.primary and nil or "PanelSoft")
		button:SetAttribute("MegMoIconOnlyButton", true)
		button:SetAttribute("MegMoAccessibleLabel", item.label)
		createCorner(button, 10)
		local stroke = createStroke(button, sectionColor, item.primary and 1.6 or 1)
		stroke.Color = sectionColor
		stroke.Transparency = item.primary and 0.08 or 0.36
		stroke:SetAttribute("MegMoThemeStrokeRole", nil)
		if item.cleanIcon then
			applyCleanToolIcon(button, item.cleanIcon, sectionColor)
		elseif not item.hideIcon then
			applyEditButtonImage(button, item.icon)
		end
		local icon = button:FindFirstChild("MegMoButtonIcon")
		if icon and icon:IsA("ImageLabel") then
			icon.AnchorPoint = Vector2.new(0.5, 0)
			icon.ImageColor3 = item.primary and Constants.THEME.Text or sectionColor
			icon.Position = UDim2.new(0.5, 0, 0, 6)
			icon.Size = UDim2.fromOffset(21, 21)
			icon:SetAttribute("MegMoThemeImageRole", nil)
		end
		local labelTop = 29
		local subtextTop = -15
		local label = create("TextLabel", {
			Name = "MegMoActionLabel",
			Parent = button,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(0, 4, 0, labelTop),
			Size = UDim2.new(1, -8, 0, 16),
			Text = item.label,
			TextColor3 = Constants.THEME.Text,
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 23,
		})
		label:SetAttribute("MegMoThemeTextRole", "Text")
		local shortcut = create("TextLabel", {
			Name = "MegMoActionSubtext",
			Parent = button,
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Position = UDim2.new(0, 4, 1, subtextTop),
			Size = UDim2.new(1, -8, 0, 12),
			Text = item.shortcut or "",
			TextColor3 = item.primary and Constants.THEME.Text or Constants.THEME.MutedText,
			TextSize = 9,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			Visible = (item.shortcut or "") ~= "",
			ZIndex = 23,
		})
		shortcut:SetAttribute("MegMoThemeTextRole", item.primary and "Text" or "MutedText")
		if item.dropdown and not item.hideDropdownChevron then
			local chevron = create("TextLabel", {
				Name = "MegMoDropdownChevron",
				Parent = button,
				AnchorPoint = Vector2.new(1, 0.5),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				Text = "v",
				TextColor3 = sectionColor,
				TextSize = 13,
				ZIndex = 24,
			})
			chevron:SetAttribute("MegMoThemeTextRole", nil)
		end
		return button
	end

	local function createToolSection(section, order)
		local sectionFrame = create("Frame", {
			Name = section.title .. "Section",
			Parent = toolsContent,
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 0),
			ZIndex = 20,
		})
		create("UIListLayout", {
			Parent = sectionFrame,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		local sectionTitle = create("TextLabel", {
			Name = section.title .. "Title",
			Parent = sectionFrame,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 16),
			Text = section.title,
			TextColor3 = section.color,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 21,
		})
		sectionTitle:SetAttribute("MegMoThemeTextRole", nil)
		local columns = math.max(1, section.columns or 2)
		local rows = math.ceil(#section.items / columns)
		local grid = create("Frame", {
			Name = section.title .. "Grid",
			Parent = sectionFrame,
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, rows * section.cellHeight + math.max(0, rows - 1) * 6),
			ZIndex = 20,
		})
		create("UIGridLayout", {
			Parent = grid,
			CellPadding = UDim2.fromOffset(6, 6),
			CellSize = UDim2.new(1 / columns, -5, 0, section.cellHeight),
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		for index, item in ipairs(section.items) do
			item.compact = section.cellHeight &lt;= 70
			toolButtons[item.key] = createEditButton(grid, item, section.color, index)
		end
	end

	for index, section in ipairs(KEYFRAME_TOOL_SECTIONS) do
		createToolSection(section, index + 2)
	end

	local undoButton = toolButtons.undo
	local redoButton = toolButtons.redo
	local selectAllButton = toolButtons.selectAll
	local resetButton = toolButtons.reset
	local copyButton = toolButtons.copy
	local cutButton = toolButtons.cut
	local pasteButton = toolButtons.paste
	local deleteButton = toolButtons.delete
	local groupButton = toolButtons.group
	local ungroupButton = toolButtons.ungroup
	local onionSkinToggleButton = toolButtons.onionSkin
	local mirrorButton = toolButtons.mirror
	local invertButton = toolButtons.invert
	local defaultPoseButton = toolButtons.defaultPose or create("TextButton", {
		Name = "DefaultPoseButton",
		Parent = rightBottomCard,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 0),
		Text = "",
		Visible = false,
	})
	local repeatButton = toolButtons["repeat"]
	local easingStyleButton = toolButtons.easingStyle
	local easingDirectionButton = toolButtons.easingDirection
	local attachObjectButton = toolButtons.attachObject
	local detachObjectButton = toolButtons.detachObject
	local easingStyleDropdown, easingStyleOptionButtons = createDropdownMenu(easingStyleButton, Constants.EASING_STYLES, 7)
	local easingDirectionDropdown, easingDirectionOptionButtons = createDropdownMenu(easingDirectionButton, Constants.EASING_DIRECTIONS, 3)

	local shortcutHint = create("TextLabel", {
		Name = "ShortcutHint",
		Parent = toolsContent,
		BackgroundTransparency = 1,
		LayoutOrder = 50,
		Size = UDim2.new(1, 0, 0, 42),
		Font = Enum.Font.Gotham,
		Text = "Shortcuts: + add keyframe, Ctrl+D delete keys, Ctrl+A select all, G default pose, [/] prev/next frame, Space play/pause, B onion skin, H highlight",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.None,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	local shortcutCaptureInput = create("TextBox", {
		Name = "ShortcutCaptureInput",
		Parent = toolsContent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		LayoutOrder = 51,
		Size = UDim2.fromOffset(1, 1),
		Font = Enum.Font.Gotham,
		PlaceholderText = "",
		Text = "",
		TextColor3 = Constants.THEME.MutedText,
		TextTransparency = 1,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	createCorner(shortcutCaptureInput, 8)
	local shortcutCaptureStroke = createStroke(shortcutCaptureInput)
	shortcutCaptureStroke.Transparency = 1
	create("UIPadding", {
		Parent = shortcutCaptureInput,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	refs._status = status
	refs._shortcutHint = shortcutHint
	refs._shortcutCaptureInput = shortcutCaptureInput
	refs._deleteButton = deleteButton
	refs._copyButton = copyButton
	refs._cutButton = cutButton
	refs._pasteButton = pasteButton
	refs._groupButton = groupButton
	refs._ungroupButton = ungroupButton
	refs._keyframeAttachObjectButton = attachObjectButton
	refs._keyframeDetachObjectButton = detachObjectButton
	refs._onionSkinToggleButton = onionSkinToggleButton
	refs._mirrorButton = mirrorButton
	refs._invertButton = invertButton
	refs._defaultPoseButton = defaultPoseButton
	refs._repeatButton = repeatButton
	refs._easingStyleButton = easingStyleButton
	refs._easingDirectionButton = easingDirectionButton
	refs._easingStyleDropdown = easingStyleDropdown
	refs._easingDirectionDropdown = easingDirectionDropdown
	refs._easingStyleOptionButtons = easingStyleOptionButtons
	refs._easingDirectionOptionButtons = easingDirectionOptionButtons
	refs._selectAllButton = selectAllButton
	refs._undoButton = undoButton
	refs._redoButton = redoButton
	refs._resetButton = resetButton
	if embedded then
		refs._embeddedKeyframeToolsCard = rightBottomCard
	else
		refs._keyframeToolsCard = rightBottomCard
		refs._keyframeToolsCollapseButton = keyframeToolsCollapseButton
	end

	return refs
end

function KeyframeToolsUI.update(_context)
end

function KeyframeToolsUI.destroy()
end

return KeyframeToolsUI
