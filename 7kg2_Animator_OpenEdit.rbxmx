          <Properties>
            <string name="Name">PhysicsLauncherPopupSupport</string>
            <ProtectedString name="Source">local CoreGui = game:GetService("CoreGui")
local Selection = game:GetService("Selection")
local UserInputService = game:GetService("UserInputService")

local PhysicsLauncherPopupSupport = {}
local PhysicsThemeSupport = require(script.Parent.Parent:WaitForChild("PhysicsThemeSupport"))

local OPEN_EVENT_NAME = "MegMoPhysicsOpenRequest"
local OVERLAY_NAME = "MegMoPhysicsLauncherOverlay"
local LOGO = "rbxassetid://110022673488157"

local COLORS = {
	background = Color3.fromRGB(7, 11, 18),
	panel = Color3.fromRGB(15, 21, 32),
	card = Color3.fromRGB(31, 40, 58),
	cardBottom = Color3.fromRGB(22, 29, 43),
	border = Color3.fromRGB(61, 74, 96),
	hover = Color3.fromRGB(242, 246, 255),
	text = Color3.fromRGB(247, 249, 255),
	muted = Color3.fromRGB(202, 211, 229),
	accent = Color3.fromRGB(126, 86, 255),
	error = Color3.fromRGB(244, 88, 112),
}

local EFFECTS = {
	{
		id = "Release",
		title = "Release a held object",
		description = "Detach an animated prop, inherit its movement and spin, then capture its natural fall and collisions.",
		image = "rbxassetid://88271717750306",
		color = Color3.fromRGB(72, 214, 255),
	},
	{
		id = "Drop",
		title = "Drop or bounce",
		description = "Turn selected loose Parts or Models physical and capture their falls, rolling, collisions and bounce.",
		image = "rbxassetid://101930051479581",
		color = Color3.fromRGB(82, 139, 255),
	},
	{
		id = "Character",
		title = "Ragdoll",
		description = "Turn a selected R6 or R15 character into a ragdoll for falls, impacts and full-body reactions.",
		image = "rbxassetid://85022907825347",
		color = Color3.fromRGB(126, 86, 255),
	},
	{
		id = "Impact",
		title = "Drive &amp; Impact",
		description = "Drive an animated object or vehicle through its route and capture jumps, collisions and debris.",
		image = "rbxassetid://101298906973815",
		color = Color3.fromRGB(255, 201, 92),
	},
	{
		id = "Projectile",
		title = "Launch projectile",
		description = "Launch a selected projectile toward an impact point and capture its flight and target reaction.",
		image = "rbxassetid://122613049511323",
		color = Color3.fromRGB(255, 116, 62),
	},
	{
		id = "Explosion",
		title = "Create explosion",
		description = "Add a timed blast that pushes selected objects outward with controllable strength and timing.",
		image = "rbxassetid://119229108932478",
