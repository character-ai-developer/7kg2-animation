editorActions.loadSavedProjects = editorActions._importActions.loadSavedProjects
editorActions.loadMyAnimations = editorActions._importActions.loadMyAnimations
editorActions.loadPresetAnimations = editorActions._importActions.loadPresetAnimations
editorActions.openSavedProject = openSavedProjectByName

pcall(function()
	local uiFolder = Modules:FindFirstChild("UI")
	local microMainScript = uiFolder and uiFolder:FindFirstChild("MicroMain")
	if not microMainScript then
		return
	end

	require(microMainScript).bindImportActions(editorActions, {
				saveAnimation = saveAnimation,
				newAnimation = newAnimationFile,
				saveAndNewAnimation = saveAndNewAnimationFile,
				exportAnimation = exportAnimation,
				selectTheme = selectTheme,
				togglePerformanceDebug = togglePerformanceDebug,
				getPerformanceViewModel = function()
					return PerformanceDebugService.getViewModel({
						trackCount = #timeline:getTracks(),
						keyframeCount = timeline:getKeyframeCount(),
						markerCount = #MotionService.listMotionMarkers(),
						isPlaying = playbackService and playbackService:getIsPlaying() or false,
						buildId = BuildInfo.BUILD_ID,
					})
				end,
				openMotionRecipeManager = openMotionRecipeManager,
				saveMotionRecipe = saveMotionRecipe,
				loadMotionRecipe = loadMotionRecipe,
				renameMotionRecipe = renameMotionRecipe,
				deleteMotionRecipe = deleteMotionRecipe,
				importAnimationId = MegMo_ImportAnimationId,
				importSelectedAnimation = MegMo_ImportSelectedAnimation,
				loadSavedProjects = editorActions._importActions.loadSavedProjects,
				loadMyAnimations = editorActions._importActions.loadMyAnimations,
				loadMoreMyAnimations = editorActions._importActions.loadMoreMyAnimations,
				loadPresetAnimations = editorActions._importActions.loadPresetAnimations,
				loadBulkKeyframeSequences = editorActions._importActions.loadBulkKeyframeSequences,
				searchMarketplaceAnimations = editorActions._importActions.searchStarterAnimations,
				searchMyAnimations = editorActions._importActions.searchMyAnimations,
				importBulkKeyframeSequence = editorActions._importActions.importBulkKeyframeSequence,
				openR15ToR6Converter = MegMo_OpenR15ToR6Converter,
				openSavedProject = openSavedProjectByName,
				importSavedProjectOntoSelectedRig = editorActions.importSavedProjectOntoSelectedRig,
				validateCutscene = function(options)
					local ok, isValid, message = pcall(function()
						return require(Modules:WaitForChild("Cutscene"):WaitForChild("CutsceneExportService")).validate(timeline, BuildInfo, options)
					end)
					local status = ok and message or ("Cutscene validation failed: " .. tostring(isValid))
					if ok and not isValid then
						status = message
					end
					refreshUi(status)
					return status
				end,
				generateCutscene = function(options)
					ChangeHistoryService:SetWaypoint("Before Generate Cutscene")
					local ok, success, message = pcall(function()
						return require(Modules:WaitForChild("Cutscene"):WaitForChild("CutsceneExportService")).generate(timeline, BuildInfo, options)
					end)
					local status = ok and message or ("Cutscene generation failed: " .. tostring(success))
					if ok and success then
						ChangeHistoryService:SetWaypoint("After Generate Cutscene")
					end
					refreshUi(status)
					return status
				end,
				getImportEntries = function()
					return importAnimationEntries
				end,
				getImportBrowserStatus = function()
					return importBrowserStatus
				end,
			})
end)

function editorActions.renameAnimation(name)
	pushUndo("Rename Animation")
	if timeline:renameAnimation(name) then
		refreshUi(string.format("Renamed animation to '%s'.", timeline:getAnimationName()))
	else
		historyService:discardPendingUndo()
		refreshUi("Enter a valid animation name before renaming.")
	end
end

function editorActions.attachHandToSelection()
	if not selectedJointPath then
		refreshUi("Select a rig body-part track before attaching a prop.")
		return
	end

	pushUndo("Attach Object")
	ChangeHistoryService:SetWaypoint("Before Attach Object")
	local service = require(Modules:WaitForChild("AttachService"))
	local success, message, result = service.attachObject({
		timeline = timeline,
		selectedPath = selectedJointPath,
		selection = SelectionService.getSelection(),
		fallbackSelection = SelectionService.getLastWorkspaceSelection(),
		frame = timeline:getCurrentFrame(),
	})
	ChangeHistoryService:SetWaypoint("After Attach Object")

	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Attach Object could not create the helper Motor6D.")
		return
	end

	local objectTrack = result and result.objectTrack
	if objectTrack then
		setSingleSelectedTrack(objectTrack.path)
		selectKeys({
			{
				jointPath = objectTrack.path,
				frame = timeline:getCurrentFrame(),
			},
		})
	end

	service.prepareTimelineState(timeline, timeline:getCurrentFrame())
	timeline:applyCurrentFrame()
	service.applyTimelineState(timeline, timeline:getCurrentFrame())
	refreshUi(message)
end

function editorActions.detachAttachedObject()
	pushUndo("Detach Object")
	ChangeHistoryService:SetWaypoint("Before Detach Object")
	local service = require(Modules:WaitForChild("AttachService"))
	local success, message, result = service.detachObject({
		timeline = timeline,
		selectedPath = selectedJointPath,
		selection = SelectionService.getSelection(),
		fallbackSelection = SelectionService.getLastWorkspaceSelection(),
		frame = timeline:getCurrentFrame(),
	})
	ChangeHistoryService:SetWaypoint("After Detach Object")

	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Detach Object could not find an attached prop.")
		return
	end

	local objectTrack = result and result.objectTrack
	if objectTrack then
		setSingleSelectedTrack(objectTrack.path)
		selectKeys({
			{
				jointPath = objectTrack.path,
				frame = timeline:getCurrentFrame(),
			},
		})
	end

	service.prepareTimelineState(timeline, timeline:getCurrentFrame())
	timeline:applyCurrentFrame()
	service.applyTimelineState(timeline, timeline:getCurrentFrame())
	refreshUi(message)
end

function editorActions.smoothSelectedMotion(mode)
	local selectedKeyRefs = getSelectedKeyRefs()
	if #selectedKeyRefs == 0 then
		refreshUi("Select middle keyframes before smoothing motion.")
		return
	end

	pushUndo("Smooth Motion")
	ChangeHistoryService:SetWaypoint("Before Smooth Motion")
	local service = require(Modules:WaitForChild("MotionSmoothingService"))
	local success, message, changedKeys = service.smoothSelectedKeys(timeline, selectedKeyRefs, mode or "Light")
	ChangeHistoryService:SetWaypoint("After Smooth Motion")

	if not success then
		historyService:discardPendingUndo()
		refreshUi(message or "Smooth Motion could not update the selected keyframes.")
		return
	end

	if changedKeys and #changedKeys &gt; 0 then
		selectKeys(changedKeys)
	end
	timeline:applyCurrentFrame()
	refreshUi(message)
end

function editorActions.showEnhanceFutureAction(actionName)
	refreshUi(tostring(actionName or "This assist") .. " is planned next. The button is in place but does not change keyframes yet.")
end

function editorActions.addTrack(trackType)
	local lightingEffectType = nil
	if trackType == "Lighting" or trackType == "LightingEffect" or trackType == "game.Lighting" then
		lightingEffectType = "Lighting"
	elseif trackType == "Atmosphere"
		or trackType == "Sky"
		or trackType == "Bloom"
		or trackType == "DepthOfField"
		or trackType == "Depth Of Field"
		or trackType == "SunRays"
		or trackType == "Sunrays"
		or trackType == "ColorCorrection"
		or trackType == "Color Correction"
		or trackType == "Blur"
		or trackType == "Highlight"
	then
		lightingEffectType = trackType
	end
	if lightingEffectType then
		return require(Modules:WaitForChild("LightingEffectActionService")).addTrack({
			timeline = timeline,
			refreshUi = refreshUi,
			pushUndo = pushUndo,
			changeHistoryService = ChangeHistoryService,
			historyService = historyService,
			setSingleSelectedTrack = setSingleSelectedTrack,
		}, lightingEffectType)
	end

	local selected = SelectionService.getFirstSelected()
	local instance = selected
	local name = nil

	if trackType == "Camera" then
		instance = workspace.CurrentCamera
		name = "Camera"
	elseif trackType == "Folder" then
		instance = nil
		local folderCount = #timeline:getTimelineFolders() + 1
		name = string.format("Folder %d", folderCount)
	elseif trackType == "EmitterGroup" then
		if not selected then
			refreshUi("Select a Part, Attachment, Folder, Model, or ParticleEmitter before adding an Emitter Group.")
			return
		end
		local emitterCount = ParticleEmitterGroupService.getEmitterCount(selected)
		if emitterCount == 0 then
			refreshUi("The selected item does not contain any ParticleEmitters.")
			return
		end
		name = ParticleEmitterGroupService.getDisplayName(selected)
	elseif trackType == "Sound" then
		if selected then
			if selected:IsA("Sound") then
				instance = selected
			else
				instance = selected:FindFirstChildWhichIsA("Sound", true)
			end
		end
		if not instance or not instance:IsA("Sound") then
			refreshUi("Select a Sound, or an object containing a Sound, before adding a Sound track.")
			return
		end
		name = instance.Name
	elseif trackType == "RigCFrame" then
		instance = SelectionService.getSelectedRig() or (timeline:getMotorByPath(selectedJointPath) and timeline:getMotorByPath(selectedJointPath).rig) or timeline:getRig()
		name = instance and (instance.Name .. " CFrame") or "Rig CFrame"
	elseif trackType == "Event" then
		instance = nil
		name = "Event"
	elseif not selected then
		refreshUi("Select an object in Studio before adding an object/model track.")
		return
	end

	if (trackType == "Model" or trackType == "RigCFrame") and instance and not instance:IsA("Model") then
		local model = instance:FindFirstAncestorOfClass("Model")
		if model then
			instance = model
		end
	end

	if trackType == "RigCFrame" and not instance then
		refreshUi("Select or bind a rig before adding a Rig CFrame track.")
		return
	end

	pushUndo("Add Track")
	local metadata = nil
	if trackType == "EmitterGroup" then
		metadata = {
			targetScope = "EmitterGroup",
			emitters = ParticleEmitterGroupService.collectEmitters(instance),
			sortOrder = 8,
		}
	elseif trackType == "Folder" then
		metadata = {
			targetScope = "TimelineFolder",
			sortOrder = 2,
		}
	end
	local track = timeline:addGenericTrack(trackType, instance, name, metadata)
	setSingleSelectedTrack(track.path)
	local trackPropertyDefaultsService = require(Modules:WaitForChild("TrackPropertyDefaultsService"))
	if trackType == "Object" or trackType == "Model" then
		local addedObjectProperties, defaultObjectTrack = trackPropertyDefaultsService.addDefaultObjectPropertyTracks(timeline, track)
		if defaultObjectTrack and defaultObjectTrack.path then
			setSingleSelectedTrack(defaultObjectTrack.path)
			refreshSelectedGizmo()
			refreshUi(string.format(
				"Added %s track '%s' with %d starter propert%s.",
				track.trackType or "Object",
				track.name,
				addedObjectProperties,
				addedObjectProperties == 1 and "y" or "ies"
			))
			return
		end
	end
	if trackType == "EmitterGroup" then
		local addedProperties = trackPropertyDefaultsService.addDefaultEmitterGroupPropertyTracks(timeline, track)
		local groupEmitterCount = ParticleEmitterGroupService.getEmitterCount(instance)
		refreshUi(string.format(
			"Added Emitter Group '%s' with %d emitter%s and %d starter propert%s.",
			track.name,
			groupEmitterCount,
			groupEmitterCount == 1 and "" or "s",
			addedProperties,
			addedProperties == 1 and "y" or "ies"
		))
		return
	end
	local addedLightProperties, defaultLightTrack = trackPropertyDefaultsService.addDefaultLightPropertyTracks(timeline, track)
	if addedLightProperties &gt; 0 then
		local selectedLightTrackPath = defaultLightTrack and defaultLightTrack.path
		if not selectedLightTrackPath and type(timeline.getChildPropertyTrackPaths) == "function" then
			selectedLightTrackPath = timeline:getChildPropertyTrackPaths(track.path)[1]
		end
		if selectedLightTrackPath then
			setSingleSelectedTrack(selectedLightTrackPath)
		end
		refreshUi(string.format(
			"Added %s track '%s' with %d starter propert%s.",
			track.trackType or "Object",
			track.name,
			addedLightProperties,
			addedLightProperties == 1 and "y" or "ies"
		))
		return
	end
	refreshUi(string.format("Added %s track '%s'.", track.trackType, track.name))
end

function editorActions.addScreenEffectTrack(effectType)
	local effectDefinition = ScreenEffectTrackService.getEffectDefinition(effectType)
	if not effectDefinition then
		refreshUi("That screen effect track is not available yet.")
		return
	end

	pushUndo("Add Screen Effect Track")
	ChangeHistoryService:SetWaypoint("Before Add Screen Effect Track")
	local track, wasAdded = ScreenEffectTrackService.addTrack(timeline, effectType)
	setSingleSelectedTrack(track.path)
	if wasAdded then
		ChangeHistoryService:SetWaypoint("After Add Screen Effect Track")
		refreshUi(string.format("Added %s screen effect track. Add keyframes, then use ... or Keypad 7 for settings.", effectDefinition.name or track.name))
	else
		historyService:discardPendingUndo()
		refreshUi(string.format("%s screen effect track already exists.", effectDefinition.name or track.name))
	end
	return track.path
end

