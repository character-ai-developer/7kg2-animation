	},
}

local function make(className, properties, parent)
	local instance = Instance.new(className)
	for property, value in pairs(properties or {}) do
		instance[property] = value
	end
	instance.Parent = parent
	return instance
end

local function corner(parent, radius)
	return make("UICorner", {
		CornerRadius = UDim.new(0, radius),
	}, parent)
end

local function stroke(parent, color, transparency, thickness)
	return make("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
	}, parent)
end

local function subjectText()
	local selected = Selection:Get()
	if #selected == 1 then
		return selected[1].Name
	end
	if #selected &gt; 1 then
		return string.format("%d selected objects", #selected)
	end
	return "Choose in the effect setup"
end

local function destroyExisting(parent)
	local existing = parent and parent:FindFirstChild(OVERLAY_NAME)
	if existing then
		existing:Destroy()
	end
end

local function readPopupNumber(plugin, key)
	if not plugin then
		return nil
	end
	local success, value = pcall(function()
		return plugin:GetSetting(key)
	end)
	return success and tonumber(value) or nil
end

local function savePopupNumber(plugin, key, value)
	if not plugin then
		return
	end
	pcall(function()
		plugin:SetSetting(key, value)
	end)
end

function PhysicsLauncherPopupSupport.open(parent, options)
	options = options or {}
	if not parent then
		return false, "Physics needs a UI parent."
	end

	destroyExisting(parent)
	PhysicsThemeSupport.SyncPalette(COLORS)
	COLORS.card = COLORS.button
	COLORS.cardBottom = COLORS.panelAlt
	COLORS.hover = COLORS.text

	local compact = options.compact == true
	local movable = compact or options.movable == true
	local plugin = options.plugin
	local popupSettingPrefix = compact and "MegMoMicroAddPhysicsPopup" or "MegMoMainAddPhysicsPopup"
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local popupBounds = parent:IsA("GuiObject") and parent.AbsoluteSize or viewport
	local popupMinWidth = compact and 420 or 430
	local popupMinHeight = 430
	local popupMaxWidth = movable and 720 or 610
	local popupMaxHeight = movable and 680 or 510
	local popupWidth = math.clamp(
		readPopupNumber(plugin, popupSettingPrefix .. "W")
			or (compact and 520 or math.floor(popupBounds.X * 0.58)),
		popupMinWidth,
		popupMaxWidth
	)
	local popupHeight = math.clamp(
		readPopupNumber(plugin, popupSettingPrefix .. "H")
			or (compact and 480 or math.floor(popupBounds.Y * 0.78)),
		popupMinHeight,
		popupMaxHeight
	)
	local popupX = math.clamp(
		readPopupNumber(plugin, popupSettingPrefix .. "X") or math.floor((popupBounds.X - popupWidth) * 0.5),
		6,
		math.max(6, popupBounds.X - popupWidth - 6)
	)
	local popupY = math.clamp(
		readPopupNumber(plugin, popupSettingPrefix .. "Y") or math.floor((popupBounds.Y - popupHeight) * 0.5),
		6,
		math.max(6, popupBounds.Y - popupHeight - 6)
	)
	local overlay = make("TextButton", {
		Name = OVERLAY_NAME,
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(2, 4, 8),
		BackgroundTransparency = 0.28,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 900,
	}, parent)

	local card = make("Frame", {
		Name = "AddPhysics",
		AnchorPoint = movable and Vector2.new(0, 0) or Vector2.new(0.5, 0.5),
		BackgroundColor3 = COLORS.background,
		BorderSizePixel = 0,
		Position = movable and UDim2.fromOffset(popupX, popupY) or UDim2.fromScale(0.5, 0.5),
		Size = movable and UDim2.fromOffset(popupWidth, popupHeight) or UDim2.new(0.58, 0, 0.78, 0),
		ZIndex = 901,
	}, overlay)
	corner(card, 12)
	stroke(card, COLORS.border, 0.08, 1.2)
	make("UISizeConstraint", {
		MaxSize = Vector2.new(popupMaxWidth, popupMaxHeight),
		MinSize = Vector2.new(popupMinWidth, popupMinHeight),
	}, card)

	local dragHandle = make("TextButton", {
		Name = "DragHandle",
		Active = movable,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, -54, 0, 50),
		Text = "",
		Visible = movable,
		ZIndex = 902,
	}, card)
	make("ImageLabel", {
		Name = "PhysicsLogo",
		BackgroundTransparency = 1,
		Image = LOGO,
		ImageColor3 = COLORS.text,
		Position = UDim2.fromOffset(16, 13),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(28, 28),
		ZIndex = 903,
	}, card)
	make("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(52, 10),
		Size = UDim2.new(1, -104, 0, 34),
		Text = "Add Physics",
		TextColor3 = COLORS.text,
		TextSize = compact and 17 or 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 903,
	}, card)
	local close = make("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		AutoButtonColor = true,
		BackgroundColor3 = COLORS.card,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(32, 32),
		Text = "X",
		TextColor3 = COLORS.text,
		TextSize = 13,
		ZIndex = 905,
	}, card)
	corner(close, 7)

	local optionsFrame = make("Frame", {
		Name = "Effects",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(1, -28, 0.58, -4),
		ZIndex = 902,
	}, card)
	local grid = make("UIGridLayout", {
		CellPadding = UDim2.fromOffset(8, 8),
		CellSize = UDim2.new(0.5, -4, 0.25, -6),
		FillDirection = Enum.FillDirection.Horizontal,
		FillDirectionMaxCells = 2,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, optionsFrame)
	grid.Name = "EffectGrid"

	local summary = make("Frame", {
		Name = "Summary",
		BackgroundColor3 = COLORS.panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0.7, 0),
		Size = UDim2.new(1, -28, 0, 78),
		ZIndex = 902,
	}, card)
	corner(summary, 8)
	stroke(summary, COLORS.border, 0.2, 1)
	local summaryTitle = make("TextLabel", {
		Name = "SummaryTitle",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Text = "Choose an effect",
		TextColor3 = COLORS.text,
		TextSize = compact and 13 or 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 903,
	}, summary)
	local summaryDescription = make("TextLabel", {
		Name = "SummaryDescription",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(12, 29),
		Size = UDim2.new(1, -24, 1, -37),
		Text = "Select the physics result you want. 7kg2 will open its guided setup in Kinetic.",
		TextColor3 = COLORS.text,
		TextSize = compact and 12 or 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 903,
	}, summary)

	local subject = make("TextLabel", {
		Name = "Subject",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 14, 0.7, 84),
		Size = UDim2.new(1, -28, 0, 26),
		Text = "Current selection: " .. subjectText(),
		TextColor3 = COLORS.muted,
		TextSize = compact and 10 or 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 902,
	}, card)

	if movable then
		local resizeGrip = make("ImageButton", {
			Name = "ResizeGrip",
			Active = true,
			AnchorPoint = Vector2.new(1, 1),
			AutoButtonColor = false,
			BackgroundColor3 = COLORS.card,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Image = "rbxassetid://104703373565023",
			ImageColor3 = COLORS.text,
			ImageTransparency = 0.12,
			Position = UDim2.new(1, -5, 1, -5),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(18, 18),
			ZIndex = 910,
		}, card)
		corner(resizeGrip, 4)

		local popupConnections = {}
		local dragging = false
		local resizing = false
		local dragStart = nil
		local resizeStart = nil
		local startPosition = nil
		local startSize = nil
		local function connectPopup(signal, callback)
			local connection = signal:Connect(callback)
			table.insert(popupConnections, connection)
			return connection
		end
		local function saveGeometry()
			savePopupNumber(plugin, popupSettingPrefix .. "X", card.Position.X.Offset)
			savePopupNumber(plugin, popupSettingPrefix .. "Y", card.Position.Y.Offset)
			savePopupNumber(plugin, popupSettingPrefix .. "W", card.AbsoluteSize.X)
			savePopupNumber(plugin, popupSettingPrefix .. "H", card.AbsoluteSize.Y)
		end
		local function stopInteraction()
			if dragging or resizing then
				dragging = false
				resizing = false
				saveGeometry()
			end
		end

		connectPopup(dragHandle.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			dragging = true
			dragStart = input.Position
			startPosition = card.Position
		end)
		connectPopup(resizeGrip.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			resizing = true
			resizeStart = input.Position
			startSize = card.AbsoluteSize
		end)
		connectPopup(UserInputService.InputChanged, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end
			if dragging and dragStart and startPosition then
				local delta = input.Position - dragStart
				local currentViewport = parent:IsA("GuiObject") and parent.AbsoluteSize
					or (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or viewport)
				card.Position = UDim2.fromOffset(
					math.clamp(
						startPosition.X.Offset + delta.X,
						6,
						math.max(6, currentViewport.X - card.AbsoluteSize.X - 6)
					),
					math.clamp(
						startPosition.Y.Offset + delta.Y,
						6,
						math.max(6, currentViewport.Y - card.AbsoluteSize.Y - 6)
					)
				)
			elseif resizing and resizeStart and startSize then
				local delta = input.Position - resizeStart
				card.Size = UDim2.fromOffset(
					math.clamp(startSize.X + delta.X, popupMinWidth, popupMaxWidth),
					math.clamp(startSize.Y + delta.Y, popupMinHeight, popupMaxHeight)
				)
			end
		end)
		connectPopup(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				stopInteraction()
			end
		end)
		connectPopup(overlay.Destroying, function()
			stopInteraction()
			for _, connection in ipairs(popupConnections) do
				connection:Disconnect()
			end
			table.clear(popupConnections)
		end)
	end

	local lastItem = nil
	local function highlightItem(item)
		if lastItem and lastItem ~= item then
			lastItem.stroke.Color = lastItem.effect.color
			lastItem.stroke.Transparency = 0.48
			lastItem.stroke.Thickness = 1
			lastItem.button.BackgroundColor3 = COLORS.card
		end
		lastItem = item
		item.stroke.Color = COLORS.hover
		item.stroke.Transparency = 0.02
		item.stroke.Thickness = 2
		item.button.BackgroundColor3 = COLORS.card:Lerp(item.effect.color, 0.12)
		summaryTitle.Text = item.effect.title
		summaryTitle.TextColor3 = item.effect.color
		summaryDescription.Text = item.effect.description
		summaryDescription.TextColor3 = COLORS.text
	end

	local function launch(effect)
		local openEvent = CoreGui:FindFirstChild(OPEN_EVENT_NAME)
		if not (openEvent and openEvent:IsA("BindableEvent") and openEvent:GetAttribute("MegMoPhysicsReady") == true) then
			summaryTitle.Text = "Physics is still loading"
			summaryTitle.TextColor3 = COLORS.error
			summaryDescription.Text = "Close and reopen 7kg2, then try Add Physics again."
			summaryDescription.TextColor3 = COLORS.error
			return
		end
		openEvent:Fire({
			source = "MegMoAnimator",
			effectMode = effect.id,
			compact = compact,
			movable = movable,
		})
		overlay:Destroy()
	end

	for index, effect in ipairs(EFFECTS) do
		local button = make("TextButton", {
			Name = effect.id,
			AutoButtonColor = false,
			BackgroundColor3 = COLORS.card,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Text = "",
			ZIndex = 903,
		}, optionsFrame)
		corner(button, 7)
		make("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, COLORS.card:Lerp(effect.color, 0.12)),
				ColorSequenceKeypoint.new(1, COLORS.cardBottom),
			}),
			Rotation = 90,
		}, button)
		local buttonStroke = stroke(button, effect.color, 0.48, 1)
		make("ImageLabel", {
			Name = "Icon",
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = effect.color:Lerp(COLORS.background, 0.67),
			BorderSizePixel = 0,
			Image = effect.image,
			Position = UDim2.new(0, 8, 0.5, 0),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(compact and 38 or 42, compact and 38 or 42),
			ZIndex = 904,
		}, button)
		corner(button.Icon, 5)
		make("TextLabel", {
			Name = "Label",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(compact and 54 or 58, 0),
			Size = UDim2.new(1, compact and -62 or -66, 1, 0),
			Text = effect.title,
			TextColor3 = COLORS.text,
			TextSize = compact and 11 or 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 904,
		}, button)
		local item = {
			button = button,
			effect = effect,
			stroke = buttonStroke,
		}
		button.MouseEnter:Connect(function()
			highlightItem(item)
		end)
		button.Activated:Connect(function()
			highlightItem(item)
			launch(effect)
		end)
	end

	close.Activated:Connect(function()
		overlay:Destroy()
	end)

	PhysicsThemeSupport.Apply(card, COLORS)
	return true, overlay
end

function PhysicsLauncherPopupSupport.close(parent)
	destroyExisting(parent)
end

return PhysicsLauncherPopupSupport
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX98">
          <Properties>
            <string name="Name">PresetsUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local PresetsUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local styleInput = UiHelpers.styleInput
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createMetaLabel = UiHelpers.createMetaLabel
local createCard = UiHelpers.createCard
local createListLayout = UiHelpers.createListLayout
local applyPanelSurface = UiHelpers.applyPanelSurface
local applySectionSurface = UiHelpers.applySectionSurface

local function flattenButtonSurface(button)
	local overlay = button and button:FindFirstChild("MegMoButtonGradientOverlay")
	if overlay and overlay:IsA("GuiObject") then
		overlay.Visible = false
	end
end

function PresetsUI.mount(parent, context)
	local root = context and context.root
	if not parent or not root then
		error("PresetsUI.mount requires parent and context.root")
	end
	local embeddedPopup = context and context.embeddedPopup == true
	local hideHeader = context and context.hideHeader == true
	local topOffset = hideHeader and -38 or 0
	local embeddedMainCorner = embeddedPopup and 8 or 12
	local embeddedStatusCorner = embeddedPopup and 8 or 9

	local refs = {}

	local presetsCard
	if embeddedPopup then
		presetsCard = create("Frame", {
			Parent = parent,
			BackgroundColor3 = Constants.THEME.Panel,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.fromScale(1, 1),
		})
		createCorner(presetsCard, 8)
		applyPanelSurface(presetsCard)
	else
		presetsCard = createCard(parent, UDim2.new(1, 0, 0, 390))
		presetsCard.Position = UDim2.new(0, 0, 0, 0)
	end
	presetsCard.Visible = false
	presetsCard.ClipsDescendants = true
	local presetsCollapseButton = UiHelpers.createPanelCollapseButton(presetsCard)
	presetsCollapseButton.Visible = not embeddedPopup

	local titleLabel = create("TextLabel", {
		Parent = presetsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 12 + topOffset),
		Size = UDim2.new(0.45, 0, 0, 20),
		Font = Enum.Font.GothamSemibold,
		Text = "Animation Presets",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local metaLabel = createMetaLabel(
		presetsCard,
		"Browse Roblox starter animation packs or your own uploaded animations without leaving Studio.",
		28 + topOffset
	)
	metaLabel.Position = UDim2.new(0, 16, 0, 34 + topOffset)
	titleLabel.Visible = not hideHeader
	metaLabel.Visible = not hideHeader

	local presetSearchInput = create("TextBox", {
		Parent = presetsCard,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 16, 0, 66 + topOffset),
		Size = UDim2.new(1, -370, 0, 32),
		Font = Enum.Font.Gotham,
		PlaceholderText = "Search packs or actions like ninja, pirate, walk, run, jump, idle",
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	styleInput(presetSearchInput)
	createCorner(presetSearchInput, 9)
	createStroke(presetSearchInput)
	create("UIPadding", {
		Parent = presetSearchInput,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local presetButtonRow = create("Frame", {
		Parent = presetsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -342, 0, 66 + topOffset),
		Size = UDim2.new(0, 326, 0, 32),
	})

	local function createPresetToolbarButton(name, text, xOffset, width, filled)
		local button = create("TextButton", {
			Name = name,
			Parent = presetButtonRow,
			Position = UDim2.new(0, xOffset, 0, 0),
			Size = UDim2.new(0, width, 1, 0),
			Text = text,
		})
		if filled then
			styleTextButton(button)
		else
			styleGhostButton(button)
		end
		button.TextSize = 11
		createCorner(button, 8)
		return button
	end

	local presetFreeButton = createPresetToolbarButton("PresetFreeButton", "Roblox Starter", 0, 112, true)
	local presetOwnedButton = createPresetToolbarButton("PresetOwnedButton", "My Animations", 120, 104, false)
	local presetMarketplaceButton = createPresetToolbarButton("PresetMarketplaceButton", "Starter Search", 0, 96, false)
	presetMarketplaceButton.Visible = false
	local presetRigFilterButton = createPresetToolbarButton("PresetRigFilterButton", "Rig: All", 232, 94, false)

	local presetImportIdRow = create("Frame", {
		Name = "PresetImportIdRow",
		Parent = presetsCard,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 106 + topOffset),
		Size = UDim2.new(1, -32, 0, 32),
	})
	local presetImportIdInput = create("TextBox", {
		Name = "PresetImportIdInput",
		Parent = presetImportIdRow,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, -248, 1, 0),
		Font = Enum.Font.Gotham,
		PlaceholderText = "Paste Animation ID or URL",
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	styleInput(presetImportIdInput)
	createCorner(presetImportIdInput, 9)
	createStroke(presetImportIdInput)
	create("UIPadding", {
		Parent = presetImportIdInput,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	local presetR15ToR6Button = create("TextButton", {
