	if self._cameraTrackEditorEasingButton then
		self:_connect(self._cameraTrackEditorEasingButton.Activated, function()
			local styles = { "Sine", "Quad", "Cubic", "Exponential", "Linear" }
			local current = self._cameraPresetEasingStyle or "Sine"
			local nextIndex = 1
			for index, styleName in ipairs(styles) do
				if styleName == current then
					nextIndex = (index % #styles) + 1
					break
				end
			end
			self._cameraPresetEasingStyle = styles[nextIndex]
			self._cameraPresetEasingDirection = "InOut"
			self:_renderCameraTrackEditor()
			self:_focusShortcutCapture("Camera preset easing set to " .. self._cameraPresetEasingStyle)
		end)
	end
	if self._cameraTrackEditorSubjectTrackingButton then
		self:_connect(self._cameraTrackEditorSubjectTrackingButton.Activated, function()
			self._cameraPresetSubjectTracking = not (self._cameraPresetSubjectTracking ~= false)
			self:_renderCameraTrackEditor()
			self:_focusShortcutCapture(self._cameraPresetSubjectTracking ~= false and "Subject tracking on" or "Subject tracking off")
		end)
	end
	local function bindCameraEditorPreset(button, presetId)
		if not button then
			return
		end
		self:_connect(button.Activated, function()
			local subjectSetupPresets = {
				CrashZoom = true,
				DollyIn = true,
				DollyOut = true,
				FollowCam = true,
				FaceFocus = true,
				FollowRig = true,
				FollowRigCinematic = true,
				HeroReveal = true,
				Orbit = true,
				OrbitShot = true,
				OverShoulder = true,
			}
			if subjectSetupPresets[presetId] or presetId == "FirstPerson" then
				self:_setEffectsOverlayVisible(false)
				self:_showCameraFollowOverlay(presetId)
				return
			end
			if callbacks.onApplyCameraPreset then
				local resolvedPresetId = presetId
				local options = self:_getCameraPresetOptions()
				if presetId == "FollowRig" then
					options.followStyle = "Regular"
				elseif presetId == "FollowRigCinematic" then
					options.followStyle = "Cinematic"
					resolvedPresetId = "FollowRig"
				end
				callbacks.onApplyCameraPreset(resolvedPresetId, options)
			end
			self:_hideCameraTrackEditor()
			self:_focusShortcutCapture("Camera preset applied")
		end)
	end
	bindCameraEditorPreset(self._cameraTrackEditorShakeButton, "ExplosionShake")
	bindCameraEditorPreset(self._cameraTrackEditorHandheldButton, "SoftHandheld")
	bindCameraEditorPreset(self._cameraTrackEditorOrbitButton, "Orbit")
	bindCameraEditorPreset(self._cameraTrackEditorFollowButton, "FollowRig")
	bindCameraEditorPreset(self._cameraTrackEditorFollowCinematicButton, "FollowRigCinematic")
	bindCameraEditorPreset(self._cameraTrackEditorAttachSelectionButton, "CameraAttachSelection")
	bindCameraEditorPreset(self._cameraTrackEditorDetachSelectionButton, "CameraDetachSelection")
	bindCameraEditorPreset(self._cameraTrackEditorFirstPersonButton, "FirstPerson")
	bindCameraEditorPreset(self._cameraTrackEditorFirstPersonDetachButton, "FirstPersonDetach")
	bindCameraEditorPreset(self._cameraTrackEditorOrbitShotButton, "OrbitShot")
	bindCameraEditorPreset(self._cameraTrackEditorDollyInButton, "DollyIn")
	bindCameraEditorPreset(self._cameraTrackEditorDollyOutButton, "DollyOut")
	bindCameraEditorPreset(self._cameraTrackEditorHeroRevealButton, "HeroReveal")
	bindCameraEditorPreset(self._cameraTrackEditorShoulderButton, "OverShoulder")
	bindCameraEditorPreset(self._cameraTrackEditorCrashZoomButton, "CrashZoom")
	bindCameraEditorPreset(self._cameraTrackEditorFollowCamButton, "FollowCam")
