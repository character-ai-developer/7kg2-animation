            <Properties>
              <string name="Name">AddPhysicsPanel</string>
              <ProtectedString name="Source">local AddPhysicsPanel = {}
AddPhysicsPanel.__index = AddPhysicsPanel

local EFFECTS = {
	{
		id = "Release",
		title = "Release a held object",
		description = "Detach an animated prop at the current release frame, inherit the hand's movement and spin, then simulate its natural fall and collisions.",
		image = "rbxassetid://88271717750306",
		color = Color3.fromRGB(72, 214, 255),
	},
	{
		id = "Drop",
		title = "Drop or bounce",
		description = "Turn the selected loose Parts or Models physical, then capture their falls, collisions, rolling and natural bounce.",
		image = "rbxassetid://101930051479581",
		color = Color3.fromRGB(82, 139, 255),
	},
	{
		id = "Character",
		title = "Ragdoll",
		description = "Turn the selected character into a ragdoll for natural falls or directed Knockback reactions with adjustable force.",
		image = "rbxassetid://85022907825347",
		color = Color3.fromRGB(126, 86, 255),
	},
	{
		id = "Impact",
		title = "Drive &amp; Impact",
		description = "Drive an animated object or vehicle into selected targets and capture the resulting movement, debris and collisions.",
		image = "rbxassetid://101298906973815",
		color = Color3.fromRGB(255, 201, 92),
	},
	{
		id = "Projectile",
		title = "Launch projectile",
		description = "Launch a selected projectile toward an impact point and capture its flight, hit timing and target reaction.",
		image = "rbxassetid://122613049511323",
		color = Color3.fromRGB(255, 116, 62),
	},
	{
		id = "Explosion",
		title = "Create explosion",
		description = "Place an immediate blast that pushes, ragdolls, or breaks apart selected objects with controllable power and direction.",
		image = "rbxassetid://119229108932478",
		color = Color3.fromRGB(255, 159, 67),
	},
	{
		id = "Scene",
		title = "Simulate selected objects",
		description = "Simulate selected loose objects together, with an optional Starting Push for dominoes and other chain reactions.",
		image = "rbxassetid://123485720397312",
		color = Color3.fromRGB(91, 224, 165),
	},
	{
		id = "AdaptiveWalk",
		title = "Adapt movement to ground",
		description = "Fit an animated walk route to steps, slopes and uneven ground while preserving the chosen walk style.",
		image = "rbxassetid://136403303423933",
		color = Color3.fromRGB(177, 223, 83),
	},
}

local PANEL_COLORS = {
	background = Color3.fromRGB(10, 14, 22),
	border = Color3.fromRGB(56, 65, 84),
	card = Color3.fromRGB(37, 47, 70),
	cardBorder = Color3.fromRGB(53, 64, 84),
	cardHover = Color3.fromRGB(47, 59, 84),
	cardHoverBorder = Color3.fromRGB(158, 170, 197),
	summary = Color3.fromRGB(12, 18, 29),
	primary = Color3.fromRGB(126, 86, 255),
	selection = Color3.fromRGB(157, 107, 255),
	text = Color3.fromRGB(240, 244, 255),
	muted = Color3.fromRGB(158, 170, 197),
	scrollbar = Color3.fromRGB(126, 86, 255),
}

local function make(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function addCorner(instance, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, instance)
end

local function addStroke(instance, color, thickness, transparency)
	return make("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	}, instance)
end

local function connect(self, signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function AddPhysicsPanel.new(options)
	options = options or {}
	local self = setmetatable({
		theme = options.theme or PANEL_COLORS,
		callbacks = options.callbacks or {},
		connections = {},
		effectButtons = {},
		context = {},
		hoverEffectId = nil,
		stageContent = options.stageContent,
		stageNavigation = options.stageNavigation,
	}, AddPhysicsPanel)

	self.frame = make("ScrollingFrame", {
		Name = "QuickAddPhysicsPanel",
		BackgroundColor3 = self.theme.background or PANEL_COLORS.background,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 510),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = self.theme.accent or PANEL_COLORS.scrollbar,
		Position = UDim2.fromOffset(12, 102),
		Size = UDim2.new(1, -24, 1, -160),
		ZIndex = 50,
	}, options.root)
	addCorner(self.frame, 9)
	self.frameStroke = addStroke(self.frame, self.theme.border or PANEL_COLORS.border)
	make("UISizeConstraint", {
		MaxSize = Vector2.new(10000, 510),
		MinSize = Vector2.new(0, 0),
	}, self.frame)

	self.physicsIcon = make("ImageLabel", {
		Name = "PhysicsIcon",
		BackgroundTransparency = 1,
		Image = "rbxassetid://110022673488157",
		ImageColor3 = Color3.fromRGB(255, 255, 255),
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(30, 30),
		ZIndex = 51,
	}, self.frame)
	self.title = make("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "Add Physics",
		TextColor3 = self.theme.text or PANEL_COLORS.text,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(54, 11),
		Size = UDim2.new(1, -108, 0, 30),
		ZIndex = 51,
	}, self.frame)
	local effectsFrame = make("Frame", {
		Name = "Effects",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 54),
		Size = UDim2.new(1, -32, 0, 322),
		ZIndex = 51,
	}, self.frame)
	for index, effect in ipairs(EFFECTS) do
		local column = (index - 1) % 2
		local row = math.floor((index - 1) / 2)
		local button = make("TextButton", {
			Name = effect.id,
			AutoButtonColor = false,
			BackgroundColor3 = self.theme.button or PANEL_COLORS.card,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = effect.title,
			TextColor3 = self.theme.text or PANEL_COLORS.text,
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(column * 0.5, column == 0 and 0 or 5, 0, row * 82),
			Size = UDim2.new(0.5, -5, 0, 76),
			ZIndex = 52,
		}, effectsFrame)
		make("UIPadding", {
			PaddingLeft = UDim.new(0, 76),
			PaddingRight = UDim.new(0, 8),
		}, button)
		addCorner(button, 6)
		local stroke = addStroke(button, self.theme.border or PANEL_COLORS.cardBorder, 1, 0)
		local icon = make("ImageLabel", {
			Name = "Icon",
			BackgroundColor3 = effect.color:Lerp(self.theme.background or PANEL_COLORS.background, 0.68),
			BorderSizePixel = 0,
			Image = effect.image,
			ImageColor3 = effect.color,
			Position = UDim2.fromOffset(-66, 12),
			Size = UDim2.fromOffset(52, 52),
			ZIndex = 53,
		}, button)
		addCorner(icon, 5)
		self.effectButtons[effect.id] = {
			button = button,
			stroke = stroke,
			icon = icon,
			color = effect.color,
		}
		connect(self, button.Activated, function()
			if self.callbacks.onEffectChosen then
				self.callbacks.onEffectChosen(effect.id)
			end
		end)
		connect(self, button.MouseEnter, function()
			self:ShowEffectDescription(effect)
		end)
	end

	self.summary = make("Frame", {
		Name = "Summary",
		BackgroundColor3 = self.theme.panel or PANEL_COLORS.summary,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 384),
		Size = UDim2.new(1, -32, 0, 112),
		ZIndex = 51,
	}, self.frame)
	addCorner(self.summary, 7)
	self.summaryStroke = addStroke(self.summary, self.theme.border or PANEL_COLORS.border)
	self.summaryLabels = {}
	self.summaryValues = {}
	for index, row in ipairs({
		{ "Subject", "subject" },
		{ "Range", "range" },
		{ "Starting motion", "startingMotion" },
		{ "End", "endBehavior" },
		{ "Collision", "collision" },
	}) do
		self.summaryLabels[row[2]] = make("TextLabel", {
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Text = row[1] .. ":",
			TextColor3 = self.theme.text or PANEL_COLORS.text,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(12, 7 + (index - 1) * 20),
			Size = UDim2.new(0.34, -12, 0, 18),
			ZIndex = 52,
		}, self.summary)
		self.summaryValues[row[2]] = make("TextLabel", {
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Text = "",
			TextColor3 = self.theme.text or PANEL_COLORS.text,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0.34, 0, 0, 7 + (index - 1) * 20),
			Size = UDim2.new(0.66, -12, 0, 18),
			ZIndex = 52,
		}, self.summary)
	end
	self.descriptionTitle = make("TextLabel", {
		Name = "DescriptionTitle",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = self.theme.text or PANEL_COLORS.text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 0, 20),
		Visible = false,
		ZIndex = 53,
	}, self.summary)
	self.descriptionText = make("TextLabel", {
		Name = "DescriptionText",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = self.theme.text or PANEL_COLORS.text,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(12, 34),
		Size = UDim2.new(1, -24, 0, 62),
		Visible = false,
		ZIndex = 53,
	}, self.summary)

	self.openQuick = make("TextButton", {
		Name = "OpenQuickAddPhysics",
		BackgroundColor3 = self.theme.accent or PANEL_COLORS.primary,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "Back to Add Physics",
		TextColor3 = self.theme.text or PANEL_COLORS.text,
		TextSize = 11,
		Position = UDim2.new(1, -160, 0, 108),
		Size = UDim2.fromOffset(142, 32),
		Visible = false,
		ZIndex = 120,
	}, options.root)
	addCorner(self.openQuick, 6)
	connect(self, self.openQuick.Activated, function()
		self:SetVisible(true)
		if self.callbacks.onOpenQuick then
			self.callbacks.onOpenQuick()
		end
	end)

	self:ShowEffectDescription(nil)
	self:SetVisible(options.visible ~= false)
	return self
end

function AddPhysicsPanel:RefreshEffectVisuals()
	local theme = self.theme or PANEL_COLORS
	local background = theme.background or PANEL_COLORS.background
	local panel = theme.panel or PANEL_COLORS.summary
	local buttonColor = theme.button or PANEL_COLORS.card
	local borderColor = theme.border or PANEL_COLORS.cardBorder
	local textColor = theme.text or PANEL_COLORS.text
	local accent = theme.accent or PANEL_COLORS.primary
	self.frame.BackgroundColor3 = background
	self.frame.ScrollBarImageColor3 = accent
	self.frameStroke.Color = borderColor
	self.title.TextColor3 = textColor
	self.physicsIcon.ImageColor3 = textColor
	self.summary.BackgroundColor3 = panel
	self.summaryStroke.Color = borderColor
	self.descriptionTitle.TextColor3 = textColor
	self.descriptionText.TextColor3 = textColor
	for _, label in pairs(self.summaryLabels or {}) do
		label.TextColor3 = textColor
	end
	for _, label in pairs(self.summaryValues or {}) do
		label.TextColor3 = textColor
	end
	self.openQuick.BackgroundColor3 = accent
	self.openQuick.TextColor3 = textColor
	for effectId, item in pairs(self.effectButtons) do
		local highlighted = effectId == self.hoverEffectId
		if highlighted then
			item.button.BackgroundColor3 = buttonColor:Lerp(textColor, 0.08)
			item.stroke.Color = item.color
			item.stroke.Thickness = 2
		else
			item.button.BackgroundColor3 = buttonColor
			item.stroke.Color = borderColor
			item.stroke.Thickness = 1
		end
		item.icon.BackgroundColor3 = item.color:Lerp(background, 0.68)
		item.icon.ImageColor3 = item.color
		item.button.TextColor3 = textColor
		item.button.TextTransparency = 0
	end
end

function AddPhysicsPanel:ShowEffectDescription(effect)
	self.hoverEffectId = effect and effect.id or nil
	for _, label in pairs(self.summaryLabels or {}) do
		label.Visible = false
	end
	for _, label in pairs(self.summaryValues or {}) do
		label.Visible = false
	end
	self.descriptionTitle.Visible = true
	self.descriptionText.Visible = true
	if effect then
		self.descriptionTitle.Text = effect.title
		self.descriptionText.Text = effect.description
	else
		self.descriptionTitle.Text = "Choose a physics effect"
		self.descriptionText.Text = "Hover over an option to see what it does. Click it to open that effect's setup."
	end
	self:RefreshEffectVisuals()
end

function AddPhysicsPanel:SetVisible(visible)
	visible = visible == true
	self.frame.Visible = visible
	self.openQuick.Visible = not visible
	if self.stageContent then
		self.stageContent.Visible = not visible
	end
	if self.stageNavigation then
		self.stageNavigation.Visible = not visible
	end
	if not visible then
		self:ShowEffectDescription(nil)
	end
end

function AddPhysicsPanel:Update(context)
	self.context = context or {}
	self:SetVisible(self.context.visible ~= false)
	self:RefreshEffectVisuals()
	for key, label in pairs(self.summaryValues) do
		label.Text = tostring(self.context[key] or "-")
	end
end

function AddPhysicsPanel:Destroy()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	if self.frame then
		self.frame:Destroy()
	end
	if self.openQuick then
		self.openQuick:Destroy()
	end
end

return AddPhysicsPanel
</ProtectedString>
