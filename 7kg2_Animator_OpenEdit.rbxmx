			or ""
		self.durationPopup.frame.Visible = not self.durationPopup.frame.Visible
	end)
	self.reviewRowTwoValue.Activated:Connect(function()
		local nextValue = not self.releaseCollisionsEnabled
		if self.callbacks.onReleaseCollisionsChanged then
			self.callbacks.onReleaseCollisionsChanged(nextValue)
		end
	end)

