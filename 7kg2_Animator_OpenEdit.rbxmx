      <Item class="ModuleScript" referent="RBX153">
        <Properties>
          <string name="Name">KeyframeGroupTimingService</string>
          <ProtectedString name="Source">local KeyframeGroupTimingService = {}

local PhysicsClipIntegritySupport = require(script.Parent:WaitForChild("PhysicsClipIntegritySupport"))

local function makeKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

local function parseKeyId(keyId)
	keyId = tostring(keyId or "")
	local divider = string.find(keyId, "\n", 1, true)
	if not divider then
		return nil, nil
	end
	return string.sub(keyId, 1, divider - 1), tonumber(string.sub(keyId, divider + 1))
end

local function getFrameBounds(keys)
	local minFrame = nil
	local maxFrame = nil
	for _, key in ipairs(keys or {}) do
		local frame = math.max(0, math.floor(tonumber(key.frame) or 0))
		minFrame = minFrame and math.min(minFrame, frame) or frame
		maxFrame = maxFrame and math.max(maxFrame, frame) or frame
	end
	return minFrame, maxFrame
end

local function getKeyMapSpanFrames(keyMap)
	local refs = {}
	for keyId in pairs(keyMap or {}) do
		local jointPath, frame = parseKeyId(keyId)
		if jointPath and frame ~= nil then
			refs[#refs + 1] = {
				jointPath = jointPath,
				frame = frame,
			}
		end
	end
	local minFrame, maxFrame = getFrameBounds(refs)
	if not minFrame or not maxFrame then
		return nil
	end
	return math.max(1, maxFrame - minFrame)
end

local function getRefsFromKeyMap(keyMap, timeline)
	local refs = {}
	for keyId in pairs(keyMap or {}) do
		local jointPath, frame = parseKeyId(keyId)
		if jointPath and frame ~= nil and timeline:hasTrackKeyframe(jointPath, frame) then
			refs[#refs + 1] = {
				jointPath = jointPath,
				frame = frame,
			}
		end
	end
	table.sort(refs, function(a, b)
		if a.frame == b.frame then
			return tostring(a.jointPath) &lt; tostring(b.jointPath)
		end
		return a.frame &lt; b.frame
	end)
	return refs
end

local function replaceGroupKeys(keyframeEditService, group, refs)
	local nextKeys = {}
	for _, key in ipairs(refs or {}) do
		nextKeys[makeKeyId(key.jointPath, key.frame)] = true
	end
	group.keys = nextKeys
	keyframeEditService:rebuildGroupMembership()
end

local function getGroupIdValue(groupId)
	return tonumber(groupId) or groupId
end

local function sameGroupId(a, b)
	return a == b or tostring(a) == tostring(b)
end

local function collectProtectedGroupKeyIds(keyframeEditService, activeGroupId)
	local protected = {}
	for groupId, group in pairs((keyframeEditService and keyframeEditService:getGroups()) or {}) do
		if groupId ~= activeGroupId and tostring(groupId) ~= tostring(activeGroupId) then
			for keyId in pairs(group.keys or {}) do
				protected[keyId] = true
			end
		end
	end
	return protected
end

local CONTINUOUS_SAMPLE_TYPES = {
	CFrame = true,
	Color3 = true,
	ColorSequence = true,
	NumberRange = true,
	NumberSequence = true,
	Vector2 = true,
	Vector3 = true,
}

local function getPathFrameBounds(keys)
	local boundsByPath = {}
	for _, key in ipairs(keys or {}) do
		local jointPath = key.jointPath or key.path
		if jointPath then
			local frame = math.max(0, math.floor(tonumber(key.frame) or 0))
			local bounds = boundsByPath[jointPath]
			if not bounds then
				bounds = {
					minFrame = frame,
					maxFrame = frame,
					keyCount = 0,
				}
				boundsByPath[jointPath] = bounds
			end
			bounds.minFrame = math.min(bounds.minFrame, frame)
			bounds.maxFrame = math.max(bounds.maxFrame, frame)
			bounds.keyCount += 1
		end
	end
	return boundsByPath
end

local function canResampleStretch(timeline, sourceKeys, sourceIds, boundsByPath)
	for _, key in ipairs(sourceKeys or {}) do
		local valueType = typeof(key.value)
		if valueType ~= "number" and not CONTINUOUS_SAMPLE_TYPES[valueType] then
			return false
		end
	end

	for jointPath, bounds in pairs(boundsByPath or {}) do
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(jointPath)) do
			if frame &gt;= bounds.minFrame
				and frame &lt;= bounds.maxFrame
				and not sourceIds[makeKeyId(jointPath, frame)]
			then
				return false
			end
		end
	end
	return true
end

local function buildResampledStretch(timeline, sourceIds, boundsByPath, minFrame, ratio)
	local paths = {}
	for jointPath, bounds in pairs(boundsByPath or {}) do
		bounds.targetMinFrame = minFrame + math.floor(((bounds.minFrame - minFrame) * ratio) + 0.5)
		bounds.targetMaxFrame = minFrame + math.floor(((bounds.maxFrame - minFrame) * ratio) + 0.5)
		if bounds.keyCount &gt; 1 and bounds.targetMaxFrame &lt;= bounds.targetMinFrame then
			return false, "That stretch is too short; some keyframes would overlap.", {}, {}
		end
		paths[#paths + 1] = jointPath
	end
	table.sort(paths)

	for _, jointPath in ipairs(paths) do
		local bounds = boundsByPath[jointPath]
		for targetFrame = bounds.targetMinFrame, bounds.targetMaxFrame do
			local targetId = makeKeyId(jointPath, targetFrame)
			if timeline:hasTrackKeyframe(jointPath, targetFrame) and not sourceIds[targetId] then
				return false, string.format("That track already has a keyframe at frame %d.", targetFrame), {}, {}
			end
		end
	end

	local stretchedKeys = {}
	local stretchedRefs = {}
	local firstTargetFrame = nil
	local lastTargetFrame = nil
	for _, jointPath in ipairs(paths) do
		local bounds = boundsByPath[jointPath]
		firstTargetFrame = firstTargetFrame and math.min(firstTargetFrame, bounds.targetMinFrame) or bounds.targetMinFrame
		lastTargetFrame = lastTargetFrame and math.max(lastTargetFrame, bounds.targetMaxFrame) or bounds.targetMaxFrame
	end

	for targetFrame = firstTargetFrame or minFrame, lastTargetFrame or minFrame do
		local sourceFrame = minFrame + ((targetFrame - minFrame) / ratio)
		local sampledPose = select(1, timeline:samplePose(sourceFrame)) or {}
		for _, jointPath in ipairs(paths) do
			local bounds = boundsByPath[jointPath]
			if targetFrame &gt;= bounds.targetMinFrame and targetFrame &lt;= bounds.targetMaxFrame then
				local value = sampledPose[jointPath]
				if value == nil then
					return false, "Could not sample every continuous track while stretching the group.", {}, {}
				end
				stretchedKeys[#stretchedKeys + 1] = {
					jointPath = jointPath,
					frame = targetFrame,
					value = value,
					easingStyle = "Linear",
					easingDirection = "InOut",
				}
				stretchedRefs[#stretchedRefs + 1] = {
					jointPath = jointPath,
					frame = targetFrame,
				}
			end
		end
	end

	return true, nil, stretchedKeys, stretchedRefs
end

local function buildBoundedPhysicsStretch(timeline, sourceIds, boundsByPath, minFrame, ratio)
	local paths = {}
	for jointPath, bounds in pairs(boundsByPath or {}) do
		bounds.targetMinFrame = minFrame + math.floor(((bounds.minFrame - minFrame) * ratio) + 0.5)
		bounds.targetMaxFrame = minFrame + math.floor(((bounds.maxFrame - minFrame) * ratio) + 0.5)
		if bounds.keyCount &gt; 1 and bounds.targetMaxFrame &lt;= bounds.targetMinFrame then
			return false, "That stretch is too short; some keyframes would overlap.", {}, {}
		end
		paths[#paths + 1] = jointPath
	end
	table.sort(paths)

	for _, jointPath in ipairs(paths) do
		local bounds = boundsByPath[jointPath]
		for targetFrame = bounds.targetMinFrame, bounds.targetMaxFrame do
			local targetId = makeKeyId(jointPath, targetFrame)
			if timeline:hasTrackKeyframe(jointPath, targetFrame) and not sourceIds[targetId] then
				return false, string.format("That track already has a keyframe at frame %d.", targetFrame), {}, {}
			end
		end
	end

	local stretchedKeys = {}
	local stretchedRefs = {}
	local sampledPoseByTargetFrame = {}
	for _, jointPath in ipairs(paths) do
		local bounds = boundsByPath[jointPath]
		local targetSpan = math.max(0, bounds.targetMaxFrame - bounds.targetMinFrame)
		local sampleCount = math.min(math.max(1, bounds.keyCount), targetSpan + 1)
		for sampleIndex = 1, sampleCount do
			local targetFrame = bounds.targetMinFrame
			if sampleCount &gt; 1 then
				local alpha = (sampleIndex - 1) / (sampleCount - 1)
				targetFrame = bounds.targetMinFrame + math.floor((targetSpan * alpha) + 0.5)
			end
			local sampledPose = sampledPoseByTargetFrame[targetFrame]
			if not sampledPose then
				local sourceFrame = minFrame + ((targetFrame - minFrame) / ratio)
				sampledPose = select(1, timeline:samplePose(sourceFrame)) or {}
				sampledPoseByTargetFrame[targetFrame] = sampledPose
			end
			local value = sampledPose[jointPath]
			if value == nil then
				return false, "Could not sample every continuous track while stretching the Physics Clip.", {}, {}
			end
			stretchedKeys[#stretchedKeys + 1] = {
				jointPath = jointPath,
				frame = targetFrame,
				value = value,
				easingStyle = "Linear",
				easingDirection = "InOut",
			}
			stretchedRefs[#stretchedRefs + 1] = {
				jointPath = jointPath,
				frame = targetFrame,
			}
		end
	end

	return true, nil, stretchedKeys, stretchedRefs
end

function KeyframeGroupTimingService.setGroupMode(keyframeEditService, groupIds, mode)
	if not keyframeEditService then
		return false, "Keyframe groups are not available."
	end

	mode = mode == "Stretch" and "Stretch" or (mode == "Repeat" and "Repeat" or nil)
	local groups = keyframeEditService:getGroups()
	local changedCount = 0
	for _, groupId in ipairs(groupIds or {}) do
		local group = groups[tonumber(groupId) or groupId]
		if group then
			group.mode = mode
			if mode == "Stretch" then
				group.sourceSpanFrames = getKeyMapSpanFrames(group.keys)
			end
			if mode == "Repeat" and type(group.repeatSourceKeys) ~= "table" then
				group.repeatSourceKeys = {}
				for keyId in pairs(group.keys or {}) do
					group.repeatSourceKeys[keyId] = true
				end
				group.repeatSourceSpanFrames = getKeyMapSpanFrames(group.repeatSourceKeys)
				group.sourceSpanFrames = group.repeatSourceSpanFrames
			elseif mode == "Repeat" then
				group.repeatSourceSpanFrames = group.repeatSourceSpanFrames or getKeyMapSpanFrames(group.repeatSourceKeys)
				group.sourceSpanFrames = group.sourceSpanFrames or group.repeatSourceSpanFrames
			elseif mode ~= "Repeat" then
				group.repeatSourceKeys = nil
				group.repeatSourceSpanFrames = nil
				if mode ~= "Stretch" then
					group.sourceSpanFrames = nil
				end
			end
			changedCount += 1
		end
	end

	if changedCount == 0 then
		return false, "Select a grouped keyframe first."
	end
	return true, string.format("%s mode enabled for %d keyframe group%s.", mode or "Normal", changedCount, changedCount == 1 and "" or "s")
end

function KeyframeGroupTimingService.stretchGroupToFrame(timeline, keyframeEditService, groupId, targetEndFrame)
	if not timeline or not keyframeEditService then
		return false, "Timeline is not available.", {}
	end
	local resolvedGroupId = getGroupIdValue(groupId)
	local group = keyframeEditService:getGroups()[resolvedGroupId]
	if not group then
		return false, "Select a grouped keyframe first.", {}
	end
	local preserveExactPhysics = group.kind == "PhysicsClip"
		and PhysicsClipIntegritySupport.IsValid(group, timeline)

	local refs = keyframeEditService:getKeyRefsForGroup(resolvedGroupId, timeline)
	local sourceKeys = timeline:getTrackKeyValues(refs)
	local minFrame, maxFrame = getFrameBounds(sourceKeys)
	if not minFrame or not maxFrame or maxFrame &lt;= minFrame then
		return false, "Stretch needs a group with keyframes at two or more times.", {}
	end

	targetEndFrame = math.max(minFrame + 1, math.floor(tonumber(targetEndFrame) or maxFrame))
	if targetEndFrame == maxFrame then
		return false, "Group is already at that length.", {}
	end

	local sourceSpan = math.max(1, maxFrame - minFrame)
	local targetSpan = math.max(1, targetEndFrame - minFrame)
	local ratio = targetSpan / sourceSpan
	local sourceIds = {}
	for _, key in ipairs(sourceKeys) do
		sourceIds[makeKeyId(key.jointPath, key.frame)] = true
	end

	local stretchedKeys = {}
	local stretchedRefs = {}
	local boundsByPath = getPathFrameBounds(sourceKeys)
	if canResampleStretch(timeline, sourceKeys, sourceIds, boundsByPath) then
		local resampled, resampleMessage
		local stretchBuilder = group.kind == "PhysicsClip" and buildBoundedPhysicsStretch or buildResampledStretch
		resampled, resampleMessage, stretchedKeys, stretchedRefs = stretchBuilder(
			timeline,
			sourceIds,
			boundsByPath,
			minFrame,
			ratio
		)
		if not resampled then
			return false, resampleMessage or "Could not resample the stretched group.", {}
		end
	else
		local targetIds = {}
		for _, key in ipairs(sourceKeys) do
			local relativeFrame = math.max(0, math.floor(tonumber(key.frame) or 0) - minFrame)
			local targetFrame = minFrame + math.floor((relativeFrame * ratio) + 0.5)
			targetFrame = math.max(0, targetFrame)
			local targetId = makeKeyId(key.jointPath, targetFrame)
			if targetIds[targetId] then
				return false, "That stretch is too short; some keyframes would overlap.", {}
			end
			if timeline:hasTrackKeyframe(key.jointPath, targetFrame) and not sourceIds[targetId] then
				return false, string.format("That track already has a keyframe at frame %d.", targetFrame), {}
			end
			targetIds[targetId] = true
			stretchedKeys[#stretchedKeys + 1] = {
				jointPath = key.jointPath,
				frame = targetFrame,
				value = key.value,
				easingStyle = key.easingStyle,
				easingDirection = key.easingDirection,
			}
			stretchedRefs[#stretchedRefs + 1] = {
				jointPath = key.jointPath,
				frame = targetFrame,
			}
		end
	end

	local deleted = timeline:deleteTrackKeyframes(sourceKeys)
	if not deleted then
		return false, "Could not retime the selected group.", {}
	end
	local pasted, pasteMessage = timeline:pasteTrackKeyframes(stretchedKeys, 0)
	if not pasted then
		timeline:pasteTrackKeyframes(sourceKeys, 0)
		return false, pasteMessage or "Could not paste stretched keyframes.", {}
	end

	group.mode = "Stretch"
	group.repeatSourceKeys = nil
	group.repeatSourceSpanFrames = nil
	group.sourceSpanFrames = group.sourceSpanFrames or sourceSpan
	replaceGroupKeys(keyframeEditService, group, stretchedRefs)
	if group.kind == "PhysicsClip" and type(group.runtimeCapture) == "table" then
		if preserveExactPhysics then
			-- A whole-clip stretch safely remaps the original capture over the new
			-- range. Establish the resampled timeline keys as its new baseline.
			PhysicsClipIntegritySupport.EstablishBaseline(group, timeline)
		else
			-- Stretching a clip that was already edited must not reactivate its old
			-- exact capture merely because the operation rebuilt its grouped keys.
			group.runtimeCaptureValid = false
		end
	end
	return true, string.format("Stretched group to %.0f%% speed.", (1 / ratio) * 100), stretchedRefs
end

function KeyframeGroupTimingService.repeatGroupToFrame(timeline, keyframeEditService, groupId, targetEndFrame)
	if not timeline or not keyframeEditService then
		return false, "Timeline is not available.", {}
	end
	local resolvedGroupId = getGroupIdValue(groupId)
	local group = keyframeEditService:getGroups()[resolvedGroupId]
	if not group then
		return false, "Select a grouped keyframe first.", {}
	end

	local sourceKeyMap = type(group.repeatSourceKeys) == "table" and group.repeatSourceKeys or group.keys
	local sourceRefs = getRefsFromKeyMap(sourceKeyMap, timeline)
	local sourceKeys = timeline:getTrackKeyValues(sourceRefs)
	local minFrame, maxFrame = getFrameBounds(sourceKeys)
	if not minFrame or not maxFrame or maxFrame &lt;= minFrame then
		return false, "Repeat needs a group with keyframes at two or more times.", {}
	end

	local sourceSpan = math.max(1, maxFrame - minFrame)
	targetEndFrame = math.max(minFrame + sourceSpan, math.floor(tonumber(targetEndFrame) or maxFrame))
	local allGroupRefs = keyframeEditService:getKeyRefsForGroup(resolvedGroupId, timeline)
	local sourceIds = {}
	for _, key in ipairs(sourceRefs) do
		sourceIds[makeKeyId(key.jointPath, key.frame)] = true
	end
	local generatedRefs = {}
	for _, key in ipairs(allGroupRefs) do
		if not sourceIds[makeKeyId(key.jointPath, key.frame)] then
			generatedRefs[#generatedRefs + 1] = key
		end
	end
	if #generatedRefs &gt; 0 then
		timeline:deleteTrackKeyframes(generatedRefs)
	end

	local RepeatFramesService = require(script.Parent:WaitForChild("RepeatFramesService"))
	local success, message, repeatedRefs = RepeatFramesService.repeatSelectedKeys(timeline, sourceRefs, {
		lengthFrames = sourceSpan,
		endFrame = targetEndFrame,
		protectedKeyIds = collectProtectedGroupKeyIds(keyframeEditService, group.id or resolvedGroupId),
	})
	if not success then
		repeatedRefs = {}
		message = message or "No repeat keyframes were needed."
	end

	local nextRefs = {}
	for _, key in ipairs(sourceRefs) do
		nextRefs[#nextRefs + 1] = key
	end
	for _, key in ipairs(repeatedRefs or {}) do
		nextRefs[#nextRefs + 1] = key
	end
	group.mode = "Repeat"
	group.repeatSourceKeys = {}
	for _, key in ipairs(sourceRefs) do
		group.repeatSourceKeys[makeKeyId(key.jointPath, key.frame)] = true
	end
	group.repeatSourceSpanFrames = sourceSpan
	group.sourceSpanFrames = sourceSpan
	replaceGroupKeys(keyframeEditService, group, nextRefs)

	local loopCount = math.max(1, math.floor(((targetEndFrame - minFrame) / sourceSpan) + 0.0001))
	return true, string.format("%s Repeat block now covers %d loop%s.", message or "Updated repeat block.", loopCount, loopCount == 1 and "" or "s"), nextRefs
end

function KeyframeGroupTimingService.trimGroupsAtPlayhead(timeline, keyframeEditService, groupIds, playheadFrame, trimSide)
	if not timeline or not keyframeEditService then
		return false, "Timeline is not available.", {}
	end
	trimSide = trimSide == "Before" and "Before" or (trimSide == "After" and "After" or nil)
	if not trimSide then
		return false, "Choose whether to trim before or after the playhead.", {}
	end
	playheadFrame = math.max(0, math.floor(tonumber(playheadFrame) or 0))
	local groups = keyframeEditService:getGroups()
	local membership = keyframeEditService:getGroupMembership()
	local sampledPose = select(1, timeline:samplePose(playheadFrame)) or {}
	local changedRefs = {}
	local changedCount = 0

	for _, requestedGroupId in ipairs(groupIds or {}) do
		local groupId = getGroupIdValue(requestedGroupId)
		local group = groups[groupId]
		if group then
			local refs = keyframeEditService:getKeyRefsForGroup(groupId, timeline)
			local minFrame, maxFrame = getFrameBounds(refs)
			if minFrame and maxFrame and playheadFrame &gt; minFrame and playheadFrame &lt; maxFrame then
				local pathSet = {}
				for _, ref in ipairs(refs) do
					pathSet[ref.jointPath] = true
				end
				for jointPath in pairs(pathSet) do
					local boundaryId = makeKeyId(jointPath, playheadFrame)
					local boundaryGroupId = membership[boundaryId]
					if boundaryGroupId and not sameGroupId(boundaryGroupId, groupId) then
						return false, string.format("Frame %d already belongs to another group on one of these tracks.", playheadFrame), {}
					end
					if not timeline:hasTrackKeyframe(jointPath, playheadFrame) and sampledPose[jointPath] == nil then
						return false, "Could not sample every track at the trim point.", {}
					end
				end
				local nextRefs = {}
				local deleteRefs = {}
				for _, ref in ipairs(refs) do
					local remove = trimSide == "Before" and ref.frame &lt; playheadFrame or ref.frame &gt; playheadFrame
					if remove then
						deleteRefs[#deleteRefs + 1] = ref
					else
						nextRefs[#nextRefs + 1] = ref
					end
				end
				for jointPath in pairs(pathSet) do
					local boundaryId = makeKeyId(jointPath, playheadFrame)
					local boundaryGroupId = membership[boundaryId]
					if boundaryGroupId and not sameGroupId(boundaryGroupId, groupId) then
						return false, string.format("Frame %d already belongs to another group on one of these tracks.", playheadFrame), {}
					end
					if not timeline:hasTrackKeyframe(jointPath, playheadFrame) then
						local value = sampledPose[jointPath]
						if value ~= nil then
							local success, message = timeline:setTrackValueAtFrame(jointPath, playheadFrame, value, "Linear", "InOut")
							if not success then
								return false, message or "Could not create the trim boundary keyframe.", {}
							end
						end
					end
					if timeline:hasTrackKeyframe(jointPath, playheadFrame) then
						nextRefs[#nextRefs + 1] = {
							jointPath = jointPath,
							frame = playheadFrame,
						}
					end
				end
				if #deleteRefs &gt; 0 then
					timeline:deleteTrackKeyframes(deleteRefs)
				end
				group.mode = "Stretch"
				group.repeatSourceKeys = nil
				group.repeatSourceSpanFrames = nil
				local nextMinFrame, nextMaxFrame = getFrameBounds(nextRefs)
				group.sourceSpanFrames = math.max(1, (nextMaxFrame or playheadFrame) - (nextMinFrame or playheadFrame))
				replaceGroupKeys(keyframeEditService, group, nextRefs)
				for _, ref in ipairs(nextRefs) do
					changedRefs[#changedRefs + 1] = ref
				end
				changedCount += 1
			end
		end
	end

	if changedCount == 0 then
		return false, "Place the playhead inside the selected clip before trimming.", {}
	end
	return true, string.format("Trimmed %d clip%s %s the playhead.", changedCount, changedCount == 1 and "" or "s", string.lower(trimSide)), changedRefs
end

function KeyframeGroupTimingService.splitGroupAtPlayhead(timeline, keyframeEditService, groupIds, playheadFrame)
	if not timeline or not keyframeEditService then
		return false, "Timeline is not available.", {}
	end
	if type(groupIds) ~= "table" or #groupIds ~= 1 then
		return false, "Select one clip block before splitting.", {}
	end
	playheadFrame = math.max(0, math.floor(tonumber(playheadFrame) or 0))
	local groupId = getGroupIdValue(groupIds[1])
	local groups = keyframeEditService:getGroups()
	local group = groups[groupId]
	if not group then
		return false, "Select one clip block before splitting.", {}
	end
	local refs = keyframeEditService:getKeyRefsForGroup(groupId, timeline)
	local minFrame, maxFrame = getFrameBounds(refs)
	if not minFrame or not maxFrame or playheadFrame &lt;= minFrame or playheadFrame &gt;= (maxFrame - 1) then
		return false, "Place the playhead inside the clip with at least one frame remaining on each side.", {}
	end

	local rightStartFrame = playheadFrame + 1
	local leftPose = select(1, timeline:samplePose(playheadFrame)) or {}
	local rightPose = select(1, timeline:samplePose(rightStartFrame)) or {}
	local pathSet = {}
	for _, ref in ipairs(refs) do
		pathSet[ref.jointPath] = true
	end
	local membership = keyframeEditService:getGroupMembership()
	local createdRefs = {}
	for jointPath in pairs(pathSet) do
		for _, boundaryFrame in ipairs({ playheadFrame, rightStartFrame }) do
			local boundaryId = makeKeyId(jointPath, boundaryFrame)
			local boundaryGroupId = membership[boundaryId]
			if boundaryGroupId and not sameGroupId(boundaryGroupId, groupId) then
				return false, string.format("Frame %d already belongs to another group on one of these tracks.", boundaryFrame), {}
			end
			if not timeline:hasTrackKeyframe(jointPath, boundaryFrame) then
				local boundaryValue = boundaryFrame == playheadFrame and leftPose[jointPath] or rightPose[jointPath]
				if boundaryValue == nil then
					return false, "Could not sample every track at the split point.", {}
				end
				local success, message = timeline:setTrackValueAtFrame(jointPath, boundaryFrame, boundaryValue, "Linear", "InOut")
				if not success then
					if #createdRefs &gt; 0 then
						timeline:deleteTrackKeyframes(createdRefs)
					end
					return false, message or "Could not create the split boundary keyframes.", {}
				end
				createdRefs[#createdRefs + 1] = {
					jointPath = jointPath,
					frame = boundaryFrame,
				}
			end
		end
	end

	local leftRefs = {}
	local rightRefs = {}
	for jointPath in pairs(pathSet) do
		for _, frame in ipairs(timeline:getTrackKeyframeFrames(jointPath)) do
			local keyId = makeKeyId(jointPath, frame)
			local owner = membership[keyId]
			if sameGroupId(owner, groupId) or frame == playheadFrame or frame == rightStartFrame then
				local target = frame &lt;= playheadFrame and leftRefs or (frame &gt;= rightStartFrame and rightRefs or nil)
				if target then
					target[#target + 1] = {
						jointPath = jointPath,
						frame = frame,
					}
				end
			end
		end
	end
	if #leftRefs &lt; 2 or #rightRefs &lt; 2 then
		if #createdRefs &gt; 0 then
			timeline:deleteTrackKeyframes(createdRefs)
		end
		return false, "The clip does not contain enough keyframes on both sides of the playhead.", {}
	end

	local originalName = tostring(group.name or "Physics Clip")
	local originalKind = group.kind
	local originalMode = group.mode
	local originalFolderPath = group.folderPath
	groups[groupId] = nil
	keyframeEditService:rebuildGroupMembership()
	local leftSuccess, leftMessage, leftGroupId = keyframeEditService:groupSelectedKeys(leftRefs)
	if not leftSuccess then
		return false, leftMessage or "Could not create the first split clip.", {}
	end
	local rightSuccess, rightMessage, rightGroupId = keyframeEditService:groupSelectedKeys(rightRefs)
	if not rightSuccess then
		groups[leftGroupId] = nil
		keyframeEditService:rebuildGroupMembership()
		return false, rightMessage or "Could not create the second split clip.", {}
	end
	local leftGroup = groups[leftGroupId]
	local rightGroup = groups[rightGroupId]
	leftGroup.name = originalName .. " A"
	leftGroup.kind = originalKind
	leftGroup.folderPath = originalFolderPath
	leftGroup.mode = originalMode
	leftGroup.sourceSpanFrames = math.max(1, playheadFrame - minFrame)
	rightGroup.name = originalName .. " B"
	rightGroup.kind = originalKind
	rightGroup.folderPath = originalFolderPath
	rightGroup.mode = originalMode
	rightGroup.sourceSpanFrames = math.max(1, maxFrame - rightStartFrame)
	keyframeEditService:rebuildGroupMembership()

	local changedRefs = {}
	for _, ref in ipairs(rightRefs) do
		changedRefs[#changedRefs + 1] = ref
	end
	return true, string.format("Split %s into %s A and %s B at frame %d.", originalName, originalName, originalName, playheadFrame), changedRefs
end

return KeyframeGroupTimingService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX154">
        <Properties>
          <string name="Name">KeyframeNavigationSupport</string>
          <ProtectedString name="Source">local KeyframeNavigationSupport = {}

function KeyframeNavigationSupport.getPreviousKeyframeResult(timeline)
	local previousFrame = timeline:getPreviousKeyframe()
	if previousFrame == nil then
		return nil, "There is no previous keyframe."
	end
	return previousFrame, string.format("Jumped to previous keyframe at frame %d.", previousFrame)
end

function KeyframeNavigationSupport.getNextKeyframeResult(timeline)
	local nextFrame = timeline:getNextKeyframe()
	if nextFrame == nil then
		return nil, "There is no next keyframe."
	end
	return nextFrame, string.format("Jumped to next keyframe at frame %d.", nextFrame)
end

return KeyframeNavigationSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX155">
        <Properties>
          <string name="Name">KeyframePasteRemapService</string>
          <ProtectedString name="Source">local KeyframePasteRemapService = {}

local function cloneValue(value)
	if type(value) == "table" then
		local clone = {}
		for key, child in pairs(value) do
			clone[key] = cloneValue(child)
		end
		return clone
	end
	return value
end

local function cloneKey(key)
	local clone = {}
	for field, value in pairs(key or {}) do
		clone[field] = cloneValue(value)
	end
	return clone
end

local function getRelativeRigPath(path)
	if type(path) ~= "string" then
		return nil
	end
	return string.match(path, "^[^/]+/(.+)$")
end

local function getTrackMeta(track)
	if not track then
		return nil
	end

	return {
		path = track.path,
		name = track.name,
		part0 = track.part0,
		part1 = track.part1,
		rigName = track.rigName,
		trackType = track.trackType,
		valueType = track.valueType,
		targetScope = track.targetScope,
		propertyName = track.propertyName,
		parentTrackPath = track.parentTrackPath,
		parentTrackName = track.parentTrackName,
		relativeRigPath = getRelativeRigPath(track.path),
	}
end

local function makeRigGroupPath(rigName)
	return "riggroup:" .. tostring(rigName or "Rig")
end

local function valuesAreCompatible(sourceMeta, targetTrack)
	if not sourceMeta or not targetTrack then
		return false
	end
	if sourceMeta.trackType == "Rig" then
		return targetTrack.trackType == "Rig"
	end
	if sourceMeta.trackType == "Rig Property" then
		return targetTrack.trackType == "Rig Property" and sourceMeta.propertyName == targetTrack.propertyName
	end
	if sourceMeta.valueType and targetTrack.valueType and sourceMeta.valueType ~= targetTrack.valueType then
		return false
	end
	if sourceMeta.targetScope and targetTrack.targetScope and sourceMeta.targetScope ~= targetTrack.targetScope then
		return false
	end
	if sourceMeta.propertyName and targetTrack.propertyName and sourceMeta.propertyName ~= targetTrack.propertyName then
		return false
	end
	return true
end

local function addTrackIndexes(index, track)
	if not track or not track.path then
		return
	end

	index.byPath[track.path] = track
	if track.rigName then
		local rigBucket = index.rigs[track.rigName]
		if not rigBucket then
			rigBucket = {
				groupPath = makeRigGroupPath(track.rigName),
				rigTracksByRelativePath = {},
				rigPropertiesByName = {},
			}
			index.rigs[track.rigName] = rigBucket
		end
		if track.trackType == "Rig" then
			local relativePath = getRelativeRigPath(track.path)
			if relativePath then
				rigBucket.rigTracksByRelativePath[relativePath] = track
			end
		elseif track.trackType == "Rig Property" and track.propertyName then
			rigBucket.rigPropertiesByName[track.propertyName] = track
		end
	end
end

local function buildTrackIndex(timeline)
	local index = {
		byPath = {},
		rigs = {},
	}
	if not timeline or type(timeline.getTracks) ~= "function" then
		return index
	end
	for _, track in ipairs(timeline:getTracks()) do
		addTrackIndexes(index, track)
	end
	return index
end

local function getSelectedTracks(timeline, selectedTrackPaths, index)
	local selectedTracks = {}
	for _, path in ipairs(selectedTrackPaths or {}) do
		local track = index.byPath[path] or (timeline and timeline.getTrackByPath and timeline:getTrackByPath(path))
		if track then
			table.insert(selectedTracks, track)
		end
	end
	return selectedTracks
end

local function getSourcePaths(keys)
	local paths = {}
	local seen = {}
	for _, key in ipairs(keys or {}) do
		local path = key.jointPath or key.path
		if path and not seen[path] then
			seen[path] = true
			table.insert(paths, path)
		end
	end
	return paths
end

local function selectedTracksMatchSourcePaths(keys, selectedTracks)
	local sourcePaths = getSourcePaths(keys)
	if #sourcePaths ~= #selectedTracks then
		return false
	end

	local sourceSet = {}
	for _, path in ipairs(sourcePaths) do
		sourceSet[path] = true
	end
	for _, track in ipairs(selectedTracks) do
		if not sourceSet[track.path] then
			return false
		end
	end
	return true
end

local function getSourceMeta(key)
	if key and key.sourceTrack then
		return key.sourceTrack
	end
	return {
		path = key and (key.jointPath or key.path),
		relativeRigPath = getRelativeRigPath(key and (key.jointPath or key.path)),
	}
end

local function remapKeyToRig(key, rigName, index)
	local meta = getSourceMeta(key)
	local rigBucket = index.rigs[rigName]
	if not rigBucket then
		return nil
	end

	if meta.trackType == "Rig Property" and meta.propertyName then
		local propertyTrack = rigBucket.rigPropertiesByName[meta.propertyName]
		return propertyTrack and propertyTrack.path or nil
	end

	local relativePath = meta.relativeRigPath or getRelativeRigPath(meta.path)
	local rigTrack = relativePath and rigBucket.rigTracksByRelativePath[relativePath] or nil
	return rigTrack and rigTrack.path or nil
end

local function buildSingleTrackMap(keys, selectedTrack, index)
	local sourcePaths = getSourcePaths(keys)
	if #sourcePaths == 1 then
		local firstMeta = getSourceMeta(keys[1])
		if valuesAreCompatible(firstMeta, selectedTrack) then
			return {
				[sourcePaths[1]] = selectedTrack.path,
			}
		end
	end

	if selectedTrack.trackType == "Rig" and selectedTrack.rigName then
		local map = {}
		for _, key in ipairs(keys) do
			local sourcePath = key.jointPath or key.path
			if sourcePath and not map[sourcePath] then
				map[sourcePath] = remapKeyToRig(key, selectedTrack.rigName, index)
			end
		end
		return map
	end

	return nil
end

local function buildPairwiseMap(keys, selectedTracks)
	local sourcePaths = getSourcePaths(keys)
	if #sourcePaths ~= #selectedTracks then
		return nil
	end

	local firstKeyByPath = {}
	for _, key in ipairs(keys) do
		local path = key.jointPath or key.path
		if path and not firstKeyByPath[path] then
			firstKeyByPath[path] = key
		end
	end

	local map = {}
	for index, sourcePath in ipairs(sourcePaths) do
		local targetTrack = selectedTracks[index]
		local sourceMeta = getSourceMeta(firstKeyByPath[sourcePath])
		if not targetTrack or not valuesAreCompatible(sourceMeta, targetTrack) then
			return nil
		end
		map[sourcePath] = targetTrack.path
	end
	return map
end

local function remapWithPathMap(keys, pathMap)
	local remapped = {}
	local changed = false
	local skipped = 0
	for _, key in ipairs(keys) do
		local sourcePath = key.jointPath or key.path
		local targetPath = sourcePath and pathMap[sourcePath] or nil
		if targetPath then
			local clone = cloneKey(key)
			clone.jointPath = targetPath
			clone.path = nil
			table.insert(remapped, clone)
			changed = changed or targetPath ~= sourcePath
		else
			skipped += 1
		end
	end
	return remapped, changed, skipped
end

local function remapToRigGroups(keys, selectedTracks, index)
	local rigGroups = {}
	for _, track in ipairs(selectedTracks) do
		if track.trackType == "Rig Group" and track.rigName then
			table.insert(rigGroups, track.rigName)
		end
	end
	if #rigGroups == 0 then
		return nil, false, 0
	end

	local remapped = {}
	local changed = false
	local skipped = 0
	for _, rigName in ipairs(rigGroups) do
		for _, key in ipairs(keys) do
			local sourcePath = key.jointPath or key.path
			local targetPath = remapKeyToRig(key, rigName, index)
			if targetPath then
				local clone = cloneKey(key)
				clone.jointPath = targetPath
				clone.path = nil
				table.insert(remapped, clone)
				changed = changed or targetPath ~= sourcePath
			else
				skipped += 1
			end
		end
	end
	return remapped, changed, skipped
end

function KeyframePasteRemapService.withTrackMetadata(timeline, keys)
	local enriched = {}
	for _, key in ipairs(keys or {}) do
		local clone = cloneKey(key)
		local path = key.jointPath or key.path
		local track = path and timeline and timeline.getTrackByPath and timeline:getTrackByPath(path) or nil
		clone.sourceTrack = getTrackMeta(track) or getSourceMeta(key)
		table.insert(enriched, clone)
	end
	return enriched
end

function KeyframePasteRemapService.remapForSelectedTracks(timeline, clipboardKeys, selectedTrackPaths)
	local keys = {}
	for _, key in ipairs(clipboardKeys or {}) do
		table.insert(keys, cloneKey(key))
	end
	if #keys == 0 then
		return keys, false, 0
	end

	local index = buildTrackIndex(timeline)
	local selectedTracks = getSelectedTracks(timeline, selectedTrackPaths, index)
	if #selectedTracks == 0 then
		return keys, false, 0
	end
	if selectedTracksMatchSourcePaths(keys, selectedTracks) then
		return keys, false, 0
	end

	local rigGroupKeys, rigGroupChanged, rigGroupSkipped = remapToRigGroups(keys, selectedTracks, index)
	if rigGroupKeys and #rigGroupKeys &gt; 0 then
		return rigGroupKeys, rigGroupChanged, rigGroupSkipped
	end

	if #selectedTracks == 1 then
		local pathMap = buildSingleTrackMap(keys, selectedTracks[1], index)
		if pathMap then
			return remapWithPathMap(keys, pathMap)
		end
	end

	local pathMap = buildPairwiseMap(keys, selectedTracks)
	if pathMap then
		return remapWithPathMap(keys, pathMap)
	end

	return keys, false, 0
end

return KeyframePasteRemapService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX156">
        <Properties>
          <string name="Name">KeyframeSelectionRebuildSupport</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local KeyframeSelectionRebuildSupport = {}

function KeyframeSelectionRebuildSupport.buildMovedSelection(selectedKeyRefs, offset, durationFrames)
	local newSelected = {}
	local movedKeys = {}
	for _, key in ipairs(selectedKeyRefs) do
		local newFrame = math.max(0, math.min(durationFrames, key.frame + offset))
		newSelected[SelectionState.makeTrackKeyId(key.jointPath, newFrame)] = {
			jointPath = key.jointPath,
			frame = newFrame,
		}
		table.insert(movedKeys, {
			jointPath = key.jointPath,
			frame = newFrame,
		})
	end
	return newSelected, movedKeys
end

function KeyframeSelectionRebuildSupport.buildPastedSelection(pastedKeys)
	local selectedKeys = {}
	for _, key in ipairs(pastedKeys or {}) do
		selectedKeys[SelectionState.makeTrackKeyId(key.jointPath, key.frame)] = {
			jointPath = key.jointPath,
			frame = key.frame,
		}
	end
	return selectedKeys
end

function KeyframeSelectionRebuildSupport.buildSelectedScope(selectedPaths)
	if #selectedPaths == 0 then
		return nil
	end
	local selectedScope = {}
	for _, path in ipairs(selectedPaths) do
		selectedScope[path] = true
	end
	return selectedScope
end

return KeyframeSelectionRebuildSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX157">
        <Properties>
          <string name="Name">LightingEffectActionService</string>
          <ProtectedString name="Source">local LightingEffectActionService = {}

local LightingEffectTrackService = require(script.Parent:WaitForChild("LightingEffectTrackService"))

function LightingEffectActionService.addTrack(context, effectType, options)
	options = type(options) == "table" and options or {}
	local effectDefinition = LightingEffectTrackService.getEffectDefinition(effectType)
	if not effectDefinition then
		context.refreshUi("That lighting effect track is not available yet.")
		return
	end

	context.pushUndo("Add Lighting Effect Track")
	context.changeHistoryService:SetWaypoint("Before Add Lighting Effect Track")
	local track, wasAdded = LightingEffectTrackService.addTrack(context.timeline, effectType, options)
	context.setSingleSelectedTrack(track.path)
	if wasAdded then
		context.changeHistoryService:SetWaypoint("After Add Lighting Effect Track")
		context.refreshUi(string.format("Added %s lighting effect track. Add keyframes, then use ... or Keypad 7 for settings.", effectDefinition.name or track.name))
	else
		context.historyService:discardPendingUndo()
		context.refreshUi(string.format("%s lighting effect track already exists.", effectDefinition.name or track.name))
	end
	return track.path
end

function LightingEffectActionService.previewValue(context, trackPath, value)
	local track = context.timeline:getTrackByPath(trackPath)
	if not LightingEffectTrackService.isLightingEffectTrack(track) then
		return
	end

	local effectType = LightingEffectTrackService.normalizeEffectType(track.valueType or track.effectType or track.name)
	local parsedValue = LightingEffectTrackService.normalizeValue(effectType, value)
	LightingEffectTrackService.applyTrackValue(track, parsedValue)
end

function LightingEffectActionService.cancelPreview(context)
	LightingEffectTrackService.applyTimelineEffects(context.timeline, context.timeline:getCurrentFrame())
end

function LightingEffectActionService.applyTimeline(context, frame)
	LightingEffectTrackService.applyTimelineEffects(context.timeline, frame or context.timeline:getCurrentFrame())
end

function LightingEffectActionService.setValue(context, trackPath, value, options)
	local timeline = context.timeline
	local track = timeline:getTrackByPath(trackPath)
	if not LightingEffectTrackService.isLightingEffectTrack(track) then
		context.refreshUi("Select a lighting effect keyframe before editing settings.")
		return
	end

	options = type(options) == "table" and options or {}
	local effectType = LightingEffectTrackService.normalizeEffectType(track.valueType or track.effectType or track.name)
	local parsedValue = LightingEffectTrackService.normalizeValue(effectType, value)
	local targetFramesByKey = {}
	if options.currentFrameOnly then
		targetFramesByKey[timeline:getCurrentFrame()] = true
	else
		for _, key in pairs(context.getSelectedKeys()) do
			if key.jointPath == track.path then
				targetFramesByKey[key.frame] = true
			end
		end
		if next(targetFramesByKey) == nil then
			targetFramesByKey[timeline:getCurrentFrame()] = true
		end
	end

	local targetFrames = {}
	for frame in pairs(targetFramesByKey) do
		table.insert(targetFrames, frame)
	end
	context.sortFrames(targetFrames)

	local actionName = tostring(options.actionName or "Lighting Effect Keyframe")
	context.pushUndo("Set " .. actionName)
	context.changeHistoryService:SetWaypoint("Before Set " .. actionName)
	local keyRefs = {}
	for _, frame in ipairs(targetFrames) do
		local success, message = timeline:setTrackValueAtFrame(track.path, frame, parsedValue)
		if not success then
			context.historyService:discardPendingUndo()
			context.refreshUi(message or "Could not set lighting effect keyframe.")
			return
		end
		table.insert(keyRefs, {
			jointPath = track.path,
			frame = frame,
		})
	end

	local lastFrame = targetFrames[#targetFrames] or timeline:getCurrentFrame()
	timeline:setCurrentFrame(lastFrame)
	context.setSingleSelectedTrack(track.path)
	context.selectKeys(keyRefs)
	LightingEffectTrackService.applyTimelineEffects(timeline, lastFrame)
	context.changeHistoryService:SetWaypoint("After Set " .. actionName)
	context.refreshUi(string.format("Set %s on %d keyframe%s.", tostring(track.name or "Lighting Effect"), #keyRefs, #keyRefs == 1 and "" or "s"))
end

return LightingEffectActionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX158">
        <Properties>
          <string name="Name">LightingEffectTrackService</string>
          <ProtectedString name="Source">local LightingEffectTrackService = {}

LightingEffectTrackService.TRACK_TYPE = "Lighting Effect"

local Lighting = game:GetService("Lighting")

local EFFECT_ORDER = {
	"Lighting",
	"Atmosphere",
	"Sky",
	"Bloom",
	"DepthOfField",
	"SunRays",
	"ColorCorrection",
	"Blur",
	"Highlight",
}

local EFFECT_DEFINITIONS = {
	Lighting = {
		id = "Lighting",
		name = "Lighting",
		description = "Keyframe global Lighting properties such as brightness, time of day, fog, ambient color, and shadows.",
		trackName = "Lighting",
		sortOrder = 3,
		defaultValue = {
			brightness = 2,
			clockTime = 14,
			exposureCompensation = 0,
			ambient = Color3.fromRGB(70, 70, 70),
			outdoorAmbient = Color3.fromRGB(70, 70, 70),
			colorShiftTop = Color3.fromRGB(255, 255, 255),
			colorShiftBottom = Color3.fromRGB(255, 255, 255),
			fogColor = Color3.fromRGB(192, 192, 192),
			fogStart = 0,
			fogEnd = 100000,
			globalShadows = true,
		},
		fields = {
			{ key = "brightness", label = "Brightness", kind = "number", min = 0, max = 10 },
			{ key = "clockTime", label = "Clock Time (0-24)", kind = "number", min = 0, max = 24 },
			{ key = "exposureCompensation", label = "Exposure Compensation", kind = "number", min = -5, max = 5 },
			{ key = "ambient", label = "Ambient", kind = "color" },
			{ key = "outdoorAmbient", label = "Outdoor Ambient", kind = "color" },
			{ key = "colorShiftTop", label = "Color Shift Top", kind = "color" },
			{ key = "colorShiftBottom", label = "Color Shift Bottom", kind = "color" },
			{ key = "fogColor", label = "Fog Color", kind = "color" },
			{ key = "fogStart", label = "Fog Start", kind = "number", min = 0, max = 100000 },
