      <Item class="ModuleScript" referent="RBX149">
        <Properties>
          <string name="Name">KeyframeEditService</string>
          <ProtectedString name="Source">local KeyframeEditService = {}
KeyframeEditService.__index = KeyframeEditService

local KeyframePasteRemapService = require(script.Parent:WaitForChild("KeyframePasteRemapService"))
local PhysicsClipClipboardSupport = require(script.Parent:WaitForChild("PhysicsClipClipboardSupport"))
local PhysicsClipIntegritySupport = require(script.Parent:WaitForChild("PhysicsClipIntegritySupport"))

local function swapSideToken(text)
	if type(text) ~= "string" then
		return nil
	end

	local swapped
	if string.find(text, "Left", 1, true) then
		swapped = string.gsub(text, "Left", "Right")
	elseif string.find(text, "Right", 1, true) then
		swapped = string.gsub(text, "Right", "Left")
	end

	return swapped
end

local function mirrorCFrame(value)
	if typeof(value) ~= "CFrame" then
		return nil
	end

	local position = value.Position
	local rx, ry, rz = value:ToOrientation()
	return CFrame.new(-position.X, position.Y, position.Z) * CFrame.fromOrientation(rx, -ry, -rz)
end

local function invertFromDefault(sourceValue, sourceDefault, targetDefault)
	if typeof(sourceValue) ~= "CFrame" or typeof(sourceDefault) ~= "CFrame" or typeof(targetDefault) ~= "CFrame" then
		return nil
	end

	local sourceDelta = sourceDefault:Inverse() * sourceValue
	return targetDefault * sourceDelta:Inverse()
end

local function buildMotorIndex(motors)
	local index = {}
	for _, motorData in ipairs(motors or {}) do
		local rig = motorData.rig
		if rig then
			local bucket = index[rig]
			if not bucket then
				bucket = {
					byName = {},
					byPart0 = {},
					byPart1 = {},
					byPath = {},
				}
				index[rig] = bucket
			end
			bucket.byName[motorData.name] = motorData
			bucket.byPart0[motorData.part0] = motorData
			bucket.byPart1[motorData.part1] = motorData
			bucket.byPath[motorData.path] = motorData
		end
	end
	return index
end

local function buildSelectedTrackScope(timeline, selectedTrackPaths)
	if type(selectedTrackPaths) ~= "table" then
		return nil
	end

	local scopedPaths = {}
	local hasScope = false
	for path, isSelected in pairs(selectedTrackPaths) do
		if isSelected then
			local track = timeline:getTrackByPath(path)
			if track then
				if track.trackType == "Rig Group" and track.rigName then
					for _, candidate in ipairs(timeline:getTracks()) do
						if candidate.rigName == track.rigName and candidate.path ~= track.path then
							scopedPaths[candidate.path] = true
							hasScope = true
						end
					end
				elseif track.targetScope == "TimelineFolder" then
					for _, candidate in ipairs(timeline:getTracks()) do
						if candidate.folderPath == path then
							scopedPaths[candidate.path] = true
							hasScope = true
						end
					end
				else
					scopedPaths[path] = true
					hasScope = true
				end
			end
		end
	end

	return hasScope and scopedPaths or nil
end

local function findOppositeMotor(motorData, motorIndex)
	local bucket = motorData and motorData.rig and motorIndex[motorData.rig]
	if not bucket then
		return nil
	end

	local pathTail = string.match(tostring(motorData.path or ""), "^[^/]+/(.+)$")
	local swappedTail = swapSideToken(pathTail)
	local candidates = {}
	if swappedTail then
		table.insert(candidates, {
			kind = "path",
			value = tostring(motorData.rigName or (motorData.rig and motorData.rig.Name) or "Rig") .. "/" .. swappedTail,
		})
	end
	table.insert(candidates, { kind = "path", value = swapSideToken(motorData.path) })
	table.insert(candidates, { kind = "name", value = swapSideToken(motorData.name) })
	table.insert(candidates, { kind = "part1", value = swapSideToken(motorData.part1) })
	table.insert(candidates, { kind = "part0", value = swapSideToken(motorData.part0) })

	for _, candidate in ipairs(candidates) do
		if candidate.value then
			local opposite
			if candidate.kind == "path" then
				opposite = bucket.byPath[candidate.value]
			elseif candidate.kind == "name" then
				opposite = bucket.byName[candidate.value]
			elseif candidate.kind == "part1" then
				opposite = bucket.byPart1[candidate.value]
			else
				opposite = bucket.byPart0[candidate.value]
			end
			if opposite and opposite.path ~= motorData.path then
				return opposite
			end
		end
	end

	return nil
end

function KeyframeEditService.new(selectionState)
	return setmetatable({
		_selectionState = selectionState,
		clipboardKeys = {},
		physicsClipClipboard = nil,
		keyGroups = {},
		groupMembership = {},
		nextGroupId = 1,
	}, KeyframeEditService)
end

function KeyframeEditService:getClipboardKeys()
	return self.clipboardKeys
end

function KeyframeEditService:getGroups()
	return self.keyGroups
end

function KeyframeEditService:getGroupMembership()
	return self.groupMembership
end

function KeyframeEditService:getNextGroupId()
	return self.nextGroupId
end

function KeyframeEditService:getGroupIdsForKeys(keys)
	return self._selectionState.getGroupIdsForKeys(keys, self.groupMembership)
end

function KeyframeEditService:getKeyRefsForGroup(groupId, timeline)
	return self._selectionState.getKeyRefsForGroup(groupId, self.keyGroups, timeline)
end

function KeyframeEditService:rebuildGroupMembership()
	self.groupMembership = self._selectionState.rebuildGroupMembership(self.keyGroups)
	return self.groupMembership
end

function KeyframeEditService:remapGroupsAfterMove(oldKeys, newKeys)
	self.groupMembership = self._selectionState.remapGroupsAfterMove(
		oldKeys,
		newKeys,
		self.keyGroups,
		self.groupMembership
	)
	return self.groupMembership
end

function KeyframeEditService:removeDeletedKeysFromGroups(timeline)
	self.groupMembership = self._selectionState.removeDeletedKeysFromGroups(self.keyGroups, timeline)
	return self.groupMembership
end

function KeyframeEditService:createSnapshotData()
	return {
		keyGroups = self._selectionState.cloneGroupState(self.keyGroups),
		nextGroupId = self.nextGroupId,
	}
end

function KeyframeEditService:restoreSnapshotData(snapshot)
	self.keyGroups = self._selectionState.cloneGroupState(snapshot and snapshot.keyGroups)
	self.nextGroupId = (snapshot and snapshot.nextGroupId) or self.nextGroupId
	self:rebuildGroupMembership()
end

function KeyframeEditService:resetGroups()
	self.keyGroups = {}
	self.groupMembership = {}
	self.nextGroupId = 1
	self.physicsClipClipboard = nil
end

local function remapSavedRuntimeCapture(runtimeCapture, pathMap)
	if type(runtimeCapture) ~= "table" or runtimeCapture.captureType ~= "Objects" then
		return runtimeCapture
	end

	local remappedCapture = {}
	for key, value in pairs(runtimeCapture) do
		remappedCapture[key] = value
	end

	local remappedTargets = {}
	for _, target in ipairs(runtimeCapture.targets or {}) do
		if type(target) == "table" then
			local remappedTarget = {}
			for key, value in pairs(target) do
				remappedTarget[key] = value
			end
			if type(target.trackPath) == "string" then
				remappedTarget.trackPath = pathMap[target.trackPath] or target.trackPath
			end
			table.insert(remappedTargets, remappedTarget)
		end
	end
	remappedCapture.targets = remappedTargets

	return remappedCapture
end

function KeyframeEditService:loadSavedGroups(extra, pathMap, options, timeline)
	options = options or {}
	local reset = options.reset == true
	local frameOffset = math.max(0, math.floor(options.frameOffset or 0))
	if reset then
		self:resetGroups()
	end
	local groups = extra and extra.groups
	if type(groups) ~= "table" then
		return
	end

	local highestGroupId = self.nextGroupId - 1
	for _, group in ipairs(groups) do
		if type(group) == "table" then
			local groupId = reset and tonumber(group.id) or self.nextGroupId
			if groupId then
				local restoredKeys = {}
				for _, savedKeyId in ipairs(group.keys or {}) do
					if type(savedKeyId) == "string" then
						local divider = string.find(savedKeyId, "\n", 1, true)
						local savedPath = divider and string.sub(savedKeyId, 1, divider - 1) or nil
						local frame = divider and tonumber(string.sub(savedKeyId, divider + 1)) or nil
						if frame then
							frame += frameOffset
						end
						local restoredPath = savedPath and (pathMap[savedPath] or savedPath) or nil
						if restoredPath and frame and (timeline:getMotorByPath(restoredPath) or timeline:getTrackByPath(restoredPath)) and timeline:hasTrackKeyframe(restoredPath, frame) then
							restoredKeys[self._selectionState.makeTrackKeyId(restoredPath, frame)] = true
						end
					end
				end

				local count = 0
				for _ in pairs(restoredKeys) do
					count += 1
				end
				if count &gt;= 2 then
					local groupMode = group.mode == "Stretch" and "Stretch" or (group.mode == "Repeat" and "Repeat" or nil)
					local restoredRuntimeCapture = group.kind == "PhysicsClip"
						and remapSavedRuntimeCapture(group.runtimeCapture, pathMap)
						or nil
					local savedRuntimeKeyCount = tonumber(group.runtimeKeyCount)
					local runtimeCaptureValid = restoredRuntimeCapture ~= nil and group.runtimeCaptureValid ~= false
					if savedRuntimeKeyCount and savedRuntimeKeyCount ~= count then
						runtimeCaptureValid = false
					end
					local repeatSourceKeys = nil
					if groupMode == "Repeat" and type(group.repeatSourceKeys) == "table" then
						repeatSourceKeys = {}
						for _, savedKeyId in ipairs(group.repeatSourceKeys) do
							if type(savedKeyId) == "string" then
								local divider = string.find(savedKeyId, "\n", 1, true)
								local savedPath = divider and string.sub(savedKeyId, 1, divider - 1) or nil
								local frame = divider and tonumber(string.sub(savedKeyId, divider + 1)) or nil
								if frame then
									frame += frameOffset
								end
								local restoredPath = savedPath and (pathMap[savedPath] or savedPath) or nil
								if restoredPath and frame then
									repeatSourceKeys[self._selectionState.makeTrackKeyId(restoredPath, frame)] = true
								end
							end
						end
					end
					local restoredGroup = {
						id = groupId,
						mode = groupMode,
						name = type(group.name) == "string" and group.name or ("Group " .. tostring(groupId)),
						kind = type(group.kind) == "string" and group.kind or nil,
						folderPath = type(group.folderPath) == "string"
							and (pathMap[group.folderPath] or group.folderPath)
							or nil,
						sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
						runtimeCapture = restoredRuntimeCapture,
						runtimeKeyCount = restoredRuntimeCapture and (savedRuntimeKeyCount or count) or nil,
						runtimeKeySignature = nil,
						runtimeCaptureValid = restoredRuntimeCapture and runtimeCaptureValid,
						repeatSourceKeys = repeatSourceKeys,
						repeatSourceSpanFrames = tonumber(group.repeatSourceSpanFrames),
						keys = restoredKeys,
					}
					self.keyGroups[groupId] = restoredGroup
					if runtimeCaptureValid then
						PhysicsClipIntegritySupport.EstablishBaseline(restoredGroup, timeline)
					end
					highestGroupId = math.max(highestGroupId, groupId)
					if not reset then
						self.nextGroupId += 1
					end
				end
			end
		end
	end

	self.nextGroupId = highestGroupId + 1
	self:rebuildGroupMembership()
end

function KeyframeEditService:getGroupSaveData(timeline)
	local groups = {}
	for groupId, group in pairs(self.keyGroups) do
		local runtimeCaptureValid = nil
		if group.kind == "PhysicsClip" and type(group.runtimeCapture) == "table" then
			runtimeCaptureValid = PhysicsClipIntegritySupport.IsValid(group, timeline)
		end
		local keys = {}
		for keyId in pairs(group.keys or {}) do
			table.insert(keys, keyId)
		end
		table.sort(keys)
		table.insert(groups, {
			id = groupId,
			mode = group.mode,
			name = group.name,
			kind = group.kind,
			folderPath = group.folderPath,
			sourceSpanFrames = group.sourceSpanFrames,
			runtimeCapture = group.runtimeCapture,
			runtimeKeyCount = group.runtimeKeyCount,
			runtimeCaptureValid = runtimeCaptureValid,
			repeatSourceSpanFrames = group.repeatSourceSpanFrames,
			keys = keys,
			repeatSourceKeys = (function()
				local sourceKeys = {}
				for keyId in pairs(group.repeatSourceKeys or {}) do
					table.insert(sourceKeys, keyId)
				end
				table.sort(sourceKeys)
				return #sourceKeys &gt; 0 and sourceKeys or nil
			end)(),
		})
	end
	table.sort(groups, function(a, b)
		return a.id &lt; b.id
	end)
	return groups
end

function KeyframeEditService:copySelectedKeys(timeline, selectedKeyRefs)
	if #selectedKeyRefs == 0 then
		return false, "Select keyframes before copying."
	end

	local copiedKeys = KeyframePasteRemapService.withTrackMetadata(timeline, timeline:getTrackKeyValues(selectedKeyRefs))
	if #copiedKeys == 0 then
		return false, "No selected keyframes could be copied."
	end

	local firstFrame = copiedKeys[1].frame
	self.clipboardKeys = {}
	for _, key in ipairs(copiedKeys) do
		table.insert(self.clipboardKeys, {
			jointPath = key.jointPath,
			frame = key.frame - firstFrame,
			value = key.value,
			easingStyle = key.easingStyle,
			easingDirection = key.easingDirection,
			sourceTrack = key.sourceTrack,
		})
	end
	self.physicsClipClipboard = PhysicsClipClipboardSupport.Capture(
		timeline,
		self,
		selectedKeyRefs,
		self.clipboardKeys
	)

	if self.physicsClipClipboard then
		return true, string.format("Copied exact Physics Clip '%s' with %d keyframes.", self.physicsClipClipboard.name, #self.clipboardKeys)
	end
	return true, string.format("Copied %d keyframes.", #self.clipboardKeys)
end

function KeyframeEditService:cutSelectedKeys(timeline, selectedKeyRefs)
	local copied, copyMessage = self:copySelectedKeys(timeline, selectedKeyRefs)
	if not copied then
		return false, copyMessage
	end

	local success, message = timeline:deleteTrackKeyframes(selectedKeyRefs)
	if success then
		self:removeDeletedKeysFromGroups(timeline)
	end
	return success, message
end

function KeyframeEditService:pasteKeysAtPlayhead(timeline, selectedTrackPaths)
	if #self.clipboardKeys == 0 then
		return false, "Copy or cut keyframes before pasting."
	end
	if self.physicsClipClipboard then
		return PhysicsClipClipboardSupport.PasteAtPlayhead(
			timeline,
			self,
			self.physicsClipClipboard,
			timeline:getCurrentFrame()
		)
	end

	local keysToPaste, remapped, skipped = KeyframePasteRemapService.remapForSelectedTracks(timeline, self.clipboardKeys, selectedTrackPaths)
	local success, message, pastedKeys = timeline:pasteTrackKeyframes(keysToPaste, timeline:getCurrentFrame())
	if success and remapped then
		if (skipped or 0) &gt; 0 then
			message = string.format(
				"%s Remapped to selected track(s); skipped %d incompatible keyframe%s.",
				message,
				skipped,
				skipped == 1 and "" or "s"
			)
		else
			message = tostring(message) .. " Remapped to selected track(s)."
		end
	end
	return success, message, pastedKeys
end

function KeyframeEditService:pastePhysicsClipToSelectedRigs(timeline, selection)
	return PhysicsClipClipboardSupport.PasteToSelectedRigs(
		timeline,
		self,
		self.physicsClipClipboard,
		selection,
		timeline:getCurrentFrame()
	)
end

function KeyframeEditService:mirrorSelectedKeys(timeline, selectedKeyRefs)
	if type(selectedKeyRefs) ~= "table" or #selectedKeyRefs == 0 then
		return false, "Select rig keyframes before mirroring.", {}
	end

	local sourceKeys = timeline:getTrackKeyValues(selectedKeyRefs)
	if #sourceKeys == 0 then
		return false, "No selected keyframes could be mirrored.", {}
	end

	local motorIndex = buildMotorIndex(timeline:getMotors())
	local mirroredKeys = {}
	local changedKeys = {}
	local seenTargets = {}
	local skipped = 0

	for _, key in ipairs(sourceKeys) do
		local mirroredValue = mirrorCFrame(key.value)
		local motorData = timeline:getMotorByPath(key.jointPath)
		if mirroredValue and motorData then
			local oppositeMotor = findOppositeMotor(motorData, motorIndex)
			local targetPath = oppositeMotor and oppositeMotor.path or key.jointPath
			local targetId = self._selectionState.makeTrackKeyId(targetPath, key.frame)
			if not seenTargets[targetId] then
				seenTargets[targetId] = true
				table.insert(mirroredKeys, {
					jointPath = targetPath,
					frame = key.frame,
					value = mirroredValue,
					easingStyle = key.easingStyle,
					easingDirection = key.easingDirection,
				})
				table.insert(changedKeys, {
					jointPath = targetPath,
					frame = key.frame,
				})
			end
		else
			skipped += 1
		end
	end

	if #mirroredKeys == 0 then
		return false, "Only rig CFrame keyframes can be mirrored right now.", {}
	end

	local success = timeline:pasteTrackKeyframes(mirroredKeys, 0)
	if not success then
		return false, "No mirrored keyframes could be written.", {}
	end

	local message = string.format("Mirrored %d rig keyframe%s.", #mirroredKeys, #mirroredKeys == 1 and "" or "s")
	if skipped &gt; 0 then
		message ..= string.format(" Skipped %d unsupported key%s.", skipped, skipped == 1 and "" or "s")
	end
	return true, message, changedKeys
end

function KeyframeEditService:invertSelectedKeys(timeline, selectedKeyRefs)
	if type(selectedKeyRefs) ~= "table" or #selectedKeyRefs == 0 then
		return false, "Select rig keyframes before inverting.", {}
	end

	local sourceKeys = timeline:getTrackKeyValues(selectedKeyRefs)
	if #sourceKeys == 0 then
		return false, "No selected keyframes could be inverted.", {}
	end

	local motorIndex = buildMotorIndex(timeline:getMotors())
	local invertedKeys = {}
	local changedKeys = {}
	local seenTargets = {}
	local skipped = 0

	for _, key in ipairs(sourceKeys) do
		local motorData = timeline:getMotorByPath(key.jointPath)
		local oppositeMotor = findOppositeMotor(motorData, motorIndex)
		local targetPath = oppositeMotor and oppositeMotor.path or key.jointPath
		local invertedValue = invertFromDefault(
			key.value,
			timeline:getOriginalPose(key.jointPath),
			timeline:getOriginalPose(targetPath)
		)
		if invertedValue then
			local targetId = self._selectionState.makeTrackKeyId(targetPath, key.frame)
			if not seenTargets[targetId] then
				seenTargets[targetId] = true
				table.insert(invertedKeys, {
					jointPath = targetPath,
					frame = key.frame,
					value = invertedValue,
					easingStyle = key.easingStyle,
					easingDirection = key.easingDirection,
				})
				table.insert(changedKeys, {
					jointPath = targetPath,
					frame = key.frame,
				})
			end
		else
			skipped += 1
		end
	end

	if #invertedKeys == 0 then
		return false, "Only rig pose keyframes can be inverted right now.", {}
	end

	local success = timeline:pasteTrackKeyframes(invertedKeys, 0)
	if not success then
		return false, "No inverted keyframes could be written.", {}
	end

	local message = string.format("Inverted %d rig keyframe%s.", #invertedKeys, #invertedKeys == 1 and "" or "s")
	if skipped &gt; 0 then
		message ..= string.format(" Skipped %d unsupported key%s.", skipped, skipped == 1 and "" or "s")
	end
	return true, message, changedKeys
end

function KeyframeEditService:buildSelectAllKeys(timeline, selectedTrackPaths)
	local selectedKeys = {}
	local selectedCount = 0
	local scopedPaths = buildSelectedTrackScope(timeline, selectedTrackPaths)
	for path, frames in pairs(timeline:getTrackKeyframesByPath()) do
		if not scopedPaths or scopedPaths[path] then
			for _, frame in ipairs(frames) do
				selectedKeys[self._selectionState.makeTrackKeyId(path, frame)] = {
					jointPath = path,
					frame = frame,
				}
				selectedCount += 1
			end
		end
	end
	return selectedKeys, selectedCount, scopedPaths ~= nil
end

function KeyframeEditService:groupSelectedKeys(selectedKeyRefs, options)
	if #selectedKeyRefs &lt; 2 then
		return false, "Select two or more keyframes before grouping."
	end

	options = options or {}
	local allowRegroup = options.regroup == true or options.replaceExisting == true
	local skippedExisting = 0

	local keysToGroup = {}
	for _, key in ipairs(selectedKeyRefs) do
		local keyId = self._selectionState.makeTrackKeyId(key.jointPath, key.frame)
		local oldGroupId = self.groupMembership[keyId]
		if oldGroupId and not allowRegroup then
			skippedExisting += 1
		else
			table.insert(keysToGroup, key)
		end
	end

	if #keysToGroup &lt; 2 then
		if skippedExisting &gt; 0 then
			return false, "Selected keyframes are already grouped. Ungroup them first to regroup."
		end
		return false, "Select two or more ungrouped keyframes before creating another group."
	end

	local groupId = self.nextGroupId
	self.nextGroupId += 1
	local group = {
		id = groupId,
		name = string.format("Group %d", groupId),
		keys = {},
	}

	for _, key in ipairs(keysToGroup) do
		local keyId = self._selectionState.makeTrackKeyId(key.jointPath, key.frame)
		local oldGroupId = self.groupMembership[keyId]
		if allowRegroup and oldGroupId and self.keyGroups[oldGroupId] then
			self.keyGroups[oldGroupId].keys[keyId] = nil
		end
		group.keys[keyId] = true
	end

	self.keyGroups[groupId] = group
	self:rebuildGroupMembership()
	return true, string.format("Grouped %d keyframes into %s.", #keysToGroup, group.name), groupId
end

function KeyframeEditService:ungroupSelectedKeys(selectedKeys)
	local groupIds = self:getGroupIdsForKeys(selectedKeys)
	if #groupIds == 0 then
		return false, "Select a grouped keyframe before ungrouping."
	end

	local selectedKeyIds = {}
	for _, key in pairs(selectedKeys or {}) do
		selectedKeyIds[self._selectionState.makeTrackKeyId(key.jointPath, key.frame)] = true
	end

	local removedKeyCount = 0
	for _, groupId in ipairs(groupIds) do
		local group = self.keyGroups[groupId]
		if group then
			local remainingKeyCount = 0
			for keyId in pairs(group.keys or {}) do
				if selectedKeyIds[keyId] then
					group.keys[keyId] = nil
					if type(group.repeatSourceKeys) == "table" then
						group.repeatSourceKeys[keyId] = nil
					end
					removedKeyCount += 1
				else
					remainingKeyCount += 1
				end
			end
			if remainingKeyCount &lt; 2 then
				self.keyGroups[groupId] = nil
			end
		end
	end
	self:rebuildGroupMembership()
	return true, string.format(
		"Ungrouped %d selected keyframe%s from %d group%s.",
		removedKeyCount,
		removedKeyCount == 1 and "" or "s",
		#groupIds,
		#groupIds == 1 and "" or "s"
	)
end

return KeyframeEditService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX150">
        <Properties>
          <string name="Name">KeyframeGroupBlockVisualSupport</string>
          <ProtectedString name="Source">local AudioClipVisualSupport = require(script.Parent:WaitForChild("AudioClipVisualSupport"))

local KeyframeGroupBlockVisualSupport = {}

local STRETCH_COLOR = Color3.fromRGB(92, 198, 255)
local REPEAT_COLOR = Color3.fromRGB(255, 197, 82)
local DEFAULT_COLOR = Color3.fromRGB(255, 166, 71)
local TEXT_DARK = Color3.fromRGB(28, 18, 8)

function KeyframeGroupBlockVisualSupport.getColor(mode, selectedColor, trackColor)
	if typeof(trackColor) == "Color3" then
		return trackColor
	end
	if mode == "Stretch" then
		return STRETCH_COLOR
	end
	if mode == "Repeat" then
		return REPEAT_COLOR
	end
	return selectedColor or DEFAULT_COLOR
end

function KeyframeGroupBlockVisualSupport.getTextColor(_mode, _backgroundColor)
	return TEXT_DARK
end

local function getPhysicsClipDisplayName(clip)
	local name = tostring(clip and clip.name or "")
	if name == "" or name == "Physics Clip" or string.match(name, "^Physics Clip %d+$") then
		local groupId = clip and clip.groupId
		return groupId and ("Group " .. tostring(groupId)) or "Physics Clip"
	end
	return name
end

function KeyframeGroupBlockVisualSupport.getLabel(clip, width)
	width = tonumber(width) or 0
	if width &lt;= 54 then
		return ""
	end
	local mode = clip and clip.mode
	local minFrame = math.max(0, math.floor(tonumber(clip and clip.minFrame) or 0))
	local maxFrame = math.max(minFrame, math.floor(tonumber(clip and clip.maxFrame) or minFrame))
	local span = math.max(1, maxFrame - minFrame)
	if clip and clip.kind == "PhysicsClip" then
		local displayName = getPhysicsClipDisplayName(clip)
		-- Rig and folder blocks summarize several independently editable tracks.
		-- Once those tracks are offset, their outer bounds do not represent a
		-- playback-speed change, so only per-track clips should show a percentage.
		if clip.isAggregate == true then
			return width &gt; 64 and displayName or ""
		end
		local sourceSpan = math.max(1, math.floor(tonumber(clip.sourceSpanFrames) or span))
		local speedPercent = (sourceSpan / span) * 100
		if width &gt; 108 and math.abs(speedPercent - 100) &gt;= 0.5 then
			return string.format("%s | %.0f%% speed", displayName, speedPercent)
		end
		return width &gt; 64 and displayName or ""
	end
	if mode == "Stretch" then
		local sourceSpan = math.max(1, math.floor(tonumber(clip and clip.sourceSpanFrames) or span))
		return string.format("Stretch %.0f%%", (span / sourceSpan) * 100)
	end
	if mode == "Repeat" then
		local sourceSpan = math.max(1, math.floor(tonumber(clip and clip.sourceSpanFrames) or span))
		local loops = math.max(1, math.floor((span / sourceSpan) + 0.0001))
		return string.format("Repeat x%d", loops)
	end
	return width &gt; 58 and tostring((clip and clip.name) or ("Group " .. tostring(clip and clip.groupId or ""))) or ""
end

function KeyframeGroupBlockVisualSupport.getWidth(clip, startX, endX)
	local span = math.max(0, (tonumber(endX) or 0) - (tonumber(startX) or 0))
	if clip and clip.kind == "PhysicsClip" then
		return math.max(8, span - 2)
	end
	return math.max(20, span + 18)
end

function KeyframeGroupBlockVisualSupport.attachTimingHandle(config)
	config = config or {}
	local mode = config.mode
	if mode ~= "Stretch" and mode ~= "Repeat" then
		return nil
	end

	local groupId = config.groupId
	local startFrame = math.max(0, math.floor(tonumber(config.startFrame) or 0))
	local endFrame = math.max(startFrame + 1, math.floor(tonumber(config.endFrame) or (startFrame + 1)))
	local sourceSpan = math.max(1, math.floor(tonumber(config.sourceSpanFrames) or (endFrame - startFrame)))
	local onCommit = mode == "Stretch" and config.onStretchGroupToFrame or config.onRepeatGroupToFrame

	return AudioClipVisualSupport.attachStopHandle({
		makeInstance = config.makeInstance,
		parent = config.parent,
		trackPath = tostring(groupId or ""),
		startFrame = startFrame,
		endFrame = endFrame,
		clipWidth = config.clipWidth,
		clipHeight = config.clipHeight,
		visibleStartFrame = config.visibleStartFrame,
		visibleFrameRange = config.visibleFrameRange,
		timelinePixelWidth = config.timelinePixelWidth,
		timelineLayer = config.timelineLayer,
		gutter = config.gutter,
		durationFrames = config.durationFrames,
		statusLabel = config.statusLabel,
		refresh = config.refresh,
		frameFromScreenX = config.frameFromScreenX,
		handleName = "GroupTimingHandle",
		statusPrefix = mode == "Stretch" and "Stretch group" or "Repeat group",
		attributePrefix = "MegMoGroupTiming",
		missingCallbackMessage = "Group timing handle is not connected yet. Restart Studio to load the latest 7kg2 build.",
		onPreviewStopFrame = function(targetFrame, nextWidth, clipHeight)
			if type(config.onPreviewTimingFrame) == "function" then
				config.onPreviewTimingFrame(targetFrame, nextWidth, clipHeight, mode, sourceSpan)
			end
		end,
		onSetStopFrame = function(_unused, _startFrame, targetFrame)
			if type(onCommit) ~= "function" then
				return false, "Group timing handle is not connected yet."
			end
			return onCommit(groupId, targetFrame)
		end,
		zIndex = config.zIndex,
	})
end

return KeyframeGroupBlockVisualSupport
