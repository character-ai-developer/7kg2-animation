function SelectedJointTransformSupport.getSelectedJointTransform(selectedJointPath, timeline)
	if not selectedJointPath then
		return nil
	end

	return timeline:getJointTransform(selectedJointPath)
end

return SelectedJointTransformSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX225">
        <Properties>
          <string name="Name">SelectedKeyAutoUpdateService</string>
          <ProtectedString name="Source">local SelectedKeyAutoUpdateService = {}
SelectedKeyAutoUpdateService.__index = SelectedKeyAutoUpdateService

local UPDATE_INTERVAL_SECONDS = 0.15

local function normalizeFrame(frame)
	return math.max(0, math.floor(tonumber(frame) or 0))
end

local function roundNumber(value)
	return math.floor((tonumber(value) or 0) * 1000 + 0.5) / 1000
end

local function appendValue(parts, value)
	local valueType = typeof(value)
	table.insert(parts, valueType)

	if valueType == "number" then
		table.insert(parts, tostring(roundNumber(value)))
	elseif valueType == "boolean" or valueType == "string" or value == nil then
		table.insert(parts, tostring(value))
	elseif valueType == "CFrame" then
		table.insert(parts, tostring(value.Position))
		local x, y, z = value:ToOrientation()
		table.insert(parts, tostring(roundNumber(x)))
		table.insert(parts, tostring(roundNumber(y)))
		table.insert(parts, tostring(roundNumber(z)))
	elseif valueType == "Vector3" then
		table.insert(parts, tostring(roundNumber(value.X)))
		table.insert(parts, tostring(roundNumber(value.Y)))
		table.insert(parts, tostring(roundNumber(value.Z)))
	elseif valueType == "Color3" then
		table.insert(parts, tostring(roundNumber(value.R)))
		table.insert(parts, tostring(roundNumber(value.G)))
		table.insert(parts, tostring(roundNumber(value.B)))
	elseif type(value) == "table" then
		local keys = {}
		for key in pairs(value) do
			table.insert(keys, key)
		end
		table.sort(keys, function(left, right)
			return tostring(left) &lt; tostring(right)
		end)
		for _, key in ipairs(keys) do
			table.insert(parts, tostring(key))
			appendValue(parts, value[key])
		end
	else
		table.insert(parts, tostring(value))
	end
end

local function getSelectedKeyRefs(deps)
	if deps and type(deps.getSelectedKeyRefs) == "function" then
		return deps.getSelectedKeyRefs() or {}
	end
	return {}
end

local function getSharedFrame(timeline, selectedKeyRefs)
	local sharedFrame = nil
	for _, keyRef in ipairs(selectedKeyRefs) do
		local frame = normalizeFrame(keyRef.frame)
		if sharedFrame == nil then
			sharedFrame = frame
		elseif sharedFrame ~= frame then
			return nil
		end
	end
	if sharedFrame == nil or normalizeFrame(timeline:getCurrentFrame()) ~= sharedFrame then
		return nil
	end
	return sharedFrame
end

local function buildSignatures(timeline, selectedKeyRefs)
	local sharedFrame = getSharedFrame(timeline, selectedKeyRefs)
	if sharedFrame == nil then
		return nil, nil, 0
	end

	local selectionParts = {}
	local valueParts = {}
	local count = 0

	for _, keyRef in ipairs(selectedKeyRefs) do
		local path = keyRef.jointPath or keyRef.path
		if type(path) == "string" and timeline:hasTrackKeyframe(path, sharedFrame) and type(timeline.captureTrackValue) == "function" then
			local success, value = timeline:captureTrackValue(path)
			if success then
				count += 1
				table.insert(selectionParts, path .. "@" .. tostring(sharedFrame))
				table.insert(valueParts, path .. "@" .. tostring(sharedFrame))
				appendValue(valueParts, value)
			end
		end
	end

	if count == 0 then
		return nil, nil, 0
	end

	return table.concat(selectionParts, "|"), table.concat(valueParts, "|"), count
end

function SelectedKeyAutoUpdateService.new(deps)
	return setmetatable({
		_deps = deps or {},
		_lastClock = 0,
		_lastSelectionSignature = nil,
		_lastValueSignature = nil,
	}, SelectedKeyAutoUpdateService)
end

function SelectedKeyAutoUpdateService:Step(now)
	now = now or os.clock()
	if now - self._lastClock &lt; UPDATE_INTERVAL_SECONDS then
		return
	end
	self._lastClock = now

	local deps = self._deps
	if deps.getIsPlaying and deps.getIsPlaying() then
		self._lastSelectionSignature = nil
		self._lastValueSignature = nil
		return
	end

	local timeline = deps.getTimeline and deps.getTimeline() or nil
	if not (timeline and type(timeline.hasTrackKeyframe) == "function" and type(timeline.captureTrackFrameAtFrame) == "function") then
		return
	end

	local selectedKeyRefs = getSelectedKeyRefs(deps)
	if #selectedKeyRefs == 0 then
		self._lastSelectionSignature = nil
		self._lastValueSignature = nil
		return
	end

	local selectionSignature, valueSignature = buildSignatures(timeline, selectedKeyRefs)
	if not selectionSignature or not valueSignature then
		self._lastSelectionSignature = nil
		self._lastValueSignature = nil
		return
	end

	if selectionSignature ~= self._lastSelectionSignature then
		self._lastSelectionSignature = selectionSignature
		self._lastValueSignature = valueSignature
		return
	end

	if valueSignature == self._lastValueSignature then
		return
	end
	self._lastValueSignature = valueSignature

	local changed = false
	for _, keyRef in ipairs(selectedKeyRefs) do
		local path = keyRef.jointPath or keyRef.path
		local frame = normalizeFrame(keyRef.frame)
		if type(path) == "string" and timeline:hasTrackKeyframe(path, frame) then
			local success = timeline:captureTrackFrameAtFrame(path, frame)
			changed = success or changed
		end
	end
	if changed and type(deps.onTimelineChanged) == "function" then
		deps.onTimelineChanged()
	end
end

return SelectedKeyAutoUpdateService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX226">
        <Properties>
          <string name="Name">SelectedKeyMutationSupport</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local SelectedKeyMutationSupport = {}

function SelectedKeyMutationSupport.setSingleSelectedKey(jointPath, frame)
	local nextSelectedKeys = {}
	frame = math.max(0, math.floor(frame or 0))
	nextSelectedKeys[SelectionState.makeTrackKeyId(jointPath, frame)] = {
		jointPath = jointPath,
		frame = frame,
	}
	return nextSelectedKeys, frame, jointPath
end

function SelectedKeyMutationSupport.setSingleSelectedKeyframe(frame, timeline)
	frame = math.max(0, math.floor(frame or 0))
	local nextSelectedKeys = {}
	if timeline and type(timeline.getTrackKeyframesByPath) == "function" then
		for path, frames in pairs(timeline:getTrackKeyframesByPath()) do
			for _, keyFrame in ipairs(frames) do
				if keyFrame == frame then
					nextSelectedKeys[SelectionState.makeTrackKeyId(path, frame)] = {
						jointPath = path,
						frame = frame,
					}
					break
				elseif keyFrame &gt; frame then
					break
				end
			end
		end
	elseif timeline then
		for _, motorData in ipairs(timeline:getMotors()) do
			if timeline:hasTrackKeyframe(motorData.path, frame) then
				nextSelectedKeys[SelectionState.makeTrackKeyId(motorData.path, frame)] = {
					jointPath = motorData.path,
					frame = frame,
				}
			end
		end
	end
	return nextSelectedKeys, frame
end

return SelectedKeyMutationSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX227">
        <Properties>
          <string name="Name">SelectedKeyQuerySupport</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local SelectedKeyQuerySupport = {}

function SelectedKeyQuerySupport.getSelectedKeyRefs(selectedKeys, timeline)
	local normalized = {}
	local normalizedMap = {}

	for _, key in ipairs(SelectionState.getSelectedKeyRefs(selectedKeys)) do
		if timeline:hasTrackKeyframe(key.jointPath, key.frame) then
			local keyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame)
			if not normalizedMap[keyId] then
				normalizedMap[keyId] = {
					jointPath = key.jointPath,
					frame = key.frame,
				}
				table.insert(normalized, normalizedMap[keyId])
			end
		end
	end

	return normalized, normalizedMap
end

function SelectedKeyQuerySupport.getSelectedKeyOptions(selectedKeys, timeline)
	local selectedKeyRefs = SelectedKeyQuerySupport.getSelectedKeyRefs(selectedKeys, timeline)
	local firstKey = selectedKeyRefs[1]
	if not firstKey then
		return {
			easingStyle = Constants.DEFAULT_EASING_STYLE,
			easingDirection = Constants.DEFAULT_EASING_DIRECTION,
		}
	end

	return timeline:getKeyOptions(firstKey.jointPath, firstKey.frame)
end

function SelectedKeyQuerySupport.getSelectedKeyframeFrames(selectedKeys)
	return SelectionState.getSelectedKeyframeFrames(selectedKeys)
end

return SelectedKeyQuerySupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX228">
        <Properties>
          <string name="Name">SelectedKeySetSupport</string>
          <ProtectedString name="Source">local SelectionState = require(script.Parent:WaitForChild("SelectionState"))

local SelectedKeySetSupport = {}

function SelectedKeySetSupport.selectKeys(keys)
	local nextSelectedKeys = {}
	for _, key in ipairs(keys or {}) do
		nextSelectedKeys[SelectionState.makeTrackKeyId(key.jointPath, key.frame)] = {
			jointPath = key.jointPath,
			frame = key.frame,
		}
	end

	local frames = {}
	local seenFrames = {}
	for _, key in pairs(nextSelectedKeys) do
		if not seenFrames[key.frame] then
			seenFrames[key.frame] = true
			table.insert(frames, key.frame)
		end
	end
	SelectionState.sortFrames(frames)
	local nextSelectedKeyframeFrame = frames[#frames]
	local nextSelectedJointPath = nil
	if next(nextSelectedKeys) then
		for _, key in pairs(nextSelectedKeys) do
			nextSelectedJointPath = key.jointPath
			break
		end
	end

	return nextSelectedKeys, nextSelectedKeyframeFrame, nextSelectedJointPath
end

function SelectedKeySetSupport.toggleKeySet(keyList, timeline, selectedKeys)
	local normalized = {}
	local shouldDeselect = true
	for _, key in ipairs(keyList or {}) do
		if timeline:hasTrackKeyframe(key.jointPath, key.frame) then
			local keyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame)
			table.insert(normalized, {
				keyId = keyId,
				jointPath = key.jointPath,
				frame = key.frame,
			})
			if not selectedKeys[keyId] then
				shouldDeselect = false
			end
		end
	end

	if #normalized == 0 then
		return nil, nil, nil, false, 0, false
	end

	local nextSelectedKeys = {}
	for keyId, value in pairs(selectedKeys or {}) do
		nextSelectedKeys[keyId] = {
			jointPath = value.jointPath,
			frame = value.frame,
		}
	end

	for _, key in ipairs(normalized) do
		if shouldDeselect then
			nextSelectedKeys[key.keyId] = nil
		else
			nextSelectedKeys[key.keyId] = {
				jointPath = key.jointPath,
				frame = key.frame,
			}
		end
	end

	local selectedFrames = SelectionState.getSelectedKeyframeFrames(nextSelectedKeys)
	local nextSelectedKeyframeFrame = selectedFrames[#selectedFrames]
	local nextSelectedJointPath = nextSelectedKeyframeFrame and normalized[1].jointPath or nil
	return nextSelectedKeys, nextSelectedKeyframeFrame, nextSelectedJointPath, shouldDeselect, #normalized, true
end

function SelectedKeySetSupport.selectKeysInBox(keyList, timeline, selectedKeys)
	local nextSelectedKeys = {}
	for keyId, value in pairs(selectedKeys or {}) do
		nextSelectedKeys[keyId] = {
			jointPath = value.jointPath,
			frame = value.frame,
		}
	end

	local selectedCount = 0
	local firstSelectedJointPath = nil
	for _, key in ipairs(keyList or {}) do
		if timeline:hasTrackKeyframe(key.jointPath, key.frame) then
			local keyId = SelectionState.makeTrackKeyId(key.jointPath, key.frame)
			nextSelectedKeys[keyId] = {
				jointPath = key.jointPath,
				frame = key.frame,
			}
			firstSelectedJointPath = firstSelectedJointPath or key.jointPath
			selectedCount += 1
		end
	end

	local selectedFrames = SelectionState.getSelectedKeyframeFrames(nextSelectedKeys)
	local nextSelectedKeyframeFrame = selectedFrames[#selectedFrames]
	if nextSelectedKeyframeFrame and not firstSelectedJointPath then
		for _, key in pairs(nextSelectedKeys) do
			firstSelectedJointPath = key.jointPath
			break
		end
	end

	return nextSelectedKeys, nextSelectedKeyframeFrame, firstSelectedJointPath, selectedCount
end

return SelectedKeySetSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX229">
        <Properties>
          <string name="Name">SelectedKeyTrackSyncSupport</string>
          <ProtectedString name="Source">local SelectedKeyTrackSyncSupport = {}

function SelectedKeyTrackSyncSupport.sync(timeline, selectedKeys, preferredJointPath)
	local selectedTrackPaths = {}
	local selectedJointPath = nil

	for _, key in pairs(selectedKeys or {}) do
		local path = key and key.jointPath
		if type(path) == "string" and timeline and type(timeline.getTrackByPath) == "function" and timeline:getTrackByPath(path) then
			selectedTrackPaths[path] = true
			if path == preferredJointPath then
				selectedJointPath = path
			elseif not selectedJointPath then
				selectedJointPath = path
			end
		end
	end

	return selectedTrackPaths, selectedJointPath
end

return SelectedKeyTrackSyncSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX230">
        <Properties>
          <string name="Name">SelectedTrackPathSupport</string>
          <ProtectedString name="Source">local SelectedTrackPathSupport = {}

function SelectedTrackPathSupport.getSelectedTrackPaths(timeline, selectedTrackPaths)
	local selected = {}
	local selectedMap = selectedTrackPaths or {}

	for _, track in ipairs(timeline:getTracks()) do
		if selectedMap[track.path] and timeline:getTrackByPath(track.path) then
			table.insert(selected, track.path)
		end
	end

	return selected
end

return SelectedTrackPathSupport
