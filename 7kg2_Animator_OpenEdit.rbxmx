        <Item class="ModuleScript" referent="RBX105">
          <Properties>
            <string name="Name">ScriptUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local ScriptUI = {}

local create = UiHelpers.create
local createCard = UiHelpers.createCard
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createMetaLabel = UiHelpers.createMetaLabel
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local applyPanelSurface = UiHelpers.applyPanelSurface
local applySectionSurface = UiHelpers.applySectionSurface

local function makePanel(parent, title, description, position, size, descriptionHeight)
	local panel = create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
	})
	applySectionSurface(panel)
	createCorner(panel, 12)
	createStroke(panel)

	create("TextLabel", {
		Parent = panel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 14, 0, 12),
		Size = UDim2.new(1, -28, 0, 20),
		Text = title,
		TextColor3 = Constants.THEME.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local meta = createMetaLabel(panel, description, 34)
	meta.Position = UDim2.new(0, 14, 0, 36)
	meta.Size = UDim2.new(1, -28, 0, descriptionHeight or 36)
	meta.TextWrapped = true

	return panel
end

local function makeButton(parent, text, position, size, accent)
	local button = create("TextButton", {
		Parent = parent,
		Position = position,
		Size = size or UDim2.new(0, 170, 0, 34),
		Text = text,
	})
	if accent then
		styleTextButton(button, accent)
	else
		styleGhostButton(button)
	end
	createCorner(button, 10)
	return button
end

local function makeInput(parent, text, placeholder, position, size)
	local input = create("TextBox", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		PlaceholderColor3 = Constants.THEME.MutedText,
		PlaceholderText = placeholder or "",
		Position = position,
		Size = size,
		Text = text or "",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	input.ClipsDescendants = true
	createCorner(input, 9)
	createStroke(input)
	create("UIPadding", {
		Parent = input,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	return input
end

local function makeOptionButton(parent, label, position, size)
	local button = makeButton(parent, label, position, size or UDim2.new(1, -28, 0, 30))
	button.TextSize = 11
	return button
end

local function makeBullet(parent, order, text, height)
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, height or 22),
		Text = "- " .. text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
end

local function findOptionIndex(options, id)
	for index, option in ipairs(options) do
		if option.id == id then
			return index
		end
	end
	return 1
end

local function selectedLabel(options, id)
	return options[findOptionIndex(options, id)].label
end

local function selectedDetail(options, id, fallback)
	local option = options[findOptionIndex(options, id)]
	return (option and option.detail) or fallback or ""
end

