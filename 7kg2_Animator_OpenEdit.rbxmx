connect(refs.eventPowerDragCapture.InputChanged, function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		state.eventActions.ContinuePowerDrag(input.Position.X)
	end
end)
