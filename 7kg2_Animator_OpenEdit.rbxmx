        <Properties>
          <string name="Name">OnionSkinPreviewSupport</string>
          <ProtectedString name="Source">local OnionSkinPreviewSupport = {}

function OnionSkinPreviewSupport.update(widgetController, timeline, playbackService, frame, force)
	if not widgetController._onionSkinService then
		return
	end

	widgetController._onionSkinService:update(timeline, {
		enabled = widgetController._onionSkinEnabled == true,
		frame = frame or timeline:getCurrentFrame(),
		frameStep = widgetController._onionSkinFrameStep or 5,
		force = force == true,
		isPlaying = playbackService and playbackService:getIsPlaying() or false,
	})
end

return OnionSkinPreviewSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX181">
        <Properties>
          <string name="Name">OnionSkinService</string>
          <ProtectedString name="Source">local RigService = require(script.Parent:WaitForChild("RigService"))

local OnionSkinService = {}
OnionSkinService.__index = OnionSkinService

local FOLDER_NAME = "MegMoAnimatorOnionSkins"
local GHOST_PART_TRANSPARENCY = 0.9

local SLOT_CONFIG = {
	Previous = {
		color = Color3.fromRGB(255, 64, 64),
		prefix = "Prev",
	},
	Next = {
		color = Color3.fromRGB(255, 64, 64),
		prefix = "Next",
	},
}

local function getFolder()
	local folder = workspace:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = workspace
	end
	return folder
end

local function safeSet(instance, propertyName, value)
	pcall(function()
		instance[propertyName] = value
	end)
end

local function shouldHideGhostPart(part)
	if not part or not part:IsA("BasePart") then
		return false
	end
	if part.Name == "HumanoidRootPart" then
		return true
	end
	return (tonumber(part.Transparency) or 0) &gt;= 1
end

local function styleGhostModel(model, color)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
			if shouldHideGhostPart(descendant) then
				descendant.Transparency = 1
			else
				descendant.Color = color
				descendant.Material = Enum.Material.Neon
				descendant.Transparency = GHOST_PART_TRANSPARENCY
			end
		elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
			safeSet(descendant, "Transparency", 1)
		elseif descendant:IsA("BillboardGui") or descendant:IsA("SurfaceGui") then
			descendant.Enabled = false
		elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
			descendant:Destroy()
		elseif descendant:IsA("Humanoid") then
			safeSet(descendant, "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None)
		end
	end
end

local function getGhostKey(rig, slotName)
	return tostring(rig and rig.Name or "") .. ":" .. tostring(slotName)
end

local function cloneRig(rig, slotName)
	if not rig or not rig.Parent then
		return nil
	end

	local wasArchivable = rig.Archivable
	rig.Archivable = true
	local ok, cloneOrMessage = pcall(function()
		return rig:Clone()
	end)
	rig.Archivable = wasArchivable

	if not ok or not cloneOrMessage then
		warn("[7kg2 OnionSkin] Could not clone rig:", cloneOrMessage)
		return nil
	end

	local config = SLOT_CONFIG[slotName] or SLOT_CONFIG.Previous
	local clone = cloneOrMessage
	clone.Name = string.format("Onion_%s_%s", config.prefix or slotName, rig.Name)
	clone:SetAttribute("MegMoOnionKey", getGhostKey(rig, slotName))
	styleGhostModel(clone, config.color)
	clone.Parent = getFolder()

	local description = RigService.describeRig(clone)
	return {
		model = clone,
		motors = description.motors or {},
		slotName = slotName,
		rigName = rig.Name,
	}
end

local function resolveNeighborKeyframe(timeline, frame, slotName, fallbackFrame)
	if timeline and type(timeline.getKeyframeFrames) == "function" then
		local frames = timeline:getKeyframeFrames()
		if slotName == "Previous" then
			for index = #frames, 1, -1 do
				local keyFrame = tonumber(frames[index])
				if keyFrame and keyFrame &lt; frame then
					return keyFrame
				end
			end
		else
			for _, keyFrameValue in ipairs(frames) do
				local keyFrame = tonumber(keyFrameValue)
				if keyFrame and keyFrame &gt; frame then
					return keyFrame
				end
			end
		end
	end
	return fallbackFrame
end

function OnionSkinService.new()
	return setmetatable({
		ghosts = {},
		lastSignature = "",
		lastFrameKey = nil,
		lastEnabled = false,
	}, OnionSkinService)
end

function OnionSkinService:_getRigSignature(timeline)
	local names = {}
	if timeline and timeline.getRigs then
		for _, rig in ipairs(timeline:getRigs()) do
			if rig and rig.Parent then
				table.insert(names, rig.Name)
			end
		end
	end
	table.sort(names)
	return table.concat(names, "|")
end

function OnionSkinService:clear()
	for _, ghost in pairs(self.ghosts) do
		if ghost.model then
			ghost.model:Destroy()
		end
	end
	self.ghosts = {}
	self.lastSignature = ""
	self.lastFrameKey = nil
	self.lastEnabled = false

	local folder = workspace:FindFirstChild(FOLDER_NAME)
	if folder and #folder:GetChildren() == 0 then
		folder:Destroy()
	end
end

function OnionSkinService:_ensureGhost(rig, slotName)
	local key = getGhostKey(rig, slotName)
	local ghost = self.ghosts[key]
	if ghost and ghost.model and ghost.model.Parent ~= nil then
		return ghost
	end
	if ghost and ghost.model and ghost.model.Parent == nil then
		ghost.model.Parent = getFolder()
		return ghost
	end

	local folder = getFolder()
	for _, child in ipairs(folder:GetChildren()) do
		if child:GetAttribute("MegMoOnionKey") == key then
			child:Destroy()
		end
	end
	ghost = cloneRig(rig, slotName)
	self.ghosts[key] = ghost
	return ghost
end

function OnionSkinService:_hideGhost(ghost)
	if ghost and ghost.model then
		ghost.model.Parent = nil
	end
end

function OnionSkinService:_showGhost(ghost)
	if ghost and ghost.model and ghost.model.Parent == nil then
		ghost.model.Parent = getFolder()
	end
end

function OnionSkinService:_applyGhostFrame(timeline, rig, slotName, frame)
	local durationFrames = timeline:getDurationFrames()
	local key = getGhostKey(rig, slotName)
	if frame == nil or frame &lt; 0 or frame &gt; durationFrames then
		local hiddenGhost = self.ghosts[key]
		self:_hideGhost(hiddenGhost)
		return false
	end

	local pose = timeline:samplePose(frame)
	if not pose then
		local hiddenGhost = self.ghosts[key]
		self:_hideGhost(hiddenGhost)
		return false
	end

	local ghost = self:_ensureGhost(rig, slotName)
	if not ghost then
		return false
	end

	self:_showGhost(ghost)
	local rigCFrameTrack = timeline:getRigPropertyTrack(rig.Name, "CFrame")
	local rigCFrame = rigCFrameTrack and pose[rigCFrameTrack.path]
	if typeof(rigCFrame) == "CFrame" then
		ghost.model:PivotTo(rigCFrame)
	else
		ghost.model:PivotTo(rig:GetPivot())
	end
	RigService.applyPose(ghost.motors, pose)
	return true
end

function OnionSkinService:update(timeline, options)
	options = options or {}
	if not timeline or options.enabled ~= true or options.isPlaying == true then
		self:clear()
		return
	end

	local frame = tonumber(options.frame) or timeline:getCurrentFrame()
	local step = math.max(1, math.floor(tonumber(options.frameStep) or 5))
	local frameKey = string.format("%.3f:%d", frame, step)
	local signature = self:_getRigSignature(timeline)
	if signature == "" then
		self:clear()
		return
	end

	if options.force ~= true and self.lastEnabled and self.lastSignature == signature and self.lastFrameKey == frameKey then
		return
	end

	if self.lastSignature ~= "" and self.lastSignature ~= signature then
		self:clear()
	end

	self.lastSignature = signature
	self.lastFrameKey = frameKey
	self.lastEnabled = true
	local activeKeys = {}

	for _, rig in ipairs(timeline:getRigs()) do
		if rig and rig.Parent then
			activeKeys[tostring(rig.Name) .. ":Previous"] = true
			activeKeys[tostring(rig.Name) .. ":Next"] = true
			self:_applyGhostFrame(
				timeline,
				rig,
				"Previous",
				resolveNeighborKeyframe(timeline, frame, "Previous", frame - step)
			)
			self:_applyGhostFrame(
				timeline,
				rig,
				"Next",
				resolveNeighborKeyframe(timeline, frame, "Next", frame + step)
			)
		end
	end

	local folder = workspace:FindFirstChild(FOLDER_NAME)
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			local key = child:GetAttribute("MegMoOnionKey")
			if key and not activeKeys[key] then
				child:Destroy()
			end
		end
		if #folder:GetChildren() == 0 then
			folder:Destroy()
		end
	end
end

return OnionSkinService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX182">
        <Properties>
          <string name="Name">ParticleEmitterGroupService</string>
          <ProtectedString name="Source">local ParticleEmitterPropertyService = require(script.Parent:WaitForChild("ParticleEmitterPropertyService"))

local ParticleEmitterGroupService = {}

local SNAPSHOT_TYPE = "EmitterGroupPropertySnapshot"

local function getInstancePath(instance)
	if not instance then
		return ""
	end

	local names = {}
	local current = instance
	while current and current ~= game do
		table.insert(names, 1, current.Name)
		current = current.Parent
	end
	return table.concat(names, ".")
end

local function sortEmitters(emitters)
	table.sort(emitters, function(a, b)
		return getInstancePath(a) &lt; getInstancePath(b)
	end)
	return emitters
end

function ParticleEmitterGroupService.collectEmitters(container)
	local emitters = {}
	if not container or not container.Parent then
		return emitters
	end

	if container:IsA("ParticleEmitter") then
		table.insert(emitters, container)
	end

	for _, descendant in ipairs(container:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			table.insert(emitters, descendant)
		end
	end

	return sortEmitters(emitters)
end

function ParticleEmitterGroupService.getEmitterCount(container)
	return #ParticleEmitterGroupService.collectEmitters(container)
end

function ParticleEmitterGroupService.isEmitterGroupTrack(track)
	return track ~= nil and (track.trackType == "Emitter Group" or track.targetScope == "EmitterGroup")
end

function ParticleEmitterGroupService.isEmitterGroupPropertyTrack(track)
	return track ~= nil and track.targetScope == "EmitterGroupProperty"
end

function ParticleEmitterGroupService.isEmitterGroupLikeTrack(track)
	return ParticleEmitterGroupService.isEmitterGroupTrack(track)
		or ParticleEmitterGroupService.isEmitterGroupPropertyTrack(track)
end

function ParticleEmitterGroupService.getTrackEmitters(track)
	if not track then
		return {}
	end

	local emitters = {}
	if type(track.emitters) == "table" then
		for _, emitter in ipairs(track.emitters) do
			if ParticleEmitterPropertyService.isParticleEmitter(emitter) then
				table.insert(emitters, emitter)
			end
		end
	end

	if #emitters == 0 then
		emitters = ParticleEmitterGroupService.collectEmitters(track.instance)
	end

	return sortEmitters(emitters)
end

function ParticleEmitterGroupService.getFirstProperty(track, propertyName)
	for _, emitter in ipairs(ParticleEmitterGroupService.getTrackEmitters(track)) do
		local value = ParticleEmitterPropertyService.getProperty(emitter, propertyName)
		if value ~= nil then
			return value
		end
	end
	return nil
end

function ParticleEmitterGroupService.capturePropertySnapshot(track, propertyName)
	local snapshot = {
		type = SNAPSHOT_TYPE,
		propertyName = propertyName,
		values = {},
	}

	for _, emitter in ipairs(ParticleEmitterGroupService.getTrackEmitters(track)) do
		local value = ParticleEmitterPropertyService.getProperty(emitter, propertyName)
		if value ~= nil then
			table.insert(snapshot.values, {
				path = getInstancePath(emitter),
				name = emitter.Name,
				value = value,
			})
		end
	end

	return snapshot
end

local function findEmitterBySnapshotEntry(track, entry, emitters)
	local wantedPath = tostring(entry and entry.path or "")
	if wantedPath ~= "" then
		for _, emitter in ipairs(emitters) do
			if getInstancePath(emitter) == wantedPath then
				return emitter
			end
		end
	end

	local wantedName = tostring(entry and entry.name or "")
	if wantedName ~= "" then
		for _, emitter in ipairs(emitters) do
			if emitter.Name == wantedName then
				return emitter
			end
		end
	end

	return nil
end

function ParticleEmitterGroupService.applyProperty(track, propertyName, value)
	local emitters = ParticleEmitterGroupService.getTrackEmitters(track)
	if #emitters == 0 then
		return false, 0
	end

	local changed = 0
	if type(value) == "table" and value.type == SNAPSHOT_TYPE and type(value.values) == "table" then
		for _, entry in ipairs(value.values) do
			local emitter = findEmitterBySnapshotEntry(track, entry, emitters)
			if emitter and ParticleEmitterPropertyService.applyProperty(emitter, propertyName, entry.value) then
				changed += 1
			end
		end
		return changed &gt; 0, changed
	end

	for _, emitter in ipairs(emitters) do
		if ParticleEmitterPropertyService.applyProperty(emitter, propertyName, value) then
			changed += 1
		end
	end

	return changed &gt; 0, changed
end

function ParticleEmitterGroupService.runAction(track, actionName, payload)
	local emitters = ParticleEmitterGroupService.getTrackEmitters(track)
	if #emitters == 0 then
		return false, 0
	end

	actionName = tostring(actionName or "")
	payload = type(payload) == "table" and payload or {}
	local changed = 0
	if actionName == "Emit" then
		local emitCount = math.max(1, math.floor(tonumber(payload.emitCount or payload.count) or 10))
		for _, emitter in ipairs(emitters) do
			local wasEnabled = emitter.Enabled == true
			local success = pcall(function()
				emitter:Emit(emitCount)
			end)
			pcall(function()
				emitter.Enabled = wasEnabled
			end)
			if success then
				changed += 1
			end
		end
	elseif actionName == "Clear" then
		for _, emitter in ipairs(emitters) do
			local success = pcall(function()
				emitter:Clear()
			end)
			if success then
				changed += 1
			end
		end
	end

	return changed &gt; 0, changed
end

function ParticleEmitterGroupService.getDisplayName(container)
	local count = ParticleEmitterGroupService.getEmitterCount(container)
	local baseName = container and container.Name or "Emitter Group"
	return string.format("%s Emitters (%d)", baseName, count)
end

return ParticleEmitterGroupService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX183">
        <Properties>
          <string name="Name">ParticleEmitterPropertyService</string>
          <ProtectedString name="Source">local ParticleEmitterPropertyService = {}

ParticleEmitterPropertyService.PROPERTY_OPTIONS = {
	"Emit",
	"Enabled",
	"Size",
	"Color",
	"Transparency",
	"Brightness",
	"Clear",
	"Speed",
	"Squash",
	"Shape",
	"ShapeInOut",
	"ShapeStyle",
	"TimeScale",
	"Rate",
	"Drag",
	"Lifetime",
	"Rotation",
	"RotSpeed",
	"LightEmission",
	"LightInfluence",
	"Texture",
	"EmissionDirection",
	"SpreadAngle",
	"Acceleration",
	"VelocityInheritance",
	"ZOffset",
	"LockedToPart",
}

ParticleEmitterPropertyService.SORT_ORDERS = {}
for index, propertyName in ipairs(ParticleEmitterPropertyService.PROPERTY_OPTIONS) do
	ParticleEmitterPropertyService.SORT_ORDERS[propertyName] = index
end

local PROPERTY_KINDS = {
	Enabled = "boolean",
	Size = "numberSequence",
	Color = "colorSequence",
	Transparency = "numberSequence",
	Brightness = "number",
	Speed = "numberRange",
	Squash = "numberSequence",
	Shape = "enum",
	ShapeInOut = "enum",
	ShapeStyle = "enum",
	TimeScale = "number",
	Rate = "number",
	Drag = "number",
	Lifetime = "numberRange",
	Rotation = "numberRange",
	RotSpeed = "numberRange",
	LightEmission = "number",
	LightInfluence = "number",
	Texture = "string",
	EmissionDirection = "enum",
	SpreadAngle = "vector2",
	Acceleration = "vector3",
	VelocityInheritance = "number",
	ZOffset = "number",
	LockedToPart = "boolean",
}

local TRACKABLE_PROPERTIES = {}
for _, propertyName in ipairs(ParticleEmitterPropertyService.PROPERTY_OPTIONS) do
	TRACKABLE_PROPERTIES[propertyName] = true
end

-- These are one-shot methods rather than stable timeline properties.
TRACKABLE_PROPERTIES.Emit = false
TRACKABLE_PROPERTIES.Clear = false

local ONE_SHOT_ACTIONS = {
	Emit = true,
	Clear = true,
}

local DISPLAY_LABELS = {
	Emit = "Emit (burst event soon)",
	Clear = "Clear (event soon)",
}

function ParticleEmitterPropertyService.isParticleEmitter(instance)
	return instance ~= nil and instance.Parent ~= nil and instance:IsA("ParticleEmitter")
end

function ParticleEmitterPropertyService.isTrackableProperty(propertyName)
	return TRACKABLE_PROPERTIES[tostring(propertyName or "")] == true
end

function ParticleEmitterPropertyService.isOneShotAction(propertyName)
	return ONE_SHOT_ACTIONS[tostring(propertyName or "")] == true
end

function ParticleEmitterPropertyService.getDisplayLabel(propertyName)
	return DISPLAY_LABELS[propertyName] or propertyName
end

function ParticleEmitterPropertyService.getValueKind(propertyName)
	return PROPERTY_KINDS[tostring(propertyName or "")] or "string"
end

function ParticleEmitterPropertyService.getInputLabel(propertyName)
	local kind = ParticleEmitterPropertyService.getValueKind(propertyName)
	if kind == "boolean" then
		return "Boolean"
	elseif kind == "colorSequence" then
		return "Color (R,G,B)"
	elseif kind == "numberSequence" or kind == "number" then
		return "Number"
	elseif kind == "numberRange" then
		return "Range (Min,Max)"
	elseif kind == "vector2" then
		return "Vector2 (X,Y)"
	elseif kind == "vector3" then
		return "Vector3 (X,Y,Z)"
	elseif kind == "enum" then
		return "Option Name"
	end
	return "Value"
end

local function trim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function splitNumbers(text)
	local values = {}
	for token in tostring(text or ""):gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value ~= nil then
			table.insert(values, value)
		end
	end
	return values
end

local function formatNumber(value)
	value = tonumber(value) or 0
	local text = string.format("%.3f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text
end

local function firstNumberSequenceValue(value)
	if typeof(value) == "NumberSequence" and value.Keypoints[1] then
		return value.Keypoints[1].Value
	end
	return 0
end

local function firstColorSequenceValue(value)
	if typeof(value) == "ColorSequence" and value.Keypoints[1] then
		return value.Keypoints[1].Value
	end
	return Color3.new(1, 1, 1)
end

function ParticleEmitterPropertyService.formatValue(value, propertyName)
	local kind = ParticleEmitterPropertyService.getValueKind(propertyName)
	if kind == "boolean" then
		return value == true and "true" or "false"
	elseif kind == "number" then
		return formatNumber(value)
	elseif kind == "numberSequence" then
		return formatNumber(firstNumberSequenceValue(value))
	elseif kind == "colorSequence" then
		local color = firstColorSequenceValue(value)
		return string.format(
			"%d,%d,%d",
			math.floor(color.R * 255 + 0.5),
			math.floor(color.G * 255 + 0.5),
			math.floor(color.B * 255 + 0.5)
		)
	elseif kind == "numberRange" and typeof(value) == "NumberRange" then
		return formatNumber(value.Min) .. "," .. formatNumber(value.Max)
	elseif kind == "vector2" and typeof(value) == "Vector2" then
		return formatNumber(value.X) .. "," .. formatNumber(value.Y)
	elseif kind == "vector3" and typeof(value) == "Vector3" then
		return formatNumber(value.X) .. "," .. formatNumber(value.Y) .. "," .. formatNumber(value.Z)
	elseif kind == "enum" and typeof(value) == "EnumItem" then
		return value.Name
	end
	return tostring(value or "")
end

local function parseBoolean(text, booleanValue)
	if type(booleanValue) == "boolean" then
		return booleanValue
	end
	local normalized = string.lower(trim(text))
	return normalized == "true" or normalized == "1" or normalized == "yes" or normalized == "on" or normalized == "enabled"
end

local function parseEnum(text, referenceValue)
	local enumName = trim(text)
	if enumName == "" then
		return referenceValue
	end

	if typeof(referenceValue) == "EnumItem" then
		local enumType
		pcall(function()
			enumType = referenceValue.EnumType
		end)
		if enumType then
			local success, enumItem = pcall(function()
				return enumType[enumName]
			end)
			if success and enumItem then
				return enumItem
			end
		end
	end
	return referenceValue
end

function ParticleEmitterPropertyService.parseInput(propertyName, text, referenceValue, booleanValue)
	local kind = ParticleEmitterPropertyService.getValueKind(propertyName)
	local numbers = splitNumbers(text)

	if kind == "boolean" then
		return true, parseBoolean(text, booleanValue)
	elseif kind == "number" then
		local number = tonumber(trim(text))
		if number == nil then
			return false, "Enter a number."
		end
		return true, number
	elseif kind == "numberSequence" then
		local number = tonumber(trim(text))
		if number == nil then
			return false, "Enter a number."
		end
		return true, NumberSequence.new(number)
	elseif kind == "colorSequence" then
		if #numbers &lt; 3 then
			return false, "Enter color as R,G,B."
		end
		return true, ColorSequence.new(Color3.fromRGB(
			math.clamp(math.floor(numbers[1] + 0.5), 0, 255),
			math.clamp(math.floor(numbers[2] + 0.5), 0, 255),
			math.clamp(math.floor(numbers[3] + 0.5), 0, 255)
		))
	elseif kind == "numberRange" then
		if #numbers == 0 then
			return false, "Enter a number or Min,Max."
		end
		return true, NumberRange.new(numbers[1], numbers[2] or numbers[1])
	elseif kind == "vector2" then
		if #numbers &lt; 2 then
			return false, "Enter X,Y."
		end
		return true, Vector2.new(numbers[1], numbers[2])
	elseif kind == "vector3" then
		if #numbers &lt; 3 then
			return false, "Enter X,Y,Z."
		end
		return true, Vector3.new(numbers[1], numbers[2], numbers[3])
	elseif kind == "enum" then
		return true, parseEnum(text, referenceValue)
	end

	return true, trim(text)
end

function ParticleEmitterPropertyService.getProperty(instance, propertyName)
	if not ParticleEmitterPropertyService.isParticleEmitter(instance) then
		return nil
	end
	if not ParticleEmitterPropertyService.isTrackableProperty(propertyName) then
		return nil
	end

	local success, value = pcall(function()
		return instance[propertyName]
	end)
	if success then
		return value
	end
	return nil
end

function ParticleEmitterPropertyService.applyProperty(instance, propertyName, value)
	if not ParticleEmitterPropertyService.isParticleEmitter(instance) then
		return false
	end
	if not ParticleEmitterPropertyService.isTrackableProperty(propertyName) then
		return false
	end

	return pcall(function()
		instance[propertyName] = value
	end)
end

return ParticleEmitterPropertyService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX184">
        <Properties>
          <string name="Name">ParticleKeyframeEditorController</string>
          <ProtectedString name="Source">local Constants = require(script.Parent:WaitForChild("Constants"))
local ParticleEmitterPropertyService = require(script.Parent:WaitForChild("ParticleEmitterPropertyService"))
local ParticleEmitterGroupService = require(script.Parent:WaitForChild("ParticleEmitterGroupService"))
local TrackEasingOptionsSupport = require(script.Parent:WaitForChild("TrackEasingOptionsSupport"))
local UiHelpers = require(script.Parent:WaitForChild("UiHelpers"))
local UiMotion = require(script.Parent:WaitForChild("UiMotion"))

local ParticleKeyframeEditorController = {}

local UserInputService = game:GetService("UserInputService")

local PRESET_COLORS = {
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(0, 0, 0),
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(255, 230, 70),
	Color3.fromRGB(85, 220, 120),
	Color3.fromRGB(70, 210, 255),
	Color3.fromRGB(80, 130, 255),
	Color3.fromRGB(170, 90, 255),
	Color3.fromRGB(255, 95, 180),
}

local function parseRgbText(text)
	local values = {}
	for token in tostring(text or ""):gmatch("[^,%s]+") do
		local value = tonumber(token)
		if value then
			table.insert(values, value)
		end
	end
	if #values &lt; 3 then
		return nil
	end
	return Color3.fromRGB(
		math.clamp(math.floor(values[1] + 0.5), 0, 255),
		math.clamp(math.floor(values[2] + 0.5), 0, 255),
		math.clamp(math.floor(values[3] + 0.5), 0, 255)
	)
end

local function formatColor(color)
	return string.format(
		"%d,%d,%d",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function getCurrentTrack(host)
	return host:_getTrackViewModel(host._activeParticlePropertyTrackPath)
end

local function getSelectedParticleKeyValue(host, track)
	local trackPath = track and track.path
	local viewModel = host._lastViewModel or {}
	for _, key in ipairs(viewModel.selectedKeyValues or {}) do
		if key.jointPath == trackPath then
			return key.value, key.frame
		end
	end

	if track and not ParticleKeyframeEditorController.isParticleEventTrack(track) then
		local propertyName = track.propertyName or track.name
		if ParticleEmitterGroupService.isEmitterGroupPropertyTrack(track) then
			return ParticleEmitterGroupService.getFirstProperty(track, propertyName), viewModel.currentFrame
		elseif ParticleEmitterPropertyService.isParticleEmitter(track.instance) then
			return ParticleEmitterPropertyService.getProperty(track.instance, propertyName), viewModel.currentFrame
		end
	end

	return nil, viewModel.currentFrame
end

local function updateBooleanButton(host)
	if not host._particleKeyframeEditorBooleanButton then
		return
	end

	host._particleKeyframeEditorBooleanButton.Text = "Boolean: "
		.. (host._particleEditorBooleanValue and "true" or "false")
	host._particleKeyframeEditorBooleanButton.BackgroundColor3 = host._particleEditorBooleanValue
		and Constants.THEME.Success
		or Constants.THEME.PanelSoft
end

local function updateColorSwatch(host)
	if not host._particleKeyframeEditorColorSwatch then
		return
	end

	local color = parseRgbText(host._particleKeyframeEditorValueInput and host._particleKeyframeEditorValueInput.Text or "")
	host._particleKeyframeEditorColorSwatch.Visible = color ~= nil
	if color then
		host._particleKeyframeEditorColorSwatch.BackgroundColor3 = color
	end
end

local function applyEditorValue(host, callbacks)
	if not callbacks.onSetParticleEmitterPropertyKey then
		return
	end

	callbacks.onSetParticleEmitterPropertyKey(
		host._activeParticlePropertyTrackPath,
		host._particleKeyframeEditorValueInput and host._particleKeyframeEditorValueInput.Text or "",
		host._particleEditorBooleanValue
	)
	host._particleEditorBooleanDirty = false
end

local function refreshEasingPanel(host)
	local overlay = host._particleKeyframeEditorOverlay
	local card = overlay and overlay:FindFirstChild("ParticleKeyframeEditorCard")
	if not card then
		return
	end
	card.Size = UDim2.new(0, 430, 0, 430)
	TrackEasingOptionsSupport.ensurePanel(host, {
		prefix = "particleKeyframeEditor",
		card = card,
		create = UiHelpers.create,
		createCorner = UiHelpers.createCorner,
		createStroke = UiHelpers.createStroke,
		position = UDim2.new(0, 18, 0, 304),
		size = UDim2.new(1, -36, 0, 68),
		zIndex = 132,
	})
	TrackEasingOptionsSupport.updatePanel(host, "particleKeyframeEditor")
	if host._particleKeyframeEditorCallbacks then
		TrackEasingOptionsSupport.connectPanel(host, host._particleKeyframeEditorCallbacks, "particleKeyframeEditor", function()
			ParticleKeyframeEditorController.render(host)
		end)
	end
end

function ParticleKeyframeEditorController.isParticleEventTrack(track)
	return track ~= nil and (track.trackType == "Particle Event" or track.targetScope == "ParticleEvent")
end

function ParticleKeyframeEditorController.isParticlePropertyTrack(track)
	local isSingleEmitterProperty = track ~= nil
		and track.trackType == "Object Property"
		and track.targetScope == "ObjectProperty"
		and track.instance ~= nil
		and track.instance.Parent ~= nil
		and track.instance:IsA("ParticleEmitter")
	local isGroupProperty = ParticleEmitterGroupService.isEmitterGroupPropertyTrack(track)
	local isParticleEvent = ParticleKeyframeEditorController.isParticleEventTrack(track)
	return isParticleEvent or ((isSingleEmitterProperty or isGroupProperty)
		and ParticleEmitterPropertyService.isTrackableProperty(track.propertyName)
	)
end

function ParticleKeyframeEditorController.show(host, trackPath)
	if not host._particleKeyframeEditorOverlay then
		return
	end

	host._activeParticlePropertyTrackPath = trackPath
	host._particleEditorBooleanDirty = false
	ParticleKeyframeEditorController.render(host)
	UiMotion.popupIn(host._particleKeyframeEditorOverlay)
	host:_setShortcutHint("Particle keyframe editor open: adjust the value, then Apply Keyframe")
end

function ParticleKeyframeEditorController.hide(host)
	if host._particleKeyframeEditorOverlay then
		UiMotion.popupOut(host._particleKeyframeEditorOverlay)
	end
	host._activeParticlePropertyTrackPath = nil
	host._particleEditorBooleanDirty = false
end

function ParticleKeyframeEditorController.render(host)
	if not host._particleKeyframeEditorOverlay then
		return
	end

	local track = getCurrentTrack(host)
	if not ParticleKeyframeEditorController.isParticlePropertyTrack(track) then
		if host._particleKeyframeEditorItemLabel then
			host._particleKeyframeEditorItemLabel.Text = "Track: ParticleEmitter"
		end
		if host._particleKeyframeEditorHelpLabel then
			host._particleKeyframeEditorHelpLabel.Text = "Select a ParticleEmitter property keyframe first."
		end
		return
	end

	local propertyName = track.propertyName or track.name or "Property"
	local isParticleEvent = ParticleKeyframeEditorController.isParticleEventTrack(track)
	local actionName = track.eventName or propertyName
	local valueKind = ParticleEmitterPropertyService.getValueKind(propertyName)
	local value, frame = getSelectedParticleKeyValue(host, track)
	local focusedTextBox = UserInputService:GetFocusedTextBox()

	if isParticleEvent then
		valueKind = "particleEvent"
		if type(value) ~= "table" then
			value = {
				actionName = actionName,
				emitCount = actionName == "Emit" and 10 or nil,
			}
		end
	end

	if host._particleKeyframeEditorItemLabel then
		host._particleKeyframeEditorItemLabel.Text = string.format("%s: %s", tostring(track.parentTrackName or "ParticleEmitter"), tostring(actionName or propertyName))
	end
	if host._particleKeyframeEditorHelpLabel then
		host._particleKeyframeEditorHelpLabel.Text = isParticleEvent
			and string.format("Editing frame %s. This event fires once during playback when the playhead crosses it.", tostring(frame or 0))
			or string.format("Editing frame %s. This writes a %s keyframe, not a new object track.", tostring(frame or 0), tostring(propertyName))
	end
	if host._particleKeyframeEditorValueLabel then
		host._particleKeyframeEditorValueLabel.Text = isParticleEvent
			and (actionName == "Emit" and "Emit Count" or "Clear Event")
			or ParticleEmitterPropertyService.getInputLabel(propertyName)
	end
	if host._particleKeyframeEditorBooleanButton then
		host._particleKeyframeEditorBooleanButton.Visible = valueKind == "boolean" and not isParticleEvent
	end
	if host._particleKeyframeEditorValueInput then
		host._particleKeyframeEditorValueInput.Visible = (valueKind ~= "boolean" and not isParticleEvent) or actionName == "Emit"
		host._particleKeyframeEditorValueInput.PlaceholderText = isParticleEvent and "Particles to emit" or ParticleEmitterPropertyService.getInputLabel(propertyName)
		if focusedTextBox ~= host._particleKeyframeEditorValueInput and value ~= nil then
			host._particleKeyframeEditorValueInput.Text = isParticleEvent
				and tostring(value.emitCount or 10)
				or ParticleEmitterPropertyService.formatValue(value, propertyName)
		end
	end
	if host._particleKeyframeEditorColorPickerFrame then
		host._particleKeyframeEditorColorPickerFrame.Visible = valueKind == "colorSequence" and not isParticleEvent
	end
	if host._particleKeyframeEditorNoteLabel then
		host._particleKeyframeEditorNoteLabel.Text = isParticleEvent
			and (actionName == "Emit" and "Emit fires once during playback. Apply Keyframe also previews it immediately." or "Clear removes live particles once when playback crosses this keyframe.")
			or "Examples: Color 255,0,4  |  Range 1,3  |  Vector 0,4,0"
	end
	if valueKind == "boolean" and value ~= nil and not host._particleEditorBooleanDirty then
		host._particleEditorBooleanValue = value == true
	end

	updateBooleanButton(host)
	updateColorSwatch(host)
	refreshEasingPanel(host)
end

function ParticleKeyframeEditorController.connect(host, callbacks)
	host._particleKeyframeEditorCallbacks = callbacks
	if host._particleKeyframeEditorCloseButton then
		host:_connect(host._particleKeyframeEditorCloseButton.Activated, function()
			ParticleKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Particle editor closed")
		end)
	end
	if host._particleKeyframeEditorOkButton then
		host:_connect(host._particleKeyframeEditorOkButton.Activated, function()
			applyEditorValue(host, callbacks)
			ParticleKeyframeEditorController.hide(host)
			host:_focusShortcutCapture("Particle editor closed")
		end)
	end
	if host._particleKeyframeEditorBooleanButton then
		host:_connect(host._particleKeyframeEditorBooleanButton.Activated, function()
			host._particleEditorBooleanValue = not host._particleEditorBooleanValue
			host._particleEditorBooleanDirty = true
			updateBooleanButton(host)
		end)
	end
	if host._particleKeyframeEditorValueInput then
		host:_connect(host._particleKeyframeEditorValueInput.FocusLost, function(enterPressed)
			updateColorSwatch(host)
			if enterPressed then
				applyEditorValue(host, callbacks)
			end
		end)
	end
	for index, button in ipairs(host._particleKeyframeEditorColorButtons or {}) do
		local color = PRESET_COLORS[index]
		if color then
			host:_connect(button.Activated, function()
				if host._particleKeyframeEditorValueInput then
					host._particleKeyframeEditorValueInput.Text = formatColor(color)
				end
				updateColorSwatch(host)
				applyEditorValue(host, callbacks)
			end)
		end
	end
	if host._particleKeyframeEditorApplyButton then
		host:_connect(host._particleKeyframeEditorApplyButton.Activated, function()
			applyEditorValue(host, callbacks)
			host:_focusShortcutCapture("Particle property keyframe updated")
		end)
	end
end

return ParticleKeyframeEditorController
</ProtectedString>
        </Properties>
