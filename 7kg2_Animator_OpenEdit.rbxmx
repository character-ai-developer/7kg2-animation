      <Item class="ModuleScript" referent="RBX169">
        <Properties>
          <string name="Name">MotionMarkerUiSupport</string>
          <ProtectedString name="Source">local MotionMarkerUiSupport = {}

function MotionMarkerUiSupport.createMotionMarkers(motionService, deps)
	return motionService.createMotionMarkers(deps)
end

function MotionMarkerUiSupport.addMotionMarker(motionService, deps)
	return motionService.addMotionMarker(deps)
end

function MotionMarkerUiSupport.selectMotionMarker(motionService, deps, markerPath)
	return motionService.selectMotionMarker(deps, markerPath)
end

function MotionMarkerUiSupport.createMotionAnimationFromMarkers(args)
	if args.motionService.getMotionPreviewState().isPreviewing then
		args.refreshUi("Stop the Motion Builder preview before building the timeline.")
		return false, "Stop the Motion Builder preview before building the timeline."
	end
	do
		local deps = args.motionServiceDeps()
		if deps and type(deps.ensureMotionBuilderRig) == "function" then
			local rigSuccess, rigMessage = deps.ensureMotionBuilderRig()
			if not rigSuccess then
				return false, rigMessage
			end
		end
	end

	local perfToken = args.performanceDebugService.begin("Motion Build")
	local success, message = args.motionService.generateMotionPathFromWorkspaceMarkers(args.motionServiceDeps(), args.motionBuilderState:getOptions({
		rigType = args.rigType,
	}))
	args.performanceDebugService.finish(perfToken, message)
	return success, message
end

function MotionMarkerUiSupport.previewMotionPathFromMarkers(startMotionPreview)
	return startMotionPreview(nil)
end

function MotionMarkerUiSupport.previewMotionSegment(startMotionPreview, segmentKey)
	return startMotionPreview(segmentKey)
end

function MotionMarkerUiSupport.stopMotionPreview(motionService, deps)
	return motionService.stopMotionPreview(deps)
end

return MotionMarkerUiSupport
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX170">
        <Properties>
          <string name="Name">MotionPreviewUiSupport</string>
          <ProtectedString name="Source">local MotionPreviewUiSupport = {}

function MotionPreviewUiSupport.getPreviewRigTypeName(motionClipService, timeline)
	return motionClipService.getRigTypeName(timeline:getRig()) or "R15"
end

function MotionPreviewUiSupport.getBoundRigTypeName(motionClipService, timeline)
	return motionClipService.getRigTypeName(timeline:getRig())
end

function MotionPreviewUiSupport.togglePerformanceDebug(performanceDebugService)
	local isEnabled = performanceDebugService.toggle()
	if isEnabled then
		performanceDebugService.reset()
		return true, "Performance Debug enabled. Scrub the timeline, preview Motion Builder, or build a path to gather timings.", "Performance Debug enabled"
	end
	return false, "Performance Debug disabled.", "Performance Debug disabled"
end

return MotionPreviewUiSupport
</ProtectedString>
