        <Item class="ModuleScript" referent="RBX70">
          <Properties>
            <string name="Name">LayoutUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))

local LayoutUI = {}

local create = UiHelpers.create
local styleTextButton = UiHelpers.styleTextButton
local styleGhostButton = UiHelpers.styleGhostButton
local createCorner = UiHelpers.createCorner
local createStroke = UiHelpers.createStroke
local createMetaLabel = UiHelpers.createMetaLabel
local createCard = UiHelpers.createCard
local applySectionSurface = UiHelpers.applySectionSurface

local PRESETS = {
	{ key = "Full Workspace", text = "Full Workspace", description = "Show every panel for full editing." },
	{ key = "Compact", text = "Compact", description = "Hide the left panels for single-screen work." },
	{ key = "Timeline Focus", text = "Timeline Focus", description = "Prioritize timeline editing and keyframe tools." },
	{ key = "Single Screen Mode", text = "Single Screen", description = "Compact the workspace for one-monitor editing." },
}

local PANELS = {
	{ key = "SessionSummary", text = "Session Summary" },
	{ key = "MotionBuilder", text = "Motion Builder" },
	{ key = "Inspector", text = "Animation Settings" },
	{ key = "KeyframeTools", text = "Keyframe Tools" },
	{ key = "CompactHeader", text = "Compact Header" },
	{ key = "SingleScreenMode", text = "Single Screen Mode" },
}

local function makeButton(parent, text, x, y, width)
	local button = create("TextButton", {
		Parent = parent,
		Position = UDim2.new(0, x, 0, y),
		Size = UDim2.new(0, width, 0, 34),
		Text = text,
	})
	styleGhostButton(button)
	createCorner(button, 10)
	return button
end

function LayoutUI.mount(parent, _context)
	if not parent then
		error("LayoutUI.mount requires parent")
	end

	local refs = {
		_layoutPresetButtons = {},
		_layoutToggleButtons = {},
	}

	local layoutCard = createCard(parent, UDim2.new(1, 0, 0, 390))
	layoutCard.Position = UDim2.new(0, 0, 0, 0)
	layoutCard.Visible = false
	layoutCard.ClipsDescendants = true
	local layoutCollapseButton = UiHelpers.createPanelCollapseButton(layoutCard)

	local layoutScroll = create("ScrollingFrame", {
		Parent = layoutCard,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ClipsDescendants = true,
		Position = UDim2.new(0, 0, 0, 0),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 5,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.new(1, 0, 1, 0),
	})

	local layoutContent = create("Frame", {
		Parent = layoutScroll,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 390),
	})

	local titleLabel = create("TextLabel", {
		Parent = layoutContent,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(0, 180, 0, 20),
		Font = Enum.Font.GothamSemibold,
		Text = "Layout Workspace",
		TextColor3 = Constants.THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local subtitleLabel = createMetaLabel(
		layoutContent,
		"Choose which panels are visible while keeping the timeline ready underneath.",
		22
	)
	subtitleLabel.Position = UDim2.new(0, 16, 0, 38)

	local presetsPanel = create("Frame", {
		Parent = layoutContent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 16, 0, 76),
		Size = UDim2.new(0.42, -24, 0, 158),
	})
	applySectionSurface(presetsPanel)
	createCorner(presetsPanel, 12)
	createStroke(presetsPanel)

	create("TextLabel", {
		Parent = presetsPanel,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 12),
		Size = UDim2.new(1, -28, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Workspace Presets",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	createMetaLabel(presetsPanel, "Fast arrangements for different screen sizes.", 16).Position = UDim2.new(0, 14, 0, 34)

	local y = 52
	local presetDescriptionLabels = {}
	for _, preset in ipairs(PRESETS) do
		local button = makeButton(presetsPanel, preset.text, 14, y, 180)
		refs._layoutPresetButtons[preset.key] = button
		local descriptionLabel = createMetaLabel(presetsPanel, preset.description, 16)
		descriptionLabel.Position = UDim2.new(0, 210, 0, y + 8)
		presetDescriptionLabels[preset.key] = descriptionLabel
		y += 38
	end

	local togglesPanel = create("Frame", {
		Parent = layoutContent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0.42, 8, 0, 76),
		Size = UDim2.new(0.58, -24, 0, 158),
	})
	applySectionSurface(togglesPanel)
	createCorner(togglesPanel, 12)
	createStroke(togglesPanel)

	create("TextLabel", {
		Parent = togglesPanel,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 12),
		Size = UDim2.new(1, -28, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = "Panel Visibility",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	createMetaLabel(togglesPanel, "Turn individual panels on or off for the current session.", 16).Position =
		UDim2.new(0, 14, 0, 34)

	local columns = 2
	local buttonWidth = 190
	local panelButtons = {}
	for index, panel in ipairs(PANELS) do
		local column = (index - 1) % columns
		local row = math.floor((index - 1) / columns)
		local button = makeButton(togglesPanel, panel.text, 14 + (column * (buttonWidth + 12)), 52 + (row * 38), buttonWidth)
		refs._layoutToggleButtons[panel.key] = button
		panelButtons[index] = button
	end

	local statusLabel = create("TextLabel", {
		Parent = layoutContent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 16, 1, -48),
		Size = UDim2.new(1, -32, 0, 32),
		Font = Enum.Font.GothamSemibold,
		Text = "Full Workspace: all panels visible.",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
	createCorner(statusLabel, 10)
	createStroke(statusLabel)
	create("UIPadding", {
		Parent = statusLabel,
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	})

	local function resizePresetRows(panelWidth)
		local showDescriptions = panelWidth &gt;= 470
		local buttonWidth = showDescriptions and 180 or math.max(120, panelWidth - 28)
		for index, preset in ipairs(PRESETS) do
			local rowY = 52 + ((index - 1) * 38)
			local button = refs._layoutPresetButtons[preset.key]
			if button then
				button.Position = UDim2.new(0, 14, 0, rowY)
				button.Size = UDim2.new(0, buttonWidth, 0, 34)
			end
			local descriptionLabel = presetDescriptionLabels[preset.key]
			if descriptionLabel then
				descriptionLabel.Visible = showDescriptions
				descriptionLabel.Position = UDim2.new(0, 210, 0, rowY + 8)
				descriptionLabel.Size = UDim2.new(1, -224, 0, 18)
			end
		end
		return 52 + (#PRESETS * 38) + 14
	end

	local function resizePanelButtons(panelWidth)
		local columnCount = panelWidth &gt;= 430 and 2 or 1
		local rowCount = math.ceil(#panelButtons / columnCount)
		local buttonWidthForPanel = math.max(120, math.floor((panelWidth - 28 - ((columnCount - 1) * 12)) / columnCount))
		for index, button in ipairs(panelButtons) do
			local column = (index - 1) % columnCount
			local row = math.floor((index - 1) / columnCount)
			button.Position = UDim2.new(0, 14 + (column * (buttonWidthForPanel + 12)), 0, 52 + (row * 38))
			button.Size = UDim2.new(0, buttonWidthForPanel, 0, 34)
		end
		return 52 + (rowCount * 38) + 14
	end

	local function applyResponsiveLayout()
		local cardSize = layoutCard.AbsoluteSize
		local contentWidth = math.max(320, (cardSize.X &gt; 0 and cardSize.X or 1000) - 10)
		local compact = contentWidth &lt; 760
		local margin = 16
		local gap = 14
		local panelWidth = contentWidth - (margin * 2)
		local headerHeight = compact and 66 or 64

		titleLabel.Position = UDim2.new(0, margin, 0, compact and 10 or 12)
		titleLabel.Size = UDim2.new(1, -(margin * 2), 0, 20)
		subtitleLabel.Position = UDim2.new(0, margin, 0, compact and 34 or 38)
		subtitleLabel.Size = UDim2.new(1, -(margin * 2), 0, compact and 30 or 18)
		subtitleLabel.TextWrapped = compact

		local contentHeight
		if compact then
			local presetsHeight = resizePresetRows(panelWidth)
			local togglesHeight = resizePanelButtons(panelWidth)
			local statusHeight = 48
			local presetsY = headerHeight + 6
			local togglesY = presetsY + presetsHeight + 12
			local statusY = togglesY + togglesHeight + 12

			presetsPanel.Position = UDim2.new(0, margin, 0, presetsY)
			presetsPanel.Size = UDim2.new(0, panelWidth, 0, presetsHeight)
			togglesPanel.Position = UDim2.new(0, margin, 0, togglesY)
			togglesPanel.Size = UDim2.new(0, panelWidth, 0, togglesHeight)
			statusLabel.Position = UDim2.new(0, margin, 0, statusY)
			statusLabel.Size = UDim2.new(0, panelWidth, 0, statusHeight)
			contentHeight = statusY + statusHeight + 16
		else
			local topY = 76
			local availableWidth = panelWidth - gap
			local presetsWidth = math.floor(availableWidth * 0.4)
			local togglesWidth = availableWidth - presetsWidth
			local presetsHeight = resizePresetRows(presetsWidth)
			local togglesHeight = resizePanelButtons(togglesWidth)
			local panelHeight = math.max(168, presetsHeight, togglesHeight)
			local statusY = topY + panelHeight + 12

			presetsPanel.Position = UDim2.new(0, margin, 0, topY)
			presetsPanel.Size = UDim2.new(0, presetsWidth, 0, panelHeight)
			togglesPanel.Position = UDim2.new(0, margin + presetsWidth + gap, 0, topY)
			togglesPanel.Size = UDim2.new(0, togglesWidth, 0, panelHeight)

			statusLabel.Position = UDim2.new(0, margin, 0, statusY)
			statusLabel.Size = UDim2.new(0, panelWidth, 0, 36)
			contentHeight = statusY + 36 + 16
		end

		layoutContent.Size = UDim2.new(1, -10, 0, contentHeight)
	end

	layoutCard:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyResponsiveLayout)
	task.defer(applyResponsiveLayout)

	refs._layoutCard = layoutCard
	refs._layoutStatusLabel = statusLabel
	refs._layoutCollapseButton = layoutCollapseButton

	return refs
end

function LayoutUI.update(_context)
end

function LayoutUI.destroy()
end

return LayoutUI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX71">
          <Properties>
            <string name="Name">MainSessionSummaryUI</string>
            <ProtectedString name="Source">local Constants = require(script.Parent.Parent:WaitForChild("Constants"))
local UiHelpers = require(script.Parent.Parent:WaitForChild("UiHelpers"))
local MainTimingPopupSupport = require(script.Parent:WaitForChild("MainTimingPopupSupport"))

local MainSessionSummaryUI = {}

local create = UiHelpers.create

local SESSION_ICON = "rbxassetid://105890935809587"
local function setBackgroundRole(instance, role)
	instance:SetAttribute("MegMoThemeBackgroundRole", role)
	return instance
end

local function setTextRole(instance, role)
	instance:SetAttribute("MegMoThemeTextRole", role)
	return instance
end

local function createBorder(parent, transparency)
	local stroke = create("UIStroke", {
		Parent = parent,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Constants.THEME.Border,
		Thickness = 1,
	})
	stroke.Transparency = transparency or 0.42
	stroke:SetAttribute("MegMoThemeStrokeRole", "Border")
	return stroke
end

local function createField(parent, y, labelText)
	local field = setBackgroundRole(create("Frame", {
		Parent = parent,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, y + 17),
		Size = UDim2.new(1, -20, 0, 39),
	}), "PanelAlt")
	UiHelpers.createCorner(field, 6)
	createBorder(field, 0.38)

	setTextRole(create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 12, 0, y),
		Size = UDim2.new(1, -28, 0, 17),
		Text = labelText,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
	}), "Text")
	return field
end

local function styleInlineTextButton(button, text, highlighted)
	local backgroundRole = highlighted and "AccentSoft" or "PanelSoft"
	button.AutoButtonColor = true
	button.BackgroundColor3 = Constants.THEME[backgroundRole]
	button.BorderSizePixel = 0
	button.Text = ""
	button:SetAttribute("MegMoThemeBackgroundRole", backgroundRole)
	UiHelpers.createCorner(button, 6)
	createBorder(button, highlighted and 0.12 or 0.42)
	setTextRole(create("TextLabel", {
		Name = "ButtonLabel",
		Parent = button,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = button.ZIndex + 1,
	}), "Text")
	return button
end

local function createActionButton(parent, name, text, column)
	local button = create("TextButton", {
		Name = name,
		Parent = parent,
		Position = UDim2.new((column - 1) * 0.25, column == 1 and 0 or 3, 0, 0),
		Size = UDim2.new(0.25, column == 1 and -3 or -6, 1, 0),
		Text = text,
	})
	UiHelpers.styleIconTileButton(button, text, Constants.THEME.PanelSoft, {
		iconSize = 20,
	})
	UiHelpers.createCorner(button, 6)
	return button
end

local function createRigButton(parent, name, text, column)
	local button = create("TextButton", {
		Name = name,
		Parent = parent,
		Position = UDim2.new((column - 1) / 3, column == 1 and 0 or 2, 0, 0),
		Size = UDim2.new(1 / 3, column == 1 and -2 or -4, 1, 0),
		Text = text,
	})
	UiHelpers.styleGhostButton(button)
	button.TextSize = 10
	UiHelpers.createCorner(button, 5)
	return button
end

local function createSummaryRow(parent, labelText, y)
	local label = setTextRole(create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		Position = UDim2.new(0, 10, 0, y),
		Size = UDim2.new(0.48, -10, 0, 23),
		Text = labelText,
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	}), "MutedText")
	local value = setTextRole(create("TextButton", {
		Parent = parent,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0.48, 0, 0, y),
		Size = UDim2.new(0.52, -10, 0, 23),
		Text = "-",
		TextColor3 = Constants.THEME.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	}), "Text")
	return label, value
end

function MainSessionSummaryUI.mount(parent, context)
	if not parent then
		error("MainSessionSummaryUI.mount requires parent")
	end

	local refs = {}
	local card = UiHelpers.createCard(parent, UDim2.new(1, 0, 0.44, -6))
	card.Name = "MainSessionSummaryCard"
	card.Position = UDim2.new(0, 0, 0.56, 12)
	card.ClipsDescendants = true
	local timingPopup = MainTimingPopupSupport.mount((context and context.root) or parent, {
		controller = context and context.controller,
	})

	local titleIcon = create("ImageLabel", {
		Name = "SessionIcon",
		Parent = card,
		BackgroundTransparency = 1,
		Image = SESSION_ICON,
		ImageColor3 = Constants.THEME.Text,
		ImageTransparency = 0.08,
		Position = UDim2.fromOffset(12, 9),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(23, 23),
	})
	titleIcon:SetAttribute("MegMoThemeImageRole", "Text")

	setTextRole(create("TextLabel", {
		Name = "SessionTitle",
		Parent = card,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(40, 5),
		Size = UDim2.new(1, -82, 0, 30),
		Text = "Session",
		TextColor3 = Constants.THEME.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
	}), "Text")
	local collapseButton = UiHelpers.createPanelCollapseButton(card)

	local summaryStack = create("ScrollingFrame", {
		Name = "MainSessionSummaryContent",
		Parent = card,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 356),
		Position = UDim2.fromOffset(4, 38),
		ScrollBarImageColor3 = Constants.THEME.Border,
		ScrollBarThickness = 3,
		Size = UDim2.new(1, -8, 1, -44),
	})
	summaryStack:SetAttribute("MegMoThemeScrollRole", "Border")

	local animationField = createField(summaryStack, 0, "Project Name")
	local animationNameInput = setTextRole(create("TextBox", {
		Name = "AnimationNameInput",
		Parent = animationField,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(8, 1),
		Size = UDim2.new(1, -16, 1, -2),
		PlaceholderText = "Animation name",
		Text = "Untitled Animation",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}), "Text")

	local actionRow = create("Frame", {
		Name = "FileActions",
		Parent = summaryStack,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 8, 0, 62),
		Size = UDim2.new(1, -20, 0, 54),
	})
	local newButton = createActionButton(actionRow, "NewButton", "New", 1)
	local saveButton = createActionButton(actionRow, "SaveButton", "Save", 2)
	local importButton = createActionButton(actionRow, "ImportButton", "Import", 3)
	local exportButton = createActionButton(actionRow, "ExportButton", "Export", 4)

	setBackgroundRole(create("Frame", {
		Name = "RigDivider",
		Parent = summaryStack,
		BackgroundColor3 = Constants.THEME.Border,
		BackgroundTransparency = 0.42,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 119),
		Size = UDim2.new(1, -20, 0, 1),
	}), "Border")
	setTextRole(create("TextLabel", {
		Name = "RigSectionTitle",
		Parent = summaryStack,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 8, 0, 126),
		Size = UDim2.new(1, -20, 0, 18),
		Text = "Rig",
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}), "Text")

	local rigRow = create("Frame", {
		Name = "RigPresets",
		Parent = summaryStack,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 8, 0, 145),
		Size = UDim2.new(1, -20, 0, 34),
		ZIndex = 2,
	})
	local insertR6Button = createRigButton(rigRow, "InsertR6Button", "R6", 1)
	local insertR15Button = createRigButton(rigRow, "InsertR15Button", "R15 Classic", 2)
	local insertR15ModernButton = createRigButton(rigRow, "InsertR15ModernButton", "R15 Modern", 3)

	local avatarRigTypeButton = create("TextButton", {
		Name = "AvatarRigTypeButton",
		Parent = summaryStack,
		Position = UDim2.new(0, 8, 0, 184),
		Size = UDim2.new(1, -20, 0, 28),
		Text = "Avatar Type: R15 Classic",
		ZIndex = 2,
	})
	UiHelpers.styleGhostButton(avatarRigTypeButton)
	avatarRigTypeButton.TextSize = 11
	UiHelpers.createCorner(avatarRigTypeButton, 5)

	local avatarInput = create("TextBox", {
		Name = "AvatarInput",
		Parent = summaryStack,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		PlaceholderText = "Username / ID or blank",
		Position = UDim2.new(0, 8, 0, 217),
		Size = UDim2.new(1, -98, 0, 30),
		Text = "",
		TextColor3 = Constants.THEME.Text,
		PlaceholderColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	})
	UiHelpers.styleInput(avatarInput)
	avatarInput.BackgroundColor3 = Constants.THEME.PanelAlt
	avatarInput.TextSize = 10
	avatarInput:SetAttribute("MegMoThemeBackgroundRole", "PanelAlt")
	avatarInput:SetAttribute("MegMoThemeTextRole", "Text")
	UiHelpers.createCorner(avatarInput, 5)
	createBorder(avatarInput, 0.42)
	create("UIPadding", {
		Parent = avatarInput,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	local insertAvatarButton = create("TextButton", {
		Name = "InsertAvatarButton",
		Parent = summaryStack,
		Position = UDim2.new(1, -108, 0, 217),
		Size = UDim2.fromOffset(96, 30),
		ZIndex = 2,
	})
	avatarInput.Size = UDim2.new(1, -122, 0, 30)
	styleInlineTextButton(insertAvatarButton, "Insert Avatar", true)

	setBackgroundRole(create("Frame", {
		Name = "ProjectDivider",
		Parent = summaryStack,
		BackgroundColor3 = Constants.THEME.Border,
		BackgroundTransparency = 0.42,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 252),
		Size = UDim2.new(1, -20, 0, 1),
	}), "Border")
	setTextRole(create("TextLabel", {
		Name = "ProjectSummaryTitle",
		Parent = summaryStack,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(0, 8, 0, 260),
		Size = UDim2.new(1, -20, 0, 19),
		Text = "Project Summary",
		TextColor3 = Constants.THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}), "Text")

	local projectTable = setBackgroundRole(create("Frame", {
		Name = "ProjectSummaryTable",
		Parent = summaryStack,
		BackgroundColor3 = Constants.THEME.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 283),
		Size = UDim2.new(1, -20, 0, 69),
	}), "PanelAlt")
	UiHelpers.createCorner(projectTable, 5)
	createBorder(projectTable, 0.42)
	for _, y in ipairs({ 23, 46 }) do
		setBackgroundRole(create("Frame", {
			Parent = projectTable,
			BackgroundColor3 = Constants.THEME.Border,
			BackgroundTransparency = 0.58,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, 1),
		}), "Border")
	end
	setBackgroundRole(create("Frame", {
		Parent = projectTable,
		BackgroundColor3 = Constants.THEME.Border,
		BackgroundTransparency = 0.58,
		BorderSizePixel = 0,
		Position = UDim2.new(0.48, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
	}), "Border")
	local _, durationValue = createSummaryRow(projectTable, "Duration", 0)
	local _, fpsValue = createSummaryRow(projectTable, "FPS", 23)
	local _, keyframeValue = createSummaryRow(projectTable, "Keyframes", 46)
	durationValue.Text = "5.00 sec"
	fpsValue.Text = "30"
	keyframeValue.Text = "0"
	keyframeValue.Active = false
	local function connectTimingValue(button, target)
		button.AutoButtonColor = true
		button.MouseEnter:Connect(function()
			button.TextColor3 = Constants.THEME.Accent
		end)
		button.MouseLeave:Connect(function()
			button.TextColor3 = Constants.THEME.Text
		end)
		button.Activated:Connect(function()
			if timingPopup and type(timingPopup.open) == "function" then
				timingPopup:open(target)
			end
		end)
	end
	connectTimingValue(durationValue, "Duration")
	connectTimingValue(fpsValue, "FPS")

	local performanceDebugLabel = setTextRole(create("TextLabel", {
		Name = "PerformanceDebug",
		Parent = summaryStack,
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Position = UDim2.new(0, 8, 0, 360),
		Size = UDim2.new(1, -20, 0, 62),
		Text = "",
		TextColor3 = Constants.THEME.MutedText,
		TextSize = 10,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Visible = false,
	}), "MutedText")
	performanceDebugLabel:GetPropertyChangedSignal("Visible"):Connect(function()
		summaryStack.CanvasSize = UDim2.fromOffset(0, performanceDebugLabel.Visible and 428 or 356)
	end)

	refs._animationNameInput = animationNameInput
	refs._renameButton = newButton
	refs._newAnimationButton = newButton
	refs._saveButton = saveButton
	refs._importButton = importButton
	refs._exportButton = exportButton
	refs._insertR6Button = insertR6Button
	refs._insertR15Button = insertR15Button
	refs._insertR15ModernButton = insertR15ModernButton
	refs._avatarRigTypeButton = avatarRigTypeButton
	refs._avatarInput = avatarInput
	refs._insertAvatarButton = insertAvatarButton
	refs._durationSummaryValue = durationValue
	refs._fpsSummaryValue = fpsValue
	refs._keyframeSummaryValue = keyframeValue
	refs._performanceDebugLabel = performanceDebugLabel
	refs._summaryStack = summaryStack
	refs._sessionSummaryCard = card
	refs._sessionSummaryCollapseButton = collapseButton

	return refs
end

function MainSessionSummaryUI.update(_context)
end

function MainSessionSummaryUI.destroy()
end

