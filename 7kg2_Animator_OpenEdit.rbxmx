      <Item class="ModuleScript" referent="RBX147">
        <Properties>
          <string name="Name">InstanceAddressSupport</string>
          <ProtectedString name="Source">local InstanceAddressSupport = {}

local HttpService = game:GetService("HttpService")

local STABLE_ID_ATTRIBUTE = "MegMoTrackTargetId"
local verifiedStableIds = setmetatable({}, { __mode = "k" })

local ROOTS = {
	Workspace = workspace,
	ServerStorage = game:GetService("ServerStorage"),
}

local function getSupportedRoot(instance)
	local current = instance
	while current and current.Parent and current.Parent ~= game do
		current = current.Parent
	end
	if current and current.Parent == game and ROOTS[current.Name] == current then
		return current
	end
	return nil
end

local function readStableId(instance)
	if not instance then
		return nil
	end
	local ok, value = pcall(function()
		return instance:GetAttribute(STABLE_ID_ATTRIBUTE)
	end)
	if ok and type(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

local function writeNewStableId(instance)
	local stableId = HttpService:GenerateGUID(false)
	local ok = pcall(function()
		instance:SetAttribute(STABLE_ID_ATTRIBUTE, stableId)
	end)
	if ok then
		verifiedStableIds[instance] = stableId
	end
	return ok and stableId or nil
end

local function buildStableIdIndex(root)
	local index = {}
	for _, descendant in ipairs(root:GetDescendants()) do
		local stableId = readStableId(descendant)
		if stableId then
			index[stableId] = index[stableId] or {}
			table.insert(index[stableId], descendant)
		end
	end
	return index
end

local function collectStableIdMatches(root, stableId, resolveContext)
	local matches = {}
	if not root or type(stableId) ~= "string" or stableId == "" then
		return matches
	end
	if type(resolveContext) == "table" then
		resolveContext.stableIdIndexes = resolveContext.stableIdIndexes or {}
		local index = resolveContext.stableIdIndexes[root]
		if not index then
			index = buildStableIdIndex(root)
			resolveContext.stableIdIndexes[root] = index
		end
		return index[stableId] or matches
	end
	for _, descendant in ipairs(root:GetDescendants()) do
		if readStableId(descendant) == stableId then
			matches[#matches + 1] = descendant
		end
	end
	return matches
end

local function resolveSegments(root, segments)
	local current = root
	for _, segment in ipairs(type(segments) == "table" and segments or {}) do
		local targetOrdinal = math.max(1, math.floor(tonumber(segment.ordinal) or 1))
		local currentOrdinal = 0
		local matched = nil
		for _, child in ipairs(current:GetChildren()) do
			if child.Name == segment.name and (segment.className == nil or child.ClassName == segment.className) then
				currentOrdinal += 1
				if currentOrdinal == targetOrdinal then
					matched = child
					break
				end
			end
		end
		if not matched then
			return nil
		end
		current = matched
	end
	return current
end

local function getSiblingOrdinal(instance)
	local parent = instance and instance.Parent
	if not parent then
		return 1
	end
	local ordinal = 0
	for _, sibling in ipairs(parent:GetChildren()) do
		if sibling.Name == instance.Name and sibling.ClassName == instance.ClassName then
			ordinal += 1
			if sibling == instance then
				return ordinal
			end
		end
	end
	return 1
end

local function getMatchingSiblingCount(instance)
	local parent = instance and instance.Parent
	if not parent then
		return 1
	end
	local count = 0
	for _, sibling in ipairs(parent:GetChildren()) do
		if sibling.Name == instance.Name and sibling.ClassName == instance.ClassName then
			count += 1
		end
	end
	return math.max(1, count)
end

local function getCandidateCFrame(instance)
	if instance and instance:IsA("BasePart") then
		return instance.CFrame
	end
	if instance and instance:IsA("Model") then
		return instance:GetPivot()
	end
	if instance and instance:IsA("Attachment") then
		return instance.WorldCFrame
	end
	return nil
end

function InstanceAddressSupport.getStableId(instance)
	return readStableId(instance)
end

function InstanceAddressSupport.ensureStableId(instance)
	local root = getSupportedRoot(instance)
	if not root then
		return nil
	end

	local stableId = readStableId(instance)
	if not stableId then
		return writeNewStableId(instance)
	end
	if verifiedStableIds[instance] == stableId then
		return stableId
	end

	local matches = collectStableIdMatches(root, stableId)
	if #matches &gt; 1 and matches[1] ~= instance then
		return writeNewStableId(instance)
	end
	verifiedStableIds[instance] = stableId
	return stableId
end

function InstanceAddressSupport.shouldUseStableId(trackType)
	trackType = tostring(trackType or "")
	return trackType ~= ""
		and trackType ~= "Rig"
		and trackType ~= "Rig Group"
		and trackType ~= "RigProperty"
		and trackType ~= "Rig Property"
		and trackType ~= "RigCFrame"
		and trackType ~= "Rig CFrame"
		and trackType ~= "Camera"
		and trackType ~= "CameraProperty"
		and trackType ~= "Camera Property"
		and trackType ~= "Folder"
		and trackType ~= "ScreenEffect"
		and trackType ~= "Screen Effect"
		and trackType ~= "LightingEffect"
		and trackType ~= "Lighting Effect"
		and trackType ~= "Event"
		and trackType ~= "Face"
end

function InstanceAddressSupport.ensureTrackTargetId(trackType, instance)
	if InstanceAddressSupport.shouldUseStableId(trackType) then
		return InstanceAddressSupport.ensureStableId(instance)
	end
	return nil
end

function InstanceAddressSupport.getDisambiguatedName(instance)
	if not instance then
		return nil
	end
	if getMatchingSiblingCount(instance) &lt;= 1 then
		return instance.Name
	end
	return string.format("%s (%d)", instance.Name, getSiblingOrdinal(instance))
end

function InstanceAddressSupport.capture(instance, options)
	if not (instance and instance.Parent) then
		return nil
	end

	local segments = {}
	local current = instance
	while current and current.Parent and current.Parent ~= game do
		table.insert(segments, 1, {
			name = current.Name,
			className = current.ClassName,
			ordinal = getSiblingOrdinal(current),
		})
		current = current.Parent
	end
	if not current or current.Parent ~= game or ROOTS[current.Name] ~= current then
		return nil
	end
	local stableId = nil
	if type(options) == "table" and options.stableId == true then
		stableId = InstanceAddressSupport.ensureStableId(instance)
	end
	return {
		version = stableId and 2 or 1,
		root = current.Name,
		segments = segments,
		stableId = stableId,
	}
end

function InstanceAddressSupport.captureTrackTarget(track)
	if type(track) ~= "table" then
		return nil
	end
	return InstanceAddressSupport.capture(track.instance, {
		stableId = InstanceAddressSupport.shouldUseStableId(track.trackType),
	})
end

function InstanceAddressSupport.createResolveContext()
	return {
		stableIdIndexes = {},
	}
end

function InstanceAddressSupport.resolve(address, resolveContext)
	if type(address) ~= "table" then
		return nil
	end
	local current = ROOTS[tostring(address.root or "")]
	if not current then
		return nil
	end

	local segmentMatch = resolveSegments(current, address.segments)
	local stableId = type(address.stableId) == "string" and address.stableId or nil
	if stableId and stableId ~= "" then
		local stableMatches = collectStableIdMatches(current, stableId, resolveContext)
		if #stableMatches == 1 then
			verifiedStableIds[stableMatches[1]] = stableId
			return stableMatches[1]
		end
		if #stableMatches &gt; 1 then
			for _, candidate in ipairs(stableMatches) do
				if candidate == segmentMatch then
					return candidate
				end
			end
			return stableMatches[1]
		end
	end
	return segmentMatch
end

function InstanceAddressSupport.resolveLegacyCandidates(pathText)
	local normalized = tostring(pathText or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("^game%.", "")
	local segments = string.split(normalized, ".")
	local root = ROOTS[segments[1]]
	if not root then
		return {}
	end

	local candidates = { root }
	for index = 2, #segments do
		local nextCandidates = {}
		for _, parent in ipairs(candidates) do
			for _, child in ipairs(parent:GetChildren()) do
				if child.Name == segments[index] then
					nextCandidates[#nextCandidates + 1] = child
				end
			end
		end
		candidates = nextCandidates
		if #candidates == 0 then
			break
		end
	end
	return candidates
end

function InstanceAddressSupport.selectBest(candidates, referenceValue, usedInstances)
	local available = {}
	for _, candidate in ipairs(candidates or {}) do
		if candidate and candidate.Parent and not (usedInstances and usedInstances[candidate]) then
			available[#available + 1] = candidate
		end
	end
	if #available == 0 then
		available = candidates or {}
	end
	if #available == 0 then
		return nil
	end
	if typeof(referenceValue) ~= "CFrame" then
		return available[1]
	end

	local best = nil
	local bestScore = math.huge
	for _, candidate in ipairs(available) do
		local candidateCFrame = getCandidateCFrame(candidate)
		if candidateCFrame then
			local positionScore = (candidateCFrame.Position - referenceValue.Position).Magnitude
			local rotationScore = 1 - math.clamp(candidateCFrame.LookVector:Dot(referenceValue.LookVector), -1, 1)
			local score = positionScore + rotationScore
			if score &lt; bestScore then
				best = candidate
				bestScore = score
			end
		end
	end
	return best or available[1]
end

return InstanceAddressSupport
