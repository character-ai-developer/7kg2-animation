		elseif actionName == "Bake" then
			return runOption(options, "onBakePreview", "bakePreview")
		end
	elseif tabName == "Time" then
		if actionName == "Play/Pause" then
			return runOption(options, "onPlayPause", "playPause")
		elseif actionName == "Stop" then
			return runOption(options, "onStop", "stopPlayback")
		elseif actionName == "Start" then
			return runOption(options, "onJumpTimelineStart")
		elseif actionName == "End" then
			return runOption(options, "onJumpTimelineEnd")
		elseif actionName == "Fit" then
			return runOption(options, "onFitTimelineKeys")
		elseif actionName == "Loop" or actionName == "30 FPS" or actionName == "60 FPS" or actionName == "15 sec" or actionName == "30 sec" or actionName == "60 sec" or actionName == "Hide Play" then
			return runMicroAction("Settings", actionName, options, payload)
		end
	elseif tabName == "Tools" then
		if actionName == "Motion Builder" then
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Motion")
				return true, "Motion Builder opened."
			end
		elseif actionName == "Faces" or actionName == "Presets" or actionName == "Effects" then
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup(actionName)
				return true, actionName .. " opened."
			end
		elseif actionName == "Cutscene Exporter" then
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Export")
				return true, "Cutscene Exporter opened."
			end
		elseif actionName == "Keyframe Tools" then
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Keyframes")
				return true, "Keyframe Tools opened."
			end
		elseif actionName == "Animation Tools" then
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Enhance")
				return true, "Animation Tools opened."
			end
		elseif actionName == "Session Summary" then
			if type(options.onOpenProjectSummary) == "function" then
				options.onOpenProjectSummary()
				return true, "Session Summary opened."
			elseif type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Summary")
				return true, "Session Summary opened."
			end
		end
	end
	local handled, didRun, message = MicroParityPopupSupport.runAction(tabName, actionName, options, payload, {
		runOption = runOption,
		requestOpenFull = requestOpenFull,
		requestOpenFullDestination = requestOpenFullDestination,
		getProjectSummary = getMicroProjectSummary,
	})
	if handled then
		return didRun, message
	end
	return false, nil
end

local function isMicroPlaybackActive(options)
	return type(options) == "table"
		and type(options.getIsPlaying) == "function"
		and options.getIsPlaying() == true
end

local function getMicroDisplayFrame(timeline, options)
	if not timeline then
		return 0
	end
	if isMicroPlaybackActive(options) and type(options.getPlaybackFrame) == "function" then
		local playbackFrame = tonumber(options.getPlaybackFrame())
		if playbackFrame ~= nil then
			return math.max(0, playbackFrame)
		end
	end
	return math.max(0, tonumber(timeline:getCurrentFrame()) or 0)
end

local function getTimelineLabel(timeline, options, frameOverride)
	if not timeline then
		return "0.00"
	end
	local fps = math.max(1, tonumber(timeline:getFps()) or 60)
	local frame = frameOverride ~= nil and math.max(0, tonumber(frameOverride) or 0) or getMicroDisplayFrame(timeline, options)
	if options and options._microPlayheadDisplayMode == "frames" then
		return string.format("%df", math.floor(frame + 0.5))
	end
	return string.format("%.2fs", frame / fps)
end

local function getTimelineFrameLabel(timeline, options)
	if not timeline then
		return "0.00"
	end
	local fps = math.max(1, tonumber(timeline:getFps()) or 60)
	local durationFrames = type(timeline.getDurationFrames) == "function" and timeline:getDurationFrames() or 0
	durationFrames = math.max(0, tonumber(durationFrames) or 0)
	if options and options._microPlayheadDisplayMode == "frames" then
		return string.format("%df", math.floor(durationFrames + 0.5))
	end
	return string.format("%.2fs", durationFrames / fps)
end

local function getTimelineStatus(timeline)
	if not timeline then
		return "No timeline"
	end
	return string.format("%d tracks  |  %d keys", #timeline:getTracks(), timeline:getKeyframeCount())
end

local function chooseMicroFrameTickStep(durationFrames, pixelWidth, fps)
	durationFrames = math.max(1, math.floor(tonumber(durationFrames) or 1))
	pixelWidth = math.max(1, tonumber(pixelWidth) or 1)
	fps = math.max(1, tonumber(fps) or 60)
	local targetTickCount = math.max(2, math.floor(pixelWidth / 44))
	local rawStep = math.max(1, durationFrames / targetTickCount)
	local secondCandidates = {
		0.05,
		0.1,
		0.2,
		0.25,
		0.5,
		1,
		2,
		5,
		10,
		15,
		30,
		60,
	}
	local candidates = {}
	local seen = {}
	for _, seconds in ipairs(secondCandidates) do
		local frameStep = math.max(1, math.floor((seconds * fps) + 0.5))
		if not seen[frameStep] then
			seen[frameStep] = true
			table.insert(candidates, frameStep)
		end
	end
	for _, step in ipairs(candidates) do
		if step &gt;= rawStep then
			return step
		end
	end
	local step = candidates[#candidates]
	while step &lt; rawStep do
		step *= 2
	end
	return step
end

local function formatMicroFrameTick(frame, fps, options)
	frame = math.max(0, math.floor(tonumber(frame) or 0))
	if options and options._microPlayheadDisplayMode == "frames" then
		return tostring(frame)
	end
	fps = math.max(1, tonumber(fps) or 60)
	local seconds = frame / fps
	if seconds &gt;= 60 then
		return string.format("%d:%02d", math.floor(seconds / 60), math.floor(seconds % 60))
	elseif seconds &gt;= 10 then
		return string.format("%.1f", seconds)
	end
	return string.format("%.2f", seconds)
end

local function hideMicroKeyDragRulerHighlight(host)
	local highlight = host and host._microKeyDragRulerHighlight
	if highlight and highlight.root and highlight.root.Parent then
		highlight.root.Visible = false
	end
end

local function setMicroKeyDragRulerHighlight(host, ruler, frame, visibleStartFrame, visibleFrameRange, fps, options)
	if not host or not ruler or frame == nil then
		hideMicroKeyDragRulerHighlight(host)
		return
	end
	visibleStartFrame = tonumber(visibleStartFrame) or 0
	visibleFrameRange = math.max(1, tonumber(visibleFrameRange) or MICRO_DEFAULT_VISIBLE_FRAMES)
	frame = math.max(0, math.floor((tonumber(frame) or 0) + 0.5))
	local alpha = (frame - visibleStartFrame) / visibleFrameRange
	if alpha &lt; -0.025 or alpha &gt; 1.025 then
		hideMicroKeyDragRulerHighlight(host)
		return
	end
	local x = MICRO_FRAME_GUTTER + (math.clamp(alpha, 0, 1) * math.max(1, ruler.AbsoluteSize.X - (MICRO_FRAME_GUTTER * 2)))
	local highlight = host._microKeyDragRulerHighlight
	if not highlight or not highlight.root or highlight.root.Parent ~= ruler then
		local root = make("Frame", {
			Name = "MicroKeyDragRulerHighlight",
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(0, 1, 1, 0),
			ZIndex = 30,
		}, ruler)
		local pill = make("Frame", {
			Name = "TargetFramePill",
			Active = false,
			BackgroundColor3 = theme().Accent,
			BackgroundTransparency = 0.02,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(-24, 1),
			Size = UDim2.fromOffset(48, 16),
			ZIndex = 31,
		}, root)
		pill:SetAttribute("MegMoThemeBackgroundRole", "Accent")
		corner(pill, 8)
		stroke(pill, theme().Text, 1, 1, "Text")
		local label = make("TextLabel", {
			Name = "TargetFrameLabel",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			TextColor3 = ThemeService.getReadableTextColor(theme().Accent),
			TextSize = 10,
			TextTransparency = 0,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 32,
		}, pill)
		label:SetAttribute("MegMoThemeTextRole", "__auto")
		local line = make("Frame", {
			Name = "TargetFrameLine",
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = theme().Accent,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 15),
			Size = UDim2.new(0, 2, 1, -14),
			ZIndex = 30,
		}, root)
		line:SetAttribute("MegMoThemeBackgroundRole", "Accent")
		corner(line, 2)
		highlight = {
			root = root,
			label = label,
		}
		host._microKeyDragRulerHighlight = highlight
	end
	highlight.root.Position = UDim2.fromOffset(math.floor(x + 0.5), 0)
	highlight.label.Text = formatMicroFrameTick(frame, fps, options)
	highlight.root.Visible = true
end

local function getMicroKeyDragRulerReferenceFrame(previewKeys, fallbackFrame)
	local firstFrame = tonumber(fallbackFrame)
	for _, previewKey in ipairs(previewKeys or {}) do
		local frame = previewKey and tonumber(previewKey.frame)
		if frame then
			firstFrame = firstFrame and math.min(firstFrame, frame) or frame
		end
	end
	return firstFrame or tonumber(fallbackFrame) or 0
end

local function snapMicroVisibleFrames(frames)
	frames = math.max(MICRO_MIN_VISIBLE_FRAMES, math.floor(tonumber(frames) or MICRO_DEFAULT_VISIBLE_FRAMES))
	return math.max(MICRO_MIN_VISIBLE_FRAMES, math.floor((frames / 30) + 0.5) * 30)
end

local function getMicroPlaybackFollowStart(currentFrame, startFrame, visibleFrames, durationFrames)
	currentFrame = math.max(0, tonumber(currentFrame) or 0)
	startFrame = math.max(0, tonumber(startFrame) or 0)
	visibleFrames = math.max(1, tonumber(visibleFrames) or MICRO_DEFAULT_VISIBLE_FRAMES)
	durationFrames = math.max(1, tonumber(durationFrames) or 1)
	if visibleFrames &gt;= durationFrames then
		return nil
	end

	local maxStart = math.max(0, durationFrames - visibleFrames)
	local rightFollowPoint = startFrame + (visibleFrames * 0.82)
	local leftFollowPoint = startFrame + (visibleFrames * 0.12)
	if currentFrame &gt;= rightFollowPoint then
		return math.clamp(math.floor(currentFrame - (visibleFrames * 0.82) + 0.5), 0, maxStart)
	elseif currentFrame &lt;= leftFollowPoint then
		return math.clamp(math.floor(currentFrame - (visibleFrames * 0.12) + 0.5), 0, maxStart)
	end
	return nil
end

getMicroProjectSummary = function(options)
	local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
	if not timeline then
		return "No timeline is available."
	end
	local fps = type(timeline.getFps) == "function" and math.max(1, tonumber(timeline:getFps()) or 60) or 60
	local durationFrames = type(timeline.getDurationFrames) == "function" and math.max(1, tonumber(timeline:getDurationFrames()) or 1) or 1
	local durationSeconds = durationFrames / fps
	local looping = type(timeline.getLooping) == "function" and timeline:getLooping() == true
	local priority = type(timeline.getPriority) == "function" and tostring(timeline:getPriority() or "Action") or "Action"
	local name = type(timeline.getAnimationName) == "function" and tostring(timeline:getAnimationName() or "Untitled Animation") or "Untitled Animation"
	if #name &gt; 18 then
		name = string.sub(name, 1, 17) .. "..."
	end
	return string.format("%s | %d FPS | %.1fs | Loop %s | %s", name, fps, durationSeconds, looping and "On" or "Off", priority)
end

local function getMicroSelectedTrackMap(options)
	local selected = {}
	if type(options.getSelectedTrackPaths) ~= "function" then
		return selected, {}
	end
	local ok, paths = pcall(options.getSelectedTrackPaths)
	if not ok or type(paths) ~= "table" then
		return selected, {}
	end
	for _, path in ipairs(paths) do
		selected[path] = true
	end
	return selected, paths
end

local MicroKeyGroupSupport = {}

function MicroKeyGroupSupport.selectedKeyId(jointPath, frame)
	return tostring(jointPath) .. ":" .. tostring(math.floor(tonumber(frame) or 0))
end

local function getMicroSelectedKeyMap(options)
	local selected = {}
	if type(options.getSelectedKeyRefs) ~= "function" then
		return selected, {}
	end
	local ok, keys = pcall(options.getSelectedKeyRefs)
	if not ok or type(keys) ~= "table" then
		return selected, {}
	end
	for _, key in ipairs(keys) do
		if key and key.jointPath and key.frame ~= nil then
			selected[MicroKeyGroupSupport.selectedKeyId(key.jointPath, key.frame)] = true
		end
	end
	return selected, keys
end

function MicroWidgetController._copyMicroKeyRefs(keyRefs)
	local copied = {}
	local seen = {}
	for _, keyRef in ipairs(type(keyRefs) == "table" and keyRefs or {}) do
		if keyRef and keyRef.jointPath and keyRef.frame ~= nil then
			local frame = math.floor(tonumber(keyRef.frame) or 0)
			local keyId = MicroKeyGroupSupport.selectedKeyId(keyRef.jointPath, frame)
			if not seen[keyId] then
				seen[keyId] = true
				copied[#copied + 1] = {
					jointPath = keyRef.jointPath,
					frame = frame,
				}
			end
		end
	end
	return copied
end

function MicroKeyGroupSupport.editorKeyId(jointPath, frame)
	return tostring(jointPath) .. "\n" .. tostring(math.max(0, math.floor(tonumber(frame) or 0)))
end

function MicroKeyGroupSupport.parseEditorKeyId(keyId)
	keyId = tostring(keyId or "")
	local divider = string.find(keyId, "\n", 1, true)
	if not divider then
		return nil, nil
	end
	return string.sub(keyId, 1, divider - 1), tonumber(string.sub(keyId, divider + 1))
end

function MicroKeyGroupSupport.buildDragState(viewModel)
	local state = {
		byKey = {},
	}
	for groupId, group in pairs((viewModel and viewModel.groups) or {}) do
		local refs = {}
		for keyId in pairs(group.keys or {}) do
			local jointPath, frame = MicroKeyGroupSupport.parseEditorKeyId(keyId)
			if jointPath and frame ~= nil then
				refs[#refs + 1] = {
					jointPath = jointPath,
					frame = frame,
				}
			end
		end
		table.sort(refs, function(a, b)
			if a.frame == b.frame then
				return tostring(a.jointPath) &lt; tostring(b.jointPath)
			end
			return (a.frame or 0) &lt; (b.frame or 0)
		end)
		for _, ref in ipairs(refs) do
			state.byKey[MicroKeyGroupSupport.editorKeyId(ref.jointPath, ref.frame)] = {
				groupId = groupId,
				keys = refs,
			}
		end
	end
	return state
end

function MicroKeyGroupSupport.buildVisualState(viewModel)
	local state = {
		groupedKeyMap = {},
		groupedTrackClipsByPath = {},
		groupedRigClipsByName = {},
	}
	local rigNameByPath = {}
	local trackByPath = {}
	for _, track in ipairs((viewModel and (viewModel.tracks or viewModel.joints)) or {}) do
		if track and track.path then
			trackByPath[track.path] = track
		end
		if track and track.path and track.rigName then
			rigNameByPath[track.path] = track.rigName
		end
	end
	for groupId, group in pairs((viewModel and viewModel.groups) or {}) do
		local groupKeys = {}
		local selectKeys = {}
		local clipsByPath = {}
		local clipsByRigName = {}
		for keyId in pairs(group.keys or {}) do
			local jointPath, frame = MicroKeyGroupSupport.parseEditorKeyId(keyId)
			if jointPath and frame ~= nil then
				groupKeys[keyId] = true
				state.groupedKeyMap[keyId] = true
				selectKeys[#selectKeys + 1] = {
					jointPath = jointPath,
					frame = frame,
				}
				local clip = clipsByPath[jointPath]
				if not clip then
					clip = {
						groupId = groupId,
						mode = group.mode,
						name = group.name,
						kind = group.kind,
						sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
						minFrame = frame,
						maxFrame = frame,
						firstFrame = frame,
						selectKeys = {},
					}
					clipsByPath[jointPath] = clip
				else
					clip.minFrame = math.min(clip.minFrame, frame)
					clip.maxFrame = math.max(clip.maxFrame, frame)
					clip.firstFrame = math.min(clip.firstFrame, frame)
				end
				clip.selectKeys[#clip.selectKeys + 1] = {
					jointPath = jointPath,
					frame = frame,
				}
				local rigName = rigNameByPath[jointPath]
				if rigName then
					local rigClip = clipsByRigName[rigName]
					if not rigClip then
						rigClip = {
							groupId = groupId,
							mode = group.mode,
							name = group.name,
							kind = group.kind,
							sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
							minFrame = frame,
							maxFrame = frame,
							firstFrame = frame,
						}
						clipsByRigName[rigName] = rigClip
					else
						rigClip.minFrame = math.min(rigClip.minFrame, frame)
						rigClip.maxFrame = math.max(rigClip.maxFrame, frame)
						rigClip.firstFrame = math.min(rigClip.firstFrame, frame)
					end
				end
			end
		end
		table.sort(selectKeys, function(a, b)
			if a.frame == b.frame then
				return tostring(a.jointPath) &lt; tostring(b.jointPath)
			end
			return (a.frame or 0) &lt; (b.frame or 0)
		end)
		local physicsFolderPath = type(group.folderPath) == "string" and group.folderPath or nil
		if group.kind == "PhysicsClip" then
			for _, keyRef in ipairs(selectKeys) do
				local keyTrack = trackByPath[keyRef.jointPath]
				local parentTrack = keyTrack and keyTrack.parentTrackPath and trackByPath[keyTrack.parentTrackPath] or nil
				local currentFolderPath = (parentTrack and parentTrack.folderPath) or (keyTrack and keyTrack.folderPath)
				if type(currentFolderPath) == "string" then
					physicsFolderPath = currentFolderPath
					break
				end
			end
		end
		if group.kind == "PhysicsClip" and type(physicsFolderPath) == "string" and #selectKeys &gt; 0 then
			state.groupedTrackClipsByPath[physicsFolderPath] = state.groupedTrackClipsByPath[physicsFolderPath] or {}
			state.groupedTrackClipsByPath[physicsFolderPath][#state.groupedTrackClipsByPath[physicsFolderPath] + 1] = {
				groupId = groupId,
				mode = group.mode,
				name = group.name,
				kind = group.kind,
				isAggregate = true,
				sourceSpanFrames = tonumber(group.sourceSpanFrames) or tonumber(group.repeatSourceSpanFrames),
				minFrame = selectKeys[1].frame,
				maxFrame = selectKeys[#selectKeys].frame,
				firstFrame = selectKeys[1].frame,
				selectKeys = selectKeys,
				groupKeys = groupKeys,
			}
		end
		for jointPath, clip in pairs(clipsByPath) do
			local keyTrack = trackByPath[jointPath]
			local isPhysicsEventTrack = group.kind == "PhysicsClip"
				and keyTrack
				and (keyTrack.targetScope == "ParticleEvent"
					or keyTrack.trackType == "Particle Event"
					or keyTrack.trackType == "ParticleEvent")
			-- A particle Emit key is intentionally instantaneous, but its editable
			-- block represents the complete parent Physics Clip. Use the shared
			-- group bounds for the Micro timing handle while leaving the event key
			-- at its real frame.
			if isPhysicsEventTrack and #selectKeys &gt; 0 then
				clip.minFrame = selectKeys[1].frame
				clip.maxFrame = selectKeys[#selectKeys].frame
			end
			table.sort(clip.selectKeys, function(a, b)
				return a.frame &lt; b.frame
			end)
			clip.groupKeys = groupKeys
			state.groupedTrackClipsByPath[jointPath] = state.groupedTrackClipsByPath[jointPath] or {}
			state.groupedTrackClipsByPath[jointPath][#state.groupedTrackClipsByPath[jointPath] + 1] = clip
		end
		for rigName, clip in pairs(clipsByRigName) do
			clip.selectKeys = selectKeys
			clip.groupKeys = groupKeys
			clip.isAggregate = true
			state.groupedRigClipsByName[rigName] = state.groupedRigClipsByName[rigName] or {}
			state.groupedRigClipsByName[rigName][#state.groupedRigClipsByName[rigName] + 1] = clip
		end
	end
	return state
end

function MicroKeyGroupSupport.appendSignatureParts(signatureParts, viewModel)
	for groupId, group in pairs((viewModel and viewModel.groups) or {}) do
		signatureParts[#signatureParts + 1] = "group:" .. tostring(groupId)
		signatureParts[#signatureParts + 1] = "mode:" .. tostring(group.mode or "")
		signatureParts[#signatureParts + 1] = "span:" .. tostring(group.sourceSpanFrames or group.repeatSourceSpanFrames or "")
		signatureParts[#signatureParts + 1] = "name:" .. tostring(group.name or "")
		signatureParts[#signatureParts + 1] = "kind:" .. tostring(group.kind or "")
		signatureParts[#signatureParts + 1] = "folder:" .. tostring(group.folderPath or "")
		local keyIds = {}
		for keyId in pairs(group.keys or {}) do
			keyIds[#keyIds + 1] = tostring(keyId)
		end
		table.sort(keyIds)
		for _, keyId in ipairs(keyIds) do
			signatureParts[#signatureParts + 1] = keyId
		end
	end
end

local function getMicroTimelineStatus(timeline, options)
	if not timeline then
		return "No timeline"
	end
	local _, selectedKeys = getMicroSelectedKeyMap(options)
	if #selectedKeys &gt; 0 then
		return string.format("%d selected key%s", #selectedKeys, #selectedKeys == 1 and "" or "s")
	end
	local _, selectedTracks = getMicroSelectedTrackMap(options)
	if #selectedTracks &gt; 0 then
		if #selectedTracks == 1 and type(timeline.getTrackByPath) == "function" then
			local track = timeline:getTrackByPath(selectedTracks[1])
			local name = track and tostring(track.part1 or track.name or track.rigName or track.path or "Selected track") or tostring(selectedTracks[1])
			if #name &gt; 30 then
				name = string.sub(name, 1, 29) .. "..."
			end
			return name
		end
		return string.format("%d selected track%s", #selectedTracks, #selectedTracks == 1 and "" or "s")
	end
	return getTimelineStatus(timeline)
end

local function updateMicroAutoSaveStatus(host, editorState)
	if not (host and host._autoSaveLabel and host._autoSaveDot) then
		return
	end
	local autoSave = type(editorState) == "table" and editorState.autoSave or {}
	local autoSaveLabel = tostring(autoSave.label or "Ready")
	host._autoSaveLabel.Text = autoSaveLabel == "Ready" and "Saved" or ("AS - " .. autoSaveLabel)
	local state = tostring(autoSave.state or "")
	if state == "error" then
		host._autoSaveDot.BackgroundColor3 = Color3.fromRGB(218, 86, 112)
	elseif state == "pending" or autoSave.isPending then
		host._autoSaveDot.BackgroundColor3 = Color3.fromRGB(236, 190, 92)
	else
		host._autoSaveDot.BackgroundColor3 = theme().Success or Color3.fromRGB(80, 220, 140)
	end
end

local function updateMicroHidePlaybackToggle(host, editorState)
	if not (host and host._hidePlaybackButton) then
		return
	end
	local active = type(editorState) == "table" and editorState.hideDuringPlayback == true
	host._hidePlaybackButton.Text = active and "UI Off" or "Hide"
	host._hidePlaybackButton.BackgroundColor3 = active and theme().Accent or theme().PanelSoft
	host._hidePlaybackButton.TextColor3 = ThemeService.getReadableTextColor(active and theme().Accent or theme().PanelSoft)
	host._hidePlaybackButton:SetAttribute("MegMoThemeBackgroundRole", active and "Accent" or "PanelSoft")
	host._hidePlaybackButton:SetAttribute("MegMoThemeTextRole", "__auto")
end

local function getThemeSignature()
	local palette = theme()
	return table.concat({
		tostring(ThemeService.getCurrentThemeId and ThemeService.getCurrentThemeId() or ""),
		tostring(palette.Background),
		tostring(palette.Panel),
		tostring(palette.PanelSoft),
		tostring(palette.Accent),
		tostring(palette.Text),
	}, "|")
end

local function clearGuiChildren(parent)
	for _, child in ipairs(parent:GetChildren()) do
		local isSurfaceChild = child:GetAttribute("MegMoSurface") == true
			or child.Name == "MegMoPanelTexture"
			or child.Name == "MegMoPanelGradient"
		if not child:IsA("UICorner")
			and not child:IsA("UIStroke")
			and not child:IsA("UIPadding")
			and not child:IsA("UIListLayout")
			and not child:IsA("UIGradient")
			and not isSurfaceChild
		then
			child:Destroy()
		end
	end
end

local function truncateName(value, maxLength)
	value = tostring(value or "Track")
	maxLength = maxLength or 18
	if #value &lt;= maxLength then
		return value
	end
	return string.sub(value, 1, math.max(1, maxLength - 1)) .. "..."
end

local function getSettingNumber(plugin, key, fallback)
	if not plugin then
		return fallback
	end
	local ok, value = pcall(function()
		return plugin:GetSetting(key)
	end)
	value = ok and tonumber(value) or nil
	return value or fallback
end

local function setSettingNumber(plugin, key, value)
	if not plugin then
		return
	end
	pcall(function()
		plugin:SetSetting(key, tonumber(value) or 0)
	end)
end

local function getSettingString(plugin, key, fallback)
	if not plugin then
		return fallback
	end
	local ok, value = pcall(function()
		return plugin:GetSetting(key)
	end)
	if ok and type(value) == "string" and value ~= "" then
		return value
	end
	return fallback
end

local function setSettingString(plugin, key, value)
	if not plugin then
		return
	end
	pcall(function()
		plugin:SetSetting(key, tostring(value or ""))
	end)
end

local function readSavedPosition(plugin, prefix, defaultPosition)
	return UDim2.fromOffset(
		getSettingNumber(plugin, prefix .. "X", defaultPosition.X.Offset),
		getSettingNumber(plugin, prefix .. "Y", defaultPosition.Y.Offset)
	)
end

local function readSavedSize(plugin, prefix, defaultSize, minSize, maxSize)
	local width = getSettingNumber(plugin, prefix .. "W", defaultSize.X.Offset)
	local height = getSettingNumber(plugin, prefix .. "H", defaultSize.Y.Offset)
	minSize = minSize or MIN_PANEL_SIZE
	maxSize = maxSize or MAX_PANEL_SIZE
	return UDim2.fromOffset(
		math.clamp(width, minSize.X, maxSize.X),
		math.clamp(height, minSize.Y, maxSize.Y)
	)
end

local function savePosition(plugin, prefix, target)
	if not target then
		return
	end
	setSettingNumber(plugin, prefix .. "X", target.Position.X.Offset)
	setSettingNumber(plugin, prefix .. "Y", target.Position.Y.Offset)
end

local function saveGeometry(plugin, prefix, target)
	if not target then
		return
	end
	savePosition(plugin, prefix, target)
	setSettingNumber(plugin, prefix .. "W", target.AbsoluteSize.X)
	setSettingNumber(plugin, prefix .. "H", target.AbsoluteSize.Y)
end

local function makeDraggable(handle, target, onDragEnd, onDragMove)
	local dragging = false
	local dragStart
	local startPosition
	local function stopDrag()
		if not dragging then
			return
		end
		dragging = false
		if type(onDragEnd) == "function" then
			onDragEnd()
		end
	end

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		dragging = true
		dragStart = input.Position
		startPosition = target.Position
	end)

	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopDrag()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = input.Position - dragStart
		target.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		if type(onDragMove) == "function" then
			onDragMove()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopDrag()
		end
	end)
end

local function blockClickThrough(guiObject)
	guiObject.Active = true
	guiObject.InputBegan:Connect(function() end)
	guiObject.InputChanged:Connect(function() end)
	guiObject.InputEnded:Connect(function() end)
end

local function makePopupSurfacesOpaque(root)
	if not root then
		return
	end

	local function apply(instance)
		if instance:IsA("UIGradient") and instance.Name == "MegMoPanelGradient" then
			instance.Transparency = NumberSequence.new(0)
		elseif instance:IsA("GuiObject") and instance:FindFirstChild("MegMoPanelGradient") then
			instance.BackgroundTransparency = 0
		end
	end

	apply(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		apply(descendant)
	end
end

local function makeInputSink(parent)
	local sink = make("TextButton", {
		Name = "InputSink",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 1,
	}, parent)
	blockClickThrough(sink)
	pcall(function()
		sink.Modal = true
	end)
	return sink
end

local function setMiddlePanModalBlocker(parent, blocker, enabled, name, zIndex)
	if enabled then
		if blocker and blocker.Parent then
			blocker.Visible = true
			return blocker
		end
		local nextBlocker = make("TextButton", {
			Name = name or "MiddlePanCameraBlocker",
			Active = true,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			Visible = true,
			ZIndex = zIndex or 100000,
		}, parent)
		blockClickThrough(nextBlocker)
		pcall(function()
			nextBlocker.Modal = true
		end)
		return nextBlocker
	end
	if blocker then
		blocker.Visible = false
	end
	return blocker
end

local function getMicroBakeReadiness(options)
	local timeline = type(options.getTimeline) == "function" and options.getTimeline() or nil
	if not timeline then
		return false, "Timeline is not ready yet."
	end
	local tracksOk, tracks = pcall(function()
		return timeline:getTracks()
	end)
	if not tracksOk or type(tracks) ~= "table" or #tracks == 0 then
		return false, "Add a rig or object track before baking preview."
	end
	local countOk, keyCount = pcall(function()
		return timeline:getKeyframeCount()
	end)
	if not countOk or tonumber(keyCount or 0) &lt;= 0 then
		return false, "Add at least one keyframe before baking preview."
	end
	return true, nil
end

local function mountMicroBakeProgress(parent)
	local overlay = make("TextButton", {
		Name = "BakeProgressOverlay",
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.42,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Visible = false,
		ZIndex = 8800,
	}, parent)
	blockClickThrough(overlay)
	pcall(function()
		overlay.Modal = true
	end)

	local card = make("Frame", {
		Name = "BakeProgressCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme().Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(320, 112),
		ZIndex = 8801,
	}, overlay)
	setBackgroundRole(card, "Panel")
	corner(card, 10)
	stroke(card, theme().Accent, 0.16, 1, "Accent")

	local title = text(card, {
		Name = "Title",
		Font = Enum.Font.GothamBold,
		Text = "Preparing Preview",
		TextSize = 14,
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(1, -36, 0, 20),
		ZIndex = 8802,
	})
	local detail = text(card, {
		Name = "Detail",
		Text = "Building optimized playback data...",
		TextColor3 = theme().MutedText,
		TextSize = 11,
		TextWrapped = true,
		Position = UDim2.fromOffset(18, 39),
		Size = UDim2.new(1, -36, 0, 32),
		ZIndex = 8802,
	})
	detail:SetAttribute("MegMoThemeTextRole", "MutedText")

	local track = make("Frame", {
		Name = "ProgressTrack",
		BackgroundColor3 = theme().PanelSoft,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(18, 82),
		Size = UDim2.new(1, -36, 0, 10),
		ZIndex = 8802,
	}, card)
	track:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	corner(track, 5)

	local fill = make("Frame", {
		Name = "ProgressFill",
		BackgroundColor3 = theme().Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 8803,
	}, track)
	fill:SetAttribute("MegMoThemeBackgroundRole", "Accent")
	corner(fill, 5)

	local state = {
		_hideToken = 0,
		overlay = overlay,
		title = title,
		detail = detail,
		fill = fill,
	}

	function state:show(nextTitle, nextDetail, progress)
		self._hideToken += 1
		self.title.Text = tostring(nextTitle or "Preparing Preview")
		self.detail.Text = tostring(nextDetail or "Building optimized playback data...")
		self.fill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 1), 0, 1, 0)
		self.overlay.Visible = true
	end

	function state:update(progress, nextDetail)
		if nextDetail then
			self.detail.Text = tostring(nextDetail)
		end
		self.fill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 1), 0, 1, 0)
	end

	function state:hideAfter(delaySeconds)
		self._hideToken += 1
		local token = self._hideToken
		task.delay(delaySeconds or 0, function()
			if token == self._hideToken and self.overlay then
				self.overlay.Visible = false
			end
		end)
	end

	return state
end

local function configureMicroBakePreview(options, progressHost, getStatusLabel, requestRefresh)
	local rawBakePreview = options._microRawBakePreview
	if type(rawBakePreview) ~= "function" then
		rawBakePreview = options.onBakePreview
		options._microRawBakePreview = rawBakePreview
	end
	options.onBakePreview = function(...)
		if not progressHost then
			return safeCall(rawBakePreview, ...)
		end

		local function setBakeStatus(message)
			local label = type(getStatusLabel) == "function" and getStatusLabel() or nil
			if label then
				label.Text = tostring(message or "")
			end
		end

		progressHost:show("Preparing Preview", "Checking timeline before baking...", 0.12)
		local ready, readyMessage = getMicroBakeReadiness(options)
		if not ready then
			progressHost:update(1, readyMessage)
			progressHost:hideAfter(1.1)
			setBakeStatus(readyMessage)
			return false, readyMessage
		end

		progressHost:update(0.42, "Building optimized playback data...")
		local ok, message = safeCall(rawBakePreview, ...)
		local status = message or (ok and "Preview cache ready." or "Preview bake failed. Realtime playback is still available.")
		progressHost:update(1, status)
		progressHost:hideAfter(ok and 0.55 or 1.1)
		setBakeStatus(status)
		if type(requestRefresh) == "function" then
			task.defer(requestRefresh)
		end
		return ok, status
	end
end

function MicroWidgetController._positionMicroTooltipNear(guiObject, toolHint, hintText, yOffset)
	if not guiObject or not toolHint then
		return
	end
	local tooltipRoot = toolHint:FindFirstAncestorWhichIsA("ScreenGui")
	local cameraEditorOverlay = tooltipRoot and tooltipRoot:FindFirstChild("CameraTrackEditorOverlay", true)
	if cameraEditorOverlay and cameraEditorOverlay.Visible then
		toolHint.Visible = false
		return
	end
	local hintString = tostring(hintText or "")
	toolHint.Text = hintString
	local height = math.max(20, toolHint.AbsoluteSize.Y)
	local measuredWidth = math.floor((toolHint.TextBounds.X or 0) + 18)
	local estimatedWidth = math.floor((#hintString * 7) + 22)
	local parent = toolHint.Parent
	local parentOffset = Vector2.new(0, 0)
	local parentSize = nil
	if parent and parent:IsA("GuiObject") then
		parentOffset = parent.AbsolutePosition
		parentSize = parent.AbsoluteSize
	end
	local maxWidth = parentSize and math.max(120, math.min(520, parentSize.X - 12)) or 520
	local width = math.clamp(math.max(measuredWidth, estimatedWidth), 80, maxWidth)
	toolHint.Size = UDim2.fromOffset(width, height)
	local buttonPosition = guiObject.AbsolutePosition
	local buttonSize = guiObject.AbsoluteSize
	local x = math.floor(buttonPosition.X - parentOffset.X + (buttonSize.X * 0.5) - (width * 0.5))
	local y = math.floor(buttonPosition.Y - parentOffset.Y + buttonSize.Y + (yOffset or 8))
	if parentSize then
		x = math.clamp(x, 6, math.max(6, parentSize.X - width - 6))
		y = math.clamp(y, 6, math.max(6, parentSize.Y - height - 6))
	end
	toolHint.Position = UDim2.fromOffset(x, y)
	toolHint.Visible = true
end

function MicroWidgetController._attachMicroSimpleTooltip(guiObject, toolHint, hintText)
	if not guiObject or not toolHint then
		return
	end
	local function hideTooltip()
		if toolHint then
			toolHint.Visible = false
		end
	end
	guiObject.MouseEnter:Connect(function()
		MicroWidgetController._positionMicroTooltipNear(guiObject, toolHint, hintText, 6)
	end)
	guiObject.MouseLeave:Connect(hideTooltip)
	if guiObject:IsA("GuiButton") then
		guiObject.Activated:Connect(hideTooltip)
	end
end

function MicroWidgetController._getCompactActionTooltipText(info, actionName)
	local details = info and info.actionDetails and info.actionDetails[actionName]
	if type(details) == "table" then
		return tostring(details[1] or "")
	elseif type(details) == "string" then
		return details
	end
	return tostring(actionName or "")
end

function MicroWidgetController._getMicroDropdownCurrentValue(tabName, actionName, options)
	if tabName ~= "Enhance" and tabName ~= "Keyframes" then
		return nil
	end
	if actionName == "Ease Style" or actionName == "Ease" or actionName == "Ease Dir" then
		local state = type(options) == "table"
			and type(options.getEditorState) == "function"
			and (options.getEditorState() or {})
			or {}
		local keyOptions = type(state.selectedKeyOptions) == "table" and state.selectedKeyOptions or {}
		if actionName == "Ease Style" or actionName == "Ease" then
			return tostring(keyOptions.easingStyle or Constants.DEFAULT_EASING_STYLE)
		end
		return tostring(keyOptions.easingDirection or Constants.DEFAULT_EASING_DIRECTION)
	elseif actionName == "Priority" then
		local timeline = type(options) == "table"
			and type(options.getTimeline) == "function"
			and options.getTimeline()
			or nil
		if timeline and type(timeline.getPriority) == "function" then
			return tostring(timeline:getPriority() or "Action")
		end
		return "Action"
	end
	return nil
end

function MicroWidgetController._getCompactActionButtonText(tabName, actionName, options)
	local currentValue = MicroWidgetController._getMicroDropdownCurrentValue(tabName, actionName, options)
	if not currentValue then
		return tostring(actionName or "")
	end
	if actionName == "Ease Style" or actionName == "Ease" then
		return "Ease: " .. currentValue .. " v"
	elseif actionName == "Ease Dir" then
		return "Dir: " .. currentValue .. " v"
	elseif actionName == "Priority" then
		return "Priority: " .. currentValue .. " v"
	end
	return tostring(actionName or "") .. ": " .. currentValue .. " v"
end

function MicroWidgetController._clearCompactDropdown(dropdownLayer)
	if not dropdownLayer then
		return
	end
	clearGuiChildren(dropdownLayer)
	dropdownLayer.Visible = false
	dropdownLayer:SetAttribute("MegMoOpenAction", nil)
end

function MicroWidgetController._showCompactActionDropdown(dropdownLayer, popup, anchorButton, info, tabName, actionName, dropdownSpec, options, statusCallback, afterActionCallback)
	if not dropdownLayer or not popup or not anchorButton or type(dropdownSpec) ~= "table" then
		return
	end
	local optionNames = dropdownSpec.options or {}
	if #optionNames == 0 then
		return
	end
	MicroWidgetController._clearCompactDropdown(dropdownLayer)
	dropdownLayer.Visible = true
	dropdownLayer:SetAttribute("MegMoOpenAction", tostring(actionName or ""))

	local optionHeight = 26
	local optionStep = optionHeight + 4
	local visibleRows = math.clamp(math.floor(tonumber(dropdownSpec.visibleRows) or 6), 1, 8)
	local desiredHeight = math.min((#optionNames * optionStep) + 8, (visibleRows * optionStep) + 8)
	local anchorX = anchorButton.AbsolutePosition.X - popup.AbsolutePosition.X
	local anchorY = anchorButton.AbsolutePosition.Y - popup.AbsolutePosition.Y + anchorButton.AbsoluteSize.Y + 4
	local popupHeight = math.max(1, popup.AbsoluteSize.Y)
	if anchorY + desiredHeight &gt; popupHeight - 8 then
		anchorY = math.max(42, anchorButton.AbsolutePosition.Y - popup.AbsolutePosition.Y - desiredHeight - 4)
	end
	local dropdownWidth = math.max(142, anchorButton.AbsoluteSize.X)
	local anchorMaxX = math.max(8, popup.AbsoluteSize.X - dropdownWidth - 8)
	anchorX = math.clamp(anchorX, 8, anchorMaxX)

	local dropdown = make("ScrollingFrame", {
		Name = tostring(actionName or "Action") .. "Dropdown",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		BackgroundColor3 = theme().Panel,
		BorderSizePixel = 0,
		CanvasPosition = Vector2.new(0, 0),
		CanvasSize = UDim2.fromOffset(0, (#optionNames * optionStep) + 8),
		Position = UDim2.fromOffset(anchorX, anchorY),
		ScrollBarImageColor3 = theme().Border,
		ScrollBarThickness = #optionNames &gt; visibleRows and 4 or 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.fromOffset(dropdownWidth, desiredHeight),
		ZIndex = 91,
	}, dropdownLayer)
	setBackgroundRole(dropdown, "Panel")
	UiHelpers.applySectionSurface(dropdown)
	blockClickThrough(dropdown)
	corner(dropdown, 7)
	stroke(dropdown, theme().Accent, 0.18, 1, "Accent")
	padding(dropdown, 4)
	make("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, dropdown)

	local currentValue = MicroWidgetController._getMicroDropdownCurrentValue(tabName, actionName, options)
	local toolHint = dropdownLayer.Parent and dropdownLayer.Parent.Parent and dropdownLayer.Parent.Parent:FindFirstChild("ToolHint") or nil
	for index, optionName in ipairs(optionNames) do
		local selected = tostring(optionName) == tostring(currentValue)
		local optionButton = button(dropdown, tostring(optionName), selected and theme().Accent or theme().PanelSoft)
		optionButton.LayoutOrder = index
		optionButton.Size = UDim2.new(1, -8, 0, 24)
		optionButton.TextSize = 11
		optionButton.ZIndex = 92
		if toolHint then
			MicroWidgetController._attachMicroSimpleTooltip(optionButton, toolHint, "Set " .. tostring(actionName) .. " to " .. tostring(optionName) .. ".")
		end
		optionButton.MouseButton1Click:Connect(function()
			local optionActionName = tostring(dropdownSpec.actionPrefix or "") .. tostring(optionName)
			MicroWidgetController._clearCompactDropdown(dropdownLayer)
			local didRun, result = runMicroAction(tabName, optionActionName, options, nil)
			if type(statusCallback) == "function" then
				statusCallback(result, tostring(optionName) .. " selected.")
			end
			if actionName == "Ease Style" or actionName == "Ease" then
				anchorButton.Text = "Ease: " .. tostring(optionName) .. " v"
			elseif actionName == "Ease Dir" then
				anchorButton.Text = "Dir: " .. tostring(optionName) .. " v"
			elseif actionName == "Priority" then
				anchorButton.Text = "Priority: " .. tostring(optionName) .. " v"
			else
				anchorButton.Text = MicroWidgetController._getCompactActionButtonText(tabName, actionName, options)
			end
			if didRun and type(afterActionCallback) == "function" then
				afterActionCallback()
			end
		end)
	end
end

function MicroWidgetController._setMicroCenteredButtonIcon(button, iconKey, size)
	for _, child in ipairs(button:GetChildren()) do
		if child:IsA("UIPadding") then
			child.PaddingTop = UDim.new(0, 0)
			child.PaddingBottom = UDim.new(0, 0)
			child.PaddingLeft = UDim.new(0, 0)
			child.PaddingRight = UDim.new(0, 0)
		elseif child.Name == "MegMoButtonTextOverlay" and child:IsA("GuiObject") then
			child.Visible = false
		elseif child.Name == "MegMoButtonGradientOverlay" and child:IsA("GuiObject") then
			child.Position = UDim2.fromScale(0, 0)
			child.Size = UDim2.fromScale(1, 1)
		end
	end
	local icon = UiHelpers.setButtonIcon(button, iconKey, {
		iconOnly = true,
		size = size or 18,
	})
	if icon then
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.new(0.5, 0, 0.5, 0)
	end
	return icon
end

function MicroWidgetController._attachEdgeResizeHandles(target, minSize, maxSize, onResizeStateChanged)
	if not target or not target:IsA("GuiObject") then
		return
	end
	if target:FindFirstChild("SevenKg2EdgeResizeRight") then
		return
	end
	minSize = minSize or MIN_PANEL_SIZE
	maxSize = maxSize or MAX_PANEL_SIZE

	local EDGE_THICKNESS = 7
	local EDGE_INSET = 14
	local specs = {
		{
			name = "SevenKg2EdgeResizeRight",
			anchor = Vector2.new(1, 0.5),
			position = UDim2.new(1, 0, 0.5, 0),
			size = UDim2.new(0, EDGE_THICKNESS, 1, -(EDGE_INSET * 2)),
			axis = "X",
			sign = 1,
		},
		{
			name = "SevenKg2EdgeResizeLeft",
			anchor = Vector2.new(0, 0.5),
			position = UDim2.new(0, 0, 0.5, 0),
			size = UDim2.new(0, EDGE_THICKNESS, 1, -(EDGE_INSET * 2)),
			axis = "X",
			sign = -1,
		},
		{
			name = "SevenKg2EdgeResizeBottom",
			anchor = Vector2.new(0.5, 1),
			position = UDim2.new(0.5, 0, 1, 0),
			size = UDim2.new(1, -(EDGE_INSET * 2), 0, EDGE_THICKNESS),
			axis = "Y",
			sign = 1,
		},
		{
			name = "SevenKg2EdgeResizeTop",
			anchor = Vector2.new(0.5, 0),
			position = UDim2.new(0.5, 0, 0, 0),
			size = UDim2.new(1, -(EDGE_INSET * 2), 0, EDGE_THICKNESS),
			axis = "Y",
			sign = -1,
		},
	}

	for _, spec in ipairs(specs) do
		local edge = Instance.new("ImageButton")
		edge.Name = spec.name
		edge.Active = true
		edge.AutoButtonColor = false
		edge.AnchorPoint = spec.anchor
		edge.BackgroundColor3 = theme().Accent
		edge.BackgroundTransparency = 1
		edge.BorderSizePixel = 0
		edge.Image = ""
		edge.Position = spec.position
		edge.Size = spec.size
		edge.ZIndex = 90
		edge.Parent = target
		edge:SetAttribute("MegMoThemeBackgroundRole", "Accent")
		local edgeCorner = Instance.new("UICorner")
		edgeCorner.CornerRadius = UDim.new(0, 4)
		edgeCorner.Parent = edge

		local dragging = false
		local startInput
		local startSize
		local startPosition

		local function setHighlight(on)
			edge.BackgroundTransparency = on and 0.25 or 1
		end

		local function stop()
			if not dragging then
				return
			end
			dragging = false
			setHighlight(false)
			if type(onResizeStateChanged) == "function" then
				onResizeStateChanged(false)
			end
		end

		edge.MouseEnter:Connect(function()
			setHighlight(true)
		end)
		edge.MouseLeave:Connect(function()
			if not dragging then
				setHighlight(false)
			end
		end)

		edge.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			dragging = true
			startInput = input.Position
			startSize = target.AbsoluteSize
			startPosition = target.Position
			setHighlight(true)
			if type(onResizeStateChanged) == "function" then
				onResizeStateChanged(true)
			end
		end)

		edge.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				stop()
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end
			local delta = input.Position - startInput
			local width = startSize.X
			local height = startSize.Y
			local offsetX = startPosition.X.Offset
			local offsetY = startPosition.Y.Offset
			if spec.axis == "X" then
				width = math.clamp(startSize.X + (delta.X * spec.sign), minSize.X, maxSize.X)
				if spec.sign &lt; 0 then
					offsetX = offsetX + (startSize.X - width)
				end
			else
				height = math.clamp(startSize.Y + (delta.Y * spec.sign), minSize.Y, maxSize.Y)
				if spec.sign &lt; 0 then
					offsetY = offsetY + (startSize.Y - height)
				end
			end
			target.Size = UDim2.fromOffset(math.floor(width), math.floor(height))
			target.Position = UDim2.new(
				startPosition.X.Scale,
				math.floor(offsetX),
				startPosition.Y.Scale,
				math.floor(offsetY)
			)
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				stop()
			end
		end)
	end
end

function MicroWidgetController._makeResizable(handle, target, onResizeStateChanged, minSize, maxSize)
	local resizing = false
	local resizeStart
	local startSize
	minSize = minSize or MIN_PANEL_SIZE
	maxSize = maxSize or MAX_PANEL_SIZE

	local function stopResize()
		if not resizing then
			return
		end
		resizing = false
		if type(onResizeStateChanged) == "function" then
			onResizeStateChanged(false)
		end
	end

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		resizing = true
		resizeStart = input.Position
		startSize = target.AbsoluteSize
		if type(onResizeStateChanged) == "function" then
			onResizeStateChanged(true)
		end
	end)

	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopResize()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not resizing or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = input.Position - resizeStart
		local width = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
		local height = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
		target.Size = UDim2.fromOffset(width, height)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopResize()
		end
	end)

	pcall(function()
		MicroWidgetController._attachEdgeResizeHandles(target, minSize, maxSize, onResizeStateChanged)
	end)
end

function MicroWidgetController._createMotionPopup(gui, panel, options, onClose)
	local tabName = "Motion"
	local panelPosition = panel and panel.Position or UDim2.fromOffset(96, 230)
	local panelSize = panel and panel.AbsoluteSize or Vector2.new(540, 310)
	local startX = panelPosition.X.Offset + math.min(panelSize.X + 12, 560)
	local startY = panelPosition.Y.Offset + 24
	local plugin = options and options.plugin
	local popupSettingPrefix = POPUP_SETTING_PREFIX .. tabName
	local defaultPopupSize = Vector2.new(980, 640)
	local minPopupSize = Vector2.new(560, 360)
	local maxPopupSize = Vector2.new(1320, 820)
	local modalShield = nil

	local popup = make("Frame", {
		Name = tabName .. "Popup",
		BackgroundColor3 = theme().Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = readSavedPosition(plugin, popupSettingPrefix, UDim2.fromOffset(startX, startY)),
		Size = readSavedSize(plugin, popupSettingPrefix, UDim2.fromOffset(defaultPopupSize.X, defaultPopupSize.Y), minPopupSize, maxPopupSize),
		Visible = false,
		ZIndex = 70,
	}, gui)
	popup.Destroying:Connect(function()
		if modalShield and modalShield.Parent then
			modalShield:Destroy()
		end
	end)
	setBackgroundRole(popup, "Panel")
	corner(popup, 8)
	UiHelpers.applyPanelSurface(popup)
	blockClickThrough(popup)
	local popupStroke = stroke(popup, theme().Accent, 0.12, 1, "Accent")

	local inputSink = make("TextButton", {
		Name = "InputSink",
		Active = true,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Modal = true,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 71,
	}, popup)
	blockClickThrough(inputSink)

	local titleBar = make("Frame", {
		Name = "TitleBar",
		BackgroundColor3 = theme().PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
		ZIndex = 72,
	}, popup)
	setBackgroundRole(titleBar, "PanelAlt")
	blockClickThrough(titleBar)
	corner(titleBar, 8)
	make("Frame", {
		Name = "TitleBarMask",
		BackgroundColor3 = titleBar.BackgroundColor3,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 8),
		ZIndex = 72,
	}, titleBar)
	makeDraggable(titleBar, popup, function()
		saveGeometry(plugin, popupSettingPrefix, popup)
	end)

	text(titleBar, {
		Name = "Title",
		Font = Enum.Font.GothamBold,
		Text = "Motion Builder",
		TextSize = 13,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0, 160, 1, 0),
		ZIndex = 73,
	})

	local motionStatusLabel = text(titleBar, {
		Name = "MotionStatus",
		Text = "",
		TextColor3 = theme().MutedText,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(132, 0),
		Size = UDim2.new(1, -170, 1, 0),
		ZIndex = 73,
	})
	motionStatusLabel.TextXAlignment = Enum.TextXAlignment.Left
	motionStatusLabel.Visible = false

	local close = button(titleBar, "X", theme().PanelSoft)
	close.Position = UDim2.new(1, -32, 0, 6)
	close.Size = UDim2.fromOffset(24, 22)
	close.ZIndex = 74

	local motionHost = make("Frame", {
		Name = "MotionHost",
		BackgroundColor3 = theme().Panel,
		BackgroundTransparency = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		ZIndex = 72,
	}, popup)
	setBackgroundRole(motionHost, "Panel")
	corner(motionHost, 8)
	local baseOnClose = onClose
	local mountedMotion
	local wrappedOnClose
	wrappedOnClose = function()
		if mountedMotion and type(mountedMotion.destroy) == "function" then
			mountedMotion.destroy()
			mountedMotion = nil
		end
		if type(baseOnClose) == "function" then
			baseOnClose()
		end
	end
	mountedMotion = MicroMotionPopupSupport.mount(motionHost, {
		getMotionBuilderViewModel = options and options.getMotionBuilderViewModel,
		onBindRig = options and options.onBindRig,
		onInsertDefaultRig = options and options.onInsertDefaultRig,
		onInsertAvatarRig = options and options.onInsertAvatarRig,
		onSelectRigInStudio = options and options.onSelectRigInStudio,
		onAddMotionMarker = options and options.onAddMotionMarker,
		onDeleteMotionMarker = options and options.onDeleteMotionMarker,
		onClearMotionMarkers = options and options.onClearMotionMarkers,
		onResetMotionSegments = options and options.onResetMotionSegments,
		onAddTrack = options and options.onAddTrack,
		onPreviewMotionPath = options and options.onPreviewMotionPath,
		onStopMotionPreview = options and options.onStopMotionPreview,
		onCreateMotionAnimation = options and options.onCreateMotionAnimation,
		onSelectMotionMarker = options and options.onSelectMotionMarker,
		onPreviewMotionSegment = options and options.onPreviewMotionSegment,
		onSetMotionSegmentMotion = options and options.onSetMotionSegmentMotion,
		onSetMotionSegmentClip = options and options.onSetMotionSegmentClip,
		onSetMotionDefaultClip = options and options.onSetMotionDefaultClip,
		onSetMotionSegmentPauseIdle = options and options.onSetMotionSegmentPauseIdle,
		onSetMotionSegmentDuration = options and options.onSetMotionSegmentDuration,
		onSetMotionSegmentPause = options and options.onSetMotionSegmentPause,
		onSetMotionSegmentBlend = options and options.onSetMotionSegmentBlend,
		onOpenMotionRecipeManager = options and options.onOpenMotionRecipeManager,
		onSaveMotionRecipe = options and options.onSaveMotionRecipe,
		onLoadMotionRecipe = options and options.onLoadMotionRecipe,
		onRenameMotionRecipe = options and options.onRenameMotionRecipe,
		onDeleteMotionRecipe = options and options.onDeleteMotionRecipe,
		onLoadPresetAnimations = options and options.onLoadPresetAnimations,
		onLoadMyAnimations = options and options.onLoadMyAnimations,
		onOpenPopup = options and options.onOpenPopup,
		getContentScale = function()
			local size = popup.AbsoluteSize
			local widthScale = size.X / defaultPopupSize.X
			local heightScale = size.Y / defaultPopupSize.Y
			return math.min(0.88, widthScale, heightScale)
		end,
		onBeginMotionPresetPick = function(segmentKey, segmentLabel, defaultMotion)
			if options then
				options._microMotionPresetPicker = {
					segmentKey = tostring(segmentKey or ""),
					segmentLabel = tostring(segmentLabel or ""),
					defaultMotion = tostring(defaultMotion or ""),
				}
			end
			task.defer(function()
				if type(wrappedOnClose) == "function" then
					wrappedOnClose()
				end
				if type(options.onOpenPopup) == "function" then
					options.onOpenPopup("Presets")
				end
			end)
		end,
		overlayParent = popup,
		onOpenCameraEffects = function()
			if type(onClose) == "function" then
				onClose()
			end
			if type(options.onOpenPopup) == "function" then
				options.onOpenPopup("Effects")
			end
		end,
		onClose = wrappedOnClose,
		setStatus = function(message)
			local statusText = tostring(message or "")
			motionStatusLabel.Text = statusText
			motionStatusLabel.Visible = statusText ~= ""
		end,
	})
	popup.Destroying:Connect(function()
		if mountedMotion and type(mountedMotion.destroy) == "function" then
			mountedMotion.destroy()
			mountedMotion = nil
		end
	end)
	if mountedMotion and type(mountedMotion.refresh) == "function" then
		mountedMotion.refresh()
	end
	onClose = wrappedOnClose

	local resizeGrip = make("ImageButton", {
		Name = "ResizeGrip",
		Active = true,
		AnchorPoint = Vector2.new(1, 1),
		AutoButtonColor = false,
		BackgroundColor3 = theme().PanelSoft,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = "rbxassetid://104703373565023",
		ImageColor3 = theme().Text,
		ImageTransparency = 1,
		Position = UDim2.new(1, -5, 1, -5),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(16, 16),
		ZIndex = 80,
	}, popup)
	resizeGrip:SetAttribute("MegMoThemeBackgroundRole", "PanelSoft")
	resizeGrip:SetAttribute("MegMoThemeImageRole", "Text")
	corner(resizeGrip, 4)
	blockClickThrough(resizeGrip)

	local gripResizing = false
	local function setResizeGripVisible(visible)
		resizeGrip.BackgroundTransparency = visible and 0.42 or 1
		resizeGrip.ImageTransparency = visible and 0.08 or 1
	end
	resizeGrip.MouseEnter:Connect(function()
		setResizeGripVisible(true)
	end)
	resizeGrip.MouseLeave:Connect(function()
		if gripResizing then
			return
		end
		setResizeGripVisible(false)
	end)
	MicroWidgetController._makeResizable(resizeGrip, popup, function(isResizing)
		gripResizing = isResizing
		setResizeGripVisible(isResizing)
		popupStroke.Color = isResizing and Color3.fromRGB(58, 176, 255) or theme().Accent
		popupStroke.Transparency = isResizing and 0 or 0.12
		popupStroke.Thickness = isResizing and 2 or 1
		if not isResizing then
			saveGeometry(plugin, popupSettingPrefix, popup)
		end
	end, minPopupSize, maxPopupSize)

	close.MouseButton1Click:Connect(function()
		if type(onClose) == "function" then
			onClose()
		end
	end)

	ThemeService.applyToGui(popup)
	UiMotion.popupIn(popup)
	return popup
end

