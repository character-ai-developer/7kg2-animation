end
local frameFromPosition = WidgetMathSupport.frameFromPosition
local frameFromInput = WidgetMathSupport.frameFromInput
local thresholdPassed = WidgetMathSupport.thresholdPassed
local makeTrackKeyId = WidgetMathSupport.makeTrackKeyId
local parseTrackKeyId = WidgetMathSupport.parseTrackKeyId
local rectsOverlap = WidgetMathSupport.rectsOverlap
local getTimelineMarkerRect = WidgetMathSupport.getTimelineMarkerRect
local function isShiftDown()
	return require(script.Parent:WaitForChild("WidgetControllerUtilitySupport")).isShiftDown(WidgetMathSupport, UserInputService)
end
local function isControlDown()
	local ok, state = pcall(function()
		return require(script.Parent:WaitForChild("ShortcutInputState"))
	end)
	if ok and state and type(state.isControlDown) == "function" then
		return state.isControlDown()
	end
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
end
local MAIN_SHORTCUT_DEBUG_ENABLED = false
local MAIN_SHORTCUT_DEBUG_KEYS = {
	[Enum.KeyCode.LeftControl] = true,
	[Enum.KeyCode.RightControl] = true,
	[Enum.KeyCode.A] = true,
	[Enum.KeyCode.C] = true,
	[Enum.KeyCode.D] = true,
	[Enum.KeyCode.V] = true,
	[Enum.KeyCode.Z] = true,
	[Enum.KeyCode.Y] = true,
	[Enum.KeyCode.R] = true,
	[Enum.KeyCode.T] = true,
	[Enum.KeyCode.Space] = true,
	[Enum.KeyCode.LeftBracket] = true,
	[Enum.KeyCode.RightBracket] = true,
}

local function isMainShortcutDebugKey(keyCode)
	return MAIN_SHORTCUT_DEBUG_ENABLED and MAIN_SHORTCUT_DEBUG_KEYS[keyCode] == true
end
local isShiftKey = WidgetMathSupport.isShiftKey
local isPointInsideGui = WidgetMathSupport.isPointInsideGui
local RIG_PROPERTY_OPTIONS = WidgetVisualSupport.RIG_PROPERTY_OPTIONS
local getEasingStyleColor = WidgetVisualSupport.getEasingStyleColor
local getTrackKeyframeColor = WidgetVisualSupport.getTrackKeyframeColor

function WidgetController.new(widget, plugin)
	local self = setmetatable({}, WidgetController)
	self._widget = widget
	self._plugin = plugin
	FontPreviewService.loadSavedFont(plugin)
	self._connections = {}
	self._timelineSession = nil
	self._keyframeDragSession = nil
	self._dragState = nil
	self._marqueeState = nil
	self._marqueeSession = nil
	self._timelineMarkers = {}
	self._trackWidgets = {}
	do
		local ok, cacheModule = pcall(function()
			return require(script.Parent:WaitForChild("TimelineDiamondCache"))
		end)
		self._timelineDiamondCache = (ok and type(cacheModule) == "table" and type(cacheModule.new) == "function")
			and cacheModule.new()
			or nil
		if not self._timelineDiamondCache then
			warn("[7kg2 Animator] Timeline diamond cache unavailable; using direct marker positions.")
		end
	end
	do
		local ok, rendererModule = pcall(function()
			return require(script.Parent:WaitForChild("Timeline"):WaitForChild("KeyframeRenderer"))
		end)
		self._keyframeRenderer = (ok and type(rendererModule) == "table" and type(rendererModule.new) == "function")
			and rendererModule.new(nil, {
				onMouseDown = function(markerData, startPos)
					self:_beginKeyframeDrag(markerData, startPos)
				end,
				onInputBegan = function(markerData, inputObject)
					if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
						self:_beginKeyframeDrag(markerData, positionToVector2(inputObject.Position))
					end
				end,
				onRightClick = function(markerData)
					self:_toggleKeyframeSelection(markerData, "Right-click")
				end,
				onHover = function(markerData, button, isHovering, cursorPoint)
					if isHovering and markerData and markerData.easingTooltip then
						self:_showTrackNameTooltip(button, "Keyframe easing", markerData.easingTooltip, cursorPoint)
					else
						self:_hideTrackNameTooltip()
					end
				end,
			})
			or nil
		if not self._keyframeRenderer then
			warn("[7kg2 Animator] Pooled keyframe renderer unavailable; using classic timeline diamonds.")
		end
	end
	self._trackReorderTargets = {}
	self._trackReorderSession = nil
	self._collapsedTracks = {}
	self._defaultCollapsedFolderTokens = {}
	self._rigHierarchyDefaultExpanded = {}
	self._hiddenTracks = {}
	self._lastAutoScrolledJointPath = nil
	self._laneOverlays = {}
	self._mouseInsideWidget = false
	self._shortcutFocus = false
	self._shortcutShiftHeld = false
	self._editingTextInput = nil
	self._keysDown = {}
	self._trackballAxisKeysDown = {}
	self._trackballAxisKeyTimes = {}
	self._shiftGraceUntil = 0
	self._timelineInput = TimelineInputController.new({
		plugin = plugin,
		contextActive = function()
			return self._widget.Enabled and not self:_isTextEditingActive()
		end,
		onShiftChanged = function(isHeld)
			self:_setShiftHeld(isHeld)
		end,
	})
	self._multiSelectLocked = false
	self._timelineZoom = 1
	self._timelinePixelWidth = 0
	self._visibleGridLanes = {}
	self._lastGridScrollX = nil
	self._lastGridZoom = nil
	self._lastGridDuration = nil
	self._lastTimelineScrollX = nil
	self._timeUnitMode = "Seconds"
	self._cameraRotationPreviewEnabled = false
	self._cameraRotationSeedText = nil
	self._lastViewModel = nil
	self._lastMotionMarkersSignature = nil
	self._lastMotionDefaultsSignature = nil
	self._lastMotionSegmentsSignature = nil
	self._lastTimelineRenderSignature = nil
	self._lastShortcutSignature = nil
	self._lastShortcutTime = 0
	self._timelineShortcutArmed = false
	self._timelineShortcutScope = nil
	self._timelineKeySelectionActive = false
	self._timelineKeyboardFocus = false
	self._mainShortcutControlMode = "megmo"
	self._mainDockWindowFocused = false
	self._mainShortcutOwner = nil
	self._mainTimelineShortcutOwned = false
	self._mainShortcutSinkBound = false
	self._mainShortcutSinkCallbacks = nil
	self._lastMainShortcutSinkBindAt = 0
	self._lastMainShortcutSinkReason = nil
	self._mainControlShortcutPollState = {}
	self._mainShortcutActivationToken = 0
	self._mainShortcutOwnershipAcquiredAt = 0
	self._mainShortcutSyntheticDockFocus = false
	self._shortcutKeyboardPluginActive = false
	self._lastAppliedThemeId = nil
	self._lastTrackClickPath = nil
	self._lastTrackClickTime = 0
	self._suppressNextTrackAutoScroll = false
	self._lastImportEntriesSignature = nil
	self._lastPresetEntriesSignature = nil
	self._presetPreviewStates = {}
	self._presetRigFilter = "All"
	self._presetPreviewEntry = nil
	self._motionDefaultPickerMotion = nil
	self._motionSegmentPickerKey = nil
	self._motionSegmentPickerLabel = nil
	self._openDropdown = nil
	self._openMotionSegmentKey = nil
	self._openMotionSegmentMenuType = nil
	self._openMotionDefaultMotion = nil
	self._selectedMotionRecipeName = nil
	self._motionRecipeListButtons = {}
	self._activeRigPropertyMenuRigName = nil
	self._activeRigPropertyTrackPath = nil
	self._activeCameraTrackPath = nil
	self._activeEffectTrackPath = nil
	self._activeParticlePropertyTrackPath = nil
	self._particleEditorBooleanValue = false
	self._particleEditorBooleanDirty = false
	self._effectFadeCustomColor = CUSTOM_FADE_COLORS.Black
	self._effectFadeCustomTransparency = 0.5
	self._effectFadeTransparencyDrag = nil
	self._uiSections = {}
	self._workspaceMode = "Animate"
	self._isViewportCardCollapsed = false
	self._isTransportCardCollapsed = false
	self._compactHeaderEnabled = false
	self._singleScreenModeEnabled = false
	self._rigPartHighlightEnabled = false
	self._viewportPartPickerSuspended = false
	self._avatarRigType = "R15Classic"
	self._hideDuringPlaybackEnabled = false
	self._layoutPreset = "Streamlined"
	self._collapsedPanels = {}
	self._layoutPanelVisibility = {
		RigExplorer = false,
		SessionSummary = true,
		MotionBuilder = true,
		Inspector = true,
		KeyframeTools = true,
	}
	self:_build()
	return self
end

function WidgetController:_closeDropdowns()
	if self._easingStyleDropdown then
		self._easingStyleDropdown.Visible = false
	end
	if self._easingDirectionDropdown then
		self._easingDirectionDropdown.Visible = false
	end
	if self._priorityDropdown then
		self._priorityDropdown.Visible = false
	end
	self._openDropdown = nil
	if self._openMotionSegmentKey then
		self._openMotionSegmentKey = nil
		self._openMotionSegmentMenuType = nil
		if self._lastViewModel then
			self:_renderMotionSegments(self._lastViewModel.motionSegments or {})
		end
	end
	if self._openMotionDefaultMotion then
		self._openMotionDefaultMotion = nil
		if self._lastViewModel then
			self:_renderMotionDefaults(self._lastViewModel)
		end
	end
	if self._timelineAddTrackMenu then
		self._timelineAddTrackMenu.Visible = false
	end
	self:_closeTopMenus()
end

function WidgetController:_toggleDropdown(dropdownName)
	local dropdown = nil
	if dropdownName == "style" then
		dropdown = self._easingStyleDropdown
	elseif dropdownName == "direction" then
		dropdown = self._easingDirectionDropdown
	elseif dropdownName == "priority" then
		dropdown = self._priorityDropdown
	end
	if not dropdown then
		return
	end

	local shouldOpen = not dropdown.Visible
	self:_closeDropdowns()
	dropdown.Visible = shouldOpen
	self._openDropdown = shouldOpen and dropdownName or nil
end

function WidgetController:_closeTopMenus()
	for menuKey, menu in pairs(self._topMenuFrames or {}) do
		menu.Visible = false
		local button = self._topMenuButtons and self._topMenuButtons[menuKey]
		if button then
			button.BackgroundTransparency = 1
			button.TextColor3 = Constants.THEME.MutedText
		end
	end
	self._openTopMenu = nil
end

function WidgetController:_toggleTopMenu(menuKey)
	local menu = self._topMenuFrames and self._topMenuFrames[menuKey]
	if not menu then
		return
	end

	local shouldOpen = not menu.Visible
	self:_closeDropdowns()
	if shouldOpen then
		menu.Visible = true
		self._openTopMenu = menuKey
		local button = self._topMenuButtons and self._topMenuButtons[menuKey]
		if button then
			button.BackgroundTransparency = 0
			button.TextColor3 = Constants.THEME.Text
		end
		self:_setShortcutHint(menuKey .. " menu open")
	end
end

function WidgetController:_runTopMenuAction(actionId, callbacks)
	callbacks = callbacks or self._callbacks or {}
	self:_closeTopMenus()

	local hint = "Menu action: " .. tostring(actionId)
	if actionId == "NewProject" then
		self:_showNewProjectPrompt()
		hint = "New animation prompt open"
	elseif actionId == "OpenFontPreview" then
		self:_setFontPreviewOverlayVisible(true)
		hint = "Font preview open"
	elseif tostring(actionId):match("^Theme_") then
		local themeId = tostring(actionId):match("^Theme_(.+)$")
		if themeId == "Custom" then
			self:_setCustomThemeOverlayVisible(true)
			hint = "Custom Theme picker open"
		else
			local success = nil
			local message = nil
			if callbacks.onSelectTheme then
				success, message = callbacks.onSelectTheme(themeId)
			end
			if success then
				self:_applyMountedTheme()
			end
			hint = message or ("Theme selected: " .. tostring(themeId))
		end
	elseif actionId == "Save" and callbacks.onSaveAnimation then
		callbacks.onSaveAnimation()
		hint = "Saved animation"
	elseif actionId == "ClosePlugin" then
		self:_showClosePluginPrompt()
		hint = "Close prompt open"
	elseif actionId == "Import" then
		self:_showImportDialog()
		hint = "Import dialog open"
	elseif actionId == "Export" and callbacks.onExportAnimation then
		callbacks.onExportAnimation()
		hint = "Exported animation"
	elseif actionId == "Undo" and callbacks.onUndo then
		callbacks.onUndo()
		hint = "Undo"
	elseif actionId == "Redo" and callbacks.onRedo then
		callbacks.onRedo()
		hint = "Redo"
	elseif actionId == "SelectAll" and callbacks.onSelectAllKeys then
		callbacks.onSelectAllKeys()
		hint = "Selected all keyframes"
	elseif actionId == "Copy" and callbacks.onCopyKeys then
		callbacks.onCopyKeys()
		hint = "Copied keyframes"
	elseif actionId == "Cut" and callbacks.onCutKeys then
		callbacks.onCutKeys()
		hint = "Cut keyframes"
	elseif actionId == "Paste" and callbacks.onPasteKeys then
		callbacks.onPasteKeys()
		hint = "Pasted keyframes"
	elseif actionId == "Delete" and self:_deleteSelectedTimelineKeyframes(callbacks, "Deleted keyframes") then
		hint = "Deleted keyframes"
	elseif actionId == "AddRig" and callbacks.onBindRig then
		callbacks.onBindRig()
		hint = "Added selected rig"
	elseif actionId == "InsertR6" and callbacks.onInsertDefaultRig then
		callbacks.onInsertDefaultRig("R6")
		hint = "Inserted R6 rig"
	elseif actionId == "InsertR15Classic" and callbacks.onInsertDefaultRig then
		callbacks.onInsertDefaultRig("R15", "Classic")
		hint = "Inserted R15 Classic rig"
	elseif actionId == "InsertR15Modern" and callbacks.onInsertDefaultRig then
		callbacks.onInsertDefaultRig("R15", "Modern")
		hint = "Inserted R15 Modern rig"
	elseif actionId == "InsertAvatar" and callbacks.onInsertAvatarRig then
		self:_showAvatarImportDialog()
		hint = "Avatar import dialog open"
	elseif actionId == "DefaultPose" and callbacks.onDefaultPoseKeyframes then
		callbacks.onDefaultPoseKeyframes(true)
		hint = "Reset selected limb to default pose"
	elseif actionId == "AddCamera" and callbacks.onAddTrack then
		callbacks.onAddTrack("Camera")
		hint = "Added camera track"
	elseif actionId == "AddObject" and callbacks.onAddTrack then
		callbacks.onAddTrack("Object")
		hint = "Added object track"
	elseif actionId == "AddModel" and callbacks.onAddTrack then
		callbacks.onAddTrack("Model")
		hint = "Added model track"
	elseif actionId == "AddRigCFrame" and callbacks.onAddTrack then
		callbacks.onAddTrack("RigCFrame")
		hint = "Added rig CFrame track"
	elseif actionId == "AddEvent" and callbacks.onAddTrack then
		callbacks.onAddTrack("Event")
		hint = "Added event track"
	elseif actionId == "RemoveSelected" then
		self:_showRemoveConfirmation()
		hint = "Choose Remove to confirm"
	elseif actionId == "PrevKey" and callbacks.onPreviousKeyframe then
		callbacks.onPreviousKeyframe()
		hint = "Previous keyframe"
	elseif actionId == "PlayPause" and callbacks.onPlayPause then
		callbacks.onPlayPause()
		hint = "Play / Pause"
	elseif actionId == "Stop" and callbacks.onStop then
		callbacks.onStop()
		hint = "Stopped playback"
	elseif actionId == "NextKey" and callbacks.onNextKeyframe then
		callbacks.onNextKeyframe()
		hint = "Next keyframe"
	elseif actionId == "MoveKeyLeft" and callbacks.onMoveKeyframeLeft then
		callbacks.onMoveKeyframeLeft()
		hint = "Moved keyframe left"
	elseif actionId == "MoveKeyRight" and callbacks.onMoveKeyframeRight then
		callbacks.onMoveKeyframeRight()
		hint = "Moved keyframe right"
	elseif actionId == "AnimateView" then
		self:_setWorkspaceMode("Animate")
		hint = "Animate workspace"
	elseif actionId == "PresetsView" then
		self:_setWorkspaceMode("Presets")
		if callbacks.onLoadPresetAnimations then
			callbacks.onLoadPresetAnimations()
		end
		hint = "Preset browser"
	elseif actionId == "LayoutView" then
		self:_setWorkspaceMode("Layout")
		hint = "Layout workspace"
	elseif actionId == "ScriptView" then
		self:_setWorkspaceMode("Script")
		hint = "Cutscene Maker"
	elseif actionId == "EffectsView" then
		self:_setEffectsOverlayVisible(true)
		hint = "Effects panel open"
	elseif actionId == "FacesView" then
		self:_setFacesOverlayVisible(true)
		hint = "Faces panel open"
	elseif actionId == "FullWorkspace" then
		self:_applyLayoutPreset("Full Workspace")
		hint = "Full workspace layout"
	elseif actionId == "CompactWorkspace" then
		self:_applyLayoutPreset("Compact")
		hint = "Compact layout"
	elseif actionId == "TimelineFocus" then
		self:_applyLayoutPreset("Timeline Focus")
		hint = "Timeline focus layout"
	elseif actionId == "SingleScreenMode" then
		if self._singleScreenModeEnabled then
			self:_toggleLayoutPanel("SingleScreenMode")
		else
			self:_applyLayoutPreset("Single Screen Mode")
		end
		hint = self._singleScreenModeEnabled and "Single Screen Mode enabled" or "Single Screen Mode disabled"
	elseif actionId == "HideDuringPlayback" and callbacks.onToggleHideDuringPlayback then
		local enabled, message = callbacks.onToggleHideDuringPlayback()
		self._hideDuringPlaybackEnabled = enabled == true
		hint = message or (enabled and "Plugin will hide during playback" or "Plugin will stay visible during playback")
	elseif actionId == "MoveTool" and callbacks.onSetGizmoMode then
		callbacks.onSetGizmoMode("Move")
		hint = "Move tool selected"
	elseif actionId == "RotateTool" and callbacks.onSetGizmoMode then
		callbacks.onSetGizmoMode("Rotate")
		hint = "Rotate tool selected"
	elseif actionId == "ToggleRotateSpace" and callbacks.onToggleRotateSpace then
		callbacks.onToggleRotateSpace()
		hint = "Toggled Local / World Move/Rotate"
	elseif actionId == "Group" and callbacks.onGroupKeys then
		callbacks.onGroupKeys()
		hint = "Grouped selected keyframes"
	elseif actionId == "Ungroup" and callbacks.onUngroupKeys then
		callbacks.onUngroupKeys()
		hint = "Ungrouped selected keyframes"
	elseif actionId == "Mirror" and callbacks.onMirrorKeys then
		callbacks.onMirrorKeys()
		hint = "Mirrored selected keyframes"
	elseif actionId == "Invert" and callbacks.onInvertKeys then
		callbacks.onInvertKeys()
		hint = "Inverted selected keyframes"
	elseif actionId == "ToggleSelectionHighlight" and callbacks.onToggleSelectionHighlight then
		local enabled, message = callbacks.onToggleSelectionHighlight()
		hint = message or (enabled and "Selection Highlight enabled" or "Selection Highlight disabled")
	elseif actionId == "ToggleRigPartHighlight" and callbacks.onToggleRigPartHighlight then
		self:_showRigPartHighlightPrompt()
		hint = "Viewport part picker options open"
	elseif actionId == "ToggleRigHandles" and callbacks.onToggleRigHandles then
		hint = select(2, callbacks.onToggleRigHandles()) or "Rig/bone handles toggled"
	elseif actionId == "EnhanceAnimation" then
		self:_setEnhanceOverlayVisible(true)
		hint = "Enhance Animation panel open"
	elseif actionId == "OpenOptions" then
		local _, message = self:_openSelectedOptionsPopup()
		hint = message
	elseif actionId == "PerformanceDebug" and callbacks.onTogglePerformanceDebug then
		local isEnabled, message = callbacks.onTogglePerformanceDebug()
		hint = message or (isEnabled and "Performance Debug enabled" or "Performance Debug disabled")
	elseif string.sub(tostring(actionId), 1, 4) == "Help" then
		self:_setHelpOverlayVisible(true, actionId)
		hint = "Help guide open"
	end

	self:_setShortcutHint(hint)
	if actionId ~= "Import" and self._widget.Enabled then
		self:_focusShortcutCapture("Shortcut capture: active after menu action")
	end
end

function WidgetController:_getTrackViewModel(path)
	if not path or not self._lastViewModel then
		return nil
	end

	for _, track in ipairs(self._lastViewModel.tracks or {}) do
		if track.path == path then
			return track
		end
	end

	return nil
end

function WidgetController:_showRemoveConfirmation(trackPath)
	if not self._confirmOverlay then
		return
	end
	self:_hideTrackActions()
	self._confirmMode = "RemoveTrack"

	local pendingPath = trackPath
	if not pendingPath and self._lastViewModel then
		pendingPath = (self._lastViewModel.selectedTrackPaths or {})[1]
	end
	if not pendingPath then
		self:_setShortcutHint("Select a rig or object track before removing it")
		return
	end

	self._pendingRemoveTrackPath = pendingPath
	local track = self:_getTrackViewModel(pendingPath)
	if self._confirmTitle then
		self._confirmTitle.Text = track and string.format("Remove '%s' from timeline?", tostring(track.name or track.trackType or "track")) or "Remove selected track?"
	end
	if self._confirmMessage then
		self._confirmMessage.Text = track and string.format(
			"This removes '%s' from this 7kg2 animation file and deletes its keyframes. Use Undo to restore it during this session.",
			tostring(track.name or track.trackType or "track")
		) or "This removes the selected rig/object from this animation file and deletes its keyframes. Use Undo to restore it during this session."
	end
	if self._confirmCancelButton then
		self._confirmCancelButton.Text = "Cancel"
	end
	if self._confirmRemoveButton then
		self._confirmRemoveButton.Text = "Remove"
		self._confirmRemoveButton.BackgroundColor3 = Constants.THEME.Danger
	end
	self._confirmOverlay.Visible = true
	self:_setShortcutHint("Confirm removal: choose Remove or Cancel")
end

function WidgetController:_showRigPartHighlightPrompt()
	if not self._confirmOverlay then
		if self._callbacks and self._callbacks.onToggleRigPartHighlight then
			self._callbacks.onToggleRigPartHighlight()
		end
		return
	end
	self:_hideTrackActions()
	self._confirmMode = "RigPartHighlight"
	self._pendingRemoveTrackPath = nil

	local enabled = self._rigPartHighlightEnabled ~= false
	if self._confirmTitle then
		self._confirmTitle.Text = enabled and "Disable viewport part picker?" or "Enable viewport part picker?"
	end
	if self._confirmMessage then
		self._confirmMessage.Text = enabled
			and "This stops the dedicated viewport body-part picker. The separate Selection Highlight option only controls the hover outline preview."
			or "This lets you click rig parts directly in the Studio viewport. Use Selection Highlight if you want a hover outline before clicking."
	end
	if self._confirmCancelButton then
		self._confirmCancelButton.Text = "Cancel"
	end
	if self._confirmRemoveButton then
		self._confirmRemoveButton.Text = enabled and "Disable" or "Enable"
		self._confirmRemoveButton.BackgroundColor3 = enabled and Constants.THEME.Danger or Constants.THEME.Accent
	end
	self._confirmOverlay.Visible = true
	self:_setShortcutHint("Viewport part picker options open")
end

function WidgetController:_hideRemoveConfirmation()
	if self._confirmOverlay then
		self._confirmOverlay.Visible = false
	end
	self._pendingRemoveTrackPath = nil
	self._confirmMode = nil
end

function WidgetController:_clearTrackFolderChoices()
	if not self._trackActionsFolderList then
		return
	end

	for _, child in ipairs(self._trackActionsFolderList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function WidgetController:_createTrackActionChoice(text, accentColor, onActivated)
	if not self._trackActionsFolderList then
		return nil
	end

	local button = create("TextButton", {
		Parent = self._trackActionsFolderList,
		AutoButtonColor = true,
		BackgroundColor3 = accentColor or Constants.THEME.PanelSoft,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Size = UDim2.new(1, -8, 0, 30),
		Text = text,
		TextColor3 = Constants.THEME.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 106,
	})
	createCorner(button, 8)
	create("UIPadding", {
		Parent = button,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	self:_connect(button.Activated, function()
		if type(onActivated) == "function" then
			onActivated()
		end
	end)
	return button
end

function WidgetController:_setAllTimelineFoldersCollapsed(collapsed)
	for _, trackData in ipairs((self._lastViewModel and self._lastViewModel.tracks) or {}) do
		if trackData.targetScope == "TimelineFolder" then
			self._collapsedTracks[trackData.path] = collapsed and true or nil
		end
	end
	if self._callbacks and self._callbacks.onRefresh then
		self._callbacks.onRefresh()
	end
end

function WidgetController:_hideTrackReorderIndicator()
	if self._trackReorderIndicator then
		self._trackReorderIndicator.Visible = false
	end
end

function WidgetController:_clearTrackReorderSession()
	local session = self._trackReorderSession
	if session then
		session.cancelled = true
		for _, connection in ipairs(session.connections or {}) do
			if connection then
				connection:Disconnect()
			end
		end
	end
	self._trackReorderSession = nil
	self._trackReorderActivePath = nil
	self._trackReorderDropTarget = nil
	self:_hideTrackReorderIndicator()
end

function WidgetController:_showTrackReorderIndicator(contentY)
	if not self._trackColumnList then
		return
	end
	local scrollY = self._laneContainer and self._laneContainer.CanvasPosition.Y or 0
	if not self._trackReorderIndicator or self._trackReorderIndicator.Parent ~= self._trackColumnList then
		self._trackReorderIndicator = create("Frame", {
			Parent = self._trackColumnList,
			BackgroundColor3 = Constants.THEME.Accent,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -8, 0, 2),
			Visible = false,
			ZIndex = 150,
		})
	end
	self._trackReorderIndicator.Position = UDim2.fromOffset(4, math.floor(contentY - scrollY + 0.5))
	self._trackReorderIndicator.Visible = true
end

function WidgetController:_autoScrollTrackColumnForPoint(point)
	if not self._laneContainer then
		return
	end

	local scroller = self._laneContainer
	local windowHeight = math.max(1, scroller.AbsoluteWindowSize.Y)
	local contentHeight = math.max(windowHeight, scroller.AbsoluteCanvasSize.Y)
	local maxScrollY = math.max(0, contentHeight - windowHeight)
	if maxScrollY &lt;= 0 then
		return
	end

	local localY = point.Y - scroller.AbsolutePosition.Y
	local edgeSize = math.min(56, math.max(24, scroller.AbsoluteSize.Y * 0.15))
	local delta = 0
	if localY &lt; edgeSize then
		delta = -math.max(4, (edgeSize - localY) * 0.22)
	elseif localY &gt; scroller.AbsoluteSize.Y - edgeSize then
		delta = math.max(4, (localY - (scroller.AbsoluteSize.Y - edgeSize)) * 0.22)
	end
	if delta == 0 then
		return
	end

	local current = scroller.CanvasPosition
	local nextY = math.clamp(current.Y + delta, 0, maxScrollY)
	scroller.CanvasPosition = Vector2.new(current.X, nextY)
	self:_positionStickyTrackRows(nextY)
end

function WidgetController:_getTrackReorderDropTarget(point, sourcePath)
	local best = nil
	local bestDistance = math.huge
	local sourceScope = nil
	local sourceTop = nil
	local sourceBottom = nil
	for _, target in ipairs(self._trackReorderTargets or {}) do
		if target.path == sourcePath and target.gui and target.gui.Parent then
			sourceScope = target.scope
			sourceTop = target.gui.AbsolutePosition.Y
			sourceBottom = sourceTop + target.gui.AbsoluteSize.Y
			break
		end
	end
	if sourceTop and sourceBottom and point.Y &gt;= sourceTop - 2 and point.Y &lt;= sourceBottom + 2 then
		return nil
	end
	for _, target in ipairs(self._trackReorderTargets or {}) do
		local gui = target.gui
		if target.path ~= sourcePath and (not sourceScope or target.scope == sourceScope) and gui and gui.Parent then
			local y1 = gui.AbsolutePosition.Y
			local y2 = y1 + gui.AbsoluteSize.Y
			local distance = 0
			if point.Y &lt; y1 then
				distance = y1 - point.Y
			elseif point.Y &gt; y2 then
				distance = point.Y - y2
			end
			if distance &lt; bestDistance then
				local placement = point.Y &gt; ((y1 + y2) * 0.5) and "After" or "Before"
				local edgeY = placement == "After" and y2 or y1
				local contentY = edgeY
				if self._trackColumnList then
					contentY = edgeY - self._trackColumnList.AbsolutePosition.Y + ((self._laneContainer and self._laneContainer.CanvasPosition.Y) or 0)
				end
				bestDistance = distance
				best = {
					path = target.path,
					placement = placement,
					contentY = contentY,
				}
			end
		end
	end
	return best
end

function WidgetController:_hideTrackNameTooltip()
	if self._trackNameTooltip then
		self._trackNameTooltip.Visible = false
	end
end

function WidgetController:_hideInspectorTooltip()
	if self._inspectorTooltip then
		self._inspectorTooltip.Visible = false
	end
end

function WidgetController:_showInspectorTooltip(targetGui, title, detail)
	local tooltip = self._inspectorTooltip
	if not tooltip or not tooltip.Parent or not targetGui or not targetGui.Parent then
		return
	end

	if self._inspectorTooltipTitle then
		self._inspectorTooltipTitle.Text = compactDisplayText(title or "Tool", 42)
	end
	if self._inspectorTooltipDetail then
		self._inspectorTooltipDetail.Text = tostring(detail or "")
	end

	local parent = tooltip.Parent
	local targetAbs = targetGui.AbsolutePosition
	local parentAbs = parent.AbsolutePosition
	local targetSize = targetGui.AbsoluteSize
	local tooltipHeight = math.max(62, tooltip.AbsoluteSize.Y &gt; 0 and tooltip.AbsoluteSize.Y or 62)
	local parentHeight = parent.AbsoluteSize.Y
	local y = targetAbs.Y - parentAbs.Y + targetSize.Y + 8
	if y + tooltipHeight &gt; parentHeight - 8 then
		y = math.max(8, targetAbs.Y - parentAbs.Y - tooltipHeight - 8)
	end

	tooltip.Position = UDim2.new(0, 18, 0, y)
	tooltip.Visible = true
end

function WidgetController:_bindInspectorTooltip(button, title, detail)
	if not button then
		return
	end

	self:_connect(button.MouseEnter, function()
		self:_showInspectorTooltip(button, title, detail)
	end)
	self:_connect(button.MouseMoved, function()
		self:_showInspectorTooltip(button, title, detail)
	end)
	self:_connect(button.MouseLeave, function()
		self:_hideInspectorTooltip()
	end)
end

function WidgetController:_setWorkspaceGrabButtonActive(active)
	local button = self._workspaceGrabButton
	if not button then
		return
	end
	active = active == true
	button.BackgroundColor3 = active and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft
	button:SetAttribute("MegMoThemeBackgroundRole", active and "AccentSoft" or "PanelSoft")
	local icon = button:FindFirstChild("MegMoWorkspaceGrabIcon")
	if icon and icon:IsA("ImageLabel") then
		icon.ImageColor3 = active and Color3.fromRGB(255, 82, 82) or Constants.THEME.Text
		icon:SetAttribute("MegMoThemeImageRole", active and "__workspaceGrabState" or "Text")
	end
	local stroke = button:FindFirstChild("MegMoWorkspaceGrabStroke")
	if stroke and stroke:IsA("UIStroke") then
		stroke.Color = active and Color3.fromRGB(255, 82, 82) or Constants.THEME.Accent
		stroke.Thickness = active and 2 or 1.25
		stroke.Transparency = active and 0 or 0.28
		stroke:SetAttribute("MegMoThemeStrokeRole", active and "__workspaceGrabState" or "Accent")
	end
end

function WidgetController:_showTrackNameTooltip(rowGui, title, detail, cursorPoint)
	require(script.Parent:WaitForChild("WidgetTooltipSupport")).showTrackNameTooltip({
		compactDisplayText = compactDisplayText,
		cursorPoint = cursorPoint,
		detail = detail,
		rowGui = rowGui,
		title = title,
		tooltip = self._trackNameTooltip,
		tooltipDetail = self._trackNameTooltipDetail,
		tooltipTitle = self._trackNameTooltipTitle,
		userInputService = UserInputService,
	})
end

function WidgetController:showBakeProgress(title, detail, progress)
	require(script.Parent:WaitForChild("WidgetBakeProgressSupport")).showBakeProgress(self, title, detail, progress)
end

function WidgetController:updateBakeProgress(progress, detail)
	require(script.Parent:WaitForChild("WidgetBakeProgressSupport")).updateBakeProgress(self, progress, detail)
end

function WidgetController:hideBakeProgress()
	require(script.Parent:WaitForChild("WidgetBakeProgressSupport")).hideBakeProgress(self)
end

function WidgetController:updateStatus(message)
	local text = tostring(message or "")
	if self._status then
		self._status.Text = text
	end
	if self._lastViewModel then
		self._lastViewModel.status = text
	end
end

function WidgetController:_reorderTrackByStep(trackPath, direction)
	local callbacks = self._callbacks or {}
	if not trackPath or not callbacks.onReorderTrack then
		return
	end

	local sourceIndex = nil
	local sourceScope = nil
	for index, target in ipairs(self._trackReorderTargets or {}) do
		if target.path == trackPath then
			sourceIndex = index
			sourceScope = target.scope
			break
		end
	end
	if not sourceIndex then
		self:_focusShortcutCapture("Track reorder unavailable")
		return
	end

	local step = direction == "Up" and -1 or 1
	local target = (self._trackReorderTargets or {})[sourceIndex + step]
	if not target or target.scope ~= sourceScope then
		self:_focusShortcutCapture(direction == "Up" and "Track is already at the top of this section" or "Track is already at the bottom of this section")
		return
	end

	self:_rememberTimelineCanvasForNextRefresh()
	callbacks.onReorderTrack(trackPath, target.path, direction == "Up" and "Before" or "After")
end

function WidgetController:_startTrackReorderSession(trackPath, startPos, button)
	local callbacks = self._callbacks or {}
	if not trackPath or not callbacks.onReorderTrack then
		return
	end
	if self._trackReorderSession and self._trackReorderSession.trackPath == trackPath then
		return
	end

	self:_clearTrackReorderSession()
	self:_clearMarqueeSession("cancel")
	self:_clearTimelineSession("cancel")

	self._trackReorderActivePath = trackPath
	self._trackReorderDropTarget = nil
	local session = {
		cancelled = false,
		connections = {},
		latestInputPosition = startPos,
		startPos = startPos,
		started = false,
		target = nil,
		trackPath = trackPath,
	}
	self._trackReorderSession = session

	local function connect(signal, callback)
		if signal then
			table.insert(session.connections, signal:Connect(callback))
		end
	end

	local function rawMousePosition()
		local mouseLocation = UserInputService:GetMouseLocation()
		if mouseLocation then
			return Vector2.new(mouseLocation.X, mouseLocation.Y)
		end

		local pluginMouse = nil
		pcall(function()
			pluginMouse = self._plugin and self._plugin:GetMouse()
		end)
		if pluginMouse and type(pluginMouse.X) == "number" and type(pluginMouse.Y) == "number" then
			return Vector2.new(pluginMouse.X, pluginMouse.Y)
		end
		if session.latestInputPosition then
			return session.latestInputPosition
		end
		return nil
	end

	session.rawStartPos = rawMousePosition() or startPos
	session.mouseOffset = startPos - session.rawStartPos

	local function currentPointerPosition()
		local raw = rawMousePosition()
		return raw and (raw + session.mouseOffset) or session.startPos
	end

	local function showCurrentDropTarget(currentPos)
		self:_autoScrollTrackColumnForPoint(currentPos)
		local target = self:_getTrackReorderDropTarget(currentPos, trackPath)
		session.target = target
		self._trackReorderDropTarget = target
		if target then
			self:_showTrackReorderIndicator(target.contentY)
		elseif self._trackColumnList then
			local contentY = currentPos.Y - self._trackColumnList.AbsolutePosition.Y + ((self._laneContainer and self._laneContainer.CanvasPosition.Y) or 0)
			self:_showTrackReorderIndicator(contentY)
		else
			self:_hideTrackReorderIndicator()
		end
	end

	local function finish(shouldApply)
		if self._trackReorderSession ~= session then
			return
		end
		local target = shouldApply and (session.target or self:_getTrackReorderDropTarget(currentPointerPosition(), trackPath)) or nil
		self:_clearTrackReorderSession()
		if target then
			self:_rememberTimelineCanvasForNextRefresh()
			callbacks.onReorderTrack(trackPath, target.path, target.placement)
		else
			self:_focusShortcutCapture(shouldApply and "Track reorder cancelled" or "Drag handle ready")
		end
	end

	connect(UserInputService.InputEnded, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			finish(session.started)
		end
	end)
	connect(UserInputService.InputChanged, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			session.latestInputPosition = positionToVector2(inputObject.Position)
			local delta = session.latestInputPosition - session.startPos
			if not session.started and thresholdPassed(delta, 2) then
				session.started = true
				self:_setShortcutHint("Drag track above or below another track to reorder")
			end
			showCurrentDropTarget(session.latestInputPosition)
		end
	end)
	connect(UserInputService.WindowFocusReleased, function()
		finish(false)
	end)
	if button and button.MouseButton1Up then
		connect(button.MouseButton1Up, function()
			finish(session.started)
		end)
	end
	local pluginMouse = nil
	pcall(function()
		pluginMouse = self._plugin and self._plugin:GetMouse()
	end)
	if pluginMouse and pluginMouse.Button1Up then
		connect(pluginMouse.Button1Up, function()
			finish(session.started)
		end)
	end

	self:_setShortcutHint("Track reorder active")
	showCurrentDropTarget(startPos)

	connect(RunService.Heartbeat, function()
		if self._trackReorderSession ~= session or session.cancelled then
			return
		end
		if session.started and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			finish(true)
			return
		end
		local currentPos = currentPointerPosition()
		local delta = currentPos - session.startPos
		if not session.started then
			if not thresholdPassed(delta, 4) then
				return
			end
			session.started = true
			self:_setShortcutHint("Drag track above or below another track to reorder")
		end

		showCurrentDropTarget(currentPos)
	end)
end

function WidgetController:_renderTrackFolderChoices(track)
	self:_clearTrackFolderChoices()
	if not self._trackActionsFolderList or not track then
		return
	end

	local callbacks = self._callbacks or {}
	local selectedMap = {}
	local selectedCount = 0
	for _, selectedPath in ipairs((self._lastViewModel and self._lastViewModel.selectedTrackPaths) or {}) do
		selectedMap[selectedPath] = true
		selectedCount += 1
	end
	local useSelectedTracks = selectedCount &gt; 1 and selectedMap[track.path] == true
	local folders = {}
	for _, trackData in ipairs((self._lastViewModel and self._lastViewModel.tracks) or {}) do
		if trackData.targetScope == "TimelineFolder" then
			folders[#folders + 1] = trackData
		end
	end

	if track.targetScope == "TimelineFolder" then
		local input = create("TextBox", {
			Parent = self._trackActionsFolderList,
			BackgroundColor3 = Constants.THEME.PanelSoft,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Folder name",
			Size = UDim2.new(1, -8, 0, 30),
			Text = tostring(track.name or "Folder"),
			TextColor3 = Constants.THEME.Text,
			TextSize = 12,
			ZIndex = 106,
		})
		styleInput(input)
		local function renameFolder()
			local trackPath = self._pendingTrackActionPath
			local newName = tostring(input.Text or "")
			self:_hideTrackActions()
			if trackPath and callbacks.onRenameTimelineFolder then
				callbacks.onRenameTimelineFolder(trackPath, newName)
			end
			self:_focusShortcutCapture("Folder renamed")
		end
		self:_connect(input.FocusLost, function(enterPressed)
			if enterPressed then
				renameFolder()
			end
		end)
		self:_createTrackActionChoice("Rename Folder", Constants.THEME.AccentSoft, renameFolder)
		for _, option in ipairs(FOLDER_COLOR_OPTIONS) do
			local label = string.format("Color: %s", option.id)
			self:_createTrackActionChoice(label, option.color:Lerp(Constants.THEME.Panel, 0.45), function()
				local trackPath = self._pendingTrackActionPath
				self:_hideTrackActions()
				if trackPath and callbacks.onSetTimelineFolderColor then
					callbacks.onSetTimelineFolderColor(trackPath, option.id)
				end
				self:_focusShortcutCapture("Folder color updated")
			end)
		end
		self:_createTrackActionChoice("Collapse All Folders", Constants.THEME.PanelSoft, function()
			self:_hideTrackActions()
			self:_setAllTimelineFoldersCollapsed(true)
			self:_focusShortcutCapture("All folders collapsed")
		end)
		self:_createTrackActionChoice("Expand All Folders", Constants.THEME.PanelSoft, function()
			self:_hideTrackActions()
			self:_setAllTimelineFoldersCollapsed(false)
			self:_focusShortcutCapture("All folders expanded")
		end)
		return
	end

	if track.trackType == "Rig Group" and BoneSkeletonOverlayService.hasBones(track.rig) then
		self:_createTrackActionChoice(
			"Bone Display: Full Skeleton",
			BoneSkeletonOverlayService.getRigDisplayMode(track.rig) == BoneSkeletonOverlayService.DISPLAY_MODE_FULL
				and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
			function()
				self:_hideTrackActions()
				BoneSkeletonOverlayService.setRigDisplayMode(track.rig, BoneSkeletonOverlayService.DISPLAY_MODE_FULL)
				self:_setShortcutHint("Bone display set to Full Skeleton")
			end
		)
		self:_createTrackActionChoice(
			"Bone Display: Joints Only",
			BoneSkeletonOverlayService.getRigDisplayMode(track.rig) == BoneSkeletonOverlayService.DISPLAY_MODE_JOINTS_ONLY
				and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
			function()
				self:_hideTrackActions()
				BoneSkeletonOverlayService.setRigDisplayMode(track.rig, BoneSkeletonOverlayService.DISPLAY_MODE_JOINTS_ONLY)
				self:_setShortcutHint("Bone display set to Joints Only")
			end
		)
	end

	if LightingEffectTrackService.isLightingEffectTrack(track)
		and LightingEffectTrackService.getTrackEffectType(track) == "Lighting" then
		local tracks = (self._lastViewModel and self._lastViewModel.tracks) or {}
		local childByEffectId = {}
		for _, candidate in ipairs(tracks) do
			if LightingEffectTrackService.isLightingEffectTrack(candidate)
				and candidate.parentTrackPath == track.path then
				childByEffectId[LightingEffectTrackService.getTrackEffectType(candidate)] = candidate
			end
		end
		self:_createTrackActionChoice("Lighting Properties", Constants.THEME.AccentSoft, function()
			local trackPath = self._pendingTrackActionPath
			self:_hideTrackActions()
			if trackPath then
				self:_showEffectTrackEditor(trackPath)
			end
		end)
		for _, effectId in ipairs(LIGHTING_OPTIONAL_EFFECTS) do
			local definition = LightingEffectTrackService.getEffectDefinition(effectId)
			if definition then
				local existingTrack = childByEffectId[LightingEffectTrackService.normalizeEffectType(effectId)]
				local label = string.format("%s %s", existingTrack and "Open" or "Add", definition.name or effectId)
				self:_createTrackActionChoice(label, existingTrack and Constants.THEME.PanelSoft or Constants.THEME.AccentSoft, function()
					self:_hideTrackActions()
					local trackPath = existingTrack and existingTrack.path or nil
					if not trackPath and callbacks.onAddLightingEffectTrack then
						trackPath = callbacks.onAddLightingEffectTrack(effectId, {
							parentTrackPath = track.path,
							parentTrackName = track.name or "Lighting",
						})
					end
					if trackPath then
						if callbacks.onSelectTrack then
							callbacks.onSelectTrack(trackPath, false)
						end
						self:_showEffectTrackEditor(trackPath)
					end
					self:_focusShortcutCapture((definition.name or effectId) .. " lighting options open")
				end)
			end
		end
	end

	if track.trackType == "Camera" or track.trackType == "Camera Property" then
		self:_createTrackActionChoice("Camera Rotation", Constants.THEME.AccentSoft, function()
			local trackPath = self._pendingTrackActionPath
			self:_hideTrackActions()
			if trackPath then
				self._activeCameraTrackPath = trackPath
			end
			self:_showCameraRotationEditor()
		end)
	end

	if track.folderPath then
		self:_createTrackActionChoice(useSelectedTracks and "Remove Selected From Folder" or "Remove From Folder", Constants.THEME.PanelSoft, function()
			local trackPath = self._pendingTrackActionPath
			self:_hideTrackActions()
			if useSelectedTracks and callbacks.onMoveSelectedTracksToFolder then
				callbacks.onMoveSelectedTracksToFolder(nil)
			elseif trackPath and callbacks.onMoveTrackToFolder then
				callbacks.onMoveTrackToFolder(trackPath, nil)
			end
			self:_focusShortcutCapture("Track removed from folder")
		end)
	end

	self:_createTrackActionChoice(useSelectedTracks and "New Folder + Move Selected" or "New Folder + Move", Constants.THEME.AccentSoft, function()
		local trackPath = self._pendingTrackActionPath
		self:_hideTrackActions()
		if useSelectedTracks and callbacks.onMoveSelectedTracksToFolder then
			callbacks.onMoveSelectedTracksToFolder("__new__")
		elseif trackPath and callbacks.onMoveTrackToFolder then
			callbacks.onMoveTrackToFolder(trackPath, "__new__")
		end
		self:_focusShortcutCapture("Created folder and moved track")
	end)

	for _, folder in ipairs(folders) do
		local isCurrent = folder.path == track.folderPath
		local folderPath = folder.path
		local actionLabel = useSelectedTracks and "Move Selected To: " or "Move To: "
		local label = string.format("%s%s", isCurrent and "Current: " or actionLabel, tostring(folder.name or "Folder"))
		self:_createTrackActionChoice(label, isCurrent and Color3.fromRGB(55, 72, 94) or Constants.THEME.PanelSoft, function()
			local trackPath = self._pendingTrackActionPath
			self:_hideTrackActions()
			if useSelectedTracks and callbacks.onMoveSelectedTracksToFolder then
				callbacks.onMoveSelectedTracksToFolder(folderPath)
			elseif trackPath and callbacks.onMoveTrackToFolder then
				callbacks.onMoveTrackToFolder(trackPath, folderPath)
			end
			self:_focusShortcutCapture("Track moved to folder")
		end)
	end
end

function WidgetController:_showTrackActions(path)
	if not self._trackActionsOverlay or not path then
		return
	end

	local track = self:_getTrackViewModel(path)
	if not track then
		self:_setShortcutHint("That track is no longer available")
		return
	end
	if self:_isFaceKeyframeTrack(track) then
		self._pendingTrackActionPath = nil
		self:_setFacesOverlayVisible(true)
		self:_setShortcutHint("Faces panel open: choose or edit a face preset")
		return
	end
	if self:_isEditablePropertyKeyframeTrack(track) then
		self._pendingTrackActionPath = nil
		self:_showPropertyKeyframeEditor(path)
		return
	end

	self._pendingTrackActionPath = path
	if self._trackActionsTitle then
		self._trackActionsTitle.Text = string.format("%s track", tostring(track.name or track.trackType or "Timeline"))
	end
	if self._trackActionsMessage then
		local message = string.format(
			"Choose what to do with '%s'. Open options or move it into a folder.",
			tostring(track.name or track.trackType or "track")
		)
		if track.targetScope == "TimelineFolder" then
			message = "Rename this folder. Removing the folder keeps the tracks in the timeline."
		end
		self._trackActionsMessage.Text = message
	end
	if self._trackActionsEditButton then
		local supportsEditor = track.trackType == "Screen Effect"
			or track.trackType == "Lighting Effect"
			or track.trackType == "Camera"
			or track.trackType == "Camera Property"
			or track.trackType == "Event"
			or track.valueType == "Event"
			or track.trackType == "Rig"
			or track.trackType == "Rig Group"
			or track.trackType == "Rig Property"
			or track.trackType == "Object"
			or track.trackType == "Model"
			or track.trackType == "Rig CFrame"
			or track.trackType == "Sound"
			or track.trackType == "Emitter Group"
			or track.trackType == "Emitter Group Property"
			or (track.trackType == "Object" and track.valueType == "Emitter")
			or (track.trackType == "Object Property" and track.parentTrackPath ~= nil)
		self._trackActionsEditButton.Visible = supportsEditor
	end
	if self._trackActionsDeleteButton then
		self._trackActionsDeleteButton.Visible = false
	end
	if self._trackActionsFolderButton then
		self._trackActionsFolderButton.Visible = false
	end
	self:_renderTrackFolderChoices(track)
	self._trackActionsOverlay.Visible = true
	self:_setShortcutHint("Track actions open")
end

function WidgetController:_hideTrackActions()
	if self._trackActionsOverlay then
		self._trackActionsOverlay.Visible = false
	end
	self:_clearTrackFolderChoices()
	self._pendingTrackActionPath = nil
end

function WidgetController:_showSelectedGroupOptions()
	local viewModel = self._lastViewModel or {}
	local groupIds = viewModel.selectedGroupIds or {}
	if #groupIds == 0 or not self._trackActionsOverlay then
		return false, "Select a clip block first."
	end
	self._pendingTrackActionPath = nil
	self:_clearTrackFolderChoices()
	if self._trackActionsTitle then
		self._trackActionsTitle.Text = #groupIds == 1 and "Physics Clip" or "Selected Clips"
	end
	if self._trackActionsMessage then
		self._trackActionsMessage.Text = "Move the playhead inside the clip, then trim the unwanted side."
	end
	if self._trackActionsEditButton then
		self._trackActionsEditButton.Visible = false
	end
	if self._trackActionsDeleteButton then
		self._trackActionsDeleteButton.Visible = false
	end
	if self._trackActionsFolderButton then
		self._trackActionsFolderButton.Visible = false
	end
	if self._callbacks and self._callbacks.onEditSelectedGroupsAtPlayhead then
		self:_createTrackActionChoice("Trim Before Playhead", Constants.THEME.AccentSoft, function()
			self:_hideTrackActions()
			self._callbacks.onEditSelectedGroupsAtPlayhead("Before", groupIds)
		end)
		self:_createTrackActionChoice("Trim After Playhead", Constants.THEME.AccentSoft, function()
			self:_hideTrackActions()
			self._callbacks.onEditSelectedGroupsAtPlayhead("After", groupIds)
		end)
		self:_createTrackActionChoice("Split at Playhead", Constants.THEME.Accent, function()
			self:_hideTrackActions()
			self._callbacks.onEditSelectedGroupsAtPlayhead("Split", groupIds)
		end)
	end
	if self._callbacks and self._callbacks.onSetSelectedGroupEditMode then
		self:_createTrackActionChoice("Stretch Clip", Constants.THEME.PanelSoft, function()
			self:_hideTrackActions()
			self._callbacks.onSetSelectedGroupEditMode("Stretch", groupIds)
		end)
		self:_createTrackActionChoice("Repeat Clip", Constants.THEME.PanelSoft, function()
			self:_hideTrackActions()
			self._callbacks.onSetSelectedGroupEditMode("Repeat", groupIds)
		end)
	end
	self._trackActionsOverlay.Visible = true
	self:_setShortcutHint("Clip options open: trim before or after the playhead")
	return true, "Clip options open."
end

function WidgetController:_showClosePluginPrompt()
	if not self._closePluginOverlay then
		return
	end
	self:_hideTrackActions()
	self:_hideRemoveConfirmation()
	self._closePromptMode = "ClosePlugin"
	if self._closePluginTitle then
		self._closePluginTitle.Text = "Close 7kg2 Animator?"
	end
	if self._closePluginMessage then
		self._closePluginMessage.Text = "Save your progress before closing? 7kg2 also keeps an autosave in ServerStorage so you can recover recent work."
	end
	if self._closePluginSaveButton then
		self._closePluginSaveButton.Text = "Save And Close"
	end
	if self._closePluginDiscardButton then
		self._closePluginDiscardButton.Text = "Close Without Saving"
	end
	self._closePluginOverlay.Visible = true
	self:_setShortcutHint("Close prompt open: save and close, close without saving, or cancel")
end

function WidgetController:_showNewProjectPrompt()
	if not self._closePluginOverlay then
		return
	end
	self:_hideTrackActions()
	self:_hideRemoveConfirmation()
	self._closePromptMode = "NewProject"
	if self._closePluginTitle then
		self._closePluginTitle.Text = "Start a new animation?"
	end
	if self._closePluginMessage then
		self._closePluginMessage.Text = "This clears the current 7kg2 timeline, tracks, keyframes, Motion Builder markers, effects, and temporary attachments. Save first if you want to keep this work."
	end
	if self._closePluginSaveButton then
		self._closePluginSaveButton.Text = "Save And Create New"
	end
	if self._closePluginDiscardButton then
		self._closePluginDiscardButton.Text = "Continue Without Saving"
	end
	self._closePluginOverlay.Visible = true
	self:_setShortcutHint("New animation prompt open: save and create new, continue without saving, or cancel")
end

function WidgetController:_hideClosePluginPrompt()
	if self._closePluginOverlay then
		self._closePluginOverlay.Visible = false
	end
	self._closePromptMode = nil
end

function WidgetController:showAlert(title, message)
	if not require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).showAlert(self, title, message) then
		return
	end
	self:_setShortcutHint("Alert open: acknowledge to continue")
end

function WidgetController:_hideAlert()
	require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).hideAlert(self)
end

function WidgetController:_showRepeatFramesOverlay(defaults)
	if not require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).showRepeatFramesOverlay(self, defaults) then
		return
	end
	self:_setShortcutHint("Repeat Frames open: choose loop count, length, or To End")
	task.defer(function()
		if self._repeatFramesLoopCountInput and self._repeatFramesOverlay.Visible then
			self._repeatFramesLoopCountInput:CaptureFocus()
		end
	end)
end

function WidgetController:_hideRepeatFramesOverlay()
	require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).hideRepeatFramesOverlay(self)
end

function WidgetController:_getRepeatFramesOptions()
	return require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).getRepeatFramesOptions(self)
end

function WidgetController:_showWiggleFramesOverlay()
	local success, errorMessage = require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).showWiggleFramesOverlay(self)
	if not success then
		self:_setShortcutHint("Wiggle settings are not available in this build.")
		return
	end
	self:_setShortcutHint("Wiggle open: choose offsets and interval, then press OK")
end

function WidgetController:_hideWiggleFramesOverlay()
	require(script.Parent:WaitForChild("WidgetOverlayStateSupport")).hideWiggleFramesOverlay(self)
end

function WidgetController:_getWiggleFramesOptions()
	return {
		angleX = self._wiggleFramesAngleXInput and self._wiggleFramesAngleXInput.Text or "2",
		angleY = self._wiggleFramesAngleYInput and self._wiggleFramesAngleYInput.Text or "2",
		angleZ = self._wiggleFramesAngleZInput and self._wiggleFramesAngleZInput.Text or "2",
		posX = self._wiggleFramesPosXInput and self._wiggleFramesPosXInput.Text or "0",
		posY = self._wiggleFramesPosYInput and self._wiggleFramesPosYInput.Text or "0",
		posZ = self._wiggleFramesPosZInput and self._wiggleFramesPosZInput.Text or "0",
		interval = self._wiggleFramesIntervalInput and self._wiggleFramesIntervalInput.Text or "0:02",
		easingStyle = self._wiggleFramesEasingStyle or "Linear",
		easingDirection = self._wiggleFramesEasingDirection or Constants.DEFAULT_EASING_DIRECTION,
	}
end

function WidgetController:_showImportDialog()
	if not self._importOverlay then
		return
	end

	self._importOverlay.Visible = true
	if self._savedProjectsCard then
		self._savedProjectsCard.Visible = true
	end
	if self._importCard then
		self._importCard.Visible = false
	end
	if self._savedProjectsSearchInput then
		self._savedProjectsSearchInput.Text = ""
	end
	self._savedProjectsPageIndex = 1
	self._lastImportEntriesSignature = nil
	if self._importStatusLabel then
		self._importStatusLabel.Text = "Loading 7kg2 Animator saves..."
	end
	self:_renderImportAnimationEntries({}, "Loading 7kg2 Animator saves...")
	self:_setShortcutHint("Import dialog open: saved 7kg2 files are shown first, or choose another import method")

	task.defer(function()
		if not self._importOverlay or not self._importOverlay.Visible then
			return
		end
		local callbacks = self._callbacks or {}
		if callbacks.onLoadSavedProjects then
			callbacks.onLoadSavedProjects()
		end
	end)
end

function WidgetController:_avatarRigTypeLabel()
	local avatarRigType = self._avatarRigType or "R15Classic"
	if avatarRigType == "R6" then
		return "Avatar Type: R6"
	elseif avatarRigType == "R15Modern" then
		return "Avatar Type: R15 Modern"
	end
	return "Avatar Type: R15 Classic"
end

function WidgetController:_setAvatarRigType(avatarRigType)
	avatarRigType = tostring(avatarRigType or "R15Classic")
	if avatarRigType ~= "R6" and avatarRigType ~= "R15Modern" then
		avatarRigType = "R15Classic"
	end
	self._avatarRigType = avatarRigType
	local label = self:_avatarRigTypeLabel()
	if self._avatarRigTypeButton then
		self._avatarRigTypeButton.Text = label
	end
	if self._avatarImportRigTypeButton then
		self._avatarImportRigTypeButton.Text = label
	end
end

function WidgetController:_cycleAvatarRigType()
	if self._avatarRigType == "R6" then
		self:_setAvatarRigType("R15Classic")
	elseif self._avatarRigType == "R15Classic" then
		self:_setAvatarRigType("R15Modern")
	else
		self:_setAvatarRigType("R6")
	end
	self:_setShortcutHint("Avatar importer rig type: " .. self:_avatarRigTypeLabel())
end

function WidgetController:_showAvatarImportDialog()
	if not self._avatarImportOverlay then
		local callbacks = self._callbacks or {}
		if callbacks.onInsertAvatarRig then
			callbacks.onInsertAvatarRig(self._avatarInput and self._avatarInput.Text or "", self._avatarRigType or "R15Classic")
		end
		return
	end

	self:_hideTrackActions()
	self:_hideRemoveConfirmation()
	self:_setAvatarRigType(self._avatarRigType or "R15Classic")
	if self._avatarImportInput and self._avatarInput then
		self._avatarImportInput.Text = self._avatarInput.Text or ""
	end
	if self._avatarImportStatusLabel then
		self._avatarImportStatusLabel.Text = "Tip: leave blank to pick a random avatar."
	end
	self._avatarImportOverlay.Visible = true
	self:_setShortcutHint("Avatar import open: enter username/userId or leave blank for random, choose rig type, then Insert Avatar")
	task.defer(function()
		if self._avatarImportOverlay and self._avatarImportOverlay.Visible and self._avatarImportInput then
			self._avatarImportInput:CaptureFocus()
		end
	end)
end

function WidgetController:_hideAvatarImportDialog()
	if self._avatarImportOverlay then
		self._avatarImportOverlay.Visible = false
	end
end

function WidgetController:_insertAvatarFromDialog()
	local callbacks = self._callbacks or {}
	if not callbacks.onInsertAvatarRig then
		return
	end
	local query = self._avatarImportInput and self._avatarImportInput.Text or ""
	query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if self._avatarInput then
		self._avatarInput.Text = query
	end
	if self._avatarImportStatusLabel then
		self._avatarImportStatusLabel.Text = query == "" and "Picking random avatar..." or "Loading avatar..."
	end
	self:_hideAvatarImportDialog()
	callbacks.onInsertAvatarRig(query, self._avatarRigType or "R15Classic")
end

function WidgetController:_cyclePresetRigFilter()
	local nextFilter = "All"
	if self._presetRigFilter == "All" then
		nextFilter = "R15"
	elseif self._presetRigFilter == "R15" then
		nextFilter = "R6"
	end
	self._presetRigFilter = nextFilter
	self._lastPresetEntriesSignature = nil
	if self._presetRigFilterButton then
		self._presetRigFilterButton.Text = "Rig: " .. nextFilter
	end
	if self._lastViewModel then
		self:_renderPresetBrowserEntries(self._lastViewModel.importAnimationEntries or {}, self._lastViewModel.importBrowserStatus)
	end
end

function WidgetController:_setPresetSource(source)
	self._presetSource = tostring(source or "")
	local active = Constants.THEME.Accent
	local inactive = Constants.THEME.PanelSoft
	if self._presetFreeButton then
		local isActive = self._presetSource == "RobloxStarter"
		self._presetFreeButton.BackgroundColor3 = isActive and active or inactive
		self._presetFreeButton.TextColor3 = isActive
			and ThemeService.getReadableTextColor(active)
			or Constants.THEME.Text
	end
	if self._presetOwnedButton then
		local isActive = self._presetSource == "MyAnimations"
		self._presetOwnedButton.BackgroundColor3 = isActive and active or inactive
		self._presetOwnedButton.TextColor3 = isActive
			and ThemeService.getReadableTextColor(active)
			or Constants.THEME.Text
	end
end

function WidgetController:_importPresetIdInput(callbacks)
	local importText = self._presetImportIdInput and self._presetImportIdInput.Text or ""
	importText = tostring(importText or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if importText == "" then
		if self._presetStatusLabel then
			self._presetStatusLabel.Text = "Paste an Animation ID or URL first, then click Import ID."
		end
		return false
	end

	local pickerMotion = tostring(self._motionDefaultPickerMotion or "")
	if pickerMotion ~= "" then
		self._motionDefaultPickerMotion = nil
		self._motionSegmentPickerKey = nil
		self._motionSegmentPickerLabel = nil
		self._lastPresetEntriesSignature = nil
		if callbacks and callbacks.onSetMotionDefaultClip then
			callbacks.onSetMotionDefaultClip(pickerMotion, importText)
		end
		if self._presetStatusLabel then
			self._presetStatusLabel.Text = "Set custom " .. pickerMotion .. " default from Animation ID."
		end
		self:_setWorkspaceMode("Animate")
		self:_setShortcutHint("Set custom " .. pickerMotion .. " recipe default.")
		return true
	end

	local segmentPickerKey = tostring(self._motionSegmentPickerKey or "")
	if segmentPickerKey ~= "" then
		local segmentLabel = tostring(self._motionSegmentPickerLabel or "segment")
		local pauseIdlePrefix = "__pause_idle__:"
		local pauseIdleKey = segmentPickerKey:sub(1, #pauseIdlePrefix) == pauseIdlePrefix
			and segmentPickerKey:sub(#pauseIdlePrefix + 1)
			or nil
		self._motionSegmentPickerKey = nil
		self._motionSegmentPickerLabel = nil
		self._lastPresetEntriesSignature = nil
		if pauseIdleKey and callbacks and callbacks.onSetMotionSegmentPauseIdle then
			callbacks.onSetMotionSegmentPauseIdle(pauseIdleKey, importText)
		elseif callbacks and callbacks.onSetMotionSegmentClip then
			callbacks.onSetMotionSegmentClip(segmentPickerKey, importText)
		end
		if self._presetStatusLabel then
			self._presetStatusLabel.Text = "Set custom " .. segmentLabel .. " style from Animation ID."
		end
		self:_setWorkspaceMode("Animate")
		self:_setShortcutHint("Set custom " .. segmentLabel .. " style for this marker segment.")
		return true
	end

	if self._presetStatusLabel then
		self._presetStatusLabel.Text = "Importing animation from ID..."
	end
	if callbacks and callbacks.onImportAnimationId then
		callbacks.onImportAnimationId(importText)
	end
	return true
end

function WidgetController:_renderMotionMarkers(markerEntries)
	markerEntries = markerEntries or {}
	local signature = require(script.Parent:WaitForChild("WidgetMotionMarkersSupport")).buildMotionMarkersSignature(markerEntries, appendSignatureValue)
	if signature == self._lastMotionMarkersSignature then
		return
	end
	self._lastMotionMarkersSignature = signature

	require(script.Parent:WaitForChild("WidgetMotionMarkersSupport")).renderMotionMarkers({
		callbacks = self._callbacks,
		connect = function(signal, callback)
			self:_connect(signal, callback)
		end,
		create = create,
		createCorner = createCorner,
		createStroke = createStroke,
		markerEntries = markerEntries,
		motionMarkersEmptyLabel = self._motionMarkersEmptyLabel,
		motionMarkersList = self._motionMarkersList,
	})
end

function WidgetController:_renderMotionDefaults(viewModel)
	viewModel = viewModel or self._lastViewModel or {}
	local defaultsSignature = require(script.Parent:WaitForChild("WidgetMotionDefaultsSupport")).buildMotionDefaultsSignature(
		viewModel,
		MOTION_DEFAULT_OPTIONS,
		self._openMotionDefaultMotion,
		appendSignatureValue
	)
	if defaultsSignature == self._lastMotionDefaultsSignature then
		return
	end
	self._lastMotionDefaultsSignature = defaultsSignature

	if not self._motionDefaultsFrame then
		return
	end
	local perfToken = PerformanceDebugService.begin("Motion Defaults")
	local rendered = require(script.Parent:WaitForChild("WidgetMotionDefaultsSupport")).renderMotionDefaults(self, viewModel, {
		create = create,
		createCorner = createCorner,
		createStroke = createStroke,
		motionOptions = MOTION_DEFAULT_OPTIONS,
	})
	if self._openMotionDefaultMotion == nil then
		PerformanceDebugService.finish(perfToken, string.format("%d motions", #MOTION_DEFAULT_OPTIONS))
		return
	end
	if not rendered then
		PerformanceDebugService.finish(perfToken, string.format("%d motions", #MOTION_DEFAULT_OPTIONS))
		return
	end
	PerformanceDebugService.finish(perfToken, string.format("%d motions", #MOTION_DEFAULT_OPTIONS))
end

function WidgetController:_renderMotionSegments(segmentEntries)
	segmentEntries = segmentEntries or {}
	local previewState = self._lastViewModel and self._lastViewModel.motionPreview or {}
	local signatureParts = {
		tostring(self._openMotionSegmentKey or ""),
		tostring(self._openMotionSegmentMenuType or ""),
		tostring(previewState.isPreviewing == true),
		tostring(previewState.segmentKey or ""),
	}
	for _, segment in ipairs(segmentEntries) do
		appendSignatureValue(signatureParts, segment.segmentKey or "")
		appendSignatureValue(signatureParts, segment.fromName or "")
		appendSignatureValue(signatureParts, segment.toName or "")
		appendSignatureValue(signatureParts, segment.motionName or "")
		appendSignatureValue(signatureParts, segment.clipId or "")
		appendSignatureValue(signatureParts, segment.durationSeconds or 0)
		appendSignatureValue(signatureParts, segment.pauseAfterSeconds or 0)
		appendSignatureValue(signatureParts, segment.blendSeconds or 0)
		appendSignatureValue(signatureParts, segment.pauseIdleClipId or "")
	end
	local signature = table.concat(signatureParts, "|")
	if signature == self._lastMotionSegmentsSignature then
		return
	end
	self._lastMotionSegmentsSignature = signature

	if not self._motionSegmentsList then
		return
	end
	local perfToken = PerformanceDebugService.begin("Motion Segments")

	for _, child in ipairs(self._motionSegmentsList:GetChildren()) do
		if child ~= self._motionSegmentsEmptyLabel and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	self._motionSegmentInputs = {}
	local segmentCount = #segmentEntries
	if self._motionSegmentsEmptyLabel then
		self._motionSegmentsEmptyLabel.Visible = segmentCount == 0
	end

	local totalSeconds = 0
	local totalDistance = 0
	for _, segment in ipairs(segmentEntries) do
		totalSeconds += tonumber(segment.durationSeconds) or 0
		totalSeconds += tonumber(segment.pauseAfterSeconds) or 0
		if segment.hasNextSegment ~= false then
			totalSeconds += tonumber(segment.blendSeconds) or 0
		end
		totalDistance += tonumber(segment.distanceStuds) or 0
	end
	if self._motionSegmentSummaryLabel then
		self._motionSegmentSummaryLabel.Text = segmentCount &gt; 0
			and string.format(
				"Total: %d segment%s, %.2fs, %.1f studs",
				segmentCount,
				segmentCount == 1 and "" or "s",
				totalSeconds,
				totalDistance
			)
			or "Total: 0 segments"
	end

	if segmentCount == 0 then
		PerformanceDebugService.finish(perfToken, "0 segments")
		return
	end

	local isMotionPreviewing = previewState.isPreviewing == true
	local activePreviewKey = tostring(previewState.segmentKey or "")
	local motionClipOptionsByMotion = self._lastViewModel and self._lastViewModel.motionClipOptionsByMotion or {}

	local function createCell(parent, text, position, size, color, font)
		return create("TextLabel", {
			Parent = parent,
			BackgroundTransparency = 1,
			Position = position,
			Size = size,
			Font = font or Enum.Font.Gotham,
			Text = text,
			TextColor3 = color or Constants.THEME.Text,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 9,
		})
	end

	local function findClipLabel(options, clipId, fallback)
		clipId = tostring(clipId or "")
		for _, option in ipairs(options or {}) do
			if tostring(option.id or "") == clipId then
				return tostring(option.name or option.pack or fallback)
			end
		end
		return fallback
	end

	local function createOptionStrip(parent, y, labelText, options, selectedId, defaultText, onSelect)
		createCell(parent, labelText, UDim2.new(0, 10, 0, y + 5), UDim2.new(0, 82, 0, 18), Constants.THEME.MutedText, Enum.Font.GothamSemibold)
		local strip = create("ScrollingFrame", {
			Parent = parent,
			Active = true,
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			Position = UDim2.new(0, 98, 0, y),
			ScrollBarThickness = 3,
			ScrollingDirection = Enum.ScrollingDirection.X,
			Size = UDim2.new(1, -108, 0, 28),
			ZIndex = 11,
		})
		self:_attachNestedMotionStripScroll(strip)
		local layout = create("UIListLayout", {
			Parent = strip,
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		layout.VerticalAlignment = Enum.VerticalAlignment.Center

		local allOptions = {}
		if defaultText and defaultText ~= "" then
			table.insert(allOptions, {
				id = "",
				name = defaultText,
			})
		end
		for _, option in ipairs(options or {}) do
			table.insert(allOptions, option)
		end

		for optionIndex, option in ipairs(allOptions) do
			local optionId = tostring(option.id or "")
			local optionText = tostring(option.name or option.pack or optionId)
			local isSelected = tostring(selectedId or "") == optionId
			local button = create("TextButton", {
				Parent = strip,
				BackgroundColor3 = isSelected and Constants.THEME.AccentSoft or Constants.THEME.PanelSoft,
				BorderSizePixel = 0,
				LayoutOrder = optionIndex,
				Size = UDim2.new(0, optionIndex == 1 and 92 or 112, 0, 22),
				Font = Enum.Font.GothamSemibold,
				Text = optionText,
				TextColor3 = Constants.THEME.Text,
				TextSize = 10,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Center,
				ZIndex = 12,
			})
			createCorner(button, 7)
			self:_connect(button.Activated, function()
				self._openMotionSegmentKey = nil
				self._openMotionSegmentMenuType = nil
				if onSelect then
					onSelect(optionId)
				end
			end)
		end
	end

	for index, segment in ipairs(segmentEntries) do
		local segmentKey = tostring(segment.segmentKey or index)
		local openMenuType = self._openMotionSegmentKey == segmentKey and self._openMotionSegmentMenuType or nil
		local isMotionMenuOpen = openMenuType ~= nil
		local currentMotion = tostring(segment.motionName or "Path Only")
		if currentMotion == "Auto" then
			currentMotion = "Path Only"
		end
		local pauseSeconds = tonumber(segment.pauseAfterSeconds) or 0
		local rowHeight = 38
		if isMotionMenuOpen then
			rowHeight = 88
		end
		local row = create("Frame", {
			Parent = self._motionSegmentsList,
			BackgroundColor3 = Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, rowHeight),
			LayoutOrder = index,
			ZIndex = 8,
		})
		createCorner(row, 4)
		createStroke(row)
		for _, dividerX in ipairs({ 0.035, 0.155, 0.275, 0.39, 0.49, 0.61, 0.695, 0.78, 0.93 }) do
			create("Frame", {
				Parent = row,
				Active = false,
				BackgroundColor3 = Constants.THEME.Border,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				Position = UDim2.new(dividerX, 0, 0, 1),
				Size = UDim2.new(0, 1, 0, 36),
				ZIndex = 8,
			})
		end

		createCell(
			row,
			tostring(index),
			UDim2.new(0, 0, 0, 0),
			UDim2.new(0.035, 0, 1, 0),
			Constants.THEME.MutedText,
			Enum.Font.GothamSemibold
		).TextXAlignment = Enum.TextXAlignment.Center
		createCell(
			row,
			tostring(segment.fromName or ("Marker " .. tostring(index))),
			UDim2.new(0.035, 4, 0, 0),
			UDim2.new(0.12, -8, 1, 0),
			Constants.THEME.Text,
			Enum.Font.GothamSemibold
		).TextXAlignment = Enum.TextXAlignment.Center
		createCell(
			row,
			tostring(segment.toName or ("Marker " .. tostring(index + 1))),
			UDim2.new(0.155, 4, 0, 0),
			UDim2.new(0.12, -8, 1, 0),
			Constants.THEME.Text,
			Enum.Font.GothamSemibold
		).TextXAlignment = Enum.TextXAlignment.Center

		local motionButton = create("TextButton", {
			Parent = row,
			BackgroundColor3 = currentMotion == "Path Only" and Constants.THEME.PanelAlt or Constants.THEME.AccentSoft,
			BorderSizePixel = 0,
			Position = UDim2.new(0.275, 4, 0, 7),
			Size = UDim2.new(0.115, -8, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Text = currentMotion .. (openMenuType == "motion" and " ^" or " v"),
			TextColor3 = Constants.THEME.Text,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(motionButton, 4)
		self:_connect(motionButton.Activated, function()
			if self._openMotionSegmentKey == segmentKey and self._openMotionSegmentMenuType == "motion" then
				self._openMotionSegmentKey = nil
				self._openMotionSegmentMenuType = nil
			else
				self:_closeDropdowns()
				self._openMotionSegmentKey = segmentKey
				self._openMotionSegmentMenuType = "motion"
				self:_setShortcutHint("Choose a motion for " .. tostring(segment.fromName or "?") .. " -&gt; " .. tostring(segment.toName or "?"))
			end
			self:_renderMotionSegments(self._lastViewModel and self._lastViewModel.motionSegments or segmentEntries)
		end)
		local motionClipOptions = motionClipOptionsByMotion[currentMotion] or {}
		local selectedClipId = tostring(segment.clipId or "")
		local styleLabel = currentMotion == "Path Only" and "None" or findClipLabel(motionClipOptions, selectedClipId, selectedClipId ~= "" and "Custom" or "Default")
		local styleButton = create("TextButton", {
			Parent = row,
			AutoButtonColor = currentMotion ~= "Path Only",
			BackgroundColor3 = currentMotion == "Path Only" and Constants.THEME.PanelAlt or Constants.THEME.AccentSoft,
			BorderSizePixel = 0,
			Position = UDim2.new(0.39, 4, 0, 7),
			Size = UDim2.new(0.10, -8, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Text = styleLabel .. (openMenuType == "style" and " ^" or " v"),
			TextColor3 = currentMotion == "Path Only" and Constants.THEME.MutedText or Constants.THEME.Text,
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(styleButton, 4)
		self:_connect(styleButton.Activated, function()
			if currentMotion == "Path Only" then
				self:_setShortcutHint("Choose Walk, Run, Jump, Climb, Idle, or Action before choosing a style.")
				return
			end
			if self._openMotionSegmentKey == segmentKey and self._openMotionSegmentMenuType == "style" then
				self._openMotionSegmentKey = nil
				self._openMotionSegmentMenuType = nil
			else
				self:_closeDropdowns()
				self._openMotionSegmentKey = segmentKey
				self._openMotionSegmentMenuType = "style"
				self:_setShortcutHint("Choose an animation style for " .. tostring(currentMotion) .. ".")
			end
			self:_renderMotionSegments(self._lastViewModel and self._lastViewModel.motionSegments or segmentEntries)
		end)
		local hasCustomDuration = segment.durationOverrideSeconds ~= nil
		local initialDurationText = string.format("%.2f", tonumber(segment.durationSeconds) or 0)
		local durationInput = create("TextBox", {
			Parent = row,
			BackgroundColor3 = hasCustomDuration and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Position = UDim2.new(0.49, 4, 0, 7),
			Size = UDim2.new(0.12, -8, 0, 24),
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamSemibold,
			PlaceholderText = "Auto",
			Text = initialDurationText,
			TextColor3 = Constants.THEME.Text,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(durationInput, 4)
		table.insert(self._motionSegmentInputs, durationInput)
		self:_connect(durationInput.Focused, function()
			self._editingTextInput = durationInput
			self._shortcutFocus = false
			self:_releaseShortcutCapture()
			self:_setShortcutHint("Editing segment duration. Press Enter or click away to apply.")
		end)
		self:_connect(durationInput.FocusLost, function()
			if self._editingTextInput == durationInput then
				self._editingTextInput = nil
			end
			if durationInput.Text ~= initialDurationText and self._callbacks and self._callbacks.onSetMotionSegmentDuration then
				self._callbacks.onSetMotionSegmentDuration(segment.segmentKey, durationInput.Text)
			end
		end)
		local hasCustomPause = segment.pauseOverrideSeconds ~= nil
		local initialPauseText = string.format("%.2f", pauseSeconds)
		local pauseInput = create("TextBox", {
			Parent = row,
			BackgroundColor3 = hasCustomPause and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Position = UDim2.new(0.61, 4, 0, 7),
			Size = UDim2.new(0.085, -8, 0, 24),
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamSemibold,
			PlaceholderText = "0",
			Text = initialPauseText,
			TextColor3 = pauseSeconds &gt; 0 and Constants.THEME.Text or Constants.THEME.MutedText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(pauseInput, 4)
		table.insert(self._motionSegmentInputs, pauseInput)
		self:_connect(pauseInput.Focused, function()
			self._editingTextInput = pauseInput
			self._shortcutFocus = false
			self:_releaseShortcutCapture()
			self:_setShortcutHint("Editing pause after this segment. Use 0 for no hold.")
		end)
		self:_connect(pauseInput.FocusLost, function()
			if self._editingTextInput == pauseInput then
				self._editingTextInput = nil
			end
			if pauseInput.Text ~= initialPauseText and self._callbacks and self._callbacks.onSetMotionSegmentPause then
				self._callbacks.onSetMotionSegmentPause(segment.segmentKey, pauseInput.Text)
			end
		end)
		local hasCustomBlend = segment.blendOverrideSeconds ~= nil
		local initialBlendText = string.format("%.2f", tonumber(segment.blendSeconds) or 0)
		local blendInput = create("TextBox", {
			Parent = row,
			BackgroundColor3 = hasCustomBlend and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Position = UDim2.new(0.695, 4, 0, 7),
			Size = UDim2.new(0.085, -8, 0, 24),
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamSemibold,
			PlaceholderText = "0",
			Text = initialBlendText,
			TextColor3 = (segment.hasNextSegment ~= false) and Constants.THEME.Text or Constants.THEME.MutedText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(blendInput, 4)
		table.insert(self._motionSegmentInputs, blendInput)
		self:_connect(blendInput.Focused, function()
			self._editingTextInput = blendInput
			self._shortcutFocus = false
			self:_releaseShortcutCapture()
			self:_setShortcutHint("Editing blend time before the next segment. Use 0 for a hard cut.")
		end)
		self:_connect(blendInput.FocusLost, function()
			if self._editingTextInput == blendInput then
				self._editingTextInput = nil
			end
			if blendInput.Text ~= initialBlendText and self._callbacks and self._callbacks.onSetMotionSegmentBlend then
				self._callbacks.onSetMotionSegmentBlend(segment.segmentKey, blendInput.Text)
			end
		end)
		local pauseIdleClipId = tostring(segment.pauseIdleClipId or "")
		local idleLabel = pauseSeconds &gt; 0 and findClipLabel(motionClipOptionsByMotion.Idle, pauseIdleClipId, pauseIdleClipId ~= "" and "Custom Idle" or "Hold Pose") or (hasCustomPause and "No hold" or "No idle")
		local pauseIdleButton = create("TextButton", {
			Parent = row,
			AutoButtonColor = pauseSeconds &gt; 0,
			BackgroundColor3 = pauseSeconds &gt; 0 and Constants.THEME.AccentSoft or Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Position = UDim2.new(0.78, 4, 0, 7),
			Size = UDim2.new(0.15, -8, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Text = pauseSeconds &gt; 0 and (idleLabel .. (openMenuType == "idle" and " ^" or " v")) or "No Pause",
			TextColor3 = pauseSeconds &gt; 0 and Constants.THEME.Text or Constants.THEME.MutedText,
			TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(pauseIdleButton, 4)
		self:_connect(pauseIdleButton.Activated, function()
			if pauseSeconds &lt;= 0 then
				self:_setShortcutHint("Set a pause greater than 0 before choosing a pause idle.")
				return
			end
			if self._openMotionSegmentKey == segmentKey and self._openMotionSegmentMenuType == "idle" then
				self._openMotionSegmentKey = nil
				self._openMotionSegmentMenuType = nil
			else
				self:_closeDropdowns()
				self._openMotionSegmentKey = segmentKey
				self._openMotionSegmentMenuType = "idle"
				self:_setShortcutHint("Choose an idle animation for this pause.")
			end
			self:_renderMotionSegments(self._lastViewModel and self._lastViewModel.motionSegments or segmentEntries)
		end)

		local isPreviewingThisSegment = isMotionPreviewing and activePreviewKey == segmentKey
		local previewButton = create("TextButton", {
			Parent = row,
			AutoButtonColor = not isMotionPreviewing or isPreviewingThisSegment,
			BackgroundColor3 = isPreviewingThisSegment and Constants.THEME.Danger or Constants.THEME.PanelAlt,
			BorderSizePixel = 0,
			Position = UDim2.new(0.93, 4, 0, 7),
			Size = UDim2.new(0.07, -8, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Text = isPreviewingThisSegment and "Stop" or (isMotionPreviewing and "..." or "Play"),
			TextColor3 = isMotionPreviewing and not isPreviewingThisSegment and Constants.THEME.MutedText or Constants.THEME.Text,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 9,
		})
		createCorner(previewButton, 4)
		self:_connect(previewButton.Activated, function()
			if isPreviewingThisSegment and self._callbacks and self._callbacks.onStopMotionPreview then
				self._callbacks.onStopMotionPreview()
			elseif isMotionPreviewing then
				self:_setShortcutHint("Stop the current Motion Builder preview before starting another.")
			elseif self._callbacks and self._callbacks.onPreviewMotionSegment then
				self._callbacks.onPreviewMotionSegment(segment.segmentKey)
			else
				self:_setShortcutHint("Motion segment preview is not connected yet.")
			end
		end)

		if isMotionMenuOpen then
			local menu = create("Frame", {
				Parent = row,
				BackgroundColor3 = Constants.THEME.PanelAlt,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 8, 0, 42),
				Size = UDim2.new(1, -16, 0, rowHeight - 48),
				ZIndex = 10,
			})
			createCorner(menu, 4)
			createStroke(menu)

			if openMenuType == "motion" then
				local motionOptions = {}
				for _, optionName in ipairs(MOTION_SEGMENT_OPTIONS) do
					table.insert(motionOptions, {
						id = optionName,
						name = optionName,
					})
				end
				createOptionStrip(menu, 5, "Motion", motionOptions, currentMotion, nil, function(optionId)
					if self._callbacks and self._callbacks.onSetMotionSegmentMotion then
						self._callbacks.onSetMotionSegmentMotion(segment.segmentKey, optionId)
					else
						self:_setShortcutHint("Segment motion picker is not connected yet.")
						self:_renderMotionSegments(self._lastViewModel and self._lastViewModel.motionSegments or segmentEntries)
					end
				end)
			elseif openMenuType == "style" then
				local styleOptions = {
					{
						id = "__load_custom__",
						name = currentMotion == "Action" and "Browse..." or "Custom...",
					},
				}
				for _, option in ipairs(motionClipOptions) do
					table.insert(styleOptions, option)
				end
				createOptionStrip(menu, 5, "Style", styleOptions, selectedClipId, "Default", function(optionId)
					if optionId == "__load_custom__" then
						local useStarterBrowser = currentMotion == "Action" and self._callbacks and self._callbacks.onLoadPresetAnimations
						self._openMotionSegmentKey = nil
						self._openMotionSegmentMenuType = nil
						self._motionSegmentPickerKey = tostring(segment.segmentKey or "")
						self._motionSegmentPickerLabel = tostring(currentMotion)
						self._motionDefaultPickerMotion = nil
						self._lastPresetEntriesSignature = nil
						self:_setWorkspaceMode("Presets")
						if self._presetStatusLabel then
							self._presetStatusLabel.Text = useStarterBrowser
								and ("Opening Roblox Starter presets. Pick one to use as the custom " .. tostring(currentMotion) .. " style.")
								or ("Loading your animations. Pick one to use as the custom " .. tostring(currentMotion) .. " style.")
						end
						self:_setShortcutHint("Choose a custom " .. tostring(currentMotion) .. " animation from the visual browser.")
						if useStarterBrowser then
							self._callbacks.onLoadPresetAnimations()
						elseif self._callbacks and self._callbacks.onLoadMyAnimations then
							self._callbacks.onLoadMyAnimations()
						else
							self:_setShortcutHint("My Animations browser is not connected yet.")
						end
						return
					end
					if self._callbacks and self._callbacks.onSetMotionSegmentClip then
						self._callbacks.onSetMotionSegmentClip(segment.segmentKey, optionId)
					else
						self:_setShortcutHint("Segment animation picker is not connected yet.")
					end
				end)
			elseif openMenuType == "idle" then
				local pauseIdleOptions = {
					{
						id = "__load_custom__",
						name = "Custom...",
					},
				}
				for _, option in ipairs(motionClipOptionsByMotion.Idle or {}) do
					table.insert(pauseIdleOptions, option)
				end
				createOptionStrip(menu, 5, "Pause Idle", pauseIdleOptions, segment.pauseIdleClipId, "Hold Pose", function(optionId)
					if optionId == "__load_custom__" then
						self._openMotionSegmentKey = nil
						self._openMotionSegmentMenuType = nil
						self._motionSegmentPickerKey = "__pause_idle__:" .. tostring(segment.segmentKey or "")
						self._motionSegmentPickerLabel = "pause idle"
						self._motionDefaultPickerMotion = nil
						self._lastPresetEntriesSignature = nil
						self:_setWorkspaceMode("Presets")
						if self._presetStatusLabel then
							self._presetStatusLabel.Text = "Loading your animations. Pick one to use as the custom pause idle."
						end
						self:_setShortcutHint("Choose a custom idle animation for this pause.")
						if self._callbacks and self._callbacks.onLoadMyAnimations then
							self._callbacks.onLoadMyAnimations()
						else
							self:_setShortcutHint("My Animations browser is not connected yet.")
						end
						return
					end
					if self._callbacks and self._callbacks.onSetMotionSegmentPauseIdle then
						self._callbacks.onSetMotionSegmentPauseIdle(segment.segmentKey, optionId)
					else
						self:_setShortcutHint("Pause idle picker is not connected yet.")
					end
				end)
			end
		end
	end
	PerformanceDebugService.finish(perfToken, string.format("%d segments", segmentCount))
end

