			onGetImportBrowserStatus = options and options.onGetImportBrowserStatus,
			getImportEntries = options and options.getImportEntries,
			getImportBrowserStatus = options and options.getImportBrowserStatus,
			onClose = wrappedOnClose,
			onCloseAfterImport = wrappedOnClose,
			setStatus = function(_message)
			end,
		})
		popup.Destroying:Connect(function()
