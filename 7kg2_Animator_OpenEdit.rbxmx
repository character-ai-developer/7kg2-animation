local TIMELINE_GRID_MAX_LINES_PER_LANE = 180
local TIMELINE_RENDER_ALL_KEY_LIMIT = 900
local KEYFRAME_DRAG_THRESHOLD = 4
local TRACK_DOUBLE_CLICK_SECONDS = 0.48
local PRESET_PREVIEW_SAMPLE_TIME = PresetPreviewSupport.SAMPLE_TIME
local MOTION_SEGMENT_OPTIONS = { "Path Only", "Walk", "Run", "Jump", "Climb", "Idle", "Action" }
local MOTION_DEFAULT_OPTIONS = { "Walk", "Run", "Jump", "Climb", "Idle", "Action" }
local CUSTOM_FADE_COLORS = {
	Black = Color3.fromRGB(0, 0, 0),
	White = Color3.fromRGB(255, 255, 255),
	Warm = Color3.fromRGB(255, 152, 96),
	Cool = Color3.fromRGB(90, 170, 255),
}
local FOLDER_COLOR_OPTIONS = {
	{ id = "Yellow", color = Color3.fromRGB(255, 225, 90) },
	{ id = "Cyan", color = Color3.fromRGB(80, 210, 255) },
	{ id = "Green", color = Color3.fromRGB(90, 220, 140) },
	{ id = "Pink", color = Color3.fromRGB(255, 95, 180) },
	{ id = "Purple", color = Color3.fromRGB(170, 90, 255) },
	{ id = "Orange", color = Color3.fromRGB(255, 170, 70) },
}
local FOLDER_COLOR_BY_ID = {}
for _, option in ipairs(FOLDER_COLOR_OPTIONS) do
	FOLDER_COLOR_BY_ID[option.id] = option.color
end
local LIGHTING_OPTIONAL_EFFECTS = {
	"Atmosphere",
	"Bloom",
	"DepthOfField",
	"SunRays",
	"ColorCorrection",
	"Sky",
	"Blur",
	"Highlight",
}

local WidgetController = {}
WidgetController.__index = WidgetController

local function applySectionRefs(target, refs)
